Dialogue: 0,0:00:05.99,0:00:07.07,Default,,0,0,0,,Halo, semuanya.
Dialogue: 0,0:00:07.07,0:00:08.78,Default,,0,0,0,,Aku Takanashi Rin.
Dialogue: 0,0:00:08.78,0:00:10.99,Default,,0,0,0,,Usiaku 20-an tahun, mantan perawat.
Dialogue: 0,0:00:10.99,0:00:12.83,Default,,0,0,0,,Sekarang menjadi ahli akupunktur.
Dialogue: 0,0:00:13.66,0:00:16.12,Default,,0,0,0,,Hobiku main gim cerita dan berkemah!
Dialogue: 0,0:00:16.12,0:00:17.33,Default,,0,0,0,,Lagi pula,
Dialogue: 0,0:00:17.33,0:00:20.96,Default,,0,0,0,,sejak kecil aku sangat suka\Nberkemah sendirian!
Dialogue: 0,0:00:21.38,0:00:22.71,Default,,0,0,0,,Kadang saat libur,
Dialogue: 0,0:00:22.71,0:00:25.80,Default,,0,0,0,,aku pergi ke alam terbuka\Ndan memancing dengan tenang.
Dialogue: 0,0:00:25.80,0:00:28.09,Default,,0,0,0,,Rasanya membuat bahagia.
Dialogue: 0,0:00:28.09,0:00:30.09,Default,,0,0,0,,Tapi ada sedikit masalah...
Dialogue: 0,0:00:30.09,0:00:31.05,Default,,0,0,0,,Dapat!
Dialogue: 0,0:00:31.05,0:00:33.43,Default,,0,0,0,,Dapat! Dapat! Dapat!
Dialogue: 0,0:00:33.43,0:00:35.27,Default,,0,0,0,,Sepertinya ini ikan besar!
Dialogue: 0,0:00:38.18,0:00:40.21,Default,,0,0,0,,Dapat!
Dialogue: 0,0:00:46.48,0:00:48.77,Default,,0,0,0,,Makhluk itu sepertinya lezat!
Dialogue: 0,0:00:49.15,0:00:50.28,Default,,0,0,0,,Baik!
Dialogue: 0,0:00:51.11,0:00:52.97,Default,,0,0,0,,Serahkan padaku!
Dialogue: 0,0:00:59.87,0:01:02.50,Default,,0,0,0,,Sebelumnya ini agak repot,
Dialogue: 0,0:01:02.92,0:01:05.35,Default,,0,0,0,,tapi sekarang sudah tak terlalu repot lagi.
Dialogue: 0,0:02:40.31,0:02:42.52,Default Above,,0,0,0,,Hari ini aku duduk di kursi wanita.
Dialogue: 0,0:02:42.52,0:02:43.85,Default Above,,0,0,0,,Benar juga.
Dialogue: 0,0:02:43.85,0:02:47.23,Default,,0,0,0,,Daripada di kursi penumpang depan,\Nduduk di kursi wanita lebih cocok.
Dialogue: 0,0:02:47.23,0:02:49.69,Default,,0,0,0,,Sebentar lagi kita sampai ke Danau Real.
Dialogue: 0,0:02:49.69,0:02:52.74,Default,,0,0,0,,Mau sekalian cari bahan\Nuntuk makan malam di sana?
Dialogue: 0,0:02:52.74,0:02:54.65,Default,,0,0,0,,Jadi tak sabar.
Dialogue: 0,0:02:55.61,0:02:58.31,Default,,0,0,0,,Kalau jalan kaki,\Npasti butuh waktu beberapa hari.
Dialogue: 0,0:02:58.31,0:03:00.54,Default,,0,0,0,,Skill ini memang hebat.
Dialogue: 0,0:03:00.54,0:03:04.00,Default,,0,0,0,,Masih sulit membayangkan ada orang bilang\Nskill ini tidak berguna.
Dialogue: 0,0:03:04.00,0:03:06.46,Default,,0,0,0,,Benar... ini tempatnya!
Dialogue: 0,0:03:06.46,0:03:08.00,Default,,0,0,0,,Rin, ada apa?
Dialogue: 0,0:03:08.00,0:03:10.75,Default,,0,0,0,,Hari pertama aku dipanggil\Nlewat ritual Pemanggilan Gadis Suci,
Dialogue: 0,0:03:10.75,0:03:12.95,Default,,0,0,0,,aku sedang memancing di sini.
Dialogue: 0,0:03:12.95,0:03:14.47,Default,,0,0,0,,Begitu, ya.
Dialogue: 0,0:03:14.47,0:03:16.68,Default,,0,0,0,,Nostalgia, ya.
Dialogue: 0,0:03:16.68,0:03:19.39,Default,,0,0,0,,Nostalgia?\NTapi itu belum lama, kan?
Dialogue: 0,0:03:19.39,0:03:21.47,Default,,0,0,0,,Itu benar,
Dialogue: 0,0:03:21.47,0:03:24.81,Default,,0,0,0,,tapi setelah itu banyak\Nhal tak terduga terjadi.
Dialogue: 0,0:03:26.31,0:03:27.94,Default,,0,0,0,,Tapi, setelah dipikirkan,
Dialogue: 0,0:03:27.94,0:03:31.90,Default,,0,0,0,,semuanya berawal sejak aku\Nmemancingmu di sini.
Dialogue: 0,0:03:32.40,0:03:33.48,Default,,0,0,0,,Memancing?
Dialogue: 0,0:03:33.48,0:03:34.86,Default,,0,0,0,,Apa maksudnya?
Dialogue: 0,0:03:35.74,0:03:37.95,Default,,0,0,0,,Aku pergi patroli dulu.
Dialogue: 0,0:03:37.95,0:03:39.64,Default,,0,0,0,,Ville, jangan lari!
Dialogue: 0,0:03:39.64,0:03:41.20,Default,,0,0,0,,Jelaskan apa maksudnya?
Dialogue: 0,0:03:41.60,0:03:44.85,Default,,0,0,0,,Jangan-jangan Ville\Ntidak cerita pada kalian, ya?
Dialogue: 0,0:03:45.37,0:03:47.54,Default,,0,0,0,,Ville tidak boleh dimakan.
Dialogue: 0,0:03:48.25,0:03:49.12,Default,,0,0,0,,Baik.
Dialogue: 0,0:03:52.92,0:03:56.38,Default,,0,0,0,,Karena cuma kita yang di sini,\Nayo cari bahan makanan.
Dialogue: 0,0:03:56.38,0:03:57.26,Default,,0,0,0,,Aku juga mau ikut.
Dialogue: 0,0:03:57.26,0:03:58.76,Default,,0,0,0,,Aku juga mau bantu.
Dialogue: 0,0:03:58.76,0:04:00.01,Default,,0,0,0,,Biar kubantu!
Dialogue: 0,0:04:00.01,0:04:01.97,Default,,0,0,0,,Mau pakai benangku?
Dialogue: 0,0:04:01.97,0:04:05.43,Default,,0,0,0,,Apa perlu aku menyelam\Ndan bergerak cepat di dalam air?
Dialogue: 0,0:04:06.56,0:04:09.98,Default,,0,0,0,,Nanti bantu aku kalau dapat ikan besar.
Dialogue: 0,0:04:10.61,0:04:11.69,Default,,0,0,0,,Gomamiso juga.
Dialogue: 0,0:04:11.69,0:04:13.07,Default,,0,0,0,,Serahkan padaku.
Dialogue: 0,0:04:13.52,0:04:14.40,Default,,0,0,0,,Hasilnya...
Dialogue: 0,0:04:14.40,0:04:16.65,Default,,0,0,0,,Dapat sebanyak ini.
Dialogue: 0,0:04:16.65,0:04:20.20,Default,,0,0,0,,Semua ini berkat bantuan besar\Ndari Aria dan Miso.
Dialogue: 0,0:04:21.24,0:04:24.83,Default,,0,0,0,,Jadi, malam ini kita akan makan\Ndengan bahan ini.
Dialogue: 0,0:04:24.83,0:04:27.83,Default,,0,0,0,,Kita akan makan Berang-Berang Ganas?
Dialogue: 0,0:04:28.96,0:04:31.79,Default,,0,0,0,,Survival bilang ini lezat.
Dialogue: 0,0:04:31.79,0:04:35.84,Default,,0,0,0,,Di desa elf, kami memakan hewan ini\Nsebagai makanan penambah stamina.
Dialogue: 0,0:04:36.30,0:04:39.30,Default,,0,0,0,,Karena Survival bilang enak,
Dialogue: 0,0:04:39.30,0:04:40.64,Default,,0,0,0,,asalkan dimasak dengan benar,
Dialogue: 0,0:04:40.64,0:04:42.30,Default,,0,0,0,,pasti rasanya enak.
Dialogue: 0,0:04:47.27,0:04:49.48,Default,,0,0,0,,Itu Gunung Merlova, ya?
Dialogue: 0,0:04:49.48,0:04:51.60,Default,,0,0,0,,Asap kawah gunungnya\Nternyata tidak banyak, ya.
Dialogue: 0,0:04:51.92,0:04:54.73,Default,,0,0,0,,Setelah pernah meletus sekali,
Dialogue: 0,0:04:54.73,0:04:56.94,Default,,0,0,0,,sekarang statusnya stabil lagi.
Dialogue: 0,0:04:57.61,0:04:59.15,Default,,0,0,0,,Hari juga sudah mulai gelap.
Dialogue: 0,0:04:59.15,0:05:01.41,Default,,0,0,0,,Kita berhenti sebentar lagi dan berkemah.
Dialogue: 0,0:05:01.41,0:05:02.57,Default,,0,0,0,,Baik.
Dialogue: 0,0:05:05.08,0:05:08.41,Default,,0,0,0,,Kalau begitu, aku dan Senon\Nmau patroli dulu di sekitar.
Dialogue: 0,0:05:08.41,0:05:12.21,Default,,0,0,0,,Kalau begitu, kami yang siapkan kemah\Ndan makan malam.
Dialogue: 0,0:05:12.21,0:05:17.17,Default,,0,0,0,,Malam ini makan telur ikan trout emas\Ndan daging rebus Berang-Berang Ganas.
Dialogue: 0,0:05:17.17,0:05:19.01,Default,,0,0,0,,Ternyata tetap dimakan, ya?
Dialogue: 0,0:05:19.01,0:05:21.08,Default,,0,0,0,,Untungnya itu bisa memulihkan stamina.
Dialogue: 0,0:05:25.60,0:05:27.71,Default,,0,0,0,,Lihat saja nanti.
Dialogue: 0,0:05:28.85,0:05:31.31,Default,,0,0,0,,Potong kentang yang sudah dikupas\Njadi ukuran sekali gigit
Dialogue: 0,0:05:31.31,0:05:33.02,Default,,0,0,0,,dan potong bawang bombai besar-besar.
Dialogue: 0,0:05:33.02,0:05:36.17,Default,,0,0,0,,Rendam jamur shitake kering\Nsisa sebelumnya hingga mengembang
Dialogue: 0,0:05:36.17,0:05:38.78,Default,,0,0,0,,Lalu simpan air rendaman jamur shitake\Nuntuk dijadikan kaldu.
Dialogue: 0,0:05:38.78,0:05:42.36,Default,,0,0,0,,Selanjutnya, bumbui sedikit daging\NBerang-Berang Ganas...
Dialogue: 0,0:05:44.74,0:05:46.31,Default,,0,0,0,,Mau dimakan utuh?
Dialogue: 0,0:05:46.31,0:05:48.73,Default,,0,0,0,,Tidak, kali ini digoreng dulu baru dipotong.
Dialogue: 0,0:05:48.73,0:05:50.66,Default,,0,0,0,,Dimakan utuh juga tidak apa-apa.
Dialogue: 0,0:05:50.66,0:05:53.87,Default,,0,0,0,,Aku juga ingin tahu sensasi\Nmenggigit potongan besar.
Dialogue: 0,0:05:53.87,0:05:57.00,Default,,0,0,0,,Minyaknya keluar semua, aromanya wangi.
Dialogue: 0,0:05:57.00,0:05:59.71,Default,,0,0,0,,Ternyata lemaknya sebanyak ini!
Dialogue: 0,0:05:59.71,0:06:02.13,Default,,0,0,0,,Pantas saja dianggap\Nsebagai makanan penambah stamina.
Dialogue: 0,0:06:02.13,0:06:05.55,Default,,0,0,0,,Sekalian, kita pakai lemak ini\Nuntuk menumis sayuran.
Dialogue: 0,0:06:05.55,0:06:07.01,Default,,0,0,0,,Sayuran...
Dialogue: 0,0:06:07.56,0:06:08.43,Default,,0,0,0,,Tapi,
Dialogue: 0,0:06:08.43,0:06:10.93,Default,,0,0,0,,aku suka sayuran masakan Rin.
Dialogue: 0,0:06:10.93,0:06:13.73,Default,,0,0,0,,Oh, senang mendengarnya.
Dialogue: 0,0:06:13.73,0:06:16.02,Default,,0,0,0,,Rin, aku tidak akan kalah darimu!
Dialogue: 0,0:06:16.02,0:06:17.65,Default,,0,0,0,,Maksud Aria itu soal masakan.
Dialogue: 0,0:06:18.69,0:06:20.15,Default,,0,0,0,,Aku hanya bercanda.
Dialogue: 0,0:06:20.15,0:06:22.15,Default,,0,0,0,,Tidak, kamu tidak sepenuhnya\Nbercanda, kan?
Dialogue: 0,0:06:22.61,0:06:24.37,Default,,0,0,0,,Tapi, aku juga tidak akan berubah.
Dialogue: 0,0:06:24.37,0:06:26.41,Default,,0,0,0,,Kapan lagi bisa mengobrol dengan wanita cantik.
Dialogue: 0,0:06:26.41,0:06:28.87,Default,,0,0,0,,Tentu aku harus ambil kesempatan.
Dialogue: 0,0:06:28.87,0:06:33.00,Default,,0,0,0,,Selanjutnya, tinggal masukkan daging\Ndan sayuran ke kaldu yang ditambahkan air,
Dialogue: 0,0:06:33.00,0:06:34.79,Default,,0,0,0,,lalu sesuaikan rasanya dengan bumbu
Dialogue: 0,0:06:34.79,0:06:36.13,Default,,0,0,0,,dan masak hingga matang.
Dialogue: 0,0:06:36.71,0:06:39.13,Default,,0,0,0,,Masakannya selesai!
Dialogue: 0,0:06:39.13,0:06:42.63,Default,,0,0,0,,Terima kasih dunia, aku bisa makan hari ini.
Dialogue: 0,0:06:42.63,0:06:43.97,Default,,0,0,0,,Selamat makan!
Dialogue: 0,0:06:47.89,0:06:49.31,Default,,0,0,0,,Aromanya enak.
Dialogue: 0,0:06:49.31,0:06:51.52,Default,,0,0,0,,Rasanya harusnya enak.
Dialogue: 0,0:06:51.52,0:06:53.43,Default,,0,0,0,,Be-Benarkah?
Dialogue: 0,0:06:59.36,0:07:00.69,Default,,0,0,0,,Lezat!
Dialogue: 0,0:07:05.95,0:07:06.91,Default,,0,0,0,,Enak!
Dialogue: 0,0:07:06.91,0:07:08.16,Default,,0,0,0,,Syukurlah.
Dialogue: 0,0:07:08.16,0:07:10.03,Default,,0,0,0,,Daging ini sangat enak.
Dialogue: 0,0:07:10.03,0:07:13.75,Default,,0,0,0,,Bukan hanya daging yang padat dan kenyal,\Nlemaknya juga langsung lumer di mulut.
Dialogue: 0,0:07:13.75,0:07:17.58,Default,,0,0,0,,Daging Berang-Berang Ganas di desaku\Nsemuanya sangat berminyak.
Dialogue: 0,0:07:17.58,0:07:20.09,Default,,0,0,0,,Tapi kamu bisa mengolah lemaknya\Ndengan sangat pas.
Dialogue: 0,0:07:20.09,0:07:23.34,Default,,0,0,0,,Aroma daging yang kuat juga\Nmenyatu sempurna ke dalam kuahnya.
Dialogue: 0,0:07:23.34,0:07:26.05,Default,,0,0,0,,Hanya dengan ini saja,\Naku bisa makan porsi besar!
Dialogue: 0,0:07:26.05,0:07:28.80,Default,,0,0,0,,Dagingnya enak!\NSenangnya!
Dialogue: 0,0:07:30.51,0:07:32.81,Default,,0,0,0,,Kentangnya juga enak!
Dialogue: 0,0:07:35.69,0:07:38.40,Default,,0,0,0,,Sayuran seperti ini ternyata bisa\Nmenambah nafsu makan.
Dialogue: 0,0:07:38.40,0:07:41.36,Default,,0,0,0,,Itu karena sayurannya menyerap\Nke semua bahannya.
Dialogue: 0,0:07:41.36,0:07:42.53,Default,,0,0,0,,Selanjutnya...
Dialogue: 0,0:07:42.53,0:07:45.61,Default,,0,0,0,,Coba juga rasa telur ikan trout emas.
Dialogue: 0,0:07:47.95,0:07:51.20,Default,,0,0,0,,Itu telur ikan trout susu, kan?
Dialogue: 0,0:07:51.20,0:07:54.54,Default,,0,0,0,,Di tempat asalku,\Nmayoritas makan telur ikan.
Dialogue: 0,0:07:54.54,0:07:57.04,Default,,0,0,0,,Bahkan itu termasuk masakan kelas atas.
Dialogue: 0,0:07:57.04,0:07:58.04,Default,,0,0,0,,Begitu.
Dialogue: 0,0:07:58.04,0:08:00.67,Default,,0,0,0,,Berbeda dengan budaya makan kami, ya.
Dialogue: 0,0:08:01.63,0:08:03.99,Default,,0,0,0,,Rin, bagaimana?
Dialogue: 0,0:08:04.46,0:08:06.51,Default,,0,0,0,,Ini... gawat!
Dialogue: 0,0:08:06.51,0:08:08.34,Default,,0,0,0,,Tidak enak?
Dialogue: 0,0:08:08.34,0:08:09.89,Default,,0,0,0,,Sebaliknya!
Dialogue: 0,0:08:09.89,0:08:14.72,Default,,0,0,0,,Saking enaknya, ditambah nasi\Nsebanyak apa pun tetap enak!
Dialogue: 0,0:08:14.72,0:08:15.92,Default,,0,0,0,,Saat telur ikannya digigit,
Dialogue: 0,0:08:15.92,0:08:17.85,Default,,0,0,0,,isinya yang kental mengalir keluar perlahan.
Dialogue: 0,0:08:17.85,0:08:20.69,Default,,0,0,0,,Rasa gurihnya yang kuat\Nlangsung memenuhi mulut,
Dialogue: 0,0:08:20.69,0:08:22.19,Default,,0,0,0,,tapi sama sekali tidak terasa amis.
Dialogue: 0,0:08:22.19,0:08:25.23,Default,,0,0,0,,Rasa gurihnya berpadu sempurna\Ndengan nasi putih,
Dialogue: 0,0:08:25.23,0:08:28.24,Default,,0,0,0,,sementara rasa asin telur ikan\Nmemperkuat rasa manis alami nasi.
Dialogue: 0,0:08:28.24,0:08:30.82,Default,,0,0,0,,Makanan seenak ini
Dialogue: 0,0:08:30.82,0:08:33.78,Default,,0,0,0,,membuatku tak berhenti mengunyah!
Dialogue: 0,0:08:37.37,0:08:40.27,Default,,0,0,0,,Enak!
Dialogue: 0,0:08:45.13,0:08:48.80,Default,,0,0,0,,Karena Senon bilang\Nmau coba duduk di kursi ini,
Dialogue: 0,0:08:48.80,0:08:50.89,Default,,0,0,0,,hari ini dia duduk di depan...
Dialogue: 0,0:08:50.89,0:08:53.93,Default,,0,0,0,,Sial, muka dia sangat tampan!
Dialogue: 0,0:08:53.93,0:08:56.56,Default,,0,0,0,,Kalau dia terus diam,\Nrasanya HP-ku berkurang drastis.
Dialogue: 0,0:08:58.23,0:09:01.69,Default,,0,0,0,,Ma-Masakan di desa elf itu\Nrasanya seperti apa?
Dialogue: 0,0:09:01.69,0:09:04.36,Default,,0,0,0,,Kami memanfaatkan semua berkat\Ndan sumber daya hutan.
Dialogue: 0,0:09:04.36,0:09:06.65,Default,,0,0,0,,Formalnya begitu.
Dialogue: 0,0:09:06.65,0:09:10.15,Default,,0,0,0,,Sebenarnya kami hanya makan daging hewan\Nyang alot dan sayuran liar pegunungan.
Dialogue: 0,0:09:11.03,0:09:13.01,Default,,0,0,0,,Jadi intinya masakan makanan liar, ya?
Dialogue: 0,0:09:13.01,0:09:16.20,Default,,0,0,0,,Oh, iya, kamu pernah bilang\Nbisa menyembelih hewan buruan.
Dialogue: 0,0:09:16.20,0:09:18.95,Default,,0,0,0,,Kami juga biasa memasak hidangan monster,
Dialogue: 0,0:09:18.95,0:09:22.83,Default,,0,0,0,,tapi masakanmu jauh lebih enak\Ndan selalu membuatku takjub.
Dialogue: 0,0:09:22.83,0:09:23.79,Default,,0,0,0,,Rin.
Dialogue: 0,0:09:23.79,0:09:25.75,Default,,0,0,0,,Sudah waktunya makan?
Dialogue: 0,0:09:25.75,0:09:29.05,Default,,0,0,0,,Kami jadi lapar karena kalian terus\Nmembicarakan makanan.
Dialogue: 0,0:09:29.05,0:09:30.51,Default,,0,0,0,,Begitu, ya.
Dialogue: 0,0:09:30.51,0:09:33.80,Default,,0,0,0,,Baiklah, kita cari tempat berhenti\Nlalu makan siang.
Dialogue: 0,0:09:33.80,0:09:35.14,Default,,0,0,0,,Hore!
Dialogue: 0,0:09:35.14,0:09:36.64,Default,,0,0,0,,Sejak Rin bergabung dengan kita,
Dialogue: 0,0:09:36.64,0:09:39.27,Default,,0,0,0,,tiap hari aku selalu menantikan waktu makan.
Dialogue: 0,0:09:39.27,0:09:39.85,Default,,0,0,0,,Iya.
Dialogue: 0,0:09:40.17,0:09:42.85,Default,,0,0,0,,Masa-masa tanpa Rin sangat suram.
Dialogue: 0,0:09:44.27,0:09:48.36,Default,,0,0,0,,Mulai lagi,\Ncerita sejarah kelam soal makanan.
Dialogue: 0,0:09:48.36,0:09:51.20,Default,,0,0,0,,Yang membuat kami repot\Nkadang bukan menyelesaikan misi,
Dialogue: 0,0:09:51.20,0:09:54.07,Default,,0,0,0,,tapi soal makan malam.
Dialogue: 0,0:09:54.07,0:09:55.24,Default,,0,0,0,,Itu benar.
Dialogue: 0,0:09:55.24,0:09:56.20,Default,,0,0,0,,Karena tahu repot,
Dialogue: 0,0:09:56.20,0:09:59.58,Default,,0,0,0,,kami cuma menerima misi\Nyang bisa cepat selesai.
Dialogue: 0,0:09:59.58,0:10:00.96,Default,,0,0,0,,Ya-Yah...
Dialogue: 0,0:10:00.96,0:10:04.04,Default,,0,0,0,,Mulai sekarang aku akan buat\Nbanyak makanan enak untuk kalian.
Dialogue: 0,0:10:04.04,0:10:06.34,Default,,0,0,0,,Jadi, meski kami ulang berkali-kali pun,
Dialogue: 0,0:10:06.34,0:10:09.59,Default,,0,0,0,,kami senang sekali kamu sudah bergabung!
Dialogue: 0,0:10:09.59,0:10:10.80,Default,,0,0,0,,Iya.
Dialogue: 0,0:10:10.80,0:10:14.33,Default Above,,0,0,0,,Rin sudah jadi anggota inti tak tergantikan.
Dialogue: 0,0:10:14.33,0:10:17.30,Default,,0,0,0,,Aku juga mau makan anggota tim!
Dialogue: 0,0:10:17.30,0:10:18.97,Default,,0,0,0,,Itu bukan makanan.
Dialogue: 0,0:10:18.97,0:10:22.48,Default,,0,0,0,,Bagi kami,\NRin sudah seperti hadiah dari langit.
Dialogue: 0,0:10:22.48,0:10:24.81,Default,,0,0,0,,Ke depannya, mohon kerja samanya juga.
Dialogue: 0,0:10:24.81,0:10:28.48,Default,,0,0,0,,Masak di dunia ini sangat seru.
Dialogue: 0,0:10:28.48,0:10:30.69,Default,,0,0,0,,Aku juga mohon kerja samanya...
Dialogue: 0,0:10:30.69,0:10:32.07,Default,,0,0,0,,Baik.
Dialogue: 0,0:10:35.74,0:10:37.28,Default,,0,0,0,,Maafkan aku!
Dialogue: 0,0:10:37.87,0:10:40.08,Default,,0,0,0,,Jangan-jangan, itu tujuan kita?
Dialogue: 0,0:10:40.08,0:10:42.29,Default,,0,0,0,,Benar, itu Merlova.
Dialogue: 0,0:10:42.29,0:10:44.29,Default,,0,0,0,,Sudah sampai?
Dialogue: 0,0:10:44.29,0:10:45.67,Default,,0,0,0,,Makan siang bagaimana?
Dialogue: 0,0:10:45.67,0:10:48.00,Default,,0,0,0,,Bisa makan di Merlova juga.
Dialogue: 0,0:10:48.00,0:10:49.09,Default,,0,0,0,,Terakhir kita ke sini,
Dialogue: 0,0:10:49.09,0:10:51.13,Default,,0,0,0,,kamu suka salah satu hidangan di sini, kan?
Dialogue: 0,0:10:51.84,0:10:54.26,Default,,0,0,0,,Ayam Kukus Ekor Pelangi\Ndengan Garam Mata Air.
Dialogue: 0,0:10:54.26,0:10:55.53,Default,,0,0,0,,Iya, itu!
Dialogue: 0,0:10:55.53,0:10:57.34,Default,,0,0,0,,Rasa garam mata air itu sangat khas
Dialogue: 0,0:10:57.34,0:10:59.47,Default,,0,0,0,,dan sangat cocok\Ndengan daging ayam kukus.
Dialogue: 0,0:10:59.47,0:11:00.26,Default,,0,0,0,,Garam mata air?
Dialogue: 0,0:11:00.26,0:11:03.98,Default,,0,0,0,,Itu bumbu dari mata air panas\Nyang dikentalkan.
Dialogue: 0,0:11:03.98,0:11:05.90,Default,,0,0,0,,Itu juga produk khas kota ini.
Dialogue: 0,0:11:05.90,0:11:08.98,Default,,0,0,0,,Kalau begitu,\Nkita akan makan siang di sini, ya!
Dialogue: 0,0:11:18.31,0:11:19.62,Default,,0,0,0,,Habis?
Dialogue: 0,0:11:19.62,0:11:20.95,Default,,0,0,0,,Maaf.
Dialogue: 0,0:11:20.95,0:11:23.12,Default,,0,0,0,,Akhir-akhir ini stok\Ngaram mata air sedang sedikit,
Dialogue: 0,0:11:23.12,0:11:25.96,Default,,0,0,0,,jadi menu Ayam Kukus Ekor Pelangi\Ndengan Garam Mata Air-nya
Dialogue: 0,0:11:25.96,0:11:29.34,Default,,0,0,0,,kami ganti dengan Ayam Kukus Ekor Pelangi\Ndengan Garam Herbal.
Dialogue: 0,0:11:30.96,0:11:33.80,Default,,0,0,0,,Tapi, pakai garam herbal juga enak, kan?
Dialogue: 0,0:11:33.80,0:11:36.48,Default,,0,0,0,,Jangan sedih, Aria.
Dialogue: 0,0:11:36.48,0:11:37.22,Default,,0,0,0,,Rin...
Dialogue: 0,0:11:37.62,0:11:40.50,Default,,0,0,0,,Sangat disayangkan kita tak bisa\Nmencicipi garam mata air,
Dialogue: 0,0:11:40.50,0:11:43.16,Default,,0,0,0,,tapi anggap ini sebagai mencoba\Ncita rasa baru.
Dialogue: 0,0:11:43.16,0:11:44.68,Default,,0,0,0,,Kalau tak menjelajah,
Dialogue: 0,0:11:44.68,0:11:47.35,Default,,0,0,0,,kita tak akan bisa menemukan makanan enak.
Dialogue: 0,0:11:48.02,0:11:49.63,Default,,0,0,0,,Benar juga.
Dialogue: 0,0:11:49.63,0:11:52.73,Default,,0,0,0,,Ucapan Rin lebih menyentuh hati Aria\Ndaripada ucapan penghiburku.
Dialogue: 0,0:11:52.73,0:11:54.69,Default,,0,0,0,,Maaf sudah menunggu!
Dialogue: 0,0:11:58.16,0:12:00.62,Default,,0,0,0,,Survival bilang ini sangat lezat!
Dialogue: 0,0:12:00.62,0:12:02.41,Default,,0,0,0,,Sepertinya layak dicoba!
Dialogue: 0,0:12:06.08,0:12:07.08,Default,,0,0,0,,Enak?
Dialogue: 0,0:12:08.96,0:12:11.50,Default,,0,0,0,,Ekor Pelangi itu monster\Nyang repot untuk dikalahkan,
Dialogue: 0,0:12:11.50,0:12:13.05,Default,,0,0,0,,tapi soal rasa, tak perlu diragukan.
Dialogue: 0,0:12:13.05,0:12:15.46,Default,,0,0,0,,Daging ini sangat enak!
Dialogue: 0,0:12:15.46,0:12:16.76,Default,,0,0,0,,Bukan hanya tidak amis,
Dialogue: 0,0:12:16.76,0:12:18.47,Default,,0,0,0,,manis dan lembutnya juga terasa.
Dialogue: 0,0:12:18.47,0:12:20.72,Default,,0,0,0,,Kulit luarnya tebal dan kaya rasa,
Dialogue: 0,0:12:20.72,0:12:23.51,Default,,0,0,0,,dagingnya lembap berair,\Ndan teksturnya sangat kenyal.
Dialogue: 0,0:12:23.51,0:12:27.60,Default,,0,0,0,,Saat terus digigit,\Nrasa segarnya perlahan meresap keluar.
Dialogue: 0,0:12:27.60,0:12:30.15,Default,,0,0,0,,Rasanya ingin terus mengunyah,
Dialogue: 0,0:12:30.15,0:12:33.61,Default,,0,0,0,,tapi tanpa sadar\Nsudah hilang di tenggorokan.
Dialogue: 0,0:12:33.61,0:12:36.07,Default,,0,0,0,,Sepertinya hidangan ini\Nsangat cocok dengan seleramu.
Dialogue: 0,0:12:36.07,0:12:37.49,Default,,0,0,0,,Setelah memakan ini,
Dialogue: 0,0:12:37.49,0:12:40.54,Default,,0,0,0,,aku jadi makin penasaran ingin\Nmencicipi garam mata air khas di sini.
Dialogue: 0,0:12:40.54,0:12:42.95,Default,,0,0,0,,Meski garam herbalnya sudah enak,
Dialogue: 0,0:12:42.95,0:12:46.29,Default,,0,0,0,,aku jadi makin penasaran\Nseperti apa rasa garam mata air.
Dialogue: 0,0:12:46.29,0:12:49.00,Default,,0,0,0,,Kalau stoknya sudah ada,\Nkita makan ke sini lagi.
Dialogue: 0,0:12:49.00,0:12:51.04,Default,,0,0,0,,Iya, harus ke sini lagi!
Dialogue: 0,0:12:51.44,0:12:55.00,Default,,0,0,0,,Para anggota Meja Rakus,\Nselamat datang di Merlova.
Dialogue: 0,0:12:55.00,0:12:57.84,Default,,0,0,0,,Ketua Serikat Elrage, Tori, mengutus kami
Dialogue: 0,0:12:57.84,0:12:59.68,Default,,0,0,0,,untuk menyerahkan dokumen ini padamu.
Dialogue: 0,0:13:02.01,0:13:06.31,Default,,0,0,0,,Aku, Ketua Serikat Merlova, Aigure,\Nsudah menerima datanya.
Dialogue: 0,0:13:06.89,0:13:10.31,Default,,0,0,0,,Omong-omong, boleh minta\Nwaktu kalian sebentar?
Dialogue: 0,0:13:11.34,0:13:12.44,Default,,0,0,0,,Itu...
Dialogue: 0,0:13:12.44,0:13:13.98,Default,,0,0,0,,Pola itu lagi, ya?
Dialogue: 0,0:13:13.98,0:13:15.27,Default,,0,0,0,,Eh, apa maksudnya?
Dialogue: 0,0:13:15.27,0:13:17.23,Default,,0,0,0,,Urusan yang merepotkan.
Dialogue: 0,0:13:17.23,0:13:21.20,Default,,0,0,0,,Karena Tori sampai memercayakan\Nurusan ini pada kalian,
Dialogue: 0,0:13:21.20,0:13:23.82,Default,,0,0,0,,seharusnya kalian petualang\Nyang cukup hebat, kan?
Dialogue: 0,0:13:23.82,0:13:27.68,Default,,0,0,0,,Di sini juga seharusnya ada\Npetualang hebat, kan?
Dialogue: 0,0:13:27.68,0:13:31.79,Default,,0,0,0,,Semua petualang di serikat kami\Nsudah dikalahkan.
Dialogue: 0,0:13:32.54,0:13:34.00,Default,,0,0,0,,Apa terjadi sesuatu?
Dialogue: 0,0:13:34.00,0:13:35.42,Default,,0,0,0,,Belakangan ini,
Dialogue: 0,0:13:35.42,0:13:40.09,Default,,0,0,0,,ada laporan suara raungan misterius\Ndari dekat sumber garam mata air
Dialogue: 0,0:13:40.09,0:13:41.47,Default,,0,0,0,,dan kami pergi menyelidikinya.
Dialogue: 0,0:13:41.47,0:13:45.76,Default,,0,0,0,,Belakangan diketahui mungkin ada monster\Nyang bersarang di sekitar sumber mata air.
Dialogue: 0,0:13:45.76,0:13:48.68,Default,,0,0,0,,Karena itu, kami pun mengutus\Nbanyak petualang untuk mengalahkannya.
Dialogue: 0,0:13:48.68,0:13:50.56,Default,,0,0,0,,Tapi semuanya dikalahkan?
Dialogue: 0,0:13:50.56,0:13:53.15,Default,,0,0,0,,Merlova dalam beberapa tahun terakhir
Dialogue: 0,0:13:53.15,0:13:55.36,Default,,0,0,0,,sudah berusaha keras di bidang kuliner.
Dialogue: 0,0:13:55.36,0:13:59.49,Default,,0,0,0,,Garam mata air yang dikembangkan bersama\Nserikat petualang dan serikat dagang
Dialogue: 0,0:13:59.49,0:14:00.91,Default,,0,0,0,,adalah produk andalan kami.
Dialogue: 0,0:14:00.91,0:14:04.11,Default,,0,0,0,,Kalau tak cepat diatasi, mungkin kami\Ntak bisa lagi memasok garam mata air.
Dialogue: 0,0:14:04.11,0:14:06.91,Default,,0,0,0,,Eh, aku bahkan belum pernah mencicipinya.
Dialogue: 0,0:14:06.91,0:14:08.08,Default,,0,0,0,,Tidak...
Dialogue: 0,0:14:08.08,0:14:11.62,Default,,0,0,0,,Jadi, aku ingin meminta kalian\Nuntuk mengalahkan monster itu.
Dialogue: 0,0:14:11.62,0:14:14.46,Default,,0,0,0,,Tentu saja, kami juga akan\Nmemberikan dukungan semampu kami.
Dialogue: 0,0:14:14.82,0:14:17.71,Default,,0,0,0,,Boleh kami diskusikan dulu?
Dialogue: 0,0:14:17.71,0:14:19.20,Default,,0,0,0,,Tentu saja.
Dialogue: 0,0:14:19.20,0:14:20.92,Default,,0,0,0,,Karena misi ini berbahaya.
Dialogue: 0,0:14:20.92,0:14:23.72,Default,,0,0,0,,Kalau begitu, aku pamit dulu.
Dialogue: 0,0:14:25.43,0:14:26.43,Default,,0,0,0,,Bagaimana?
Dialogue: 0,0:14:26.43,0:14:31.52,Default,,0,0,0,,Di Merlova harusnya juga ada\Npetualang yang cukup hebat.
Dialogue: 0,0:14:31.52,0:14:35.09,Default,,0,0,0,,Apa monster itu sangat kuat sampai bisa\Nmengalahkan mereka semua?
Dialogue: 0,0:14:35.09,0:14:37.48,Default,,0,0,0,,Sepertinya monster itu\Ntidak mudah dilawan.
Dialogue: 0,0:14:37.48,0:14:41.49,Default,,0,0,0,,Selain itu, kita masih harus ke ibu kota.
Dialogue: 0,0:14:41.49,0:14:46.24,Default,,0,0,0,,Tapi, aku ingin kamu mencicipi Ayam Kukus\NEkor Pelangi dengan Garam Mata Air, Rin.
Dialogue: 0,0:14:46.24,0:14:48.95,Default,,0,0,0,,Itu betulan enak.
Dialogue: 0,0:14:48.95,0:14:50.08,Default,,0,0,0,,Benar.
Dialogue: 0,0:14:50.08,0:14:50.77,Default,,0,0,0,,Eh?
Dialogue: 0,0:14:50.77,0:14:52.96,Default,,0,0,0,,Sayang sekali kalau tak pernah mencobanya.
Dialogue: 0,0:14:52.96,0:14:54.83,Default,,0,0,0,,Kalau begitu, kita terima misi ini.
Dialogue: 0,0:14:54.83,0:14:57.84,Default,,0,0,0,,Tunggu, kita tak bisa menerima misi\Nkarena alasan begitu.
Dialogue: 0,0:14:57.84,0:15:01.60,Default,,0,0,0,,Tapi setelah mendengar ceritanya,\Nkita tak bisa mengabaikannya.
Dialogue: 0,0:15:01.60,0:15:04.55,Default,,0,0,0,,Kita juga sadar bahwa ini misi yang sulit.
Dialogue: 0,0:15:04.55,0:15:07.37,Default,,0,0,0,,Kalau ada yang keberatan,\Naku berniat menolaknya.
Dialogue: 0,0:15:07.37,0:15:09.60,Default,,0,0,0,,Tapi tidak ada yang keberatan, kan?
Dialogue: 0,0:15:09.60,0:15:11.25,Default,,0,0,0,,Ta-Tapi...
Dialogue: 0,0:15:11.25,0:15:13.35,Default,,0,0,0,,Rin, kamu keberatan?
Dialogue: 0,0:15:13.35,0:15:16.48,Default,,0,0,0,,Tidak.\NKalau semuanya ikut,
Dialogue: 0,0:15:16.48,0:15:18.06,Default,,0,0,0,,tentu saja aku juga akan ikut.
Dialogue: 0,0:15:18.06,0:15:19.84,Default,,0,0,0,,Kalau begitu, sudah diputuskan.
Dialogue: 0,0:15:19.84,0:15:21.40,Default,,0,0,0,,Aku akan panggil Nona Aigure kemari.
Dialogue: 0,0:15:21.80,0:15:24.71,Default,,0,0,0,,Apa kalian yakin kita mengambil misi ini\Nuntuk alasan seperti itu?
Dialogue: 0,0:15:24.71,0:15:29.24,Default,,0,0,0,,Mungkin saja, ini juga berkaitan\Ndengan Pemanggilan Gadis Suci.
Dialogue: 0,0:15:29.60,0:15:31.91,Default,,0,0,0,,Selain itu, bagiku pergi\Nke ibu kota kerajaan
Dialogue: 0,0:15:31.91,0:15:34.11,Default,,0,0,0,,beberapa hari lebih lambat\Njuga bukan masalah.
Dialogue: 0,0:15:35.79,0:15:37.17,Default,,0,0,0,,Aku hanya bercanda.
Dialogue: 0,0:15:39.54,0:15:41.34,Default,,0,0,0,,Kalau terjadi sesuatu,
Dialogue: 0,0:15:41.34,0:15:44.71,Default,,0,0,0,,utamakan keselamatan nyawa kalian.
Dialogue: 0,0:15:44.71,0:15:47.55,Default,,0,0,0,,Kalau gagal mengalahkannya,\Nkalian tetap akan kami bayar.
Dialogue: 0,0:15:47.55,0:15:50.01,Default,,0,0,0,,Terima kasih atas pengertiannya.
Dialogue: 0,0:15:50.41,0:15:53.89,Default,,0,0,0,,Selain itu,\Nperhatikan juga pembagian stamina.
Dialogue: 0,0:15:53.89,0:15:56.89,Default,,0,0,0,,Perjalanan menuju mata air\Nbanyak tanjakan dan turunannya.
Dialogue: 0,0:15:56.89,0:15:59.35,Default,,0,0,0,,Butuh lima jam kalau dengan berjalan kaki.
Dialogue: 0,0:15:59.35,0:16:02.23,Default,,0,0,0,,Kalau itu, sepertinya bukan masalah.
Dialogue: 0,0:16:05.69,0:16:07.07,Default,,0,0,0,,Meski harus sedikit memutar,
Dialogue: 0,0:16:07.07,0:16:08.99,Default,,0,0,0,,kalau lewat jalan besar seperti ini,
Dialogue: 0,0:16:08.99,0:16:11.83,Default,,0,0,0,,kita harusnya bisa langsung berkendara\Nsampai dekat mata air.
Dialogue: 0,0:16:12.14,0:16:13.66,Default,,0,0,0,,Kalau jalan kaki butuh lima jam,
Dialogue: 0,0:16:13.66,0:16:16.37,Default,,0,0,0,,kita seharusnya bisa sampai\Ndalam sekitar satu jam.
Dialogue: 0,0:16:16.37,0:16:18.04,Default,,0,0,0,,Cepat sekali, ya.
Dialogue: 0,0:16:18.04,0:16:19.29,Default,,0,0,0,,Dari laporan ini,
Dialogue: 0,0:16:19.29,0:16:23.05,Default,,0,0,0,,monster yang muncul di sekitar sini\Nsemua hanya monster kecil berelemen api.
Dialogue: 0,0:16:23.05,0:16:25.84,Default,,0,0,0,,Yang merepotkan adalah bos\Nyang bersarang di mata air.
Dialogue: 0,0:16:25.84,0:16:30.97,Default,,0,0,0,,Tapi laporan saksi mata yang tercatat\Ndalam di situ isinya bermacam-macam.
Dialogue: 0,0:16:30.97,0:16:32.93,Default,,0,0,0,,Jangan-jangan bosnya ada banyak?
Dialogue: 0,0:16:32.93,0:16:33.68,Default,,0,0,0,,Tidak.
Dialogue: 0,0:16:33.68,0:16:36.60,Default,,0,0,0,,Bahkan dalam tim yang sama,\Ntiap orang melihat monster yang berbeda.
Dialogue: 0,0:16:36.60,0:16:38.92,Default,,0,0,0,,Kemungkinan besar itu karena sihir ilusi.
Dialogue: 0,0:16:38.92,0:16:41.02,Default,,0,0,0,,Kedengarannya sangat merepotkan.
Dialogue: 0,0:16:41.02,0:16:42.31,Default,,0,0,0,,Selama kita tahu musuh,
Dialogue: 0,0:16:42.31,0:16:44.11,Default,,0,0,0,,kita bisa mengantisipasinya.
Dialogue: 0,0:16:44.11,0:16:46.86,Default,,0,0,0,,Semoga kita bisa berhasil menaklukkannya.
Dialogue: 0,0:16:46.86,0:16:49.82,Default,,0,0,0,,Nona Aigure juga kelihatan gelisah.
Dialogue: 0,0:16:49.82,0:16:53.74,Default,,0,0,0,,Bagi Merlova, garam dari mata air itu\Nsepertinya sangat penting.
Dialogue: 0,0:16:53.74,0:16:55.33,Default,,0,0,0,,Bukan hanya karena itu saja.
Dialogue: 0,0:16:55.33,0:16:56.45,Default,,0,0,0,,Di lokasi mata air,
Dialogue: 0,0:16:56.45,0:16:59.50,Default,,0,0,0,,di sekitar puncak Gunung Merlova,\Nterdapat wilayah suci.
Dialogue: 0,0:16:59.50,0:17:03.71,Default,,0,0,0,,Merlova memiliki legenda lisan\Nyang telah diwariskan sejak zaman dulu.
Dialogue: 0,0:17:04.67,0:17:06.30,Default,,0,0,0,,Konon, pada zaman kuno,
Dialogue: 0,0:17:06.30,0:17:08.77,Default,,0,0,0,,hidup seekor naga di gunung itu.
Dialogue: 0,0:17:08.77,0:17:12.65,Default,,0,0,0,,Ia suka bermain dengan api dan angin,\Nberlari di antara langit dan Bumi.
Dialogue: 0,0:17:13.12,0:17:15.99,Default,,0,0,0,,Suatu hari, seorang gadis dari desa\Npergi jauh ke dalam gunung
Dialogue: 0,0:17:15.99,0:17:18.12,Default,,0,0,0,,dan keduanya saling beresonansi.
Dialogue: 0,0:17:18.12,0:17:20.35,Default,,0,0,0,,Naga memberi berkah pada gadis itu
Dialogue: 0,0:17:20.35,0:17:22.90,Default,,0,0,0,,dan gadis tersebut menjadi miko.
Dialogue: 0,0:17:22.90,0:17:25.82,Default,,0,0,0,,Singkatnya, puncak Gunung Merlova itu
Dialogue: 0,0:17:25.82,0:17:28.79,Default,,0,0,0,,adalah tempat penting pertemuan\NTuan Naga dan miko.
Dialogue: 0,0:17:28.79,0:17:31.61,Default,,0,0,0,,Jadi, kita tidak boleh\Nmasuk sembarangan, kan?
Dialogue: 0,0:17:31.61,0:17:34.31,Default,,0,0,0,,Lalu sekarang ada monster\Nyang bersarang di sana.
Dialogue: 0,0:17:34.31,0:17:38.33,Default,,0,0,0,,Pasti banyak penganut taat yang khawatir.
Dialogue: 0,0:17:38.33,0:17:39.37,Default,,0,0,0,,Benar juga.
Dialogue: 0,0:17:39.37,0:17:43.03,Default,,0,0,0,,Kalau ada monster yang bersarang di kuil\Ntempat asalku, aku juga pasti marah.
Dialogue: 0,0:17:44.08,0:17:45.82,Default,,0,0,0,,Rin, ada apa?
Dialogue: 0,0:17:45.82,0:17:49.21,Default,,0,0,0,,Rasanya seperti melindas sesuatu.
Dialogue: 0,0:17:49.21,0:17:51.68,Default,,0,0,0,,Oh, itu mungkin Slime Gunung Berapi.
Dialogue: 0,0:17:51.68,0:17:53.55,Default,,0,0,0,,Tapi di laporan kemarin
Dialogue: 0,0:17:53.55,0:17:55.64,Default,,0,0,0,,disebutkan bahwa monster itu beracun?
Dialogue: 0,0:17:55.64,0:17:58.47,Default,,0,0,0,,Kalau sampai bannya rusak,\Nkita akan repot.
Dialogue: 0,0:17:58.47,0:18:00.68,Default,,0,0,0,,Aku akan memeriksanya dulu.
Dialogue: 0,0:18:01.52,0:18:02.81,Default,,0,0,0,,Rin, tunggu.
Dialogue: 0,0:18:03.44,0:18:05.65,Default,,0,0,0,,Sepertinya ada sesuatu di sekitar sini.
Dialogue: 0,0:18:05.65,0:18:07.77,Default,,0,0,0,,Ukurannya lumayan besar.
Dialogue: 0,0:18:14.66,0:18:16.41,Default,,0,0,0,,Kadal itu enak?
Dialogue: 0,0:18:16.41,0:18:17.23,Default,,0,0,0,,Apa?
Dialogue: 0,0:18:17.23,0:18:19.66,Default,,0,0,0,,Sepertinya akan enak kalau dikukus.
Dialogue: 0,0:18:21.15,0:18:23.07,Default,,0,0,0,,Kerja sama yang hebat.
Dialogue: 0,0:18:23.07,0:18:25.83,Default,,0,0,0,,Kita kan Meja Rakus.
Dialogue: 0,0:18:25.83,0:18:28.67,Default,,0,0,0,,Karena kamu bilang enak,\Nkami tak bisa mengabaikannya.
Dialogue: 0,0:18:28.67,0:18:30.96,Default,,0,0,0,,Aku juga tak akan mengabaikannya.
Dialogue: 0,0:18:30.96,0:18:34.26,Default,,0,0,0,,Lagi pula, Rin akan mengolahnya\Njadi makanan enak.
Dialogue: 0,0:18:34.26,0:18:35.47,Default,,0,0,0,,Jadi tidak sabar, ya.
Dialogue: 0,0:18:35.47,0:18:38.43,Default,,0,0,0,,Aku akan berusaha memenuhi harapan kalian!
Dialogue: 0,0:18:39.26,0:18:41.39,Default,,0,0,0,,Cocoknya dikukus, ya?
Dialogue: 0,0:18:41.39,0:18:43.77,Default,,0,0,0,,Tapi aku tidak punya kukusan.
Dialogue: 0,0:18:43.77,0:18:46.10,Default,,0,0,0,,Apa pakai panci dan piring saja?
Dialogue: 0,0:18:46.10,0:18:48.69,Default,,0,0,0,,Bagaimana kalau dikukus\Npakai mata air uap?
Dialogue: 0,0:18:48.69,0:18:50.11,Default,,0,0,0,,Mata air uap?
Dialogue: 0,0:18:50.11,0:18:52.32,Default,,0,0,0,,Itu lubang yang mengeluarkan uap.
Dialogue: 0,0:18:52.32,0:18:54.51,Default,,0,0,0,,Harusnya ada di sekitar sini.
Dialogue: 0,0:18:54.51,0:18:56.91,Default,,0,0,0,,Jadi kita bisa langsung\Nmengukusnya di sana, kan?
Dialogue: 0,0:18:57.98,0:19:00.24,Default,,0,0,0,,Restoran kemarin juga menyediakan itu, kan?
Dialogue: 0,0:19:00.24,0:19:01.83,Default,,0,0,0,,Ide bagus!
Dialogue: 0,0:19:01.83,0:19:03.46,Default,,0,0,0,,Aku sudah lama ingin mencoba
Dialogue: 0,0:19:03.46,0:19:05.83,Default,,0,0,0,,masakan luar ruangan dan penuh nuansa alam.
Dialogue: 0,0:19:05.83,0:19:08.00,Default,,0,0,0,,Kalau begitu,\Nsetelah menemukan mata air uap,
Dialogue: 0,0:19:08.00,0:19:09.84,Default,,0,0,0,,kita istirahat sebentar sambil makan siang.
Dialogue: 0,0:19:09.84,0:19:11.34,Default,,0,0,0,,Sudah diputuskan.
Dialogue: 0,0:19:16.83,0:19:18.72,Default,,0,0,0,,Apa ini sudah cukup, kan?
Dialogue: 0,0:19:20.83,0:19:22.27,Default,,0,0,0,,Dasar...
Dialogue: 0,0:19:22.27,0:19:24.52,Default,,0,0,0,,Kenapa aku diangkat?
Dialogue: 0,0:19:24.52,0:19:26.90,Default,,0,0,0,,Di sana hangat dan nyaman.
Dialogue: 0,0:19:26.90,0:19:30.07,Default,,0,0,0,,Aku tahu kamu nyaman,\Ntapi kalau kelamaan,
Dialogue: 0,0:19:30.07,0:19:32.53,Default,,0,0,0,,nanti bisa kena luka bakar suhu rendah.
Dialogue: 0,0:19:32.53,0:19:35.78,Default,,0,0,0,,Aku tak akan langsung terbakar seperti itu!
Dialogue: 0,0:19:35.78,0:19:38.07,Default,,0,0,0,,Kalau begitu, sambil menunggu\Nmengukusnya beres,
Dialogue: 0,0:19:38.07,0:19:40.41,Default,,0,0,0,,aku akan buat saus tambahan.
Dialogue: 0,0:19:40.41,0:19:41.12,Default,,0,0,0,,Rin.
Dialogue: 0,0:19:41.69,0:19:43.04,Default,,0,0,0,,Kenapa?
Dialogue: 0,0:19:43.04,0:19:44.83,Default,,0,0,0,,Saus tartar.\NBuat saus tartar tidak?
Dialogue: 0,0:19:44.83,0:19:46.21,Default,,0,0,0,,Oh.
Dialogue: 0,0:19:46.21,0:19:50.04,Default,,0,0,0,,Sepertinya Aria juga sudah jatuh\Nke sisi gelap saus tartar?
Dialogue: 0,0:19:50.04,0:19:51.71,Default,,0,0,0,,Ada yang menyebut saus tartar?
Dialogue: 0,0:19:51.71,0:19:52.71,Default,,0,0,0,,Mau buat saus tartar?
Dialogue: 0,0:19:52.71,0:19:53.96,Default,,0,0,0,,Itu ide bagus!
Dialogue: 0,0:19:53.96,0:19:56.51,Default,,0,0,0,,Saus itu sepertinya juga cocok\Ndengan hidangan kukus.
Dialogue: 0,0:19:56.51,0:19:59.72,Default,,0,0,0,,Kalian semua sudah menjadi\Ntawanan saus tartar, ya.
Dialogue: 0,0:19:59.72,0:20:02.14,Default,,0,0,0,,Tapi, maaf. Hari ini aku akan\Nmembuat saus lain.
Dialogue: 0,0:20:02.64,0:20:03.60,Default,,0,0,0,,Saus lain?
Dialogue: 0,0:20:03.60,0:20:05.31,Default,,0,0,0,,Coba kupikirkan.
Dialogue: 0,0:20:05.31,0:20:07.44,Default,,0,0,0,,Mau coba saus mayones pedas ringan?
Dialogue: 0,0:20:07.44,0:20:09.10,Default,,0,0,0,,Saus mayones?
Dialogue: 0,0:20:09.10,0:20:11.44,Default,,0,0,0,,Saus agak pedas\Nyang terbuat dari mayones.
Dialogue: 0,0:20:11.44,0:20:13.28,Default,,0,0,0,,Mayones.
Dialogue: 0,0:20:13.28,0:20:16.61,Default,,0,0,0,,Mayones... itu saus mengerikan!
Dialogue: 0,0:20:16.61,0:20:20.37,Default,,0,0,0,,Kali ini kita pakai mayones premium\Nyang kaya rasa dan gurih manis.
Dialogue: 0,0:20:20.37,0:20:23.70,Default,,0,0,0,,Ditambah dengan miso khas daerah\Nhasil fermentasi dari tempat asalku,
Dialogue: 0,0:20:23.70,0:20:27.12,Default,,0,0,0,,lalu shichimi togarashi, bumbu terkenal\Ndari pemandian air panas desaku.
Dialogue: 0,0:20:27.12,0:20:29.71,Default,,0,0,0,,Di tempat asalmu juga ada\Npemandian air panas?
Dialogue: 0,0:20:29.71,0:20:31.50,Default,,0,0,0,,Iya, ada!
Dialogue: 0,0:20:31.50,0:20:33.46,Default,,0,0,0,,Jadi, masakan kali ini
Dialogue: 0,0:20:33.46,0:20:37.47,Default,,0,0,0,,bisa dibilang kolaborasi antara isekai\Ndan pemandian air panas tempat asalku.
Dialogue: 0,0:20:42.64,0:20:43.43,Default,,0,0,0,,Selanjutnya...
Dialogue: 0,0:20:43.43,0:20:46.98,Default,,0,0,0,,Buat satu lagi saus asam manis?
Dialogue: 0,0:20:46.98,0:20:48.98,Default,,0,0,0,,Mayones saja sudah enak.
Dialogue: 0,0:20:48.98,0:20:51.23,Default,,0,0,0,,Malah buat saus lain juga.\NKamu kejam!
Dialogue: 0,0:20:51.23,0:20:53.03,Default,,0,0,0,,Nanti kami kebanyakan makan!
Dialogue: 0,0:20:54.15,0:20:55.98,Default,,0,0,0,,Tinggal bilang saja!
Dialogue: 0,0:20:55.98,0:21:01.03,Default,,0,0,0,,Akan kubuktikan bahwa nafsu makan itu\Nselalu mengalahkan akal sehat!
Dialogue: 0,0:21:01.03,0:21:03.62,Default,,0,0,0,,Bisa tolong berhenti menjaili istriku?
Dialogue: 0,0:21:03.62,0:21:06.41,Default,,0,0,0,,Tidak... aku hanya bercanda.
Dialogue: 0,0:21:06.41,0:21:09.25,Default,,0,0,0,,Oh, bahan yang dikukus di luar\Nsepertinya sudah matang.
Dialogue: 0,0:21:09.75,0:21:11.46,Default,,0,0,0,,Tunggu, Rin.\NJangan keluar sendiri.
Dialogue: 0,0:21:11.46,0:21:13.46,Default,,0,0,0,,Di sini penuh monster!
Dialogue: 0,0:21:13.46,0:21:15.34,Default,,0,0,0,,Oh, iya, maaf...
Dialogue: 0,0:21:16.46,0:21:17.55,Default,,0,0,0,,Rin!
Dialogue: 0,0:21:21.76,0:21:22.51,Default,,0,0,0,,Aku...
Dialogue: 0,0:21:22.51,0:21:23.68,Default,,0,0,0,,Aku juga mau...
Dialogue: 0,0:21:23.68,0:21:24.80,Default,,0,0,0,,Aku juga mau ikut.
Dialogue: 0,0:21:33.02,0:21:35.07,Default,,0,0,0,,Di sini hangat dan nyaman, ya.
Dialogue: 0,0:21:35.07,0:21:37.26,Default,,0,0,0,,Tapi agak bau belerang.
Dialogue: 0,0:21:37.26,0:21:39.44,Default,,0,0,0,,Meski sangat nyaman,
Dialogue: 0,0:21:39.44,0:21:42.45,Default,,0,0,0,,sepertinya ada sesuatu\Nyang terus menyentuh wajahku.
Dialogue: 0,0:21:48.56,0:21:50.54,Default,,0,0,0,,Akhirnya kamu bangun?
Dialogue: 0,0:21:50.54,0:21:53.71,Default,,0,0,0,,Padahal kamu dikirim kemari\Nuntuk menjadi pelayan selir,
Dialogue: 0,0:21:53.71,0:21:56.50,Default,,0,0,0,,tapi kamu ini ceroboh sekali.
Dialogue: 0,0:21:56.50,0:21:58.46,Default,,0,0,0,,Pelayan?
