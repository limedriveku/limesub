Dialogue: 0,0:00:00.52,0:00:02.15,sign,,0000,0000,0000,,KOMITE PRODUKSI BARA OTOME
Dialogue: 0,0:00:05.93,0:00:06.40,sign,,0000,0000,0000,,AAAA, SERANG, SIHIR, ITEM, KABUR
Dialogue: 0,0:00:06.40,0:00:06.74,sign,,0000,0000,0000,,AAAA: BAGAIMANA INI, TAKUT...
Dialogue: 0,0:00:06.74,0:00:07.74,sign,,0000,0000,0000,,ASYLUM: PERCAYA PADAKU! AYO!
Dialogue: 0,0:00:07.74,0:00:09.41,sign,,0000,0000,0000,,AAAA: AKU MENGERTI, RASAKAN INI!
Dialogue: 0,0:00:09.41,0:00:13.20,sign,,0000,0000,0000,,CERES: MAKSUDNYA KAMU MENGAJAKKU KENCAN?
Dialogue: 0,0:01:17.43,0:01:23.48,sign,,0000,0000,0000,,THE FORSAKEN SAINTESS\NAND HER FOODIE ROADTRIP IN ANOTHER WORLD
Dialogue: 0,0:02:24.00,0:02:26.13,sign,,0000,0000,0000,,EPISODE 11:
Dialogue: 0,0:02:26.13,0:02:27.46,sign,,0000,0000,0000,,ROTI LAPIS KUBA TENGAH MALAM
Dialogue: 0,0:02:27.46,0:02:29.67,sign,,0000,0000,0000,,ADALAH RASA DOSA
Dialogue: 0,0:04:53.40,0:04:54.52,sign,,0000,0000,0000,,NOBARA NO OTOME, KLIK UNTUK MEMULAI
Dialogue: 0,0:23:34.98,0:23:36.31,sign,,0000,0000,0000,,EPISODE 12:\NKERJA BAGUS DAN MARI MAKAN KARI!
Dialogue: 0,0:23:36.31,0:23:38.86,sign,,0000,0000,0000,,PETUALANGAN KITA\NAKAN TERUS BERLANJUT KE MANA PUN!
Dialogue: 0,0:00:00.52,0:00:02.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nobara No Otome.
Dialogue: 0,0:00:02.15,0:00:05.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lakon gim ini dipanggil ke isekai\Nsebagai Gadis Suci.
Dialogue: 0,0:00:05.93,0:00:07.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan mengalahkan monster
Dialogue: 0,0:00:07.74,0:00:09.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bersama para pria tampan
Dialogue: 0,0:00:09.41,0:00:10.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau berkencan,
Dialogue: 0,0:00:10.45,0:00:13.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menambah XP, dan mempererat keintiman.
Dialogue: 0,0:00:13.20,0:00:17.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gim otome yang bertujuan\Nmencapai akhir bahagia.
Dialogue: 0,0:00:18.00,0:00:20.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tiba di ibu kota\Ndan bertemu kakaknya Ville,
Dialogue: 0,0:00:20.50,0:00:21.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Noah.
Dialogue: 0,0:00:21.56,0:00:24.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata, dia adalah reinkarnator isekai.
Dialogue: 0,0:00:24.55,0:00:28.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum bereinkarnasi, dia karyawan perusahaan\Nyang membuat gim Nobara No Otome.
Dialogue: 0,0:00:28.17,0:00:32.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, dia memberitahuku kebenaran\Ntentang dunia ini.
Dialogue: 0,0:00:32.25,0:00:34.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata, dunia ini
Dialogue: 0,0:00:34.85,0:00:37.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah dunia dari gim otome\NNobara No Otome.
Dialogue: 0,0:00:37.85,0:00:40.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua petualangan yang kujalani\Nbersama teman-teman Meja Rakus
Dialogue: 0,0:00:40.52,0:00:43.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanyalah rangkaian cerita di dalam gim.
Dialogue: 0,0:00:44.61,0:00:45.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar.
Dialogue: 0,0:00:45.61,0:00:48.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan nasibku\Nyang langsung dibuang
Dialogue: 0,0:00:48.15,0:00:49.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}setelah dipanggil ke dunia ini?
Dialogue: 0,0:00:50.95,0:00:53.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal itu pun akan kujelaskan semuanya.
Dialogue: 0,0:02:24.00,0:02:27.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di gim ini, tujuan akhir Gadis Suci
Dialogue: 0,0:02:27.46,0:02:29.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah mengalahkanku.
Dialogue: 0,0:02:29.67,0:02:32.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menyampaikan hal sepenting ini\Ndengan entengnya.
Dialogue: 0,0:02:32.26,0:02:34.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar kamu kaget mendengarnya.
Dialogue: 0,0:02:34.59,0:02:37.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, sambil mendengarkan penjelasanku,
Dialogue: 0,0:02:37.93,0:02:39.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}silakan nikmati camilannya.
Dialogue: 0,0:02:39.39,0:02:40.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:02:41.18,0:02:42.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat makan.
Dialogue: 0,0:02:44.10,0:02:45.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudapan ini
Dialogue: 0,0:02:45.10,0:02:49.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sama sekali tidak ada kehalusannya,\Nhanya rasa manis yang berlebihan.
Dialogue: 0,0:02:49.11,0:02:53.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembuatnya asal menambahkan\Npemanis mahal agar terkesan mewah.
Dialogue: 0,0:02:53.86,0:02:55.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar.
Dialogue: 0,0:02:55.28,0:02:59.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perjuangan produsen kue Jepang\Nmemang hebat, ya.
Dialogue: 0,0:03:01.20,0:03:04.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku sudah terbiasa.
Dialogue: 0,0:03:04.00,0:03:07.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, aku masih merindukan\Ncita rasa Jepang.
Dialogue: 0,0:03:09.04,0:03:12.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin makan kari atau ramen\Ndengan rasa yang biasa saja.
Dialogue: 0,0:03:12.59,0:03:14.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya, tiap kali lihat laporan Ville
Dialogue: 0,0:03:14.51,0:03:16.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tentang masakan yang kamu buat,
Dialogue: 0,0:03:16.68,0:03:19.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sangat iri!
Dialogue: 0,0:03:20.79,0:03:23.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, kita malah keluar topik.
Dialogue: 0,0:03:23.10,0:03:24.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm...
Dialogue: 0,0:03:24.56,0:03:29.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konflik antara manusia dan ras submanusia\Ndi dunia gim ini masih sangat parah.
Dialogue: 0,0:03:29.61,0:03:31.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana pendapatmu sejauh ini?
Dialogue: 0,0:03:31.07,0:03:33.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:03:33.19,0:03:36.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku, semuanya terlihat rukun.
Dialogue: 0,0:03:36.15,0:03:38.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Ville pernah cerita
Dialogue: 0,0:03:38.45,0:03:41.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahwa dulu manusia sangat\Nmendiskriminasi ras submanusia.
Dialogue: 0,0:03:41.58,0:03:47.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya kelompok yang menentang\Nmenyeberangi laut dan mendirikan negara ini.
Dialogue: 0,0:03:47.12,0:03:48.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tepat sekali.
Dialogue: 0,0:03:48.50,0:03:52.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Adikku memang hebat,\Ndia melakukan tugasnya dengan baik.
Dialogue: 0,0:03:52.50,0:03:54.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat membahas Ville,
Dialogue: 0,0:03:54.34,0:03:57.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ekspresi wajahnya langsung senang.
Dialogue: 0,0:03:57.18,0:03:59.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya, karena itulah
Dialogue: 0,0:03:59.14,0:04:01.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Risfield dalam gim ini
Dialogue: 0,0:04:01.05,0:04:04.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}diatur sebagai negara monster\Ndan ras submanusia yang membenci manusia.
Dialogue: 0,0:04:05.22,0:04:08.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, raja di negeri ini, yaitu diriku,
Dialogue: 0,0:04:08.73,0:04:11.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berperan sebagai Raja Iblis.
Dialogue: 0,0:04:11.11,0:04:13.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi itu alasan Gadis Suci...
Dialogue: 0,0:04:13.15,0:04:16.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, negara ini sama sekali\Ntidak terasa seperti itu.
Dialogue: 0,0:04:16.94,0:04:19.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, itu cerita zaman dulu.
Dialogue: 0,0:04:19.45,0:04:21.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti reinkarnator lainnya,
Dialogue: 0,0:04:21.66,0:04:24.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku juga susah payah menjalankan\Ndiplomasi sebelum naik takhta
Dialogue: 0,0:04:24.87,0:04:27.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}demi meluruskan kesalahpahaman negara lain.
Dialogue: 0,0:04:28.54,0:04:30.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sudah tahu alur cerita gimnya,
Dialogue: 0,0:04:30.88,0:04:33.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu tetap hebat\Nkarena langsung bertindak.
Dialogue: 0,0:04:33.67,0:04:37.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Gadis Suci tetap saja dipanggil.
Dialogue: 0,0:04:37.42,0:04:41.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini memang alur cerita\Nyang sudah klise?
Dialogue: 0,0:04:41.68,0:04:44.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi begitu.\NSekarang semuanya masuk akal.
Dialogue: 0,0:04:44.47,0:04:45.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya?
Dialogue: 0,0:04:45.68,0:04:49.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya, pemanggilan Gadis Suci\Nmenjadi pemicu
Dialogue: 0,0:04:49.52,0:04:53.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kekacauan monster akhir-akhir ini.
Dialogue: 0,0:04:54.52,0:04:58.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kata lain,\Ngimnya sudah dimulai, ya?
Dialogue: 0,0:04:58.15,0:04:59.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, Rin.
Dialogue: 0,0:04:59.86,0:05:01.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peranmu sangat penting.
Dialogue: 0,0:05:01.36,0:05:02.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:05:02.66,0:05:05.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu adalah anomali ritual\Npemanggilan Gadis Suci
Dialogue: 0,0:05:05.49,0:05:06.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang seharusnya satu orang.
Dialogue: 0,0:05:06.74,0:05:08.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu yang melakukannya,
Dialogue: 0,0:05:08.29,0:05:11.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku yakin rencana Gadis Suci\Nbisa dihentikan.
Dialogue: 0,0:05:11.12,0:05:13.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu maksudmu, kamu juga anomali.
Dialogue: 0,0:05:13.46,0:05:18.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Status dan peranku terbatas karena terikat\Nsebagai karakter penting.
Dialogue: 0,0:05:18.34,0:05:22.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlebih, kamu berhasil menggagalkan\Nmisi peningkatan level Gadis Suci.
Dialogue: 0,0:05:22.80,0:05:24.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peningkatan level?
Dialogue: 0,0:05:24.30,0:05:27.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menjelaskan bahwa Gadis Suci\Nnaik level dengan menyelesaikan misi
Dialogue: 0,0:05:27.89,0:05:32.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menjadi kuat dengan meningkatkan\Nkeintiman bersama rekan pria tampan.
Dialogue: 0,0:05:32.52,0:05:34.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pasti paham maksudku, kan?
Dialogue: 0,0:05:35.77,0:05:38.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengalaman, tingkat keintiman,\Nsampai barang yang didapat...
Dialogue: 0,0:05:38.65,0:05:40.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya hangus begitu saja.
Dialogue: 0,0:05:40.53,0:05:43.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya, aku sangat senang\Nsaat mendengar laporannya!
Dialogue: 0,0:05:44.87,0:05:47.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu apakah Gadis Suci
Dialogue: 0,0:05:47.16,0:05:49.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang dipanggil bersamaku\Npaham tentang gim ini...
Dialogue: 0,0:05:49.91,0:05:52.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau tak bisa naik level\Ndan meningkatkan keintiman...
Dialogue: 0,0:05:52.75,0:05:54.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesannya ini seperti gim ampas, ya?
Dialogue: 0,0:05:54.46,0:05:57.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedangkan bagiku,\Naku justru ingin memastikan
Dialogue: 0,0:05:57.50,0:06:00.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau gim ini memang sangat ampas.
Dialogue: 0,0:06:01.67,0:06:04.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu ucapan yang pantas dikatakan\Noleh karyawan perusahaan gim?
Dialogue: 0,0:06:04.72,0:06:06.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga belum ingin mati
Dialogue: 0,0:06:06.97,0:06:10.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tak mau terlibat konflik\Nmanusia dan ras submanusia saat ini.
Dialogue: 0,0:06:11.89,0:06:14.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, bagaimana caramu\Nmemastikan gim ini ampas?
Dialogue: 0,0:06:14.10,0:06:16.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merebut misi penting Gadis Suci.
Dialogue: 0,0:06:16.52,0:06:17.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin Meja Rakus
Dialogue: 0,0:06:17.98,0:06:20.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengambil alih dua misi penting.
Dialogue: 0,0:06:20.90,0:06:25.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu, Ville dan yang lainnya\Njuga karakter target Gadis Suci?
Dialogue: 0,0:06:25.53,0:06:27.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dikelilingi pria tampan dan wanita cantik.
Dialogue: 0,0:06:27.62,0:06:31.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku, HP-ku pasti terkuras habis.
Dialogue: 0,0:06:31.16,0:06:33.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengaturan karakter mereka\Njuga sangat kuat.
Dialogue: 0,0:06:40.55,0:06:42.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar!
Dialogue: 0,0:06:42.72,0:06:44.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu meninggalkanku lagi?
Dialogue: 0,0:06:44.88,0:06:45.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kejam!
Dialogue: 0,0:06:45.80,0:06:47.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya maaf, aku yang salah.
Dialogue: 0,0:06:47.72,0:06:50.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?\NApa dia merundungmu?
Dialogue: 0,0:06:50.77,0:06:52.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf membiarkanmu masuk sendirian.
Dialogue: 0,0:06:52.43,0:06:54.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajahmu terlihat agak pucat.
Dialogue: 0,0:06:54.89,0:06:56.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku baik-baik saja.
Dialogue: 0,0:06:56.48,0:06:59.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang,\Nkami akan selalu menemanimu.
Dialogue: 0,0:06:59.02,0:07:00.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak perlu khawatir.
Dialogue: 0,0:07:00.40,0:07:01.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:07:01.61,0:07:03.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sangat disayang, ya, Rin.
Dialogue: 0,0:07:03.65,0:07:06.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau aku tidak layak dipercaya oleh kalian?
Dialogue: 0,0:07:07.37,0:07:09.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan curiga begitu.
Dialogue: 0,0:07:09.08,0:07:11.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak melakukan apa pun.
Dialogue: 0,0:07:11.08,0:07:12.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang dia bilang itu benar, Ville.
Dialogue: 0,0:07:12.62,0:07:16.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja, terlalu banyak informasi\Nmembuat kepalaku pusing.
Dialogue: 0,0:07:16.33,0:07:18.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:07:18.17,0:07:20.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kesalahpahamannya sudah teratasi?
Dialogue: 0,0:07:20.46,0:07:22.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izinkan aku mengatakannya sekali lagi.
Dialogue: 0,0:07:28.76,0:07:30.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang kembali, Ville!
Dialogue: 0,0:07:30.43,0:07:31.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya kamu pulang juga.
Dialogue: 0,0:07:34.27,0:07:35.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lepaskan aku, Kakak!
Dialogue: 0,0:07:35.81,0:07:37.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kamu masih terlihat antusias.
Dialogue: 0,0:07:37.85,0:07:39.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu kalau lengah sedikit saja,
Dialogue: 0,0:07:39.48,0:07:41.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu pasti langsung bertindak ceroboh.
Dialogue: 0,0:07:41.27,0:07:44.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sudah memakai\Nkekuatan Naga Iblis,
Dialogue: 0,0:07:44.49,0:07:46.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku masih sulit lepas darinya!
Dialogue: 0,0:07:46.11,0:07:50.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah menemani adikku\Nyang kabur dari rumah dan suka buat ulah.
Dialogue: 0,0:07:50.95,0:07:53.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari dulu dia selalu ceroboh.
Dialogue: 0,0:07:53.87,0:07:56.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lengah sedikit saja,\Nmasalah pasti akan datang.
Dialogue: 0,0:07:56.46,0:07:58.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat mengkhawatirkannya.
Dialogue: 0,0:07:58.96,0:08:01.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dia begitu hanya pada Ville saja.\N- Apa? Hei, hentikan!
Dialogue: 0,0:08:01.42,0:08:03.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tapi sebagai raja, dia sangat cerdas.\N- Jangan selalu menganggapku bocah!
Dialogue: 0,0:08:03.71,0:08:06.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Baginda Raja sangat menyayangi Ville.\N- Lepaskan aku!
Dialogue: 0,0:08:06.30,0:08:08.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Singkatnya, dia sangat sayang pada adiknya.
Dialogue: 0,0:08:10.05,0:08:14.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini juga salah satu alasan\NVille tidak ingin pulang.
Dialogue: 0,0:08:21.36,0:08:23.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang tertulis\Ndi sini itu benar, Kakak?
Dialogue: 0,0:08:23.94,0:08:24.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:08:24.73,0:08:26.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah menerima laporanmu,
Dialogue: 0,0:08:26.52,0:08:29.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku menyuruh Pasukan Bayangan menyelidiki\Nhasil Pemanggilan Gadis Suci.
Dialogue: 0,0:08:29.57,0:08:31.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konon rombongan Gadis Suci
Dialogue: 0,0:08:31.74,0:08:34.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}telah menyeberangi laut\Ndan mendarat di negeri ini.
Dialogue: 0,0:08:34.62,0:08:36.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuan akhir mereka
Dialogue: 0,0:08:36.87,0:08:38.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah memenggal kepala Raja Iblis,
Dialogue: 0,0:08:38.71,0:08:40.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yaitu kepalaku.
Dialogue: 0,0:08:42.46,0:08:45.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para dalangnya adalah keluarga kerajaan\Ndan bangsawan berpangkat tinggi.
Dialogue: 0,0:08:45.63,0:08:49.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka semua anak ketiga\Ndan menganut supremasi manusia?
Dialogue: 0,0:08:49.30,0:08:52.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya mereka gagal menjadi pewaris
Dialogue: 0,0:08:52.18,0:08:55.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan terhasut Pemanggilan Gadis Suci\Nyang mencurigakan itu.
Dialogue: 0,0:08:55.85,0:08:59.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mendengar mereka menganut\Nsupremasi manusia membuatku kesal.
Dialogue: 0,0:08:59.77,0:09:01.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang dulu.
Dialogue: 0,0:09:01.02,0:09:02.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang akan kamu lakukan?
Dialogue: 0,0:09:02.69,0:09:05.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bukan tipe orang yang akan\Nmenyerah begitu saja, kan?
Dialogue: 0,0:09:05.36,0:09:06.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:09:06.59,0:09:09.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak hanya mengirim\NPasukan Bayangan untuk mengawasi,
Dialogue: 0,0:09:09.03,0:09:11.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sudah menyusun strategi\Nyang jelas juga.
Dialogue: 0,0:09:11.74,0:09:12.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu,
Dialogue: 0,0:09:12.99,0:09:15.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada dua hal yang ingin kupercayakan\Npada kalian, Meja Rakus.
Dialogue: 0,0:09:15.79,0:09:16.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memercayakan pada kami?
Dialogue: 0,0:09:16.99,0:09:19.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Rin sudah menyetujuinya tadi.
Dialogue: 0,0:09:21.29,0:09:24.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, kamu betulan\Ntidak dirundung olehnya, kan?
Dialogue: 0,0:09:24.25,0:09:26.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak sama sekali.
Dialogue: 0,0:09:26.38,0:09:29.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah memutuskan sendiri\Ntanpa diskusi dengan kalian.
Dialogue: 0,0:09:29.26,0:09:31.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kekacauan monster\Nyang terjadi akhir-akhir ini,
Dialogue: 0,0:09:31.97,0:09:34.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sepertinya memang dipengaruhi\Noleh Pemanggilan Gadis Suci.
Dialogue: 0,0:09:34.97,0:09:38.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai orang yang terlibat,\Naku merasa ikut bertanggung jawab.
Dialogue: 0,0:09:38.56,0:09:39.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak...
Dialogue: 0,0:09:39.89,0:09:42.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ritual pemanggilan merekalah\Nyang menyeretmu ke dalam masalah ini!
Dialogue: 0,0:09:42.77,0:09:44.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak melakukan kesalahan apa pun.
Dialogue: 0,0:09:44.65,0:09:47.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, Rin tidak salah.
Dialogue: 0,0:09:47.07,0:09:48.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya...
Dialogue: 0,0:09:48.57,0:09:51.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mengkhawatirkan kakakku, ya?
Dialogue: 0,0:09:51.49,0:09:53.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah merepotkanmu.
Dialogue: 0,0:09:53.70,0:09:56.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, bisa dibilang begitu.
Dialogue: 0,0:09:56.41,0:09:59.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, kami akan menerima misi ini.
Dialogue: 0,0:09:59.16,0:10:01.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau manusia dan submanusia\Nkembali bermusuhan,
Dialogue: 0,0:10:01.91,0:10:03.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu sudah bukan masalah ringan!
Dialogue: 0,0:10:06.21,0:10:08.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya bisa lega.
Dialogue: 0,0:10:08.21,0:10:11.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, mari konfirmasi ulang\Npermintaan misinya.
Dialogue: 0,0:10:11.09,0:10:12.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konon, di desa dekat ibu kota,
Dialogue: 0,0:10:12.93,0:10:16.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}setiap malam selalu terlihat\Nbayangan hitam misterius raksasa.
Dialogue: 0,0:10:16.26,0:10:19.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus menyelidikinya\Ndan membasminya kalau perlu.
Dialogue: 0,0:10:19.93,0:10:21.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, kan, Rin?
Dialogue: 0,0:10:21.35,0:10:23.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, dia memang bilang begitu.
Dialogue: 0,0:10:23.06,0:10:26.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejauh ini, belum menimbulkan\Nkerusakan langsung,
Dialogue: 0,0:10:26.02,0:10:28.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi seluruh warga desa\Nsudah sangat cemas.
Dialogue: 0,0:10:28.65,0:10:30.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan mereka sampai sulit tidur.
Dialogue: 0,0:10:30.23,0:10:35.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit tidur sama sakitnya dengan kelaparan.
Dialogue: 0,0:10:35.87,0:10:37.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut beberapa dokumen,
Dialogue: 0,0:10:37.70,0:10:41.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemanggilan Gadis Suci tampaknya membentuk\Nseperti titik energi di berbagai tempat
Dialogue: 0,0:10:41.50,0:10:44.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk memperkuat kekuatan Gadis Suci.
Dialogue: 0,0:10:44.58,0:10:48.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk hal detailnya,\Naku juga tidak tahu seperti apa bentuknya.
Dialogue: 0,0:10:48.17,0:10:50.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kita harus menekan\NGadis Suci terlebih dulu
Dialogue: 0,0:10:50.59,0:10:52.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebelum kekuatannya meningkat?
Dialogue: 0,0:10:52.59,0:10:53.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:10:53.84,0:10:55.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:10:55.13,0:10:58.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa misi yang satunya juga seperti ini?
Dialogue: 0,0:10:58.05,0:11:00.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk hal itu,
Dialogue: 0,0:11:00.18,0:11:03.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita bisa memutuskannya\Nsetelah misi ini selesai.
Dialogue: 0,0:11:03.31,0:11:04.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin?
Dialogue: 0,0:11:04.18,0:11:06.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada sesuatu yang lewat.
Dialogue: 0,0:11:06.31,0:11:08.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sangat arogan.
Dialogue: 0,0:11:09.27,0:11:11.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa itu mereka?
Dialogue: 0,0:11:11.53,0:11:12.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinan besar iya.
Dialogue: 0,0:11:12.53,0:11:14.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, kita kejar mereka.
Dialogue: 0,0:11:23.62,0:11:26.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi itu... suara teriakan?
Dialogue: 0,0:11:26.08,0:11:28.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu menjatuhkanku?
Dialogue: 0,0:11:28.25,0:11:30.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peluk aku lebih erat lagi!
Dialogue: 0,0:11:30.67,0:11:33.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka terlihat seperti Kelelawar Raksasa.
Dialogue: 0,0:11:33.13,0:11:36.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita kumpulkan informasi\Ndi desa itu dulu.
Dialogue: 0,0:11:36.05,0:11:38.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, ayo berangkat.
Dialogue: 0,0:11:42.60,0:11:44.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti yang kalian lihat,
Dialogue: 0,0:11:44.02,0:11:48.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bayangan hitam itu beterbangan\Ndi sekitar desa sepanjang malam.
Dialogue: 0,0:11:48.10,0:11:53.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejauh ini, belum ada penduduk\Natau ternak yang diserang.
Dialogue: 0,0:11:53.07,0:11:55.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi mereka bisa menyerang kapan saja.
Dialogue: 0,0:11:55.32,0:11:58.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketakutan seperti ini\Nmemang sulit untuk ditahan.
Dialogue: 0,0:11:58.07,0:12:00.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepanjang hari dalam kondisi waspada
Dialogue: 0,0:12:00.45,0:12:01.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membuat sulit untuk beristirahat.
Dialogue: 0,0:12:01.91,0:12:04.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenaga dan mental pun pasti terkuras.
Dialogue: 0,0:12:04.08,0:12:07.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para orang dewasa masih bisa bertahan,
Dialogue: 0,0:12:07.16,0:12:09.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi anak-anak sudah tak sanggup.
Dialogue: 0,0:12:10.88,0:12:14.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak juga peka terhadap\Nrasa cemas di sekitar mereka
Dialogue: 0,0:12:14.17,0:12:15.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan akhirnya ikut terpengaruh.
Dialogue: 0,0:12:15.80,0:12:19.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kami sudah pasrah mengajukan\Npermohonan ke ibu kota,
Dialogue: 0,0:12:19.59,0:12:21.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian semua bersedia datang ke sini.
Dialogue: 0,0:12:21.55,0:12:23.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:12:23.06,0:12:26.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami dari Meja Rakus sudah menerima misi ini.
Dialogue: 0,0:12:26.14,0:12:27.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada yang janggal,
Dialogue: 0,0:12:27.64,0:12:30.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}meski itu hal kecil,\Nlangsung laporkan pada kami.
Dialogue: 0,0:12:30.15,0:12:31.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik.
Dialogue: 0,0:12:31.48,0:12:33.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata pemuda desa,
Dialogue: 0,0:12:33.86,0:12:35.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pertama kali terjadi keanehan...
Dialogue: 0,0:12:35.57,0:12:38.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah aku dipanggil kemari,
Dialogue: 0,0:12:38.07,0:12:40.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}para makhluk raksasa ini pun muncul.
Dialogue: 0,0:12:40.82,0:12:44.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya Pemanggilan Gadis Suci memang\Nmenjadi syarat pemicu untuk alur cerita.
Dialogue: 0,0:12:45.24,0:12:46.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mbak.
Dialogue: 0,0:12:47.04,0:12:49.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mbak, kalian juga petualang?
Dialogue: 0,0:12:49.83,0:12:51.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dipanggil Mbak meski usiaku sudah 30-an.
Dialogue: 0,0:12:51.71,0:12:52.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia anak baik.
Dialogue: 0,0:12:52.92,0:12:54.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal.
Dialogue: 0,0:12:54.67,0:12:57.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Rin, juru masak dari Meja Rakus.
Dialogue: 0,0:12:58.30,0:13:00.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Aria, dari tim yang sama.
Dialogue: 0,0:13:00.38,0:13:02.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada aku juga!
Dialogue: 0,0:13:02.34,0:13:05.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku, tugasnya hanya menjadi imut.
Dialogue: 0,0:13:05.35,0:13:06.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak kucing!
Dialogue: 0,0:13:06.81,0:13:08.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Imut.\N- Aku memang imut.
Dialogue: 0,0:13:08.64,0:13:09.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat imut.
Dialogue: 0,0:13:10.98,0:13:14.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kalian akan membantu\Nmengalahkan makhluk seram itu?
Dialogue: 0,0:13:15.27,0:13:18.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku tak ingin melihat\Nmakhluk seram itu lagi!
Dialogue: 0,0:13:18.74,0:13:21.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami kemari untuk menyelesaikan masalah itu.
Dialogue: 0,0:13:21.74,0:13:23.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:13:23.16,0:13:25.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuhajar para makhluk seram itu
Dialogue: 0,0:13:25.53,0:13:26.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu mengolahnya jadi gorengan!
Dialogue: 0,0:13:26.99,0:13:28.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sudah bilang gorengan,
Dialogue: 0,0:13:28.50,0:13:30.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tentu saja kami tak bisa tinggal diam.
Dialogue: 0,0:13:31.37,0:13:34.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sudah menemukan tempat\Nyang diduga sebagai sarangnya.
Dialogue: 0,0:13:34.59,0:13:36.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, Aria, kalian masih sanggup?
Dialogue: 0,0:13:36.88,0:13:38.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, bukan masalah.
Dialogue: 0,0:13:38.55,0:13:40.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, sekarang semangatku membara.
Dialogue: 0,0:13:40.59,0:13:44.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami pasti akan mengungkap identitas asli\Nbayangan hitam itu.
Dialogue: 0,0:13:44.05,0:13:46.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tak akan khawatir lagi\Nsaat malam tiba.
Dialogue: 0,0:13:46.68,0:13:49.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan segera kembali.
Dialogue: 0,0:13:58.23,0:14:00.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara dan ukuran tubuhnya...
Dialogue: 0,0:14:00.28,0:14:03.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bayangan hitam yang beterbangan\Ndi sekitar desa, kan?
Dialogue: 0,0:14:03.03,0:14:06.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warna putih di ujung sayap\Ndan bagian tengah punggung,
Dialogue: 0,0:14:06.91,0:14:09.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mata berwarna merah,\Ndan hidung yang agak pesek.
Dialogue: 0,0:14:09.58,0:14:11.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah pasti itu Kelelawar Raksasa.
Dialogue: 0,0:14:11.91,0:14:13.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raksasa...
Dialogue: 0,0:14:13.58,0:14:15.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar sesuai dengan namanya.
Dialogue: 0,0:14:15.71,0:14:16.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:14:16.34,0:14:18.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ukuran normalnya harusnya seperti itu.
Dialogue: 0,0:14:19.71,0:14:21.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti mereka tak bisa dibuat gorengan...
Dialogue: 0,0:14:21.51,0:14:23.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku, mereka terlalu besar!
Dialogue: 0,0:14:23.93,0:14:25.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mereka tiba-tiba bermutasi?
Dialogue: 0,0:14:25.47,0:14:30.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinan besar ada hal\Nyang menyebabkan mereka menjadi raksasa.
Dialogue: 0,0:14:30.81,0:14:33.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan ini juga dampak\Ndari Pemanggilan Gadis Suci?
Dialogue: 0,0:14:33.81,0:14:38.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, mereka makan apa sampai\Nukuran tubuhnya bisa sebesar itu?
Dialogue: 0,0:14:38.52,0:14:41.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut warga desa,\Nmereka tidak menyerang warga ataupun ternak.
Dialogue: 0,0:14:41.53,0:14:43.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sepertinya memakan ini.
Dialogue: 0,0:14:44.66,0:14:47.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini... Tawon Ganas?
Dialogue: 0,0:14:47.32,0:14:49.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, ukuran ini...
Dialogue: 0,0:14:49.33,0:14:51.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, serangga juga\Nikut menjadi raksasa?
Dialogue: 0,0:14:51.50,0:14:52.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:14:52.75,0:14:55.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan Aria sempat\Nmenjelajah di sekitar sini,
Dialogue: 0,0:14:55.12,0:14:57.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya Tawon Ganas\Nyang mengalami keanehan.
Dialogue: 0,0:14:57.42,0:15:00.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya ada yang aneh\Ndi dalam sarangnya.
Dialogue: 0,0:15:00.25,0:15:02.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin itu penyebabnya.
Dialogue: 0,0:15:02.84,0:15:04.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:15:04.26,0:15:06.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya alasan mereka menjadi raksasa
Dialogue: 0,0:15:06.14,0:15:09.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena terus memangsa Tawon Ganas ini.
Dialogue: 0,0:15:09.72,0:15:11.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kata lain, itu efek sampingnya.
Dialogue: 0,0:15:11.60,0:15:14.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, kita harus menyelidiki\Nsarangnya dulu?
Dialogue: 0,0:15:15.56,0:15:17.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, tunggu, Gomamiso?
Dialogue: 0,0:15:18.27,0:15:22.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangga ini harum dan juga enak!
Dialogue: 0,0:15:22.65,0:15:26.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menggosok wajah kecilmu yang baru\Nmenjilat cairan tubuh serangga itu padaku.
Dialogue: 0,0:15:26.82,0:15:28.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memang imut,
Dialogue: 0,0:15:28.32,0:15:30.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku takut serangga!
Dialogue: 0,0:15:30.03,0:15:31.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Jadi kamu keberatan kalau aku\N- Ed.
Dialogue: 0,0:15:31.20,0:15:34.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tolong antar kami ke sarang Tawon Ganas.\N- menggosokkan tubuhku padamu?
Dialogue: 0,0:15:34.08,0:15:35.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan padaku.
Dialogue: 0,0:15:37.75,0:15:40.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kita akan menerobos masuk ke sana?
Dialogue: 0,0:15:40.38,0:15:42.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih bisa mengatasi\Nsatu atau dua ekor.
Dialogue: 0,0:15:42.42,0:15:43.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau diserang gerombolan,
Dialogue: 0,0:15:43.76,0:15:45.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin aku tak sanggup menahannya.
Dialogue: 0,0:15:45.38,0:15:48.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita tangkap mereka\Ndengan benangnya Aria?
Dialogue: 0,0:15:48.97,0:15:51.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa menanganinya\Nkalau hanya beberapa ekor di luar.
Dialogue: 0,0:15:51.35,0:15:53.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau bala bantuan\Nkeluar dari sarang,
Dialogue: 0,0:15:53.35,0:15:54.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}benangku tak akan kuat.
Dialogue: 0,0:15:54.81,0:15:57.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini juga tidak ada insektisida.
Dialogue: 0,0:15:57.27,0:16:00.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau buat mereka kedinginan\Ndan tak bisa bergerak?
Dialogue: 0,0:16:00.77,0:16:02.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membekukan mereka beserta sarangnya...
Dialogue: 0,0:16:02.57,0:16:04.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dengan ukuran sebesar itu...
Dialogue: 0,0:16:04.82,0:16:06.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ukurannya cuma sebegitu, kan?
Dialogue: 0,0:16:06.20,0:16:08.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan butuh waktu, tapi tak usah cemas!
Dialogue: 0,0:16:08.45,0:16:09.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:16:09.74,0:16:12.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, lakukan saja begitu.
Dialogue: 0,0:16:14.20,0:16:16.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, gunakan jaring benang buatan Aria
Dialogue: 0,0:16:16.91,0:16:19.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menangkap Tawon Ganas\Nyang sedang berjaga.
Dialogue: 0,0:16:19.72,0:16:21.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu bala bantuan yang keluar
Dialogue: 0,0:16:21.13,0:16:23.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan ditangani\Ndengan sihir paralisisnya Senon.
Dialogue: 0,0:16:24.80,0:16:25.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya,
Dialogue: 0,0:16:25.67,0:16:28.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}gunakan alkimia sihir milik Ed\Nuntuk membekukan sarangnya
Dialogue: 0,0:16:28.88,0:16:32.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan membasmi semua\NTawon Ganas di dalamnya!
Dialogue: 0,0:16:32.76,0:16:34.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masalah ini selesai dalam sekejap, ya.
Dialogue: 0,0:16:34.97,0:16:37.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadinya aku berencana\Nmelindungimu dari dekat.
Dialogue: 0,0:16:37.31,0:16:38.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sepertinya tak perlu.
Dialogue: 0,0:16:38.81,0:16:40.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hore.
Dialogue: 0,0:16:40.02,0:16:41.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mudah diselesaikan.
Dialogue: 0,0:16:41.19,0:16:42.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar!
Dialogue: 0,0:16:42.11,0:16:45.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari dalam tercium aroma\Nyang sangat harum.
Dialogue: 0,0:16:45.28,0:16:46.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aroma yang sangat harum?
Dialogue: 0,0:16:46.65,0:16:50.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, Miso tadi bilang\Naroma Tawon Ganas sangat harum.
Dialogue: 0,0:16:50.32,0:16:54.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dalam sarang, memang terasa\Naliran kekuatan sihir yang aneh.
Dialogue: 0,0:16:54.41,0:16:56.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aroma harum yang dimaksud Gomamiso
Dialogue: 0,0:16:56.79,0:16:58.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti itu, kan?
Dialogue: 0,0:16:58.16,0:17:02.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barusan Aria juga bilang hal yang sama.
Dialogue: 0,0:17:02.88,0:17:05.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ed, bagaimana situasi di dalam?
Dialogue: 0,0:17:06.26,0:17:08.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya hawa dinginnya sudah menyebar,
Dialogue: 0,0:17:08.58,0:17:10.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mereka semua mati.
Dialogue: 0,0:17:10.76,0:17:11.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:17:13.47,0:17:16.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ed dan lainnya tetap di sini\Ndan awasi keadaan sekitar.
Dialogue: 0,0:17:16.43,0:17:18.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan masuk memeriksa.
Dialogue: 0,0:17:18.18,0:17:19.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ikut.
Dialogue: 0,0:17:19.64,0:17:20.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga.
Dialogue: 0,0:17:40.96,0:17:42.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besar sekali.
Dialogue: 0,0:17:42.42,0:17:43.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:17:43.29,0:17:46.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini yang dimaksud Aria dan lainnya?
Dialogue: 0,0:17:46.27,0:17:48.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia ratunya?
Dialogue: 0,0:17:57.22,0:17:59.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Gomamiso?
Dialogue: 0,0:18:02.98,0:18:05.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, itu barangku.
Dialogue: 0,0:18:05.11,0:18:06.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu milikku.
Dialogue: 0,0:18:06.06,0:18:10.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh...\NBarang ini milik bersama tim.
Dialogue: 0,0:18:10.11,0:18:12.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mau, yang itu aromanya harum!
Dialogue: 0,0:18:12.45,0:18:14.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu barang yang enak!
Dialogue: 0,0:18:14.49,0:18:15.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batu itu…
Dialogue: 0,0:18:15.62,0:18:18.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya yang disebut Batu Sihir.
Dialogue: 0,0:18:18.29,0:18:19.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batu Sihir?
Dialogue: 0,0:18:19.54,0:18:22.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau digambarkan secara ekstrem,\Nini semacam kumpulan energi sihir.
Dialogue: 0,0:18:22.75,0:18:25.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga baru pertama kali melihatnya.
Dialogue: 0,0:18:25.17,0:18:27.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya Tawon Ganas\Nmenjadi sebesar itu
Dialogue: 0,0:18:27.29,0:18:28.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena pengaruhnya.
Dialogue: 0,0:18:29.34,0:18:31.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konon, Batu Sihir hanya ada\Ndi dasar dungeon
Dialogue: 0,0:18:31.92,0:18:33.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau yang mudah menumpuk\Nenergi sihir,
Dialogue: 0,0:18:33.80,0:18:36.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan butuh waktu lama untuk terbentuk.
Dialogue: 0,0:18:36.85,0:18:39.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, ini barang yang dimaksud Noah
Dialogue: 0,0:18:39.31,0:18:41.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa memperkuat kekuatan Gadis Suci.
Dialogue: 0,0:18:41.93,0:18:43.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.\NArtinya...
Dialogue: 0,0:18:43.89,0:18:47.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, misi pertama berhasil diselesaikan!
Dialogue: 0,0:18:47.02,0:18:49.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hore.\N- Bagus.
Dialogue: 0,0:18:49.07,0:18:50.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu,
Dialogue: 0,0:18:50.19,0:18:51.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami, Meja Rakus,
Dialogue: 0,0:18:51.90,0:18:55.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menumpas semua Kelelawar Raksasa\Nyang membesar itu tanpa sisa.
Dialogue: 0,0:18:55.36,0:18:59.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu kembali memberi tahu warga desa\Nbahwa kekacauan telah teratasi
Dialogue: 0,0:18:59.03,0:19:01.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kami pun pergi meninggalkan desa.
Dialogue: 0,0:19:01.08,0:19:02.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu,
Dialogue: 0,0:19:03.21,0:19:05.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}waktunya kudapan malam!
Dialogue: 0,0:19:05.21,0:19:07.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menduga\Nhal seperti ini akan terjadi,
Dialogue: 0,0:19:07.67,0:19:10.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi sebelumnya aku\Nsudah memanggang hewan liar.
Dialogue: 0,0:19:12.17,0:19:15.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa memanggil Mo,\Naku tetap bisa menggunakan oven.
Dialogue: 0,0:19:15.84,0:19:17.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daging ini akan kamu apakan?
Dialogue: 0,0:19:19.05,0:19:22.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan buat roti lapis spesial.
Dialogue: 0,0:19:22.85,0:19:25.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Susun daging hewan liar panggang,\Nham, dan keju,
Dialogue: 0,0:19:25.06,0:19:27.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu acar mentimun yang diiris banyak.
Dialogue: 0,0:19:27.02,0:19:29.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu, oleskan saus mustard\Ndalam jumlah banyak pada roti,
Dialogue: 0,0:19:29.98,0:19:31.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}masukkan semua bahan,
Dialogue: 0,0:19:31.94,0:19:35.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu goreng dengan banyak mentega\Nhingga berwarna keemasan.
Dialogue: 0,0:19:35.40,0:19:37.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan roti menyerap mentega sepenuhnya,
Dialogue: 0,0:19:37.66,0:19:40.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}goreng permukaannya hingga renyah.
Dialogue: 0,0:19:41.83,0:19:42.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Roti Lapis Kuba!
Dialogue: 0,0:19:42.87,0:19:46.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Roti lapis panggang dengan daging\Nhewan liar panggang sudah jadi!
Dialogue: 0,0:19:47.54,0:19:49.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Roti ini mengeluarkan aroma dosa\Nyang sangat menggoda!
Dialogue: 0,0:19:49.84,0:19:52.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makan makanan ini sebagai kudapan malam\Nbenar-benar sebuah dosa!
Dialogue: 0,0:19:54.34,0:19:56.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, kita semua berbuat jahat.
Dialogue: 0,0:19:56.43,0:19:59.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, ayo semuanya mulai makan.
Dialogue: 0,0:20:01.81,0:20:03.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak!
Dialogue: 0,0:20:03.22,0:20:05.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Rin.\NApa sebenarnya ini?
Dialogue: 0,0:20:05.31,0:20:07.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasa ini sangat penuh dosa!
Dialogue: 0,0:20:07.77,0:20:10.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mentega yang meleleh dari roti lapis\Ndan sari daging yang melimpah
Dialogue: 0,0:20:10.86,0:20:13.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seketika memenuhi mulut.
Dialogue: 0,0:20:13.69,0:20:16.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makan makanan ini sebagai kudapan malam\Nbenar-benar sangat berdosa.
Dialogue: 0,0:20:16.78,0:20:19.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dewa, mohon ampuni aku\Nyang penuh dosa ini.
Dialogue: 0,0:20:22.08,0:20:23.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menaklukkan dungeon?
Dialogue: 0,0:20:23.95,0:20:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:20:25.20,0:20:28.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada dungeon yang sangat tersembunyi\Ndi dekat ibu kota.
Dialogue: 0,0:20:28.46,0:20:32.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sana tersimpan permata kuat\Nyang bisa memperkuat Gadis Suci.
Dialogue: 0,0:20:32.75,0:20:36.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, mekanisme dungeon ini,\Nkalau bukan Gadis Suci
Dialogue: 0,0:20:36.55,0:20:39.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau bukan orang dari dunia lain,\Ntak akan bisa dipecahkan.
Dialogue: 0,0:20:39.38,0:20:42.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedengarannya seperti alur cerita\Nyang merepotkan lagi.
Dialogue: 0,0:20:42.05,0:20:43.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu,
Dialogue: 0,0:20:43.01,0:20:47.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada dungeon yang akan menewaskan Ville\Ndan tiga lainnya di dalam gim.
Dialogue: 0,0:20:51.31,0:20:52.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:20:52.77,0:20:54.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ville dan yang lainnya
Dialogue: 0,0:20:54.52,0:20:56.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebenarnya bukan karakter target,
Dialogue: 0,0:20:56.61,0:21:00.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka hanya figuran tanpa nama\Nyang menjadi pelengkap aktivitas Gadis Suci.
Dialogue: 0,0:21:00.91,0:21:03.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Figuran?\NMaksudmu Ville dan yang lainnya?
Dialogue: 0,0:21:03.91,0:21:06.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar.
Dialogue: 0,0:21:06.33,0:21:09.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kalau Ville\Ndan yang lainnya ada di sana...
Dialogue: 0,0:21:09.62,0:21:12.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau hanya nyawaku yang diincar,
Dialogue: 0,0:21:12.83,0:21:16.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tak akan melibatkanmu, Ville,\Ndan yang lainnya.
Dialogue: 0,0:21:16.38,0:21:20.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau semuanya sesuai alur cerita,\Nbaik negara ini ataupun ras submanusia
Dialogue: 0,0:21:20.34,0:21:21.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan ada di ambang kehancuran!
Dialogue: 0,0:21:22.47,0:21:24.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Noah.
Dialogue: 0,0:21:25.14,0:21:26.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Rin.
Dialogue: 0,0:21:26.39,0:21:28.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama ada skill-mu,
Dialogue: 0,0:21:28.10,0:21:30.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin kita bisa mengubah\Nalur cerita ini!
Dialogue: 0,0:21:30.77,0:21:32.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill-ku...
Dialogue: 0,0:21:32.02,0:21:34.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, meski ini terdengar licik,
Dialogue: 0,0:21:35.48,0:21:37.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ingin kamu yang memutuskan
Dialogue: 0,0:21:37.65,0:21:39.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apakah akan menerima misi ini atau tidak.
Dialogue: 0,0:21:40.86,0:21:42.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang memutuskan...
Dialogue: 0,0:21:45.53,0:21:46.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya.
Dialogue: 0,0:21:47.41,0:21:50.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjelaskan misi kedua sekarang.
Dialogue: 0,0:21:54.21,0:21:57.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teman-temanku adalah karakter figuran?
Dialogue: 0,0:21:57.05,0:22:00.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah dia Gadis Suci atau bukan,
Dialogue: 0,0:22:00.01,0:22:02.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku yang akan menghancurkannya
Dialogue: 0,0:22:02.01,0:22:04.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau alur ceritanya seperti ini!
