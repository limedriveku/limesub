Dialogue: 0,0:00:06.70,0:00:08.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada laporan monster muncul!
Dialogue: 0,0:00:08.45,0:00:09.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf!
Dialogue: 0,0:00:10.53,0:00:12.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sensei, izin ke toilet!
Dialogue: 0,0:00:12.06,0:00:13.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga...
Dialogue: 0,0:00:13.18,0:00:14.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh, silakan.
Dialogue: 0,0:00:15.58,0:00:17.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian, jangan lari di koridor!
Dialogue: 0,0:00:18.56,0:00:21.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belakangan ini monster sering muncul.
Dialogue: 0,0:00:21.86,0:00:23.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua, hati-hati, ya!
Dialogue: 0,0:02:08.13,0:02:11.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai petir, empaskan semua\Nyang menghalangi jalanku!
Dialogue: 0,0:02:11.78,0:02:15.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemarilah, api yang agung.\NPui pui pun!
Dialogue: 0,0:02:26.34,0:02:27.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus.
Dialogue: 0,0:02:27.92,0:02:29.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian memang hebat.
Dialogue: 0,0:02:30.84,0:02:33.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuh kali ini adalah Hellhound.
Dialogue: 0,0:02:33.60,0:02:35.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kategori: Pendatang
Dialogue: 0,0:02:35.59,0:02:39.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya monster dari dunia lain\Nkembali masuk ke sini.
Dialogue: 0,0:02:39.35,0:02:42.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, mereka datang dari dimensi mana?
Dialogue: 0,0:02:42.81,0:02:44.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih dalam penyelidikan.
Dialogue: 0,0:02:44.67,0:02:50.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dunia ini memang sedang terancam\Noleh bahaya dari dimensi lain.
Dialogue: 0,0:02:50.02,0:02:52.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tidak sanggup\Nmenjalankan tugas ini.
Dialogue: 0,0:02:52.21,0:02:54.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sudah tidak sanggup.
Dialogue: 0,0:02:54.62,0:02:57.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belakangan ini tingkat\Nkemunculan monster abnormal.
Dialogue: 0,0:02:57.70,0:03:01.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlebih, orang yang harus kalian\Nawasi juga bertambah.
Dialogue: 0,0:03:01.08,0:03:01.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:03:01.95,0:03:03.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:03:04.08,0:03:07.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita pun baru memastikan\Nada penyihir bernama Asahina.
Dialogue: 0,0:03:08.00,0:03:11.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tampak tak berniat menjadi musuh kita,\Ntapi tetap perlu diawasi.
Dialogue: 0,0:03:12.43,0:03:15.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, sang Returner, Takanashi.
Dialogue: 0,0:03:15.34,0:03:17.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sempat dirawat karena cedera,
Dialogue: 0,0:03:17.43,0:03:21.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi dia minta pulang\Ndan ingin kembali sekolah.
Dialogue: 0,0:03:21.31,0:03:22.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:03:22.88,0:03:24.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:03:24.66,0:03:29.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah janji tak akan berulah,\Ntapi tetap harus kita awasi.
Dialogue: 0,0:03:30.11,0:03:34.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah berapa banyak\Ncelah dimensi yang dia buka?
Dialogue: 0,0:03:34.78,0:03:38.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin saja ada orang lain\Nyang terus membukanya?
Dialogue: 0,0:03:38.78,0:03:41.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi masih ada masalah lain!
Dialogue: 0,0:03:41.70,0:03:43.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berdua!
Dialogue: 0,0:03:43.37,0:03:47.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Narukami Ryusei dan Hanaori Meteor\Nyang harusnya diawasi juga?
Dialogue: 0,0:03:47.57,0:03:49.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya ada apa dengan mereka berdua?
Dialogue: 0,0:03:52.46,0:03:54.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih untuk yang tempo hari.
Dialogue: 0,0:03:54.71,0:03:55.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tertolong.
Dialogue: 0,0:03:56.34,0:03:58.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kami datang tepat waktu.
Dialogue: 0,0:03:59.34,0:04:03.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, itu pengalaman yang luar biasa.
Dialogue: 0,0:04:03.06,0:04:05.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha-Hanaori-san?
Dialogue: 0,0:04:05.27,0:04:08.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia malah minum punya Sensei!
Dialogue: 0,0:04:10.02,0:04:11.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia akhirnya menyadarinya!
Dialogue: 0,0:04:12.61,0:04:14.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reaksi macam apa itu?
Dialogue: 0,0:04:16.51,0:04:17.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:04:17.70,0:04:19.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sedang bahas apa?
Dialogue: 0,0:04:19.66,0:04:21.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini soal komedi romantis!
Dialogue: 0,0:04:21.62,0:04:24.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Target yang kami awasi ini\Nkesehariannya penuh komedi romantis!
Dialogue: 0,0:04:24.45,0:04:26.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:04:26.00,0:04:28.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pahami yang kami rasakan\Nharus mengawasi mereka tiap hari!
Dialogue: 0,0:04:28.46,0:04:31.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu paham apa yang kami rasakan?
Dialogue: 0,0:04:32.17,0:04:35.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibanding invasi alien\Natau menyelidiki gadis penyihir,
Dialogue: 0,0:04:35.42,0:04:37.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menghadapi kisah komedi romantis\Njauh lebih menyiksa!
Dialogue: 0,0:04:39.63,0:04:41.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku suka...
Dialogue: 0,0:04:43.14,0:04:43.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:04:44.96,0:04:46.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kenapa?
Dialogue: 0,0:04:46.13,0:04:47.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ganti penampilan.
Dialogue: 0,0:04:47.64,0:04:49.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu cocok pakai pita hitam itu.
Dialogue: 0,0:04:50.85,0:04:53.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesannya seperti anak buah penjahat.
Dialogue: 0,0:04:53.48,0:04:54.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjahat?
Dialogue: 0,0:04:57.49,0:04:58.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi malu.
Dialogue: 0,0:04:59.50,0:05:01.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa malah jadi malu?
Dialogue: 0,0:05:13.26,0:05:14.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu...
Dialogue: 0,0:05:14.29,0:05:16.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lucu seperti binatang mungil, ya.
Dialogue: 0,0:05:18.58,0:05:19.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?
Dialogue: 0,0:05:19.80,0:05:22.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu membayangkan binatang apa?
Dialogue: 0,0:05:22.34,0:05:23.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bilang tupai mungil!
Dialogue: 0,0:05:23.76,0:05:25.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya itu penting?
Dialogue: 0,0:05:25.52,0:05:26.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penting!
Dialogue: 0,0:05:28.98,0:05:31.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, kalian ini bahas apa?
Dialogue: 0,0:05:31.69,0:05:33.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan buat kami mengatakannya lagi.
Dialogue: 0,0:05:33.40,0:05:35.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini soal dunia komedi romantis!
Dialogue: 0,0:05:36.85,0:05:39.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minto, aku ingin minta tolong padamu.
Dialogue: 0,0:05:39.32,0:05:40.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:05:40.28,0:05:43.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa sihir aku agar ototku terlihat kekar?
Dialogue: 0,0:05:43.36,0:05:44.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu bilang?
Dialogue: 0,0:05:44.57,0:05:47.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin punya otot kekar.
Dialogue: 0,0:05:47.10,0:05:49.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak paham kamu bicara apa.
Dialogue: 0,0:05:49.23,0:05:53.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, aku sampai pinjam baju olahraganya\NSensei agar punyaku tidak robek.
Dialogue: 0,0:05:53.62,0:05:56.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!\NMaksudnya kamu tukaran baju olahraga?
Dialogue: 0,0:05:56.59,0:05:57.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:05:57.55,0:05:59.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, jadi itu maksudnya, ya.
Dialogue: 0,0:05:59.76,0:06:01.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah lihat di manga cewek!
Dialogue: 0,0:06:01.71,0:06:05.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakai baju olahraga orang\Nyang kamu suka itu bikin deg-degan, kan?
Dialogue: 0,0:06:05.39,0:06:08.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu salah paham!\NAku cuma ingin ototku kekar!
Dialogue: 0,0:06:08.85,0:06:10.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah.
Dialogue: 0,0:06:10.05,0:06:12.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya jujur dan mengaku saja.
Dialogue: 0,0:06:12.03,0:06:14.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku serius!
Dialogue: 0,0:06:31.82,0:06:35.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan komedi romantis,\Ntapi orang yang ingin punya otot kekar.
Dialogue: 0,0:06:35.49,0:06:37.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang kalian ceritakan ini juga\Nsudah cukup menyeramkan.
Dialogue: 0,0:06:38.17,0:06:39.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya!
Dialogue: 0,0:06:39.50,0:06:44.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di SMA Putri Mitsurugi yang abnormal ini,\Nkejadian seperti ini sudah dianggap biasa!
Dialogue: 0,0:06:44.70,0:06:46.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu bilang?
Dialogue: 0,0:06:46.72,0:06:49.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini dunia kisah komedi romantis?
Dialogue: 0,0:06:50.85,0:06:52.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:06:52.06,0:06:55.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir terkuat OZ sampai minta maaf.
Dialogue: 0,0:06:55.71,0:06:57.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong tambah dua kue kejunya, ya.
Dialogue: 0,0:06:57.73,0:06:58.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga.
Dialogue: 0,0:06:59.65,0:07:01.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kucek dulu.
Dialogue: 0,0:07:01.07,0:07:03.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua kue keju, ya.
Dialogue: 0,0:07:03.32,0:07:04.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, cewek cantik.
Dialogue: 0,0:07:04.75,0:07:07.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kisah komedi romantis di sekitarmu?
Dialogue: 0,0:07:07.04,0:07:09.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelanggan ini tiba-tiba\Nmenanyakan hal yang aneh!
Dialogue: 0,0:07:11.20,0:07:12.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba kuingat...
Dialogue: 0,0:07:12.91,0:07:16.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada cewek cantik yang tiba-tiba datang\Nke kamar kakakku yang pengangguran
Dialogue: 0,0:07:16.82,0:07:19.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu mereka makin dekat\Ndan kakakku langsung berubah drastis.
Dialogue: 0,0:07:19.63,0:07:20.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar saja.
Dialogue: 0,0:07:20.84,0:07:22.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia dia kena tipu beli barang aneh?
Dialogue: 0,0:07:22.96,0:07:24.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu orang ***, kan?
Dialogue: 0,0:07:24.63,0:07:26.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bohong!
Dialogue: 0,0:07:26.04,0:07:28.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirip cerita manga, kan?
Dialogue: 0,0:07:29.84,0:07:31.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tanya sekali lagi.
Dialogue: 0,0:07:31.56,0:07:34.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka serius seperti itu?
Dialogue: 0,0:07:34.02,0:07:34.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:07:35.57,0:07:37.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka juga inkarnasi dari dunia lain.
Dialogue: 0,0:07:38.52,0:07:42.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu aku bisa melihat masa depan mereka\Nsaat akan terlibat pertempuran besar.
Dialogue: 0,0:07:43.87,0:07:46.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini kemampuan menerawangnya Dorothy...
Dialogue: 0,0:07:46.94,0:07:49.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para pahlawan yang kembali dari dunia lain
Dialogue: 0,0:07:49.20,0:07:53.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti kesulitan beradaptasi dengan keseharian\Ndi dunia ini dan akan lepas kendali.
Dialogue: 0,0:07:55.15,0:07:57.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini sudah ada tiga Returner\Nyang lepas kendali.
Dialogue: 0,0:07:58.40,0:07:59.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenzaki Yuya.
Dialogue: 0,0:08:00.14,0:08:01.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jinguji Hokuto.
Dialogue: 0,0:08:01.73,0:08:03.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, Takanashi Ayame.
Dialogue: 0,0:08:04.66,0:08:07.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka semua mengalami lepas kendali.
Dialogue: 0,0:08:07.30,0:08:08.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:08:09.18,0:08:11.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari yang kami lihat,\Nmereka agak sedikit berbeda.
Dialogue: 0,0:08:11.76,0:08:13.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:08:13.31,0:08:15.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita amati mereka\Nsedikit lebih lama.
Dialogue: 0,0:08:16.66,0:08:18.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ingin percaya.
Dialogue: 0,0:08:18.96,0:08:22.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahwa di dunia ini pun,\Nsang Pahlawan akan muncul.
Dialogue: 0,0:08:22.44,0:08:24.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah merangkumnya jadi cerita bagus!
Dialogue: 0,0:08:24.11,0:08:25.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sok keren, Kuper!
Dialogue: 0,0:08:25.86,0:08:27.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak perlu menyebutku kuper!
Dialogue: 0,0:08:28.35,0:08:31.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka pasti punya alasan sendiri.
Dialogue: 0,0:08:31.12,0:08:32.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alasan seperti apa?
Dialogue: 0,0:08:32.42,0:08:36.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kalau mereka berpisah,\Ndunia akan hancur?
Dialogue: 0,0:08:36.53,0:08:38.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan remehkan kisah komedi romantis.
Dialogue: 0,0:08:38.53,0:08:42.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau kalau mereka ciuman,\NBumi akan meledak?
Dialogue: 0,0:08:42.08,0:08:44.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan remehkan kisah komedi romantis.
Dialogue: 0,0:08:45.33,0:08:47.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Komedi romantis ternyata rumit, ya.
Dialogue: 0,0:08:47.30,0:08:48.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan remehkan kisah komedi romantis.
Dialogue: 0,0:08:48.94,0:08:51.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan remehkan kisah komedi romantis.
Dialogue: 0,0:08:51.01,0:08:54.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka ini penggemar berat\Nkisah komedi romantis, ya?
Dialogue: 0,0:08:56.82,0:08:57.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi?
Dialogue: 0,0:08:57.94,0:08:59.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kue kejuku!
Dialogue: 0,0:08:59.64,0:09:01.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku serahkan pada kalian berdua!
Dialogue: 0,0:09:01.39,0:09:03.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku yang menghabiskan kuenya.
Dialogue: 0,0:09:03.10,0:09:05.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan konyol, Kuper!
Dialogue: 0,0:09:05.36,0:09:06.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami pergi dulu!
Dialogue: 0,0:09:06.22,0:09:07.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kue keju!
Dialogue: 0,0:09:07.90,0:09:10.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perusahaan gelap yang suka\Nkisah komedi romantis?
Dialogue: 0,0:09:19.54,0:09:21.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lightning Bolt!
Dialogue: 0,0:09:21.04,0:09:22.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fireball!
Dialogue: 0,0:09:30.16,0:09:32.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster hari ini terlalu banyak.
Dialogue: 0,0:09:32.53,0:09:34.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih ada banyak reaksi kemunculan monster.
Dialogue: 0,0:09:35.42,0:09:38.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Markas, cepat kirim lokasi berikutnya!
Dialogue: 0,0:09:38.18,0:09:41.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, monster tadi menjatuhkan cincin ini.
Dialogue: 0,0:09:41.35,0:09:43.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini yang disebut barang langka?
Dialogue: 0,0:09:43.54,0:09:45.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu malah santai menonton di sini?
Dialogue: 0,0:09:46.64,0:09:48.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu Cincin Kegelapan.
Dialogue: 0,0:09:48.70,0:09:50.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama lainnya "Jatuh ke Kegelapan".
Dialogue: 0,0:09:50.52,0:09:52.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benda terkutuk yang merusak\Npikiran manusia
Dialogue: 0,0:09:52.58,0:09:56.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan membuat pemakainya\Nbertindak sesuka hati.
Dialogue: 0,0:09:57.62,0:09:59.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati.
Dialogue: 0,0:09:59.12,0:10:02.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makin besar keinginanmu,\Nmakin besar pula kamu ditelan kegelapan.
Dialogue: 0,0:10:02.58,0:10:05.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang, aku tak punya keinginan macam-macam.
Dialogue: 0,0:10:10.02,0:10:11.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:10:11.05,0:10:13.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, Gadis Bokong Persik?
Dialogue: 0,0:10:26.94,0:10:29.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesatria Hitam?
Dialogue: 0,0:10:30.24,0:10:32.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sang Pembalas Dendam,
Dialogue: 0,0:10:33.32,0:10:34.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Avenger.
Dialogue: 0,0:10:35.28,0:10:37.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang akan menghancurkan Raja Iblis.
Dialogue: 0,0:10:38.66,0:10:41.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Raja Iblis ada di mana?
Dialogue: 0,0:10:41.16,0:10:42.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raja Iblis?
Dialogue: 0,0:10:43.86,0:10:46.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mencium bau monster.
Dialogue: 0,0:10:46.08,0:10:47.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus kukalahkan!
Dialogue: 0,0:10:50.43,0:10:52.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang Raja Iblis...
Dialogue: 0,0:10:52.45,0:10:54.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus menghubungi Sensei.
Dialogue: 0,0:11:21.37,0:11:23.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi dia sang Pahlawan?
Dialogue: 0,0:11:23.25,0:11:25.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ini aneh.
Dialogue: 0,0:11:25.52,0:11:27.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru dengar bahwa penampilannya hitam.
Dialogue: 0,0:11:28.42,0:11:31.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana, jelaskan situasi saat ini.
Dialogue: 0,0:11:31.21,0:11:34.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini, ada beberapa hal terjadi\Nlalu sang Pahlawan jatuh ke kegelapan
Dialogue: 0,0:11:34.75,0:11:36.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan pergi menuju kota.
Dialogue: 0,0:11:36.72,0:11:38.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, terjadi beberapa hal, ya.
Dialogue: 0,0:11:38.62,0:11:41.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf! Aku akan segera lapor posisinya!
Dialogue: 0,0:11:41.46,0:11:44.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu.\NDia ada tepat di depan kami.
Dialogue: 0,0:11:46.05,0:11:47.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raja Iblis.
Dialogue: 0,0:11:47.49,0:11:48.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana Raja Iblis?
Dialogue: 0,0:11:50.06,0:11:53.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya sang Pahlawan\Nsedang mencari Raja Iblis,
Dialogue: 0,0:11:53.09,0:11:54.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi siapa Raja Iblis?
Dialogue: 0,0:11:54.67,0:11:56.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami juga ingin tahu.
Dialogue: 0,0:12:00.34,0:12:04.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Singkatnya, Meteor berubah menjadi\Nkegelapan dan sedang mengamuk?
Dialogue: 0,0:12:04.16,0:12:07.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, dia dirasuki benda terkutuk\Nyang membuat penggunanya mengamuk
Dialogue: 0,0:12:07.25,0:12:09.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan berbuat sesuka hati.
Dialogue: 0,0:12:09.75,0:12:13.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang dia sedang membasmi semua\Nmonster di kota, tapi dia bilang sesuatu
Dialogue: 0,0:12:13.31,0:12:15.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang membuat kami penasaran.
Dialogue: 0,0:12:15.13,0:12:16.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang apa?
Dialogue: 0,0:12:16.70,0:12:18.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang, "Di mana Raja Iblis?"
Dialogue: 0,0:12:19.26,0:12:21.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi targetnya itu aku...
Dialogue: 0,0:12:22.30,0:12:24.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tahu sesuatu?
Dialogue: 0,0:12:25.07,0:12:26.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini, aku...
Dialogue: 0,0:12:26.69,0:12:28.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah Raja Iblis.
Dialogue: 0,0:12:28.75,0:12:30.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu Raja Iblis?
Dialogue: 0,0:12:31.19,0:12:34.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal monster dan juga pintu antardimensi...
Dialogue: 0,0:12:34.48,0:12:37.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama ini semuanya kubebankan pada kalian.
Dialogue: 0,0:12:37.55,0:12:40.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, detailnya akan kujelaskan nanti.
Dialogue: 0,0:12:40.83,0:12:43.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menduga\Nkamu pasti punya alasannya.
Dialogue: 0,0:12:43.33,0:12:47.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kalau ada yang mengaku Raja Iblis,\Nsiapa pun pasti tak akan percaya.
Dialogue: 0,0:12:47.16,0:12:50.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, aku tak akan\Nmengorek rahasia seorang pria.
Dialogue: 0,0:12:50.87,0:12:53.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanita baik selalu begitu, kan?
Dialogue: 0,0:12:53.59,0:12:54.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak benar.
Dialogue: 0,0:12:56.55,0:13:00.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar lagi Meteor akan merasakan\Nkekuatan sihirku dan kembali ke sini.
Dialogue: 0,0:13:00.76,0:13:04.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuraishi, tolong pasang barier untuk menjauhkan\Nwarga dan mencegah kerusakan.
Dialogue: 0,0:13:04.56,0:13:05.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:13:05.22,0:13:07.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana cara menghilangkan\Nkutukan cincin itu?
Dialogue: 0,0:13:07.68,0:13:10.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketika semua keinginannya tersalurkan,
Dialogue: 0,0:13:10.30,0:13:12.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau cincinnya dihancurkan.
Dialogue: 0,0:13:12.15,0:13:14.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, akan kuusahakan.
Dialogue: 0,0:13:18.46,0:13:20.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketemu juga, Raja Iblis!
Dialogue: 0,0:13:20.90,0:13:22.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meteor.
Dialogue: 0,0:13:22.42,0:13:25.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tak jumpa,\Npenampilanmu keren juga sekarang.
Dialogue: 0,0:13:25.62,0:13:27.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu malah mirip prajurit Raja Iblis.
Dialogue: 0,0:13:27.62,0:13:28.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:13:28.70,0:13:31.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memujiku tak akan mengubah apa pun!
Dialogue: 0,0:13:31.46,0:13:32.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak sedang memujimu.
Dialogue: 0,0:13:32.96,0:13:35.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wujud jatuhnya ternyata imut, ya.
Dialogue: 0,0:13:35.76,0:13:39.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keinginanku adalah menyelesaikan\Npertarungan denganmu!
Dialogue: 0,0:13:39.33,0:13:42.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, lawan aku dengan serius!
Dialogue: 0,0:13:43.38,0:13:45.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu keinginanmu,
Dialogue: 0,0:13:45.65,0:13:47.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan kulayani.
Dialogue: 0,0:13:48.81,0:13:50.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersiaplah!
Dialogue: 0,0:13:50.52,0:13:51.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aura Slash!
Dialogue: 0,0:13:52.35,0:13:53.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Darkness Wall!
Dialogue: 0,0:14:02.28,0:14:03.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Licik sekali!
Dialogue: 0,0:14:05.07,0:14:06.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Energy Bolt!
Dialogue: 0,0:14:09.79,0:14:12.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berpindah-pindah di antara dinding sihir,
Dialogue: 0,0:14:12.21,0:14:15.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menggunakan barier sambil menyerang\Ndengan sihir tembakan cepat?
Dialogue: 0,0:14:15.25,0:14:16.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya penyihir bertarung
Dialogue: 0,0:14:16.96,0:14:21.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan mengalahkan lawan\Nsebelum barier sihirnya sendiri hancur.
Dialogue: 0,0:14:21.51,0:14:24.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka ada penyihir\Nyang bertarung seperti itu.
Dialogue: 0,0:14:27.14,0:14:29.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, serangannya tak bisa\Nmenjadi serangan penentu.
Dialogue: 0,0:14:30.85,0:14:32.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dinding seperti ini!
Dialogue: 0,0:14:34.58,0:14:37.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat itu, aku bisa memasang jebakan\Nuntuk membuat celah.
Dialogue: 0,0:14:38.45,0:14:40.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Binding Trap.
Dialogue: 0,0:14:45.95,0:14:49.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melepaskan pembatas kekuatan sihir.\NMelepaskan kekuatan sihir.
Dialogue: 0,0:14:49.55,0:14:51.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan yang membakar langit dan Bumi.
Dialogue: 0,0:14:51.50,0:14:53.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan yang membelah\Ndan melampaui tatanan.
Dialogue: 0,0:14:53.75,0:14:56.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai gerbang yang terkunci.\NTerbukalah dan berkumpullah di tanganku.
Dialogue: 0,0:14:56.67,0:15:00.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai Api dari dunia lain,\Nlepaskan kekuatan kekacauan.
Dialogue: 0,0:15:00.80,0:15:03.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanguskan segalanya\Ndan ubahlah menjadi abu!
Dialogue: 0,0:15:03.51,0:15:04.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hell Flare!
Dialogue: 0,0:15:13.66,0:15:16.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menghentikan pergerakannya\Ndengan sihir pengikat
Dialogue: 0,0:15:16.13,0:15:18.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu merapal sihir tingkat tinggi lengkap!
Dialogue: 0,0:15:23.71,0:15:25.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mampu menahan sihir barusan, ya?
Dialogue: 0,0:15:26.42,0:15:27.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bilang, kan?
Dialogue: 0,0:15:27.90,0:15:30.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku diciptakan untuk mengalahkanmu.
Dialogue: 0,0:15:31.74,0:15:33.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, sekarang giliranku.
Dialogue: 0,0:15:35.22,0:15:37.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang,\Npertarungan sang Raja Iblis dimulai!
Dialogue: 0,0:15:39.96,0:15:41.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Muncullah.
Dialogue: 0,0:15:41.52,0:15:43.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para kesatria mayat hidupku!
Dialogue: 0,0:15:45.82,0:15:47.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dead March!
Dialogue: 0,0:15:48.51,0:15:50.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan kesatria mayat hidup Raja Iblis?
Dialogue: 0,0:15:51.10,0:15:52.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serang!
Dialogue: 0,0:16:04.69,0:16:06.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesatria mayat hidup sebanyak itu...
Dialogue: 0,0:16:06.65,0:16:08.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanaori-san bisa menahan mereka.
Dialogue: 0,0:16:12.93,0:16:16.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku adalah senjata yang diciptakan\Nuntuk mengalahkan Raja Iblis.
Dialogue: 0,0:16:17.33,0:16:19.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya itu yang kumiliki.
Dialogue: 0,0:16:19.89,0:16:22.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kamu sengaja membiarkanku mengalahkanmu!
Dialogue: 0,0:16:22.96,0:16:26.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bahkan merampas alasan keberadaanku!
Dialogue: 0,0:16:27.34,0:16:30.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu... untuk apa arti keberadaanku?
Dialogue: 0,0:16:39.02,0:16:40.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kena!
Dialogue: 0,0:16:41.73,0:16:43.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Palsu?
Dialogue: 0,0:16:44.42,0:16:48.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Necromancer memiliki sihir\Nyang menggunakan mayat sebagai katalis.
Dialogue: 0,0:16:48.43,0:16:50.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya sudah kupersiapkan sejak awal.
Dialogue: 0,0:16:50.90,0:16:53.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti sisa-sisa kesatria mayat hidup itu.
Dialogue: 0,0:16:53.66,0:16:55.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingat baik-baik.
Dialogue: 0,0:16:55.71,0:16:58.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah cara bertarung seorang necromancer.
Dialogue: 0,0:17:01.31,0:17:01.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat!
Dialogue: 0,0:17:02.62,0:17:04.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Corpse Explosion!
Dialogue: 0,0:17:22.02,0:17:25.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga, Raja Iblis memang kuat.
Dialogue: 0,0:17:26.36,0:17:27.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah puas?
Dialogue: 0,0:17:27.94,0:17:29.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lain kali aku akan mengalahkanmu.
Dialogue: 0,0:17:30.30,0:17:32.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Datang dan lawan aku kapan saja.
Dialogue: 0,0:17:32.18,0:17:33.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, nyalimu besar.
Dialogue: 0,0:17:34.87,0:17:36.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lanjutkan pertarungan kalian di hotel.
Dialogue: 0,0:17:39.47,0:17:41.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:17:41.04,0:17:42.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan cemas.
Dialogue: 0,0:17:42.78,0:17:44.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak dengar.
Dialogue: 0,0:17:45.07,0:17:48.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, dia Pahlawan yang merepotkan, ya.
Dialogue: 0,0:17:52.27,0:17:54.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri, kamu malah datang ke sini lagi.
Dialogue: 0,0:17:54.99,0:17:56.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti kakekmu marah.
Dialogue: 0,0:17:56.61,0:17:59.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, sembunyikan aku sebentar.
Dialogue: 0,0:17:59.89,0:18:01.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara yang nostalgia.
Dialogue: 0,0:18:01.77,0:18:03.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka tempat ini.
Dialogue: 0,0:18:03.66,0:18:05.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat yang nostalgia.
Dialogue: 0,0:18:05.97,0:18:10.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saat berada di sini, aku tak perlu\Npakai topeng sebagai seorang putri.
Dialogue: 0,0:18:12.56,0:18:13.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pasti mimpi.
Dialogue: 0,0:18:14.30,0:18:16.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mimpi sebelum aku menjadi Raja Iblis.
Dialogue: 0,0:18:17.07,0:18:20.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, bidang utamamu itu ilmu sihir mayat, kan?
Dialogue: 0,0:18:20.20,0:18:21.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:18:21.26,0:18:24.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah menggunakannya,\Ntapi risetnya masih terus kulakukan.
Dialogue: 0,0:18:24.92,0:18:27.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi kalau manusia mati?
Dialogue: 0,0:18:27.74,0:18:31.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konon tubuhnya akan membusuk dan hancur,\Nsedangkan jiwanya akan lenyap.
Dialogue: 0,0:18:32.66,0:18:37.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir roh adalah ilmu sihir\Nyang mengendalikan tubuh tanpa jiwa.
Dialogue: 0,0:18:37.71,0:18:39.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jiwa, ya.
Dialogue: 0,0:18:40.48,0:18:42.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pernah dengar tentang reinkarnasi?
Dialogue: 0,0:18:42.80,0:18:43.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reinkarnasi?
Dialogue: 0,0:18:43.82,0:18:44.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:18:45.09,0:18:48.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlahir kembali menjadi orang lain\Ndengan jiwa yang sama.
Dialogue: 0,0:18:48.88,0:18:51.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak sengaja pernah dengar cerita itu.
Dialogue: 0,0:18:52.50,0:18:55.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada sihir seperti itu, pasti indah, ya.
Dialogue: 0,0:18:56.37,0:18:57.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di tempat yang bukan di sini.
Dialogue: 0,0:18:58.83,0:19:03.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang bukan seorang putri dan kamu\Nyang bukan penyihir istana akan bertemu.
Dialogue: 0,0:19:04.46,0:19:07.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau momen itu tiba,\Nmaukah kamu jadi temanku lagi?
Dialogue: 0,0:19:07.54,0:19:08.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ryusei!
Dialogue: 0,0:19:09.23,0:19:10.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri...
Dialogue: 0,0:19:10.96,0:19:13.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ryusei. Ryusei!
Dialogue: 0,0:19:16.66,0:19:17.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:19:18.00,0:19:19.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meteor?
Dialogue: 0,0:19:19.18,0:19:20.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah sadar?
Dialogue: 0,0:19:20.91,0:19:22.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu ada di kamarku?
Dialogue: 0,0:19:22.62,0:19:26.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tak mengajar hari ini, kan?\NAku kira terjadi sesuatu padamu.
Dialogue: 0,0:19:26.98,0:19:30.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, mungkin aku terus tidur\Nkarena mana-ku habis.
Dialogue: 0,0:19:32.11,0:19:33.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:19:34.50,0:19:37.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara aku terserap ke dalam cincin itu...
Dialogue: 0,0:19:37.17,0:19:39.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berujung merepotkan banyak orang.
Dialogue: 0,0:19:39.76,0:19:41.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan dipikirkan.
Dialogue: 0,0:19:42.10,0:19:44.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sendiri bagaimana?\NLukamu sudah sembuh?
Dialogue: 0,0:19:44.66,0:19:45.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baik-baik saja!
Dialogue: 0,0:19:45.92,0:19:48.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat perlindungan para roh,\Nlukaku cepat sembuh!
Dialogue: 0,0:19:49.52,0:19:50.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meteor.
Dialogue: 0,0:19:51.12,0:19:52.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:19:52.83,0:19:54.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua ini terjadi karena ulahku.
Dialogue: 0,0:19:55.15,0:19:57.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memanfaatkanmu, membuatmu menderita,
Dialogue: 0,0:19:57.79,0:20:00.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}baik di kehidupanmu sebelumnya\Nmaupun setelah bereinkarnasi.
Dialogue: 0,0:20:01.46,0:20:02.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar minta maaf.
Dialogue: 0,0:20:03.52,0:20:05.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.\NTidak apa-apa.
Dialogue: 0,0:20:06.32,0:20:08.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain karena kamu mengalahkanku,
Dialogue: 0,0:20:08.32,0:20:09.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku memaafkanmu.
Dialogue: 0,0:20:09.09,0:20:10.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata masih dendam!
Dialogue: 0,0:20:10.61,0:20:11.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini.
Dialogue: 0,0:20:12.69,0:20:15.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri itu orangnya seperti apa?
Dialogue: 0,0:20:15.78,0:20:17.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tiba-tiba bahas itu?
Dialogue: 0,0:20:17.49,0:20:20.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kamu terus mengigaukan itu saat tidur.
Dialogue: 0,0:20:23.12,0:20:28.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia putri Kerajaan Runeberg\Nsekaligus Gadis Suci.
Dialogue: 0,0:20:28.99,0:20:31.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kadang mampir ke ruang penelitianku.
Dialogue: 0,0:20:31.63,0:20:35.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saat di sana, Putri melepas topengnya\Ndan menjadi seorang gadis biasa.
Dialogue: 0,0:20:36.82,0:20:40.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya dia selalu memandang\Nke suatu tempat yang jauh dari sana.
Dialogue: 0,0:20:41.70,0:20:44.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia orang yang unik,\Nseperti bukan penghuni dunia kita.
Dialogue: 0,0:20:44.56,0:20:46.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti idola sekolah
Dialogue: 0,0:20:46.03,0:20:48.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang sering datang ke ekskul otaku.
Dialogue: 0,0:20:48.52,0:20:50.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perumpamaannya kejam!
Dialogue: 0,0:20:50.74,0:20:54.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai rela mengorbankan nyawanya\Ndemi balas dendam, ya.
Dialogue: 0,0:20:55.07,0:20:57.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku agak iri padanya.
Dialogue: 0,0:20:57.01,0:20:58.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya gagal melindunginya.
Dialogue: 0,0:20:59.46,0:21:01.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya itu yang bisa kulakukan.
Dialogue: 0,0:21:02.06,0:21:04.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku pasti akan melindungimu.\NApa pun yang terjadi.
Dialogue: 0,0:21:04.45,0:21:05.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:21:05.91,0:21:07.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku gurumu.
Dialogue: 0,0:21:07.49,0:21:09.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan melindungimu dan semua murid.
Dialogue: 0,0:21:09.87,0:21:11.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya.
Dialogue: 0,0:21:12.25,0:21:14.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai kakak, kamu juga harus melindungiku!
Dialogue: 0,0:21:14.72,0:21:17.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu sebagai anak sulung,\Nlindungi keluarga juga!
Dialogue: 0,0:21:19.05,0:21:21.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bebannya berat...
Dialogue: 0,0:22:51.10,0:22:54.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kamu datang lagi,\Nbos dari perusahaan gelap itu.
Dialogue: 0,0:22:54.85,0:22:59.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, kamu adik dari mantan kakak\Npengangguran yang punya pacar seram itu, ya?
Dialogue: 0,0:22:59.40,0:23:00.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kabarmu?
Dialogue: 0,0:23:00.36,0:23:01.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara bicaramu...
Dialogue: 0,0:23:01.86,0:23:03.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama-sama menyindir, kan?
Dialogue: 0,0:23:04.38,0:23:06.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang kembali.
Dialogue: 0,0:23:06.11,0:23:10.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, ada cerita baru\Ndari cinta komedi romantis kakakmu?
Dialogue: 0,0:23:10.74,0:23:12.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada.
Dialogue: 0,0:23:12.08,0:23:17.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kakakku jatuh sakit beberapa hari lalu,\Npacarnya terus menemani dan merawatnya.
Dialogue: 0,0:23:17.21,0:23:18.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sangat perhatian, ya.
Dialogue: 0,0:23:18.92,0:23:23.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, yang kudengar kakakku\Njatuh sakit gara-gara pacarnya.
Dialogue: 0,0:23:23.05,0:23:25.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata pacarnya memang seram!
Dialogue: 0,0:23:26.61,0:23:28.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langit tahu, Bumi tahu, dan manusia pun tahu!
Dialogue: 0,0:23:28.72,0:23:30.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perkenalkan koleksi\Nbarang-barang terkutuk kami!
Dialogue: 0,0:23:30.80,0:23:32.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang di Kanal Pandora!
Dialogue: 0,0:23:32.62,0:23:34.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pandora, sepertinya penonton\Nkali ini lebih banyak.
Dialogue: 0,0:23:34.81,0:23:37.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena benda berikutnya sangat spesial!
Dialogue: 0,0:23:37.23,0:23:39.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lupa klik suka dan berlangganan, ya!
Dialogue: 0,0:23:39.79,0:23:41.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nantikan, ya!
