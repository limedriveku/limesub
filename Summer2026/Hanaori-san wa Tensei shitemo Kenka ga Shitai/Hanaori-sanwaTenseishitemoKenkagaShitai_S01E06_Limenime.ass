Dialogue: 0,0:00:03.95,0:00:05.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Bokong Persik.
Dialogue: 0,0:00:05.71,0:00:07.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggil aku Hanaori.
Dialogue: 0,0:00:07.16,0:00:09.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa berubah jadi hewan,\Nkamu mau jadi apa?
Dialogue: 0,0:00:09.70,0:00:10.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kucing!
Dialogue: 0,0:00:10.71,0:00:11.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:00:11.91,0:00:14.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rapalan sihir!
Dialogue: 0,0:00:14.73,0:00:15.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:00:20.79,0:00:22.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhasil.
Dialogue: 0,0:00:22.25,0:00:23.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya ini?
Dialogue: 0,0:00:25.04,0:00:27.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sedang mengembangkan sihir baru.
Dialogue: 0,0:00:27.68,0:00:30.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir yang bisa mengubah teman\Nmenjadi bentuk lain dengan aman.
Dialogue: 0,0:00:30.91,0:00:32.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menjadikanku bahan eksperimen?
Dialogue: 0,0:00:32.99,0:00:34.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kan sudah minta persetujuanmu.
Dialogue: 0,0:00:34.92,0:00:37.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan minta persetujuan!
Dialogue: 0,0:00:37.06,0:00:39.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini memang genius, ya.
Dialogue: 0,0:00:39.12,0:00:41.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gunakan bakatmu itu untuk peka, dong!
Dialogue: 0,0:00:41.90,0:00:43.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana rasanya?
Dialogue: 0,0:00:43.31,0:00:45.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Susah dijelaskan!
Dialogue: 0,0:00:46.68,0:00:49.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya puas bisa bicara dengan makhluk
Dialogue: 0,0:00:49.61,0:00:51.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang lebih pendek dariku!
Dialogue: 0,0:00:51.21,0:00:52.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sifatnya ternyata jelek.
Dialogue: 0,0:00:52.82,0:00:55.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, ini efeknya berapa lama?
Dialogue: 0,0:00:55.04,0:00:57.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, efek?
Dialogue: 0,0:01:00.96,0:01:02.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurang lebih...
Dialogue: 0,0:01:02.50,0:01:04.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dua setengah jam.
Dialogue: 0,0:01:05.25,0:01:06.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh!
Dialogue: 0,0:01:06.91,0:01:07.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:01:08.21,0:01:11.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku akan mengembalikan wujudmu.
Dialogue: 0,0:01:12.40,0:01:14.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah.
Dialogue: 0,0:01:16.93,0:01:18.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak begitu!
Dialogue: 0,0:02:52.99,0:02:54.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kucing!
Dialogue: 0,0:02:54.19,0:02:55.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matsurika.
Dialogue: 0,0:02:59.55,0:03:00.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kucing!
Dialogue: 0,0:03:00.87,0:03:03.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia seperti orang mencurigakan...
Dialogue: 0,0:03:03.08,0:03:04.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan kabur! Tunggu!
Dialogue: 0,0:03:04.91,0:03:06.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menakutkan!
Dialogue: 0,0:03:06.75,0:03:08.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau begini?
Dialogue: 0,0:03:10.53,0:03:13.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meong! Meong!
Dialogue: 0,0:03:14.09,0:03:15.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sedang apa?
Dialogue: 0,0:03:16.13,0:03:17.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kucing!
Dialogue: 0,0:03:18.01,0:03:20.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin berteman dengan kucing.
Dialogue: 0,0:03:20.43,0:03:22.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dengan kucing, tidak apa-apa.
Dialogue: 0,0:03:22.32,0:03:24.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ternyata paham perasaan ini?
Dialogue: 0,0:03:24.27,0:03:27.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham.\NKalau sudah begini...
Dialogue: 0,0:03:28.48,0:03:31.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mainan kucing!
Dialogue: 0,0:03:32.31,0:03:34.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sini, sini.
Dialogue: 0,0:03:35.17,0:03:37.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pikir aku akan terpancing?
Dialogue: 0,0:03:39.64,0:03:43.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat! Jiwa kucing dalam diriku bangkit!
Dialogue: 0,0:03:43.33,0:03:44.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meong!
Dialogue: 0,0:03:44.44,0:03:47.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hentikan!\N- Kamu suka ini, kan?
Dialogue: 0,0:03:51.51,0:03:53.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku malah sampai ke ruangannya Ryusei.
Dialogue: 0,0:03:57.63,0:04:00.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata dia sedang serius bekerja.
Dialogue: 0,0:04:02.56,0:04:05.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa? Apa aku ketahuan?
Dialogue: 0,0:04:07.19,0:04:09.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kucing ini tak kabur saat melihatku?
Dialogue: 0,0:04:09.89,0:04:12.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bulunya warna pink lembut...
Dialogue: 0,0:04:12.06,0:04:14.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kucing yang cantik, ya.
Dialogue: 0,0:04:14.39,0:04:16.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kucing yang sangat cantik.
Dialogue: 0,0:04:17.13,0:04:18.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja!
Dialogue: 0,0:04:18.64,0:04:21.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah punya nama?\NSebaiknya dipanggil apa, ya?
Dialogue: 0,0:04:25.08,0:04:28.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, namamu Avante Momoko.
Dialogue: 0,0:04:28.04,0:04:30.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selera penamaannya jelek!
Dialogue: 0,0:04:30.67,0:04:32.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti akan mengutukmu!
Dialogue: 0,0:04:33.05,0:04:34.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang, ya?
Dialogue: 0,0:04:34.07,0:04:36.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin!
Dialogue: 0,0:04:36.47,0:04:38.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mirip salah satu muridku.
Dialogue: 0,0:04:39.87,0:04:41.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia gadis cantik yang sangat pemberani.
Dialogue: 0,0:04:41.72,0:04:45.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Kamu bilang begitu pun percuma.
Dialogue: 0,0:04:46.24,0:04:50.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang aku tak bisa menghubunginya\Ndan membuatku cemas.
Dialogue: 0,0:04:50.07,0:04:52.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga dia tak terlibat masalah.
Dialogue: 0,0:04:53.61,0:04:55.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal terlibat masalah, itu benar.
Dialogue: 0,0:04:58.05,0:05:01.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Firasatku tak enak.\NKita keliling sebentar.
Dialogue: 0,0:05:01.81,0:05:04.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keliling sendirian di sekolah\Nsaat malam hari, ya.
Dialogue: 0,0:05:05.37,0:05:07.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau ada hantu?
Dialogue: 0,0:05:07.61,0:05:08.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lemah!
Dialogue: 0,0:05:08.58,0:05:12.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, dia pernah bilang takut hantu.
Dialogue: 0,0:05:12.29,0:05:14.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantan Raja Iblis Mayat Hidup.\NKenapa bisa takut?
Dialogue: 0,0:05:16.16,0:05:17.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali!
Dialogue: 0,0:05:17.79,0:05:20.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kan kesempatanmu berduaan\Nsama gadis cantik di sekolah malam-malam!
Dialogue: 0,0:05:20.89,0:05:25.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan mungkin saja bisa\Ngandengan tangan atau pelukan.
Dialogue: 0,0:05:25.71,0:05:29.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini tidak ada gadis cantik\Nyang memberimu keberanian!
Dialogue: 0,0:05:31.36,0:05:34.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kucing ini terlihat seram, ya?
Dialogue: 0,0:05:35.51,0:05:36.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pendeteksi EMF!
Dialogue: 0,0:05:36.98,0:05:38.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Termometer!
Dialogue: 0,0:05:38.32,0:05:40.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Spirit box!
Dialogue: 0,0:05:40.79,0:05:44.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah tanggung, kita sekalian coba\Nalat-alat pendeteksi hantu!
Dialogue: 0,0:05:44.44,0:05:48.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia malah terlihat semangat!\NAku jadi ingin ikut!
Dialogue: 0,0:05:48.60,0:05:51.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sekolah tempat para murid-murid\Nberhargaku belajar!
Dialogue: 0,0:05:51.20,0:05:53.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus kupastikan tempat ini aman!
Dialogue: 0,0:05:53.21,0:05:55.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jaga-jaga itu harus!
Dialogue: 0,0:05:55.71,0:05:57.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar.
Dialogue: 0,0:05:57.99,0:06:00.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mulai seperti guru sungguhan.
Dialogue: 0,0:06:01.30,0:06:02.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:06:02.13,0:06:05.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ga-Gawat! Apa ini surga?
Dialogue: 0,0:06:05.69,0:06:08.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku malah ikutan juga.\NJadi malu.
Dialogue: 0,0:06:12.51,0:06:16.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa sekolah di malam hari terasa seram?
Dialogue: 0,0:06:17.06,0:06:20.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm? Kenapa aku sangat penakut?
Dialogue: 0,0:06:20.40,0:06:22.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mungkin penasaran.
Dialogue: 0,0:06:23.23,0:06:24.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu terjadi saat aku masih kecil.
Dialogue: 0,0:06:24.99,0:06:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu aku pergi uji nyali ke pemakaman\Ndi pinggir kota bersama dua teman nakalku.
Dialogue: 0,0:06:30.72,0:06:34.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu, sebenarnya tak terjadi apa pun.
Dialogue: 0,0:06:34.11,0:06:39.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi setelah kami pulang,\Nkondisi si A makin memburuk.
Dialogue: 0,0:06:39.08,0:06:41.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu si B juga jatuh sakit.
Dialogue: 0,0:06:42.57,0:06:45.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu suatu malam, saat aku sedang tidur,
Dialogue: 0,0:06:45.27,0:06:48.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sesuatu muncul dan mencekikku.
Dialogue: 0,0:06:48.68,0:06:51.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sosok itu adalah seorang wanita\Nberpakaian putih.
Dialogue: 0,0:06:53.40,0:06:55.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berteriak keras.
Dialogue: 0,0:06:55.39,0:06:59.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat orang tuaku datang, arwah wanita\Nberpakaian putih itu sudah hilang.
Dialogue: 0,0:07:00.48,0:07:04.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu,\Npara orang dewasa bertanya pada si A.
Dialogue: 0,0:07:04.28,0:07:08.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata dia menemukan sesuatu yang mirip\Njari manusia yang mengering di pemakaman,
Dialogue: 0,0:07:08.73,0:07:11.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu membawanya pulang tanpa izin.
Dialogue: 0,0:07:12.71,0:07:15.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal itu membuat para orang dewasa panik.
Dialogue: 0,0:07:15.37,0:07:19.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka memanggil seorang pendeta dari kota\Ndan melakukan ritual pengusiran roh masif.
Dialogue: 0,0:07:20.29,0:07:23.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu, A dan B kembali sehat,
Dialogue: 0,0:07:23.51,0:07:26.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu arwah wanita putih itu\Ntak pernah muncul lagi.
Dialogue: 0,0:07:27.11,0:07:30.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah pengalaman pertamaku\Ndengan dunia gaib.
Dialogue: 0,0:07:31.06,0:07:33.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu cuma cerita hantu biasa.
Dialogue: 0,0:07:33.84,0:07:35.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku akan melindungimu.
Dialogue: 0,0:07:37.44,0:07:41.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatanku ada untuk mengatasi\Nrasa takut terhadap hantu.
Dialogue: 0,0:07:42.53,0:07:45.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai mantan Raja Iblis, tujuanmu kecil.
Dialogue: 0,0:07:49.33,0:07:50.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita istirahat sebentar.
Dialogue: 0,0:07:51.37,0:07:53.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah menemaniku.
Dialogue: 0,0:07:53.08,0:07:55.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sembarangan menyentuhku!
Dialogue: 0,0:07:55.77,0:07:57.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar Meteor.
Dialogue: 0,0:07:57.41,0:08:00.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ponselnya tak bisa dihubungi.\NAlat pendeteksi pun tak bereaksi.
Dialogue: 0,0:08:00.91,0:08:02.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tas dan sepatunya juga masih ada.
Dialogue: 0,0:08:03.39,0:08:06.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan dia masuk\Nke pintu dimensi lain?
Dialogue: 0,0:08:07.56,0:08:10.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, dia mudah cemas, ya.
Dialogue: 0,0:08:10.64,0:08:12.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya dia pergi ke mana?
Dialogue: 0,0:08:12.95,0:08:14.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:08:18.45,0:08:19.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:08:21.83,0:08:24.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada di sini.
Dialogue: 0,0:08:24.52,0:08:25.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:08:26.28,0:08:29.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir jahat mengubahku menjadi kucing.
Dialogue: 0,0:08:29.05,0:08:31.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Itu pasti berat, ya.
Dialogue: 0,0:08:40.28,0:08:42.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi...
Dialogue: 0,0:08:42.78,0:08:45.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat... pagi.
Dialogue: 0,0:08:45.51,0:08:46.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yaho!
Dialogue: 0,0:08:48.13,0:08:52.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pagi, Meteor.\NKemarin ada kucing di sekolah.
Dialogue: 0,0:08:52.09,0:08:53.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:08:53.67,0:08:55.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kucing tersesat.
Dialogue: 0,0:08:55.56,0:08:56.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahu tidak?
Dialogue: 0,0:08:56.83,0:08:59.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kucing punya delapan puting di perutnya.
Dialogue: 0,0:08:59.75,0:09:01.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, sensitivitasnya empat kali lipat, ya?
Dialogue: 0,0:09:01.77,0:09:03.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana kutahu!
Dialogue: 0,0:09:03.17,0:09:04.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu marah?
Dialogue: 0,0:09:08.61,0:09:10.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Bokong Persik.
Dialogue: 0,0:09:10.07,0:09:12.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, namaku Hanaori.
Dialogue: 0,0:09:12.08,0:09:15.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu lebih suka Putri Salju\Natau Putri Duyung?
Dialogue: 0,0:09:15.20,0:09:16.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Putri?
Dialogue: 0,0:09:16.41,0:09:17.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri Duyung!
Dialogue: 0,0:09:17.92,0:09:19.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:09:19.57,0:09:21.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rapalan sihir!
Dialogue: 0,0:09:21.58,0:09:23.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Lagi?
Dialogue: 0,0:09:29.51,0:09:30.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhasil.
Dialogue: 0,0:09:30.97,0:09:33.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga belajar sihir pembungkam.
Dialogue: 0,0:09:33.23,0:09:35.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini memang genius, ya.
Dialogue: 0,0:09:36.33,0:09:38.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu? Kamu itu apa?
Dialogue: 0,0:09:39.88,0:09:42.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Burung? Merpati?
Dialogue: 0,0:09:45.77,0:09:48.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laser!\NJawaban yang benar itu Laser Merpati!
Dialogue: 0,0:09:49.37,0:09:52.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dansa?\NJadi ini Dansa Merpati yang terkenal itu?
Dialogue: 0,0:09:54.24,0:09:56.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawabannya adalah Pukulan Pahlawan.
Dialogue: 0,0:10:01.16,0:10:03.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa? Lapar?
Dialogue: 0,0:10:04.55,0:10:06.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nih, aku punya camilan.
Dialogue: 0,0:10:06.99,0:10:08.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Apa?
Dialogue: 0,0:10:08.29,0:10:10.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada seseorang di sana?
Dialogue: 0,0:10:10.79,0:10:13.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ular? Ada pawang ular muncul?
Dialogue: 0,0:10:14.53,0:10:15.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laser?
Dialogue: 0,0:10:15.93,0:10:18.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mengalahkannya dengan Laser Pahlawan?
Dialogue: 0,0:10:18.10,0:10:21.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.\NTernyata kamu sangat senang, ya.
Dialogue: 0,0:10:23.24,0:10:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawabannya adalah Pukulan Pahlawan.
Dialogue: 0,0:10:29.01,0:10:30.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisikan Sylph.
Dialogue: 0,0:10:31.13,0:10:32.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir roh?
Dialogue: 0,0:10:33.15,0:10:34.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa dengar aku?
Dialogue: 0,0:10:35.19,0:10:36.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu terlalu dekat!
Dialogue: 0,0:10:36.60,0:10:38.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat!
Dialogue: 0,0:10:38.88,0:10:45.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir ini hanya bisa mengirimkan bisikan\Nke orang yang bersentuhan denganmu.
Dialogue: 0,0:10:45.47,0:10:49.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu pemulihannya lama,\Njadi jangan lepaskan tanganku.
Dialogue: 0,0:10:49.04,0:10:51.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, sebenarnya ada apa?
Dialogue: 0,0:10:51.33,0:10:54.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kena ulah si penyihir\Nmuka berbintik itu lagi.
Dialogue: 0,0:10:54.19,0:10:56.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ini bahan percobaan dia?
Dialogue: 0,0:10:56.39,0:10:57.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini?
Dialogue: 0,0:10:57.97,0:11:00.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suruh dia untuk membatalkannya.
Dialogue: 0,0:11:00.43,0:11:02.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku malah memukulnya lalu kabur.
Dialogue: 0,0:11:02.93,0:11:04.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat kembali dan minta maaf.
Dialogue: 0,0:11:06.65,0:11:09.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, panjang umur, ini Takigawa.
Dialogue: 0,0:11:10.52,0:11:12.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya ada monster muncul di sekolah.
Dialogue: 0,0:11:13.65,0:11:18.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya monsternya seperti\Nprajurit wanita seksi yang sesuai seleraku.
Dialogue: 0,0:11:19.45,0:11:21.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti dia?
Dialogue: 0,0:11:21.03,0:11:21.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:11:31.34,0:11:32.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabur!
Dialogue: 0,0:11:34.53,0:11:35.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lari!
Dialogue: 0,0:11:50.97,0:11:53.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dia bereaksi terhadap suara.
Dialogue: 0,0:11:53.59,0:11:55.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jantungku berdegup kencang.
Dialogue: 0,0:11:55.63,0:11:57.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa malah tegang?
Dialogue: 0,0:11:57.55,0:11:59.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin karena takut.
Dialogue: 0,0:12:01.39,0:12:04.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dia pergi ke sana?
Dialogue: 0,0:12:04.92,0:12:07.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, kamu pernah nonton drama zombi?
Dialogue: 0,0:12:07.47,0:12:09.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zombi di drama itu juga bereaksi\Nterhadap suara, ya?
Dialogue: 0,0:12:09.92,0:12:12.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya sekarang perlu membahas itu?
Dialogue: 0,0:12:12.17,0:12:15.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zombi yang bisa lari itu benar-benar\Npenemuan yang paling buruk.
Dialogue: 0,0:12:16.13,0:12:19.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau zombi seperti itu muncul,\Numat manusia pasti tamat.
Dialogue: 0,0:12:19.03,0:12:20.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau di dunia kita,
Dialogue: 0,0:12:20.76,0:12:24.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}zombi seperti itu bisa kita basmi\Ndengan kekuatan para pendeta.
Dialogue: 0,0:12:24.43,0:12:26.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turn Undead memang sangat berguna, ya.
Dialogue: 0,0:12:26.81,0:12:29.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para pendeta memang hebat.
Dialogue: 0,0:12:29.28,0:12:32.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, mereka wajib dibawa ke tim.
Dialogue: 0,0:12:32.06,0:12:35.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ryusei, kamu lebih suka pendeta\Natau pahlawan?
Dialogue: 0,0:12:35.28,0:12:37.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sebenarnya sedang bahas apa?
Dialogue: 0,0:12:38.12,0:12:40.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kamu dengar aku tidak?
Dialogue: 0,0:12:40.95,0:12:41.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:12:43.12,0:12:44.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu malu, ya?
Dialogue: 0,0:12:45.40,0:12:47.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu deg-degan gara-gara aku?
Dialogue: 0,0:12:47.85,0:12:52.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau... kamu takut hantu?
Dialogue: 0,0:12:52.40,0:12:53.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar Pahlawan Bodoh!
Dialogue: 0,0:12:53.84,0:12:57.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembali ke topik awal, si pemeran\Nutama wanita di drama itu cantik, ya.
Dialogue: 0,0:12:57.49,0:12:59.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita masih lanjut membahas itu?
Dialogue: 0,0:12:59.43,0:13:03.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekilas dia terlihat galak,\Ntapi sebenarnya baik dan ramah.
Dialogue: 0,0:13:03.67,0:13:05.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia agak mirip Matsurika, ya?
Dialogue: 0,0:13:06.75,0:13:08.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mirip, ya?\NBegitu.
Dialogue: 0,0:13:10.05,0:13:12.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dia mirip seseorang...
Dialogue: 0,0:13:15.52,0:13:18.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku dia mirip kamu.
Dialogue: 0,0:13:26.72,0:13:27.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat!
Dialogue: 0,0:13:38.32,0:13:39.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf membuat kalian menunggu.
Dialogue: 0,0:13:40.17,0:13:43.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya... pas sekali!
Dialogue: 0,0:13:43.13,0:13:44.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:13:47.56,0:13:49.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi itu pengalaman buruk.
Dialogue: 0,0:13:49.25,0:13:51.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nasib kita sial, ya.
Dialogue: 0,0:13:56.13,0:13:57.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:13:58.16,0:14:00.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi agak seru, ya?
Dialogue: 0,0:14:17.41,0:14:19.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Ini...
Dialogue: 0,0:14:20.52,0:14:22.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Surat cinta?
Dialogue: 0,0:14:28.57,0:14:31.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, surat ini...
Dialogue: 0,0:14:31.83,0:14:33.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu yang buat?
Dialogue: 0,0:14:35.52,0:14:36.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Narukami-sensei.
Dialogue: 0,0:14:37.69,0:14:38.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu murid kelas 2-3,
Dialogue: 0,0:14:39.25,0:14:40.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asahina Eriko-kun?
Dialogue: 0,0:14:41.92,0:14:44.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sensei, aku punya permintaan.
Dialogue: 0,0:14:48.91,0:14:50.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sensei...
Dialogue: 0,0:14:51.79,0:14:53.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong matilah!
Dialogue: 0,0:14:53.91,0:14:54.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:14:54.92,0:14:57.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasakan kekuatan\Nsihir kegelapan yang sangat kuat darimu.
Dialogue: 0,0:14:57.93,0:14:59.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Retakan dimensi itu pasti ulahmu, ya?
Dialogue: 0,0:14:59.93,0:15:01.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu, kamu salah paham!
Dialogue: 0,0:15:02.09,0:15:04.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kamu tahu tentang insiden\Nretakan dimensi, ya?
Dialogue: 0,0:15:04.69,0:15:07.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, kamu juga tahu tentang kekuatanku.
Dialogue: 0,0:15:07.53,0:15:11.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asahina Eriko, kamu sebenarnya siapa?
Dialogue: 0,0:15:11.44,0:15:13.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa diriku itu tak ada kaitannya!
Dialogue: 0,0:15:13.87,0:15:16.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kamu akan kukalahkan!
Dialogue: 0,0:15:17.53,0:15:18.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berubah!
Dialogue: 0,0:15:38.84,0:15:40.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis penyihir?
Dialogue: 0,0:15:40.75,0:15:43.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir jahat!\NBersiaplah!
Dialogue: 0,0:15:43.55,0:15:45.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Su-Sudah kubilang kamu salah paham!
Dialogue: 0,0:15:45.51,0:15:47.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Magical Fire!
Dialogue: 0,0:15:51.65,0:15:53.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ryusei, kamu baik-baik saja?
Dialogue: 0,0:15:53.51,0:15:54.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tertolong!
Dialogue: 0,0:15:54.81,0:15:58.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menahan sihirku dengan pedang?
Dialogue: 0,0:15:58.02,0:15:59.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Gadis cantik!
Dialogue: 0,0:15:59.83,0:16:01.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, lakon wanita baru?
Dialogue: 0,0:16:01.65,0:16:02.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu salah paham.
Dialogue: 0,0:16:02.73,0:16:06.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kamu, ya, gadis yang pacaran\Ndengan guru pria?
Dialogue: 0,0:16:06.52,0:16:08.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumornya kamu suka buat masalah di sekolah.
Dialogue: 0,0:16:08.43,0:16:09.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu salah paham!
Dialogue: 0,0:16:10.03,0:16:13.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu, kenapa membela orang seperti dia?
Dialogue: 0,0:16:13.58,0:16:15.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Benar juga.
Dialogue: 0,0:16:15.54,0:16:18.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah ditipu oleh pria jahat itu!
Dialogue: 0,0:16:18.54,0:16:21.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau soal jahat, aku akui itu benar.
Dialogue: 0,0:16:21.04,0:16:22.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya jangan setuju.
Dialogue: 0,0:16:22.63,0:16:24.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:16:24.00,0:16:26.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah jadi objek operasi pria itu, ya?
Dialogue: 0,0:16:26.59,0:16:27.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu salah paham!
Dialogue: 0,0:16:27.80,0:16:29.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah banyak melanggar!
Dialogue: 0,0:16:29.09,0:16:31.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu!
Dialogue: 0,0:16:31.85,0:16:33.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, sudahlah!
Dialogue: 0,0:16:33.55,0:16:35.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa begitu!\NLuruskan kesalahpahaman ini!
Dialogue: 0,0:16:36.35,0:16:38.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar sukubus sialan!
Dialogue: 0,0:16:38.17,0:16:40.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf saja, tapi aku akan segera mengalahkanmu!
Dialogue: 0,0:16:40.60,0:16:42.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi kamu bilang apa?
Dialogue: 0,0:16:42.33,0:16:43.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sukubus.
Dialogue: 0,0:16:43.44,0:16:45.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan sukubus!
Dialogue: 0,0:16:45.25,0:16:46.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah jelas aku ini gadis penyihir!
Dialogue: 0,0:16:46.94,0:16:48.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana ada gadis penyihir montok sepertimu!
Dialogue: 0,0:16:48.81,0:16:49.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada di sini!
Dialogue: 0,0:16:49.91,0:16:52.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga gadis penyihir, kan?
Dialogue: 0,0:16:52.32,0:16:53.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:16:53.51,0:16:54.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:16:54.53,0:16:58.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pahlawan yang bereinkarnasi ke dunia ini.
Dialogue: 0,0:16:58.01,0:17:02.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak pernah dijadikan objek operasi\Ndan juga bukan gadis penyihir!
Dialogue: 0,0:17:02.17,0:17:05.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga bukan dalang\Ndi balik retakan dimensi itu.
Dialogue: 0,0:17:05.13,0:17:07.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga bukan sukubus.
Dialogue: 0,0:17:09.10,0:17:11.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi semuanya cuma salah paham.
Dialogue: 0,0:17:11.36,0:17:13.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi yang benar itu yang mana?
Dialogue: 0,0:17:15.28,0:17:17.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Nkita mulai dari perkenalan diri dulu.
Dialogue: 0,0:17:18.41,0:17:21.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mantan Raja Iblis\Nyang bereinkarnasi dari dunia lain.
Dialogue: 0,0:17:21.41,0:17:24.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya sedikit membantu\Nmenyelidiki insiden retakan dimensi,
Dialogue: 0,0:17:24.88,0:17:28.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi intinya, aku tak ikut campur\Nsoal masalah di dunia ini.
Dialogue: 0,0:17:28.92,0:17:30.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantan Raja Iblis?
Dialogue: 0,0:17:30.71,0:17:33.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya aku merasakan\Nkekuatan sihir kegelapan darimu, ya?
Dialogue: 0,0:17:33.82,0:17:35.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Pahlawan!
Dialogue: 0,0:17:35.63,0:17:38.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah tahu Raja Iblis bereinkarnasi,\Naku mengejarnya ke sini!
Dialogue: 0,0:17:38.89,0:17:42.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengawasinya.\NTak akan kubiarkan dia berbuat jahat.
Dialogue: 0,0:17:42.29,0:17:44.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, jadi begitu, ya.
Dialogue: 0,0:17:44.57,0:17:47.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah mengganggu kehidupan\Nsekolah kalian yang menyenangkan.
Dialogue: 0,0:17:47.42,0:17:48.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang salah paham!
Dialogue: 0,0:17:49.21,0:17:52.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah menyerangmu karena salah paham.
Dialogue: 0,0:17:53.21,0:17:55.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Asahi, Gadis Penyihir.
Dialogue: 0,0:17:55.39,0:17:59.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku datang dari dimensi lain,\Ndunia yang disebut Earth 13.
Dialogue: 0,0:17:59.93,0:18:02.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dimensi lain?
Dialogue: 0,0:18:03.15,0:18:07.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, di alam semesta ini\Nada banyak dunia paralel.
Dialogue: 0,0:18:08.63,0:18:13.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku adalah versi lain\Ndari Asahina Eriko di dunia ini.
Dialogue: 0,0:18:13.12,0:18:17.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terseret ke dalam retakan dimensi\Ndan berujung tersesat ke dunia ini.
Dialogue: 0,0:18:17.49,0:18:19.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini yang disebut multisemesta?
Dialogue: 0,0:18:20.67,0:18:24.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Retakan dimensi itu terhubung\Nke dunia paralel lain?
Dialogue: 0,0:18:24.95,0:18:26.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya begitu.
Dialogue: 0,0:18:26.65,0:18:32.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia ini menjadi sangat tidak stabil\Nkarena banyaknya retakan dimensi.
Dialogue: 0,0:18:32.16,0:18:34.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi meningkatnya kemunculan monster pun
Dialogue: 0,0:18:34.67,0:18:38.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}retakan dimensinya makin banyak\Ndan makin besar?
Dialogue: 0,0:18:38.63,0:18:42.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati, masih ada sesuatu\Nyang tersembunyi di balik insiden ini.
Dialogue: 0,0:18:46.42,0:18:50.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, Hanaori-san.\NKamu bilang bukan gadis penyihir,
Dialogue: 0,0:18:50.19,0:18:52.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku merasakan kekuatan roh dari tubuhmu.
Dialogue: 0,0:18:52.69,0:18:54.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena aku Pahlawan
Dialogue: 0,0:18:54.81,0:18:57.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan dapat perlindungan dari roh cahaya.
Dialogue: 0,0:18:57.41,0:18:58.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pahlawan?
Dialogue: 0,0:18:58.85,0:19:01.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kelihatan bingung, ya.
Dialogue: 0,0:19:01.12,0:19:04.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal itu peran yang cukup terkenal.
Dialogue: 0,0:19:04.12,0:19:07.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku juga bisa menjadi gadis penyihir?
Dialogue: 0,0:19:07.33,0:19:10.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena dapat pelindungan roh, harusnya bisa.
Dialogue: 0,0:19:10.41,0:19:12.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa penampilanku akan begitu juga?
Dialogue: 0,0:19:12.09,0:19:13.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin.
Dialogue: 0,0:19:13.30,0:19:16.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membayangkan...
Dialogue: 0,0:19:18.67,0:19:22.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, kostum ini terlalu pendek!
Dialogue: 0,0:19:22.16,0:19:23.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lihat ke sini!
Dialogue: 0,0:19:23.99,0:19:26.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan!
Dialogue: 0,0:19:26.19,0:19:28.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan membayangkannya! Bodoh! Mesum!
Dialogue: 0,0:19:33.05,0:19:35.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Multisemesta, ya?
Dialogue: 0,0:19:35.40,0:19:39.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti dunia pedang dan sihir\Ntempat kita dulu juga salah satunya?
Dialogue: 0,0:19:39.49,0:19:42.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dunia aku menjadi\Ngadis penyihir juga ada?
Dialogue: 0,0:19:43.83,0:19:45.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menatapku mesum lagi!
Dialogue: 0,0:19:45.43,0:19:46.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lihat ke sini!
Dialogue: 0,0:19:46.58,0:19:48.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak lihat!
Dialogue: 0,0:19:48.63,0:19:49.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seram!
Dialogue: 0,0:19:49.88,0:19:54.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abaikan aku, silakan lanjutkan\Nmasalah dunia kalian berdua.
Dialogue: 0,0:19:54.15,0:19:55.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia komedi romantis...
Dialogue: 0,0:19:55.84,0:19:57.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu salah paham!
Dialogue: 0,0:21:30.17,0:21:31.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kujelaskan!
Dialogue: 0,0:21:32.36,0:21:37.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis Penyihir Asahi, mengakunya begitu,\Nadalah gadis penyihir dari dimensi lain!
Dialogue: 0,0:21:37.31,0:21:42.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena insiden tak terduga, dia jatuh\Nke dalam retakan dimensi dan tiba di dunia ini!
Dialogue: 0,0:21:42.30,0:21:46.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dialah saksi hidup multisemesta,\NGadis Penyihir Asahi!
Dialogue: 0,0:21:48.37,0:21:51.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis Penyihir Eritan, pergi bertugas!
Dialogue: 0,0:21:51.00,0:21:53.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan panggil aku Eritan!
Dialogue: 0,0:22:08.52,0:22:10.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak akan menoleransi hal-hal mesum!
Dialogue: 0,0:22:22.99,0:22:26.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat terjatuh ke dalam retakan dan terbangun,\Naku merasa ada sesuatu yang aneh.
Dialogue: 0,0:22:29.31,0:22:30.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bulannya hanya satu?
Dialogue: 0,0:22:31.83,0:22:34.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sekolahku... cuma ada manusia!
Dialogue: 0,0:22:34.58,0:22:37.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenshinhan di Kanto sausnya asam manis?
Dialogue: 0,0:22:37.71,0:22:41.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu aku sadar.\NDunia ini pasti dimensi lain.
Dialogue: 0,0:22:41.51,0:22:44.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku penasaran soal Tenshinhan.
Dialogue: 0,0:22:44.80,0:22:46.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya dengan\Ncuma ada manusia di dunia ini?
Dialogue: 0,0:22:46.97,0:22:52.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sekolahku ada manusia kadal, robot,\Ndan alien berbentuk jamur beracun.
Dialogue: 0,0:22:52.08,0:22:54.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekolahmu sangat unik, ya.
Dialogue: 0,0:22:54.89,0:22:58.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu hebat bisa tetap tenang\Ndan mengatasi situasi seperti itu, ya.
Dialogue: 0,0:22:59.01,0:23:03.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di duniaku, karena berbagai hal, penelitian\Ntentang multisemesta sudah sangat maju.
Dialogue: 0,0:23:03.76,0:23:06.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa bertindak karena\Nsudah paham hal-hal seperti itu.
Dialogue: 0,0:23:06.32,0:23:09.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dimensi lain itu ada apa saja?
Dialogue: 0,0:23:09.53,0:23:12.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga. Misalnya...
Dialogue: 0,0:23:12.20,0:23:14.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia pria dan wanita bertukar peran.
Dialogue: 0,0:23:15.29,0:23:17.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia yang dihuni hewan.
Dialogue: 0,0:23:18.50,0:23:20.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia yang dihuni mesin.
Dialogue: 0,0:23:22.01,0:23:23.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bohong.
Dialogue: 0,0:23:23.04,0:23:24.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku serius!
Dialogue: 0,0:23:25.71,0:23:29.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Dorothy dari OZ.\NKemampuanku bisa menerawang.
Dialogue: 0,0:23:29.20,0:23:33.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minggu depan, Hanaori Meteor\Nakan sangat merepotkan kalian.
Dialogue: 0,0:23:33.27,0:23:34.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati, ya.
Dialogue: 0,0:23:34.29,0:23:37.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu tiap episode.\NTak perlu diingatkan pun kami sudah tahu.
Dialogue: 0,0:23:37.31,0:23:38.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu, ya.
Dialogue: 0,0:23:38.37,0:23:40.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiap episode.
