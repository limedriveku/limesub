Dialogue: 0,0:01:41.71,0:01:45.13,sign,,0000,0000,0000,,HANAORI METEOR\NREINKARNASI PAHLAWAN
Dialogue: 0,0:02:42.89,0:02:49.94,sign,,0000,0000,0000,,HANAORI-SAN STILL WANTS\NTO FIGHT IN THE NEXT LIFE
Dialogue: 0,0:02:56.78,0:03:00.03,sign,,0000,0000,0000,,EPISODE 12: CINTA SEBENARNYA
Dialogue: 0,0:03:05.54,0:03:10.50,sign,,0000,0000,0000,,BERKAT BAGI SANG PAHLAWAN
Dialogue: 0,0:03:57.93,0:04:01.39,sign,,0000,0000,0000,,LLOYD: KESATRIA
Dialogue: 0,0:04:01.39,0:04:04.97,sign,,0000,0000,0000,,ANRI: PENYIHIR
Dialogue: 0,0:04:04.97,0:04:07.57,sign,,0000,0000,0000,,KARIS: PENGINTAI
Dialogue: 0,0:04:07.57,0:04:09.44,sign,,0000,0000,0000,,METEOR: PENDEKAR PEDANG
