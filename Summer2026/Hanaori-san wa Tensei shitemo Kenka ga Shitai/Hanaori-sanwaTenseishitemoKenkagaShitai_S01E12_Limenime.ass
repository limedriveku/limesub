Dialogue: 0,0:12:01.53,0:12:03.04,sign,,0000,0000,0000,,HANAORI-SAN STILL WANTS\NTO FIGHT IN THE NEXT LIFE
Dialogue: 0,0:12:03.04,0:12:07.46,sign,,0000,0000,0000,,BALADA SANG PAHLAWAN DAN SI ADIK
Dialogue: 0,0:12:13.71,0:12:17.47,sign,,0000,0000,0000,,SILAU
Dialogue: 0,0:14:04.87,0:14:07.83,sign,,0000,0000,0000,,SYOK
Dialogue: 0,0:14:10.45,0:14:12.92,sign,,0000,0000,0000,,JENG
Dialogue: 0,0:14:12.92,0:14:18.55,sign,,0000,0000,0000,,JRENG
Dialogue: 0,0:14:18.55,0:14:19.73,sign,,0000,0000,0000,,UWAWA
Dialogue: 0,0:14:24.93,0:14:25.47,sign,,0000,0000,0000,,PYO
Dialogue: 0,0:15:37.33,0:15:41.17,sign,,0000,0000,0000,,PWEH
Dialogue: 0,0:15:41.17,0:15:45.47,sign,,0000,0000,0000,,PANIK
Dialogue: 0,0:15:45.47,0:15:48.01,sign,,0000,0000,0000,,NYENGIR
Dialogue: 0,0:16:38.77,0:16:41.98,sign,,0000,0000,0000,,DUAR
Dialogue: 0,0:16:54.49,0:16:57.70,sign,,0000,0000,0000,,HARI PERTAMA SERUMAH
Dialogue: 0,0:17:27.04,0:17:31.15,sign,,0000,0000,0000,,TERHARU
Dialogue: 0,0:17:56.14,0:17:59.31,sign,,0000,0000,0000,,MALU
Dialogue: 0,0:17:59.31,0:18:04.77,sign,,0000,0000,0000,,NYENGIR
Dialogue: 0,0:18:38.60,0:18:39.81,sign,,0000,0000,0000,,APA?
Dialogue: 0,0:19:59.34,0:20:04.35,sign,,0000,0000,0000,,MENGEJEK
Dialogue: 0,0:20:21.32,0:20:27.29,sign,,0000,0000,0000,,DPS CHECKER, DAYA SERANG PER DETIK
Dialogue: 0,0:21:11.67,0:21:13.63,sign,,0000,0000,0000,,PWEH
Dialogue: 0,0:22:23.41,0:22:24.86,sign,,0000,0000,0000,,PANGGILAN DARURAT OZ
Dialogue: 0,0:23:40.07,0:23:50.08,sign,,0000,0000,0000,,ILUSTRASI: HIKAWA HEKIRU
Dialogue: 0,0:00:01.62,0:00:03.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bilang,
Dialogue: 0,0:00:03.18,0:00:05.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau Raja Iblisku memang hebat!
Dialogue: 0,0:00:20.56,0:00:22.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sangat seru.
Dialogue: 0,0:00:23.57,0:00:26.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga kita bertemu lagi, rival cintaku.
Dialogue: 0,0:00:36.72,0:00:38.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau kita bertemu lagi.
Dialogue: 0,0:00:39.46,0:00:40.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meteor...
Dialogue: 0,0:00:41.98,0:00:43.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita menang!
Dialogue: 0,0:00:51.32,0:00:53.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami berterima kasih padamu,\NNarukami Ryusei.
Dialogue: 0,0:00:53.87,0:00:55.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:00:55.01,0:00:57.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah menyelamatkan dunia.
Dialogue: 0,0:00:57.57,0:01:01.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Insiden kali ini... rasanya akulah\Nyang memancingnya terjadi.
Dialogue: 0,0:01:01.70,0:01:04.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku punya\Nsegudang keluhan untukmu.
Dialogue: 0,0:01:04.11,0:01:09.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara kalian, semua staf OZ\Nlembur sampai tak tidur.
Dialogue: 0,0:01:10.54,0:01:13.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong biarkan Kuraishi\Ndan Takigawa istirahat.
Dialogue: 0,0:01:13.55,0:01:14.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:01:14.80,0:01:17.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka ikut terlibat menyelamatkan dunia.
Dialogue: 0,0:01:17.28,0:01:20.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhak tidur nyenyak semalam penuh.
Dialogue: 0,0:01:20.27,0:01:22.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma semalam saja?
Dialogue: 0,0:03:23.57,0:03:24.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan melamun!
Dialogue: 0,0:03:33.86,0:03:34.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kena!
Dialogue: 0,0:03:38.51,0:03:39.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang!
Dialogue: 0,0:03:39.62,0:03:41.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan padaku!
Dialogue: 0,0:03:45.47,0:03:46.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini mimpi.
Dialogue: 0,0:03:50.70,0:03:54.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenangan saat aku\Nmasih jadi petualang pemula.
Dialogue: 0,0:03:56.48,0:03:57.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus untuk hari ini!
Dialogue: 0,0:03:58.83,0:04:01.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertarungan kali ini sangat berbahaya.
Dialogue: 0,0:04:01.39,0:04:04.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya kemampuan kita meningkat, kan?
Dialogue: 0,0:04:04.97,0:04:07.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beruntung juga bagian dari kemampuan.
Dialogue: 0,0:04:07.57,0:04:09.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!
Dialogue: 0,0:04:09.44,0:04:12.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus jadi petualang kelas satu!
Dialogue: 0,0:04:13.90,0:04:17.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, sudah dengar belum?\NSoal Meteor Drive.
Dialogue: 0,0:04:17.24,0:04:19.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para Petualang Kelas S\Nyang sedang heboh dibahas itu?
Dialogue: 0,0:04:19.89,0:04:20.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:04:21.38,0:04:25.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabarnya mereka baru saja menaklukkan\NDungeon Jurang Kegelapan Abadi.
Dialogue: 0,0:04:25.07,0:04:27.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu suka topik yang begituan, ya, Lloyd.
Dialogue: 0,0:04:27.41,0:04:29.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga suka, kan, Meteor?
Dialogue: 0,0:04:29.23,0:04:30.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya!
Dialogue: 0,0:04:31.89,0:04:33.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meteor Drive.
Dialogue: 0,0:04:34.02,0:04:37.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim petualang Kelas S legendaris\Nyang terkenal di seluruh dunia
Dialogue: 0,0:04:37.52,0:04:42.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena berhasil menaklukkan\Nberbagai dungeon yang mustahil ditaklukkan.
Dialogue: 0,0:04:43.44,0:04:47.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, te-tentu saja,\Naku penggemar berat mereka!
Dialogue: 0,0:04:47.23,0:04:49.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa anggota yang kamu kagumi?
Dialogue: 0,0:04:49.82,0:04:51.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pendekar pedang,\Nberarti si Kesatria Suci?
Dialogue: 0,0:04:53.02,0:04:55.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si Penyihir Merah Tua...
Dialogue: 0,0:04:58.57,0:05:02.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setiap penyihir, terlahir dengan\Nbakat sihirnya masing-masing,
Dialogue: 0,0:05:02.42,0:05:05.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan Serikat Penyihir\Nmengelompokkannya berdasarkan warna.
Dialogue: 0,0:05:06.16,0:05:09.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari semua Warna Mana,\Nwarna merah tua dianggap
Dialogue: 0,0:05:09.63,0:05:15.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebagai warna terlemah\Ntanpa spesialis apa pun.
Dialogue: 0,0:05:15.18,0:05:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sosok yang berhasil mencapai puncak\NKelas S adalah si Penyihir Merah Tua.
Dialogue: 0,0:05:19.76,0:05:21.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seleramu bagus, ya.
Dialogue: 0,0:05:21.52,0:05:24.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka panutanmu\Nmalah seorang penyihir.
Dialogue: 0,0:05:24.10,0:05:29.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konon si Penyihir Merah Tua\Nbisa merapal tiga sihir sekaligus.
Dialogue: 0,0:05:29.12,0:05:33.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau cuma sihir tingkat rendah\Ntanpa rapalan panjang, aku juga bisa.
Dialogue: 0,0:05:34.06,0:05:37.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru itu, yang dia rapal itu\Ntiga sihir tingkat tinggi sekaligus.
Dialogue: 0,0:05:38.80,0:05:40.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi itu levelnya Kelas S, ya...
Dialogue: 0,0:05:40.99,0:05:45.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Meteor, suatu hari\Nkamu pasti bisa setingkat dengannya.
Dialogue: 0,0:05:46.14,0:05:48.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus giat menaikkan levelku.
Dialogue: 0,0:05:49.79,0:05:53.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu aku sangat mengagumi\Npetualang legendaris itu.
Dialogue: 0,0:05:54.19,0:05:57.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berharap suatu hari bisa mengikuti jejaknya.
Dialogue: 0,0:05:58.09,0:05:59.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh!
Dialogue: 0,0:06:01.95,0:06:03.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma mimpi, ya.
Dialogue: 0,0:06:04.78,0:06:08.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua kepingan teka-tekinya\Nakhirnya tersusun.
Dialogue: 0,0:06:08.75,0:06:12.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir Merah Tua yang menguasai\Nsemua elemen sihir.
Dialogue: 0,0:06:12.78,0:06:18.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konon dia berhenti sebagai petualang\Ndan menjadi penyihir istana di suatu kerajaan.
Dialogue: 0,0:06:18.99,0:06:20.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerajaannya lalu hancur,
Dialogue: 0,0:06:20.69,0:06:25.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kutukan sihir terlarang memberinya\Nkeabadian sebagai Raja Iblis Scarlet Eyes.
Dialogue: 0,0:06:28.05,0:06:29.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin.
Dialogue: 0,0:06:29.62,0:06:33.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tebakanku benar,\Naku harus bagaimana?
Dialogue: 0,0:06:34.29,0:06:37.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah dipikir, selama ini\Naku selalu ditolong olehnya.
Dialogue: 0,0:06:37.87,0:06:40.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata aku belum bisa mengejarnya.
Dialogue: 0,0:06:41.13,0:06:44.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlebih, aku malah banyak tingkah.
Dialogue: 0,0:06:50.90,0:06:53.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ketemu nanti,\Naku bingung harus bagaimana.
Dialogue: 0,0:06:58.92,0:07:02.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saking malunya, Meteor pun tidur lagi.
Dialogue: 0,0:07:09.33,0:07:12.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua, maaf ikut terseret\Nke dalam masalahku.
Dialogue: 0,0:07:12.33,0:07:14.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, kami kerepotan.
Dialogue: 0,0:07:14.02,0:07:17.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa,\Njustru kami merasa terbantu.
Dialogue: 0,0:07:17.76,0:07:21.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kamu hebat bisa mengalahkan\Nmusuh securang itu.
Dialogue: 0,0:07:21.84,0:07:23.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia cuma main-main.
Dialogue: 0,0:07:23.95,0:07:26.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita menang karena dia meremehkan kita.
Dialogue: 0,0:07:26.99,0:07:29.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dari awal kita mengepungnya,
Dialogue: 0,0:07:29.35,0:07:32.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita pasti sudah mati satu per satu.
Dialogue: 0,0:07:32.79,0:07:35.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sengaja bertarung dengan jumlah sedikit.
Dialogue: 0,0:07:36.46,0:07:40.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membuatnya merasa unggul\Njadi penentu kemenangan kita.
Dialogue: 0,0:07:43.12,0:07:45.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir terakhir yang Kuraishi\Nrapalkan itu luar biasa.
Dialogue: 0,0:07:45.90,0:07:49.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kaget karena tiba-tiba\Ndihubungi lewat Telepati.
Dialogue: 0,0:07:50.42,0:07:55.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena aku yakin sihirmu sanggup\Nmenembus titik buta jangkauan dia.
Dialogue: 0,0:07:55.50,0:07:57.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:07:58.06,0:08:01.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Battle Dress-nya Takigawa\Njuga membuatku kagum.
Dialogue: 0,0:08:01.55,0:08:04.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Efek pesona dan selera desainnya...
Dialogue: 0,0:08:04.22,0:08:06.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuanmu sangat hebat, ya.
Dialogue: 0,0:08:06.76,0:08:08.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus puji aku.
Dialogue: 0,0:08:08.45,0:08:11.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis Bokong Persik itu jadi makin imut, kan?
Dialogue: 0,0:08:11.18,0:08:12.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:08:18.00,0:08:21.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya, dia memang imut.
Dialogue: 0,0:08:23.07,0:08:25.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa reaksimu begitu?\NGeli!
Dialogue: 0,0:08:25.36,0:08:26.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pikiranmu kotor!
Dialogue: 0,0:08:26.43,0:08:27.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu!
Dialogue: 0,0:08:40.88,0:08:43.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekacauan kemarin seperti mimpi, ya.
Dialogue: 0,0:08:44.35,0:08:45.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu Earth 10.
Dialogue: 0,0:08:48.59,0:08:53.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu dunia pedang dan sihir\Nyang ingin kamu kunjungi lagi.
Dialogue: 0,0:08:53.17,0:08:56.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia lain juga bagian dari multisemesta.
Dialogue: 0,0:08:56.88,0:08:59.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa mengembalikanmu ke dimensi itu.
Dialogue: 0,0:08:59.71,0:09:02.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatanku sanggup melakukannya.
Dialogue: 0,0:09:02.19,0:09:03.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Amou.
Dialogue: 0,0:09:03.97,0:09:07.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku ingin berjuang di dunia ini.
Dialogue: 0,0:09:07.78,0:09:10.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sadar di atas langit masih ada langit.
Dialogue: 0,0:09:10.42,0:09:13.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalaupun kembali ke sana,\Naku pasti langsung mati!
Dialogue: 0,0:09:13.49,0:09:15.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:09:15.49,0:09:19.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mungkin sempat sedikit salah jalan,
Dialogue: 0,0:09:19.20,0:09:21.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kamu tetaplah pahlawan hebat.
Dialogue: 0,0:09:22.83,0:09:25.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kutunggu perkembanganmu berikutnya.
Dialogue: 0,0:09:27.42,0:09:29.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pahlawan, ya.
Dialogue: 0,0:09:30.38,0:09:31.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takanashi-san.
Dialogue: 0,0:09:32.80,0:09:34.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?
Dialogue: 0,0:09:34.30,0:09:37.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekspresimu terlihat\Nseperti merasakan tanda cinta.
Dialogue: 0,0:09:37.62,0:09:38.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanda cinta?
Dialogue: 0,0:09:38.97,0:09:41.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira kamu kepikiran karena sudah keluar
Dialogue: 0,0:09:41.55,0:09:43.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari zona komedi romantis.
Dialogue: 0,0:09:43.19,0:09:45.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak memikirkan hal itu!
Dialogue: 0,0:09:45.25,0:09:46.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:09:47.65,0:09:51.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, maaf! Sebenarnya aku kepikiran!
Dialogue: 0,0:09:52.82,0:09:57.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis Suci yang ingin menghancurkan dunia\Nberhasil dihentikan Pahlawan dan Raja Iblis.
Dialogue: 0,0:09:57.46,0:10:00.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari semua insiden, ini yang paling kacau.
Dialogue: 0,0:10:00.38,0:10:03.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Insiden seperti ini memang langka.
Dialogue: 0,0:10:03.12,0:10:06.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu masih ada satu hal\Nyang membuatku penasaran.
Dialogue: 0,0:10:06.24,0:10:07.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:10:07.25,0:10:09.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya pahlawan itu apa?
Dialogue: 0,0:10:10.75,0:10:12.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pahlawan, ya.
Dialogue: 0,0:10:13.20,0:10:18.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan, kemenangan, tanggung jawab,\Nharapan, cita-cita.
Dialogue: 0,0:10:19.10,0:10:23.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sosok yang dipaksa memikul\Nsemua ekspektasi itu demi umat manusia.
Dialogue: 0,0:10:23.89,0:10:26.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagiku itu malah seperti kutukan.
Dialogue: 0,0:10:27.62,0:10:29.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku tak akan sanggup.
Dialogue: 0,0:10:30.43,0:10:32.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia itu hebat.
Dialogue: 0,0:10:32.19,0:10:36.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya kamu bilang itu\Ndi depan mukanya, Raja Iblis.
Dialogue: 0,0:10:36.21,0:10:36.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jijik.
Dialogue: 0,0:10:36.94,0:10:39.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konteksnya bukan ke sana!
Dialogue: 0,0:10:39.47,0:10:41.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, sang Pahlawan ke mana?
Dialogue: 0,0:10:41.46,0:10:43.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, dia tidak kelihatan.
Dialogue: 0,0:10:43.25,0:10:46.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bablas kesiangan!
Dialogue: 0,0:10:49.97,0:10:52.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga keberuntungan menyertai sang Pahlawan.
Dialogue: 0,0:10:55.79,0:10:58.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nikmatnya, serasa hidup kembali.
Dialogue: 0,0:10:58.39,0:11:01.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kita sebenarnya nyaris mati.
Dialogue: 0,0:11:01.49,0:11:06.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu terlalu konyol, kita melawan\Nwanita jahat dari dimensi lain.
Dialogue: 0,0:11:06.69,0:11:10.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski membantu Sensei dan yang lainnya,\Nnekat melawan musuh seperti itu,
Dialogue: 0,0:11:10.90,0:11:12.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ternyata kita masih polos, ya.
Dialogue: 0,0:11:12.82,0:11:16.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang kita ke sini cuma ingin curhat\N"Kita juga ikut bantu"?
Dialogue: 0,0:11:17.44,0:11:20.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah lelah bertarung lagi.
Dialogue: 0,0:11:20.00,0:11:23.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, mulai sekarang\Nkita hidup santai dan damai saja.
Dialogue: 0,0:11:23.62,0:11:26.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku akan buat\Nalur komedi romantismu.
Dialogue: 0,0:11:26.29,0:11:29.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama bukan bertarung, aku terima.
Dialogue: 0,0:11:29.08,0:11:31.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepalaku mulai pusing.
Dialogue: 0,0:11:35.62,0:11:37.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panas.
Dialogue: 0,0:11:38.29,0:11:41.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rambutmu lebih cocok begitu.
Dialogue: 0,0:11:42.45,0:11:43.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan?
Dialogue: 0,0:11:43.95,0:11:48.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini tipe gadis cantik\Nyang tidak menonjolkan pesonanya.
Dialogue: 0,0:11:49.30,0:11:52.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kutarik lagi ucapanku,\Nkamu sama sekali tidak imut.
Dialogue: 0,0:11:52.85,0:11:54.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu bilang?
Dialogue: 0,0:12:07.46,0:12:10.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya, aku malah bolos sekolah.
Dialogue: 0,0:12:10.62,0:12:13.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin bicara panjang lebar\Ndengan Ryusei.
Dialogue: 0,0:12:13.71,0:12:17.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyelonong ke rumahnya memang solusi terbaik!
Dialogue: 0,0:12:17.47,0:12:21.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pahlawan ini, kalau soal inisiatif,\Ndia sudah Kelas S.
Dialogue: 0,0:12:21.43,0:12:24.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sudah beli tart\Nyang lagi tren di Shirahime.
Dialogue: 0,0:12:24.35,0:12:26.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa si Adik bakal senang?
Dialogue: 0,0:12:30.88,0:12:32.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan di jalan!
Dialogue: 0,0:12:41.07,0:12:42.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ryusei, rumahmu!
Dialogue: 0,0:12:43.03,0:12:44.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meteor.
Dialogue: 0,0:12:44.00,0:12:45.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?\NKamu terluka?
Dialogue: 0,0:12:45.47,0:12:47.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baik-baik saja, tapi adikku...
Dialogue: 0,0:12:47.84,0:12:49.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Adikmu?
Dialogue: 0,0:12:52.58,0:12:54.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamarku!
Dialogue: 0,0:12:54.88,0:12:57.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, semua kenanganku!
Dialogue: 0,0:13:00.13,0:13:02.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan cemas!\NTenangkan dirimu.
Dialogue: 0,0:13:02.59,0:13:05.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat paham tangisan air mata ini...
Dialogue: 0,0:13:06.02,0:13:08.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Air mata petualang yang gagal\Nmenaklukkan dungeon!
Dialogue: 0,0:13:08.90,0:13:12.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Air mata pak kades saat desanya\Ndibakar para iblis!
Dialogue: 0,0:13:12.32,0:13:16.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Air mata yang tak sempat\Ndiselamatkan sang Pahlawan!
Dialogue: 0,0:13:19.66,0:13:22.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana perasaanmu sekarang?\NSudah bisa tenang?
Dialogue: 0,0:13:22.87,0:13:27.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tinggal sendiri di sini,\Njadi anggap ini rumahmu sendiri.
Dialogue: 0,0:13:27.02,0:13:28.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:13:28.10,0:13:31.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, abangku bagaimana?
Dialogue: 0,0:13:31.33,0:13:35.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ryusei harus lapor pemeriksaan,\Ndia bilang akan pulang telat.
Dialogue: 0,0:13:35.79,0:13:37.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:13:37.55,0:13:42.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi aku panik dan bingung harus bagaimana.
Dialogue: 0,0:13:42.76,0:13:45.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu wajar karena situasinya begitu.
Dialogue: 0,0:13:45.28,0:13:49.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar, ya.\NAkan kubuatkan minuman hangat.
Dialogue: 0,0:13:49.95,0:13:53.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.\NSampai disiapkan air hangat dan baju ganti.
Dialogue: 0,0:13:53.73,0:13:55.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saling bantu di saat sulit itu wajar.
Dialogue: 0,0:13:55.77,0:13:58.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, matcha latte hangat untukmu.
Dialogue: 0,0:13:59.40,0:14:03.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pe-Penampilanmu terlalu seksi!
Dialogue: 0,0:14:03.18,0:14:04.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Apa?
Dialogue: 0,0:14:04.87,0:14:06.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana ada cewek SMA di rumah
Dialogue: 0,0:14:06.78,0:14:07.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}penampilannya begini!
Dialogue: 0,0:14:07.83,0:14:09.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada, di sini!
Dialogue: 0,0:14:09.06,0:14:10.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah bangga!
Dialogue: 0,0:14:10.45,0:14:12.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dada demplon perusak fokus para pria!
Dialogue: 0,0:14:12.92,0:14:14.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rambut pink yang lembut
Dialogue: 0,0:14:14.74,0:14:15.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan bibir yang menggoda!
Dialogue: 0,0:14:15.88,0:14:17.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bokong kencang yang terlalu mencolok!!
Dialogue: 0,0:14:17.95,0:14:18.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu...
Dialogue: 0,0:14:18.55,0:14:19.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan!
Dialogue: 0,0:14:19.73,0:14:22.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dipuji terus, aku akan salah tingkah!
Dialogue: 0,0:14:25.47,0:14:27.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, ya.
Dialogue: 0,0:14:27.14,0:14:28.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imut.
Dialogue: 0,0:14:29.06,0:14:30.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau, makan ini juga.
Dialogue: 0,0:14:30.96,0:14:34.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, ini kue yang lagi tren itu!\NSenangnya!
Dialogue: 0,0:14:34.56,0:14:36.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:14:37.31,0:14:39.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa pakai kepala naga?
Dialogue: 0,0:14:39.02,0:14:41.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku malu dan tak berani\Nmenunjukkan mukaku.
Dialogue: 0,0:14:41.47,0:14:43.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepalanya ditutup\Ntapi dadanya kelihatan jelas!
Dialogue: 0,0:14:43.71,0:14:45.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia naga betina yang berbahaya!
Dialogue: 0,0:14:47.01,0:14:49.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, Hanaori-san.
Dialogue: 0,0:14:49.22,0:14:51.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggil kakak juga boleh!
Dialogue: 0,0:14:51.64,0:14:53.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu orangnya ribet, ya.
Dialogue: 0,0:14:53.50,0:14:56.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, aku ingin bilang\Nterima kasih dari dulu.
Dialogue: 0,0:14:56.18,0:14:56.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:14:57.78,0:15:02.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak lama setelah abangku jadi guru,\Ndia tiba-tiba mengurung diri.
Dialogue: 0,0:15:02.43,0:15:08.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beberapa hari setelahnya, sikapnya aneh\Nseperti tak ada masalah di sekolah.
Dialogue: 0,0:15:08.54,0:15:12.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu fenomena ingatan kehidupan masa lalu\Nyang tiba-tiba bangkit dalam semalam.
Dialogue: 0,0:15:12.53,0:15:14.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mengalami hal yang sama.
Dialogue: 0,0:15:14.64,0:15:17.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya, situasi di rumah kami\Nsaat itu sedang tegang.
Dialogue: 0,0:15:18.40,0:15:21.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu, kamu datang.
Dialogue: 0,0:15:21.23,0:15:23.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, saat itu, ya.
Dialogue: 0,0:15:23.49,0:15:26.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu abangku langsung bangkit.
Dialogue: 0,0:15:26.82,0:15:30.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembali mengajar dan belakangan ini\Ndia terlihat menikmatinya.
Dialogue: 0,0:15:31.94,0:15:33.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini semua berkatmu.
Dialogue: 0,0:15:33.87,0:15:37.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kamu salah paham!\NItu pasti cuma kebetulan!
Dialogue: 0,0:15:37.33,0:15:39.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau berbuat mesum sama cewek secantik ini,
Dialogue: 0,0:15:39.44,0:15:41.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}cowok mana pun pasti semangat lagi.
Dialogue: 0,0:15:41.17,0:15:42.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu!
Dialogue: 0,0:15:42.56,0:15:45.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tidak melakukan hal mesum apa pun!
Dialogue: 0,0:15:45.47,0:15:48.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang itu salah paham!
Dialogue: 0,0:15:48.46,0:15:51.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah pencet bel dari tadi,\Njadi aku langsung masuk, ya.
Dialogue: 0,0:15:52.22,0:15:54.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, selamat datang kembali...
Dialogue: 0,0:15:54.82,0:15:57.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa jelaskan ini situasi aneh apa?
Dialogue: 0,0:15:58.91,0:16:00.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa penyebab kebakarannya?
Dialogue: 0,0:16:00.61,0:16:02.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih belum diketahui.
Dialogue: 0,0:16:02.29,0:16:06.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi belakangan, ada orang mencurigakan\Nmondar-mandir di sekitar rumah.
Dialogue: 0,0:16:06.65,0:16:10.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan,\Nkeluargamu diincar seseorang?
Dialogue: 0,0:16:10.87,0:16:12.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinan itu cukup besar.
Dialogue: 0,0:16:12.99,0:16:14.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa rencanamu?
Dialogue: 0,0:16:14.26,0:16:16.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin sementara menginap di hotel murah.
Dialogue: 0,0:16:16.90,0:16:18.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau menyuruhnya pulang kampung.
Dialogue: 0,0:16:18.33,0:16:23.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada musuh baru, kamu tak akan\Nbisa fokus menjaga adikmu.
Dialogue: 0,0:16:23.74,0:16:27.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, ada kemungkinan\Nmusuh sengaja memecah belah kita.
Dialogue: 0,0:16:29.86,0:16:34.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, solusi terakhirnya\Nharus pakai cara itu...
Dialogue: 0,0:16:34.26,0:16:36.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm? Apa?
Dialogue: 0,0:16:38.77,0:16:40.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Solusinya tinggal bareng di rumahku!
Dialogue: 0,0:16:40.88,0:16:41.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi!
Dialogue: 0,0:16:41.98,0:16:44.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langsung tinggal seatap\Nbakal bikin salah paham.
Dialogue: 0,0:16:44.32,0:16:45.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah...
Dialogue: 0,0:16:48.53,0:16:49.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak peduli!
Dialogue: 0,0:16:49.49,0:16:50.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah kamu yang ribet!
Dialogue: 0,0:16:50.86,0:16:53.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keseharian tinggal bersama\Nyang mendebarkan dimulai.
Dialogue: 0,0:16:57.70,0:16:59.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya makan!
Dialogue: 0,0:16:59.92,0:17:02.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya seatap dengan muridmu sendiri, ya!
Dialogue: 0,0:17:03.90,0:17:04.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya...
Dialogue: 0,0:17:04.88,0:17:06.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat makan!
Dialogue: 0,0:17:09.47,0:17:11.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, ini enak!
Dialogue: 0,0:17:11.18,0:17:12.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cocok jadi istri idaman!
Dialogue: 0,0:17:12.64,0:17:15.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kamu jago masak, ya, Meteor-san.
Dialogue: 0,0:17:15.64,0:17:18.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena kamu ikut bantu, Moe-chan.
Dialogue: 0,0:17:18.13,0:17:19.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, tidak begitu...
Dialogue: 0,0:17:19.34,0:17:23.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai dibuatkan makan.\NMaaf sudah banyak merepotkan, ya.
Dialogue: 0,0:17:24.21,0:17:26.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saling bantu di saat sulit itu wajar.
Dialogue: 0,0:17:27.04,0:17:28.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiknya.
Dialogue: 0,0:17:28.50,0:17:31.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini yang disebut Kewajiban Bangsawan.
Dialogue: 0,0:17:31.15,0:17:33.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kehidupanmu sebelumnya itu bangsawan?
Dialogue: 0,0:17:33.15,0:17:34.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asalku cuma rakyat jelata.
Dialogue: 0,0:17:35.58,0:17:37.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nasi campur ini enak, ya!
Dialogue: 0,0:17:37.74,0:17:38.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:17:38.58,0:17:40.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahu apa bumbu rahasianya?
Dialogue: 0,0:17:40.77,0:17:41.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm? Apa?
Dialogue: 0,0:17:41.92,0:17:43.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kutangnya Meteor.
Dialogue: 0,0:17:43.96,0:17:45.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uhuk!
Dialogue: 0,0:17:45.42,0:17:46.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ini!
Dialogue: 0,0:17:46.26,0:17:49.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ukuran alami seperti itu langka, lo.
Dialogue: 0,0:17:49.57,0:17:52.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Momen makan seperti ini langka,\Njadi harus nikmati, ya.
Dialogue: 0,0:17:52.50,0:17:53.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ini sedang bahas apa?
Dialogue: 0,0:17:53.89,0:17:56.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meteor, nasihati dia juga!
Dialogue: 0,0:17:57.39,0:17:59.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meteor, jangan dianggap serius!
Dialogue: 0,0:18:00.27,0:18:03.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abang juga, malah tidak sopan padanya.
Dialogue: 0,0:18:03.04,0:18:04.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu harusnya ngaca.
Dialogue: 0,0:18:04.77,0:18:07.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya, waspada dengan\Ninsiden mesum hoki, ya!
Dialogue: 0,0:18:07.52,0:18:09.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa jadi ke situ?
Dialogue: 0,0:18:09.19,0:18:11.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mesum hoki itu apa?
Dialogue: 0,0:18:11.78,0:18:14.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, di situlah letak bencananya!
Dialogue: 0,0:18:14.94,0:18:20.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanita ini, selain pahlawan, dia juga latihan\Nbela diri sampai menjadi manusia senjata.
Dialogue: 0,0:18:21.39,0:18:24.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teriak "Dasar mesum!"\Nsambil meremukkan rahang
Dialogue: 0,0:18:24.69,0:18:28.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan berpotensi memicu\Ngegar otak fatal seketika si penyihir.
Dialogue: 0,0:18:28.96,0:18:32.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini... gim maut model baru sungguhan.
Dialogue: 0,0:18:35.76,0:18:38.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, bisa ceritakan\Nawal kalian berdua bertemu?
Dialogue: 0,0:18:38.60,0:18:39.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:18:39.81,0:18:44.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik sebelum atau sesudah mengurung diri,\Nabangku tak ada tanda dekat dengan cewek.
Dialogue: 0,0:18:44.02,0:18:45.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:18:45.52,0:18:51.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami kenal... lewat gim daring\Npedang dan sihir...
Dialogue: 0,0:18:51.23,0:18:54.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius? Abang dapat cewek\Nsecantik ini dari gim daring?
Dialogue: 0,0:18:54.62,0:18:57.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kaya, demplon,\Ndan jadi obat ampuh depresi!
Dialogue: 0,0:18:57.42,0:18:59.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah seperti lakon cewek SSR\Ndi gim gacha!
Dialogue: 0,0:18:59.95,0:19:02.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi literasinya soal internet jongkok.
Dialogue: 0,0:19:02.34,0:19:03.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu.
Dialogue: 0,0:19:04.37,0:19:06.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Air mandinya sudah siap!
Dialogue: 0,0:19:06.02,0:19:07.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:19:08.40,0:19:11.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mandi di rumah orang lain\Nmemang bikin canggung.
Dialogue: 0,0:19:15.22,0:19:16.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Moe?
Dialogue: 0,0:19:16.18,0:19:19.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali! Jatah adegan spesial\Nkali ini aku yang ambil!
Dialogue: 0,0:19:19.89,0:19:21.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ini bicara apa?
Dialogue: 0,0:19:21.66,0:19:24.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus melindungi badan demplonnya\NMeteor-san dari matamu.
Dialogue: 0,0:19:24.56,0:19:26.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ini maunya apa?
Dialogue: 0,0:19:31.14,0:19:33.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah bisa hubungi orang tuamu?
Dialogue: 0,0:19:33.25,0:19:34.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sudah.
Dialogue: 0,0:19:34.99,0:19:38.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka masih liburan panjang di luar pulau\Ndan menyerahkannya padaku.
Dialogue: 0,0:19:38.08,0:19:41.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, kamu masih\Nmerasa canggung di sini.
Dialogue: 0,0:19:41.24,0:19:43.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu belum mau tidur?
Dialogue: 0,0:19:43.39,0:19:45.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum ngantuk.
Dialogue: 0,0:19:48.17,0:19:52.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, ceritakan kehidupanmu sebagai petualang\Nsebelum menjadi Raja Iblis.
Dialogue: 0,0:19:52.63,0:19:56.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kehidupanku sebagai petualang, ya.\NCeritanya bikin ngantuk.
Dialogue: 0,0:19:56.75,0:19:59.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asyik, justru itu bagus!
Dialogue: 0,0:19:59.34,0:20:01.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, Merah Tua, kamu dipecat!
Dialogue: 0,0:20:01.95,0:20:04.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya kamu beban!
Dialogue: 0,0:20:04.80,0:20:07.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena warna manaku merah tua\Nyang tidak populer,
Dialogue: 0,0:20:07.38,0:20:09.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sering ditendang dari tim.
Dialogue: 0,0:20:09.57,0:20:14.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlalu klise, jadi diskriminasi\Nwarna sihir separah itu?
Dialogue: 0,0:20:14.94,0:20:16.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah.
Dialogue: 0,0:20:16.11,0:20:21.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakat terlihat jelas, mengasah spesialisasi\Nsudah jadi aturan umum penyihir.
Dialogue: 0,0:20:21.89,0:20:23.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu ada alat sihir populer
Dialogue: 0,0:20:23.78,0:20:25.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang disebut DPS Checker.
Dialogue: 0,0:20:25.31,0:20:27.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}DPS Checker?
Dialogue: 0,0:20:27.29,0:20:32.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Era saat para penyihir spesialis api\Ndan daya serang tinggi diistimewakan.
Dialogue: 0,0:20:33.55,0:20:36.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saking parahnya prasangka orang-orang,\Naku sampai krisis identitas.
Dialogue: 0,0:20:36.99,0:20:40.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sempat nganggur lama sampai\Nakhirnya jadi porter.
Dialogue: 0,0:20:40.26,0:20:44.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi porter? Nostalgia!\NDulu sempat tren, ya!
Dialogue: 0,0:20:44.22,0:20:47.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selalu dijadikan umpan\Natau ditinggal mati sendirian...
Dialogue: 0,0:20:47.65,0:20:48.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu?
Dialogue: 0,0:20:49.41,0:20:52.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill analisis mulai tren\Ndan akhirnya hidupku membaik.
Dialogue: 0,0:20:52.46,0:20:53.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:20:53.32,0:20:57.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah petualang itu\Nharusnya tidak diatur oleh tren?
Dialogue: 0,0:20:59.02,0:21:00.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ryusei...
Dialogue: 0,0:21:00.24,0:21:02.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah kehangatan manusia.
Dialogue: 0,0:21:02.54,0:21:06.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan perlakukanku seperti\Nmonster tragis yang patut dikasihani.
Dialogue: 0,0:21:07.70,0:21:09.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau di eramu, apa yang tren waktu itu?
Dialogue: 0,0:21:09.70,0:21:11.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau di eraku...
Dialogue: 0,0:21:11.67,0:21:13.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin tren om-om.
Dialogue: 0,0:21:13.63,0:21:15.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tren om-om?
Dialogue: 0,0:21:15.59,0:21:18.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, kenapa tadi pakai alasan\Nkita kenal lewat gim daring?
Dialogue: 0,0:21:18.69,0:21:24.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar saat dia dengar soal sihir, pahlawan,\Natau dunia lain, kesannya itu dari gim.
Dialogue: 0,0:21:24.00,0:21:25.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma untuk jaga-jaga.
Dialogue: 0,0:21:25.10,0:21:26.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pintar juga, ya.
Dialogue: 0,0:21:26.43,0:21:27.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu...
Dialogue: 0,0:21:30.75,0:21:33.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaya... dan tampan.
Dialogue: 0,0:21:33.66,0:21:35.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oi!
Dialogue: 0,0:21:35.84,0:21:39.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana rasanya jadi Raja Iblis\Nyang dinafkahi sang Pahlawan?
Dialogue: 0,0:21:44.96,0:21:46.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf!
Dialogue: 0,0:21:51.66,0:21:53.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini tidak ada yang lihat...
Dialogue: 0,0:21:53.77,0:21:55.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiap kali begini, selalu ada yang ganggu.
Dialogue: 0,0:21:55.96,0:21:57.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kamu tetap harus dihukum.
Dialogue: 0,0:21:57.97,0:21:58.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:22:02.46,0:22:05.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mesum hoki selamanya abadi!
