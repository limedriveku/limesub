Dialogue: 0,0:00:12.32,0:00:14.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sensei, kena!
Dialogue: 0,0:00:14.23,0:00:15.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Takanashi-kun?
Dialogue: 0,0:00:16.32,0:00:18.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Narukami-sensei.
Dialogue: 0,0:00:18.95,0:00:20.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kubantu!
Dialogue: 0,0:00:20.54,0:00:23.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sensei akhirnya merasakan musim semi.
Dialogue: 0,0:01:55.00,0:01:57.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takanashi Ayame, kelas 2-3.
Dialogue: 0,0:01:58.80,0:02:01.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Murid yang ceria dan populer di kelas.
Dialogue: 0,0:02:02.35,0:02:04.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lucu.
Dialogue: 0,0:02:04.08,0:02:06.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belakangan ini mereka makin dekat, ya?
Dialogue: 0,0:02:06.31,0:02:07.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang naksir, ya?
Dialogue: 0,0:02:07.89,0:02:09.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, itu fase naksir?
Dialogue: 0,0:02:09.91,0:02:13.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru pria di sekolah perempuan kan sedikit.
Dialogue: 0,0:02:13.85,0:02:16.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal seperti ini kadang terjadi.
Dialogue: 0,0:02:16.04,0:02:19.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bicara begitu\Ndari sudut pandang yang mana?
Dialogue: 0,0:02:19.20,0:02:22.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sensei, sepulang sekolah\Ntolong bantu aku belajar!
Dialogue: 0,0:02:22.66,0:02:26.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, kamu sebenarnya\Ntak perlu ikut kelas tambahan, kan?
Dialogue: 0,0:02:29.99,0:02:33.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia... malah senang digoda!
Dialogue: 0,0:02:33.13,0:02:35.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tatapannya seram banget!
Dialogue: 0,0:02:38.48,0:02:41.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pacaran sembunyi-sembunyi! Cinta segitiga!
Dialogue: 0,0:02:41.64,0:02:43.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seram!
Dialogue: 0,0:02:45.07,0:02:46.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi penasaran...
Dialogue: 0,0:02:47.11,0:02:50.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia imut, pendiam...
Dialogue: 0,0:02:50.31,0:02:54.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesannya seperti gadis manis\Ndan disukai semua orang...
Dialogue: 0,0:02:54.70,0:02:57.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tipe dia gadis yang seperti itu?
Dialogue: 0,0:02:57.95,0:03:01.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dulu dia kelihatan suka murung, kan?
Dialogue: 0,0:03:01.29,0:03:04.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, serius?\NKamu tahu banyak hal, ya.
Dialogue: 0,0:03:04.35,0:03:07.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya dulu ada yang siswi\Nyang satu ekskul di kelas 3.
Dialogue: 0,0:03:07.12,0:03:08.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sering ke sana.
Dialogue: 0,0:03:08.75,0:03:11.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa dibilang dia agak menyendiri di kelas...
Dialogue: 0,0:03:11.49,0:03:13.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesannya susah berbaur dengan yang lain.
Dialogue: 0,0:03:14.28,0:03:17.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi entah sejak kapan dia tiba-tiba\Njadi yang paling populer di kelas.
Dialogue: 0,0:03:17.89,0:03:20.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sikapnya juga berubah.\NAneh, ya?
Dialogue: 0,0:03:20.72,0:03:23.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal seperti itu\Nsering terjadi pada gadis, kan?
Dialogue: 0,0:03:23.56,0:03:25.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang seakan itu hal wajar.
Dialogue: 0,0:03:26.40,0:03:27.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sensei!
Dialogue: 0,0:03:28.40,0:03:31.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang ingin kubahas denganmu sebentar!
Dialogue: 0,0:03:32.92,0:03:34.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Oi!
Dialogue: 0,0:03:34.05,0:03:36.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hal yang penting!
Dialogue: 0,0:03:36.12,0:03:37.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikut aku!
Dialogue: 0,0:03:37.16,0:03:39.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Tu-Tunggu!
Dialogue: 0,0:03:40.28,0:03:41.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang berubah lagi selain itu?
Dialogue: 0,0:03:41.91,0:03:45.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang istimewa,\Nperubahan yang lainnya biasa saja.
Dialogue: 0,0:03:46.65,0:03:49.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah jadi aneh karena tak ada yang aneh, ya?
Dialogue: 0,0:03:49.15,0:03:52.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesannya malah seperti kena sihir.
Dialogue: 0,0:03:53.71,0:03:56.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mata Sensei indah sekali, ya.
Dialogue: 0,0:03:56.92,0:03:58.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, kamu terlalu dekat!
Dialogue: 0,0:03:59.31,0:04:03.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sensei, bagaimana perasaanmu padaku?
Dialogue: 0,0:04:03.73,0:04:06.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, Takanashi-kun, kamu mau apa?
Dialogue: 0,0:04:06.63,0:04:08.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat mataku.
Dialogue: 0,0:04:10.92,0:04:13.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, ucapkan dengan jelas.
Dialogue: 0,0:04:17.37,0:04:19.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kuperingatkan.
Dialogue: 0,0:04:19.89,0:04:22.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal kemunculan monster misterius.
Dialogue: 0,0:04:22.97,0:04:24.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berdasarkan penyelidikan kami,
Dialogue: 0,0:04:24.59,0:04:27.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada dalang yang sedang membuka pintu\Nmenuju dunia lain.
Dialogue: 0,0:04:27.83,0:04:30.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang sedang kami cari...
Dialogue: 0,0:04:30.79,0:04:32.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sang Pahlawan yang Kembali.
Dialogue: 0,0:04:32.39,0:04:33.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Returner.
Dialogue: 0,0:04:34.50,0:04:36.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Returner?
Dialogue: 0,0:04:36.53,0:04:41.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konon, orang yang dipanggil ke dunia lain akan\Ndapat kekuatan hebat dan jadi pahlawan.
Dialogue: 0,0:04:41.45,0:04:42.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan hebat?
Dialogue: 0,0:04:42.99,0:04:45.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa dibilang, dia dapat cheat.
Dialogue: 0,0:04:45.47,0:04:51.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Returner, orang yang kembali ke dunia ini\Ndengan kekuatan dari dunia lain.
Dialogue: 0,0:04:51.31,0:04:53.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu aku harus percaya dongeng seperti itu?
Dialogue: 0,0:04:53.89,0:04:58.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pernah ada insiden gadis penyihir jahat\Nyang menyerang dari dimensi lain.
Dialogue: 0,0:04:58.47,0:05:01.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi aku percaya ada dunia lain\Nyang penuh pedang dan sihir.
Dialogue: 0,0:05:01.57,0:05:03.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:05:03.55,0:05:09.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kejadian itu ada, mungkin seseorang\Nakan terlihat karakternya tiba-tiba berubah.
Dialogue: 0,0:05:12.07,0:05:13.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sikapnya juga berubah.
Dialogue: 0,0:05:13.88,0:05:15.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aneh, ya?
Dialogue: 0,0:05:16.36,0:05:19.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia itu Returner...
Dialogue: 0,0:05:20.83,0:05:22.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ryusei dalam bahaya!
Dialogue: 0,0:05:34.40,0:05:37.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.\NKekuatan cheat pesona, ya?
Dialogue: 0,0:05:38.61,0:05:41.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya, sihir pesona tak mempan padaku.
Dialogue: 0,0:05:41.99,0:05:42.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:05:43.23,0:05:46.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sensei, kamu bicara apa?
Dialogue: 0,0:05:47.32,0:05:50.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mendekatiku dengan skill pemindai\Nkarena aku tidak berbahaya, ya?
Dialogue: 0,0:05:51.15,0:05:55.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kamu sedikit lengah,\NTakanashi Ayame.
Dialogue: 0,0:05:55.44,0:05:56.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kamulah Returner?
Dialogue: 0,0:05:59.88,0:06:03.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya ini?\NApa pun hasil nilainya, dia orang biasa.
Dialogue: 0,0:06:04.14,0:06:07.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, suruhan para penyihir itu, ya?
Dialogue: 0,0:06:08.55,0:06:11.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku beruntung sudah menyiapkan cara\Nuntuk menangkal skill penilaian.
Dialogue: 0,0:06:15.89,0:06:21.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi mereka menggunakan orang biasa\Nsebagai pion untuk mengelabui skill penilaian?
Dialogue: 0,0:06:22.01,0:06:25.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang dan cerdas...\NDia lawan yang merepotkan.
Dialogue: 0,0:06:27.17,0:06:29.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tujuanmu?
Dialogue: 0,0:06:29.43,0:06:33.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya ingin kembali ke dunia itu.
Dialogue: 0,0:06:33.89,0:06:36.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pahlawan yang dipilih oleh dunia.
Dialogue: 0,0:06:36.81,0:06:40.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai pahlawan,\Nmisiku adalah membunuh Raja Iblis!
Dialogue: 0,0:06:40.59,0:06:43.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Raja Iblis-nya sedang ada di sini!
Dialogue: 0,0:06:43.92,0:06:46.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, kalian semua harus mati.
Dialogue: 0,0:06:46.33,0:06:48.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para penyihir itu juga.
Dialogue: 0,0:06:48.28,0:06:51.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si pahlawan palsu bernama Hanaori juga.
Dialogue: 0,0:06:51.56,0:06:53.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi target dia Meteor!
Dialogue: 0,0:06:55.04,0:06:56.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa dia?
Dialogue: 0,0:06:56.60,0:06:58.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak tahu?
Dialogue: 0,0:06:58.19,0:07:02.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau membunuh manusia yang lebih kuat,\Npengalaman kita akan bertambah banyak!
Dialogue: 0,0:07:04.21,0:07:09.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar bisa kembali ke dunia itu,\Naku perlu sihir yang lebih kuat.
Dialogue: 0,0:07:09.45,0:07:11.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya aku perlu naik level.
Dialogue: 0,0:07:11.79,0:07:15.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, tapi orang-orang yang dulu merundungku
Dialogue: 0,0:07:15.52,0:07:18.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan juga teman sekelas\Nyang pura-pura tidak lihat,
Dialogue: 0,0:07:18.43,0:07:20.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti nanti akan kubunuh.
Dialogue: 0,0:07:21.17,0:07:24.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan untuk membuat dunia\Nberjalan sesuai keinginanmu.
Dialogue: 0,0:07:24.29,0:07:25.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu seru?
Dialogue: 0,0:07:25.47,0:07:28.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seru!\NRasanya luar biasa!
Dialogue: 0,0:07:28.43,0:07:32.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah diriku yang sebenarnya!\NInilah sang pahlawan!
Dialogue: 0,0:07:33.48,0:07:36.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, Sensei...\NSampai jumpa...
Dialogue: 0,0:07:37.64,0:07:40.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai tanda perpisahan,\Nakan kutunjukkan
Dialogue: 0,0:07:40.73,0:07:42.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kekuatan sang pahlawan!
Dialogue: 0,0:07:43.03,0:07:45.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial! Ada reaksi sihir!
Dialogue: 0,0:07:45.28,0:07:48.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, dia mau ke mana?
Dialogue: 0,0:07:50.39,0:07:51.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sana!
Dialogue: 0,0:07:51.20,0:07:52.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?
Dialogue: 0,0:08:00.00,0:08:02.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa malah jadi begini?
Dialogue: 0,0:08:02.21,0:08:04.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Jangan-jangan kamu membunuhnya?
Dialogue: 0,0:08:04.15,0:08:05.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:08:05.63,0:08:08.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis Bokong Persik ketakutan\Nsambil memegang pisau.
Dialogue: 0,0:08:08.34,0:08:11.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sensei wajahnya seperti nyaris dibunuh.
Dialogue: 0,0:08:11.30,0:08:14.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu Mana seperti syok\Nkarena melakukan kesalahan fatal!
Dialogue: 0,0:08:17.14,0:08:18.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggap saja semuanya pelakunya.
Dialogue: 0,0:08:18.69,0:08:19.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi!
Dialogue: 0,0:08:19.52,0:08:21.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekspresi kalian semua seperti pembunuh.
Dialogue: 0,0:08:21.89,0:08:22.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan konyol!
Dialogue: 0,0:08:22.47,0:08:24.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tak melakukan apa pun!
Dialogue: 0,0:08:27.07,0:08:30.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, kalau tidak salah...
Dialogue: 0,0:08:30.45,0:08:32.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat Takanashi-kun mau membunuhku,
Dialogue: 0,0:08:34.45,0:08:36.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka berdua datang menolong.
Dialogue: 0,0:08:37.12,0:08:39.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takanashi sudah melakukan serangan, tapi...
Dialogue: 0,0:08:39.37,0:08:42.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tersandung di kakiku\Ndan keseimbangannya goyah...
Dialogue: 0,0:08:43.47,0:08:47.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanaori-kun mengayunkan pisau tapi meleset,\Nlalu lututnya menghantam muka Takanashi.
Dialogue: 0,0:08:48.22,0:08:52.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pisaunya nyaris membunuhku,\Nsampai jantungku berdebar kencang.
Dialogue: 0,0:08:54.32,0:08:57.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu sihir Kuraishi-kun menyerang\NTakanashi berkali-kali!
Dialogue: 0,0:08:58.89,0:09:01.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kejadian yang sebenarnya.
Dialogue: 0,0:09:01.16,0:09:02.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kejam.
Dialogue: 0,0:09:04.09,0:09:06.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini jadi heboh.\NApa kita akan baik-baik saja?
Dialogue: 0,0:09:06.64,0:09:08.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan ini pada Oz.
Dialogue: 0,0:09:08.38,0:09:09.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oz penyelamat, ya.
Dialogue: 0,0:09:09.59,0:09:11.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dilempar semua ke mereka?
Dialogue: 0,0:09:21.03,0:09:24.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama kali melawan manusia, ya?\NDia anak baik.
Dialogue: 0,0:09:25.11,0:09:26.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak cocok bertarung.
Dialogue: 0,0:09:29.15,0:09:31.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, aku tertolong.
Dialogue: 0,0:09:32.13,0:09:34.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu hal yang tak mudah dilakukan\Ntanpa keberanian.
Dialogue: 0,0:09:34.51,0:09:37.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, ini sudah tugasku.
Dialogue: 0,0:09:40.35,0:09:41.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:09:41.19,0:09:43.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tatapannya seram banget!
Dialogue: 0,0:09:45.11,0:09:47.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dipanggil ke dunia lain, ya?
Dialogue: 0,0:09:47.61,0:09:51.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dunia itu sangat menarik baginya?
Dialogue: 0,0:09:52.48,0:09:55.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena tiba-tiba dapat kekuatan\Ndi luar batas manusia,
Dialogue: 0,0:09:55.57,0:09:58.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin dia meluapkan semua hal\Nyang dia pendam.
Dialogue: 0,0:09:59.55,0:10:02.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, apa itu keputusan yang tepat?
Dialogue: 0,0:10:02.89,0:10:06.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kita juga\Nbisa mengirimnya ke dunia lain?
Dialogue: 0,0:10:06.16,0:10:07.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu mustahil.
Dialogue: 0,0:10:08.59,0:10:13.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena dia sudah tahu rasa darah.
Dialogue: 0,0:10:14.88,0:10:16.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini cerita horor?
Dialogue: 0,0:10:32.92,0:10:37.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemarin, aku tak sengaja\Nmemotong dasi Ryusei.
Dialogue: 0,0:10:38.43,0:10:40.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah beli penggantinya.
Dialogue: 0,0:10:41.17,0:10:42.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kapan harus kuberikan?
Dialogue: 0,0:10:43.95,0:10:47.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini... kesannya seperti memberi hadiah?
Dialogue: 0,0:10:47.96,0:10:52.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, bagaimana kalau berujung salah paham?
Dialogue: 0,0:10:52.17,0:10:54.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sang pahlawan ternyata orang\Nyang bertanggung jawab.
Dialogue: 0,0:10:56.75,0:11:00.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurang lebih begitu.\NBagaimana cara memberikan ini padanya?
Dialogue: 0,0:11:00.24,0:11:01.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sedang kasmaran, ya?
Dialogue: 0,0:11:01.73,0:11:02.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:11:02.64,0:11:04.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikan seperti biasa saja.
Dialogue: 0,0:11:04.87,0:11:07.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makin aneh caramu,\Nmakin jelas salah pahamnya.
Dialogue: 0,0:11:07.96,0:11:10.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dia ingin itu jadi salah paham, kan?
Dialogue: 0,0:11:10.03,0:11:12.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak! Aku tidak ada niat begitu!
Dialogue: 0,0:11:13.44,0:11:16.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan hadiah, hanya ganti rugi.
Dialogue: 0,0:11:16.25,0:11:17.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah jadi canggung, ya.
Dialogue: 0,0:11:17.67,0:11:20.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Ntinggal minta maaf dengan jujur.
Dialogue: 0,0:11:20.20,0:11:24.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kalian diberi hadiah, inginnya dapat apa?
Dialogue: 0,0:11:24.41,0:11:25.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uang.
Dialogue: 0,0:11:25.71,0:11:26.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanah.
Dialogue: 0,0:11:26.75,0:11:28.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku ganti pertanyaannya.
Dialogue: 0,0:11:28.75,0:11:31.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau ganti rugi,\Nkalian mau aku rusakkan apa?
Dialogue: 0,0:11:31.39,0:11:32.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami cuma bercanda!
Dialogue: 0,0:11:33.55,0:11:37.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu dapat senyumanmu,\Njadi aku tak butuh apa pun!
Dialogue: 0,0:11:37.32,0:11:41.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu dapat kebaikanmu!
Dialogue: 0,0:11:43.55,0:11:46.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Narukami-sensei, tahu tidak?
Dialogue: 0,0:11:46.23,0:11:49.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya hadiah yang paling\Ndisukai siswi SMA itu
Dialogue: 0,0:11:49.75,0:11:52.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aksesori yang mahal.
Dialogue: 0,0:11:53.65,0:11:56.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ini informasi dari internet,\Ntidak harus percaya.
Dialogue: 0,0:11:57.21,0:11:59.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, sedang bahas apa?
Dialogue: 0,0:11:59.47,0:12:04.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, aku sedang bahas hadiah\Nyang membuat siswi SMA senang.
Dialogue: 0,0:12:04.62,0:12:08.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kosmetik bermerek\Nyang agak mahal juga pilihan bagus!
Dialogue: 0,0:12:09.67,0:12:11.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang bahas apa?
Dialogue: 0,0:12:12.83,0:12:16.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, dasi.\NKemarin aku merusaknya dengan pisau.
Dialogue: 0,0:12:16.61,0:12:17.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:12:18.09,0:12:19.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf malah merepotkan, ya.
Dialogue: 0,0:12:20.04,0:12:21.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat senang!
Dialogue: 0,0:12:21.26,0:12:24.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.\NJangan dipikirkan.
Dialogue: 0,0:12:24.03,0:12:26.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, ini dariku.
Dialogue: 0,0:12:28.20,0:12:29.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:12:37.78,0:12:39.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cincin?
Dialogue: 0,0:12:39.61,0:12:43.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?\NMe-Menikah?
Dialogue: 0,0:12:43.08,0:12:45.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang, itu senjata.
Dialogue: 0,0:12:45.47,0:12:47.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cincin yang menyimpan senjata.
Dialogue: 0,0:12:47.63,0:12:48.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:12:48.41,0:12:51.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sama seperti pedang suci\Nyang dulu kamu gunakan.
Dialogue: 0,0:12:51.72,0:12:53.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu sebut namanya,\Npedangnya akan muncul.
Dialogue: 0,0:12:54.63,0:12:57.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat melawan Eater di bawah tanah,\Nkamu cuma memukulnya.
Dialogue: 0,0:12:57.16,0:12:59.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu saat melawan pahlawan,\Nkamu cuma pakai pisau.
Dialogue: 0,0:13:00.11,0:13:02.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak bawa senjata pasti merepotkan, bukan?
Dialogue: 0,0:13:03.41,0:13:04.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih...
Dialogue: 0,0:13:04.68,0:13:06.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba dulu sekali.
Dialogue: 0,0:13:09.68,0:13:12.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Muncullah, Sachertorte!
Dialogue: 0,0:13:15.04,0:13:16.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya Rosenritter.
Dialogue: 0,0:13:23.79,0:13:25.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang suciku...
Dialogue: 0,0:13:34.67,0:13:37.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}200 ribu pasukan musnah semua?
Dialogue: 0,0:13:37.75,0:13:40.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil...
Dialogue: 0,0:13:41.31,0:13:43.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Raja Iblis.
Dialogue: 0,0:13:43.67,0:13:46.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu telah mengotori dunia ini!
Dialogue: 0,0:13:47.00,0:13:49.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tebus dosamu dengan kematian!
Dialogue: 0,0:13:50.47,0:13:52.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dulunya Raja Iblis.
Dialogue: 0,0:13:53.42,0:13:54.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sekarang...
Dialogue: 0,0:13:57.11,0:13:59.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, ini malah seperti...
Dialogue: 0,0:13:59.81,0:14:01.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:14:01.99,0:14:04.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini terapi kopel?
Dialogue: 0,0:14:04.69,0:14:05.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rokudo-sensei!
Dialogue: 0,0:14:05.78,0:14:06.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya ini?
Dialogue: 0,0:14:06.84,0:14:08.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami bukan kopel!
Dialogue: 0,0:14:08.41,0:14:10.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan kopel.
Dialogue: 0,0:14:10.25,0:14:11.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan dicatat!
Dialogue: 0,0:14:12.29,0:14:16.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah dengar banyak rumor tentang kalian.\NKatanya ada guru yang pacaran dengan murid.
Dialogue: 0,0:14:17.28,0:14:18.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:14:18.71,0:14:22.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sebenarnya ingin mendukung kalian,\Ntapi ini sekolah!
Dialogue: 0,0:14:22.16,0:14:23.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terang-terangan!
Dialogue: 0,0:14:23.57,0:14:24.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sensei salah paham!
Dialogue: 0,0:14:24.68,0:14:26.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini karena kamu selalu mendekatiku!
Dialogue: 0,0:14:26.55,0:14:28.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini salah kamu, kan?
Dialogue: 0,0:14:28.35,0:14:31.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku tidak melakukan apa pun!\N- Kita selalu terlibat masalah!
Dialogue: 0,0:14:31.41,0:14:34.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, harusnya bukan aku saja, kan?\NAku tidak ada kaitannya!
Dialogue: 0,0:14:34.41,0:14:36.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu benar!
Dialogue: 0,0:14:36.92,0:14:40.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, wah, jadi ini yang dirumorkan itu, ya!
Dialogue: 0,0:14:40.44,0:14:42.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan!
Dialogue: 0,0:14:43.11,0:14:45.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bacakan tanggapan yang mereka, ya.
Dialogue: 0,0:14:46.09,0:14:50.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saling panggil nama depan.\NSaling tatap dengan penuh perasaan.
Dialogue: 0,0:14:50.41,0:14:53.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ribut sepele seperti kopel\Nyang membuatku tak tahan melihatnya.
Dialogue: 0,0:14:54.71,0:14:57.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, wah, sepertinya ini\Ntak bisa terus dibiarkan, ya.
Dialogue: 0,0:14:57.84,0:14:59.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dengan polisi komedi romantis!
Dialogue: 0,0:14:59.47,0:15:01.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau di zaman lain, kalian bisa dihukum mati!
Dialogue: 0,0:15:10.11,0:15:11.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanaori-san, bagaimana perasaanmu padanya?
Dialogue: 0,0:15:12.33,0:15:13.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu...
Dialogue: 0,0:15:15.41,0:15:18.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ditanya perasaanku sekarang...
Dialogue: 0,0:15:19.25,0:15:21.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku harus mengalami hal seperti ini?
Dialogue: 0,0:15:23.32,0:15:24.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penasaran!
Dialogue: 0,0:15:25.61,0:15:27.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin seharusnya dia kubunuh saja.
Dialogue: 0,0:15:27.68,0:15:28.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanaori-san?
Dialogue: 0,0:15:28.99,0:15:32.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Narukami-sensei,\Nbagaimana perasaanmu pada Hanaori-san?
Dialogue: 0,0:15:32.74,0:15:34.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagiku dia wanita yang merepotkan.
Dialogue: 0,0:15:34.93,0:15:36.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Narukami-sensei!
Dialogue: 0,0:15:36.46,0:15:37.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu yang jadi masalah!
Dialogue: 0,0:15:37.92,0:15:39.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apanya?
Dialogue: 0,0:15:39.04,0:15:40.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu!
Dialogue: 0,0:15:40.09,0:15:41.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan dicatat!
Dialogue: 0,0:15:42.46,0:15:44.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian terlihat sangat akrab,
Dialogue: 0,0:15:44.61,0:15:46.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa dulu saling kenal?
Dialogue: 0,0:15:46.48,0:15:50.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami berasal dari daerah yang sama...
Dialogue: 0,0:15:50.01,0:15:52.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kalian teman masa kecil!
Dialogue: 0,0:15:52.53,0:15:53.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan!
Dialogue: 0,0:15:53.33,0:15:54.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggap saja begitu.
Dialogue: 0,0:15:55.27,0:15:58.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, kami tak sengaja bertemu lagi\Ndi sekolah ini.
Dialogue: 0,0:15:58.48,0:16:00.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini pertemuan kembali yang ditakdirkan, ya?
Dialogue: 0,0:16:00.59,0:16:01.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang!
Dialogue: 0,0:16:01.59,0:16:03.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggap saja begitu.
Dialogue: 0,0:16:03.57,0:16:06.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, kenapa malah jadi bahas\Ningin membunuhnya?
Dialogue: 0,0:16:10.76,0:16:12.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ceritanya agak panjang.
Dialogue: 0,0:16:12.80,0:16:13.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:16:14.47,0:16:17.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggap ceritanya mirip seperti aku membuat\Nsupermarket besar di kota yang sepi,
Dialogue: 0,0:16:17.88,0:16:21.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu memberi pukulan telak\Npada kawasan pertokoan.
Dialogue: 0,0:16:21.23,0:16:23.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pekerjaanmu sebelumnya, Narukami-sensei?
Dialogue: 0,0:16:24.20,0:16:26.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mau cerita apa?
Dialogue: 0,0:16:26.38,0:16:29.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu keluarga Hanaori-san tinggal di sana?
Dialogue: 0,0:16:29.32,0:16:30.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:16:30.22,0:16:33.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sebenarnya, itu dilakukan\Nuntuk menyelamatkan kota!
Dialogue: 0,0:16:33.09,0:16:34.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia ikut bantu!
Dialogue: 0,0:16:34.43,0:16:38.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wali kota berniat menjual kota kami\Ndemi memperkaya diri
Dialogue: 0,0:16:38.29,0:16:42.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mengubahnya jadi tempat pembuangan sampah\Ndengan kedok pusat pengolahan limbah.
Dialogue: 0,0:16:43.24,0:16:47.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru sadar belakangan bahwa rencana\Nmembangun supermarket besar
Dialogue: 0,0:16:47.93,0:16:49.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu demi menyelamatkan kota.
Dialogue: 0,0:16:50.37,0:16:53.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa tahu hal itu, kami malah mengusirnya...
Dialogue: 0,0:16:53.04,0:16:55.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengusir supermarketnya.
Dialogue: 0,0:16:56.28,0:17:01.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raja Iblis Bermata Merah yang memimpin pasukan\Nmayat hidup untuk menghancurkan kekaisaran.
Dialogue: 0,0:17:01.80,0:17:06.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata sosok aslinya\Nhanyalah seorang ahli sihir arwah.
Dialogue: 0,0:17:06.13,0:17:08.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia menganggap kekuatannya berbahaya,
Dialogue: 0,0:17:08.88,0:17:11.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan perang baru pun pecah.
Dialogue: 0,0:17:12.97,0:17:17.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang merenggut kawasan pertokoan\Nyang berharga bagiku dan keluargaku...
Dialogue: 0,0:17:17.44,0:17:20.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, orang yang menyelamatkan kota kami...
Dialogue: 0,0:17:21.31,0:17:23.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah Narukami-sensei!
Dialogue: 0,0:17:23.40,0:17:26.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ceritanya malah jauh lebih berat\Ndari yang kubayangkan...
Dialogue: 0,0:17:28.07,0:17:30.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah jadi seru, ya?
Dialogue: 0,0:17:30.40,0:17:32.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terlalu menjailinya.
Dialogue: 0,0:17:33.44,0:17:34.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:17:34.32,0:17:35.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kedengaran.
Dialogue: 0,0:17:35.40,0:17:38.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi suasananya jadi serius.
Dialogue: 0,0:17:38.53,0:17:39.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah...
Dialogue: 0,0:17:40.19,0:17:43.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sekolah sampai tahu\Nmereka berdua pacaran...
Dialogue: 0,0:17:43.59,0:17:45.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sensei bisa dipecat.
Dialogue: 0,0:17:45.75,0:17:47.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah merasa mereka pacaran?
Dialogue: 0,0:17:47.67,0:17:49.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, mereka tidak pacaran?
Dialogue: 0,0:17:49.21,0:17:51.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, mereka jelas-jelas pacaran.
Dialogue: 0,0:17:51.68,0:17:53.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini gawat.
Dialogue: 0,0:17:53.04,0:17:54.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat.
Dialogue: 0,0:17:54.29,0:17:56.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bicara seenaknya!
Dialogue: 0,0:17:57.52,0:17:59.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi begitu, ya.
Dialogue: 0,0:17:59.73,0:18:02.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sensei merasa bersalah pada Hanaori-san.
Dialogue: 0,0:18:02.45,0:18:05.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu Hanaori-san punya perasaan rumit\Nyang sulit disingkirkan.
Dialogue: 0,0:18:05.56,0:18:07.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi karena itu kalian makin dekat?
Dialogue: 0,0:18:07.83,0:18:09.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:18:09.53,0:18:12.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ini sekolah,\Ndan sekolah perempuan pula.
Dialogue: 0,0:18:12.90,0:18:16.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kalian tidak punya hubungan pun,\Nrumor tetap menyebar.
Dialogue: 0,0:18:16.21,0:18:19.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa berujung masalah besar juga,\Njadi hati-hati, ya.
Dialogue: 0,0:18:19.70,0:18:21.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Sensei.
Dialogue: 0,0:18:24.53,0:18:25.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:18:25.54,0:18:27.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau permen pelega tenggorokan?
Dialogue: 0,0:18:27.67,0:18:32.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini yang kumaksud!\NImut!
Dialogue: 0,0:18:33.95,0:18:35.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi itu suram.
Dialogue: 0,0:18:35.92,0:18:39.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita malah membuat Rokudo-sensei cemas.
Dialogue: 0,0:18:39.04,0:18:40.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:18:40.06,0:18:42.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih belum memaafkanmu.
Dialogue: 0,0:18:42.77,0:18:44.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak perlu.
Dialogue: 0,0:18:44.95,0:18:46.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang memanfaatkanmu.
Dialogue: 0,0:18:48.19,0:18:51.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah menghancurkan kekaisaran,\Nyang tersisa...
Dialogue: 0,0:18:51.49,0:18:55.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanyalah rasa sakit kematian yang abadi\Ndan pertempuran yang tak pernah usai.
Dialogue: 0,0:18:57.39,0:18:59.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menunggumu.
Dialogue: 0,0:18:59.67,0:19:02.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Raja Iblis harus dikalahkan\Noleh sang Pahlawan.
Dialogue: 0,0:19:03.96,0:19:08.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya kamu satu-satunya sosok\Nyang bisa membebaskanku.
Dialogue: 0,0:19:23.56,0:19:25.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berterima kasih padamu.
Dialogue: 0,0:19:29.57,0:19:30.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh.
Dialogue: 0,0:19:30.86,0:19:34.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat pertama kali aku datang ke rumahmu,\Napa yang kamu pikirkan?
Dialogue: 0,0:19:45.00,0:19:46.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti merepotkan.
Dialogue: 0,0:19:46.53,0:19:48.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu yang membuatku kesal!
Dialogue: 0,0:19:48.17,0:19:50.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hmph! Dasar!
Dialogue: 0,0:19:50.67,0:19:52.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dulunya Raja Iblis.
Dialogue: 0,0:19:52.81,0:19:53.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sekarang...
Dialogue: 0,0:19:55.47,0:19:56.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang...
Dialogue: 0,0:19:57.88,0:20:01.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar! Malah terseret masalah\Nseperti ini, aku jadi repot!
Dialogue: 0,0:20:02.43,0:20:03.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:20:04.69,0:20:07.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal seperti ini disebut kedamaian, ya?
Dialogue: 0,0:20:07.60,0:20:09.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu orangnya positif, ya.
Dialogue: 0,0:20:09.48,0:20:11.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kan pahlawan.
Dialogue: 0,0:20:11.86,0:20:12.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yaho!
Dialogue: 0,0:20:12.97,0:20:14.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan, ya!
Dialogue: 0,0:20:14.32,0:20:16.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tadi melihat kami, ya?
Dialogue: 0,0:20:16.13,0:20:17.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya temanku sedang dalam masalah.
Dialogue: 0,0:20:17.85,0:20:19.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan persahabatan.
Dialogue: 0,0:20:19.41,0:20:21.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu salah paham!\NKami bukan kopel!
Dialogue: 0,0:20:21.84,0:20:23.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah, aku ingin membunuhnya!
Dialogue: 0,0:20:23.99,0:20:26.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa muka kalian nyengir begitu?
Dialogue: 0,0:20:53.57,0:20:57.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar!\NSudah kubilang bukan!
Dialogue: 0,0:20:57.56,0:20:59.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keseharian seperti ini juga lumayan.
Dialogue: 0,0:22:37.39,0:22:40.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai anak domba yang tersesat dalam dosa.
Dialogue: 0,0:22:41.71,0:22:44.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertobatlah dan akuilah dosamu sepenuh jiwa.
Dialogue: 0,0:22:45.57,0:22:47.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat melawan Takanashi,
Dialogue: 0,0:22:47.49,0:22:51.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat bersentuhan dengannya, aku diam-diam\Nmencuri levelnya dengan Energi Drain.
Dialogue: 0,0:22:54.92,0:22:56.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itulah dia bukan ancaman.
Dialogue: 0,0:22:57.06,0:22:58.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berdoalah.
Dialogue: 0,0:23:18.31,0:23:21.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan melakukan hal\Nyang sulit dipahami penonton.
Dialogue: 0,0:23:21.46,0:23:22.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:23:22.65,0:23:24.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Parodi ini juga.
Dialogue: 0,0:23:25.77,0:23:28.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masalah teratasi!\NBagian pertama selesai!
Dialogue: 0,0:23:28.92,0:23:31.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang diselesaikan baru beberapa.
Dialogue: 0,0:23:31.22,0:23:34.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari sini,\Ndrama komedi romantis sekolah dimulai!
Dialogue: 0,0:23:34.65,0:23:37.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu bisa tahan hidup tanpa kekerasan?
Dialogue: 0,0:23:37.35,0:23:38.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu harusnya ngaca.
Dialogue: 0,0:23:38.44,0:23:40.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu bilang?
