Dialogue: 0,0:23:37.27,0:23:39.98,sign,,0000,0000,0000,,EPISODE 10: SEGITIGA PEMBALIK KEADAAN
Dialogue: 0,0:23:39.98,0:23:49.99,sign,,0000,0000,0000,,JANGAN LUPA NONTON LAGI, YA!\NILUSTRASI: FUKUYAMA JUN
Dialogue: 0,0:00:03.73,0:00:07.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Telat terparah of the year!\NAku harus bergegas!
Dialogue: 0,0:00:09.32,0:00:11.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang ini kenapa?\NSebaiknya kubunuh saja.
Dialogue: 0,0:00:11.87,0:00:13.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh.
Dialogue: 0,0:00:13.87,0:00:15.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kacamataku mana?
Dialogue: 0,0:00:20.86,0:00:23.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dilihat dari dekat,\Ndia ternyata tampan.
Dialogue: 0,0:00:25.57,0:00:28.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal, aku gadis yang menarik.
Dialogue: 0,0:00:28.78,0:00:30.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kenapa?
Dialogue: 0,0:00:31.46,0:00:34.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Mecha #6.
Dialogue: 0,0:00:34.46,0:00:37.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mesin pembantai yang datang\Ndari celah antardimensi.
Dialogue: 0,0:00:37.90,0:00:39.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bilang dirimu mesin pembantai?
Dialogue: 0,0:00:39.94,0:00:41.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:00:41.65,0:00:44.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku android model\NGadis Kasmaran of the year.
Dialogue: 0,0:00:44.90,0:00:46.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu bagaimana\Ndengan mesin pembunuhnya?
Dialogue: 0,0:00:46.73,0:00:53.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, sakit!\NIni cedera kaki tersakit of the year!
Dialogue: 0,0:00:53.76,0:00:55.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini punyamu?
Dialogue: 0,0:00:55.26,0:00:56.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan punyaku!
Dialogue: 0,0:00:56.87,0:01:00.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakiku tidak ada bautnya!\NLihat yang benar!
Dialogue: 0,0:01:00.59,0:01:02.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:01:05.09,0:01:07.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! Itu mobil pemadam kebakaran!
Dialogue: 0,0:02:53.57,0:02:55.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sensei, kamu kenapa?
Dialogue: 0,0:02:56.08,0:02:57.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu terlihat lelah, ya.
Dialogue: 0,0:02:57.70,0:03:02.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini, tapi pagi aku tabrakan\Ndengan seseorang di gang.
Dialogue: 0,0:03:02.34,0:03:03.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?\NDengan perempuan?
Dialogue: 0,0:03:04.14,0:03:04.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Deg.
Dialogue: 0,0:03:04.94,0:03:07.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dibilang perempuan,\Ndia mungkin perempuan...
Dialogue: 0,0:03:07.97,0:03:09.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia sedang makan roti?
Dialogue: 0,0:03:09.57,0:03:11.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku telat!\NAku telat!
Dialogue: 0,0:03:11.06,0:03:14.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan roti, tapi dia menggigit\Nyang bentuknya mirip.
Dialogue: 0,0:03:14.22,0:03:16.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, momen deg-degan apaan itu?
Dialogue: 0,0:03:16.96,0:03:18.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirip orang mendadak jatuh cinta.
Dialogue: 0,0:03:18.93,0:03:21.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan deg-degan,
Dialogue: 0,0:03:21.33,0:03:23.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lebih mirip kecelakaan lalu lintas.
Dialogue: 0,0:03:23.02,0:03:24.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya itu?
Dialogue: 0,0:03:26.98,0:03:29.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Momen deg-degan, ya?
Dialogue: 0,0:03:29.31,0:03:31.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meteor, kamu ingin mengalami\Nmomen deg-degan seperti apa?
Dialogue: 0,0:03:31.82,0:03:34.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin momen yang mirip permainan maut?
Dialogue: 0,0:03:35.07,0:03:36.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ini bodoh, ya?
Dialogue: 0,0:03:36.24,0:03:37.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti ada, kan?
Dialogue: 0,0:03:37.63,0:03:38.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Momen yang romantis!
Dialogue: 0,0:03:38.75,0:03:39.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:03:40.32,0:03:42.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti momen menjinakkan bom?
Dialogue: 0,0:03:42.96,0:03:44.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu anggota SWAT negara mana?
Dialogue: 0,0:03:44.24,0:03:46.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke mana tingkah gadis polosmu?
Dialogue: 0,0:03:47.07,0:03:49.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matsurika, beri dia masukan juga!
Dialogue: 0,0:03:49.98,0:03:51.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau coba trading fx?
Dialogue: 0,0:03:51.90,0:03:53.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga sama bodohnya!
Dialogue: 0,0:04:00.74,0:04:03.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku murid baru of the year!
Dialogue: 0,0:04:04.64,0:04:06.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu membuat hatiku meledak
Dialogue: 0,0:04:06.51,0:04:09.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seperti bom of the year!
Dialogue: 0,0:04:09.20,0:04:11.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?\NItu cuma kiasan, kan?
Dialogue: 0,0:04:11.11,0:04:13.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, dadaku sakit.
Dialogue: 0,0:04:14.38,0:04:16.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong sentuh aku di sini.
Dialogue: 0,0:04:16.02,0:04:17.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:04:17.74,0:04:20.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sentuh aku di sini.\NCepat!
Dialogue: 0,0:04:24.04,0:04:27.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat!\NLima menit lagi sebelum meledakkan diri!
Dialogue: 0,0:04:29.29,0:04:31.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Empat menit lagi sebelum meledakkan diri...
Dialogue: 0,0:04:31.97,0:04:34.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}of... of...
Dialogue: 0,0:04:34.00,0:04:37.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, dia itu mesin pembantai!
Dialogue: 0,0:04:37.97,0:04:40.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, "of the year" itu apa?
Dialogue: 0,0:04:40.59,0:04:42.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik! Minggir sana!
Dialogue: 0,0:04:42.17,0:04:43.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau akan kubunuh of the year!
Dialogue: 0,0:04:44.93,0:04:46.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh!
Dialogue: 0,0:04:46.39,0:04:47.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gikon!
Dialogue: 0,0:04:47.85,0:04:49.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Megas!
Dialogue: 0,0:04:53.90,0:04:55.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelas 1 heboh, ya.
Dialogue: 0,0:04:55.84,0:04:57.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa terjadi sesuatu?
Dialogue: 0,0:04:58.11,0:05:00.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya ada robot yang mengamuk.
Dialogue: 0,0:05:00.43,0:05:02.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?\NRobot?
Dialogue: 0,0:05:02.16,0:05:05.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu,\Ndia juga tergila-gila pada Sensei.
Dialogue: 0,0:05:05.84,0:05:07.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Robotnya?
Dialogue: 0,0:05:10.46,0:05:13.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini hari yang sangat kacau.
Dialogue: 0,0:05:15.15,0:05:16.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ryusei.
Dialogue: 0,0:05:16.38,0:05:19.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meteor, jajan saat perjalanan pulang?
Dialogue: 0,0:05:19.09,0:05:21.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini aku bantu-bantu ekskul voli.
Dialogue: 0,0:05:21.73,0:05:23.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku lapar.
Dialogue: 0,0:05:23.84,0:05:25.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, setengahnya buatmu.
Dialogue: 0,0:05:25.73,0:05:26.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius boleh?
Dialogue: 0,0:05:28.91,0:05:31.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih punya bakpao kacang merah.
Dialogue: 0,0:05:32.40,0:05:35.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau soal jajan di jalan,\Nbakpao daging memang pas, ya.
Dialogue: 0,0:05:35.58,0:05:36.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:05:37.86,0:05:39.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meteor, di bagian ini.
Dialogue: 0,0:05:40.58,0:05:42.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada pasta kacang di mulutmu.
Dialogue: 0,0:05:42.66,0:05:44.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong lapkan.\NTanganku sedang pegang yang lain.
Dialogue: 0,0:05:44.86,0:05:46.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat.
Dialogue: 0,0:05:46.38,0:05:47.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar, ya.
Dialogue: 0,0:05:47.49,0:05:49.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar tinggi kita sama.
Dialogue: 0,0:05:49.92,0:05:50.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang boleh.
Dialogue: 0,0:05:54.13,0:05:56.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, sudah bersih.
Dialogue: 0,0:06:02.91,0:06:04.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih...
Dialogue: 0,0:06:07.22,0:06:09.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti menatapku!
Dialogue: 0,0:06:09.54,0:06:11.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus begitu untuk mengelap mulutmu!
Dialogue: 0,0:06:12.22,0:06:16.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini aku mengobrol soal momen\Nyang bikin deg-degan.
Dialogue: 0,0:06:16.56,0:06:18.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:06:18.18,0:06:22.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat memikirkan yang lebih seru\Ndari serangan robot...
Dialogue: 0,0:06:22.11,0:06:24.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawabannya adalah trading fx!
Dialogue: 0,0:06:24.74,0:06:26.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kusarankan jangan sentuh fx.
Dialogue: 0,0:06:28.43,0:06:29.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba lihat yang ini!
Dialogue: 0,0:06:29.78,0:06:31.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih!
Dialogue: 0,0:06:35.00,0:06:37.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pohon tumbang mau lewat!
Dialogue: 0,0:06:37.04,0:06:38.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tong juga mau lewat!
Dialogue: 0,0:06:40.71,0:06:42.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah dapat ide riasan rambut kita?
Dialogue: 0,0:06:42.91,0:06:44.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya diikal kecil cocok!
Dialogue: 0,0:06:44.85,0:06:47.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah kelihatan cocok, Ayame!
Dialogue: 0,0:06:47.18,0:06:51.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku ingin sama dengan yang lainnya juga.\N- Oi, Takanashi!
Dialogue: 0,0:06:51.14,0:06:54.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, jangan mengabaikan kami!
Dialogue: 0,0:06:54.18,0:06:56.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu lupa dengan mukaku?
Dialogue: 0,0:06:56.67,0:06:58.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yaotome-san.
Dialogue: 0,0:06:58.64,0:07:00.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:07:01.25,0:07:04.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar kamu senang-senang\Nselagi aku tidak ada.
Dialogue: 0,0:07:04.85,0:07:06.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu benar, kan?
Dialogue: 0,0:07:06.95,0:07:09.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tidak jawab?
Dialogue: 0,0:07:09.25,0:07:13.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kamu lupa peranmu,\Ntemui aku di belakang sekolah.
Dialogue: 0,0:07:13.28,0:07:15.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik...
Dialogue: 0,0:07:20.02,0:07:22.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan buat aku mengulang perkataanku!
Dialogue: 0,0:07:22.96,0:07:27.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya kamu jadi terkenal\Ndi kelas saat aku tidak ada.
Dialogue: 0,0:07:27.71,0:07:30.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya kamu sadar diri\Nsebelum aku membunuhmu.
Dialogue: 0,0:07:30.68,0:07:35.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, orang yang mau kubunuh\Nmalah mengancam mau membunuhku.
Dialogue: 0,0:07:35.25,0:07:37.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama dia Takanashi Ayame.
Dialogue: 0,0:07:37.71,0:07:41.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pahlawan dunia lain yang jadi antagonis,\Ndan mengerikan saat marah.
Dialogue: 0,0:07:41.49,0:07:42.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengurungkan niatku untuk membunuhnya,
Dialogue: 0,0:07:42.44,0:07:44.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengurungkan niatku untuk membunuhnya.
Dialogue: 0,0:07:44.26,0:07:46.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus bagaimana?
Dialogue: 0,0:07:46.15,0:07:51.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin mereka tak pernah\Nterpikirkan akan dibunuh.
Dialogue: 0,0:07:51.20,0:07:53.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi bimbang...
Dialogue: 0,0:07:53.66,0:07:55.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian yang di sana!\NSedang apa?
Dialogue: 0,0:07:56.32,0:07:56.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat!
Dialogue: 0,0:07:57.66,0:07:59.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awas kalau cerita ke orang lain.
Dialogue: 0,0:07:59.98,0:08:02.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti akan membuatmu menderita.
Dialogue: 0,0:08:05.88,0:08:08.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja, Takanashi-san?\NApa yang sebenarnya terjadi?
Dialogue: 0,0:08:08.63,0:08:11.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.\NKamu Asahina-san, ya?
Dialogue: 0,0:08:11.89,0:08:14.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa barusan kamu dirundung?
Dialogue: 0,0:08:14.24,0:08:15.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:08:16.34,0:08:19.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pakai Pesona untuk menyuruh mereka\Ntidak masuk sekolah,
Dialogue: 0,0:08:19.63,0:08:22.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi efeknya kurang manjur\Nkalau targetnya sangat benci padaku, ya.
Dialogue: 0,0:08:22.82,0:08:23.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:08:23.84,0:08:28.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tahu kamu siapa.\NKamu Gadis Penyihir dari dimensi lain, kan?
Dialogue: 0,0:08:28.75,0:08:30.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu bisa tahu?
Dialogue: 0,0:08:30.16,0:08:32.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu terjadi berkat ulahku.
Dialogue: 0,0:08:32.37,0:08:33.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:08:33.38,0:08:35.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanaori-san tidak cerita?
Dialogue: 0,0:08:35.84,0:08:37.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku adalah pahlawan jahat.
Dialogue: 0,0:08:37.83,0:08:40.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dengan egoisnya membuka portal\Ndi sembarang tempat,
Dialogue: 0,0:08:40.88,0:08:42.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memanipulasi Narukami-sensei,
Dialogue: 0,0:08:42.75,0:08:45.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu mencoba menyakiti Hanaori-san\Ndan teman-temannya.
Dialogue: 0,0:08:45.55,0:08:47.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, karena satu hal dan hal lainnya,
Dialogue: 0,0:08:47.69,0:08:50.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sekarang aku menjaga sikap\Nsambil merenungkan perbuatanku.
Dialogue: 0,0:08:50.93,0:08:52.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:08:52.58,0:08:56.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya kamu menahan diri\Nsaat dirundung Yaotome-san?
Dialogue: 0,0:08:56.06,0:08:58.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, tapi...
Dialogue: 0,0:08:58.30,0:08:59.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi?
Dialogue: 0,0:08:59.27,0:09:02.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tadi nyaris akan membunuh mereka.
Dialogue: 0,0:09:02.75,0:09:04.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu!
Dialogue: 0,0:09:04.61,0:09:06.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma bercanda.
Dialogue: 0,0:09:06.66,0:09:08.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi niatmu serius, ya?
Dialogue: 0,0:09:08.96,0:09:10.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah dapat peringatan.
Dialogue: 0,0:09:10.91,0:09:14.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku sampai melukai orang biasa,
Dialogue: 0,0:09:14.74,0:09:18.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}reputasi "dia" sebagai penjahat\Nakan makin kuat.
Dialogue: 0,0:09:18.62,0:09:21.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan dicap sebagai orang\Nyang menyalahgunakan kekuatan
Dialogue: 0,0:09:21.09,0:09:23.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari dunia lain untuk menyakiti orang lemah.
Dialogue: 0,0:09:24.38,0:09:27.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alasanku sebenarnya tak penting.
Dialogue: 0,0:09:27.03,0:09:31.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka yang merundungku,\Ntapi aku yang akan dicap buruk.
Dialogue: 0,0:09:31.57,0:09:35.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sebenarnya sangat benci\Ndiperlakukan tak adil seperti ini.
Dialogue: 0,0:09:35.51,0:09:37.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula...
Dialogue: 0,0:09:37.70,0:09:40.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya tak enak kalau\Norang-orang yang agak kusukai
Dialogue: 0,0:09:40.24,0:09:42.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berpikiran buruk tentangku.
Dialogue: 0,0:09:43.23,0:09:44.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takanashi.
Dialogue: 0,0:09:45.33,0:09:47.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau konsultasi\Nke Narukami-sensei?
Dialogue: 0,0:09:48.88,0:09:53.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, saat ini aku ingin memikirkan\Nmasalah ini sendiri.
Dialogue: 0,0:09:53.20,0:09:55.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini aku tak mau dengar\Nsaran dari siapa pun.
Dialogue: 0,0:09:55.74,0:09:58.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa cerita padaku.
Dialogue: 0,0:09:58.18,0:10:00.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau curhat, tinggal bilang padaku.
Dialogue: 0,0:10:00.45,0:10:05.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, aku percaya pada pilihan\Napa pun yang kamu ambil.
Dialogue: 0,0:10:05.42,0:10:08.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Asahina.
Dialogue: 0,0:10:08.58,0:10:12.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini masalah yang harus kuputuskan sendiri.
Dialogue: 0,0:10:15.72,0:10:18.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, ayo lanjutkan
Dialogue: 0,0:10:18.45,0:10:20.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}obrolan kita yang tadi.
Dialogue: 0,0:10:20.43,0:10:21.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini terlalu cepat.
Dialogue: 0,0:10:22.14,0:10:24.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yaotome-san, maafkan aku.
Dialogue: 0,0:10:24.62,0:10:25.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan konyol!
Dialogue: 0,0:10:25.78,0:10:28.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cewek tadi itu murid baru, kan?
Dialogue: 0,0:10:28.13,0:10:30.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu curhat ke teman barumu?
Dialogue: 0,0:10:30.70,0:10:32.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku tidak cerita pada siapa pun.
Dialogue: 0,0:10:32.90,0:10:36.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sekarang bokek\Nkarena habis untuk bolos.
Dialogue: 0,0:10:36.99,0:10:39.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong bantu kami, Takanashi.
Dialogue: 0,0:10:39.74,0:10:41.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak punya uang lagi.
Dialogue: 0,0:10:41.23,0:10:42.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak punya?
Dialogue: 0,0:10:42.20,0:10:45.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, bisa pinjam\Nke cewek murid baru tadi?
Dialogue: 0,0:10:46.54,0:10:49.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan libatkan Asahina-san!
Dialogue: 0,0:10:49.36,0:10:51.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tidak peduli pendapatmu.
Dialogue: 0,0:10:51.87,0:10:55.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti bisa menghadapi mereka\Ndengan baik-baik.
Dialogue: 0,0:10:55.33,0:10:58.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku tak mau dia terlibat\Ndalam masalahku.
Dialogue: 0,0:11:02.06,0:11:04.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sepertinya gampang kita rundung!
Dialogue: 0,0:11:04.86,0:11:06.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:11:07.20,0:11:09.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keputusanku...
Dialogue: 0,0:11:09.90,0:11:11.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keputusanku...
Dialogue: 0,0:11:15.20,0:11:18.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah merekam semua obrolan kita tadi!
Dialogue: 0,0:11:18.80,0:11:22.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya termasuk ancaman\Ndan niat buruk kalian tadi.
Dialogue: 0,0:11:23.57,0:11:25.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pikir kami akan takut dengan itu?
Dialogue: 0,0:11:25.87,0:11:28.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sadar apa yang sudah kamu lakukan?
Dialogue: 0,0:11:28.18,0:11:29.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:11:29.54,0:11:33.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa mengadu ke orang tuaku\Nuntuk menghilangkan rekamanmu itu.
Dialogue: 0,0:11:33.84,0:11:37.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bahkan bisa membuat hidupmu hancur.
Dialogue: 0,0:11:37.80,0:11:40.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum hal repot terjadi,
Dialogue: 0,0:11:40.26,0:11:42.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebaiknya serahkan ponselmu!
Dialogue: 0,0:11:44.11,0:11:45.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku setuju.
Dialogue: 0,0:11:47.74,0:11:50.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harusnya pilih cara yang paling simpel.
Dialogue: 0,0:11:50.02,0:11:52.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pukulan Cewek Cantik!
Dialogue: 0,0:11:55.31,0:11:56.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa ini?\NPintunya susah dibuka!
Dialogue: 0,0:11:56.94,0:11:58.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa pun, tolong kami!
Dialogue: 0,0:11:58.59,0:12:00.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tak akan kubiarkan kabur.
Dialogue: 0,0:12:01.04,0:12:03.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua juga sama-sama bersalah.
Dialogue: 0,0:12:05.14,0:12:06.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memanggil monster!
Dialogue: 0,0:12:08.40,0:12:11.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Roper adalah hewan tak bertulang belakang\Nyang punya tentakel.
Dialogue: 0,0:12:12.05,0:12:15.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menyerang dengan\Ntentakel lengket dan berlendir!
Dialogue: 0,0:12:15.84,0:12:17.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan ini, dasar para cewek nakal!
Dialogue: 0,0:12:17.82,0:12:20.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bermainlah dengan tentakel monster ini!
Dialogue: 0,0:12:21.30,0:12:24.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:12:27.54,0:12:29.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yo, sudah selesai?
Dialogue: 0,0:12:29.95,0:12:31.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:12:31.27,0:12:34.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak perlu menasihatiku,\Naku tak akan membunuh mereka.
Dialogue: 0,0:12:34.02,0:12:36.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau dengar omongan klise\Ntentang balas dendam
Dialogue: 0,0:12:36.40,0:12:40.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu buruk atau semua nyawa itu berarti.
Dialogue: 0,0:12:40.91,0:12:42.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum cerita, ya?
Dialogue: 0,0:12:42.80,0:12:45.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dulunya Raja Iblis dari dunia lain.
Dialogue: 0,0:12:45.12,0:12:46.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:12:46.69,0:12:48.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menghancurkan kerajaanku sendiri.
Dialogue: 0,0:12:49.84,0:12:52.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mempelajari ilmu terlarang\Ndemi balas dendam,
Dialogue: 0,0:12:52.93,0:12:56.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan membawa kehancuran pada musuh\Ndengan pasukan mayat hidupku.
Dialogue: 0,0:12:56.94,0:13:00.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu, aku bereinkarnasi setelah\Ndibunuh oleh sang Pahlawan Meteor.
Dialogue: 0,0:13:01.82,0:13:04.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi aku tak pernah bicara\Nsoal omongan klise.
Dialogue: 0,0:13:04.14,0:13:06.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia Raja Iblis? Aku baru tahu!
Dialogue: 0,0:13:06.97,0:13:11.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, bagaimana rasanya\Nsetelah berhasil balas dendam?
Dialogue: 0,0:13:11.06,0:13:12.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terbaik!
Dialogue: 0,0:13:12.77,0:13:15.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah aku tak minta saran padanya.
Dialogue: 0,0:13:16.24,0:13:17.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:13:28.00,0:13:29.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?\NAku cocok pakai ini?
Dialogue: 0,0:13:29.96,0:13:31.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kelihatan cocok.
Dialogue: 0,0:13:33.17,0:13:37.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah lama jadi petualang\Ndan nostalgia ingin pakai baju seperti ini.
Dialogue: 0,0:13:37.66,0:13:40.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kamu kelihatan seksi pakai itu.\NYakin tak jadi masalah?
Dialogue: 0,0:13:40.69,0:13:42.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan masalah.
Dialogue: 0,0:13:42.22,0:13:43.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya, hari ini...
Dialogue: 0,0:13:43.51,0:13:46.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Festival Sekolah Putri Mitsurugi!
Dialogue: 0,0:13:57.11,0:13:58.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang!
Dialogue: 0,0:13:58.67,0:14:01.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang di Kafe Petualang Dunia Lain!
Dialogue: 0,0:14:01.28,0:14:03.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kafe Petualang, ya?
Dialogue: 0,0:14:03.74,0:14:05.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengunjungnya khusus untuk para maniak?
Dialogue: 0,0:14:05.49,0:14:06.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa!
Dialogue: 0,0:14:06.58,0:14:08.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang suka genre dunia lain, kan?
Dialogue: 0,0:14:08.70,0:14:10.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santai dan nikmati hari kalian, ya!
Dialogue: 0,0:14:10.51,0:14:12.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:14:16.32,0:14:18.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini cocok?
Dialogue: 0,0:14:18.80,0:14:20.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia elf!
Dialogue: 0,0:14:20.02,0:14:22.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu elf sungguhan!
Dialogue: 0,0:14:22.67,0:14:25.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak seorang pun akan berkabung\Nuntuk orang mati...
Dialogue: 0,0:14:25.43,0:14:27.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elf tidak bicara seperti itu!
Dialogue: 0,0:14:28.75,0:14:31.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, kalian sangat niat, ya!
Dialogue: 0,0:14:31.76,0:14:34.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami totalitas soal kostum dan dekorasi!
Dialogue: 0,0:14:34.42,0:14:36.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sudah sebagus aslinya.
Dialogue: 0,0:14:36.15,0:14:39.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, kami juga kerja keras buat menunya.
Dialogue: 0,0:14:39.10,0:14:39.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:14:39.86,0:14:42.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menu Kreasi Anggota Guild!
Dialogue: 0,0:14:43.09,0:14:45.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takoyaki Kraken dengan Pedang Pahlawan!
Dialogue: 0,0:14:45.53,0:14:48.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pot au Feu Penuh Ketulusan dari Guild Petualang!
Dialogue: 0,0:14:48.49,0:14:51.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pisang Bakar dari Hutan Elf.
Dialogue: 0,0:14:51.08,0:14:53.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mangkuk Babi Hutan Jahe.
Dialogue: 0,0:14:55.25,0:14:58.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Rokudo-sensei ada di sini?
Dialogue: 0,0:14:58.13,0:14:59.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, Wakil Ketua Guild?
Dialogue: 0,0:14:59.69,0:15:02.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami kehabisan ide dan minta saran beliau.
Dialogue: 0,0:15:02.42,0:15:03.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kan orang bijak.
Dialogue: 0,0:15:03.97,0:15:06.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski Hutan Elf sampai kebakaran?
Dialogue: 0,0:15:06.61,0:15:08.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matsurika sudah usaha maksimal membuat itu!
Dialogue: 0,0:15:08.93,0:15:12.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang serius soal festival sekolah kita.
Dialogue: 0,0:15:12.89,0:15:14.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi begitu.
Dialogue: 0,0:15:14.35,0:15:16.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelas lain buat pameran apa?
Dialogue: 0,0:15:16.90,0:15:21.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelas 2 membuat rumah hantu\Npakai pemetaan proyeksi dan drone.
Dialogue: 0,0:15:21.61,0:15:22.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Canggih!
Dialogue: 0,0:15:22.59,0:15:23.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka serius, ya.
Dialogue: 0,0:15:23.82,0:15:26.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sudah niat,\Nsekolah putri pun tetap bekerja keras.
Dialogue: 0,0:15:26.84,0:15:27.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Kelas 3?
Dialogue: 0,0:15:27.99,0:15:30.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelas 3 membuat Kafe Putri Berkelas.
Dialogue: 0,0:15:30.70,0:15:32.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kafe Putri Berkelas?
Dialogue: 0,0:15:32.41,0:15:35.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kafe Putri Berkelas, maksudnya apa?
Dialogue: 0,0:15:35.09,0:15:36.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak tahu.
Dialogue: 0,0:15:36.52,0:15:38.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri berkelas itu maksudnya apa?
Dialogue: 0,0:15:38.13,0:15:39.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau cek ke sana!
Dialogue: 0,0:15:39.46,0:15:41.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, putri berkelas, ya?
Dialogue: 0,0:15:41.62,0:15:43.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku penasaran!
Dialogue: 0,0:15:43.05,0:15:45.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elf tidak bicara seperti itu!
Dialogue: 0,0:15:47.59,0:15:50.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tehnya sudah siap!
Dialogue: 0,0:15:50.67,0:15:53.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang, pelanggan yang terhormat.
Dialogue: 0,0:15:53.10,0:15:55.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan masuk dan nikmati.
Dialogue: 0,0:15:55.27,0:15:57.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sedia teh dan kopi.
Dialogue: 0,0:15:57.98,0:16:01.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, ini memang seperti putri berkelas!
Dialogue: 0,0:16:02.83,0:16:05.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri berkelas itu maksudnya apa?
Dialogue: 0,0:16:05.44,0:16:07.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada satu orang yang tidak niat!
Dialogue: 0,0:16:08.64,0:16:10.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:16:10.20,0:16:11.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada masalah!
Dialogue: 0,0:16:11.12,0:16:12.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takut!
Dialogue: 0,0:16:12.70,0:16:14.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan ke sana untuk menyelidiki!
Dialogue: 0,0:16:14.80,0:16:16.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati, ya!
Dialogue: 0,0:16:16.87,0:16:19.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisanya kuserahkan pada kalian!
Dialogue: 0,0:16:19.02,0:16:20.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan pada kami!
Dialogue: 0,0:16:20.29,0:16:22.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka tidak serius mengikuti tema!
Dialogue: 0,0:16:26.40,0:16:28.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak hantu yang mengamuk?
Dialogue: 0,0:16:28.22,0:16:31.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada serbuan monster?\NDi sini?
Dialogue: 0,0:16:31.98,0:16:35.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di area sekolah ini, pasti ada\Ncelah dimensi yang terbuka!
Dialogue: 0,0:16:35.14,0:16:37.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat! Kita harus redamkan\Nkekacauan ini dulu!
Dialogue: 0,0:16:37.35,0:16:40.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, penampilan kalian bagus juga, ya.
Dialogue: 0,0:16:40.31,0:16:43.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak penting.\NKami memang hantu!
Dialogue: 0,0:16:43.10,0:16:46.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelas kami membuat rumah hantu.
Dialogue: 0,0:16:46.34,0:16:48.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua cocok pakai itu.
Dialogue: 0,0:16:48.53,0:16:50.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga akan membantu.
Dialogue: 0,0:16:50.69,0:16:51.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu...
Dialogue: 0,0:16:51.78,0:16:54.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggap saja hari ini aku rekanmu.
Dialogue: 0,0:16:54.74,0:16:56.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri berkelas ikut bergabung?
Dialogue: 0,0:16:57.63,0:17:01.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal hantu ini, kita jelaskan pada semuanya\Nkalau ini bagian dari atraksi rumah hantu!
Dialogue: 0,0:17:01.96,0:17:05.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tinggal jelaskan kalau kami\Nsedang melakukan pemetaan proyeksi.
Dialogue: 0,0:17:05.17,0:17:07.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu akan berhasil?
Dialogue: 0,0:17:07.63,0:17:12.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, bagaimana cara kita mengalahkan\Nhantu yang mengamuk di area ramai ini?
Dialogue: 0,0:17:12.56,0:17:14.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisa ledakan bola apiku dan petir dia
Dialogue: 0,0:17:14.66,0:17:16.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan kena orang-orang.
Dialogue: 0,0:17:16.52,0:17:17.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku yang mengatasinya.
Dialogue: 0,0:17:17.98,0:17:22.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berpencar dan pancing\Nhantu-hantunya ke Rumah Hantu Kelas 2.
Dialogue: 0,0:17:22.23,0:17:25.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu mereka semua berkumpul,\Naku akan membasmi mereka sekaligus.
Dialogue: 0,0:17:25.77,0:17:26.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian lihat, kan?
Dialogue: 0,0:17:26.93,0:17:29.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru sihir kita sangat hebat, kan?
Dialogue: 0,0:17:29.54,0:17:32.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ingin lebih kuat,\Nkalian harus dengar dia.
Dialogue: 0,0:17:32.88,0:17:35.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa malah kamu yang bangga?
Dialogue: 0,0:17:35.49,0:17:36.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuserahkan pada kalian.
Dialogue: 0,0:17:36.74,0:17:37.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Baik!\N- Iya.
Dialogue: 0,0:17:37.66,0:17:39.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Serahkan padaku.\N- Baik.
Dialogue: 0,0:17:39.00,0:17:40.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Spark!
Dialogue: 0,0:17:40.21,0:17:41.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shock Bolt!
Dialogue: 0,0:17:46.26,0:17:47.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita ke area mana?
Dialogue: 0,0:17:47.46,0:17:48.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm...
Dialogue: 0,0:17:50.30,0:17:54.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita ke stan yakisoba dan stan sosis.
Dialogue: 0,0:17:56.16,0:17:57.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ide bagus!
Dialogue: 0,0:18:02.13,0:18:05.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau sendirian di rumah hantu.
Dialogue: 0,0:18:06.58,0:18:10.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kujelaskan!\NRyusei takut rumah hantu.
Dialogue: 0,0:18:10.24,0:18:13.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga kamu akan takut kalau sendirian.
Dialogue: 0,0:18:13.01,0:18:16.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena tak bisa memancing hantunya,\Naku akan menemanimu di sini.
Dialogue: 0,0:18:16.83,0:18:19.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ini, malah bicara seperti pahlawan.
Dialogue: 0,0:18:19.82,0:18:23.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pahlawan tak pernah berpaling\Ndari orang yang kesusahan.
Dialogue: 0,0:18:24.42,0:18:26.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiap orang punya hal\Nyang tak bisa mereka hadapi.
Dialogue: 0,0:18:26.83,0:18:28.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laki banget!
Dialogue: 0,0:18:28.50,0:18:30.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, apa hal yang kamu benci?
Dialogue: 0,0:18:31.28,0:18:33.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang yang sok benar secara moral.
Dialogue: 0,0:18:33.14,0:18:34.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sisi gelap sang Pahlawan.
Dialogue: 0,0:18:39.71,0:18:42.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berhasil memancingnya kemari.\NAyo kita basmi!
Dialogue: 0,0:18:42.42,0:18:44.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunjukkan kemampuanmu.
Dialogue: 0,0:18:45.22,0:18:47.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Return to the Grave!
Dialogue: 0,0:18:55.66,0:18:57.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takut.
Dialogue: 0,0:18:57.15,0:18:58.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan?
Dialogue: 0,0:19:00.11,0:19:02.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, sibuk parah!
Dialogue: 0,0:19:02.79,0:19:04.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita laris manis!
Dialogue: 0,0:19:04.38,0:19:07.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanaori-kun malah tidak ada!
Dialogue: 0,0:19:07.00,0:19:08.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, di sana!
Dialogue: 0,0:19:08.96,0:19:10.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia...
Dialogue: 0,0:19:10.09,0:19:11.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia Kuon, model terkenal!
Dialogue: 0,0:19:11.92,0:19:13.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat!
Dialogue: 0,0:19:13.05,0:19:14.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat yang di sana juga!
Dialogue: 0,0:19:14.18,0:19:15.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa dia?
Dialogue: 0,0:19:15.81,0:19:18.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu MooTuber terkenal, Anjing Luar Angkasa!
Dialogue: 0,0:19:18.48,0:19:19.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak kenal!
Dialogue: 0,0:19:19.60,0:19:21.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau yang duduk di belakang?
Dialogue: 0,0:19:21.39,0:19:22.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana?
Dialogue: 0,0:19:22.43,0:19:24.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia cuma paman biasa.
Dialogue: 0,0:19:24.94,0:19:26.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia cuma orang biasa.
Dialogue: 0,0:19:27.95,0:19:30.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hantu-hantu ini tak ada habisnya.
Dialogue: 0,0:19:30.61,0:19:34.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka tak akan berhenti\Nsampai kita menutup gerbangnya!
Dialogue: 0,0:19:36.91,0:19:40.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pukulan Sensitif Pahlawan!
Dialogue: 0,0:19:40.87,0:19:41.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar mesum!
Dialogue: 0,0:19:41.81,0:19:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu fokus melihat dada hantu itu, kan?
Dialogue: 0,0:19:43.78,0:19:45.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia itu hantu!
Dialogue: 0,0:19:45.08,0:19:47.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga Raja Iblis itu jahat!\NParah!
Dialogue: 0,0:19:47.96,0:19:49.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak salah apa pun!
Dialogue: 0,0:19:49.17,0:19:49.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:19:49.87,0:19:52.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia begitu karena Raja Iblis?
Dialogue: 0,0:19:52.82,0:19:55.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutmu, Raja Iblis itu seperti apa?
Dialogue: 0,0:19:57.17,0:19:58.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:19:58.84,0:20:01.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi ada yang keluar dari situ, kan?
Dialogue: 0,0:20:01.01,0:20:03.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kita lapor ini ke Sensei.
Dialogue: 0,0:20:05.26,0:20:06.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:20:06.32,0:20:07.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:20:09.02,0:20:11.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian ini selalu buat heboh, ya.
Dialogue: 0,0:20:12.19,0:20:15.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bantu kamu sekali ini saja, Penyihir.
Dialogue: 0,0:20:17.23,0:20:19.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya panik karena hantu\Nsudah mulai reda.
Dialogue: 0,0:20:19.54,0:20:23.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, malah jadi promosi bagus\Nbuat rumah hantu mereka.
Dialogue: 0,0:20:27.04,0:20:28.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang lain baru saja lapor.
Dialogue: 0,0:20:28.62,0:20:31.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, kita juga pergi.
Dialogue: 0,0:20:39.97,0:20:41.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laporan selesai.
Dialogue: 0,0:20:41.57,0:20:43.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, kita juga pergi.
Dialogue: 0,0:20:43.41,0:20:46.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, bisa jalan duluan?
Dialogue: 0,0:20:46.26,0:20:47.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?\NAda apa?
Dialogue: 0,0:20:48.59,0:20:51.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku malu kalau kita keluar bareng.
Dialogue: 0,0:20:51.94,0:20:54.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Oh, iya...
Dialogue: 0,0:20:54.93,0:20:57.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah apa yang terjadi,\Nmereka berdua tiba-tiba malu.
Dialogue: 0,0:22:27.99,0:22:30.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi itu enak banget.
Dialogue: 0,0:22:30.62,0:22:33.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kualitas sekolah putri megah memang beda.
Dialogue: 0,0:22:33.33,0:22:36.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masakan dari putri, ya.
Dialogue: 0,0:22:36.29,0:22:40.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu lebih suka yang mana?\NCewek kaya, cantik, pintar, dan jago masak,
Dialogue: 0,0:22:40.99,0:22:44.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau cewek kaya manja\Nyang jarinya diperban
Dialogue: 0,0:22:44.08,0:22:45.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi usahanya sudah maksimal?
Dialogue: 0,0:22:45.38,0:22:46.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ini bahas apa?
Dialogue: 0,0:22:50.14,0:22:53.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.\NAku boleh istirahat sebentar?
Dialogue: 0,0:22:53.23,0:22:54.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?
Dialogue: 0,0:22:54.54,0:22:56.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku agak lelah.
Dialogue: 0,0:23:01.07,0:23:03.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?\NAda hantu lagi?
Dialogue: 0,0:23:06.22,0:23:07.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan...
Dialogue: 0,0:23:07.57,0:23:09.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan apa-apa.
Dialogue: 0,0:23:24.97,0:23:27.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aurora cantik, ya.
Dialogue: 0,0:23:27.53,0:23:29.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu tak merasa itu pertanda buruk?
Dialogue: 0,0:23:29.79,0:23:31.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu harus lebih hati-hati.
Dialogue: 0,0:23:31.35,0:23:34.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin saja saingan cinta barumu muncul.
Dialogue: 0,0:23:34.66,0:23:36.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:23:36.14,0:23:37.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa?
Dialogue: 0,0:23:38.17,0:23:39.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa?
