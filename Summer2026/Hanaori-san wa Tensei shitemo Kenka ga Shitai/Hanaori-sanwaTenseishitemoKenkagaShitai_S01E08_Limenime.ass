Dialogue: 0,0:00:08.26,0:00:12.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sang Pembalas Dendam, Avenger.
Dialogue: 0,0:00:13.31,0:00:15.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang akan menghancurkan Raja Iblis.
Dialogue: 0,0:00:16.77,0:00:17.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aura Slash!
Dialogue: 0,0:00:17.62,0:00:19.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Darkness Wall!
Dialogue: 0,0:00:24.67,0:00:25.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Licik sekali!
Dialogue: 0,0:00:27.13,0:00:28.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Energy Bolt!
Dialogue: 0,0:00:29.72,0:00:31.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dinding seperti ini!
Dialogue: 0,0:00:34.72,0:00:36.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Binding Trap.
Dialogue: 0,0:00:38.99,0:00:40.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hell Flare!
Dialogue: 0,0:00:45.23,0:00:46.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingat baik-baik.
Dialogue: 0,0:00:47.25,0:00:49.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah cara bertarung seorang necromancer.
Dialogue: 0,0:00:52.83,0:00:53.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat!
Dialogue: 0,0:00:54.02,0:00:55.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Corpse Explosion!
Dialogue: 0,0:01:10.95,0:01:14.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga, Raja Iblis memang kuat.
Dialogue: 0,0:01:15.30,0:01:16.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah puas?
Dialogue: 0,0:01:16.89,0:01:18.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lain kali aku akan mengalahkanmu.
Dialogue: 0,0:01:25.10,0:01:28.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, aku mau kamu memangkuku.
Dialogue: 0,0:01:28.28,0:01:29.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:01:29.49,0:01:31.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai tanda permintaan maafku kemarin.
Dialogue: 0,0:01:31.46,0:01:33.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sangat memikirkan itu?
Dialogue: 0,0:01:33.28,0:01:36.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan aku tidur di pangkuanmu!
Dialogue: 0,0:01:36.06,0:01:37.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu terlalu memaksa!
Dialogue: 0,0:01:41.70,0:01:43.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang?
Dialogue: 0,0:01:43.08,0:01:44.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya...
Dialogue: 0,0:01:44.79,0:01:46.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keras dan tidak empuk.
Dialogue: 0,0:01:46.75,0:01:49.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa para pria suka hal seperti ini?
Dialogue: 0,0:01:51.78,0:01:53.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah malah sebaliknya?
Dialogue: 0,0:01:53.38,0:01:54.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Sebaliknya?
Dialogue: 0,0:01:54.90,0:01:56.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang bilang begitu?
Dialogue: 0,0:01:56.19,0:01:57.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rokudo-sensei.
Dialogue: 0,0:03:31.86,0:03:34.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rokudo-sensei tahu segala hal.
Dialogue: 0,0:03:34.40,0:03:35.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beliau seperti orang bijak.
Dialogue: 0,0:03:35.99,0:03:37.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu...
Dialogue: 0,0:03:38.06,0:03:39.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa betulan dia orang bijak?
Dialogue: 0,0:03:39.95,0:03:42.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu dapat petuah apa lagi darinya?
Dialogue: 0,0:03:42.49,0:03:46.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, beliau bilang pria suka kentang goreng.
Dialogue: 0,0:03:46.10,0:03:47.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya itu?
Dialogue: 0,0:03:47.83,0:03:51.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang sering pesan\Nkentang goreng di bar...
Dialogue: 0,0:03:51.17,0:03:52.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi itu salah?
Dialogue: 0,0:03:54.80,0:03:55.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:03:55.59,0:03:58.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan!\NApa maksud dia itu nikujaga?
Dialogue: 0,0:03:58.18,0:04:00.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu hampir benar, Rokudo-sensei!
Dialogue: 0,0:04:02.19,0:04:03.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang apa lagi?
Dialogue: 0,0:04:03.35,0:04:06.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beliau bilang semua pria suka zirah bikini.
Dialogue: 0,0:04:06.42,0:04:08.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rokudo-sensei!
Dialogue: 0,0:04:08.81,0:04:13.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meteor...\NKamu ditipu Rokudo-sensei.
Dialogue: 0,0:04:13.52,0:04:15.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?\NJadi kamu tidak suka?
Dialogue: 0,0:04:15.23,0:04:17.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa... tidak semuanya.
Dialogue: 0,0:04:17.70,0:04:21.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:04:22.26,0:04:23.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ditipu...
Dialogue: 0,0:04:24.16,0:04:26.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami ditipu orang bijak yang jail, ya.
Dialogue: 0,0:04:28.75,0:04:31.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku harus pulang...
Dialogue: 0,0:04:31.09,0:04:33.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Me-Meteor juga bilang begitu.
Dialogue: 0,0:04:33.46,0:04:35.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu.\NJangan-jangan...
Dialogue: 0,0:04:36.45,0:04:38.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, kamu memakainya?
Dialogue: 0,0:04:38.67,0:04:40.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak mungkin, kan?
Dialogue: 0,0:04:40.64,0:04:43.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menatapku begitu!\NSukebe Ningen!
Dialogue: 0,0:04:43.18,0:04:47.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Scheveningen itu kawasan wisata\Ndi Provinsi Holland Selatan, Belanda.
Dialogue: 0,0:04:47.92,0:04:49.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau pulang!
Dialogue: 0,0:04:58.11,0:05:01.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah...
Dialogue: 0,0:05:05.41,0:05:07.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rokudo-sensei.
Dialogue: 0,0:05:07.49,0:05:10.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan ajarkan Hanaori-kun\Nhal-hal yang aneh lagi.
Dialogue: 0,0:05:10.99,0:05:12.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat kerepotan.
Dialogue: 0,0:05:12.67,0:05:16.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh! Jadi dia tidur di pangkuanmu?
Dialogue: 0,0:05:16.06,0:05:17.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kamu menikmatinya, ya?
Dialogue: 0,0:05:17.96,0:05:19.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia melakukannya...
Dialogue: 0,0:05:19.66,0:05:22.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh? Oh...
Dialogue: 0,0:05:22.09,0:05:24.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, makanan yang pria suka\Nitu nikujaga, kan?
Dialogue: 0,0:05:24.97,0:05:28.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, kenapa jadi begini?
Dialogue: 0,0:05:28.18,0:05:29.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu...
Dialogue: 0,0:05:30.46,0:05:32.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, lupakan saja.
Dialogue: 0,0:05:33.15,0:05:37.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rokudo-sensei, dari mana kamu\Ntahu banyak soal percintaan?
Dialogue: 0,0:05:39.50,0:05:44.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, dari artefak Kitab Kebenaran\Nyang kutemukan di Amerika Selatan.
Dialogue: 0,0:05:44.24,0:05:45.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bohong, kan?
Dialogue: 0,0:05:46.37,0:05:47.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:05:47.70,0:05:49.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa melakukan hal seperti itu?
Dialogue: 0,0:05:49.41,0:05:51.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya seru!
Dialogue: 0,0:05:51.31,0:05:53.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini sosok asli orang bijak!
Dialogue: 0,0:05:54.82,0:05:56.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Ryusei.
Dialogue: 0,0:05:56.34,0:05:58.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau kuberi seribu pukulan?
Dialogue: 0,0:05:58.55,0:06:00.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini siapa yang mengajarimu?
Dialogue: 0,0:06:00.67,0:06:02.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu nasihat dari Minto.
Dialogue: 0,0:06:02.51,0:06:05.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memang penyihir hebat.\NTahu banyak hal.
Dialogue: 0,0:06:06.96,0:06:10.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia malah kelihatan sudah di tingkat\Npenyihir jahat yang ada di dongeng.
Dialogue: 0,0:06:10.10,0:06:12.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku juga ada hal\Nyang ingin kulakukan bersamamu.
Dialogue: 0,0:06:12.53,0:06:13.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh? Apa?
Dialogue: 0,0:06:13.81,0:06:16.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selektiflah dalam memilih teman.
Dialogue: 0,0:06:20.74,0:06:22.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ryusei, lihat ini!
Dialogue: 0,0:06:23.52,0:06:24.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}MooTube?
Dialogue: 0,0:06:24.86,0:06:28.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kanal soal barang-barang gelap\Nyang diajarkan Minto padaku.
Dialogue: 0,0:06:28.91,0:06:32.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo semuanya! Hari ini kami kembali\Nmemperkenalkan barang-barang terkutuk langka!
Dialogue: 0,0:06:32.45,0:06:35.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang di Kanal Pandra!
Dialogue: 0,0:06:35.12,0:06:37.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benda terkutuk hari ini adalah ini!
Dialogue: 0,0:06:37.07,0:06:39.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang suci Rosenritter!
Dialogue: 0,0:06:39.90,0:06:41.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:06:41.34,0:06:45.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang ini adalah pedang suci asli\Nyang dibuat di dunia lain,
Dialogue: 0,0:06:45.07,0:06:50.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan rumornya tingkatnya setara\Ndengan barang kelas tertinggi +4!
Dialogue: 0,0:06:50.18,0:06:53.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konon, sebanyak 44 pedang dibuat
Dialogue: 0,0:06:53.60,0:06:56.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di sebuah negeri di dunia lain\Nuntuk melawan bangsa iblis.
Dialogue: 0,0:06:56.90,0:06:59.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, Pandra.\NSekarang sesi pertanyaan.
Dialogue: 0,0:06:59.55,0:07:00.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jreng.
Dialogue: 0,0:07:00.53,0:07:03.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua Rosenritter memiliki nama panggilan,
Dialogue: 0,0:07:03.39,0:07:06.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan semuanya diperjualbelikan\Ndengan harga sangat tinggi.
Dialogue: 0,0:07:06.00,0:07:06.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:07:06.61,0:07:09.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, berapa harga Rosenritter Messiah ini
Dialogue: 0,0:07:09.72,0:07:12.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di lelang gelap?
Dialogue: 0,0:07:12.95,0:07:17.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tingkatnya +4,\Nmungkin sekitar 80 juta yen?
Dialogue: 0,0:07:17.17,0:07:18.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu miliar yen.
Dialogue: 0,0:07:18.79,0:07:20.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu miliar yen?
Dialogue: 0,0:07:20.25,0:07:22.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu miliar yen...
Dialogue: 0,0:07:24.72,0:07:26.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru dengar harganya sebegitu...
Dialogue: 0,0:07:26.61,0:07:28.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kejutan.
Dialogue: 0,0:07:28.42,0:07:33.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas saja hari ini banyak orang baru...
Dialogue: 0,0:07:33.22,0:07:34.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka siapa?
Dialogue: 0,0:07:34.66,0:07:37.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka petugas keamanan khusus\Ndari perusahaan militer swasta.
Dialogue: 0,0:07:37.69,0:07:38.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia?
Dialogue: 0,0:07:38.66,0:07:40.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia petinggi perusahaan asuransi.
Dialogue: 0,0:07:41.58,0:07:43.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu miliar yen...
Dialogue: 0,0:07:46.27,0:07:48.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu miliar yen...
Dialogue: 0,0:07:48.16,0:07:50.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia orang kaya, kan?\NJangan panik.
Dialogue: 0,0:07:50.83,0:07:52.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan itu masalahnya!
Dialogue: 0,0:07:53.41,0:07:55.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ke sekolah sambil bawa cincin
Dialogue: 0,0:07:55.12,0:07:57.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berisi pedang seharga satu miliar yen!
Dialogue: 0,0:07:57.78,0:07:59.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih sulit untuk percaya!
Dialogue: 0,0:07:59.88,0:08:03.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pedang yang sama dengan\Nyang biasa kamu gunakan.
Dialogue: 0,0:08:03.07,0:08:04.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terlalu dipikirkan.
Dialogue: 0,0:08:04.34,0:08:06.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, pedang itu
Dialogue: 0,0:08:06.38,0:08:09.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kutemukan saat misi\Nmerebut kembali Kastel Runeberg.
Dialogue: 0,0:08:09.71,0:08:13.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi tak enak karena kesannya\Nmencuri perlengkapan seorang kesatria suci.
Dialogue: 0,0:08:13.31,0:08:14.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:08:14.94,0:08:18.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mengalahkan Raja Iblis dengan pedang itu,\Nmereka juga pasti akan senang.
Dialogue: 0,0:08:19.65,0:08:22.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama julukan pedang itu Rosenritter Stella.
Dialogue: 0,0:08:23.49,0:08:26.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang itu dinamai karena kilaunya\Nseperti bintang.
Dialogue: 0,0:08:28.08,0:08:31.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang ini seolah diciptakan untukmu,\Nsang Pahlawan yang mulia.
Dialogue: 0,0:08:33.33,0:08:35.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin kamu yang menggunakannya.
Dialogue: 0,0:08:35.49,0:08:37.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya...
Dialogue: 0,0:08:37.82,0:08:41.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi-lagi kamu bicara\Ndengan ekspresi serius seperti itu.
Dialogue: 0,0:08:41.21,0:08:44.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, cincin tunangan ini\Nbebannya terlalu berat.
Dialogue: 0,0:08:44.43,0:08:45.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu.
Dialogue: 0,0:08:45.42,0:08:47.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunangan?
Dialogue: 0,0:08:47.05,0:08:49.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat, kalian berdua!
Dialogue: 0,0:08:49.02,0:08:51.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang mohon bantuannya, Meteor-neesan!
Dialogue: 0,0:08:51.76,0:08:53.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, kamu salah paham!
Dialogue: 0,0:08:53.55,0:08:56.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apanya yang salah paham?
Dialogue: 0,0:08:57.73,0:08:59.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya...
Dialogue: 0,0:08:59.46,0:09:01.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sensei memberiku cincin\Nseharga satu miliar yen...
Dialogue: 0,0:09:01.68,0:09:04.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian ini kopel bodoh yang selalu melucu.
Dialogue: 0,0:09:04.08,0:09:06.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya dengan satu miliar yen?
Dialogue: 0,0:09:06.19,0:09:09.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih belum bisa mencerna\Nsemua ini dengan benar...
Dialogue: 0,0:09:09.09,0:09:12.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan, aku juga.\NMeski gagal paham.
Dialogue: 0,0:09:14.16,0:09:17.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, aku wanita seharga satu miliar yen!
Dialogue: 0,0:09:17.01,0:09:19.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang ini bicara apa?
Dialogue: 0,0:09:19.29,0:09:22.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makan malam hari ini,\Naku cuma buat untukku dan kakakku...
Dialogue: 0,0:09:22.86,0:09:25.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia malah langsung ganti topik...
Dialogue: 0,0:09:25.71,0:09:27.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, sudah jam sebegini, ya.
Dialogue: 0,0:09:27.76,0:09:30.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah! Hari ini serahkan semuanya padaku!
Dialogue: 0,0:09:30.90,0:09:34.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kusiapkan makanan yang pantas\Nuntuk wanita seharga satu miliar yen!
Dialogue: 0,0:09:34.09,0:09:37.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat! Meteor-neesan,\Nternyata kamu bisa masak?
Dialogue: 0,0:09:37.70,0:09:39.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Firasatku mulai tak enak...
Dialogue: 0,0:09:39.81,0:09:42.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, semuanya!
Dialogue: 0,0:09:42.35,0:09:45.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau betulan wanita satu miliar yen,\Npasti bisa membedakannya!
Dialogue: 0,0:09:45.02,0:09:48.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tes Kelayakan Pahlawan!
Dialogue: 0,0:09:48.61,0:09:52.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang satu ini steik sapi Yonezawa kelas terbaik!
Dialogue: 0,0:09:52.07,0:09:55.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang satu lagi steik daging asal Meksiko.
Dialogue: 0,0:09:55.32,0:09:57.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia meniru acara TV!
Dialogue: 0,0:09:57.28,0:10:00.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanita yang diberi cincin\Nseharga satu miliar yen...
Dialogue: 0,0:10:00.48,0:10:03.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, dia pahlawan kelas satu, kan?
Dialogue: 0,0:10:03.71,0:10:06.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak paham kamu bicara apa.
Dialogue: 0,0:10:07.39,0:10:10.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, ya,\Nbiar aku yang panggang dagingnya.
Dialogue: 0,0:10:10.03,0:10:11.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:10:11.06,0:10:12.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah kamu yang panggang?
Dialogue: 0,0:10:12.84,0:10:15.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat! Cepat!
Dialogue: 0,0:10:15.97,0:10:17.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dia sangat imut!
Dialogue: 0,0:10:18.30,0:10:19.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selesai.
Dialogue: 0,0:10:19.33,0:10:20.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asyik!
Dialogue: 0,0:10:20.22,0:10:21.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:10:21.33,0:10:22.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita mulai.
Dialogue: 0,0:10:22.43,0:10:24.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:10:29.36,0:10:31.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat! Ini permainan macam apa?
Dialogue: 0,0:10:31.54,0:10:33.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dipikirkan berarti kamu kalah!
Dialogue: 0,0:10:33.23,0:10:35.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya seperti sedang melakukan hal buruk.
Dialogue: 0,0:10:35.39,0:10:37.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sadarlah! Jangan terus melihatnya!
Dialogue: 0,0:10:37.70,0:10:39.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawabannya B.
Dialogue: 0,0:10:39.04,0:10:40.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu jawabannya juga benar!
Dialogue: 0,0:10:40.91,0:10:45.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia ini kenapa? Ini terlalu berat untukku.
Dialogue: 0,0:10:45.38,0:10:47.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar minta maaf.
Dialogue: 0,0:10:47.12,0:10:49.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena ada orang seperti ini,\Nkamu berubah drastis, ya.
Dialogue: 0,0:10:49.98,0:10:51.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu salah paham.
Dialogue: 0,0:10:51.51,0:10:53.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, giliran Moe-chan.
Dialogue: 0,0:10:53.72,0:10:57.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?\NKalau itu tidak mungkin...
Dialogue: 0,0:10:57.43,0:10:59.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, pejamkan matamu.
Dialogue: 0,0:10:59.64,0:11:01.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa! Tidak bisa!
Dialogue: 0,0:11:01.52,0:11:03.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, buka mulutmu.
Dialogue: 0,0:11:11.30,0:11:12.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:11:12.36,0:11:14.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa!
Dialogue: 0,0:11:14.57,0:11:17.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Moe!
Dialogue: 0,0:11:23.25,0:11:25.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang memikirkan sesuatu?
Dialogue: 0,0:11:25.38,0:11:26.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:11:26.86,0:11:30.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal benda-benda dari dunia lain\Nyang beredar di dunia ini.
Dialogue: 0,0:11:30.21,0:11:34.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang suci itu bukan benda\Nyang kebetulan bisa tersesat ke dunia ini.
Dialogue: 0,0:11:35.23,0:11:37.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti ada hal janggal yang terjadi.
Dialogue: 0,0:11:37.87,0:11:41.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Multisemesta...\NMasalah ini terlalu banyak.
Dialogue: 0,0:11:41.60,0:11:43.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin ada hal besar
Dialogue: 0,0:11:43.39,0:11:46.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang menyebabkan dimensi ini\Nmenjadi bengkok.
Dialogue: 0,0:11:46.66,0:11:48.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti...
Dialogue: 0,0:11:48.40,0:11:51.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyebabnya karena reinkarnasi kita?
Dialogue: 0,0:11:51.86,0:11:54.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ki-Kita harus tanggung jawab...
Dialogue: 0,0:11:54.38,0:11:56.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus tanggung jawab, ya?
Dialogue: 0,0:11:56.69,0:11:57.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berat sekali.
Dialogue: 0,0:11:59.32,0:12:01.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanggung jawab?
Dialogue: 0,0:12:10.90,0:12:13.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sensei, terima kasih untuk hari ini.
Dialogue: 0,0:12:13.68,0:12:14.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan masalah.
Dialogue: 0,0:12:14.93,0:12:17.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tertarik dengan sihir kalian.
Dialogue: 0,0:12:17.72,0:12:22.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini, aku Narukami Ryusei,\Nakan mengajarkan kalian sihir.
Dialogue: 0,0:12:22.86,0:12:25.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak tahu apakah\Npengetahuanku akan berguna,
Dialogue: 0,0:12:25.49,0:12:27.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku ingin membantu kalian\Nsebisa mungkin.
Dialogue: 0,0:12:27.94,0:12:29.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:12:29.12,0:12:30.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:12:30.40,0:12:32.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, kita mulai dengan lari jarak jauh!
Dialogue: 0,0:12:32.90,0:12:34.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam, kepala otot!
Dialogue: 0,0:12:34.37,0:12:35.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu ke sini?
Dialogue: 0,0:12:35.47,0:12:36.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih.
Dialogue: 0,0:12:37.14,0:12:40.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, untuk awalan,\Ntunjukkan sihir andalan kalian.
Dialogue: 0,0:12:40.36,0:12:42.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pui pui pun!
Dialogue: 0,0:12:42.37,0:12:44.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fireball!
Dialogue: 0,0:12:44.08,0:12:46.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai petir, empaskanlah!
Dialogue: 0,0:12:46.04,0:12:48.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lightning Bolt!
Dialogue: 0,0:12:52.69,0:12:55.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir kuno yang dimodernisasi, ya?
Dialogue: 0,0:12:55.31,0:12:59.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuraishi Mana memiliki kekuatan sihir yang besar\Ntapi sulit mengendalikannya.
Dialogue: 0,0:12:59.03,0:13:02.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedangkan sihir apinya Takigawa Minto lemah\Nkarena asal-asalan saat merapalnya.
Dialogue: 0,0:13:02.55,0:13:04.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang ingin kutanyakan.
Dialogue: 0,0:13:04.51,0:13:05.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:13:05.63,0:13:09.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat menggunakan sihir,\Napa yang sering kamu perhatikan?
Dialogue: 0,0:13:09.64,0:13:11.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rapalan dan gerakan.
Dialogue: 0,0:13:11.55,0:13:13.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu fokus.
Dialogue: 0,0:13:13.22,0:13:14.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gerakan?
Dialogue: 0,0:13:14.50,0:13:18.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gerakan tubuh untuk meningkatkan\Nkekuatan sihir saat digunakan.
Dialogue: 0,0:13:18.74,0:13:21.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menggunakan tongkat sihir\Njuga ada tekniknya, kan?
Dialogue: 0,0:13:21.07,0:13:22.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai angin, menarilah.
Dialogue: 0,0:13:23.47,0:13:25.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku merapal ini tanpa tongkat.
Dialogue: 0,0:13:26.10,0:13:28.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sudah menguasainya,\Nkekuatannya akan besar.
Dialogue: 0,0:13:28.39,0:13:31.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi di dunia ini,\Nsepertinya tongkat sihir sudah lebih maju.
Dialogue: 0,0:13:31.50,0:13:35.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bereinkarnasi dari dunia lain,\Nkukira kamu akan bilang
Dialogue: 0,0:13:35.68,0:13:36.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dunia ini ketinggalan zaman.
Dialogue: 0,0:13:36.91,0:13:39.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan berprasangka buruk\Npada orang yang bereinkarnasi!
Dialogue: 0,0:13:39.55,0:13:41.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu fokus.
Dialogue: 0,0:13:41.52,0:13:46.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini berguna agar sihir tetap bisa\Ndilepaskan meski ada gangguan.
Dialogue: 0,0:13:46.05,0:13:48.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuan untuk mengaktifkan sihir...
Dialogue: 0,0:13:48.31,0:13:49.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Kucingnya di mana?
Dialogue: 0,0:13:49.94,0:13:51.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu fokusmu ke mana?
Dialogue: 0,0:13:54.23,0:13:57.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk Takigawa,\Nkamu harus latihan merapal singkat.
Dialogue: 0,0:13:57.49,0:13:59.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merapal singkat?
Dialogue: 0,0:13:59.25,0:14:01.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku itu soal rapalanmu yang asal-asalan.
Dialogue: 0,0:14:01.42,0:14:02.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:14:02.45,0:14:06.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rapalan bisa disingkat,\Nbahkan tanpa rapalan pun sebenarnya bisa.
Dialogue: 0,0:14:06.32,0:14:09.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi efeknya serangan sihirnya bisa lemah\Natau risiko gagalnya tinggi.
Dialogue: 0,0:14:10.52,0:14:12.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kecepatan merapal bisa jadi keuntungan.
Dialogue: 0,0:14:12.96,0:14:14.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Popopopom.
Dialogue: 0,0:14:15.19,0:14:18.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang, coba merapal\Ndengan ritme seperti ini.
Dialogue: 0,0:14:21.55,0:14:23.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pupui, pupupui!
Dialogue: 0,0:14:26.24,0:14:28.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Instingmu bagus, ya.
Dialogue: 0,0:14:28.10,0:14:30.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sudah terbiasa, kamu bisa\Nmenemukan gaya bertarungmu sendiri.
Dialogue: 0,0:14:31.50,0:14:34.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gaya bertarungku sendiri, ya?
Dialogue: 0,0:14:34.48,0:14:37.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi penyihir akan langsung tumbang
Dialogue: 0,0:14:37.02,0:14:39.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau dipukul rahangnya atau ulu hatinya.
Dialogue: 0,0:14:39.41,0:14:40.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepala otot, pulang sana!
Dialogue: 0,0:14:41.38,0:14:43.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuraishi, kekuatan sihirmu terlalu besar.
Dialogue: 0,0:14:43.28,0:14:45.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar! Kekuatan sihirku besar,
Dialogue: 0,0:14:45.66,0:14:47.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku belum bisa mengendalikannya!
Dialogue: 0,0:14:47.65,0:14:48.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak sedang memujimu!
Dialogue: 0,0:14:48.82,0:14:49.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:14:51.86,0:14:54.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya, aku tak cocok\Nbekerja sama dalam tim
Dialogue: 0,0:14:54.37,0:14:57.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tak pernah ikut dalam misi penting.
Dialogue: 0,0:14:58.85,0:15:02.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, aku disuruh belajar\Nuntuk mengendalikan kekuatan sihirku.
Dialogue: 0,0:15:02.18,0:15:05.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bilang aku juga harus\Nbisa berguna sebagai anggota OZ.
Dialogue: 0,0:15:07.06,0:15:09.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu keinginanmu yang sebenarnya?
Dialogue: 0,0:15:10.26,0:15:11.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya...
Dialogue: 0,0:15:11.89,0:15:15.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak peduli selama aku bisa melihat\Npara gadis yang saling bermesraan!
Dialogue: 0,0:15:15.84,0:15:18.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cinta dan damai.
Dialogue: 0,0:15:18.23,0:15:20.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga harus berlatih keras!
Dialogue: 0,0:15:20.37,0:15:22.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minto, temani aku latihan!
Dialogue: 0,0:15:22.23,0:15:24.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik! Rasakan ini!
Dialogue: 0,0:15:25.30,0:15:26.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Strike!
Dialogue: 0,0:15:26.91,0:15:29.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, tadi itu betulan bola sihir!
Dialogue: 0,0:15:29.37,0:15:31.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya Fire Strike!
Dialogue: 0,0:15:31.62,0:15:33.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keren!\NMinto, kamu keren!
Dialogue: 0,0:15:33.58,0:15:34.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, lumayan.
Dialogue: 0,0:15:34.80,0:15:36.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Latihan yang serius!
Dialogue: 0,0:15:42.32,0:15:45.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kami meminjam tempat latihan OZ,
Dialogue: 0,0:15:45.04,0:15:47.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}banyak penyihir yang mengawasi kami.
Dialogue: 0,0:15:47.92,0:15:50.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena ini teknik dari dunia lain.
Dialogue: 0,0:15:50.19,0:15:52.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar kalau mereka tertarik.
Dialogue: 0,0:15:54.80,0:15:57.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi mereka yang bereinkarnasi itu, ya.
Dialogue: 0,0:15:57.26,0:15:58.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:15:58.74,0:16:00.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabarnya mereka Raja Iblis dan sang Pahlawan.
Dialogue: 0,0:16:01.57,0:16:03.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepalaku jadi sakit.
Dialogue: 0,0:16:03.47,0:16:05.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:16:06.00,0:16:09.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sepertinya mereka bisa akur\Ndengan Minto dan Kuraishi.
Dialogue: 0,0:16:09.41,0:16:10.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan ini!
Dialogue: 0,0:16:13.58,0:16:14.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!
Dialogue: 0,0:16:14.72,0:16:15.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lari, Bokong Persik!
Dialogue: 0,0:16:15.98,0:16:17.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:16:17.29,0:16:19.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Latihan yang serius.
Dialogue: 0,0:16:23.66,0:16:28.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menerima tugas melatih ini\Nkarena aku sendiri pun perlu.
Dialogue: 0,0:16:29.95,0:16:32.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau hanya melawan monster itu\Ntak akan sulit.
Dialogue: 0,0:16:32.59,0:16:36.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sekarang banyak pintu antardimensi\Nyang bermunculan,
Dialogue: 0,0:16:36.31,0:16:41.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kemungkinan sosok seperti Returner\Natau Gadis Penyihir muncul itu besar.
Dialogue: 0,0:16:51.25,0:16:53.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku bisa mengalahkan mereka\Ndengan kekuatanku sekarang?
Dialogue: 0,0:16:55.46,0:17:00.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuan sihir Raja Iblis yang tak masuk akal\Nberasal dari modifikasi sihir manusia.
Dialogue: 0,0:17:00.51,0:17:02.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuh tulangnya menggunakan sihir\Nuntuk getaran suara,
Dialogue: 0,0:17:02.88,0:17:05.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menggantikan fungsi pita suara.
Dialogue: 0,0:17:05.70,0:17:09.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, dia juga menambahkan\Norgan sihir serupa di tangannya,
Dialogue: 0,0:17:09.90,0:17:12.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar bisa merapalkan beberapa sihir sekaligus.
Dialogue: 0,0:17:13.73,0:17:14.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti...
Dialogue: 0,0:17:15.20,0:17:18.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku membuat organ\Nyang menghasilkan suara di tanganku juga...
Dialogue: 0,0:17:24.85,0:17:26.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan, Ryusei.
Dialogue: 0,0:17:26.80,0:17:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu akan membuatmu\Nmelampaui batas manusia lagi.
Dialogue: 0,0:17:29.70,0:17:31.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meteor...
Dialogue: 0,0:17:31.66,0:17:34.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah bereinkarnasi.
Dialogue: 0,0:17:34.08,0:17:37.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau kamu kembali menjadi Raja Iblis.
Dialogue: 0,0:17:40.29,0:17:42.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka malah kamu yang menasihatiku.
Dialogue: 0,0:17:44.74,0:17:46.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku, Meteor.
Dialogue: 0,0:17:49.63,0:17:51.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Janji, ya.
Dialogue: 0,0:17:52.13,0:17:54.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tiba-tiba jadi drama cinta?
Dialogue: 0,0:17:54.58,0:17:56.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah mirip sketsa komedi Tokyo 03.
Dialogue: 0,0:17:59.14,0:18:03.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi mereka orang baru\Nyang dibawa duo pecundang itu.
Dialogue: 0,0:18:03.02,0:18:04.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita, para elite OZ,
Dialogue: 0,0:18:04.84,0:18:06.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memberi mereka sedikit pelajaran?
Dialogue: 0,0:18:07.31,0:18:08.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita hajar mereka.
Dialogue: 0,0:18:08.98,0:18:11.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka pasti cuma orang-orang kelas bawah.
Dialogue: 0,0:18:11.95,0:18:14.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggap saja ini cuma insiden tak disengaja.
Dialogue: 0,0:18:19.12,0:18:22.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai api, jadilah bola!
Dialogue: 0,0:18:22.04,0:18:23.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fireball!
Dialogue: 0,0:18:28.50,0:18:29.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lemah.
Dialogue: 0,0:18:29.71,0:18:31.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembatalan?
Dialogue: 0,0:18:31.60,0:18:36.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir balasan yang menganalisis\Ndan menetralkan sihir lawan secara instan?
Dialogue: 0,0:18:37.12,0:18:41.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknik tingkat tertinggi yang hanya bisa\Ndilakukan penyihir kelas master.
Dialogue: 0,0:18:41.87,0:18:44.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan sekarang pun\Ndia masih pantas dijuluki Raja Iblis.
Dialogue: 0,0:18:46.58,0:18:49.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bengong!\NSekarang kita serang berdua!
Dialogue: 0,0:18:49.36,0:18:50.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya!
Dialogue: 0,0:18:50.57,0:18:51.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka!\NHarus kita hentikan!
Dialogue: 0,0:18:51.89,0:18:52.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tunggu.
Dialogue: 0,0:18:52.88,0:18:54.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:18:54.53,0:18:56.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu tidak penasaran?
Dialogue: 0,0:18:56.70,0:18:59.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan sihir dari orang\Nyang bereinkarnasi itu?
Dialogue: 0,0:18:59.41,0:19:01.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai api, jadilah bola!
Dialogue: 0,0:19:01.26,0:19:05.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai api, jadilah bola dan musnahkan musuh!
Dialogue: 0,0:19:13.80,0:19:15.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matilah!
Dialogue: 0,0:19:22.87,0:19:24.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:19:24.06,0:19:26.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sebenarnya siapa?
Dialogue: 0,0:19:26.10,0:19:27.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Se-Sekali lagi!
Dialogue: 0,0:19:28.53,0:19:30.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Death Stingers.
Dialogue: 0,0:19:38.57,0:19:41.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir macam apa ini?
Dialogue: 0,0:19:41.76,0:19:45.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah melihat sihir\Nyang mengerikan seperti ini!
Dialogue: 0,0:19:46.11,0:19:49.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat kalian bagus,\Ntapi kemampuan kalian masih kurang.
Dialogue: 0,0:19:49.38,0:19:50.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seram.
Dialogue: 0,0:19:54.01,0:19:55.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bind!
Dialogue: 0,0:19:55.22,0:19:56.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lumpuh!
Dialogue: 0,0:19:59.34,0:20:01.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!\NAku tak terima kalah dari kalian!
Dialogue: 0,0:20:01.33,0:20:03.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lepaskan!
Dialogue: 0,0:20:03.81,0:20:07.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah menyerang tamu.\NKalian ini benar-benar sampah.
Dialogue: 0,0:20:07.15,0:20:10.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan melaporkan ini pada atasan!
Dialogue: 0,0:20:12.18,0:20:13.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian beruntung masih selamat.
Dialogue: 0,0:20:13.98,0:20:18.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kalian membuat gadis itu marah,\Nrahang kalian pasti sudah remuk.
Dialogue: 0,0:20:19.90,0:20:22.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Se-Sebenarnya dia itu siapa?
Dialogue: 0,0:20:22.66,0:20:25.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia itu wanita milik Raja Iblis.
Dialogue: 0,0:20:25.02,0:20:26.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanita milik Raja Iblis?
Dialogue: 0,0:20:26.54,0:20:28.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan beri aku julukan aneh!
Dialogue: 0,0:21:58.96,0:22:01.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, video kali ini sampai di sini!
Dialogue: 0,0:22:01.97,0:22:04.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa di video berikutnya!
Dialogue: 0,0:22:04.40,0:22:08.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lupa klik suka dan berlangganan, ya!
Dialogue: 0,0:22:11.22,0:22:13.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Capek...
Dialogue: 0,0:22:18.66,0:22:20.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus, Pandra.
Dialogue: 0,0:22:20.76,0:22:24.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius, siaran hari ini sangat tegang.
Dialogue: 0,0:22:24.86,0:22:28.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya dengan pedang suci\Nseharga satu miliar yen itu?
Dialogue: 0,0:22:28.33,0:22:32.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memperkenalkan barang-barang mahal itu\Nsudah jadi konten lumrah para MooTuber.
Dialogue: 0,0:22:32.03,0:22:35.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi harganya tak masuk akal\Nuntuk jadi bahan konten MooTuber!
Dialogue: 0,0:22:35.46,0:22:38.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, siapa yang mau beli pedang suci?
Dialogue: 0,0:22:38.46,0:22:40.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin sang Pahlawan akan membelinya?
Dialogue: 0,0:22:40.67,0:22:44.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sang Pahlawan membeli pedang suci\Nlegendaris seharga satu miliar yen?
Dialogue: 0,0:22:44.19,0:22:45.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesannya aneh.
Dialogue: 0,0:22:45.39,0:22:47.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti dia tinggal merampasnya ala pahlawan.
Dialogue: 0,0:22:47.63,0:22:49.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu malah lebih parah!
Dialogue: 0,0:22:51.06,0:22:55.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabarnya ada pahlawan sungguhan\Nyang bereinkarnasi ke era modern.
Dialogue: 0,0:22:55.68,0:22:56.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:22:56.77,0:22:57.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius.
Dialogue: 0,0:22:57.86,0:23:01.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pahlawan, ya.\NOrangnya seperti apa, ya.
Dialogue: 0,0:23:01.57,0:23:07.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konon pahlawan itu adalah pejuang\Nprofesional yang berani dan baik hati.
Dialogue: 0,0:23:07.28,0:23:09.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya juga pahlawan.
Dialogue: 0,0:23:09.74,0:23:13.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti sangat baik hati\Ndan punya otot seperti gorila.
Dialogue: 0,0:23:14.05,0:23:16.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, sang Pahlawan itu\Nsebenarnya gorila?
Dialogue: 0,0:23:16.86,0:23:20.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gorila, ya.\NKira-kira dia mau kolaborasi denganku?
Dialogue: 0,0:23:20.00,0:23:22.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kalau dengan gorila itu mustahil.
Dialogue: 0,0:23:22.29,0:23:24.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi dengan gorila
Dialogue: 0,0:23:24.00,0:23:25.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu mustahil, ya.
Dialogue: 0,0:23:27.10,0:23:30.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya, episode festival sekolah\Nyang wajib ada di setiap cerita sekolah!
Dialogue: 0,0:23:30.56,0:23:32.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?\NFestival Pembantaian?
Dialogue: 0,0:23:32.43,0:23:33.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Festival sekolah!
Dialogue: 0,0:23:33.56,0:23:34.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, maksudnya itu.
Dialogue: 0,0:23:35.26,0:23:37.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Festival Pembantaian\Njuga mungkin terjadi.
Dialogue: 0,0:23:37.15,0:23:38.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu.
Dialogue: 0,0:23:38.27,0:23:38.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya?
Dialogue: 0,0:23:38.94,0:23:40.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nantikan saja.
