Dialogue: 0,0:01:52.47,0:01:56.01,sign,,0000,0000,0000,,KESATRIA TENGKORAK BERKELANA DI DUNIA LAIN\NMUSIM KEDUA
Dialogue: 0,0:06:01.09,0:06:03.93,sign,,0000,0000,0000,,HATSUME NO TSUBONE
Dialogue: 0,0:06:07.05,0:06:10.18,sign,,0000,0000,0000,,MOCHIZUKI CHIYOME
Dialogue: 0,0:06:13.69,0:06:16.69,sign,,0000,0000,0000,,HATTORI HANZO, ISHIKAWA GOEMON
Dialogue: 0,0:06:27.87,0:06:31.50,sign,,0000,0000,0000,,KIRIGAKURE SAIZO, FUMA KOTARO
Dialogue: 0,0:06:36.83,0:06:38.84,sign,,0000,0000,0000,,SARUTOBI SASUKE
Dialogue: 0,0:06:50.47,0:06:52.48,sign,,0000,0000,0000,,DARI DUNIA LAIN
Dialogue: 0,0:10:35.45,0:10:36.95,sign,,0000,0000,0000,,ORANG JEPANG
Dialogue: 0,0:11:53.98,0:11:58.99,sign,,0000,0000,0000,,EPISODE 7:\NSEMANGAT PRIA YANG MEKAR DI DESA NINJA
Dialogue: 0,0:21:17.34,0:21:22.68,sign,,0000,0000,0000,,TAJIENT, KERAJAAN AGUNG VALVNACH
Dialogue: 0,0:23:39.94,0:23:44.94,sign,,0000,0000,0000,,SELANJUTNYA: DENGARLAH GEMURUH OMBAK,\NWAHAI DUKA HATI KUNOICHI
Dialogue: 0,0:23:44.94,0:23:51.45,sign,,0000,0000,0000,,#PONTASAATINIJUGASEDANGBERKELANA\NFESTIVAL MAKAN DAN MINUM YANG MERIAH
Dialogue: 0,0:00:00.94,0:00:03.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf mengganggu pembicaraan kalian.
Dialogue: 0,0:00:03.48,0:00:06.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa benar kamu Tuan Arc?
Dialogue: 0,0:00:08.24,0:00:10.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Tuan Goemon!
Dialogue: 0,0:00:10.57,0:00:11.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu... Siapa?
Dialogue: 0,0:00:13.59,0:00:15.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Telinga hewan itu...
Dialogue: 0,0:00:15.62,0:00:17.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu kaum dengan Nona Chiyome?
Dialogue: 0,0:00:17.68,0:00:21.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dilihat-lihat kedudukannya\Nseperti seorang tetua.
Dialogue: 0,0:00:21.27,0:00:23.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Dragon Lord.
Dialogue: 0,0:00:23.69,0:00:27.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami telah berhasil membangun\Ndesa baru kami.
Dialogue: 0,0:00:27.75,0:00:31.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mewakili semua klan\Nmengucapkan terima kasih banyak.
Dialogue: 0,0:00:31.89,0:00:34.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, tak perlu berterima kasih.
Dialogue: 0,0:00:35.22,0:00:38.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang bertemu denganmu, Tuan Arc.
Dialogue: 0,0:00:38.43,0:00:39.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat!
Dialogue: 0,0:00:39.60,0:00:42.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tengkorakku kelihatan banget!
Dialogue: 0,0:00:43.61,0:00:47.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Hanzo ke-22 yang memimpin Klan Jinshin.
Dialogue: 0,0:00:47.90,0:00:51.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah mengetahui\Nwujud Tuan Arc dari Chiyome.
Dialogue: 0,0:00:51.32,0:00:52.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:00:52.87,0:00:56.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terpaksa mengatakannya\Nuntuk jelaskan situasinya.
Dialogue: 0,0:00:56.58,0:00:59.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, justru terima kasih, Nona Chiyome.
Dialogue: 0,0:00:59.83,0:01:02.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tak jumpa, wahai sobat.
Dialogue: 0,0:01:02.58,0:01:03.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Goemon.
Dialogue: 0,0:01:07.05,0:01:09.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Arc, Nona Ariane,
Dialogue: 0,0:01:09.63,0:01:13.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku dengar kalian telah banyak membantu.
Dialogue: 0,0:01:13.47,0:01:16.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mewakili Klan Jinshin,\Naku ucapkan terima kasih banyak.
Dialogue: 0,0:01:16.85,0:01:20.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kami pun sudah banyak\Ndibantu Nona Chiyome.
Dialogue: 0,0:01:21.56,0:01:25.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami hanya saling membantu\Nsebagai seorang teman.
Dialogue: 0,0:01:25.84,0:01:30.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan mengadakan festival untuk merayakan\Nberdirinya desa baru di tanah ini.
Dialogue: 0,0:01:30.86,0:01:35.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai tanda terima kasih,\Nkami ingin mengundang kalian, bagaimana?
Dialogue: 0,0:01:35.39,0:01:37.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Itu artinya...
Dialogue: 0,0:01:37.24,0:01:39.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini jadi desa ninja!
Dialogue: 0,0:02:16.03,0:02:18.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iga, Koga, Fuma.
Dialogue: 0,0:02:18.25,0:02:19.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada ninja fiktifnya juga!
Dialogue: 0,0:02:19.66,0:02:23.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau pakai nama-nama itu,\Nberarti dia orang Jepang!
Dialogue: 0,0:02:23.08,0:02:24.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:02:24.12,0:02:26.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sarutobi Sasuke!
Dialogue: 0,0:03:10.80,0:03:13.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, aku Arc!
Dialogue: 0,0:03:13.01,0:03:15.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya aku tiba di desa ninja!
Dialogue: 0,0:03:15.43,0:03:17.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini benar-benar membuatku bersemangat!
Dialogue: 0,0:03:35.03,0:03:38.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa,\Nsatu bulan sudah jadi seperti ini.
Dialogue: 0,0:03:38.03,0:03:39.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini karena semua orang bekerja keras.
Dialogue: 0,0:03:55.72,0:03:59.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desa elf fantasinya sangat terasa,
Dialogue: 0,0:03:59.75,0:04:02.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ini entah kenapa biasa saja.
Dialogue: 0,0:04:02.10,0:04:04.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berangkat!
Dialogue: 0,0:04:07.19,0:04:09.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru dibilang langsung ada hal hebat!
Dialogue: 0,0:04:09.92,0:04:12.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata benar-benar desa ninja!
Dialogue: 0,0:04:13.36,0:04:15.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ada layang-layang.\N- Layang-layang?
Dialogue: 0,0:04:15.07,0:04:17.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya ada yang sedang bermain.
Dialogue: 0,0:04:17.20,0:04:18.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu waktu kecil aku juga sering.
Dialogue: 0,0:04:18.99,0:04:22.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Chiyome, selamat datang kembali!
Dialogue: 0,0:04:22.45,0:04:24.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bisa dinaiki?
Dialogue: 0,0:04:24.75,0:04:28.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu barang yang diwariskan\Nturun-temurun sejak Hanzo pertama.
Dialogue: 0,0:04:28.79,0:04:31.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dengar awalnya itu alat permainan.
Dialogue: 0,0:04:32.59,0:04:34.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan itu...
Dialogue: 0,0:04:34.09,0:04:35.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Chiyome!
Dialogue: 0,0:04:35.21,0:04:38.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tamu sekalian, selamat datang di desa kami.
Dialogue: 0,0:04:38.47,0:04:40.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh! Sudah kuduga!
Dialogue: 0,0:04:40.21,0:04:41.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar ninja!
Dialogue: 0,0:04:41.55,0:04:42.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Persis yang kubayangkan.
Dialogue: 0,0:04:42.97,0:04:46.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, layang-layang dan semacamnya\Nitu cuma di manga.
Dialogue: 0,0:04:46.27,0:04:49.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga pernah baca kalau pakaian\Nserbahitam itu sebenarnya tidak ada.
Dialogue: 0,0:04:50.77,0:04:53.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang Tuan Arc bicarakan?
Dialogue: 0,0:04:53.23,0:04:55.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abaikan saja, kadang memang suka begini.
Dialogue: 0,0:05:02.37,0:05:04.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mereka anak-anak dari Klan Jinshin?
Dialogue: 0,0:05:04.53,0:05:06.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak semuanya.
Dialogue: 0,0:05:06.95,0:05:11.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di antaranya ada yang dikejar kaum manusia\Ndan kehilangan tempat tinggal.
Dialogue: 0,0:05:11.24,0:05:12.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sama.
Dialogue: 0,0:05:12.71,0:05:14.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Chiyome juga?
Dialogue: 0,0:05:14.79,0:05:15.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:05:16.21,0:05:19.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kampung halamanku diserang kaum manusia.
Dialogue: 0,0:05:20.22,0:05:21.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti itu, ya.
Dialogue: 0,0:05:25.64,0:05:29.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian Tuan Kesatria dan pejuang wanita elf\Nyang dirumorkan itu?
Dialogue: 0,0:05:29.68,0:05:31.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa?
Dialogue: 0,0:05:31.21,0:05:33.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah satu Enam Ninja, namanya Tsubone.
Dialogue: 0,0:05:34.02,0:05:36.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal, aku Tsubone.
Dialogue: 0,0:05:38.23,0:05:42.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enam Ninja itu orang-orang tingkat tinggi\Ndi antara Klan Jinshin, kan?
Dialogue: 0,0:05:42.95,0:05:44.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:05:44.05,0:05:45.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya orang-orang terpilih
Dialogue: 0,0:05:45.70,0:05:50.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang dapat mewarisi nama khusus\Npemberian Hanzo pertama.
Dialogue: 0,0:05:50.00,0:05:53.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti Dik Chiyome juga punya nama asli?
Dialogue: 0,0:05:53.37,0:05:55.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, namaku Mia.
Dialogue: 0,0:05:55.54,0:05:57.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tsubone... Tsubone...
Dialogue: 0,0:05:57.84,0:06:00.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh! Hatsume no Tsubone!
Dialogue: 0,0:06:01.09,0:06:02.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hatsume no Tsubone adalah
Dialogue: 0,0:06:02.34,0:06:03.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selir dari Ishida Mitsunari,
Dialogue: 0,0:06:03.93,0:06:06.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sebenarnya dia itu\Npembunuh yang dikirim Ieyasu.
Dialogue: 0,0:06:07.05,0:06:08.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mochizuki Chiyome adalah
Dialogue: 0,0:06:08.47,0:06:10.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pemimpin para Miko Pengelana,
Dialogue: 0,0:06:10.18,0:06:13.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sebenarnya adalah mata-mata\Nwanita dari Takeda Shingen.
Dialogue: 0,0:06:13.69,0:06:16.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hattori Hanzo dan Ishikawa Goemon!
Dialogue: 0,0:06:17.36,0:06:18.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu artinya...
Dialogue: 0,0:06:18.98,0:06:20.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Chiyome,
Dialogue: 0,0:06:20.07,0:06:23.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enam Ninja itu berarti masih\Nada tiga lainnya, kan?
Dialogue: 0,0:06:23.07,0:06:24.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, benar.
Dialogue: 0,0:06:24.59,0:06:26.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa nama-namanya?
Dialogue: 0,0:06:26.15,0:06:27.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saizo dan Kotaro.
Dialogue: 0,0:06:27.87,0:06:31.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kirigakure Saizo dan Fuma Kotaro!
Dialogue: 0,0:06:31.50,0:06:32.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus?
Dialogue: 0,0:06:34.21,0:06:35.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sasuke.
Dialogue: 0,0:06:35.33,0:06:36.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:06:36.83,0:06:38.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sarutobi Sasuke!
Dialogue: 0,0:06:38.84,0:06:40.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iga, Koga, Fuma.
Dialogue: 0,0:06:40.76,0:06:42.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada ninja fiktifnya juga!
Dialogue: 0,0:06:42.34,0:06:45.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau pakai nama-nama itu,\Nberarti dia orang Jepang!
Dialogue: 0,0:06:45.22,0:06:47.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau orang asing yang suka ninja?
Dialogue: 0,0:06:47.76,0:06:50.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun, Hanzo generasi pertama itu...
Dialogue: 0,0:06:52.48,0:06:53.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Arc?
Dialogue: 0,0:06:53.77,0:06:55.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abaikan saja.
Dialogue: 0,0:06:55.40,0:06:57.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Nona Tsubone,
Dialogue: 0,0:06:57.02,0:06:58.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rumor tentang kami maksudnya apa?
Dialogue: 0,0:06:58.61,0:07:01.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kalian pernah membaca ini?
Dialogue: 0,0:07:01.98,0:07:03.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seorang pejuang wanita elf
Dialogue: 0,0:07:03.69,0:07:06.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tak sengaja bertemu kesatria dari manusia\Ndan mengalahkan raja iblis.
Dialogue: 0,0:07:06.81,0:07:08.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Tak sengaja"?
Dialogue: 0,0:07:08.12,0:07:11.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka yang sama-sama diperintah\Nuntuk mengalahkan raja iblis,
Dialogue: 0,0:07:11.99,0:07:15.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}awalnya saingan,\Nlambat laun mulai saling tertarik.
Dialogue: 0,0:07:15.25,0:07:19.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cinta terlarang yang tak direstui\Nkaum elf dan manusia.
Dialogue: 0,0:07:19.09,0:07:22.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kami tidak seperti itu.
Dialogue: 0,0:07:22.25,0:07:26.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya, pejuang wanita itu bersikap dingin.
Dialogue: 0,0:07:26.76,0:07:29.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, di bab tiga...
Dialogue: 0,0:07:30.01,0:07:34.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sang kesatria merawat pejuang wanita\Nyang menderita akibat racun musuh.
Dialogue: 0,0:07:35.52,0:07:38.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah sadar, pejuang wanita tersebut
Dialogue: 0,0:07:38.17,0:07:40.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berterima kasih pada sang kesatria.
Dialogue: 0,0:07:40.61,0:07:43.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, di malam itu... mereka berdua...
Dialogue: 0,0:07:48.36,0:07:50.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah banget!
Dialogue: 0,0:07:50.03,0:07:51.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan membayangkan yang bukan-bukan!
Dialogue: 0,0:07:51.74,0:07:53.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, Arc itu tengko—
Dialogue: 0,0:07:54.91,0:07:56.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:07:56.25,0:07:59.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah mendengar tentang Arc dari Chiyome.
Dialogue: 0,0:07:59.54,0:08:01.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti yang ini.
Dialogue: 0,0:08:01.96,0:08:03.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Bunga dan Tulang".
Dialogue: 0,0:08:03.59,0:08:08.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kisah cinta antara pria yang dikutuk\Njadi tengkorak dan wanita bangsawan.
Dialogue: 0,0:08:08.09,0:08:10.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bentuk rupa itu tidak penting.
Dialogue: 0,0:08:10.55,0:08:12.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama hatinya saling terhubung.
Dialogue: 0,0:08:12.30,0:08:13.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu juga!
Dialogue: 0,0:08:13.72,0:08:16.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Nona Tsubone suka membaca buku?
Dialogue: 0,0:08:16.35,0:08:19.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan bukunya, dia lebih tertarik\Ndengan dunia luar.
Dialogue: 0,0:08:19.75,0:08:22.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tsubone sering mendapat tugas di dalam desa,
Dialogue: 0,0:08:22.44,0:08:24.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi dia mendambakan dunia luar.
Dialogue: 0,0:08:25.94,0:08:30.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku minta teman-temanku\Nmembawakan buku dari luar desa.
Dialogue: 0,0:08:30.17,0:08:31.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Tsubone!
Dialogue: 0,0:08:31.74,0:08:34.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, gawat.\NAku sedang di tengah pekerjaan.
Dialogue: 0,0:08:34.83,0:08:36.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pamit dulu.
Dialogue: 0,0:08:36.40,0:08:38.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nikmatilah festivalnya.
Dialogue: 0,0:08:38.90,0:08:40.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, akan kami nikmati.
Dialogue: 0,0:08:41.91,0:08:44.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba kalau Sasuke sudah kembali.
Dialogue: 0,0:08:44.79,0:08:47.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah di mana dan sedang apa dia.
Dialogue: 0,0:08:49.26,0:08:51.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Nona Chiyome?
Dialogue: 0,0:08:52.01,0:08:53.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan apa-apa.
Dialogue: 0,0:09:10.20,0:09:12.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh! Ramai sekali!
Dialogue: 0,0:09:12.70,0:09:13.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:09:13.57,0:09:14.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kalian?
Dialogue: 0,0:09:14.91,0:09:17.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kalian menikmati festivalnya?
Dialogue: 0,0:09:17.24,0:09:19.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dia, sate ati dan ayamnya sudah matang.
Dialogue: 0,0:09:19.66,0:09:21.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, kelihatan enak!
Dialogue: 0,0:09:24.59,0:09:28.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Tsubone sendiri\Nkelihatannya sangat menikmati.
Dialogue: 0,0:09:31.97,0:09:34.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tsubone tidak pernah berubah, ya.
Dialogue: 0,0:09:34.77,0:09:37.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak pernah tahu apa yang akan terjadi.
Dialogue: 0,0:09:37.10,0:09:38.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi nikmatilah ketika bisa menikmati.
Dialogue: 0,0:09:38.97,0:09:41.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan dimakan, Tuan Kesatria.
Dialogue: 0,0:09:43.15,0:09:46.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Kesatria?\NSilakan, tidak perlu sungkan.
Dialogue: 0,0:09:46.11,0:09:47.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas kebaikanmu.
Dialogue: 0,0:09:47.73,0:09:50.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Kesatria tidak kuat minum alkohol?
Dialogue: 0,0:09:50.24,0:09:52.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, bukan begitu.
Dialogue: 0,0:09:52.76,0:09:55.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kasihan sekali si Arc ini.
Dialogue: 0,0:09:55.28,0:09:56.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tarik tambang!
Dialogue: 0,0:09:56.37,0:09:58.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tarik tambangnya mau dimulai!
Dialogue: 0,0:10:13.30,0:10:15.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tarik tambang itu apa?
Dialogue: 0,0:10:15.05,0:10:17.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sederhananya adu kekuatan.
Dialogue: 0,0:10:17.43,0:10:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang berhasil menarik tali itu
Dialogue: 0,0:10:19.01,0:10:22.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menyeretnya hingga\Nke wilayahnya berarti menang.
Dialogue: 0,0:10:22.14,0:10:23.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam festival klan,
Dialogue: 0,0:10:23.73,0:10:26.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tarik tambang dijadikan\Nsebagai upacara persembahan
Dialogue: 0,0:10:26.90,0:10:29.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menghormati Hanzo generasi pertama.
Dialogue: 0,0:10:29.57,0:10:30.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Torii.
Dialogue: 0,0:10:30.73,0:10:32.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakaian wasit.
Dialogue: 0,0:10:32.07,0:10:33.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Persembahan.
Dialogue: 0,0:10:33.24,0:10:35.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya Hanzo generasi pertama itu...
Dialogue: 0,0:10:36.95,0:10:41.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, sebagai persembahan\Nberdirinya desa yang baru,
Dialogue: 0,0:10:41.29,0:10:43.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita akan memulai pertandingan tarik tambang.
Dialogue: 0,0:10:43.33,0:10:45.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kalian siap?
Dialogue: 0,0:10:53.63,0:10:55.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersedia!
Dialogue: 0,0:10:56.51,0:10:57.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai!
Dialogue: 0,0:11:10.07,0:11:12.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemenangnya Goemon!
Dialogue: 0,0:11:12.57,0:11:14.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantap.
Dialogue: 0,0:11:14.28,0:11:15.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya!
Dialogue: 0,0:11:15.32,0:11:16.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:11:20.24,0:11:21.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemenangnya Goemon!
Dialogue: 0,0:11:26.25,0:11:28.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemenangnya Goemon!
Dialogue: 0,0:11:31.13,0:11:33.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemenangnya Goemon!
Dialogue: 0,0:11:33.67,0:11:34.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya!
Dialogue: 0,0:11:35.45,0:11:37.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada yang berani?
Dialogue: 0,0:11:37.97,0:11:40.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini Goemon menang lagi, ya.
Dialogue: 0,0:11:40.81,0:11:42.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa saja boleh ikut?
Dialogue: 0,0:11:42.60,0:11:43.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:11:43.39,0:11:46.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa pun yang merasa kuat\Nboleh berpartisipasi.
Dialogue: 0,0:11:47.39,0:11:49.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Tuan Goemon?
Dialogue: 0,0:11:51.48,0:11:52.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:11:52.73,0:11:53.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku?
Dialogue: 0,0:11:59.68,0:12:02.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dilarang menggunakan ninjutsu maupun sihir.
Dialogue: 0,0:12:02.83,0:12:06.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus bertanding mengandalkan\Nkekuatan masing-masing.
Dialogue: 0,0:12:06.37,0:12:07.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:12:07.09,0:12:08.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:12:08.00,0:12:11.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang ingin sesekali\Nbertanding melawan Tuan Goemon.
Dialogue: 0,0:12:11.88,0:12:13.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama.
Dialogue: 0,0:12:13.46,0:12:16.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, semuanya bersiap.
Dialogue: 0,0:12:18.43,0:12:20.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat, Goemon!
Dialogue: 0,0:12:20.26,0:12:22.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mau kalah dari kaum manusia!
Dialogue: 0,0:12:22.35,0:12:24.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalahkan dia, Goemon!
Dialogue: 0,0:12:24.39,0:12:25.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertandinglah yang adil!
Dialogue: 0,0:12:28.85,0:12:30.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makin meriah, ya.
Dialogue: 0,0:12:30.81,0:12:32.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini berkat Tuan Arc.
Dialogue: 0,0:12:32.61,0:12:35.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang kalian berdua bisa datang.
Dialogue: 0,0:12:35.31,0:12:37.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga turut senang.
Dialogue: 0,0:12:37.29,0:12:42.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau selalu ada Goemon,\Nyang lain jadi susah menang.
Dialogue: 0,0:12:42.32,0:12:43.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal itu...
Dialogue: 0,0:12:43.37,0:12:45.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya ada Sasuke.
Dialogue: 0,0:12:45.84,0:12:47.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sasuke?
Dialogue: 0,0:12:47.08,0:12:49.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seangkatan dengan kami dan Goemon.
Dialogue: 0,0:12:49.50,0:12:52.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka selalu bersaing dengan ketat.
Dialogue: 0,0:12:52.61,0:12:55.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua kali sebelumnya juga Sasuke yang menang.
Dialogue: 0,0:12:55.38,0:12:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:12:57.00,0:12:59.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat juga bisa menang dari Goemon.
Dialogue: 0,0:13:02.05,0:13:04.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Kesatria, kalahkan dia!
Dialogue: 0,0:13:04.56,0:13:08.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sasuke itu tidak mengandalkan kekuatan,\Nmelainkan jago taktik.
Dialogue: 0,0:13:08.60,0:13:09.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:13:09.85,0:13:12.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, kenapa kali ini dia tidak ikut?
Dialogue: 0,0:13:12.85,0:13:15.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia belum pulang dari menjalankan misi.
Dialogue: 0,0:13:16.69,0:13:19.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sudah biasa, jadi tenang saja.
Dialogue: 0,0:13:22.82,0:13:25.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari, kita juga ikut menikmati.
Dialogue: 0,0:13:25.83,0:13:28.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan, Ariane.
Dialogue: 0,0:13:28.04,0:13:30.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Te-Terima kasih.
Dialogue: 0,0:13:30.33,0:13:33.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua, bersedia!
Dialogue: 0,0:13:34.29,0:13:36.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap, mulai!
Dialogue: 0,0:13:39.26,0:13:41.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo! Sudah dimulai!
Dialogue: 0,0:13:41.47,0:13:42.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tarik!
Dialogue: 0,0:13:42.76,0:13:44.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ayo! Ayo!\N- Tarik!
Dialogue: 0,0:13:44.26,0:13:45.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat!
Dialogue: 0,0:13:45.35,0:13:46.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desa yang indah, ya.
Dialogue: 0,0:13:46.99,0:13:52.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku mulai paham\Napa yang ingin Dik Chiyome lindungi.
Dialogue: 0,0:13:54.23,0:13:58.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya melindungi apa\Nyang orang itu ingin lindungi.
Dialogue: 0,0:13:58.48,0:13:59.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang itu?
Dialogue: 0,0:14:01.11,0:14:02.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah sadar?
Dialogue: 0,0:14:05.87,0:14:08.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti orang itu\Nyang pernah menyelamatkanku.
Dialogue: 0,0:14:22.05,0:14:23.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tarik, Goemon!
Dialogue: 0,0:14:23.13,0:14:25.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mau kalah dengan kaum manusia!
Dialogue: 0,0:14:25.05,0:14:28.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arc itu bukan kaum manusia biasa!
Dialogue: 0,0:14:29.35,0:14:30.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hajar, Arc!
Dialogue: 0,0:14:30.81,0:14:32.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kalah, aku bakar kamu!
Dialogue: 0,0:14:33.31,0:14:34.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat!
Dialogue: 0,0:14:34.56,0:14:36.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang memberikan sake padanya!
Dialogue: 0,0:14:58.38,0:15:00.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Arc!
Dialogue: 0,0:15:00.09,0:15:02.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang lebih semangat lagi tariknya!
Dialogue: 0,0:15:03.84,0:15:06.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Goemon, mari kita selesaikan ini!
Dialogue: 0,0:15:06.51,0:15:08.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang itu yang aku inginkan!
Dialogue: 0,0:15:36.79,0:15:39.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Siapa yang menang?\N- Hasilnya bisa begini?
Dialogue: 0,0:15:39.13,0:15:41.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus bagaimana ini?
Dialogue: 0,0:15:50.39,0:15:53.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertandingan ini dinyatakan seri!
Dialogue: 0,0:15:56.27,0:15:58.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa seri?
Dialogue: 0,0:15:58.40,0:16:00.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Main yang benar, Arc!
Dialogue: 0,0:16:00.15,0:16:01.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}No-Nona Chiyome!
Dialogue: 0,0:16:01.90,0:16:04.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan biarkan Nona Ariane minum sake lagi!
Dialogue: 0,0:16:04.65,0:16:06.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ba-baik!
Dialogue: 0,0:16:07.10,0:16:09.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembalikan sake milikku!
Dialogue: 0,0:16:09.03,0:16:10.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh.
Dialogue: 0,0:16:10.16,0:16:12.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dik Chiyome, kembalikan!
Dialogue: 0,0:16:12.45,0:16:13.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh!
Dialogue: 0,0:16:13.79,0:16:15.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dik Chiyome, kembalikan sakenya!
Dialogue: 0,0:16:15.54,0:16:16.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh!
Dialogue: 0,0:16:16.41,0:16:19.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, jangan iseng.
Dialogue: 0,0:16:19.96,0:16:21.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu iseng begini?
Dialogue: 0,0:16:21.67,0:16:22.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, a-aku...
Dialogue: 0,0:16:22.67,0:16:24.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Kok begini?
Dialogue: 0,0:16:24.30,0:16:26.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pikir Ariane dan Arc.
Dialogue: 0,0:16:26.51,0:16:28.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata malah Ariane dan Chiyome?
Dialogue: 0,0:16:28.72,0:16:31.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Telinga hewanmu dan telinga runcingku.
Dialogue: 0,0:16:31.64,0:16:35.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri elf yang diculik manusia\Ndan putri dari manusia hewan
Dialogue: 0,0:16:35.93,0:16:38.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}melarikan diri bersama-sama.
Dialogue: 0,0:16:38.23,0:16:41.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kami tidak seperti itu!
Dialogue: 0,0:16:41.10,0:16:42.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dik Chiyome.
Dialogue: 0,0:16:42.52,0:16:45.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak akan bisa kabur.
Dialogue: 0,0:16:45.11,0:16:48.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tsu-Tsubone, tolong aku!
Dialogue: 0,0:16:48.24,0:16:50.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar.
Dialogue: 0,0:16:50.86,0:16:53.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dik Chiyome.
Dialogue: 0,0:16:55.74,0:16:57.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dik Chiyome?
Dialogue: 0,0:16:57.54,0:16:59.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudahlah.
Dialogue: 0,0:17:00.00,0:17:02.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, hampir saja, Nona Ariane!
Dialogue: 0,0:17:02.33,0:17:04.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arc, apa yang kamu lakukan?
Dialogue: 0,0:17:04.54,0:17:06.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, kamu kenapa?
Dialogue: 0,0:17:06.63,0:17:08.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya seri!
Dialogue: 0,0:17:08.55,0:17:10.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, wahai api...
Dialogue: 0,0:17:10.80,0:17:12.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Nona Ariane!
Dialogue: 0,0:17:12.68,0:17:14.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sedang di festival!
Dialogue: 0,0:17:14.18,0:17:18.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan buat masalah di tempat festival\Nyang meriah begini!
Dialogue: 0,0:17:18.56,0:17:21.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuangkan lagi ke cangkir ini.
Dialogue: 0,0:17:22.69,0:17:24.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Ariane!
Dialogue: 0,0:17:24.65,0:17:26.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Ariane tidak apa-apa?
Dialogue: 0,0:17:26.81,0:17:29.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ariane tidak kuat minum sake, ya.
Dialogue: 0,0:18:05.52,0:18:07.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tamaya!
Dialogue: 0,0:18:22.12,0:18:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, apa yang akan kamu\Nlakukan ke depannya?
Dialogue: 0,0:18:25.56,0:18:28.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah tahu bahwa kekuatan mata air
Dialogue: 0,0:18:28.21,0:18:30.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak bisa mengembalikan\Ntubuhmu seperti semula.
Dialogue: 0,0:18:33.51,0:18:37.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, tujuan untuk kembali\Nke wujud semula
Dialogue: 0,0:18:37.22,0:18:40.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah pengaturan karakter\Nyang kubuat untuk roleplay.
Dialogue: 0,0:18:40.60,0:18:45.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin tidak jadi masalah kalau lanjut\Nberkelana dengan wujud seperti ini.
Dialogue: 0,0:18:45.81,0:18:48.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, baiknya bagaimana, ya?
Dialogue: 0,0:18:49.40,0:18:51.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Arc.
Dialogue: 0,0:18:52.01,0:18:55.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membawamu ke mata air ini\Nadalah bentuk balas budiku.
Dialogue: 0,0:18:56.41,0:18:58.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu mau,
Dialogue: 0,0:18:58.89,0:18:59.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku...
Dialogue: 0,0:19:01.54,0:19:05.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai kamu menemukan cara\Nmengembalikan tubuhmu,
Dialogue: 0,0:19:05.67,0:19:08.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bersedia menemanimu\Nsedikit lebih lama lagi.
Dialogue: 0,0:19:12.01,0:19:13.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Burung sialan!
Dialogue: 0,0:19:13.01,0:19:16.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti kujadikan sate lalu kumakan habis!
Dialogue: 0,0:19:17.47,0:19:18.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tes, tes.
Dialogue: 0,0:19:18.93,0:19:21.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kabar kalian?
Dialogue: 0,0:19:21.01,0:19:22.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Bu Glenys!
Dialogue: 0,0:19:22.89,0:19:25.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dengar Arc sudah sadar kembali,
Dialogue: 0,0:19:25.81,0:19:28.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku langsung kirim burung\Npembisik paket kilat.
Dialogue: 0,0:19:28.90,0:19:31.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas saja burungnya terengah-engah.
Dialogue: 0,0:19:31.53,0:19:33.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada dua hal yang ingin aku sampaikan.
Dialogue: 0,0:19:33.80,0:19:35.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langsung saja yang pertama.
Dialogue: 0,0:19:35.65,0:19:36.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arc,
Dialogue: 0,0:19:36.86,0:19:40.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mulai sekarang gunakanlah nama Arc Lalatoya.
Dialogue: 0,0:19:40.16,0:19:41.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa begitu?
Dialogue: 0,0:19:41.74,0:19:45.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Ariane, ini kan cuma rekaman,\Njadi percuma protes.
Dialogue: 0,0:19:46.50,0:19:48.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inti pokoknya,
Dialogue: 0,0:19:48.25,0:19:51.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat ini Arc adalah tentara bayaran\Ntanpa ikatan, kan?
Dialogue: 0,0:19:51.43,0:19:54.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke depannya, kamu akan lebih mudah bergerak
Dialogue: 0,0:19:54.71,0:19:56.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau punya status dan identitas resmi.
Dialogue: 0,0:19:56.88,0:19:57.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:19:57.84,0:19:59.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu yang kedua.
Dialogue: 0,0:19:59.39,0:20:04.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya Danka diserang pengguna\Npedang ganda di benua selatan.
Dialogue: 0,0:20:05.52,0:20:07.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa?\N- Pengguna pedang ganda?
Dialogue: 0,0:20:07.37,0:20:09.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini dia sedang memulihkan diri.
Dialogue: 0,0:20:09.31,0:20:11.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian cepatlah menyusul padanya.
Dialogue: 0,0:20:13.90,0:20:18.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Danka adalah salah satu pejuang\Nterkuat di antara kaum elf.
Dialogue: 0,0:20:18.17,0:20:20.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bahkan tak bisa menyerang Danka\Nsecara mendadak.
Dialogue: 0,0:20:23.54,0:20:25.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, ayo kita berangkat.
Dialogue: 0,0:20:25.29,0:20:26.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arc?
Dialogue: 0,0:20:26.29,0:20:29.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun,\Nsekarang aku adalah Arc Lalatoya.
Dialogue: 0,0:20:31.17,0:20:33.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Arc.
Dialogue: 0,0:20:34.21,0:20:37.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, Tuan Dragon Lord, terima kasih!
Dialogue: 0,0:20:37.48,0:20:39.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami izin pamit.
Dialogue: 0,0:20:39.05,0:20:41.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, jaga diri.
Dialogue: 0,0:20:42.64,0:20:46.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Arc, kalau nanti bertemu sosok\Nyang menyerang Tuan Danka,
Dialogue: 0,0:20:46.89,0:20:48.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa tolong beri tahu aku?
Dialogue: 0,0:20:48.97,0:20:50.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya?
Dialogue: 0,0:20:50.69,0:20:55.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ciri-cirinya sangat mirip dengan orang\Nyang sedang kami cari di desa.
Dialogue: 0,0:20:55.32,0:20:56.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya soal Sasuke?
Dialogue: 0,0:20:56.94,0:20:57.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:20:57.94,0:21:01.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau lawannya pengguna pedang ganda\Nyang Tuan Danka saja kewalahan,
Dialogue: 0,0:21:01.32,0:21:03.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada kemungkinan memang dia orangnya.
Dialogue: 0,0:21:03.70,0:21:06.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Nbagaimana kalau Nona Chiyome ikut?
Dialogue: 0,0:21:07.12,0:21:10.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mencari orang itu lebih bagus beramai-ramai.
Dialogue: 0,0:21:11.19,0:21:13.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Arc, Nona Ariane.
Dialogue: 0,0:21:22.68,0:21:26.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, padahal sekarang lagi bebas-bebasnya.
Dialogue: 0,0:21:30.89,0:21:35.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ampun, apa yang dipikirkan Bapa Paus?
Dialogue: 0,0:21:35.98,0:21:39.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, untuk menjalankan rencana ini\Ntanpa ketahuan,
Dialogue: 0,0:21:39.57,0:21:44.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sepuluh ribu prajurit bawah tanah saja\Ntidak akan cukup, tahu.
Dialogue: 0,0:21:44.66,0:21:46.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:21:46.28,0:21:47.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yakin?
Dialogue: 0,0:21:47.89,0:21:48.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia siapa?
Dialogue: 0,0:21:48.91,0:21:52.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar tidak memancing kecurigaan,
Dialogue: 0,0:21:52.17,0:21:54.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita harus bergerak dalam jumlah sedikit.
Dialogue: 0,0:21:54.75,0:21:56.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya kita butuh bidak.
Dialogue: 0,0:21:56.80,0:21:59.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya dia bakal berguna?
Dialogue: 0,0:22:00.80,0:22:03.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia akan sangat berguna.
Dialogue: 0,0:22:03.39,0:22:08.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk tujuan itulah Bapa Paus\Nmemberikan dia pada kita.
