Dialogue: 0,0:02:12.49,0:02:16.03,sign,,0000,0000,0000,,KESATRIA TENGKORAK BERKELANA DI DUNIA LAIN\NMUSIM KEDUA
Dialogue: 0,0:12:36.99,0:12:41.99,sign,,0000,0000,0000,,EPISODE 9: REUNI BERSAMA AUMAN\NSANG BINATANG HITAM
Dialogue: 0,0:14:37.65,0:14:38.94,sign,,0000,0000,0000,,PEDANG SINAR SUCI
Dialogue: 0,0:23:39.98,0:23:44.99,sign,,0000,0000,0000,,SELANJUTNYA: KEJAM! MENGEJAR KAKAK ANGKAT\NSAMBIL MENAHAN AIR MATA
Dialogue: 0,0:23:44.99,0:23:51.41,sign,,0000,0000,0000,,#PONTASAATINIJUGASEDANGBERKELANA\NNIKMATILAH MAKAN DENGAN SANTAI DAN TENANG!
Dialogue: 0,0:00:13.20,0:00:15.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, aku Arc.
Dialogue: 0,0:00:15.48,0:00:20.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah tiba di Primus, Nona Ariane\Nlangsung pergi menemui Danka...
Dialogue: 0,0:00:20.08,0:00:21.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang!
Dialogue: 0,0:00:21.71,0:00:24.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan cumi bakar krakennya!
Dialogue: 0,0:00:25.51,0:00:27.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau dua tusuk!
Dialogue: 0,0:00:27.38,0:00:29.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tiga tusuk!
Dialogue: 0,0:00:29.22,0:00:31.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari, silakan antre dulu!
Dialogue: 0,0:00:31.89,0:00:33.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dia, dua cumi bakar sudah matang!
Dialogue: 0,0:00:33.85,0:00:36.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, apa yang kalian lakukan?
Dialogue: 0,0:00:36.35,0:00:38.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Nona Ariane.
Dialogue: 0,0:00:38.08,0:00:40.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena punya banyak bahan cumi-cumi,
Dialogue: 0,0:00:40.27,0:00:43.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku terpikir sekalian saja\Ndijual ke orang-orang.
Dialogue: 0,0:00:43.27,0:00:45.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cumi bakar, Nona Ariane?
Dialogue: 0,0:00:45.44,0:00:47.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ini bicara apa?
Dialogue: 0,0:00:47.78,0:00:49.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup menggoda, kan?
Dialogue: 0,0:00:53.49,0:00:57.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun, meleng sedikit langsung begini.
Dialogue: 0,0:00:57.33,0:00:59.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, tidak apa-apa.
Dialogue: 0,0:00:59.21,0:01:00.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahan cumi-cuminya bisa habis,
Dialogue: 0,0:01:00.83,0:01:03.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita pun dapat uang banyak.
Dialogue: 0,0:01:03.13,0:01:06.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, bagaimana keadaan Tuan Danka?
Dialogue: 0,0:01:06.64,0:01:08.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal itu...
Dialogue: 0,0:01:08.05,0:01:11.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya Danka sudah tidak ada di kota ini.
Dialogue: 0,0:01:11.13,0:01:12.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:01:12.68,0:01:15.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabarnya dia sempat beristirahat.
Dialogue: 0,0:01:15.56,0:01:17.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi setelah bisa bergerak,
Dialogue: 0,0:01:17.28,0:01:19.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia langsung pergi ke Tajient.
Dialogue: 0,0:01:21.06,0:01:24.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, bagaimana kalau\Nkita juga pergi ke Tajient?
Dialogue: 0,0:01:25.32,0:01:27.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jaraknya lumayan jauh.
Dialogue: 0,0:01:27.15,0:01:31.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita perlu bekal makanan\Ndan berbagai keperluan perjalanan.
Dialogue: 0,0:01:31.21,0:01:34.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi, Tuan Arc sudah beli tomat, Red Nail,
Dialogue: 0,0:01:34.95,0:01:37.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan berbagai bahan lain di pasar.
Dialogue: 0,0:01:38.45,0:01:40.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti aku bisa sajikan makanan enak.
Dialogue: 0,0:01:40.75,0:01:43.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tomat dan Red Nail, ya.
Dialogue: 0,0:01:43.21,0:01:45.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau masak apa kamu nanti?
Dialogue: 0,0:01:46.59,0:01:48.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, sudahlah.
Dialogue: 0,0:01:48.09,0:01:49.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita berangkat.
Dialogue: 0,0:01:49.76,0:01:52.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa jauh jarak ke Tajient?
Dialogue: 0,0:01:52.88,0:01:56.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalan kaki 20 hari, kalau naik burung 5 hari.
Dialogue: 0,0:01:56.85,0:01:57.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Burung?
Dialogue: 0,0:02:38.30,0:02:41.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Orang tak berpengalaman\Ntak boleh melakukan ini!
Dialogue: 0,0:02:41.34,0:02:46.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku harus memasak dulu!
Dialogue: 0,0:03:36.45,0:03:38.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya burung ini?
Dialogue: 0,0:03:38.17,0:03:40.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini baru yang namanya fantasi!
Dialogue: 0,0:03:40.78,0:03:42.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya Doriorg.
Dialogue: 0,0:03:42.03,0:03:44.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggangan yang cocok untuk perjalanan jauh.
Dialogue: 0,0:03:45.66,0:03:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf,
Dialogue: 0,0:03:47.04,0:03:50.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat ini Doriorg sedang masa istirahat,\Njadi tak bisa disewakan.
Dialogue: 0,0:03:50.67,0:03:52.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Wah, repot juga.
Dialogue: 0,0:03:52.80,0:03:56.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau Driftpus yang tertinggal\Ndari kaum manusia harimau sih ada.
Dialogue: 0,0:03:57.34,0:03:59.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Driftpus.
Dialogue: 0,0:04:00.60,0:04:02.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa tolong perlihatkan dulu?
Dialogue: 0,0:04:02.85,0:04:05.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, memangnya kenapa?
Dialogue: 0,0:04:08.77,0:04:12.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Driftpus itu hewan yang dijadikan tunggangan\Noleh kaum manusia harimau.
Dialogue: 0,0:04:12.86,0:04:15.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaum manusia harimau itu apa?
Dialogue: 0,0:04:15.53,0:04:18.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bagian dari kaum manusia hewan\Nyang tinggal di benua ini.
Dialogue: 0,0:04:18.86,0:04:19.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:04:19.95,0:04:24.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa menunggangi dan mengembalikannya\Nke manusia harimau, biayanya jadi gratis.
Dialogue: 0,0:04:24.45,0:04:25.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penawaran yang bagus, kan?
Dialogue: 0,0:04:25.75,0:04:29.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, untuk bisa menunggangi Driftpus itu...
Dialogue: 0,0:04:36.51,0:04:41.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus adu kekuatan dulu agar dia\Nmenganggap kita bisa jadi majikannya.
Dialogue: 0,0:04:41.64,0:04:44.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo Arc, giliranmu beraksi.
Dialogue: 0,0:04:46.68,0:04:49.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh!\NFantasi maksimal!
Dialogue: 0,0:04:49.69,0:04:51.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Come on!
Dialogue: 0,0:04:53.19,0:04:56.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo maju, Driftpus!
Dialogue: 0,0:05:11.79,0:05:15.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh!\NHewan yang sangat kuat!
Dialogue: 0,0:05:15.23,0:05:18.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berani menghadapiku secara langsung!
Dialogue: 0,0:05:18.51,0:05:21.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia langsung hilang semangat untuk bertarung.
Dialogue: 0,0:05:21.44,0:05:22.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:05:22.76,0:05:24.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lumayan.
Dialogue: 0,0:05:24.51,0:05:27.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata cukup kuat juga.
Dialogue: 0,0:05:27.27,0:05:28.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:05:32.02,0:05:32.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Angkat!
Dialogue: 0,0:05:36.90,0:05:39.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlalu berlebihan, Arc.
Dialogue: 0,0:05:48.91,0:05:50.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam sesingkat ini,
Dialogue: 0,0:05:50.20,0:05:53.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah mengumpulkan banyak informasi terbaru
Dialogue: 0,0:05:53.54,0:05:56.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tentang Kekaisaran Suci Revlon di timur?
Dialogue: 0,0:05:57.17,0:05:59.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda Sekt memang hebat.
Dialogue: 0,0:06:01.05,0:06:05.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, apa ada yang membuatmu tertarik,\NYuriarna?
Dialogue: 0,0:06:05.60,0:06:08.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka memang bersitegang\Ndengan kekaisaran di barat,
Dialogue: 0,0:06:08.34,0:06:10.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi tampak damai-damai saja?
Dialogue: 0,0:06:11.27,0:06:13.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, benar.
Dialogue: 0,0:06:14.23,0:06:17.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat tak wajar karena tidak terlihat\Nadanya kerugian.
Dialogue: 0,0:06:18.27,0:06:21.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tidak ada perang besar yang terjadi,
Dialogue: 0,0:06:21.73,0:06:26.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}situasinya seolah tak mengalami kerugian\Nsedikit pun dari perburuan monster.
Dialogue: 0,0:06:27.03,0:06:28.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:06:28.78,0:06:33.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu negeri yang berada\Ndalam situasi seperti ini.
Dialogue: 0,0:06:34.04,0:06:36.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerajaan Suci Hilk, ya?
Dialogue: 0,0:06:36.67,0:06:38.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabarnya, di masa lalu,
Dialogue: 0,0:06:38.50,0:06:43.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}negeri tersebut mengalami kerugian akibat\Nperburuan monster seperti negeri lainnya.
Dialogue: 0,0:06:44.30,0:06:47.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya berubah drastis sejak insiden itu.
Dialogue: 0,0:06:48.22,0:06:49.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Insiden ketika satu monster
Dialogue: 0,0:06:49.93,0:06:53.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memusnahkan seluruh pasukan suatu negara.
Dialogue: 0,0:06:53.77,0:06:57.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tak salah,\Nitu terjadi hampir 100 tahun lalu.
Dialogue: 0,0:06:57.01,0:07:00.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster yang dijuluki Raja Dunia Bawah\Natau Dewa Kematian.
Dialogue: 0,0:07:01.32,0:07:04.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, setelah itu monster tersebut hilang.
Dialogue: 0,0:07:04.20,0:07:08.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konon itu berkat kesatria suci\Ndari kerajaan tersebut.
Dialogue: 0,0:07:09.66,0:07:11.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak saat itu,
Dialogue: 0,0:07:11.74,0:07:15.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kesatria suci mereka menjadi\Nsumber wibawa dan kejayaan ordo gereja.
Dialogue: 0,0:07:17.17,0:07:21.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, apa situasi yang tidak wajar\Ndi kekaisaran timur ini,
Dialogue: 0,0:07:21.80,0:07:24.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada hubungannya dengan Kerajaan Suci Hilk?
Dialogue: 0,0:07:25.38,0:07:29.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk saat ini, masih sebatas spekulasi.
Dialogue: 0,0:07:38.98,0:07:41.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mataku memang tidak salah lihat.
Dialogue: 0,0:07:41.61,0:07:43.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihatlah larinya ini!
Dialogue: 0,0:07:43.15,0:07:44.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuat dan bertenaga!
Dialogue: 0,0:07:44.44,0:07:47.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggangan yang melewati\Npadang belantara itu harusnya begini!
Dialogue: 0,0:07:56.96,0:08:00.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong aku!
Dialogue: 0,0:08:07.80,0:08:10.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Dik Chiyome.
Dialogue: 0,0:08:10.43,0:08:13.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tidak, jangan sungkan.
Dialogue: 0,0:08:26.78,0:08:29.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mempertimbangkan pantat\NNona Ariane yang begini,
Dialogue: 0,0:08:29.43,0:08:31.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebaiknya kita istirahat dulu di sini.
Dialogue: 0,0:08:31.28,0:08:32.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:08:32.58,0:08:37.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tergantung orangnya, menunggangi Driftpus\Nmemang membebani pantat.
Dialogue: 0,0:08:37.03,0:08:39.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti kalau pantatnya sudah membaik,
Dialogue: 0,0:08:39.58,0:08:42.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan kusajikan masakan spesial buatanku.
Dialogue: 0,0:08:42.33,0:08:46.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, selanjutnya masukkan tomat\Nyang bentuknya seperti pantat ini.
Dialogue: 0,0:08:46.45,0:08:49.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian jangan melulu bicara pantat, dong.
Dialogue: 0,0:08:49.05,0:08:51.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apaan pula, tomat yang seperti pantat?
Dialogue: 0,0:08:52.39,0:08:54.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya mau buat apa?
Dialogue: 0,0:08:54.31,0:08:58.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada cabai merah dan tomat,\Npaling pas buat arrabbiata.
Dialogue: 0,0:08:58.43,0:09:00.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan mau makan.
Dialogue: 0,0:09:00.48,0:09:01.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:09:01.48,0:09:03.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tomatnya sudah disiapkan dan dibersihkan.
Dialogue: 0,0:09:04.48,0:09:09.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, bagaimana kalau pantatnya\NNona Ariane aku rapalkan heal?
Dialogue: 0,0:09:09.40,0:09:11.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau patah tulang mungkin bisa,
Dialogue: 0,0:09:11.75,0:09:14.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kalau pegal-pegal\Nbegini efeknya akan minim.
Dialogue: 0,0:09:14.93,0:09:19.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, aku juga tidak mau\Npantatku dirapalkan heal.
Dialogue: 0,0:09:19.29,0:09:21.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:09:21.87,0:09:23.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana, Nona Ariane?
Dialogue: 0,0:09:26.30,0:09:29.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh!\NSudah mendingan.
Dialogue: 0,0:09:29.22,0:09:30.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:09:30.34,0:09:33.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sakit lagi, bilang saja padaku.
Dialogue: 0,0:09:33.84,0:09:37.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti aku obati dengan\Nmenusukkan jarum ke pantat.
Dialogue: 0,0:09:37.10,0:09:38.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pengobatan, kan?
Dialogue: 0,0:09:38.39,0:09:39.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:09:39.06,0:09:42.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya bahu dan pinggangku\Njuga terasa pegal.
Dialogue: 0,0:09:42.90,0:09:46.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara naik Driftpus.
Dialogue: 0,0:09:47.82,0:09:52.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, biar aku pijat bahu\Ndan pinggang Tuan Arc.
Dialogue: 0,0:09:56.45,0:09:57.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Tsubone!
Dialogue: 0,0:09:57.95,0:10:01.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Orang tak berpengalaman\Ntak boleh melakukan ini!
Dialogue: 0,0:10:01.75,0:10:02.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:10:02.71,0:10:04.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Cintai Aku Sampai ke Tulang".
Dialogue: 0,0:10:04.58,0:10:09.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pikir ini novel romantis tentang\Nmerebut cinta sampai ke sumsum tulang.
Dialogue: 0,0:10:09.21,0:10:11.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata buku perawatan tulang.
Dialogue: 0,0:10:11.26,0:10:13.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tapi, ternyata buku ini menarik.\N- Kayak pernah lihat.
Dialogue: 0,0:10:13.88,0:10:16.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi ingin mempraktikkannya.
Dialogue: 0,0:10:18.06,0:10:21.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku harus memasak dulu!
Dialogue: 0,0:10:21.98,0:10:23.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:10:23.27,0:10:25.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku dan Nona Ariane yang melanjutkan.
Dialogue: 0,0:10:25.57,0:10:29.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini pantatmu\Nbutuh perhatian khusus, Arc.
Dialogue: 0,0:10:29.90,0:10:31.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kalau begitu...
Dialogue: 0,0:10:31.90,0:10:34.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ambil pasta dari panci,
Dialogue: 0,0:10:34.11,0:10:37.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu pindahkan ke wajan...
Dialogue: 0,0:10:38.12,0:10:39.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap.
Dialogue: 0,0:10:39.91,0:10:42.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ca-Campurkan pastanya dengan saus,
Dialogue: 0,0:10:42.45,0:10:44.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}la-lalu taburkan sedikit garam.
Dialogue: 0,0:10:44.54,0:10:45.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:10:54.63,0:10:56.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuhku jadi terasa lebih enteng.
Dialogue: 0,0:10:56.89,0:10:59.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya pijatannya cukup manjur.
Dialogue: 0,0:10:59.93,0:11:02.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, terlalu manjur.
Dialogue: 0,0:11:02.02,0:11:03.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedas!
Dialogue: 0,0:11:03.27,0:11:06.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, ternyata ini enak juga.
Dialogue: 0,0:11:07.23,0:11:10.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak disangka di dalamnya\Nada Red Nail dan tomat.
Dialogue: 0,0:11:10.86,0:11:14.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, aneh banget.
Dialogue: 0,0:11:15.33,0:11:16.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak!
Dialogue: 0,0:11:16.82,0:11:17.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan?
Dialogue: 0,0:11:17.87,0:11:21.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di balik rasa pedas,\Nada kelezatan yang menanti, kan?
Dialogue: 0,0:11:21.25,0:11:25.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti ketenangan\Nyang menanti di balik rasa sakit.
Dialogue: 0,0:11:30.21,0:11:31.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Ponta?
Dialogue: 0,0:11:38.09,0:11:39.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang datang.
Dialogue: 0,0:11:40.47,0:11:42.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kawanan Driftpus?
Dialogue: 0,0:11:48.35,0:11:52.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari mana kalian mendapatkan Driftpus itu?
Dialogue: 0,0:11:52.32,0:11:53.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawab!
Dialogue: 0,0:11:53.36,0:11:55.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu... manusia harimau?
Dialogue: 0,0:11:55.99,0:11:58.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, telinga harimau yang luar biasa.
Dialogue: 0,0:11:58.85,0:12:03.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bertanya seperti itu pada orang asing\Nrasanya agak tidak sopan.
Dialogue: 0,0:12:03.66,0:12:04.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu dengar atau tidak?
Dialogue: 0,0:12:04.87,0:12:07.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami datang dari benua utara,
Dialogue: 0,0:12:07.17,0:12:09.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hutan tempat tinggal kaum elf.
Dialogue: 0,0:12:09.50,0:12:10.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Driftpus ini
Dialogue: 0,0:12:10.92,0:12:15.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dipinjamkan dari pedagang di Primus\Nuntuk dikembalikan ke kaum manusia harimau.
Dialogue: 0,0:12:15.53,0:12:18.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pikir aku percaya dengan ceritamu?
Dialogue: 0,0:12:18.49,0:12:21.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelana Driftpus itu milik kaum kami!
Dialogue: 0,0:12:21.51,0:12:24.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tergantung jawabanmu,\Nkami mungkin akan membunuhmu!
Dialogue: 0,0:12:25.56,0:12:28.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana agar mereka percaya?
Dialogue: 0,0:12:32.56,0:12:34.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ariane dan Arc?
Dialogue: 0,0:12:34.96,0:12:36.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Danka?
Dialogue: 0,0:13:00.59,0:13:03.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sedang kalian lakukan\Ndi tempat seperti ini?
Dialogue: 0,0:13:04.43,0:13:07.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami ke sini untuk membantu misimu.
Dialogue: 0,0:13:07.52,0:13:11.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sendiri, kenapa bisa bersama\Nkaum manusia harimau?
Dialogue: 0,0:13:11.06,0:13:14.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, aku diserang seseorang di Primus,
Dialogue: 0,0:13:14.98,0:13:18.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu setelah beristirahat,\Naku langsung berangkat menjalankan misi.
Dialogue: 0,0:13:19.40,0:13:23.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di perjalanan, aku menolong\Nkaum manusia harimau yang terluka,
Dialogue: 0,0:13:23.03,0:13:24.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu bertemu Ein, kepala suku mereka.
Dialogue: 0,0:13:24.99,0:13:27.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:13:27.23,0:13:29.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, tenanglah.
Dialogue: 0,0:13:29.25,0:13:31.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bukanlah orang yang mencurigakan.
Dialogue: 0,0:13:31.75,0:13:34.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu yang bilang, aku percaya!
Dialogue: 0,0:13:34.03,0:13:36.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepercayaannya sangat tinggi.
Dialogue: 0,0:13:38.17,0:13:40.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepala suku!
Dialogue: 0,0:13:40.30,0:13:42.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada Jamiant di permukiman terdekat!
Dialogue: 0,0:13:42.76,0:13:43.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi?
Dialogue: 0,0:13:43.89,0:13:44.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jamiant?
Dialogue: 0,0:13:44.89,0:13:45.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Danka!
Dialogue: 0,0:13:46.35,0:13:49.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ariane, Arc, dan para Klan Jinshin.
Dialogue: 0,0:13:49.64,0:13:51.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong bantu kami.
Dialogue: 0,0:14:02.95,0:14:04.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa semuanya sudah dievakuasi?
Dialogue: 0,0:14:04.36,0:14:06.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, semuanya aman.
Dialogue: 0,0:14:06.08,0:14:08.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan biarkan mereka mendekat!
Dialogue: 0,0:14:08.41,0:14:09.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisi mereka!
Dialogue: 0,0:14:14.08,0:14:15.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}He-Hentikan!
Dialogue: 0,0:14:19.80,0:14:21.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku datang membantu!
Dialogue: 0,0:14:26.39,0:14:28.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini yang namanya Jamiant?
Dialogue: 0,0:14:28.53,0:14:29.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan padaku!
Dialogue: 0,0:14:32.35,0:14:35.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknik kesatria suci: Holy Ray Sword!
Dialogue: 0,0:14:41.15,0:14:43.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Danka, siapa sebenarnya mereka?
Dialogue: 0,0:14:44.03,0:14:46.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rekan sejawat yang bisa diandalkan.
Dialogue: 0,0:14:50.54,0:14:51.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Heal!
Dialogue: 0,0:14:55.92,0:14:57.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selesai.
Dialogue: 0,0:14:57.04,0:15:00.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang semuanya sudah diobati.
Dialogue: 0,0:15:00.17,0:15:02.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih kerja kerasnya, Tuan Arc.
Dialogue: 0,0:15:02.80,0:15:04.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami benar-benar tertolong.
Dialogue: 0,0:15:04.93,0:15:08.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mewakili kaum manusia harimau,\Naku ucapkan terima kasih sedalam-dalamnya.
Dialogue: 0,0:15:08.64,0:15:10.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tidak usah dipikirkan.
Dialogue: 0,0:15:10.83,0:15:13.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat kagum dengan aksimu.
Dialogue: 0,0:15:13.35,0:15:16.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa mengalahkan Jamiant\Ndengan satu serangan.
Dialogue: 0,0:15:16.28,0:15:18.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan hal yang besar, kok.
Dialogue: 0,0:15:18.73,0:15:23.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, apa Jamiant\Nselalu menyerang seperti itu?
Dialogue: 0,0:15:23.69,0:15:26.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, Jamiant memang monster\Nyang mengerikan,
Dialogue: 0,0:15:26.91,0:15:29.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi mereka tak pernah menyerang permukiman.
Dialogue: 0,0:15:30.24,0:15:32.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa ini bisa terjadi?
Dialogue: 0,0:15:33.54,0:15:35.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di kaki pegunungan Anetto,
Dialogue: 0,0:15:35.62,0:15:39.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada yang menculik orang-orang\Ndan memaksanya menambang batu sihir.
Dialogue: 0,0:15:40.79,0:15:45.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan ada eksperimen mengubah\Norang mati menjadi Undead.
Dialogue: 0,0:15:45.34,0:15:50.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berpikir ada suatu negara\Nyang sedang melakukan persiapan perang.
Dialogue: 0,0:15:50.30,0:15:52.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sependapat.
Dialogue: 0,0:15:53.85,0:15:58.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dengar kabar bahwa kaum elf\Nditawan di benua selatan.
Dialogue: 0,0:15:58.40,0:15:59.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi aku selidiki.
Dialogue: 0,0:16:01.57,0:16:05.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya rekan-rekan mereka juga\Nditawan di tempat yang sama.
Dialogue: 0,0:16:06.45,0:16:09.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tempat itu Tajient?
Dialogue: 0,0:16:10.24,0:16:11.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:16:23.09,0:16:26.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisakah kamu makan\Ndengan lebih santai,
Dialogue: 0,0:16:26.55,0:16:28.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kardinal Charros.
Dialogue: 0,0:16:28.72,0:16:31.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ingin menikmati makanannya.
Dialogue: 0,0:16:31.47,0:16:35.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi mau bagaimana lagi?\NTidak ada waktu.
Dialogue: 0,0:16:35.22,0:16:37.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau memakan semuanya?
Dialogue: 0,0:16:37.77,0:16:41.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya sayang kalau dibuang.
Dialogue: 0,0:16:41.15,0:16:43.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi seenak ini.
Dialogue: 0,0:16:56.95,0:16:59.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok kami juga mau patroli di sekitar.
Dialogue: 0,0:16:59.67,0:17:01.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kalian bisa bantu?
Dialogue: 0,0:17:01.48,0:17:03.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tentu saja.
Dialogue: 0,0:17:03.00,0:17:04.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:17:04.08,0:17:08.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus segera menyelidiki\Nkenapa Jamiant bisa mengamuk.
Dialogue: 0,0:17:08.83,0:17:13.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Danka, ada hal yang ingin kutanyakan.
Dialogue: 0,0:17:13.22,0:17:14.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:17:14.89,0:17:17.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengenai orang yang menyerang Tuan Danka.
Dialogue: 0,0:17:17.97,0:17:21.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia dari Klan Jinshin sama seperti kami?
Dialogue: 0,0:17:21.48,0:17:24.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, bukan.
Dialogue: 0,0:17:24.19,0:17:27.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia diselimuti Aura Kematian.
Dialogue: 0,0:17:27.99,0:17:29.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aura Kematian?
Dialogue: 0,0:17:29.49,0:17:33.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, itu seperti\Nyang Nona Ariane dan Nona Evin lihat?
Dialogue: 0,0:17:33.70,0:17:37.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, semacam aura beracun khas undead\Nyang bisa dilihat kaum elf.
Dialogue: 0,0:17:39.16,0:17:41.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Undead adalah
Dialogue: 0,0:17:41.04,0:17:44.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}keberadaan yang seharusnya\Ntak ada di dunia ini.
Dialogue: 0,0:17:44.44,0:17:46.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iri akan hidup dan menyebarkan kematian.
Dialogue: 0,0:17:46.71,0:17:49.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, itu bukan Kak Sasuke.
Dialogue: 0,0:17:49.85,0:17:50.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:17:52.72,0:17:55.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, sekarang kekhawatiran kalian\Nsudah hilang.
Dialogue: 0,0:17:57.64,0:18:00.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas informasi berharga ini.
Dialogue: 0,0:18:00.59,0:18:03.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama-sama.\NKalian juga kalau ada informasi baru,
Dialogue: 0,0:18:03.31,0:18:05.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tolong beri tahu aku.
Dialogue: 0,0:18:05.06,0:18:09.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak akan memaafkan pecundang itu.
Dialogue: 0,0:18:09.17,0:18:11.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia benar-benar kesal, ya.
Dialogue: 0,0:18:11.57,0:18:12.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, di sini!
Dialogue: 0,0:18:13.82,0:18:14.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelah sini!
Dialogue: 0,0:18:19.45,0:18:20.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kan...
Dialogue: 0,0:18:20.16,0:18:22.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari permukiman sebelah!
Dialogue: 0,0:18:27.13,0:18:28.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lukanya sangat parah.
Dialogue: 0,0:18:30.26,0:18:31.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi sebentar.
Dialogue: 0,0:18:32.13,0:18:33.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Over Heal!
Dialogue: 0,0:18:37.64,0:18:39.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh!\NSembuh!
Dialogue: 0,0:18:39.81,0:18:41.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir keajaiban!
Dialogue: 0,0:18:41.57,0:18:44.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lukanya sudah sembuh,\Ntapi staminanya belum pulih.
Dialogue: 0,0:18:44.73,0:18:46.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istirahatkan dia di suatu tempat.
Dialogue: 0,0:18:46.65,0:18:48.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku yang bawa.
Dialogue: 0,0:18:48.02,0:18:50.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong...
Dialogue: 0,0:18:52.28,0:18:53.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya...
Dialogue: 0,0:18:54.32,0:18:55.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan memaksakan diri.
Dialogue: 0,0:18:55.66,0:18:59.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gerombolan Jamiant menyerang desa.
Dialogue: 0,0:19:00.91,0:19:03.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong, selamatkan mereka.
Dialogue: 0,0:19:03.66,0:19:05.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya bisa mati.
Dialogue: 0,0:19:20.68,0:19:22.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sudah sangat parah!
Dialogue: 0,0:19:22.77,0:19:26.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita serang Jamiant sambil selamatkan\Nyang belum melarikan diri.
Dialogue: 0,0:19:26.52,0:19:27.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti!
Dialogue: 0,0:19:27.52,0:19:30.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!\NLindungi desa dengan sekuat tenaga!
Dialogue: 0,0:19:30.48,0:19:32.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:19:35.20,0:19:36.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai Api,
Dialogue: 0,0:19:36.07,0:19:39.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang melahap semuanya,\Nbakarlah segalanya!
Dialogue: 0,0:19:41.91,0:19:44.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suiton: Suisousen!
Dialogue: 0,0:19:46.42,0:19:48.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wyvern Slash!
Dialogue: 0,0:20:05.23,0:20:07.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang sudah aman, anak-anak.
Dialogue: 0,0:20:11.73,0:20:12.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arc!
Dialogue: 0,0:20:12.73,0:20:15.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Ariane, mereka ada yang terakhir.
Dialogue: 0,0:20:21.24,0:20:22.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Situasinya?
Dialogue: 0,0:20:23.16,0:20:25.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bagus.
Dialogue: 0,0:20:25.08,0:20:27.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jamiant itu sangat tangguh.
Dialogue: 0,0:20:32.09,0:20:32.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ponta!
Dialogue: 0,0:20:39.47,0:20:41.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Ponta?
Dialogue: 0,0:20:42.68,0:20:45.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada sesuatu di dalam kantung itu?
Dialogue: 0,0:20:45.97,0:20:48.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baunya busuk sekali.
Dialogue: 0,0:20:52.15,0:20:54.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah tak bernyawa.\NApa ini?
Dialogue: 0,0:20:54.98,0:20:57.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini anak Jamiant.
Dialogue: 0,0:20:57.86,0:21:02.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini sebabnya para Jamiant\Nmenyerang permukiman?
Dialogue: 0,0:21:02.49,0:21:05.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membunuh anak mereka\Ndan menjadikannya umpan.
Dialogue: 0,0:21:05.69,0:21:07.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang melakukannya?
Dialogue: 0,0:21:13.67,0:21:15.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Arc.
Dialogue: 0,0:21:17.67,0:21:19.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengguna pedang ganda?
Dialogue: 0,0:21:19.21,0:21:22.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu artinya, dia yang menyerang Tuan Danka.
Dialogue: 0,0:21:23.77,0:21:25.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia diselimuti Aura Kematian.
Dialogue: 0,0:21:25.89,0:21:27.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak salah lagi.
Dialogue: 0,0:21:33.15,0:21:34.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku datang membantu!
Dialogue: 0,0:21:34.31,0:21:35.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga!
Dialogue: 0,0:21:35.15,0:21:38.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pas sekali, Dik Chiyome, Tsubone!
Dialogue: 0,0:21:40.82,0:21:43.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu lawan empat.\NKita pasti menang.
Dialogue: 0,0:21:43.91,0:21:48.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Ariane, pernyataan seperti itu\Nbiasanya pertanda buruk.
Dialogue: 0,0:21:48.33,0:21:50.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertanda buruk apa?
Dialogue: 0,0:21:52.42,0:21:53.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Telinga hewan?
Dialogue: 0,0:21:54.54,0:21:55.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin.
Dialogue: 0,0:21:55.75,0:21:58.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Chiyome, ada apa?
Dialogue: 0,0:21:58.30,0:21:59.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa...
Dialogue: 0,0:21:59.57,0:22:01.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tsubone?
Dialogue: 0,0:22:05.72,0:22:08.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Sasuke.
