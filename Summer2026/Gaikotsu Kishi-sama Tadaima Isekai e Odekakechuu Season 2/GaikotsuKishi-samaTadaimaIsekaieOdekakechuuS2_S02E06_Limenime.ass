Dialogue: 0,0:03:02.50,0:03:06.04,sign,,0000,0000,0000,,KESATRIA TENGKORAK BERKELANA DI DUNIA LAIN\NMUSIM KEDUA
Dialogue: 0,0:12:48.04,0:12:53.04,sign,,0000,0000,0000,,EPISODE 6: YANG TERUKIR DALAM MATA AIR RAJA NAGA\NADALAH TATANAN DUNIA INI
Dialogue: 0,0:18:39.51,0:18:45.52,sign,,0000,0000,0000,,TIDAK MENYAHUT, DIA HANYA SESOSOK MAYAT
Dialogue: 0,0:21:20.34,0:21:23.01,sign,,0000,0000,0000,,SENSASI
Dialogue: 0,0:21:23.01,0:21:26.35,sign,,0000,0000,0000,,STIMULASI
Dialogue: 0,0:23:40.02,0:23:45.03,sign,,0000,0000,0000,,SELANJUTNYA:\NSEMANGAT PRIA YANG MEKAR DI DESA NINJA
Dialogue: 0,0:23:45.03,0:23:51.41,sign,,0000,0000,0000,,#PONTASAATINIJUGASEDANGBERKELANA\NAKU INGIN BERKELANA SAMBIL MENUNGGANGI RAJA NAGA
Dialogue: 0,0:00:06.86,0:00:08.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar lagi sampai.
Dialogue: 0,0:00:08.29,0:00:10.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, akhirnya!
Dialogue: 0,0:00:11.41,0:00:13.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempatnya seperti apa, ya?
Dialogue: 0,0:00:13.70,0:00:17.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat tak terjamah yang hanya bisa\Ndicapai dengan bantuan elf.
Dialogue: 0,0:00:17.51,0:00:19.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi tidak sabar!
Dialogue: 0,0:00:21.83,0:00:22.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu dia.
Dialogue: 0,0:00:22.88,0:00:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari sini kita bisa melihat Lord Crown.
Dialogue: 0,0:00:39.14,0:00:41.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, aku Arc.
Dialogue: 0,0:00:41.65,0:00:46.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, kami sedang menuju mata air\Nyang katanya ada di Lord Crown.
Dialogue: 0,0:00:47.49,0:00:51.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin ini bisa membantu\Nmenghilangkan kutukanmu.
Dialogue: 0,0:00:52.03,0:00:54.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dekat Lord Crown,
Dialogue: 0,0:00:54.20,0:00:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terdapat mata air yang mampu\Nmenyembuhkan segala kutukan.
Dialogue: 0,0:00:57.52,0:01:00.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar pemandangan yang indah!
Dialogue: 0,0:01:00.08,0:01:04.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi seperti ini tempat yang tak terjamah!
Dialogue: 0,0:01:06.25,0:01:09.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sungguh,\Nperjalanan kita berat sekali, ya.
Dialogue: 0,0:01:09.85,0:01:12.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi banyak hal yang terjadi.
Dialogue: 0,0:01:12.72,0:01:15.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hampir dilumat tumbuhan pemakan serangga.
Dialogue: 0,0:01:17.27,0:01:20.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kena ledakan monster.
Dialogue: 0,0:01:24.15,0:01:25.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tersesat di gua.
Dialogue: 0,0:01:25.32,0:01:26.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ke sini!\N- Pasti lewat sini.
Dialogue: 0,0:01:26.12,0:01:26.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Lewat sini!\N- Pasti lewat sini.
Dialogue: 0,0:01:26.98,0:01:28.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku yakin lewat sini!\N- Jalannya ke sini!
Dialogue: 0,0:01:28.74,0:01:32.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah melewati berbagai cobaan, akhirnya...
Dialogue: 0,0:01:33.70,0:01:35.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, Nona Ariane,
Dialogue: 0,0:01:35.53,0:01:38.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada di mana mata air yang kita cari?
Dialogue: 0,0:01:40.41,0:01:42.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, itu kan...
Dialogue: 0,0:01:44.71,0:01:46.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arc, ada apa?
Dialogue: 0,0:01:46.88,0:01:49.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku pergi duluan.
Dialogue: 0,0:01:52.30,0:01:54.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Arc!
Dialogue: 0,0:02:00.85,0:02:03.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak salah lagi, ini kan...
Dialogue: 0,0:02:04.52,0:02:05.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Torii!
Dialogue: 0,0:02:09.07,0:02:11.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, ini ada hubungannya
Dialogue: 0,0:02:11.74,0:02:14.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan Tuan Hanzo\Nyang diceritakan Nona Chiyome?
Dialogue: 0,0:02:20.79,0:02:22.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa ini?
Dialogue: 0,0:02:38.01,0:02:42.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menginjakkan kaki di atasku?
Dialogue: 0,0:02:42.73,0:02:45.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyalimu besar juga, ya,
Dialogue: 0,0:02:45.77,0:02:48.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak Muda!
Dialogue: 0,0:03:26.35,0:03:29.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya ini tidak sopan.
Dialogue: 0,0:03:29.19,0:03:31.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi karena tidak ada orang selain kita...
Dialogue: 0,0:03:31.44,0:03:34.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ponta, ayo kita menceburkan diri!
Dialogue: 0,0:04:29.75,0:04:31.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu, dia...
Dialogue: 0,0:04:34.42,0:04:38.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh? Kamu masih mampu berdiri\Nmenerima intimidasiku?
Dialogue: 0,0:04:38.51,0:04:42.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas saja kamu berani datang kepadaku.
Dialogue: 0,0:04:42.72,0:04:44.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, tunggu dulu!
Dialogue: 0,0:04:44.26,0:04:45.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan ingin bertarung...
Dialogue: 0,0:05:01.57,0:05:03.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, itu kan...
Dialogue: 0,0:05:04.83,0:05:06.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dragon Breath!
Dialogue: 0,0:05:22.03,0:05:23.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hampir saja.
Dialogue: 0,0:05:23.84,0:05:26.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mampu menahannya?
Dialogue: 0,0:05:26.10,0:05:27.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,
Dialogue: 0,0:05:27.35,0:05:30.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kali ini aku akan serius!
Dialogue: 0,0:05:35.90,0:05:38.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong hentikan pertarungan ini,
Dialogue: 0,0:05:38.69,0:05:40.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Dragon Lord!
Dialogue: 0,0:05:41.86,0:05:44.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata memang Dragon Lord, ya.
Dialogue: 0,0:05:44.41,0:05:45.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:05:45.62,0:05:50.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu elf yang tinggal di hutan\Ndi balik gunung itu, bukan?
Dialogue: 0,0:05:50.41,0:05:54.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu yang satu ini\Ndari garis keturunan Hanzo, ya?
Dialogue: 0,0:05:54.50,0:05:55.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:05:55.17,0:05:57.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Ariane Glenys Maple.
Dialogue: 0,0:05:57.80,0:06:00.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggota dari klan yang tinggal\Ndi Hutan Besar Kanada.
Dialogue: 0,0:06:00.97,0:06:02.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Chiyome.
Dialogue: 0,0:06:02.61,0:06:06.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keturunan Klan Jinshin\Nyang dipimpin Tuan Hanzo.
Dialogue: 0,0:06:06.68,0:06:10.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami mohon, agar Tuan Dragon Lord\Nmendengarkan penjelasan kami.
Dialogue: 0,0:06:11.68,0:06:15.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kupikir bisa menikmati\Npertarungan setelah sekian lama.
Dialogue: 0,0:06:15.94,0:06:18.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali, harus dihentikan.
Dialogue: 0,0:06:18.90,0:06:21.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami justru sangat berterima kasih.
Dialogue: 0,0:06:21.19,0:06:24.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Villiers Fim.
Dialogue: 0,0:06:24.28,0:06:25.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana denganmu?
Dialogue: 0,0:06:25.70,0:06:29.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Arc, tentara bayaran\Nyang sedang berkelana.
Dialogue: 0,0:06:31.37,0:06:32.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:06:32.71,0:06:36.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi karena ingin membalas budi Arc,
Dialogue: 0,0:06:36.67,0:06:42.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian datang ke sini untuk mencari\Nkekuatan mata air, begitu?
Dialogue: 0,0:06:44.05,0:06:45.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Anak Muda,
Dialogue: 0,0:06:45.76,0:06:49.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dilihat-lihat kamu memang istimewa.
Dialogue: 0,0:06:49.81,0:06:54.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dia malah mengarahkan telapak kakinya\Nke arah Tuan Dragon Lord.
Dialogue: 0,0:06:54.06,0:06:55.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa.
Dialogue: 0,0:06:55.06,0:06:57.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga minta maaf karena terlalu cepat
Dialogue: 0,0:06:57.48,0:07:00.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menyimpulkan kalian sebagai orang jahat.
Dialogue: 0,0:07:00.77,0:07:05.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga terlalu fokus pada Torii\Nhingga tidak memperhatikan sekitar.
Dialogue: 0,0:07:05.45,0:07:08.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, maafkan aku.
Dialogue: 0,0:07:08.07,0:07:10.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti duduk perkaranya.
Dialogue: 0,0:07:10.59,0:07:13.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mata airnya ada di balik Torii itu.
Dialogue: 0,0:07:13.12,0:07:15.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gunakan saja sesuka kalian.
Dialogue: 0,0:07:15.08,0:07:18.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sana ada kuil yang dulu\Ndigunakan oleh Hanzo,
Dialogue: 0,0:07:18.79,0:07:21.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin bisa jadi penunjuk jalan.
Dialogue: 0,0:07:21.09,0:07:22.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Villiers Fim.
Dialogue: 0,0:07:22.76,0:07:25.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku boleh menanyakan sesuatu?
Dialogue: 0,0:07:25.40,0:07:29.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa, gadis dari Klan Jinshin?
Dialogue: 0,0:07:29.47,0:07:30.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya,
Dialogue: 0,0:07:30.64,0:07:34.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami telah mencari tempat tersembunyi\Nmilik Tuan Hanzo.
Dialogue: 0,0:07:35.31,0:07:38.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelumnya, Tuan Arc dan Nona Ariane,
Dialogue: 0,0:07:38.02,0:07:41.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}telah menyelamatkan kaum kami,
Dialogue: 0,0:07:41.57,0:07:45.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi jumlahnya terlalu banyak\Nuntuk ditampung di desa kami.
Dialogue: 0,0:07:45.74,0:07:49.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau di sini, mereka pasti bisa hidup\Ndengan tenang.
Dialogue: 0,0:07:49.43,0:07:51.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, tolong izinkan kami
Dialogue: 0,0:07:51.54,0:07:55.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk membangun desa persembunyian di sini.
Dialogue: 0,0:07:58.44,0:08:03.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak awal, Hanzo memang sudah berada\Ndi sana sebelum aku datang.
Dialogue: 0,0:08:03.55,0:08:07.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi tidak ada alasan bagiku untuk melarang.
Dialogue: 0,0:08:08.05,0:08:10.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:08:11.55,0:08:14.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah, Dik Chiyome.
Dialogue: 0,0:08:15.85,0:08:18.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian juga, terima kasih banyak.
Dialogue: 0,0:08:19.31,0:08:23.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ayo kita langsung ke mata airnya.
Dialogue: 0,0:08:26.90,0:08:30.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kuil milik Tuan Hanzo, ya.
Dialogue: 0,0:08:32.53,0:08:34.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,
Dialogue: 0,0:08:34.58,0:08:38.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari dekat ini lebih mirip gunung\Ndaripada pohon.
Dialogue: 0,0:08:38.59,0:08:41.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira sudah berapa lama usianya?
Dialogue: 0,0:08:41.69,0:08:43.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu.
Dialogue: 0,0:08:43.71,0:08:47.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya pohon ini sudah ada\Nsejak dunia diciptakan...
Dialogue: 0,0:08:50.22,0:08:52.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ukurannya sungguh luar biasa!
Dialogue: 0,0:08:52.14,0:08:55.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar pantas disebut Lord Crown!
Dialogue: 0,0:08:55.37,0:08:56.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mata airnya pasti sudah dekat.
Dialogue: 0,0:08:56.89,0:08:58.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo ke sana.
Dialogue: 0,0:09:01.98,0:09:05.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibilang mata air...
Dialogue: 0,0:09:05.21,0:09:08.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pemandian air panas besar terbuka!
Dialogue: 0,0:09:14.78,0:09:17.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh! Kutukannya mulai terangkat!
Dialogue: 0,0:09:17.91,0:09:20.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah, Arc.
Dialogue: 0,0:09:20.04,0:09:23.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, terima kasih, Nona Ariane.
Dialogue: 0,0:09:28.46,0:09:31.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku harus berendam cukup lama?
Dialogue: 0,0:09:31.55,0:09:35.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa terlihat aneh.
Dialogue: 0,0:09:35.55,0:09:37.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, langsung saja!
Dialogue: 0,0:09:42.44,0:09:46.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ditatap begini\Nrasanya jadi agak canggung.
Dialogue: 0,0:09:46.84,0:09:48.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tubuhku hanya tulang,
Dialogue: 0,0:09:48.65,0:09:51.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku juga punya rasa malu.
Dialogue: 0,0:09:52.57,0:09:55.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga!\NKamu pasti malu, ya!
Dialogue: 0,0:09:55.28,0:09:58.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Ariane, selagi di pemandian air panas,
Dialogue: 0,0:09:58.29,0:10:00.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagaimana kalau kita melepas penat?
Dialogue: 0,0:10:00.54,0:10:02.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sambil menunggu Tuan Arc selesai,
Dialogue: 0,0:10:02.54,0:10:04.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ayo kita berendam di mata air lain.
Dialogue: 0,0:10:04.88,0:10:06.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Ayo.
Dialogue: 0,0:10:06.43,0:10:09.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dah, Arc, sampai nanti.
Dialogue: 0,0:10:13.97,0:10:16.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, persiapan sudah mantap!
Dialogue: 0,0:10:17.02,0:10:18.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dia!
Dialogue: 0,0:10:19.81,0:10:21.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelan-pelan.
Dialogue: 0,0:10:32.19,0:10:34.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segar sekali, ya.
Dialogue: 0,0:10:36.45,0:10:38.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,
Dialogue: 0,0:10:38.12,0:10:42.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Ariane benar-benar\Nmemiliki tubuh yang menawan, ya.
Dialogue: 0,0:10:43.12,0:10:45.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku boleh menyentuhnya?
Dialogue: 0,0:10:45.12,0:10:46.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, lagi?
Dialogue: 0,0:10:46.96,0:10:48.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malu, tahu.
Dialogue: 0,0:10:48.13,0:10:49.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Colek.
Dialogue: 0,0:10:50.88,0:10:52.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Geli.
Dialogue: 0,0:10:55.51,0:10:57.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segar sekali, ya, Ponta.
Dialogue: 0,0:11:00.97,0:11:03.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, bisa kembali!
Dialogue: 0,0:11:04.56,0:11:05.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip!
Dialogue: 0,0:11:05.78,0:11:08.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya ini tidak sopan.
Dialogue: 0,0:11:08.94,0:11:11.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi karena tidak ada orang selain kita...
Dialogue: 0,0:11:11.69,0:11:14.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ponta, ayo kita menceburkan diri!
Dialogue: 0,0:11:17.36,0:11:21.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira seperti apa penampilan Arc\Nsetelah tubuhnya kembali, ya?
Dialogue: 0,0:11:23.58,0:11:27.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari wujudnya yang sekarang,\Nsama sekali tidak terbayang.
Dialogue: 0,0:11:27.96,0:11:30.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena dia sangat kuat,
Dialogue: 0,0:11:30.04,0:11:32.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin tubuhnya sangat berotot?
Dialogue: 0,0:11:32.21,0:11:33.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:11:33.67,0:11:37.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau mungkin dia orangnya sangat tampan?
Dialogue: 0,0:11:37.80,0:11:40.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bercanda, itu tidak mungkin, kan?
Dialogue: 0,0:11:44.52,0:11:47.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah tubuh Arc kembali,
Dialogue: 0,0:11:47.06,0:11:49.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa perjalanan ini juga berakhir?
Dialogue: 0,0:12:01.70,0:12:06.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, apa tubuhku\Nbenar-benar sudah kembali?
Dialogue: 0,0:12:07.67,0:12:08.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip.
Dialogue: 0,0:12:09.75,0:12:13.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya agak berbeda\Ndari tubuhku di dunia yang asli.
Dialogue: 0,0:12:32.82,0:12:34.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak apa-apa?
Dialogue: 0,0:12:34.19,0:12:36.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arc, ada apa?
Dialogue: 0,0:12:37.19,0:12:40.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak apa-apa, Nona Ariane.
Dialogue: 0,0:12:41.16,0:12:45.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu,\Njangan memasang wajah seperti itu.
Dialogue: 0,0:12:45.16,0:12:48.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arc!
Dialogue: 0,0:12:56.67,0:13:00.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lapor, Yang Mulia Domitianus.
Dialogue: 0,0:13:01.59,0:13:02.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut mata-mata kami,
Dialogue: 0,0:13:02.93,0:13:07.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}batu ini telah ditemukan tertanam
Dialogue: 0,0:13:07.10,0:13:10.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dalam monster yang mengamuk\Ndi Kerajaan Rhoden.
Dialogue: 0,0:13:11.44,0:13:13.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berdasarkan analisis,
Dialogue: 0,0:13:13.21,0:13:15.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}batu ini memiliki teknologi yang sejenis
Dialogue: 0,0:13:15.82,0:13:18.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan Employ Ring yang digunakan Fumba.
Dialogue: 0,0:13:18.82,0:13:21.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah itu dibocorkan dari kekaisaran kita,
Dialogue: 0,0:13:21.20,0:13:23.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau mungkin...
Dialogue: 0,0:13:23.00,0:13:24.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan Agama Hilk?
Dialogue: 0,0:13:24.70,0:13:27.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyelidikan masih berjalan.
Dialogue: 0,0:13:27.03,0:13:30.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya selain Rhoden di benua selatan,
Dialogue: 0,0:13:30.58,0:13:34.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka juga ke Tajient\Nuntuk menambah pengikut.
Dialogue: 0,0:13:34.13,0:13:37.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Tajient, ya?
Dialogue: 0,0:13:38.96,0:13:40.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tidak jadi masalah?
Dialogue: 0,0:13:40.84,0:13:44.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita memasuki rumah Tuan Hanzo tanpa izin.
Dialogue: 0,0:13:44.20,0:13:46.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sedang mengutamakan kondisi Tuan Arc.
Dialogue: 0,0:13:46.64,0:13:49.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beliau pasti memakluminya.
Dialogue: 0,0:13:49.11,0:13:52.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, Arc sama sekali tidak sadar.
Dialogue: 0,0:13:53.44,0:13:55.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sebenarnya terjadi?
Dialogue: 0,0:13:56.15,0:13:57.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah.
Dialogue: 0,0:13:57.73,0:14:01.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pikir ini karena khasiat\Npemandian air panasnya.
Dialogue: 0,0:14:01.65,0:14:05.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak meninggal, kan?
Dialogue: 0,0:14:05.12,0:14:07.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya dia terasa tidak bernapas.
Dialogue: 0,0:14:07.66,0:14:11.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Ariane, memangnya sejak awal\NTuan Arc bernapas?
Dialogue: 0,0:14:11.87,0:14:14.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Aku tidak tahu.
Dialogue: 0,0:14:14.36,0:14:17.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bisa menghela napas dan makan.
Dialogue: 0,0:14:17.67,0:14:21.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Arc sendiri adalah sosok\Nyang penuh misteri.
Dialogue: 0,0:14:21.47,0:14:25.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kita tanya orang\Nyang punya wawasan lebih luas.
Dialogue: 0,0:14:28.85,0:14:30.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:14:30.72,0:14:32.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:14:32.18,0:14:34.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti juga dia akan sadar.
Dialogue: 0,0:14:34.73,0:14:36.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh?
Dialogue: 0,0:14:36.31,0:14:39.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, seperti kepanasan karena\Nberendam terlalu lama.
Dialogue: 0,0:14:39.86,0:14:40.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:14:41.44,0:14:44.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Ariane, sementara aku juga\Nakan menemani Tuan Arc...
Dialogue: 0,0:14:44.70,0:14:45.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah.
Dialogue: 0,0:14:45.70,0:14:49.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pergi saja beri tahu rekan-rekanmu\Nsoal tempat ini.
Dialogue: 0,0:14:49.24,0:14:51.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku saja yang menjaga Arc.
Dialogue: 0,0:14:51.63,0:14:53.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:14:53.00,0:14:56.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku percayakan Tuan Arc padamu.
Dialogue: 0,0:14:56.21,0:14:57.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:14:57.84,0:15:00.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat bangun desa barunya.
Dialogue: 0,0:15:38.25,0:15:42.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arc, desanya sebentar lagi selesai dibangun.
Dialogue: 0,0:15:42.01,0:15:45.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang Lalatoya juga mengkhawatirkanmu.
Dialogue: 0,0:15:45.88,0:15:48.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepatlah bangun.
Dialogue: 0,0:15:48.89,0:15:50.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang
Dialogue: 0,0:15:50.39,0:15:53.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia akan terus seperti ini?
Dialogue: 0,0:15:58.19,0:15:59.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau seperti ini,
Dialogue: 0,0:15:59.52,0:16:02.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin kita harus menggunakan cara itu.
Dialogue: 0,0:16:02.40,0:16:05.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dik Chiyome, apa kamu punya solusi?
Dialogue: 0,0:16:06.20,0:16:10.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, aku tahu ini\Ndari orang terdekatku di desa.
Dialogue: 0,0:16:11.16,0:16:14.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya, ada cara ampuh\Nuntuk situasi seperti ini.
Dialogue: 0,0:16:14.90,0:16:16.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:16:16.21,0:16:18.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bertele-tele, beri tahu aku.
Dialogue: 0,0:16:19.88,0:16:21.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengecup!
Dialogue: 0,0:16:23.67,0:16:25.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengecup Tuan Arc.
Dialogue: 0,0:16:26.26,0:16:28.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengecup?
Dialogue: 0,0:16:28.01,0:16:30.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengecup, maksudnya...
Dialogue: 0,0:16:30.26,0:16:32.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang mencium?
Dialogue: 0,0:16:34.00,0:16:36.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara apa kamu ini, Dik Chiyome?
Dialogue: 0,0:16:36.06,0:16:39.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengecup bisa membangunkan orang\Nyang tak sadarkan diri!
Dialogue: 0,0:16:39.19,0:16:43.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konon, cara itu ditemukan\Ndari catatan di berbagai zaman!
Dialogue: 0,0:16:43.32,0:16:44.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:16:44.90,0:16:46.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa logikanya?
Dialogue: 0,0:16:46.32,0:16:48.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu.
Dialogue: 0,0:16:48.36,0:16:49.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:16:49.03,0:16:53.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau dilakukan orang yang hatinya\Nsaling terhubung, pasti berhasil!
Dialogue: 0,0:16:54.12,0:16:57.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hatinya saling terhubung?
Dialogue: 0,0:16:59.46,0:17:02.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ini...
Dialogue: 0,0:17:03.34,0:17:06.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pe-Pertama kalinya untukku.
Dialogue: 0,0:17:06.96,0:17:10.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau Tuan Arc\Ntidak sadarkan diri seperti ini terus?
Dialogue: 0,0:17:10.43,0:17:13.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ponta, coba katakanlah sesuatu.
Dialogue: 0,0:17:15.39,0:17:17.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ponta juga?
Dialogue: 0,0:17:17.10,0:17:18.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantapkan hatimu!
Dialogue: 0,0:17:18.77,0:17:20.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Nona Ariane!
Dialogue: 0,0:17:24.48,0:17:26.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arc.
Dialogue: 0,0:17:29.78,0:17:31.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:17:31.32,0:17:34.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak yakin, tapi akan kucoba.
Dialogue: 0,0:17:59.31,0:18:01.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anu...
Dialogue: 0,0:18:04.90,0:18:07.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kenapa kamu bangun?
Dialogue: 0,0:18:07.15,0:18:08.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Se-Sejak kapan?
Dialogue: 0,0:18:09.74,0:18:12.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya berisik.\NLalu, saat aku membuka mata...
Dialogue: 0,0:18:12.61,0:18:14.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiba-tiba ada Nona Ariane.
Dialogue: 0,0:18:14.57,0:18:16.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai batu yang diselimuti api,
Dialogue: 0,0:18:16.78,0:18:17.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Ariane?
Dialogue: 0,0:18:17.87,0:18:20.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}serang dan binasakan musuh!
Dialogue: 0,0:18:23.25,0:18:26.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bakal jadi abu!
Dialogue: 0,0:18:27.29,0:18:28.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:18:28.63,0:18:31.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi aku tertidur selama itu?
Dialogue: 0,0:18:31.26,0:18:34.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar merepotkan, tahu.
Dialogue: 0,0:18:34.01,0:18:37.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, syukurlah sudah sadarkan diri.
Dialogue: 0,0:18:37.43,0:18:39.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah menyusahkan kalian.
Dialogue: 0,0:18:39.51,0:18:43.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Tidak menyahut, dia hanya sesosok mayat."
Dialogue: 0,0:18:43.39,0:18:45.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung kalian tidak berpikir begitu.
Dialogue: 0,0:18:45.52,0:18:47.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar.
Dialogue: 0,0:18:47.53,0:18:49.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bikin khawatir, tahu.
Dialogue: 0,0:18:51.32,0:18:53.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, maafkan aku,
Dialogue: 0,0:18:53.99,0:18:55.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Ariane.
Dialogue: 0,0:19:11.84,0:19:13.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak.
Dialogue: 0,0:19:13.07,0:19:14.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidangan khas Primus memang mantap.
Dialogue: 0,0:19:14.67,0:19:16.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kue salad nanas.
Dialogue: 0,0:19:17.55,0:19:20.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pak Pemilik, terima kasih atas makanannya.
Dialogue: 0,0:19:26.02,0:19:29.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya untuk ke Tajient\Nhanya bisa lewat darat.
Dialogue: 0,0:19:49.08,0:19:51.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengguna pedang ganda?
Dialogue: 0,0:20:05.81,0:20:06.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak berubah?
Dialogue: 0,0:20:06.89,0:20:13.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kutukanmu menjadi resistan\Nterhadap mata air ini.
Dialogue: 0,0:20:13.11,0:20:16.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Tuan Dragon Lord.
Dialogue: 0,0:20:16.05,0:20:19.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, tampaknya kondisi fisikmu sudah pulih.
Dialogue: 0,0:20:19.87,0:20:25.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atas permintaan gadis elf itu,\Naku telah memeriksa tubuhmu sekilas.
Dialogue: 0,0:20:25.61,0:20:29.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak Muda, kamu seorang pengembara, ya?
Dialogue: 0,0:20:29.35,0:20:30.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengembara?
Dialogue: 0,0:20:30.88,0:20:32.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti namanya,
Dialogue: 0,0:20:32.42,0:20:36.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pengembara dari tempat lain\Nyang bukan berasal dari sini.
Dialogue: 0,0:20:36.38,0:20:39.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dipikir-pikir memang masuk akal.
Dialogue: 0,0:20:40.30,0:20:44.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, keberadaan pengembara\Nbukanlah hal yang langka.
Dialogue: 0,0:20:44.19,0:20:45.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, Anak Muda,
Dialogue: 0,0:20:45.89,0:20:49.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di antara mereka, kamu tergolong istimewa.
Dialogue: 0,0:20:49.56,0:20:51.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya?
Dialogue: 0,0:20:52.23,0:20:56.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuhmu yang asli ada di dunia yang berbeda.
Dialogue: 0,0:20:56.90,0:21:00.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya jiwamu yang bersemayam\Ndi tubuh sekarang ini.
Dialogue: 0,0:21:01.45,0:21:06.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, dengan berendam di mata air,\Ntubuh aslimu mulai kembali.
Dialogue: 0,0:21:11.96,0:21:15.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya itu pun bukan tubuh asliku.
Dialogue: 0,0:21:15.09,0:21:17.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal itulah yang menjadi pemicunya.
Dialogue: 0,0:21:17.21,0:21:20.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sensasi dan stimulasi\Nyang kamu terima di dunia ini,
Dialogue: 0,0:21:20.34,0:21:23.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang tersimpan di tubuh sementara ini,
Dialogue: 0,0:21:23.01,0:21:26.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}secara sekaligus mengalir ke tubuh aslimu.
Dialogue: 0,0:21:26.35,0:21:28.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba pikirkan.
Dialogue: 0,0:21:28.42,0:21:32.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kekuatan sebesar itu\Ntiba-tiba mengalir sekaligus,
Dialogue: 0,0:21:32.19,0:21:34.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}wadahnya pasti akan hancur.
Dialogue: 0,0:21:34.40,0:21:35.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kata lain...
Dialogue: 0,0:21:35.69,0:21:38.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuh asliku tak mampu menahannya,
Dialogue: 0,0:21:39.11,0:21:41.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu sebabnya aku kehilangan kesadaran.
Dialogue: 0,0:21:41.88,0:21:43.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi begitu, aku paham.
Dialogue: 0,0:21:43.91,0:21:46.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Tuan Dragon Lord.
Dialogue: 0,0:21:46.37,0:21:47.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:21:49.12,0:21:53.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti mata air ini tidak bisa\Nmengembalikan tubuh asliku lagi, ya.
Dialogue: 0,0:21:54.79,0:21:57.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf mengganggu pembicaraan kalian.
Dialogue: 0,0:21:57.38,0:22:00.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa benar kamu Tuan Arc?
Dialogue: 0,0:22:02.38,0:22:05.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Tuan Goemon!
Dialogue: 0,0:22:05.12,0:22:05.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu...
Dialogue: 0,0:22:06.80,0:22:07.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia siapa?
