Dialogue: 0,0:00:54.49,0:00:58.04,sign,,0000,0000,0000,,KESATRIA TENGKORAK BERKELANA DI DUNIA LAIN\NMUSIM KEDUA
Dialogue: 0,0:14:24.01,0:14:29.01,sign,,0000,0000,0000,,EPISODE 4: ROH SANTO YANG BERKELIARAN\NDI DESA TERKUTUK
Dialogue: 0,0:23:40.02,0:23:45.03,sign,,0000,0000,0000,,SELANJUTNYA: MENGERIKAN! BAYANGAN ORANG MATI\NBERSEMBUNYI DI BAWAH TANAH
Dialogue: 0,0:23:45.03,0:23:51.41,sign,,0000,0000,0000,,#PONTASAATINIJUGASEDANGBERKELANA\NDESA LIZA? BUKAN, INI GEDUNG PERTUNJUKAN!
Dialogue: 0,0:01:18.73,0:01:22.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pikir kemampuanku\Nsudah mendekati kakak.
Dialogue: 0,0:01:22.40,0:01:25.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kalau dibandingkan\Npertama kita bertemu,
Dialogue: 0,0:01:25.73,0:01:28.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu sudah tumbuh jauh lebih kuat.
Dialogue: 0,0:02:11.74,0:02:13.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, aku Arc.
Dialogue: 0,0:02:13.86,0:02:17.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atas panggilan kakaknya Nona Ariane,\Nyaitu Nona Evin,
Dialogue: 0,0:02:17.28,0:02:19.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami akhirnya tiba di pegunungan Anetto.
Dialogue: 0,0:02:19.74,0:02:21.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut Nona Ariane,
Dialogue: 0,0:02:21.54,0:02:24.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Evin adalah pejuang\Nyang cukup tangguh.
Dialogue: 0,0:02:25.21,0:02:28.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sendiri sangat menantikan\Nbertemu dengannya, tapi...
Dialogue: 0,0:02:32.88,0:02:35.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sejak tadi kamu pikirkan?
Dialogue: 0,0:02:35.76,0:02:39.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Evin memintaku menjalankan sebuah misi.
Dialogue: 0,0:02:39.72,0:02:41.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa firasatku tidak enak.
Dialogue: 0,0:02:41.97,0:02:45.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu artinya dia sudah mengakui\Nperkembangan Nona Ariane.
Dialogue: 0,0:02:45.77,0:02:47.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga saja begitu.
Dialogue: 0,0:02:50.15,0:02:51.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Ponta?
Dialogue: 0,0:02:55.99,0:02:56.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arc!
Dialogue: 0,0:02:58.70,0:03:00.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknik pedang itu...
Dialogue: 0,0:03:00.11,0:03:00.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan!
Dialogue: 0,0:03:07.33,0:03:09.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setop!
Dialogue: 0,0:03:14.59,0:03:17.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahaya sekali,\Ndisambut dengan serangan dadakan,
Dialogue: 0,0:03:17.59,0:03:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Evin.
Dialogue: 0,0:03:20.43,0:03:22.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh, ketahuan, ya?
Dialogue: 0,0:03:23.64,0:03:25.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, apaan, sih?
Dialogue: 0,0:03:25.60,0:03:28.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, bukan itu, Dik Arin.
Dialogue: 0,0:03:28.35,0:03:30.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggil aku kakak.
Dialogue: 0,0:03:31.94,0:03:34.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, lepaskan!\NKak Evin!
Dialogue: 0,0:03:34.69,0:03:36.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibilang panggil aku kakak.
Dialogue: 0,0:03:36.99,0:03:38.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah.
Dialogue: 0,0:03:42.37,0:03:43.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu,
Dialogue: 0,0:03:43.66,0:03:46.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kenapa bisa tahu kami di Hoban?
Dialogue: 0,0:03:46.62,0:03:48.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku diberi tahu Danka.
Dialogue: 0,0:03:48.67,0:03:51.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kamu tampak kurusan?
Dialogue: 0,0:03:51.67,0:03:54.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya, sudah cukup.
Dialogue: 0,0:03:55.59,0:03:57.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknik pedangnya terasa tidak asing.
Dialogue: 0,0:03:57.84,0:04:00.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata memang mirip dengan Bu Glenys, ya.
Dialogue: 0,0:04:00.76,0:04:03.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih jauh dibanding dengan Ibu.
Dialogue: 0,0:04:03.68,0:04:06.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlepas itu, kenapa menyerang Arc?
Dialogue: 0,0:04:06.68,0:04:08.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kamu lupa?
Dialogue: 0,0:04:08.52,0:04:09.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah bilang,
Dialogue: 0,0:04:09.69,0:04:14.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahwa aku tak akan merestui pasanganmu\Nkalau lebih lemah dariku.
Dialogue: 0,0:04:14.32,0:04:15.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:04:15.40,0:04:16.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasangan?
Dialogue: 0,0:04:18.77,0:04:21.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah dengar dari Ayah dan Ibu.
Dialogue: 0,0:04:21.37,0:04:25.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya kamu banyak dibantu\Nkesatria dari kaum manusia.
Dialogue: 0,0:04:25.66,0:04:26.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu,
Dialogue: 0,0:04:26.83,0:04:30.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu mau ke mata air\Npeluluh kutukan bersamanya, kan?
Dialogue: 0,0:04:30.58,0:04:33.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pasti bukan misi resmi, kan?
Dialogue: 0,0:04:33.92,0:04:38.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma memberi tahu tentang mata air\Nsebagai tanda terima kasihku.
Dialogue: 0,0:04:38.13,0:04:40.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu juga ikut bersamanya?
Dialogue: 0,0:04:40.59,0:04:43.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia tak bisa masuk\Nke sana sendirian, kan?
Dialogue: 0,0:04:43.22,0:04:44.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ponta.
Dialogue: 0,0:04:44.39,0:04:46.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sebenarnya mereka bicarakan?
Dialogue: 0,0:04:47.73,0:04:49.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu.
Dialogue: 0,0:04:49.48,0:04:51.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tahu soal mata air itu,
Dialogue: 0,0:04:51.90,0:04:53.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak tahu kondisinya Arc?
Dialogue: 0,0:04:53.73,0:04:55.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tentu saja.
Dialogue: 0,0:05:00.57,0:05:03.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar tengkorak hidup, ya.
Dialogue: 0,0:05:03.32,0:05:05.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, halo.
Dialogue: 0,0:05:06.41,0:05:08.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, bagaimana hasilnya?
Dialogue: 0,0:05:08.54,0:05:09.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apanya?
Dialogue: 0,0:05:09.66,0:05:11.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah melawannya tadi.
Dialogue: 0,0:05:12.08,0:05:14.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa Arc juga petarung yang kuat.
Dialogue: 0,0:05:14.71,0:05:16.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau dibandingkan Kakak...
Dialogue: 0,0:05:16.46,0:05:19.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi diganggu, jadi tidak tahu.
Dialogue: 0,0:05:19.59,0:05:23.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku masih belum merestuinya\Nsebagai pasanganmu.
Dialogue: 0,0:05:24.35,0:05:26.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibilang bukan itu maksudku!
Dialogue: 0,0:05:26.51,0:05:27.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu,
Dialogue: 0,0:05:27.47,0:05:30.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kenapa aku harus minta restu Kakak?
Dialogue: 0,0:05:30.73,0:05:33.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak saja menikah dengan orang\Nyang Kakak suka.
Dialogue: 0,0:05:33.40,0:05:37.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, Nona Evin mau menikah, ya?
Dialogue: 0,0:05:37.23,0:05:39.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat atas pernikahannya.
Dialogue: 0,0:05:39.53,0:05:42.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Ariane bilang ingin\Nmenghadiahkan tudung pengantin,
Dialogue: 0,0:05:42.36,0:05:46.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kami sempat mendapatkan\Nekor Haunted Wolf.
Dialogue: 0,0:05:47.37,0:05:49.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masalahnya belum.
Dialogue: 0,0:05:49.50,0:05:51.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena ada misi, aku minta menunggu.
Dialogue: 0,0:05:51.83,0:05:54.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa calonnya tidak keberatan?
Dialogue: 0,0:05:55.79,0:05:58.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya, aku bebas melakukan apa pun.
Dialogue: 0,0:05:58.42,0:06:03.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, dia juga setuju kamu punya kamar sendiri\Ndi rumah kami nanti.
Dialogue: 0,0:06:03.38,0:06:05.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Aku tidak mau!
Dialogue: 0,0:06:05.47,0:06:07.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa aku tinggal bareng pengantin baru.
Dialogue: 0,0:06:07.89,0:06:09.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:06:09.52,0:06:11.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamar tidurnya terpisah.
Dialogue: 0,0:06:11.68,0:06:13.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, iyalah!
Dialogue: 0,0:06:15.56,0:06:18.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Evin ternyata cukup jenaka juga.
Dialogue: 0,0:06:18.65,0:06:23.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang Kakak ke sini\Ncuma ingin menguji Arc.
Dialogue: 0,0:06:23.61,0:06:25.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu tidak.
Dialogue: 0,0:06:25.53,0:06:28.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misi kali ini agak merepotkan.
Dialogue: 0,0:06:28.91,0:06:32.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, apa ada situasi khusus?
Dialogue: 0,0:06:33.25,0:06:34.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku rasa
Dialogue: 0,0:06:34.88,0:06:37.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kali ini melibatkan kelas kakap.
Dialogue: 0,0:06:38.96,0:06:40.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelaskan pada kami.
Dialogue: 0,0:06:40.42,0:06:41.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:06:42.34,0:06:44.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sebelum itu...
Dialogue: 0,0:06:46.26,0:06:47.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo,
Dialogue: 0,0:06:47.14,0:06:50.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tunjukkan pada Kakak sejauh apa\Nkemampuanmu berkembang.
Dialogue: 0,0:06:50.93,0:06:52.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan senang hati.
Dialogue: 0,0:06:56.19,0:06:57.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seranglah kapan pun kamu mau.
Dialogue: 0,0:06:58.44,0:07:00.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku tak akan segan.
Dialogue: 0,0:07:02.53,0:07:03.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah.
Dialogue: 0,0:07:03.78,0:07:05.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dik Arin hebat!
Dialogue: 0,0:07:05.53,0:07:07.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak bisa kalah.
Dialogue: 0,0:07:10.37,0:07:13.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Evin seperti telah membaca\Nsemua gerakannya.
Dialogue: 0,0:07:15.75,0:07:16.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, bukan.
Dialogue: 0,0:07:16.96,0:07:19.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Evin sudah membaca\Ngerakan Nona Ariane,
Dialogue: 0,0:07:19.75,0:07:21.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan bergerak lebih dulu.
Dialogue: 0,0:07:22.88,0:07:24.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lincah sekali!
Dialogue: 0,0:07:24.09,0:07:25.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma itu kemampuanmu?
Dialogue: 0,0:07:25.51,0:07:27.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai batu yang diselimuti api,
Dialogue: 0,0:07:27.30,0:07:28.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}serang dan binasakan musuh!
Dialogue: 0,0:07:29.89,0:07:30.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai angin,
Dialogue: 0,0:07:30.81,0:07:32.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berlarilah bersamaku!
Dialogue: 0,0:07:37.65,0:07:38.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai air,
Dialogue: 0,0:07:38.48,0:07:40.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jawablah panggilanku dan hanyutkan musuh!
Dialogue: 0,0:07:42.57,0:07:43.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Celaka!
Dialogue: 0,0:07:44.90,0:07:45.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:07:59.08,0:08:00.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih belum cukup.
Dialogue: 0,0:08:00.38,0:08:02.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Kakak memang luar biasa.
Dialogue: 0,0:08:06.55,0:08:08.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Yuriarna!
Dialogue: 0,0:08:09.47,0:08:12.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tidak bersua, Kakanda Sekt.
Dialogue: 0,0:08:12.76,0:08:14.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kamu selamat.
Dialogue: 0,0:08:14.64,0:08:16.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir tak akan bisa bertemu lagi.
Dialogue: 0,0:08:16.81,0:08:19.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagiku juga suatu kehormatan\Nbisa bertemu lagi.
Dialogue: 0,0:08:21.06,0:08:22.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dakares sialan.
Dialogue: 0,0:08:22.49,0:08:25.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tega sekali dia mencoba\Nmembunuh adiknya sendiri.
Dialogue: 0,0:08:29.82,0:08:31.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kasus kali ini,
Dialogue: 0,0:08:31.37,0:08:33.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada kemungkinan bahwa Kakanda Dakares
Dialogue: 0,0:08:33.49,0:08:36.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}telah dijadikan pion oleh Kakanda Sekt.
Dialogue: 0,0:08:38.21,0:08:40.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini aku kembalikan padamu.
Dialogue: 0,0:08:42.46,0:08:45.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat mendengar kamu dibunuh oleh Dakares,
Dialogue: 0,0:08:45.21,0:08:48.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku menyesal tidak melakukan\Npencarian lebih lanjut.
Dialogue: 0,0:08:48.34,0:08:50.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:08:50.76,0:08:53.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kalung peninggalan ibunda.
Dialogue: 0,0:08:53.14,0:08:55.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kalung ini ada pada Kakanda Dakares,
Dialogue: 0,0:08:55.77,0:08:58.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}padahal aku tidak bisa dihubungi,
Dialogue: 0,0:08:58.43,0:09:02.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}wajar saja kalau orang mengira\Naku telah terbunuh.
Dialogue: 0,0:09:02.35,0:09:05.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang jelas, syukurlah kamu baik-baik saja.
Dialogue: 0,0:09:05.11,0:09:07.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, benar sekali.
Dialogue: 0,0:09:07.99,0:09:10.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Kakanda.
Dialogue: 0,0:09:10.07,0:09:14.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang ingin aku sampaikan\Nmengenai perundingan dengan kaum elf.
Dialogue: 0,0:09:15.74,0:09:17.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah berunding dengan Tetua Agung,
Dialogue: 0,0:09:17.79,0:09:21.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Fangas dari kaum elf,
Dialogue: 0,0:09:21.47,0:09:23.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami, Kerajaan Rhoden,
Dialogue: 0,0:09:23.25,0:09:26.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}telah mendapatkan hak perdagangan prioritas.
Dialogue: 0,0:09:27.13,0:09:31.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Komoditas yang diperdagangkan\Nadalah batu sihir kesuburan.
Dialogue: 0,0:09:31.13,0:09:32.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa.
Dialogue: 0,0:09:32.51,0:09:33.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada itu,
Dialogue: 0,0:09:33.55,0:09:36.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rhoden bisa berkembang lebih pesat lagi.
Dialogue: 0,0:09:36.64,0:09:38.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengingat dirimu,
Dialogue: 0,0:09:38.43,0:09:42.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu pasti ingin memulihkan wilayah\Nyang tanahnya paling tandus dulu.
Dialogue: 0,0:09:42.60,0:09:44.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin akan ada yang menentang,
Dialogue: 0,0:09:44.91,0:09:46.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}soal itu biar kami yang mengurusnya.
Dialogue: 0,0:09:46.82,0:09:49.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Kakanda Sekt.
Dialogue: 0,0:09:50.65,0:09:53.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah percobaan pembunuhannya gagal,
Dialogue: 0,0:09:53.03,0:09:56.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia bahkan berhasil mendapatkan\Nhak perdagangan dengan kaum elf.
Dialogue: 0,0:09:56.20,0:09:59.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun,\Nyang harus kulakukan hanya satu hal.
Dialogue: 0,0:09:59.84,0:10:02.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yaitu melakukan yang terbaik\Nuntuk negeri ini.
Dialogue: 0,0:10:05.42,0:10:06.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh cerdik.
Dialogue: 0,0:10:07.63,0:10:10.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau perjanjian dagangnya terus berjalan,
Dialogue: 0,0:10:10.39,0:10:12.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rakyat bisa berpihak pada Putri Yuriarna.
Dialogue: 0,0:10:13.09,0:10:14.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu, takhta akan...
Dialogue: 0,0:10:14.72,0:10:16.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu terburu-buru.
Dialogue: 0,0:10:16.51,0:10:19.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan Yuriarna memiliki tujuan yang sama.
Dialogue: 0,0:10:19.60,0:10:23.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya demi Kerajaan Rhoden.
Dialogue: 0,0:10:27.82,0:10:31.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu masih memikirkan kekalahanmu\Ndari Nona Evin?
Dialogue: 0,0:10:31.11,0:10:33.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas buatku terpukul.
Dialogue: 0,0:10:34.07,0:10:37.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak dulu, Kakak selalu bersinar.
Dialogue: 0,0:10:39.03,0:10:42.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak aku masih kecil,
Dialogue: 0,0:10:42.12,0:10:45.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebagai pejuang,\Ndia sudah menolong banyak rekan.
Dialogue: 0,0:10:50.34,0:10:54.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pikir kemampuanku\Nsudah mendekati Kakak.
Dialogue: 0,0:10:55.01,0:10:58.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kalau dibandingkan\Npertama kita bertemu,
Dialogue: 0,0:10:58.26,0:11:00.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu sudah tumbuh jauh lebih kuat.
Dialogue: 0,0:11:01.60,0:11:02.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:11:03.43,0:11:08.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi, Nona Ariane juga sudah\Nmenyelamatkan banyak orang, kan?
Dialogue: 0,0:11:10.82,0:11:14.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang melihat perjuanganmu\Nberani menjaminnya.
Dialogue: 0,0:11:14.41,0:11:17.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banggalah akan dirimu sendiri, Nona Ariane.
Dialogue: 0,0:11:17.74,0:11:18.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arc.
Dialogue: 0,0:11:19.70,0:11:21.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:11:23.37,0:11:24.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,
Dialogue: 0,0:11:24.91,0:11:27.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pertemanan kita\Nsudah berlangsung cukup lama, ya.
Dialogue: 0,0:11:27.92,0:11:30.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perjalananku tidak untuk buru-buru.
Dialogue: 0,0:11:30.29,0:11:33.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat menikmati perjalanan\Nbersama Nona Ariane.
Dialogue: 0,0:11:35.17,0:11:37.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku harus berjuang lebih keras.
Dialogue: 0,0:11:48.98,0:11:50.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menunggu lagi, ya.
Dialogue: 0,0:11:51.69,0:11:54.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belakangan, aku sering begini.
Dialogue: 0,0:11:55.28,0:11:57.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di kaki pegunungan Anetto ini,
Dialogue: 0,0:11:57.53,0:12:00.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada sebuah desa kecil bernama Denel.
Dialogue: 0,0:12:00.91,0:12:03.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desa yang ada jauh di dalam hutan lebat.
Dialogue: 0,0:12:03.45,0:12:06.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya desanya sangat tertutup.
Dialogue: 0,0:12:06.62,0:12:09.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu tidak pernah berhubungan\Ndengan desa sekitar.
Dialogue: 0,0:12:11.75,0:12:13.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Dulu"?
Dialogue: 0,0:12:13.13,0:12:17.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama beberapa generasi,\Nyang memerintah adalah kepala desa tersebut.
Dialogue: 0,0:12:17.63,0:12:22.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beberapa tahun lalu, mereka diserang monster\Nhingga binasa semuanya.
Dialogue: 0,0:12:22.85,0:12:25.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri kepala desa yang satu-satunya selamat,
Dialogue: 0,0:12:25.35,0:12:27.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}meneruskan kedudukannya.
Dialogue: 0,0:12:27.77,0:12:31.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia dikenal baik hati bagaikan malaikat.
Dialogue: 0,0:12:32.90,0:12:34.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi.
Dialogue: 0,0:12:34.65,0:12:36.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi.
Dialogue: 0,0:12:36.74,0:12:38.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi.
Dialogue: 0,0:12:38.78,0:12:41.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak dia mulai memimpin,
Dialogue: 0,0:12:41.12,0:12:45.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}penduduk desa mulai terbuka\Ndan berinteraksi dengan orang-orang luar.
Dialogue: 0,0:12:46.37,0:12:47.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sanalah,
Dialogue: 0,0:12:48.33,0:12:53.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terdapat fasilitas tempat berlindung\Nkaum elf bernama Desa Liza.
Dialogue: 0,0:12:53.46,0:12:55.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desa Liza?
Dialogue: 0,0:12:55.63,0:12:57.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat Putri Yuriarna,
Dialogue: 0,0:12:57.55,0:13:01.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}penyelamatan dan pembebasan kaum elf\Nyang ditawan berjalan lancar, kan?
Dialogue: 0,0:13:01.60,0:13:04.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, meski sudah bebas,
Dialogue: 0,0:13:04.31,0:13:06.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka tidak bisa pulang begitu saja.
Dialogue: 0,0:13:06.77,0:13:10.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka tidak dibantu sejauh itu, ya.
Dialogue: 0,0:13:10.37,0:13:11.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedangkan di Desa Liza,
Dialogue: 0,0:13:11.94,0:13:16.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kaum elf yang di bawah perlindungannya\Ndipulangkan ke kampung halamannya.
Dialogue: 0,0:13:16.40,0:13:18.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Liza?\NApa mungkin...
Dialogue: 0,0:13:18.44,0:13:19.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:13:19.57,0:13:22.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama putri kepala desa yang selamat.
Dialogue: 0,0:13:22.43,0:13:25.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mendirikan tempat itu bersama suaminya.
Dialogue: 0,0:13:25.08,0:13:29.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kegiatan seperti itu pasti\Nmembutuhkan biaya yang cukup banyak.
Dialogue: 0,0:13:29.58,0:13:33.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sang suami katanya dulu seorang pedagang.
Dialogue: 0,0:13:33.63,0:13:38.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia datang ke Kerajaan Rhoden,\Njatuh cinta pada Liza,
Dialogue: 0,0:13:38.03,0:13:39.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan akhirnya menikah.
Dialogue: 0,0:13:40.11,0:13:42.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabarnya, dia membawa uang yang banyak
Dialogue: 0,0:13:42.63,0:13:44.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari hasil saat berdagang.
Dialogue: 0,0:13:44.68,0:13:47.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar orang yang bersemangat, ya.
Dialogue: 0,0:13:47.85,0:13:50.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, apa masalahnya?
Dialogue: 0,0:13:50.10,0:13:52.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah itu cerita yang bagus?
Dialogue: 0,0:13:52.36,0:13:54.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kalau ceritanya benar.
Dialogue: 0,0:13:54.94,0:13:58.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bilangnya mereka memulangkan\Nkaum elf dan manusia hewan.
Dialogue: 0,0:13:58.57,0:14:01.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenyataannya tak satu pun\Nyang benar-benar pulang.
Dialogue: 0,0:14:01.24,0:14:02.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:14:02.25,0:14:03.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh?
Dialogue: 0,0:14:03.20,0:14:05.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan alasan diserang di perjalanan,
Dialogue: 0,0:14:05.66,0:14:08.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau tidak tahu apa yang terjadi\Nsetelah diberangkatkan.
Dialogue: 0,0:14:08.95,0:14:10.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi sulit dibuktikan.
Dialogue: 0,0:14:10.41,0:14:11.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu...
Dialogue: 0,0:14:11.58,0:14:14.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita ke sana untuk memastikan kebenarannya.
Dialogue: 0,0:14:19.51,0:14:21.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang
Dialogue: 0,0:14:21.55,0:14:23.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di Desa Liza.
Dialogue: 0,0:14:29.85,0:14:31.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal.
Dialogue: 0,0:14:31.18,0:14:34.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Yakoff, penanggung jawab desa ini.
Dialogue: 0,0:14:34.27,0:14:37.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu sampai di sini, kalian sudah aman.
Dialogue: 0,0:14:37.27,0:14:39.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:14:39.68,0:14:44.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kami ingin pulang ke Desa Lalatoya.
Dialogue: 0,0:14:44.15,0:14:46.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti, tapi...
Dialogue: 0,0:14:46.66,0:14:50.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini ada banyak sekali\Nkaum elf dan manusia hewan.
Dialogue: 0,0:14:50.12,0:14:53.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan tinggal di sini dulu\Nsambil menunggu giliran.
Dialogue: 0,0:14:53.04,0:14:56.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Yakoff, kenapa kamu mau\Nmelakukan hal ini pada kami?
Dialogue: 0,0:14:57.50,0:14:58.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena istriku.
Dialogue: 0,0:14:59.59,0:15:01.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keinginan Liza.
Dialogue: 0,0:15:02.84,0:15:06.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan bersantai dan beristirahat\Nhingga persiapannya selesai.
Dialogue: 0,0:15:06.97,0:15:08.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pamela.
Dialogue: 0,0:15:08.16,0:15:08.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:15:08.97,0:15:12.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong antarkan mereka ke kediaman.
Dialogue: 0,0:15:12.64,0:15:14.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:15:15.81,0:15:18.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua ditangkap bersama?
Dialogue: 0,0:15:18.48,0:15:20.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti itulah.
Dialogue: 0,0:15:20.11,0:15:22.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sejak kapan di sini, Pamela?
Dialogue: 0,0:15:22.44,0:15:25.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga baru datang beberapa hari lalu.
Dialogue: 0,0:15:25.79,0:15:26.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pamela.
Dialogue: 0,0:15:27.36,0:15:29.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bart.
Dialogue: 0,0:15:30.45,0:15:31.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang baru?
Dialogue: 0,0:15:31.91,0:15:32.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:15:32.87,0:15:35.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sedang mengantar mereka.
Dialogue: 0,0:15:35.21,0:15:36.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo.
Dialogue: 0,0:15:36.25,0:15:37.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo juga.
Dialogue: 0,0:15:38.04,0:15:40.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dipanggil Tuan Yakoff.
Dialogue: 0,0:15:40.41,0:15:41.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, sampai nanti.
Dialogue: 0,0:15:41.92,0:15:42.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:15:46.33,0:15:48.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang gagah, ya.
Dialogue: 0,0:15:48.55,0:15:50.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tunanganku.
Dialogue: 0,0:15:50.18,0:15:51.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh?
Dialogue: 0,0:15:51.60,0:15:52.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat.
Dialogue: 0,0:15:52.81,0:15:56.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami kenal dari kediaman\Nyang memperbudak kami.
Dialogue: 0,0:15:56.95,0:15:59.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami berjanji hidup bersama\Nsetelah bebas nanti.
Dialogue: 0,0:15:59.98,0:16:02.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu menjadi satu-satunya\Nharapan kami hidup.
Dialogue: 0,0:16:02.95,0:16:06.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah bebas,\Nimpian kalian akan terwujud.
Dialogue: 0,0:16:06.11,0:16:07.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:16:07.40,0:16:08.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:16:09.99,0:16:12.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini ruang makan.
Dialogue: 0,0:16:14.62,0:16:16.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Pamela.
Dialogue: 0,0:16:16.41,0:16:17.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang baru?
Dialogue: 0,0:16:17.54,0:16:20.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, mereka Nona Evin dan Nona Ariane.
Dialogue: 0,0:16:20.59,0:16:21.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal.
Dialogue: 0,0:16:21.96,0:16:23.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal juga.
Dialogue: 0,0:16:23.46,0:16:25.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang di Desa Liza.
Dialogue: 0,0:16:26.26,0:16:28.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan datang ke sini,\Nkalian sudah aman.
Dialogue: 0,0:16:28.55,0:16:31.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini ada kasur empuk dan pemandian.
Dialogue: 0,0:16:31.30,0:16:32.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa.
Dialogue: 0,0:16:32.97,0:16:37.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membuat fasilitas seperti itu\Nhanya untuk orang seperti kita.
Dialogue: 0,0:16:37.21,0:16:41.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Liza benar-benar orang yang baik, ya.
Dialogue: 0,0:16:41.06,0:16:43.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya, dia sudah membantu\Nkaum elf dan manusia hewan
Dialogue: 0,0:16:43.69,0:16:47.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebelum Putri Yuriarna memberi dekretnya.
Dialogue: 0,0:16:47.28,0:16:49.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi ingin bertemu dengannya.
Dialogue: 0,0:16:52.70,0:16:54.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:16:54.79,0:16:57.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sendiri pun belum pernah\Nbertemu dengannya.
Dialogue: 0,0:16:58.71,0:17:01.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Liza sudah lama menghilang.
Dialogue: 0,0:17:01.54,0:17:03.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menghilang?
Dialogue: 0,0:17:03.17,0:17:04.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di antara kaum manusia,
Dialogue: 0,0:17:04.88,0:17:10.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}masih banyak yang tidak suka\Nkalau ada yang memihak kami, kaum elf.
Dialogue: 0,0:17:10.00,0:17:13.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumornya dia diculik\Noleh orang-orang seperti itu.
Dialogue: 0,0:17:13.80,0:17:17.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Tuan Yakoff percaya dia selamat\Ndan berada di suatu tempat.
Dialogue: 0,0:17:17.93,0:17:21.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, kami juga tidak ingin\Nmemercayai rumor itu.
Dialogue: 0,0:17:21.81,0:17:24.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja, banyak yang bilang
Dialogue: 0,0:17:24.06,0:17:27.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahwa ada hantu di depan kamar Nona Liza.
Dialogue: 0,0:17:27.31,0:17:28.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hantu?
Dialogue: 0,0:17:28.82,0:17:31.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, aku juga pernah.
Dialogue: 0,0:17:40.46,0:17:42.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kamarnya Nona Liza?
Dialogue: 0,0:17:42.60,0:17:44.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Benar.
Dialogue: 0,0:17:44.21,0:17:46.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa terasa aneh.
Dialogue: 0,0:17:46.46,0:17:48.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, entah apa.
Dialogue: 0,0:17:48.46,0:17:51.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kalian berdua merasakan sesuatu?
Dialogue: 0,0:17:51.47,0:17:53.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, bukan apa-apa.
Dialogue: 0,0:17:53.76,0:17:55.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ayo lanjut.
Dialogue: 0,0:18:08.65,0:18:10.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berasa hidup lagi.
Dialogue: 0,0:18:10.86,0:18:14.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Liza sudah berusaha membantu kaum elf.
Dialogue: 0,0:18:14.49,0:18:18.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa di tempat seperti itu ada sisi gelapnya?
Dialogue: 0,0:18:19.04,0:18:21.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlepas dari niat baik Nona Liza,
Dialogue: 0,0:18:21.29,0:18:24.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa saja ada yang ingin\Nmemanfaatkannya, kan?
Dialogue: 0,0:18:24.25,0:18:25.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu benar.
Dialogue: 0,0:18:25.79,0:18:29.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, kamu percaya cerita tentang hantu?
Dialogue: 0,0:18:29.98,0:18:31.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:18:31.38,0:18:33.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hawa aneh yang kita rasakan di kamar itu...
Dialogue: 0,0:18:33.80,0:18:35.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya apa?
Dialogue: 0,0:18:38.22,0:18:40.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita selidiki.
Dialogue: 0,0:18:43.48,0:18:46.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi hawanya terlalu lemah\Njadi tak begitu terasa.
Dialogue: 0,0:18:46.36,0:18:49.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di kamar ini pasti ada sesuatu.
Dialogue: 0,0:18:53.74,0:18:54.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkunci.
Dialogue: 0,0:18:54.74,0:18:57.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, sudah pasti.
Dialogue: 0,0:18:57.04,0:18:59.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh? Kalian berdua?
Dialogue: 0,0:18:59.49,0:19:02.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa malam-malam begini?
Dialogue: 0,0:19:02.50,0:19:05.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kami tersesat.
Dialogue: 0,0:19:06.75,0:19:08.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, tempat ini luas.
Dialogue: 0,0:19:08.71,0:19:10.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku antarkan ke kamar.
Dialogue: 0,0:19:10.21,0:19:11.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:19:11.51,0:19:12.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:19:12.67,0:19:15.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk sekarang, kita panggil Arc dulu.
Dialogue: 0,0:19:28.69,0:19:29.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak.
Dialogue: 0,0:19:29.77,0:19:31.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak sekali, ya.
Dialogue: 0,0:19:31.78,0:19:34.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pamela dan Bart tidak ada.
Dialogue: 0,0:19:34.57,0:19:35.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:19:36.11,0:19:38.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka diberangkatkan malam hari?
Dialogue: 0,0:19:38.16,0:19:40.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, ke kampung halamannya Bart.
Dialogue: 0,0:19:40.91,0:19:42.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mendadak sekali.
Dialogue: 0,0:19:42.80,0:19:44.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana cara mereka pergi?
Dialogue: 0,0:19:45.37,0:19:48.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal itu tidak ada yang tahu.
Dialogue: 0,0:19:48.00,0:19:50.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya, untuk memulangkan mereka,
Dialogue: 0,0:19:50.39,0:19:53.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami pun tidak diberi tahu demi keamanan.
Dialogue: 0,0:19:53.67,0:19:58.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi tidak ada negeri yang membebaskan\Nkaum elf selain Kerajaan Rhoden.
Dialogue: 0,0:20:05.52,0:20:06.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf menunggu.
Dialogue: 0,0:20:06.94,0:20:08.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir teleportasi jarak dekat?
Dialogue: 0,0:20:08.60,0:20:10.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata benar-benar bisa digunakan, ya.
Dialogue: 0,0:20:11.31,0:20:13.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama dalam jangkauan mataku,
Dialogue: 0,0:20:13.32,0:20:15.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa berpindah ke mana pun.
Dialogue: 0,0:20:18.28,0:20:20.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlihat seperti ini saja sudah cukup.
Dialogue: 0,0:20:21.87,0:20:23.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dimension Move.
Dialogue: 0,0:20:30.33,0:20:31.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak.
Dialogue: 0,0:20:31.32,0:20:32.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:20:32.11,0:20:34.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada hawa keberadaan dari bawah sini.
Dialogue: 0,0:20:37.72,0:20:39.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini jalan rahasianya?
Dialogue: 0,0:20:42.89,0:20:44.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangga tersembunyi?
Dialogue: 0,0:20:48.81,0:20:49.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak.
Dialogue: 0,0:20:49.81,0:20:52.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, sepertinya memang bukan hantu.
Dialogue: 0,0:20:52.79,0:20:53.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa?
Dialogue: 0,0:20:53.65,0:20:55.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada sesuatu?
Dialogue: 0,0:20:55.57,0:20:58.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak melihat apa pun.
Dialogue: 0,0:20:58.15,0:21:00.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aura Kematian.
Dialogue: 0,0:21:00.07,0:21:01.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aura Kematian?
Dialogue: 0,0:21:01.28,0:21:04.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya aku pernah mendengar kata itu.
Dialogue: 0,0:21:04.53,0:21:09.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami, kaum elf,\Nbisa melihat miasma khas Undead.
Dialogue: 0,0:21:09.29,0:21:11.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pasti sesuatu\Nyang kita rasakan kemarin.
Dialogue: 0,0:21:11.79,0:21:15.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wujud hantu yang dilihat Pamela\Njuga pasti ini.
Dialogue: 0,0:21:15.21,0:21:17.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kenapa tidak ada yang tahu?
Dialogue: 0,0:21:17.92,0:21:21.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kekuatannya dilemahkan\Noleh teknik tertentu.
Dialogue: 0,0:21:21.22,0:21:23.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau hawanya sesamar ini...
Dialogue: 0,0:21:23.01,0:21:27.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bukan kita yang sudah terlatih,\Npasti tidak akan tahu.
Dialogue: 0,0:21:27.28,0:21:29.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk sekarang, ayo kita turun ke bawah.
Dialogue: 0,0:21:29.52,0:21:30.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:21:31.02,0:21:31.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fire.
Dialogue: 0,0:21:42.11,0:21:43.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Ponta?
Dialogue: 0,0:21:46.45,0:21:48.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di depan sana ada sesuatu?
Dialogue: 0,0:21:51.04,0:21:53.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aura Kematian!\NAda sesuatu yang datang!
Dialogue: 0,0:21:57.09,0:21:58.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Aku?
Dialogue: 0,0:21:58.38,0:21:59.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin.
Dialogue: 0,0:21:59.97,0:22:01.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka Undead!
