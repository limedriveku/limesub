Dialogue: 0,0:00:11.62,0:00:12.83,sign,,0000,0000,0000,,ANGIN PUYUH
Dialogue: 0,0:00:22.63,0:00:23.50,sign,,0000,0000,0000,,TARING BATU TAJAM
Dialogue: 0,0:00:55.49,0:00:59.04,sign,,0000,0000,0000,,KESATRIA TENGKORAK BERKELANA DI DUNIA LAIN\NMUSIM KEDUA
Dialogue: 0,0:01:24.45,0:01:26.11,sign,,0000,0000,0000,,GOLEM SUPER
Dialogue: 0,0:09:22.29,0:09:24.59,sign,,0000,0000,0000,,PEMULIHAN TINGKAT TINGGI
Dialogue: 0,0:10:45.04,0:10:50.05,sign,,0000,0000,0000,,EPISODE 5: MENGERIKAN! BAYANGAN ORANG MATI\NBERSEMBUNYI DI BAWAH TANAH
Dialogue: 0,0:13:18.11,0:13:20.11,sign,,0000,0000,0000,,ELEMEN AIR: SHURIKEN AIR
Dialogue: 0,0:13:52.94,0:13:55.31,sign,,0000,0000,0000,,LARIAT ZIRAH
Dialogue: 0,0:16:07.36,0:16:10.82,sign,,0000,0000,0000,,GOLEM SUPER
Dialogue: 0,0:16:37.85,0:16:39.35,sign,,0000,0000,0000,,PEDANG PENGHAKIMAN
Dialogue: 0,0:17:31.32,0:17:34.16,sign,,0000,0000,0000,,ELEMEN AIR: TOMBAK TIRTA
Dialogue: 0,0:17:44.58,0:17:45.67,sign,,0000,0000,0000,,TARING BATU TAJAM
Dialogue: 0,0:18:07.69,0:18:08.65,sign,,0000,0000,0000,,ULAR API
Dialogue: 0,0:19:44.91,0:19:47.42,sign,,0000,0000,0000,,KERAJAAN SUCI HILK, KOTA SUCI FEHRBIO
Dialogue: 0,0:19:47.42,0:19:48.58,sign,,0000,0000,0000,,KATEDRAL AGUNG PUSAT ALSUS
Dialogue: 0,0:23:40.02,0:23:41.60,sign,,0000,0000,0000,,SELANJUTNYA:
Dialogue: 0,0:23:41.60,0:23:45.03,sign,,0000,0000,0000,,YANG TERUKIR DALAM MATA AIR RAJA NAGA\NADALAH TATANAN DUNIA INI
Dialogue: 0,0:23:45.03,0:23:47.01,sign,,0000,0000,0000,,#PONTASAATINIJUGASEDANGBERKELANA
Dialogue: 0,0:23:47.01,0:23:51.41,sign,,0000,0000,0000,,SIHIR MANIPULASI MEDAN\NDI DALAM GUA ITU SANGAT DILARANG!
Dialogue: 0,0:00:00.36,0:00:02.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, aku Arc.
Dialogue: 0,0:00:02.07,0:00:03.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang menanti kami saat menyelidiki
Dialogue: 0,0:00:03.94,0:00:05.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- fasilitas mencurigakan adalah...\N- Eh? Aku?
Dialogue: 0,0:00:06.44,0:00:08.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian, mundurlah!
Dialogue: 0,0:00:09.11,0:00:11.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bring Whirlwind!
Dialogue: 0,0:00:16.45,0:00:17.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh juga.
Dialogue: 0,0:00:17.53,0:00:18.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, Arc!
Dialogue: 0,0:00:18.75,0:00:20.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekalian sisanya!
Dialogue: 0,0:00:20.67,0:00:22.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rock Fang!
Dialogue: 0,0:00:24.25,0:00:24.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:00:24.75,0:00:25.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Arc!
Dialogue: 0,0:00:28.72,0:00:30.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng, Arc?
Dialogue: 0,0:00:30.47,0:00:33.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia pakai\Nsihir manipulasi medan di sini...
Dialogue: 0,0:01:19.64,0:01:21.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau sebesar ini,
Dialogue: 0,0:01:21.69,0:01:24.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ini Raksasa Terkuat, Golem Super!
Dialogue: 0,0:01:24.45,0:01:26.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti itulah kira-kira.
Dialogue: 0,0:01:26.11,0:01:27.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantap jiwa!
Dialogue: 0,0:02:13.99,0:02:16.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyusup?
Dialogue: 0,0:02:16.03,0:02:18.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa mereka?
Dialogue: 0,0:02:18.16,0:02:21.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya pejuang dari kaum elf.
Dialogue: 0,0:02:21.00,0:02:23.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tak perlu khawatir.
Dialogue: 0,0:02:23.62,0:02:26.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaliknya, ini justru menguntungkan kita.
Dialogue: 0,0:02:29.84,0:02:32.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sebenarnya terjadi?
Dialogue: 0,0:02:33.67,0:02:36.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Ariane, kamu tidak apa-apa?
Dialogue: 0,0:02:38.51,0:02:40.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dik Chiyome?
Dialogue: 0,0:02:41.27,0:02:43.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, jadi Tuan Arc, ya.
Dialogue: 0,0:02:43.68,0:02:46.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tertolong, terima kasih.
Dialogue: 0,0:02:46.03,0:02:47.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kenapa kamu ada di sini?
Dialogue: 0,0:02:48.05,0:02:51.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami, para Klan Jinshin,\Njuga mengetahui tentang Desa Liza,
Dialogue: 0,0:02:51.94,0:02:53.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan curiga ada yang tidak beres.
Dialogue: 0,0:02:53.86,0:02:56.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, saat aku menyusup ke sini,
Dialogue: 0,0:02:56.70,0:02:59.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku merasakan adanya aura kematian
Dialogue: 0,0:02:59.62,0:03:02.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mendengar suara kalian.
Dialogue: 0,0:03:02.87,0:03:07.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia hewan seperti Dik Chiyome juga\Nbisa merasakan aura kematian, ya.
Dialogue: 0,0:03:07.75,0:03:08.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:03:08.76,0:03:11.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun tak bisa melihatnya langsung\Nseperti kaum elf.
Dialogue: 0,0:03:11.97,0:03:13.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ponta.
Dialogue: 0,0:03:13.27,0:03:15.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu tahu di mana Arc dan Kakak?
Dialogue: 0,0:03:20.14,0:03:23.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, mereka berdua tak perlu dikhawatirkan.
Dialogue: 0,0:03:23.03,0:03:24.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita jalan saja.
Dialogue: 0,0:03:24.64,0:03:25.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:03:27.60,0:03:30.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kamu tahu sihir manipulasi\Nmedan itu memengaruhi tanah,
Dialogue: 0,0:03:30.69,0:03:34.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi tak boleh digunakan dalam gua\Natau tempat sempit?
Dialogue: 0,0:03:34.28,0:03:36.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, sebelumnya juga sama.
Dialogue: 0,0:03:36.20,0:03:38.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah diperingatkan oleh Nona Ariane.
Dialogue: 0,0:03:38.73,0:03:40.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:03:40.53,0:03:42.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu,
Dialogue: 0,0:03:42.03,0:03:44.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kenapa di tempat seperti ini ada Undead?
Dialogue: 0,0:03:46.29,0:03:48.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya perlu kita selidiki.
Dialogue: 0,0:03:51.54,0:03:54.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Nona Ariane dan Ponta baik-baik saja?
Dialogue: 0,0:03:54.30,0:03:57.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tak perlu khawatir soal Dik Arin.
Dialogue: 0,0:03:57.05,0:03:59.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya akulah yang melatih dia.
Dialogue: 0,0:03:59.43,0:04:01.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya kamu sangat memercayainya.
Dialogue: 0,0:04:01.87,0:04:06.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya, tadi aku ingin melihat\Nsudah sejauh apa dia berkembang.
Dialogue: 0,0:04:06.81,0:04:11.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, rasanya Nona Evin seperti sudah\Nmembaca semua gerakan Nona Ariane.
Dialogue: 0,0:04:11.81,0:04:14.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dik Arin itu orangnya serius.
Dialogue: 0,0:04:14.23,0:04:16.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlalu terpaku mengikuti dasar-dasar.
Dialogue: 0,0:04:16.48,0:04:19.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi ragu apa dia baik-baik saja?
Dialogue: 0,0:04:19.07,0:04:21.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi karena itu kamu ingin\Nmenjalankan misi bersama?
Dialogue: 0,0:04:21.95,0:04:22.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:04:22.91,0:04:26.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya ingin memastikan\Ntak ada serangga pengganggu.
Dialogue: 0,0:04:28.69,0:04:30.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah berpisah dengan kalian,
Dialogue: 0,0:04:30.88,0:04:34.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku kembali ke desa dan mengumpulkan\Nberbagai informasi.
Dialogue: 0,0:04:34.01,0:04:36.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, apa ada yang kamu ketahui?
Dialogue: 0,0:04:36.21,0:04:39.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria bernama Udolan itu\Nmenggunakan monster.
Dialogue: 0,0:04:39.41,0:04:42.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan ada kelompok lain\Nyang menangkap kaum elf, manusia hewan,
Dialogue: 0,0:04:42.80,0:04:45.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan manusia dengan menggunakan monster.
Dialogue: 0,0:04:46.31,0:04:50.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, mereka yang ditangkap\Ntidak dibawa ke luar negeri,
Dialogue: 0,0:04:50.11,0:04:53.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}melainkan dikumpulkan di suatu tempat\Ndi dalam Kerajaan Rhoden.
Dialogue: 0,0:04:53.86,0:04:55.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya tempat ini?
Dialogue: 0,0:04:55.27,0:04:56.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:04:56.67,0:04:58.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yakoff yang mendirikan Desa Liza,
Dialogue: 0,0:04:58.93,0:05:01.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sepertinya mantan seorang pedagang.
Dialogue: 0,0:05:01.03,0:05:02.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal itu, aku juga tahu.
Dialogue: 0,0:05:02.99,0:05:06.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sebenarnya dia pedagang\Ndari negara mana?
Dialogue: 0,0:05:06.41,0:05:10.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya, kami tidak tahu meski sudah\Ndiselidiki sedalam mungkin.
Dialogue: 0,0:05:10.03,0:05:12.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali tak ada petunjuk.
Dialogue: 0,0:05:20.59,0:05:22.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kata Tuan Fangas?
Dialogue: 0,0:05:22.51,0:05:27.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyelamatan dan pembebasan kaum elf\Ntampaknya tidak berjalan lancar.
Dialogue: 0,0:05:27.53,0:05:30.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sudah dibebaskan\Ndari para bangsawan dan pedagang,
Dialogue: 0,0:05:30.27,0:05:34.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tak lama kemudian mereka\Ndiculik kembali oleh pihak lain.
Dialogue: 0,0:05:34.36,0:05:35.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:05:35.61,0:05:38.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah ini ada hubungannya atau tidak,
Dialogue: 0,0:05:38.33,0:05:40.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ada satu hal yang mengganjalku.
Dialogue: 0,0:05:41.24,0:05:43.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu tahu Agama Hilk?
Dialogue: 0,0:05:43.32,0:05:44.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:05:44.74,0:05:49.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabarnya jumlah pengikutnya diam-diam\Nbertambah di Kerajaan Rhoden.
Dialogue: 0,0:05:49.33,0:05:53.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya, agama tersebut ajarannya\Nsangat umum,
Dialogue: 0,0:05:53.05,0:05:56.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seperti berdoa pada Tuhan\Ndan menginginkan perdamaian.
Dialogue: 0,0:05:56.34,0:05:59.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, mereka mengajarkan bahwa kaum elf
Dialogue: 0,0:05:59.35,0:06:02.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan manusia hewan adalah makhluk\Nyang hina daripada manusia.
Dialogue: 0,0:06:12.06,0:06:14.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Nona Evin?
Dialogue: 0,0:06:14.69,0:06:16.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:06:30.12,0:06:31.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa.
Dialogue: 0,0:06:31.60,0:06:32.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat apa ini?
Dialogue: 0,0:06:32.66,0:06:35.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya ini penambangan kristal sihir.
Dialogue: 0,0:06:35.25,0:06:36.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kristal sihir?
Dialogue: 0,0:06:36.38,0:06:37.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak tahu?
Dialogue: 0,0:06:37.59,0:06:39.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya selama ini kamu hidup seperti apa?
Dialogue: 0,0:06:39.92,0:06:41.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, kalau itu...
Dialogue: 0,0:06:42.67,0:06:44.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba nyalakan ini dengan api.
Dialogue: 0,0:06:50.51,0:06:51.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:06:51.56,0:06:54.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kristal sihir digunakan sebagai bahan bakar.
Dialogue: 0,0:06:55.02,0:06:56.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan jumlah sebanyak ini,
Dialogue: 0,0:06:56.73,0:07:00.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hasil jualnya pasti bisa\Nmemperkaya keuangan negara.
Dialogue: 0,0:07:04.57,0:07:06.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu, jangan berhenti!
Dialogue: 0,0:07:06.32,0:07:08.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat, kerja!
Dialogue: 0,0:07:08.45,0:07:10.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kejam sekali.
Dialogue: 0,0:07:11.20,0:07:12.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kan...
Dialogue: 0,0:07:21.21,0:07:23.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berdua ada di sini?
Dialogue: 0,0:07:23.63,0:07:24.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mengenalnya?
Dialogue: 0,0:07:24.76,0:07:26.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka elf yang hilang.
Dialogue: 0,0:07:26.30,0:07:27.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:07:29.30,0:07:31.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awas!\NRuntuh!
Dialogue: 0,0:07:39.06,0:07:40.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:07:40.98,0:07:43.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bart!
Dialogue: 0,0:07:43.53,0:07:45.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertahanlah, Bart!
Dialogue: 0,0:07:45.44,0:07:47.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ganggu!\NMinggir!
Dialogue: 0,0:07:47.03,0:07:50.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dia sudah tak tertolong.\N- Tidak, lepaskan!
Dialogue: 0,0:07:50.50,0:07:53.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dasar, padahal baru dibawa.\N- Bart!
Dialogue: 0,0:07:53.04,0:07:54.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tidak berguna.\N- Bart!
Dialogue: 0,0:07:54.41,0:07:57.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Oi, bawa dia ke tempat eksperimen!\N- Hei, sadarlah!
Dialogue: 0,0:07:57.04,0:07:58.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:08:00.88,0:08:02.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bart!
Dialogue: 0,0:08:02.96,0:08:06.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak! Bart!
Dialogue: 0,0:08:06.47,0:08:08.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka tidak bisa dimaafkan.
Dialogue: 0,0:08:08.68,0:08:10.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus segera lakukan sesuatu.
Dialogue: 0,0:08:10.80,0:08:13.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi mereka menyebut soal tempat eksperimen.
Dialogue: 0,0:08:13.18,0:08:15.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita cari tahu itu dulu.
Dialogue: 0,0:08:23.94,0:08:25.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tempat eksperimennya?
Dialogue: 0,0:08:25.53,0:08:27.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya seperti penyimpanan mayat.
Dialogue: 0,0:08:28.61,0:08:30.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Ponta!
Dialogue: 0,0:08:30.16,0:08:32.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arc! Kakak!
Dialogue: 0,0:08:32.07,0:08:33.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dik Arin?
Dialogue: 0,0:08:34.15,0:08:37.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Nona Chiyome, kamu sudah kembali?
Dialogue: 0,0:08:37.20,0:08:40.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, syukurlah Tuan Arc juga baik-baik saja.
Dialogue: 0,0:08:40.16,0:08:41.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa dia?
Dialogue: 0,0:08:41.16,0:08:44.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dik Chiyome dari Klan Jinshin.
Dialogue: 0,0:08:44.01,0:08:45.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia Kak Evin, kakakku.
Dialogue: 0,0:08:45.88,0:08:46.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Chiyome.
Dialogue: 0,0:08:46.92,0:08:48.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal.
Dialogue: 0,0:08:48.30,0:08:50.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama-sama, salam kenal juga.
Dialogue: 0,0:08:50.18,0:08:52.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar, harusnya panggil aku kakak.
Dialogue: 0,0:08:52.30,0:08:53.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya.
Dialogue: 0,0:08:53.76,0:08:55.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, ini tempat apa?
Dialogue: 0,0:08:55.89,0:08:58.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini tempat penyimpanan mayat?
Dialogue: 0,0:08:58.35,0:08:59.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak tahu.
Dialogue: 0,0:08:59.52,0:09:01.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi mereka menyebutnya tempat eksperimen.
Dialogue: 0,0:09:01.81,0:09:03.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat eksperimen?
Dialogue: 0,0:09:09.07,0:09:11.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ternyata ada yang masih hidup!
Dialogue: 0,0:09:11.16,0:09:12.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ini juga masih hidup!
Dialogue: 0,0:09:12.99,0:09:14.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang di sini juga!
Dialogue: 0,0:09:14.53,0:09:17.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya masih ada lagi yang masih hidup.
Dialogue: 0,0:09:17.04,0:09:18.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:09:20.50,0:09:22.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Over Heal!
Dialogue: 0,0:09:38.85,0:09:40.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:09:43.44,0:09:44.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin.
Dialogue: 0,0:09:44.81,0:09:47.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Arc memang bisa melakukan apa saja.
Dialogue: 0,0:09:49.15,0:09:50.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:09:50.28,0:09:51.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tertolong.
Dialogue: 0,0:09:51.65,0:09:53.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian datang menyelamatkan kami?
Dialogue: 0,0:09:53.41,0:09:55.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sebenarnya siapa?
Dialogue: 0,0:09:55.07,0:09:57.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami adalah Pejuang Maple.
Dialogue: 0,0:09:57.83,0:09:59.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sebenarnya terjadi?
Dialogue: 0,0:09:59.58,0:10:03.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya kami telah ditipu oleh Yakoff.
Dialogue: 0,0:10:05.63,0:10:06.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Ponta?
Dialogue: 0,0:10:14.97,0:10:16.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang masih hidup?
Dialogue: 0,0:10:16.39,0:10:18.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, itu Undead!
Dialogue: 0,0:10:18.26,0:10:19.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu semua ulah Yakoff!
Dialogue: 0,0:10:19.89,0:10:23.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yakoff mempekerjakan orang-orang\Ndi penambangan sampai mati.
Dialogue: 0,0:10:23.48,0:10:28.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Parahnya, dia menggunakan mayat mereka\Nuntuk eksperimen Undead.
Dialogue: 0,0:10:28.23,0:10:29.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:10:29.33,0:10:32.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya Undead yang diciptakan manusia?
Dialogue: 0,0:10:32.03,0:10:34.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, yang menyerang kita tadi itu...
Dialogue: 0,0:10:34.78,0:10:36.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar sekali.
Dialogue: 0,0:10:37.53,0:10:38.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yakoff!
Dialogue: 0,0:10:39.91,0:10:43.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang, para pejuang elf.
Dialogue: 0,0:10:52.34,0:10:53.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yakoff.
Dialogue: 0,0:10:53.59,0:10:57.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kamu memanfaatkan Desa Liza\Nuntuk mengumpulkan orang-orang.
Dialogue: 0,0:10:57.29,0:11:00.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kamu bisa menemukan\Nurat tambang sebesar ini?
Dialogue: 0,0:11:00.10,0:11:02.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat ini telah diwariskan
Dialogue: 0,0:11:02.47,0:11:07.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}oleh keluarga istriku, Liza, dan dirahasiakan\Ndari pihak keluarga kerajaan.
Dialogue: 0,0:11:07.23,0:11:08.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:11:08.61,0:11:11.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka menyelundupkan kristal sihir
Dialogue: 0,0:11:11.19,0:11:13.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan meraup kekayaan dari hasilnya.
Dialogue: 0,0:11:13.11,0:11:15.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi untuk menutupi rahasia itu,
Dialogue: 0,0:11:15.40,0:11:18.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu melarang orang-orang desa\Nberhubungan dengan orang luar?
Dialogue: 0,0:11:18.87,0:11:23.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagian warga desa juga tampaknya\Ntidak tahu tentang urat tambang ini.
Dialogue: 0,0:11:23.87,0:11:27.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, bagaimana kamu tahu\Ntentang urat tambang ini?
Dialogue: 0,0:11:27.37,0:11:29.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan aku.
Dialogue: 0,0:11:29.65,0:11:31.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu adalah jasa Beliau Yang Agung.
Dialogue: 0,0:11:31.75,0:11:33.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beliau?
Dialogue: 0,0:11:33.81,0:11:35.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beliau yang menemukannya
Dialogue: 0,0:11:35.85,0:11:38.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan memerintahkanku untuk menguasainya.
Dialogue: 0,0:11:38.89,0:11:42.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana bisa orang luar sepertimu\Ntahu desa ini?
Dialogue: 0,0:11:42.01,0:11:43.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desa terpencil di pegunungan
Dialogue: 0,0:11:43.77,0:11:47.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak mungkin bisa sepenuhnya\Nterputus dari dunia luar.
Dialogue: 0,0:11:47.52,0:11:49.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obat-obatan, peralatan,
Dialogue: 0,0:11:49.86,0:11:53.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada banyak barang\Nyang harus diperoleh dari luar.
Dialogue: 0,0:11:53.53,0:11:56.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi itu alasanmu mendekati Liza?
Dialogue: 0,0:11:56.95,0:11:59.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis desa polos yang tak tahu dunia luar.
Dialogue: 0,0:11:59.87,0:12:02.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat mudah membuatnya menurut.
Dialogue: 0,0:12:02.41,0:12:05.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memanfaatkan Liza\Nuntuk menyelidiki desa,
Dialogue: 0,0:12:05.25,0:12:07.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menemukan lokasi urat tambang,
Dialogue: 0,0:12:07.67,0:12:08.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu,
Dialogue: 0,0:12:09.29,0:12:11.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membunuh kepala desa dan lainnya,
Dialogue: 0,0:12:11.38,0:12:14.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan membuatnya seolah-olah\Nperbuatan monster.
Dialogue: 0,0:12:14.77,0:12:16.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alasanmu membiarkan Liza tetap hidup
Dialogue: 0,0:12:16.72,0:12:21.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah untuk menikahinya dan mewarisi\Nharta serta hak-hak kepala desa.
Dialogue: 0,0:12:21.13,0:12:22.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti itu, bukan?
Dialogue: 0,0:12:22.81,0:12:26.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kubilang membuat tempat perlindungan\Nuntuk kaum elf dan manusia hewan,
Dialogue: 0,0:12:26.89,0:12:30.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Liza tampak sangat gembira.
Dialogue: 0,0:12:30.31,0:12:31.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kejam sekali!
Dialogue: 0,0:12:31.44,0:12:32.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa dipercaya!
Dialogue: 0,0:12:32.77,0:12:38.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kristal sihir yang kamu dapat ini\Ndiberikan pada "Beliau" itu?
Dialogue: 0,0:12:38.01,0:12:39.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang kamu sebut "Beliau" itu?
Dialogue: 0,0:12:39.91,0:12:42.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tujuanmu sampai-sampai\Nmenciptakan Undead?
Dialogue: 0,0:12:42.83,0:12:45.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyebut namanya saja sudah lancang.
Dialogue: 0,0:12:45.91,0:12:50.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beliau adalah sosok yang bahkan orang\Nseperti kalian pun tak pantas mengetahuinya.
Dialogue: 0,0:12:50.75,0:12:51.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:12:52.33,0:12:55.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kekuatan yang memungkinkan\Nkalian menyusup ke sini,
Dialogue: 0,0:12:55.00,0:12:57.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sangat layak dijadikan bahan eksperimen.
Dialogue: 0,0:12:57.71,0:12:59.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kujadikan Undead berkualitas,
Dialogue: 0,0:12:59.85,0:13:02.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kupersembahkan pada Beliau.
Dialogue: 0,0:13:02.34,0:13:03.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:13:04.10,0:13:06.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serang dan bunuh mereka!
Dialogue: 0,0:13:06.85,0:13:10.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ubah mereka menjadi mayat\Ndan jadikan bagian dari kalian!
Dialogue: 0,0:13:14.36,0:13:16.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Undead mendengarkan perintahnya?
Dialogue: 0,0:13:16.23,0:13:17.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicaranya nanti saja!
Dialogue: 0,0:13:17.23,0:13:18.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku maju!
Dialogue: 0,0:13:18.11,0:13:20.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suiton: Mizu Shuriken!
Dialogue: 0,0:13:20.11,0:13:21.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tingkat tinggi!
Dialogue: 0,0:13:25.45,0:13:28.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai Angin, berlarilah bersamaku!
Dialogue: 0,0:13:31.87,0:13:36.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai Ibu Pertiwi, limpahkan kedamaian\Nbagi semua yang terbaring di bumi,
Dialogue: 0,0:13:36.30,0:13:38.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kembalikanlah ke tanah penuh berkah!
Dialogue: 0,0:13:45.76,0:13:46.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:13:52.94,0:13:55.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yoroi Lariat!
Dialogue: 0,0:14:02.99,0:14:04.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, apa itu?
Dialogue: 0,0:14:12.00,0:14:13.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu... Liza?
Dialogue: 0,0:14:13.75,0:14:14.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:14:14.88,0:14:18.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kamu ada di tempat seperti itu, istriku?
Dialogue: 0,0:14:18.84,0:14:21.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sempat terpikir ke mana jasadmu jatuh.
Dialogue: 0,0:14:21.42,0:14:24.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata di dalam dinding tempat eksperimen.
Dialogue: 0,0:14:24.18,0:14:27.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar kuburan yang pantas untukmu.
Dialogue: 0,0:14:30.22,0:14:33.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadinya aku mau menyerahkanmu\Npada pihak berwenang.
Dialogue: 0,0:14:33.19,0:14:35.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi amarahku tidak akan mereda!
Dialogue: 0,0:14:35.94,0:14:37.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sama, Arc.
Dialogue: 0,0:14:38.90,0:14:41.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian pikir bisa menang?
Dialogue: 0,0:14:41.11,0:14:43.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih memiliki kekuatan.
Dialogue: 0,0:14:43.53,0:14:47.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan besar yang dianugerahkan\Noleh Beliau!
Dialogue: 0,0:14:47.95,0:14:50.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Golem!
Dialogue: 0,0:15:00.88,0:15:02.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, hati-hati!
Dialogue: 0,0:15:05.72,0:15:07.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yakoff melarikan diri!
Dialogue: 0,0:15:07.09,0:15:08.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dik Chiyome, Ponta.
Dialogue: 0,0:15:08.60,0:15:10.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Evakuasi semuanya dari area tambang!
Dialogue: 0,0:15:10.97,0:15:12.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:15:12.05,0:15:14.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan mengejar Yakoff.
Dialogue: 0,0:15:14.06,0:15:14.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Baik!\N- Ya!
Dialogue: 0,0:15:37.46,0:15:39.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, cepat!
Dialogue: 0,0:15:39.07,0:15:40.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat lari!
Dialogue: 0,0:15:40.92,0:15:41.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bart!
Dialogue: 0,0:15:41.96,0:15:42.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pamela?
Dialogue: 0,0:15:42.92,0:15:44.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu selamat?
Dialogue: 0,0:15:44.26,0:15:45.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:15:48.05,0:15:49.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yakoff sialan.
Dialogue: 0,0:15:49.26,0:15:50.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke mana dia pergi?
Dialogue: 0,0:15:54.18,0:15:56.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, besar sekali!
Dialogue: 0,0:15:56.64,0:16:00.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setahuku golem itu boneka dari tanah liat.
Dialogue: 0,0:16:00.27,0:16:02.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau sebesar ini,
Dialogue: 0,0:16:02.47,0:16:04.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukan disebut boneka tanah liat lagi,
Dialogue: 0,0:16:04.57,0:16:07.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ini Raksasa Terkuat, Golem Super!
Dialogue: 0,0:16:07.36,0:16:09.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti itulah kira-kira.
Dialogue: 0,0:16:09.45,0:16:10.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantap jiwa!
Dialogue: 0,0:16:10.82,0:16:12.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara apa kamu sejak tadi?
Dialogue: 0,0:16:12.95,0:16:13.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita serang.
Dialogue: 0,0:16:13.95,0:16:14.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:16:14.62,0:16:15.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya!
Dialogue: 0,0:16:15.91,0:16:19.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai Api, bakarlah segalanya!
Dialogue: 0,0:16:22.09,0:16:23.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai Roh Air,
Dialogue: 0,0:16:23.84,0:16:27.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bangkitkan arus derasmu, telan,\Ndan hancurkan segalanya!
Dialogue: 0,0:16:31.72,0:16:33.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknik Kesatria Suci:
Dialogue: 0,0:16:35.22,0:16:37.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Judgement!
Dialogue: 0,0:16:39.35,0:16:40.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhasil!
Dialogue: 0,0:16:44.86,0:16:45.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mempan?
Dialogue: 0,0:16:45.73,0:16:47.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia masih bisa bertarung?
Dialogue: 0,0:16:50.20,0:16:54.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihatlah kekuatan yang dianugerahkan\NBeliau kepadaku!
Dialogue: 0,0:16:54.16,0:16:57.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Golem!\NHancurkan mereka hingga menjadi abu!
Dialogue: 0,0:17:01.63,0:17:04.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat!\NKalau begini...
Dialogue: 0,0:17:04.04,0:17:06.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang sudah keluar\Ndari area tambang.
Dialogue: 0,0:17:06.71,0:17:08.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Area tambang?
Dialogue: 0,0:17:09.47,0:17:10.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arc!
Dialogue: 0,0:17:10.51,0:17:12.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pancing golem itu ke urat tambang.
Dialogue: 0,0:17:12.47,0:17:13.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urat tambang?
Dialogue: 0,0:17:13.98,0:17:16.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu!\NAku mengerti!
Dialogue: 0,0:17:16.22,0:17:19.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak dan Dik Chiyome\Npadamkan api di kediaman itu.
Dialogue: 0,0:17:19.06,0:17:20.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong lakukan.
Dialogue: 0,0:17:20.05,0:17:21.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dik Arin?
Dialogue: 0,0:17:24.06,0:17:25.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:17:25.15,0:17:26.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku di sini!
Dialogue: 0,0:17:27.53,0:17:28.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai Air,
Dialogue: 0,0:17:28.65,0:17:31.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jawablah panggilanku dan hanyutkan musuh!
Dialogue: 0,0:17:31.32,0:17:34.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suiton: Suisousen!
Dialogue: 0,0:17:41.16,0:17:42.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini seharusnya aman.
Dialogue: 0,0:17:42.83,0:17:44.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rock Fang!
Dialogue: 0,0:17:55.68,0:17:57.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, Nona Ariane!
Dialogue: 0,0:17:57.22,0:17:57.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:17:58.43,0:17:59.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai Api,
Dialogue: 0,0:17:59.43,0:18:02.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanguskanlah musuh di hadapanku!
Dialogue: 0,0:18:05.65,0:18:07.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Flame Viper!
Dialogue: 0,0:18:24.67,0:18:26.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita berhasil, Arc.
Dialogue: 0,0:18:26.32,0:18:27.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:18:27.46,0:18:32.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini, masalah beres!
Dialogue: 0,0:18:34.26,0:18:35.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berhasil.
Dialogue: 0,0:18:35.80,0:18:39.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau berdua bersama Arc,\Nsemua bisa teratasi, ya?
Dialogue: 0,0:18:39.89,0:18:42.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak jadi cemburu.
Dialogue: 0,0:18:43.85,0:18:46.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Golem!\NBangkitlah!
Dialogue: 0,0:18:46.06,0:18:49.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisi orang-orang yang menentang Beliau!
Dialogue: 0,0:18:59.28,0:19:00.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!
Dialogue: 0,0:19:00.53,0:19:02.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunuh!\NBunuh mereka!
Dialogue: 0,0:19:04.08,0:19:06.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?\NKenapa diam saja?
Dialogue: 0,0:19:06.46,0:19:08.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat habisi mereka!
Dialogue: 0,0:19:11.51,0:19:13.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak mungkin.
Dialogue: 0,0:19:13.72,0:19:15.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu...
Dialogue: 0,0:19:18.26,0:19:19.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Liza!
Dialogue: 0,0:19:28.40,0:19:30.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?\NApa yang terjadi?
Dialogue: 0,0:19:48.58,0:19:53.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya Baltord telah kehilangan markas\Ndi dalam Kerajaan Rhoden.
Dialogue: 0,0:19:53.98,0:19:56.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak berdampak pada rencana.
Dialogue: 0,0:19:56.63,0:19:58.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Palurumo,
Dialogue: 0,0:19:58.03,0:20:01.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}beri tahu Charros\Nuntuk menjalankan rencananya.
Dialogue: 0,0:20:01.51,0:20:04.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, Tuan Thanatos.
Dialogue: 0,0:20:07.60,0:20:09.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat tinggal!
Dialogue: 0,0:20:09.27,0:20:10.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jaga diri, ya!
Dialogue: 0,0:20:10.48,0:20:11.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih!
Dialogue: 0,0:20:11.48,0:20:13.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Terima kasih!\N- Terima kasih banyak!
Dialogue: 0,0:20:13.90,0:20:14.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:20:14.69,0:20:17.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Terima kasih!\N- Terima kasih banyak!
Dialogue: 0,0:20:18.74,0:20:22.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya akan diantar sampai ke masing-masing\Nkampung halamannya, ya.
Dialogue: 0,0:20:22.74,0:20:23.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:20:23.70,0:20:26.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, pada akhirnya kita tetap tidak tahu
Dialogue: 0,0:20:26.58,0:20:29.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}siapa dalang di balik kejadian ini.
Dialogue: 0,0:20:29.03,0:20:31.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih ada kesempatan lain.
Dialogue: 0,0:20:31.00,0:20:33.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, apa sebenarnya yang waktu itu?
Dialogue: 0,0:20:33.92,0:20:35.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang saat-saat terakhir golem?
Dialogue: 0,0:20:35.59,0:20:37.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya ada yang aneh, ya.
Dialogue: 0,0:20:37.38,0:20:38.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih dibahas juga?
Dialogue: 0,0:20:38.84,0:20:39.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu cuma kebetulan.
Dialogue: 0,0:20:39.84,0:20:43.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Golem itu cuma kehabisan tenaga\Nlalu jatuh ke tempatnya Yakoff.
Dialogue: 0,0:20:44.93,0:20:46.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:20:46.31,0:20:47.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:20:53.15,0:20:55.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ada misi yang lain, jadi pamit di sini.
Dialogue: 0,0:20:57.07,0:20:58.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:20:58.40,0:21:00.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa lagi, Nona Evin.
Dialogue: 0,0:21:00.41,0:21:01.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dadah.
Dialogue: 0,0:21:03.20,0:21:04.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati di jalan.
Dialogue: 0,0:21:04.24,0:21:06.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Kakak!
Dialogue: 0,0:21:07.50,0:21:11.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, bagaimana hasilnya?
Dialogue: 0,0:21:11.12,0:21:13.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana apanya?
Dialogue: 0,0:21:13.54,0:21:15.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu, soal Arc.
Dialogue: 0,0:21:15.88,0:21:18.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut pandangan Kakak bagaimana?
Dialogue: 0,0:21:18.30,0:21:22.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bilang tidak tahu\Ngara-gara diganggu kamu, kan?
Dialogue: 0,0:21:22.24,0:21:23.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak pergi.
Dialogue: 0,0:21:24.35,0:21:26.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak!
Dialogue: 0,0:21:26.31,0:21:27.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar.
Dialogue: 0,0:21:28.46,0:21:31.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak sadar kalau Arc\Nsedang menahan diri.
Dialogue: 0,0:21:31.76,0:21:34.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu masih harus belajar, Dik Arin.
Dialogue: 0,0:21:34.19,0:21:38.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu, kalau dia benar-benar serius...
Dialogue: 0,0:21:39.28,0:21:41.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku harus berlatih lebih keras.
Dialogue: 0,0:21:42.20,0:21:45.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih belum rela\Nmemberikan Dik Arin kepadanya.
Dialogue: 0,0:21:50.29,0:21:51.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kalian bicarakan?
Dialogue: 0,0:21:51.87,0:21:54.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak, bukan apa-apa.
Dialogue: 0,0:21:54.71,0:21:56.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, kita juga pergi.
Dialogue: 0,0:21:56.85,0:21:57.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:21:57.84,0:22:00.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi kita sudah memutar terlalu jauh.
Dialogue: 0,0:22:00.09,0:22:00.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:22:00.88,0:22:02.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, kalau begitu...
Dialogue: 0,0:22:03.51,0:22:06.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya berangkat\Nke mata air peluluh kutukan!
