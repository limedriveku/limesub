Dialogue: 0,0:02:49.48,0:02:53.03,sign,,0000,0000,0000,,KESATRIA TENGKORAK BERKELANA DI DUNIA LAIN\NMUSIM KEDUA
Dialogue: 0,0:06:32.04,0:06:33.96,sign,,0000,0000,0000,,PEMULIHAN TINGKAT TINGGI
Dialogue: 0,0:12:28.60,0:12:30.02,sign,,0000,0000,0000,,SHIDEN
Dialogue: 0,0:13:43.01,0:13:48.02,sign,,0000,0000,0000,,EPISODE 10: KEJAM! MENGEJAR KAKAK ANGKAT\NSAMBIL MENAHAN AIR MATA
Dialogue: 0,0:17:30.95,0:17:32.82,sign,,0000,0000,0000,,PEDANG PENGHAKIMAN
Dialogue: 0,0:23:39.98,0:23:44.99,sign,,0000,0000,0000,,SELANJUTNYA: PERTARUNGAN BERDARAH!\NGUGUR DI KOTA YANG HANCUR
Dialogue: 0,0:23:44.99,0:23:51.41,sign,,0000,0000,0000,,#PONTASAATINIJUGASEDANGBERKELANA\NKELIHATANNYA LEBIH NYAMAN DARIPADA DRIFTPUS!
Dialogue: 0,0:00:09.51,0:00:11.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sudah sangat parah!
Dialogue: 0,0:00:11.62,0:00:15.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita serang Jamiant sambil selamatkan\Nyang belum melarikan diri.
Dialogue: 0,0:00:15.29,0:00:16.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti!
Dialogue: 0,0:00:16.32,0:00:19.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!\NLindungi desa dengan sekuat tenaga!
Dialogue: 0,0:00:19.33,0:00:21.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:00:24.00,0:00:27.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai Api, yang melahap semuanya,\Nbakarlah segalanya!
Dialogue: 0,0:00:30.74,0:00:33.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suiton: Suisousen!
Dialogue: 0,0:00:35.22,0:00:37.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wyvern Slash!
Dialogue: 0,0:00:53.53,0:00:55.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Situasinya?
Dialogue: 0,0:00:55.04,0:00:57.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bagus.
Dialogue: 0,0:00:57.12,0:01:00.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jamiant itu sangat tangguh.
Dialogue: 0,0:01:04.17,0:01:05.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ponta!
Dialogue: 0,0:01:11.59,0:01:13.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Ponta?
Dialogue: 0,0:01:14.60,0:01:17.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada sesuatu di dalam kantung itu?
Dialogue: 0,0:01:18.27,0:01:20.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baunya busuk sekali.
Dialogue: 0,0:01:24.36,0:01:27.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah tak bernyawa.\NApa ini?
Dialogue: 0,0:01:27.28,0:01:29.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini anak Jamiant.
Dialogue: 0,0:01:29.86,0:01:34.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini sebabnya para Jamiant\Nmenyerang permukiman?
Dialogue: 0,0:01:34.78,0:01:37.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membunuh anak mereka\Ndan menjadikannya umpan.
Dialogue: 0,0:01:37.79,0:01:39.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang melakukannya?
Dialogue: 0,0:01:45.88,0:01:47.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Arc.
Dialogue: 0,0:01:49.96,0:01:51.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengguna pedang ganda?
Dialogue: 0,0:01:51.39,0:01:54.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu artinya, dia yang menyerang Tuan Danka.
Dialogue: 0,0:01:55.64,0:01:57.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia diselimuti Aura Kematian.
Dialogue: 0,0:01:57.85,0:01:59.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak salah lagi.
Dialogue: 0,0:02:05.52,0:02:06.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku datang membantu!
Dialogue: 0,0:02:06.69,0:02:07.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga!
Dialogue: 0,0:02:07.69,0:02:10.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pas sekali, Dik Chiyome, Tsubone!
Dialogue: 0,0:02:13.20,0:02:16.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu lawan empat.\NKita pasti menang.
Dialogue: 0,0:02:16.24,0:02:20.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Ariane, pernyataan seperti itu\Nbiasanya pertanda buruk.
Dialogue: 0,0:02:20.62,0:02:22.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertanda buruk apa?
Dialogue: 0,0:02:24.71,0:02:26.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Telinga hewan?
Dialogue: 0,0:02:26.88,0:02:28.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin.
Dialogue: 0,0:02:28.04,0:02:30.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Chiyome, ada apa?
Dialogue: 0,0:02:30.60,0:02:31.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:02:31.85,0:02:33.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tsubone?
Dialogue: 0,0:03:13.05,0:03:14.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiarap.
Dialogue: 0,0:03:14.31,0:03:15.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duduk.
Dialogue: 0,0:03:16.18,0:03:17.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ulurkan tangan.
Dialogue: 0,0:03:17.68,0:03:19.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shiden memang pintar.
Dialogue: 0,0:03:19.30,0:03:21.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak pintar, anak pintar.
Dialogue: 0,0:04:07.19,0:04:09.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, aku Arc.
Dialogue: 0,0:04:09.52,0:04:12.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang menyelamatkan\Nmanusia hewan dari para Jamiant
Dialogue: 0,0:04:12.44,0:04:15.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang saat ini ada di hadapan kami adalah...
Dialogue: 0,0:04:15.00,0:04:18.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Sasuke?
Dialogue: 0,0:04:19.61,0:04:21.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Chiyome, kamu bicara apa?
Dialogue: 0,0:04:24.89,0:04:27.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak...
Dialogue: 0,0:04:27.21,0:04:28.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenanglah, Chiyome!
Dialogue: 0,0:04:28.96,0:04:31.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perhatikan!\NDia sudah bukan Sasuke lagi!
Dialogue: 0,0:04:31.46,0:04:33.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia Undead!
Dialogue: 0,0:04:55.94,0:04:57.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat!
Dialogue: 0,0:05:04.74,0:05:05.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak!
Dialogue: 0,0:05:06.54,0:05:08.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Chiyome!
Dialogue: 0,0:05:09.71,0:05:11.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chiyome!
Dialogue: 0,0:05:18.59,0:05:20.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Kakak!
Dialogue: 0,0:05:21.97,0:05:23.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah bangun?
Dialogue: 0,0:05:24.76,0:05:25.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak!
Dialogue: 0,0:05:26.35,0:05:28.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, seperti itu.
Dialogue: 0,0:05:28.06,0:05:30.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus berlatih dan tingkatkan akurasimu.
Dialogue: 0,0:05:30.27,0:05:31.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Sasuke!
Dialogue: 0,0:05:33.02,0:05:36.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat atas penobatan gelar Enam Ninja,\NKak Rowe.
Dialogue: 0,0:05:36.52,0:05:38.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, bukan, Tuan Sasuke.
Dialogue: 0,0:05:38.78,0:05:40.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:05:42.49,0:05:44.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sasuke...
Dialogue: 0,0:05:44.99,0:05:46.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Rowe!
Dialogue: 0,0:05:55.79,0:05:57.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak?
Dialogue: 0,0:06:14.94,0:06:19.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kak Rowe.
Dialogue: 0,0:06:27.78,0:06:28.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Chiyome!
Dialogue: 0,0:06:32.04,0:06:33.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Over Heal!
Dialogue: 0,0:06:36.17,0:06:37.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:06:39.34,0:06:41.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang akan dia lakukan?
Dialogue: 0,0:06:50.18,0:06:51.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:06:51.22,0:06:52.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku?
Dialogue: 0,0:06:52.31,0:06:53.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan!
Dialogue: 0,0:07:00.02,0:07:01.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka ke permukiman?
Dialogue: 0,0:07:01.61,0:07:03.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini mereka menyuruh Undead\Nuntuk menyerang.
Dialogue: 0,0:07:03.90,0:07:05.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ariane, kamu urus mereka!
Dialogue: 0,0:07:05.61,0:07:06.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:07:09.24,0:07:11.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Futon: Kaze Rougoku.
Dialogue: 0,0:07:18.92,0:07:20.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang itu...
Dialogue: 0,0:07:35.77,0:07:39.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak salah lagi,\Nyang menyerang Danka adalah Sasuke.
Dialogue: 0,0:07:40.19,0:07:43.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Sasuke menjadi Undead?
Dialogue: 0,0:07:43.11,0:07:47.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, sepertinya dia juga\Nyang mengendalikan Undead lainnya.
Dialogue: 0,0:07:47.74,0:07:48.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:07:48.85,0:07:50.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pendan itu...
Dialogue: 0,0:07:51.95,0:07:56.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat mirip seperti yang dimiliki\Nsi anak bengal dan Yakoff.
Dialogue: 0,0:07:57.33,0:07:58.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di Desa Denel,
Dialogue: 0,0:07:58.75,0:08:02.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada orang yang melakukan\Neksperimen menciptakan Undead.
Dialogue: 0,0:08:02.17,0:08:06.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya, merekalah\Nyang menjadikan Sasuke Undead?
Dialogue: 0,0:08:06.17,0:08:07.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:08:07.38,0:08:11.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku merasa Tuan Sasuke berbeda\Ndari Undead yang ada di Desa Denel.
Dialogue: 0,0:08:11.85,0:08:13.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:08:13.18,0:08:16.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu mereka lebih seperti binatang.
Dialogue: 0,0:08:16.31,0:08:18.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seolah bergerak hanya berdasarkan naluri.
Dialogue: 0,0:08:18.97,0:08:20.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:08:20.10,0:08:25.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti mengamuk karena diperintah tuannya,\Ntanpa mengerti apa pun yang dilakukan.
Dialogue: 0,0:08:25.00,0:08:26.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:08:26.36,0:08:29.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tindakan Tuan Sasuke\Nseperti memiliki kecerdasan.
Dialogue: 0,0:08:29.82,0:08:31.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bahkan menggunakan ninjutsu.
Dialogue: 0,0:08:31.91,0:08:35.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mungkin dia masih memiliki kesadaran?
Dialogue: 0,0:08:36.25,0:08:38.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak mungkin.
Dialogue: 0,0:08:38.15,0:08:39.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chiyome?
Dialogue: 0,0:08:39.41,0:08:41.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah sadar?\NKamu tidak apa-apa?
Dialogue: 0,0:08:41.78,0:08:45.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknik itu memang milik Kak Sasuke.
Dialogue: 0,0:08:45.80,0:08:48.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku bisa merasakannya.
Dialogue: 0,0:08:48.88,0:08:50.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tatapan mata itu...
Dialogue: 0,0:08:53.80,0:08:57.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukanlah Kakak.
Dialogue: 0,0:08:58.35,0:09:00.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga berpikir begitu.
Dialogue: 0,0:09:00.15,0:09:02.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wujudnya memang Sasuke,
Dialogue: 0,0:09:02.43,0:09:04.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sekarang dia hanyalah Undead.
Dialogue: 0,0:09:04.82,0:09:07.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, bagaimana denganmu, Dik Chiyome?
Dialogue: 0,0:09:22.58,0:09:24.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Ariane.
Dialogue: 0,0:09:25.46,0:09:28.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kaum elf dan Tuan Arc memiliki sihir
Dialogue: 0,0:09:28.35,0:09:31.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang bisa mengembalikan Undead\Nke wujud semula?
Dialogue: 0,0:09:31.63,0:09:35.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menghidupkan orang mati adalah ranah Tuhan.
Dialogue: 0,0:09:35.26,0:09:38.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya, hal seperti itu\Ntidak memungkinkan.
Dialogue: 0,0:09:38.35,0:09:40.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arc juga pernah bilang tidak bisa.
Dialogue: 0,0:09:40.98,0:09:42.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:09:43.15,0:09:46.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku tidak bisa membantu.
Dialogue: 0,0:09:46.29,0:09:49.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, terima kasih.
Dialogue: 0,0:09:49.03,0:09:52.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mendengar itu, kini tekadku sudah bulat.
Dialogue: 0,0:09:52.15,0:09:53.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:09:53.53,0:09:57.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada pilihan selain kita berdua\Nyang menghentikan Sasuke.
Dialogue: 0,0:09:57.66,0:09:59.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:09:59.48,0:10:02.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah aturan kami sebagai Enam Ninja.
Dialogue: 0,0:10:02.72,0:10:03.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aturan?
Dialogue: 0,0:10:03.91,0:10:06.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak ditunjuk sebagai Enam Ninja,
Dialogue: 0,0:10:06.17,0:10:11.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami memiliki tugas untuk mengeksekusi\Nanggota lain yang jatuh ke jalan sesat.
Dialogue: 0,0:10:11.72,0:10:14.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Tsubone dari Enam Ninja.
Dialogue: 0,0:10:14.05,0:10:17.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Chiyome dari Enam Ninja.
Dialogue: 0,0:10:24.40,0:10:27.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini peta daerah sekitar sini.
Dialogue: 0,0:10:27.31,0:10:30.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanda silang di tempat ini
Dialogue: 0,0:10:30.19,0:10:32.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah permukiman yang diserang Jamiant.
Dialogue: 0,0:10:32.82,0:10:37.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak salah lagi bahwa Tuan Sasuke\Nyang menggiring para Jamiant,
Dialogue: 0,0:10:37.88,0:10:40.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi untuk apa?
Dialogue: 0,0:10:41.83,0:10:43.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat ini...
Dialogue: 0,0:10:46.29,0:10:48.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sudah tahu tujuan para Jamiant?
Dialogue: 0,0:10:48.79,0:10:50.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih tepatnya,
Dialogue: 0,0:10:50.34,0:10:54.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tujuan dari orang-orang\Nyang memanfaatkan Jamiant.
Dialogue: 0,0:10:54.23,0:10:56.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya?
Dialogue: 0,0:10:56.01,0:10:57.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti yang dilaporkan,
Dialogue: 0,0:10:57.72,0:11:00.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami menduga para Undead\Nmenggunakan jasad anak-anak,
Dialogue: 0,0:11:00.06,0:11:03.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk memancing dan menggiring para Jamiant.
Dialogue: 0,0:11:03.31,0:11:06.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menyusuri permukiman yang diserang,
Dialogue: 0,0:11:06.69,0:11:08.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ujung dari tujuan mereka adalah...
Dialogue: 0,0:11:09.48,0:11:11.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tajient?
Dialogue: 0,0:11:11.32,0:11:16.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu kenapa Jamiant dipakai\Nuntuk menyerang kota kaum manusia.
Dialogue: 0,0:11:16.11,0:11:20.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bagi kita, mungkin ini\Nbisa jadi kesempatan emas.
Dialogue: 0,0:11:20.83,0:11:23.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di benua selatan ini,
Dialogue: 0,0:11:23.00,0:11:25.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebagian besar wilayahnya dikuasai\NKerajaan Agung Fobnach
Dialogue: 0,0:11:25.83,0:11:28.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang diperintah kaum manusia hewan.
Dialogue: 0,0:11:28.08,0:11:30.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tajient satu-satunya wilayah
Dialogue: 0,0:11:30.54,0:11:35.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang dikuasai oleh kaum manusia,\NKekaisaran Revlon dari Barat.
Dialogue: 0,0:11:35.97,0:11:39.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sana ada banyak rekan kami yang ditawan.
Dialogue: 0,0:11:39.80,0:11:41.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:11:41.64,0:11:44.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kota itu dikelilingi tembok kokoh\Ndan pertahanannya sangat kuat,
Dialogue: 0,0:11:44.81,0:11:47.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang membuat kami tak bisa\Nmelakukan penyelamatan.
Dialogue: 0,0:11:47.98,0:11:51.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kita memanfaatkan kekacauan\Nsaat Jamiant menyerang...
Dialogue: 0,0:11:51.75,0:11:54.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinan kaum elf juga ada yang ditangkap.
Dialogue: 0,0:11:54.53,0:11:56.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi aku juga akan ikut.
Dialogue: 0,0:11:56.24,0:11:57.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan kalian?
Dialogue: 0,0:11:57.85,0:11:59.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan Chiyome juga ikut.
Dialogue: 0,0:11:59.96,0:12:00.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:12:00.74,0:12:02.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena di sana ada Kak Sasuke...
Dialogue: 0,0:12:02.91,0:12:06.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku, mungkin Undead itu\Nada di sana juga.
Dialogue: 0,0:12:06.00,0:12:07.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami juga.
Dialogue: 0,0:12:07.21,0:12:10.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kami akan ikut sebagai bantuan\NNona Chiyome dan lainnya.
Dialogue: 0,0:12:10.50,0:12:13.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Ariane, Tuan Arc.
Dialogue: 0,0:12:13.21,0:12:15.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:12:19.59,0:12:21.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, persiapannya sudah selesai.
Dialogue: 0,0:12:21.72,0:12:23.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami mengandalkanmu, Shiden.
Dialogue: 0,0:12:24.77,0:12:26.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shide...\NApa?
Dialogue: 0,0:12:26.98,0:12:28.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya Shiden.
Dialogue: 0,0:12:30.02,0:12:33.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya seperti ada yang kurang\Nkalau tanpa nama.
Dialogue: 0,0:12:33.11,0:12:35.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan, Shiden?
Dialogue: 0,0:12:35.00,0:12:37.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kapan kamu memberinya nama?
Dialogue: 0,0:12:37.37,0:12:39.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan hanya nama saja.
Dialogue: 0,0:12:39.11,0:12:40.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiarap.
Dialogue: 0,0:12:41.37,0:12:42.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duduk.
Dialogue: 0,0:12:43.12,0:12:44.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ulurkan tangan.
Dialogue: 0,0:12:46.48,0:12:48.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shiden memang pintar.
Dialogue: 0,0:12:48.08,0:12:49.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak pintar, anak pintar.
Dialogue: 0,0:12:50.75,0:12:52.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shiden!\NHentikan!
Dialogue: 0,0:12:52.54,0:12:56.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hei, jangan! Shiden! Buka mulutmu!\N- Jangan salahkan aku kalau dia makin menempel.
Dialogue: 0,0:12:56.13,0:12:58.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini, akan kupakai alat rahasiaku!
Dialogue: 0,0:12:58.92,0:13:00.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Alat penembus dinding!\N- Dik Chiyome.
Dialogue: 0,0:13:00.72,0:13:02.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Alat penembus dinding!\N- Kamu sungguh baik-baik saja?
Dialogue: 0,0:13:02.14,0:13:04.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Alat penembus dinding!\N- Tak perlu memaksakan diri.
Dialogue: 0,0:13:04.18,0:13:08.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyawaku pernah diselamatkan Kak Sasuke.
Dialogue: 0,0:13:08.39,0:13:11.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak masuk desa, aku diajari ninjutsu.
Dialogue: 0,0:13:11.31,0:13:15.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memperlakukanku dengan penuh kasih,\Nseperti adiknya sendiri.
Dialogue: 0,0:13:16.65,0:13:20.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, aku ingin menyelesaikannya\Ndengan tanganku sendiri.
Dialogue: 0,0:13:22.36,0:13:23.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Chiyome.
Dialogue: 0,0:13:26.24,0:13:27.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berangkat!
Dialogue: 0,0:13:52.94,0:13:55.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah waktunya kita mulai
Dialogue: 0,0:13:56.40,0:13:59.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membawa kekacauan pada dunia ini.
Dialogue: 0,0:14:01.82,0:14:05.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah ajaran Hilk.
Dialogue: 0,0:14:05.66,0:14:08.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuhan akan membebaskan kita
Dialogue: 0,0:14:08.79,0:14:12.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari rasa takut akan kematian.
Dialogue: 0,0:14:12.05,0:14:14.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita berdoa dan percaya kepada-Nya.
Dialogue: 0,0:14:20.63,0:14:22.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mudah sekali, ya.
Dialogue: 0,0:14:22.88,0:14:27.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para pengikut setiap hari membawa\Nberbagai macam persembahan.
Dialogue: 0,0:14:27.22,0:14:31.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan mengatasnamakan Tuhan,\Napa pun akan mereka lakukan.
Dialogue: 0,0:14:34.59,0:14:38.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya jadi sayang kalau dimusnahkan.
Dialogue: 0,0:14:38.19,0:14:42.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Tuan Thanatos ke sini,\Nmungkin beliau akan berubah pikiran?
Dialogue: 0,0:14:42.74,0:14:46.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau menentang perintah Bapa Paus?
Dialogue: 0,0:14:47.32,0:14:49.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, menurut laporan,
Dialogue: 0,0:14:49.99,0:14:53.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}belakangan jumlah manusia hewan\Nyang ditangkap ternyata tidak cocok.
Dialogue: 0,0:14:54.21,0:14:56.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terlalu banyak makan.
Dialogue: 0,0:14:58.71,0:15:01.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak berniat menentang Bapa Paus.
Dialogue: 0,0:15:01.46,0:15:05.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya menjalankan perintah\Ndengan caraku sendiri.
Dialogue: 0,0:15:05.88,0:15:09.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku kita tidak bisa\Nbersantai-santai seperti itu.
Dialogue: 0,0:15:13.43,0:15:14.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:15:14.73,0:15:16.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hasilnya memuaskan.
Dialogue: 0,0:15:17.59,0:15:21.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya dia itu subjek eksperimen\Nyang cukup menjanjikan.
Dialogue: 0,0:15:30.41,0:15:32.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada Jamiant!
Dialogue: 0,0:15:46.47,0:15:50.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini awal dari panggung kehancuran Tajient.
Dialogue: 0,0:15:50.05,0:15:52.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?\NSudah dimulai?
Dialogue: 0,0:15:52.72,0:15:54.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat sekali!
Dialogue: 0,0:15:54.27,0:15:57.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini juga bimbingan dari Bapa Paus.
Dialogue: 0,0:15:57.31,0:16:00.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan meminjam para subjek\Neksperimen di bawah tanah.
Dialogue: 0,0:16:01.02,0:16:05.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga sebaiknya bekerjalah\Nsebaik mungkin demi Bapa Paus.
Dialogue: 0,0:16:09.82,0:16:11.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:16:11.03,0:16:13.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada Jamiant di kota?
Dialogue: 0,0:16:13.00,0:16:14.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi?
Dialogue: 0,0:16:14.79,0:16:16.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat mengungsi!
Dialogue: 0,0:16:16.21,0:16:18.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jamiant sedang menuju ke arah sini!
Dialogue: 0,0:16:28.26,0:16:29.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kembali, ya?
Dialogue: 0,0:16:29.89,0:16:31.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulailah.
Dialogue: 0,0:16:43.57,0:16:44.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:16:45.23,0:16:46.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Undead?
Dialogue: 0,0:16:46.65,0:16:48.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa datang dari gereja?
Dialogue: 0,0:16:52.78,0:16:55.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, pantatku.
Dialogue: 0,0:16:55.49,0:16:57.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak apa-apa, Nona Ariane?
Dialogue: 0,0:16:57.33,0:17:00.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau pantatnya dirapalkan heal?
Dialogue: 0,0:17:00.12,0:17:02.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau mau dipasang jarum?
Dialogue: 0,0:17:02.11,0:17:03.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, terima kasih.
Dialogue: 0,0:17:03.38,0:17:05.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tajient masih jauh?
Dialogue: 0,0:17:06.38,0:17:09.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat!\NJangan-jangan, itu Tajient?
Dialogue: 0,0:17:09.30,0:17:11.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya sudah diserang para Jamiant.
Dialogue: 0,0:17:11.89,0:17:13.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo bergegas, Shiden!
Dialogue: 0,0:17:25.69,0:17:27.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknik kesatria suci:
Dialogue: 0,0:17:27.81,0:17:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Judgement!
Dialogue: 0,0:17:34.91,0:17:36.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Undead?
Dialogue: 0,0:17:36.12,0:17:38.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mereka di sini, berarti...
Dialogue: 0,0:17:38.16,0:17:40.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin Sasuke ada di sini.
Dialogue: 0,0:17:40.25,0:17:42.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan hanya membawa Jamiant ke sini,
Dialogue: 0,0:17:42.25,0:17:44.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}para Undead pun dibuat mengamuk.
Dialogue: 0,0:17:44.88,0:17:48.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya mereka ingin mengacaukan kota ini.
Dialogue: 0,0:17:48.67,0:17:51.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan menjalankan operasi penyelamatan.
Dialogue: 0,0:17:51.73,0:17:54.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan mencari Sasuke.
Dialogue: 0,0:17:54.05,0:17:56.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, berhati-hatilah.
Dialogue: 0,0:17:56.35,0:17:59.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian juga, semoga beruntung.
Dialogue: 0,0:17:59.43,0:18:00.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar!
Dialogue: 0,0:18:00.64,0:18:02.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menyakiti orang tanpa alasan!
Dialogue: 0,0:18:02.64,0:18:04.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fokus membebaskan rekan sesama
Dialogue: 0,0:18:04.73,0:18:06.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan singkirkan mereka yang menghalangi!
Dialogue: 0,0:18:06.90,0:18:07.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Baik!\N- Siap!
Dialogue: 0,0:18:07.77,0:18:10.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Dik Chiyome, Tsubone.
Dialogue: 0,0:18:10.78,0:18:11.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:18:25.21,0:18:27.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian semua sudah mati.
Dialogue: 0,0:18:34.38,0:18:37.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu ke dalam,\Nkondisinya jauh lebih parah, ya.
Dialogue: 0,0:18:37.26,0:18:40.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mencari satu orang di kekacauan ini?
Dialogue: 0,0:18:40.10,0:18:42.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya, kita harus mencarinya!
Dialogue: 0,0:18:44.35,0:18:45.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!
Dialogue: 0,0:18:45.60,0:18:47.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka terus berdatangan!
Dialogue: 0,0:18:51.86,0:18:53.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elf dan manusia harimau...
Dialogue: 0,0:18:53.82,0:18:55.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membantu kita?
Dialogue: 0,0:18:55.49,0:18:56.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:18:56.70,0:18:57.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya?
Dialogue: 0,0:18:57.70,0:19:00.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana para manusia hewan\Ndan elf yang ditawan?
Dialogue: 0,0:19:01.58,0:19:03.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}So-Soal itu...
Dialogue: 0,0:19:03.21,0:19:03.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katakan!
Dialogue: 0,0:19:03.91,0:19:05.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik!
Dialogue: 0,0:19:07.75,0:19:08.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:19:09.92,0:19:10.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tsubone!
Dialogue: 0,0:19:10.93,0:19:11.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:19:12.17,0:19:13.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai api,
Dialogue: 0,0:19:13.34,0:19:16.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selimuti pedangku, terjang dan meledaklah!
Dialogue: 0,0:19:21.14,0:19:22.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat, pergilah.
Dialogue: 0,0:19:22.18,0:19:23.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik!
Dialogue: 0,0:19:23.39,0:19:25.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:19:33.90,0:19:37.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua ini juga karena Kak Sasuke?
Dialogue: 0,0:19:39.87,0:19:41.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:19:45.14,0:19:47.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chiyome, cahaya itu!
Dialogue: 0,0:19:47.83,0:19:48.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tsubone!
Dialogue: 0,0:19:50.96,0:19:53.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Chiyome, Nona Tsubone!
Dialogue: 0,0:19:57.84,0:19:59.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia harimau, ya.
Dialogue: 0,0:20:00.01,0:20:03.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peduli dengan sesama\Nadalah hal yang merepotkan.
Dialogue: 0,0:20:08.69,0:20:10.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisanya kuserahkan padamu.
Dialogue: 0,0:20:36.84,0:20:40.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Sasuke sudah ketemu.
Dialogue: 0,0:20:45.22,0:20:45.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arc!
Dialogue: 0,0:20:45.99,0:20:46.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:20:46.56,0:20:48.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dik Chiyome!\NTsubone!
Dialogue: 0,0:20:49.44,0:20:54.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Klan Jinshin dan pejuang elf, ya.
Dialogue: 0,0:20:54.09,0:20:56.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kamu yang membuat Sasuke\Nmenjadi Undead?
Dialogue: 0,0:20:57.47,0:20:58.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sasuke?
Dialogue: 0,0:20:58.74,0:21:02.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, maksudnya boneka ini?
Dialogue: 0,0:21:02.20,0:21:03.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boneka?
Dialogue: 0,0:21:06.37,0:21:09.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari pakaianmu, kamu orang gereja, ya?
Dialogue: 0,0:21:09.65,0:21:12.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi rasanya bukan sekadar pendeta biasa.
Dialogue: 0,0:21:12.42,0:21:15.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian pikir aku akan\Nmenjawab pertanyaan itu?
Dialogue: 0,0:21:15.75,0:21:17.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bicara begitu.
Dialogue: 0,0:21:18.22,0:21:19.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong beri tahu aku.
Dialogue: 0,0:21:19.88,0:21:23.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tertarik padamu.
Dialogue: 0,0:21:23.68,0:21:27.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, siapa dan dari mana asalmu?
Dialogue: 0,0:21:28.56,0:21:32.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri tahu.
Dialogue: 0,0:21:32.81,0:21:36.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Palurumo Avaritia Liberalitas.
Dialogue: 0,0:21:36.65,0:21:39.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah satu Tujuh Kardinal Gereja Hilk.
Dialogue: 0,0:21:41.78,0:21:43.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gereja Hilk?
Dialogue: 0,0:21:43.28,0:21:44.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah dengar.
Dialogue: 0,0:21:44.62,0:21:48.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu agama yang belakangan ini\Nmenyebar di kalangan manusia.
Dialogue: 0,0:21:48.08,0:21:51.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka menganggap manusia hewan\Ndan elf makhluk yang hina.
Dialogue: 0,0:21:52.17,0:21:54.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, jadi begitu.
Dialogue: 0,0:21:54.27,0:21:57.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tadi dia bilang tidak akan\Nmenjawab pertanyaan kami.
Dialogue: 0,0:21:57.71,0:22:00.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang malah dijawabnya dengan mudah.
Dialogue: 0,0:22:00.62,0:22:03.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?\NKenapa aku mengatakannya?
Dialogue: 0,0:22:03.97,0:22:05.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:22:06.10,0:22:09.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya apa lagi\Nyang harus kamu katakan?
