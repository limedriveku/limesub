Dialogue: 0,0:01:32.45,0:01:35.99,sign,,0000,0000,0000,,KESATRIA TENGKORAK BERKELANA DI DUNIA LAIN\NMUSIM KEDUA
Dialogue: 0,0:05:23.14,0:05:24.43,sign,,0000,0000,0000,,PEDANG PENGHAKIMAN
Dialogue: 0,0:09:18.79,0:09:19.87,sign,,0000,0000,0000,,KABUT KOROSI KEKACAUAN
Dialogue: 0,0:09:45.06,0:09:46.02,sign,,0000,0000,0000,,PEDANG SUCI PENYEGEL KEGELAPAN
Dialogue: 0,0:09:49.53,0:09:50.53,sign,,0000,0000,0000,,MEMANGGIL ULAR API
Dialogue: 0,0:09:58.91,0:09:59.79,sign,,0000,0000,0000,,TEBASAN CAHAYA SUCI
Dialogue: 0,0:10:10.21,0:10:14.18,sign,,0000,0000,0000,,PENGHANCUR KEJAHATAN
Dialogue: 0,0:13:45.01,0:13:50.02,sign,,0000,0000,0000,,EPISODE 12: HEBAT! PENGHAKIMAN TENGKORAK\NYANG MEMBASMI KEJAHATAN!
Dialogue: 0,0:23:01.99,0:23:03.95,sign,,0000,0000,0000,,KESATRIA TENGKORAK BERKELANA DI DUNIA LAIN\NMUSIM KEDUA
Dialogue: 0,0:23:44.99,0:23:47.17,sign,,0000,0000,0000,,TERIMA KASIH SUDAH MENONTON!
Dialogue: 0,0:23:47.17,0:23:51.99,sign,,0000,0000,0000,,PERJALANAN PONTA, ARC, DAN LAINNYA\NAKAN TERUS BERLANJUT!
Dialogue: 0,0:00:05.49,0:00:08.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah merusak kesenangan anak-anakku!
Dialogue: 0,0:00:11.20,0:00:13.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan memaafkanmu lagi.
Dialogue: 0,0:00:13.82,0:00:18.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anakku akan memakan kalian semua!
Dialogue: 0,0:00:24.36,0:00:28.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya pertarungan melawan bos\Nmendadak dimulai.
Dialogue: 0,0:00:43.36,0:00:47.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daging...
Dialogue: 0,0:00:47.74,0:00:49.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada banyak daging!
Dialogue: 0,0:00:49.67,0:00:51.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat makan!
Dialogue: 0,0:01:04.95,0:01:07.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir teleportasi jarak pendek?
Dialogue: 0,0:01:07.30,0:01:08.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kamu?
Dialogue: 0,0:01:08.84,0:01:12.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak akan kumaafkan lagi\Nperbuatan kejimu yang keterlaluan ini!
Dialogue: 0,0:01:13.22,0:01:15.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa pun kamu, aku tidak peduli.
Dialogue: 0,0:01:15.76,0:01:18.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ganggu anak-anakku!
Dialogue: 0,0:01:56.01,0:01:58.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Datanglah, penjaga waktu abadi!
Dialogue: 0,0:01:58.64,0:02:01.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memanggil makhluk tingkat tinggi: Aion!
Dialogue: 0,0:02:01.77,0:02:04.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuhabisi kamu sekaligus!
Dialogue: 0,0:02:51.44,0:02:54.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ku-Ku-Kurang ajar!
Dialogue: 0,0:02:54.74,0:02:57.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Badan sebesar itu ternyata gesit juga.
Dialogue: 0,0:02:57.66,0:03:01.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bergerak ke sana kemari,\Nbikin jengkel saja!
Dialogue: 0,0:03:01.33,0:03:03.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wyvern Slash!
Dialogue: 0,0:03:03.16,0:03:04.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh!
Dialogue: 0,0:03:04.25,0:03:07.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan!\NKurang ajar!
Dialogue: 0,0:03:08.33,0:03:10.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia beregenerasi lagi, ya?
Dialogue: 0,0:03:10.09,0:03:12.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bakal merepotkan.
Dialogue: 0,0:03:12.13,0:03:13.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arc!
Dialogue: 0,0:03:13.11,0:03:14.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Arc!
Dialogue: 0,0:03:14.16,0:03:16.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Ariane!\NKalian juga!
Dialogue: 0,0:03:16.72,0:03:19.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi dia sumber kekuatan sihir\Nyang besar itu?
Dialogue: 0,0:03:19.47,0:03:22.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arc, siapa sebenarnya monster ini?
Dialogue: 0,0:03:22.72,0:03:26.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dia salah satu dari tujuh\Natau apalah yang Hilk itu.
Dialogue: 0,0:03:26.98,0:03:31.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Charros Acedia Industria,\Nsalah satu dari Tujuh Kardinal.
Dialogue: 0,0:03:31.07,0:03:33.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini orang penting, tahu.
Dialogue: 0,0:03:33.20,0:03:37.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Kardinal dari Gereja Hilk\Nyang menyelamatkan dan menuntun dunia ini.
Dialogue: 0,0:03:38.89,0:03:42.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elf dan manusia hewan itu pahit,\Njadi aku tidak suka.
Dialogue: 0,0:03:42.99,0:03:46.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi mubazir, jadi harus kumakan\Nsemuanya sampai habis.
Dialogue: 0,0:03:46.79,0:03:48.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa katamu?
Dialogue: 0,0:03:48.49,0:03:52.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kamu terlihat lembut,\Nmungkin aku akan suka.
Dialogue: 0,0:03:53.55,0:03:55.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan melihatku\Ndengan tatapan menjijikkanmu.
Dialogue: 0,0:03:55.88,0:04:00.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kamu galak juga.\NAku jadi makin suka.
Dialogue: 0,0:04:00.11,0:04:04.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daging seperti itu paling enak dijilat,\Ndiisap, dikunyah,
Dialogue: 0,0:04:04.07,0:04:07.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu dinikmati perlahan-lahan!
Dialogue: 0,0:04:08.44,0:04:10.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini juga ada Jamiant?
Dialogue: 0,0:04:11.77,0:04:12.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:04:12.51,0:04:13.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:04:14.04,0:04:15.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini? Ah!
Dialogue: 0,0:04:15.40,0:04:17.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wyvern Slash!
Dialogue: 0,0:04:18.02,0:04:20.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Danka, selamatkan warga kota!
Dialogue: 0,0:04:20.24,0:04:21.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:04:21.02,0:04:23.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dik Chiyome, Tsubone, kalian juga!
Dialogue: 0,0:04:23.09,0:04:24.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini aman?
Dialogue: 0,0:04:24.35,0:04:24.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aman.
Dialogue: 0,0:04:24.93,0:04:28.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan Arc sudah cukup\Nuntuk melawan monster ini.
Dialogue: 0,0:04:28.01,0:04:28.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:04:28.91,0:04:30.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami serahkan padamu.
Dialogue: 0,0:04:30.92,0:04:34.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arc, ayo kita hancurkan bajingan ini!
Dialogue: 0,0:04:35.78,0:04:36.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:04:36.80,0:04:39.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua pikir bisa\Nmengalahkanku sendirian?
Dialogue: 0,0:04:39.68,0:04:42.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadinya aku mau makan yang betina dulu,
Dialogue: 0,0:04:42.20,0:04:43.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi karena kalian seakrab itu,
Dialogue: 0,0:04:43.87,0:04:46.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sekalian saja semuanya!
Dialogue: 0,0:04:46.52,0:04:48.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wyvern... waduh!
Dialogue: 0,0:04:58.64,0:05:00.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wyvern Slash!
Dialogue: 0,0:05:03.24,0:05:04.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma saja!
Dialogue: 0,0:05:04.62,0:05:06.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia regenerasi lagi?
Dialogue: 0,0:05:06.04,0:05:07.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan beri waktu dia beregenerasi.
Dialogue: 0,0:05:07.87,0:05:09.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langsung serang sekaligus!
Dialogue: 0,0:05:09.89,0:05:11.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara sih gampang!
Dialogue: 0,0:05:11.96,0:05:15.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai Api, yang melahap semuanya,\Nbakarlah segalanya!
Dialogue: 0,0:05:18.26,0:05:21.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknik kesatria suci: Judgement!
Dialogue: 0,0:05:25.14,0:05:26.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhasil!
Dialogue: 0,0:05:26.29,0:05:29.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Ariane, jangan buat pernyataan begitu!
Dialogue: 0,0:05:38.60,0:05:41.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurang ajar!\NKurang ajar! Kurang ajar!
Dialogue: 0,0:05:41.76,0:05:43.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian ini cuma seonggok daging!
Dialogue: 0,0:05:43.69,0:05:45.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian ini cuma makananku!
Dialogue: 0,0:05:46.40,0:05:48.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubunuh kalian!
Dialogue: 0,0:05:48.78,0:05:49.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin!
Dialogue: 0,0:05:49.91,0:05:52.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengungsilah ke atas bukit di sebelah barat!
Dialogue: 0,0:05:52.67,0:05:54.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan berhenti!\NCepat lari!
Dialogue: 0,0:06:00.01,0:06:01.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini juga ada?
Dialogue: 0,0:06:01.31,0:06:02.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kulawan!
Dialogue: 0,0:06:19.69,0:06:22.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan, Jamiant di seluruh kota pun\Ndia makan.
Dialogue: 0,0:06:23.09,0:06:25.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kota ini, benua ini, dunia ini!
Dialogue: 0,0:06:25.91,0:06:27.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua, semua, semua,\Nsemua, semua, semua!
Dialogue: 0,0:06:27.71,0:06:31.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya akan kumakan!
Dialogue: 0,0:06:43.76,0:06:45.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, lihat itu!
Dialogue: 0,0:06:45.47,0:06:47.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:06:58.36,0:07:00.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:07:02.32,0:07:04.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih bisa makan lagi!
Dialogue: 0,0:07:04.56,0:07:07.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sedunia!\NSemua, semuanya!
Dialogue: 0,0:07:08.95,0:07:11.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Ariane, mundurlah.
Dialogue: 0,0:07:16.46,0:07:18.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar kalian serangga!
Dialogue: 0,0:07:26.77,0:07:27.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arc!
Dialogue: 0,0:07:30.39,0:07:34.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan akibatnya kalau jadi serangga\Nberani melawanku.
Dialogue: 0,0:07:34.77,0:07:36.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai batu yang diselimuti api,
Dialogue: 0,0:07:36.69,0:07:38.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}serang dan binasakan musuh!
Dialogue: 0,0:07:40.23,0:07:41.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma saja!
Dialogue: 0,0:07:41.65,0:07:45.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai Api, yang melahap semuanya,\Nbakarlah segalanya!
Dialogue: 0,0:07:48.86,0:07:51.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali tidak mempan.
Dialogue: 0,0:07:53.79,0:07:55.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lengah.
Dialogue: 0,0:07:55.12,0:07:56.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melemahkan serangan?
Dialogue: 0,0:07:56.89,0:07:58.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Debuff, ya?\N- Sakit.
Dialogue: 0,0:08:00.00,0:08:02.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara apa itu?
Dialogue: 0,0:08:03.09,0:08:05.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sakit! Sakit!\N- Panas!
Dialogue: 0,0:08:05.01,0:08:07.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Mama di mana?\N- Dingin!
Dialogue: 0,0:08:07.59,0:08:10.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan,\Nmereka orang-orang yang dimakan?
Dialogue: 0,0:08:10.97,0:08:12.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tolong.\N- Sakit!
Dialogue: 0,0:08:12.93,0:08:14.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesak.
Dialogue: 0,0:08:14.47,0:08:18.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi dia bukan hanya makan,\Njiwanya pun dia serap?
Dialogue: 0,0:08:22.23,0:08:23.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesal, ya?
Dialogue: 0,0:08:23.73,0:08:25.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sudah berakhir.
Dialogue: 0,0:08:25.28,0:08:28.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kulahap wajah manismu itu.
Dialogue: 0,0:08:31.37,0:08:33.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang sudah berakhir itu justru kamu.
Dialogue: 0,0:08:38.08,0:08:40.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa ini?
Dialogue: 0,0:08:42.08,0:08:44.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan membuatku menunggu, Arc!
Dialogue: 0,0:08:44.25,0:08:47.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Ariane,\Nterima kasih sudah mengulur waktu.
Dialogue: 0,0:08:47.51,0:08:49.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu masih hidup?
Dialogue: 0,0:08:49.51,0:08:52.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Datanglah, penjaga waktu abadi!
Dialogue: 0,0:08:52.39,0:08:55.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memanggil makhluk tingkat tinggi: Aion!
Dialogue: 0,0:08:57.52,0:09:00.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aion adalah makhluk panggilan\Nyang dapat mengunci
Dialogue: 0,0:09:00.10,0:09:02.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pemanggilnya dalam waktu tertentu.
Dialogue: 0,0:09:02.77,0:09:04.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama efeknya aktif,
Dialogue: 0,0:09:04.52,0:09:06.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tak akan menerima damage\Ndan manaku tidak berkurang.
Dialogue: 0,0:09:06.98,0:09:09.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, efeknya hanya tiga menit.
Dialogue: 0,0:09:09.78,0:09:12.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuhabisi kamu sekaligus!
Dialogue: 0,0:09:12.28,0:09:14.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurang ajar! Kurang ajar! Kurang ajar!
Dialogue: 0,0:09:14.66,0:09:16.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan jurus pemungkasku,
Dialogue: 0,0:09:16.79,0:09:18.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chaos Corrosion!
Dialogue: 0,0:09:21.96,0:09:24.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membusuklah hingga meleleh!
Dialogue: 0,0:09:26.71,0:09:27.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma saja.
Dialogue: 0,0:09:27.92,0:09:29.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}So-Sok kuat!
Dialogue: 0,0:09:29.63,0:09:31.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan sekali lagi!
Dialogue: 0,0:09:34.39,0:09:36.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chaos Corrosion-ku
Dialogue: 0,0:09:36.31,0:09:37.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ditangkis begitu saja?
Dialogue: 0,0:09:37.89,0:09:40.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan harap kamu menyisakan apa pun.
Dialogue: 0,0:09:40.23,0:09:42.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknik kesatria suci:
Dialogue: 0,0:09:43.31,0:09:45.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sacred Shield!
Dialogue: 0,0:09:46.48,0:09:48.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknik sihir kesatria suci:
Dialogue: 0,0:09:48.76,0:09:50.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Flame Viper!
Dialogue: 0,0:09:52.53,0:09:57.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknik kesatria suci: Holy Ray Sword!
Dialogue: 0,0:10:01.04,0:10:04.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Regenerasiku tak bisa mengimbanginya!
Dialogue: 0,0:10:04.42,0:10:07.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, tak akan kubiarkan\Nkamu menyisakan apa pun.
Dialogue: 0,0:10:07.42,0:10:10.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill Paus Tingkat Tinggi:
Dialogue: 0,0:10:10.21,0:10:11.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cross Avent!
Dialogue: 0,0:10:11.59,0:10:14.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit!
Dialogue: 0,0:10:22.69,0:10:23.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:10:23.97,0:10:25.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa mati dengan tenang.
Dialogue: 0,0:10:25.73,0:10:27.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya bisa mati!
Dialogue: 0,0:10:27.52,0:10:28.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:10:29.40,0:10:30.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:10:30.65,0:10:31.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:10:32.78,0:10:37.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih ingin makan\Nberbagai macam orang.
Dialogue: 0,0:10:39.08,0:10:41.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tidak boleh terjadi.
Dialogue: 0,0:10:41.83,0:10:45.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku satu dari Tujuh Kardinal!
Dialogue: 0,0:10:46.71,0:10:50.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kalah oleh kesatria seperti ini?
Dialogue: 0,0:10:50.36,0:10:54.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si-Siapa kamu sebenarnya?
Dialogue: 0,0:10:55.72,0:10:58.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya aku tak ingin\Nmemberitahukan namaku padamu.
Dialogue: 0,0:10:58.60,0:11:01.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, anggaplah sebagai hadiah ke alam baka.
Dialogue: 0,0:11:02.35,0:11:05.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Arc Lalatoya!
Dialogue: 0,0:11:12.28,0:11:14.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seorang kesatria dari kaum elf.
Dialogue: 0,0:11:15.78,0:11:18.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu makanmu sudah berakhir.
Dialogue: 0,0:11:18.53,0:11:20.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamanya.
Dialogue: 0,0:11:21.20,0:11:24.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Ponta.\NApa anak laki-laki itu selamat?
Dialogue: 0,0:11:25.12,0:11:27.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.\NBaguslah kalau begitu.
Dialogue: 0,0:11:32.46,0:11:35.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai jiwa-jiwa yang terperangkap,
Dialogue: 0,0:11:35.17,0:11:37.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}beristirahatlah dengan tenang.
Dialogue: 0,0:11:49.02,0:11:50.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita selamat!
Dialogue: 0,0:11:55.11,0:11:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kini semuanya sudah berakhir, ya.
Dialogue: 0,0:11:57.49,0:11:58.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:11:58.61,0:11:59.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kakakmu?
Dialogue: 0,0:11:59.87,0:12:02.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal itu, kami sudah berpamitan.
Dialogue: 0,0:12:03.58,0:12:04.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:12:05.91,0:12:09.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, sekarang masalahnya sudah beres.
Dialogue: 0,0:12:14.21,0:12:19.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabarnya Kota Tajient diserang\Ngerombolan Jamiant dan Undead.
Dialogue: 0,0:12:20.22,0:12:22.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tajient?\NBukankah itu...
Dialogue: 0,0:12:22.76,0:12:23.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:12:23.76,0:12:28.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu-satunya kota di Benua Selatan\Nyang dimiliki gereja Hilk.
Dialogue: 0,0:12:28.93,0:12:30.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, bagaimana keadaannya?
Dialogue: 0,0:12:31.40,0:12:35.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat kerja keras para prajurit,\Nkeadaan berhasil diatasi.
Dialogue: 0,0:12:36.40,0:12:37.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:12:37.82,0:12:42.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, hebat juga mereka bisa\Nmembereskan situasi tersebut.
Dialogue: 0,0:12:42.66,0:12:44.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini informasi yang belum bisa dipastikan.
Dialogue: 0,0:12:44.99,0:12:48.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kabarnya ada kaum manusia hewan, elf,
Dialogue: 0,0:12:48.99,0:12:52.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kesatria perak yang ikut\Nbertarung di kota itu.
Dialogue: 0,0:12:54.17,0:12:56.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabarnya situasinya sangat kacau.
Dialogue: 0,0:12:56.68,0:12:59.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi informasi tersebut masih belum pasti.
Dialogue: 0,0:12:59.97,0:13:02.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesatria perak?
Dialogue: 0,0:13:11.15,0:13:13.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Yuriarna?
Dialogue: 0,0:13:13.03,0:13:16.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tidak, bukan apa-apa.
Dialogue: 0,0:13:21.70,0:13:24.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Tajient, ya?
Dialogue: 0,0:13:24.05,0:13:25.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:13:25.28,0:13:28.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya Kerajaan Suci Hilk\Nsudah mulai bergerak.
Dialogue: 0,0:13:28.50,0:13:30.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang akan kita lakukan?
Dialogue: 0,0:13:30.96,0:13:33.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan saja mereka berbuat sesukanya.
Dialogue: 0,0:13:33.75,0:13:38.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan mereka membuat\Ndunia ini kacau balau.
Dialogue: 0,0:13:38.01,0:13:42.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu, kita bisa melakukan\Napa yang seharusnya kita lakukan.
Dialogue: 0,0:13:42.01,0:13:43.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuka hati kita.
Dialogue: 0,0:14:05.74,0:14:08.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tempat dengan\Npemandangan terbaik di desa.
Dialogue: 0,0:14:08.83,0:14:11.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini Kakak pasti bisa melihatnya\Ndengan jelas.
Dialogue: 0,0:14:11.47,0:14:15.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melihat semua orang yang hidup bahagia\Ndi desa baru ini.
Dialogue: 0,0:14:16.04,0:14:18.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chiyome, sudah waktunya berangkat.
Dialogue: 0,0:14:18.55,0:14:19.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:14:20.46,0:14:22.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan pergi berkelana lagi.
Dialogue: 0,0:14:22.93,0:14:26.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jaga semua orang selagi aku pergi,
Dialogue: 0,0:14:26.40,0:14:27.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Sasuke.
Dialogue: 0,0:14:41.32,0:14:42.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Arc.
Dialogue: 0,0:14:42.90,0:14:44.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa, Nona Ariane?
Dialogue: 0,0:14:44.53,0:14:48.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anu, begini...
Dialogue: 0,0:14:49.70,0:14:52.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sedang buat apa, ya?
Dialogue: 0,0:14:52.20,0:14:55.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang buat piza,\Nmakanan dari kampung halamanku.
Dialogue: 0,0:14:55.17,0:14:58.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mumpung punya banyak tomat\Nyang aku beli di sini.
Dialogue: 0,0:14:58.42,0:15:00.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Begitu.
Dialogue: 0,0:15:00.18,0:15:02.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga cocok dengan lidah kalian.
Dialogue: 0,0:15:03.09,0:15:04.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:15:06.22,0:15:07.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arc.
Dialogue: 0,0:15:07.30,0:15:08.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:15:08.39,0:15:10.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, aku...
Dialogue: 0,0:15:11.60,0:15:14.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, bukankah itu burung pembisik?
Dialogue: 0,0:15:16.19,0:15:20.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal manusia hewan dan manusia harimau\Nyang dibebaskan dari Tajient.
Dialogue: 0,0:15:20.13,0:15:22.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sudah tiba di Kerajaan Fobnach\Ndengan aman.
Dialogue: 0,0:15:22.69,0:15:25.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, syukurlah kalau begitu.
Dialogue: 0,0:15:25.07,0:15:27.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan melanjutkan\Npenyelidikan lagi di sini.
Dialogue: 0,0:15:27.74,0:15:31.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ein juga memintaku untuk\Nmenyampaikan rasa terima kasihnya.
Dialogue: 0,0:15:31.70,0:15:33.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sama.
Dialogue: 0,0:15:33.16,0:15:35.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas bantuan kalian kali ini.
Dialogue: 0,0:15:36.67,0:15:41.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaum elf yang dibebaskan dari Tajient\Ntelah kembali ke desanya masing-masing.
Dialogue: 0,0:15:41.80,0:15:45.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedangkan yang lain, akan dilindungi\Ndi negeri manusia hewan,
Dialogue: 0,0:15:45.01,0:15:48.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yaitu di Kerajaan Agung Fobnach.
Dialogue: 0,0:15:48.22,0:15:51.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami juga ikut mengawal\Nhingga setengah perjalanan.
Dialogue: 0,0:15:51.64,0:15:54.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, sebagai tanda terima kasih mereka...
Dialogue: 0,0:15:57.44,0:16:00.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tidak jadi masalah kita bawa ini?
Dialogue: 0,0:16:00.23,0:16:04.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kebetulan aku juga tidak mau\Nberpisah dengan Shiden.
Dialogue: 0,0:16:11.66,0:16:13.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sabar, Ponta.\NTunggu sebentar lagi.
Dialogue: 0,0:16:15.04,0:16:17.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Arc, sebenarnya...
Dialogue: 0,0:16:17.92,0:16:20.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, baunya enak juga.
Dialogue: 0,0:16:20.58,0:16:22.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Pak Dillan!
Dialogue: 0,0:16:22.69,0:16:24.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, aku kembali.
Dialogue: 0,0:16:25.30,0:16:27.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku membawa tamu.
Dialogue: 0,0:16:27.05,0:16:28.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dik Chiyome?\N- Nona Tsubone?
Dialogue: 0,0:16:28.34,0:16:29.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tidak bersua.
Dialogue: 0,0:16:29.68,0:16:31.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tak jumpa, kalian berdua.
Dialogue: 0,0:16:31.80,0:16:35.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dihubungi salah satu Klan Jinshin,
Dialogue: 0,0:16:35.18,0:16:37.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu berkumpul dengan mereka.
Dialogue: 0,0:16:37.06,0:16:38.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:16:38.52,0:16:42.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Nona Chiyome,\Nbagaimana setelah kembali ke desa?
Dialogue: 0,0:16:42.06,0:16:46.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku melaporkan seluruh kronologi\Nke Tuan Hanzo,
Dialogue: 0,0:16:46.11,0:16:48.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menguburkan Kakak.
Dialogue: 0,0:16:48.57,0:16:50.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:16:50.05,0:16:52.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekali lagi, aku turut berduka cita.
Dialogue: 0,0:16:52.82,0:16:55.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, apa Glenys ada di sini?
Dialogue: 0,0:16:55.16,0:16:57.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada, harusnya sebentar lagi pulang.
Dialogue: 0,0:16:57.91,0:17:00.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, aromanya enak sekali.
Dialogue: 0,0:17:00.48,0:17:02.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru saja dibicarakan.
Dialogue: 0,0:17:02.13,0:17:05.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, selamat datang kembali, Sayang.
Dialogue: 0,0:17:05.00,0:17:06.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka siapa?
Dialogue: 0,0:17:06.38,0:17:08.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka dari Klan Jinshin.
Dialogue: 0,0:17:08.83,0:17:10.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suatu kehormatan bisa bertemu.
Dialogue: 0,0:17:10.63,0:17:12.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya Chiyome, dari Enam Ninja.
Dialogue: 0,0:17:12.83,0:17:14.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya Tsubone, dari Enam Ninja juga.
Dialogue: 0,0:17:14.68,0:17:16.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang bisa bertemu.
Dialogue: 0,0:17:17.47,0:17:19.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sering dengar tentang kalian.
Dialogue: 0,0:17:19.14,0:17:20.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santai saja di sini.
Dialogue: 0,0:17:20.89,0:17:23.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, sebentar lagi pizanya juga matang.
Dialogue: 0,0:17:26.28,0:17:30.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Sayang,\Nada apa pulang mendadak begini?
Dialogue: 0,0:17:30.32,0:17:31.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal itu...
Dialogue: 0,0:17:31.78,0:17:35.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada permintaan dari Desa Drant.
Dialogue: 0,0:17:35.21,0:17:40.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetua Agung meminta kita\Nuntuk menangani tugas ini.
Dialogue: 0,0:17:40.48,0:17:42.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita?
Dialogue: 0,0:17:42.00,0:17:44.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi di Desa Drant?
Dialogue: 0,0:17:44.67,0:17:45.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal itu...
Dialogue: 0,0:17:45.92,0:17:48.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada laporan mereka diserang Undead.
Dialogue: 0,0:17:48.96,0:17:49.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:17:49.92,0:17:53.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabarnya mereka bergerak\Ndengan terorganisasi.
Dialogue: 0,0:17:53.43,0:17:55.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terorganisasi, ya.
Dialogue: 0,0:17:56.43,0:17:59.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, ada kaitannya lagi\Ndengan orang-orang Hilk.
Dialogue: 0,0:17:59.63,0:18:02.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinannya sangat besar.
Dialogue: 0,0:18:02.44,0:18:07.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, Nona Chiyome dan Nona Tsubone\Nke Lalatoya juga karena alasan itu?
Dialogue: 0,0:18:07.19,0:18:11.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, kami datang karena ada yang ingin\Nkami sampaikan pada Tuan Arc.
Dialogue: 0,0:18:11.36,0:18:12.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padaku?
Dialogue: 0,0:18:12.63,0:18:17.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat Sasuke, kita jadi tahu\Nyang menculik itu orang-orang Hilk, kan?
Dialogue: 0,0:18:17.52,0:18:19.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di markas pusat gereja Hilk itu,
Dialogue: 0,0:18:19.70,0:18:22.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin masih ada orang yang ditawan.
Dialogue: 0,0:18:22.68,0:18:26.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu,\Nkami ingin minta bantuan Tuan Arc.
Dialogue: 0,0:18:26.34,0:18:27.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm...
Dialogue: 0,0:18:27.29,0:18:30.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja aku tidak keberatan,
Dialogue: 0,0:18:30.33,0:18:31.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi, Pak Dillan,
Dialogue: 0,0:18:31.38,0:18:34.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sekarang aku sudah bagian\Ndari Lalatoya, kan?
Dialogue: 0,0:18:34.89,0:18:37.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tidak jadi masalah\Naku pergi dengan mereka?
Dialogue: 0,0:18:37.60,0:18:43.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami juga berniat melanjutkan\Npenyelidikan Kerajaan Suci Hilk.
Dialogue: 0,0:18:43.14,0:18:47.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku justru senang bisa bekerja sama\Ndengan Klan Jinshin.
Dialogue: 0,0:18:47.36,0:18:49.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti itu bukan masalah!
Dialogue: 0,0:18:49.36,0:18:52.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti itulah,\NNona Chiyome, Nona Tsubone.
Dialogue: 0,0:18:52.24,0:18:54.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terima permintaan kalian!
Dialogue: 0,0:18:55.36,0:18:57.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:18:57.03,0:18:58.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon kerja samanya, ya.
Dialogue: 0,0:18:58.20,0:19:01.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu!\NAku jadi khawatir kalau Arc sendirian!
Dialogue: 0,0:19:01.62,0:19:03.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ikut!
Dialogue: 0,0:19:03.36,0:19:06.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita juga tak bisa biarkan\Norang-orang Hilk itu.
Dialogue: 0,0:19:06.44,0:19:10.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, aku senang kalau kamu ikut.
Dialogue: 0,0:19:10.55,0:19:12.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:19:12.30,0:19:18.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah Nona Ariane Pejuang Maple\Ndari Hutan Pusat?
Dialogue: 0,0:19:18.13,0:19:23.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu yakin tidak mengambil tugas Maple\Ndan menjalankan misi Lalatoya?
Dialogue: 0,0:19:24.43,0:19:27.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, soal itu...
Dialogue: 0,0:19:27.73,0:19:30.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kamu masih belum memberitahunya?
Dialogue: 0,0:19:31.82,0:19:36.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setibanya di rumah,\Ndia langsung mengajukan perpindahan.
Dialogue: 0,0:19:36.36,0:19:38.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengajuannya sudah disetujui.
Dialogue: 0,0:19:38.20,0:19:42.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, sekarang Ariane sudah\Njadi bagian dari Lalatoya.
Dialogue: 0,0:19:42.66,0:19:44.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, jadi begitu!
Dialogue: 0,0:19:45.87,0:19:47.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Ariane,
Dialogue: 0,0:19:47.29,0:19:50.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jangan-jangan kamu pindah ke Lalatoya\Nkarena ingin bersama Arc?
Dialogue: 0,0:19:50.71,0:19:52.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukan!
Dialogue: 0,0:19:52.38,0:19:55.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya khawatir kalau Arc\Ndibiarkan sendirian!
Dialogue: 0,0:19:55.47,0:19:56.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, yang benar?
Dialogue: 0,0:19:56.63,0:19:58.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cinta, ya.
Dialogue: 0,0:19:58.01,0:20:02.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, makanya aku diam saja\Nbiar tidak dibilang begitu!
Dialogue: 0,0:20:02.03,0:20:04.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, tunggu, itu artinya...
Dialogue: 0,0:20:04.89,0:20:06.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:20:06.14,0:20:09.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang aku jadi bisa bepergian\Ndengan Nona Ariane, ya.
Dialogue: 0,0:20:09.81,0:20:11.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi senang.
Dialogue: 0,0:20:12.02,0:20:13.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arc Lalatoya.
Dialogue: 0,0:20:13.57,0:20:15.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ariane Glenys Lalatoya.
Dialogue: 0,0:20:16.70,0:20:19.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya sama seperti suami istri.
Dialogue: 0,0:20:19.30,0:20:20.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suami istri?
Dialogue: 0,0:20:20.49,0:20:22.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kamu tidak tahu?
Dialogue: 0,0:20:22.41,0:20:26.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di kaum manusia, kalau namanya sama,
Dialogue: 0,0:20:26.08,0:20:29.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}biasanya karena satu keluarga\Natau pasangan suami istri.
Dialogue: 0,0:20:29.50,0:20:31.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Ariane ternyata sigap juga!
Dialogue: 0,0:20:31.79,0:20:33.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di-Dibilang bukan!
Dialogue: 0,0:20:33.46,0:20:36.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami bukan pasangan begitu!
Dialogue: 0,0:20:38.05,0:20:40.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perjalanan berikutnya jadi tenang.
Dialogue: 0,0:20:48.44,0:20:51.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar perjalanan baru berjalan lancar.
Dialogue: 0,0:20:51.06,0:20:54.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar masa depan Arc dan Ariane\Nberjalan lancar.
Dialogue: 0,0:20:54.77,0:20:56.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa jadi kami berdua?
Dialogue: 0,0:20:56.19,0:20:57.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersulang!
Dialogue: 0,0:20:57.65,0:20:59.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar!
Dialogue: 0,0:21:07.45,0:21:10.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan tambah lagi, Lalatoya.
Dialogue: 0,0:21:10.08,0:21:13.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Lalatoya, tidak baik kebanyakan minum.
Dialogue: 0,0:21:13.17,0:21:15.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, kalian berdua apaan, sih!
Dialogue: 0,0:21:17.46,0:21:19.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, aku Arc.
Dialogue: 0,0:21:19.55,0:21:23.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami pun akhirnya berangkat\Nuntuk melakukan perjalanan baru.
Dialogue: 0,0:21:24.01,0:21:28.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketika datang ke dunia ini,\Naku ingin bertualang tanpa mencolok,
Dialogue: 0,0:21:28.98,0:21:31.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi keinginan itu sepertinya masih jauh.
Dialogue: 0,0:23:07.12,0:23:09.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, Kardinal Charros telah tewas?
Dialogue: 0,0:23:09.79,0:23:12.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lawannya kesatria berzirah perak.
Dialogue: 0,0:23:15.79,0:23:19.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesatria perak, ya?\NMenarik juga.
Dialogue: 0,0:23:19.57,0:23:22.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, itu tidak mengganggu rencana kita.
Dialogue: 0,0:23:23.80,0:23:25.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, sesuai rencana,
Dialogue: 0,0:23:25.76,0:23:29.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}operasi di Kerajaan Nohzan\Nakan tetap dilanjutkan.
Dialogue: 0,0:23:33.81,0:23:34.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh...
Dialogue: 0,0:23:35.44,0:23:37.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh lama sekali.
Dialogue: 0,0:23:40.61,0:23:43.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah awal dari sebuah event.
