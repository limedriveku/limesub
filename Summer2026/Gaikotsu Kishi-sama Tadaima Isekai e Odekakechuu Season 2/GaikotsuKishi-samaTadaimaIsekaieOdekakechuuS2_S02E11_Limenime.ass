Dialogue: 0,0:00:50.49,0:00:54.03,sign,,0000,0000,0000,,KESATRIA TENGKORAK BERKELANA DI DUNIA LAIN\NMUSIM KEDUA
Dialogue: 0,0:03:14.92,0:03:16.30,sign,,0000,0000,0000,,SENI PENGELABUAN: KABUT HALUSINASI
Dialogue: 0,0:09:32.18,0:09:33.14,sign,,0000,0000,0000,,TEBASAN NAGA
Dialogue: 0,0:09:45.31,0:09:46.57,sign,,0000,0000,0000,,SENI PENGELABUAN: BONEKA TANPA BATAS
Dialogue: 0,0:12:31.02,0:12:36.03,sign,,0000,0000,0000,,EPISODE 11: PERTARUNGAN BERDARAH!\NGUGUR DI KOTA YANG HANCUR
Dialogue: 0,0:15:29.99,0:15:31.24,sign,,0000,0000,0000,,ELEMEN AIR: PENJARA JARUM DARAH
Dialogue: 0,0:23:40.02,0:23:45.03,sign,,0000,0000,0000,,SELANJUTNYA: HEBAT! PENGHAKIMAN TENGKORAK\NYANG MEMBASMI KEJAHATAN!
Dialogue: 0,0:23:45.03,0:23:51.43,sign,,0000,0000,0000,,#PONTASAATINIJUGASEDANGBERKELANA\NPEMANDANGAN KOTA YANG SEPERTI TAJIENT!
Dialogue: 0,0:00:00.86,0:00:03.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kamu yang membuat Sasuke\Nmenjadi Undead?
Dialogue: 0,0:00:03.48,0:00:04.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sasuke?
Dialogue: 0,0:00:04.86,0:00:07.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, maksudnya boneka ini?
Dialogue: 0,0:00:08.82,0:00:09.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boneka?
Dialogue: 0,0:00:12.23,0:00:15.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari pakaianmu, kamu orang gereja, ya?
Dialogue: 0,0:00:15.63,0:00:18.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi rasanya bukan sekadar pendeta biasa.
Dialogue: 0,0:00:18.71,0:00:21.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian pikir aku akan\Nmenjawab pertanyaan itu?
Dialogue: 0,0:00:21.71,0:00:23.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bicara begitu.
Dialogue: 0,0:00:23.96,0:00:27.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tertarik padamu.
Dialogue: 0,0:00:28.01,0:00:32.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, siapa dan dari mana asalmu?
Dialogue: 0,0:00:32.68,0:00:36.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri tahu.
Dialogue: 0,0:01:14.64,0:01:16.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membiarkan orang lain mengotori tangannya,
Dialogue: 0,0:01:16.47,0:01:18.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar kalian tetap terlihat\Ntidak mencurigakan, ya.
Dialogue: 0,0:01:19.48,0:01:20.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:01:20.31,0:01:21.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima ini,
Dialogue: 0,0:01:21.27,0:01:24.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wyvern Slash!
Dialogue: 0,0:02:08.44,0:02:10.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, aku Arc.
Dialogue: 0,0:02:10.53,0:02:13.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu tiba di Tajient,\Nkota para kaum manusia,
Dialogue: 0,0:02:13.07,0:02:15.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jamiant dan Undead mengamuk di mana-mana.
Dialogue: 0,0:02:15.64,0:02:19.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu saat kami pikir sudah\Nmenemukan Tuan Sasuke, di sana...
Dialogue: 0,0:02:19.49,0:02:23.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Palurumo Avaritia Liberalitas.
Dialogue: 0,0:02:23.32,0:02:26.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah satu Tujuh Kardinal Gereja Hilk.
Dialogue: 0,0:02:28.50,0:02:29.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gereja Hilk?
Dialogue: 0,0:02:29.99,0:02:31.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah dengar.
Dialogue: 0,0:02:31.38,0:02:34.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu agama yang belakangan ini\Nmenyebar di kalangan manusia.
Dialogue: 0,0:02:34.79,0:02:38.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka menganggap manusia hewan\Ndan elf makhluk yang hina.
Dialogue: 0,0:02:38.39,0:02:40.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, jadi begitu.
Dialogue: 0,0:02:40.96,0:02:44.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tadi dia bilang tidak akan\Nmenjawab pertanyaan kami.
Dialogue: 0,0:02:44.39,0:02:47.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang malah dijawabnya dengan mudah.
Dialogue: 0,0:02:47.31,0:02:50.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?\NKenapa aku mengatakannya?
Dialogue: 0,0:02:51.05,0:02:52.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:02:52.82,0:02:55.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya apa lagi\Nyang harus kamu ungkapkan?
Dialogue: 0,0:02:57.16,0:02:59.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, jadi ini jutsu milikmu?
Dialogue: 0,0:02:59.66,0:03:00.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jutsu?
Dialogue: 0,0:03:00.54,0:03:02.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya?
Dialogue: 0,0:03:02.29,0:03:04.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, ketahuan, ya?
Dialogue: 0,0:03:04.41,0:03:08.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jutsu Tsubone adalah teknik pengelabuan\Nuntuk mengendalikan orang.
Dialogue: 0,0:03:08.79,0:03:10.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengendalikan orang?
Dialogue: 0,0:03:10.09,0:03:10.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:03:11.80,0:03:14.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inton: Tencho Genkomu.
Dialogue: 0,0:03:21.60,0:03:26.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, jawablah pertanyaanku,\NKardinal Palurumo.
Dialogue: 0,0:03:26.25,0:03:28.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Sasuke menjadi Undead?
Dialogue: 0,0:03:30.98,0:03:33.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawab!\NKenapa Sasuke—
Dialogue: 0,0:03:33.15,0:03:35.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jutsu yang menarik.
Dialogue: 0,0:03:35.61,0:03:39.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski hanya sesaat,\Nkamu berhasil membingungkanku.
Dialogue: 0,0:03:39.52,0:03:40.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:03:40.70,0:03:44.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}trik murahan seperti ini\Ntak akan bisa mempan selamanya.
Dialogue: 0,0:03:44.62,0:03:46.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bisa menahan jutsu Tsubone?
Dialogue: 0,0:03:46.96,0:03:50.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh? Kamu memang Kardinal yang hebat.
Dialogue: 0,0:03:50.00,0:03:54.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, akan kuberi satu serangan\Nyang lebih kuat lagi.
Dialogue: 0,0:03:54.56,0:03:57.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak perlu sampai sejauh itu.
Dialogue: 0,0:03:57.01,0:04:00.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau hanya sebatas itu,\Naku bisa memberitahumu.
Dialogue: 0,0:04:00.51,0:04:02.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:04:02.14,0:04:05.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alasan pria ini menjadi Undead.
Dialogue: 0,0:04:08.94,0:04:14.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami melakukan eksperimen\Nmenciptakan Undead di sebuah desa.
Dialogue: 0,0:04:14.32,0:04:18.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kejadian di Desa Denel\Nitu perbuatanmu?
Dialogue: 0,0:04:18.07,0:04:19.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi begitu.
Dialogue: 0,0:04:19.24,0:04:23.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kalian yang menghancurkan\Ntempat eksperimen itu?
Dialogue: 0,0:04:23.95,0:04:29.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak manusia hewan, elf, dan manusia\Nyang diculik dari berbagai tempat.
Dialogue: 0,0:04:29.67,0:04:31.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para pelakunya,
Dialogue: 0,0:04:31.04,0:04:34.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selalu mengatakan dijual\Nke pedagang di luar negeri.
Dialogue: 0,0:04:34.96,0:04:38.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kamu dalang di balik semua ini?
Dialogue: 0,0:04:38.72,0:04:42.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu menjadikan mereka yang diculik\Nsebagai kelinci percobaan!
Dialogue: 0,0:04:42.64,0:04:43.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:04:43.72,0:04:48.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi menciptakan pasukan Undead\Ndari mayat hidup.
Dialogue: 0,0:04:48.23,0:04:52.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setahuku, Sasuke juga menelusuri\Nkaum manusia hewan yang diculik.
Dialogue: 0,0:04:52.90,0:04:54.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:04:54.11,0:04:58.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, pria ini mengetahui pergerakan kami,
Dialogue: 0,0:04:58.32,0:05:02.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menyusup ke Kerajaan Suci Hilk.
Dialogue: 0,0:05:17.76,0:05:19.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bersuara, aku akan menolong kalian.
Dialogue: 0,0:05:19.67,0:05:20.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia hewan.
Dialogue: 0,0:05:20.93,0:05:23.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, Klan Jinshin, ya?
Dialogue: 0,0:05:29.52,0:05:31.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Futon: Kamaitachi.
Dialogue: 0,0:05:37.98,0:05:39.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Futon: Kaze Rougoku.
Dialogue: 0,0:05:45.66,0:05:48.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memiliki kekuatan yang menarik.
Dialogue: 0,0:05:50.66,0:05:54.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kamu bisa menjadi\Nkelinci percobaan yang bagus.
Dialogue: 0,0:05:58.71,0:06:03.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dia dengan mudahnya\Nditangkap Tuan Thanatos.
Dialogue: 0,0:06:03.47,0:06:04.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin!
Dialogue: 0,0:06:04.65,0:06:07.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Sasuke tak mungkin\Ntertangkap semudah itu!
Dialogue: 0,0:06:07.97,0:06:11.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bapa Paus Thanatos adalah sosok\Nyang melampaui Tuhan.
Dialogue: 0,0:06:11.73,0:06:15.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada seorang pun di dunia ini\Nyang mampu menandinginya.
Dialogue: 0,0:06:15.73,0:06:17.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Thanatos?
Dialogue: 0,0:06:17.16,0:06:19.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dialah dalang utamanya.
Dialogue: 0,0:06:19.36,0:06:20.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lancang sekali!
Dialogue: 0,0:06:21.24,0:06:24.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jaga mulutmu, elf!
Dialogue: 0,0:06:24.00,0:06:26.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bapa Paus adalah sosok Agung\Nyang memimpin Kerajaan Suci Hilk.
Dialogue: 0,0:06:26.87,0:06:31.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, yang menuntun seluruh umat manusia!
Dialogue: 0,0:06:31.25,0:06:32.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apanya yang menuntun?
Dialogue: 0,0:06:32.45,0:06:35.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dialah yang mengubah Sasuke\Nmenjadi Undead, kan?
Dialogue: 0,0:06:35.75,0:06:37.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tepat sekali.
Dialogue: 0,0:06:37.13,0:06:39.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh pria yang sangat beruntung.
Dialogue: 0,0:06:39.88,0:06:41.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu bilang?
Dialogue: 0,0:06:41.71,0:06:46.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia dibangkitkan sebagai Undead khusus\Nyang bertindak atas penilaiannya sendiri.
Dialogue: 0,0:06:46.22,0:06:47.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu...
Dialogue: 0,0:06:47.80,0:06:52.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bapa Paus sendirilah yang memberinya misi.
Dialogue: 0,0:06:52.56,0:06:56.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yaitu memimpin para Undead lainnya.
Dialogue: 0,0:06:56.40,0:07:01.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai manusia hewan,\Nitu sebuah kehormatan.
Dialogue: 0,0:07:01.57,0:07:04.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Gereja Hilk mengincar kota ini?
Dialogue: 0,0:07:04.45,0:07:09.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang menyerang Tajient\Nadalah murni Jamiant dan Undead.
Dialogue: 0,0:07:09.49,0:07:11.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami, Gereja Hilk,
Dialogue: 0,0:07:11.49,0:07:15.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}justru mengulurkan tangan untuk membantu\Nmereka yang terluka dan ketakutan.
Dialogue: 0,0:07:15.46,0:07:17.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya bicara begitu.
Dialogue: 0,0:07:17.00,0:07:18.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membiarkan orang lain mengotori tangannya,
Dialogue: 0,0:07:18.92,0:07:21.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar kalian tetap terlihat\Ntidak mencurigakan, ya.
Dialogue: 0,0:07:21.71,0:07:24.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar tindakan yang sangat jahat.
Dialogue: 0,0:07:24.72,0:07:27.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan mereka\Nyang ingin diselamatkan Sasuke?
Dialogue: 0,0:07:27.47,0:07:30.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah, aku juga tidak tahu.
Dialogue: 0,0:07:30.72,0:07:34.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin mereka sudah menjadi Undead\Ndan berkeliaran di kota ini.
Dialogue: 0,0:07:35.60,0:07:37.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau memang begitu,
Dialogue: 0,0:07:37.10,0:07:40.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pria ini juga pasti akan merasa puas.
Dialogue: 0,0:07:40.00,0:07:42.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena bisa bekerja demi Bapa Paus
Dialogue: 0,0:07:42.44,0:07:45.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bersama rekan-rekannya\Nyang ingin dia selamatkan.
Dialogue: 0,0:07:48.28,0:07:51.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Sasuke memang luar biasa.
Dialogue: 0,0:07:52.20,0:07:54.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menemukan musuh demi teman-temannya,
Dialogue: 0,0:07:54.56,0:07:57.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hingga menyusup ke markas sendirian.
Dialogue: 0,0:07:57.37,0:08:01.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah alasanku mengaguminya\Nsebagai kakakku.
Dialogue: 0,0:08:01.38,0:08:04.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaan dan tekad itu
Dialogue: 0,0:08:04.39,0:08:05.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan aku teruskan!
Dialogue: 0,0:08:10.72,0:08:14.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku terlalu banyak bicara.
Dialogue: 0,0:08:14.04,0:08:15.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, sudahlah.
Dialogue: 0,0:08:15.52,0:08:17.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula tujuanku sudah tercapai.
Dialogue: 0,0:08:17.68,0:08:18.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu,
Dialogue: 0,0:08:18.98,0:08:22.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian semua juga akan mati di sini.
Dialogue: 0,0:08:29.70,0:08:31.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku yang urus Kak Sasuke.
Dialogue: 0,0:08:31.32,0:08:33.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu yakin, Nona Chiyome?
Dialogue: 0,0:08:33.53,0:08:36.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti akan membebaskan jiwa kakak.
Dialogue: 0,0:08:36.59,0:08:38.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan tanganku sendiri!
Dialogue: 0,0:08:38.03,0:08:39.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Chiyome.
Dialogue: 0,0:08:39.35,0:08:41.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, aku mengerti!
Dialogue: 0,0:08:41.00,0:08:43.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan para Undead itu pada kami.
Dialogue: 0,0:08:43.41,0:08:45.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami percayakan padamu, Chiyome.
Dialogue: 0,0:08:45.30,0:08:46.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:08:46.30,0:08:49.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hancurkan mereka beserta kota ini.
Dialogue: 0,0:08:59.14,0:09:00.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua Undead-nya...
Dialogue: 0,0:09:00.73,0:09:03.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?\NSi Palurumo menghilang!
Dialogue: 0,0:09:03.23,0:09:04.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kapan?
Dialogue: 0,0:09:04.61,0:09:05.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka datang!
Dialogue: 0,0:09:15.33,0:09:16.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai api, menarilah!
Dialogue: 0,0:09:16.83,0:09:20.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembalikan segala hal\Ndan segala jiwa menjadi abu!
Dialogue: 0,0:09:25.50,0:09:27.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertarungan mereka tidak boleh diganggu.
Dialogue: 0,0:09:27.88,0:09:28.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:09:28.67,0:09:29.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima ini,
Dialogue: 0,0:09:29.80,0:09:32.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wyvern Slash!
Dialogue: 0,0:09:43.06,0:09:45.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inton: Mukyuu Kairai!
Dialogue: 0,0:09:54.41,0:09:56.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang waktunya!\NCepat lari!
Dialogue: 0,0:09:58.83,0:10:00.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, begitu.
Dialogue: 0,0:10:00.12,0:10:04.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bereskan semua Undead itu, Jamiant.
Dialogue: 0,0:10:10.63,0:10:11.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami datang membantu.
Dialogue: 0,0:10:11.84,0:10:13.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, cepat lari!
Dialogue: 0,0:10:19.27,0:10:21.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, cukup seperti ini.
Dialogue: 0,0:10:21.39,0:10:23.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Jamiant.
Dialogue: 0,0:10:23.89,0:10:25.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berdiri tegak.
Dialogue: 0,0:10:26.40,0:10:29.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Angkat tangan kananmu tinggi-tinggi.
Dialogue: 0,0:10:30.90,0:10:32.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pukul kepala.
Dialogue: 0,0:10:36.66,0:10:39.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, terima kasih kerja samanya.
Dialogue: 0,0:10:46.08,0:10:48.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suiton: Mizu Shuriken!
Dialogue: 0,0:10:48.92,0:10:50.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Futon: Kaze Shuriken!
Dialogue: 0,0:10:52.55,0:10:54.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suiton: Suisousen!
Dialogue: 0,0:10:54.68,0:10:56.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Futon: Fusousen!
Dialogue: 0,0:11:02.39,0:11:04.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Futon: Kaze Rougoku.
Dialogue: 0,0:11:12.90,0:11:13.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Sasuke.
Dialogue: 0,0:11:17.62,0:11:20.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan langsung berpikir untuk kabur.
Dialogue: 0,0:11:20.49,0:11:22.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuh akan bisa menebakmu.
Dialogue: 0,0:11:29.92,0:11:33.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petarung yang kuat harus mampu\Nmengejutkan lawan.
Dialogue: 0,0:11:34.09,0:11:36.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuh yang terkejut\Nakan memperlihatkan celah.
Dialogue: 0,0:11:37.97,0:11:40.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan soal cepat atau kuat.
Dialogue: 0,0:11:40.30,0:11:45.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu harus selalu ingat ini\Nsaat menghadapi lawan yang lebih kuat.
Dialogue: 0,0:11:46.14,0:11:49.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lengah di saat-saat terakhir.
Dialogue: 0,0:11:49.31,0:11:51.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maafkan aku.
Dialogue: 0,0:11:51.07,0:11:53.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku, aku salah.
Dialogue: 0,0:11:56.03,0:11:57.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kamu baik-baik saja.
Dialogue: 0,0:11:58.66,0:12:02.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan membuatku merasakan sakitnya\Nkehilangan keluarga lagi.
Dialogue: 0,0:12:03.16,0:12:04.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak.
Dialogue: 0,0:12:05.33,0:12:07.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Futon: Kaze Shuriken!
Dialogue: 0,0:12:17.42,0:12:18.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Futon:
Dialogue: 0,0:12:20.55,0:12:22.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fusousen!
Dialogue: 0,0:12:28.89,0:12:30.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dik Chiyome!
Dialogue: 0,0:12:47.04,0:12:48.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tembok es?
Dialogue: 0,0:12:48.79,0:12:49.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fusousen!
Dialogue: 0,0:12:50.71,0:12:52.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suiton: Mizu Shuriken!
Dialogue: 0,0:13:04.72,0:13:05.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chiyome!
Dialogue: 0,0:13:05.36,0:13:06.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dik Chiyome!
Dialogue: 0,0:13:08.10,0:13:12.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku masih memiliki keraguan.
Dialogue: 0,0:13:13.56,0:13:15.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak sudah tidak ada.
Dialogue: 0,0:13:15.61,0:13:18.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terus meyakinkan diriku seperti itu.
Dialogue: 0,0:13:19.11,0:13:23.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, jauh di lubuk hatiku\Ntidak mengharapkan hal itu.
Dialogue: 0,0:13:24.53,0:13:28.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai melibatkan anak ini\Nhanya untuk membunuhku.
Dialogue: 0,0:13:28.95,0:13:32.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak yang sesungguhnya\Ntidak akan melakukan itu.
Dialogue: 0,0:13:32.96,0:13:36.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah bukan Kak Sasuke lagi!
Dialogue: 0,0:13:36.96,0:13:38.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku titip anak ini.
Dialogue: 0,0:13:44.89,0:13:47.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknik pedang Kakak tidaklah selemah itu.
Dialogue: 0,0:13:48.21,0:13:50.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Futon: Kaze Shuriken,
Dialogue: 0,0:13:50.56,0:13:51.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kiwami!
Dialogue: 0,0:13:51.85,0:13:54.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suiton: Mizu Shuriken,
Dialogue: 0,0:13:54.03,0:13:55.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kiwami!
Dialogue: 0,0:14:01.03,0:14:03.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jutsu Kakak tidaklah selemah itu.
Dialogue: 0,0:14:04.49,0:14:07.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Futon: Fujinto, Nagi!
Dialogue: 0,0:14:14.12,0:14:15.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak itu...
Dialogue: 0,0:14:15.71,0:14:17.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak bukanlah...
Dialogue: 0,0:14:55.42,0:14:57.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Futon: Rasen Kamaitachi!
Dialogue: 0,0:14:59.42,0:15:00.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dik Chiyome!
Dialogue: 0,0:15:11.81,0:15:13.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah berakhir.
Dialogue: 0,0:15:18.69,0:15:21.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi itu hanya bunshin elemen air.
Dialogue: 0,0:15:22.34,0:15:23.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu penuh celah.
Dialogue: 0,0:15:25.11,0:15:28.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suiton: Suiketsu Shingokuso!
Dialogue: 0,0:15:43.13,0:15:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya kamu lengah\Ndi saat-saat terakhir.
Dialogue: 0,0:15:48.89,0:15:51.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah menjadi lebih kuat, ya.
Dialogue: 0,0:15:56.52,0:15:59.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Sasuke.
Dialogue: 0,0:16:02.44,0:16:04.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia masih punya kesadaran?
Dialogue: 0,0:16:04.03,0:16:06.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat panggil Arc untuk menyembuhkannya!
Dialogue: 0,0:16:06.28,0:16:07.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma.
Dialogue: 0,0:16:08.28,0:16:12.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir penyembuh tak akan mempan\Npada tubuh yang sudah jadi mayat.
Dialogue: 0,0:16:16.75,0:16:19.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu masih mengingatnya, ya.
Dialogue: 0,0:16:20.00,0:16:21.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:16:21.63,0:16:24.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petarung kuat yang sesungguhnya...
Dialogue: 0,0:16:24.50,0:16:27.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus bisa mengejutkan lawan.
Dialogue: 0,0:16:27.05,0:16:28.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu satu lagi.
Dialogue: 0,0:16:29.34,0:16:33.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yaitu mereka yang rela mempertaruhkan\Nnyawanya demi orang lain.
Dialogue: 0,0:16:35.68,0:16:38.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku, Chiyome.
Dialogue: 0,0:16:39.31,0:16:40.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergi di tangan keluarga...
Dialogue: 0,0:16:41.73,0:16:44.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergi di tanganmu sendiri
Dialogue: 0,0:16:44.69,0:16:46.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah penghormatan terbaik.
Dialogue: 0,0:16:48.65,0:16:50.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:17:05.58,0:17:06.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi?
Dialogue: 0,0:17:07.33,0:17:08.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita selamat?
Dialogue: 0,0:17:11.30,0:17:14.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Kakak bertarung\Ndengan kekuatan aslinya,
Dialogue: 0,0:17:14.01,0:17:16.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku pasti tidak akan bisa berkutik.
Dialogue: 0,0:17:17.59,0:17:19.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas bantuannya,
Dialogue: 0,0:17:19.89,0:17:21.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Ariane.
Dialogue: 0,0:17:21.59,0:17:24.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, kita langsung menyusul\NTuan Danka dan lainnya.
Dialogue: 0,0:17:24.73,0:17:27.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}No-Nona Ariane, ada apa?
Dialogue: 0,0:17:28.53,0:17:30.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak perlu menahannya lagi.
Dialogue: 0,0:17:31.61,0:17:35.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia orang yang sangat berharga, kan?
Dialogue: 0,0:17:38.34,0:17:40.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:17:53.51,0:17:56.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua Undead-nya tidak mau bergerak lagi!
Dialogue: 0,0:17:56.51,0:17:59.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sebenarnya Palurumo lakukan?
Dialogue: 0,0:17:59.54,0:18:01.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sedang apa?
Dialogue: 0,0:18:01.64,0:18:05.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak bicara tapi ujungnya gagal juga.
Dialogue: 0,0:18:05.02,0:18:07.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gagal?\NMaksudnya aku?
Dialogue: 0,0:18:07.47,0:18:09.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menghancurkan Tajient
Dialogue: 0,0:18:09.94,0:18:13.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah tugasmu, Kardinal Charros.
Dialogue: 0,0:18:15.16,0:18:19.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku di sini hanya sebatas asistenmu.
Dialogue: 0,0:18:19.20,0:18:20.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak berjalan lancar,
Dialogue: 0,0:18:20.79,0:18:23.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semua tanggung jawabmu.
Dialogue: 0,0:18:25.92,0:18:29.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kardinal yang lain juga\Nsudah mulai bergerak.
Dialogue: 0,0:18:29.50,0:18:31.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mendekati para bangsawan,
Dialogue: 0,0:18:31.51,0:18:35.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk memengaruhi negara dari dalam.
Dialogue: 0,0:18:35.80,0:18:38.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu melakukan eksperimen
Dialogue: 0,0:18:38.26,0:18:40.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk memperkuat kekuatan tempur.
Dialogue: 0,0:18:40.77,0:18:46.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua itu dilakukan demi membawa\Ndunia ini ke dalam kekacauan.
Dialogue: 0,0:18:46.27,0:18:48.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dunia kacau,
Dialogue: 0,0:18:48.15,0:18:51.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}orang-orang akan mencari keselamatan\Ndan bergantung pada agama Hilk.
Dialogue: 0,0:18:51.23,0:18:54.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa diberi tahu pun aku sudah tahu!
Dialogue: 0,0:18:54.03,0:18:56.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu lakukanlah\Napa yang seharusnya dilakukan.
Dialogue: 0,0:18:56.74,0:18:58.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi Bapa Paus.
Dialogue: 0,0:19:02.16,0:19:05.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin, Sasuke pasti berterima kasih.
Dialogue: 0,0:19:05.48,0:19:08.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga berterima kasih, Chiyome.
Dialogue: 0,0:19:08.29,0:19:09.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tsubone.
Dialogue: 0,0:19:10.38,0:19:11.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ariane.
Dialogue: 0,0:19:13.22,0:19:15.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Danka?\NBagaimana penyelamatannya?
Dialogue: 0,0:19:15.55,0:19:16.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lancar.
Dialogue: 0,0:19:16.68,0:19:18.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua yang diculik
Dialogue: 0,0:19:18.35,0:19:21.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah dibawa keluar oleh Ein.
Dialogue: 0,0:19:21.81,0:19:23.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:19:23.23,0:19:25.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya masalahmu juga sudah selesai.
Dialogue: 0,0:19:26.23,0:19:27.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:19:30.23,0:19:32.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan Undead sudah berhenti!
Dialogue: 0,0:19:32.78,0:19:34.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fokuslah untuk menyerang Jamiant!
Dialogue: 0,0:19:34.74,0:19:37.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang sudah mulai\Nmembalikkan keadaan.
Dialogue: 0,0:19:37.08,0:19:39.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah sebaiknya kita ikut membantu?
Dialogue: 0,0:19:39.74,0:19:42.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, hasilnya sudah terkendali.
Dialogue: 0,0:19:42.20,0:19:44.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tak perlu terlibat lebih jauh.
Dialogue: 0,0:19:44.12,0:19:45.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:19:45.58,0:19:47.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, di mana Arc?
Dialogue: 0,0:19:47.20,0:19:49.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?\NOh, benar juga.
Dialogue: 0,0:19:50.38,0:19:54.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, sembari bertarung\Naku malah berjalan terlalu jauh.
Dialogue: 0,0:19:54.97,0:19:57.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Ariane dan lainnya ada di mana?
Dialogue: 0,0:20:01.64,0:20:03.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Charros, tolong kami!
Dialogue: 0,0:20:03.85,0:20:06.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong pinjamkan kami kekuatan!
Dialogue: 0,0:20:06.02,0:20:06.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Charros!
Dialogue: 0,0:20:06.85,0:20:08.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di kota ada Jamiant dan Undead!
Dialogue: 0,0:20:08.73,0:20:10.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami semua bisa mati!
Dialogue: 0,0:20:11.27,0:20:13.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Oh, itu Tuan Charros!\N- Tuan Charros sudah muncul!
Dialogue: 0,0:20:13.23,0:20:15.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tolong kami, Tuan Charros!\N- Tuan Charros sudah muncul!
Dialogue: 0,0:20:15.49,0:20:17.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong selamatkan kami!
Dialogue: 0,0:20:23.24,0:20:27.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, kalian semua berisik!
Dialogue: 0,0:20:34.13,0:20:36.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, kota ini juga akan hancur!
Dialogue: 0,0:20:36.63,0:20:40.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu,\Nakan kubebaskan kalian dari ketakutan!
Dialogue: 0,0:20:43.43,0:20:46.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat makan!
Dialogue: 0,0:20:52.44,0:20:56.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya aku ingin membiarkanmu\Ntumbuh dulu sebelum kumakan.
Dialogue: 0,0:20:56.94,0:20:59.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi mubazir kalau dibiarkan.
Dialogue: 0,0:21:06.54,0:21:09.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ponta, bawa anak ini ke tempat aman.
Dialogue: 0,0:21:14.21,0:21:16.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kamu?
Dialogue: 0,0:21:16.34,0:21:19.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal masalah Undead baru selesai.
Dialogue: 0,0:21:19.16,0:21:21.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga dari Gereja Hilk?
Dialogue: 0,0:21:21.22,0:21:24.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk apa aku harus menjawab pertanyaanmu?
Dialogue: 0,0:21:24.72,0:21:26.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mengganggu waktu makan anak-anakku!
Dialogue: 0,0:21:26.97,0:21:28.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makan?
Dialogue: 0,0:21:34.31,0:21:37.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah merusak kesenangan anak-anakku!
Dialogue: 0,0:21:40.24,0:21:43.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan sihir mengerikan apa ini?
Dialogue: 0,0:21:43.87,0:21:47.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada sesuatu\Nyang tidak masuk akal telah muncul?
Dialogue: 0,0:21:47.17,0:21:49.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo bergegas ke sana!
Dialogue: 0,0:21:51.06,0:21:53.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan memaafkanmu lagi.
Dialogue: 0,0:21:53.79,0:21:59.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anakku akan memakan kalian semua!
Dialogue: 0,0:22:04.34,0:22:08.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya pertarungan melawan bos\Nmendadak dimulai.
