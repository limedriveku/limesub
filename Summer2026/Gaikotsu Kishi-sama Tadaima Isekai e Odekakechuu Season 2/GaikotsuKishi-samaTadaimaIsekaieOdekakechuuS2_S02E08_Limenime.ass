Dialogue: 0,0:00:04.23,0:00:06.85,sign,,0000,0000,0000,,LANDFREA
Dialogue: 0,0:02:09.47,0:02:13.03,sign,,0000,0000,0000,,KESATRIA TENGKORAK BERKELANA DI DUNIA LAIN\NMUSIM KEDUA
Dialogue: 0,0:11:25.96,0:11:30.96,sign,,0000,0000,0000,,EPISODE 8: DENGARLAH GEMURUH OMBAK,\NWAHAI DUKA HATI KUNOICHI
Dialogue: 0,0:19:25.52,0:19:29.02,sign,,0000,0000,0000,,PRIMUS, KERAJAAN AGUNG FOBNACH
Dialogue: 0,0:23:39.94,0:23:44.94,sign,,0000,0000,0000,,SELANJUTNYA: REUNI BERSAMA AUMAN\NSANG BINATANG HITAM
Dialogue: 0,0:23:44.94,0:23:51.45,sign,,0000,0000,0000,,#PONTASAATINIJUGASEDANGBERKELANA\NHATI-HATI ADA KRAKEN!
Dialogue: 0,0:00:02.19,0:00:04.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, aku Arc.
Dialogue: 0,0:00:04.23,0:00:06.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya tiba di Kota Landfrea.
Dialogue: 0,0:00:06.85,0:00:11.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari sini, petualangan laut\Nmenyeberangi samudra akan dimulai!
Dialogue: 0,0:00:13.62,0:00:15.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat itu, kapalnya luar biasa.
Dialogue: 0,0:00:15.29,0:00:18.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Landfrea memang beda dari pelabuhan lain.
Dialogue: 0,0:00:18.83,0:00:20.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemandangan megah!
Dialogue: 0,0:00:20.47,0:00:22.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapal-kapal besar berjejer seperti ini.
Dialogue: 0,0:00:22.96,0:00:25.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Spektakuler dan nostalgia!
Dialogue: 0,0:00:26.30,0:00:27.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga merasakannya, Ponta?
Dialogue: 0,0:00:27.88,0:00:29.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Romantisme lautan ini!
Dialogue: 0,0:00:30.43,0:00:33.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesatria, elf, dan dua manusia hewan.
Dialogue: 0,0:00:34.39,0:00:38.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian rombongan yang mau\Nmenyeberang ke benua selatan?
Dialogue: 0,0:00:38.10,0:00:39.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu siapa?
Dialogue: 0,0:00:39.19,0:00:42.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang mengurus kapal untuk kalian.
Dialogue: 0,0:00:42.19,0:00:44.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, mohon bantuannya.
Dialogue: 0,0:00:45.55,0:00:48.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, pelabuhannya besar sekali, ya.
Dialogue: 0,0:00:48.19,0:00:52.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya tempat ini jadi pusat perdagangan\Ndengan benua selatan.
Dialogue: 0,0:00:52.20,0:00:56.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, banyak juga yang ke sini\Nuntuk mencari tanah baru.
Dialogue: 0,0:00:56.45,0:00:58.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat para perintis, ya.
Dialogue: 0,0:00:58.16,0:01:01.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, romantisme dalam\Nmengejar masa depan baru.
Dialogue: 0,0:01:01.54,0:01:02.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu.
Dialogue: 0,0:01:02.75,0:01:05.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapal yang akan kalian naiki.
Dialogue: 0,0:01:05.09,0:01:09.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh!\NPerlengkapan kapalnya terlihat kokoh, ya.
Dialogue: 0,0:01:09.09,0:01:11.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapal-kapal yang menyeberang ke benua selatan
Dialogue: 0,0:01:11.97,0:01:15.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hampir semuanya dipersenjatai\Ndan dilapisi baja dari sisik naga.
Dialogue: 0,0:01:15.85,0:01:19.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya harus sekuat itu\Nuntuk mengusir musuh.
Dialogue: 0,0:01:19.10,0:01:21.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuh?\NApa ada bajak laut yang muncul?
Dialogue: 0,0:01:21.89,0:01:24.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan itu, tapi kraken.
Dialogue: 0,0:01:24.48,0:01:27.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya, monster cumi atau gurita?
Dialogue: 0,0:01:27.98,0:01:30.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kadang suka muncul.
Dialogue: 0,0:01:30.64,0:01:32.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ukurannya sangat besar.
Dialogue: 0,0:01:32.99,0:01:35.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dia!\NKraken raksasa!
Dialogue: 0,0:01:35.87,0:01:39.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster ikonik lautan yang sering muncul\Ndi berbagai film dan gim!
Dialogue: 0,0:01:39.66,0:01:42.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah aroma fantasi lautan\Nyang sesungguhnya!
Dialogue: 0,0:01:44.21,0:01:46.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi ingin melihatnya.
Dialogue: 0,0:01:46.75,0:01:49.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, jangan mengatakan hal\Nyang mengerikan.
Dialogue: 0,0:01:49.84,0:01:52.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, maafkan aku.
Dialogue: 0,0:02:33.59,0:02:36.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dia!\NKraken raksasa!
Dialogue: 0,0:02:36.05,0:02:38.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster ikonik lautan.
Dialogue: 0,0:02:38.68,0:02:41.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah aroma fantasi lautan\Nyang sesungguhnya!
Dialogue: 0,0:03:29.23,0:03:31.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita berangkat!
Dialogue: 0,0:03:40.58,0:03:43.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau di laut paling pas memang pose begini.
Dialogue: 0,0:03:43.45,0:03:45.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau jatuh pakai zirah begini
Dialogue: 0,0:03:45.96,0:03:48.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti bakal tenggelam dengan cepat.
Dialogue: 0,0:03:48.79,0:03:51.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya jangan, aku jadi takut.
Dialogue: 0,0:03:53.63,0:03:55.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?\NDi mana Nona Chiyome?
Dialogue: 0,0:03:55.91,0:03:57.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sana.
Dialogue: 0,0:04:02.68,0:04:06.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kenapa?\NTerlihat tidak bersemangat.
Dialogue: 0,0:04:06.81,0:04:11.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, Chiyome dipenuhi kecemasan karena\Nakan pergi ke dunia yang belum dikenal.
Dialogue: 0,0:04:11.71,0:04:13.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seorang gadis yang lemah.
Dialogue: 0,0:04:14.15,0:04:15.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi begitu.
Dialogue: 0,0:04:15.68,0:04:16.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bercanda.
Dialogue: 0,0:04:16.82,0:04:17.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lah!
Dialogue: 0,0:04:18.74,0:04:19.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma bercanda?
Dialogue: 0,0:04:19.86,0:04:22.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seorang gadis yang hatinya penuh harapan.
Dialogue: 0,0:04:22.74,0:04:27.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena mungkin akan bertemu\Ndengan pria tampan nan memesona.
Dialogue: 0,0:04:28.54,0:04:29.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi begitu.
Dialogue: 0,0:04:29.71,0:04:30.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bercanda.
Dialogue: 0,0:04:30.92,0:04:31.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lah!
Dialogue: 0,0:04:32.75,0:04:33.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bercanda juga?
Dialogue: 0,0:04:33.96,0:04:35.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlalu bertele-tele, deh.
Dialogue: 0,0:04:35.55,0:04:38.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dia sedang memikirkan Sasuke.
Dialogue: 0,0:04:39.13,0:04:42.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sasuke? Apa dia seseorang\Nyang dekat dengan Nona Chiyome?
Dialogue: 0,0:04:42.72,0:04:44.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kakaknya Chiyome.
Dialogue: 0,0:04:44.22,0:04:46.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata Nona Chiyome punya kakak, ya.
Dialogue: 0,0:04:47.52,0:04:50.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi mereka tak punya hubungan darah.
Dialogue: 0,0:04:50.65,0:04:53.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, sebelum kita berangkat,
Dialogue: 0,0:04:53.31,0:04:55.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Hanzo sudah memperingatkan kami.
Dialogue: 0,0:04:58.57,0:05:02.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau yang menyerang elf tersebut\Nadalah Sasuke,
Dialogue: 0,0:05:02.32,0:05:03.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ini adalah masalah besar.
Dialogue: 0,0:05:03.78,0:05:08.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untungnya, sejauh ini tidak menjadi\Nkeributan besar di kalangan elf.
Dialogue: 0,0:05:08.16,0:05:10.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus memastikan kebenarannya.
Dialogue: 0,0:05:11.33,0:05:14.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku serahkan pada kalian, Tsubone, Chiyome.
Dialogue: 0,0:05:15.13,0:05:16.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:05:17.13,0:05:19.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Hanzo sampai mengatakan hal seperti itu?
Dialogue: 0,0:05:19.92,0:05:23.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, memanggil kakak\Nmeski tak punya hubungan sedarah.
Dialogue: 0,0:05:23.84,0:05:27.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya mereka punya ikatan\Nyang sangat erat, ya.
Dialogue: 0,0:05:27.56,0:05:29.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau membicarakan hal itu,
Dialogue: 0,0:05:29.35,0:05:32.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pertama aku harus ceritakan dulu\Nbagaimana seorang Chiyome
Dialogue: 0,0:05:32.85,0:05:34.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa datang ke desa kami.
Dialogue: 0,0:05:35.48,0:05:38.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tak salah mungkin\Nsudah tujuh tahun yang lalu?
Dialogue: 0,0:05:38.63,0:05:40.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan Rowe...
Dialogue: 0,0:05:40.15,0:05:41.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rowe?
Dialogue: 0,0:05:41.86,0:05:45.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama Sasuke sebelum\Nmenyandang gelar Enam Ninja.
Dialogue: 0,0:05:45.29,0:05:49.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari itu, saat perjalanan pulang\Nsetelah menyelesaikan misi,
Dialogue: 0,0:05:50.05,0:05:52.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami melewati sebuah desa.
Dialogue: 0,0:06:01.63,0:06:04.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jahat sekali.\NIni pasti ulah sekelompok bandit.
Dialogue: 0,0:06:05.26,0:06:06.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kembali.
Dialogue: 0,0:06:28.33,0:06:30.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kita bawa dia ke desa.
Dialogue: 0,0:06:38.21,0:06:39.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah bangun?
Dialogue: 0,0:06:40.88,0:06:42.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini di mana?
Dialogue: 0,0:06:42.38,0:06:44.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desa Klan Jinshin.
Dialogue: 0,0:06:44.93,0:06:47.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami menyelamatkanmu\Nyang pingsan di bawah jurang.
Dialogue: 0,0:06:48.39,0:06:51.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu Ibu?\NDi mana Ibu?
Dialogue: 0,0:06:53.56,0:06:56.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang selamat hanya kamu seorang.
Dialogue: 0,0:07:03.99,0:07:05.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuat...
Dialogue: 0,0:07:07.53,0:07:09.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku
Dialogue: 0,0:07:09.62,0:07:11.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ingin menjadi kuat.
Dialogue: 0,0:07:12.33,0:07:15.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menjadi kuat.
Dialogue: 0,0:07:15.54,0:07:19.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjadi kuat!
Dialogue: 0,0:07:36.48,0:07:38.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat desanya diserang,
Dialogue: 0,0:07:38.19,0:07:41.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kabarnya, ibunya meninggal\Nkarena melindunginya.
Dialogue: 0,0:07:45.24,0:07:50.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itulah Chiyome menganggap\Nkematian ibunya adalah kesalahannya.
Dialogue: 0,0:07:52.58,0:07:55.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi itu bukan salahnya.
Dialogue: 0,0:07:55.41,0:07:57.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi dia masih anak-anak.
Dialogue: 0,0:07:57.25,0:07:58.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:07:58.54,0:08:01.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dia pasti sulit menerimanya.
Dialogue: 0,0:08:01.13,0:08:02.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya dia ingin menjadi kuat.
Dialogue: 0,0:08:02.75,0:08:04.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan sungguh-sungguh.
Dialogue: 0,0:08:07.97,0:08:09.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun, payah banget.
Dialogue: 0,0:08:09.89,0:08:11.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah berapa kali meleset?
Dialogue: 0,0:08:15.10,0:08:17.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat tubuhmu lebih rileks lagi.
Dialogue: 0,0:08:19.48,0:08:21.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Rowe.
Dialogue: 0,0:08:21.73,0:08:23.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan langsung pakai tenaga di awal.
Dialogue: 0,0:08:24.17,0:08:26.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nantinya keseimbanganmu bisa goyah.
Dialogue: 0,0:08:27.28,0:08:28.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:08:31.37,0:08:33.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhasil!\NKena!
Dialogue: 0,0:08:33.28,0:08:35.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, seperti itu.
Dialogue: 0,0:08:35.27,0:08:37.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus berlatih dan tingkatkan akurasimu.
Dialogue: 0,0:08:37.54,0:08:39.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik!
Dialogue: 0,0:08:40.08,0:08:42.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik sekali kamu padanya.
Dialogue: 0,0:08:42.84,0:08:44.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar lebih efisien saja.
Dialogue: 0,0:08:44.91,0:08:46.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Efisien?
Dialogue: 0,0:08:46.55,0:08:48.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau yang tingkat bawah jadi lebih hebat,
Dialogue: 0,0:08:48.87,0:08:52.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang lain pasti tidak akan mau kalah.
Dialogue: 0,0:08:52.34,0:08:55.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hasilnya, semua orang akan berkembang.
Dialogue: 0,0:08:55.10,0:08:56.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:08:56.91,0:08:58.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu hanya alasan.
Dialogue: 0,0:08:59.77,0:09:02.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasakan keistimewaan dari anak itu.
Dialogue: 0,0:09:02.35,0:09:03.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istimewa?
Dialogue: 0,0:09:03.79,0:09:06.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin bisa dibilang tekad yang kuat?
Dialogue: 0,0:09:06.98,0:09:09.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat anak itu bangun setelah diselamatkan,
Dialogue: 0,0:09:09.96,0:09:12.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku pikir dia akan terus mengeluh.
Dialogue: 0,0:09:13.50,0:09:14.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata tidak.
Dialogue: 0,0:09:15.87,0:09:19.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak itu mengatakan ingin menjadi kuat.
Dialogue: 0,0:09:20.08,0:09:21.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itulah aku merasakannya.
Dialogue: 0,0:09:21.95,0:09:23.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuatu yang tak dimiliki anak lain.
Dialogue: 0,0:09:24.38,0:09:27.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pasti bakat alaminya.
Dialogue: 0,0:09:27.04,0:09:30.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat juang yang tak akan menyerah\Npada apa pun.
Dialogue: 0,0:09:30.63,0:09:33.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin dia pasti akan menjadi kuat.
Dialogue: 0,0:09:33.56,0:09:36.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hingga dapat memikul masa depan desa ini.
Dialogue: 0,0:09:37.64,0:09:39.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat juang yang pantang menyerah, ya.
Dialogue: 0,0:09:39.60,0:09:41.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dik Chiyome ternyata kuat, ya.
Dialogue: 0,0:09:41.81,0:09:46.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tak kusangka Nona Chiyome\Nmenjalani hidup yang berat.
Dialogue: 0,0:09:46.40,0:09:48.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:09:48.15,0:09:52.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuai perkataan Rowe,\Nkemampuan Mia meningkat pesat.
Dialogue: 0,0:09:53.70,0:09:58.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan Rowe merawat Mia\Nbagaikan adiknya sendiri.
Dialogue: 0,0:09:59.62,0:10:00.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:10:00.45,0:10:02.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bergerak lima menit duluan\Ntapi sudah terkejar.
Dialogue: 0,0:10:02.62,0:10:03.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat sekali!
Dialogue: 0,0:10:03.75,0:10:05.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan dia ini?
Dialogue: 0,0:10:08.96,0:10:10.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua gagal.
Dialogue: 0,0:10:11.24,0:10:13.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan!\NJangan kalah, Mia!
Dialogue: 0,0:10:13.30,0:10:15.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunjukkan tekadmu sebagai murid pelatihan!
Dialogue: 0,0:10:19.64,0:10:22.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuanmu sudah meningkat pesat, ya.
Dialogue: 0,0:10:22.56,0:10:23.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Futon,
Dialogue: 0,0:10:24.81,0:10:26.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaze Shuriken!
Dialogue: 0,0:10:34.74,0:10:36.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini pun gagal.
Dialogue: 0,0:10:36.41,0:10:39.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan langsung berpikir untuk kabur.
Dialogue: 0,0:10:39.24,0:10:41.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuh akan bisa menebakmu.
Dialogue: 0,0:10:41.24,0:10:44.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan berusaha bergerak lebih cepat lagi.
Dialogue: 0,0:10:44.75,0:10:47.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sama sekali tak mengerti\Nyang kukatakan, ya.
Dialogue: 0,0:10:48.50,0:10:52.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mia, menurutmu petarung\Nyang kuat itu seperti apa?
Dialogue: 0,0:10:53.30,0:10:54.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal itu...
Dialogue: 0,0:10:54.80,0:10:56.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih cepat dan kuat.
Dialogue: 0,0:10:56.97,0:10:57.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah.
Dialogue: 0,0:10:58.47,0:11:02.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petarung yang kuat\Nadalah mampu mengejutkan lawan.
Dialogue: 0,0:11:02.77,0:11:05.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuh yang terkejut akan\Nmemperlihatkan celah.
Dialogue: 0,0:11:06.69,0:11:09.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan soal cepat atau kuat.
Dialogue: 0,0:11:09.65,0:11:14.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu harus selalu ingat ini\Nsaat menghadapi lawan yang lebih kuat.
Dialogue: 0,0:11:14.24,0:11:16.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan aku ingat baik-baik!
Dialogue: 0,0:11:22.73,0:11:24.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita kembali ke desa.
Dialogue: 0,0:11:24.03,0:11:25.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:11:32.63,0:11:34.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak itu, Mia terus berlatih dengan giat.
Dialogue: 0,0:11:34.80,0:11:39.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, Rowe pun terpilih sebagai Enam Ninja\Nyang menjadi pilar Klan Jinshin.
Dialogue: 0,0:11:44.85,0:11:45.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mia?
Dialogue: 0,0:11:46.09,0:11:49.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat atas penobatan gelar Enam Ninja,\NKak Rowe.
Dialogue: 0,0:11:49.61,0:11:51.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, bukan, Tuan Sasuke.
Dialogue: 0,0:11:51.73,0:11:54.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga akan berjuang\Nagar bisa menyusul Tuan Sasuke!
Dialogue: 0,0:11:54.94,0:11:56.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke sini hanya untuk bilang begitu?
Dialogue: 0,0:11:56.89,0:11:58.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:11:58.24,0:12:00.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga sudah mulai dapat\Nmisi pertama, ya?
Dialogue: 0,0:12:00.70,0:12:02.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:12:02.03,0:12:04.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ini hanya tugas pengintaian biasa.
Dialogue: 0,0:12:04.50,0:12:05.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lengah.
Dialogue: 0,0:12:06.87,0:12:09.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam misi tidak ada\Nyang namanya tugas biasa.
Dialogue: 0,0:12:09.58,0:12:11.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf.
Dialogue: 0,0:12:11.96,0:12:13.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bercanda.
Dialogue: 0,0:12:14.30,0:12:17.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misi pertamaku juga benar-benar kacau.
Dialogue: 0,0:12:17.35,0:12:19.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Benarkah?
Dialogue: 0,0:12:19.22,0:12:20.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:12:20.09,0:12:23.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terpeleset dan jatuh di saat-saat penting.
Dialogue: 0,0:12:23.05,0:12:25.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau malah gentar duluan\Nsaat bertemu musuh.
Dialogue: 0,0:12:27.02,0:12:30.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada orang yang langsung sempurna.
Dialogue: 0,0:12:30.00,0:12:31.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti saat pakai shuriken.
Dialogue: 0,0:12:31.48,0:12:35.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan melemaskan bahumu,\Nketegangannya akan terasa seimbang.
Dialogue: 0,0:12:35.03,0:12:37.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu,\Njangan lengah sampai benar-benar berakhir.
Dialogue: 0,0:12:38.53,0:12:39.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:12:40.57,0:12:41.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:12:41.53,0:12:45.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pikir Tuan Sasuke\Nadalah orang yang berpengalaman.
Dialogue: 0,0:12:45.29,0:12:47.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata pernah melalui masa seperti itu.
Dialogue: 0,0:12:47.53,0:12:50.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tidak, semua itu cuma bohong.
Dialogue: 0,0:12:50.71,0:12:52.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya?
Dialogue: 0,0:12:52.25,0:12:54.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena yang bodoh itu sebenarnya aku.
Dialogue: 0,0:12:54.80,0:12:57.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak awal Sasuke itu sempurna.
Dialogue: 0,0:12:58.07,0:13:01.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misi pertama Sasuke itu dilakukan bersamaku.
Dialogue: 0,0:13:08.14,0:13:11.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat panik hingga tubuhku terdiam.
Dialogue: 0,0:13:17.82,0:13:19.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelah sini!
Dialogue: 0,0:13:19.28,0:13:21.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Niatnya hanya mengintai,
Dialogue: 0,0:13:21.49,0:13:23.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau begini, tak ada cara lain.
Dialogue: 0,0:13:23.28,0:13:24.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mundurlah.
Dialogue: 0,0:13:31.96,0:13:35.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Sasuke mengalahkan semuanya sendiri.
Dialogue: 0,0:13:36.05,0:13:41.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Sasuke sengaja berbohong\Nuntuk mengendurkan ketegangan Nona Chiyome?
Dialogue: 0,0:13:41.21,0:13:42.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik sekali.
Dialogue: 0,0:13:42.63,0:13:43.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:13:47.58,0:13:51.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat Tuan Sasuke, aku bisa selesaikan\Nmisi pertama dengan aman.
Dialogue: 0,0:13:53.65,0:13:54.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang mengejar?
Dialogue: 0,0:13:54.69,0:13:56.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, aura ini...
Dialogue: 0,0:13:59.03,0:14:00.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster apa ini?
Dialogue: 0,0:14:00.99,0:14:01.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat!
Dialogue: 0,0:14:01.95,0:14:03.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini...
Dialogue: 0,0:14:04.24,0:14:05.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus pakai itu!
Dialogue: 0,0:14:13.96,0:14:16.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suiton: Suiketsu Shingoku So!
Dialogue: 0,0:14:25.76,0:14:28.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhasil!\NAku bisa mengalahkannya!
Dialogue: 0,0:14:30.52,0:14:32.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada satu lagi?
Dialogue: 0,0:14:32.10,0:14:35.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Futon: Rasen Kamaitachi!
Dialogue: 0,0:14:41.82,0:14:44.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bilang, jangan lengah.
Dialogue: 0,0:14:44.74,0:14:46.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Sasuke?
Dialogue: 0,0:14:46.36,0:14:50.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belakangan ini aku dengar\Nada Snow Giant muncul di daerah sini.
Dialogue: 0,0:14:50.16,0:14:52.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung aku datang mengeceknya.
Dialogue: 0,0:14:52.16,0:14:55.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lengah di saat-saat terakhir.
Dialogue: 0,0:14:55.00,0:14:56.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maafkan aku.
Dialogue: 0,0:14:56.71,0:14:59.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku, aku salah.
Dialogue: 0,0:15:01.63,0:15:03.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kamu baik-baik saja.
Dialogue: 0,0:15:04.30,0:15:07.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan buat aku merasakan sakitnya\Nkehilangan keluarga lagi.
Dialogue: 0,0:15:08.76,0:15:10.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak.
Dialogue: 0,0:15:12.68,0:15:14.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu,
Dialogue: 0,0:15:14.23,0:15:17.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu sudah meningkat pesat\Ndalam waktu sesingkat ini.
Dialogue: 0,0:15:18.06,0:15:21.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kamu memiliki bakat luar biasa.
Dialogue: 0,0:15:22.48,0:15:24.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:15:24.44,0:15:27.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu, kemampuan Mia diakui,
Dialogue: 0,0:15:27.53,0:15:31.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan secara resmi mewarisi\Nnama Chiyome dari Enam Ninja.
Dialogue: 0,0:15:31.83,0:15:36.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak saat itu, mereka berdua menjalani\Nbanyak misi sulit bersama-sama.
Dialogue: 0,0:15:37.29,0:15:41.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi misi sulit itulah\Nyang mempererat ikatan mereka, ya?
Dialogue: 0,0:15:41.80,0:15:44.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti aku dan Arc, ya.
Dialogue: 0,0:15:44.43,0:15:44.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:15:45.50,0:15:46.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:15:46.84,0:15:49.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, setelah menginjak usia dewasa,
Dialogue: 0,0:15:49.68,0:15:52.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka pasti menyadari\Nperasaan satu sama lain.
Dialogue: 0,0:15:53.89,0:15:57.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaan mendalam yang membara\Ndi antara mereka.
Dialogue: 0,0:15:57.39,0:16:02.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sebagai seorang shinobi,\Nhati mereka saling terkekang!
Dialogue: 0,0:16:02.15,0:16:04.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, dalam suatu misi...
Dialogue: 0,0:16:04.99,0:16:06.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih ada lanjutannya, ya.
Dialogue: 0,0:16:07.70,0:16:09.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keseruannya baru akan dimulai.
Dialogue: 0,0:16:17.87,0:16:19.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup sampai di situ!
Dialogue: 0,0:16:19.29,0:16:20.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam dan menyerahlah.
Dialogue: 0,0:16:23.67,0:16:24.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chiyome!
Dialogue: 0,0:16:24.84,0:16:26.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berdua terdesak.
Dialogue: 0,0:16:26.84,0:16:30.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemudian perasaan\Nyang saling terkekang itu akhirnya...
Dialogue: 0,0:16:30.34,0:16:33.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Sasuke,\Nlari saja tak usah pedulikan aku!
Dialogue: 0,0:16:33.81,0:16:36.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku rela berkorban demi dirimu.
Dialogue: 0,0:16:36.48,0:16:38.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara apa kamu, Chiyome?
Dialogue: 0,0:16:38.45,0:16:41.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau kamu hilang dari hidupku!
Dialogue: 0,0:16:41.31,0:16:43.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu mati, aku juga memilih mati!
Dialogue: 0,0:16:43.23,0:16:44.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak!
Dialogue: 0,0:16:44.32,0:16:45.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chiyome!
Dialogue: 0,0:16:47.86,0:16:49.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mencintaimu.
Dialogue: 0,0:16:49.48,0:16:50.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak akan kulepaskan lagi.
Dialogue: 0,0:16:55.62,0:16:57.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemandangan yang indah.
Dialogue: 0,0:16:57.62,0:17:00.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cinta tak memandang lawan dan kawan!
Dialogue: 0,0:17:00.54,0:17:02.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!
Dialogue: 0,0:17:02.15,0:17:05.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita semua hidup di dunia yang indah ini!
Dialogue: 0,0:17:05.67,0:17:08.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita rayakan bersama-sama!
Dialogue: 0,0:17:11.01,0:17:12.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cinta terlarang yang membara.
Dialogue: 0,0:17:12.93,0:17:15.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti itulah cintanya bersemi.
Dialogue: 0,0:17:15.81,0:17:18.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sembarangan membuat\Ndrama yang aneh-aneh!
Dialogue: 0,0:17:19.43,0:17:21.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, sejak kapan kamu mendengarnya?
Dialogue: 0,0:17:21.84,0:17:23.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak awal!
Dialogue: 0,0:17:23.23,0:17:25.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Telingaku ini bukan pajangan.
Dialogue: 0,0:17:25.42,0:17:27.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagian awal aku terima.
Dialogue: 0,0:17:27.44,0:17:29.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi yang terakhir itu bohong!
Dialogue: 0,0:17:29.36,0:17:30.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:17:30.71,0:17:33.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, terlalu tidak masuk akal.
Dialogue: 0,0:17:33.24,0:17:35.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terlalu berlebihan, ya.
Dialogue: 0,0:17:35.39,0:17:38.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan pikirkan diriku.
Dialogue: 0,0:17:38.00,0:17:40.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dik Chiyome.
Dialogue: 0,0:17:40.00,0:17:43.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang mengkhawatirkan Kak Sasuke.
Dialogue: 0,0:17:43.63,0:17:45.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Khawatir, tapi...
Dialogue: 0,0:17:45.17,0:17:46.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuh, kan?
Dialogue: 0,0:17:46.30,0:17:49.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya bukan ke arah situ!
Dialogue: 0,0:17:54.64,0:17:57.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh!\NItu kraken raksasa!
Dialogue: 0,0:17:57.10,0:17:58.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ditunggu-tunggu!
Dialogue: 0,0:17:58.72,0:18:00.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tunggu, jangan malah senang!\N- Bagaimana kabarmu?
Dialogue: 0,0:18:00.99,0:18:04.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Chiyome, dalam hidup itu\Nada dua hal yang perlu dikhawatirkan.
Dialogue: 0,0:18:06.30,0:18:09.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang pertama, adalah hal\Nyang masih bisa kita atasi sendiri.
Dialogue: 0,0:18:09.28,0:18:13.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang kedua, adalah hal\Nyang ada di luar kendali kita.
Dialogue: 0,0:18:14.51,0:18:17.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang di luar kendali biarkan saja\Nterjadi sesuai kehendak.
Dialogue: 0,0:18:17.81,0:18:22.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, mari bergerak bersamaku\Ndan melampiaskan semuanya!
Dialogue: 0,0:18:22.63,0:18:23.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:18:23.54,0:18:26.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita lomba siapa yang bisa\Nmengalahkan monster itu duluan.
Dialogue: 0,0:18:29.50,0:18:31.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terima tantangan itu.
Dialogue: 0,0:18:31.88,0:18:34.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal tadi bicaranya kedengaran bijak.
Dialogue: 0,0:18:49.44,0:18:52.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini, buat cumi asin kering\Nuntuk seribu orang bukanlah masalah.
Dialogue: 0,0:18:52.74,0:18:54.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau sebesar ini...
Dialogue: 0,0:18:54.53,0:18:56.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal itu serahkan padaku!
Dialogue: 0,0:18:59.83,0:19:01.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tertolong, Tuan Kesatria!
Dialogue: 0,0:19:01.95,0:19:03.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona juga hebat!
Dialogue: 0,0:19:03.91,0:19:05.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana, Nona Chiyome?
Dialogue: 0,0:19:05.54,0:19:07.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa perasaanmu sudah sedikit lega?
Dialogue: 0,0:19:07.92,0:19:09.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:19:09.54,0:19:12.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu, ini mau dimakan?
Dialogue: 0,0:19:12.40,0:19:16.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya dibakar di atas arang dan dimakan\Ndengan garam rasanya akan enak.
Dialogue: 0,0:19:17.66,0:19:20.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa lagi!
Dialogue: 0,0:19:21.77,0:19:25.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, cumi sebanyak ini mau kita apakan?
Dialogue: 0,0:19:34.03,0:19:39.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kota ini ternyata ramai\Nakan berbagai manusia hewan, ya.
Dialogue: 0,0:19:39.03,0:19:43.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerajaan Agung Fobnach adalah negeri\Nyang diperintah oleh kaum manusia hewan.
Dialogue: 0,0:19:43.08,0:19:45.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena ada berbagai ras manusia binatang,
Dialogue: 0,0:19:45.66,0:19:48.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}budaya dan adat istiadatnya\Nbercampur aduk.
Dialogue: 0,0:19:48.92,0:19:50.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi begitu.
Dialogue: 0,0:19:51.29,0:19:55.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau lihat keadaan Danka\Ndi tempat dia memulihkan diri.
Dialogue: 0,0:19:55.38,0:19:56.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:19:58.93,0:20:01.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, cabai merah!
Dialogue: 0,0:20:01.39,0:20:03.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan ada tomat juga!
Dialogue: 0,0:20:03.43,0:20:06.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada pasta,\Nbahan-bahan ini bisa dipakai.
Dialogue: 0,0:20:06.69,0:20:08.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku beli saja, deh.
Dialogue: 0,0:20:08.35,0:20:11.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Red Nail dan tomat dijadikan masakan?
Dialogue: 0,0:20:11.83,0:20:14.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya dipakai buat apa\Nkalau bukan untuk masak?
Dialogue: 0,0:20:14.44,0:20:17.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Red Nail dijadikan bubuk\Nuntuk membutakan musuh.
Dialogue: 0,0:20:17.15,0:20:20.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedangkan tomat ada racunnya,\Nkalau langsung dimakan bisa sakit perut.
Dialogue: 0,0:20:20.94,0:20:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi harus hilangkan racunnya dulu.
Dialogue: 0,0:20:22.70,0:20:23.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:20:23.91,0:20:27.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata berbeda dengan cabai\Ndan tomat yang aku ketahui.
Dialogue: 0,0:20:27.08,0:20:30.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau ada banyak kedai begini,
Dialogue: 0,0:20:30.50,0:20:34.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku jadi ingin menunjukkan\Nkemampuan memasakku.
Dialogue: 0,0:20:35.84,0:20:38.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, kita kan punya bahan\Nyang bisa dijual!
Dialogue: 0,0:20:40.22,0:20:41.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:20:41.60,0:20:45.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Antrean apa ini?\NPadahal tadi tidak ada.
Dialogue: 0,0:20:45.60,0:20:48.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, aromanya enak pula.
Dialogue: 0,0:20:48.69,0:20:49.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:20:49.56,0:20:51.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang!
Dialogue: 0,0:20:51.15,0:20:53.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan cumi bakar krakennya!
Dialogue: 0,0:20:54.98,0:20:56.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau dua tusuk!
Dialogue: 0,0:20:56.69,0:20:58.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tiga tusuk!
Dialogue: 0,0:20:58.70,0:21:01.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari, silakan antre dulu!
Dialogue: 0,0:21:01.28,0:21:03.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dia, dua cumi bakar sudah matang!
Dialogue: 0,0:21:03.33,0:21:05.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, apa yang kalian lakukan?
Dialogue: 0,0:21:05.79,0:21:07.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Nona Ariane.
Dialogue: 0,0:21:07.54,0:21:09.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena punya banyak bahan cumi-cumi,
Dialogue: 0,0:21:09.66,0:21:12.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku terpikir sekalian saja\Ndijual ke orang-orang.
Dialogue: 0,0:21:12.71,0:21:14.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cumi bakar, Nona Ariane?
Dialogue: 0,0:21:14.92,0:21:17.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ini bicara apa?
Dialogue: 0,0:21:17.26,0:21:19.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup menggoda, kan?
Dialogue: 0,0:21:23.01,0:21:26.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun, meleng sedikit langsung begini.
Dialogue: 0,0:21:26.81,0:21:28.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, tidak apa-apa.
Dialogue: 0,0:21:28.73,0:21:30.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahan cumi-cuminya bisa habis,
Dialogue: 0,0:21:30.31,0:21:32.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita pun dapat uang banyak.
Dialogue: 0,0:21:32.60,0:21:36.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, bagaimana keadaan Tuan Danka?
Dialogue: 0,0:21:36.21,0:21:37.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal itu...
Dialogue: 0,0:21:37.44,0:21:40.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya Danka sudah tidak ada di kota ini.
Dialogue: 0,0:21:40.61,0:21:42.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
