Dialogue: 0,0:00:00.00,0:00:01.21,sign,,0000,0000,0000,,PAKSA KAKAKKU MENYELESAIKAN GIM OTOME
Dialogue: 0,0:00:01.21,0:00:03.02,sign,,0000,0000,0000,,"DAN PERGI KE LUAR NEGERI"
Dialogue: 0,0:00:03.02,0:00:04.43,sign,,0000,0000,0000,,"BERSAMA TEMAN-TEMANNYA"
Dialogue: 0,0:00:04.43,0:00:05.95,sign,,0000,0000,0000,,"YA - TIDAK"
Dialogue: 0,0:03:21.58,0:03:24.21,sign,,0000,0000,0000,,"TUTUP MULUT KOTORMU, SAMPAH"
Dialogue: 0,0:00:01.21,0:00:03.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam arti tertentu,
Dialogue: 0,0:00:03.02,0:00:04.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hidup itu seperti gim.
Dialogue: 0,0:00:04.43,0:00:05.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tergantung pilihanmu,
Dialogue: 0,0:00:05.95,0:00:08.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau bisa saja berakhir\Ndengan akhir yang sangat buruk.
Dialogue: 0,0:00:11.05,0:00:14.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau liburanku terganggu,
Dialogue: 0,0:00:14.36,0:00:16.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi kuabaikan orang tuaku\Nyang mencoba meneleponku.
Dialogue: 0,0:00:17.37,0:00:20.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku tak tahu kalau kakakku meninggal
Dialogue: 0,0:00:20.61,0:00:22.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tak menghadiri pemakamannya.
Dialogue: 0,0:00:22.73,0:00:25.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kehilangan kepercayaan\Norang tuaku padaku.
Dialogue: 0,0:00:27.03,0:00:30.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku diusir dari rumah,\Ndan kerja di jalanan malam hari.
Dialogue: 0,0:00:31.38,0:00:36.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua pria yang kutemui di sana\Ncuma kejar uang atau sering selingkuh.
Dialogue: 0,0:00:36.14,0:00:38.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya benar-benar sampah.
Dialogue: 0,0:00:39.39,0:00:43.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nasibku pada pria sangat buruk.\NWaktu punya bayi, mereka kabur.
Dialogue: 0,0:00:44.14,0:00:47.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah lahirkan putriku,\Naku berhenti dari kerja malam,
Dialogue: 0,0:00:47.48,0:00:50.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi hidup makin susah tiap harinya.
Dialogue: 0,0:00:50.11,0:00:53.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya, aku harus\Nbergantung pada orang tuaku.
Dialogue: 0,0:00:53.99,0:00:57.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sepakat\Naku akan tinggal terpisah dari putriku,
Dialogue: 0,0:00:57.87,0:01:00.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}temui dia beberapa kali sebulan,
Dialogue: 0,0:01:00.47,0:01:03.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kemudian aku berakhir\Ndengan pria jahat lainnya.
Dialogue: 0,0:01:04.87,0:01:08.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembalikan!\NAku simpan uang itu untuk putriku!
Dialogue: 0,0:01:08.87,0:01:13.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, diam! Sudah kubilang\Nakan kugandakan dan kukembalikan!
Dialogue: 0,0:01:13.08,0:01:16.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon! Hari ini hari ulang tahunnya!
Dialogue: 0,0:01:16.84,0:01:18.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pikir aku peduli?
Dialogue: 0,0:01:18.67,0:01:22.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon! Apa saja, asal jangan uang itu!
Dialogue: 0,0:01:22.46,0:01:24.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tutup mulutmu!
Dialogue: 0,0:01:29.01,0:01:31.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam saja!\NLakukan yang priamu perintahkan!
Dialogue: 0,0:01:34.85,0:01:38.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuhku tak mau bergerak...
Dialogue: 0,0:01:39.17,0:01:40.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putriku...
Dialogue: 0,0:01:40.90,0:01:42.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin bertemu putriku...
Dialogue: 0,0:01:43.80,0:01:45.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamatkan aku...
Dialogue: 0,0:01:45.39,0:01:48.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamatkan aku, Kakak!
Dialogue: 0,0:01:55.62,0:01:56.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Trapped in a Dating Sim
Dialogue: 0,0:01:59.33,0:02:00.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}The World of Otome Games\Nis Tough for Mobs
Dialogue: 0,0:02:09.13,0:02:17.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Trapped in a Dating Sim 2: The World\Nof Otome Games is Tough for Mobs
Dialogue: 0,0:03:21.58,0:03:24.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau tinggalkan putrimu
Dialogue: 0,0:03:24.21,0:03:25.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bersama Ayah dan Ibu?
Dialogue: 0,0:03:26.52,0:03:29.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata mereka akan urus\Ncucu perempuan mereka yang berharga,
Dialogue: 0,0:03:29.38,0:03:31.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku harus urus diriku sendiri.
Dialogue: 0,0:03:31.80,0:03:32.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak punya perasaan, ya?
Dialogue: 0,0:03:32.95,0:03:34.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, sama sekali tidak.
Dialogue: 0,0:03:34.70,0:03:35.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak punya perasaan!
Dialogue: 0,0:03:35.62,0:03:41.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius? Wanita yang kacaukan semua hal\Ndi dunia ini adikku sendiri?
Dialogue: 0,0:03:41.11,0:03:42.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hatiku menangis.
Dialogue: 0,0:03:42.76,0:03:46.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua\Nsepertinya bukan lagi berakting.
Dialogue: 0,0:03:46.52,0:03:50.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cerita soal kehidupan masa lalu\Ndan gim otome sekarang jauh lebih nyata.
Dialogue: 0,0:03:50.26,0:03:52.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau masih ragukan aku?
Dialogue: 0,0:03:52.59,0:03:59.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, aku diserang pria sampah,\Ndan waktu sadar, aku ada di dunia ini.
Dialogue: 0,0:03:59.40,0:04:00.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tee-hee!
Dialogue: 0,0:04:00.46,0:04:03.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan! Isi dalammu wanita tua!\NKau bikin aku merinding!
Dialogue: 0,0:04:03.95,0:04:07.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau bahas itu?!\NKau juga tua di dalam tubuh itu, Kakak!
Dialogue: 0,0:04:08.35,0:04:09.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terserahlah.
Dialogue: 0,0:04:09.66,0:04:11.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang kau harus bekerja sama dengan kami.
Dialogue: 0,0:04:12.27,0:04:14.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bantu kami kalahkan bos akhir.
Dialogue: 0,0:04:14.19,0:04:15.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?!
Dialogue: 0,0:04:15.75,0:04:20.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini, aku akan mati\Ndi dunia ini juga! Gara-gara eksekusi!
Dialogue: 0,0:04:20.24,0:04:21.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, betul.
Dialogue: 0,0:04:21.91,0:04:23.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya yang bisa kau lakukan\Ndi kehidupan keduamu
Dialogue: 0,0:04:23.54,0:04:25.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah hadapi kehidupan itu langsung.
Dialogue: 0,0:04:25.78,0:04:27.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mau!
Dialogue: 0,0:04:27.73,0:04:30.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamatkan aku, Kak!
Dialogue: 0,0:04:30.19,0:04:33.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam! Lagi pula, jangan mulai\Npanggil aku "kakak"!
Dialogue: 0,0:04:33.20,0:04:36.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau melawan monster itu!
Dialogue: 0,0:04:36.19,0:04:40.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak berhak bicara!\NSalahmu sendiri seluruh cerita jadi kacau!
Dialogue: 0,0:04:40.94,0:04:41.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh!
Dialogue: 0,0:04:42.26,0:04:45.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan bertanggung jawab\Ndan aktifkan kapal kerajaan.
Dialogue: 0,0:04:45.94,0:04:49.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan dukung Livia,\Nprotagonis sebenarnya.
Dialogue: 0,0:04:51.06,0:04:52.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:04:52.60,0:04:54.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Olivia?!
Dialogue: 0,0:04:54.88,0:04:56.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa harus dia?!
Dialogue: 0,0:04:57.35,0:05:00.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisakah kau selamatkan aku?
Dialogue: 0,0:05:02.66,0:05:03.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:05:03.99,0:05:05.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:05:06.08,0:05:09.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Viscount, persiapan pertempuran\Nsudah selesai.
Dialogue: 0,0:05:11.09,0:05:14.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua bangsawan yang tanggapi\Npanggilan Yang Mulia sudah tiba.
Dialogue: 0,0:05:14.96,0:05:16.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan datang ke ruang audiensi.
Dialogue: 0,0:05:22.14,0:05:23.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Marie?
Dialogue: 0,0:05:23.19,0:05:26.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanita itu!\NDia mau kabur sekarang?!
Dialogue: 0,0:05:28.33,0:05:30.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ange, tetaplah bersama Leon!
Dialogue: 0,0:05:30.43,0:05:32.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan periksa dia.
Dialogue: 0,0:05:32.43,0:05:33.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku akan...
Dialogue: 0,0:05:33.94,0:05:38.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergilah ke Leon.\NCuma kau yang bisa bantu dia sekarang.
Dialogue: 0,0:05:38.80,0:05:39.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Livia?
Dialogue: 0,0:05:42.50,0:05:46.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul. Aku tak bisa menghalangi jalannya.
Dialogue: 0,0:05:46.89,0:05:49.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak layak untuk Leon.
Dialogue: 0,0:05:49.87,0:05:53.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tahu itu sejak awal.
Dialogue: 0,0:05:53.81,0:05:57.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal ada Ange...\NKenapa aku masih bersikeras pada Leon?
Dialogue: 0,0:06:04.35,0:06:05.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau...
Dialogue: 0,0:06:08.83,0:06:10.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kukembalikan!
Dialogue: 0,0:06:10.43,0:06:11.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:06:11.29,0:06:13.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kukembalikan semuanya padamu!
Dialogue: 0,0:06:13.94,0:06:16.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kembalikan padaku juga!
Dialogue: 0,0:06:16.96,0:06:22.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia dan empat lainnya, juga Kyle,\Ndan posisi Saint! Semua milikmu!
Dialogue: 0,0:06:22.97,0:06:25.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kembalikan padaku!
Dialogue: 0,0:06:25.40,0:06:27.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa yang kau bicarakan?
Dialogue: 0,0:06:27.39,0:06:28.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak...
Dialogue: 0,0:06:29.01,0:06:32.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia! Kembalikan Leon padaku!
Dialogue: 0,0:06:32.03,0:06:34.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kukembalikan semuanya padamu!
Dialogue: 0,0:06:39.42,0:06:44.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini terasa tidak asing.\NOrang tuaku juga tampar aku begini.
Dialogue: 0,0:06:44.71,0:06:46.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sangat sakit.
Dialogue: 0,0:06:46.79,0:06:48.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau anggap aku apa?!
Dialogue: 0,0:06:48.44,0:06:50.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leon bukan apa-apa!
Dialogue: 0,0:06:50.50,0:06:51.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leon...
Dialogue: 0,0:06:53.56,0:06:54.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukan milikku...
Dialogue: 0,0:06:55.82,0:06:57.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bukan milikku...
Dialogue: 0,0:06:58.76,0:07:01.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leon dan Ange cocok.
Dialogue: 0,0:07:01.98,0:07:04.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus berhenti mengharapkannya.
Dialogue: 0,0:07:04.21,0:07:05.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus, apa?
Dialogue: 0,0:07:05.93,0:07:09.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya aku kehilangan segalanya,\Ndan cuma begitu saja?
Dialogue: 0,0:07:09.40,0:07:13.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir semuanya akan berhasil kali ini.\NKenapa?!
Dialogue: 0,0:07:13.84,0:07:16.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku tidak pernah bisa\Ntemukan kebahagiaan?!
Dialogue: 0,0:07:20.22,0:07:21.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Marie!
Dialogue: 0,0:07:21.61,0:07:23.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rupanya kau di sini?
Dialogue: 0,0:07:23.36,0:07:26.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua... Kenapa?
Dialogue: 0,0:07:28.39,0:07:33.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku sangat senang\Nwaktu kau menyelamatkanku.
Dialogue: 0,0:07:34.63,0:07:39.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat kau selalu berusaha keras,\Naku rasa aku bisa lakukan itu juga.
Dialogue: 0,0:07:39.86,0:07:43.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi... Jadi, tolong jangan menangis.
Dialogue: 0,0:07:44.38,0:07:45.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Carla...
Dialogue: 0,0:07:45.91,0:07:49.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona, kau mementingkan diri sendiri\Ndan egois.
Dialogue: 0,0:07:49.09,0:07:51.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau cuma kasih aku kesulitan.
Dialogue: 0,0:07:52.65,0:07:57.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku juga tahu\Nkau bisa baik dan perhatian.
Dialogue: 0,0:07:58.38,0:08:01.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penghinaan itu bikin kaget kami semua,
Dialogue: 0,0:08:01.17,0:08:05.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi akan sangat menyedihkan\Nkalau aku dan Carla tidak tetap bersamamu.
Dialogue: 0,0:08:07.30,0:08:10.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku, kalian berdua...
Dialogue: 0,0:08:10.72,0:08:12.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sungguh minta maaf...
Dialogue: 0,0:08:12.40,0:08:13.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Marie...
Dialogue: 0,0:08:13.75,0:08:15.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ayo pergi.
Dialogue: 0,0:08:16.18,0:08:19.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mungkin palsu, tapi kau tetap Saint.
Dialogue: 0,0:08:19.04,0:08:21.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya kau harus mainkan peran itu.
Dialogue: 0,0:08:27.29,0:08:28.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembohong.
Dialogue: 0,0:08:29.33,0:08:32.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak kehilangan segalanya.
Dialogue: 0,0:08:32.91,0:08:35.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau punya dua orang yang mendukungmu.
Dialogue: 0,0:08:38.03,0:08:39.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pembohong.
Dialogue: 0,0:08:41.87,0:08:43.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat aku sendirian...
Dialogue: 0,0:08:44.52,0:08:47.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat tak ada lagi yang tersisa untukku...
Dialogue: 0,0:08:50.48,0:08:51.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Livia...
Dialogue: 0,0:08:52.96,0:08:57.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tentu saja. Kau juga sudah lama\Npunya perasaan pada Leon.
Dialogue: 0,0:08:57.83,0:08:58.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Livia.
Dialogue: 0,0:09:00.49,0:09:01.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ange?
Dialogue: 0,0:09:02.91,0:09:05.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Marie sudah baik-baik saja.\NDia sudah kembali.
Dialogue: 0,0:09:06.85,0:09:10.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Em, tolong jangan lihat wajahku sekarang.
Dialogue: 0,0:09:10.19,0:09:11.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada beberapa hal terjadi...
Dialogue: 0,0:09:11.86,0:09:12.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Livia.
Dialogue: 0,0:09:14.39,0:09:16.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cinta Leon.
Dialogue: 0,0:09:21.31,0:09:23.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, jangan mundur darinya.
Dialogue: 0,0:09:23.55,0:09:24.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:09:25.51,0:09:27.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri tahu Leon perasaanmu yang sebenarnya.
Dialogue: 0,0:09:29.23,0:09:30.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah beri tahu dia.
Dialogue: 0,0:09:31.36,0:09:32.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah pernah bilang.
Dialogue: 0,0:09:34.19,0:09:38.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi Leon tetap tidak mau kasih aku jawaban.
Dialogue: 0,0:09:39.47,0:09:41.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pasti karena dia cinta kau, Ange.
Dialogue: 0,0:09:41.80,0:09:43.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu...
Dialogue: 0,0:09:43.67,0:09:46.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, kau perlu bilang sekali lagi.
Dialogue: 0,0:09:46.67,0:09:48.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubilang perasaanku juga.
Dialogue: 0,0:09:51.77,0:09:55.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya akan baik-baik saja.\NAkan kubuat dia tidak bisa kabur.
Dialogue: 0,0:09:57.83,0:10:00.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi... kau yakin?
Dialogue: 0,0:10:00.91,0:10:05.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau dan Leon sama-sama bangsawan,\Ndan kalian cocok.
Dialogue: 0,0:10:05.72,0:10:10.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bodoh! Perbedaan pangkat\Ntidak mengubah siapa yang dicintai!
Dialogue: 0,0:10:12.89,0:10:17.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menyerah semudah itu,\Ntidak ada yang perlu menderita.
Dialogue: 0,0:10:18.07,0:10:22.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu-satunya cara sampaikan perasaanmu\Nadalah bilang berulang kali.
Dialogue: 0,0:10:23.73,0:10:24.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ange...
Dialogue: 0,0:10:28.80,0:10:35.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Livia, kau penting untukku juga,\Njadi jangan menangis.
Dialogue: 0,0:10:36.47,0:10:37.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:10:46.23,0:10:48.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma, Tuan Vandel!
Dialogue: 0,0:10:48.80,0:10:52.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka tidak dilahap dia!\NNyawa mereka terkuras habis!
Dialogue: 0,0:10:53.96,0:10:55.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Vandel!
Dialogue: 0,0:10:59.35,0:11:00.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri...
Dialogue: 0,0:11:05.28,0:11:08.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuserahkan padamu, Tuan Vandel.
Dialogue: 0,0:11:08.56,0:11:12.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Dewa Penjaga takkan berhenti.
Dialogue: 0,0:11:12.58,0:11:16.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau selalu jadi favoritnya.
Dialogue: 0,0:11:16.21,0:11:19.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lebih pilih hindari kurangi\Npertahanan armada utama,
Dialogue: 0,0:11:19.75,0:11:21.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi tidak ada alternatif lain.
Dialogue: 0,0:11:21.49,0:11:26.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pahlawan yang pernah kalah sekali\Ntidak ada artinya.
Dialogue: 0,0:11:26.78,0:11:30.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya perpaduanmu\Ndengan baju besi sihir sudah selesai.
Dialogue: 0,0:11:30.98,0:11:31.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:11:32.86,0:11:37.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya itu memberi kekuatan\Nsebagai imbalan nyawa penggunanya.
Dialogue: 0,0:11:38.26,0:11:41.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu-satunya yang dipilih\Noleh kekuatan ini adalah aku.
Dialogue: 0,0:11:43.59,0:11:44.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:11:49.29,0:11:50.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster.
Dialogue: 0,0:11:50.97,0:11:55.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Count Gelatt, ada panggilan\Ndari Marquess Frampton dari Kerajaan.
Dialogue: 0,0:11:55.34,0:11:57.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi? Dia bisa sangat menyebalkan!
Dialogue: 0,0:11:58.35,0:12:02.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah saatnya dia sadar\Nakan kebodohannya sendiri!
Dialogue: 0,0:12:02.59,0:12:06.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar bodoh.\NBagaimana bisa kau biarkan Bartfort kabur?
Dialogue: 0,0:12:06.54,0:12:08.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maafkan aku.
Dialogue: 0,0:12:08.58,0:12:11.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia dapat perlindungan Yang Mulia.\NAku tidak bisa serang dia.
Dialogue: 0,0:12:12.04,0:12:13.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vince...
Dialogue: 0,0:12:13.99,0:12:15.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kau hubungi Kerajaan Fanoss?
Dialogue: 0,0:12:15.89,0:12:20.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka tidak jawab.\NSudah kucoba hubungi mereka beberapa kali.
Dialogue: 0,0:12:21.34,0:12:22.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?!
Dialogue: 0,0:12:22.75,0:12:25.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa mereka terus maju?
Dialogue: 0,0:12:25.44,0:12:28.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sudah maju jauh melampaui wilayah\Nyang seharusnya diserahkan.
Dialogue: 0,0:12:28.53,0:12:31.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka hampir sampai di ibu kota kerajaan!
Dialogue: 0,0:12:32.51,0:12:34.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Akan kucoba hubungi mereka sekali lagi.
Dialogue: 0,0:12:35.47,0:12:36.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti.
Dialogue: 0,0:12:37.82,0:12:38.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak perlu.
Dialogue: 0,0:12:40.24,0:12:45.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah terlalu sering gagal.\NKau akan bertanggung jawab.
Dialogue: 0,0:12:45.48,0:12:47.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bo-Botol itu...
Dialogue: 0,0:12:48.45,0:12:50.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pengorbanan yang perlu.
Dialogue: 0,0:12:51.15,0:12:54.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Politik selalu disertai pengorbanan.
Dialogue: 0,0:12:55.15,0:12:58.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, nikmati segelas rasa terima kasihku.
Dialogue: 0,0:13:01.07,0:13:02.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sudah semuanya?
Dialogue: 0,0:13:02.53,0:13:03.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlalu sedikit!
Dialogue: 0,0:13:03.94,0:13:05.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuh ada tepat di depan kita!
Dialogue: 0,0:13:05.66,0:13:08.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka akan sampai ibu kota kerajaan\Nsatu-dua hari lagi!
Dialogue: 0,0:13:08.05,0:13:10.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerajaan terkutuk...
Dialogue: 0,0:13:10.05,0:13:15.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Heh. Sepertinya lebih sedikit orang\Nyang setia ke Istana dari dugaan kita.
Dialogue: 0,0:13:17.39,0:13:21.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, yang berkumpul di sini\Nadalah pahlawan sejati.
Dialogue: 0,0:13:22.03,0:13:26.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya! Kita tak boleh biarkan\NKerajaan Fanoss terus maju!
Dialogue: 0,0:13:26.27,0:13:28.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekaranglah saatnya pertaruhkan hidup kita!
Dialogue: 0,0:13:30.90,0:13:33.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Viscount Bartfort, maju.
Dialogue: 0,0:13:34.44,0:13:35.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?!
Dialogue: 0,0:13:35.45,0:13:36.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bartfort?!
Dialogue: 0,0:13:36.86,0:13:37.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah dia dipenjara?!
Dialogue: 0,0:13:42.79,0:13:45.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada masa berbahaya\Nbagi Kerajaan Holfort ini,
Dialogue: 0,0:13:45.75,0:13:48.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kuangkat kau sebagai panglima tertinggi.
Dialogue: 0,0:13:49.64,0:13:50.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?!
Dialogue: 0,0:13:51.39,0:13:54.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beberapa orang mungkin\Nanggap dia terlalu muda.
Dialogue: 0,0:13:54.50,0:13:57.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beberapa mungkin tidak percaya dia\Natau kurangnya pengalamannya.
Dialogue: 0,0:13:59.14,0:14:02.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, cuma Viscount yang punya\Nkekuatan untuk buka jalan
Dialogue: 0,0:14:02.73,0:14:03.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menuju kemenangan.
Dialogue: 0,0:14:04.97,0:14:09.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Viscount Bartfort,\Nbisakah kau menangkan perang ini?
Dialogue: 0,0:14:09.78,0:14:12.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau banyak latihan buat sampaikan itu\Ndengan dramatis,
Dialogue: 0,0:14:12.57,0:14:14.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku tidak bisa bilang aku tidak suka.
Dialogue: 0,0:14:16.68,0:14:18.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau memintanya, Yang Mulia.
Dialogue: 0,0:14:20.23,0:14:22.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kalahkan dramaku!
Dialogue: 0,0:14:22.24,0:14:23.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berani bicara.
Dialogue: 0,0:14:23.64,0:14:25.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah dengar kalimat itu.
Dialogue: 0,0:14:25.30,0:14:26.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuberi dia 70 poin.
Dialogue: 0,0:14:27.27,0:14:29.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di-Diam! Ini memalukan!
Dialogue: 0,0:14:30.04,0:14:33.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tunggu, Yang Mulia kesal? Kenapa?
Dialogue: 0,0:14:35.35,0:14:37.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Mylene tersipu...
Dialogue: 0,0:14:38.04,0:14:39.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:14:39.61,0:14:43.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku angkat Viscount Bartfort\Nsebagai panglima tertinggi
Dialogue: 0,0:14:44.11,0:14:46.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan perintahkan dia perang\Nmelawan Kerajaan Fanoss!
Dialogue: 0,0:14:46.75,0:14:48.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu!
Dialogue: 0,0:14:49.67,0:14:54.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia, kau tak boleh percaya\Npemula muda ini!
Dialogue: 0,0:14:54.74,0:14:58.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria ini dicurigai lakukan pengkhianatan!
Dialogue: 0,0:15:00.19,0:15:03.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Marquess Frampton, hentikan\Nkelakuan tak tahu malu ini sekarang!
Dialogue: 0,0:15:04.19,0:15:07.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yang mengarang kejahatannya!
Dialogue: 0,0:15:07.53,0:15:12.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Kau mungkin Ratu, tapi aku tidak bisa\Nmaafkan ucapan begitu!
Dialogue: 0,0:15:12.78,0:15:16.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saatnya untuk bersatu\Ndan berjuang sebagai satu...
Dialogue: 0,0:15:20.91,0:15:24.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tutup mulut kotormu, Sampah.
Dialogue: 0,0:15:24.92,0:15:26.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak kecil...
Dialogue: 0,0:15:27.06,0:15:30.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjaga! Apa yang kalian lakukan?!\NTangkap dia sekarang juga!
Dialogue: 0,0:15:32.58,0:15:33.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kalian lakukan?!
Dialogue: 0,0:15:33.92,0:15:35.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan ini?!
Dialogue: 0,0:15:35.51,0:15:39.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang akan ditangkap atas pengkhianatan\Nkarena kerja sama dengan Kerajaan Fanoss
Dialogue: 0,0:15:39.10,0:15:42.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan taruh Kerajaan Holfort\Ndalam bahaya besar bukan aku.
Dialogue: 0,0:15:42.76,0:15:44.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kau!
Dialogue: 0,0:15:44.14,0:15:47.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong kosong apa ini?! Kenapa aku?!
Dialogue: 0,0:15:47.85,0:15:49.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana buktinya?!
Dialogue: 0,0:15:49.85,0:15:52.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ugh. Sayang sekali.
Dialogue: 0,0:15:52.52,0:15:55.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat baik hati,\Ntadinya akan kumaafkan kau
Dialogue: 0,0:15:55.78,0:15:58.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau kau gabung dengan kami\Nuntuk lawan mereka.
Dialogue: 0,0:15:58.65,0:16:01.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga punya banyak musuh.
Dialogue: 0,0:16:01.08,0:16:03.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para bangsawan bodoh itu\Nkasih tahu aku semuanya.
Dialogue: 0,0:16:04.07,0:16:06.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentang orang-orang\Nyang terkait denganmu juga.
Dialogue: 0,0:16:07.87,0:16:09.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bertindak di balik layar.
Dialogue: 0,0:16:09.65,0:16:11.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai imbalan menyelamatkanmu...
Dialogue: 0,0:16:11.41,0:16:14.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami dapat beberapa pengakuan\Nbahwa salah satu bawahanmu
Dialogue: 0,0:16:14.37,0:16:16.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}perintahkan mereka\Nuntuk bantu Kerajaan Fanoss.
Dialogue: 0,0:16:16.92,0:16:18.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Marquess Frampton?
Dialogue: 0,0:16:18.53,0:16:20.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti ada kesalahan!
Dialogue: 0,0:16:20.14,0:16:22.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah satu bawahanku\Nyang perintahkan mereka?
Dialogue: 0,0:16:23.04,0:16:26.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, maksudmu bukan... Dayle?!
Dialogue: 0,0:16:26.55,0:16:27.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:16:27.85,0:16:29.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi!
Dialogue: 0,0:16:29.83,0:16:32.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Ada apa lagi sekarang?
Dialogue: 0,0:16:33.10,0:16:35.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baron Dayle sudah bunuh diri.
Dialogue: 0,0:16:35.43,0:16:36.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa...
Dialogue: 0,0:16:37.98,0:16:40.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut surat yang tertinggal di tangannya,
Dialogue: 0,0:16:40.66,0:16:41.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia coba tebus dosa
Dialogue: 0,0:16:41.82,0:16:45.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena pakai nama Marquess Frampton\Nuntuk khianati Kerajaan Holfort.
Dialogue: 0,0:16:45.32,0:16:50.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gimana ini bisa terjadi?!\NTidak kusangka dia akan lakukan itu!
Dialogue: 0,0:16:50.35,0:16:53.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia coba limpahkan semuanya ke anteknya?
Dialogue: 0,0:16:54.47,0:16:59.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia, mohon maaf sedalam-dalamnya\Natas pengkhianatan bawahanku!
Dialogue: 0,0:16:59.70,0:17:03.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku tidak tahu soal semua ini!
Dialogue: 0,0:17:04.60,0:17:10.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong... Tolong percaya kesetiaanku!
Dialogue: 0,0:17:10.41,0:17:12.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau aktor yang hebat.
Dialogue: 0,0:17:16.31,0:17:17.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hertrude?
Dialogue: 0,0:17:17.64,0:17:18.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?!
Dialogue: 0,0:17:18.38,0:17:19.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia dari Kerajaan Fanoss!
Dialogue: 0,0:17:19.48,0:17:21.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri negara musuh!
Dialogue: 0,0:17:21.14,0:17:25.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mau bicara denganmu,\Njadi kubawa dia ke sini.
Dialogue: 0,0:17:25.36,0:17:27.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuberi tahu mereka semua
Dialogue: 0,0:17:27.58,0:17:29.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}soal kesepakatanmu dengan Kerajaan Fanoss.
Dialogue: 0,0:17:29.94,0:17:34.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahwa ada kesepakatan,\Nsebagai imbalan menyerahkan wilayah,
Dialogue: 0,0:17:34.13,0:17:37.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau akan dapat dukungan\Nbangun perdamaian antara negara kita.
Dialogue: 0,0:17:37.58,0:17:40.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar anak kecil...
Dialogue: 0,0:17:40.59,0:17:43.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku bisa lenyapkan Marquess sekarang,
Dialogue: 0,0:17:43.46,0:17:46.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasukan Kerajaan Holfort\Nakan berkurang signifikan.
Dialogue: 0,0:17:48.79,0:17:51.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyerahan wilayah\Ntidak sepadan dengan waktu kami.
Dialogue: 0,0:17:52.18,0:17:55.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerajaan Fanoss akan kalahkan\NKerajaan Holfort dengan kekuatan sendiri.
Dialogue: 0,0:17:55.42,0:17:59.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau tidak dapatkan posisi\Nperdana menteri dengan kekuatanmu sendiri?
Dialogue: 0,0:17:59.55,0:18:01.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar wanita!
Dialogue: 0,0:18:02.95,0:18:07.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun juga,\Nkorupsi di dalam Istana sudah terungkap.
Dialogue: 0,0:18:07.67,0:18:10.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vince, kau...
Dialogue: 0,0:18:10.58,0:18:12.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah hebat.
Dialogue: 0,0:18:12.61,0:18:16.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga Redgrave sudah kembali\Njadi faksi terbesar lagi.
Dialogue: 0,0:18:16.67,0:18:18.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawa Yang Mulia ke ruangan lain.
Dialogue: 0,0:18:18.71,0:18:22.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak! Itu semua\Ndemi kebaikan Kerajaan Holfort!
Dialogue: 0,0:18:22.10,0:18:25.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini perlu dilakukan\Nuntuk pertahankan Kerajaan!
Dialogue: 0,0:18:25.73,0:18:29.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hasilnya adalah\Nkau dikhianati Kerajaan Fanoss,
Dialogue: 0,0:18:29.51,0:18:31.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan Kerajaan Holfort\Nada di ambang kehancuran.
Dialogue: 0,0:18:31.99,0:18:33.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam!
Dialogue: 0,0:18:33.95,0:18:37.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pikir siapa yang topang\NKerajaan Holfort bertahun-tahun?!
Dialogue: 0,0:18:37.34,0:18:42.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya, kau buat\Nkeputusan yang salah, Kakek.
Dialogue: 0,0:18:43.35,0:18:44.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak kecil!
Dialogue: 0,0:18:45.48,0:18:48.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu apa yang sudah kukorbankan\Nuntuk bangsa ini?!
Dialogue: 0,0:18:48.93,0:18:53.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takkan kubiarkan anak yang tidak punya\Npengetahuan politik menyangkal itu!
Dialogue: 0,0:18:53.57,0:18:54.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyangkal?
Dialogue: 0,0:18:55.11,0:19:00.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kau salah paham.\NAku akui pencapaianmu.
Dialogue: 0,0:19:00.18,0:19:03.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah topang Kerajaan\Nseperti kesatria sejati selama ini, 'kan?
Dialogue: 0,0:19:03.37,0:19:06.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kerja bagus! Aku hormati kau!
Dialogue: 0,0:19:06.24,0:19:08.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sungguh luar biasa!
Dialogue: 0,0:19:08.98,0:19:10.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:19:10.70,0:19:13.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau kau gagal,\Nkau harus bertanggung jawab.
Dialogue: 0,0:19:14.15,0:19:16.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku seorang marquess!
Dialogue: 0,0:19:16.95,0:19:21.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau cukup tinggi untuk bertanggung jawab\Nkarena taruh Kerajaan dalam bahaya.
Dialogue: 0,0:19:23.86,0:19:27.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau coba membuat tuduhan palsu\Ndan jadikan aku kambing hitam.
Dialogue: 0,0:19:27.90,0:19:29.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti ada banyak orang
Dialogue: 0,0:19:29.15,0:19:31.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang kau kambinghitamkan\Ndengan cara sama sampai sekarang.
Dialogue: 0,0:19:31.97,0:19:34.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa banyak orang yang sudah kau injak?
Dialogue: 0,0:19:34.43,0:19:36.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa maksud itu?!
Dialogue: 0,0:19:36.09,0:19:40.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pengorbanan yang perlu!\NPolitik selalu disertai pengorbanan!
Dialogue: 0,0:19:40.34,0:19:44.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tepat sekali!\NAku setuju sentimen itu.
Dialogue: 0,0:19:44.57,0:19:46.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini demi kebaikan bangsa. Itu saja.
Dialogue: 0,0:19:46.74,0:19:51.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pengorbanan yang perlu!\NPolitik selalu disertai pengorbanan!
Dialogue: 0,0:19:51.43,0:19:54.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau paham maksudku dengan ini semua?
Dialogue: 0,0:19:54.93,0:19:56.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau...
Dialogue: 0,0:19:57.14,0:20:01.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti jadi pecundang lembek.\NKau sudah tamat, Pengecut.
Dialogue: 0,0:20:03.19,0:20:06.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian pecundang\Nyang akan dibuang dan disingkirkan.
Dialogue: 0,0:20:06.66,0:20:09.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau akan terima\Ndan jadi pengorbanan, 'kan?
Dialogue: 0,0:20:09.82,0:20:12.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau takkan bilang kau menolak.
Dialogue: 0,0:20:12.07,0:20:14.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah lakukan hal sama ke orang lain.
Dialogue: 0,0:20:15.59,0:20:20.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, sekarang kau akan jadi\Npengorbanan untuk Kerajaan!
Dialogue: 0,0:20:26.23,0:20:28.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kumaafkan kau\Nkarena cari masalah denganku.
Dialogue: 0,0:20:29.69,0:20:31.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tebuslah dosa-dosamu sendiri.
Dialogue: 0,0:20:32.43,0:20:33.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawa dia pergi.
Dialogue: 0,0:20:35.45,0:20:37.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lepaskan aku! Ini pengkhianatan!
Dialogue: 0,0:20:37.67,0:20:39.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian pikir aku ini siapa?!
Dialogue: 0,0:20:40.52,0:20:44.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena sekarang sudah selesai,\Nada yang mau kuperjelas.
Dialogue: 0,0:20:46.80,0:20:50.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, aku benci kalian semua.
Dialogue: 0,0:20:50.73,0:20:52.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benci kerajaan ini.
Dialogue: 0,0:20:53.95,0:20:55.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alasannya?
Dialogue: 0,0:20:55.11,0:20:59.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian semua terbelakang,\Njadi sekarang aku harus bekerja.
Dialogue: 0,0:21:00.00,0:21:01.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lakukan pekerjaan kalian sekali saja.
Dialogue: 0,0:21:03.60,0:21:07.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedua, aku tidak percaya kalian semua.
Dialogue: 0,0:21:07.79,0:21:11.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tahu kalian tidak percaya aku.
Dialogue: 0,0:21:12.55,0:21:14.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketiga, akan kuberikan posisiku
Dialogue: 0,0:21:14.37,0:21:16.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ke siapa pun di antara kalian kapan saja.
Dialogue: 0,0:21:17.27,0:21:19.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada di antara kalian yang pikir\Nbisa balikkan keadaan
Dialogue: 0,0:21:19.58,0:21:21.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan pimpin Kerajaan Holfort\Nmenuju kemenangan,
Dialogue: 0,0:21:21.56,0:21:22.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maju ke sini.
Dialogue: 0,0:21:24.35,0:21:26.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terakhir, sesuatu yang sangat sederhana.
Dialogue: 0,0:21:26.98,0:21:29.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kalian tidak mau menurutiku,\Nlarilah sekarang.
Dialogue: 0,0:21:31.95,0:21:33.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ragukan aku!
Dialogue: 0,0:21:33.69,0:21:35.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan membantahku!
Dialogue: 0,0:21:35.75,0:21:40.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang boleh kalian lakukan\Ncuma mematuhi perintahku!
Dialogue: 0,0:21:47.05,0:21:49.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berjuang untukku dan mati.
Dialogue: 0,0:21:50.43,0:21:53.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuselamatkan kerajaan ini.
Dialogue: 0,0:23:26.32,0:23:27.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ukur cinta pakai angka?!
Dialogue: 0,0:23:27.99,0:23:30.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang hancur, satu-satu!
Dialogue: 0,0:23:30.00,0:23:32.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leon teriak putus asa\Ngara-gara hasil tak terduga ini!
Dialogue: 0,0:23:32.28,0:23:35.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya."Mengukur Cinta\Ndengan Angka Itu Kacau!"
Dialogue: 0,0:23:35.44,0:23:36.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Ini...
Dialogue: 0,0:23:36.83,0:23:39.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah cintamu ini cinta sejati?
