Dialogue: 0,0:03:04.47,0:03:08.47,sign,,0000,0000,0000,,PERUBAHAN MENDADAK LAINNYA
Dialogue: 0,0:00:08.39,0:00:10.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bartfort ditangkap?!
Dialogue: 0,0:00:10.71,0:00:12.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya dia bekerja sama dengan Kerajaan.
Dialogue: 0,0:00:14.62,0:00:17.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka dapat bukti dari kamarnya!
Dialogue: 0,0:00:17.03,0:00:20.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penolakannya ke Kerajaan cuma kedok?!
Dialogue: 0,0:00:21.98,0:00:23.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjijikkan.
Dialogue: 0,0:00:23.50,0:00:25.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengkhianat Kerajaan kita.
Dialogue: 0,0:00:25.38,0:00:28.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu tahu dia mencurigakan!
Dialogue: 0,0:00:29.26,0:00:33.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fiuh... Astaga, sampai sejauh ini\Nmereka mau menjatuhkan aku.
Dialogue: 0,0:00:34.22,0:00:35.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam, Pengkhianat!
Dialogue: 0,0:00:37.93,0:00:39.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh...
Dialogue: 0,0:00:41.93,0:00:44.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuingat wajahmu.
Dialogue: 0,0:00:48.31,0:00:49.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat itu.
Dialogue: 0,0:00:50.37,0:00:51.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pantas dapat itu.
Dialogue: 0,0:00:52.50,0:00:53.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka?
Dialogue: 0,0:00:53.94,0:00:55.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mencemari nama Akademi!
Dialogue: 0,0:00:55.88,0:00:57.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjahat!
Dialogue: 0,0:00:57.06,0:00:58.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengkhianat!
Dialogue: 0,0:00:58.73,0:01:00.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau! Bangun dan jalan!
Dialogue: 0,0:01:00.82,0:01:02.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enyahlah!
Dialogue: 0,0:01:03.21,0:01:05.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perubahan mendadak lagi, ya?
Dialogue: 0,0:01:05.94,0:01:08.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, setidaknya ini lebih baik\Ndaripada diperlakukan sebagai pahlawan.
Dialogue: 0,0:01:09.60,0:01:10.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leon...
Dialogue: 0,0:01:26.58,0:01:27.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun...
Dialogue: 0,0:01:29.71,0:01:33.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa lagi yang cari masalah\Ndenganku sekarang?
Dialogue: 0,0:01:39.60,0:01:40.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Trapped in a Dating Sim
Dialogue: 0,0:01:43.32,0:01:44.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}The World of Otome Games is Tough for Mobs
Dialogue: 0,0:01:53.16,0:02:01.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Trapped in a Dating Sim 2: The World of\NOtome Games is Tough for Mobs
Dialogue: 0,0:03:09.99,0:03:13.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang, kapal ini dikelola Kerajaan!
Dialogue: 0,0:03:16.07,0:03:17.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minggir!
Dialogue: 0,0:03:17.02,0:03:18.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampah sialan!
Dialogue: 0,0:03:22.46,0:03:24.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istana sudah sita properti ini!
Dialogue: 0,0:03:24.82,0:03:26.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Termasuk baju besi hilangnya!
Dialogue: 0,0:03:27.03,0:03:28.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau menolak, kau disingkirkan!
Dialogue: 0,0:03:51.25,0:03:53.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sudah tangkap Leon Fou Bartfort
Dialogue: 0,0:03:53.21,0:03:55.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atas dugaan pengkhianatan terhadap Istana.
Dialogue: 0,0:03:55.83,0:04:00.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus sekali. Dia ditempatkan\Ndi sel lantai paling bawah penjara.
Dialogue: 0,0:04:00.40,0:04:01.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kami bawa dia ke sana.
Dialogue: 0,0:04:02.27,0:04:03.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:04:06.11,0:04:08.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lewat sini. Jalan!
Dialogue: 0,0:04:12.28,0:04:13.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalan lebih cepat.
Dialogue: 0,0:04:13.76,0:04:17.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Aku sudah jalan secepat mungkin.
Dialogue: 0,0:04:19.79,0:04:21.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Mylene?
Dialogue: 0,0:04:21.10,0:04:23.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leon, kecilkan suaramu.
Dialogue: 0,0:04:23.28,0:04:28.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, tak kusangka bakal ketemu kau di sini!\NUntung aku ditangkap.
Dialogue: 0,0:04:28.95,0:04:32.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar saja,\Ntetap santai dalam situasi begini...
Dialogue: 0,0:04:36.69,0:04:39.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kau kan...
Dialogue: 0,0:04:39.17,0:04:40.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak Ange, Gilbert.
Dialogue: 0,0:04:41.37,0:04:43.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau minta bantuanmu.
Dialogue: 0,0:04:44.19,0:04:45.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bantuan?
Dialogue: 0,0:04:45.78,0:04:51.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leon, seperti sudah kubilang tadi,\Npertikaian di istana sangat sengit.
Dialogue: 0,0:04:51.71,0:04:54.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena Keluarga Redgrave mundur
Dialogue: 0,0:04:54.05,0:04:56.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}setelah pencabutan hak waris Pangeran Julius.
Dialogue: 0,0:04:57.46,0:05:00.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurang lebih, kau penyebabnya.
Dialogue: 0,0:05:02.27,0:05:06.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terutama, faksi Marquess Frampton\Nmendapat banyak dukungan.
Dialogue: 0,0:05:06.64,0:05:10.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia coba lenyapkan\Npengaruh Keluarga Redgrave sepenuhnya.
Dialogue: 0,0:05:11.65,0:05:16.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk dapat kekuasaan,\Ndia coba dekati Kerajaan.
Dialogue: 0,0:05:18.95,0:05:24.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi maksudmu aku ditangkap\Ndemi rencana Marquess dan Kerajaan?
Dialogue: 0,0:05:24.11,0:05:28.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Marquess Frampton anggap kau ancaman\Nkarena kau punya barang hilang.
Dialogue: 0,0:05:29.63,0:05:32.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat mungkin dia gabung dengan Kerajaan
Dialogue: 0,0:05:32.68,0:05:34.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena dendam mereka padamu.
Dialogue: 0,0:05:34.65,0:05:36.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan Kerajaan?
Dialogue: 0,0:05:36.50,0:05:42.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tuntut ganti rugi wilayah invasi,\Ntapi belum ada tanggapan.
Dialogue: 0,0:05:43.39,0:05:47.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau mungkin Marquess yang menunda.
Dialogue: 0,0:05:48.26,0:05:49.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm.
Dialogue: 0,0:05:50.06,0:05:53.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya, kau harus tetap di penjara ini.
Dialogue: 0,0:05:53.96,0:05:57.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami mau kau ungkap orang-orang\Nyang terkait Kerajaan.
Dialogue: 0,0:05:57.83,0:06:01.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka mungkin akan hubungi kau\Nselama kau dipenjara.
Dialogue: 0,0:06:01.01,0:06:03.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi aku ini umpan?
Dialogue: 0,0:06:03.40,0:06:06.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami mau tentukan\Nsiapa musuh dan siapa kawan.
Dialogue: 0,0:06:06.77,0:06:10.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Leon. Ini akan berat bagimu.
Dialogue: 0,0:06:10.54,0:06:11.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Mylene...
Dialogue: 0,0:06:14.66,0:06:17.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Ange dan Livia tahu\Napa yang terjadi padaku?
Dialogue: 0,0:06:17.78,0:06:18.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka tak tahu.
Dialogue: 0,0:06:18.97,0:06:20.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kita tak boleh beri tahu mereka.
Dialogue: 0,0:06:21.11,0:06:22.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini misi rahasia.
Dialogue: 0,0:06:25.31,0:06:26.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya ini?!
Dialogue: 0,0:06:26.97,0:06:29.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau jebak Leon masuk perangkap!
Dialogue: 0,0:06:29.56,0:06:32.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh? Maksudmu apa?
Dialogue: 0,0:06:32.06,0:06:35.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya Marquess Frampton melindungimu.
Dialogue: 0,0:06:37.34,0:06:41.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menjilat Marquess untuk hancurkan Leon!
Dialogue: 0,0:06:41.22,0:06:44.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih baik kalau kau\Ntak menuduhku tanpa bukti.
Dialogue: 0,0:06:44.82,0:06:48.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma karena faksi mereka\Nberselisih dengan keluargamu...
Dialogue: 0,0:06:50.47,0:06:52.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau sejauh ini terhadap Leon?
Dialogue: 0,0:06:55.99,0:06:58.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau berniat mulai perang lagi?
Dialogue: 0,0:06:59.70,0:07:04.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau sangat membenci kami...\NKerajaan?
Dialogue: 0,0:07:04.06,0:07:05.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau tahu?
Dialogue: 0,0:07:07.07,0:07:08.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua puluh tahun lalu,
Dialogue: 0,0:07:08.50,0:07:12.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}setahuku Kerajaan Holfort menyerang\NKerajaan Fanoss tanpa basa-basi.
Dialogue: 0,0:07:15.14,0:07:17.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma untuk perluas wilayah kalian sendiri...
Dialogue: 0,0:07:18.27,0:07:21.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma untuk ambil harta karun\Ndan sumber daya di sana...
Dialogue: 0,0:07:23.15,0:07:26.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, sebut itu "naluri petualang",
Dialogue: 0,0:07:26.31,0:07:30.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian tak cuma serang tentara,\Ntapi juga wanita dan anak-anak.
Dialogue: 0,0:07:33.04,0:07:35.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Prajurit pemberani Kerajaan\Nberhasil usir kalian
Dialogue: 0,0:07:35.68,0:07:37.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lewat pertempuran sulit,
Dialogue: 0,0:07:37.01,0:07:39.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi harganya terlalu mahal.
Dialogue: 0,0:07:40.32,0:07:42.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak mereka... Orang tua mereka...
Dialogue: 0,0:07:42.82,0:07:45.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesedihan rakyat Kerajaan Fanoss\Nyang keluarganya dibunuh...
Dialogue: 0,0:07:45.94,0:07:47.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa pahami rasa sakit itu?
Dialogue: 0,0:07:47.67,0:07:50.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pikir kalian bisa dimaafkan!
Dialogue: 0,0:07:51.39,0:07:56.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Marquess cuma manfaatkan dendammu\Nke Kerajaan Holfort demi untungnya sendiri!
Dialogue: 0,0:07:56.18,0:07:58.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau tak paham itu?!
Dialogue: 0,0:07:59.42,0:08:00.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup.
Dialogue: 0,0:08:03.75,0:08:08.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa biarkan\Nkau kasar pada Putri Hertrude.
Dialogue: 0,0:08:09.68,0:08:11.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau...
Dialogue: 0,0:08:12.14,0:08:15.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri Hertrude,\NMarquess mau bicara denganmu.
Dialogue: 0,0:08:19.33,0:08:20.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini...?
Dialogue: 0,0:08:21.48,0:08:26.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami periksa lagi brankasnya\Nberdasarkan laporan ekspedisi
Dialogue: 0,0:08:26.88,0:08:28.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan temukan ini.
Dialogue: 0,0:08:29.82,0:08:33.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lengan baju besi kuno\Ntercatat dalam laporan.
Dialogue: 0,0:08:33.45,0:08:36.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin ini barang hilang.
Dialogue: 0,0:08:36.58,0:08:40.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Sangat mirip\Ndengan yang ada di pulau elf.
Dialogue: 0,0:08:42.78,0:08:48.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya ini sepasang\Ndengan barang hilang lainnya.
Dialogue: 0,0:08:48.10,0:08:52.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan merasa terhormat\Nkalau Kerajaan mau memanfaatkannya.
Dialogue: 0,0:08:53.83,0:08:58.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau boleh, aku ingin kau kembalikan\Nseruling ajaib dan pedang Vandel.
Dialogue: 0,0:08:59.35,0:09:03.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga kerajaan simpan itu rapat\Ndi balik gembok dan kunci.
Dialogue: 0,0:09:03.78,0:09:08.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyuap orang punya risiko yang cukup besar.
Dialogue: 0,0:09:08.13,0:09:08.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hmph.
Dialogue: 0,0:09:09.85,0:09:12.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini, rencana sebelumnya\Nbisa dilaksanakan.
Dialogue: 0,0:09:12.77,0:09:17.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin akan berguna untuk paksa\NKerajaan Fanoss serahkan tanah.
Dialogue: 0,0:09:19.00,0:09:21.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau dapat tanahmu,
Dialogue: 0,0:09:21.05,0:09:24.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan aku buat perdamaian di antara kita\Nuntuk dapatkan kedudukan.
Dialogue: 0,0:09:24.42,0:09:27.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini menguntungkan kita berdua.
Dialogue: 0,0:09:30.32,0:09:33.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, bagaimana dengan Viscount Bartfort?
Dialogue: 0,0:09:33.69,0:09:38.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain kapalnya,\Nkami sita barang hilangnya, baju besi hitam.
Dialogue: 0,0:09:38.81,0:09:41.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah dipenjara juga.
Dialogue: 0,0:09:42.51,0:09:48.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya, semua yang bisa mengancam Kerajaan\Nsudah tak berdaya lagi.
Dialogue: 0,0:09:49.39,0:09:52.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya hari kami panggil kau\NPerdana Menteri sudah dekat.
Dialogue: 0,0:09:52.67,0:09:55.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya berkat bantuanmu, Yang Mulia.
Dialogue: 0,0:09:55.95,0:10:00.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jatuhnya Keluarga Redgrave\Njuga faktor utamanya.
Dialogue: 0,0:10:01.13,0:10:05.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuserahkan koordinasi dengan Kerajaan padamu.\NLakukan dengan baik.
Dialogue: 0,0:10:05.35,0:10:07.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap.
Dialogue: 0,0:10:16.20,0:10:18.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada jalan kembali sekarang.
Dialogue: 0,0:10:19.06,0:10:22.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rauda, salahkan semuanya\Npada kakak perempuan yang bodoh ini.
Dialogue: 0,0:10:31.49,0:10:33.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dari Putri?
Dialogue: 0,0:10:33.93,0:10:37.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Dia berhasil\Nmenjilat Kerajaan Holfort.
Dialogue: 0,0:10:38.65,0:10:42.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Vandel, kau sudah siap melengkapinya?
Dialogue: 0,0:10:42.85,0:10:45.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah mati sebagai kesatria.
Dialogue: 0,0:10:45.46,0:10:48.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisa hidupku untuk sang Putri.
Dialogue: 0,0:10:48.65,0:10:49.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:10:50.19,0:10:53.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya mereka sudah penjarakan\Nkesatria jahat itu
Dialogue: 0,0:10:53.02,0:10:56.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan sita kapal serta baju besinya.
Dialogue: 0,0:10:56.24,0:11:00.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berharap bisa selesaikan\Nurusanku dengan bocah itu di medan perang.
Dialogue: 0,0:11:00.74,0:11:03.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kau singkirkan\Nkesombonganmu sebagai pejuang?!
Dialogue: 0,0:11:04.43,0:11:08.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami... Kerajaan Fanoss\Nharus menang apa pun caranya!
Dialogue: 0,0:11:11.66,0:11:14.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Vandel, siapkan baju besi ajaib.
Dialogue: 0,0:11:14.46,0:11:17.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kupanggil Yang Mulia,
Dialogue: 0,0:11:17.65,0:11:22.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adik perempuan Putri, Putri Hertrauda.
Dialogue: 0,0:11:26.83,0:11:29.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agh...
Dialogue: 0,0:11:29.38,0:11:30.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, ada pengunjung!
Dialogue: 0,0:11:31.23,0:11:32.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengunjung?
Dialogue: 0,0:11:34.56,0:11:35.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergi.
Dialogue: 0,0:11:40.58,0:11:42.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, lihat siapa yang datang!
Dialogue: 0,0:11:42.78,0:11:47.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang bawa putri Kerajaan\Nyang mulia dan perkasa ke sini?
Dialogue: 0,0:11:47.34,0:11:50.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku datang untuk bicara denganmu,\NViscount Bartfort.
Dialogue: 0,0:11:53.71,0:11:58.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti sudah tahu sekarang\Nkita di ambang perang lagi.
Dialogue: 0,0:11:58.67,0:12:01.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Berkat seseorang.
Dialogue: 0,0:12:01.73,0:12:03.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Viscount Bartfort.
Dialogue: 0,0:12:04.83,0:12:08.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berlututlah di hadapanku\Ndan jadi kesatriaku.
Dialogue: 0,0:12:11.99,0:12:14.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan mengabdi ke Kerajaan Fanoss.
Dialogue: 0,0:12:14.23,0:12:16.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau mau, akan kubebaskan kau.
Dialogue: 0,0:12:16.43,0:12:18.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus jadi pendukungmu?
Dialogue: 0,0:12:19.57,0:12:21.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau kehilangan nyawa
Dialogue: 0,0:12:21.63,0:12:23.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}cuma demi rebutan kekuasaan di Kerajaan?
Dialogue: 0,0:12:23.98,0:12:27.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang sebenarnya kau cari\Nadalah kehidupan tenang.
Dialogue: 0,0:12:28.16,0:12:30.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau berpikir begitu?
Dialogue: 0,0:12:30.99,0:12:34.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada saat kau tak membunuh seseorang.
Dialogue: 0,0:12:37.30,0:12:41.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, meski kau punya kekuatan besar\Ndari barang hilang,
Dialogue: 0,0:12:41.12,0:12:43.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau tak pamerkan kekuatan itu,
Dialogue: 0,0:12:43.19,0:12:45.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}juga tak bantu tentara Kerajaan Holfort.
Dialogue: 0,0:12:47.28,0:12:48.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:12:48.53,0:12:53.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kau lebih paham aku\Ndaripada Kerajaan Holfort.
Dialogue: 0,0:12:54.14,0:12:56.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau mengabdi padaku,
Dialogue: 0,0:12:56.09,0:12:59.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kujanjikan kehidupan tenang\Ndan damai suatu hari nanti.
Dialogue: 0,0:12:59.18,0:13:00.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menolak.
Dialogue: 0,0:13:02.40,0:13:04.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau sangat cinta Kerajaan Holfort?
Dialogue: 0,0:13:04.45,0:13:06.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak juga.
Dialogue: 0,0:13:06.55,0:13:07.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:13:07.91,0:13:10.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak merasa punya kewajiban ke Kerajaan.
Dialogue: 0,0:13:10.33,0:13:13.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku, mereka lempar aku ke lubang ini.
Dialogue: 0,0:13:13.79,0:13:15.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan, aku membencinya.
Dialogue: 0,0:13:15.51,0:13:16.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu kenapa menolak?
Dialogue: 0,0:13:17.45,0:13:18.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kau tahu sendiri...
Dialogue: 0,0:13:21.98,0:13:24.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya percuma juga.
Dialogue: 0,0:13:24.79,0:13:27.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan terlambat\Nkalau kau berubah pikiran nanti.
Dialogue: 0,0:13:27.53,0:13:31.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini, akan kami ubah\NKerajaan Holfort jadi genangan darah.
Dialogue: 0,0:13:31.96,0:13:32.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu...
Dialogue: 0,0:13:33.45,0:13:35.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan kami tenggelamkan negeri ini.
Dialogue: 0,0:13:38.24,0:13:40.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba hentikan kami kalau bisa.
Dialogue: 0,0:13:42.51,0:13:44.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dia sangat benci aku.
Dialogue: 0,0:13:45.55,0:13:48.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kelihatan agak ragu-ragu bagiku.
Dialogue: 0,0:13:49.09,0:13:50.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ragu-ragu?
Dialogue: 0,0:13:56.31,0:14:00.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah, tolong! Bebaskan Leon dari penjara!
Dialogue: 0,0:14:01.15,0:14:02.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti bertingkah seperti anak kecil.
Dialogue: 0,0:14:03.43,0:14:06.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau terus begini,\Nperang akan mulai lagi.
Dialogue: 0,0:14:06.86,0:14:08.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa kekuatan Leon...
Dialogue: 0,0:14:08.89,0:14:12.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan kalau aku pakai posisiku\Nuntuk bebaskan dia,
Dialogue: 0,0:14:12.14,0:14:15.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kapal dan baju besi terpentingnya\Ntakkan dikembalikan.
Dialogue: 0,0:14:16.27,0:14:20.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksud Ayah, Leon tak berharga\Ntanpa barang hilangnya?
Dialogue: 0,0:14:22.63,0:14:26.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leon sudah lakukan\Nbanyak hal untukku begitu lama!
Dialogue: 0,0:14:26.53,0:14:28.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu kenapa?
Dialogue: 0,0:14:30.01,0:14:32.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuberi dia balasan yang setimpal.
Dialogue: 0,0:14:33.89,0:14:37.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutmu siapa yang membuat dia\Njadi terkenal?
Dialogue: 0,0:14:37.85,0:14:39.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah...
Dialogue: 0,0:14:39.58,0:14:45.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sedikit berpihak pada Bartfort\Nselama ini karena kekuatannya.
Dialogue: 0,0:14:45.04,0:14:47.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena sekarang dia sudah kehilangan itu,
Dialogue: 0,0:14:47.24,0:14:50.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tak ada yang bisa kita lakukan lagi\Nsebagai Keluarga Redgrave.
Dialogue: 0,0:14:51.87,0:14:54.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau harus selalu ingat ini.
Dialogue: 0,0:14:54.58,0:14:56.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau salah satu langkah saja,
Dialogue: 0,0:14:56.16,0:14:59.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau takkan pernah\Nlewati gerbang kediaman ini lagi.
Dialogue: 0,0:15:09.86,0:15:11.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leon...
Dialogue: 0,0:15:13.81,0:15:14.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ange!
Dialogue: 0,0:15:16.43,0:15:20.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi pada Leon?\NApa mereka lakukan sesuatu?
Dialogue: 0,0:15:20.21,0:15:22.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia masih dipenjara.
Dialogue: 0,0:15:23.35,0:15:26.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Tapi kenapa...
Dialogue: 0,0:15:26.39,0:15:28.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Situasinya lebih buruk\Ndari yang kubayangkan.
Dialogue: 0,0:15:31.19,0:15:35.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada beberapa orang di Istana\Nyang bekerja sama dengan Kerajaan Fanoss.
Dialogue: 0,0:15:35.01,0:15:37.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka lempar Leon ke penjara bawah tanah
Dialogue: 0,0:15:37.72,0:15:39.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan akan mulai perang.
Dialogue: 0,0:15:39.82,0:15:42.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perang? Tapi...
Dialogue: 0,0:15:42.76,0:15:45.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku minta bantuan keluargaku,\Ntapi tak ada hasil.
Dialogue: 0,0:15:45.92,0:15:50.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai aku punya kekuatan lebih,\Naku bisa lindungi Leon.
Dialogue: 0,0:15:50.28,0:15:53.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, apa yang akan terjadi pada Leon?
Dialogue: 0,0:15:55.00,0:15:58.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia tak bisa buktikan\Ndia bukan mata-mata Kerajaan Fanoss,
Dialogue: 0,0:15:58.60,0:16:00.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kemungkinan besar dia akan dieksekusi.
Dialogue: 0,0:16:00.56,0:16:01.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?!
Dialogue: 0,0:16:01.83,0:16:05.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leon sudah selamatkan kita berkali-kali.
Dialogue: 0,0:16:06.53,0:16:09.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam duel melawan Pangeran Julius...
Dialogue: 0,0:16:10.37,0:16:12.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan waktu aku disandera\Noleh Kerajaan Fanoss...
Dialogue: 0,0:16:14.72,0:16:17.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku tak bisa lakukan apa pun untuknya.
Dialogue: 0,0:16:18.79,0:16:19.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali tidak.
Dialogue: 0,0:16:20.77,0:16:22.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ange...
Dialogue: 0,0:16:25.40,0:16:26.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Livia...
Dialogue: 0,0:16:27.92,0:16:29.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tunggu!
Dialogue: 0,0:16:29.95,0:16:34.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih ada satu kelompok\Nyang mungkin bisa membantu.
Dialogue: 0,0:16:34.93,0:16:36.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu...
Dialogue: 0,0:16:42.21,0:16:43.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:16:43.62,0:16:46.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kau datang minta bantuanku?
Dialogue: 0,0:16:46.43,0:16:49.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku, Saint?
Dialogue: 0,0:16:49.67,0:16:52.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong, selamatkan Leon.
Dialogue: 0,0:16:52.37,0:16:53.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami mohon.
Dialogue: 0,0:16:56.04,0:17:00.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang sekali\Nwaktu dengar si mob bodoh itu ditangkap,
Dialogue: 0,0:17:00.73,0:17:04.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi tak kusangka\Nkalian berdua bakal minta bantuanku!
Dialogue: 0,0:17:04.79,0:17:09.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minta bantuanku sekarang itu\Nsangat tidak peka.
Dialogue: 0,0:17:09.16,0:17:11.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau lupa apa yang kau lakukan pada Julius?
Dialogue: 0,0:17:15.01,0:17:19.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ngomong macam-macam soal aku waktu itu.
Dialogue: 0,0:17:20.15,0:17:23.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak berpikir panjang.\NTolong maafkan aku.
Dialogue: 0,0:17:23.78,0:17:25.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, itu betul!
Dialogue: 0,0:17:25.35,0:17:27.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, kau, bunga daripada otak.
Dialogue: 0,0:17:27.94,0:17:29.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya?
Dialogue: 0,0:17:30.11,0:17:33.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutmu tidak ada\Ncara yang benar untuk minta bantuan?
Dialogue: 0,0:17:33.32,0:17:35.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara yang benar?
Dialogue: 0,0:17:36.81,0:17:39.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua, sujud di hadapanku,\Nkepala menyentuh tanah!
Dialogue: 0,0:17:40.49,0:17:42.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau salah satu langkah saja,
Dialogue: 0,0:17:42.35,0:17:45.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau takkan pernah\Nlewati gerbang kediaman ini lagi.
Dialogue: 0,0:17:48.80,0:17:50.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku yang sujud mewakili kami...
Dialogue: 0,0:17:50.18,0:17:53.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak. Harus kalian berdua.\NTidak ada alasan.
Dialogue: 0,0:17:54.30,0:17:55.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:17:58.07,0:18:00.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Angelica takkan pernah mau begitu.
Dialogue: 0,0:18:00.85,0:18:03.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri seorang duke,\Nmenunduk sampai kepala ke tanah?
Dialogue: 0,0:18:03.38,0:18:05.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pencabutan hak waris\Nitu konsekuensi paling ringan.
Dialogue: 0,0:18:06.98,0:18:10.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian aku tak tahu\Ncara selamatkan si mob sialan itu.
Dialogue: 0,0:18:10.67,0:18:13.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kutolak mereka dengan lembut dan...
Dialogue: 0,0:18:16.18,0:18:17.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?!
Dialogue: 0,0:18:20.59,0:18:23.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?!
Dialogue: 0,0:18:24.27,0:18:25.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:18:25.46,0:18:26.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sujud ke tanah?
Dialogue: 0,0:18:26.84,0:18:28.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri Duke?
Dialogue: 0,0:18:29.27,0:18:32.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, sampai separah itu\Nkejatuhan Keluarga Redgrave.
Dialogue: 0,0:18:33.71,0:18:37.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat itu, Saint Marie!\NBenar-benar tak sedap dipandang!
Dialogue: 0,0:18:37.76,0:18:41.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri duke bersujud bersama rakyat jelata!
Dialogue: 0,0:18:41.58,0:18:43.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memalukan!
Dialogue: 0,0:18:45.62,0:18:50.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bikin mereka sampai begini?\NSejujurnya, aku sendiri jadi muak.
Dialogue: 0,0:18:51.23,0:18:56.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, tunggu, tunggu! Tak kusangka\Nmereka benar-benar melakukannya!
Dialogue: 0,0:18:56.22,0:18:59.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau kau selamatkan nyawa Leon.
Dialogue: 0,0:18:59.72,0:19:01.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Itu...
Dialogue: 0,0:19:01.30,0:19:02.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan sikap begitu?
Dialogue: 0,0:19:02.68,0:19:06.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti katanya,\Nada cara yang benar untuk minta bantuan.
Dialogue: 0,0:19:06.46,0:19:10.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau mungkin putri duke\Ntak tahu cara bicara yang benar?
Dialogue: 0,0:19:13.75,0:19:16.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong selamatkan nyawa Leon,
Dialogue: 0,0:19:16.48,0:19:18.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saint Marie.
Dialogue: 0,0:19:19.03,0:19:20.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah itu menyedihkan?
Dialogue: 0,0:19:21.61,0:19:23.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga, Rakyat Jelata!
Dialogue: 0,0:19:23.87,0:19:25.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:19:25.12,0:19:29.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sombong\Ncuma karena punya kekuatan misterius!
Dialogue: 0,0:19:29.37,0:19:31.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:19:32.85,0:19:36.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong selamatkan Leon, Saint Marie.
Dialogue: 0,0:19:38.53,0:19:42.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saint Marie, kutemukan pijakan kaki\Nyang nyaman untukmu.
Dialogue: 0,0:19:42.29,0:19:44.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau pakai putri duke\Nsebagai kursi
Dialogue: 0,0:19:44.13,0:19:47.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan rakyat jelata sebagai pijakan kaki?
Dialogue: 0,0:19:47.76,0:19:50.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Ada apa dengan mereka berdua?
Dialogue: 0,0:19:50.48,0:19:53.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka pakai namaku\Nuntuk lampiaskan dendam mereka!
Dialogue: 0,0:19:54.17,0:19:57.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau senang jadi kursi Saint?
Dialogue: 0,0:19:57.02,0:19:59.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat jawab dia!
Dialogue: 0,0:19:59.73,0:20:00.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!
Dialogue: 0,0:20:07.21,0:20:08.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Julius...
Dialogue: 0,0:20:09.11,0:20:12.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sudah tunjukkan tekadnya.
Dialogue: 0,0:20:12.10,0:20:14.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Marie, mereka tak perlu tunjukkan lagi.
Dialogue: 0,0:20:14.96,0:20:18.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan tekad sebesar ini,\Nkita harus tanggapi dengan cara yang sama.
Dialogue: 0,0:20:19.21,0:20:22.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita lupakan masalah masa lalu kita.
Dialogue: 0,0:20:22.98,0:20:26.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih jauh dari ini\Nbakal lukai kehormatanmu, Marie.
Dialogue: 0,0:20:26.90,0:20:30.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo selamatkan Bartfort itu!
Dialogue: 0,0:20:30.38,0:20:36.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamatkan dia?! Apa-apaan?!\NAku tak tahu caranya!
Dialogue: 0,0:20:36.38,0:20:39.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Nboleh kuminta kalian yang lakukan?
Dialogue: 0,0:20:40.47,0:20:41.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:20:41.80,0:20:43.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan saja pada kami!
Dialogue: 0,0:20:43.99,0:20:44.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ange...
Dialogue: 0,0:20:46.98,0:20:50.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup aku saja yang sujud. Kenapa?
Dialogue: 0,0:20:50.38,0:20:53.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kurasa ini yang terbaik.
Dialogue: 0,0:20:53.15,0:20:55.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski itu berarti mencoreng nama keluargaku
Dialogue: 0,0:20:55.46,0:20:58.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan bersujud di hadapan wanita\Nyang rebut tunanganku...
Dialogue: 0,0:20:59.24,0:21:03.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebesar itulah keinginanku\Nuntuk selamatkan Leon.
Dialogue: 0,0:21:03.80,0:21:04.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ange...
Dialogue: 0,0:21:05.56,0:21:08.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau terlalu pikirkan Leon...
Dialogue: 0,0:21:22.65,0:21:25.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesatria jahat itu belum bergerak.
Dialogue: 0,0:21:25.35,0:21:30.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barang hilang, kapal, dan baju besinya\Nmasih disita Marquess Frampton.
Dialogue: 0,0:21:31.08,0:21:32.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat bagus.
Dialogue: 0,0:21:33.82,0:21:37.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri, semua persiapan sudah selesai.
Dialogue: 0,0:21:42.27,0:21:44.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teman-teman, bangun!
Dialogue: 0,0:21:45.10,0:21:47.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang kita bergerak maju\Nke Kerajaan Holfort!
Dialogue: 0,0:21:48.94,0:21:50.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maju!
Dialogue: 0,0:23:25.57,0:23:27.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersujud ke tanah, lalu lima antek datang?
Dialogue: 0,0:23:27.76,0:23:30.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ah!\N- Leon masih tenang di bawah tanah.
Dialogue: 0,0:23:30.07,0:23:31.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saint jatuh! Kerajaan dalam bahaya!
Dialogue: 0,0:23:31.58,0:23:32.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:23:32.76,0:23:34.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, "Aku Suka Pencitraan".
Dialogue: 0,0:23:34.87,0:23:37.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi orang-orang ini\Nmau selamatkan aku? Seram amat!
Dialogue: 0,0:23:37.24,0:23:39.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
