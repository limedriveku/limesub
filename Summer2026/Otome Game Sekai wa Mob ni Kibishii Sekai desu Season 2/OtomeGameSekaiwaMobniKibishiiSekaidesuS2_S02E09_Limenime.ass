Dialogue: 0,0:01:55.91,0:01:58.03,sign,,0000,0000,0000,,LIVIA...
Dialogue: 0,0:00:03.46,0:00:05.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan awal Kerajaan Fanoss?
Dialogue: 0,0:00:05.42,0:00:07.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Viscount Bartfort memerintahkan
Dialogue: 0,0:00:07.48,0:00:10.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}satu detasemen pasukan utama melawan mereka.
Dialogue: 0,0:00:10.68,0:00:11.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:00:13.15,0:00:14.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leon...
Dialogue: 0,0:00:30.63,0:00:31.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Trapped in a Dating Sim
Dialogue: 0,0:00:34.34,0:00:35.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}The World of Otome Games is Tough for Mobs
Dialogue: 0,0:00:44.27,0:00:52.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Trapped in a Dating Sim 2: The World\Nof Otome Games is Tough for Mobs
Dialogue: 0,0:01:58.07,0:01:59.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembalilah ke tempat asalmu!
Dialogue: 0,0:02:03.25,0:02:05.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lemah!
Dialogue: 0,0:02:07.46,0:02:10.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?!\NTadi kau sangat bersemangat!
Dialogue: 0,0:02:10.63,0:02:12.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benci Kerajaan Holfort, 'kan?
Dialogue: 0,0:02:12.92,0:02:15.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa bertarung lebih keras?
Dialogue: 0,0:02:19.93,0:02:21.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Transportasi berkecepatan tinggi?
Dialogue: 0,0:02:21.43,0:02:22.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, kau cepat!
Dialogue: 0,0:02:22.93,0:02:24.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan ini!
Dialogue: 0,0:02:25.81,0:02:27.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini! Di sini!
Dialogue: 0,0:02:27.45,0:02:29.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke mana kau lihat?!
Dialogue: 0,0:02:29.81,0:02:31.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mundur!
Dialogue: 0,0:02:35.10,0:02:37.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tidak akan lolos, dasar bodoh!
Dialogue: 0,0:02:37.30,0:02:39.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya, sepertinya sudah waktunya.
Dialogue: 0,0:02:40.67,0:02:44.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster raksasa yang kau sebut\Nbos akhir itu mendekat.
Dialogue: 0,0:02:52.58,0:02:54.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang...
Dialogue: 0,0:02:55.58,0:02:59.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjaga di Istana sama sekali tidak berguna.
Dialogue: 0,0:03:00.33,0:03:02.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kau sependapat denganku,
Dialogue: 0,0:03:02.84,0:03:05.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri Hertrude?
Dialogue: 0,0:03:05.18,0:03:07.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Marquess Frampton.
Dialogue: 0,0:03:07.50,0:03:09.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis bodoh.
Dialogue: 0,0:03:10.05,0:03:13.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah membuatku kehilangan segalanya!
Dialogue: 0,0:03:13.86,0:03:18.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seandainya kau tutup mulut,\Nsemuanya akan berakhir dengan sempurna!
Dialogue: 0,0:03:19.35,0:03:22.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terkejut kau punya nyali\Nuntuk balas dendam.
Dialogue: 0,0:03:23.05,0:03:25.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir kau akan mati\Ndengan tenang di penjara.
Dialogue: 0,0:03:25.98,0:03:28.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takkan mati!
Dialogue: 0,0:03:28.11,0:03:30.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak sampai aku bunuh kau!
Dialogue: 0,0:03:31.09,0:03:33.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku, Rauda.
Dialogue: 0,0:03:43.32,0:03:46.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf atas keterlambatanku, Yang Mulia.
Dialogue: 0,0:03:46.40,0:03:47.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vandel?!
Dialogue: 0,0:03:47.63,0:03:50.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kesatria Hitam Kerajaan Fanoss!
Dialogue: 0,0:04:09.83,0:04:11.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:04:11.38,0:04:14.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau pakai itu, Vandel?
Dialogue: 0,0:04:14.76,0:04:16.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi itu...
Dialogue: 0,0:04:16.91,0:04:22.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong biarkan saja.\NIni pengabdian terakhir orang tua bodoh ini.
Dialogue: 0,0:04:22.93,0:04:24.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku minta maaf.
Dialogue: 0,0:04:25.03,0:04:31.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berdasarkan informasimu, seruling sihir\Ndan pedangku yang dicuri sudah ditemukan.
Dialogue: 0,0:04:31.94,0:04:34.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Adikmu menunggumu.
Dialogue: 0,0:04:34.67,0:04:35.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini!
Dialogue: 0,0:04:35.71,0:04:36.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami temukan mereka!
Dialogue: 0,0:04:36.67,0:04:37.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam di tempat!
Dialogue: 0,0:04:37.59,0:04:38.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menolak!
Dialogue: 0,0:04:41.05,0:04:43.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anjing Kerajaan Holfort!
Dialogue: 0,0:04:43.49,0:04:45.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia, harap cepat.
Dialogue: 0,0:04:56.31,0:04:59.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih. Apa boleh buat. Lakukanlah.
Dialogue: 0,0:04:59.31,0:05:03.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini keputusan yang rasional, tapi kau yakin?
Dialogue: 0,0:05:03.52,0:05:07.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Komunikasi terganggu\Ndi dekat monster raksasa.
Dialogue: 0,0:05:07.19,0:05:12.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kutinggalkan Partner untukmu,\Ntapi aku takkan bisa berikan dukungan.
Dialogue: 0,0:05:12.94,0:05:14.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa. Pergi saja.
Dialogue: 0,0:05:15.51,0:05:16.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:05:17.74,0:05:21.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapal kerajaan siap diluncurkan.
Dialogue: 0,0:05:21.51,0:05:25.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tugaskan AI lain\Nuntuk berikan dukungan.
Dialogue: 0,0:05:25.18,0:05:27.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanyakan saja kalau kau perlu sesuatu.
Dialogue: 0,0:05:27.78,0:05:29.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}AI lain?
Dialogue: 0,0:05:29.30,0:05:31.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, permisi.
Dialogue: 0,0:05:31.41,0:05:35.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan, tolong jangan lakukan apa pun...\Nyang gegabah.
Dialogue: 0,0:05:36.35,0:05:38.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau... masalah, lari...
Dialogue: 0,0:05:40.80,0:05:43.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuserahkan padaku, Rekan.
Dialogue: 0,0:05:44.58,0:05:46.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}AI Vice.
Dialogue: 0,0:05:46.08,0:05:47.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya?
Dialogue: 0,0:05:57.10,0:05:58.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buka gerbangnya!
Dialogue: 0,0:06:00.74,0:06:02.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mesin beroperasi normal.
Dialogue: 0,0:06:02.79,0:06:05.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peluncuran kapal kerajaan, Vice!
Dialogue: 0,0:06:05.84,0:06:08.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada uji coba. Semoga beruntung.
Dialogue: 0,0:06:09.34,0:06:10.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai naik!
Dialogue: 0,0:06:13.77,0:06:15.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapal stabil.
Dialogue: 0,0:06:15.50,0:06:17.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua sistem aman.
Dialogue: 0,0:06:19.06,0:06:21.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua pasukan, maju!
Dialogue: 0,0:06:26.84,0:06:28.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah...
Dialogue: 0,0:06:28.55,0:06:29.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo.
Dialogue: 0,0:06:31.41,0:06:35.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita adakan kontak\Ndi Danau Eldral pada siang hari.
Dialogue: 0,0:06:35.81,0:06:41.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit dipercaya.\NLeon memimpin armada raksasa itu.
Dialogue: 0,0:06:44.15,0:06:48.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bisakah dia benar-benar kalahkan\Nmonster raksasa yang menakutkan itu?
Dialogue: 0,0:06:54.07,0:06:55.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membuka selubung.
Dialogue: 0,0:06:56.82,0:07:00.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koordinat monster raksasa terkonfirmasi,\Npada baringan 25.
Dialogue: 0,0:07:01.58,0:07:03.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?!
Dialogue: 0,0:07:03.11,0:07:05.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku harus ada di medan perang?!
Dialogue: 0,0:07:05.08,0:07:07.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan mendukung Vice.
Dialogue: 0,0:07:07.50,0:07:11.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau jadi tameng hidup Livia sampai kapal\Nbisa tembus penghalang monster itu.
Dialogue: 0,0:07:11.50,0:07:14.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kenapa harus aku?!
Dialogue: 0,0:07:14.09,0:07:17.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Secara teknis kau bisa pakai kekuatan Saint.
Dialogue: 0,0:07:17.36,0:07:22.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya kami mencu... Kuil menitipkan\Nperalatan Saint untuk kami urus.
Dialogue: 0,0:07:22.22,0:07:25.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar kalian berikan itu ke yang palsu!
Dialogue: 0,0:07:26.71,0:07:28.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vice menargetkan monster raksasa itu.
Dialogue: 0,0:07:28.85,0:07:30.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau hadapi yang kecil-kecil.
Dialogue: 0,0:07:30.61,0:07:34.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya kami mencu...\Nmeminjam armada Kuil.
Dialogue: 0,0:07:34.02,0:07:36.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau bertarung!\NAku tidak mau mati!
Dialogue: 0,0:07:36.73,0:07:37.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam!
Dialogue: 0,0:07:37.99,0:07:41.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau lakukan pekerjaanmu,\Nada peluang kau akan selamat!
Dialogue: 0,0:07:42.31,0:07:44.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan khawatir, Marie!
Dialogue: 0,0:07:45.90,0:07:48.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya akan baik-baik saja\Ndengan kami di sini!
Dialogue: 0,0:07:48.10,0:07:50.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kulindungi kau!
Dialogue: 0,0:07:50.31,0:07:52.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti akan melayanimu!
Dialogue: 0,0:07:52.61,0:07:55.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Marie, kau tidak sendirian lagi!
Dialogue: 0,0:07:55.13,0:07:57.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kalian...
Dialogue: 0,0:07:58.13,0:08:01.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, kau punya pengawal yang baik.
Dialogue: 0,0:08:01.65,0:08:03.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lakukan saja.
Dialogue: 0,0:08:03.79,0:08:06.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan bergabung juga!
Dialogue: 0,0:08:07.47,0:08:08.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zirah putih?
Dialogue: 0,0:08:09.03,0:08:09.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kau?!
Dialogue: 0,0:08:09.80,0:08:10.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuh?!
Dialogue: 0,0:08:11.14,0:08:12.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenanglah.
Dialogue: 0,0:08:12.62,0:08:15.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa beri tahu namaku,
Dialogue: 0,0:08:15.14,0:08:17.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi mungkin kalian bisa panggil aku...
Dialogue: 0,0:08:19.91,0:08:22.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesatria Bertopeng!
Dialogue: 0,0:08:25.18,0:08:26.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enyah.
Dialogue: 0,0:08:26.65,0:08:28.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kau?!
Dialogue: 0,0:08:28.47,0:08:31.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bajingan bertopeng!\NNgapain kau di sini?!
Dialogue: 0,0:08:31.07,0:08:33.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waspada! Dia pasti musuh!
Dialogue: 0,0:08:33.29,0:08:35.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Marie, mundur!
Dialogue: 0,0:08:35.03,0:08:36.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya...
Dialogue: 0,0:08:36.86,0:08:39.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, itu jelas sekali...
Dialogue: 0,0:08:39.40,0:08:42.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tergerak oleh tekad kalian.
Dialogue: 0,0:08:42.61,0:08:44.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kulakukan\Nsedikit hal berguna yang aku bisa...
Dialogue: 0,0:08:44.92,0:08:46.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh! Aduh! Aduh!
Dialogue: 0,0:08:46.54,0:08:48.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau apa?!
Dialogue: 0,0:08:48.33,0:08:50.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terserahlah, ikut aku, dasar bodoh!
Dialogue: 0,0:08:52.26,0:08:54.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ngapain kau di sini, Yang Mulia?
Dialogue: 0,0:08:54.20,0:08:56.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hmph. Apa katamu?
Dialogue: 0,0:08:56.34,0:08:59.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan pria bangsawan\Nseperti Pangeran Julius...
Dialogue: 0,0:09:03.99,0:09:06.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, ini aku, Julius.
Dialogue: 0,0:09:06.10,0:09:07.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga!
Dialogue: 0,0:09:07.98,0:09:11.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bartfort, aku akan bergabung\Ndalam pertarungan ini.
Dialogue: 0,0:09:11.59,0:09:13.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan pergi. Jalan keluarnya ke sana.
Dialogue: 0,0:09:13.86,0:09:16.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku akan bertarung bersama kalian semua.
Dialogue: 0,0:09:16.36,0:09:20.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak! Kalau kau mati,\Nitu akan jadi tanggung jawabku!
Dialogue: 0,0:09:20.00,0:09:22.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hmph! Makanya aku pakai topeng ini!
Dialogue: 0,0:09:22.46,0:09:22.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enyah!
Dialogue: 0,0:09:22.98,0:09:23.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan pernah!
Dialogue: 0,0:09:23.49,0:09:24.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enyah! Enyah! Enyah!
Dialogue: 0,0:09:24.87,0:09:26.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak mau! Tak mau! Tak mau!
Dialogue: 0,0:09:30.83,0:09:31.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar...
Dialogue: 0,0:09:34.26,0:09:35.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau siap lakukan ini?
Dialogue: 0,0:09:35.67,0:09:39.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Aku akan berjuang\Nuntuk melindungi Marie.
Dialogue: 0,0:09:39.93,0:09:41.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lakukan apa yang kau mau.
Dialogue: 0,0:09:41.77,0:09:45.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia akan menjaga kapal kerajaan.\NLindungi dia dengan baik.
Dialogue: 0,0:09:47.47,0:09:50.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menerima misi ini, Panglima Tertinggi.
Dialogue: 0,0:09:51.35,0:09:56.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, karakter bertopeng\Nmuncul di gim otome.
Dialogue: 0,0:09:57.29,0:09:59.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dalam gim, itu bukan Julius.
Dialogue: 0,0:09:59.12,0:10:01.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kami tak pernah tahu siapa orang itu.\N- Pria bernama kesatria!
Dialogue: 0,0:10:02.29,0:10:04.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa itu?
Dialogue: 0,0:10:05.48,0:10:06.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada?
Dialogue: 0,0:10:06.36,0:10:07.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada?!
Dialogue: 0,0:10:07.24,0:10:08.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada!
Dialogue: 0,0:10:08.86,0:10:11.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyamaranku tidak ada!
Dialogue: 0,0:10:11.37,0:10:14.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kunci untuk aktifkan zirah putih\Njuga tidak ada!
Dialogue: 0,0:10:15.47,0:10:19.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial! Pasti ulah Mylene! Wanita tua itu!
Dialogue: 0,0:10:19.72,0:10:21.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau bilang sesuatu?
Dialogue: 0,0:10:21.50,0:10:24.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Apa kau bilang sesuatu?"\NDasar wanita sialan...
Dialogue: 0,0:10:24.37,0:10:25.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:10:25.75,0:10:27.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Bagaimana kau bisa tahu soal ruangan ini?!
Dialogue: 0,0:10:27.89,0:10:28.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?!
Dialogue: 0,0:10:28.33,0:10:30.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang tahu soal ruangan ini.
Dialogue: 0,0:10:30.39,0:10:33.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang lebih penting, apa kau lihat Julius?
Dialogue: 0,0:10:33.51,0:10:35.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak ada di mana-mana.
Dialogue: 0,0:10:36.42,0:10:40.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di-Dia tidak mungkin ambil penyamaranku!
Dialogue: 0,0:10:40.18,0:10:43.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keinginan rahasia Raja!
Dialogue: 0,0:10:43.40,0:10:46.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak punya nama\Nuntuk kuberi tahu padamu!
Dialogue: 0,0:10:59.20,0:11:01.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Em... Lux?
Dialogue: 0,0:11:01.41,0:11:03.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, maaf, bukan.
Dialogue: 0,0:11:03.99,0:11:07.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku adalah yang biasa kalian sebut familiar.
Dialogue: 0,0:11:07.18,0:11:10.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luxion perintahkan aku\Nuntuk kendalikan kapal ini.
Dialogue: 0,0:11:10.30,0:11:12.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berutang budi padanya.
Dialogue: 0,0:11:15.53,0:11:19.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, serahkan kemudi kapal padaku.
Dialogue: 0,0:11:19.18,0:11:21.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan tidak perlu dipikirkan.
Dialogue: 0,0:11:22.26,0:11:24.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami harus panggil kau apa?
Dialogue: 0,0:11:24.11,0:11:28.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, nomor seriku akan terasa hambar.
Dialogue: 0,0:11:29.05,0:11:31.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian bisa panggil aku Creare.
Dialogue: 0,0:11:46.91,0:11:48.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak!
Dialogue: 0,0:11:49.18,0:11:50.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rauda!
Dialogue: 0,0:11:51.66,0:11:52.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sungguh minta maaf.
Dialogue: 0,0:11:53.64,0:11:56.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paksa kau ambil peran yang menyakitkan.
Dialogue: 0,0:11:58.15,0:12:03.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, ini peran yang salah satu dari kita\Nakan ambil pada akhirnya.
Dialogue: 0,0:12:06.01,0:12:07.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rauda...
Dialogue: 0,0:12:08.39,0:12:14.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau ingat, menjelajahi langit\Nseperti ini bersama Ibu dan Ayah?
Dialogue: 0,0:12:14.63,0:12:19.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Semuanya sangat menyenangkan dulu.
Dialogue: 0,0:12:23.03,0:12:24.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rauda, tunggu aku!
Dialogue: 0,0:12:28.96,0:12:32.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Angin di pipi kita,\Nsinar matahari di kulit kita...
Dialogue: 0,0:12:33.26,0:12:35.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat suka semua itu.
Dialogue: 0,0:12:39.91,0:12:44.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai aku tahu Ibu dan Ayah jatuh\Nke tangan Kerajaan Holfort.
Dialogue: 0,0:12:55.79,0:13:00.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada hari itu,\Nkita putuskan akan memikul segalanya.
Dialogue: 0,0:13:02.07,0:13:04.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan Dewa Penjaga Langit dan Laut,
Dialogue: 0,0:13:05.24,0:13:07.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}keinginan terdalam Kerajaan Fanoss\Nbisa terwujud.
Dialogue: 0,0:13:08.20,0:13:11.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak, begitu ini selesai,\Nsegalanya terserah padamu.
Dialogue: 0,0:13:15.98,0:13:20.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri Hertrauda! Armada Kerajaan mendekat!
Dialogue: 0,0:13:21.63,0:13:23.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan segera pergi.
Dialogue: 0,0:13:26.60,0:13:27.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rauda...
Dialogue: 0,0:13:29.93,0:13:36.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak, kalau aku jatuh,\Ntolong ambil alih untukku.
Dialogue: 0,0:13:37.49,0:13:38.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rauda...
Dialogue: 0,0:13:46.08,0:13:47.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Impuls normal.
Dialogue: 0,0:13:47.91,0:13:50.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua pendorong beroperasi.
Dialogue: 0,0:13:50.63,0:13:54.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengoreksi geografi dan momen konveksi.
Dialogue: 0,0:13:54.14,0:13:55.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manuver normal.
Dialogue: 0,0:13:56.26,0:13:58.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita adakan kontak di Danau.
Dialogue: 0,0:13:58.59,0:13:59.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua kapal, formasi tempur.
Dialogue: 0,0:13:59.87,0:14:01.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersiaplah bertempur!
Dialogue: 0,0:14:03.51,0:14:05.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai di bawah danau.
Dialogue: 0,0:14:07.52,0:14:08.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serang!
Dialogue: 0,0:14:12.11,0:14:14.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami di atas danau!
Dialogue: 0,0:14:14.05,0:14:15.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan masuk jarak tembak sebentar lagi!
Dialogue: 0,0:14:30.79,0:14:32.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tembakan musuh!
Dialogue: 0,0:14:32.45,0:14:33.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Balas tembakan!
Dialogue: 0,0:14:41.67,0:14:46.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik. Seperti kata Tuan, kau beregenerasi\Ndi bagian mana pun yang hancur.
Dialogue: 0,0:14:49.99,0:14:52.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku akan terus hancurkan kau.
Dialogue: 0,0:14:52.14,0:14:54.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takkan izinkan kau maju selangkah pun.
Dialogue: 0,0:15:01.69,0:15:02.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak akan lewat.
Dialogue: 0,0:15:09.47,0:15:11.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku bisa hentikan itu.
Dialogue: 0,0:15:11.72,0:15:12.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:15:13.37,0:15:17.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Schwert, lahir kembali demi Tuan.
Dialogue: 0,0:15:21.16,0:15:22.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Livia.
Dialogue: 0,0:15:22.23,0:15:23.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:15:23.71,0:15:25.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapal kerajaan, Vice...
Dialogue: 0,0:15:25.71,0:15:27.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong pinjamkan kami kekuatanmu!
Dialogue: 0,0:15:38.85,0:15:40.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan langsung dikonfirmasi!
Dialogue: 0,0:15:40.36,0:15:41.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita berhasil!
Dialogue: 0,0:15:45.35,0:15:46.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?!
Dialogue: 0,0:15:46.49,0:15:48.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu meregenerasi bagian-bagiannya.
Dialogue: 0,0:15:48.45,0:15:50.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Tapi...
Dialogue: 0,0:15:50.53,0:15:52.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak berhasil, ya?
Dialogue: 0,0:15:52.42,0:15:54.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ange, Livia, satu tembakan lagi!
Dialogue: 0,0:16:02.49,0:16:03.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka di sini!
Dialogue: 0,0:16:03.53,0:16:05.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Marie, mulai melindungi!
Dialogue: 0,0:16:05.71,0:16:06.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Tapi...
Dialogue: 0,0:16:07.33,0:16:10.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunjukkan ke mereka kekuatan Saint palsu!
Dialogue: 0,0:16:10.16,0:16:12.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kau bilang hal baik sekali saja?!
Dialogue: 0,0:16:12.25,0:16:13.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurang ajar!
Dialogue: 0,0:16:17.64,0:16:20.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlalu banyak!
Dialogue: 0,0:16:20.25,0:16:21.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Marie!
Dialogue: 0,0:16:24.94,0:16:26.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Julius...
Dialogue: 0,0:16:29.01,0:16:31.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Marie, aku...
Dialogue: 0,0:16:34.34,0:16:35.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Kesatria Bertopeng!
Dialogue: 0,0:16:35.50,0:16:37.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang peduli soal itu sekarang?!
Dialogue: 0,0:16:39.02,0:16:41.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak boleh ada di depan!
Dialogue: 0,0:16:41.02,0:16:43.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan lindungi Marie!
Dialogue: 0,0:16:43.02,0:16:44.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kini saatnya kami...
Dialogue: 0,0:16:44.40,0:16:46.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunjukkan cinta kami padanya!
Dialogue: 0,0:16:46.35,0:16:48.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, mereka akan baik-baik saja.
Dialogue: 0,0:16:49.14,0:16:50.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya...
Dialogue: 0,0:16:57.54,0:17:00.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah! Saatnya fase kedua!
Dialogue: 0,0:17:00.04,0:17:03.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita serbu ke penghalang monster raksasa!
Dialogue: 0,0:17:04.06,0:17:04.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Livia!
Dialogue: 0,0:17:04.70,0:17:05.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:17:14.43,0:17:16.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei! Mundur!
Dialogue: 0,0:17:16.78,0:17:17.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Partner!
Dialogue: 0,0:17:25.09,0:17:26.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penghalang rusak!
Dialogue: 0,0:17:26.81,0:17:32.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! Penghalang Dewa Penjaga\Nyang batalkan segalanya!
Dialogue: 0,0:17:33.40,0:17:36.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cinta runtuhkan semua penghalang!
Dialogue: 0,0:17:36.32,0:17:38.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lovely Beam!
Dialogue: 0,0:17:40.62,0:17:43.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus. Sekarang yang tersisa cuma...
Dialogue: 0,0:17:43.57,0:17:48.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum! Meski tanpa penghalang,\NDewa Penjaga tidak bisa dikalahkan!
Dialogue: 0,0:17:48.08,0:17:49.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan ini!
Dialogue: 0,0:17:58.34,0:18:00.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tembak jatuh mereka!
Dialogue: 0,0:18:10.97,0:18:11.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!
Dialogue: 0,0:18:11.90,0:18:12.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mati aku!
Dialogue: 0,0:18:13.36,0:18:14.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Livia...
Dialogue: 0,0:18:17.97,0:18:19.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Livia?
Dialogue: 0,0:18:22.85,0:18:26.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kenapa semua orang harus bertarung?
Dialogue: 0,0:18:27.05,0:18:28.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal itu sangat sakit...
Dialogue: 0,0:18:30.27,0:18:32.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kenapa mereka lakukan itu?
Dialogue: 0,0:18:34.99,0:18:36.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan airbike, bergerak!
Dialogue: 0,0:18:38.82,0:18:39.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!
Dialogue: 0,0:18:40.75,0:18:45.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak peduli apa tujuan besarnya,\Nmenumpahkan darah itu menyakitkan.
Dialogue: 0,0:18:45.75,0:18:46.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rudal musuh mendekat!
Dialogue: 0,0:18:46.82,0:18:48.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke kiri! Naik!
Dialogue: 0,0:18:50.75,0:18:54.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau...\Nmenyakiti siapa pun sama sekali.
Dialogue: 0,0:18:54.80,0:18:56.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahan! Tunggu sebentar!
Dialogue: 0,0:18:56.80,0:18:58.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku juga.
Dialogue: 0,0:18:58.43,0:19:00.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, maju!
Dialogue: 0,0:19:02.19,0:19:03.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga!
Dialogue: 0,0:19:07.94,0:19:09.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takkan kubiarkan kau!
Dialogue: 0,0:19:10.94,0:19:12.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih belum!
Dialogue: 0,0:19:15.37,0:19:17.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin semua orang\Nmerasakan hal yang sama.
Dialogue: 0,0:19:21.59,0:19:23.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sentuh aku.
Dialogue: 0,0:19:31.64,0:19:33.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang mau disakiti.
Dialogue: 0,0:19:34.17,0:19:37.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi setiap orang\Npunya sesuatu untuk dilindungi.
Dialogue: 0,0:19:37.34,0:19:38.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamatkan aku!
Dialogue: 0,0:19:38.43,0:19:40.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku tidak mau mati!\N- Melindungi?
Dialogue: 0,0:19:42.03,0:19:44.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa ini?
Dialogue: 0,0:19:44.26,0:19:46.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara orang sekarat?
Dialogue: 0,0:19:46.34,0:19:48.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kau bisa sebut itu resonansi?
Dialogue: 0,0:19:48.90,0:19:52.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya Olivia bereaksi pada situasi\Nyang terjadi di sekelilingnya.
Dialogue: 0,0:19:55.85,0:19:59.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau merasakannya selama ini?
Dialogue: 0,0:20:01.21,0:20:05.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ingin kulindungi adalah...
Dialogue: 0,0:20:07.86,0:20:08.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Livia!
Dialogue: 0,0:20:16.99,0:20:18.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?!
Dialogue: 0,0:20:19.17,0:20:20.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaan marahku...
Dialogue: 0,0:20:22.14,0:20:23.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menghilang?
Dialogue: 0,0:20:25.47,0:20:27.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keinginanku untuk bertarung...
Dialogue: 0,0:20:28.63,0:20:30.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mencair.
Dialogue: 0,0:20:46.87,0:20:49.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan!
Dialogue: 0,0:20:55.34,0:20:56.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak...
Dialogue: 0,0:20:59.09,0:21:00.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan!
Dialogue: 0,0:21:01.83,0:21:06.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau minta kami\Nmelupakan kebencian kami dengan ini?
Dialogue: 0,0:21:08.23,0:21:12.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita hentikan ini.\NBerhentilah bertarung sekarang juga.
Dialogue: 0,0:21:12.66,0:21:14.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takkan pernah.
Dialogue: 0,0:21:14.14,0:21:16.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang? Omong kosong bodoh...
Dialogue: 0,0:21:16.82,0:21:21.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara Livia bergema di hati orang-orang.
Dialogue: 0,0:21:21.49,0:21:24.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang ingin melindungi\Napa yang mereka cintai.
Dialogue: 0,0:21:24.56,0:21:27.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu betul betapa sakitnya itu.
Dialogue: 0,0:21:27.50,0:21:29.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan cuma kata-katanya.
Dialogue: 0,0:21:29.34,0:21:33.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Emosinya juga masuk ke hati mereka.
Dialogue: 0,0:21:33.62,0:21:36.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau kita saling menyakiti lagi.
Dialogue: 0,0:21:38.02,0:21:40.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaan hangat dan lembut.
Dialogue: 0,0:21:41.15,0:21:44.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan psikologis yang sangat kuat.
Dialogue: 0,0:21:44.02,0:21:45.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan kau!
Dialogue: 0,0:21:45.51,0:21:47.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan ini!
Dialogue: 0,0:21:47.42,0:21:49.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan cinta...
Dialogue: 0,0:21:49.30,0:21:53.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat mengalaminya langsung,\Nitu benar-benar menyebalkan.
Dialogue: 0,0:23:26.11,0:23:28.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sedang berusaha sangat keras,\Nwaktu mereka bertanya,
Dialogue: 0,0:23:28.57,0:23:30.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Apakah bangsa ini layak diperjuangkan?"
Dialogue: 0,0:23:30.32,0:23:32.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku, Leon.
Dialogue: 0,0:23:32.36,0:23:33.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mulai menggila!
Dialogue: 0,0:23:33.93,0:23:35.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya,\N"Kau Benar-Benar Mengenai Titik Sensitif!"
Dialogue: 0,0:23:35.86,0:23:38.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luxion, buat penghalang di sekitar pikiranku!
Dialogue: 0,0:23:38.43,0:23:40.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Vandel, hei!
