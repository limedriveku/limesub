Dialogue: 0,0:02:11.09,0:02:12.51,sign,,0000,0000,0000,,"AKU SUKA PENCITRAAN"
Dialogue: 0,0:04:53.22,0:04:55.70,sign,,0000,0000,0000,,"JILK"
Dialogue: 0,0:05:41.79,0:05:44.45,sign,,0000,0000,0000,,"GREG"
Dialogue: 0,0:06:06.48,0:06:08.47,sign,,0000,0000,0000,,"BRAD"
Dialogue: 0,0:06:28.17,0:06:29.17,sign,,0000,0000,0000,,CHRIS
Dialogue: 0,0:06:49.32,0:06:50.32,sign,,0000,0000,0000,,JULIUS
Dialogue: 0,0:00:06.70,0:00:09.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baju besi ajaib dibawa,\Nkesatria penjahat dipenjara,
Dialogue: 0,0:00:09.99,0:00:13.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan seruling ajaib\Nserta Putri Hertrauda pun hadir.
Dialogue: 0,0:00:13.59,0:00:19.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, dengan ketiganya di sini,\Nkemenangan Kerajaan Fanoss sudah pasti.
Dialogue: 0,0:00:32.03,0:00:33.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya! Berangkat!
Dialogue: 0,0:00:33.23,0:00:35.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunjukkan kekuatan Kerajaan Fanoss\Npada mereka!
Dialogue: 0,0:00:35.59,0:00:37.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini akhir dari Kerajaan Holfort!
Dialogue: 0,0:00:45.64,0:00:46.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Trapped in a Dating Sim
Dialogue: 0,0:00:49.35,0:00:50.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}The World of Otome Games is Tough for Mobs
Dialogue: 0,0:00:59.20,0:01:07.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Trapped in a Dating Sim 2: The World\Nof Otome Games is Tough for Mobs
Dialogue: 0,0:02:11.09,0:02:12.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan.
Dialogue: 0,0:02:12.51,0:02:14.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:02:14.56,0:02:18.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada gangguan komunikasi kecil\Ndi dekat perbatasan.
Dialogue: 0,0:02:19.51,0:02:22.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lapor! Kerajaan Fanoss sudah mulai maju!
Dialogue: 0,0:02:23.15,0:02:27.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih dari 100 kapal dan 1.000 monster\Nmendekati perbatasan Kerajaan!
Dialogue: 0,0:02:27.92,0:02:30.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil! Ke mana perginya para penjaga?!
Dialogue: 0,0:02:30.96,0:02:35.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya ada masalah transponder\Nyang mengganggu komunikasi.
Dialogue: 0,0:02:35.98,0:02:38.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya Kerajaan Fanoss.
Dialogue: 0,0:02:38.48,0:02:39.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, sudah dimulai.
Dialogue: 0,0:02:39.53,0:02:44.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka takkan mencapai\Nibu kota kerajaan dalam waktu dekat.
Dialogue: 0,0:02:44.01,0:02:46.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita lihat saja\Nseberapa tangguh bangsawan setempat
Dialogue: 0,0:02:46.38,0:02:47.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mempertahankan wilayahnya.
Dialogue: 0,0:02:48.45,0:02:50.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang harus kita lakukan, Tuan?
Dialogue: 0,0:02:50.25,0:02:51.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm...
Dialogue: 0,0:02:52.50,0:02:55.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerusakannya takkan bertambah besar.
Dialogue: 0,0:02:55.52,0:02:58.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampaikan pesan ke Yang Mulia dengan tenang.
Dialogue: 0,0:02:58.32,0:02:59.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:02:59.38,0:03:02.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapkan ibu kota kerajaan\Ndalam siaga tinggi.
Dialogue: 0,0:03:04.86,0:03:05.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:03:05.88,0:03:06.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada keributan apa?
Dialogue: 0,0:03:06.70,0:03:07.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa ini?
Dialogue: 0,0:03:07.64,0:03:10.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu kota kerajaan sedang\Ndalam kewaspadaan tinggi.
Dialogue: 0,0:03:11.19,0:03:14.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warga diimbau untuk tidak keluar rumah.
Dialogue: 0,0:03:14.05,0:03:15.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekolah tutup?
Dialogue: 0,0:03:15.50,0:03:16.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segampang itu?
Dialogue: 0,0:03:16.92,0:03:18.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, sih?
Dialogue: 0,0:03:18.63,0:03:20.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sudah terjadi?
Dialogue: 0,0:03:20.52,0:03:22.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leon masih di penjara...
Dialogue: 0,0:03:23.18,0:03:26.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa informasi ini bisa dipercaya?
Dialogue: 0,0:03:26.15,0:03:29.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Papa suruh aku\Npulang sekarang juga.
Dialogue: 0,0:03:29.49,0:03:34.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit dipercaya.\NPerang sungguh akan dimulai?
Dialogue: 0,0:03:36.83,0:03:38.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ange...
Dialogue: 0,0:03:41.83,0:03:44.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau dapat lebih banyak dari yang diharapkan.
Dialogue: 0,0:03:44.04,0:03:48.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Banyak sekali\Nbangsawan mencurigakan yang masuk.
Dialogue: 0,0:03:48.17,0:03:50.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri tahu aku cara aktifkan\Nbarang hilang itu.
Dialogue: 0,0:03:51.29,0:03:53.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan diampuni\Nkalau bergabung dengan kami.
Dialogue: 0,0:03:53.92,0:03:55.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang menjebloskanmu ke sini...
Dialogue: 0,0:03:56.48,0:03:58.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah syaratnya.
Dialogue: 0,0:03:59.42,0:04:01.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua berjalan seperti kata Nyonya Mylene.
Dialogue: 0,0:04:01.76,0:04:06.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau mereka tak segera datang untukmu,\Nkau akan dihukum mati.
Dialogue: 0,0:04:06.60,0:04:09.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, aku takkan biarkan itu terjadi.
Dialogue: 0,0:04:09.38,0:04:12.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku, sepertinya\Naku merencanakan pemberontakan.
Dialogue: 0,0:04:12.50,0:04:15.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau tak mau\Nbertindak sendiri saja, Tuan?
Dialogue: 0,0:04:16.38,0:04:19.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma sebagian kecil bangsawan\Nyang merasa tidak puas.
Dialogue: 0,0:04:19.69,0:04:22.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang lainnya puas\Ndengan keadaan dunia sekarang.
Dialogue: 0,0:04:23.54,0:04:27.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku mulai kacaukan semuanya,\Naku yang jadi penjahatnya.
Dialogue: 0,0:04:27.62,0:04:29.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini masih seorang kesatria, tahu.
Dialogue: 0,0:04:29.83,0:04:31.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di Kerajaan Holfort,
Dialogue: 0,0:04:31.77,0:04:35.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kesatria cuma kenyamanan\Nuntuk wanita bangsawan dan Istana.
Dialogue: 0,0:04:35.63,0:04:38.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kekesatriaanmu\Nmembela rakyat juga waktu itu?
Dialogue: 0,0:04:39.45,0:04:42.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesatria itu cuma pencitraan.
Dialogue: 0,0:04:42.75,0:04:45.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menyedihkan, Bartfort.
Dialogue: 0,0:04:46.24,0:04:48.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Hijau Muka Dua.
Dialogue: 0,0:04:48.34,0:04:49.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Jilk.
Dialogue: 0,0:04:50.54,0:04:53.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana bisa kau masuk ke sini?\NDi mana para penjaga?
Dialogue: 0,0:04:53.22,0:04:55.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka tak terlalu waspada.
Dialogue: 0,0:04:55.70,0:04:57.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin karena hubungan kita tak baik.
Dialogue: 0,0:04:57.98,0:05:01.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus. Ayo kita buat\Nhubungan kita makin buruk.
Dialogue: 0,0:05:01.44,0:05:05.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu, Marie minta kami\Nuntuk menyelamatkanmu.
Dialogue: 0,0:05:05.49,0:05:08.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan ini? Ini jebakan?
Dialogue: 0,0:05:08.47,0:05:10.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana caramu menyelamatkanku?
Dialogue: 0,0:05:10.45,0:05:13.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluargaku masih Bangsawan Istana.
Dialogue: 0,0:05:13.49,0:05:15.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami punya koneksi.
Dialogue: 0,0:05:16.00,0:05:18.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, santai saja dan tunggu.
Dialogue: 0,0:05:20.66,0:05:21.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:05:23.44,0:05:24.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kau baik-baik saja?
Dialogue: 0,0:05:26.26,0:05:28.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka teriaki aku\Nuntuk merenungkan perbuatanku.
Dialogue: 0,0:05:28.97,0:05:31.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka tak mau dengar.
Dialogue: 0,0:05:32.82,0:05:34.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pasti karma.
Dialogue: 0,0:05:35.67,0:05:37.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Merah Otak Otot.
Dialogue: 0,0:05:37.20,0:05:38.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Greg!
Dialogue: 0,0:05:38.51,0:05:41.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau datang menyelamatkanku\Nkarena Marie yang memintamu?
Dialogue: 0,0:05:41.79,0:05:44.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku minta keluargaku keluarkan kau
Dialogue: 0,0:05:44.45,0:05:46.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan jadi bertengkar dengan ayahku.
Dialogue: 0,0:05:46.23,0:05:48.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minta maaf ke ayahmu.
Dialogue: 0,0:05:48.94,0:05:51.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian bikin terlalu banyak masalah\Nuntuk semua orang.
Dialogue: 0,0:05:53.78,0:05:55.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar tak mau dengar itu darimu.
Dialogue: 0,0:05:55.82,0:05:57.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?! Kenapa begitu?!
Dialogue: 0,0:05:59.86,0:06:01.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ungu Narsis.
Dialogue: 0,0:06:01.94,0:06:04.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau di sini untuk selamatkan aku juga?
Dialogue: 0,0:06:04.38,0:06:05.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Brad.
Dialogue: 0,0:06:06.48,0:06:08.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya begitu rencananya,
Dialogue: 0,0:06:08.47,0:06:10.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku tak bisa hubungi keluargaku.
Dialogue: 0,0:06:11.05,0:06:11.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:06:12.23,0:06:17.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Komunikator tak tersambung, dan tak ada\Nsiapa pun di rumah kami di ibu kota...
Dialogue: 0,0:06:17.75,0:06:21.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menangis. Pasti ada alasannya...
Dialogue: 0,0:06:21.76,0:06:23.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei! Kenapa aku malah menghiburmu?
Dialogue: 0,0:06:24.51,0:06:25.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Byrartfart.
Dialogue: 0,0:06:25.76,0:06:26.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:06:26.98,0:06:28.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biru Cinta Diri?!
Dialogue: 0,0:06:29.52,0:06:31.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Chris!
Dialogue: 0,0:06:31.17,0:06:34.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tanya ayah dan guru pedangku\Napa dia bisa selamatkan kau.
Dialogue: 0,0:06:34.92,0:06:37.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bertanya, padahal kau kan Saint Pedang?
Dialogue: 0,0:06:37.16,0:06:38.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga lakukan ini padaku.
Dialogue: 0,0:06:38.88,0:06:40.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, ada cara lebih baik\Nuntuk bilang itu.
Dialogue: 0,0:06:42.89,0:06:44.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluar! Putih Gila Sialan!
Dialogue: 0,0:06:44.94,0:06:48.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?! Aku belum bilang\Nsepatah kata pun!
Dialogue: 0,0:06:48.05,0:06:49.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, namaku Julius!
Dialogue: 0,0:06:50.61,0:06:54.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku langsung tahu.\NKau coba keluarkan aku, tapi gagal.
Dialogue: 0,0:06:54.57,0:06:59.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Aku tanya ibuku,\Ndan dia tiba-tiba tampar aku.
Dialogue: 0,0:06:59.72,0:07:01.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Mylene?!
Dialogue: 0,0:07:01.22,0:07:03.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia lakukan itu?
Dialogue: 0,0:07:06.09,0:07:09.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang kubilang cuma,\N"Ini permintaan dari Marie
Dialogue: 0,0:07:09.11,0:07:10.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang bakal jadi menantumu!"
Dialogue: 0,0:07:10.48,0:07:12.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa salahku?
Dialogue: 0,0:07:12.26,0:07:14.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katakan padaku, Bartfort!
Dialogue: 0,0:07:14.82,0:07:16.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ini bodoh, ya?
Dialogue: 0,0:07:16.65,0:07:18.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, ya, kau memang bodoh.
Dialogue: 0,0:07:18.37,0:07:19.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bartfort!
Dialogue: 0,0:07:21.23,0:07:24.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti akan selamatkan kau\Nsuatu hari nanti!
Dialogue: 0,0:07:29.95,0:07:33.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa sih, yang mereka coba lakukan?
Dialogue: 0,0:07:37.20,0:07:38.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditembaki dari sisi kiri belakang!
Dialogue: 0,0:07:38.95,0:07:40.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster mendekat!
Dialogue: 0,0:07:41.13,0:07:44.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jumlahnya kebanyakan!\NKita takkan bisa tahan mereka!
Dialogue: 0,0:07:55.44,0:07:59.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya armada Kerajaan Fanoss\Nsudah mulai operasi perbatasan.
Dialogue: 0,0:08:00.20,0:08:03.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penguasa dan penjaga perbatasan setempat\Nsudah hadapi mereka,
Dialogue: 0,0:08:03.73,0:08:05.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi jumlah mereka...
Dialogue: 0,0:08:05.10,0:08:06.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan masalah.
Dialogue: 0,0:08:06.53,0:08:11.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanah yang diserbu Kerajaan\Nharus diserahkan sesuai kesepakatan kita.
Dialogue: 0,0:08:11.68,0:08:15.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah mereka duduki,\NKerajaan akan perlambat majunya mereka.
Dialogue: 0,0:08:15.33,0:08:19.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itulah kita bertindak.\NSekarang biarkan mereka lakukan apa maunya.
Dialogue: 0,0:08:20.26,0:08:23.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti, posisimu bakal jadi sekokoh batu.
Dialogue: 0,0:08:23.82,0:08:24.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hmph.
Dialogue: 0,0:08:24.69,0:08:27.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, ada permintaan dari Kuil.
Dialogue: 0,0:08:27.49,0:08:30.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka ingin Saint ikut dalam pertempuran.
Dialogue: 0,0:08:31.47,0:08:33.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bikin resah...
Dialogue: 0,0:08:33.80,0:08:37.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar Saint\Npunya kekuatan mengusir monster.
Dialogue: 0,0:08:37.26,0:08:41.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka mau tunjukkan kekuatan itu\Ndan tambah kepercayaan pada Kuil.
Dialogue: 0,0:08:42.23,0:08:45.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu takkan berdampak\Npada kesepakatan kita dengan Kerajaan.
Dialogue: 0,0:08:45.86,0:08:50.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Amankan bantuan dari Kuil bukan ide buruk.
Dialogue: 0,0:08:50.07,0:08:50.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, Tuan.
Dialogue: 0,0:08:50.91,0:08:52.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terakhir,
Dialogue: 0,0:08:52.05,0:08:54.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita harus apakan Bartfort?
Dialogue: 0,0:08:54.35,0:08:55.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya,
Dialogue: 0,0:08:55.36,0:08:58.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sepertinya kita takkan pernah\Nbisa aktifkan barang hilangnya.
Dialogue: 0,0:09:05.11,0:09:08.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu aku. Sebentar lagi...
Dialogue: 0,0:09:10.32,0:09:12.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Viscount Bartfort.
Dialogue: 0,0:09:12.06,0:09:12.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:09:12.77,0:09:16.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir kau mungkin kesepian.\NKubawakan anggur.
Dialogue: 0,0:09:17.10,0:09:18.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:09:21.50,0:09:25.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, tapi aku belum mau minum alkohol.
Dialogue: 0,0:09:25.67,0:09:27.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kau minum sendiri?
Dialogue: 0,0:09:29.27,0:09:30.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hmph.
Dialogue: 0,0:09:32.66,0:09:35.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai kapan kau mau jalani\Nhidup tak terhormat ini?
Dialogue: 0,0:09:36.15,0:09:38.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seorang kesatria\Nharus mati secara terhormat.
Dialogue: 0,0:09:38.67,0:09:42.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa? Aku lebih pilih mati\Nkarena tua saat tidur.
Dialogue: 0,0:09:42.38,0:09:44.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekurangajaranmu tak kenal batas!
Dialogue: 0,0:09:47.38,0:09:48.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matilah!
Dialogue: 0,0:09:51.47,0:09:52.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?!
Dialogue: 0,0:09:55.35,0:09:58.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma saja.\NCoba lihat ke kananmu.
Dialogue: 0,0:10:04.16,0:10:06.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bartfort, kau baik-baik saja?
Dialogue: 0,0:10:06.53,0:10:09.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan! Kalian pikir\Nsiapa yang ada di belakangku...
Dialogue: 0,0:10:10.11,0:10:11.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam kau.
Dialogue: 0,0:10:11.77,0:10:16.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sudah coba sebisa mungkin,\Ntapi selalu gagal.
Dialogue: 0,0:10:17.23,0:10:19.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada cara lain selain kekerasan.
Dialogue: 0,0:10:20.25,0:10:23.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Greg dan Brad tahan mereka yang di atas.
Dialogue: 0,0:10:23.87,0:10:25.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian...
Dialogue: 0,0:10:26.07,0:10:29.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun, apa pun yang terjadi,\Nitu bukan salahku.
Dialogue: 0,0:10:33.42,0:10:35.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Bartfort!
Dialogue: 0,0:10:35.09,0:10:38.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kutunjukkan jalan rahasia\Nyang cuma diketahui bangsawan!
Dialogue: 0,0:10:38.59,0:10:41.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan beri tahu aku rahasia begitu!
Dialogue: 0,0:10:41.74,0:10:43.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat itu, kau bakal terselamatkan.
Dialogue: 0,0:10:43.89,0:10:45.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan protes sekarang.
Dialogue: 0,0:10:48.47,0:10:50.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, kalian gila.
Dialogue: 0,0:10:52.65,0:10:54.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat. Lewat sini.
Dialogue: 0,0:10:57.71,0:11:01.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru, sayangnya, kita terkepung.
Dialogue: 0,0:11:01.49,0:11:02.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial.
Dialogue: 0,0:11:04.74,0:11:06.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian semua, turunkan senjata.
Dialogue: 0,0:11:06.99,0:11:08.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Ayah!
Dialogue: 0,0:11:08.91,0:11:10.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia, Raja Roland?!
Dialogue: 0,0:11:15.75,0:11:18.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah, Bartfort...
Dialogue: 0,0:11:19.03,0:11:22.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tahu, Bodoh.
Dialogue: 0,0:11:23.76,0:11:26.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau kelihatan sehat, Viscount.
Dialogue: 0,0:11:26.38,0:11:28.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, untungnya.
Dialogue: 0,0:11:28.27,0:11:29.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi?
Dialogue: 0,0:11:29.44,0:11:33.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan Kerajaan Fanoss sedang maju\Nke ibu kota kerajaan.
Dialogue: 0,0:11:34.52,0:11:37.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Armada musuh diperkirakan punya 150 kapal.
Dialogue: 0,0:11:37.53,0:11:39.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jumlah prajuritnya tak diketahui.
Dialogue: 0,0:11:39.38,0:11:42.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster di belakangnya cukup banyak\Nuntuk menutupi langit.
Dialogue: 0,0:11:42.74,0:11:44.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster?
Dialogue: 0,0:11:44.44,0:11:48.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya kita punya Putri Hertrude\Ndan seruling ajaib?
Dialogue: 0,0:11:48.50,0:11:51.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerajaan Fanoss punya seruling ajaib kedua.
Dialogue: 0,0:11:51.88,0:11:53.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pasti masalahnya.
Dialogue: 0,0:11:54.62,0:11:58.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seruling ajaib kedua?\NItu tak ada di gim.
Dialogue: 0,0:11:58.16,0:12:02.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hipotesis kami, putri kedua yang memakainya.
Dialogue: 0,0:12:02.71,0:12:04.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri kedua?
Dialogue: 0,0:12:05.23,0:12:10.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Adik Putri Hertrude, Putri Hertrauda.
Dialogue: 0,0:12:11.14,0:12:13.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga belum pernah\Ndengar soal dia sebelumnya!
Dialogue: 0,0:12:13.76,0:12:18.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami pertahankan garis pertahanan\Ndi sepanjang jalur mereka,
Dialogue: 0,0:12:18.08,0:12:23.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi lebih dari 10 kapal perang\Natau 100 prajurit sudah gugur sejauh ini.
Dialogue: 0,0:12:24.49,0:12:29.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuil sudah mengajukan permintaan kuat\Nuntuk kirim Saint ke garis depan.
Dialogue: 0,0:12:30.56,0:12:32.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia?
Dialogue: 0,0:12:32.02,0:12:33.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pe-Permisi!
Dialogue: 0,0:12:34.17,0:12:37.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan ini?\NKau ada di hadapan Yang Mulia!
Dialogue: 0,0:12:37.80,0:12:40.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak masalah. Ada apa?
Dialogue: 0,0:12:40.03,0:12:43.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuil dan pasukan kita\Nsedang menuju melawan musuh...
Dialogue: 0,0:12:47.89,0:12:50.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan musuh mendekat dari awan di depan.
Dialogue: 0,0:12:51.10,0:12:55.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saint Marie, saatnya sudah tiba\Nuntuk kau tunjukkan kekuatan sucimu.
Dialogue: 0,0:12:55.50,0:12:57.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kalau kau bersikeras!
Dialogue: 0,0:12:58.17,0:13:02.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian boleh serahkan semuanya padaku!
Dialogue: 0,0:13:03.37,0:13:08.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku bisa buktikan diri di sini,\Ntakkan ada yang menentangku lagi.
Dialogue: 0,0:13:12.01,0:13:12.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:13:17.23,0:13:18.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ap-Mustahil...
Dialogue: 0,0:13:18.86,0:13:20.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka tak bilang jumlahnya sebanyak ini...
Dialogue: 0,0:13:26.54,0:13:29.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh! Ini dia kekuatan Saint!
Dialogue: 0,0:13:29.18,0:13:29.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:13:29.85,0:13:31.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bisa menang.\NKita bisa menangkan ini!
Dialogue: 0,0:13:31.45,0:13:32.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dorong mundur Kerajaan Fanoss!
Dialogue: 0,0:13:32.65,0:13:34.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidup Saint!
Dialogue: 0,0:13:34.10,0:13:37.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}He-Hei, aku ini cukup jago soal beginian!
Dialogue: 0,0:13:37.54,0:13:39.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak harus Olivia!
Dialogue: 0,0:13:42.80,0:13:46.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan Saint... Sepertinya itu nyata.
Dialogue: 0,0:13:46.78,0:13:49.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia, maukah kau beri kami kehormatan
Dialogue: 0,0:13:49.23,0:13:51.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk buka jalan menuju ibu kota kerajaan?
Dialogue: 0,0:13:52.02,0:13:53.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku paham.
Dialogue: 0,0:13:53.95,0:13:56.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat tinggal, Kak.
Dialogue: 0,0:13:57.23,0:13:59.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peran yang tak bisa kau penuhi...
Dialogue: 0,0:14:05.03,0:14:06.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kupenuhi.
Dialogue: 0,0:14:07.18,0:14:08.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa?
Dialogue: 0,0:14:09.69,0:14:14.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, Saint,\Nrasakan murka Kerajaan Fanoss!
Dialogue: 0,0:14:19.89,0:14:21.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Itu...
Dialogue: 0,0:14:30.82,0:14:32.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mo-Monster!
Dialogue: 0,0:14:33.15,0:14:38.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wujud yang sungguh kuat!\NDewa Penjaga Langit!
Dialogue: 0,0:14:40.20,0:14:44.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanah kalian akan tenggelam,\Nhancur antara langit dan laut...
Dialogue: 0,0:14:46.19,0:14:47.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia!
Dialogue: 0,0:14:47.66,0:14:50.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan asli seruling ajaib\Nyang menguras nyawa penggunanya!
Dialogue: 0,0:14:50.55,0:14:54.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, kau sungguh luar biasa!
Dialogue: 0,0:14:54.84,0:14:59.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan Saint tak punya peluang\Nmelawan Dewa Penjaga Langit.
Dialogue: 0,0:14:59.20,0:15:02.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggal menginjak-injak Kerajaan Holfort!
Dialogue: 0,0:15:02.77,0:15:05.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kulakukan, Kak.
Dialogue: 0,0:15:09.97,0:15:12.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saint! Perisai!
Dialogue: 0,0:15:12.00,0:15:14.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong kalahkan monster itu!
Dialogue: 0,0:15:14.28,0:15:17.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Me-Menjauhlah! Pergi!
Dialogue: 0,0:15:34.30,0:15:36.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak mungkin...
Dialogue: 0,0:15:36.30,0:15:38.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa kalahkan itu!
Dialogue: 0,0:15:38.12,0:15:41.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak tahu dia bakal muncul sekarang!
Dialogue: 0,0:15:41.17,0:15:43.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan gim yang kutahu!
Dialogue: 0,0:15:44.48,0:15:45.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saint!
Dialogue: 0,0:15:45.83,0:15:47.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saint!
Dialogue: 0,0:15:47.14,0:15:48.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong, lakukan sesuatu!
Dialogue: 0,0:15:48.76,0:15:50.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong, Saint!
Dialogue: 0,0:15:50.44,0:15:54.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saint!
Dialogue: 0,0:15:54.94,0:15:56.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamatkan kami!
Dialogue: 0,0:15:56.19,0:15:57.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan itu!
Dialogue: 0,0:15:58.78,0:16:02.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan Saint! Aku cuma yang palsu!
Dialogue: 0,0:16:03.19,0:16:04.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa...
Dialogue: 0,0:16:04.20,0:16:05.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saint...
Dialogue: 0,0:16:08.85,0:16:12.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa... lakukan apa pun...
Dialogue: 0,0:16:12.21,0:16:14.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mu-Mundur! Mundur sekarang...
Dialogue: 0,0:16:20.35,0:16:24.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada yang bisa kulakukan!\NAku bukan tokoh utamanya!
Dialogue: 0,0:16:27.99,0:16:31.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong... seseorang... selamatkan aku...
Dialogue: 0,0:16:31.84,0:16:33.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa pun!
Dialogue: 0,0:16:34.95,0:16:39.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan Kuil mundur!\NBantuan Armada Kerajaan sudah musnah!
Dialogue: 0,0:16:41.10,0:16:42.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini mimpi buruk.
Dialogue: 0,0:16:42.76,0:16:47.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terus begini, mereka akan tiba\Ndi ibu kota kerajaan dalam dua hari.
Dialogue: 0,0:16:47.39,0:16:50.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Viscount Bartfort,\Nakan kutanya langsung padamu.
Dialogue: 0,0:16:51.58,0:16:53.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kau mengalahkannya?
Dialogue: 0,0:16:54.35,0:16:59.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster yang Marie tak bisa kalahkan\Npastinya bos akhir dari gim otome.
Dialogue: 0,0:16:59.77,0:17:03.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya, itu mustahil.\NLuxion tak bisa mengalahkannya.
Dialogue: 0,0:17:03.06,0:17:06.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu-satunya yang bisa adalah Livia,\Ntokoh utama sebenarnya.
Dialogue: 0,0:17:06.90,0:17:11.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, semuanya sudah berkembang\Nsama sekali berbeda dari gim.
Dialogue: 0,0:17:11.38,0:17:15.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan cinta antara Livia\Ndan orang yang disukainya tak bisa aktif.
Dialogue: 0,0:17:15.70,0:17:19.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya, kita kalah.\NPermainan sudah berakhir.
Dialogue: 0,0:17:20.09,0:17:23.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kulihat kau pun merasa itu sulit dijawab.
Dialogue: 0,0:17:23.16,0:17:28.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, tak masalah. Bersiaplah sampai kami\Ndapat informasi lebih lanjut.
Dialogue: 0,0:17:28.63,0:17:30.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:17:30.16,0:17:33.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia, boleh aku ajukan pertanyaan?
Dialogue: 0,0:17:33.34,0:17:34.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:17:34.96,0:17:37.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana Julius dan yang lain\Nyang menyelamatkanku?
Dialogue: 0,0:17:37.22,0:17:38.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sudah dipenjara.
Dialogue: 0,0:17:38.95,0:17:42.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siswa tanpa pengalaman tempur\Ncuma akan jadi penghalang.
Dialogue: 0,0:17:42.09,0:17:43.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi mereka...
Dialogue: 0,0:17:43.84,0:17:46.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi\Nseandainya aku tak ada di sana?
Dialogue: 0,0:17:46.77,0:17:47.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar orang-orang bodoh.
Dialogue: 0,0:17:51.43,0:17:54.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya Kuil berniat bunuh Marie.
Dialogue: 0,0:17:55.43,0:17:57.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atas klaim palsu sebagai Saint,
Dialogue: 0,0:17:57.39,0:18:00.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia akan dibakar di tiang pancang\Natau disalib.
Dialogue: 0,0:18:01.13,0:18:04.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlepas itu, bahkan di situasi ini,\Nmereka suruh kau bersiap.
Dialogue: 0,0:18:04.63,0:18:06.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka orang-orang sederhana.
Dialogue: 0,0:18:07.25,0:18:08.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luxion.
Dialogue: 0,0:18:08.40,0:18:09.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:18:10.02,0:18:11.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa banyak?
Dialogue: 0,0:18:11.69,0:18:12.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf?
Dialogue: 0,0:18:13.51,0:18:16.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa banyak korban jiwa\Ndari serangan Kerajaan Fanoss?
Dialogue: 0,0:18:16.32,0:18:21.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan 30 kapal Kuil dan 200 kapal\NKerajaan Holfort hancur semua,
Dialogue: 0,0:18:21.85,0:18:24.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kuyakin seharusnya ada beberapa puluh ribu.
Dialogue: 0,0:18:25.64,0:18:26.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan,
Dialogue: 0,0:18:27.31,0:18:29.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tertunda akibat gangguan komunikasi,
Dialogue: 0,0:18:29.51,0:18:32.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sudah kupindai\Nseluruh Kerajaan sekali lagi.
Dialogue: 0,0:18:32.83,0:18:35.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua monster raksasa terdeteksi.
Dialogue: 0,0:18:35.79,0:18:38.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka jepit daratan terapung\Ndari langit dan laut,
Dialogue: 0,0:18:38.01,0:18:40.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menuju ibu kota kerajaan.
Dialogue: 0,0:18:40.47,0:18:41.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:18:52.82,0:18:54.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua?
Dialogue: 0,0:18:54.22,0:18:55.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa ini?
Dialogue: 0,0:18:55.88,0:18:58.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini beda dari gim otome.
Dialogue: 0,0:18:59.07,0:19:02.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya gangguan komunikasi\Ndisebabkan monster raksasa itu.
Dialogue: 0,0:19:03.40,0:19:06.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kusarankan untuk kabur dari benua ini.
Dialogue: 0,0:19:07.21,0:19:08.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu itu.
Dialogue: 0,0:19:08.87,0:19:11.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak terikat pada Kerajaan Holfort\Ndengan cara apa pun.
Dialogue: 0,0:19:12.01,0:19:13.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:19:13.75,0:19:14.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:19:19.91,0:19:21.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama tak jumpa, Guru.
Dialogue: 0,0:19:22.72,0:19:25.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Leon, pikiranmu terlihat kacau.
Dialogue: 0,0:19:28.73,0:19:30.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa tahu itu?
Dialogue: 0,0:19:30.94,0:19:33.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ratu Mylene mengkhawatirkanmu.
Dialogue: 0,0:19:33.54,0:19:37.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mahir menawan hati\Npara wanita, Tuan Leon.
Dialogue: 0,0:19:37.61,0:19:40.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau kau ajari aku suatu hari nanti.
Dialogue: 0,0:19:41.20,0:19:44.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jarang sekali Guru bercanda.
Dialogue: 0,0:19:47.02,0:19:50.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru, kau takkan lari?
Dialogue: 0,0:19:52.42,0:19:57.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak layak, tapi aku kesatria Kerajaan\Nyang punya pangkat dan gelar.
Dialogue: 0,0:19:58.14,0:19:59.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau takkan lari?
Dialogue: 0,0:20:01.39,0:20:05.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Leon, aku takkan mengkritikmu\Nkarena melarikan diri.
Dialogue: 0,0:20:06.43,0:20:10.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma sudah putuskan\Nbahwa aku akan tetap di sini.
Dialogue: 0,0:20:11.79,0:20:15.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gagasanku tentang kekesatriaan\Nadalah membela mereka yang kusayangi.
Dialogue: 0,0:20:16.60,0:20:17.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk lakukan itu,
Dialogue: 0,0:20:19.37,0:20:24.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan kuperjuangkan sampai akhir yang pahit,\Nsesulit apa pun kemenangannya.
Dialogue: 0,0:20:25.49,0:20:27.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gagasanmu tentang kekesatriaan?
Dialogue: 0,0:20:28.47,0:20:32.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Boleh kutanya apa gagasanmu\Ntentang kekesatriaan, Tuan Leon?
Dialogue: 0,0:20:32.90,0:20:35.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekesatriaan cuma pencitraan.
Dialogue: 0,0:20:37.26,0:20:41.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku suka pencitraan, tahu.
Dialogue: 0,0:20:41.97,0:20:44.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka kekesatriaan yang membela rakyat.
Dialogue: 0,0:20:51.02,0:20:55.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih tehnya, Guru.\NAku pergi dulu sekarang.
Dialogue: 0,0:21:02.31,0:21:04.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan, kau takkan lari?
Dialogue: 0,0:21:04.99,0:21:07.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak lagi. Aku sedang berjuang\Nmelawan Kerajaan Fanoss.
Dialogue: 0,0:21:07.68,0:21:09.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yakin?
Dialogue: 0,0:21:09.41,0:21:12.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Julius dan antek-anteknya datang\Nuntuk keluarkan aku,
Dialogue: 0,0:21:12.41,0:21:14.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sadar penuh bahwa mereka bakal tertangkap.
Dialogue: 0,0:21:14.17,0:21:17.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa kabur sendirian.
Dialogue: 0,0:21:18.45,0:21:21.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kau sudah tertular kebodohan mereka.
Dialogue: 0,0:21:21.42,0:21:24.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa pahami keputusanmu.
Dialogue: 0,0:21:26.19,0:21:28.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tak bisa memahaminya.
Dialogue: 0,0:21:28.99,0:21:33.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau aku kabur sekarang,\Naku tahu bakal terus terpikir nanti.
Dialogue: 0,0:21:34.34,0:21:36.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau hidup dengan\Nterus bertanya-tanya
Dialogue: 0,0:21:36.70,0:21:40.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa aku sudah lakukan hal yang benar\Nwaktu berbaring di tempat tidur.
Dialogue: 0,0:21:41.11,0:21:44.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa bergantung pada orang lain,\Njadi akan kulakukan sendiri.
Dialogue: 0,0:21:44.62,0:21:46.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bantu aku, Luxion.
Dialogue: 0,0:21:46.91,0:21:48.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga.
Dialogue: 0,0:21:50.45,0:21:52.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tuan yang benar-benar tak ada harapan.
Dialogue: 0,0:23:26.31,0:23:28.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya Leon buat keputusan.
Dialogue: 0,0:23:28.03,0:23:30.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sisinya, ada teman menghina\Ndan ayah yang marah?
Dialogue: 0,0:23:30.96,0:23:32.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, identitas asli mereka terungkap!
Dialogue: 0,0:23:33.13,0:23:35.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya,\N"Kalau Kau Tak Mau, Aku Kabur Saja".
Dialogue: 0,0:23:35.75,0:23:37.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menangis, tertawa, dan berkelahi...
Dialogue: 0,0:23:37.74,0:23:39.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei! Ini bukan waktunya begitu!
