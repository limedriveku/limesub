Dialogue: 0,0:02:48.64,0:02:52.52,tanda-5,signs,0,0,0,,{\fad(240,0)\fs100\bord0\shad0\pos(960,700)\c&HF9F8F8&}Seribu Tahun Raja Monster Sihir
Dialogue: 10,0:00:01.95,0:00:03.60,dialog,,0,0,0,,Aku sudah tidak kedinginan lagi.
Dialogue: 10,0:00:05.15,0:00:07.75,dialog,,0,0,0,,Karena aku sudah mendapatkan\Nkehangatan yang cukup.
Dialogue: 10,0:00:08.40,0:00:09.79,dialog,,0,0,0,,Hei!
Dialogue: 10,0:00:09.79,0:00:11.55,dialog,,0,0,0,,Tunggu sebentar!
Dialogue: 10,0:00:11.55,0:00:14.00,dialog,,0,0,0,,Kau tidak memilih jalan yang nyaman,
Dialogue: 10,0:00:14.00,0:00:17.50,dialog,,0,0,0,,juga tidak menganggap ayahmu sendiri\Nsebagai barang palsu dan menebasnya.
Dialogue: 10,0:00:17.50,0:00:20.19,dialog,,0,0,0,,Keyakinan dirimu yang teguh itu…
Dialogue: 10,0:00:20.19,0:00:23.20,dialog,,0,0,0,,Sampai di tahap ini,\Nkau malah bisa masuk ke rute yang benar.
Dialogue: 10,0:00:23.20,0:00:26.50,dialog,,0,0,0,,Padahal dengan perkembangan tadi\Nkau jelas-jelas akan tereliminasi.
Dialogue: 10,0:00:27.56,0:00:28.62,dialog,,0,0,0,,Terima kasih, kalian semua.
Dialogue: 10,0:00:30.25,0:00:31.45,dialog,,0,0,0,,Selamat tinggal selamanya.
Dialogue: 10,0:00:32.30,0:00:34.79,dialog,,0,0,0,,Benar-benar tidak mungkin.
Dialogue: 10,0:00:38.35,0:00:40.89,dialog,,0,0,0,,Kau jangan harap bisa mendapatkan apa pun!
Dialogue: 10,0:00:40.89,0:00:43.54,dialog,,0,0,0,,Kemampuan dan informasi yang didapat di sini,
Dialogue: 10,0:00:43.54,0:00:45.84,dialog,,0,0,0,,serta ingatan pertemuan kembali\Ndengan orang tua
Dialogue: 10,0:00:45.84,0:00:48.90,dialog,,0,0,0,,dan tentu saja termasuk lambang kutukan,\Nsemuanya akan kembali menjadi kehampaan.
Dialogue: 10,0:00:48.90,0:00:51.75,dialog,,0,0,0,,Bahkan ingatanmu pun akan menghilang…
Dialogue: 10,0:00:51.95,0:00:55.00,dialog,,0,0,0,,Tertusuklah oleh cermin\Nyang tidak terhitung jumlahnya.
Dialogue: 10,0:00:55.60,0:01:00.00,dialog,,0,0,0,,Kali ini kau pasti mati, pahlawan palsu!
Dialogue: 10,0:02:50.95,0:02:52.51,dialog,,0,0,0,,Ini pertama kalinya
Dialogue: 10,0:02:52.89,0:02:55.40,dialog,,0,0,0,,aku bertarung melawan musuh\Nyang setara kekuatannya.
Dialogue: 10,0:02:56.35,0:03:00.23,dialog,,0,0,0,,Baiklah, mari kita lanjutkan, Vordin.
Dialogue: 10,0:03:00.75,0:03:04.26,dialog,,0,0,0,,Apakah bisa menyerang tanpa menahan diri\Nmembuatmu sesenang itu?
Dialogue: 10,0:03:05.26,0:03:07.65,dialog,,0,0,0,,Lihatlah, kau bahkan tidak bisa\Nmenyembunyikan senyummu.
Dialogue: 10,0:03:08.20,0:03:10.41,dialog,,0,0,0,,Aku tersenyum?
Dialogue: 10,0:03:10.80,0:03:14.26,dialog,,0,0,0,,Tidak ada lawan di dunia ini,\Nbenar-benar sangat membosankan.
Dialogue: 10,0:03:15.55,0:03:18.70,dialog,,0,0,0,,Yang memiliki kemampuan untuk\Nbertarung melawan Raja Monster Sihir
Dialogue: 10,0:03:18.70,0:03:22.74,dialog,,0,0,0,,hanyalah orang yang sama-sama\Nmemiliki kekuatan wilayah
Dialogue: 10,0:03:22.75,0:03:27.50,dialog,,0,0,0,,atau pahlawan sejati yang punya kekuatan\Nuntuk menghancurkan wilayah.
Dialogue: 10,0:03:28.70,0:03:32.25,dialog,,0,0,0,,Kau tidak pernah bisa bertemu\Ndengan lawan semacam itu.
Dialogue: 10,0:03:32.25,0:03:35.55,dialog,,0,0,0,,Kekuatanmu itu pasti selama ini\Ntidak ada tempat untuk dilampiaskan, 'kan?
Dialogue: 10,0:03:35.95,0:03:39.05,dialog,,0,0,0,,Yang mengalahkanmu adalah pahlawan.
Dialogue: 10,0:03:39.05,0:03:43.15,dialog,,0,0,0,,Lalu, yang mengalahkan pahlawan itu\Nadalah "Vordin dari Api Unggun".
Dialogue: 10,0:03:43.85,0:03:45.20,dialog,,0,0,0,,Vordin.
Dialogue: 10,0:03:45.65,0:03:49.15,dialog,,0,0,0,,Aku akan datang setiap seratus tahun\Nuntuk memastikan situasi.
Dialogue: 10,0:03:49.70,0:03:53.35,dialog,,0,0,0,,Meskipun setiap kali aku datang,\Nmiko yang kurasuki akan berbeda,
Dialogue: 10,0:03:53.35,0:03:54.80,dialog,,0,0,0,,kumohon jangan memedulikannya.
Dialogue: 10,0:03:55.90,0:03:59.19,dialog,,0,0,0,,Apakah kau mau mencoba bertarung denganku?
Dialogue: 10,0:03:59.19,0:04:00.39,dialog,,0,0,0,,Sayang sekali,
Dialogue: 10,0:04:00.40,0:04:03.42,dialog,,0,0,0,,kekuatan yang bisa dikeluarkan\Nmelalui miko sangat terbatas.
Dialogue: 10,0:04:04.90,0:04:06.50,dialog,,0,0,0,,Zavtier.
Dialogue: 10,0:04:06.50,0:04:08.90,dialog,,0,0,0,,Sebenarnya, apa artinya hidup?
Dialogue: 10,0:04:09.75,0:04:14.30,dialog,,0,0,0,,Seharusnya itu adalah\Nproses dari sejak lahir hingga mati, 'kan?
Dialogue: 10,0:04:14.90,0:04:17.00,dialog,,0,0,0,,Melahirkan dan membesarkan anak,
Dialogue: 10,0:04:17.00,0:04:20.23,dialog,,0,0,0,,lalu anak itu tumbuh dewasa\Ndan menghasilkan generasi berikutnya.
Dialogue: 10,0:04:21.00,0:04:24.22,dialog,,0,0,0,,Kurasa jawabannya ada di dalam hal tersebut.
Dialogue: 10,0:04:24.69,0:04:27.35,dialog,,0,0,0,,Jadi, kau juga tidak tahu, ya.
Dialogue: 10,0:04:27.35,0:04:30.20,dialog,,0,0,0,,Padahal kau sudah hidup\Nlebih dari dua ribu tahun.
Dialogue: 10,0:04:30.79,0:04:31.70,dialog,,0,0,0,,Ya.
Dialogue: 10,0:04:32.20,0:04:34.25,dialog,,0,0,0,,Kembalilah, Zavtier.
Dialogue: 10,0:04:35.14,0:04:37.40,dialog,,0,0,0,,Kalau begitu,\Nsampai jumpa seratus tahun lagi.
Dialogue: 10,0:04:37.40,0:04:39.60,dialog,,0,0,0,,Kau tidak perlu datang lagi.
Dialogue: 10,0:04:40.45,0:04:44.85,dialog,,0,0,0,,Selama seribu tahun ini\Nkau pasti merasa bosan hidup, 'kan?
Dialogue: 10,0:04:45.30,0:04:46.85,dialog,,0,0,0,,Seribu tahun…
Dialogue: 10,0:04:50.45,0:04:53.90,dialog,,0,0,0,,Kau sekarang masih bisa tersenyum,
Dialogue: 10,0:04:53.90,0:04:57.09,dialog,,0,0,0,,itu karena aku telah mengakhiri era tersebut.
Dialogue: 10,0:04:57.55,0:05:02.80,dialog,,0,0,0,,Karena kau tidak tahu apa-apa tentang sejarah\Nsebelum itu dan tragedi-tragedi tersebut.
Dialogue: 10,0:05:11.65,0:05:13.00,dialog,,0,0,0,,Tempat ini,
Dialogue: 10,0:05:13.00,0:05:17.96,dialog,,0,0,0,,pernah ada peradaban yang jauh lebih tua\Ndari "zaman kuno" suku manusia.
Dialogue: 10,0:05:18.55,0:05:19.70,dialog,,0,0,0,,"Toah"
Dialogue: 10,0:05:19.70,0:05:22.80,dialog,,0,0,0,,merujuk pada segala hal\Nyang ada di tanah ini.
Dialogue: 10,0:05:23.55,0:05:26.71,dialog,,0,0,0,,Semua bencana bermula dari sini.
Dialogue: 10,0:05:29.50,0:05:32.39,dialog,,0,0,0,,Seribu seratus sekian tahun yang lalu,
Dialogue: 10,0:05:32.39,0:05:36.00,dialog,,0,0,0,,wilayah tempat tinggal suku manusia terbagi\Nmenjadi tiga lapis.
Dialogue: 10,0:05:36.59,0:05:40.40,dialog,,0,0,0,,Lapisan langit dan lapisan atas\Ntempat tinggal rakyat Toah,
Dialogue: 10,0:05:40.40,0:05:44.23,dialog,,0,0,0,,serta lapisan bawah yang luas\Ntempat ras lain tinggal.
Dialogue: 10,0:05:45.10,0:05:46.90,dialog,,0,0,0,,Walaupun sekarang sudah berubah\Nmenjadi lautan,
Dialogue: 10,0:05:46.90,0:05:50.89,dialog,,0,0,0,,tetapi pusat Toah dulunya terletak\Ndi sebelah utara Solsein.
Dialogue: 10,0:06:02.25,0:06:06.59,dialog,,0,0,0,,Sepertinya aku harus memperluas\Nwilayah terlebih dahulu.
Dialogue: 10,0:06:07.95,0:06:11.10,dialog,,0,0,0,,Yang pertama kali melancarkan invasi\Nadalah Toah.
Dialogue: 10,0:06:11.70,0:06:14.20,dialog,,0,0,0,,Ingatan darah yang berlanjut\Nselama puluhan ribu tahun
Dialogue: 10,0:06:14.20,0:06:16.20,dialog,,0,0,0,,memberitahuku demikian.
Dialogue: 10,0:06:16.89,0:06:20.55,dialog,,0,0,0,,Kami mendapatkan wilayah\Nyang berbeda dari Toah.
Dialogue: 10,0:06:20.55,0:06:23.50,dialog,,0,0,0,,Menghabiskan waktu yang panjang barulah\Nakhirnya kami bisa memukul mundur mereka.
Dialogue: 10,0:06:24.15,0:06:29.40,dialog,,0,0,0,,Namun, mereka mengirimkan prajurit baru.
Dialogue: 10,0:06:29.40,0:06:33.46,dialog,,0,0,0,,Serangan mereka tidak lagi monoton\Nmengandalkan jumlah seperti dulu.
Dialogue: 10,0:06:33.46,0:06:37.20,dialog,,0,0,0,,Menggunakan taktik yang menggabungkan\Nilmu sihir dan ilmu pedang.
Dialogue: 10,0:06:37.20,0:06:41.89,dialog,,0,0,0,,Terutama niat membunuh dan ketakutan\Nyang tidak mereka tutupi itu,
Dialogue: 10,0:06:41.89,0:06:44.45,dialog,,0,0,0,,adalah sesuatu yang tidak dimiliki\Noleh suku manusia di masa lalu.
Dialogue: 10,0:06:45.19,0:06:47.59,dialog,,0,0,0,,Hei, bawakan obat! Cepat!
Dialogue: 10,0:06:47.59,0:06:48.79,dialog,,0,0,0,,Baik, Tuan "Pahlawan".
Dialogue: 10,0:06:49.79,0:06:51.15,dialog,,0,0,0,,Pahlawan?
Dialogue: 10,0:06:51.15,0:06:52.64,dialog,,0,0,0,,Hei, itu Raja Monster Sihir!
Dialogue: 10,0:06:52.65,0:06:54.45,dialog,,0,0,0,,Raja Monster Sihir telah muncul!
Dialogue: 10,0:06:54.45,0:06:56.25,dialog,,0,0,0,,Kita malah sangat beruntung.
Dialogue: 10,0:06:56.25,0:06:58.84,dialog,,0,0,0,,Siapkan formasi, buka lingkaran sihir.
Dialogue: 10,0:06:58.84,0:07:00.44,dialog,,0,0,0,,Budak, maju ke depan!
Dialogue: 10,0:07:00.44,0:07:02.15,dialog,,0,0,0,,Sihir tingkat ekstrem.
Dialogue: 10,0:07:02.15,0:07:04.59,dialog,,0,0,0,,Tornado Pedang Kegelapan.
Dialogue: 10,0:07:09.50,0:07:10.85,dialog,,0,0,0,,Apakah berhasil?
Dialogue: 10,0:07:24.99,0:07:26.40,dialog,,0,0,0,,Ini…
Dialogue: 10,0:07:27.15,0:07:28.80,dialog,,0,0,0,,Cangkang kosong?
Dialogue: 10,0:07:30.85,0:07:36.40,dialog,,0,0,0,,Sepertinya aku perlu menyelidiki eksistensi\Nmacam apa sebenarnya "pahlawan" itu.
Dialogue: 10,0:07:45.89,0:07:49.10,dialog,,0,0,0,,Untuk sementara, aku akan bertindak\Nmenggunakan tubuh ini.
Dialogue: 10,0:07:51.20,0:07:54.25,dialog,,0,0,0,,Eksistensi bernama "pahlawan" ini
Dialogue: 10,0:07:54.25,0:07:56.00,dialog,,0,0,0,,sama seperti monster sihir tingkat tinggi.
Dialogue: 10,0:07:56.00,0:07:58.70,dialog,,0,0,0,,Meskipun mati, akan bangkit kembali.
Dialogue: 10,0:07:59.10,0:08:01.95,dialog,,0,0,0,,Oleh karena itu,\Nmereka bisa sebegitu ceroboh dan gilanya.
Dialogue: 10,0:08:02.50,0:08:06.80,dialog,,0,0,0,,Darah mereka juga berubah jadi bijih sihir,\Nsama seperti monster sihir.
Dialogue: 10,0:08:07.35,0:08:08.65,dialog,,0,0,0,,Toah yang terkutuk itu
Dialogue: 10,0:08:09.05,0:08:11.95,dialog,,0,0,0,,meniru kita tanpa batas, ya?
Dialogue: 10,0:08:12.94,0:08:15.75,dialog,,0,0,0,,Asalkan bisa tiba di sana saja sudah cukup,\Ntetapi…
Dialogue: 10,0:08:16.26,0:08:20.65,dialog,,0,0,0,,Makin besar sihir yang dimiliki,\Nmakin mudah terpengaruh oleh wilayah.
Dialogue: 10,0:08:20.65,0:08:24.80,dialog,,0,0,0,,Apa aku tetap harus perlahan\Nmencari informasinya?
Dialogue: 10,0:08:32.10,0:08:33.48,dialog,,0,0,0,,Pahlawan?
Dialogue: 10,0:08:34.10,0:08:37.98,dialog,,0,0,0,,Tidak ada rasa permusuhan\Natau kewaspadaan sama sekali.
Dialogue: 10,0:08:39.60,0:08:42.70,dialog,,0,0,0,,Hei, kau yang di sana! Sedang apa?
Dialogue: 10,0:08:43.50,0:08:44.69,dialog,,0,0,0,,Aku?
Dialogue: 10,0:08:44.69,0:08:46.80,dialog,,0,0,0,,Siapa lagi kalau bukan kau?
Dialogue: 10,0:08:47.19,0:08:50.05,dialog,,0,0,0,,Biasanya hampir tidak ada\Nyang mengajakku bicara.
Dialogue: 10,0:08:50.05,0:08:52.10,dialog,,0,0,0,,Karena aku selalu merasa terasing.
Dialogue: 10,0:08:52.75,0:08:53.75,dialog,,0,0,0,,Siapa kau?
Dialogue: 10,0:08:54.55,0:08:55.55,dialog,,0,0,0,,Vod.
Dialogue: 10,0:08:56.05,0:08:58.75,dialog,,0,0,0,,Vod, nama yang sangat bagus.
Dialogue: 10,0:08:59.65,0:09:01.05,dialog,,0,0,0,,Aku Write.
Dialogue: 10,0:09:01.05,0:09:03.35,dialog,,0,0,0,,Karena aku hidup dari menulis,\Nmakanya aku menyebut diriku demikian.
Dialogue: 10,0:09:04.10,0:09:05.48,dialog,,0,0,0,,Write…
Dialogue: 10,0:09:06.10,0:09:07.90,dialog,,0,0,0,,Pria ini,
Dialogue: 10,0:09:07.90,0:09:12.30,dialog,,0,0,0,,di antara para pahlawan yang pernah kutemui,\Ndialah yang terkuat.
Dialogue: 10,0:09:12.70,0:09:14.85,dialog,,0,0,0,,Sekarang aku berkelana sambil
Dialogue: 10,0:09:14.85,0:09:16.90,dialog,,0,0,0,,merancang buku yang akan kutulis.
Dialogue: 10,0:09:17.30,0:09:18.30,dialog,,0,0,0,,Buku?
Dialogue: 10,0:09:18.30,0:09:21.45,dialog,,0,0,0,,Dunia ini sama sekali\Ntidak punya bacaan hiburan.
Dialogue: 10,0:09:21.45,0:09:22.85,dialog,,0,0,0,,Jadi aku ingin menulisnya sendiri,
Dialogue: 10,0:09:23.25,0:09:26.65,dialog,,0,0,0,,menulis buku yang menarik\Nseperti di duniaku yang asli.
Dialogue: 10,0:09:27.15,0:09:29.05,dialog,,0,0,0,,Duniamu yang asli?
Dialogue: 10,0:09:30.25,0:09:32.99,dialog,,0,0,0,,Tentu saja permintaan Toah\Ntetap akan kuselesaikan.
Dialogue: 10,0:09:32.99,0:09:34.90,dialog,,0,0,0,,Namun, mengesampingkan hal itu,
Dialogue: 10,0:09:34.90,0:09:36.60,dialog,,0,0,0,,aku ingin memberikan pada orang-orang\Nyang ditindas oleh Toah,
Dialogue: 10,0:09:36.60,0:09:41.05,dialog,,0,0,0,,orang-orang kelas lapisan bawah\Ndijadikan budak pahlawan, sedikit impian.
Dialogue: 10,0:09:41.49,0:09:44.84,dialog,,0,0,0,,Kalau tidak, mereka terlihat seperti\Nbahkan telah kehilangan emosi.
Dialogue: 10,0:09:44.84,0:09:46.75,dialog,,0,0,0,,Benar-benar sangat kasihan.
Dialogue: 10,0:09:47.65,0:09:49.15,dialog,,0,0,0,,Tidakkah kau berpikir begitu?
Dialogue: 10,0:09:53.05,0:09:55.80,dialog,,0,0,0,,Kau adalah orang pertama\Nyang setuju denganku.
Dialogue: 10,0:09:55.80,0:09:57.56,dialog,,0,0,0,,Lagi pula, semua orang sedang sibuk\Nmengurus diri mereka sendiri.
Dialogue: 10,0:09:58.30,0:10:01.00,dialog,,0,0,0,,Apa permintaan "Toah" itu?
Dialogue: 10,0:10:02.30,0:10:05.50,dialog,,0,0,0,,Yaitu menggunakan keterampilanku,\N"Pustakawan" dan "Penyihir Agung",
Dialogue: 10,0:10:05.50,0:10:08.20,dialog,,0,0,0,,untuk menulis buku panduan sihir\Nyang bisa membimbing para pahlawan.
Dialogue: 10,0:10:09.95,0:10:13.15,dialog,,0,0,0,,"Pustakawan" dapat menyegel\Nkekuatan wilayah ke dalam buku.
Dialogue: 10,0:10:13.15,0:10:15.55,dialog,,0,0,0,,Sementara "Penyihir Agung"\Nadalah kekuatan pemandu…
Dialogue: 10,0:10:15.55,0:10:16.40,dialog,,0,0,0,,Singkatnya,
Dialogue: 10,0:10:16.40,0:10:18.91,dialog,,0,0,0,,membuat orang-orang percaya\Npada isi yang kutulis.
Dialogue: 10,0:10:19.65,0:10:21.39,dialog,,0,0,0,,Buku panduan sihir yang kutulis,
Dialogue: 10,0:10:21.39,0:10:25.40,dialog,,0,0,0,,akan menjadi cerita yang terwujud\Nmelalui tangan orang-orang di dunia ini.
Dialogue: 10,0:10:26.46,0:10:28.05,dialog,,0,0,0,,Tanggung jawabku besar sekali.
Dialogue: 10,0:10:29.20,0:10:31.65,dialog,,0,0,0,,Niat Toah bisa kupahami.
Dialogue: 10,0:10:31.65,0:10:36.74,dialog,,0,0,0,,Mereka ingin mengurus pahlawan panggilan\Nyang lepas kendali.
Dialogue: 10,0:10:37.45,0:10:40.75,dialog,,0,0,0,,"Kalahkan Raja Monster Sihir\Nmaka bisa kembali ke dunia asal".
Dialogue: 10,0:10:40.75,0:10:41.89,dialog,,0,0,0,,Mengatakan hal seperti itu,
Dialogue: 10,0:10:41.89,0:10:44.44,dialog,,0,0,0,,bagi kami itu adalah ancaman.
Dialogue: 10,0:10:44.45,0:10:46.76,dialog,,0,0,0,,Mana mungkin kami bertarung\Ndengan sepenuh hati.
Dialogue: 10,0:10:47.34,0:10:51.85,dialog,,0,0,0,,Karena kami tidak bisa mati dan tidak punya\Ntujuan lain, makanya kami terus bertarung.
Dialogue: 10,0:10:51.85,0:10:54.39,dialog,,0,0,0,,Namun, untuk monster sihir\Nyang terbunuh karena itu,
Dialogue: 10,0:10:54.39,0:10:56.00,dialog,,0,0,0,,aku benar-benar merasa bersalah.
Dialogue: 10,0:10:56.99,0:11:00.70,dialog,,0,0,0,,Toah kurang memiliki emosi dan imajinasi.
Dialogue: 10,0:11:01.15,0:11:03.73,dialog,,0,0,0,,Saat menerima misi, aku juga pernah\Nbertemu orang-orang Toah di langit.
Dialogue: 10,0:11:04.35,0:11:06.25,dialog,,0,0,0,,Hanya dengan mereka yang seperti itu,\Nmustahil.
Dialogue: 10,0:11:06.25,0:11:08.65,dialog,,0,0,0,,Sama sekali tidak ada rasa kemanusiaan.
Dialogue: 10,0:11:09.74,0:11:12.55,dialog,,0,0,0,,Justru karena itulah\Naku harus berusaha keras.
Dialogue: 10,0:11:13.55,0:11:17.20,dialog,,0,0,0,,Begitu buku panduan sihir selesai,\Nsemua orang akan bisa menjadi lebih kuat,
Dialogue: 10,0:11:17.20,0:11:19.65,dialog,,0,0,0,,dan dunia manusia pasti akan lebih baik.
Dialogue: 10,0:11:21.10,0:11:23.65,dialog,,0,0,0,,Pria ini terlalu berbahaya.
Dialogue: 10,0:11:23.65,0:11:26.15,dialog,,0,0,0,,Aku harus menaklukkannya di sini.
Dialogue: 10,0:11:28.45,0:11:29.15,dialog,,0,0,0,,Eh?
Dialogue: 10,0:11:29.15,0:11:31.40,dialog,,0,0,0,,Kenapa tanpa sadar aku bicara sebanyak ini?
Dialogue: 10,0:11:31.80,0:11:33.90,dialog,,0,0,0,,Padahal aku belum pernah membicarakannya\Ndengan orang lain.
Dialogue: 10,0:11:37.30,0:11:39.20,dialog,,0,0,0,,Mungkin karena lawan bicaranya adalah kau.
Dialogue: 10,0:11:40.45,0:11:42.85,dialog,,0,0,0,,Entah mengapa aku merasa bisa\Nmembicarakan apa saja denganmu.
Dialogue: 10,0:11:44.75,0:11:45.95,dialog,,0,0,0,,Bagaimana menggambarkannya, ya?
Dialogue: 10,0:11:45.95,0:11:48.35,dialog,,0,0,0,,Ada semacam perasaan seperti\Nroda gigi yang saling terhubung.
Dialogue: 10,0:11:49.50,0:11:51.60,dialog,,0,0,0,,Oh iya, Vod, apakah kau mau ikut denganku?
Dialogue: 10,0:11:52.10,0:11:54.70,dialog,,0,0,0,,Kalau ada pendengar,\Nproses pengerjaanku juga akan lebih lancar.
Dialogue: 10,0:11:55.10,0:11:56.19,dialog,,0,0,0,,Boleh, tidak?
Dialogue: 10,0:11:57.24,0:11:58.40,dialog,,0,0,0,,Baiklah kalau begitu.
Dialogue: 10,0:11:58.80,0:12:00.30,dialog,,0,0,0,,Bagus sekali.
Dialogue: 10,0:12:00.30,0:12:04.75,dialog,,0,0,0,,Dengan begini aku bisa korek lebih banyak\Ninformasi tentang Toah dari mulut pria ini.
Dialogue: 10,0:12:04.75,0:12:08.55,dialog,,0,0,0,,Tidak akan terlambat\Nuntuk berurusan dengannya setelah itu.
Dialogue: 10,0:12:21.50,0:12:24.15,dialog,,0,0,0,,Aku memberi judul "Warisan Pahlawan".
Dialogue: 10,0:12:24.15,0:12:25.75,dialog,,0,0,0,,Singkat dan jelas, bagus bukan?
Dialogue: 10,0:12:36.40,0:12:38.85,dialog,,0,0,0,,Akhir-akhir ini\Npara pahlawan makin lepas kendali.
Dialogue: 10,0:12:38.85,0:12:40.85,dialog,,0,0,0,,Bukan hanya saling membunuh\Nantarsesama kawan,
Dialogue: 10,0:12:40.86,0:12:43.31,dialog,,0,0,0,,mereka juga melakukan kekerasan\Nterhadap perempuan lapisan bawah.
Dialogue: 10,0:12:43.70,0:12:45.85,dialog,,0,0,0,,Orang-orang Toah semuanya menutup mata.
Dialogue: 10,0:12:46.25,0:12:48.57,dialog,,0,0,0,,Lebih tepatnya mereka tidak sadar\Nbahwa itu adalah sebuah dosa.
Dialogue: 10,0:12:49.15,0:12:50.90,dialog,,0,0,0,,Sekalipun mereka memenangkan pertempuran ini,
Dialogue: 10,0:12:50.90,0:12:53.20,dialog,,0,0,0,,dunia hanya akan menjadi makin buruk.
Dialogue: 10,0:12:53.90,0:12:56.80,dialog,,0,0,0,,Apakah benar-benar tidak apa-apa\Naku terus menulis buku?
Dialogue: 10,0:12:58.35,0:13:02.10,dialog,,0,0,0,,Tidak boleh,\Ntubuh ini diberikan oleh Toah padaku.
Dialogue: 10,0:13:02.10,0:13:04.46,dialog,,0,0,0,,Aku tidak seharusnya\Nmengatakan hal seperti itu.
Dialogue: 10,0:13:06.60,0:13:08.00,dialog,,0,0,0,,Kalau bertentangan dengan kehendak Toah,
Dialogue: 10,0:13:08.00,0:13:09.96,dialog,,0,0,0,,aku mungkin akan dipaksa mundur.
Dialogue: 10,0:13:10.80,0:13:12.90,dialog,,0,0,0,,Padahal bukunya sudah hampir selesai ditulis.
Dialogue: 10,0:13:16.90,0:13:18.25,dialog,,0,0,0,,Oh ya, Vod.
Dialogue: 10,0:13:18.26,0:13:19.25,dialog,,0,0,0,,Ada apa?
Dialogue: 10,0:13:19.65,0:13:21.40,dialog,,0,0,0,,Kita sudah bertindak bersama-sama\Nselama setahun.
Dialogue: 10,0:13:21.40,0:13:24.50,dialog,,0,0,0,,Kuharap setidaknya kau bisa memercayaiku.
Dialogue: 10,0:13:26.16,0:13:27.35,dialog,,0,0,0,,Bagaimana menurutmu?
Dialogue: 10,0:13:29.06,0:13:29.54,dialog,,0,0,0,,Ya.
Dialogue: 10,0:13:31.59,0:13:32.90,dialog,,0,0,0,,Syukurlah.
Dialogue: 10,0:13:32.90,0:13:35.35,dialog,,0,0,0,,Mendengar perkataanmu itu,\Naku tidak punya alasan lagi untuk ragu.
Dialogue: 10,0:13:35.35,0:13:36.64,dialog,,0,0,0,,Aku pasti bisa menyelesaikan\Ntulisannya dengan lancar.
Dialogue: 10,0:13:37.75,0:13:40.35,dialog,,0,0,0,,Menyelesaikan buku yang akan membuat\Ndunia menjadi lebih baik ini.
Dialogue: 10,0:13:41.59,0:13:44.25,dialog,,0,0,0,,Write memiliki permusuhan terhadap Toah.
Dialogue: 10,0:13:44.95,0:13:48.54,dialog,,0,0,0,,Namun, anehnya dia tidak menunjukkan\Npermusuhan pada monster sihir.
Dialogue: 10,0:13:49.36,0:13:53.26,dialog,,0,0,0,,Setidaknya mari kita tunggu\Nsampai bukunya selesai.
Dialogue: 10,0:13:54.60,0:13:57.30,dialog,,0,0,0,,Namun, setelah itu, empat tahun berlalu,
Dialogue: 10,0:13:57.69,0:14:00.70,dialog,,0,0,0,,Write tidak pernah muncul lagi.
Dialogue: 10,0:14:03.65,0:14:07.52,dialog,,0,0,0,,Akhir-akhir ini, wilayahku mulai tertekan.
Dialogue: 10,0:14:08.25,0:14:10.45,dialog,,0,0,0,,Bilah pedang merah menyala.
Dialogue: 10,0:14:11.10,0:14:12.55,dialog,,0,0,0,,Mungkinkah…
Dialogue: 10,0:14:12.55,0:14:16.94,dialog,,0,0,0,,"Warisan Pahlawan" sudah mulai beroperasi?
Dialogue: 10,0:14:16.94,0:14:21.10,dialog,,0,0,0,,Sepertinya saat itu\Naku tidak seharusnya melepaskannya.
Dialogue: 10,0:14:21.50,0:14:22.91,dialog,,0,0,0,,Write.
Dialogue: 10,0:14:32.00,0:14:33.44,dialog,,0,0,0,,Hai, Vod.
Dialogue: 10,0:14:34.40,0:14:36.21,dialog,,0,0,0,,Kau bisa mengenaliku?
Dialogue: 10,0:14:36.60,0:14:38.90,dialog,,0,0,0,,Lagi pula, kita sudah bepergian\Nbersama selama satu tahun.
Dialogue: 10,0:14:38.90,0:14:40.95,dialog,,0,0,0,,Hanya dari auramu saja aku bisa mengenalimu.
Dialogue: 10,0:14:41.35,0:14:44.89,dialog,,0,0,0,,Aku selalu samar-samar merasa\Nbahwa kau mungkin bukan manusia.
Dialogue: 10,0:14:44.89,0:14:46.94,dialog,,0,0,0,,"Warisan Pahlawan",
Dialogue: 10,0:14:46.95,0:14:53.40,dialog,,0,0,0,,bukankah buku itu untuk memperbaiki\Ndunia yang dirusak Toah?
Dialogue: 10,0:14:53.40,0:14:56.50,dialog,,0,0,0,,Salah, itu kutulis agar manusia\Nbisa mengalahkan Raja Monster Sihir
Dialogue: 10,0:14:56.50,0:14:58.89,dialog,,0,0,0,,dan kemudian memperluas dunia.
Dialogue: 10,0:14:59.45,0:15:03.35,dialog,,0,0,0,,Pahlawan pasti akan menjadi kuat,\Ncukup kuat untuk mengalahkanmu.
Dialogue: 10,0:15:05.15,0:15:06.46,dialog,,0,0,0,,Write.
Dialogue: 10,0:15:06.85,0:15:08.75,dialog,,0,0,0,,Apakah kau tidak rela, Vod?
Dialogue: 10,0:15:09.15,0:15:10.56,dialog,,0,0,0,,Kalau begitu, datanglah kemari.
Dialogue: 10,0:15:11.35,0:15:13.60,dialog,,0,0,0,,Aku menunggumu di "Ruang Audiensi".
Dialogue: 10,0:15:13.60,0:15:15.40,dialog,,0,0,0,,Tempat itu dirancang olehku.
Dialogue: 10,0:15:16.06,0:15:19.25,dialog,,0,0,0,,Kau harus mengalahkan pahlawan\Nyang menghalangi jalanmu lebih dulu.
Dialogue: 10,0:15:20.35,0:15:21.06,dialog,,0,0,0,,Teleportasi.
Dialogue: 10,0:15:24.40,0:15:27.20,dialog,,0,0,0,,Semua bawahan, berkumpul!
Dialogue: 10,0:15:27.20,0:15:29.45,dialog,,0,0,0,,Selanjutnya, tanpa jalan mundur,
Dialogue: 10,0:15:29.45,0:15:32.94,dialog,,0,0,0,,perluas wilayah dan maju menyerang!
Dialogue: 10,0:15:32.95,0:15:37.50,dialog,,0,0,0,,Musnahkan semua rakyat Toah\Ndan para pahlawan.
Dialogue: 10,0:15:39.05,0:15:41.95,dialog,,0,0,0,,Penyerangan hari ke-25.
Dialogue: 10,0:15:41.95,0:15:45.85,dialog,,0,0,0,,Kami monster sihir bisa tiba di sini\Ndengan pengorbanan yang tidak terhitung.
Dialogue: 10,0:15:45.85,0:15:49.25,dialog,,0,0,0,,Rathwell dan Clevatess\Nsepertinya telah ditaklukkan.
Dialogue: 10,0:15:49.69,0:15:52.70,dialog,,0,0,0,,Namun, monster sihir utara kami
Dialogue: 10,0:15:52.70,0:15:54.64,dialog,,0,0,0,,berhasil menerobos rintangan para pahlawan
Dialogue: 10,0:15:54.64,0:15:57.35,dialog,,0,0,0,,dan akhirnya tiba di sini.
Dialogue: 10,0:15:57.35,0:16:00.20,dialog,,0,0,0,,Tepatnya di pusat wilayah Toah.
Dialogue: 10,0:16:02.09,0:16:05.19,dialog,,0,0,0,,Sama sekali tidak merasakan\Naura pelindung penghalang.
Dialogue: 10,0:16:08.20,0:16:09.90,dialog,,0,0,0,,Lapisan langit…
Dialogue: 10,0:16:10.55,0:16:14.05,dialog,,0,0,0,,Secara logika,\Nini adalah jantung wilayah Toah.
Dialogue: 10,0:16:21.95,0:16:23.55,dialog,,0,0,0,,Write.
Dialogue: 10,0:16:31.55,0:16:32.40,dialog,,0,0,0,,Maaf.
Dialogue: 10,0:16:32.40,0:16:36.15,dialog,,0,0,0,,Aku mengatur tempat ini agar hanya\Nbisa dimasuki dalam wujud manusia.
Dialogue: 10,0:16:36.15,0:16:38.80,dialog,,0,0,0,,Karena aku ingin bicara padamu\Ndi ketinggian yang sama.
Dialogue: 10,0:16:45.49,0:16:47.05,dialog,,0,0,0,,Wajah ini sungguh membuat rindu.
Dialogue: 10,0:16:48.39,0:16:50.70,dialog,,0,0,0,,Wujudmu yang ini memang lebih mudah\Nuntuk diajak bicara.
Dialogue: 10,0:16:51.30,0:16:54.60,dialog,,0,0,0,,Write, apa yang terjadi pada tanah ini?
Dialogue: 10,0:16:55.85,0:16:56.95,dialog,,0,0,0,,Maksudmu di sini?
Dialogue: 10,0:16:57.60,0:16:59.45,dialog,,0,0,0,,Aku telah membunuh semua orang.
Dialogue: 10,0:17:01.15,0:17:03.35,dialog,,0,0,0,,Eh, apakah kau tidak senang?
Dialogue: 10,0:17:03.75,0:17:05.45,dialog,,0,0,0,,Bukankah ini harapan kalian sejak lama?
Dialogue: 10,0:17:05.45,0:17:07.95,dialog,,0,0,0,,Kalau sedari awal kau sudah\Nberniat memusnahkan mereka,
Dialogue: 10,0:17:07.95,0:17:10.60,dialog,,0,0,0,,kenapa tidak mengatakannya\Ndengan jelas sejak awal?
Dialogue: 10,0:17:11.05,0:17:14.80,dialog,,0,0,0,,Di duniaku yang asli, ada sebuah pepatah.
Dialogue: 10,0:17:15.30,0:17:18.26,dialog,,0,0,0,,"Untuk menipu musuh, kau harus mengelabui\Norangmu sendiri terlebih dahulu."
Dialogue: 10,0:17:19.05,0:17:22.39,dialog,,0,0,0,,"Warisan Pahlawan" yang kutulis\Nterbagi menjadi lima bab.
Dialogue: 10,0:17:22.39,0:17:26.27,dialog,,0,0,0,,Isinya sebenarnya adalah untuk meningkatkan\Nkekuatan pahlawan hingga batas maksimal.
Dialogue: 10,0:17:26.75,0:17:29.54,dialog,,0,0,0,,Jadi setiap kali menyelesaikan satu bab,
Dialogue: 10,0:17:29.55,0:17:32.27,dialog,,0,0,0,,aku akan mendapatkan hak akses\Nuntuk membangun satu tempat suci.
Dialogue: 10,0:17:32.80,0:17:34.84,dialog,,0,0,0,,"Ruang Audiensi" ini
Dialogue: 10,0:17:34.85,0:17:38.59,dialog,,0,0,0,,berada tepat di atas sumber air Toah,\Ntempat suci di bab keempat.
Dialogue: 10,0:17:38.59,0:17:40.65,dialog,,0,0,0,,Aku memungkinkan pahlawan untuk\Nberbicara dengan orang langit Toah,
Dialogue: 10,0:17:40.65,0:17:43.19,dialog,,0,0,0,,dan juga membuat mereka\Nbisa meningkatkan level.
Dialogue: 10,0:17:43.19,0:17:46.30,dialog,,0,0,0,,Aku membujuk mereka dengan alasan\N"hal ini bisa lebih membangkitkan motivasi".
Dialogue: 10,0:17:47.05,0:17:49.55,dialog,,0,0,0,,Orang Toah pun tertipu olehku\Ntanpa curiga sedikit pun.
Dialogue: 10,0:17:50.40,0:17:52.25,dialog,,0,0,0,,Lagi pula,\Ndi sekelilingnya adalah lautan awan,
Dialogue: 10,0:17:52.25,0:17:54.49,dialog,,0,0,0,,dan pahlawan tidak bisa masuk\Nselain lewat gerbang suci.
Dialogue: 10,0:17:54.49,0:17:56.20,dialog,,0,0,0,,Mungkin itu sebabnya orang Toah lengah.
Dialogue: 10,0:17:56.75,0:18:00.30,dialog,,0,0,0,,Aku membubarkan lautan awan\Ndan juga menonaktifkan penghalang.
Dialogue: 10,0:18:00.30,0:18:04.65,dialog,,0,0,0,,Membiarkan rakyat Toah yang tidak bersenjata\Nterekspos di hadapan para pahlawan.
Dialogue: 10,0:18:04.65,0:18:08.55,dialog,,0,0,0,,Orang Toah tidak punya hati,\Nmungkin mereka tidak menyadarinya.
Dialogue: 10,0:18:08.55,0:18:11.00,dialog,,0,0,0,,Para pahlawan yang dibawa\Nke dunia ini secara paksa,
Dialogue: 10,0:18:11.00,0:18:12.89,dialog,,0,0,0,,berkali-kali merasakan kematian,
Dialogue: 10,0:18:12.90,0:18:15.31,dialog,,0,0,0,,kemarahan itu sudah mengakar kuat.
Dialogue: 10,0:18:15.95,0:18:17.95,dialog,,0,0,0,,Pemandangannya benar-benar\Ntragis layaknya neraka.
Dialogue: 10,0:18:18.45,0:18:21.90,dialog,,0,0,0,,Setelah para pahlawan\Nmemusnahkan rakyat Toah,
Dialogue: 10,0:18:22.29,0:18:24.57,dialog,,0,0,0,,mereka hanya berdiri diam di tempat.
Dialogue: 10,0:18:24.99,0:18:27.80,dialog,,0,0,0,,Wajah mereka penuh darah,\Nmenatap ke arah langit.
Dialogue: 10,0:18:27.80,0:18:30.08,dialog,,0,0,0,,Entah ke mana mereka memandang.
Dialogue: 10,0:18:30.50,0:18:32.70,dialog,,0,0,0,,Ekspresi itu tidak akan bisa\Nkulupakan hingga saat ini.
Dialogue: 10,0:18:33.40,0:18:35.10,dialog,,0,0,0,,Lalu mereka berkata,
Dialogue: 10,0:18:36.25,0:18:38.55,dialog,,0,0,0,,"Biar aku mati saja."
Dialogue: 10,0:18:40.85,0:18:44.45,dialog,,0,0,0,,Itu berarti mereka lebih memilih mati\Ndaripada bangkit kembali.
Dialogue: 10,0:18:45.00,0:18:46.90,dialog,,0,0,0,,Maka aku mengabulkan keinginan mereka.
Dialogue: 10,0:18:47.85,0:18:52.05,dialog,,0,0,0,,Aku menusuk Buku "Kuil" ini yang menyatu
Dialogue: 10,0:18:52.05,0:18:53.65,dialog,,0,0,0,,dengan sistem kebangkitan pahlawan,
Dialogue: 10,0:18:54.49,0:18:56.45,dialog,,0,0,0,,tepat di hadapan mereka
Dialogue: 10,0:18:56.45,0:18:58.45,dialog,,0,0,0,,bersamaan dengan jantungku sendiri.
Dialogue: 10,0:19:00.10,0:19:03.40,dialog,,0,0,0,,Semua orang meniru jejakku dan bunuh diri.
Dialogue: 10,0:19:04.95,0:19:07.46,dialog,,0,0,0,,Kalau ini dicabut, aku juga akan mati.
Dialogue: 10,0:19:08.65,0:19:09.89,dialog,,0,0,0,,Write.
Dialogue: 10,0:19:09.89,0:19:12.00,dialog,,0,0,0,,Aku belum mencabutnya
Dialogue: 10,0:19:12.00,0:19:13.60,dialog,,0,0,0,,karena aku ingin melihatmu\Nuntuk terakhir kalinya.
Dialogue: 10,0:19:14.45,0:19:17.00,dialog,,0,0,0,,Karena aku ingin\Nmengatakannya langsung padamu.
Dialogue: 10,0:19:22.50,0:19:26.19,dialog,,0,0,0,,Namun, segalanya belum berakhir, Vod.
Dialogue: 10,0:19:27.15,0:19:29.85,dialog,,0,0,0,,Ceritanya baru akan dimulai sekarang.
Dialogue: 10,0:19:30.80,0:19:33.90,dialog,,0,0,0,,Untuk mengalahkan\Napa yang tidak bisa kami jatuhkan…
Dialogue: 10,0:19:34.60,0:19:36.44,dialog,,0,0,0,,Kisah Toah yang abadi
Dialogue: 10,0:19:36.45,0:19:38.90,dialog,,0,0,0,,baru akan dimulai.
Dialogue: 10,0:19:39.29,0:19:42.36,dialog,,0,0,0,,Bukankah Toah telah kau hancurkan\Ndengan tanganmu sendiri?
Dialogue: 10,0:19:42.36,0:19:43.96,dialog,,0,0,0,,Ini baru prolognya.
Dialogue: 10,0:19:44.65,0:19:46.75,dialog,,0,0,0,,Aku telah menabur benihnya.
Dialogue: 10,0:19:47.55,0:19:50.05,dialog,,0,0,0,,Di saat benih itu berbunga dan berbuah…
Dialogue: 10,0:19:56.45,0:19:58.95,dialog,,0,0,0,,Aku tidak akan membiarkanmu mati, Write.
Dialogue: 10,0:19:58.95,0:20:01.00,dialog,,0,0,0,,Aku akan menghentikan pendarahanmu\Ndengan apiku…
Dialogue: 10,0:20:11.94,0:20:13.26,dialog,,0,0,0,,Kalau terus begini,
Dialogue: 10,0:20:13.26,0:20:15.60,dialog,,0,0,0,,bawahanku di bawah juga akan dalam bahaya.
Dialogue: 10,0:20:15.60,0:20:16.84,dialog,,0,0,0,,Aku harus pergi.
Dialogue: 10,0:20:19.20,0:20:22.20,dialog,,0,0,0,,Di balik pintu itu tidak ada getaran.
Dialogue: 10,0:20:29.80,0:20:33.33,dialog,,0,0,0,,Inilah kebenaran\Ndari seribu seratus sekian tahun yang lalu.
Dialogue: 10,0:21:02.55,0:21:04.15,dialog,,0,0,0,,Daya tembak yang hebat!
Dialogue: 10,0:21:04.55,0:21:09.81,dialog,,0,0,0,,Zavtier pernah bilang, pahlawan\Nyang berevolusi sempurna akan melampaui itu.
Dialogue: 10,0:21:10.29,0:21:13.40,dialog,,0,0,0,,Jika lebih kuat dari itu, seberapa kuatkah\Npahlawan yang berevolusi sempurna?
Dialogue: 10,0:21:23.54,0:21:26.39,dialog,,0,0,0,,Write pernah bilang Toah itu "abadi".
Dialogue: 10,0:21:27.16,0:21:30.29,dialog,,0,0,0,,Kenyataannya,\Nmeskipun seluruh rakyat Toah punah
Dialogue: 10,0:21:30.30,0:21:32.55,dialog,,0,0,0,,dan bahkan tenggelam ke dasar laut,
Dialogue: 10,0:21:32.95,0:21:35.50,dialog,,0,0,0,,wilayah tersebut tetap tidak menghilang.
Dialogue: 10,0:21:36.70,0:21:38.79,dialog,,0,0,0,,Sekumpulan orang itu benar-benar licik,
Dialogue: 10,0:21:38.79,0:21:42.10,dialog,,0,0,0,,mereka malah bersembunyi di bawah tanah\Nyang lebih dalam dari dasar laut.
Dialogue: 10,0:21:43.30,0:21:45.30,dialog,,0,0,0,,Sebenarnya apa Toah itu?
Dialogue: 10,0:21:45.30,0:21:47.36,dialog,,0,0,0,,Apa yang harus dilakukan agar bisa menang?
Dialogue: 10,0:21:48.10,0:21:49.40,dialog,,0,0,0,,Membosankan…
Dialogue: 10,0:21:51.15,0:21:53.75,dialog,,0,0,0,,Benar-benar sangat membosankan.
Dialogue: 10,0:21:54.34,0:21:59.30,dialog,,0,0,0,,Sekarang ini\NWrite sedang dalam proses kebangkitan.
Dialogue: 10,0:21:59.30,0:22:01.00,dialog,,0,0,0,,Clevatess,
Dialogue: 10,0:22:01.00,0:22:04.00,dialog,,0,0,0,,kau tidak seharusnya muncul di sini.
