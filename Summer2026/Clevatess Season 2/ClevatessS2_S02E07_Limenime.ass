Dialogue: 0,0:02:27.00,0:02:30.99,sign,,0000,0000,0000,,EPISODE 7:\NDUNIA PERMUKAAN DAN DUNIA TERSEMBUNYI
Dialogue: 0,0:07:39.59,0:07:42.35,sign,,0000,0000,0000,,IBU KOTA BOELATE, BARESS
Dialogue: 0,0:08:04.11,0:08:06.13,sign,,0000,0000,0000,,IBU KOTA ESLINN, ESLINNEBERG
Dialogue: 0,0:11:12.97,0:11:15.24,sign,,0000,0000,0000,,14 TAHUN YANG LALU
Dialogue: 0,0:00:11.50,0:00:12.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Zefeld".
Dialogue: 0,0:00:18.45,0:00:19.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makhluk itu memutar ke sana!
Dialogue: 0,0:00:20.80,0:00:22.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, makhluk itu ada di sini!
Dialogue: 0,0:00:24.50,0:00:26.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuai perintah Kaisar,
Dialogue: 0,0:00:26.00,0:00:29.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jika ada pergerakan apa pun,\Nkita harus segera mengerahkan pasukan.
Dialogue: 0,0:00:29.49,0:00:31.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah ini bisa dianggap sebagai pergerakan?
Dialogue: 0,0:00:31.79,0:00:33.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru, bagaimana menurutmu?
Dialogue: 0,0:00:33.20,0:00:34.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah, jangan panggil aku guru.
Dialogue: 0,0:00:34.95,0:00:38.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, bukankah kau menyamar\Ndi akademi ini sebagai guru?
Dialogue: 0,0:00:38.75,0:00:39.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau tidak pergi ke sana?
Dialogue: 0,0:00:40.65,0:00:42.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih perlu ditanya?
Dialogue: 0,0:00:44.20,0:00:47.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sama sekali tidak punya bakat\Nmenjadi guru.
Dialogue: 0,0:00:47.19,0:00:49.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa melihatnya sendiri, 'kan?
Dialogue: 0,0:00:49.40,0:00:51.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, aku cukup menjadi orang luar saja.
Dialogue: 0,0:00:52.25,0:00:54.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum waktunya untuk\Nseorang pencuri beraksi.
Dialogue: 0,0:02:24.93,0:02:27.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Clevatess Ⅱ
Dialogue: 0,0:02:35.65,0:02:37.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Klen ada di sana.
Dialogue: 0,0:02:37.45,0:02:39.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku terbang ke Menara Hitam sekarang,
Dialogue: 0,0:02:39.39,0:02:41.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak akan bisa menggali informasi.
Dialogue: 0,0:02:41.59,0:02:42.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kita harus mendarat.
Dialogue: 0,0:02:42.85,0:02:44.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu.
Dialogue: 0,0:02:44.65,0:02:47.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, aku bukan bawahan Clevatess.
Dialogue: 0,0:02:54.34,0:02:56.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa mengerti\Napa yang orang ini katakan.
Dialogue: 0,0:02:56.60,0:02:57.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku yang membantu\Nkalian menerjemahkannya.
Dialogue: 0,0:02:59.30,0:03:01.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku hanya bisa memercayaimu.
Dialogue: 0,0:03:01.45,0:03:03.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, apa yang dikatakan pahlawan Alicia?
Dialogue: 0,0:03:06.40,0:03:10.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang dia ingin berterima kasih padamu\Nkarena telah menyelamatkan nyawanya.
Dialogue: 0,0:03:12.50,0:03:14.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama-sama.
Dialogue: 0,0:03:31.50,0:03:33.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat pertemuannya ada di bawah tanah.
Dialogue: 0,0:03:34.00,0:03:36.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah berapa lama kita tidak dikumpulkan?
Dialogue: 0,0:03:36.60,0:03:37.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua tahun.
Dialogue: 0,0:03:37.55,0:03:39.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, aku tidak keberatan\Njika kita lebih sering dikumpulkan.
Dialogue: 0,0:03:39.65,0:03:41.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mata faksi utama Gereja Elds,
Dialogue: 0,0:03:41.55,0:03:42.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita adalah aliran sesat.
Dialogue: 0,0:03:42.95,0:03:46.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar merepotkan karena kita\Ntidak bisa bertindak terang-terangan.
Dialogue: 0,0:03:46.35,0:03:49.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langkah kerahasiaannya pasti aman\Ntanpa cela, 'kan, Wakil Dekan?
Dialogue: 0,0:03:49.45,0:03:51.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal itu tidak ada masalah.
Dialogue: 0,0:03:51.40,0:03:54.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada penghalang kuat\Nyang melindungi bangunan sekolah ini.
Dialogue: 0,0:03:54.39,0:03:56.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya mereka yang diundang\Nyang berhak masuk.
Dialogue: 0,0:03:56.86,0:04:02.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, kami juga mengirim orang\Nmemastikan para siswa sudah tertidur lelap.
Dialogue: 0,0:04:03.75,0:04:04.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada masalah.
Dialogue: 0,0:04:11.45,0:04:12.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang aneh.
Dialogue: 0,0:04:12.86,0:04:14.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kamar terakhir, 'kan?
Dialogue: 0,0:04:19.83,0:04:20.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana mungkin?
Dialogue: 0,0:04:20.80,0:04:22.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian bukan…
Dialogue: 0,0:04:25.50,0:04:27.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu "Topeng Kematian", bodoh.
Dialogue: 0,0:04:28.55,0:04:30.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mencampur serbuk bijih sihir\Ndengan tanah liat.
Dialogue: 0,0:04:30.95,0:04:34.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ilmu sihir ramuan yang dicetak sesuai\Nbentuk wajah untuk membuat topeng.
Dialogue: 0,0:04:34.05,0:04:36.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, yang akan kita tiru
Dialogue: 0,0:04:36.00,0:04:38.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah wajah mereka.
Dialogue: 0,0:04:41.50,0:04:44.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kita benar-benar tidak punya\Nwaktu untuk membuat rambut palsu.
Dialogue: 0,0:04:45.45,0:04:48.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal kita memakai tudung,\Nkita tidak akan ketahuan, 'kan?
Dialogue: 0,0:04:48.86,0:04:51.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walaupun Menara Hitam sepertinya menarik,
Dialogue: 0,0:04:51.05,0:04:54.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tentu saja kita memilih tempat ini\Nuntuk mencari informasi.
Dialogue: 0,0:04:54.45,0:04:55.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana keadaan para siswa?
Dialogue: 0,0:04:55.90,0:04:57.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya sudah tidur.
Dialogue: 0,0:04:57.65,0:04:58.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di tempatku juga.
Dialogue: 0,0:04:58.75,0:05:00.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, ayo masuk.
Dialogue: 0,0:05:03.80,0:05:05.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kabut di depan itu adalah penghalang?
Dialogue: 0,0:05:06.65,0:05:09.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata bangunan sekolah ini\Npunya ruang bawah tanah.
Dialogue: 0,0:05:11.34,0:05:12.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tidak berjumpa.
Dialogue: 0,0:05:12.80,0:05:15.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau lihat menara di luar sana?
Dialogue: 0,0:05:15.10,0:05:17.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak orang yang berkumpul, ya.
Dialogue: 0,0:05:17.20,0:05:19.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila dilihat lebih dekat,\Nada banyak wajah yang dikenal.
Dialogue: 0,0:05:19.40,0:05:21.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eslinn dan Boelate…
Dialogue: 0,0:05:21.35,0:05:24.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya para tokoh penting\Ndari kedua negara sudah hadir semua.
Dialogue: 0,0:05:24.24,0:05:26.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai orang yang mencintai ilmu sihir,
Dialogue: 0,0:05:26.15,0:05:28.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sudah lama mengetahui keberadaan\Nperkumpulan rahasia ini.
Dialogue: 0,0:05:28.15,0:05:29.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, formasi sebesar ini\Nbenar-benar mengejutkan…
Dialogue: 0,0:05:29.80,0:05:31.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat mengejutkan, bukan?
Dialogue: 0,0:05:31.50,0:05:32.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa itu?
Dialogue: 0,0:05:34.05,0:05:35.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ini aku.
Dialogue: 0,0:05:35.55,0:05:37.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tygel, Leon.
Dialogue: 0,0:05:37.59,0:05:39.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Rupanya kau.\N- Bagaimana kau bisa masuk?
Dialogue: 0,0:05:39.50,0:05:41.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kau bisa membongkar\Npenyamaran kami?
Dialogue: 0,0:05:42.20,0:05:45.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, sebenarnya aku melihat semuanya\Ndari awal sampai akhir.
Dialogue: 0,0:05:45.56,0:05:48.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, untuk apa pertemuan ini diadakan?
Dialogue: 0,0:05:48.59,0:05:50.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ikut ke sini tanpa tahu apa-apa?
Dialogue: 0,0:05:50.45,0:05:52.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, kau sama sekali tidak menyamar.
Dialogue: 0,0:05:52.15,0:05:54.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat tundukkan kepalamu,\Nkalau tidak kau akan ketahuan.
Dialogue: 0,0:05:54.15,0:05:57.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika intuisi dan pengetahuan kami benar,
Dialogue: 0,0:05:57.39,0:05:59.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}orang-orang ini adalah anggota asosiasi…\NAnggota "Union".
Dialogue: 0,0:05:59.90,0:06:00.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Union?
Dialogue: 0,0:06:00.85,0:06:02.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan angkat kepalamu.
Dialogue: 0,0:06:03.70,0:06:05.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perkumpulan Union ini
Dialogue: 0,0:06:05.35,0:06:09.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah ada sejak zaman ketika ilmu sihir\Nhanya sekadar pertunjukan jalanan.
Dialogue: 0,0:06:09.30,0:06:15.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuan mereka mengulang kembali ilmu sihir\Nlegenda "Warisan Pahlawan" sepenuhnya.
Dialogue: 0,0:06:15.70,0:06:17.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alasan mengapa ilmu sihir modern\Nbisa berkembang
Dialogue: 0,0:06:17.74,0:06:19.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak lepas dari peran\Norang-orang ini di baliknya.
Dialogue: 0,0:06:19.80,0:06:21.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi Union,
Dialogue: 0,0:06:21.20,0:06:24.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}konflik antarnegara juga merupakan\Najang eksperimen ilmu sihir.
Dialogue: 0,0:06:24.20,0:06:26.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelompok ini memang seberbahaya itu.
Dialogue: 0,0:06:28.05,0:06:31.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sudah lama menduga\Nbahwa sekolah ini didukung oleh Union.
Dialogue: 0,0:06:31.80,0:06:33.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, bagaimanapun juga…
Dialogue: 0,0:06:33.95,0:06:36.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami bahkan tidak pernah membayangkannya.
Dialogue: 0,0:06:36.06,0:06:41.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dekan akademi ini sepertinya\Nadalah pemimpin Union.
Dialogue: 0,0:06:47.70,0:06:49.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rekan-rekan sekalian.
Dialogue: 0,0:06:49.35,0:06:53.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, Tempat Suci Solsein\Nsedang dalam keadaan darurat.
Dialogue: 0,0:06:53.80,0:06:55.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Telah muncul Menara Hitam
Dialogue: 0,0:06:55.95,0:06:58.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan penghalang misterius yang terbentuk\Ndari kabut tebal.
Dialogue: 0,0:06:58.95,0:07:03.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat ilmu sihirku, kalian semua\Ndapat memasuki penghalang tersebut.
Dialogue: 0,0:07:03.49,0:07:06.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, jika kalian ingin keluar-masuk\Ndengan berjalan kaki, rasanya mustahil.
Dialogue: 0,0:07:06.60,0:07:09.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengenai mengapa aku memanggil\Nkalian di tengah kondisi darurat ini,
Dialogue: 0,0:07:10.34,0:07:12.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jawabannya sangat sederhana.
Dialogue: 0,0:07:13.74,0:07:16.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekaranglah saatnya.
Dialogue: 0,0:07:18.05,0:07:19.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu untuk mewujudkan impian lama kita,
Dialogue: 0,0:07:19.95,0:07:24.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yaitu membuat ulang Warisan Pahlawan\Nsepenuhnya, telah tiba.
Dialogue: 0,0:07:29.50,0:07:32.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membuat ulang Warisan Pahlawan sepenuhnya?
Dialogue: 0,0:07:32.39,0:07:34.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka skalanya akan sebesar ini.
Dialogue: 0,0:07:34.94,0:07:36.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pikiranku ternyata benar.
Dialogue: 0,0:07:36.39,0:07:38.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini jauh lebih menarik.
Dialogue: 0,0:07:50.20,0:07:51.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia.
Dialogue: 0,0:07:51.75,0:07:54.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada urusan penting apa hingga Anda\Ndatang ke mari malam ini?
Dialogue: 0,0:07:54.40,0:07:57.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku datang menemui putriku sendiri,\Nkenapa membutuhkan alasan?
Dialogue: 0,0:07:57.90,0:07:59.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada beberapa hal tentang Solsein
Dialogue: 0,0:07:59.55,0:08:02.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang harus kutanyakan jelas pada Milea\Nselaku Ketua.
Dialogue: 0,0:08:02.56,0:08:03.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, mengenai hal itu…
Dialogue: 0,0:08:09.35,0:08:13.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kardinal Elro Romain\Nmemang sangat mencurigakan.
Dialogue: 0,0:08:14.35,0:08:16.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sewaktu dia masih di keuskupan Eslinn,
Dialogue: 0,0:08:16.75,0:08:21.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebelum menjadi kardinal, dia terlihat\Nhanya seperti pendeta biasa yang taat.
Dialogue: 0,0:08:21.95,0:08:26.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak terlihat hubungannya\Ndengan ilmu sihir maupun Union.
Dialogue: 0,0:08:26.45,0:08:28.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perubahannya terjadi…
Dialogue: 0,0:08:28.20,0:08:30.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah setelah dia ditugaskan di Solsein,
Dialogue: 0,0:08:30.90,0:08:34.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau setelah mulai bergaul\Ndengan Jenderal Dorel?
Dialogue: 0,0:08:34.45,0:08:36.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar seperti dua orang yang berbeda.
Dialogue: 0,0:08:37.85,0:08:41.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, di saat yang sama\Nada satu orang lagi…
Dialogue: 0,0:08:41.90,0:08:43.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini,
Dialogue: 0,0:08:43.20,0:08:48.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seluruh kekuatan telah terpusat\Ndi Tempat Suci Solsein.
Dialogue: 0,0:08:49.00,0:08:51.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan yang dimaksud adalah kitab suci,
Dialogue: 0,0:08:51.85,0:08:53.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang juga kita sebut sebagai "Buku Toah",
Dialogue: 0,0:08:53.90,0:08:56.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}asal mula sejarah suku manusia.
Dialogue: 0,0:08:56.25,0:09:01.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak berlebihan jika dikatakan suku manusia\Nlahir bersamaan dengan buku ini.
Dialogue: 0,0:09:01.30,0:09:04.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buku ini ibaratnya adalah\Nwilayah suku manusia.
Dialogue: 0,0:09:04.65,0:09:07.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buku ini mencatat
Dialogue: 0,0:09:07.14,0:09:10.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}metode untuk memperluas\Nwilayah suku manusia.
Dialogue: 0,0:09:10.10,0:09:12.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu adalah Warisan Pahlawan
Dialogue: 0,0:09:12.65,0:09:16.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan juga wahyu ilahi yang harus kita patuhi.
Dialogue: 0,0:09:16.70,0:09:19.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, skalanya ini kelewat besar.
Dialogue: 0,0:09:19.74,0:09:23.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buku Bab Kedua "Desa Awal"
Dialogue: 0,0:09:23.49,0:09:26.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada di tanganku.
Dialogue: 0,0:09:26.15,0:09:27.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin kalian semua tahu
Dialogue: 0,0:09:27.35,0:09:29.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahwa selain satu buku,
Dialogue: 0,0:09:29.15,0:09:32.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}empat bab sisanya telah terkumpul.
Dialogue: 0,0:09:34.50,0:09:37.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buku terakhir yang dilindungi paling ketat
Dialogue: 0,0:09:37.35,0:09:40.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan sulit didapat,
Dialogue: 0,0:09:40.75,0:09:43.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yaitu Buku Bab Ketiga "Tungku",
Dialogue: 0,0:09:43.85,0:09:46.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}telah muncul bersamaan\Ndengan Menara Hitam itu.
Dialogue: 0,0:09:49.25,0:09:50.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saudara-saudara,
Dialogue: 0,0:09:50.75,0:09:52.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukankah ini saatnya kita menggunakan\Nkekuatan kita untuk mewujudkan impian itu,
Dialogue: 0,0:09:52.90,0:09:55.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mewujudkan cita-cita kita?
Dialogue: 0,0:09:55.76,0:09:58.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita wujudkan impian Union kita.
Dialogue: 0,0:10:03.40,0:10:08.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak perlu lagi menyembunyikan\Nidentitas asliku.
Dialogue: 0,0:10:11.56,0:10:13.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiba-tiba sebuah gambaran\Nmuncul di kepalaku.
Dialogue: 0,0:10:13.69,0:10:16.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diriku berdiri di depan cermin?
Dialogue: 0,0:10:16.39,0:10:20.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata "cermin" ini\Nterus mengganggu pikiranku.
Dialogue: 0,0:10:20.65,0:10:22.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di kamar pria bernama Dorel itu
Dialogue: 0,0:10:22.00,0:10:26.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}juga terdapat cermin besar\Nyang tidak serasi dengannya.
Dialogue: 0,0:10:26.55,0:10:30.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cermin itu seharusnya ditempatkan\Ndi kamar Milea.
Dialogue: 0,0:10:30.79,0:10:35.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa ada cermin yang sama di kamar Dorel?
Dialogue: 0,0:10:39.05,0:10:40.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah Milea ada di kamarnya?
Dialogue: 0,0:10:40.55,0:10:42.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia sedang tidur, bangunkan dia.
Dialogue: 0,0:10:42.65,0:10:45.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Putri Milea\Nsempat keluar sebentar tadi.
Dialogue: 0,0:10:45.80,0:10:47.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, beliau berpesan agar tidak\Nmembiarkan siapa pun masuk ke kamarnya.
Dialogue: 0,0:10:47.51,0:10:50.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memerintahkanmu untuk minggir.
Dialogue: 0,0:10:52.25,0:10:53.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu…
Dialogue: 0,0:10:53.80,0:10:54.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:10:55.89,0:10:57.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu "Topeng Kematian".
Dialogue: 0,0:10:57.70,0:11:01.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, Dekan sendiri…
Dialogue: 0,0:11:06.60,0:11:11.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang adalah waktunya untuk membuka\N"laboratorium rahasia".
Dialogue: 0,0:11:15.50,0:11:16.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia.
Dialogue: 0,0:11:16.49,0:11:18.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana keadaan Milea?
Dialogue: 0,0:11:25.96,0:11:28.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia terus-terusan berdiam diri seperti itu\Ndari pagi sampai malam.
Dialogue: 0,0:11:28.45,0:11:31.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sepertinya masih belum bisa lepas\Ndari duka akibat kehilangan ibunya.
Dialogue: 0,0:11:31.50,0:11:33.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun juga, usianya baru empat tahun.
Dialogue: 0,0:11:34.25,0:11:37.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Putri Milea sungguh malang.
Dialogue: 0,0:11:41.55,0:11:44.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sering menatap kosong\Nke arah ruangan yang sepi
Dialogue: 0,0:11:44.34,0:11:47.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tanpa ekspresi wajah.
Dialogue: 0,0:11:47.45,0:11:51.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar dia menjadi seperti itu\Nkarena pengaruh garis keturunan Allozar.
Dialogue: 0,0:11:53.70,0:11:55.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong sampaikan pada putriku,
Dialogue: 0,0:11:55.35,0:11:57.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampaikan kata-kata ini kepada Milea.
Dialogue: 0,0:11:58.75,0:12:01.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Terima kasih sudah terlahir ke dunia ini,
Dialogue: 0,0:12:02.40,0:12:06.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan maafkan aku."
Dialogue: 0,0:12:15.25,0:12:16.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar.
Dialogue: 0,0:12:16.85,0:12:18.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya dia bunuh diri\Ndengan melompat dari gedung.
Dialogue: 0,0:12:18.99,0:12:22.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tahu begini,\Naku seharusnya tidak menikahinya.
Dialogue: 0,0:12:22.60,0:12:23.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia.
Dialogue: 0,0:12:23.95,0:12:25.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu diungkit lagi.
Dialogue: 0,0:12:25.90,0:12:27.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun tanpa sosok seorang ibu,
Dialogue: 0,0:12:27.40,0:12:30.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan membesarkan Milea dengan baik.
Dialogue: 0,0:12:30.44,0:12:35.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun juga,\Ndia adalah putriku, Beis Werz.
Dialogue: 0,0:12:35.05,0:12:36.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia.
Dialogue: 0,0:12:36.40,0:12:37.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:12:38.05,0:12:42.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada seseorang yang meminta audiensi.\NDia ada di ruang pertemuan.
Dialogue: 0,0:12:42.55,0:12:45.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian membiarkan orang\Nyang tidak punya janji temu masuk?
Dialogue: 0,0:12:45.71,0:12:47.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, itu karena…
Dialogue: 0,0:12:47.65,0:12:51.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada satu pun penjaga yang bisa\Nmenghentikan orang itu.
Dialogue: 0,0:13:00.15,0:13:01.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kau, Dorel.
Dialogue: 0,0:13:01.85,0:13:05.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar kau mengembara\Nselama sepuluh tahun terakhir?
Dialogue: 0,0:13:06.64,0:13:10.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah sekian lama,\Nada urusan apa kau kemari? Katakan.
Dialogue: 0,0:13:10.55,0:13:13.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bersedia mengabdi pada negara ini.
Dialogue: 0,0:13:13.40,0:13:18.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harap Anda bersedia membeli kekuatanku,\Nseluruh pengetahuan sihirku.
Dialogue: 0,0:13:19.90,0:13:22.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu apa imbalan yang kau inginkan?
Dialogue: 0,0:13:22.90,0:13:27.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memutuskan untuk mempekerjakanmu\Natau membunuhmu berdasarkan jawabanmu.
Dialogue: 0,0:13:27.15,0:13:29.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imbalan yang kuinginkan hanya satu.
Dialogue: 0,0:13:29.95,0:13:32.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yaitu kebebasan untuk mengeksplorasi\Njalan sihir.
Dialogue: 0,0:13:32.79,0:13:34.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalan sihir…
Dialogue: 0,0:13:34.35,0:13:36.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu jalan untuk mendalami ilmu sihir?
Dialogue: 0,0:13:36.90,0:13:37.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:13:37.80,0:13:39.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di era mendatang,
Dialogue: 0,0:13:39.39,0:13:43.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jika ingin memperkuat pasukan,\Nilmu sihir akan menjadi sangat diperlukan.
Dialogue: 0,0:13:43.10,0:13:44.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya belajar secara tertutup
Dialogue: 0,0:13:44.60,0:13:47.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan menyulitkan seseorang\Nuntuk mencapai puncak di jalan ini.
Dialogue: 0,0:13:47.70,0:13:50.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal memanfaatkan pengetahuanku,
Dialogue: 0,0:13:50.26,0:13:51.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian bisa mendapatkan\Nhasil berkali-kali lipat
Dialogue: 0,0:13:51.50,0:13:55.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya dengan separuh pasukan.
Dialogue: 0,0:13:55.25,0:13:56.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu,
Dialogue: 0,0:13:56.90,0:14:03.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau ingin menjadi Penyihir Agung seperti\Nyang muncul dalam Warisan Pahlawan?
Dialogue: 0,0:14:03.25,0:14:06.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya, aku tidak bisa\Nmenjadi Penyihir Agung.
Dialogue: 0,0:14:06.65,0:14:09.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku bisa menemukan bakat\Nyang kelak menjadi Penyihir Agung
Dialogue: 0,0:14:09.89,0:14:12.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan membimbingnya.
Dialogue: 0,0:14:12.80,0:14:15.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal ini, aku berani jamin.
Dialogue: 0,0:14:16.70,0:14:18.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menarik.
Dialogue: 0,0:14:18.25,0:14:21.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dorel, aku akan membelimu.
Dialogue: 0,0:14:21.25,0:14:23.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, pengkhianatan berarti kematian.
Dialogue: 0,0:14:23.95,0:14:28.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, silakan teliti jalan sihir sepuasmu\Ndi negara ini.
Dialogue: 0,0:14:29.65,0:14:31.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:14:42.36,0:14:43.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Putri, Anda mau ke mana?
Dialogue: 0,0:14:49.94,0:14:51.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:14:51.45,0:14:52.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku seperti mendengar suara.
Dialogue: 0,0:15:04.99,0:15:08.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benar-benar bisa\Nmendengar suara itu, ya?
Dialogue: 0,0:15:09.09,0:15:11.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kembalilah\Ndan bertanyalah pada cermin,
Dialogue: 0,0:15:11.50,0:15:14.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}siapa dirimu.
Dialogue: 0,0:15:17.40,0:15:21.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara itu sedang memanggilmu.
Dialogue: 0,0:15:21.45,0:15:22.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara?
Dialogue: 0,0:15:24.45,0:15:26.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Garis keturunan Allozar
Dialogue: 0,0:15:26.85,0:15:29.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pastinya akan menuntun arahmu.
Dialogue: 0,0:15:30.50,0:15:32.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Garis keturunan Allozar…
Dialogue: 0,0:15:45.74,0:15:48.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kau?
Dialogue: 0,0:15:52.04,0:15:55.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu kau sendiri siapa?
Dialogue: 0,0:16:05.40,0:16:07.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Geli.\N- Milea benar-benar berbeda.
Dialogue: 0,0:16:07.90,0:16:10.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beginilah seharusnya sikap\Nseorang Putri Boelate.
Dialogue: 0,0:16:10.95,0:16:13.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah bagaimana suasana hatinya\Nbisa tiba-tiba berubah.
Dialogue: 0,0:16:13.75,0:16:16.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, anak-anak memang\Nmudah berubah pikiran, 'kan?
Dialogue: 0,0:16:17.05,0:16:20.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah Dorel bergabung,\Npasukan kita akan makin kuat.
Dialogue: 0,0:16:20.79,0:16:23.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang adalah eranya\Nilmu sihir berkuasa.
Dialogue: 0,0:16:24.40,0:16:26.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, Ayahanda.
Dialogue: 0,0:16:31.79,0:16:35.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang adalah eranya\Nilmu sihir berkuasa.
Dialogue: 0,0:16:36.05,0:16:38.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku adalah
Dialogue: 0,0:16:38.05,0:16:41.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri Milea Renault Allozar Werz.
Dialogue: 0,0:16:41.15,0:16:44.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri dari Kaisar Beis Werz.
Dialogue: 0,0:16:44.10,0:16:49.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekaligus pemilik kitab Solsein,\Nyang dulu dikenal sebagai "Desa Awal".
Dialogue: 0,0:16:49.99,0:16:53.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada saat yang sama,\Nketurunan dari Pendeta Allozar.
Dialogue: 0,0:16:53.40,0:16:55.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rekan-rekan Union,
Dialogue: 0,0:16:55.79,0:16:57.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pujilah kitab itu.
Dialogue: 0,0:16:58.50,0:17:00.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah
Dialogue: 0,0:17:00.29,0:17:04.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}wahyu ilahi yang membimbing kita\Nmenuju jalan sihir.
Dialogue: 0,0:17:07.79,0:17:10.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Putri Milea makin cantik saja.
Dialogue: 0,0:17:10.90,0:17:15.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi bernostalgia dengan saat pertama kali\Ndia muncul di hadapan kita.
Dialogue: 0,0:17:15.84,0:17:18.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu benar-benar\Nmembuatku sangat terkejut.
Dialogue: 0,0:17:18.80,0:17:21.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana tidak, dia menghancurkan\Nketua pada masa itu
Dialogue: 0,0:17:21.84,0:17:25.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dalam duel ilmu sihir satu lawan satu.
Dialogue: 0,0:17:25.45,0:17:29.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itulah kita mengetahui keberadaan\NBuku Toah beserta kekuatannya.
Dialogue: 0,0:17:29.04,0:17:33.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang lebih mengejutkan adalah saat\Nusianya 14 tahun, 'kan?
Dialogue: 0,0:17:40.34,0:17:41.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang hendak Anda lakukan?
Dialogue: 0,0:17:43.20,0:17:44.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa ini?
Dialogue: 0,0:17:44.90,0:17:46.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ceritanya kita bisa\Nsampai ke sini?
Dialogue: 0,0:17:46.89,0:17:49.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dekan, Anda tidak perlu memikirkannya.
Dialogue: 0,0:17:50.04,0:17:51.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengarkan, semuanya.
Dialogue: 0,0:17:51.85,0:17:54.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku adalah Master Solsein,
Dialogue: 0,0:17:55.05,0:17:57.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan hari ini juga secara resmi\Nmenjabat sebagai Ketua Solsein.
Dialogue: 0,0:17:58.45,0:18:01.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di permukaan, hak keputusan manajemen\Nakademi ada di tanganku,
Dialogue: 0,0:18:01.80,0:18:04.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi jika tujuannya adalah\Nmenyempurnakan jalan sihir,
Dialogue: 0,0:18:04.50,0:18:07.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tentu kekuatan Dekan\Nsangat dibutuhkan, bukan?
Dialogue: 0,0:18:08.30,0:18:12.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oleh karena itu, aku akan menjadi Dekan\Ndi balik layar.
Dialogue: 0,0:18:16.40,0:18:17.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cermin.
Dialogue: 0,0:18:18.50,0:18:21.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan aku menirunya.
Dialogue: 0,0:18:21.45,0:18:23.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau… Apa yang mau kau lakukan? Hentikan!
Dialogue: 0,0:18:38.40,0:18:42.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kejadian saat itu benar-benar\Nmembuatku terkejut.
Dialogue: 0,0:18:43.85,0:18:47.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ilmu sihir itu bahkan bisa mengubah\Nbentuk tubuh dan suara.
Dialogue: 0,0:18:47.25,0:18:50.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun dia bilang dia\Nmengaplikasikan ilmu sihir kita,
Dialogue: 0,0:18:50.70,0:18:53.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kekuatan Buku Toah sungguh menakutkan.
Dialogue: 0,0:18:53.95,0:18:55.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Bagaimana dia menggunakan dua identitas,\N- Ini gawat.
Dialogue: 0,0:18:55.80,0:18:57.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- luar dan dalam?\N- Ya, gawat.
Dialogue: 0,0:18:58.74,0:19:01.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat menginginkan\Nkemampuan seperti itu.
Dialogue: 0,0:19:01.59,0:19:02.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku setuju.
Dialogue: 0,0:19:04.90,0:19:06.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, tunggu sebentar, kalian berdua.
Dialogue: 0,0:19:07.44,0:19:09.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan mereka pergi, Eddy.
Dialogue: 0,0:19:09.35,0:19:12.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, ini benar-benar terlalu berbahaya.
Dialogue: 0,0:19:12.44,0:19:16.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika terjadi sesuatu, aku akan mencari\Ncara untuk setidaknya melindungimu.
Dialogue: 0,0:19:16.20,0:19:18.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiraukan mereka,\NVordin adalah poin utamanya.
Dialogue: 0,0:19:18.54,0:19:20.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa hubungan antara Vordin dan wanita itu?
Dialogue: 0,0:19:20.90,0:19:22.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika dia akan muncul,\Nkapan waktu yang dia pilih
Dialogue: 0,0:19:22.55,0:19:25.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan wujud seperti apa\Nyang akan digunakannya?
Dialogue: 0,0:19:25.99,0:19:28.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa merasakan hawa keberadaannya\Ndengan jelas.
Dialogue: 0,0:19:28.40,0:19:30.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang itu pasti akan muncul.
Dialogue: 0,0:19:31.35,0:19:34.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa jadi dia sudah menyadari keberadaanku.
Dialogue: 0,0:19:36.70,0:19:38.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarlah, Vordin.
Dialogue: 0,0:19:39.69,0:19:42.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang ingin kutanyakan padamu.
Dialogue: 0,0:19:44.85,0:19:50.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dekan diduga melintasi Dunia Permukaan\Ndan Dunia Tersembunyi dengan sihir cermin.
Dialogue: 0,0:19:50.69,0:19:52.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekali terjebak oleh ilmu sihir semacam itu,
Dialogue: 0,0:19:52.55,0:19:54.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}penampilan di Dunia Permukaan\Nakan berubah menjadi monster sihir.
Dialogue: 0,0:19:54.50,0:19:59.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila dilihat dari Dunia Tersembunyi,\Nsegalanya akan tampak busuk dan buruk rupa.
Dialogue: 0,0:20:00.40,0:20:03.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agak mirip dengan cobaan\Ndalam Warisan Pahlawan.
Dialogue: 0,0:20:04.20,0:20:06.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika bertahan hidup dari cobaan, seseorang\Nakan mendapatkan kekuatan "lambang kutukan"
Dialogue: 0,0:20:06.70,0:20:09.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan memperoleh kemampuan\Nyang disebut "keterampilan".
Dialogue: 0,0:20:09.55,0:20:10.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah yang dikatakan orang ini.
Dialogue: 0,0:20:13.90,0:20:16.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, di saat yang sama, akan kehilangan\Nmemori selama cobaan.
Dialogue: 0,0:20:16.79,0:20:21.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlebih lagi, hal ini berhubungan dengan\NRaja Monster Sihir dari Utara, Vordin.
Dialogue: 0,0:20:21.75,0:20:23.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vordin, ya?
Dialogue: 0,0:20:23.30,0:20:26.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa masih ada lantai yang lebih\Nrendah lagi di sini.
Dialogue: 0,0:20:27.10,0:20:29.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laboratorium rahasia itu\Nkemungkinan besar ada di sana.
Dialogue: 0,0:20:30.29,0:20:31.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya ada petunjuk\Nyang tersembunyi di sini.
Dialogue: 0,0:20:31.99,0:20:35.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di Dunia Tersembunyi ini,\Nretakan dapat terlihat di mana-mana.
Dialogue: 0,0:20:35.95,0:20:38.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan cahaya merah terlihat\Nmemancar dari dalamnya.
Dialogue: 0,0:20:38.50,0:20:39.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Retakan?
Dialogue: 0,0:20:39.69,0:20:41.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak terlihat dari tempat kita.
Dialogue: 0,0:20:41.55,0:20:42.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, 'kan?
Dialogue: 0,0:20:42.85,0:20:45.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku berpikir,\Nmungkinkah itu adalah celahnya?
Dialogue: 0,0:20:46.65,0:20:48.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Celah di dunia ini.
Dialogue: 0,0:20:48.55,0:20:51.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat ini pasti belum sempurna.
Dialogue: 0,0:20:52.00,0:20:53.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin itulah alasannya
Dialogue: 0,0:20:53.70,0:20:56.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kenapa sekarang aku bisa sedikit\Nmerasakan keberadaan Klen.
Dialogue: 0,0:20:58.70,0:21:00.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin juga karena itu,
Dialogue: 0,0:21:00.20,0:21:03.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tubuhku yang tadinya hancur\Nberangsur-angsur mulai pulih.
Dialogue: 0,0:21:04.15,0:21:05.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:21:05.75,0:21:08.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berencana untuk melompat ke dalam\Nretakan itu sekarang untuk melihat-lihat.
Dialogue: 0,0:21:10.40,0:21:13.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gart, kalau kau tidak keberatan,\Ntolong bantu aku.
Dialogue: 0,0:21:13.60,0:21:15.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampaikan hal-hal yang kukatakan tadi\Npada Klen.
Dialogue: 0,0:21:16.10,0:21:18.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedangkan Rhode, tolong carilah Dekan.
Dialogue: 0,0:21:18.65,0:21:20.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinan besar, buku itu ada padanya.
Dialogue: 0,0:21:20.70,0:21:23.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terserah bagaimana kalian mau menindak\Nbuku itu, mau dibakar juga boleh.
Dialogue: 0,0:21:23.24,0:21:24.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu katanya.
Dialogue: 0,0:21:24.46,0:21:26.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini… Aku tidak ada masalah.
Dialogue: 0,0:21:27.25,0:21:31.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, buku itu sepertinya bukan sesuatu\Nyang bisa diselesaikan hanya dengan dibakar.
Dialogue: 0,0:21:32.49,0:21:34.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yakin melakukan ini tidak apa-apa?
Dialogue: 0,0:21:34.55,0:21:36.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekalipun kau berhasil tiba di sana,
Dialogue: 0,0:21:36.40,0:21:40.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau akan menerobos markas musuh sendirian.
Dialogue: 0,0:21:40.60,0:21:43.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perkataanmu sama sekali tidak salah.
Dialogue: 0,0:21:46.69,0:21:49.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, berani masuk ke situasi berbahaya\Nseperti inilah yang disebut pahlawan, 'kan?
Dialogue: 0,0:21:55.09,0:21:56.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu memang benar.
Dialogue: 0,0:21:56.39,0:21:59.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu dia, orang itu pasti sudah\Nmenendangku ke bawah sejak tadi.
Dialogue: 0,0:21:59.60,0:22:01.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memikirkannya saja membuatku merasa lucu.
Dialogue: 0,0:22:02.30,0:22:05.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggulah, laboratorium rahasia!
