Dialogue: 0,0:02:20.90,0:02:24.50,sign,,0000,0000,0000,,"EPISODE 4: MENARA HITAM"
Dialogue: 0,0:17:04.65,0:17:05.84,sign,,0000,0000,0000,,AHAHAHA
Dialogue: 0,0:17:05.84,0:17:07.69,sign,,0000,0000,0000,,"APA PUN TERSERAHLAH"
Dialogue: 0,0:00:16.14,0:00:17.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan, jangan ditutup!
Dialogue: 0,0:00:17.90,0:00:19.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan aku keluar!
Dialogue: 0,0:00:19.90,0:00:21.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:00:25.65,0:00:27.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, yang benar saja?
Dialogue: 0,0:00:28.09,0:00:30.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangga, serangga lagi!
Dialogue: 0,0:00:30.45,0:00:33.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mendekat, aku trauma dengan serangga!
Dialogue: 0,0:00:33.95,0:00:37.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan!
Dialogue: 0,0:02:14.24,0:02:15.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Clevatess Ⅱ
Dialogue: 0,0:02:18.49,0:02:20.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya kau menangkap gadis\Nyang menyamar sebagai pahlawan,
Dialogue: 0,0:02:20.90,0:02:24.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alicia Glenfall?
Dialogue: 0,0:02:24.50,0:02:28.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar. Jiwanya berada di dalam cermin.
Dialogue: 0,0:02:29.30,0:02:31.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama buku ini tidak dibuka,
Dialogue: 0,0:02:31.50,0:02:33.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia tidak akan bisa kabur.
Dialogue: 0,0:02:34.06,0:02:37.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kau sudah bisa menggunakan\NBuku Toah dengan mahir.
Dialogue: 0,0:02:38.10,0:02:39.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:02:39.70,0:02:41.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buku ini pada dasarnya adalah
Dialogue: 0,0:02:41.15,0:02:45.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}warisan turun-temurun keluargaku yang pernah\Nmenjabat sebagai Uskup di "Desa Awal".
Dialogue: 0,0:02:45.89,0:02:47.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah aku bertemu dengan Jenderal
Dialogue: 0,0:02:47.85,0:02:49.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menerima bimbingan Anda,
Dialogue: 0,0:02:49.85,0:02:53.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kini aku telah mendapatkan kembali\Nkekuatanku yang semula.
Dialogue: 0,0:02:54.25,0:02:58.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua ini demi mewujudkan\Nkeinginan lama kita.
Dialogue: 0,0:02:58.40,0:03:02.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk mencapai tujuan tersebut,\Nkita harus mengumpulkan semua bukunya.
Dialogue: 0,0:03:03.00,0:03:05.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buku terakhir, buku "Tungku",
Dialogue: 0,0:03:05.95,0:03:08.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada di tangan Clevatess.
Dialogue: 0,0:03:08.49,0:03:11.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin kau merebutnya\Nbagaimanapun caranya.
Dialogue: 0,0:03:11.35,0:03:12.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan padaku.
Dialogue: 0,0:03:13.45,0:03:16.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama berada di dalam sekolah Solsein\Nyang dulunya adalah "Desa Awal" ini,
Dialogue: 0,0:03:16.90,0:03:20.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}siapa pun tidak akan bisa\Nmelawan kekuatan buku ini.
Dialogue: 0,0:03:21.70,0:03:24.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan Raja Monster Sihir sekalipun.
Dialogue: 0,0:03:27.10,0:03:28.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon bersabar sedikit lagi,
Dialogue: 0,0:03:29.34,0:03:31.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raja dari Utara yang Agung.
Dialogue: 0,0:03:34.49,0:03:39.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak disangka pahlawan Alicia akan berubah\Nmenjadi monster sihir semacam itu.
Dialogue: 0,0:03:40.80,0:03:42.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang lebih mengejutkan, yang menangkapnya
Dialogue: 0,0:03:42.55,0:03:44.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ternyata adalah Andrew Hwyp.
Dialogue: 0,0:03:45.90,0:03:47.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini akan menjadi sangat menarik.
Dialogue: 0,0:03:50.60,0:03:52.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah kembali, Andrew?
Dialogue: 0,0:03:53.10,0:03:54.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah kembali, Ray.
Dialogue: 0,0:03:55.20,0:03:57.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau menangkap sesuatu lagi?
Dialogue: 0,0:03:58.35,0:03:59.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seekor tikus.
Dialogue: 0,0:03:59.45,0:04:02.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ini sepertinya bisa\Nberumur lebih panjang.
Dialogue: 0,0:04:04.10,0:04:07.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sungguh kagum dengan rasa ingin tahumu.
Dialogue: 0,0:04:07.69,0:04:11.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bahkan tidak segan-segan memakai sihir\Nuntuk membangun ruang bawah tanah.
Dialogue: 0,0:04:13.05,0:04:14.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membuatmu merasa terganggu?
Dialogue: 0,0:04:14.40,0:04:15.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja tidak.
Dialogue: 0,0:04:16.35,0:04:18.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan Merry Merry
Dialogue: 0,0:04:18.08,0:04:21.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sama-sama menyukai kepribadianmu\Nyang pendiam tetapi antusias.
Dialogue: 0,0:04:27.56,0:04:28.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Fel".
Dialogue: 0,0:04:37.25,0:04:40.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesekali aku mendengar suara\Nseperti orang sedang berbicara,
Dialogue: 0,0:04:40.10,0:04:42.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi aku tidak bisa mendengar\Ndengan jelas apa yang mereka bicarakan.
Dialogue: 0,0:04:42.30,0:04:43.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah ini mimpi?
Dialogue: 0,0:04:43.90,0:04:46.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan ada orang yang sengaja\Nmemperlihatkan mimpi ini padaku?
Dialogue: 0,0:04:48.16,0:04:49.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah aku diletakkan di suatu tempat?
Dialogue: 0,0:04:49.65,0:04:51.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di lantai atau di atas meja?
Dialogue: 0,0:04:59.70,0:05:01.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat apa ini?
Dialogue: 0,0:05:01.25,0:05:03.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang ingin dilakukan orang ini padaku?
Dialogue: 0,0:05:08.39,0:05:12.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang… Ada apa lagi?
Dialogue: 0,0:05:14.80,0:05:16.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa denganmu?
Dialogue: 0,0:05:16.80,0:05:20.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reaksi darah sihir di wilayah ini\Npada dasarnya memang sudah sangat lemah.
Dialogue: 0,0:05:20.60,0:05:22.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, sekarang malah menghilang sepenuhnya.
Dialogue: 0,0:05:22.50,0:05:24.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan dia ditangkap oleh seseorang?
Dialogue: 0,0:05:24.44,0:05:25.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Clevatess?
Dialogue: 0,0:05:26.20,0:05:28.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akhiri obrolannya sampai di sini dulu.
Dialogue: 0,0:05:28.29,0:05:30.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah lumayan mengerti\Ntentang hal-hal di masa lalu.
Dialogue: 0,0:05:30.70,0:05:34.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan aku juga mengerti bahwa kau adalah\Nseorang berengsek, Zavtier.
Dialogue: 0,0:05:34.35,0:05:38.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku minta maaf karena selama ini menunda\Nmemberitahumu cerita sebelum kau lahir.
Dialogue: 0,0:05:38.79,0:05:41.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya kupikir semuanya sudah berakhir,
Dialogue: 0,0:05:41.30,0:05:43.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi ternyata aku salah.
Dialogue: 0,0:05:43.39,0:05:45.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebangkitan Warisan Pahlawan?
Dialogue: 0,0:05:46.05,0:05:49.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus mencegah hal itu.\NKita harus mencegahnya
Dialogue: 0,0:05:49.45,0:05:51.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagaimanapun caranya.
Dialogue: 0,0:05:52.50,0:05:56.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}1.100 tahun yang lalu,\Nsebelum dunia terbentuk seperti sekarang,
Dialogue: 0,0:05:56.60,0:05:58.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}telah terjadi banyak pengorbanan.
Dialogue: 0,0:05:58.50,0:06:01.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di saat pendahulu-pendahulu kalian\Ntumbang satu demi satu,
Dialogue: 0,0:06:01.95,0:06:06.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sosok yang mengakhiri perang 200 tahun\Nantara kita dan pahlawan tidak lain
Dialogue: 0,0:06:06.39,0:06:10.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah Raja Monster Sihir\Ndari Utara, Vordin.
Dialogue: 0,0:06:11.15,0:06:15.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah luka di sekujur tubuh orang itu\Ndidapatkan pada saat itu?
Dialogue: 0,0:06:15.14,0:06:18.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata pahlawan yang sebenarnya\Nsekuat itu.
Dialogue: 0,0:06:18.70,0:06:23.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan pahlawan yang telah berevolusi\Nke tahap akhir jauh melebihi kita.
Dialogue: 0,0:06:23.75,0:06:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak diragukan lagi,\Nitu adalah sebuah mimpi buruk.
Dialogue: 0,0:06:25.56,0:06:28.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang paling memahami hal itu adalah...
Dialogue: 0,0:06:28.20,0:06:30.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vordin, yang bertarung paling sengit\Nmelawan sang pahlawan.
Dialogue: 0,0:06:31.64,0:06:36.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu mengapa orang seperti dia malah\Nmembantu membangkitkan Warisan Pahlawan?
Dialogue: 0,0:06:36.55,0:06:39.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaan orang itu\Nsama sekali tidak penting.
Dialogue: 0,0:06:39.86,0:06:42.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia adalah musuh yang menginvasi wilayahku.
Dialogue: 0,0:06:42.14,0:06:44.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuh yang memamerkan taringnya padaku.
Dialogue: 0,0:06:44.30,0:06:46.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa pun yang berhubungan dengannya\Nadalah musuh.
Dialogue: 0,0:06:46.50,0:06:48.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengetahui hal ini saja sudah cukup.
Dialogue: 0,0:06:48.39,0:06:50.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan terus bertindak\Ndengan caraku sendiri.
Dialogue: 0,0:06:51.30,0:06:53.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kau berhati-hati, Clevatess.
Dialogue: 0,0:06:53.85,0:06:55.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini berada di luar wilayah kekuasaanmu.
Dialogue: 0,0:06:55.65,0:06:58.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya tidak akan berjalan selancar\Nsaat kau berada di Hiden.
Dialogue: 0,0:06:58.95,0:07:02.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya aku membawa pelayan bersamaku.
Dialogue: 0,0:07:03.10,0:07:05.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sepertimu, Zavtier.
Dialogue: 0,0:07:07.40,0:07:09.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menyadarinya?
Dialogue: 0,0:07:09.86,0:07:11.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:07:11.84,0:07:14.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sama sekali tidak membawa siapa pun.
Dialogue: 0,0:07:14.80,0:07:19.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelayanku itu sepertinya saat ini\Nsedang dalam kondisi tidak bisa dihubungi.
Dialogue: 0,0:07:19.20,0:07:21.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke mana sebenarnya dia pergi keluyuran?
Dialogue: 0,0:07:23.70,0:07:26.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, dia malah melepaskan\Npenghalangnya tanpa izin.
Dialogue: 0,0:07:31.69,0:07:34.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepalaku pusing sekali.
Dialogue: 0,0:07:34.36,0:07:36.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata dia dan pahlawan Alicia…
Dialogue: 0,0:07:36.35,0:07:40.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, dia dan Alyssa kehilangan kontak?
Dialogue: 0,0:07:40.55,0:07:42.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah orang itu tidak apa-apa?
Dialogue: 0,0:07:47.35,0:07:52.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alyssa Sleihunt hari ini juga absen.
Dialogue: 0,0:07:52.60,0:07:55.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Klen, apakah kau mendengar sesuatu?
Dialogue: 0,0:07:55.45,0:07:56.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali tidak.
Dialogue: 0,0:07:57.15,0:07:59.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rupanya begitu.
Dialogue: 0,0:07:59.25,0:08:03.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dia sudah kembali ke negaranya.
Dialogue: 0,0:08:03.10,0:08:04.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kadang memang ada orang seperti itu.
Dialogue: 0,0:08:04.69,0:08:08.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa mengikuti pelajaran\Ndan akhirnya memilih untuk melarikan diri.
Dialogue: 0,0:08:08.30,0:08:10.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin begitu.
Dialogue: 0,0:08:31.85,0:08:35.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah berapa hari aku tidak makan dan minum?
Dialogue: 0,0:08:36.35,0:08:39.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seolah-olah semuanya\Nsedang membusuk perlahan.
Dialogue: 0,0:08:40.45,0:08:42.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat ini bukanlah dunia nyata.
Dialogue: 0,0:08:42.65,0:08:44.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alasan aku bisa begitu yakin
Dialogue: 0,0:08:45.60,0:08:46.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah karena bayangan diriku
Dialogue: 0,0:08:47.40,0:08:49.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang terpantul di kaca itu
Dialogue: 0,0:08:49.85,0:08:52.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah monster sihir yang terlihat\Nseperti tikus.
Dialogue: 0,0:08:52.65,0:08:55.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemandangan di belakang\Ntidak terlihat ada yang aneh.
Dialogue: 0,0:08:56.19,0:08:57.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, itu adalah
Dialogue: 0,0:08:58.20,0:09:00.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}wujudku di dunia nyata.
Dialogue: 0,0:09:01.50,0:09:04.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kata lain,\Nraksasa yang menangkapku itu
Dialogue: 0,0:09:05.20,0:09:07.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah seseorang yang seukuran manusia.
Dialogue: 0,0:09:07.85,0:09:09.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti itu adalah orang\Nyang saat itu ada di sana,
Dialogue: 0,0:09:09.69,0:09:11.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}si peringkat ketiga di angkatan ini.
Dialogue: 0,0:09:12.45,0:09:16.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah katak itu adalah pakan untukku?
Dialogue: 0,0:09:16.85,0:09:18.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah dia ingin memeliharaku?
Dialogue: 0,0:09:20.25,0:09:22.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, sepertinya bukan.
Dialogue: 0,0:09:25.05,0:09:26.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena
Dialogue: 0,0:09:28.55,0:09:31.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tempat ini adalah\Nfasilitas budidaya miliknya.
Dialogue: 0,0:09:32.95,0:09:36.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini akan dijadikan pakan\Nuntuk makhluk ini.
Dialogue: 0,0:09:42.95,0:09:45.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau selalu saja muncul tiba-tiba, ya,
Dialogue: 0,0:09:46.20,0:09:47.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gart.
Dialogue: 0,0:09:47.35,0:09:49.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjadi sayapmu,
Dialogue: 0,0:09:49.85,0:09:52.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan sebagai imbalannya kau\Nharus memberikan informasi padaku.
Dialogue: 0,0:09:53.85,0:09:56.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang begitulah kontraknya,\NRhode dari Eslinn.
Dialogue: 0,0:09:57.50,0:09:59.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau harus memberikan hasil kerja\Nyang sepadan dengan penerbanganku kali ini.
Dialogue: 0,0:09:59.95,0:10:02.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini tolong panggil aku Barnes.
Dialogue: 0,0:10:03.05,0:10:05.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini aku adalah\Nguru sejarah baru di sini.
Dialogue: 0,0:10:05.85,0:10:09.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu kau datang ke sini\Nuntuk membongkar rahasia Dorel.
Dialogue: 0,0:10:10.00,0:10:11.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuanku juga sama.
Dialogue: 0,0:10:12.35,0:10:13.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kau menemukan sesuatu?
Dialogue: 0,0:10:14.39,0:10:16.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih dalam proses penyelidikan.
Dialogue: 0,0:10:16.56,0:10:18.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk saat ini, aku hanya tahu
Dialogue: 0,0:10:18.25,0:10:21.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahwa tidak ada ruangan semacam ruang\Ntersembunyi di dalam bangunan sekolah.
Dialogue: 0,0:10:22.80,0:10:24.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal ini sudah diselidiki oleh Miquel.
Dialogue: 0,0:10:25.15,0:10:28.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia adalah ahli dalam hal menyusup,\Nmencari, dan mengintai.
Dialogue: 0,0:10:28.35,0:10:30.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena dia yang mengatakannya,\Nmaka itu pasti tidak salah.
Dialogue: 0,0:10:33.05,0:10:35.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut hasil informasi yang kudapat,
Dialogue: 0,0:10:36.05,0:10:40.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di sekolah ini sepertinya sering ada\Nmurid yang menghilang tanpa kabar.
Dialogue: 0,0:10:40.35,0:10:41.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sering?
Dialogue: 0,0:10:41.70,0:10:44.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konon, sebagian besar murid pada akhirnya\Nakan kembali dengan selamat.
Dialogue: 0,0:10:45.15,0:10:49.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya itu adalah ritual yang harus\Ndilalui untuk bisa mempelajari ilmu sihir.
Dialogue: 0,0:10:50.50,0:10:52.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itulah tidak ada yang menganggap\Nfenomena ini sebagai masalah.
Dialogue: 0,0:10:53.15,0:10:56.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan, murid yang lebih cerdas justru\Nmakin menantikan ritual itu.
Dialogue: 0,0:10:57.99,0:11:02.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Murid yang kembali mungkin akan\Nmembangkitkan suatu bakat ilmu sihir.
Dialogue: 0,0:11:02.70,0:11:04.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak memiliki bakat,
Dialogue: 0,0:11:04.39,0:11:07.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia akan menjadi lelah secara fisik\Ndan mental seperti Nathan Franc itu.
Dialogue: 0,0:11:07.59,0:11:10.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu pada akhirnya akan dipaksa\Nuntuk cuti sekolah atau berhenti sekolah.
Dialogue: 0,0:11:11.40,0:11:13.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Singkatnya, ini adalah sebuah penyaringan.
Dialogue: 0,0:11:13.75,0:11:17.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masalahnya, kita masih belum\Nmengetahui metode penyaringannya.
Dialogue: 0,0:11:17.40,0:11:21.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku, ini pasti ada hubungannya\Ndengan "laboratorium rahasia" Dorel.
Dialogue: 0,0:11:21.30,0:11:25.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maka kuncinya tentu saja adalah\Npara murid yang menghilang.
Dialogue: 0,0:11:26.30,0:11:27.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Murid yang saat ini menghilang adalah?
Dialogue: 0,0:11:28.76,0:11:30.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siswa pertukaran dari Hiden,
Dialogue: 0,0:11:31.05,0:11:33.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alyssa Sleihunt.
Dialogue: 0,0:11:33.09,0:11:36.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menemukannya adalah kunci\Nuntuk memecahkan misteri ini.
Dialogue: 0,0:11:37.65,0:11:39.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah menghilang selama tiga hari.
Dialogue: 0,0:11:39.85,0:11:42.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bisa terkena penyaringan kapan saja.
Dialogue: 0,0:11:42.45,0:11:45.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lebih khawatir dia akan dibunuh\Nkarena dianggap sebagai mata-mata.
Dialogue: 0,0:11:45.70,0:11:48.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini terlalu kejam bagi anak-anak\Nyang masih sekecil itu.
Dialogue: 0,0:11:48.99,0:11:52.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah orang ini masih belum menyadari\Nbahwa dia adalah pahlawan?
Dialogue: 0,0:11:52.99,0:11:55.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau juga menemukan sesuatu,\Ntolong beri tahu aku.
Dialogue: 0,0:11:55.80,0:11:58.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang bisa kulakukan\Nhanyalah mengamati dari pinggir.
Dialogue: 0,0:11:58.55,0:12:01.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, apa pun itu, tidak akan ada\Nyang bisa lolos dari pandangan mataku.
Dialogue: 0,0:12:02.70,0:12:05.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ada temuan baru,\Naku akan langsung mengabarimu.
Dialogue: 0,0:12:06.40,0:12:07.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengandalkanmu.
Dialogue: 0,0:12:13.60,0:12:17.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun dia belum tentu bisa\Ndianggap sebagai pihak sekutu,
Dialogue: 0,0:12:18.20,0:12:20.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia benar-benar bisa diandalkan.
Dialogue: 0,0:12:27.05,0:12:28.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang harus aku lakukan?
Dialogue: 0,0:12:31.05,0:12:35.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa pahlawan itu tiba-tiba menghilang?
Dialogue: 0,0:12:35.26,0:12:38.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Mungkin kita akan bisa mengetahui\Nkebenaran tentang laboratorium rahasia."
Dialogue: 0,0:12:38.75,0:12:41.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu dia hanya bicara\Nsampai di sini saja.
Dialogue: 0,0:12:41.14,0:12:44.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat aku ingin bertanya alasan dia pergi,\Ndia ternyata malah menghilang setelah itu.
Dialogue: 0,0:12:44.25,0:12:47.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku juga sedang mencari tempat itu.
Dialogue: 0,0:12:47.34,0:12:52.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak ketemu, jangan-jangan\Naku benar-benar akan dibunuh oleh Kaisar.
Dialogue: 0,0:12:58.96,0:13:03.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Kaisar tahu aku hanya memberi petunjuk\Ndan dia kabur membawa jawaban rahasianya,
Dialogue: 0,0:13:03.20,0:13:07.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kali ini aku pasti akan dibunuh.
Dialogue: 0,0:13:07.55,0:13:09.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa, ini sama sekali\Ntidak boleh terjadi.
Dialogue: 0,0:13:09.75,0:13:13.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melihat alat penyiksaan saja\Naku sudah mati ketakutan.
Dialogue: 0,0:13:13.95,0:13:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku bisa memanipulasi besi, mereka\Npasti mengeksekusiku tanpa menggunakan besi.
Dialogue: 0,0:13:20.25,0:13:21.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panas sekali.
Dialogue: 0,0:13:24.80,0:13:26.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sebenarnya harus kulakukan?
Dialogue: 0,0:13:26.90,0:13:30.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus menemukannya,\Nharus menemukannya…
Dialogue: 0,0:13:30.35,0:13:32.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat ingatlah, Naie Shifonlitz.
Dialogue: 0,0:13:32.40,0:13:35.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa lagi yang dikatakan pahlawan itu?
Dialogue: 0,0:13:36.95,0:13:40.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang akan menghancurkan rahasia\Npemicu itu sebelum perang pecah.
Dialogue: 0,0:13:40.60,0:13:44.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga bilang bahwa dia dan si kembar\Ndari Eslinn menjalin hubungan kerja sama.
Dialogue: 0,0:13:45.85,0:13:47.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa harus si kembar itu?
Dialogue: 0,0:13:47.40,0:13:50.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan dia tidak ada hubungannya\Ndengan dua orang yang datang sebagai guru?
Dialogue: 0,0:13:50.90,0:13:52.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah dia sengaja bekerja sama
Dialogue: 0,0:13:52.50,0:13:56.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan si kembar yang bukan bagian\Ndari militer demi menghindari perang?
Dialogue: 0,0:13:56.80,0:13:58.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau hanya aku sendirian,\Naku pasti tidak akan bisa menemukannya.
Dialogue: 0,0:13:58.90,0:14:01.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku butuh bantuan orang\Nyang memahami kesulitanku.
Dialogue: 0,0:14:03.85,0:14:05.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang itu tidak bisa diandalkan,\Ndia terlalu menakutkan.
Dialogue: 0,0:14:05.75,0:14:08.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada rasa ngeri darinya yang secara naluriah\Ntidak bisa kuterima.
Dialogue: 0,0:14:09.49,0:14:12.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, apakah aku memang\Nharus meminta bantuan murid?
Dialogue: 0,0:14:12.20,0:14:16.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mencari siswa lokal malah\Nakan membuat situasiku jadi lebih buruk.
Dialogue: 0,0:14:16.20,0:14:17.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika mencari siswa pertukaran…
Dialogue: 0,0:14:17.26,0:14:21.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar bodoh, untuk apa membocorkan\Nrahasia ke lebih banyak orang?
Dialogue: 0,0:14:21.74,0:14:26.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal yang bisa kulakukan saat ini adalah…
Dialogue: 0,0:14:27.35,0:14:28.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:14:28.35,0:14:29.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kabur!
Dialogue: 0,0:14:29.75,0:14:33.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba ceritakan tentang hal itu\Ndengan lebih detail.
Dialogue: 0,0:14:34.44,0:14:36.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau!
Dialogue: 0,0:14:36.75,0:14:39.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Bagaimana kau bisa masuk ke sini?
Dialogue: 0,0:14:39.50,0:14:42.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jendelanya tertutup\Ndan pintunya juga dikunci.
Dialogue: 0,0:14:42.55,0:14:45.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, ini adalah asrama wanita\Ndi asrama guru.
Dialogue: 0,0:14:45.80,0:14:49.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku datang mengikuti bayangan\Nyang membawa bau orang itu.
Dialogue: 0,0:14:49.10,0:14:51.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makin lama kau berbicara dengannya,\Nbaunya akan makin pekat.
Dialogue: 0,0:14:51.75,0:14:53.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Bau?
Dialogue: 0,0:14:53.50,0:14:56.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baunya secara alami akan memudar\Nsetelah tiga hari berlalu.
Dialogue: 0,0:14:56.15,0:14:59.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, karena dia tidak kunjung kembali,\Naku pun terpaksa mulai melacaknya.
Dialogue: 0,0:14:59.75,0:15:02.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mencari orang dengan menggunakan bau,\Njangan-jangan kau ini anjing?
Dialogue: 0,0:15:03.70,0:15:05.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan anjing.
Dialogue: 0,0:15:06.29,0:15:09.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, dengan hidungku pun\Naku tidak bisa melacak tubuh aslinya.
Dialogue: 0,0:15:09.80,0:15:11.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah masalah terbesarnya.
Dialogue: 0,0:15:11.76,0:15:17.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bau itu menghilang di kawasan botani\Ndi sisi timur bangunan sekolah.
Dialogue: 0,0:15:17.40,0:15:19.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan jika dia terbunuh,\Nsetidaknya baunya masih akan tertinggal.
Dialogue: 0,0:15:20.29,0:15:23.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, dia menghilang tanpa meninggalkan\Njejak sedikit pun, sungguh membingungkan.
Dialogue: 0,0:15:24.20,0:15:26.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar bagaimanapun,\Norang itu adalah seorang pahlawan.
Dialogue: 0,0:15:27.19,0:15:29.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada tanda-tanda perlawanan apa pun\Nyang terlihat di tempat kejadian.
Dialogue: 0,0:15:30.60,0:15:33.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika dia lari keluar\Nsetelah berbicara denganmu,
Dialogue: 0,0:15:33.65,0:15:38.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maka itu berarti dia telah menemukan jawaban\Npenting dengan caranya sendiri, 'kan?
Dialogue: 0,0:15:39.59,0:15:42.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat katakan.\NKatakan semua hal yang kau ketahui.
Dialogue: 0,0:15:42.85,0:15:44.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katakan padaku tentang kekuatan\Nyang didapatkan orang-orang di tempat ini
Dialogue: 0,0:15:44.65,0:15:46.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan hubungannya dengan kemunculan\Nmonster sihir.
Dialogue: 0,0:15:47.60,0:15:50.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Juga ceritakan setiap patah kata\Ndari percakapan kalian.
Dialogue: 0,0:15:50.90,0:15:55.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika perlu, aku akan memaksamu bicara,\Nbahkan bila harus mengaduk otakmu.
Dialogue: 0,0:15:55.75,0:15:58.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kau ini kenapa?
Dialogue: 0,0:15:58.70,0:16:01.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau bisa mengatakan hal\Nyang sangat mengerikan seperti itu?
Dialogue: 0,0:16:02.25,0:16:05.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ucapanmu yang bilang ingin mengaduk otakku\Nitu sama sekali tidak bercanda, 'kan?
Dialogue: 0,0:16:05.69,0:16:08.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga membicarakan tentang bayangan\Ndan mencari orang dengan penciuman…
Dialogue: 0,0:16:08.40,0:16:11.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kau benar-benar manusia?
Dialogue: 0,0:16:13.66,0:16:14.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan…
Dialogue: 0,0:16:16.05,0:16:18.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa sekarang kau mau buka mulut?
Dialogue: 0,0:16:19.09,0:16:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah melihat wujud ini,\Nseharusnya kau mengerti, 'kan?
Dialogue: 0,0:16:22.70,0:16:24.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau tidak mematuhiku,
Dialogue: 0,0:16:25.25,0:16:26.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau akan mati.
Dialogue: 0,0:16:27.70,0:16:30.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memastikan kau mati\Ndengan cara yang mengenaskan.
Dialogue: 0,0:16:31.70,0:16:33.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini benar-benar tidak ada harapan lagi.
Dialogue: 0,0:16:34.45,0:16:36.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habislah riwayatku.
Dialogue: 0,0:16:37.55,0:16:40.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sudah mengerti, cepat katakan.
Dialogue: 0,0:16:45.46,0:16:47.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan seenaknya pingsan.
Dialogue: 0,0:16:55.65,0:16:58.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sakit sekali.\N- Kau sudah sadar?
Dialogue: 0,0:16:58.95,0:17:00.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sakit sekali.\N- Kalau begitu, cepat katakan.
Dialogue: 0,0:17:01.55,0:17:03.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, Master.
Dialogue: 0,0:17:05.84,0:17:07.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun terserahlah.
Dialogue: 0,0:17:11.00,0:17:12.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:17:12.25,0:17:14.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peristiwa yang terjadi di sini
Dialogue: 0,0:17:14.25,0:17:17.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}meniru sebagian dari konten\Ndi dalam Warisan Pahlawan.
Dialogue: 0,0:17:17.90,0:17:19.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desa Awal, ya?
Dialogue: 0,0:17:19.55,0:17:21.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zavtier juga pernah menyebutkan tentang ini.
Dialogue: 0,0:17:21.95,0:17:25.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti akan kutanyakan kepada pelayanku itu\Ntentang hal apa yang dia sadari.
Dialogue: 0,0:17:25.75,0:17:29.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya adalah tentang manusia\Nyang berubah menjadi monster sihir.
Dialogue: 0,0:17:29.49,0:17:31.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar. Di generasiku,\Nmurid yang tidak bisa beradaptasi
Dialogue: 0,0:17:31.55,0:17:36.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan ilmu sihir kristal pasti akan\Nberubah wujudnya menjadi monster sihir.
Dialogue: 0,0:17:36.20,0:17:39.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu hampir tidak bisa kembali\Nke wujud semula,
Dialogue: 0,0:17:39.73,0:17:42.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi sekarang sepertinya berbeda.
Dialogue: 0,0:17:42.39,0:17:46.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak punya ingatan saat itu,\Njadi aku hanya mendengar dari orang lain.
Dialogue: 0,0:17:47.05,0:17:51.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya cobaan itu adalah ujian\Napakah peserta bisa menundukkan kekuatan itu.
Dialogue: 0,0:17:51.40,0:17:54.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asalkan bisa menundukkannya,\Nmaka mereka akan mendapatkan kekuatannya.
Dialogue: 0,0:17:54.69,0:17:58.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ditelan olehnya, hati mereka pun\Nakan berubah menjadi monster sihir.
Dialogue: 0,0:17:58.00,0:18:00.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu diburu oleh para guru\Natau murid yang lain.
Dialogue: 0,0:18:02.15,0:18:06.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kemungkinan pelayanku itu terseret\Nke dalam cobaan yang kau sebutkan tadi.
Dialogue: 0,0:18:07.76,0:18:12.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya saat ini sudah heboh\Nmembicarakan kemunculan monster sihir.
Dialogue: 0,0:18:12.60,0:18:14.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalaupun dia mendapatkan kekuatan,
Dialogue: 0,0:18:14.30,0:18:16.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seharusnya dia sudah keluar sejak tadi.
Dialogue: 0,0:18:17.00,0:18:22.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa jadi dia malah dipenjara di suatu tempat\Ndengan wujud monster sihirnya.
Dialogue: 0,0:18:24.75,0:18:26.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika demikian,
Dialogue: 0,0:18:26.00,0:18:29.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pertanyaannya adalah siapa pelakunya\Ndan apa tujuan pihak tersebut?
Dialogue: 0,0:18:30.40,0:18:36.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika mereka tahu dia pahlawan penakluk Dorel\Ntetapi sengaja melakukannya, berarti…
Dialogue: 0,0:18:38.95,0:18:40.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah tujuannya adalah ini?
Dialogue: 0,0:18:41.00,0:18:42.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mungkin mengira karena si pahlawan\Nsaat ini sedang tidak ada,
Dialogue: 0,0:18:42.95,0:18:44.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan aku sedang berada di luar wilayahku,
Dialogue: 0,0:18:44.64,0:18:47.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maka dia bisa dengan mudah\Nmerebut benda ini dariku.
Dialogue: 0,0:18:47.20,0:18:50.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku sepertinya pernah melihat\Nbuku ini di suatu tempat.
Dialogue: 0,0:18:50.75,0:18:53.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sungguh meremehkanku, ya?
Dialogue: 0,0:18:59.29,0:19:03.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atapnya hancur!
Dialogue: 0,0:19:27.05,0:19:28.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi?
Dialogue: 0,0:19:36.65,0:19:39.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Clevatess, jangan-jangan…
Dialogue: 0,0:19:43.54,0:19:45.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benda apa itu?
Dialogue: 0,0:19:47.00,0:19:49.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menara Hitam?
Dialogue: 0,0:19:55.30,0:19:58.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuatu yang kalian hasratkan ada di sini.
Dialogue: 0,0:20:00.05,0:20:01.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tepat di tempat ini.
Dialogue: 0,0:20:02.00,0:20:04.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kalian mau, datang dan ambillah sendiri.
Dialogue: 0,0:20:07.40,0:20:08.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menara apakah itu?
Dialogue: 0,0:20:09.65,0:20:12.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara barusan itu berasal dari sana, 'kan?
Dialogue: 0,0:20:12.40,0:20:14.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata orang itu, Andrew.
Dialogue: 0,0:20:15.85,0:20:18.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"lambang kutukan" milikku bergejolak.
Dialogue: 0,0:20:21.05,0:20:22.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah merasakan
Dialogue: 0,0:20:23.06,0:20:25.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}perasaan seperti ini\Nsejak pertama kali melihatnya.
Dialogue: 0,0:20:27.29,0:20:31.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pasti perbuatannya, tidak salah lagi.
Dialogue: 0,0:20:32.84,0:20:33.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Heiyo!
Dialogue: 0,0:20:34.45,0:20:38.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang dari pihak Selatan sepertinya\Nmulai melakukan hal yang menarik ya.
Dialogue: 0,0:20:39.60,0:20:40.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, cepat lihat!
Dialogue: 0,0:20:43.00,0:20:44.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru Barnes.
Dialogue: 0,0:20:44.85,0:20:46.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sedang melihatnya.
Dialogue: 0,0:20:47.00,0:20:48.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara barusan itu juga.
Dialogue: 0,0:20:49.60,0:20:50.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sedang terjadi?
Dialogue: 0,0:20:54.10,0:20:56.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siang tadi menara itu belum ada, 'kan?
Dialogue: 0,0:20:56.65,0:20:58.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, pergilah ke sana untuk memeriksanya.
Dialogue: 0,0:20:58.20,0:20:59.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau.
Dialogue: 0,0:20:59.75,0:21:03.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan itu adalah cobaan\Nuntuk bisa mendapatkan lambang kutukan?
Dialogue: 0,0:21:03.55,0:21:04.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar saja?
Dialogue: 0,0:21:05.46,0:21:06.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harap tenang.
Dialogue: 0,0:21:07.95,0:21:10.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku adalah kepala sekolah ini, Elro Romain.
Dialogue: 0,0:21:11.40,0:21:13.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para murid sekalian,
Dialogue: 0,0:21:13.20,0:21:17.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan seluruh staf pengajar sekolah ini,\Ntolong bertindaklah dengan tenang.
Dialogue: 0,0:21:18.20,0:21:20.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah sebuah pelatihan.
Dialogue: 0,0:21:20.39,0:21:21.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelatihan?
Dialogue: 0,0:21:21.58,0:21:23.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka yang tidak bisa melawan suara ini,
Dialogue: 0,0:21:23.65,0:21:25.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}segeralah kembali\Nke kamar asrama masing-masing.
Dialogue: 0,0:21:25.85,0:21:29.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kunci pintu kamar,\Ndan tidurlah dengan lelap.
Dialogue: 0,0:21:31.35,0:21:34.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, dimengerti.
Dialogue: 0,0:21:39.35,0:21:42.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah tidak apa-apa\Nuntuk mulai beraksi sekarang?
Dialogue: 0,0:21:43.10,0:21:44.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun ini situasi darurat,
Dialogue: 0,0:21:44.90,0:21:47.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat ini ada banyak mata-mata\Nyang menyusup ke dalam sekolah…
Dialogue: 0,0:21:47.55,0:21:49.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebanyak apa pun mata-mata yang datang,
Dialogue: 0,0:21:49.64,0:21:51.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka tidak akan berdaya\Ndi hadapan buku ini.
Dialogue: 0,0:21:52.55,0:21:56.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, sesuatu semacam itu sama sekali\Ntidak boleh ditoleransi di sini.
Dialogue: 0,0:21:56.05,0:22:02.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menempatkan benda asing kotor semacam itu\Ndi Solsein, tempat suci dari "Desa Awal",
Dialogue: 0,0:22:04.35,0:22:07.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah hal yang mutlak tidak bisa dimaafkan.
