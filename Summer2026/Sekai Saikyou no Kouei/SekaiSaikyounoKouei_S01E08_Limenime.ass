Dialogue: 0,0:05:08.12,0:05:09.96,sign,,0000,0000,0000,,SWEET BIRD MENGAKTIFKAN PESTA SAYAP\NATK DAN DEF MONSTER BERSAYAP MENINGKAT SEMENTARA
Dialogue: 0,0:05:20.68,0:05:21.97,sign,,0000,0000,0000,,BERDIRI DI BELAKANG
Dialogue: 0,0:06:51.18,0:06:52.18,sign,,0000,0000,0000,,INFORMASI DELEGASI WEWENANG\NHAK KEPEMILIKAN SHION
Dialogue: 0,0:06:52.18,0:06:55.52,sign,,0000,0000,0000,,DIALIHKAN DARI FALMA KE ARIHITO
Dialogue: 0,0:09:30.42,0:09:31.68,sign,,0000,0000,0000,,MAUT LANGIT\NMENGAKTIFKAN KILAU API
Dialogue: 0,0:09:31.68,0:09:32.89,sign,,0000,0000,0000,,MENGAKTIFKAN LANGKAH KILAT\NMENGHINDAR DARI KILAU API
