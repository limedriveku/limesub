Dialogue: 0,0:10:31.32,0:10:32.74,sign,,0000,0000,0000,,MENGAKTIFKAN BANTUAN DARI LUAR\NMENGAKTIFKAN PERTAHANAN DUKUNGAN LV. 1
Dialogue: 0,0:10:32.74,0:10:33.49,sign,,0000,0000,0000,,TARGET: RIVAL
Dialogue: 0,0:11:02.77,0:11:05.73,sign,,0000,0000,0000,,ARIHITO MEMINTA DUKUNGAN SEMENTARA\NKEPADA ARIADNE
Dialogue: 0,0:11:17.78,0:11:18.63,sign,,0000,0000,0000,,THERESIA\NSEMANGAT TEMPUR, MENGAKTIFKAN TRIPLE STEAL
Dialogue: 0,0:11:18.63,0:11:19.28,sign,,0000,0000,0000,,MEMBERIKAN EFEK KE SELURUH ANGGOTA PARTY
Dialogue: 0,0:11:41.60,0:11:43.02,sign,,0000,0000,0000,,BERHASIL MENUMPAS 1 MAUT LANGIT
Dialogue: 0,0:11:58.99,0:12:01.47,sign,,0000,0000,0000,,GARDA BELAKANG TERKUAT DI DUNIA
