Dialogue: 0,0:16:00.52,0:16:00.98,sign,,0000,0000,0000,,POIN KONTRIBUSI PENJELAJAH: 5.100
Dialogue: 0,0:16:00.98,0:16:02.65,sign,,0000,0000,0000,,PERINGKAT DISTRIK 8: 1
Dialogue: 0,0:16:02.65,0:16:04.52,sign,,0000,0000,0000,,PERINGKAT DISTRIK 7: 332
Dialogue: 0,0:17:08.88,0:17:09.83,sign,,0000,0000,0000,,LAPORAN PEMOTONGAN DARI TEMPAT JAGAL
Dialogue: 0,0:19:48.67,0:19:50.63,sign,,0000,0000,0000,,LEMPARAN GANDA: MELEMPAR DUA SENJATA BERSAMAAN
Dialogue: 0,0:19:50.63,0:19:51.72,sign,,0000,0000,0000,,SERANGAN PUKULAN: MENYERANG TANPA
Dialogue: 0,0:19:51.72,0:19:52.65,sign,,0000,0000,0000,,KETAHUAN DAN MELIPATGANDAKAN DMG
Dialogue: 0,0:19:52.65,0:19:53.52,sign,,0000,0000,0000,,TEKNIK JARI: MEMBUKA KUNCI DAN MELEPASKAN
Dialogue: 0,0:19:53.52,0:19:54.17,sign,,0000,0000,0000,,JEBAKAN TINGKAT MENENGAH
Dialogue: 0,0:19:54.17,0:19:55.03,sign,,0000,0000,0000,,BERSEMBUNYI: SAMA SEKALI TAK TERDETEKSI
Dialogue: 0,0:19:55.03,0:19:55.84,sign,,0000,0000,0000,,SAMPAI MELAKUKAN SERANGAN
Dialogue: 0,0:20:02.06,0:20:03.17,sign,,0000,0000,0000,,KOMANDAN BELAKANG: MAKIN BANYAK REKAN DI DEPAN,
Dialogue: 0,0:20:03.17,0:20:04.80,sign,,0000,0000,0000,,MAKIN MENINGKAT KEMAMPUAN DIRI SENDIRI
Dialogue: 0,0:20:06.23,0:20:07.89,sign,,0000,0000,0000,,BANTUAN PENGISIAN: MEMBAGIKAN SEBAGIAN KECIL
Dialogue: 0,0:20:07.89,0:20:09.31,sign,,0000,0000,0000,,MANA KE REKAN DI DEPAN
Dialogue: 0,0:00:07.74,0:00:08.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak apa-apa?
Dialogue: 0,0:00:10.37,0:00:11.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengungsilah ke Guild.
Dialogue: 0,0:00:12.83,0:00:15.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa ada monster di luar labirin?
Dialogue: 0,0:00:15.59,0:00:16.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu serbuan monster.
Dialogue: 0,0:00:16.96,0:00:19.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk menjaga labirin tetap stabil,
Dialogue: 0,0:00:19.54,0:00:22.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}monster yang terlalu banyak\Nakan dikeluarkan.
Dialogue: 0,0:00:22.48,0:00:24.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kelalaian kami.
Dialogue: 0,0:00:25.13,0:00:28.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jumlah perburuan monster\Ndi Rawa Kantuk menurun drastis.
Dialogue: 0,0:00:28.97,0:00:32.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya, penanganannya lamban\Nhingga jadi seperti ini.
Dialogue: 0,0:00:32.04,0:00:33.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para penjaga juga kewalahan,
Dialogue: 0,0:00:33.89,0:00:36.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi tak bisa langsung datang ke sini.
Dialogue: 0,0:00:36.18,0:00:39.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suzuna, ambillah kemampuan Garam Pemurni.
Dialogue: 0,0:00:39.27,0:00:40.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:00:40.21,0:00:41.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah ada garam?
Dialogue: 0,0:00:41.52,0:00:43.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan segera saya siapkan.
Dialogue: 0,0:00:44.32,0:00:47.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Atobe, tolong lindungi kota ini.
Dialogue: 0,0:00:47.94,0:00:50.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti akan melindunginya.
Dialogue: 0,0:02:31.09,0:02:33.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suzuna sudah membuat penghalang\Ndengan Garam Pemurni,
Dialogue: 0,0:02:33.97,0:02:35.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi di dalam sini aman.
Dialogue: 0,0:02:36.05,0:02:38.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadikanlah ini sebagai tempat pengungsian.
Dialogue: 0,0:02:38.73,0:02:39.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya mengerti.
Dialogue: 0,0:02:39.89,0:02:42.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arihito, tampilkan peta di lisensimu.
Dialogue: 0,0:02:45.40,0:02:47.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat Serbuan Monster seperti ini,
Dialogue: 0,0:02:47.36,0:02:50.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}posisi monster di seluruh kota\Nbisa terdeteksi.
Dialogue: 0,0:02:50.40,0:02:54.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kawanan besar\Ndi pintu masuk Padang Fajar.
Dialogue: 0,0:02:54.03,0:02:56.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah yang di tengah itu monster bernama?
Dialogue: 0,0:02:56.28,0:03:00.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita ke arah Padang Fajar\Nsambil membereskan monster di jalan.
Dialogue: 0,0:03:00.33,0:03:04.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suzuna, pakai Garam Pemurni di bangunan\Nuntuk dijadikan tempat pengungsian
Dialogue: 0,0:03:04.08,0:03:05.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan perbanyak zona aman.
Dialogue: 0,0:03:05.79,0:03:06.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:03:07.17,0:03:09.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misaki, tolong kawal Suzuna.
Dialogue: 0,0:03:10.29,0:03:12.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elitia dan Igarashi di garis depan.
Dialogue: 0,0:03:12.67,0:03:14.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia fleksibel.
Dialogue: 0,0:03:15.22,0:03:17.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ayo.
Dialogue: 0,0:03:24.52,0:03:27.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tak bisa apa-apa\Nkalau mereka tak menyerang duluan.
Dialogue: 0,0:03:27.60,0:03:28.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu...
Dialogue: 0,0:03:28.48,0:03:31.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elitia, apa kamu bisa\Nmemancing perhatian musuh?
Dialogue: 0,0:03:31.73,0:03:33.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan masalah!
Dialogue: 0,0:03:33.32,0:03:36.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Igarashi, gunakan Decoy pada Elitia!
Dialogue: 0,0:03:36.03,0:03:37.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:03:37.21,0:03:40.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai jiwa pemberani, pancinglah musuh.
Dialogue: 0,0:03:40.45,0:03:41.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Decoy!
Dialogue: 0,0:03:57.22,0:03:59.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zona aman berhasil didapatkan!
Dialogue: 0,0:04:06.31,0:04:08.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi Harpy?
Dialogue: 0,0:04:08.06,0:04:10.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada musuh baru mendekat!
Dialogue: 0,0:04:10.01,0:04:11.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhati-hatilah!
Dialogue: 0,0:04:11.98,0:04:13.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa kumpulkan 100 sebelum
Dialogue: 0,0:04:13.45,0:04:14.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lawan monster bernama,
Dialogue: 0,0:04:14.69,0:04:16.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat Tempur bisa diaktifkan.
Dialogue: 0,0:04:18.57,0:04:20.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rising Zapper!
Dialogue: 0,0:04:35.67,0:04:37.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Lagu?
Dialogue: 0,0:04:38.93,0:04:41.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atobe...
Dialogue: 0,0:04:49.89,0:04:52.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, bertahanlah!
Dialogue: 0,0:04:54.90,0:04:56.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia, ya.
Dialogue: 0,0:04:58.49,0:04:59.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial.
Dialogue: 0,0:05:15.34,0:05:16.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia tidak akan sempat.
Dialogue: 0,0:05:16.98,0:05:18.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak akan kubiarkan Elitia kena!
Dialogue: 0,0:05:19.55,0:05:20.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Back Stand!
Dialogue: 0,0:05:32.85,0:05:35.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Atobe, Anda baik-baik saja?
Dialogue: 0,0:05:36.65,0:05:38.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:05:38.19,0:05:39.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jaga teman-temanku.
Dialogue: 0,0:05:41.61,0:05:44.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mereka pakai Lagu Tidur lagi,\Nkami bisa tamat.
Dialogue: 0,0:05:45.78,0:05:46.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Back Stand!
Dialogue: 0,0:05:51.50,0:05:53.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shion, tangkap mereka!
Dialogue: 0,0:06:09.68,0:06:11.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah membuatmu khawatir.
Dialogue: 0,0:06:11.75,0:06:13.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa memikirkan cara lain.
Dialogue: 0,0:06:20.07,0:06:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak memikirkan efek\Ndari status abnormal.
Dialogue: 0,0:06:23.24,0:06:26.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kecerobohanku,\Nkalian jadi dalam bahaya.
Dialogue: 0,0:06:29.91,0:06:31.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Falma.
Dialogue: 0,0:06:32.75,0:06:35.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia, ulurkan tanganmu.
Dialogue: 0,0:06:36.17,0:06:38.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini, efek tidur bisa dicegah.
Dialogue: 0,0:06:38.34,0:06:40.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah banyak membantu.
Dialogue: 0,0:06:40.76,0:06:43.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak apa, syukurlah tepat waktu.
Dialogue: 0,0:06:43.25,0:06:47.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shion menyadari Tuan Atobe\Nsedang bertarung dan langsung lari kemari.
Dialogue: 0,0:06:47.43,0:06:50.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Atobe, lisensinya.
Dialogue: 0,0:06:52.18,0:06:55.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga pasti berharap bisa berguna bagimu.
Dialogue: 0,0:06:58.06,0:06:59.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan aku terima.
Dialogue: 0,0:07:03.56,0:07:07.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mendengar lagu aneh\Nlalu tiba-tiba mengantuk.
Dialogue: 0,0:07:07.37,0:07:09.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu ulah monster.
Dialogue: 0,0:07:09.39,0:07:13.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan bantuan Shion dan induknya,\Nkami berhasil mengalahkannya.
Dialogue: 0,0:07:14.91,0:07:16.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia, ya.
Dialogue: 0,0:07:17.25,0:07:20.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah ditangkap harus kita apakan?
Dialogue: 0,0:07:20.15,0:07:22.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tak bisa membiarkannya begini.
Dialogue: 0,0:07:22.30,0:07:26.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau dimasukkan\Nke peternakan monster?
Dialogue: 0,0:07:26.25,0:07:27.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peternakan monster?
Dialogue: 0,0:07:27.84,0:07:30.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat memelihara monster\Nyang bisa dijinakkan.
Dialogue: 0,0:07:30.76,0:07:34.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nantinya bisa dipanggil pakai batu pemanggil.
Dialogue: 0,0:07:34.10,0:07:37.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya bisa dijadikan kekuatan tempur?
Dialogue: 0,0:07:37.05,0:07:39.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya akan berguna.
Dialogue: 0,0:07:39.15,0:07:41.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti akan kubantu bawa.
Dialogue: 0,0:07:41.40,0:07:42.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:07:46.70,0:07:49.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang tak perlu cemas akan tertidur.
Dialogue: 0,0:07:49.23,0:07:51.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Atobe, yang ini juga.
Dialogue: 0,0:07:51.49,0:07:53.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlengkapan untuk mencegah kebingungan.
Dialogue: 0,0:07:53.74,0:07:56.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya Arihito sebagai pemimpin\Nyang memakainya.
Dialogue: 0,0:07:56.40,0:07:58.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama kamu masih berdiri,
Dialogue: 0,0:07:58.40,0:07:59.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami pasti akan baik-baik saja.
Dialogue: 0,0:08:02.84,0:08:06.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjelajah lain sudah menekan jumlah monster.
Dialogue: 0,0:08:06.25,0:08:08.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggal monster bernama saja.
Dialogue: 0,0:08:08.01,0:08:09.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita kalahkan.
Dialogue: 0,0:08:22.44,0:08:23.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan.
Dialogue: 0,0:08:28.95,0:08:29.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ke sini!
Dialogue: 0,0:08:29.82,0:08:32.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arihito, jangan lihat ke arahnya!
Dialogue: 0,0:08:42.84,0:08:43.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Rival!
Dialogue: 0,0:08:43.75,0:08:45.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berpencar dan lari!
Dialogue: 0,0:08:48.38,0:08:49.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shion, lakukan!
Dialogue: 0,0:09:00.64,0:09:03.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suzuna, Misaki, kita kalahkan dia dulu!
Dialogue: 0,0:09:03.84,0:09:04.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:09:18.29,0:09:19.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leila!
Dialogue: 0,0:09:19.65,0:09:20.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubantu!
Dialogue: 0,0:09:23.04,0:09:24.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat.
Dialogue: 0,0:09:24.21,0:09:25.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan padaku!
Dialogue: 0,0:09:36.26,0:09:39.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama cooldown,\Ndia tidak menembakkan sinar panasnya?
Dialogue: 0,0:09:39.16,0:09:41.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinan sekitar 15 detik.
Dialogue: 0,0:09:41.39,0:09:44.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, bersembunyilah\Nbegitu aku beri aba-aba!
Dialogue: 0,0:09:44.40,0:09:45.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:09:50.74,0:09:52.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisanya tinggal monster bernama itu!
Dialogue: 0,0:09:52.76,0:09:55.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar lagi serangannya datang, sembunyi!
Dialogue: 0,0:09:58.66,0:10:00.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak menembak?
Dialogue: 0,0:10:00.04,0:10:01.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kehabisan mana?
Dialogue: 0,0:10:02.08,0:10:02.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:10:11.88,0:10:13.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Back Stand...
Dialogue: 0,0:10:13.16,0:10:15.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu hanya akan membuat kami dimakan.
Dialogue: 0,0:10:15.28,0:10:17.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini? Aku ingin menolongnya!
Dialogue: 0,0:10:17.14,0:10:20.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menolongnya!
Dialogue: 0,0:10:23.31,0:10:24.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ariadne!
Dialogue: 0,0:10:24.73,0:10:27.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lindungilah orang yang aku beri dukungan!
Dialogue: 0,0:10:27.48,0:10:29.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Rival, akan kuberi dukungan!
Dialogue: 0,0:10:35.57,0:10:38.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertahanan Dukungan\Ntak akan cukup menahannya.
Dialogue: 0,0:10:38.12,0:10:40.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayolah, aku mohon!
Dialogue: 0,0:10:42.75,0:10:44.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku adalah Ariadne.
Dialogue: 0,0:10:45.21,0:10:48.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuberikan berkah pada mereka
Dialogue: 0,0:10:49.04,0:10:50.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang mengikutiku.
Dialogue: 0,0:11:10.11,0:11:11.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang waktunya!
Dialogue: 0,0:11:11.44,0:11:12.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita habisi dia!
Dialogue: 0,0:11:12.61,0:11:14.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelepasan Semangat Tempur, Soul Blink!
Dialogue: 0,0:11:14.61,0:11:17.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelepasan Semangat Tempur, Fortune Roll!
Dialogue: 0,0:11:21.58,0:11:25.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gugurlah seperti bunga, Blossom Blade!
Dialogue: 0,0:11:44.10,0:11:45.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhasil.
Dialogue: 0,0:11:49.44,0:11:53.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kamu ingin menyelamatkan seseorang,
Dialogue: 0,0:11:53.03,0:11:55.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan menjawab keinginanmu,
Dialogue: 0,0:11:55.82,0:11:58.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}wahai Garda Belakang yang teguh.
Dialogue: 0,0:11:58.99,0:12:01.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba tebak, siapa namaku?
Dialogue: 0,0:12:01.47,0:12:03.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petunjuknya dimulai dari "Ma".
Dialogue: 0,0:12:05.54,0:12:08.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Giliranku sudah selesai.
Dialogue: 0,0:12:09.00,0:12:10.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan.
Dialogue: 0,0:12:10.51,0:12:12.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakailah ini.
Dialogue: 0,0:12:12.00,0:12:14.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, tolong bantu di sini.
Dialogue: 0,0:12:15.42,0:12:19.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harpy ini juga harus kita serahkan\Nke peternakan monster.
Dialogue: 0,0:12:19.55,0:12:21.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hasil tangkapan kita.
Dialogue: 0,0:12:22.02,0:12:23.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:12:23.44,0:12:26.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batu sihir yang drop dari monster bernama.
Dialogue: 0,0:12:26.24,0:12:28.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Efeknya masih belum diketahui.
Dialogue: 0,0:12:28.98,0:12:32.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seingatku ada gulungan identifikasi\Nyang didapat dari kotak hitam.
Dialogue: 0,0:12:38.45,0:12:40.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batu Kebingungan?
Dialogue: 0,0:12:40.41,0:12:44.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti efek khususnya\Nbisa membuat kebingungan.
Dialogue: 0,0:12:44.54,0:12:46.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya begitu.
Dialogue: 0,0:12:46.24,0:12:49.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tadi dipakai musuh,\Nkita pasti saling menyerang.
Dialogue: 0,0:12:49.03,0:12:51.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung selesai duluan sebelum mereka pakai.
Dialogue: 0,0:12:56.30,0:12:57.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Rival.
Dialogue: 0,0:12:59.09,0:13:00.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada yang terluka?
Dialogue: 0,0:13:00.76,0:13:02.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada.
Dialogue: 0,0:13:02.01,0:13:04.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memang hebat, ya.
Dialogue: 0,0:13:04.41,0:13:07.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang aku malah jadi pihak yang ditolong.
Dialogue: 0,0:13:07.98,0:13:10.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tadi kamu tak melindungiku\Ndari sinar panas,
Dialogue: 0,0:13:10.69,0:13:13.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku pasti sudah gosong.
Dialogue: 0,0:13:14.19,0:13:16.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang jelas, terima kasih.
Dialogue: 0,0:13:19.86,0:13:21.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arihito.
Dialogue: 0,0:13:22.07,0:13:24.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi-lagi kamu dapat tangkapan besar.
Dialogue: 0,0:13:24.45,0:13:27.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melissa, Pak Rikerton,\Nsyukurlah kalian baik-baik saja.
Dialogue: 0,0:13:27.87,0:13:33.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski yang bisa kulakukan hanya mengalahkan\Nmonster yang muncul di sekitar toko.
Dialogue: 0,0:13:33.03,0:13:36.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku boleh memotong\Nmonster bernama yang kamu dapat?
Dialogue: 0,0:13:36.09,0:13:38.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, silakan.
Dialogue: 0,0:13:42.34,0:13:45.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leila, apa ada yang perlu dibantu?
Dialogue: 0,0:13:45.33,0:13:47.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu repot-repot.
Dialogue: 0,0:13:47.85,0:13:49.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada itu, Arihito,
Dialogue: 0,0:13:49.81,0:13:51.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kemampuan macam apa itu?
Dialogue: 0,0:13:51.56,0:13:54.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa melakukan "pemanggilan"?
Dialogue: 0,0:13:54.29,0:13:56.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin bisa dibilang begitu.
Dialogue: 0,0:13:56.44,0:13:58.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggap saja itu kemampuan tipe pertahanan.
Dialogue: 0,0:13:59.69,0:14:01.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:14:01.04,0:14:04.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau memang rahasia party,\Naku tak akan menanyakannya lebih jauh.
Dialogue: 0,0:14:04.92,0:14:06.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:14:10.95,0:14:12.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak apa-apa?
Dialogue: 0,0:14:13.29,0:14:15.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya kamu tidak terluka.
Dialogue: 0,0:14:15.29,0:14:20.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, abang yang waktu itu beli item.
Dialogue: 0,0:14:20.84,0:14:22.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku bantu bereskan.
Dialogue: 0,0:14:23.47,0:14:25.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, terima kasih.
Dialogue: 0,0:14:25.93,0:14:27.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya aku pun
Dialogue: 0,0:14:27.97,0:14:32.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ingin menaikkan level\Ndan menguasai beberapa kemampuan.
Dialogue: 0,0:14:32.03,0:14:36.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, di labirin pertama pun\Naku tak bisa menjelajah dengan baik.
Dialogue: 0,0:14:36.56,0:14:39.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya aku ingin\Nlakukan yang bisa kulakukan,
Dialogue: 0,0:14:39.32,0:14:43.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku menjual senjata\Ndengan harga murah ke para pemula.
Dialogue: 0,0:14:44.71,0:14:47.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi itu pun sudah berakhir.
Dialogue: 0,0:14:47.28,0:14:49.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tak punya apa-apa lagi.
Dialogue: 0,0:14:52.04,0:14:53.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau berkenan,
Dialogue: 0,0:14:53.64,0:14:57.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa kamu mau menjadi\Npedagang eksklusif party kami?
Dialogue: 0,0:14:58.00,0:15:00.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan membentuk party\Ndan saling membantu,
Dialogue: 0,0:15:00.71,0:15:03.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kelas pekerjaan apa pun\Nbisa naik ke distrik atas.
Dialogue: 0,0:15:03.65,0:15:05.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggotaku juga bertambah,
Dialogue: 0,0:15:05.49,0:15:08.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku ingin orang yang bisa\Nbantu beli dan identifikasi item.
Dialogue: 0,0:15:09.51,0:15:11.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku masih level 2.
Dialogue: 0,0:15:11.93,0:15:14.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga masih level 2.
Dialogue: 0,0:15:14.60,0:15:16.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita sama-sama menjadi kuat.
Dialogue: 0,0:15:16.83,0:15:20.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersama Arihito pasti akan menyenangkan.
Dialogue: 0,0:15:20.67,0:15:25.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kamu yakin dengan orang sepertiku?
Dialogue: 0,0:15:27.82,0:15:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Atobe Arihito.
Dialogue: 0,0:15:31.96,0:15:35.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Shinonogi Madoka, mohon bantuannya.
Dialogue: 0,0:15:39.17,0:15:43.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya ucapkan terima kasih banyak\Ntelah menyelamatkan Distrik 8 ini.
Dialogue: 0,0:15:43.55,0:15:46.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kita bisa melewatinya dengan aman.
Dialogue: 0,0:15:46.04,0:15:50.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harap orang-orang yang terluka\Nbisa pulih secepatnya.
Dialogue: 0,0:15:50.39,0:15:54.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas kata-kata hangatnya.
Dialogue: 0,0:15:54.02,0:15:56.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, ini lisensinya.
Dialogue: 0,0:15:56.35,0:15:58.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan saya periksa.
Dialogue: 0,0:16:00.98,0:16:02.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, sudah kuduga.
Dialogue: 0,0:16:02.65,0:16:04.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:16:04.52,0:16:07.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Tuan Atobe telah memberikan\Nkontribusi yang sangat besar,
Dialogue: 0,0:16:07.64,0:16:12.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guild telah memasukkan Anda\Nke jajaran Distrik 7.
Dialogue: 0,0:16:12.99,0:16:14.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya aku naik tingkat?
Dialogue: 0,0:16:14.91,0:16:17.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, saya rasa itu hal yang wajar.
Dialogue: 0,0:16:17.96,0:16:21.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, rasanya aneh kalau tanpa ujian.
Dialogue: 0,0:16:21.38,0:16:26.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menjalani ujian bersama Polaris\Nyang satu penginapan denganku.
Dialogue: 0,0:16:26.05,0:16:27.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengenai mereka,
Dialogue: 0,0:16:27.93,0:16:31.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pagi-pagi sekali sudah mengikuti ujian\Ndi Hutan Panggilan.
Dialogue: 0,0:16:31.89,0:16:34.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas saja tidak kelihatan.
Dialogue: 0,0:16:34.81,0:16:38.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah ujiannya bisa\Nmemakan waktu berhari-hari?
Dialogue: 0,0:16:38.27,0:16:39.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:16:39.44,0:16:43.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di Distrik 7,\Nujiannya harus berkemah di dalam labirin,
Dialogue: 0,0:16:43.69,0:16:45.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi sekalian untuk berlatih.
Dialogue: 0,0:16:45.99,0:16:49.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menghadapi monster di malam hari\Njuga termasuk ujian.
Dialogue: 0,0:16:50.16,0:16:52.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya bisa jadi latihan yang bagus.
Dialogue: 0,0:16:52.49,0:16:54.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau teman-temanku setuju,
Dialogue: 0,0:16:54.99,0:16:57.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa kami boleh mengikuti ujian?
Dialogue: 0,0:16:57.25,0:17:01.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu yang diinginkan,\Nnanti saya urus prosedurnya.
Dialogue: 0,0:17:03.50,0:17:06.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laporan hasil pemotongan\Nmonsternya sudah tiba.
Dialogue: 0,0:17:07.58,0:17:08.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba lihat.
Dialogue: 0,0:17:09.83,0:17:11.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Praktis juga, ya.
Dialogue: 0,0:17:11.58,0:17:14.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku terdaftar di serikat pedagang,
Dialogue: 0,0:17:14.76,0:17:18.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa menghubungi toko-toko\Ndi Distrik 8 melalui lisensi.
Dialogue: 0,0:17:18.64,0:17:21.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keistimewaan seorang pedagang, ya.
Dialogue: 0,0:17:21.14,0:17:23.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga bisa memberikan\Nperbandingan harga material.
Dialogue: 0,0:17:23.98,0:17:27.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi tidak perlu mampir\Nke toko satu per satu, ya.
Dialogue: 0,0:17:30.15,0:17:32.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elitia, ada apa?
Dialogue: 0,0:17:32.93,0:17:36.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arihito, kamu sudah menerima\Nhasil kita di guild, kan?
Dialogue: 0,0:17:36.83,0:17:38.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:17:38.04,0:17:39.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana hasilnya?
Dialogue: 0,0:17:39.31,0:17:41.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena poin kontribusinya sangat tinggi,
Dialogue: 0,0:17:41.50,0:17:44.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita bisa naik ke Distrik 7 tanpa ujian.
Dialogue: 0,0:17:45.84,0:17:48.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku merasa tetap harus ikut ujian.
Dialogue: 0,0:17:48.46,0:17:50.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa jadi latihan berkemah juga.
Dialogue: 0,0:17:50.84,0:17:52.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:17:52.51,0:17:54.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa harus ikut ujian?
Dialogue: 0,0:17:54.43,0:17:56.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Soalnya...
Dialogue: 0,0:17:56.29,0:18:00.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku rasa lebih baik melakukan\Nyang bisa kita lakukan di Distrik 8,
Dialogue: 0,0:18:00.10,0:18:01.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebelum naik ke atas.
Dialogue: 0,0:18:01.64,0:18:05.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak setuju kalau terlalu santai begini.
Dialogue: 0,0:18:07.44,0:18:09.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau istirahat duluan.
Dialogue: 0,0:18:13.78,0:18:15.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku bagus saja, sih.
Dialogue: 0,0:18:15.78,0:18:18.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengikuti ujian sekalian latihan.
Dialogue: 0,0:18:18.40,0:18:22.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya Eli punya alasan tersendiri.
Dialogue: 0,0:18:22.66,0:18:26.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita biarkan dia istirahat dulu,\Nbaru nanti dibicarakan.
Dialogue: 0,0:18:27.88,0:18:29.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:18:34.84,0:18:37.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia, kamu sudah bisa istirahat sekarang.
Dialogue: 0,0:18:39.31,0:18:42.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah membuatmu khawatir.
Dialogue: 0,0:18:43.93,0:18:46.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar kalau kami semua sampai terbunuh.
Dialogue: 0,0:18:46.81,0:18:49.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai pemimpin,\Naku harus lebih bisa diandalkan.
Dialogue: 0,0:18:49.69,0:18:50.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atobe.
Dialogue: 0,0:18:50.98,0:18:51.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya?
Dialogue: 0,0:18:52.24,0:18:53.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum tidur?
Dialogue: 0,0:18:53.78,0:18:56.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kepikiran ingin minum teh dulu.
Dialogue: 0,0:18:56.61,0:18:59.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atobe dan Theresia mau?
Dialogue: 0,0:18:59.28,0:19:01.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, sekalian saja.
Dialogue: 0,0:19:01.41,0:19:04.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah, kamu duduk saja.
Dialogue: 0,0:19:04.54,0:19:05.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:19:05.62,0:19:08.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kenapa tidak minta tolong pelayan saja?
Dialogue: 0,0:19:08.13,0:19:10.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan.
Dialogue: 0,0:19:10.15,0:19:14.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng, aku yang menggantikan pelayan.
Dialogue: 0,0:19:17.14,0:19:18.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maksudku...
Dialogue: 0,0:19:18.76,0:19:21.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkatmu, hari ini kita semua selamat.
Dialogue: 0,0:19:21.52,0:19:24.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, aku belum pernah minta maaf\Nkarena dulu sering memaksa
Dialogue: 0,0:19:24.85,0:19:26.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat kita masih satu kantor.
Dialogue: 0,0:19:26.85,0:19:29.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya aku belum tenang\Nkalau belum berterima kasih.
Dialogue: 0,0:19:29.73,0:19:32.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan cara jadi pelayan?
Dialogue: 0,0:19:32.32,0:19:35.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tuan, saya ambilkan teh,
Dialogue: 0,0:19:35.86,0:19:37.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi mohon tunggu sebentar.
Dialogue: 0,0:19:41.16,0:19:43.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita periksa kemampuanmu saja, Theresia.
Dialogue: 0,0:19:45.37,0:19:48.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kita ambil Double Throw\Ndan Assault Hit.
Dialogue: 0,0:19:48.67,0:19:50.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shadow Step bisa dipakai untuk kabur
Dialogue: 0,0:19:50.63,0:19:52.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}setelah pakai Assault Hit.
Dialogue: 0,0:19:52.65,0:19:54.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa bisa kuserahkan membuka kunci
Dialogue: 0,0:19:54.17,0:19:55.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mematikan jebakan padamu?
Dialogue: 0,0:19:57.13,0:19:58.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:19:58.40,0:20:02.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita ambil Teknik Jari satu dan dua.
Dialogue: 0,0:20:02.06,0:20:04.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, selanjutnya aku.
Dialogue: 0,0:20:06.23,0:20:09.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuan yang aku inginkan akhirnya muncul.
Dialogue: 0,0:20:14.83,0:20:16.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Komandan Belakang?
Dialogue: 0,0:20:16.96,0:20:19.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bisa menutupi kelemahanku,
Dialogue: 0,0:20:19.77,0:20:23.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi untuk jaga-jaga,\Naku ingin ambil Assist Charge.
Dialogue: 0,0:20:23.44,0:20:27.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sinergi Dukungan juga sepertinya\Nbisa meningkatkan serangan party.
Dialogue: 0,0:20:29.08,0:20:31.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ambil Komandan Belakang?
Dialogue: 0,0:20:33.13,0:20:34.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:20:34.89,0:20:37.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski bukan tugas utama garda belakang,
Dialogue: 0,0:20:37.37,0:20:39.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}suatu saat aku memang ingin mengambilnya.
Dialogue: 0,0:20:40.84,0:20:43.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf menunggu, Tuan.
Dialogue: 0,0:20:48.23,0:20:51.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Ini yang dimaksud menggantikan pelayan?
Dialogue: 0,0:20:51.94,0:20:53.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakaiannya aku pinjam.
Dialogue: 0,0:20:53.82,0:20:56.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pikir kamu akan menyukainya.
Dialogue: 0,0:20:57.28,0:20:58.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelek, ya?
Dialogue: 0,0:20:58.40,0:21:00.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak.
Dialogue: 0,0:21:00.24,0:21:03.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng, aku hanya tak tahu harus berkata apa.
Dialogue: 0,0:21:03.20,0:21:06.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku bisa pastikan pakaiannya cocok.
Dialogue: 0,0:21:06.91,0:21:09.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu? Syukurlah.
Dialogue: 0,0:21:09.50,0:21:12.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka akan seperti ini.
Dialogue: 0,0:21:12.41,0:21:13.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya.
Dialogue: 0,0:21:13.88,0:21:16.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Igarashi, bisa coba membelakangiku?
Dialogue: 0,0:21:16.80,0:21:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Kenapa?
Dialogue: 0,0:21:19.01,0:21:20.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti ini?
Dialogue: 0,0:21:20.26,0:21:23.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin coba kemampuan\Nyang baru saja kuambil.
Dialogue: 0,0:21:25.39,0:21:27.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Assist Charge.
Dialogue: 0,0:21:32.52,0:21:34.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasa lelahku terasa berkurang.
Dialogue: 0,0:21:34.77,0:21:36.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini menggunakan mana milikku,
Dialogue: 0,0:21:36.65,0:21:39.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk memulihkan mana garda depan.
Dialogue: 0,0:21:39.52,0:21:43.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi bisa mengisi mana-mu\Nsaat habis karena Blink Step.
Dialogue: 0,0:21:43.66,0:21:46.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memilih kemampuan\Nsampai memikirkan sejauh itu untukku?
Dialogue: 0,0:21:46.95,0:21:48.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, seperti itulah.
Dialogue: 0,0:21:48.83,0:21:52.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, padahal aku\Nbelum berterima kasih padamu.
Dialogue: 0,0:21:52.54,0:21:55.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar-benar susah menerima balas budi.
Dialogue: 0,0:21:57.50,0:21:59.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus berjuang sama-sama.
Dialogue: 0,0:22:01.73,0:22:06.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia, kamu lebih mengerti Igarashi\Ndaripada aku?
