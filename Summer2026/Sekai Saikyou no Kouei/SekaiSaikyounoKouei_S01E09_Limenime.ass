Dialogue: 0,0:00:45.44,0:00:56.08,sign,,0000,0000,0000,,GARDA BELAKANG TERKUAT DI DUNIA\N~PENJELAJAH PEMULA DI NEGERI LABIRIN~
Dialogue: 0,0:02:03.98,0:02:08.97,sign,,0000,0000,0000,,LUKA YANG TERPENDAM\NDAN PENGAKUAN SANG PEJUANG
Dialogue: 0,0:11:13.99,0:11:15.95,sign,,0000,0000,0000,,GARDA BELAKANG TERKUAT DI DUNIA
Dialogue: 0,0:11:15.95,0:11:18.99,sign,,0000,0000,0000,,~PENJELAJAH PEMULA DI NEGERI LABIRIN~
Dialogue: 0,0:16:32.80,0:16:34.81,sign,,0000,0000,0000,,PENEMBAK PELURU SIHIR HITAM +3
Dialogue: 0,0:16:34.81,0:16:38.03,sign,,0000,0000,0000,,MEMBERIKAN EFEK RACUN,
Dialogue: 0,0:16:38.03,0:16:41.69,sign,,0000,0000,0000,,KEBINGUNGAN, DAN STUN
Dialogue: 0,0:17:26.10,0:17:28.90,sign,,0000,0000,0000,,PEDANG PENDEK\NMEMBERIKAN SERANGAN BEREFEK STUN
Dialogue: 0,0:00:11.21,0:00:12.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eli.
Dialogue: 0,0:00:13.91,0:00:17.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita mau mengadakan\Npesta penyambutan untuk Madoka.
Dialogue: 0,0:00:17.04,0:00:19.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada banyak makanan enak.
Dialogue: 0,0:00:19.41,0:00:22.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku akan senang kalau kamu mau ikut.
Dialogue: 0,0:00:22.92,0:00:23.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:00:23.75,0:00:25.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita punya anggota baru,
Dialogue: 0,0:00:25.84,0:00:28.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi semuanya harus ikut merayakan, bukan?
Dialogue: 0,0:00:28.09,0:00:30.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Eli!
Dialogue: 0,0:02:12.24,0:02:15.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenyang sekali.
Dialogue: 0,0:02:19.08,0:02:23.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, bagaimana kalau habis makan\Nkita bermain?
Dialogue: 0,0:02:23.16,0:02:24.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bermain?
Dialogue: 0,0:02:24.62,0:02:26.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertanyaan bagus!
Dialogue: 0,0:02:26.63,0:02:30.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara soal permainan\Nuntuk mempererat keakraban,
Dialogue: 0,0:02:30.30,0:02:31.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah pasti ini!
Dialogue: 0,0:02:31.84,0:02:35.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kan permainan raja-rajaan!
Dialogue: 0,0:02:35.05,0:02:36.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kyouka memang hebat.
Dialogue: 0,0:02:36.84,0:02:39.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu tahu banyak soal ini?
Dialogue: 0,0:02:39.10,0:02:42.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku tahu permainan seperti apa itu,
Dialogue: 0,0:02:42.10,0:02:43.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi belum pernah memainkannya.
Dialogue: 0,0:02:49.69,0:02:51.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ayo kita coba!
Dialogue: 0,0:02:52.78,0:02:54.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masing-masing ambil satu, ya.
Dialogue: 0,0:02:56.61,0:03:00.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang dapat sumpit\Ndengan tanda merah berarti jadi raja.
Dialogue: 0,0:03:00.64,0:03:03.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perintah raja adalah mutlak.
Dialogue: 0,0:03:03.00,0:03:03.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan.
Dialogue: 0,0:03:07.63,0:03:10.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, siapa yang jadi raja?
Dialogue: 0,0:03:10.55,0:03:12.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku.
Dialogue: 0,0:03:12.55,0:03:14.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat, Suzu.
Dialogue: 0,0:03:14.67,0:03:16.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan beri perintah.
Dialogue: 0,0:03:16.43,0:03:19.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng, maksudnya perintah bagaimana?
Dialogue: 0,0:03:19.26,0:03:22.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di setiap sumpit ada nomornya,
Dialogue: 0,0:03:22.43,0:03:27.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebut saja nomor sekian melakukan\Nini atau itu ke nomor sekian.
Dialogue: 0,0:03:27.44,0:03:29.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:03:30.15,0:03:33.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, nomor 5 dan nomor 3...
Dialogue: 0,0:03:36.61,0:03:40.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah memberi perintah\Nberjabat tangan juga boleh?
Dialogue: 0,0:03:40.16,0:03:45.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh, sih, tapi kamu itu raja, beri perintah\Nyang lebih berani juga boleh, kok.
Dialogue: 0,0:03:45.04,0:03:46.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misalnya...
Dialogue: 0,0:03:46.75,0:03:49.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang begitu, atau yang begini.
Dialogue: 0,0:03:49.79,0:03:52.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa saja oke!
Dialogue: 0,0:03:52.83,0:03:55.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal masih dalam batas wajar lo, ya!
Dialogue: 0,0:03:56.48,0:04:00.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti yang diperintah\Njuga harus melakukannya?
Dialogue: 0,0:04:03.43,0:04:05.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memberi perintah itu sulit!
Dialogue: 0,0:04:05.64,0:04:10.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terlalu dipikirkan\Nmalah jadi makin sulit, lo.
Dialogue: 0,0:04:10.40,0:04:12.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi langsung saja!
Dialogue: 0,0:04:12.36,0:04:13.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kalau begitu,
Dialogue: 0,0:04:13.82,0:04:16.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nomor 5 memanjakan nomor 3.
Dialogue: 0,0:04:16.74,0:04:18.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata perintah beraninya sebatas itu!
Dialogue: 0,0:04:18.74,0:04:22.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi memang Suzu banget, sih.
Dialogue: 0,0:04:29.62,0:04:33.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atobe nomor 5 dan Theresia nomor 3, ya.
Dialogue: 0,0:04:33.67,0:04:34.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:04:34.91,0:04:37.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia, apa terasa sakit?
Dialogue: 0,0:04:38.05,0:04:41.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia terlihat menikmati, ya.
Dialogue: 0,0:04:41.01,0:04:44.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makin akrab itu adalah hal yang bagus,
Dialogue: 0,0:04:44.01,0:04:46.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi permainannya baru saja dimulai.
Dialogue: 0,0:04:46.64,0:04:50.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misaki, kamu tidak akan memerintah\Nyang aneh-aneh ke Atobe, kan?
Dialogue: 0,0:04:51.48,0:04:53.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa, sih?
Dialogue: 0,0:04:53.19,0:04:56.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sama sekali tidak mengincar Abang, kok.
Dialogue: 0,0:04:56.07,0:04:57.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}The-Theresia!
Dialogue: 0,0:05:00.49,0:05:01.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merah banget!
Dialogue: 0,0:05:03.45,0:05:05.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kamu tidak apa-apa?
Dialogue: 0,0:05:05.28,0:05:07.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi?
Dialogue: 0,0:05:07.29,0:05:10.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pijatan abang terlalu enak?
Dialogue: 0,0:05:10.67,0:05:12.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan ini...
Dialogue: 0,0:05:16.55,0:05:18.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama seperti waktu itu?
Dialogue: 0,0:05:18.34,0:05:21.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bi-Bisa jadi.
Dialogue: 0,0:05:23.30,0:05:24.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:05:24.89,0:05:27.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Bu-Bukan apa-apa.\N- Tidak ada apa-apa.
Dialogue: 0,0:05:34.52,0:05:37.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, karena Theresia juga\Nsudah mulai tenang,
Dialogue: 0,0:05:37.44,0:05:39.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita lanjut ronde kedua!
Dialogue: 0,0:05:41.53,0:05:44.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asyik! Aku yang jadi raja!
Dialogue: 0,0:05:50.33,0:05:53.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dia, perintah dari raja.
Dialogue: 0,0:05:53.45,0:05:58.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang nomor 2 harus mencurahkan\Nhatinya ke semua orang!
Dialogue: 0,0:05:58.46,0:06:01.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng, siapa yang nomor 2?
Dialogue: 0,0:06:05.22,0:06:06.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku.
Dialogue: 0,0:06:06.51,0:06:07.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh!
Dialogue: 0,0:06:07.31,0:06:10.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan Eli si Nomor 2, curahkan semuanya!
Dialogue: 0,0:06:10.77,0:06:13.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya aku sudah tahu.
Dialogue: 0,0:06:13.52,0:06:16.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Eli sejak tadi\Nsedang memikirkan seseorang.
Dialogue: 0,0:06:20.44,0:06:21.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eli.
Dialogue: 0,0:06:22.86,0:06:25.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau malu bicara serius,
Dialogue: 0,0:06:25.03,0:06:27.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nanti bisik-bisik saja ke aku.
Dialogue: 0,0:06:27.07,0:06:28.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan seperti itu.
Dialogue: 0,0:06:29.70,0:06:32.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal yang sedang aku pikirkan ini
Dialogue: 0,0:06:32.03,0:06:34.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukanlah hal yang Misaki bayangkan.
Dialogue: 0,0:06:37.67,0:06:39.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama ini selalu ada di dalam hatiku.
Dialogue: 0,0:06:39.97,0:06:42.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selalu aku pikirkan.
Dialogue: 0,0:06:43.47,0:06:46.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentang gadis yang aku temui di labirin.
Dialogue: 0,0:06:47.85,0:06:52.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia selalu menungguku di dalam labirin.
Dialogue: 0,0:06:52.89,0:06:54.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menunggu?
Dialogue: 0,0:07:00.53,0:07:02.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat masih di Byakuya Rhodan,
Dialogue: 0,0:07:02.55,0:07:07.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami diserang monster bernama\NKera Merah Membara.
Dialogue: 0,0:07:07.82,0:07:11.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu, temanku diculik dan dibawa pergi.
Dialogue: 0,0:07:12.50,0:07:16.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, mereka tidak menyelamatkan temanku.
Dialogue: 0,0:07:17.63,0:07:22.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah banyak penjelajah yang diculik.
Dialogue: 0,0:07:22.27,0:07:24.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster itu memiliki kecerdasan.
Dialogue: 0,0:07:24.85,0:07:28.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mengerti nilai dari manusia\Nyang dikalahkannya.
Dialogue: 0,0:07:28.58,0:07:32.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia yang diculik\Ndihilangkan kesadarannya
Dialogue: 0,0:07:33.10,0:07:34.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan dijadikan pengikut.
Dialogue: 0,0:07:34.93,0:07:36.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengikut?
Dialogue: 0,0:07:37.49,0:07:39.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak akan memaafkannya.
Dialogue: 0,0:07:39.69,0:07:40.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubunuh!
Dialogue: 0,0:07:41.44,0:07:42.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eli!
Dialogue: 0,0:07:47.53,0:07:51.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan menanggung\Nrasa sakit ini sendirian.
Dialogue: 0,0:07:53.12,0:07:56.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga akan menjadi lebih kuat\Nagar bisa membantumu.
Dialogue: 0,0:07:56.32,0:08:00.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita sama-sama\Nmenyelamatkan temanmu, Eli.
Dialogue: 0,0:08:00.25,0:08:03.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak sendirian.
Dialogue: 0,0:08:07.84,0:08:09.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:08:10.22,0:08:13.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lemah.
Dialogue: 0,0:08:13.26,0:08:15.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa menyelamatkannya.
Dialogue: 0,0:08:15.02,0:08:17.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa melakukan apa pun.
Dialogue: 0,0:08:23.48,0:08:24.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arihito.
Dialogue: 0,0:08:25.94,0:08:28.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini,\Nkatanya mau ambil ujian kenaikan tingkat.
Dialogue: 0,0:08:29.74,0:08:31.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terlalu terburu-buru.
Dialogue: 0,0:08:31.45,0:08:34.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya ingin cepat-cepat\Nmenyelamatkan temanku.
Dialogue: 0,0:08:36.00,0:08:39.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah bersikap seperti itu.
Dialogue: 0,0:08:41.08,0:08:43.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah mau bercerita.
Dialogue: 0,0:08:43.15,0:08:45.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang semuanya sudah jelas.
Dialogue: 0,0:08:46.01,0:08:50.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga punya alasan\Nuntuk sekali lagi melangkah maju.
Dialogue: 0,0:08:50.51,0:08:53.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku tidak bisa melakukannya sendiri.
Dialogue: 0,0:08:54.18,0:08:58.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekali lagi, izinkan kami berjanji\Nuntuk ikut membantu.
Dialogue: 0,0:09:01.81,0:09:03.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, Elitia...
Dialogue: 0,0:09:04.57,0:09:07.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti yang dikatakan Suzuna tadi,
Dialogue: 0,0:09:07.11,0:09:10.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita harus menjadi lebih kuat\Nuntuk menyelamatkan temanmu.
Dialogue: 0,0:09:11.49,0:09:15.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, kita naikkan level\Nlewat ujian kenaikan tingkat.
Dialogue: 0,0:09:15.39,0:09:16.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak keberatan, kan?
Dialogue: 0,0:09:18.22,0:09:19.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:09:24.46,0:09:28.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Level dan pengalaman\Nyang kumiliki tidaklah penting.
Dialogue: 0,0:09:28.04,0:09:32.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlakukanlah aku sebagai\Nanggota party seperti yang lainnya.
Dialogue: 0,0:09:32.89,0:09:35.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, aku mengerti.
Dialogue: 0,0:09:35.61,0:09:39.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mungkin akan memintamu menambahkan\Nbeberapa kemampuan yang ada.
Dialogue: 0,0:09:39.52,0:09:42.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, utamakan keinginanmu dulu.
Dialogue: 0,0:09:42.13,0:09:42.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:09:42.85,0:09:46.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, biarkan aku menjadikan\Npendapatmu sebagai referensi.
Dialogue: 0,0:09:46.83,0:09:47.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:09:49.44,0:09:53.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Red Eye kemungkinan kemampuan\Nyang tak ada kutukannya.
Dialogue: 0,0:09:53.33,0:09:56.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Blossom Blade juga\Ntak ada tanda kutukan,
Dialogue: 0,0:09:56.20,0:09:58.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin bisa kita anggap begitu.
Dialogue: 0,0:09:58.07,0:10:00.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku akan ambil Red Eye.
Dialogue: 0,0:10:00.59,0:10:04.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku juga ingin bisa berguna\Nuntuk party meski hanya seberapa.
Dialogue: 0,0:10:04.64,0:10:06.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, aku mengerti.
Dialogue: 0,0:10:06.67,0:10:10.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip, dengan ini masalah beres.
Dialogue: 0,0:10:12.30,0:10:14.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu, Misaki,
Dialogue: 0,0:10:14.28,0:10:18.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa kamu sengaja main gim raja-rajaan\Nkarena tahu Eli memendam sesuatu?
Dialogue: 0,0:10:18.39,0:10:21.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng, bagaimana, ya?
Dialogue: 0,0:10:21.39,0:10:24.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutmu mana yang dirasa paling keren?
Dialogue: 0,0:10:25.73,0:10:26.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misaki.
Dialogue: 0,0:10:28.11,0:10:31.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah memberikan\Nkesempatan untuk bicara.
Dialogue: 0,0:10:31.53,0:10:35.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama-sama, aku juga mengucapkan terima kasih.
Dialogue: 0,0:10:37.12,0:10:39.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, besok aku dan Theresia
Dialogue: 0,0:10:39.79,0:10:42.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan pergi ke Bengkel Mistral\Nuntuk memperkuat senjata.
Dialogue: 0,0:10:42.97,0:10:47.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu kami akan ke peternakan monster\Nuntuk membuat kontrak dengan Demi Harpy.
Dialogue: 0,0:10:47.79,0:10:52.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian istirahatlah yang cukup\Nuntuk persiapan ke Hutan Panggilan.
Dialogue: 0,0:10:52.24,0:10:53.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:10:53.55,0:10:56.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tunggu, Abang.
Dialogue: 0,0:10:56.14,0:10:58.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong cek kemampuanku juga.
Dialogue: 0,0:10:58.30,0:11:00.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin gara-gara melawan monster gede itu
Dialogue: 0,0:11:00.93,0:11:02.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}levelku jadi naik banyak.
Dialogue: 0,0:11:02.85,0:11:05.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Punyaku juga tolong dicek.
Dialogue: 0,0:11:05.27,0:11:06.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga.
Dialogue: 0,0:11:06.65,0:11:11.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kita harus menjadi lebih kuat\Nuntuk menolong temannya Elitia.
Dialogue: 0,0:11:13.99,0:11:15.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kamu salah lihat!
Dialogue: 0,0:11:15.95,0:11:18.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dapat ekspresi malu-malu kucingnya!
Dialogue: 0,0:11:29.19,0:11:32.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh? Sepertinya bukan pelanggan\Nyang sudah membuat janji.
Dialogue: 0,0:11:35.38,0:11:37.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf kami datang tiba-tiba.
Dialogue: 0,0:11:37.79,0:11:39.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Arihito Atobe.
Dialogue: 0,0:11:39.72,0:11:41.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami ingin memperkuat senjata.
Dialogue: 0,0:11:42.56,0:11:45.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Temanmu seorang Lizardman, ya.
Dialogue: 0,0:11:45.33,0:11:49.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa bisa aku asumsikan\Nkamu tidak mendiskriminasikan
Dialogue: 0,0:11:49.43,0:11:51.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kaum setengah manusia?
Dialogue: 0,0:11:52.15,0:11:55.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia adalah teman berhargaku.
Dialogue: 0,0:11:55.07,0:11:57.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemikiran yang luar biasa.
Dialogue: 0,0:11:57.57,0:12:00.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia tempat semua memperlakukan\Nsetengah manusia dengan adil.
Dialogue: 0,0:12:00.55,0:12:05.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa hidup di dunia seperti itu\Ntermasuk salah satu impianku.
Dialogue: 0,0:12:05.08,0:12:07.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari, silakan masuk.
Dialogue: 0,0:12:12.96,0:12:17.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum itu, selamat datang\Ndi bengkel tempa sihir Mistral.
Dialogue: 0,0:12:17.51,0:12:20.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku adalah Steiner,\Nahli tempa di bengkel ini.
Dialogue: 0,0:12:21.18,0:12:26.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, untuk memperkuat senjata,\Nkamu butuh batu sihir atau bijih logam,
Dialogue: 0,0:12:26.14,0:12:28.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kali ini apa yang kamu bawa?
Dialogue: 0,0:12:28.02,0:12:30.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ini barangnya.
Dialogue: 0,0:12:30.73,0:12:33.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami juga ingin memasang rune ke slot.
Dialogue: 0,0:12:33.69,0:12:35.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Rune, katamu?
Dialogue: 0,0:12:41.12,0:12:44.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku jadi tak sengaja nongol.
Dialogue: 0,0:12:44.95,0:12:48.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal tadinya aku mau menyuruh\NSteiner saja yang melayani.
Dialogue: 0,0:12:48.93,0:12:51.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master, ini berat.
Dialogue: 0,0:12:51.00,0:12:53.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, maaf.
Dialogue: 0,0:12:56.59,0:12:58.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Steiner, anak ini siapa?
Dialogue: 0,0:12:58.97,0:13:00.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan "anak".
Dialogue: 0,0:13:00.38,0:13:03.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini-begini, aku sudah dewasa, tahu.
Dialogue: 0,0:13:03.47,0:13:07.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, aku adalah pemilik\Nbengkel tempa sihir Mistral ini.
Dialogue: 0,0:13:07.60,0:13:09.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Ceres Mistral.
Dialogue: 0,0:13:13.48,0:13:14.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, wah.
Dialogue: 0,0:13:14.82,0:13:18.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menunjukkan wajah penasaran\Nsaat melihat telingaku, ya.
Dialogue: 0,0:13:19.24,0:13:20.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, maaf.
Dialogue: 0,0:13:20.53,0:13:22.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, mau bagaimana lagi.
Dialogue: 0,0:13:22.53,0:13:26.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya bertemu ras asli dunia ini sepertiku
Dialogue: 0,0:13:26.54,0:13:28.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sangatlah jarang terjadi.
Dialogue: 0,0:13:28.54,0:13:30.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ras asli dunia ini?
Dialogue: 0,0:13:30.91,0:13:32.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:13:32.29,0:13:35.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang yang bereinkarnasi\Nmenyebutku elf,
Dialogue: 0,0:13:35.79,0:13:39.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan ada juga yang menyebutku Jade\Nkarena warna mataku.
Dialogue: 0,0:13:39.76,0:13:42.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku adalah salah satu ras asli\NNegeri Labirin ini,
Dialogue: 0,0:13:42.55,0:13:45.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kelas pekerjaanku berbeda\Ndengan mereka yang bereinkarnasi,
Dialogue: 0,0:13:45.39,0:13:47.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yaitu Rune Maker.
Dialogue: 0,0:13:48.56,0:13:52.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, zirah ini juga\Naku gerakkan dengan rune.
Dialogue: 0,0:13:54.65,0:13:58.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, ternyata ada manusia\Nyang menarik juga.
Dialogue: 0,0:13:58.48,0:14:00.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski setengah manusia disewa\Njadi tentara bayaran,
Dialogue: 0,0:14:00.90,0:14:03.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jarang ada yang mau mengajaknya\Nberjalan bersama.
Dialogue: 0,0:14:03.68,0:14:06.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, tampaknya dia sangat menyukaimu.
Dialogue: 0,0:14:06.70,0:14:11.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya sejak aku muncul,\Ndia selalu melindungimu.
Dialogue: 0,0:14:12.33,0:14:16.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia, kamu tidak perlu waspada\Ndengan Ceres.
Dialogue: 0,0:14:17.21,0:14:19.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar sekali.
Dialogue: 0,0:14:19.21,0:14:23.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku sudah membuka rahasiaku\Nkarena aku menyukai kalian.
Dialogue: 0,0:14:23.03,0:14:24.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo, eh?
Dialogue: 0,0:14:24.01,0:14:27.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berjalan di kota\Ndengan seorang setengah manusia.
Dialogue: 0,0:14:27.76,0:14:29.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan saling peduli.
Dialogue: 0,0:14:29.93,0:14:32.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan pemandangan yang sering terlihat.
Dialogue: 0,0:14:34.56,0:14:38.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, mana rune yang kalian bawa?
Dialogue: 0,0:14:41.82,0:14:42.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:14:42.78,0:14:45.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besi Elmina, Kristal Racun,
Dialogue: 0,0:14:45.11,0:14:46.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dua Batu Penglihatan,
Dialogue: 0,0:14:46.99,0:14:49.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu Batu Kebingungan,
Dialogue: 0,0:14:49.74,0:14:51.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan rune Magia, ya.
Dialogue: 0,0:14:51.66,0:14:55.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Magia?\NApa yang terjadi kalau itu dipasang?
Dialogue: 0,0:14:55.29,0:14:59.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa mengubah serangan senjata\Nmenjadi serangan sihir.
Dialogue: 0,0:14:59.27,0:15:02.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Praktis, tapi butuh senjata yang ada slotnya.
Dialogue: 0,0:15:02.71,0:15:04.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Slot?
Dialogue: 0,0:15:04.22,0:15:07.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, senjataku kayaknya ada.
Dialogue: 0,0:15:07.72,0:15:09.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini bisa dipakai?
Dialogue: 0,0:15:09.72,0:15:12.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, sebaiknya sekalian\Npasang batu sihir juga.
Dialogue: 0,0:15:12.81,0:15:14.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan Besi Elmina?
Dialogue: 0,0:15:14.48,0:15:15.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat cocok untuk armor.
Dialogue: 0,0:15:15.94,0:15:17.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin untuk armor temanku.
Dialogue: 0,0:15:17.86,0:15:20.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tapi aku tidak bawa.
Dialogue: 0,0:15:20.57,0:15:21.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Atobe,
Dialogue: 0,0:15:21.82,0:15:25.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa meminta kurir\Nuntuk mengantar armornya ke sini.
Dialogue: 0,0:15:25.95,0:15:27.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:15:27.99,0:15:32.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, mari kita langsung pasang rune-nya.
Dialogue: 0,0:15:33.62,0:15:37.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama sekali\Ntidak mengerjakan rune, ya, Master.
Dialogue: 0,0:15:42.24,0:15:44.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai aksara yang memiliki kekuatan,
Dialogue: 0,0:15:44.37,0:15:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menyatulah dengan benda tak bernyawa.
Dialogue: 0,0:15:48.39,0:15:50.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enchant Rune!
Dialogue: 0,0:16:09.24,0:16:11.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, memasang batu sihir.
Dialogue: 0,0:16:20.04,0:16:22.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya berhasil tanpa kendala.
Dialogue: 0,0:16:24.21,0:16:25.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan memasangkan rune,
Dialogue: 0,0:16:25.55,0:16:28.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nama senjatanya akan menjadi unik.
Dialogue: 0,0:16:28.01,0:16:29.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan diperiksa.
Dialogue: 0,0:16:34.81,0:16:38.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penembak Peluru Sihir Hitam +3.
Dialogue: 0,0:16:38.03,0:16:41.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memberikan efek racun, kebingungan, dan stun?
Dialogue: 0,0:16:42.40,0:16:43.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa!
Dialogue: 0,0:16:43.65,0:16:46.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangannya meningkat,\Nditambah ada efeknya juga.
Dialogue: 0,0:16:46.99,0:16:48.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:16:48.95,0:16:53.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ceres, satu lagi Batu Penglihatan...
Dialogue: 0,0:16:54.24,0:16:55.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia.
Dialogue: 0,0:16:55.59,0:16:59.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu lebih memilih mencegah stun\Natau memberikan stun ke musuh?
Dialogue: 0,0:17:00.75,0:17:02.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah, Theresia.
Dialogue: 0,0:17:02.80,0:17:05.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selagi bersama tuanmu,
Dialogue: 0,0:17:05.33,0:17:08.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rasanya sayang kalau tidak mendapatkan\Nhadiah apa pun.
Dialogue: 0,0:17:11.72,0:17:13.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma memperkuat perlengkapan.
Dialogue: 0,0:17:13.84,0:17:16.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini berbeda dari hadiah.
Dialogue: 0,0:17:16.06,0:17:18.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara apa kamu ini?
Dialogue: 0,0:17:18.06,0:17:21.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau seperti apa pun bentuknya,\Nhadiah tetaplah hadiah.
Dialogue: 0,0:17:21.27,0:17:23.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima saja dengan senang hati.
Dialogue: 0,0:17:33.53,0:17:35.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ceres, Steiner,
Dialogue: 0,0:17:35.83,0:17:39.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terima kasih untuk hari ini\Nmeski kami datang mendadak.
Dialogue: 0,0:17:39.50,0:17:40.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama-sama.
Dialogue: 0,0:17:40.54,0:17:43.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, saat kurir barangnya datang,
Dialogue: 0,0:17:43.42,0:17:45.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan kami perkuat lalu kami kirim kembali.
Dialogue: 0,0:17:45.69,0:17:46.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:17:49.84,0:17:53.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia benar-benar orang\Nyang luar biasa ya, Master.
Dialogue: 0,0:17:54.34,0:17:57.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia yang saling memahami\Nhati setengah manusia.
Dialogue: 0,0:17:58.77,0:18:03.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia ini sepertinya belum sepenuhnya\Nkehilangan harapan.
Dialogue: 0,0:18:07.73,0:18:10.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, Master.
Dialogue: 0,0:18:11.86,0:18:15.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia, tadinya aku mau\Nke peternakan monster bersamamu,
Dialogue: 0,0:18:15.85,0:18:17.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku sendirian saja.
Dialogue: 0,0:18:17.66,0:18:21.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pulang dan beri tahu\Nakan ada kurir barang yang datang.
Dialogue: 0,0:18:23.62,0:18:25.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:18:28.67,0:18:30.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa.
Dialogue: 0,0:18:31.13,0:18:33.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kamu Tuan Atobe?
Dialogue: 0,0:18:33.80,0:18:35.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:18:35.13,0:18:38.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin mendaftarkan Demi Harpy\Nyang sebelumnya aku titipkan ke sini.
Dialogue: 0,0:18:38.60,0:18:41.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku sudah mendengarnya dari Guild.
Dialogue: 0,0:18:41.81,0:18:44.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku adalah pengelola peternakan ini,
Dialogue: 0,0:18:44.83,0:18:47.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}namaku William Christensen.
Dialogue: 0,0:18:47.56,0:18:51.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi Harpy sudah tunduk\Npada Tuan Atobe,
Dialogue: 0,0:18:51.78,0:18:55.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi tinggal pasangkan saja\Ndengan batu pemanggil ini
Dialogue: 0,0:18:55.95,0:18:58.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan nantinya bisa dipanggil kapan pun.
Dialogue: 0,0:19:01.16,0:19:02.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Millis!
Dialogue: 0,0:19:02.53,0:19:06.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Antarkan Tuan Atobe ke tempat Demi Harpy.
Dialogue: 0,0:19:09.80,0:19:11.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekor sapi?
Dialogue: 0,0:19:11.46,0:19:14.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, Kakek.
Dialogue: 0,0:19:16.89,0:19:18.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa...
Dialogue: 0,0:19:21.68,0:19:23.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}gede.
Dialogue: 0,0:19:23.64,0:19:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, Tuan Atobe,
Dialogue: 0,0:19:25.56,0:19:28.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mari kita ke tempat Demi Harpy.
Dialogue: 0,0:19:37.49,0:19:40.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh, duh, mereka sangat ketakutan.
Dialogue: 0,0:19:40.74,0:19:42.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:19:42.04,0:19:44.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau monster yang mirip manusia ditangkap,
Dialogue: 0,0:19:45.58,0:19:48.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}biasanya dijadikan tontonan,
Dialogue: 0,0:19:48.79,0:19:52.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau bagian tubuh yang bisa dimanfaatkan\Nakan dipotong begitu saja,
Dialogue: 0,0:19:52.88,0:19:55.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}makanya mereka ketakutan.
Dialogue: 0,0:19:58.51,0:20:02.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Millis, aku ingin menghilangkan\Nkewaspadaan Demi Harpy ini
Dialogue: 0,0:20:02.14,0:20:04.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan meningkatkan kepercayaannya padaku.
Dialogue: 0,0:20:04.75,0:20:07.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira apa yang harus kulakukan?
Dialogue: 0,0:20:07.06,0:20:09.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Caranya tinggal percaya pada mereka.
Dialogue: 0,0:20:09.86,0:20:14.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu menaruh rasa keraguan\Npada Demi Harpy,
Dialogue: 0,0:20:14.57,0:20:18.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}perasaan itu akan tersampaikan pada mereka.
Dialogue: 0,0:20:20.99,0:20:22.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:20:24.74,0:20:26.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tidak perlu takut.
Dialogue: 0,0:20:26.92,0:20:29.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian memang sempat membuatku kewalahan
Dialogue: 0,0:20:29.48,0:20:31.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan harus dikalahkan.
Dialogue: 0,0:20:31.82,0:20:34.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, mulai sekarang\Naku tak akan menyakiti kalian.
Dialogue: 0,0:20:36.67,0:20:39.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pinjamkanlah kekuatan kalian pada kami.
Dialogue: 0,0:20:39.84,0:20:43.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang,\Naku ingin suara indah kalian,
Dialogue: 0,0:20:43.03,0:20:47.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukan digunakan untuk menyerang,\Ntapi untuk melindungi manusia.
Dialogue: 0,0:21:06.08,0:21:10.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip, sekarang kontrak pemanggilannya\Nsudah selesai.
Dialogue: 0,0:21:10.47,0:21:13.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat dipanggil,\Ntolong gunakanlah lagu tidur kalian.
Dialogue: 0,0:21:19.47,0:21:23.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua persiapan untuk pergi\Nke Hutan Panggilan sudah selesai.
Dialogue: 0,0:21:23.39,0:21:27.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisanya tinggal menerima senjata\Ndari Ceres malam ini.
Dialogue: 0,0:21:28.48,0:21:31.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok, akhirnya ujian kenaikan tingkat.
Dialogue: 0,0:21:31.94,0:21:33.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kalian sudah tahu?
Dialogue: 0,0:21:33.44,0:21:36.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya ada monster bernama\Nyang muncul di Hutan Panggilan.
Dialogue: 0,0:21:36.86,0:21:38.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku sudah tahu.
Dialogue: 0,0:21:38.44,0:21:42.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara itu,\Njadi sulit lolos ujian kenaikan tingkat.
Dialogue: 0,0:21:42.36,0:21:46.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini,\Nkelompok Polaris sedang ujian, kan?
Dialogue: 0,0:21:46.12,0:21:47.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:21:47.12,0:21:49.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku tidak tahu apa yang akan terjadi.
Dialogue: 0,0:21:49.67,0:21:52.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kita urungkan dulu ke sana.
Dialogue: 0,0:21:52.17,0:21:55.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, nyawa lebih penting.
Dialogue: 0,0:21:57.38,0:22:00.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Georg, pemimpin dari Polaris.
Dialogue: 0,0:22:01.97,0:22:04.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kamu menarik juga.
Dialogue: 0,0:22:05.85,0:22:09.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah Georg dan lainnya baik-baik saja?
