Dialogue: 0,0:00:33.97,0:00:34.46,sign,,0000,0000,0000,,HUTAN PANGGILAN
Dialogue: 0,0:02:33.42,0:02:44.06,sign,,0000,0000,0000,,GARDA BELAKANG TERKUAT DI DUNIA\N~PENJELAJAH PEMULA DI NEGERI LABIRIN~
Dialogue: 0,0:03:52.00,0:03:57.01,sign,,0000,0000,0000,,SI CANTIK DARI HUTAN YANG MENGGILA
Dialogue: 0,0:03:57.01,0:03:59.72,sign,,0000,0000,0000,,TOKO JAGAL RIKERTON
Dialogue: 0,0:08:58.14,0:08:59.42,sign,,0000,0000,0000,,FEAR TREANT LV. 4 - SEDANG DALAM PERTARUNGAN
Dialogue: 0,0:08:59.42,0:09:04.32,sign,,0000,0000,0000,,DIRTY MASH LV. 2 - SEDANG DALAM PERTARUNGAN
Dialogue: 0,0:09:33.97,0:09:35.89,sign,,0000,0000,0000,,PROYEKTIL SIHIR, TEMBAKAN KUAT
Dialogue: 0,0:09:59.79,0:10:00.45,sign,,0000,0000,0000,,SERANGAN BALIK DIRTY MASH C
Dialogue: 0,0:10:00.45,0:10:02.96,sign,,0000,0000,0000,,MEMICU SPORA KEKACAUAN
Dialogue: 0,0:10:08.33,0:10:08.96,sign,,0000,0000,0000,,AKURASI
Dialogue: 0,0:10:55.47,0:10:56.09,sign,,0000,0000,0000,,AIR SUCI\NMENGHILANGKAN SEBAGIAN EFEK STATUS BURUK
Dialogue: 0,0:10:56.09,0:10:57.80,sign,,0000,0000,0000,,DENGAN MENYIRAMKAN AIR
Dialogue: 0,0:10:57.80,0:11:00.22,sign,,0000,0000,0000,,SKILL YANG DIPERLUKAN: PENYUCIAN
Dialogue: 0,0:11:29.29,0:11:30.15,sign,,0000,0000,0000,,APEL KECERDIKAN\NMEMAKAN SATU AKAN MEMBUAT
Dialogue: 0,0:11:30.15,0:11:32.63,sign,,0000,0000,0000,,BATAS MAKSIMUM MP MENINGKAT SEDIKIT
Dialogue: 0,0:13:36.05,0:13:37.17,sign,,0000,0000,0000,,GARDA BELAKANG TERKUAT DI DUNIA\N~PENJELAJAH PEMULA DI NEGERI LABIRIN~
Dialogue: 0,0:13:41.05,0:13:41.93,sign,,0000,0000,0000,,GARDA BELAKANG TERKUAT DI DUNIA\N~PENJELAJAH PEMULA DI NEGERI LABIRIN~
Dialogue: 0,0:18:43.02,0:18:44.27,sign,,0000,0000,0000,,MONSTER YANG DITEMUKAN:
Dialogue: 0,0:18:44.27,0:18:47.61,sign,,0000,0000,0000,,TANAMAN MERAMBAT PENGENDALI
Dialogue: 0,0:00:00.56,0:00:02.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, apa kalian sudah tahu?
Dialogue: 0,0:00:02.11,0:00:05.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya ada monster bernama\Nyang muncul di Hutan Panggilan.
Dialogue: 0,0:00:05.19,0:00:06.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku sudah tahu.
Dialogue: 0,0:00:06.78,0:00:10.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara itu, katanya\Nlulus ujian kenaikan tingkat jadi sulit.
Dialogue: 0,0:00:10.63,0:00:14.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini,\Nkelompok Polaris sedang ujian, kan?
Dialogue: 0,0:00:14.47,0:00:15.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:00:15.50,0:00:17.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku tidak tahu apa yang akan terjadi.
Dialogue: 0,0:00:17.91,0:00:20.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kita urungkan dulu ke sana.
Dialogue: 0,0:00:20.42,0:00:23.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, nyawa lebih penting.
Dialogue: 0,0:00:29.80,0:00:33.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, di depan sana adalah labirin\Ntempat ujian kenaikan tingkat.
Dialogue: 0,0:00:34.46,0:00:37.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya adalah Hutan Panggilan.
Dialogue: 0,0:00:39.06,0:00:43.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Louisa, aku dengar ada monster bernama\Nyang muncul di Hutan Panggilan.
Dialogue: 0,0:00:43.94,0:00:46.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan kelompok Georg\Nyang masuk duluan?
Dialogue: 0,0:00:47.36,0:00:49.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka masih belum kembali.
Dialogue: 0,0:00:49.11,0:00:50.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:00:50.51,0:00:53.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu kenal\Ndengan orang bernama Georg itu?
Dialogue: 0,0:00:53.41,0:00:54.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:00:54.33,0:00:57.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia adalah pemimpin party\Nyang disebut Polaris.
Dialogue: 0,0:00:57.35,0:00:59.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah bicara dengannya sebentar.
Dialogue: 0,0:01:00.54,0:01:04.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mereka diserang monster bernama\Ndan dalam situasi berbahaya,
Dialogue: 0,0:01:04.40,0:01:06.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tak bisa mengabaikannya.
Dialogue: 0,0:01:07.51,0:01:09.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Abang.
Dialogue: 0,0:01:09.57,0:01:12.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai aku juga bisa bertarung...
Dialogue: 0,0:01:12.51,0:01:14.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:01:14.21,0:01:18.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mendukung dengan kemampuanmu\Nsebagai pedagang saja sudah sangat membantu.
Dialogue: 0,0:01:18.14,0:01:20.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:01:20.71,0:01:22.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anu, ini.
Dialogue: 0,0:01:22.94,0:01:23.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:01:23.94,0:01:26.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gulungan identifikasi dan potion.
Dialogue: 0,0:01:26.82,0:01:28.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan dipakai.
Dialogue: 0,0:01:28.74,0:01:30.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal harga potion di sini mahal.
Dialogue: 0,0:01:30.99,0:01:32.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat juga kamu bisa punya.
Dialogue: 0,0:01:32.83,0:01:34.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya tidak aku jual di toko,
Dialogue: 0,0:01:34.99,0:01:38.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku menyimpan satu botol\Nuntuk keadaan darurat.
Dialogue: 0,0:01:38.01,0:01:40.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, sangat membantu.
Dialogue: 0,0:01:40.00,0:01:43.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Madoka benar-benar bisa diandalkan, ya.
Dialogue: 0,0:01:43.04,0:01:46.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditambah mengurus item\Ndan banyak hal lainnya.
Dialogue: 0,0:01:46.59,0:01:48.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak juga, kok.
Dialogue: 0,0:01:48.63,0:01:50.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, soal item,
Dialogue: 0,0:01:50.84,0:01:53.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pengolahan barang yang kita minta\Nke Pak Rikerton
Dialogue: 0,0:01:53.38,0:01:55.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seharusnya sebentar lagi selesai.
Dialogue: 0,0:01:55.91,0:01:57.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku saja yang mengambilnya?
Dialogue: 0,0:01:57.81,0:01:59.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tolong.
Dialogue: 0,0:01:59.35,0:02:03.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok, kayaknya Madoka sudah bekerja\Nlebih banyak daripada aku?
Dialogue: 0,0:02:03.08,0:02:06.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga punya peran penting\Ndengan caramu sendiri kok, Misaki.
Dialogue: 0,0:02:06.15,0:02:08.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebaikan Suzu benar-benar menyentuh hati!
Dialogue: 0,0:02:09.72,0:02:11.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ayo berangkat!
Dialogue: 0,0:02:14.28,0:02:16.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ber-Berjuanglah.
Dialogue: 0,0:02:16.37,0:02:17.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhati-hatilah.
Dialogue: 0,0:04:01.29,0:04:03.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Per-Permisi.
Dialogue: 0,0:04:04.68,0:04:06.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:04:06.89,0:04:09.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, apakah ada orang?
Dialogue: 0,0:04:11.65,0:04:12.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang.
Dialogue: 0,0:04:18.95,0:04:20.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang.
Dialogue: 0,0:04:20.24,0:04:22.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melissa?
Dialogue: 0,0:04:22.02,0:04:24.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tidak pakai baju?
Dialogue: 0,0:04:25.70,0:04:29.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sedang menguji perlengkapan baru\Nbernama Stealth Suit ini.
Dialogue: 0,0:04:29.33,0:04:31.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Stealth Suit.
Dialogue: 0,0:04:31.77,0:04:34.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibuat dari Batu Kamuflase olahan, ya?
Dialogue: 0,0:04:34.42,0:04:35.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:04:35.52,0:04:38.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dari sudut pandang pedagang,\Nmenurutmu bagaimana?
Dialogue: 0,0:04:38.60,0:04:41.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Efek transparannya itu\Ndari Suit tersebut, ya?
Dialogue: 0,0:04:41.63,0:04:43.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barang yang luar biasa.
Dialogue: 0,0:04:43.29,0:04:45.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kamu yang membuatnya?
Dialogue: 0,0:04:45.77,0:04:49.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya tukang jagal punya kemampuan\N"Pengolahan Perlengkapan".
Dialogue: 0,0:04:51.80,0:04:55.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyelesaian kainnya pun\Ndijahit dengan rapi, ya.
Dialogue: 0,0:04:58.69,0:05:00.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh aku ambil?
Dialogue: 0,0:05:00.82,0:05:02.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:05:02.00,0:05:03.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini masih belum jadi.
Dialogue: 0,0:05:03.53,0:05:05.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum jadi?
Dialogue: 0,0:05:05.85,0:05:07.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah efek transparannya habis,
Dialogue: 0,0:05:07.73,0:05:09.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nanti akan langsung terlihat telanjang.
Dialogue: 0,0:05:12.63,0:05:14.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, yang tadi itu, ya?
Dialogue: 0,0:05:14.67,0:05:16.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti itulah.
Dialogue: 0,0:05:16.55,0:05:19.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi akan kuberikan nanti\Nkalau sudah selesai.
Dialogue: 0,0:05:19.13,0:05:21.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:05:23.93,0:05:25.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Me-Melissa?
Dialogue: 0,0:05:26.39,0:05:29.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena sudah bekerja keras,\Naku jadi ingin mengelusmu.
Dialogue: 0,0:05:29.56,0:05:31.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Eh?
Dialogue: 0,0:05:31.40,0:05:34.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anu, aku sangat senang,
Dialogue: 0,0:05:34.69,0:05:37.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi tetap saja terasa malu.
Dialogue: 0,0:05:37.44,0:05:40.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya, aku tak pernah\Nmelakukan hal yang hebat.
Dialogue: 0,0:05:40.86,0:05:41.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa, sih?
Dialogue: 0,0:05:44.49,0:05:47.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, tidak, maaf.
Dialogue: 0,0:05:47.03,0:05:49.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya menyenangkan.
Dialogue: 0,0:05:49.50,0:05:50.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyenangkan?
Dialogue: 0,0:05:50.88,0:05:52.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:05:52.20,0:05:54.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, Melissa...
Dialogue: 0,0:05:54.50,0:05:58.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah ini mau mengobrol\Nlebih banyak bersamaku?
Dialogue: 0,0:06:09.06,0:06:12.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya sudah lama\Naku ingin berkunjung ke sini.
Dialogue: 0,0:06:12.73,0:06:16.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kamu sering datang\Nke kedai seperti ini?
Dialogue: 0,0:06:16.59,0:06:17.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:06:17.55,0:06:19.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya aku ada pekerjaan pemotongan.
Dialogue: 0,0:06:20.89,0:06:23.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, padahal sedang sibuk-sibuknya.
Dialogue: 0,0:06:23.57,0:06:26.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tidak apa-apa.
Dialogue: 0,0:06:26.03,0:06:28.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paling pengerjaan Suit-nya bakal terlambat saja.
Dialogue: 0,0:06:28.87,0:06:31.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:06:31.00,0:06:32.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bercanda.
Dialogue: 0,0:06:32.25,0:06:34.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak akan mengabaikan pekerjaan.
Dialogue: 0,0:06:35.40,0:06:38.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang bisa mengajakmu hari ini.
Dialogue: 0,0:06:38.01,0:06:40.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa mendengarmu bercanda juga.
Dialogue: 0,0:06:40.95,0:06:42.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang terpenting,
Dialogue: 0,0:06:42.67,0:06:46.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sudah lama sekali\Ntidak bersantai seperti ini.
Dialogue: 0,0:06:46.80,0:06:49.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Madoka, selama ini apa yang kamu lakukan?
Dialogue: 0,0:06:49.39,0:06:52.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang aku lakukan?
Dialogue: 0,0:06:52.01,0:06:54.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum menjadi rekan Arihito.
Dialogue: 0,0:06:54.02,0:06:55.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:06:55.27,0:06:59.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin buka toko sendiri,\Njadi memilih menjadi pedagang.
Dialogue: 0,0:06:59.24,0:07:02.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, karena tidak bisa\Nmasuk labirin sendirian,
Dialogue: 0,0:07:02.11,0:07:04.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}awalnya memang sangat sulit.
Dialogue: 0,0:07:04.01,0:07:05.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjadi pedagang itu sulit?
Dialogue: 0,0:07:05.82,0:07:07.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak juga, kok.
Dialogue: 0,0:07:07.70,0:07:10.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ikut senang\Nbisa membuat pelanggan senang.
Dialogue: 0,0:07:10.99,0:07:13.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti sama sepertiku.
Dialogue: 0,0:07:13.50,0:07:15.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa jadi begitu.
Dialogue: 0,0:07:16.83,0:07:19.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang rasanya bisa mendengarkan ceritamu.
Dialogue: 0,0:07:19.42,0:07:20.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah aku ke sini.
Dialogue: 0,0:07:20.71,0:07:24.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti aku juga bersyukur sudah mengajakmu.
Dialogue: 0,0:07:24.33,0:07:27.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jarang mengobrol dengan anak seumuran.
Dialogue: 0,0:07:27.97,0:07:28.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi pengalaman baru.
Dialogue: 0,0:07:28.89,0:07:30.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:07:30.39,0:07:31.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu temanmu?
Dialogue: 0,0:07:31.51,0:07:32.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak punya.
Dialogue: 0,0:07:32.58,0:07:37.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya aku anak dari ibu manusia kucing,\Nsedangkan ayahku manusia biasa.
Dialogue: 0,0:07:37.55,0:07:39.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi banyak yang takut padaku.
Dialogue: 0,0:07:41.69,0:07:43.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan karena itu dia...
Dialogue: 0,0:07:50.57,0:07:51.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:07:51.41,0:07:53.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, bukan apa-apa.
Dialogue: 0,0:07:54.37,0:07:56.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Madoka, kamu tidak takut?
Dialogue: 0,0:07:56.37,0:07:58.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Takut apa?
Dialogue: 0,0:07:58.79,0:08:01.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahwa aku punya darah setengah manusia.
Dialogue: 0,0:08:01.75,0:08:03.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, sama sekali.
Dialogue: 0,0:08:03.79,0:08:06.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia juga setengah manusia,
Dialogue: 0,0:08:06.01,0:08:09.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan malah menurutku kamu itu menggemaskan.
Dialogue: 0,0:08:10.43,0:08:11.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:08:12.22,0:08:15.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi, aku bilang sibuk karena ada pekerjaan.
Dialogue: 0,0:08:16.60,0:08:17.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya?
Dialogue: 0,0:08:17.56,0:08:19.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak keberatan,
Dialogue: 0,0:08:19.37,0:08:21.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ingin kamu mengajakku lagi.
Dialogue: 0,0:08:23.07,0:08:24.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, tenang saja.
Dialogue: 0,0:08:27.57,0:08:30.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi Melissa pergi keluar, lo.
Dialogue: 0,0:08:31.03,0:08:34.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya mau pergi main\Ndengan rekan kelompoknya Arihito.
Dialogue: 0,0:08:36.12,0:08:37.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Felis.
Dialogue: 0,0:08:38.12,0:08:39.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak menyangka
Dialogue: 0,0:08:39.71,0:08:44.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melissa akan mengatakan, "Aku mau makan di luar,\Njadi tak perlu siapkan makan malam."
Dialogue: 0,0:08:46.26,0:08:47.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pasti
Dialogue: 0,0:08:47.85,0:08:50.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berkat bantuan Arihito.
Dialogue: 0,0:08:59.42,0:09:01.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dirty Mash.
Dialogue: 0,0:09:01.15,0:09:04.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster jamur itu levelnya tidak terlalu tinggi.
Dialogue: 0,0:09:04.32,0:09:05.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:09:05.94,0:09:08.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya!\NKita lawan dengan penuh semangat!
Dialogue: 0,0:09:08.28,0:09:09.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:09:14.41,0:09:15.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, Shion.
Dialogue: 0,0:09:15.83,0:09:17.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahan terus seperti itu.
Dialogue: 0,0:09:17.75,0:09:20.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Igarashi dan Theresia\Nurus jamur yang di sana!
Dialogue: 0,0:09:20.46,0:09:21.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:09:29.47,0:09:31.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita coba kekuatan rune.
Dialogue: 0,0:09:32.38,0:09:33.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Force Shoot!
Dialogue: 0,0:09:37.72,0:09:39.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan yang luar biasa.
Dialogue: 0,0:09:49.53,0:09:52.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, yang satunya tampak aneh!
Dialogue: 0,0:09:57.95,0:09:58.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia!
Dialogue: 0,0:10:00.45,0:10:02.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, serangan balik!
Dialogue: 0,0:10:02.96,0:10:05.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suzuna, gunakan serangan jarak jauh!
Dialogue: 0,0:10:05.54,0:10:06.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:10:07.09,0:10:08.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenalah!
Dialogue: 0,0:10:13.22,0:10:15.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia, kamu tidak apa-apa?
Dialogue: 0,0:10:20.52,0:10:21.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia?
Dialogue: 0,0:10:21.77,0:10:23.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu efek status Kebingungan.
Dialogue: 0,0:10:23.85,0:10:28.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mata Theresia,\Nkita pasti terlihat seperti musuh.
Dialogue: 0,0:10:28.98,0:10:30.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan, Theresia!
Dialogue: 0,0:10:38.45,0:10:41.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia, tidak usah dipikirkan.
Dialogue: 0,0:10:41.31,0:10:44.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami juga tidak apa-apa berkat Suzuna.
Dialogue: 0,0:10:44.16,0:10:46.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia!
Dialogue: 0,0:10:46.00,0:10:49.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tak ada cara menghilangkan\Nstatus Kebingungan-nya?
Dialogue: 0,0:10:49.50,0:10:51.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia, aku akan menyembuhkanmu!
Dialogue: 0,0:10:56.09,0:10:57.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kemampuan baru yang aku ambil
Dialogue: 0,0:10:57.80,0:11:00.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa berguna.
Dialogue: 0,0:11:02.18,0:11:04.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tampak murung.
Dialogue: 0,0:11:04.01,0:11:06.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia merasa bertanggung jawab,
Dialogue: 0,0:11:06.32,0:11:09.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi kalau salah menghibur\Nmalah berdampak buruk.
Dialogue: 0,0:11:09.40,0:11:11.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, hei, lihat!
Dialogue: 0,0:11:11.98,0:11:13.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya enak.
Dialogue: 0,0:11:13.99,0:11:15.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Oh...
Dialogue: 0,0:11:15.83,0:11:19.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu item yang jatuh dari monster pohon, kan?
Dialogue: 0,0:11:19.95,0:11:21.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:11:21.41,0:11:23.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi aku sempat identifikasi.
Dialogue: 0,0:11:23.95,0:11:25.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya ini item yang sangat langka.
Dialogue: 0,0:11:25.92,0:11:28.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Efeknya apa?
Dialogue: 0,0:11:30.15,0:11:32.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata luar biasa juga.
Dialogue: 0,0:11:32.63,0:11:36.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Item ini harusnya sangat jarang didapat.
Dialogue: 0,0:11:37.18,0:11:41.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misaki punya kemampuan meningkatkan\Nrasio drop item langka,
Dialogue: 0,0:11:41.10,0:11:43.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi mungkin karena efek itu.
Dialogue: 0,0:11:43.01,0:11:44.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, siapa yang akan memakannya?
Dialogue: 0,0:11:45.52,0:11:47.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin sebaiknya Atobe saja.
Dialogue: 0,0:11:47.94,0:11:49.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku?
Dialogue: 0,0:11:49.69,0:11:51.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setuju.
Dialogue: 0,0:11:51.16,0:11:55.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Force Shoot yang tadi kamu gunakan\Njuga tampaknya memakan banyak mana sihir.
Dialogue: 0,0:11:55.95,0:11:57.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:11:57.87,0:11:59.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, tunggu dulu!
Dialogue: 0,0:12:00.41,0:12:04.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya Theresia tertarik dengan ini.
Dialogue: 0,0:12:08.79,0:12:10.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ingin memakannya?
Dialogue: 0,0:12:13.09,0:12:14.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, kamu mau apa?
Dialogue: 0,0:12:18.51,0:12:21.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh! Mengupas kulit apel!
Dialogue: 0,0:12:21.05,0:12:24.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku, sepertinya\Ntidak bisa mengupas sebagus itu.
Dialogue: 0,0:12:33.57,0:12:35.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, terima kasih.
Dialogue: 0,0:12:37.40,0:12:38.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia?
Dialogue: 0,0:12:42.24,0:12:44.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Disuapi, ya!
Dialogue: 0,0:12:46.87,0:12:48.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng...
Dialogue: 0,0:12:58.05,0:13:01.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah Theresia sudah terlihat ceria lagi.
Dialogue: 0,0:13:01.51,0:13:02.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:13:05.51,0:13:06.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shion?
Dialogue: 0,0:13:06.97,0:13:08.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kenapa?
Dialogue: 0,0:13:08.48,0:13:12.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia sedang mencari sesuatu?
Dialogue: 0,0:13:13.94,0:13:15.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita ikuti.
Dialogue: 0,0:13:27.04,0:13:28.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sana ada orang!
Dialogue: 0,0:13:30.83,0:13:31.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:13:33.33,0:13:34.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Georg!
Dialogue: 0,0:13:37.17,0:13:40.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Persahabatan itu sangat dalam.
Dialogue: 0,0:13:41.93,0:13:43.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan melakukan trik sulap.
Dialogue: 0,0:13:46.43,0:13:47.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Georg.
Dialogue: 0,0:13:48.44,0:13:50.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini potion, bisa kamu minum?
Dialogue: 0,0:13:57.57,0:14:00.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arihito, aku...
Dialogue: 0,0:14:00.36,0:14:03.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pingsan di dalam labirin.
Dialogue: 0,0:14:03.12,0:14:04.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:14:05.37,0:14:06.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi?
Dialogue: 0,0:14:06.91,0:14:09.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, aku...
Dialogue: 0,0:14:12.16,0:14:13.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak suka kabut ini.
Dialogue: 0,0:14:18.92,0:14:20.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahaya, Georg!
Dialogue: 0,0:14:26.68,0:14:28.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sophie!
Dialogue: 0,0:14:39.94,0:14:41.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!
Dialogue: 0,0:14:41.74,0:14:44.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makhluk apa itu?
Dialogue: 0,0:14:44.12,0:14:46.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Thunder Wave!
Dialogue: 0,0:14:50.08,0:14:51.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana sihirnya sudah habis.
Dialogue: 0,0:14:51.70,0:14:53.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terus begini, kita semua bisa mati.
Dialogue: 0,0:14:53.84,0:14:56.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemimpin, pergilah panggil bantuan!
Dialogue: 0,0:15:05.93,0:15:06.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sophie!
Dialogue: 0,0:15:06.93,0:15:08.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mikhail!
Dialogue: 0,0:15:08.25,0:15:09.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jake!
Dialogue: 0,0:15:09.40,0:15:11.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taira!
Dialogue: 0,0:15:11.01,0:15:12.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenanglah.
Dialogue: 0,0:15:12.41,0:15:13.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuhnya seperti apa?
Dialogue: 0,0:15:15.44,0:15:16.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster.
Dialogue: 0,0:15:16.67,0:15:17.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!
Dialogue: 0,0:15:17.93,0:15:20.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster seperti tanaman muncul dari tanah.
Dialogue: 0,0:15:23.82,0:15:25.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa bisa begitu?
Dialogue: 0,0:15:25.40,0:15:28.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal sebelum sampai sana,\Nsemua lancar-lancar saja!
Dialogue: 0,0:15:34.54,0:15:36.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini berbahaya.
Dialogue: 0,0:15:36.42,0:15:39.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakailah ini dan pergi dari sini.
Dialogue: 0,0:15:39.21,0:15:43.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku tidak mungkin
Dialogue: 0,0:15:43.63,0:15:45.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}meninggalkan mereka sendirian!
Dialogue: 0,0:15:45.85,0:15:49.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi sudah sejauh ini.
Dialogue: 0,0:15:50.89,0:15:53.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan berarti kamu kabur.
Dialogue: 0,0:15:53.00,0:15:56.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami ingin kamu keluar\Ndan panggil bantuan.
Dialogue: 0,0:15:59.31,0:16:02.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami juga ke sini untuk melaksanakan ujian.
Dialogue: 0,0:16:02.65,0:16:05.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun, kami harus melewati ini.
Dialogue: 0,0:16:05.65,0:16:07.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, tenang saja.
Dialogue: 0,0:16:24.80,0:16:26.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cantik, ya.
Dialogue: 0,0:16:27.09,0:16:29.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, lihat!\NDi sana ada orang!
Dialogue: 0,0:16:32.30,0:16:34.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:16:42.19,0:16:45.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kamu anggota Polaris?
Dialogue: 0,0:16:45.29,0:16:46.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana yang lain?
Dialogue: 0,0:16:46.94,0:16:50.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teman-temanku baik-baik saja.
Dialogue: 0,0:16:50.21,0:16:52.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sedang istirahat di depan sana.
Dialogue: 0,0:16:52.33,0:16:53.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian mau ke sana?
Dialogue: 0,0:16:53.91,0:16:56.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Eng...
Dialogue: 0,0:16:56.13,0:16:57.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu siapa?
Dialogue: 0,0:16:57.37,0:17:00.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Sophie, salam kenal.
Dialogue: 0,0:17:00.33,0:17:02.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, syukurlah.
Dialogue: 0,0:17:02.58,0:17:06.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah mendengar cerita dari Georg,\Nkami datang untuk menyelamatkan kalian.
Dialogue: 0,0:17:06.77,0:17:09.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, terima kasih.
Dialogue: 0,0:17:09.30,0:17:13.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami dengar kalian\Ndiserang monster berbahaya.
Dialogue: 0,0:17:13.01,0:17:15.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang berbahaya, kok.
Dialogue: 0,0:17:15.31,0:17:17.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Benarkah?
Dialogue: 0,0:17:26.28,0:17:28.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Georg sudah keluar dari labirin.
Dialogue: 0,0:17:28.76,0:17:30.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kalian juga keluar dari sini.
Dialogue: 0,0:17:30.70,0:17:31.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluar?
Dialogue: 0,0:17:31.95,0:17:35.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pikir tidak perlu\Nburu-buru keluar seperti itu.
Dialogue: 0,0:17:35.28,0:17:36.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, benar juga!
Dialogue: 0,0:17:36.83,0:17:39.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada banyak drop dari monster\Nyang kami kalahkan.
Dialogue: 0,0:17:39.45,0:17:42.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan teman-temanku\Ntak sanggup membawanya.
Dialogue: 0,0:17:42.09,0:17:45.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti kami beri imbalan,\Nbisa tolong bantu bawakan?
Dialogue: 0,0:17:45.04,0:17:47.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja bisa kalau hanya sebatas itu.
Dialogue: 0,0:17:48.01,0:17:49.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:17:49.38,0:17:50.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari, sebelah sini.
Dialogue: 0,0:17:55.76,0:17:56.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elitia?
Dialogue: 0,0:17:56.89,0:17:58.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:17:59.73,0:18:02.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berniat hentikan seranganku\Nkalau dia tak bereaksi.
Dialogue: 0,0:18:02.87,0:18:04.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dugaanku benar.
Dialogue: 0,0:18:07.23,0:18:09.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, hati-hati!
Dialogue: 0,0:18:09.20,0:18:11.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sedang dikendalikan oleh sesuatu!
Dialogue: 0,0:18:11.70,0:18:13.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, benar sekali.
Dialogue: 0,0:18:13.83,0:18:16.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu bisa tahu?
Dialogue: 0,0:18:16.03,0:18:19.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya kamu membereskan\Nsenjata yang rusak itu.
Dialogue: 0,0:18:19.28,0:18:21.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada seorang pun penjelajah
Dialogue: 0,0:18:21.04,0:18:24.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang memikirkan harta\Nsaat buruannya seperti itu.
Dialogue: 0,0:18:26.21,0:18:28.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh juga kalian.
Dialogue: 0,0:18:28.13,0:18:30.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai hadiah karena tebakan kalian benar,
Dialogue: 0,0:18:38.18,0:18:40.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan kujadikan kalian santapan.
Dialogue: 0,0:18:43.02,0:18:44.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Level 5!
Dialogue: 0,0:18:44.27,0:18:46.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanaman Merambat Pengendali!
Dialogue: 0,0:18:46.25,0:18:47.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia monster bernama!
Dialogue: 0,0:18:47.61,0:18:49.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berubah menjadi monster?
Dialogue: 0,0:18:49.60,0:18:52.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, apa dia hanya dikendalikan?
Dialogue: 0,0:18:52.07,0:18:55.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia hanya sedang dikendalikan!
Dialogue: 0,0:18:55.11,0:18:57.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat dia tidak berdaya!
Dialogue: 0,0:18:57.03,0:18:59.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan ini.
Dialogue: 0,0:19:04.16,0:19:06.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shion, terima kasih.
Dialogue: 0,0:19:06.12,0:19:08.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peliharaan yang tidak sopan.
Dialogue: 0,0:19:08.39,0:19:09.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau ini?
Dialogue: 0,0:19:13.51,0:19:15.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:19:28.86,0:19:31.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin, ini...
Dialogue: 0,0:19:34.86,0:19:36.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Power Strike!
Dialogue: 0,0:19:37.53,0:19:39.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertahanan Dukungan!
Dialogue: 0,0:19:45.62,0:19:48.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatannya melebihi Dukungan Atobe?
Dialogue: 0,0:19:48.83,0:19:51.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mereka juga dikendalikan?
Dialogue: 0,0:19:53.26,0:19:54.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurang ajar.
Dialogue: 0,0:19:55.59,0:19:58.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mengendalikan penjelajah seperti alat.
Dialogue: 0,0:20:01.18,0:20:02.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak bisa dimaafkan!
Dialogue: 0,0:20:06.52,0:20:08.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Breaker Swing.
Dialogue: 0,0:20:12.82,0:20:15.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di-Dia terlalu kuat.
Dialogue: 0,0:20:15.61,0:20:18.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena dikendalikan,\Nserangannya jadi tak kenal ampun.
Dialogue: 0,0:20:18.82,0:20:21.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedangkan kami...
Dialogue: 0,0:20:23.54,0:20:26.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kalian sanggup membunuh manusia?
Dialogue: 0,0:20:29.58,0:20:31.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Thunder Wave.
Dialogue: 0,0:20:32.42,0:20:33.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Thunderbolt!
Dialogue: 0,0:20:36.09,0:20:39.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelas pekerjaan musuh\Nsepertinya tipe penyihir.
Dialogue: 0,0:20:39.26,0:20:42.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kita duluan\Nyang akan kehabisan mana.
Dialogue: 0,0:20:43.81,0:20:45.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wall Guard.
Dialogue: 0,0:20:56.69,0:20:59.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuh aslinya mungkin\Nbersembunyi di suatu tempat!
Dialogue: 0,0:20:59.70,0:21:01.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kita bisa mengalahkannya...
Dialogue: 0,0:21:01.20,0:21:05.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau tubuhnya bersembunyi\Ndi dalam tanah seperti kepompong tadi,
Dialogue: 0,0:21:05.95,0:21:07.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan sulit menemukannya.
Dialogue: 0,0:21:10.40,0:21:12.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi dalam kondisi ini,
Dialogue: 0,0:21:12.29,0:21:14.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami tak bisa mencarinya dengan tenang.
Dialogue: 0,0:21:15.17,0:21:18.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suzuna, kalau mereka memang dikendalikan,
Dialogue: 0,0:21:18.26,0:21:20.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa kamu bisa menyembuhkannya\Ndengan kemampuanmu?
Dialogue: 0,0:21:20.86,0:21:22.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu.
Dialogue: 0,0:21:22.01,0:21:24.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus dilakukan dengan sangat dekat,
Dialogue: 0,0:21:24.68,0:21:25.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi tak bisa langsung.
Dialogue: 0,0:21:30.94,0:21:34.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, akan kusingkirkan\Norang-orang yang mengganggu.
Dialogue: 0,0:21:40.65,0:21:42.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shion, terima kasih!
Dialogue: 0,0:21:44.57,0:21:46.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bagaimana ini?
Dialogue: 0,0:21:46.16,0:21:48.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Pertahanan Dukungan\Ntak bisa melindungi,
Dialogue: 0,0:21:48.58,0:21:50.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menyuruh Suzuna maju akan sangat berbahaya.
Dialogue: 0,0:21:51.46,0:21:52.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tak ada cara lain?
Dialogue: 0,0:21:52.81,0:21:54.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara lain
Dialogue: 0,0:21:55.67,0:21:58.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang bisa membuatnya tak berdaya.
Dialogue: 0,0:21:59.09,0:22:00.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak berdaya?
Dialogue: 0,0:22:00.67,0:22:01.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga!
Dialogue: 0,0:22:01.80,0:22:04.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun yang kalian lakukan sia-sia.
Dialogue: 0,0:22:06.47,0:22:08.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Datanglah, Demi Harpy!
