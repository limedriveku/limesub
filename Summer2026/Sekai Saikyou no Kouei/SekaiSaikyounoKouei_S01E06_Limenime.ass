Dialogue: 0,0:00:46.15,0:00:46.53,sign,,0000,0000,0000,,LOKASI SAAT INI: AREA YANG BELUM DIJAMAH
Dialogue: 0,0:00:46.53,0:00:47.03,sign,,0000,0000,0000,,RETURN SCROLL TERKUNCI KARENA\NDI LUAR AREA YANG TERSEDIA
Dialogue: 0,0:01:52.43,0:02:03.06,sign,,0000,0000,0000,,GARDA BELAKANG TERKUAT DI DUNIA\N~PENJELAJAH PEMULA DI NEGERI LABIRIN~
Dialogue: 0,0:03:10.96,0:03:15.97,sign,,0000,0000,0000,,ARIADNE SANG AUTOMATON
Dialogue: 0,0:03:32.32,0:03:35.79,sign,,0000,0000,0000,,INDRA SPIRITUAL LV. 1
Dialogue: 0,0:04:30.88,0:04:31.62,sign,,0000,0000,0000,,PELEPASAN SEMANGAT TEMPUR
Dialogue: 0,0:05:24.18,0:05:28.43,sign,,0000,0000,0000,,PRAJURIT RAKSASA BERKEPALA ELANG LV. 6
Dialogue: 0,0:05:28.43,0:05:30.06,sign,,0000,0000,0000,,DROP: ???
Dialogue: 0,0:05:51.16,0:05:53.00,sign,,0000,0000,0000,,SERANGAN GANDA
Dialogue: 0,0:05:59.80,0:06:01.38,sign,,0000,0000,0000,,LANGKAH KILAT
Dialogue: 0,0:06:06.60,0:06:07.47,sign,,0000,0000,0000,,TARIAN PEDANG
Dialogue: 0,0:06:19.44,0:06:20.57,sign,,0000,0000,0000,,HANTAMAN ANGIN
Dialogue: 0,0:07:03.53,0:07:05.45,sign,,0000,0000,0000,,SERANGAN SONIK
Dialogue: 0,0:08:07.51,0:08:08.13,sign,,0000,0000,0000,,MUSUH MENGAKTIFKAN HANTAMAN ANGIN,
Dialogue: 0,0:08:08.13,0:08:08.60,sign,,0000,0000,0000,,BERLANJUT MENJADI BULU DURI
Dialogue: 0,0:08:08.60,0:08:09.23,sign,,0000,0000,0000,,MENGENAI SEMUA ANGGOTA PARTY
Dialogue: 0,0:08:09.23,0:08:09.80,sign,,0000,0000,0000,,HP ARIHITO BERKURANG DRASTIS
Dialogue: 0,0:08:51.97,0:08:53.93,sign,,0000,0000,0000,,GARDA BELAKANG TERKUAT DI DUNIA
Dialogue: 0,0:08:53.93,0:08:56.97,sign,,0000,0000,0000,,~PENJELAJAH PEMULA DI NEGERI LABIRIN~
Dialogue: 0,0:08:56.97,0:08:59.60,sign,,0000,0000,0000,,GARDA BELAKANG TERKUAT DI DUNIA
Dialogue: 0,0:08:59.60,0:09:01.98,sign,,0000,0000,0000,,~PENJELAJAH PEMULA DI NEGERI LABIRIN~
Dialogue: 0,0:09:07.03,0:09:08.99,sign,,0000,0000,0000,,PELEPASAN SEMANGAT TEMPUR\NDIAKTIFKAN
Dialogue: 0,0:09:09.40,0:09:12.36,sign,,0000,0000,0000,,LOMPATAN JIWA
Dialogue: 0,0:10:21.56,0:10:26.61,sign,,0000,0000,0000,,SERANGAN TAMBAHAN ARWAH TEMPUR
Dialogue: 0,0:10:33.11,0:10:34.57,sign,,0000,0000,0000,,PEDANG KELOPAK
Dialogue: 0,0:18:50.94,0:18:51.94,sign,,0000,0000,0000,,DEWA YANG DISEMBAH
Dialogue: 0,0:00:04.65,0:00:08.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini lempengan batu\Nuntuk berteleportasi ke lantai lain.
Dialogue: 0,0:00:13.45,0:00:15.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, duh.
Dialogue: 0,0:00:15.73,0:00:17.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misaki, cepat kemari.
Dialogue: 0,0:00:21.83,0:00:22.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat!
Dialogue: 0,0:00:42.06,0:00:43.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takut!
Dialogue: 0,0:00:43.90,0:00:46.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Tenanglah, Misaki.
Dialogue: 0,0:00:47.03,0:00:50.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya Return Scroll\Ntidak bisa digunakan.
Dialogue: 0,0:00:50.49,0:00:54.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu artinya,\Ntak ada pilihan selain terus maju.
Dialogue: 0,0:00:59.46,0:01:03.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu\Nmusuh apa yang sudah menanti.
Dialogue: 0,0:01:03.43,0:01:06.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, apa pun itu bukan masalah.
Dialogue: 0,0:01:06.67,0:01:08.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai rekan,
Dialogue: 0,0:01:08.88,0:01:10.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebagai garda belakang,
Dialogue: 0,0:01:35.78,0:01:39.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku hanya perlu melindungi party-ku!
Dialogue: 0,0:03:18.89,0:03:21.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, boleh bicara sebentar?
Dialogue: 0,0:03:21.14,0:03:22.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Suzuna?
Dialogue: 0,0:03:22.85,0:03:26.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasakan sesuatu di sekitar sini.
Dialogue: 0,0:03:26.69,0:03:28.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan seorang Gadis Kuil?
Dialogue: 0,0:03:28.61,0:03:29.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:03:29.75,0:03:32.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku rasa karena kemampuan ini.
Dialogue: 0,0:03:32.32,0:03:34.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Indra Spiritual?
Dialogue: 0,0:03:34.24,0:03:35.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi begitu.
Dialogue: 0,0:03:35.79,0:03:38.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agak samar, tapi aku merasakannya.
Dialogue: 0,0:03:41.47,0:03:43.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang bertarung melawan sesuatu di sini
Dialogue: 0,0:03:43.61,0:03:46.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hingga kehilangan nyawanya.
Dialogue: 0,0:03:47.50,0:03:49.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuatu, ya?
Dialogue: 0,0:03:50.75,0:03:53.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Firasatku itu golem.
Dialogue: 0,0:03:53.05,0:03:55.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Golem?
Dialogue: 0,0:03:56.05,0:03:58.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa benda itu bisa bergerak?
Dialogue: 0,0:03:58.47,0:04:01.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya terlalu berlebihan, deh.
Dialogue: 0,0:04:02.10,0:04:05.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa "sesuatu" yang harus dilawan pun,
Dialogue: 0,0:04:05.31,0:04:07.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}patung itu sudah terlihat mencurigakan.
Dialogue: 0,0:04:09.90,0:04:13.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, rasanya ada aura\Nyang tidak menenangkan.
Dialogue: 0,0:04:14.51,0:04:16.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya akan sulit ditebas dengan pedang.
Dialogue: 0,0:04:17.38,0:04:19.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau ada dukungan Arihito,
Dialogue: 0,0:04:19.66,0:04:21.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harusnya bisa memberikan kerusakan.
Dialogue: 0,0:04:22.62,0:04:24.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hajar dia dengan serangan yang banyak.
Dialogue: 0,0:04:24.69,0:04:26.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:04:26.04,0:04:29.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga akan menyerangnya\Nkalau ada celah!
Dialogue: 0,0:04:29.04,0:04:30.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati dan jangan dipaksakan.
Dialogue: 0,0:04:31.62,0:04:36.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atobe, sepertinya aku dan Theresia\Nbisa memakai Pelepasan Semangat Tempur.
Dialogue: 0,0:04:38.05,0:04:41.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti kita coba seperti apa efeknya.
Dialogue: 0,0:04:41.01,0:04:42.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:04:42.55,0:04:45.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elitia juga sebentar lagi bisa memakainya.
Dialogue: 0,0:04:45.60,0:04:49.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya Pelepasan Semangat Tempur-ku\Ntidak digunakan dulu.
Dialogue: 0,0:04:49.55,0:04:52.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya cuma bisa dipakai\Nsaat Berserk-ku aktif.
Dialogue: 0,0:04:52.31,0:04:53.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:04:53.84,0:04:57.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah mengatasi kutukan pedang itu,\Nbarulah aku
Dialogue: 0,0:04:57.16,0:04:59.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan memintamu memakai\NPelepasan Semangat Tempur.
Dialogue: 0,0:04:59.40,0:05:00.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:05:02.45,0:05:05.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada hal lain lagi\Nyang perlu diperhatikan?
Dialogue: 0,0:05:10.96,0:05:13.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ayo mulai.
Dialogue: 0,0:05:20.97,0:05:22.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga bisa bergerak.
Dialogue: 0,0:05:24.18,0:05:26.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Prajurit Raksasa Berkepala Elang.
Dialogue: 0,0:05:26.51,0:05:28.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster bernama level 6!
Dialogue: 0,0:05:28.43,0:05:30.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia musuh yang sangat kuat!
Dialogue: 0,0:05:39.49,0:05:41.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Levelnya lebih tinggi dari Juggernaut?
Dialogue: 0,0:05:41.90,0:05:43.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya tak akan mudah dikalahkan.
Dialogue: 0,0:05:43.86,0:05:46.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, jangan patah semangat!
Dialogue: 0,0:05:47.16,0:05:47.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:05:51.16,0:05:53.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Double Attack!
Dialogue: 0,0:05:55.92,0:05:58.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Igarashi, awas serangan balasan!
Dialogue: 0,0:05:59.80,0:06:01.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Blink Step!
Dialogue: 0,0:06:01.38,0:06:02.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elitia, sekarang!
Dialogue: 0,0:06:02.88,0:06:06.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hancurlah, Blade Rondo.
Dialogue: 0,0:06:11.73,0:06:12.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenalah!
Dialogue: 0,0:06:14.90,0:06:16.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia melindungi kepalanya?
Dialogue: 0,0:06:16.88,0:06:18.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:06:24.91,0:06:26.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eli!
Dialogue: 0,0:06:39.96,0:06:40.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sana!
Dialogue: 0,0:06:44.43,0:06:45.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:06:45.81,0:06:48.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya! Kelemahannya ada di kepala!
Dialogue: 0,0:06:48.51,0:06:50.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kita harus fokus ke sana.
Dialogue: 0,0:06:50.85,0:06:53.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu, ada sesuatu!
Dialogue: 0,0:06:57.81,0:06:59.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perilakunya berubah?
Dialogue: 0,0:07:00.48,0:07:02.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuserang!
Dialogue: 0,0:07:03.53,0:07:05.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sonic Raid!
Dialogue: 0,0:07:09.45,0:07:10.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat sekali!
Dialogue: 0,0:07:12.79,0:07:13.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertahanan Dukungan!
Dialogue: 0,0:07:26.88,0:07:27.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat!
Dialogue: 0,0:07:27.84,0:07:29.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pasti serangan area!
Dialogue: 0,0:07:38.77,0:07:40.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin!
Dialogue: 0,0:07:46.78,0:07:48.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atobe!
Dialogue: 0,0:07:48.78,0:07:50.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kyouka, Theresia.
Dialogue: 0,0:07:50.79,0:07:52.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jaga Arihito.
Dialogue: 0,0:07:55.33,0:07:57.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku yang mengurusnya.
Dialogue: 0,0:07:57.11,0:07:58.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubantu!
Dialogue: 0,0:08:03.63,0:08:05.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abang!
Dialogue: 0,0:08:06.34,0:08:07.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Atobe!\N- Ini tidak mungkin.
Dialogue: 0,0:08:07.51,0:08:09.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertahanlah, Atobe!
Dialogue: 0,0:08:09.80,0:08:12.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh.
Dialogue: 0,0:08:19.81,0:08:24.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bukan musuh yang bisa dilawan\Ndengan level kita sekarang.
Dialogue: 0,0:08:24.94,0:08:27.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini, Abang bisa...
Dialogue: 0,0:08:28.24,0:08:29.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak apa-apa.
Dialogue: 0,0:08:30.07,0:08:31.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya jangan bicara.
Dialogue: 0,0:08:31.41,0:08:32.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulihkan dulu dirimu.
Dialogue: 0,0:08:33.17,0:08:34.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak,
Dialogue: 0,0:08:34.35,0:08:38.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk memulihkan diri,\Nkita harus mengalahkannya dulu.
Dialogue: 0,0:08:38.50,0:08:41.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, aku masih punya teknik rahasia.
Dialogue: 0,0:08:43.66,0:08:47.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Igarashi, lakukan Pelepasan Semangat Tempur.
Dialogue: 0,0:08:47.09,0:08:48.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia juga.
Dialogue: 0,0:08:51.97,0:08:53.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yey, hore!
Dialogue: 0,0:08:53.93,0:08:56.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagian A sudah selesai!
Dialogue: 0,0:08:56.97,0:08:59.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu, wa, tu, wa.
Dialogue: 0,0:08:59.60,0:09:01.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagian B segera dimulai!
Dialogue: 0,0:09:04.15,0:09:07.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelepasan Semangat Tempur, Soul Blink!
Dialogue: 0,0:09:13.60,0:09:16.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini... aku?
Dialogue: 0,0:09:21.96,0:09:25.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini klona fisik?
Dialogue: 0,0:09:25.04,0:09:26.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Thunderbolt!
Dialogue: 0,0:09:31.93,0:09:34.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa! Dengan begini...
Dialogue: 0,0:09:34.35,0:09:37.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pakai teknik yang tadi lagi!
Dialogue: 0,0:09:38.77,0:09:40.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak akan kubiarkan dia...
Dialogue: 0,0:09:40.13,0:09:41.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyentuh Bang Arihito!
Dialogue: 0,0:09:41.56,0:09:43.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan! Terlalu berbahaya!
Dialogue: 0,0:09:43.60,0:09:45.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja, Atobe.
Dialogue: 0,0:09:45.56,0:09:47.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, pakai arwah tempur sebagai perisai!
Dialogue: 0,0:09:47.85,0:09:49.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, kalau begitu...
Dialogue: 0,0:09:55.70,0:09:56.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi begitu.
Dialogue: 0,0:09:56.99,0:10:01.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertahanan Dukungan Abang\Nbisa dipakai untuk arwah tempur juga.
Dialogue: 0,0:10:01.00,0:10:01.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:10:07.32,0:10:08.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arihito?
Dialogue: 0,0:10:08.38,0:10:12.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya teknik tadi\Ntak bisa dipakai terus-menerus.
Dialogue: 0,0:10:12.34,0:10:13.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:10:16.47,0:10:17.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Back Stand.
Dialogue: 0,0:10:27.19,0:10:28.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus! Sekarang!
Dialogue: 0,0:10:28.94,0:10:30.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan padaku!
Dialogue: 0,0:10:30.65,0:10:33.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mekarlah, Blossom Blade!
Dialogue: 0,0:10:39.08,0:10:41.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih bisa bergerak?
Dialogue: 0,0:10:42.04,0:10:42.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisi dia!
Dialogue: 0,0:10:42.75,0:10:43.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:10:46.17,0:10:48.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan!
Dialogue: 0,0:10:48.63,0:10:49.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misaki?
Dialogue: 0,0:11:11.48,0:11:13.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kita menang?
Dialogue: 0,0:11:15.07,0:11:18.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya sulit dipercaya kita masih hidup.
Dialogue: 0,0:11:22.75,0:11:24.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat, beri pertolongan pertama.
Dialogue: 0,0:11:25.87,0:11:27.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lukanya tidak ada?
Dialogue: 0,0:11:27.47,0:11:30.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku sudah tidak apa-apa.
Dialogue: 0,0:11:30.63,0:11:32.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa bisa begitu?
Dialogue: 0,0:11:32.02,0:11:34.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini berkat Theresia.
Dialogue: 0,0:11:35.22,0:11:37.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Efek Pelepasan Semangat Tempur Theresia
Dialogue: 0,0:11:37.27,0:11:42.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rupanya bisa menyerap HP\Nsesuai jumlah DMG yang dihasilkan.
Dialogue: 0,0:11:42.01,0:11:45.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu efek yang diberikan\Nke seluruh anggota party, ya?
Dialogue: 0,0:11:46.31,0:11:48.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Theresia.
Dialogue: 0,0:11:49.31,0:11:51.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:11:52.82,0:11:53.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia?
Dialogue: 0,0:11:53.57,0:11:54.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:11:55.28,0:11:57.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batu permata?
Dialogue: 0,0:11:57.47,0:12:00.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya drop dari musuh tadi.
Dialogue: 0,0:12:00.23,0:12:01.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau yang hitam itu Rune.
Dialogue: 0,0:12:01.95,0:12:04.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa dipakai untuk menguatkan perlengkapan.
Dialogue: 0,0:12:04.08,0:12:07.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau yang merah itu... apa, ya?
Dialogue: 0,0:12:07.00,0:12:08.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa asalnya dari situ?
Dialogue: 0,0:12:12.96,0:12:17.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah satu matanya terlihat lepas.
Dialogue: 0,0:12:17.01,0:12:20.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita periksa,\Napa ada yang bisa diambil lagi atau tidak.
Dialogue: 0,0:12:28.73,0:12:30.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia, apa pintunya bisa dibuka?
Dialogue: 0,0:12:32.31,0:12:33.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa, ya.
Dialogue: 0,0:12:39.49,0:12:41.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Misaki?
Dialogue: 0,0:12:44.91,0:12:46.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batu ini...
Dialogue: 0,0:12:46.47,0:12:51.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya cocok dimasukkan ke lubang itu.
Dialogue: 0,0:12:51.07,0:12:53.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar, ukurannya juga sama.
Dialogue: 0,0:12:54.80,0:12:56.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya layak dicoba.
Dialogue: 0,0:12:58.30,0:13:00.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati, Theresia.
Dialogue: 0,0:13:14.67,0:13:16.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terbuka!
Dialogue: 0,0:13:17.61,0:13:19.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak tahu apa yang akan terjadi.
Dialogue: 0,0:13:19.88,0:13:21.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi hati-hati.
Dialogue: 0,0:13:24.83,0:13:26.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:13:26.79,0:13:29.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan peti mati?
Dialogue: 0,0:13:34.59,0:13:36.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada sesuatu yang keluar.
Dialogue: 0,0:13:45.85,0:13:47.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanita?
Dialogue: 0,0:13:47.44,0:13:49.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa di tempat seperti ini?
Dialogue: 0,0:13:49.10,0:13:51.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang di telinganya itu... antena?
Dialogue: 0,0:13:51.98,0:13:54.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bo-Boneka?
Dialogue: 0,0:13:54.63,0:13:56.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, dia hidup.
Dialogue: 0,0:13:57.11,0:13:58.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya sedang tertidur.
Dialogue: 0,0:13:59.78,0:14:03.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}The-Theresia, jangan terlalu dekat.
Dialogue: 0,0:14:03.99,0:14:06.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada lubangnya.
Dialogue: 0,0:14:06.03,0:14:09.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dilihat, seperti lubang kunci.
Dialogue: 0,0:14:09.58,0:14:12.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat membuka kotak di tempat Falma,
Dialogue: 0,0:14:12.51,0:14:15.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau tak salah ada benda\Nyang bentuknya seperti kunci.
Dialogue: 0,0:14:16.96,0:14:19.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menyelidiki ruangan ini,
Dialogue: 0,0:14:19.13,0:14:22.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin kita bisa menemukan cara keluar.
Dialogue: 0,0:14:22.32,0:14:25.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku sangat penasaran dengan orang ini.
Dialogue: 0,0:14:25.84,0:14:28.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa membangunkan wanita ini,
Dialogue: 0,0:14:28.68,0:14:30.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin bisa tanya ruangan apa ini
Dialogue: 0,0:14:30.69,0:14:35.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan bagaimana caranya keluar.
Dialogue: 0,0:14:35.69,0:14:38.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita coba kunci itu.
Dialogue: 0,0:14:50.58,0:14:51.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia?
Dialogue: 0,0:14:51.92,0:14:54.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau pemimpin\Nmenanggung beban ini sendirian.
Dialogue: 0,0:14:54.71,0:14:56.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Igarashi.
Dialogue: 0,0:14:58.54,0:15:01.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak merasakan\Nhawa permusuhan dari orang ini.
Dialogue: 0,0:15:01.05,0:15:03.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, ayo kita coba.
Dialogue: 0,0:15:03.48,0:15:05.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terjadi sesuatu,
Dialogue: 0,0:15:05.03,0:15:08.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan pakai daduku lagi,\Nlangsung beres.
Dialogue: 0,0:15:08.73,0:15:10.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Arihito.
Dialogue: 0,0:15:16.40,0:15:17.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita mulai.
Dialogue: 0,0:15:28.24,0:15:29.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada anak kecil!
Dialogue: 0,0:15:29.53,0:15:31.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat, selamatkan dia!
Dialogue: 0,0:15:44.01,0:15:46.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arihito Atobe.
Dialogue: 0,0:15:46.23,0:15:50.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang telah membuka segel\Ndan membangunkanku.
Dialogue: 0,0:15:51.01,0:15:54.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah benar itu namamu?
Dialogue: 0,0:15:54.73,0:15:55.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:15:56.56,0:16:01.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai Garda Belakang\Nyang datang dari dunia seberang,
Dialogue: 0,0:16:01.21,0:16:03.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku adalah Ariadne sang Roda Besi.
Dialogue: 0,0:16:03.96,0:16:06.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dewa rahasia ke-117.
Dialogue: 0,0:16:06.57,0:16:08.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dewa rahasia?
Dialogue: 0,0:16:08.70,0:16:13.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih telah memecahkan teka-teki\Ndalam labirin dan membangunkanku.
Dialogue: 0,0:16:13.85,0:16:14.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu,
Dialogue: 0,0:16:15.25,0:16:18.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku minta maaf karena usaha kalian sia-sia.
Dialogue: 0,0:16:18.51,0:16:20.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya?
Dialogue: 0,0:16:20.33,0:16:21.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya,
Dialogue: 0,0:16:21.96,0:16:25.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku adalah esensi yang memberikan\Nperlindungan kepada mereka yang ke sini.
Dialogue: 0,0:16:25.96,0:16:27.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun,
Dialogue: 0,0:16:33.35,0:16:36.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku telah kehilangan sebagian besar fungsiku.
Dialogue: 0,0:16:36.80,0:16:39.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama sekali sejak aku dibuang
Dialogue: 0,0:16:39.44,0:16:41.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan banyak bagian diriku yang telah hilang.
Dialogue: 0,0:16:41.61,0:16:45.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, tadi kamu bilang "dibuang",
Dialogue: 0,0:16:45.94,0:16:47.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa maksudnya?
Dialogue: 0,0:16:47.53,0:16:51.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dianggap sebagai produk gagal\Noleh sang Pencipta.
Dialogue: 0,0:16:51.87,0:16:53.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Produk gagal?
Dialogue: 0,0:16:54.83,0:16:58.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena tingkat kesempurnaanku\Nsebagai dewa terlalu rendah,
Dialogue: 0,0:16:58.85,0:17:03.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sang Pencipta membuang\Ndan mengurungku dalam labirin ini.
Dialogue: 0,0:17:03.21,0:17:05.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya kamu dibuang oleh penciptamu?
Dialogue: 0,0:17:05.75,0:17:07.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kejam.
Dialogue: 0,0:17:07.05,0:17:11.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengurungmu di tempat seperti ini\Ndan membiarkanmu dalam waktu yang lama.
Dialogue: 0,0:17:15.51,0:17:16.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ariadne,
Dialogue: 0,0:17:16.92,0:17:19.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apakah kami tak bisa membawamu\Nkeluar dari sini?
Dialogue: 0,0:17:19.56,0:17:21.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa saja kalau kalian menyembahku
Dialogue: 0,0:17:21.48,0:17:25.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mengumpulkan bagian-bagianku yang hilang.
Dialogue: 0,0:17:25.27,0:17:27.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku tak menyarankannya.
Dialogue: 0,0:17:27.21,0:17:28.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:17:28.65,0:17:31.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyembah dewa rahasia
Dialogue: 0,0:17:31.36,0:17:34.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}artinya memusuhi dewa-dewa yang lain.
Dialogue: 0,0:17:34.72,0:17:36.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus bertarung melawan mereka?
Dialogue: 0,0:17:36.81,0:17:38.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada pilihan selain bertarung?
Dialogue: 0,0:17:39.37,0:17:40.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada.
Dialogue: 0,0:17:40.83,0:17:43.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena siapa pun\Nyang menyembah pada satu dewa,
Dialogue: 0,0:17:43.81,0:17:46.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan memikul kewajiban\Nmengumpulkan dewa-dewa.
Dialogue: 0,0:17:46.59,0:17:48.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengumpulkan dewa?
Dialogue: 0,0:17:48.41,0:17:50.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak pernah dengar soal itu.
Dialogue: 0,0:17:50.92,0:17:53.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, dewa yang bisa disembah
Dialogue: 0,0:17:53.68,0:17:55.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanyalah satu.
Dialogue: 0,0:17:55.55,0:17:57.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku adalah produk gagal.
Dialogue: 0,0:17:57.60,0:18:00.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang kehilangan bagian-bagianku
Dialogue: 0,0:18:00.04,0:18:02.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan sulit menang
Dialogue: 0,0:18:02.64,0:18:04.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau harus melawan dewa lain.
Dialogue: 0,0:18:04.40,0:18:06.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi begitu.
Dialogue: 0,0:18:06.00,0:18:08.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang berisiko.
Dialogue: 0,0:18:08.57,0:18:09.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun...
Dialogue: 0,0:18:09.86,0:18:12.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, bagaimana?
Dialogue: 0,0:18:12.36,0:18:14.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengikuti pilihan pemimpin.
Dialogue: 0,0:18:14.57,0:18:18.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ingin menolong Nona Ariadne.
Dialogue: 0,0:18:18.29,0:18:21.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abang Arihito dan Ariadne.
Dialogue: 0,0:18:21.29,0:18:23.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi duo Ari-Ari.
Dialogue: 0,0:18:23.63,0:18:25.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi kami, para penjelajah,
Dialogue: 0,0:18:25.68,0:18:28.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau bisa mendapatkan berkah\Ndari dewa rahasia,
Dialogue: 0,0:18:28.34,0:18:30.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin akan menjadi kekuatan yang besar.
Dialogue: 0,0:18:31.84,0:18:33.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian...
Dialogue: 0,0:18:33.84,0:18:37.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tidak menganggapmu sebagai produk gagal.
Dialogue: 0,0:18:37.51,0:18:40.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toh, kita bisa mengobrol seperti ini.
Dialogue: 0,0:18:40.04,0:18:42.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan sesembahannya?
Dialogue: 0,0:18:45.63,0:18:49.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menambahkan fungsi komunikasi\Nke dalam perangkatmu.
Dialogue: 0,0:18:51.94,0:18:53.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuhubungi saat waktunya tiba.
Dialogue: 0,0:18:54.36,0:18:57.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketika kalian dalam bahaya,
Dialogue: 0,0:18:57.65,0:19:00.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan membantu dalam bentuk berkah.
Dialogue: 0,0:19:00.19,0:19:01.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya melegakan.
Dialogue: 0,0:19:01.83,0:19:03.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:19:03.10,0:19:06.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih karena telah memilihku.
Dialogue: 0,0:19:06.88,0:19:09.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami hanya melakukan yang ingin kami lakukan.
Dialogue: 0,0:19:09.76,0:19:12.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu berterima kasih.
Dialogue: 0,0:19:12.01,0:19:13.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:19:14.05,0:19:16.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian ingin kembali, kan?
Dialogue: 0,0:19:16.01,0:19:20.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membuat jalur pulang untuk kalian.
Dialogue: 0,0:19:23.18,0:19:24.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf,
Dialogue: 0,0:19:25.10,0:19:28.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apakah kami bisa kembali ke sini?
Dialogue: 0,0:19:28.31,0:19:30.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kekuatanku sudah kembali,
Dialogue: 0,0:19:30.48,0:19:33.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa membuatkan jalan masuk ke sini.
Dialogue: 0,0:19:33.03,0:19:35.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, kami akan datang lagi.
Dialogue: 0,0:19:35.53,0:19:37.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa, Ariadne.
Dialogue: 0,0:19:48.86,0:19:50.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:19:50.04,0:19:52.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kita sudah kembali.
Dialogue: 0,0:19:52.92,0:19:54.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:19:54.84,0:19:57.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pikir akan bagaimana.
Dialogue: 0,0:19:57.05,0:19:59.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:19:59.01,0:20:00.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atobe.
Dialogue: 0,0:20:00.47,0:20:02.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:20:02.05,0:20:05.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkatmu, kami masih hidup sampai sekarang.
Dialogue: 0,0:20:05.56,0:20:07.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Igarashi.
Dialogue: 0,0:20:09.69,0:20:10.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atobe!
Dialogue: 0,0:20:10.56,0:20:11.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak apa-apa?
Dialogue: 0,0:20:11.95,0:20:13.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:20:13.43,0:20:16.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya aku mendadak kehilangan tenaga.
Dialogue: 0,0:20:16.77,0:20:19.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak tadi kamu memaksakan diri, sih.
Dialogue: 0,0:20:19.41,0:20:22.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada Watadama, biar kami yang urus.
Dialogue: 0,0:20:22.16,0:20:24.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu istirahat saja.
Dialogue: 0,0:20:24.24,0:20:27.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku tidak bisa begitu.
Dialogue: 0,0:20:28.17,0:20:28.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia?
Dialogue: 0,0:20:31.92,0:20:34.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, Theresia!
Dialogue: 0,0:20:34.30,0:20:36.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berani banget!
Dialogue: 0,0:20:36.01,0:20:38.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Terima kasih.
Dialogue: 0,0:20:38.37,0:20:40.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, ada apa tiba-tiba?
Dialogue: 0,0:20:47.29,0:20:51.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin itu cara Theresia menghiburmu.
Dialogue: 0,0:20:52.36,0:20:53.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:20:54.65,0:20:57.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, semuanya.
Dialogue: 0,0:22:37.71,0:22:41.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah 860 tahun berlalu\Nsejak taman miniatur ini dibuat.
Dialogue: 0,0:22:41.55,0:22:45.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah perjalanan panjang,\Nakhirnya segel ini terbuka.
Dialogue: 0,0:22:46.43,0:22:48.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arihito Atobe.
Dialogue: 0,0:22:55.84,0:22:57.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arihito.
Dialogue: 0,0:22:57.98,0:22:59.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mohon...
Dialogue: 0,0:22:59.52,0:23:01.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu...
Dialogue: 0,0:23:02.40,0:23:05.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini... ingatanmu?
Dialogue: 0,0:23:06.53,0:23:08.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}...harus lari.
Dialogue: 0,0:23:08.91,0:23:12.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atobe, maaf.
Dialogue: 0,0:23:12.41,0:23:15.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak berguna bagimu.
Dialogue: 0,0:23:16.54,0:23:19.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arihito, cepat kabur!
Dialogue: 0,0:23:19.63,0:23:23.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mungkin kabur\Nmeskipun disuruh!
Dialogue: 0,0:23:26.26,0:23:29.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu melindungi mereka dari belakang,
Dialogue: 0,0:23:30.43,0:23:33.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan melindungimu dari sini.
