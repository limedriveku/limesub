Dialogue: 0,0:10:38.03,0:10:44.21,sign,,0000,0000,0000,,GARDA BELAKANG TERKUAT DI DUNIA\N~PENJELAJAH PEMULA DI NEGERI LABIRIN~
Dialogue: 0,0:16:14.12,0:16:14.62,sign,,0000,0000,0000,,PENINGKATAN PELUANG DROP:
Dialogue: 0,0:16:14.62,0:16:17.08,sign,,0000,0000,0000,,PELUANG MUSUH MENJATUHKAN DROP MENINGKAT
Dialogue: 0,0:16:17.08,0:16:19.58,sign,,0000,0000,0000,,KEBERUNTUNGAN KECIL:
Dialogue: 0,0:16:19.58,0:16:21.44,sign,,0000,0000,0000,,PELUANG MENDAPATKAN KOTAK HARTA
Dialogue: 0,0:16:21.44,0:16:22.92,sign,,0000,0000,0000,,SEDIKIT MENINGKAT
Dialogue: 0,0:16:22.92,0:16:24.71,sign,,0000,0000,0000,,KEMAMPUAN YANG DAPAT DIMILIKI:
Dialogue: 0,0:16:24.71,0:16:26.26,sign,,0000,0000,0000,,TRIK DADU:
Dialogue: 0,0:16:26.26,0:16:27.88,sign,,0000,0000,0000,,DAPAT MEMUNCULKAN ANGKA YANG DIINGINKAN
Dialogue: 0,0:16:27.88,0:16:29.68,sign,,0000,0000,0000,,RUSSIAN ROULETTE LV. 1:
Dialogue: 0,0:16:29.68,0:16:31.14,sign,,0000,0000,0000,,MENGURANGI HP MENJADI SETENGAH,
Dialogue: 0,0:16:31.14,0:16:33.89,sign,,0000,0000,0000,,TANPA PEDULI MUSUH ATAU SEKUTU
Dialogue: 0,0:16:33.89,0:16:34.64,sign,,0000,0000,0000,,POKER FACE:
Dialogue: 0,0:16:34.64,0:16:37.68,sign,,0000,0000,0000,,MENCEGAH EMOSI TERBACA ORANG LAIN
Dialogue: 0,0:16:37.68,0:16:40.19,sign,,0000,0000,0000,,PREDIKSI KEBERUNTUNGAN LV. 1:
Dialogue: 0,0:16:40.19,0:16:43.69,sign,,0000,0000,0000,,MERASAKAN ARAH HAL BAIK AKAN TERJADI
Dialogue: 0,0:16:43.69,0:16:45.32,sign,,0000,0000,0000,,LEMPAR KOIN:
Dialogue: 0,0:16:45.32,0:16:46.74,sign,,0000,0000,0000,,MINTA REKAN MENEBAK KOIN,
Dialogue: 0,0:16:46.74,0:16:50.24,sign,,0000,0000,0000,,JIKA BENAR, KEBERUNTUNGAN MENINGKAT
Dialogue: 0,0:16:50.24,0:16:54.12,sign,,0000,0000,0000,,SISA POIN SKILL: 2
Dialogue: 0,0:17:00.08,0:17:00.95,sign,,0000,0000,0000,,AKURASI, PURIFIKASI, PENGUSIRAN LV. 1
Dialogue: 0,0:17:00.95,0:17:01.67,sign,,0000,0000,0000,,INDRA SPIRITUAL LV. 1
Dialogue: 0,0:17:01.67,0:17:06.80,sign,,0000,0000,0000,,KEMAMPUAN YANG DAPAT DIMILIKI:
Dialogue: 0,0:17:06.80,0:17:09.08,sign,,0000,0000,0000,,DELAPAN TAHAP MEMANAH:
Dialogue: 0,0:17:09.08,0:17:11.24,sign,,0000,0000,0000,,MELEPASKAN PANAH SESUAI DASAR TAHAP MEMANAH,
Dialogue: 0,0:17:11.24,0:17:13.18,sign,,0000,0000,0000,,DMG BERLIPAT GANDA
Dialogue: 0,0:17:13.18,0:17:14.59,sign,,0000,0000,0000,,PANAH PENGUSIR ROH:
Dialogue: 0,0:17:14.59,0:17:16.40,sign,,0000,0000,0000,,MEMBERIKAN ATRIBUT SUCI PADA ANAK PANAH
Dialogue: 0,0:17:16.40,0:17:19.89,sign,,0000,0000,0000,,PENYUCIAN:
Dialogue: 0,0:17:19.89,0:17:21.80,sign,,0000,0000,0000,,MEMBERIKAN ATRIBUT SUCI
Dialogue: 0,0:17:21.80,0:17:23.27,sign,,0000,0000,0000,,KEPADA TARGET DENGAN AIR
Dialogue: 0,0:17:23.27,0:17:26.11,sign,,0000,0000,0000,,PERANTARA ROH:
Dialogue: 0,0:17:26.11,0:17:27.19,sign,,0000,0000,0000,,MEMASUKKAN ROH DI SEKITAR
Dialogue: 0,0:17:27.19,0:17:28.06,sign,,0000,0000,0000,,KE TUBUH SENDIRI UNTUK BERDIALOG
Dialogue: 0,0:17:28.06,0:17:29.82,sign,,0000,0000,0000,,DOA: MENINGKATKAN SEDIKIT TINGKAT
Dialogue: 0,0:17:29.82,0:17:32.16,sign,,0000,0000,0000,,KEBERHASILAN SELURUH ANGGOTA PARTY
Dialogue: 0,0:17:32.16,0:17:33.35,sign,,0000,0000,0000,,GARAM PEMURNI:
Dialogue: 0,0:17:33.35,0:17:35.03,sign,,0000,0000,0000,,MENABUR GARAM PEMURNI
Dialogue: 0,0:17:35.03,0:17:36.19,sign,,0000,0000,0000,,DI AREA TERTENTU UNTUK MENCEGAH
Dialogue: 0,0:17:36.19,0:17:37.69,sign,,0000,0000,0000,,MONSTER MENDEKAT
Dialogue: 0,0:17:40.00,0:17:41.54,sign,,0000,0000,0000,,SISA POIN SKILL: 2
Dialogue: 0,0:00:03.44,0:00:04.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Louisa?
Dialogue: 0,0:00:06.65,0:00:08.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, bagaimana, ya?
Dialogue: 0,0:00:08.99,0:00:12.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mo-Mohon maaf, tidak biasanya saya begini.
Dialogue: 0,0:00:12.95,0:00:16.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pencapaian Tuan Atobe sangat luar biasa
Dialogue: 0,0:00:16.25,0:00:19.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai membuat saya terdiam sesaat.
Dialogue: 0,0:00:19.42,0:00:21.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai sebegitunya?
Dialogue: 0,0:00:21.38,0:00:24.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hasil penjelajahannya memang\Nsama seperti biasa,
Dialogue: 0,0:00:24.42,0:00:26.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi yang perlu diperhatikan adalah
Dialogue: 0,0:00:26.38,0:00:29.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}penemuan area yang belum dijamah.
Dialogue: 0,0:00:30.72,0:00:32.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Area yang belum dijamah
Dialogue: 0,0:00:32.25,0:00:36.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berarti belum ada yang pernah ke sana\Ndan kembali ke guild dengan selamat.
Dialogue: 0,0:00:36.18,0:00:37.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun,
Dialogue: 0,0:00:37.06,0:00:40.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian berhasil kembali dengan selamat.
Dialogue: 0,0:00:41.56,0:00:44.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, berdasarkan poin kontribusinya,
Dialogue: 0,0:00:44.07,0:00:48.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}party Tuan Atobe kini berhasil\Nmelampaui party lainnya
Dialogue: 0,0:00:48.07,0:00:50.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menduduki peringkat pertama di Distrik 8.
Dialogue: 0,0:00:50.95,0:00:52.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Per-Pertama?
Dialogue: 0,0:02:31.05,0:02:32.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peringkat pertama, ya.
Dialogue: 0,0:02:32.84,0:02:35.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebisa mungkin, aku ingin menghindari masalah
Dialogue: 0,0:02:35.09,0:02:38.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tidak ingin diketahui\Noleh penjelajah lainnya.
Dialogue: 0,0:02:41.39,0:02:42.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, maaf.
Dialogue: 0,0:02:42.84,0:02:45.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus berkumpul\Ndengan yang lainnya dulu.
Dialogue: 0,0:02:47.27,0:02:49.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, hei, kalian yang duluan menabrak, tahu.
Dialogue: 0,0:02:49.57,0:02:53.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak dari tempat Falma dan Silver Hound?
Dialogue: 0,0:02:53.88,0:02:56.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mereka sedang terlibat masalah?
Dialogue: 0,0:02:56.57,0:02:59.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan cuma diam, katakan sesuatu!
Dialogue: 0,0:02:59.78,0:03:03.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalian mau tanggung jawab?
Dialogue: 0,0:03:04.00,0:03:05.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa ini?
Dialogue: 0,0:03:06.12,0:03:09.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak ini adalah kenalanku.
Dialogue: 0,0:03:09.35,0:03:10.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan sekali.
Dialogue: 0,0:03:10.92,0:03:13.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anjing sialan ini menabrakku dengan sengaja.
Dialogue: 0,0:03:13.92,0:03:16.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepatu kulit berhargaku jadi kotor.
Dialogue: 0,0:03:16.18,0:03:18.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu harus ganti rugi.
Dialogue: 0,0:03:18.90,0:03:22.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bayar 10 koin emas,\Nbaru aku biarkan kalian pergi.
Dialogue: 0,0:03:22.14,0:03:24.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemerasan, ya.
Dialogue: 0,0:03:24.47,0:03:26.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar tidak tertolong.
Dialogue: 0,0:03:26.10,0:03:28.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shi-Shion tidak menabrak.
Dialogue: 0,0:03:28.69,0:03:32.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang itu yang menabrak Kakak,\Njadi Shion cuma melindungi.
Dialogue: 0,0:03:32.23,0:03:34.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam kamu, bocah!
Dialogue: 0,0:03:34.44,0:03:37.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah bawel, berikan saja uangmu!
Dialogue: 0,0:03:38.61,0:03:40.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eiku, Plum,
Dialogue: 0,0:03:40.28,0:03:42.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}boleh pinjam Shion untuk membantuku?
Dialogue: 0,0:03:42.87,0:03:43.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:03:43.57,0:03:44.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya.
Dialogue: 0,0:03:46.75,0:03:47.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip.
Dialogue: 0,0:03:47.71,0:03:50.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shion sudah bergabung dengan party.
Dialogue: 0,0:03:50.75,0:03:52.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang bisik-bisik apa kalian?
Dialogue: 0,0:03:52.71,0:03:55.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shion tidak melakukan kesalahan apa pun.
Dialogue: 0,0:03:55.63,0:03:58.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubiarkan kalau kamu\Nminta maaf pada mereka.
Dialogue: 0,0:03:58.68,0:04:00.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sok pahlawan.
Dialogue: 0,0:04:00.22,0:04:03.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya harus diberi pelajaran\Nbiar paham, ya.
Dialogue: 0,0:04:04.14,0:04:05.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertahanan Dukungan!
Dialogue: 0,0:04:08.52,0:04:09.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan.
Dialogue: 0,0:04:09.19,0:04:10.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serang, Shion.
Dialogue: 0,0:04:13.07,0:04:14.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan Dukungan!
Dialogue: 0,0:04:22.02,0:04:23.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eiku, Plum!
Dialogue: 0,0:04:24.12,0:04:25.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tidak apa-apa?
Dialogue: 0,0:04:25.16,0:04:26.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Ibu!
Dialogue: 0,0:04:30.33,0:04:32.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berdua tidak terluka.
Dialogue: 0,0:04:32.31,0:04:34.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Atobe yang menolong mereka, ya.
Dialogue: 0,0:04:34.96,0:04:36.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:04:36.67,0:04:38.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shion-lah yang melindungi mereka.
Dialogue: 0,0:04:38.95,0:04:42.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya tergerak oleh keberanian Shion.
Dialogue: 0,0:04:42.55,0:04:46.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlepas dari itu,\Nternyata Shion punya kemampuan seperti itu.
Dialogue: 0,0:04:48.39,0:04:49.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ada apa?
Dialogue: 0,0:04:49.69,0:04:52.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shion minta dielus.
Dialogue: 0,0:04:52.23,0:04:53.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:04:55.73,0:04:57.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia, kamu mau menyentuhnya juga?
Dialogue: 0,0:04:59.40,0:05:02.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak menaruh waspada\Nterhadap Setengah Manusia,
Dialogue: 0,0:05:02.71,0:05:04.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi tenang saja.
Dialogue: 0,0:05:11.00,0:05:12.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Falma,
Dialogue: 0,0:05:12.79,0:05:17.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apakah ada tempat yang menyediakan\Nanjing penjaga seperti Shion?
Dialogue: 0,0:05:17.26,0:05:20.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda tertarik dengan Shion?
Dialogue: 0,0:05:20.01,0:05:21.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:05:22.89,0:05:25.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Atobe, kalau berkenan,
Dialogue: 0,0:05:25.51,0:05:29.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagaimana kalau penjelajahan berikutnya\NAnda mengajak Shion?
Dialogue: 0,0:05:29.98,0:05:34.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya ingin memberikan pengalaman\Nmenjelajah padanya.
Dialogue: 0,0:05:34.44,0:05:37.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi, Shion juga sepertinya\Nmenyukai Tuan Atobe.
Dialogue: 0,0:05:37.53,0:05:39.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kalau Anda tidak keberatan.
Dialogue: 0,0:05:39.53,0:05:44.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Shion ikut dan memakai\Nkemampuan "Covering" ini,
Dialogue: 0,0:05:44.12,0:05:47.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pertahanan party-ku pasti jadi makin kokoh.
Dialogue: 0,0:05:47.74,0:05:49.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:05:50.00,0:05:53.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu mau menjelajah sekali bersamaku?
Dialogue: 0,0:05:54.63,0:05:57.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shion bilang dia mau.
Dialogue: 0,0:06:00.51,0:06:03.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dia juga menyukai Kakak.
Dialogue: 0,0:06:08.26,0:06:11.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, kami menunggu lama sekali, tahu!
Dialogue: 0,0:06:11.39,0:06:13.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, maaf.
Dialogue: 0,0:06:13.39,0:06:15.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi kami sempat ketemu Falma.
Dialogue: 0,0:06:15.77,0:06:17.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Arihito.
Dialogue: 0,0:06:18.82,0:06:21.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelompokmu makin ramai saja, ya.
Dialogue: 0,0:06:21.65,0:06:24.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, rekanku juga bertambah.
Dialogue: 0,0:06:24.20,0:06:26.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjelajahan kami juga berjalan lancar.
Dialogue: 0,0:06:26.78,0:06:28.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku turut senang.
Dialogue: 0,0:06:28.62,0:06:32.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi pengangkut barang\Nbaru datang membawa monster.
Dialogue: 0,0:06:32.28,0:06:35.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gaze Hound dan Plain Eater.
Dialogue: 0,0:06:35.00,0:06:36.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh aku memotongnya?
Dialogue: 0,0:06:36.58,0:06:39.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tolong lakukan.
Dialogue: 0,0:06:47.64,0:06:49.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, Pak Rikerton,
Dialogue: 0,0:06:49.51,0:06:52.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apakah di sini hanya ada pemotongan monster?
Dialogue: 0,0:06:52.27,0:06:53.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin identifikasi barang.
Dialogue: 0,0:06:53.98,0:06:57.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf,\Ndi sini tak bisa melakukan identifikasi.
Dialogue: 0,0:06:58.56,0:07:01.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tidak ada yang punya\Nkemampuan identifikasi?
Dialogue: 0,0:07:01.90,0:07:04.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan sangat berguna\Nkalau ada anggota yang bisa, lo.
Dialogue: 0,0:07:04.95,0:07:06.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:07:06.41,0:07:08.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuan identifikasi, ya.
Dialogue: 0,0:07:08.20,0:07:09.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih sangat segar.
Dialogue: 0,0:07:11.83,0:07:13.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlepas dari itu,
Dialogue: 0,0:07:13.29,0:07:17.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian hebat sekali bisa kalahkan\NGaze Hound dan Plain Eater.
Dialogue: 0,0:07:17.21,0:07:18.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kalian selamat.
Dialogue: 0,0:07:19.25,0:07:20.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terdengar menyedihkan, tapi...
Dialogue: 0,0:07:20.67,0:07:24.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di Negeri Labirin,\Npenjelajah hebat yang gugur
Dialogue: 0,0:07:24.01,0:07:28.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau berubah menjadi Setengah Manusia\Nsudah jadi pemandangan sehari-hari.
Dialogue: 0,0:07:28.33,0:07:32.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku juga dengar ada cara mengembalikan\NSetengah Manusia ke wujud aslinya.
Dialogue: 0,0:07:32.97,0:07:35.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa seperti ada sebuah harapan
Dialogue: 0,0:07:35.23,0:07:38.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang ditinggalkan labirin\Nuntuk para penjelajah.
Dialogue: 0,0:07:38.75,0:07:40.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga berpikir begitu.
Dialogue: 0,0:07:40.44,0:07:44.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat menjadikannya rekan, aku sudah putuskan\Nakan mengembalikannya ke wujud aslinya.
Dialogue: 0,0:07:45.82,0:07:47.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengembalikan wujud Theresia?
Dialogue: 0,0:07:47.82,0:07:49.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:07:49.78,0:07:53.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin ucapanku terdengar tidak peduli,
Dialogue: 0,0:07:53.66,0:07:55.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi istriku,
Dialogue: 0,0:07:55.25,0:07:57.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ibunya Melissa,\Nadalah seorang Setengah Manusia.
Dialogue: 0,0:07:57.87,0:08:01.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istri Pak Rikerton seorang Setengah Manusia?
Dialogue: 0,0:08:01.09,0:08:03.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istriku gugur di dalam labirin,
Dialogue: 0,0:08:03.59,0:08:07.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu ditemukan tim pencari\Ndalam wujud Setengah Manusia.
Dialogue: 0,0:08:07.70,0:08:12.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, saat itu dia sudah mengandung Melissa.
Dialogue: 0,0:08:12.00,0:08:13.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi seperti itu, ya.
Dialogue: 0,0:08:13.76,0:08:15.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah melahirkan Melissa,
Dialogue: 0,0:08:15.52,0:08:19.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}istriku bergabung dengan party kenalannya\Ndan melanjutkan penjelajahan.
Dialogue: 0,0:08:20.02,0:08:22.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena untuk menemukan\Ncara kembali ke wujudnya,
Dialogue: 0,0:08:22.64,0:08:25.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia harus menaikkan\Nperingkatnya terlebih dahulu.
Dialogue: 0,0:08:25.32,0:08:29.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, Pak Rikerton\Nmembesarkan Melissa sendiri
Dialogue: 0,0:08:29.45,0:08:31.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan berpisah dengan istri Bapak, ya?
Dialogue: 0,0:08:32.49,0:08:34.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arihito.
Dialogue: 0,0:08:34.04,0:08:37.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana menurutmu tentang masa muda?
Dialogue: 0,0:08:37.78,0:08:41.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melissa kurang tertarik\Ndengan hal yang disukai anak-anak.
Dialogue: 0,0:08:41.08,0:08:45.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu-satunya yang menarik minatnya\Nadalah pemotongan monster.
Dialogue: 0,0:08:45.21,0:08:48.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu,\Ndia selalu membantuku jadi tukang jagal
Dialogue: 0,0:08:48.63,0:08:52.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tanpa sempat merasakan berinteraksi\Ndengan anak-anak seusianya.
Dialogue: 0,0:08:52.51,0:08:57.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah tidak jadi masalah\Nmenyia-nyiakan masa mudanya,
Dialogue: 0,0:08:57.39,0:09:00.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}waktu yang tak bisa diulang lagi
Dialogue: 0,0:09:00.19,0:09:02.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya untuk menunggu\Nbarang langka untuk dipotong?
Dialogue: 0,0:09:02.73,0:09:07.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah Bapak ingin Melissa merasakan
Dialogue: 0,0:09:07.15,0:09:10.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}waktu berharga yang disebut masa muda itu?
Dialogue: 0,0:09:10.70,0:09:11.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:09:11.66,0:09:15.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin Melissa melihat dunia luar.
Dialogue: 0,0:09:15.40,0:09:18.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang terdengar seperti ayah\Nyang sok ikut campur, sih.
Dialogue: 0,0:09:18.66,0:09:19.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak benar.
Dialogue: 0,0:09:19.91,0:09:22.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, maaf, obrolan kami mengganggu, ya?
Dialogue: 0,0:09:24.38,0:09:27.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Plain Eater ternyata membawa Batu Kamuflase.
Dialogue: 0,0:09:27.65,0:09:29.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dipasang pada perlengkapan,
Dialogue: 0,0:09:29.59,0:09:34.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}benda ini bisa mengaktifkan skill "Active Stealth"\Nyang membuatnya menyatu dengan sekitar.
Dialogue: 0,0:09:34.35,0:09:35.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barang bagus.
Dialogue: 0,0:09:35.60,0:09:37.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat juga.
Dialogue: 0,0:09:37.40,0:09:38.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasang saja untuk garda depan.
Dialogue: 0,0:09:38.85,0:09:40.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara apa kamu ini?
Dialogue: 0,0:09:40.23,0:09:42.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamulah yang harus memakainya.
Dialogue: 0,0:09:42.69,0:09:46.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ingin kamu terluka\Nseperti waktu itu lagi.
Dialogue: 0,0:09:46.82,0:09:50.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Active Stealth sangat boros mana.
Dialogue: 0,0:09:50.28,0:09:52.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati karena\Ntak bisa dipakai sembarangan.
Dialogue: 0,0:09:52.53,0:09:53.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:09:54.07,0:09:55.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau diperhatikan,
Dialogue: 0,0:09:55.37,0:09:59.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan menekan konsumsi mana,\Naku bisa jadi tak terlihat.
Dialogue: 0,0:09:59.03,0:10:01.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dikombinasi dengan "Back Stand",
Dialogue: 0,0:10:01.25,0:10:04.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa menyerang tanpa diketahui musuh.
Dialogue: 0,0:10:04.63,0:10:07.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, akan kupasang di perlengkapanku.
Dialogue: 0,0:10:08.59,0:10:11.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, apakah kamu sendiri
Dialogue: 0,0:10:11.84,0:10:15.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ingin pergi menjelajah bersama kami?
Dialogue: 0,0:10:15.01,0:10:15.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingin.
Dialogue: 0,0:10:15.85,0:10:17.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:10:17.43,0:10:19.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku ingin kamu ikut.
Dialogue: 0,0:10:19.43,0:10:21.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjemputmu saat mau menjelajah.
Dialogue: 0,0:10:22.14,0:10:23.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersiap-siaplah.
Dialogue: 0,0:10:23.57,0:10:25.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, mohon bantuannya.
Dialogue: 0,0:10:26.40,0:10:27.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Melissa.
Dialogue: 0,0:10:27.93,0:10:29.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa memotong dan mengurai monster.
Dialogue: 0,0:10:29.78,0:10:31.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Oh! Salam kenal!\N- Mohon bantuannya!
Dialogue: 0,0:10:44.21,0:10:47.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ahli membuka kotak.
Dialogue: 0,0:10:48.96,0:10:52.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang di Kediaman Ny. Orelus, Tuan.
Dialogue: 0,0:10:52.59,0:10:56.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya, Mirei, akan mengantar kalian ke kamar.
Dialogue: 0,0:10:57.93,0:11:00.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamar kalian berada di lantai dua.
Dialogue: 0,0:11:00.85,0:11:03.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian pergilah ke kamar duluan.
Dialogue: 0,0:11:03.64,0:11:06.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau mengurus pendaftarannya dulu.
Dialogue: 0,0:11:06.13,0:11:08.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah beres, mari kita makan.
Dialogue: 0,0:11:14.24,0:11:16.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pendaftarannya silakan sebelah sini.
Dialogue: 0,0:11:16.53,0:11:17.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, baik.
Dialogue: 0,0:11:22.24,0:11:25.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pemimpin party yang baru bergabung itu?
Dialogue: 0,0:11:25.66,0:11:26.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, benar.
Dialogue: 0,0:11:26.87,0:11:28.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya Arihito Atobe.
Dialogue: 0,0:11:28.88,0:11:31.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sementara ini, kami akan menginap di sini.
Dialogue: 0,0:11:31.85,0:11:33.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, mohon bantuannya.
Dialogue: 0,0:11:33.01,0:11:34.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atobe, ya?
Dialogue: 0,0:11:34.92,0:11:38.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami dulunya party teratas di Distrik 8
Dialogue: 0,0:11:38.17,0:11:40.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan baru saja turun ke peringkat dua.
Dialogue: 0,0:11:40.47,0:11:44.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, aku penasaran seperti apa\Norang hebat yang menyalipku.
Dialogue: 0,0:11:45.73,0:11:48.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Poin kontribusi kami\Nlebih banyak dari perkiraan,
Dialogue: 0,0:11:48.31,0:11:50.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membuat kami naik ke peringkat pertama.
Dialogue: 0,0:11:50.69,0:11:53.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ada faktor keberuntungan juga.
Dialogue: 0,0:11:53.41,0:11:56.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk orang yang naik peringkat,\Nkamu rendah hati juga.
Dialogue: 0,0:11:56.70,0:12:00.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kemampuanmu pasti luar biasa.
Dialogue: 0,0:12:00.23,0:12:03.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah anggota party-mu juga hebat-hebat?
Dialogue: 0,0:12:03.08,0:12:06.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami beruntung ada satu anggota berlevel 9
Dialogue: 0,0:12:06.25,0:12:08.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan dialah yang menuntun party.
Dialogue: 0,0:12:08.37,0:12:10.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, level 9?
Dialogue: 0,0:12:10.50,0:12:11.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa.
Dialogue: 0,0:12:11.92,0:12:13.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku pikir dia akan tersinggung karena tersalip.\N- Level 9, ya?
Dialogue: 0,0:12:13.84,0:12:16.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku pikir dia akan tersinggung karena tersalip.\N- Jarang ada yang setinggi itu.
Dialogue: 0,0:12:16.09,0:12:18.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya dia benar-benar biasa saja.
Dialogue: 0,0:12:18.53,0:12:20.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau levelnya setinggi itu,
Dialogue: 0,0:12:20.39,0:12:24.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa mungkin dia Elitia Centrale\Nyang baru-baru ini ke Distrik 8?
Dialogue: 0,0:12:24.60,0:12:27.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat juga kamu\Nbisa membuatnya masuk party.
Dialogue: 0,0:12:27.18,0:12:30.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami bergabung saat bertemu\Ndi labirin bersama.
Dialogue: 0,0:12:30.15,0:12:30.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kemudian...\N- Oh...
Dialogue: 0,0:12:31.25,0:12:33.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah pakai bahasa formal padaku.
Dialogue: 0,0:12:33.82,0:12:37.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Georg, pemimpin dari Polaris.
Dialogue: 0,0:12:37.70,0:12:39.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Polaris?
Dialogue: 0,0:12:39.20,0:12:40.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama party-ku.
Dialogue: 0,0:12:40.86,0:12:43.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya party-mu tak punya nama?
Dialogue: 0,0:12:43.03,0:12:45.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, maksudku...
Dialogue: 0,0:12:45.17,0:12:49.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku tidak tahu\Nada kebiasaan memberi nama.
Dialogue: 0,0:12:49.09,0:12:51.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti aku coba bicarakan dengan anggotaku.
Dialogue: 0,0:12:51.79,0:12:54.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pemimpinnya, kan?
Dialogue: 0,0:12:54.00,0:12:56.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tidak putuskan sendiri saja?
Dialogue: 0,0:12:56.13,0:12:57.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:12:57.05,0:12:59.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemimpin cuma formalitas.
Dialogue: 0,0:12:59.35,0:13:03.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Party kami bisa sejauh ini sebenarnya\Njuga berkat anggota lainnya.
Dialogue: 0,0:13:03.68,0:13:05.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Karena itu...\N- Jadi begitu, ya.
Dialogue: 0,0:13:06.93,0:13:09.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kamu menarik juga.
Dialogue: 0,0:13:09.48,0:13:11.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini aku tak ada waktu,
Dialogue: 0,0:13:11.19,0:13:13.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi lain kali kita minum bersama yuk, Atobe.
Dialogue: 0,0:13:13.91,0:13:15.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, bukan, Arihito.
Dialogue: 0,0:13:16.69,0:13:17.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa.
Dialogue: 0,0:13:20.95,0:13:25.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dia benar-benar orang yang ramah.
Dialogue: 0,0:13:31.08,0:13:34.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena namanya Kepiting Tanah,\Naku pikir bakal bau lumpur,
Dialogue: 0,0:13:34.96,0:13:37.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ternyata sudah dibersihkan dengan baik.
Dialogue: 0,0:13:37.25,0:13:38.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, benar.
Dialogue: 0,0:13:38.71,0:13:41.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun pakai rempah-rempah\Nyang baru aku lihat,
Dialogue: 0,0:13:41.22,0:13:43.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ternyata rasanya enak juga.
Dialogue: 0,0:13:48.60,0:13:51.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Kenyal dan enak!
Dialogue: 0,0:13:51.19,0:13:56.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini... meskipun udang,\Ntetap saja monster, kan?
Dialogue: 0,0:13:56.86,0:13:59.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, kelihatan enak sih, tapi...
Dialogue: 0,0:13:59.65,0:14:03.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia, punyaku untukmu saja.
Dialogue: 0,0:14:04.87,0:14:08.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misaki, kalau pilih-pilih makanan\Nkamu tidak akan tumbuh tinggi.
Dialogue: 0,0:14:08.91,0:14:12.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh? Aku kan lebih tinggi darimu.
Dialogue: 0,0:14:12.29,0:14:14.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggiku berubah-ubah tergantung hari.
Dialogue: 0,0:14:14.92,0:14:16.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini kondisiku sedang kurang baik.
Dialogue: 0,0:14:17.46,0:14:20.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eli, kamu tidak suka sayur?
Dialogue: 0,0:14:20.87,0:14:22.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau buatku saja?
Dialogue: 0,0:14:22.80,0:14:24.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kalau begitu, ambil setengah saja.
Dialogue: 0,0:14:25.89,0:14:28.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya ini kebanyakan, deh.
Dialogue: 0,0:14:28.01,0:14:30.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia, kamu mau?
Dialogue: 0,0:14:36.48,0:14:38.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makannya lahap juga.
Dialogue: 0,0:14:38.55,0:14:41.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arihito, kamu tidak bisa berkomunikasi\Nlewat tulisan?
Dialogue: 0,0:14:41.90,0:14:45.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dia tidak bisa\Nmenulis atau semacamnya.
Dialogue: 0,0:14:45.03,0:14:47.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski paham apa yang dilihat dan didengar,
Dialogue: 0,0:14:47.53,0:14:52.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}keinginan untuk menyampaikan\Ndengan kata-kata sepertinya telah disegel.
Dialogue: 0,0:14:52.79,0:14:55.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin mendengar suara Theresia.
Dialogue: 0,0:14:55.33,0:15:00.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kemampuanku pun,\Naku tak bisa membuatnya bersuara.
Dialogue: 0,0:15:01.42,0:15:02.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untukku?
Dialogue: 0,0:15:03.72,0:15:06.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.\NTapi, bagaimana ya...
Dialogue: 0,0:15:06.99,0:15:09.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah cukup kenyang.
Dialogue: 0,0:15:09.14,0:15:10.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan dipaksakan.
Dialogue: 0,0:15:10.47,0:15:13.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok kita akan menjelajah,
Dialogue: 0,0:15:13.05,0:15:14.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi jangan kebanyakan makan.
Dialogue: 0,0:15:14.81,0:15:16.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:15:16.90,0:15:19.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku menolak saja.
Dialogue: 0,0:15:19.33,0:15:21.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia, silakan kalau mau.
Dialogue: 0,0:15:24.40,0:15:26.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok aku pasti
Dialogue: 0,0:15:26.82,0:15:30.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menunggu di rumah, ya.
Dialogue: 0,0:15:30.28,0:15:33.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membawa Melissa dan Shion pun\Ntotalnya delapan orang,
Dialogue: 0,0:15:33.54,0:15:35.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aman kalau mau ikut.
Dialogue: 0,0:15:35.28,0:15:38.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang aku khawatirkan cuma\Nkarena levelmu masih 2.
Dialogue: 0,0:15:38.54,0:15:40.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi staminamu masih rendah.
Dialogue: 0,0:15:40.63,0:15:44.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku akan ikut\Ndi belakang Melissa saja, ya.
Dialogue: 0,0:15:44.97,0:15:48.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan ikut bertarung\Ndan jadi tim terpisah.
Dialogue: 0,0:15:48.77,0:15:50.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:15:50.19,0:15:52.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi bisa bergerak seperti itu juga.
Dialogue: 0,0:15:52.56,0:15:56.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dukunganku bisa aktif\Nselama ada di belakang mereka.
Dialogue: 0,0:15:56.60,0:15:58.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalaupun tim terpisah ikut bertarung,
Dialogue: 0,0:15:58.99,0:16:01.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tetap bisa beri dukungan\Ndengan mengatur posisiku.
Dialogue: 0,0:16:01.52,0:16:05.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikut pun aku hanya bisa\Nmeningkatkan tingkat keberuntungan.
Dialogue: 0,0:16:05.65,0:16:08.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya ingin melakukan hal\Nyang membuat Abang senang.
Dialogue: 0,0:16:08.70,0:16:10.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:16:10.05,0:16:13.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku bisa lihat kemampuan\Nyang kamu miliki saat ini?
Dialogue: 0,0:16:14.62,0:16:17.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kemampuan ini,
Dialogue: 0,0:16:17.08,0:16:19.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harusnya bisa sapu bersih kasino, sih.
Dialogue: 0,0:16:19.58,0:16:21.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau yang ini?
Dialogue: 0,0:16:21.44,0:16:22.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Russian Roulette Lv. 1.
Dialogue: 0,0:16:22.92,0:16:24.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau penjudinya beruntung,
Dialogue: 0,0:16:24.71,0:16:26.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kemungkinan mengenai teman sendiri
Dialogue: 0,0:16:26.26,0:16:27.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti sangat kecil.
Dialogue: 0,0:16:27.88,0:16:29.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dalam praktiknya terlalu berisiko
Dialogue: 0,0:16:29.68,0:16:31.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk digunakan.
Dialogue: 0,0:16:31.14,0:16:33.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paling aman kayaknya Prediksi Keberuntungan Lv. 1.
Dialogue: 0,0:16:33.89,0:16:34.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:16:34.64,0:16:37.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kayaknya belum terlalu dibutuhkan sekarang.
Dialogue: 0,0:16:37.68,0:16:40.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin bisa tunggu satu level lagi?
Dialogue: 0,0:16:40.19,0:16:42.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin meningkatkan sesuatu
Dialogue: 0,0:16:42.12,0:16:43.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang membuatku makin beruntung.
Dialogue: 0,0:16:43.69,0:16:45.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai bisa menemukan uang banyak
Dialogue: 0,0:16:45.32,0:16:46.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}cuma dengan jalan kaki.
Dialogue: 0,0:16:46.74,0:16:50.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan asal memungut kotak harta lagi, ya.
Dialogue: 0,0:16:50.24,0:16:51.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kok.
Dialogue: 0,0:16:51.68,0:16:54.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal itu aku sudah kapok.
Dialogue: 0,0:16:54.12,0:16:55.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf.
Dialogue: 0,0:16:55.41,0:16:58.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa tolong lihat punyaku juga?
Dialogue: 0,0:16:58.37,0:16:59.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu.
Dialogue: 0,0:17:00.08,0:17:01.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi begitu.
Dialogue: 0,0:17:01.67,0:17:03.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suzuna mempelajari kemampuan Gadis Kuil
Dialogue: 0,0:17:03.83,0:17:06.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan memanah bersamaan, ya.
Dialogue: 0,0:17:06.80,0:17:09.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Delapan Tahap Memanah juga termasuk.
Dialogue: 0,0:17:09.08,0:17:11.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi karena menjadi Perantara Roh,
Dialogue: 0,0:17:11.24,0:17:13.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mustahil kulakukan di kehidupan dulu,
Dialogue: 0,0:17:13.18,0:17:16.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku penasaran seperti apa kemampuan itu.
Dialogue: 0,0:17:16.40,0:17:19.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kemungkinan dirasuki roh jahat juga.
Dialogue: 0,0:17:19.89,0:17:21.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi karena ini keinginan Suzuna,
Dialogue: 0,0:17:21.80,0:17:23.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita coba ambil Perantara Roh.
Dialogue: 0,0:17:23.27,0:17:26.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk Penyucian, sepertinya bisa dipakai
Dialogue: 0,0:17:26.11,0:17:28.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat masuk labirin yang butuh atribut suci,
Dialogue: 0,0:17:28.06,0:17:29.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sekarang belum butuh.
Dialogue: 0,0:17:29.82,0:17:32.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, aku mengerti.
Dialogue: 0,0:17:32.16,0:17:33.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Delapan Tahap Memanah juga
Dialogue: 0,0:17:33.35,0:17:35.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menurutku cukup kuat,
Dialogue: 0,0:17:35.03,0:17:36.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi karena ada aku,
Dialogue: 0,0:17:36.19,0:17:37.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi belum dibutuhkan dulu.
Dialogue: 0,0:17:37.69,0:17:40.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena yang penting adalah\Njumlah serangan.
Dialogue: 0,0:17:40.00,0:17:41.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku juga begitu.
Dialogue: 0,0:17:41.54,0:17:45.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Punya kemampuan dukungan selain serangan\Njuga hal yang bagus.
Dialogue: 0,0:17:46.96,0:17:48.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, Abang Arihito,
Dialogue: 0,0:17:48.96,0:17:52.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena di kamar ada pemandiannya,\NAbang mau masuk duluan?
Dialogue: 0,0:17:52.76,0:17:54.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku nanti saja.
Dialogue: 0,0:17:54.43,0:17:57.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah,\Nbagaimana kalau urutan setiap dua orang?
Dialogue: 0,0:17:57.77,0:18:01.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau masuk satu per satu\Nbakal makan waktu, sih.
Dialogue: 0,0:18:01.06,0:18:02.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia.
Dialogue: 0,0:18:03.02,0:18:05.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kita sekamar,\Nkamu masuk bersamaku, ya.
Dialogue: 0,0:18:07.27,0:18:08.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia?
Dialogue: 0,0:18:15.12,0:18:16.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}The-Theresia.
Dialogue: 0,0:18:16.45,0:18:19.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Igarashi sudah mengajakmu,
Dialogue: 0,0:18:19.16,0:18:20.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebaiknya kamu ikut dengannya.
Dialogue: 0,0:18:22.83,0:18:25.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia, kamu ingin mandi sendirian?
Dialogue: 0,0:18:26.46,0:18:27.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:18:27.84,0:18:30.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ingin mandi bersama\Norang lain selain aku?
Dialogue: 0,0:18:33.68,0:18:34.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, wah.
Dialogue: 0,0:18:34.72,0:18:38.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti ingin balas budi\Nkarena sudah banyak membantu, ya?
Dialogue: 0,0:18:38.47,0:18:41.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi menggosok punggung laki-laki itu
Dialogue: 0,0:18:41.35,0:18:44.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rasanya agak terlalu berani, deh.
Dialogue: 0,0:18:44.69,0:18:48.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Arihito yang pengin,\Naku tidak bisa melarang, sih.
Dialogue: 0,0:18:48.44,0:18:50.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Tapi, kalau dilihat-lihat,
Dialogue: 0,0:18:50.73,0:18:53.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukankah Theresia yang pengin?
Dialogue: 0,0:18:57.53,0:19:00.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Atobe dan Theresia mandi bersama,
Dialogue: 0,0:19:00.41,0:19:02.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nanti aku jadi sendirian.
Dialogue: 0,0:19:02.33,0:19:04.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Kamu mengkhawatirkan itu?
Dialogue: 0,0:19:04.79,0:19:09.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ten-Tentu saja, kita tidak bisa membiarkan\Nlaki-laki dan perempuan mandi bersama.
Dialogue: 0,0:19:09.25,0:19:12.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Theresia terlihat kesepian.
Dialogue: 0,0:19:12.71,0:19:16.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia sangat menyukai Atobe,\Naku tidak bisa melarang.
Dialogue: 0,0:19:17.68,0:19:19.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, benar juga!
Dialogue: 0,0:19:19.14,0:19:21.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau pakai sesuatu seperti baju renang,
Dialogue: 0,0:19:21.18,0:19:24.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu bisa masuk bersama laki-laki.
Dialogue: 0,0:19:25.10,0:19:26.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Tapi,
Dialogue: 0,0:19:26.35,0:19:29.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak usah sejauh itu juga kalau mau bersama.
Dialogue: 0,0:19:29.15,0:19:32.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masalahnya itu Theresia kesepian.
Dialogue: 0,0:19:32.07,0:19:34.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tak punya hak untuk menolak, Atobe.
Dialogue: 0,0:19:34.44,0:19:36.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng...
Dialogue: 0,0:19:36.24,0:19:39.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembicaraan ini kita bahas lain kali saja.
Dialogue: 0,0:19:39.03,0:19:44.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk sekarang,\Nkita bagi saja setiap tiga orang.
Dialogue: 0,0:19:56.47,0:19:59.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku berendam terlalu lama.
Dialogue: 0,0:20:01.47,0:20:02.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia?
Dialogue: 0,0:20:02.81,0:20:05.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa? Tidak bisa tidur?
Dialogue: 0,0:20:07.48,0:20:10.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa badanmu masih panas?
Dialogue: 0,0:20:10.44,0:20:14.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia, kamu gampang kepanasan\Nsaat berendam.
Dialogue: 0,0:20:14.20,0:20:15.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yakin tidak apa-apa?
Dialogue: 0,0:20:15.61,0:20:16.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemarilah.
Dialogue: 0,0:20:16.86,0:20:19.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Staminamu jadi berkurang\Nkarena kepanasan, kan?
Dialogue: 0,0:20:19.91,0:20:22.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perubahan suhu itu berbahaya untuk Lizardman.
Dialogue: 0,0:20:22.62,0:20:24.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya pulihkan dulu.
Dialogue: 0,0:20:29.67,0:20:32.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa posisinya\Nmalah jadi agak memalukan.
Dialogue: 0,0:20:38.84,0:20:42.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pertama kalinya\Nkita berduaan seperti ini, ya.
Dialogue: 0,0:20:43.14,0:20:44.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal,
Dialogue: 0,0:20:44.39,0:20:47.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sejak datang kemari,\Naku selalu dibantu olehmu.
Dialogue: 0,0:20:47.56,0:20:50.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya aku tak pernah berterima kasih.
Dialogue: 0,0:20:50.90,0:20:54.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah bergabung\Ndengan party-ku, Theresia.
Dialogue: 0,0:20:56.40,0:20:58.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar lagi.
Dialogue: 0,0:20:58.45,0:21:01.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Staminamu masih belum pulih sepenuhnya.
Dialogue: 0,0:21:08.33,0:21:10.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu marah?
Dialogue: 0,0:21:11.29,0:21:13.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku kurang peka.
Dialogue: 0,0:21:13.73,0:21:14.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:21:14.54,0:21:17.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau ada yang ingin kamu sampaikan padaku,
Dialogue: 0,0:21:17.71,0:21:19.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ingatlah baik-baik.
Dialogue: 0,0:21:19.84,0:21:22.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suatu saat aku pasti akan\Nmenjadikanmu manusia.
Dialogue: 0,0:21:22.55,0:21:25.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu tiba, sampaikan padaku
Dialogue: 0,0:21:25.05,0:21:26.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan suara,
Dialogue: 0,0:21:27.14,0:21:28.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan kata-kata.
Dialogue: 0,0:21:37.13,0:21:39.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah, sepertinya panasmu sudah turun.
Dialogue: 0,0:21:42.45,0:21:45.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dingin dan nyaman.
Dialogue: 0,0:21:47.79,0:21:48.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:21:51.96,0:21:53.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lari!
Dialogue: 0,0:21:53.21,0:21:54.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa ini?
Dialogue: 0,0:21:54.75,0:21:57.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster! Ada monster muncul di kota!
Dialogue: 0,0:22:00.01,0:22:01.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster?
Dialogue: 0,0:22:01.38,0:22:02.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:22:06.47,0:22:08.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serbuan monster?
