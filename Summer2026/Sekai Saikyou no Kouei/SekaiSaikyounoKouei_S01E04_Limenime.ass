Dialogue: 0,0:01:32.41,0:01:43.04,sign,,0000,0000,0000,,GARDA BELAKANG TERKUAT DI DUNIA\N~PENJELAJAH PEMULA DI NEGERI LABIRIN~
Dialogue: 0,0:02:51.03,0:02:56.03,sign,,0000,0000,0000,,PEMANDIAN CAMPUR YANG MENEGANGKAN
Dialogue: 0,0:11:49.27,0:11:49.61,sign,,0000,0000,0000,,KEMAMPUAN YANG DIMILIKI
Dialogue: 0,0:11:49.61,0:11:49.98,sign,,0000,0000,0000,,PERTAHANAN DUKUNGAN LV. 1,\NMENGURANGI 10 POIN DMG YANG DITERIMA REKAN
Dialogue: 0,0:11:49.98,0:11:50.31,sign,,0000,0000,0000,,PEMULIHAN DUKUNGAN LV. 1,\NMEMULIHKAN 10 POIN HP SETIAP 30 DETIK
Dialogue: 0,0:11:50.31,0:11:50.73,sign,,0000,0000,0000,,SERANGAN DUKUNGAN LV. 1,\NMEMBERIKAN 10 POIN DMG YANG DILANCARKAN REKAN
Dialogue: 0,0:11:55.90,0:11:58.24,sign,,0000,0000,0000,,PENINGKATAN DUKUNGAN LV. 1, PENJAGA BELAKANG
Dialogue: 0,0:11:58.24,0:12:01.45,sign,,0000,0000,0000,,MATA ELANG, BACK STAND, BACKDRAFT
Dialogue: 0,0:12:01.45,0:12:03.49,sign,,0000,0000,0000,,POIN SKILL: 3
Dialogue: 0,0:12:46.12,0:12:47.08,sign,,0000,0000,0000,,KEMAMPUAN BUDAK "THERESIA"
Dialogue: 0,0:12:47.08,0:12:48.79,sign,,0000,0000,0000,,LIZARD SKIN LV. 1
Dialogue: 0,0:12:48.79,0:12:50.58,sign,,0000,0000,0000,,ACCEL DASH
Dialogue: 0,0:16:33.49,0:16:35.39,sign,,0000,0000,0000,,GARDA BELAKANG TERKUAT DI DUNIA\N~PENJELAJAH PEMULA DI NEGERI LABIRIN~
Dialogue: 0,0:17:46.09,0:17:47.63,sign,,0000,0000,0000,,ARIHITO
Dialogue: 0,0:18:08.57,0:18:09.19,sign,,0000,0000,0000,,KEMAMPUAN YANG DIMILIKI
Dialogue: 0,0:18:09.19,0:18:10.32,sign,,0000,0000,0000,,PENINGKATAN DUKUNGAN LV. 1
Dialogue: 0,0:18:10.32,0:18:12.20,sign,,0000,0000,0000,,MATA ELANG
Dialogue: 0,0:00:00.81,0:00:02.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang ingin aku bicarakan.
Dialogue: 0,0:00:05.68,0:00:09.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah ini, aku berniat ke tempatnya Leila
Dialogue: 0,0:00:09.28,0:00:12.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk meminta Theresia\Nmenjadi rekan party secara resmi.
Dialogue: 0,0:00:14.45,0:00:19.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin mengembalikan Theresia\Nke wujud manusianya.
Dialogue: 0,0:00:23.38,0:00:26.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah memang ada caranya?
Dialogue: 0,0:00:26.59,0:00:28.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:00:28.53,0:00:33.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika status setengah manusianya hilang,\Ndia bisa kembali ke wujud semula.
Dialogue: 0,0:00:33.35,0:00:35.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kasus mereka yang kembali semula,
Dialogue: 0,0:00:35.47,0:00:38.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kemungkinan pernah terjadi di masa lalu.
Dialogue: 0,0:00:38.01,0:00:40.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski caranya masih belum diketahui.
Dialogue: 0,0:00:40.52,0:00:44.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, saya juga tidak tahu detailnya,
Dialogue: 0,0:00:45.00,0:00:46.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi untuk kembali seperti semula,
Dialogue: 0,0:00:46.61,0:00:50.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kabarnya harus pergi\Nke Kuil Agung di Distrik 4.
Dialogue: 0,0:00:50.53,0:00:52.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuil Agung?
Dialogue: 0,0:00:52.57,0:00:55.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja, itu tidaklah mudah.
Dialogue: 0,0:00:55.41,0:00:58.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjelajah yang mampu\Nke Distrik 4 dari Distrik 8 ini
Dialogue: 0,0:00:58.72,0:01:00.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jumlahnya sangat sedikit.
Dialogue: 0,0:01:00.04,0:01:03.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sendiri pun hanya sampai\Nke Distrik 5 saja.
Dialogue: 0,0:01:04.48,0:01:07.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti kalau mau ke Distrik 4...
Dialogue: 0,0:01:07.34,0:01:11.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahayanya jauh lebih besar\Ndaripada di Distrik 8 ini.
Dialogue: 0,0:01:11.61,0:01:15.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kalian tak bisa ikut,\Naku tidak akan memaksa.
Dialogue: 0,0:01:17.12,0:01:19.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin mendengar pendapat kalian.
Dialogue: 0,0:03:03.25,0:03:06.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini masalah hidup dan mati.
Dialogue: 0,0:03:06.21,0:03:08.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa memaksa mereka.
Dialogue: 0,0:03:09.13,0:03:10.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku...
Dialogue: 0,0:03:13.34,0:03:15.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan ikut.
Dialogue: 0,0:03:15.76,0:03:19.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sudah banyak ditolong Theresia.
Dialogue: 0,0:03:19.97,0:03:21.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Igarashi.
Dialogue: 0,0:03:21.63,0:03:24.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, kamu bukan orang yang gegabah
Dialogue: 0,0:03:24.43,0:03:27.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai akan membahayakan orang lain, kan?
Dialogue: 0,0:03:28.49,0:03:30.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat bekerja dulu pun,
Dialogue: 0,0:03:32.69,0:03:35.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu tak pernah memaksa rekan kerjamu.
Dialogue: 0,0:03:39.46,0:03:43.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaliknya, malah kamu\Nyang akan memaksakan diri kalau dibiarkan.
Dialogue: 0,0:03:43.29,0:03:46.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ja-Jadi, karena itu...
Dialogue: 0,0:03:46.17,0:03:48.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus ada seseorang yang mengawasimu.
Dialogue: 0,0:03:50.08,0:03:52.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau boleh saya menambahkan,
Dialogue: 0,0:03:52.38,0:03:54.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan kemampuan Tuan Atobe,
Dialogue: 0,0:03:54.34,0:03:56.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saya rasa cepat atau lambat
Dialogue: 0,0:03:56.59,0:03:59.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian bisa mencapai Distrik 4.
Dialogue: 0,0:03:59.09,0:04:01.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau ikut!
Dialogue: 0,0:04:01.55,0:04:04.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya terus berada di tempat\Nyang sama itu membosankan.
Dialogue: 0,0:04:04.57,0:04:06.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu...
Dialogue: 0,0:04:06.50,0:04:08.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berdasarkan intuisi penjudi,
Dialogue: 0,0:04:08.27,0:04:11.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau ikut Abang rasanya\Naku bakal panjang umur.
Dialogue: 0,0:04:12.77,0:04:15.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti aku harus pastikan intuisimu benar.
Dialogue: 0,0:04:15.32,0:04:16.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga.
Dialogue: 0,0:04:16.69,0:04:18.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin ikut membantu.
Dialogue: 0,0:04:18.99,0:04:19.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja,
Dialogue: 0,0:04:19.91,0:04:23.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang mengajakku bergabung adalah Elitia.
Dialogue: 0,0:04:23.69,0:04:28.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku akan menunggu jawaban Elitia dulu.
Dialogue: 0,0:04:30.89,0:04:33.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti yang kalian ketahui,
Dialogue: 0,0:04:33.00,0:04:35.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku memiliki masalah tersendiri.
Dialogue: 0,0:04:36.03,0:04:39.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang ini bernama Scarlet Emperor.
Dialogue: 0,0:04:40.06,0:04:43.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senjata ini ditemukan dalam peti\Ndari monster bernama.
Dialogue: 0,0:04:44.89,0:04:48.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senjata ini mengubah penggunanya\Nmenjadi kelas senjata unik.
Dialogue: 0,0:04:48.64,0:04:51.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu artinya, gara-gara pedang itu...
Dialogue: 0,0:04:52.77,0:04:54.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pekerjaanku adalah pendekar pedang
Dialogue: 0,0:04:54.77,0:04:57.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan berubah menjadi Curse Blade.
Dialogue: 0,0:04:57.74,0:04:59.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuan Berserk milikku,
Dialogue: 0,0:04:59.90,0:05:02.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aktif secara paksa\Nsaat aku terkena darah musuh.
Dialogue: 0,0:05:03.22,0:05:06.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan pedang ini tak bisa dilepas\Ndari perlengkapanku.
Dialogue: 0,0:05:06.91,0:05:10.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tak bisa diperiksa dulu\Nsebelum memakaikannya?
Dialogue: 0,0:05:11.24,0:05:13.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di Byakuya Rhodan, tempatku dulu,
Dialogue: 0,0:05:13.77,0:05:18.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami memperkuat diri dengan senjata\Ndari peti monster bernama.
Dialogue: 0,0:05:18.30,0:05:22.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena tak peduli dengan kutukannya,\Nkami tak memeriksanya.
Dialogue: 0,0:05:22.43,0:05:24.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami bahkan tak bisa menolak memakainya.
Dialogue: 0,0:05:24.93,0:05:28.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun dilakukan untuk menjadi kuat, ya.
Dialogue: 0,0:05:28.64,0:05:32.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski ada alasannya,\Nmenurutku itu sudah berlebihan.
Dialogue: 0,0:05:33.81,0:05:36.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu, aku juga hanya memikirkan\Ningin menjadi kuat.
Dialogue: 0,0:05:36.71,0:05:38.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sekarang menyesal.
Dialogue: 0,0:05:38.87,0:05:40.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku seperti dikendalikan pedang itu
Dialogue: 0,0:05:40.61,0:05:44.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan berubah menjadi sesuatu\Nyang bukan diri sendiri.
Dialogue: 0,0:05:44.99,0:05:46.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu...
Dialogue: 0,0:05:46.12,0:05:49.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa masalah Theresia\Nsama seperti diriku.
Dialogue: 0,0:05:50.08,0:05:51.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga akan membantu.
Dialogue: 0,0:05:51.84,0:05:52.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:05:52.92,0:05:55.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai gantinya, aku juga butuh bantuan.
Dialogue: 0,0:05:56.00,0:05:59.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga memiliki alasan\Nuntuk mencoba melangkah kembali.
Dialogue: 0,0:06:00.51,0:06:03.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan itu adalah sesuatu\Nyang tak bisa kulakukan sendiri.
Dialogue: 0,0:06:04.76,0:06:06.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sama.
Dialogue: 0,0:06:06.39,0:06:08.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kutukan senjatamu perlu dihilangkan.
Dialogue: 0,0:06:08.06,0:06:10.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk caranya, kita cari tahu pelan-pelan.
Dialogue: 0,0:06:10.77,0:06:13.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga setuju dengan hal itu.
Dialogue: 0,0:06:13.16,0:06:15.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencana kita ke depan sudah diputuskan, ya.
Dialogue: 0,0:06:15.65,0:06:17.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kita sepakat.
Dialogue: 0,0:06:17.65,0:06:19.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, terima kasih.
Dialogue: 0,0:06:25.20,0:06:27.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Igarashi.
Dialogue: 0,0:06:27.12,0:06:29.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau mengobrol denganku lebih lama lagi?
Dialogue: 0,0:06:29.54,0:06:30.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh.
Dialogue: 0,0:06:30.75,0:06:33.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi malam ini masih panjang.
Dialogue: 0,0:06:34.12,0:06:35.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Mereka benar-benar akrab.\N- Ayo, berdua saja.
Dialogue: 0,0:06:35.71,0:06:37.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Mereka benar-benar akrab.\N- Ayo.
Dialogue: 0,0:06:37.57,0:06:40.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau ke penyalur tentara bayaran, kan?
Dialogue: 0,0:06:40.03,0:06:42.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku saja yang mengantar\Nmereka ke tempatmu.
Dialogue: 0,0:06:42.59,0:06:45.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, terima kasih.
Dialogue: 0,0:06:45.19,0:06:47.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau ikut Dik Eli.
Dialogue: 0,0:06:47.35,0:06:49.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dik Eli?
Dialogue: 0,0:06:49.07,0:06:51.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pertama kalinya aku dipanggil begitu.
Dialogue: 0,0:06:51.69,0:06:53.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau cuma Eli, sih, pernah.
Dialogue: 0,0:06:53.68,0:06:57.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, apa aku boleh\Nmemanggilmu Eli?
Dialogue: 0,0:06:59.23,0:07:01.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suzu juga mau ikut, kan?
Dialogue: 0,0:07:01.61,0:07:04.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pertama kalinya aku\Nmampir ke rumah laki-laki.
Dialogue: 0,0:07:04.99,0:07:06.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asalkan bersama-sama...
Dialogue: 0,0:07:08.20,0:07:09.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Baiklah, ayo.\N- Ayo minum!
Dialogue: 0,0:07:09.91,0:07:12.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya babak kedua.
Dialogue: 0,0:07:14.21,0:07:15.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, datang juga.
Dialogue: 0,0:07:15.58,0:07:19.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau datang terlambat,\Nke depannya kunjunganmu bisa dibatasi.
Dialogue: 0,0:07:19.54,0:07:21.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untunglah tepat waktu.
Dialogue: 0,0:07:22.83,0:07:25.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah siapkan seratus tiket perunggu.
Dialogue: 0,0:07:26.18,0:07:30.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa sekarang Theresia sudah bisa\Nmasuk party secara resmi?
Dialogue: 0,0:07:30.83,0:07:32.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk pemula sehebat dirimu,
Dialogue: 0,0:07:32.68,0:07:35.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku pikir paling cepat\Nbutuh waktu satu bulan.
Dialogue: 0,0:07:35.89,0:07:39.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata langsung datang\Nsehari setelah menyatakannya.
Dialogue: 0,0:07:39.60,0:07:43.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak hal yang berjalan lancar.\NDitambah faktor keberuntungan.
Dialogue: 0,0:07:44.24,0:07:46.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke depannya aku juga tak boleh lengah.
Dialogue: 0,0:07:46.69,0:07:49.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi mengembalikan Theresia menjadi manusia.
Dialogue: 0,0:07:50.61,0:07:55.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa tugasku adalah memberikan\Ntempat untuk para setengah manusia.
Dialogue: 0,0:07:55.07,0:07:56.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sebenarnya ada alasan lain.
Dialogue: 0,0:07:57.58,0:08:00.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin mengembalikan hati mereka.
Dialogue: 0,0:08:00.50,0:08:02.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku tidak mampu.
Dialogue: 0,0:08:02.63,0:08:06.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjelajah hebat dan jujur sepertimu,
Dialogue: 0,0:08:06.04,0:08:08.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagiku adalah sebuah harapan.
Dialogue: 0,0:08:08.09,0:08:10.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak, aku tidak seperti itu.
Dialogue: 0,0:08:11.35,0:08:13.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja, bagiku Theresia adalah
Dialogue: 0,0:08:14.01,0:08:15.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rekan pertamaku.
Dialogue: 0,0:08:15.85,0:08:17.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan merendah.
Dialogue: 0,0:08:17.43,0:08:19.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah pendapat jujurku.
Dialogue: 0,0:08:19.90,0:08:21.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tidak bicara,
Dialogue: 0,0:08:21.73,0:08:26.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rasanya ada saat-saat ketika aku\Nbisa mengerti perasaannya.
Dialogue: 0,0:08:26.11,0:08:28.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah itu hanya perasaanku atau bukan,
Dialogue: 0,0:08:28.87,0:08:31.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan memastikannya langsung.
Dialogue: 0,0:08:32.07,0:08:35.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa serta-merta mengatakan\Nmereka punya perasaan.
Dialogue: 0,0:08:35.72,0:08:37.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dibanding kemarin,
Dialogue: 0,0:08:37.28,0:08:40.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia tampak lebih\Nmembuka hatinya padamu.
Dialogue: 0,0:08:40.58,0:08:42.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya, begitulah menurutku.
Dialogue: 0,0:08:42.75,0:08:44.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:08:44.73,0:08:47.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga berharap seperti itu.
Dialogue: 0,0:08:48.22,0:08:49.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jaga Theresia.
Dialogue: 0,0:08:50.59,0:08:51.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:08:59.63,0:09:02.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia, kamu tak harus berjalan\Ndi belakangku.
Dialogue: 0,0:09:02.77,0:09:05.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berjalanlah di mana pun kamu suka.
Dialogue: 0,0:09:13.02,0:09:16.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ingin berjalan di depanku seperti biasa?
Dialogue: 0,0:09:16.58,0:09:18.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai garda depan?
Dialogue: 0,0:09:27.92,0:09:30.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, kamu bisa berjalan di mana pun.
Dialogue: 0,0:09:31.34,0:09:35.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, saat bertarung,\Nmajulah sedikit di depanku.
Dialogue: 0,0:09:35.16,0:09:37.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu,\Naku bisa membantumu seperti biasa.
Dialogue: 0,0:09:42.52,0:09:45.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ingin kita cepat pulang?
Dialogue: 0,0:09:47.38,0:09:49.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita memutar sebentar?
Dialogue: 0,0:09:52.91,0:09:55.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang mohon bantuannya ya, Theresia.
Dialogue: 0,0:09:58.49,0:09:59.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Dia tidur?
Dialogue: 0,0:10:00.65,0:10:01.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:10:01.62,0:10:05.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misaki sudah telanjur\Nmemakai tempat tidurnya.
Dialogue: 0,0:10:06.04,0:10:08.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berani juga dia.
Dialogue: 0,0:10:08.30,0:10:10.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti kelelahan.
Dialogue: 0,0:10:10.05,0:10:11.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi banyak hal terjadi.
Dialogue: 0,0:10:11.89,0:10:13.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:10:13.26,0:10:17.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kalau sudah tidur nyenyak,\Nsebaiknya biarkan saja.
Dialogue: 0,0:10:17.35,0:10:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Atobe.
Dialogue: 0,0:10:19.64,0:10:21.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang kembali.
Dialogue: 0,0:10:22.39,0:10:24.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami mau pergi mandi.
Dialogue: 0,0:10:24.44,0:10:25.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisanya tolong, ya.
Dialogue: 0,0:10:26.61,0:10:29.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau pulang ke penginapan sekarang,
Dialogue: 0,0:10:29.07,0:10:30.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita tak akan sempat ambil jam mandi.
Dialogue: 0,0:10:30.99,0:10:33.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau mandi bersama?
Dialogue: 0,0:10:33.19,0:10:34.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa pinjam baju ganti, kok.
Dialogue: 0,0:10:35.74,0:10:36.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arihito.
Dialogue: 0,0:10:36.99,0:10:41.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau peringkatmu naik,\Nkamu harus memikirkan soal tempat tinggalmu.
Dialogue: 0,0:10:42.08,0:10:43.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:10:43.28,0:10:46.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat penjelajahan hari ini,\Nperingkat Tuan Atobe di Distrik 8
Dialogue: 0,0:10:46.46,0:10:48.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}naik hingga ke peringkat 7.
Dialogue: 0,0:10:48.42,0:10:49.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gila!
Dialogue: 0,0:10:49.30,0:10:50.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atobe memang hebat.
Dialogue: 0,0:10:50.99,0:10:53.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian bisa pindah ke Royal Suite,
Dialogue: 0,0:10:53.30,0:10:55.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi karena batasnya delapan orang,
Dialogue: 0,0:10:55.43,0:10:59.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tempat tinggal Nona Suzuna dan Nona Elitia\Nakan dibatalkan secara otomatis.
Dialogue: 0,0:10:59.93,0:11:02.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aturannya begitu?
Dialogue: 0,0:11:02.22,0:11:06.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, jumlah anggota party\Ndibatasi maksimal delapan orang.
Dialogue: 0,0:11:06.19,0:11:09.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kapasitas tempat tinggal\Nyang bisa disewa
Dialogue: 0,0:11:09.40,0:11:13.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk satu party hanya boleh delapan orang.
Dialogue: 0,0:11:13.15,0:11:16.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya jumlah penginapannya terbatas.
Dialogue: 0,0:11:16.29,0:11:17.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:11:17.63,0:11:19.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tempat yang bagus
Dialogue: 0,0:11:19.37,0:11:22.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa memulihkan stamina\Ndan mana lebih cepat.
Dialogue: 0,0:11:22.12,0:11:25.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku lebih praktis\Nkalau seluruh anggota tinggal bersama.
Dialogue: 0,0:11:25.92,0:11:27.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ber-Bersama?
Dialogue: 0,0:11:27.96,0:11:29.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku mengerti.
Dialogue: 0,0:11:29.88,0:11:31.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan aku pikirkan.
Dialogue: 0,0:11:34.38,0:11:36.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya bisa santai juga.
Dialogue: 0,0:11:36.73,0:11:39.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia juga duduk dan bersantailah.
Dialogue: 0,0:11:40.89,0:11:43.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu juga ingin pergi mandi?
Dialogue: 0,0:11:45.27,0:11:48.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya-Yah, kamu bisa duduk kapan saja, kok.
Dialogue: 0,0:11:50.73,0:11:53.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini levelku naik.
Dialogue: 0,0:11:53.12,0:11:55.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin aku bisa mempelajari\Nkemampuan baru?
Dialogue: 0,0:11:55.90,0:11:58.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Backdraft?
Dialogue: 0,0:11:58.24,0:12:01.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini berguna untukku yang selalu di belakang.
Dialogue: 0,0:12:01.45,0:12:03.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku penasaran yang lain.
Dialogue: 0,0:12:03.91,0:12:06.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia, apa kamu punya lisensi?
Dialogue: 0,0:12:06.46,0:12:08.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa lihat sebentar...
Dialogue: 0,0:12:11.17,0:12:13.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya, aku harus lihat punggungmu?
Dialogue: 0,0:12:18.88,0:12:23.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penggunaan segel perbudakan\Nterhadap setengah manusia tak dilarang.
Dialogue: 0,0:12:23.85,0:12:25.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:12:37.36,0:12:38.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lisensi?
Dialogue: 0,0:12:47.08,0:12:48.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keterangannya berubah
Dialogue: 0,0:12:48.79,0:12:50.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari tentara bayaran menjadi budak.
Dialogue: 0,0:12:50.58,0:12:54.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, yang tadi itu\Nproses perubahan segel budak?
Dialogue: 0,0:12:55.05,0:12:57.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisa poin skill tinggal satu.
Dialogue: 0,0:12:57.53,0:13:00.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kita pikirkan bersama\Nmau ambil yang mana.
Dialogue: 0,0:13:02.76,0:13:05.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, selamat datang kembali, Abang.
Dialogue: 0,0:13:05.81,0:13:07.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah bangun, ya?
Dialogue: 0,0:13:07.18,0:13:10.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidur di kamar Suite memang mantap.
Dialogue: 0,0:13:10.44,0:13:12.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang, mohon bantuannya juga.
Dialogue: 0,0:13:14.15,0:13:15.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama-sama, aku juga.
Dialogue: 0,0:13:15.57,0:13:18.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suatu saat aku pasti akan berguna.
Dialogue: 0,0:13:18.44,0:13:19.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya kalau bersamaku,
Dialogue: 0,0:13:19.70,0:13:22.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mencari harta pasti akan lebih mudah.
Dialogue: 0,0:13:23.62,0:13:28.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, kenapa kamu menulis "Gambler"\Ndi kelas pekerjaanmu?
Dialogue: 0,0:13:28.95,0:13:32.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya menurutku kalau ada yang begitu\Nmungkin bakal seru.
Dialogue: 0,0:13:32.42,0:13:36.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di ramalan kuil pun aku selalu\Ndapat yang Sangat Beruntung.
Dialogue: 0,0:13:36.09,0:13:38.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga jago main kartu.
Dialogue: 0,0:13:38.46,0:13:42.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupon lotre yang dibeli bareng\Nkeluargaku juga dapat 100.000 yen.
Dialogue: 0,0:13:43.01,0:13:44.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keberuntunganmu benar-benar bagus, ya.
Dialogue: 0,0:13:44.85,0:13:46.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi tenang saja.
Dialogue: 0,0:13:46.62,0:13:48.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, yang lain ke mana?
Dialogue: 0,0:13:48.64,0:13:49.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi mandi.
Dialogue: 0,0:13:49.60,0:13:51.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih bisa ikut atau tidak, ya?
Dialogue: 0,0:13:51.23,0:13:53.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau ke sana.
Dialogue: 0,0:13:54.44,0:13:57.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, aku juga mau mandi, deh.
Dialogue: 0,0:14:02.36,0:14:05.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia, kamu juga mandilah\Nselagi yang lain masih di sana.
Dialogue: 0,0:14:05.62,0:14:08.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, sampai nanti.
Dialogue: 0,0:14:11.08,0:14:13.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serasa milik sendiri.
Dialogue: 0,0:14:18.46,0:14:21.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kalau mau pakai sampo, silakan saja.
Dialogue: 0,0:14:21.76,0:14:24.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penghuni kamar lain, kah?
Dialogue: 0,0:14:24.34,0:14:26.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak merasakan ada yang masuk.
Dialogue: 0,0:14:29.60,0:14:30.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya?
Dialogue: 0,0:14:32.68,0:14:34.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}The-Theresia?
Dialogue: 0,0:14:34.77,0:14:36.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar, Theresia,
Dialogue: 0,0:14:36.90,0:14:41.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ini tempat untuk laki-laki,\Nkamu tidak boleh masuk sini!
Dialogue: 0,0:14:41.74,0:14:42.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tung-Tunggu,
Dialogue: 0,0:14:42.82,0:14:46.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}zirahmu tidak bisa dilepas,\Njadi pakai terus saja.
Dialogue: 0,0:14:46.45,0:14:48.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, bukan!\NPergilah ke tempat perempuan...
Dialogue: 0,0:14:59.00,0:15:01.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya aku bisa pastikan\Ntak akan ada yang masuk.
Dialogue: 0,0:15:01.88,0:15:05.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, masalah utamanya itu...
Dialogue: 0,0:15:11.89,0:15:14.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata bisa dilepas, ya.
Dialogue: 0,0:15:15.06,0:15:17.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, yang lebih penting sekarang,
Dialogue: 0,0:15:17.19,0:15:18.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pergilah ke pemandian perempuan.
Dialogue: 0,0:15:22.69,0:15:25.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau menggosok punggungku?
Dialogue: 0,0:15:33.12,0:15:35.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau niatnya memang baik,
Dialogue: 0,0:15:35.37,0:15:37.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tak ada gunanya aku terus-terusan canggung.
Dialogue: 0,0:15:38.54,0:15:40.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Theresia.
Dialogue: 0,0:15:40.42,0:15:43.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tak perlu sampai sesungkan itu.
Dialogue: 0,0:15:43.80,0:15:47.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pergi mandi sendirian itu\Nhal yang wajar.
Dialogue: 0,0:15:47.80,0:15:50.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toh, bukan berarti\Naku dikucilkan rekan-rekanku.
Dialogue: 0,0:15:52.68,0:15:55.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Su-Sudah cukup.
Dialogue: 0,0:16:00.90,0:16:03.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia, menggosoknya sudahi dulu.
Dialogue: 0,0:16:03.39,0:16:05.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita berendam!
Dialogue: 0,0:16:05.11,0:16:07.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menghargai perhatiannya,
Dialogue: 0,0:16:07.53,0:16:09.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku harus bersikap bagaimana?
Dialogue: 0,0:16:09.62,0:16:13.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia, mulai besok kamu harus\Nke pemandian perempuan.
Dialogue: 0,0:16:15.25,0:16:16.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia?
Dialogue: 0,0:16:16.58,0:16:17.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia!
Dialogue: 0,0:16:19.21,0:16:20.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pusing kelamaan berendam.
Dialogue: 0,0:16:21.54,0:16:24.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, Lizardman itu kan kadal,
Dialogue: 0,0:16:25.21,0:16:28.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}artinya dia makhluk berdarah dingin?
Dialogue: 0,0:16:29.01,0:16:33.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, izinkan saya memanggil Anda\NNona Kyouka.
Dialogue: 0,0:16:35.39,0:16:39.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Louisa, mau lanjut ronde ketiga?
Dialogue: 0,0:16:47.03,0:16:50.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena memasukkan setengah manusia\Nke party itu sangat jarang,
Dialogue: 0,0:16:50.74,0:16:54.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saya tidak tahu akan\Nada kasus seperti ini.
Dialogue: 0,0:16:54.53,0:16:58.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibilang "kasus" malah membuatku\Njadi merasa bersalah.
Dialogue: 0,0:16:58.37,0:16:59.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Su-Sudah.
Dialogue: 0,0:16:59.79,0:17:01.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atobe itu orangnya serius,
Dialogue: 0,0:17:01.58,0:17:04.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku tidak menaruh rasa curiga.
Dialogue: 0,0:17:04.38,0:17:07.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia, kamu tidak apa-apa?
Dialogue: 0,0:17:07.83,0:17:12.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu tidak keberatan\Nmandi bersama laki-laki?
Dialogue: 0,0:17:13.43,0:17:16.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dia ingin berterima kasih\Npada Arihito.
Dialogue: 0,0:17:16.80,0:17:20.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata diam-diam Abang suka yang begituan.
Dialogue: 0,0:17:20.14,0:17:21.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bercanda.
Dialogue: 0,0:17:21.52,0:17:24.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku percaya sama Abang, kok.
Dialogue: 0,0:17:25.69,0:17:28.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ayo kita tentukan tempat tidur.
Dialogue: 0,0:17:29.57,0:17:33.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat tidur mana yang akan terpilih\Ndari tujuh takdir ini?
Dialogue: 0,0:17:35.70,0:17:40.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidur sekamar dengan orang lain\Nrasanya agak berbahaya.
Dialogue: 0,0:17:42.92,0:17:46.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu akan sulit dijelaskan.
Dialogue: 0,0:17:47.63,0:17:51.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, kalau berbeda kamar mungkin aman.
Dialogue: 0,0:17:53.72,0:17:56.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keberuntunganku ternyata lumayan juga.
Dialogue: 0,0:17:57.81,0:18:01.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia, tak perlu berjaga semalaman.
Dialogue: 0,0:18:05.48,0:18:08.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, sebentar lagi juga dia kembali tidur.
Dialogue: 0,0:18:09.19,0:18:10.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini saja cukup.
Dialogue: 0,0:18:10.32,0:18:12.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin ambil Backdraft,
Dialogue: 0,0:18:12.20,0:18:14.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi prioritasku adalah\Nmembantu yang lain.
Dialogue: 0,0:18:17.87,0:18:19.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini Mata Elang?
Dialogue: 0,0:18:20.12,0:18:23.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya area yang aku pantau\Njadi lebih luas.
Dialogue: 0,0:18:23.00,0:18:25.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya ini akan berguna.
Dialogue: 0,0:18:25.83,0:18:28.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai garda belakang, ini sudah lumayan.
Dialogue: 0,0:18:28.71,0:18:30.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah
Dialogue: 0,0:18:30.76,0:18:32.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lumayan.
Dialogue: 0,0:18:46.82,0:18:49.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Kyouka juga?
Dialogue: 0,0:18:51.03,0:18:52.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian juga?
Dialogue: 0,0:18:52.99,0:18:55.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Kyouka, kita harus bagaimana?
Dialogue: 0,0:18:55.86,0:18:59.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini, kita tidak akan bisa tidur.
Dialogue: 0,0:18:59.08,0:19:02.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga, itu, bagaimana mengatakannya...
Dialogue: 0,0:19:10.80,0:19:13.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia juga tidak bisa tidur, ya.
Dialogue: 0,0:19:13.47,0:19:17.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, ini efeknya Atobe.
Dialogue: 0,0:19:18.39,0:19:21.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidurnya nyenyak sekali, ya.
Dialogue: 0,0:19:21.68,0:19:23.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajah tidurnya menggemaskan.
Dialogue: 0,0:19:23.81,0:19:26.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, jangan terlalu dekat.
Dialogue: 0,0:19:29.15,0:19:31.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, Tuan Atobe.
Dialogue: 0,0:19:32.32,0:19:35.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa yang kamu lakukan, Misaki?
Dialogue: 0,0:19:36.66,0:19:38.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah.
Dialogue: 0,0:19:38.24,0:19:40.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangannya besar.
Dialogue: 0,0:19:41.85,0:19:43.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar saja.
Dialogue: 0,0:19:46.16,0:19:49.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Kyouka, ada apa?
Dialogue: 0,0:19:49.67,0:19:52.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melakukan hal seperti ini\Nsaat Atobe tertidur,
Dialogue: 0,0:19:52.00,0:19:55.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menurutku, ini, bukanlah hal yang baik.
Dialogue: 0,0:19:55.72,0:19:58.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita rahasiakan saja.
Dialogue: 0,0:20:14.23,0:20:16.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah waktunya kita tidur.
Dialogue: 0,0:20:16.15,0:20:18.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, bahaya kalau diteruskan.
Dialogue: 0,0:20:33.71,0:20:37.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengenai Royal Suite dan kotak hitamnya
Dialogue: 0,0:20:37.30,0:20:39.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan saya atur begitu masuk kerja.
Dialogue: 0,0:20:39.47,0:20:42.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami mau keliling dulu\Nsetelah ke tukang jagal,
Dialogue: 0,0:20:42.25,0:20:44.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi mohon bantuannya.
Dialogue: 0,0:20:44.03,0:20:45.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong...
Dialogue: 0,0:20:45.18,0:20:46.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa, Atobe?
Dialogue: 0,0:20:46.85,0:20:51.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada sesuatu yang terjadi\Nsaat aku tidur semalam?
Dialogue: 0,0:20:51.23,0:20:53.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak ada.
Dialogue: 0,0:20:53.44,0:20:55.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:20:55.94,0:20:58.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang di tempat kami.
Dialogue: 0,0:20:58.90,0:21:02.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat perlengkapan yang dibuat di sini\Ndengan bahan Red Face,
Dialogue: 0,0:21:02.53,0:21:05.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kemarin nyawaku jadi selamat.
Dialogue: 0,0:21:05.54,0:21:07.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, wah.
Dialogue: 0,0:21:07.29,0:21:09.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku turut senang kalau kamu selamat.
Dialogue: 0,0:21:10.17,0:21:13.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Juggernaut terlalu besar,\Ntubuhnya kami bagi-bagi
Dialogue: 0,0:21:13.75,0:21:18.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan pemotongannya kami serahkan\Nke seluruh tukang jagal di Distrik 8.
Dialogue: 0,0:21:18.05,0:21:20.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putriku juga tampaknya sudah tak sabar.
Dialogue: 0,0:21:20.59,0:21:21.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa.
Dialogue: 0,0:21:21.99,0:21:24.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dapat monster bernama\Ndua kali berturut-turut.
Dialogue: 0,0:21:24.51,0:21:28.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami memang mengalahkannya,\Ntapi kurasa itu cuma beruntung.
Dialogue: 0,0:21:28.48,0:21:31.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama aku ingin kembali ke labirin.
Dialogue: 0,0:21:31.77,0:21:33.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bersama kalian,
Dialogue: 0,0:21:33.44,0:21:36.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rasanya aku akan bisa memotong\Nbanyak monster langka.
Dialogue: 0,0:21:37.65,0:21:40.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Material hasil pemotongannya mau diapakan?
Dialogue: 0,0:21:40.11,0:21:41.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong disimpan saja dulu.
Dialogue: 0,0:21:41.86,0:21:46.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih ingin memikirkan mau diuangkan\Natau dijadikan perlengkapan.
Dialogue: 0,0:21:46.36,0:21:48.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:21:49.87,0:21:52.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kita bisa serahkan pada mereka.
Dialogue: 0,0:21:52.58,0:21:55.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toh, kita pernah dibantu juga.
Dialogue: 0,0:21:55.20,0:21:58.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, setelah ini\Nkita akan meninjau Royal Suite...
Dialogue: 0,0:22:00.09,0:22:01.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan kotak ini.
Dialogue: 0,0:22:03.84,0:22:08.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa sebenarnya isi di dalam ini?
