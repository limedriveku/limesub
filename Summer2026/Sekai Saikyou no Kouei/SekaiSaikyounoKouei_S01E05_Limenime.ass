Dialogue: 0,0:00:07.14,0:00:10.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Kyouka juga?
Dialogue: 0,0:00:11.49,0:00:12.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian juga?
Dialogue: 0,0:00:13.79,0:00:16.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidurnya nyenyak sekali, ya.
Dialogue: 0,0:00:17.16,0:00:19.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajah tidurnya menggemaskan.
Dialogue: 0,0:00:19.21,0:00:21.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangannya besar.
Dialogue: 0,0:00:22.88,0:00:24.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar saja.
Dialogue: 0,0:00:29.26,0:00:33.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa terjadi sesuatu\Nsaat aku tidur semalam?
Dialogue: 0,0:00:33.64,0:00:36.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak ada.
Dialogue: 0,0:00:37.77,0:00:40.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kita bisa serahkan pada mereka.
Dialogue: 0,0:00:40.69,0:00:44.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, setelah ini\Nkita akan meninjau Royal Suite.
Dialogue: 0,0:00:45.40,0:00:46.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan kotak ini.
Dialogue: 0,0:00:49.78,0:00:53.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan pergi ke toko ahli kotak\Nuntuk membuka kotak hitam ini.
Dialogue: 0,0:00:53.49,0:00:56.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tolong urus proses pindahannya.
Dialogue: 0,0:00:56.61,0:00:57.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:00:57.55,0:01:01.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu, kita akan langsung berangkat\Nke Padang Fajar!
Dialogue: 0,0:01:01.08,0:01:04.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misaki, kamu semangat sekali, ya.
Dialogue: 0,0:01:04.29,0:01:05.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:01:05.34,0:01:09.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya kita bakal menginap\Ndi tempat yang luar biasa itu!
Dialogue: 0,0:01:10.38,0:01:13.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar puncak kemewahan!
Dialogue: 0,0:01:14.14,0:01:16.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya aku bisa hidup mewah juga.
Dialogue: 0,0:01:18.02,0:01:19.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:01:19.14,0:01:21.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak tadi, Misaki jadi seperti ini.
Dialogue: 0,0:01:21.35,0:01:23.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baguslah kalau sudah bersemangat.
Dialogue: 0,0:01:23.84,0:01:26.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, nanti kita berkumpul lagi.
Dialogue: 0,0:01:26.07,0:01:27.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:01:30.57,0:01:34.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tak salah, tokonya ada di sekitar sini.
Dialogue: 0,0:01:37.41,0:01:38.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Theresia?
Dialogue: 0,0:01:40.21,0:01:41.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:01:46.04,0:01:48.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di tengah kota ada monster?
Dialogue: 0,0:01:49.88,0:01:54.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, apa mungkin Anda Tuan Arihito Atobe?
Dialogue: 0,0:01:57.06,0:01:59.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, benar.
Dialogue: 0,0:01:59.02,0:02:01.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah mendengarnya dari Guild.
Dialogue: 0,0:02:01.75,0:02:04.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang di Toko Ahli Kotak Arthur.
Dialogue: 0,0:02:04.64,0:02:07.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izinkan aku membuka kotak hitamnya.
Dialogue: 0,0:02:07.83,0:02:10.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Falma Arthur.
Dialogue: 0,0:03:48.46,0:03:52.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf karena tadi\NShion membuat kalian terkejut.
Dialogue: 0,0:03:52.55,0:03:53.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shion?
Dialogue: 0,0:03:53.67,0:03:56.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, anjing yang besar itu.
Dialogue: 0,0:03:56.72,0:03:59.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anjing itu dari ras\Nyang disebut Silver Hound.
Dialogue: 0,0:03:59.59,0:04:03.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya, ia merupakan anjing penjaga\Nyang menemani penjelajah.
Dialogue: 0,0:04:03.18,0:04:04.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:04:04.93,0:04:08.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, sekarang menjaga anak-anak?
Dialogue: 0,0:04:08.03,0:04:08.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:04:08.77,0:04:11.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu mau membuka kotak?
Dialogue: 0,0:04:11.61,0:04:12.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:04:12.40,0:04:15.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Plum dan Eiku tunggu di luar, ya.
Dialogue: 0,0:04:15.32,0:04:17.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:04:17.99,0:04:19.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, Tuan Atobe.
Dialogue: 0,0:04:19.57,0:04:23.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah aku menyentuh kotak hitam itu?
Dialogue: 0,0:04:23.43,0:04:24.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, silakan.
Dialogue: 0,0:04:28.08,0:04:32.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, sudah lama sekali\Ntidak merasakan sensasi ini.
Dialogue: 0,0:04:32.23,0:04:35.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Isinya barang yang belum tentu\Nbisa dijumpai dalam setahun
Dialogue: 0,0:04:35.55,0:04:39.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan memiliki nilai kelangkaan\Nyang sangat tinggi.
Dialogue: 0,0:04:40.97,0:04:44.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, seandainya gagal\Nmembuka segel kotaknya,
Dialogue: 0,0:04:45.43,0:04:49.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}monster kuat dalam jumlah besar\Nakan terpanggil,
Dialogue: 0,0:04:49.02,0:04:51.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebagian kota bisa hancur,
Dialogue: 0,0:04:52.56,0:04:55.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan bencana besar bisa saja terjadi.
Dialogue: 0,0:04:58.57,0:05:00.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, jangan khawatir.
Dialogue: 0,0:05:01.16,0:05:04.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan Anting Kemahiran\Ndan Cincin Penguasaan,
Dialogue: 0,0:05:04.78,0:05:08.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tingkat keberhasilannya menjadi 100%.
Dialogue: 0,0:05:08.00,0:05:10.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dijamin bisa dibuka dengan aman.
Dialogue: 0,0:05:12.75,0:05:14.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, langsung saja,
Dialogue: 0,0:05:14.34,0:05:16.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mari kita buka kotaknya.
Dialogue: 0,0:05:20.80,0:05:23.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubuka pelan-pelan\Ndan penuh hati-hati.
Dialogue: 0,0:05:27.10,0:05:28.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:05:28.77,0:05:31.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, proses pembukaan kotak\Nakan dimulai.
Dialogue: 0,0:05:38.40,0:05:39.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:05:44.49,0:05:46.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlihat seperti labirin, ya?
Dialogue: 0,0:05:46.87,0:05:48.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah sistem pertahanan
Dialogue: 0,0:05:48.70,0:05:51.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang dibuat agar kotaknya sulit dibuka.
Dialogue: 0,0:05:51.41,0:05:54.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua bolanya harus dimasukkan\Nke dalam kotak
Dialogue: 0,0:05:54.29,0:05:55.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau tak akan bisa dibuka.
Dialogue: 0,0:05:56.96,0:05:59.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai ke tempat sempit seperti itu?
Dialogue: 0,0:05:59.34,0:06:02.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sampai menyentuh dinding labirinnya,
Dialogue: 0,0:06:02.22,0:06:04.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akibatnya akan sangat gawat.
Dialogue: 0,0:06:05.51,0:06:07.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tenang saja.
Dialogue: 0,0:06:07.43,0:06:09.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan saja pada tanganku.
Dialogue: 0,0:06:11.18,0:06:12.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alamak.
Dialogue: 0,0:06:15.44,0:06:18.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di bagian sini seperti ini...
Dialogue: 0,0:06:20.94,0:06:23.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan nakal.
Dialogue: 0,0:06:23.15,0:06:25.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuh, kan, bisa lewat.
Dialogue: 0,0:06:29.37,0:06:31.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dorong, lebih dalam lagi.
Dialogue: 0,0:06:32.29,0:06:34.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masukkan semuanya sekaligus.
Dialogue: 0,0:06:34.64,0:06:36.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai ke tujuan!
Dialogue: 0,0:06:36.29,0:06:39.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, benar begitu.
Dialogue: 0,0:06:39.04,0:06:40.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang...
Dialogue: 0,0:06:41.16,0:06:42.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah semuanya!
Dialogue: 0,0:06:45.13,0:06:47.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembuka segel adalah
Dialogue: 0,0:06:49.10,0:06:51.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Falma Arthur.
Dialogue: 0,0:06:52.77,0:06:54.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus.
Dialogue: 0,0:06:54.23,0:06:57.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, perlihatkan semuanya pada kami.
Dialogue: 0,0:06:58.15,0:06:59.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terbukalah!
Dialogue: 0,0:07:07.28,0:07:08.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silau.
Dialogue: 0,0:07:20.42,0:07:22.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah selesai.
Dialogue: 0,0:07:22.40,0:07:24.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang sudah aman.
Dialogue: 0,0:07:24.01,0:07:26.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan dilihat isi kotaknya.
Dialogue: 0,0:07:28.93,0:07:30.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak sekali.
Dialogue: 0,0:07:42.57,0:07:43.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:07:43.73,0:07:47.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagian ujungnya seperti kunci, ya.
Dialogue: 0,0:07:47.03,0:07:50.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kemungkinan ada barang yang terkutuk,
Dialogue: 0,0:07:50.07,0:07:53.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dipakainya nanti\Nsetelah aku periksa dulu, ya.
Dialogue: 0,0:07:53.20,0:07:54.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:08:02.67,0:08:05.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka masih lama, ya?
Dialogue: 0,0:08:05.36,0:08:08.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin di dalam kotak hitam itu\Nada beberapa perlengkapan,
Dialogue: 0,0:08:08.88,0:08:11.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi akan memakan waktu untuk memilihnya.
Dialogue: 0,0:08:22.98,0:08:26.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh? Dia seperti memakai rompi antipeluru.
Dialogue: 0,0:08:26.11,0:08:27.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arihito, apa itu?
Dialogue: 0,0:08:27.65,0:08:28.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:08:28.61,0:08:31.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya ini "Katapel Kayu Hitam".
Dialogue: 0,0:08:33.37,0:08:37.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di pegangannya ada slot\Nuntuk memasang Rune, ya.
Dialogue: 0,0:08:37.32,0:08:38.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rune?
Dialogue: 0,0:08:38.33,0:08:41.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rune itu semacam versi unggul\Ndari batu sihir.
Dialogue: 0,0:08:41.66,0:08:44.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlengkapan yang bisa\Ndipasang Rune itu langka,
Dialogue: 0,0:08:44.21,0:08:45.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi harus dijaga baik-baik.
Dialogue: 0,0:08:45.88,0:08:47.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi begitu.
Dialogue: 0,0:08:47.59,0:08:50.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sarung tangan itu untuk apa?
Dialogue: 0,0:08:50.05,0:08:53.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Light Steel Chain Glove +1.
Dialogue: 0,0:08:53.39,0:08:56.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena katanya ada efek\Nmemperkuat skill dukungan,
Dialogue: 0,0:08:56.77,0:08:59.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sepertinya cocok untukku.
Dialogue: 0,0:08:59.14,0:09:01.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa, itemnya ada bermacam-macam.
Dialogue: 0,0:09:01.59,0:09:04.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Eli, ini apa?
Dialogue: 0,0:09:04.11,0:09:07.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu dinamakan Chameleon Boots.
Dialogue: 0,0:09:07.07,0:09:08.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fungsinya untuk menyatu
Dialogue: 0,0:09:08.28,0:09:10.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan lingkungan sekitar.
Dialogue: 0,0:09:10.32,0:09:12.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, chameleon?
Dialogue: 0,0:09:12.24,0:09:14.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu juga terbuat dari bahan monster?
Dialogue: 0,0:09:14.20,0:09:15.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya begitu.
Dialogue: 0,0:09:15.69,0:09:17.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:09:17.66,0:09:20.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sensasi kasarnya enak juga.
Dialogue: 0,0:09:20.75,0:09:22.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, di mana Kyouka?
Dialogue: 0,0:09:22.83,0:09:25.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kalau Igarashi...
Dialogue: 0,0:09:32.34,0:09:34.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang dia lakukan?
Dialogue: 0,0:09:42.56,0:09:44.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlengkapannya luar biasa.
Dialogue: 0,0:09:44.06,0:09:46.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, cocok dipakai Kyouka.
Dialogue: 0,0:09:53.82,0:09:56.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlengkapan yang dipakai Kyouka adalah
Dialogue: 0,0:09:56.16,0:09:58.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Light Steel Lady Armor +3.
Dialogue: 0,0:09:58.62,0:10:01.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlengkapan pelindung bagus
Dialogue: 0,0:10:01.16,0:10:02.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang meningkatkan pertahanan sihir.
Dialogue: 0,0:10:03.29,0:10:05.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski terbuka begini?
Dialogue: 0,0:10:05.67,0:10:08.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makin terbuka, makin ringan saat dipakai.
Dialogue: 0,0:10:08.63,0:10:10.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:10:10.55,0:10:13.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini terlalu terbuka!
Dialogue: 0,0:10:15.09,0:10:17.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bikin pengin melihat terus.
Dialogue: 0,0:10:19.01,0:10:21.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suzuna, Silk Sash ini
Dialogue: 0,0:10:21.64,0:10:24.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tadinya aku pakai untuk menutupi tubuhku,
Dialogue: 0,0:10:24.40,0:10:27.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kupikir,\Nsebaiknya pertahananmu perlu ditingkatkan,
Dialogue: 0,0:10:27.60,0:10:28.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi cobalah pakai.
Dialogue: 0,0:10:28.94,0:10:33.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa tidak enak hati menerimanya,
Dialogue: 0,0:10:33.07,0:10:34.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi terima kasih.
Dialogue: 0,0:10:39.12,0:10:40.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Cocok banget!
Dialogue: 0,0:10:40.79,0:10:42.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis kuil memang luar biasa.
Dialogue: 0,0:10:42.41,0:10:43.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis kuil?
Dialogue: 0,0:10:43.83,0:10:44.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:10:44.71,0:10:46.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumah keluargaku adalah kuil
Dialogue: 0,0:10:46.73,0:10:49.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan aku biasa membantu ritual keagamaan.
Dialogue: 0,0:10:49.80,0:10:52.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, jadi begitu, ya.
Dialogue: 0,0:10:52.76,0:10:54.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, Arihito.
Dialogue: 0,0:10:54.73,0:10:56.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi saat mengecek lisensi,
Dialogue: 0,0:10:56.80,0:11:00.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}levelku meningkat\Ndan poin skillku bertambah.
Dialogue: 0,0:11:00.68,0:11:02.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, aku juga sama.
Dialogue: 0,0:11:02.22,0:11:03.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga.
Dialogue: 0,0:11:03.73,0:11:05.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh!
Dialogue: 0,0:11:05.06,0:11:08.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kita bisa coba-coba\Nbanyak hal di Padang Fajar.
Dialogue: 0,0:11:08.36,0:11:10.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti perlengkapan atau kemampuan baru.
Dialogue: 0,0:11:10.90,0:11:12.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:11:12.25,0:11:13.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ayo berangkat.
Dialogue: 0,0:11:13.90,0:11:16.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu dulu.
Dialogue: 0,0:11:16.11,0:11:19.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mentalku masih belum siap.
Dialogue: 0,0:11:22.54,0:11:25.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ayo kita kalahkan yang banyak!
Dialogue: 0,0:11:29.63,0:11:31.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, ayo mulai.
Dialogue: 0,0:11:32.71,0:11:33.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:11:36.80,0:11:39.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Garda belakang terkuat di dunia!
Dialogue: 0,0:11:47.69,0:11:50.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misaki, coba lempar senjatamu.
Dialogue: 0,0:11:51.07,0:11:52.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kucoba!
Dialogue: 0,0:11:57.36,0:11:59.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa?
Dialogue: 0,0:11:59.03,0:12:01.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku cuma melempar dadu besi biasa.
Dialogue: 0,0:12:03.35,0:12:05.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dukungan DMG bertambah 1?
Dialogue: 0,0:12:05.91,0:12:10.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini, sepertinya aku bisa\Nmeningkatkan pertahanan dan pemulihan.
Dialogue: 0,0:12:10.38,0:12:11.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:12:11.70,0:12:13.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abang hebat!
Dialogue: 0,0:12:24.89,0:12:28.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar, jumlahnya banyak sekali!
Dialogue: 0,0:12:28.77,0:12:31.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suzuna, mari coba kemampuan barumu.
Dialogue: 0,0:12:31.94,0:12:32.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:12:32.82,0:12:34.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Igarashi juga.
Dialogue: 0,0:12:34.44,0:12:35.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:12:35.73,0:12:38.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia juga, pakai senjata barumu.
Dialogue: 0,0:12:42.49,0:12:43.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenalah!
Dialogue: 0,0:13:08.73,0:13:12.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Double Attack bisa menyerang\Ndua target sekaligus.
Dialogue: 0,0:13:12.06,0:13:17.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedangkan Wind Slash memiliki efek\Nmengempas musuh setelah serangan.
Dialogue: 0,0:13:17.23,0:13:18.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuan yang bagus.
Dialogue: 0,0:13:18.61,0:13:21.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf, Arihito,
Dialogue: 0,0:13:21.24,0:13:26.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semua yang di depan\Nterlihat memancarkan cahaya redup.
Dialogue: 0,0:13:27.54,0:13:30.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak melihatnya.
Dialogue: 0,0:13:30.00,0:13:32.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suzuna, apa kamu bisa merasakannya?
Dialogue: 0,0:13:32.75,0:13:35.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku juga tidak tahu kenapa.
Dialogue: 0,0:13:40.26,0:13:42.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suzuna punya indra keenam.
Dialogue: 0,0:13:42.68,0:13:45.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia bisa melihat sesuatu\Nyang tak bisa dilihat orang lain?
Dialogue: 0,0:13:53.69,0:13:55.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini lantai tiga, ya.
Dialogue: 0,0:13:55.69,0:13:59.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sama-sama Padang Fajar,\Nlangitnya terasa berbeda.
Dialogue: 0,0:13:59.15,0:14:01.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, pohonnya juga banyak.
Dialogue: 0,0:14:01.70,0:14:03.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal awalnya jarang.
Dialogue: 0,0:14:03.61,0:14:05.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada tempat berlindung,
Dialogue: 0,0:14:05.62,0:14:09.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kemungkinan ada banyak musuh bersembunyi,\Njadi harus waspada.
Dialogue: 0,0:14:15.04,0:14:16.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengerikan!
Dialogue: 0,0:14:16.34,0:14:18.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara apa ini?
Dialogue: 0,0:14:21.42,0:14:22.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicaranya nanti saja.
Dialogue: 0,0:14:22.67,0:14:25.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Igarashi, Theresia, kita akan menyerang.
Dialogue: 0,0:14:25.39,0:14:27.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misaki, jangan maju dulu.
Dialogue: 0,0:14:27.18,0:14:28.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suzuna, kamu di depanku.
Dialogue: 0,0:14:28.97,0:14:30.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:14:32.68,0:14:33.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenalah!
Dialogue: 0,0:14:47.32,0:14:48.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Igarashi?
Dialogue: 0,0:15:01.88,0:15:02.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Igarashi.
Dialogue: 0,0:15:03.34,0:15:05.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertahanlah.
Dialogue: 0,0:15:07.09,0:15:08.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuhku bisa bergerak.
Dialogue: 0,0:15:10.72,0:15:13.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, Atobe...
Dialogue: 0,0:15:13.18,0:15:14.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya?
Dialogue: 0,0:15:15.73,0:15:17.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, ma-maaf.
Dialogue: 0,0:15:17.81,0:15:18.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati!
Dialogue: 0,0:15:18.86,0:15:20.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih ada sesuatu di dekat sini!
Dialogue: 0,0:15:24.11,0:15:25.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:15:25.86,0:15:27.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak melihat musuh.
Dialogue: 0,0:15:33.25,0:15:35.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia bisa melihatnya?
Dialogue: 0,0:15:36.87,0:15:40.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fungsinya untuk menyatu\Ndengan lingkungan sekitar.
Dialogue: 0,0:15:40.42,0:15:42.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chameleon!
Dialogue: 0,0:15:42.21,0:15:45.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suzuna, bidiklah ke arah\Nyang ditunjukkan Theresia!
Dialogue: 0,0:15:45.34,0:15:46.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik!
Dialogue: 0,0:16:00.27,0:16:01.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matilah!
Dialogue: 0,0:16:12.74,0:16:15.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gila, chameleon.
Dialogue: 0,0:16:15.41,0:16:17.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata betulan ada.
Dialogue: 0,0:16:17.66,0:16:19.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Igarashi, kamu tidak apa-apa?
Dialogue: 0,0:16:21.96,0:16:23.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf.
Dialogue: 0,0:16:34.51,0:16:36.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi begitu.
Dialogue: 0,0:16:36.20,0:16:37.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tatapan tajam, ya.
Dialogue: 0,0:16:37.52,0:16:41.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu yang membuatku terkena stun tadi, ya?
Dialogue: 0,0:16:41.73,0:16:45.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, begitu Atobe memanggil namaku,
Dialogue: 0,0:16:45.11,0:16:47.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tubuhku langsung bisa bergerak lagi.
Dialogue: 0,0:16:47.19,0:16:48.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kenapa?
Dialogue: 0,0:16:48.32,0:16:50.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya Peningkatan Dukungan.
Dialogue: 0,0:16:50.65,0:16:53.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa itu efek dari kemampuan baruku.
Dialogue: 0,0:16:53.70,0:16:55.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, Suzuna.
Dialogue: 0,0:16:55.41,0:16:58.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi kamu bilang\Ntubuh semua orang bersinar.
Dialogue: 0,0:16:58.41,0:17:00.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang bagaimana?
Dialogue: 0,0:17:00.12,0:17:01.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar.
Dialogue: 0,0:17:07.46,0:17:11.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kilauan dari diriku dan Misaki makin kuat.
Dialogue: 0,0:17:11.18,0:17:13.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Kok, bisa?
Dialogue: 0,0:17:13.51,0:17:16.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misaki, Suzuna, coba lihat lisensi kalian.
Dialogue: 0,0:17:20.02,0:17:22.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pe-Pelepasan Semangat Tempur?
Dialogue: 0,0:17:22.48,0:17:24.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dukungan dari Arihito
Dialogue: 0,0:17:24.48,0:17:26.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}meningkatkan semangat tempur kita.
Dialogue: 0,0:17:26.85,0:17:28.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:17:28.44,0:17:30.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semacam stamina moral kita.
Dialogue: 0,0:17:30.95,0:17:35.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau disimpan, efek negatif ringan pun\Nbisa disembuhkan sendiri.
Dialogue: 0,0:17:35.20,0:17:37.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, apa maksudnya\NPelepasan Semangat Tempur?
Dialogue: 0,0:17:37.95,0:17:41.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu untuk mengaktifkan kemampuan\Nciri khas masing-masing.
Dialogue: 0,0:17:41.97,0:17:44.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin terisi karena\Npenguatan dukungan milikmu.
Dialogue: 0,0:17:44.67,0:17:46.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu,
Dialogue: 0,0:17:46.25,0:17:50.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tak kusangka moralnya terisi\Nhanya dengan bertarung sebanyak ini.
Dialogue: 0,0:17:50.53,0:17:53.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tak akan tahu kalau tidak dicoba,
Dialogue: 0,0:17:53.05,0:17:54.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi, kenapa tak dicoba saja?
Dialogue: 0,0:17:54.89,0:17:57.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Kak Kyouka boleh juga!
Dialogue: 0,0:17:57.93,0:17:59.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakekku juga pernah bilang,
Dialogue: 0,0:17:59.18,0:18:02.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Lebih baik menyesal karena mencoba\Ndaripada menyesal karena tidak."
Dialogue: 0,0:18:03.27,0:18:06.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arihito, apa aku boleh mencobanya?
Dialogue: 0,0:18:06.36,0:18:07.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:18:07.23,0:18:09.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena belum tahu\Nuntuk bertarung atau bukan,
Dialogue: 0,0:18:09.64,0:18:11.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}coba perlihatkan sekali dulu.
Dialogue: 0,0:18:11.24,0:18:12.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:18:18.08,0:18:21.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelepasan Semangat Tempur, Fortune Roll!
Dialogue: 0,0:18:22.25,0:18:24.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelepasan Semangat Tempur, Tsukuyomi!
Dialogue: 0,0:18:53.49,0:18:55.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini... jadi kombo?
Dialogue: 0,0:18:57.20,0:18:59.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suzu, ada apa?
Dialogue: 0,0:19:00.29,0:19:02.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}He-Hei, ada apa?
Dialogue: 0,0:19:02.75,0:19:03.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suzuna.
Dialogue: 0,0:19:05.42,0:19:07.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suzuna!
Dialogue: 0,0:19:07.88,0:19:10.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suzu, kamu tidak apa-apa?
Dialogue: 0,0:19:10.92,0:19:12.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:19:12.34,0:19:14.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sedikit melamun.
Dialogue: 0,0:19:15.26,0:19:16.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, itu.
Dialogue: 0,0:19:21.64,0:19:24.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aktivasi "Tsukuyomi" berhasil.
Dialogue: 0,0:19:24.61,0:19:26.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah itu efek
Dialogue: 0,0:19:26.52,0:19:28.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari Pelepasan Semangat Tempur-ku?
Dialogue: 0,0:19:28.98,0:19:31.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya begitu.
Dialogue: 0,0:19:38.99,0:19:42.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini lempengan batu\Nuntuk berteleportasi ke lantai lain.
Dialogue: 0,0:19:42.87,0:19:46.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelumnya pernah dipakai di labirin lain.
Dialogue: 0,0:19:46.29,0:19:48.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, rasanya aneh.
Dialogue: 0,0:19:48.05,0:19:49.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat Padang Fajar ini
Dialogue: 0,0:19:49.88,0:19:53.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harusnya hanya sampai lantai ketiga.
Dialogue: 0,0:19:54.26,0:19:57.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atobe, apa kita harus waspada?
Dialogue: 0,0:19:57.77,0:19:58.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau
Dialogue: 0,0:19:58.97,0:20:03.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sayang kalau penemuan berharga ini\Ndibiarkan begitu saja?
Dialogue: 0,0:20:03.72,0:20:05.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar.
Dialogue: 0,0:20:05.55,0:20:08.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga penasaran,\Ntapi firasatku menyuruh waspada.
Dialogue: 0,0:20:08.19,0:20:11.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abang, di saat begini sebaiknya langsung gas!
Dialogue: 0,0:20:15.03,0:20:17.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, duh.
Dialogue: 0,0:20:17.20,0:20:19.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misaki, cepat kemari.
Dialogue: 0,0:20:23.49,0:20:24.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat!
Dialogue: 0,0:20:30.13,0:20:33.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arihito, kalau langsung kembali\Ndengan teleportasi, harusnya aman.
Dialogue: 0,0:20:33.85,0:20:35.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku yang pergi sendirian.
Dialogue: 0,0:20:35.46,0:20:37.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku saja.
Dialogue: 0,0:20:37.01,0:20:38.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sekian lama aku tidak kembali,
Dialogue: 0,0:20:38.97,0:20:41.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}anggap saja aku tak bisa berteleportasi.
Dialogue: 0,0:20:41.36,0:20:42.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu...
Dialogue: 0,0:20:42.30,0:20:44.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bicara apa, Atobe?
Dialogue: 0,0:20:44.31,0:20:47.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seluruh party harus selamat bersama-sama.
Dialogue: 0,0:20:47.89,0:20:52.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu pergi, aku yakin Theresia juga\Nakan langsung ikut teleportasi.
Dialogue: 0,0:20:52.43,0:20:54.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, aku juga sama.
Dialogue: 0,0:20:54.29,0:20:55.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga.
Dialogue: 0,0:20:59.74,0:21:01.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya.
Dialogue: 0,0:21:02.03,0:21:03.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:21:03.52,0:21:05.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu kita bertemu Misaki,
Dialogue: 0,0:21:05.16,0:21:09.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ingin kalian langsung bersiap\Nmemakai Return Scroll.
Dialogue: 0,0:21:19.13,0:21:20.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita pergi.
Dialogue: 0,0:21:39.49,0:21:41.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takut!
Dialogue: 0,0:21:41.40,0:21:43.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Tenanglah, Misaki.
Dialogue: 0,0:21:45.20,0:21:48.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya Return Scroll\Ntidak bisa digunakan.
Dialogue: 0,0:21:48.79,0:21:52.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu artinya,\Ntak ada pilihan selain terus maju.
Dialogue: 0,0:21:52.25,0:21:55.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, rasanya menyeramkan.
Dialogue: 0,0:21:56.84,0:21:59.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuh yang kuat mungkin saja muncul.
Dialogue: 0,0:21:59.67,0:22:03.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku hanya perlu melindungi party-ku!
