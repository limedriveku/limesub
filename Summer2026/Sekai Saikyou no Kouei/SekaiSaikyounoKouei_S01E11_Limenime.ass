Dialogue: 0,0:00:26.55,0:00:28.47,sign,,0000,0000,0000,,DEMI HARPY A, B, C, MENGAKTIFKAN LAGU TIDUR
Dialogue: 0,0:01:17.39,0:01:28.03,sign,,0000,0000,0000,,GARDA BELAKANG TERKUAT DI DUNIA\N~PENJELAJAH PEMULA DI NEGERI LABIRIN~
Dialogue: 0,0:02:36.01,0:02:41.02,sign,,0000,0000,0000,,GODAAN UNTUK KEMBALI KE AWAL
Dialogue: 0,0:03:27.35,0:03:28.31,sign,,0000,0000,0000,,BERDIRI DI BELAKANG
Dialogue: 0,0:03:56.17,0:03:57.76,sign,,0000,0000,0000,,SAMBARAN DAHSYAT
Dialogue: 0,0:03:58.38,0:03:59.80,sign,,0000,0000,0000,,SERANGAN GANDA
Dialogue: 0,0:04:00.93,0:04:01.80,sign,,0000,0000,0000,,LEMPARAN GANDA
Dialogue: 0,0:04:02.68,0:04:03.76,sign,,0000,0000,0000,,TERJANGAN BUAS
Dialogue: 0,0:04:15.94,0:04:17.02,sign,,0000,0000,0000,,PEDANG KELOPAK
Dialogue: 0,0:04:25.66,0:04:26.91,sign,,0000,0000,0000,,STATUS "BONEKA" PADA SOPHIE, MIKHAIL,\NJAKE, DAN TAIRA TELAH DIHAPUS
Dialogue: 0,0:04:26.91,0:04:27.91,sign,,0000,0000,0000,,BERHASIL MENUMPAS\NTANAMAN MERAMBAT PENGENDALI
Dialogue: 0,0:08:27.99,0:08:38.00,sign,,0000,0000,0000,,GARDA BELAKANG TERKUAT DI DUNIA\N~PENJELAJAH PEMULA DI NEGERI LABIRIN~
Dialogue: 0,0:08:44.88,0:08:45.46,sign,,0000,0000,0000,,HASIL PENJELAJAHAN
Dialogue: 0,0:18:56.24,0:18:58.03,sign,,0000,0000,0000,,SITUASI SAAT INI, ARIADNE MEMINTA SUZUNA\NUNTUK MENGGUNAKAN PERANTARA ROH
Dialogue: 0,0:00:02.77,0:00:03.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga!
Dialogue: 0,0:00:05.15,0:00:07.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun yang kamu lakukan, sia-sia saja.
Dialogue: 0,0:00:08.82,0:00:10.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Datanglah, Demi Harpy!
Dialogue: 0,0:00:21.08,0:00:23.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian semua, bernyanyilah!
Dialogue: 0,0:00:39.69,0:00:41.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata ada cara seperti ini, ya.
Dialogue: 0,0:00:41.40,0:00:43.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, dengan begini...
Dialogue: 0,0:00:48.40,0:00:50.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa dia tidak tidur?
Dialogue: 0,0:00:50.53,0:00:52.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlengkapannya punya ketahanan?
Dialogue: 0,0:00:52.71,0:00:54.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, bukan.
Dialogue: 0,0:00:57.33,0:01:01.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dialah yang paling kuat\Ndan di bawah kendali langsung.
Dialogue: 0,0:02:44.52,0:02:47.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan langsung hanya akan melukainya.
Dialogue: 0,0:02:47.73,0:02:50.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus menghentikan gerakannya.
Dialogue: 0,0:02:50.37,0:02:54.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar orang-orang jahat,\Nbisanya cuma mengganggu.
Dialogue: 0,0:02:55.66,0:02:58.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku mengendalikan pria itu,
Dialogue: 0,0:02:58.07,0:03:01.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apakah kalian akan menuruti perkataanku?
Dialogue: 0,0:03:14.59,0:03:16.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku menghadap belakang,
Dialogue: 0,0:03:16.63,0:03:19.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pertahanan dukunganku akan hilang.
Dialogue: 0,0:03:19.02,0:03:20.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini?
Dialogue: 0,0:03:22.01,0:03:25.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua akarnya berasal dari punggungnya?
Dialogue: 0,0:03:25.85,0:03:27.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Back Stand!
Dialogue: 0,0:03:29.77,0:03:31.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini tubuh aslinya!
Dialogue: 0,0:03:37.24,0:03:38.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan!
Dialogue: 0,0:03:44.16,0:03:46.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, awas di belakang!
Dialogue: 0,0:03:51.21,0:03:53.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang saatnya, habisi dia!
Dialogue: 0,0:03:56.17,0:03:57.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rising Zapper!
Dialogue: 0,0:03:58.38,0:03:59.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Double Attack!
Dialogue: 0,0:04:06.06,0:04:06.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenalah!
Dialogue: 0,0:04:07.39,0:04:09.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lucky Seven!
Dialogue: 0,0:04:10.73,0:04:12.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Blossom Blade!
Dialogue: 0,0:04:28.40,0:04:30.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhasil juga.
Dialogue: 0,0:04:34.17,0:04:38.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah apa jadinya\Nkalau tak ada Demi Harpy.
Dialogue: 0,0:04:38.84,0:04:42.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atobe, kamu sudah memberi mereka nama?
Dialogue: 0,0:04:42.73,0:04:46.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng, aku tidak pandai memberi nama.
Dialogue: 0,0:04:46.22,0:04:50.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena dia perempuan bersayap,\Nbagaimana kalau Asuka?
Dialogue: 0,0:04:50.10,0:04:51.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asuka.
Dialogue: 0,0:04:51.73,0:04:54.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Nbagaimana kalau yang ini Yayoi?
Dialogue: 0,0:04:55.36,0:04:56.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang satunya lagi...
Dialogue: 0,0:04:56.95,0:04:59.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau Himiko?
Dialogue: 0,0:04:59.65,0:05:01.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya mereka setuju.
Dialogue: 0,0:05:01.49,0:05:03.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah diputuskan.
Dialogue: 0,0:05:03.03,0:05:05.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih kerja kerasnya.
Dialogue: 0,0:05:11.46,0:05:12.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:05:12.37,0:05:15.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kotak hitam drop langka.
Dialogue: 0,0:05:15.00,0:05:17.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata efek kemampuanku berhasil, ya.
Dialogue: 0,0:05:25.51,0:05:27.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kalian dari Polaris?
Dialogue: 0,0:05:27.57,0:05:29.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami dari party lain.
Dialogue: 0,0:05:29.57,0:05:32.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster yang menyerang Polaris\Nbaru saja kami kalahkan.
Dialogue: 0,0:05:32.76,0:05:33.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian siapa?
Dialogue: 0,0:05:33.94,0:05:38.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami dari Guild Saver,\Ndatang atas permintaan bantuan.
Dialogue: 0,0:05:40.19,0:05:43.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami berterima kasih karena telah\Nmenyelesaikan tugas ini.
Dialogue: 0,0:05:43.43,0:05:44.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, lain kali,
Dialogue: 0,0:05:44.78,0:05:49.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jangan hadapi monster level tinggi\Nmeski tujuannya untuk membantu.
Dialogue: 0,0:05:49.43,0:05:50.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berjanjilah.
Dialogue: 0,0:05:50.96,0:05:52.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal itu...
Dialogue: 0,0:05:52.83,0:05:54.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tergantung situasinya.
Dialogue: 0,0:05:54.17,0:05:56.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa berjanji.
Dialogue: 0,0:05:57.21,0:05:59.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan karena ini wilayahku.
Dialogue: 0,0:05:59.69,0:06:04.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami hanya ingin mengurangi\Njumlah penjelajah yang kehilangan nyawanya.
Dialogue: 0,0:06:04.13,0:06:06.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah yang kami pikirkan.
Dialogue: 0,0:06:06.54,0:06:08.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengingatnya.
Dialogue: 0,0:06:10.64,0:06:15.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kami yang membawa Polaris\Nke kota dengan teleportasi.
Dialogue: 0,0:06:16.27,0:06:20.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau, kami juga bisa\Nmembawa kalian sekalian.
Dialogue: 0,0:06:21.99,0:06:23.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong lakukan.
Dialogue: 0,0:06:24.57,0:06:26.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:06:26.37,0:06:29.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum memperkenalkan diri,\Nnamaku Atobe.
Dialogue: 0,0:06:29.85,0:06:31.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arihito Atobe.
Dialogue: 0,0:06:31.87,0:06:35.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namamu lebih terkenal\Ndari yang kamu bayangkan.
Dialogue: 0,0:06:37.96,0:06:40.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Seraphina Edelbert.
Dialogue: 0,0:06:48.18,0:06:52.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arihito, syukurlah orang-orang\Ndari Guild Saver datang.
Dialogue: 0,0:06:52.39,0:06:54.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, mereka sangat membantu.
Dialogue: 0,0:06:54.77,0:06:56.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan aku juga ingin keluar.
Dialogue: 0,0:06:56.81,0:07:00.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita benar-benar mendapatkan ini.
Dialogue: 0,0:07:01.57,0:07:05.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mungkin di Hutan Panggilan juga\Nada lantai tersembunyi?
Dialogue: 0,0:07:05.43,0:07:08.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kotak hitam bukanlah sesuatu\Nyang sengaja kita dapatkan.
Dialogue: 0,0:07:08.16,0:07:10.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau punya akses ke lantai tersembunyi,
Dialogue: 0,0:07:10.79,0:07:13.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebaiknya kita jangan sia-siakan itu.
Dialogue: 0,0:07:15.08,0:07:16.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar.
Dialogue: 0,0:07:16.21,0:07:19.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita buka dan kalau isinya kunci,\Nkita tuju lantai tersembunyi itu.
Dialogue: 0,0:07:20.88,0:07:23.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok, aku minta Falma untuk membukanya.
Dialogue: 0,0:07:23.67,0:07:26.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau melapor ke Louisa,
Dialogue: 0,0:07:26.51,0:07:28.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian istirahatlah di penginapan.
Dialogue: 0,0:07:28.34,0:07:29.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:07:35.39,0:07:36.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau ikut?
Dialogue: 0,0:07:38.05,0:07:40.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sebaiknya kamu istirahat saja.
Dialogue: 0,0:07:49.24,0:07:51.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan karena jabat tangan tadi?
Dialogue: 0,0:07:53.24,0:07:57.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Kamu kepikiran soal Seraphina?
Dialogue: 0,0:08:02.17,0:08:05.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal tadi rasanya tidak sopan\Nkalau tak jabat tangan.
Dialogue: 0,0:08:05.51,0:08:09.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami berdua juga tak punya\Nhubungan khusus apa pun, kok.
Dialogue: 0,0:08:16.85,0:08:20.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan pulang duluan,\Nkalian pergi berdua saja dulu.
Dialogue: 0,0:08:23.19,0:08:24.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:08:38.40,0:08:42.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sudah menyelamatkan duluan\Nsebelum Guild Saver datang?
Dialogue: 0,0:08:42.66,0:08:44.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kontribusi yang didapat sungguh luar biasa.
Dialogue: 0,0:08:45.46,0:08:48.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujian ini sebenarnya tidak diperlukan
Dialogue: 0,0:08:48.84,0:08:51.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena kamu sudah dinyatakan\Nlulus dengan mutlak.
Dialogue: 0,0:08:51.76,0:08:55.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali\Nkami tak bisa merasakan berkemah.
Dialogue: 0,0:08:55.17,0:08:58.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bisa menyelamatkan orang-orang Polaris\Nadalah hal terpenting.
Dialogue: 0,0:08:58.69,0:09:01.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imbalan penyelamatannya\Nakan dibayarkan nanti.
Dialogue: 0,0:09:03.69,0:09:07.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong gunakan saja\Nuntuk pengobatan Georg dan lainnya.
Dialogue: 0,0:09:07.03,0:09:08.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh?
Dialogue: 0,0:09:08.57,0:09:11.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggap saja bantuan dari satu penginapan.
Dialogue: 0,0:09:11.13,0:09:13.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin membantu sebisaku.
Dialogue: 0,0:09:13.70,0:09:17.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Atobe ingin semua penjelajah
Dialogue: 0,0:09:17.37,0:09:20.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa terus menjalankan aktivitasnya\Nselama mungkin, ya.
Dialogue: 0,0:09:20.92,0:09:23.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami mungkin saling bersaing,
Dialogue: 0,0:09:23.21,0:09:25.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kalau tujuan kami sama,
Dialogue: 0,0:09:25.42,0:09:27.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebisa mungkin aku ingin saling membantu.
Dialogue: 0,0:09:27.79,0:09:29.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah yang kupikirkan.
Dialogue: 0,0:09:29.13,0:09:30.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya mengerti.
Dialogue: 0,0:09:30.82,0:09:33.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk imbalannya, akan diurus\Nsesuai keinginan Anda.
Dialogue: 0,0:09:33.89,0:09:35.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:09:35.71,0:09:38.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menjenguk mereka,\Ntempatnya di mana?
Dialogue: 0,0:09:39.85,0:09:43.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang Polaris dibawa ke fasilitas medis
Dialogue: 0,0:09:43.27,0:09:45.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan sedang masa pemulihan.
Dialogue: 0,0:09:46.94,0:09:49.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arihito, kamu datang rupanya.
Dialogue: 0,0:09:49.74,0:09:51.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti berat, ya.
Dialogue: 0,0:09:51.31,0:09:53.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai kami datang lebih cepat...
Dialogue: 0,0:09:54.87,0:09:57.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak dikendalikan monster itu.
Dialogue: 0,0:09:57.45,0:10:00.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang terluka,\Ntapi masih bisa bertarung.
Dialogue: 0,0:10:00.87,0:10:03.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kakiku gemetaran.
Dialogue: 0,0:10:04.17,0:10:05.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konyol sekali, kan?
Dialogue: 0,0:10:06.96,0:10:11.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau pemimpinnya lemah begini,\Nmungkin sudah saatnya party ini bubar.
Dialogue: 0,0:10:11.76,0:10:14.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalian semua kembali dengan selamat.
Dialogue: 0,0:10:14.59,0:10:16.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian pasti bisa bangkit lagi.
Dialogue: 0,0:10:17.76,0:10:21.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata-kataku mungkin terkesan\Ntak bertanggung jawab.
Dialogue: 0,0:10:21.64,0:10:24.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, terima kasih\Nsudah menyemangati kami.
Dialogue: 0,0:10:25.10,0:10:28.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja, ada satu alasan lagi\Nkenapa kami harus bubar.
Dialogue: 0,0:10:29.98,0:10:32.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kamu menjenguk Sophie?
Dialogue: 0,0:10:32.43,0:10:35.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu yang ke sana, mungkin...
Dialogue: 0,0:10:36.62,0:10:37.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesadarannya tidak ada?
Dialogue: 0,0:10:37.99,0:10:39.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:10:39.17,0:10:43.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, anggota lain sedang tidur\Ndan sempat terbangun sesaat.
Dialogue: 0,0:10:43.46,0:10:48.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun hanya pasien ini yang saat\Nmatanya terbuka pun, tak memiliki kesadaran.
Dialogue: 0,0:10:48.09,0:10:50.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa bisa seperti itu?
Dialogue: 0,0:10:50.01,0:10:52.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kontak dengan kesadaran monster\Nsecara langsung
Dialogue: 0,0:10:52.34,0:10:55.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memberikan beban\Nyang sangat berat bagi manusia.
Dialogue: 0,0:10:55.44,0:10:58.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak juga yang tidak bisa\Npulih sepenuhnya.
Dialogue: 0,0:10:59.39,0:11:03.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah ada sesuatu yang bisa aku lakukan?
Dialogue: 0,0:11:03.56,0:11:06.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai penyembuh profesional pun,
Dialogue: 0,0:11:06.52,0:11:08.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami hanya bisa mempertahankan hidupnya.
Dialogue: 0,0:11:08.68,0:11:10.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di luar itu, kami hanya bisa berdoa.
Dialogue: 0,0:11:29.63,0:11:34.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tidak ada cara\Nuntuk mengembalikan dia seperti semula?
Dialogue: 0,0:11:35.22,0:11:36.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buntu.
Dialogue: 0,0:11:36.84,0:11:38.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau dibiarkan begini...
Dialogue: 0,0:11:41.89,0:11:42.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:11:42.81,0:11:45.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terlalu lama duduk dan melamun.
Dialogue: 0,0:11:45.11,0:11:46.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin karena kelelahan.
Dialogue: 0,0:12:04.83,0:12:06.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:12:06.29,0:12:09.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kita semua sudah mati.
Dialogue: 0,0:12:10.04,0:12:12.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau ada Atobe,\Nrasanya jadi tenang.
Dialogue: 0,0:12:14.55,0:12:18.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, silakan mendaftar\Nsebagai penjelajah.
Dialogue: 0,0:12:18.13,0:12:20.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan tulis pekerjaan yang diinginkan.
Dialogue: 0,0:12:20.18,0:12:23.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi seingatku, aku sedang menjenguk orang.
Dialogue: 0,0:12:25.47,0:12:29.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena baru saja bereinkarnasi,\Nmungkin ingatan Anda jadi kacau.
Dialogue: 0,0:12:29.69,0:12:32.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Atobe kebingungan,
Dialogue: 0,0:12:32.11,0:12:34.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}biar aku saja yang menentukan pekerjaanmu.
Dialogue: 0,0:12:37.70,0:12:39.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat, Tuan Atobe.
Dialogue: 0,0:12:39.82,0:12:41.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permohonan Anda telah diterima.
Dialogue: 0,0:12:41.68,0:12:45.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda telah menjadi pahlawan\Ndi Negeri Labirin ini.
Dialogue: 0,0:12:50.62,0:12:56.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, Atobe bisa memulai hidup baru\Nsebagai pahlawan di sini, ya.
Dialogue: 0,0:12:57.46,0:12:59.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bentuklah party bersamaku.
Dialogue: 0,0:12:59.55,0:13:02.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bersama pahlawan,\Ntak ada lagi yang perlu ditakuti.
Dialogue: 0,0:13:02.43,0:13:04.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau ikut.
Dialogue: 0,0:13:04.35,0:13:07.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beruntung sekali bisa bertemu pahlawan.
Dialogue: 0,0:13:07.10,0:13:09.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jadikan aku bagian dari party.
Dialogue: 0,0:13:09.27,0:13:13.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Tapi, kalau mendadak seperti itu...
Dialogue: 0,0:13:13.15,0:13:14.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja boleh.
Dialogue: 0,0:13:14.86,0:13:17.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang kita bentuk party pahlawan.
Dialogue: 0,0:13:17.86,0:13:19.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya, senang rasanya.
Dialogue: 0,0:13:19.86,0:13:21.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:13:21.82,0:13:25.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kalau itu membuat kalian senang...
Dialogue: 0,0:13:25.99,0:13:27.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah!
Dialogue: 0,0:13:27.08,0:13:28.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pahlawan memang hebat.
Dialogue: 0,0:13:28.62,0:13:30.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan pahlawan memang luar biasa.
Dialogue: 0,0:13:30.87,0:13:32.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat kagum.
Dialogue: 0,0:13:32.54,0:13:35.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abang pahlawan sangat keren!
Dialogue: 0,0:13:35.92,0:13:38.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi pahlawan?
Dialogue: 0,0:13:38.30,0:13:41.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlahir kembali ternyata boleh juga.
Dialogue: 0,0:13:50.64,0:13:52.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tolong mereka!
Dialogue: 0,0:13:52.34,0:13:53.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk apa?
Dialogue: 0,0:13:54.15,0:13:57.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa menolong orang yang tidak dikenal?
Dialogue: 0,0:13:57.02,0:14:00.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tidak menolong,\Ntak akan ada yang menyalahkanmu, Arihito.
Dialogue: 0,0:14:01.40,0:14:03.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak bergerak, mereka bisa...
Dialogue: 0,0:14:03.61,0:14:06.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya Abang harus bertanggung jawab
Dialogue: 0,0:14:06.08,0:14:08.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atas kematian orang lain?
Dialogue: 0,0:14:08.29,0:14:10.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kan?
Dialogue: 0,0:14:10.08,0:14:12.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalani saja dengan lebih santai.
Dialogue: 0,0:14:12.33,0:14:13.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:14:13.46,0:14:16.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal tak ada yang minta ditolong.
Dialogue: 0,0:14:18.63,0:14:20.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:14:20.80,0:14:25.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mempertaruhkan nyawa untuk hal\Nyang tak diminta adalah konyol.
Dialogue: 0,0:14:25.91,0:14:28.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam saja sudah cukup.
Dialogue: 0,0:14:36.98,0:14:37.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:14:39.48,0:14:40.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:14:41.94,0:14:43.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:14:44.15,0:14:45.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memang...
Dialogue: 0,0:14:47.49,0:14:48.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ingin menolongnya.
Dialogue: 0,0:14:49.08,0:14:50.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:14:51.41,0:14:53.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ingin menolongnya!
Dialogue: 0,0:14:58.00,0:15:02.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pikir kamu lebih berguna dari wanita ini,\Nmakanya aku ingin pindah.
Dialogue: 0,0:15:02.38,0:15:05.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si pengendali itu?\NKamu masih hidup?
Dialogue: 0,0:15:05.09,0:15:07.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah dunia batinku.
Dialogue: 0,0:15:07.05,0:15:09.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tak bisa keluar kecuali mengalahkanku.
Dialogue: 0,0:15:09.81,0:15:11.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan kamu tak akan mampu melakukannya.
Dialogue: 0,0:15:14.64,0:15:19.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang bodoh yang menolak dikendalikan\Nmeski diberi kebahagiaan.
Dialogue: 0,0:15:19.83,0:15:21.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuhancurkan saja kamu.
Dialogue: 0,0:15:22.61,0:15:25.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau batinmu hancur,\Ntubuh fisikmu juga akan mati.
Dialogue: 0,0:15:25.61,0:15:28.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesempatan terakhir, tunduklah padaku.
Dialogue: 0,0:15:28.70,0:15:30.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menolak!
Dialogue: 0,0:15:30.41,0:15:32.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, matilah!
Dialogue: 0,0:15:37.83,0:15:40.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia? Bagaimana kamu bisa ke sini?
Dialogue: 0,0:15:40.75,0:15:42.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Budak?
Dialogue: 0,0:15:42.17,0:15:45.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menelusuri ikatan dari tanda itu?
Dialogue: 0,0:15:45.17,0:15:48.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu datang menyelamatkanku?
Dialogue: 0,0:15:48.64,0:15:50.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sia-sia saja.
Dialogue: 0,0:15:50.35,0:15:52.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tak bisa bawa senjata ke sini.
Dialogue: 0,0:15:52.65,0:15:55.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tak akan mungkin menang!
Dialogue: 0,0:15:56.73,0:15:58.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia, aku beri dukungan!
Dialogue: 0,0:15:59.65,0:16:00.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bisa melakukannya!
Dialogue: 0,0:16:00.65,0:16:02.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan Dukungan!
Dialogue: 0,0:16:02.15,0:16:03.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lakukan, Theresia!
Dialogue: 0,0:16:24.50,0:16:26.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia?
Dialogue: 0,0:16:26.99,0:16:29.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.\NBerkatmu aku selamat.
Dialogue: 0,0:16:33.68,0:16:36.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah membuatmu khawatir.
Dialogue: 0,0:16:38.03,0:16:42.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku salah mengira\Nbisa melindungi semuanya sendiri.
Dialogue: 0,0:16:43.69,0:16:49.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kelas pekerjaanku baru bisa berguna\Nsaat ada seseorang di depanku.
Dialogue: 0,0:16:58.79,0:17:00.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Drop item?
Dialogue: 0,0:17:00.28,0:17:02.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, ini benih makhluk itu.
Dialogue: 0,0:17:02.75,0:17:04.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata dia masih hidup.
Dialogue: 0,0:17:05.50,0:17:06.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu!
Dialogue: 0,0:17:06.96,0:17:10.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa dijinakkan,\Nini bisa jadi kekuatan tempur.
Dialogue: 0,0:17:10.08,0:17:12.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bawa ke peternakan monster.
Dialogue: 0,0:17:19.52,0:17:21.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sophie?
Dialogue: 0,0:17:22.30,0:17:26.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bermimpi buruk.
Dialogue: 0,0:17:27.03,0:17:30.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian yang mengakhirinya, ya.
Dialogue: 0,0:17:30.78,0:17:32.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:17:33.97,0:17:35.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kutukan setengah manusia.
Dialogue: 0,0:17:36.16,0:17:38.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa itu...
Dialogue: 0,0:17:38.52,0:17:40.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar-benar...
Dialogue: 0,0:17:45.13,0:17:47.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi dia seperti mau bicara sesuatu, kan?
Dialogue: 0,0:17:47.80,0:17:52.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, tadi kamu tidak memakai topeng.
Dialogue: 0,0:17:53.22,0:17:55.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku di belakang, jadi tidak kelihatan.
Dialogue: 0,0:17:55.85,0:17:58.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi Sophie pasti melihatnya.
Dialogue: 0,0:17:58.01,0:18:00.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dia ingin membicarakan itu?
Dialogue: 0,0:18:01.73,0:18:03.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ingin melihatnya.
Dialogue: 0,0:18:03.65,0:18:07.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, kamu mungkin akan kerepotan.
Dialogue: 0,0:18:11.82,0:18:15.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, mau sedekat apa pun,\Nwajahmu tidak akan kelihatan.
Dialogue: 0,0:18:21.58,0:18:23.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka monsternya masih hidup.
Dialogue: 0,0:18:23.95,0:18:25.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kalian baik-baik saja.
Dialogue: 0,0:18:25.96,0:18:29.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sempat menegangkan,\Ntapi untungnya bisa kami akhiri.
Dialogue: 0,0:18:29.46,0:18:32.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya, kami juga dapat sesuatu.
Dialogue: 0,0:18:32.34,0:18:34.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga saja bisa dijinakkan.
Dialogue: 0,0:18:34.38,0:18:36.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku coba dulu meskipun tidak berhasil.
Dialogue: 0,0:18:36.93,0:18:39.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melissa, soal Fear Treant\Nharusnya sudah selesai, kan?
Dialogue: 0,0:18:39.77,0:18:40.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah selesai.
Dialogue: 0,0:18:40.85,0:18:43.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk perlengkapan kayu, aku bisa buatkan.
Dialogue: 0,0:18:43.71,0:18:46.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langsung dijual pun harganya cukup tinggi.
Dialogue: 0,0:18:46.61,0:18:48.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti aku minta taksiran harganya.
Dialogue: 0,0:18:48.32,0:18:50.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, tolong lakukan.
Dialogue: 0,0:18:52.15,0:18:53.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara apa itu?
Dialogue: 0,0:18:54.11,0:18:56.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dari lisensiku.
Dialogue: 0,0:18:58.03,0:19:00.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pesan dari Ariadne?
Dialogue: 0,0:19:00.64,0:19:04.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dia ingin menyampaikan\Nsesuatu pada kita.
Dialogue: 0,0:19:06.50,0:19:09.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suzuna, bisa gunakan Perantara Roh?
Dialogue: 0,0:19:09.69,0:19:11.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa.
Dialogue: 0,0:19:12.34,0:19:14.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turunlah ke wadah ini
Dialogue: 0,0:19:14.51,0:19:17.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan sampaikan suaramu kepada dunia.
Dialogue: 0,0:19:22.47,0:19:25.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kamu Garda Belakang?
Dialogue: 0,0:19:25.31,0:19:27.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, ini aku.
Dialogue: 0,0:19:27.19,0:19:29.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah membantu\Nsaat serbuan monster.
Dialogue: 0,0:19:29.90,0:19:34.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memberikan perlindungan kepada pengikut\Nadalah hukum dewa.
Dialogue: 0,0:19:34.01,0:19:35.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak perlu berterima kasih.
Dialogue: 0,0:19:35.49,0:19:38.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu?\NTapi, kami benar-benar terbantu.
Dialogue: 0,0:19:38.86,0:19:42.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, apakah ada sesuatu\Nyang ingin kamu sampaikan?
Dialogue: 0,0:19:42.33,0:19:45.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku datang untuk memperingatkan Black Box
Dialogue: 0,0:19:45.79,0:19:47.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang baru saja kalian dapatkan.
Dialogue: 0,0:19:48.79,0:19:50.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya ini?
Dialogue: 0,0:19:50.34,0:19:52.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah ada sesuatu yang berbahaya?
Dialogue: 0,0:19:52.53,0:19:56.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Black Box tersebut berisi Armament.
Dialogue: 0,0:19:56.59,0:19:58.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Armament?
Dialogue: 0,0:19:58.15,0:20:01.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebutan dari Armored Attachment.
Dialogue: 0,0:20:01.39,0:20:05.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagian dari tubuhku,\Ndengan kata lain Artefak Suci.
Dialogue: 0,0:20:05.46,0:20:08.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mendapatkannya,\Nkemampuanku akan meningkat
Dialogue: 0,0:20:08.69,0:20:11.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan waktuku keluar dari lapisan ini\Nakan makin dekat.
Dialogue: 0,0:20:11.61,0:20:13.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kita harus segera membukanya.
Dialogue: 0,0:20:13.98,0:20:17.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, Artefak Suci akan melakukan penolakan
Dialogue: 0,0:20:17.49,0:20:20.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan melakukan perlawanan diri.
Dialogue: 0,0:20:20.08,0:20:21.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang mencoba mendapatkannya
Dialogue: 0,0:20:21.99,0:20:24.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin akan kehilangan nyawa.
Dialogue: 0,0:20:24.83,0:20:27.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahaya juga.
Dialogue: 0,0:20:27.21,0:20:30.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah Guard Arm milikmu\Ntak bisa menahannya?
Dialogue: 0,0:20:30.45,0:20:35.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau syaratnya terpenuhi,\Nmungkin aku bisa menahannya.
Dialogue: 0,0:20:37.22,0:20:39.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin membuka kotak ini.
Dialogue: 0,0:20:39.49,0:20:42.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski harus mempertaruhkan nyawa.
Dialogue: 0,0:20:43.31,0:20:46.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu menjadi lebih kuat\Ndan bisa keluar,
Dialogue: 0,0:20:46.72,0:20:49.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu bisa jadi kekuatan untuk naik ke atas.
Dialogue: 0,0:20:49.20,0:20:53.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan untuk mengembalikan Theresia\Ndan menolong teman Elitia.
Dialogue: 0,0:20:54.11,0:20:57.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin pasti akan berguna\Nuntuk menolong yang lain juga.
Dialogue: 0,0:20:57.74,0:21:00.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja, aku tak bisa sendirian.
Dialogue: 0,0:21:01.41,0:21:04.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti akan melindungi kalian,
Dialogue: 0,0:21:04.09,0:21:05.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi lakukanlah bersamaku.
Dialogue: 0,0:21:06.41,0:21:10.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa melakukannya sendirian\Njuga berlaku untuk semuanya.
Dialogue: 0,0:21:10.25,0:21:12.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita saling membutuhkan.
Dialogue: 0,0:21:12.71,0:21:14.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miko ini juga setuju.
Dialogue: 0,0:21:14.97,0:21:19.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kotaknya terbuka, aku juga akan\Nmemberikan perlindungan sebisaku.
Dialogue: 0,0:21:19.42,0:21:21.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku nantikan itu.
Dialogue: 0,0:21:21.65,0:21:23.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:21:25.64,0:21:26.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya.
Dialogue: 0,0:21:30.06,0:21:31.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:21:35.44,0:21:37.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ayo pergi.
Dialogue: 0,0:21:39.24,0:21:41.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Georg? Yang lain juga?
Dialogue: 0,0:21:41.24,0:21:43.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuhmu sudah baik-baik saja?
Dialogue: 0,0:21:43.07,0:21:44.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:21:44.99,0:21:47.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar-benar sudah membantu.
Dialogue: 0,0:21:47.79,0:21:50.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang akan kalian lakukan?
Dialogue: 0,0:21:50.04,0:21:51.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan lanjut.
Dialogue: 0,0:21:51.79,0:21:55.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik sebagai penjelajah maupun party.
Dialogue: 0,0:21:55.63,0:21:57.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua ini berkatmu, Arihito.
Dialogue: 0,0:21:57.62,0:22:01.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah seperti samurai\Nyang aku kagumi.
Dialogue: 0,0:22:01.09,0:22:04.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat dalam bertarung\Ndan jiwamu juga kuat.
Dialogue: 0,0:22:05.93,0:22:09.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku adalah Garda Belakang.
