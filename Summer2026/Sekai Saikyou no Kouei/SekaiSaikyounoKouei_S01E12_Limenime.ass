Dialogue: 0,0:02:29.42,0:02:40.06,sign,,0000,0000,0000,,GARDA BELAKANG TERKUAT DI DUNIA\N~PENJELAJAH PEMULA DI NEGERI LABIRIN
Dialogue: 0,0:03:48.00,0:03:53.00,sign,,0000,0000,0000,,MENUJU NEGERI LABIRIN SELANJUTNYA
Dialogue: 0,0:11:59.16,0:12:00.78,sign,,0000,0000,0000,,LOKASI SAAT INI: AREA YANG BELUM DIJAMAH
Dialogue: 0,0:12:38.28,0:12:38.99,sign,,0000,0000,0000,,HOYOKU YANG MENARI DI PADANG SALJU\NLV. 8. KEBINGUNGAN, KEBAL ES
Dialogue: 0,0:14:16.96,0:14:19.00,sign,,0000,0000,0000,,GARDA BELAKANG TERKUAT DI DUNIA\N~PENJELAJAH PEMULA DI NEGERI LABIRIN~
Dialogue: 0,0:14:23.59,0:14:24.72,sign,,0000,0000,0000,,GARDA BELAKANG TERKUAT DI DUNIA\N~PENJELAJAH PEMULA DI NEGERI LABIRIN~
Dialogue: 0,0:14:42.03,0:14:42.78,sign,,0000,0000,0000,,MENDAPATKAN DUA BATU PEMBEKU
Dialogue: 0,0:14:42.78,0:14:44.64,sign,,0000,0000,0000,,MENDAPATKAN SATU KRISTAL SALJU
Dialogue: 0,0:14:44.64,0:14:48.32,sign,,0000,0000,0000,,MENDAPATKAN BULU PUTIH HOYOKU
Dialogue: 0,0:20:55.73,0:21:00.03,sign,,0000,0000,0000,,IZIN MEMASUKI POS PEMERIKSAAN DISTRIK 7
Dialogue: 0,0:22:05.51,0:22:09.98,sign,,0000,0000,0000,,GARDA BELAKANG TERKUAT DI DUNIA\N~PENJELAJAH PEMULA DI NEGERI LABIRIN~
Dialogue: 0,0:00:02.11,0:00:03.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Atobe.
Dialogue: 0,0:00:03.73,0:00:06.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan Anda akan pergi ke Distrik 7?
Dialogue: 0,0:00:06.82,0:00:11.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berniat secepatnya ke sana\Nsetelah meningkatkan perlengkapan kami.
Dialogue: 0,0:00:11.31,0:00:12.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:00:12.87,0:00:17.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan pindah distrik,\Nkami akan berpisah denganmu, ya.
Dialogue: 0,0:00:17.08,0:00:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya jadi sepi.
Dialogue: 0,0:00:20.63,0:00:25.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ini jika Tuan Atobe berkenan,
Dialogue: 0,0:00:25.17,0:00:29.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}meski sudah naik ke Distrik 7, apa boleh\Ntetap saya yang menangani Tuan Atobe?
Dialogue: 0,0:00:29.97,0:00:32.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya bisa?
Dialogue: 0,0:00:33.14,0:00:37.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua pegawai Guild\Nbisa dipindah ke area lain.
Dialogue: 0,0:00:37.10,0:00:38.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, dengan senang hati.
Dialogue: 0,0:00:38.87,0:00:42.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon kerja samanya lagi, Louisa.
Dialogue: 0,0:00:42.77,0:00:43.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:00:46.07,0:00:47.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan.
Dialogue: 0,0:00:49.65,0:00:51.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seraphina?
Dialogue: 0,0:00:51.24,0:00:55.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menyampaikan terima kasih lagi\Natas penyelamatan tempo hari.
Dialogue: 0,0:00:55.84,0:00:57.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin memberikan
Dialogue: 0,0:00:58.33,0:01:00.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hadiah ini pada party kalian.
Dialogue: 0,0:01:00.21,0:01:01.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulau Fantasi?
Dialogue: 0,0:01:01.96,0:01:03.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, luar biasa!
Dialogue: 0,0:01:03.88,0:01:07.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulau Fantasi adalah salah satu\Ntempat liburan yang dikelola Guild.
Dialogue: 0,0:01:07.71,0:01:09.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebuah labirin berbentuk pulau kecil.
Dialogue: 0,0:01:09.92,0:01:11.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster-monster yang hidup di sana
Dialogue: 0,0:01:11.68,0:01:15.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dilatih dan dipelihara\Ndi beberapa tempat di pulau tersebut.
Dialogue: 0,0:01:16.76,0:01:18.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena tempatnya begitu indah,
Dialogue: 0,0:01:18.89,0:01:21.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin bisa\Nuntuk menyegarkan pikiran kalian.
Dialogue: 0,0:01:21.73,0:01:24.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada masa berlakunya.
Dialogue: 0,0:01:24.01,0:01:26.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiketnya bisa dipakai kapan pun kalian mau.
Dialogue: 0,0:01:26.69,0:01:29.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan pun kami mau, ya.
Dialogue: 0,0:01:29.90,0:01:31.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dipikir-pikir,
Dialogue: 0,0:01:31.11,0:01:34.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sejak ke Negeri Labirin,\Nkami belum istirahat satu hari pun.
Dialogue: 0,0:01:35.66,0:01:39.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kalian sungguh\Nbelum istirahat satu hari pun?
Dialogue: 0,0:01:39.50,0:01:40.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:01:40.71,0:01:42.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atobe Arihito.
Dialogue: 0,0:01:43.04,0:01:46.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham setiap party\Npunya urusannya masing-masing.
Dialogue: 0,0:01:46.66,0:01:47.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:01:49.34,0:01:52.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bekerja terus tanpa henti itu
Dialogue: 0,0:01:52.09,0:01:55.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya akan menurunkan stamina\Ndan kekuatan fisik anggota party.
Dialogue: 0,0:01:55.85,0:01:59.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar bagi seorang penjelajah adalah\Nmakan yang baik, istirahat yang cukup,
Dialogue: 0,0:01:59.47,0:02:01.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan melakukan persiapan dengan matang.
Dialogue: 0,0:02:01.31,0:02:04.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terutama pendatang baru seperti kalian.
Dialogue: 0,0:02:04.31,0:02:06.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ambillah libur yang cukup.
Dialogue: 0,0:02:06.69,0:02:07.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:02:07.86,0:02:10.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang lain mungkin sudah lelah.
Dialogue: 0,0:02:12.53,0:02:13.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:02:13.65,0:02:16.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku terima tawarannya.
Dialogue: 0,0:03:57.13,0:03:58.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:03:58.59,0:04:01.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa! Luar biasa!
Dialogue: 0,0:04:01.80,0:04:05.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari tadi yang bisa aku ucapkan\Ncuma luar biasa!
Dialogue: 0,0:04:05.02,0:04:06.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar sekali.
Dialogue: 0,0:04:06.73,0:04:08.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena disebut tempat liburan,
Dialogue: 0,0:04:08.48,0:04:12.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku membayangkan tempatnya\Ntenang seperti kawasan vila.
Dialogue: 0,0:04:15.32,0:04:17.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tidak jadi masalah
Dialogue: 0,0:04:17.86,0:04:20.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menyewa tempat seindah ini\Nhanya untuk kita-kita?
Dialogue: 0,0:04:20.99,0:04:23.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya seperti selebritas.
Dialogue: 0,0:04:24.20,0:04:26.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa, ya!
Dialogue: 0,0:04:26.04,0:04:27.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:04:27.66,0:04:29.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arihito, ada apa?
Dialogue: 0,0:04:29.62,0:04:31.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku hanya...
Dialogue: 0,0:04:31.79,0:04:34.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur, aku bingung\Nmau melihat ke arah mana.
Dialogue: 0,0:04:38.01,0:04:40.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar tempat yang indah, ya.
Dialogue: 0,0:04:40.76,0:04:43.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku akan\Nbersantai sejenak di sini.
Dialogue: 0,0:04:43.77,0:04:46.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ada jus tropis juga, lo.
Dialogue: 0,0:04:46.85,0:04:48.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jus.
Dialogue: 0,0:04:48.19,0:04:49.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau.
Dialogue: 0,0:04:49.44,0:04:51.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Kyouka juga mau?
Dialogue: 0,0:04:51.45,0:04:55.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, sebenarnya,\Nada tempat yang ingin aku datangi.
Dialogue: 0,0:04:55.89,0:04:59.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atobe, apa kamu mau menemaniku?
Dialogue: 0,0:05:00.82,0:05:03.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tempat yang ingin kamu datangi?
Dialogue: 0,0:05:03.93,0:05:05.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, ini tempatnya.
Dialogue: 0,0:05:05.74,0:05:08.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya ini tempat pemeliharaan Coral Vigo.
Dialogue: 0,0:05:10.00,0:05:11.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atobe, lihat itu!
Dialogue: 0,0:05:12.33,0:05:14.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu Coral Vigo.
Dialogue: 0,0:05:14.67,0:05:16.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti boneka, ya.
Dialogue: 0,0:05:16.88,0:05:18.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:05:18.21,0:05:20.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, mereka tetap monster, kan?
Dialogue: 0,0:05:20.47,0:05:22.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izinkan aku menjelaskan!
Dialogue: 0,0:05:22.39,0:05:24.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coral Vigo ini
Dialogue: 0,0:05:24.18,0:05:27.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}monster yang hidupnya sama seperti\Nmakhluk yang disebut penguin.
Dialogue: 0,0:05:27.68,0:05:29.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama tidak membuatnya kaget,
Dialogue: 0,0:05:29.56,0:05:33.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka tak akan tiba-tiba\Nmengamuk atau menyerang.
Dialogue: 0,0:05:33.85,0:05:35.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditambah lagi...
Dialogue: 0,0:05:35.40,0:05:38.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian bisa memberi makan\Nsambil berinteraksi langsung.
Dialogue: 0,0:05:38.44,0:05:39.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau mencoba?
Dialogue: 0,0:05:42.28,0:05:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita coba.
Dialogue: 0,0:05:52.46,0:05:54.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Imut banget!
Dialogue: 0,0:05:54.47,0:05:58.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanan yang mereka sukai saat ini\Nadalah Sword Trout.
Dialogue: 0,0:05:58.01,0:06:00.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, udang, kepiting,\Ndan rumput laut pun mereka suka.
Dialogue: 0,0:06:00.63,0:06:03.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, sesuai asal-usul namanya,
Dialogue: 0,0:06:03.38,0:06:06.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka juga kadang makan\Nbenda keras seperti karang.
Dialogue: 0,0:06:07.03,0:06:10.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah dengar kalau penguin\Nmemang makan batu.
Dialogue: 0,0:06:10.41,0:06:12.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kenapa?
Dialogue: 0,0:06:12.06,0:06:13.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada berbagai teori soal itu.
Dialogue: 0,0:06:13.77,0:06:17.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Coral Vigo sendiri punya alasan\Nkenapa makan benda keras.
Dialogue: 0,0:06:17.32,0:06:19.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkadang, mereka menghasilkan
Dialogue: 0,0:06:19.78,0:06:23.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}batu sihir di dalam tubuh mereka\Ndan mengeluarkannya seperti telur.
Dialogue: 0,0:06:23.49,0:06:25.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat sekali, ya.
Dialogue: 0,0:06:25.82,0:06:28.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah batu sihirnya sama semua?
Dialogue: 0,0:06:28.49,0:06:30.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di tempat pemeliharaan ini,
Dialogue: 0,0:06:30.49,0:06:33.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hampir semua yang dihasilkan\Nadalah Batu Laut.
Dialogue: 0,0:06:33.96,0:06:35.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imut banget!
Dialogue: 0,0:06:35.50,0:06:40.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah Coral Vigo bisa dipelihara\Noleh penjelajah biasa?
Dialogue: 0,0:06:40.21,0:06:42.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak yang menanyakan itu,
Dialogue: 0,0:06:42.59,0:06:46.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ada syarat tertentu\Nuntuk memelihara Coral Vigo.
Dialogue: 0,0:06:46.39,0:06:47.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syarat tertentu?
Dialogue: 0,0:06:47.68,0:06:50.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus bertemu Coral Vigo bernama
Dialogue: 0,0:06:50.75,0:06:53.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mendapatkan item tertentu.
Dialogue: 0,0:06:53.64,0:06:55.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang bernama?
Dialogue: 0,0:06:55.44,0:06:59.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja tidak mudah\Nuntuk bertemu dengan yang bernama.
Dialogue: 0,0:06:59.11,0:07:01.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun kalau dipikir kembali,
Dialogue: 0,0:07:01.44,0:07:04.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kemunculan terakhir Coral Vigo bernama
Dialogue: 0,0:07:04.07,0:07:06.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di pulau ini terjadinya sudah sangat lama.
Dialogue: 0,0:07:07.57,0:07:09.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin karena hal itu juga
Dialogue: 0,0:07:09.24,0:07:12.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka seolah tampak gelisah.
Dialogue: 0,0:07:12.70,0:07:15.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya, terima kasih banyak.
Dialogue: 0,0:07:15.76,0:07:19.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau seperti itu, aku jadi menantikan\Nkesempatan untuk berkunjung lagi.
Dialogue: 0,0:07:19.42,0:07:20.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap.
Dialogue: 0,0:07:20.43,0:07:23.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan nikmati waktu bersantai kalian.
Dialogue: 0,0:07:24.22,0:07:27.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, bikin adem.
Dialogue: 0,0:07:28.01,0:07:30.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku rasa dia sudah dewasa,
Dialogue: 0,0:07:30.30,0:07:33.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi pas bilang "piyo-piyo" itu lucu banget.
Dialogue: 0,0:07:33.53,0:07:37.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ketemu di labirin,\Naku tak akan tega melawannya.
Dialogue: 0,0:07:37.73,0:07:41.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melihat monster seperti itu,\Nrasanya menenangkan, ya.
Dialogue: 0,0:07:41.00,0:07:45.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya monster yang kita temui\Nselalu menakutkan.
Dialogue: 0,0:07:45.19,0:07:46.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:07:46.99,0:07:49.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada monster yang mengerikan,\Nada juga yang tangguh.
Dialogue: 0,0:07:50.38,0:07:51.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu,
Dialogue: 0,0:07:51.74,0:07:55.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu selalu membantu kami.
Dialogue: 0,0:07:55.16,0:07:56.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kok.
Dialogue: 0,0:07:56.92,0:07:59.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga selalu ditolong.
Dialogue: 0,0:07:59.17,0:08:01.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu selalu bilang begitu,
Dialogue: 0,0:08:01.88,0:08:03.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi jujur, aku
Dialogue: 0,0:08:04.09,0:08:06.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa bersama denganmu saja...
Dialogue: 0,0:08:06.20,0:08:06.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:08:08.80,0:08:11.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia tidak ada?
Dialogue: 0,0:08:15.10,0:08:18.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abang, Kyouka, selamat datang kembali!
Dialogue: 0,0:08:20.69,0:08:21.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misaki!
Dialogue: 0,0:08:25.99,0:08:27.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kamu lakukan?
Dialogue: 0,0:08:27.45,0:08:28.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga sama!
Dialogue: 0,0:08:28.78,0:08:32.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua,\Nlagi liburan jangan malah bertengkar!
Dialogue: 0,0:08:32.15,0:08:33.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, Suzuna.
Dialogue: 0,0:08:33.37,0:08:35.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesekali Misaki harus diceramahi.
Dialogue: 0,0:08:35.58,0:08:39.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Aku tidak salah, kok.\NAku tidak sengaja.
Dialogue: 0,0:08:39.28,0:08:40.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana Theresia?
Dialogue: 0,0:08:40.91,0:08:43.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi aku lihat dia jalan ke arah hutan.
Dialogue: 0,0:08:43.96,0:08:45.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sendirian?
Dialogue: 0,0:08:55.41,0:08:58.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajahmu kelihatan seperti kesepian.
Dialogue: 0,0:08:58.31,0:09:00.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak, kok!
Dialogue: 0,0:09:00.06,0:09:03.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi aku melihat ke arah hutan itu, eng...
Dialogue: 0,0:09:03.36,0:09:04.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:09:05.94,0:09:08.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita coba ke sana?
Dialogue: 0,0:09:08.66,0:09:12.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka jalan-jalan di hutan.
Dialogue: 0,0:09:15.87,0:09:18.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalannya hanya sampai di sini, ya.
Dialogue: 0,0:09:22.79,0:09:23.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia!
Dialogue: 0,0:09:28.96,0:09:30.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia.
Dialogue: 0,0:09:35.14,0:09:36.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:09:37.93,0:09:42.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu menemukan sesuatu\Ndi dalam mata air?
Dialogue: 0,0:09:53.49,0:09:55.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih menyelam ke dalam?
Dialogue: 0,0:09:56.02,0:09:57.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam banget.
Dialogue: 0,0:09:57.87,0:10:01.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku tak bisa membiarkan\NTheresia sendirian.
Dialogue: 0,0:10:02.28,0:10:03.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Napasku...
Dialogue: 0,0:10:05.21,0:10:07.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, napasku...
Dialogue: 0,0:10:09.55,0:10:11.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abang, bertahanlah!
Dialogue: 0,0:10:11.30,0:10:12.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atobe!
Dialogue: 0,0:10:12.47,0:10:14.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Atobe!
Dialogue: 0,0:10:14.43,0:10:16.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arihito!
Dialogue: 0,0:10:16.03,0:10:18.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mohon, sadarlah!
Dialogue: 0,0:10:21.60,0:10:23.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:10:23.02,0:10:25.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun, aku sampai takut\Nkalau kamu kenapa-kenapa.
Dialogue: 0,0:10:25.98,0:10:27.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar sekali.
Dialogue: 0,0:10:27.89,0:10:30.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arihito, jangan buat kami khawatir.
Dialogue: 0,0:10:30.94,0:10:32.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:10:32.44,0:10:34.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku salah perhitungan.
Dialogue: 0,0:10:34.36,0:10:35.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahu-tahu habis napas.
Dialogue: 0,0:10:36.27,0:10:37.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana Theresia?
Dialogue: 0,0:10:41.16,0:10:43.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah membuatmu khawatir.
Dialogue: 0,0:10:44.12,0:10:47.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang, aku baik-baik saja, kok.
Dialogue: 0,0:10:47.52,0:10:48.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia?
Dialogue: 0,0:10:49.92,0:10:51.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kamu kenapa?
Dialogue: 0,0:10:51.51,0:10:53.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiba-tiba kamu memerah begitu.
Dialogue: 0,0:10:54.34,0:10:56.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa dengan Theresia?
Dialogue: 0,0:10:56.87,0:11:00.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abang tadi tiba-tiba\Ningin menyelam ke mata air?
Dialogue: 0,0:11:00.96,0:11:02.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak tiba-tiba juga, sih.
Dialogue: 0,0:11:02.35,0:11:05.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi di dasar mata air ada sesuatu.
Dialogue: 0,0:11:05.12,0:11:08.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia yang menemukannya\Ndan memberitahukannya padaku.
Dialogue: 0,0:11:09.44,0:11:12.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menemukan hal baru di tempat liburan Guild
Dialogue: 0,0:11:12.32,0:11:14.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang sudah lama tidak dipakai.
Dialogue: 0,0:11:14.74,0:11:18.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya party ini memang punya\Nsuatu keberuntungan, ya.
Dialogue: 0,0:11:18.41,0:11:20.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dasar mata air?
Dialogue: 0,0:11:20.37,0:11:22.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira ada apa di sana?
Dialogue: 0,0:11:27.88,0:11:29.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelepasan Semangat Tempur!
Dialogue: 0,0:11:40.80,0:11:43.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teleportasi Paksa akan segera dimulai.
Dialogue: 0,0:11:44.39,0:11:48.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para pengikutku,\Nmohon untuk tidak terpencar.
Dialogue: 0,0:11:52.27,0:11:53.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, apa ini?
Dialogue: 0,0:11:53.98,0:11:56.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sebenarnya terjadi?
Dialogue: 0,0:11:56.36,0:11:58.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar.
Dialogue: 0,0:11:58.24,0:11:59.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lihat peta dulu.
Dialogue: 0,0:12:00.78,0:12:04.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata, tadi itu mekanisme\Nuntuk teleportasi.
Dialogue: 0,0:12:05.00,0:12:09.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan tempat ini adalah pulau\Nyang berbeda dari tempat yang tadi.
Dialogue: 0,0:12:09.17,0:12:10.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulau berbeda?
Dialogue: 0,0:12:10.67,0:12:12.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya ada pulau yang lain?
Dialogue: 0,0:12:12.96,0:12:15.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, labirin ini
Dialogue: 0,0:12:15.84,0:12:20.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah labirin luas\Nyang pulaunya tersebar di lautan, ya.
Dialogue: 0,0:12:20.34,0:12:24.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak diteleportasi,\Nkita tak akan ke pulau ini.
Dialogue: 0,0:12:26.02,0:12:27.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?\NApa ada sesuatu?
Dialogue: 0,0:12:33.82,0:12:35.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coral Vigo?
Dialogue: 0,0:12:35.40,0:12:38.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dia sangat besar.
Dialogue: 0,0:12:38.99,0:12:41.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hoyoku yang Menari di Padang Salju.
Dialogue: 0,0:12:41.37,0:12:42.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang kebingungan?
Dialogue: 0,0:12:43.37,0:12:45.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, awas!
Dialogue: 0,0:12:48.29,0:12:49.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membeku?
Dialogue: 0,0:12:49.58,0:12:50.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dingin!
Dialogue: 0,0:12:50.75,0:12:52.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat.
Dialogue: 0,0:12:52.20,0:12:54.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita selesaikan ini dengan cepat!
Dialogue: 0,0:12:58.26,0:12:59.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:12:59.65,0:13:01.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang aneh.
Dialogue: 0,0:13:01.70,0:13:03.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:13:06.18,0:13:07.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Elitia!
Dialogue: 0,0:13:07.56,0:13:08.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia! Shion!
Dialogue: 0,0:13:10.10,0:13:11.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batalkan serangan.
Dialogue: 0,0:13:11.60,0:13:13.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, kenapa?
Dialogue: 0,0:13:13.52,0:13:16.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hanya tebakanku,\Nmungkin monster bernama itu
Dialogue: 0,0:13:16.44,0:13:20.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menyerang kita hanya karena terkejut.
Dialogue: 0,0:13:20.74,0:13:24.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin karena suatu alasan,\Nsejak muncul di pulau ini
Dialogue: 0,0:13:24.37,0:13:26.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia sudah lama sendirian.
Dialogue: 0,0:13:27.12,0:13:29.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu kita mendadak diteleportasi ke sini.
Dialogue: 0,0:13:29.58,0:13:31.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya dia terkejut?
Dialogue: 0,0:13:33.29,0:13:36.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa, monster ini jangan dibunuh,
Dialogue: 0,0:13:36.13,0:13:39.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi dibawa ke pulau tempat penginapan kita.
Dialogue: 0,0:13:40.38,0:13:43.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk dipertemukan dengan teman-temannya.
Dialogue: 0,0:13:45.01,0:13:46.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setuju.
Dialogue: 0,0:13:46.60,0:13:49.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin pasti berat\Nterus-terusan sendirian.
Dialogue: 0,0:13:49.64,0:13:51.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:13:53.98,0:13:56.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, tidak perlu takut.
Dialogue: 0,0:13:58.78,0:14:01.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku rasa dia tidak mengerti kata-kataku.
Dialogue: 0,0:14:01.82,0:14:02.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:14:06.58,0:14:09.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin membawamu\Nke tempat teman-temanmu.
Dialogue: 0,0:14:09.95,0:14:12.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maukah kamu ikut bersama kami?
Dialogue: 0,0:14:19.00,0:14:20.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu melakukan sesuatu?
Dialogue: 0,0:14:21.97,0:14:23.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti iya, kan?
Dialogue: 0,0:14:24.72,0:14:26.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak marah, kok.
Dialogue: 0,0:14:27.76,0:14:29.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mon-Monster bernama?
Dialogue: 0,0:14:29.77,0:14:32.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menjinakkannya dan dibawa kemari?
Dialogue: 0,0:14:32.48,0:14:33.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:14:34.39,0:14:37.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk membuat Coral Vigo patuh,
Dialogue: 0,0:14:37.06,0:14:39.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}butuh Bulu Putih Hoyoku.
Dialogue: 0,0:14:39.57,0:14:41.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan kalian...
Dialogue: 0,0:14:41.03,0:14:42.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:14:42.78,0:14:44.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata sudah dapat, ya.
Dialogue: 0,0:14:44.64,0:14:48.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat paham perasaan terkejutmu itu.
Dialogue: 0,0:14:48.32,0:14:52.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar para pendatang baru\Nyang luar biasa.
Dialogue: 0,0:14:56.88,0:14:58.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah bisa pergi.
Dialogue: 0,0:15:07.68,0:15:11.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sangat senang\Nbisa bertemu teman-temannya.
Dialogue: 0,0:15:32.70,0:15:37.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bersama Arihito, masa depan\Nseperti ini pasti menanti kami.
Dialogue: 0,0:15:37.83,0:15:38.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat itu!
Dialogue: 0,0:15:38.92,0:15:43.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mata penguin besar itu\Nseperti ada permata yang jatuh.
Dialogue: 0,0:15:43.71,0:15:46.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Air mata dari Hoyoku yang Menari\Ndi Padang Salju
Dialogue: 0,0:15:46.02,0:15:48.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan berubah menjadi permata Snowdrop.
Dialogue: 0,0:15:48.65,0:15:52.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa melihat air matanya terjatuh\Nmerupakan momen yang sangat langka.
Dialogue: 0,0:15:52.47,0:15:55.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kita membawanya pulang ke sini.
Dialogue: 0,0:15:58.35,0:15:59.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:16:00.48,0:16:05.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya dia mengenali Tuan Atobe\Nsebagai majikannya.
Dialogue: 0,0:16:05.01,0:16:08.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Tuan punya kontrak\Ndi peternakan monster,
Dialogue: 0,0:16:08.16,0:16:09.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia bisa sekalian dipelihara.
Dialogue: 0,0:16:09.70,0:16:12.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dia kan sudah bertemu\Ndengan teman-temannya.
Dialogue: 0,0:16:19.42,0:16:22.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkadang mereka suka membuatku terkejut,
Dialogue: 0,0:16:22.88,0:16:26.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena cerdas dan peduli\Ndengan teman-temannya.
Dialogue: 0,0:16:26.36,0:16:27.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:16:27.88,0:16:31.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bawa teman-temanmu,\Nkamu tak akan kesepian di peternakan, kan?
Dialogue: 0,0:16:34.93,0:16:37.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau saat itu kita mengalahkan Hoyoku,
Dialogue: 0,0:16:37.77,0:16:41.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita tak akan bisa melihat\Npemandangan seperti ini.
Dialogue: 0,0:16:41.09,0:16:42.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:16:44.07,0:16:47.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok kita akan berangkat ke Distrik 7.
Dialogue: 0,0:16:47.82,0:16:49.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:16:49.12,0:16:50.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf,
Dialogue: 0,0:16:50.53,0:16:53.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dibanding konsultasi,\Nmungkin lebih tepatnya usulan.
Dialogue: 0,0:16:53.99,0:16:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita siapkan\Nperlengkapan cadangan
Dialogue: 0,0:16:57.00,0:17:01.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan memasang batu sihir\Nyang berbeda untuk setiap labirin?
Dialogue: 0,0:17:01.21,0:17:02.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:17:02.13,0:17:05.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sewa gudang saja\Nuntuk menyimpan perlengkapan.
Dialogue: 0,0:17:05.45,0:17:08.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kita rapikan di rak penyimpanan.
Dialogue: 0,0:17:08.01,0:17:09.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti aku siapkan uangnya,
Dialogue: 0,0:17:09.55,0:17:12.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi setelah masuk Distrik 7,\Nbisa aku serahkan urusannya padamu?
Dialogue: 0,0:17:12.82,0:17:14.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik!
Dialogue: 0,0:17:14.53,0:17:18.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang bisa dipercaya\Nuntuk melakukan tugas sebesar itu.
Dialogue: 0,0:17:18.60,0:17:20.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Kak.
Dialogue: 0,0:17:21.27,0:17:23.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ingin segera berguna.
Dialogue: 0,0:17:23.65,0:17:26.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tukang Jagal juga punya\Nkemampuan khusus untuk menjelajah.
Dialogue: 0,0:17:26.97,0:17:28.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin segera memakainya.
Dialogue: 0,0:17:28.68,0:17:29.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:17:32.29,0:17:34.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya Shion juga sudah bersemangat.
Dialogue: 0,0:17:35.83,0:17:38.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pak Rikerton, Falma,
Dialogue: 0,0:17:38.52,0:17:40.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan menjaga keluarga kalian
Dialogue: 0,0:17:40.89,0:17:42.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kembali dengan selamat.
Dialogue: 0,0:17:43.25,0:17:46.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin akan jadi perjalanan panjang,\Ntapi jangan khawatir.
Dialogue: 0,0:17:46.80,0:17:49.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Atobe?
Dialogue: 0,0:17:49.17,0:17:50.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajahmu serius begitu.
Dialogue: 0,0:17:50.76,0:17:52.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tidak.
Dialogue: 0,0:17:52.61,0:17:55.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesampainya di Distrik 7,\Naku ingin menulis surat
Dialogue: 0,0:17:55.26,0:17:58.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk mereka yang telah membantuku.
Dialogue: 0,0:17:58.97,0:18:04.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, tiba-tiba aku jadi merasa sentimental.
Dialogue: 0,0:18:04.19,0:18:09.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sendiri heran,\Npria seumuranku bicara begini.
Dialogue: 0,0:18:09.90,0:18:11.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham perasaanmu.
Dialogue: 0,0:18:11.86,0:18:13.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Abang kesepian,
Dialogue: 0,0:18:13.82,0:18:16.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Theresia bisa temani Abang tidur, lo.
Dialogue: 0,0:18:17.20,0:18:19.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suzu juga boleh.
Dialogue: 0,0:18:19.83,0:18:21.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, tapi...
Dialogue: 0,0:18:21.75,0:18:24.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sekamar dengan Arihito,\Naku tidak keberatan, sih.
Dialogue: 0,0:18:24.84,0:18:27.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak begitu, rasanya jadi aneh...
Dialogue: 0,0:18:27.59,0:18:29.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Kalau begitu, Suzuna,
Dialogue: 0,0:18:29.76,0:18:33.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berarti kamu tidak keberatan\Ntidur satu kamar?
Dialogue: 0,0:18:33.22,0:18:36.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar, jangan-jangan selama ini...
Dialogue: 0,0:18:36.18,0:18:37.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak pernah, kan?
Dialogue: 0,0:18:39.51,0:18:41.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak, tidak pernah.
Dialogue: 0,0:18:41.99,0:18:44.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian kan kamu satu kamar\Ndengan Theresia.
Dialogue: 0,0:18:45.90,0:18:47.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Theresia,
Dialogue: 0,0:18:47.19,0:18:49.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita juga harus mengunjungi Leila dulu.
Dialogue: 0,0:18:51.28,0:18:52.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan melaporkan perjalanan kita
Dialogue: 0,0:18:52.90,0:18:57.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan memberitahunya kalau kita sudah berlibur\Nke tempat yang menyenangkan.
Dialogue: 0,0:19:14.76,0:19:17.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Theresia?
Dialogue: 0,0:19:24.06,0:19:25.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo, Theresia?
Dialogue: 0,0:19:25.10,0:19:26.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat!
Dialogue: 0,0:19:28.98,0:19:31.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu apa yang terjadi,
Dialogue: 0,0:19:31.15,0:19:34.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi, ini pertama kalinya\Naku melihat Theresia sepanik itu.
Dialogue: 0,0:19:39.20,0:19:40.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyegarkan.
Dialogue: 0,0:19:41.74,0:19:45.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awannya berlalu,\Ndan langitnya dipenuhi bintang.
Dialogue: 0,0:19:45.61,0:19:47.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kita ke sini.
Dialogue: 0,0:19:50.38,0:19:54.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih ada banyak yang ingin\Ndan harus kita lakukan.
Dialogue: 0,0:19:54.80,0:19:58.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalan yang akan dilalui party ini\Nmungkin akan sulit.
Dialogue: 0,0:19:58.77,0:20:00.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun,
Dialogue: 0,0:20:00.55,0:20:04.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku jadi tahu kita juga bisa menikmati\Nwaktu yang tenang ini.
Dialogue: 0,0:20:04.85,0:20:07.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh hari yang indah.
Dialogue: 0,0:20:24.91,0:20:27.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, wah, sungguh mengejutkan.
Dialogue: 0,0:20:27.37,0:20:31.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa naik ke Distrik 7\Ndalam waktu sesingkat ini.
Dialogue: 0,0:20:31.75,0:20:35.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini rekor tercepat sejak berdirinya\NNegeri Labirin.
Dialogue: 0,0:20:35.63,0:20:39.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kamu bekerja di sini, ya?
Dialogue: 0,0:20:39.05,0:20:40.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:20:40.25,0:20:43.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, tapi, aku bukan sekadar pekerja biasa.
Dialogue: 0,0:20:43.93,0:20:46.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya cukup wewenang di sini.
Dialogue: 0,0:20:46.02,0:20:48.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketika mendengar kalian\Nberhasil ke Distrik 7,
Dialogue: 0,0:20:48.98,0:20:51.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ditugaskan untuk menerima kalian.
Dialogue: 0,0:20:51.73,0:20:53.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon, lisensinya.
Dialogue: 0,0:20:55.73,0:20:58.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, sekarang kalian sudah diizinkan
Dialogue: 0,0:20:58.24,0:21:00.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}melewati pos pemeriksaan Distrik 7.
Dialogue: 0,0:21:00.99,0:21:02.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:21:02.70,0:21:04.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, kami pamit.
Dialogue: 0,0:21:06.66,0:21:09.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin ini kalimat yang biasa,
Dialogue: 0,0:21:09.41,0:21:11.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi izinkan aku mengatakannya.
Dialogue: 0,0:21:11.75,0:21:14.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang, para pendatang baru.
Dialogue: 0,0:21:14.17,0:21:17.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai dari sini adalah\NNegeri Labirin yang sesungguhnya.
Dialogue: 0,0:21:17.53,0:21:21.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, aku akan menunggu di Distrik 1.
Dialogue: 0,0:21:28.64,0:21:30.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengembalikan Theresia menjadi manusia
Dialogue: 0,0:21:30.69,0:21:32.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menyelamatkan teman Elitia.
Dialogue: 0,0:21:33.15,0:21:35.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa, sama seperti party Georg,
Dialogue: 0,0:21:35.73,0:21:38.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ingin membantu party\Nyang tumbang di dalam labirin.
Dialogue: 0,0:21:39.40,0:21:40.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku...
Dialogue: 0,0:21:41.32,0:21:45.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah seorang Garda Belakang\Nyang tak bisa bertarung sendirian.
Dialogue: 0,0:21:45.78,0:21:46.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun...
Dialogue: 0,0:21:50.41,0:21:53.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa menjadi\NGarda Belakang terkuat di dunia,
Dialogue: 0,0:21:54.17,0:21:56.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selama ada mereka bersamaku.
Dialogue: 0,0:21:59.15,0:22:00.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
