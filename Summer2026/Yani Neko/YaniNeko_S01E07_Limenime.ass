Dialogue: 0,0:02:15.51,0:02:17.92,sign,,0000,0000,0000,,DUNIA PUN TERSELAMATKAN
Dialogue: 0,0:03:48.01,0:03:51.02,sign,,0000,0000,0000,,PERUSAHAAN PENYALUR MANUSIA HEWAN\NBEAST PAL
Dialogue: 0,0:04:55.25,0:04:58.13,sign,,0000,0000,0000,,RUANG ISTIRAHAT
Dialogue: 0,0:05:30.20,0:05:33.54,sign,,0000,0000,0000,,PERUSAHAAN PENYALUR MANUSIA HEWAN\NLEMBAR EVALUASI YANIKO SATO: C
Dialogue: 0,0:06:12.74,0:06:13.66,sign,,0000,0000,0000,,{\an8}DORAYAKI KACANG
Dialogue: 0,0:07:04.13,0:07:05.88,sign,,0000,0000,0000,,AESHNA CRENATA
Dialogue: 0,0:08:18.12,0:08:20.54,sign,,0000,0000,0000,,SATO
Dialogue: 0,0:10:15.74,0:10:18.61,sign,,0000,0000,0000,,SATO
Dialogue: 0,0:10:21.53,0:10:22.53,sign,,0000,0000,0000,,BIOSKOP PAON
Dialogue: 0,0:12:19.98,0:12:20.90,sign,,0000,0000,0000,,{\an8}LABORATORIUM
Dialogue: 0,0:12:35.96,0:12:37.92,sign,,0000,0000,0000,,{\an8}AST = FUNGSI LIVER\NIPK = NILAI MAHASISWA
Dialogue: 0,0:13:52.70,0:13:54.20,sign,,0000,0000,0000,,SELAMAT ATAS KELULUSAN!
Dialogue: 0,0:15:39.48,0:15:41.14,sign,,0000,0000,0000,,TIGA MENIT LALU
Dialogue: 0,0:16:10.71,0:16:11.55,sign,,0000,0000,0000,,BAHAYA
Dialogue: 0,0:17:52.19,0:17:53.94,sign,,0000,0000,0000,,MAAF
Dialogue: 0,0:23:37.99,0:23:39.16,sign,,0000,0000,0000,,INI KARYA FIKSI.
Dialogue: 0,0:23:39.16,0:23:40.96,sign,,0000,0000,0000,,ANAK-ANAK\NDILARANG MEROKOK DAN MINUM-MINUM.
Dialogue: 0,0:00:54.55,0:00:56.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa mendengarnya.
Dialogue: 0,0:00:56.18,0:01:00.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara kebencian akan dunia\Nyang begitu kejam kepada para perokok.
Dialogue: 0,0:01:00.56,0:01:02.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:01:02.31,0:01:06.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubuat dunia ini\Ndipenuhi abu dan tar.
Dialogue: 0,0:01:06.06,0:01:09.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebab akulah Iblis Nikotin.
Dialogue: 0,0:01:13.15,0:01:14.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kecoak!
Dialogue: 0,0:01:14.44,0:01:16.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lantainya penuh sampah juga!
Dialogue: 0,0:01:16.82,0:01:19.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang tinggal di sini?
Dialogue: 0,0:01:20.83,0:01:24.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangkuk nasi yang dimakan setengah,\Nditinggalkan terbuka begitu saja!
Dialogue: 0,0:01:24.33,0:01:28.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah kau selesai makan,\Nharusnya langsung cuci dan bereskan.
Dialogue: 0,0:01:28.21,0:01:31.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paling benci orang yang seperti ini.
Dialogue: 0,0:01:32.17,0:01:35.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuah ramennya\Nsudah mengental dan menghitam.
Dialogue: 0,0:01:36.09,0:01:37.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang bergerak-gerak.
Dialogue: 0,0:01:41.30,0:01:44.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak! Aku jijik pada serangga!
Dialogue: 0,0:01:48.14,0:01:50.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menginjak sesuatu! Apa itu?
Dialogue: 0,0:01:50.11,0:01:53.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang penyek di bawah kakiku!\NMenjijikkan sekali!
Dialogue: 0,0:01:54.28,0:01:55.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjijikkan!
Dialogue: 0,0:01:55.32,0:01:59.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku muak sekali! Aku benci tempat ini!\NAku pulang saja!
Dialogue: 0,0:03:51.02,0:03:54.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, ini perusahaan penyalur\Nyang disebut oleh Yaku.
Dialogue: 0,0:03:54.27,0:03:57.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kekurangan uang rokok\Nbulan ini, jadi harus bekerja.
Dialogue: 0,0:03:58.23,0:04:00.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nomor 82.
Dialogue: 0,0:04:00.86,0:04:02.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin bekerja.
Dialogue: 0,0:04:02.15,0:04:03.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:04:03.53,0:04:05.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan kau bisa mulai?
Dialogue: 0,0:04:05.57,0:04:08.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin langsung mulai bekerja\Ndan dapat banyak uang.
Dialogue: 0,0:04:08.41,0:04:12.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, ada lowongan pekerjaan\Nyang dimulai siang ini.
Dialogue: 0,0:04:12.04,0:04:13.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pekerjaan macam apa itu?
Dialogue: 0,0:04:14.29,0:04:17.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Bersih-bersih sederhana\Nyang bisa dilakukan siapa pun.
Dialogue: 0,0:04:46.95,0:04:51.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Baik, sekarang istirahat 15 menit.\NSemua, naiklah.{\i0}
Dialogue: 0,0:05:02.46,0:05:03.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hei!{\i0}
Dialogue: 0,0:05:03.76,0:05:07.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jangan nyalakan api! Alat pelindungmu\Nberlapis bahan mudah terbakar.{\i0}
Dialogue: 0,0:05:07.68,0:05:10.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Manusia hewan pun\Nbisa paham kenapa itu berbahaya, bukan?{\i0}
Dialogue: 0,0:05:10.60,0:05:13.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pekerjaan macam apa ini!
Dialogue: 0,0:05:13.47,0:05:15.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerjanya sulit, nyaris tak ada istirahat.
Dialogue: 0,0:05:15.52,0:05:18.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak sebanding dengan upahnya!
Dialogue: 0,0:05:18.02,0:05:20.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau setuju denganku, 'kan?
Dialogue: 0,0:05:21.27,0:05:23.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, 'kan?
Dialogue: 0,0:05:25.61,0:05:26.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar saja.
Dialogue: 0,0:05:34.58,0:05:36.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Chainsmoker Cat.{\i0}
Dialogue: 0,0:05:47.34,0:05:49.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Capung musim gugur.
Dialogue: 0,0:05:50.18,0:05:52.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa itu artinya musim gugur tiba.
Dialogue: 0,0:05:52.10,0:05:55.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, waktu berlalu begitu cepat.
Dialogue: 0,0:05:57.35,0:06:00.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yaku Neko, kau sudah pulang?
Dialogue: 0,0:06:00.48,0:06:01.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:06:02.48,0:06:05.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira kau akan meluangkan waktu\Nlebih lama bersama mereka.
Dialogue: 0,0:06:05.57,0:06:08.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus bekerja besok.
Dialogue: 0,0:06:10.28,0:06:12.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kubawakan dorayaki.
Dialogue: 0,0:06:13.66,0:06:14.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terima kasih.
Dialogue: 0,0:06:14.66,0:06:17.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kubeli dari kedai tua\Ndekat rumah orang tuaku.
Dialogue: 0,0:06:17.41,0:06:20.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru mau minum teh.\NKau mau ikut minum?
Dialogue: 0,0:06:21.92,0:06:23.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:06:23.21,0:06:27.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku agak lelah,\Njadi kurasa kali ini aku tidak ikut.
Dialogue: 0,0:06:27.63,0:06:28.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:06:28.93,0:06:30.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beristirahatlah.
Dialogue: 0,0:06:30.51,0:06:31.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:06:33.14,0:06:35.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah itu Yaku?
Dialogue: 0,0:06:35.18,0:06:36.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:06:36.97,0:06:38.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama aku tak melihatnya.
Dialogue: 0,0:06:39.35,0:06:40.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia baru mengunjungi orang tua.
Dialogue: 0,0:06:40.98,0:06:42.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peringatan satu tahun wafat kakeknya.
Dialogue: 0,0:06:43.56,0:06:45.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas warna rambutnya begitu.
Dialogue: 0,0:06:46.78,0:06:48.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warna hitam juga cocok untuknya.
Dialogue: 0,0:06:49.57,0:06:51.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakeknya juga manusia hewan?
Dialogue: 0,0:07:00.16,0:07:04.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Capung merah{\i0}
Dialogue: 0,0:07:07.34,0:07:11.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Capung merah{\i0}
Dialogue: 0,0:07:11.55,0:07:15.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak sabar untuk menggoreng\Ndan memakannya. Ada lauk makan malam lagi.
Dialogue: 0,0:07:20.18,0:07:22.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kehabisan rokok.
Dialogue: 0,0:07:22.19,0:07:23.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu!
Dialogue: 0,0:07:24.94,0:07:27.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yaku, kau sudah pulang?
Dialogue: 0,0:07:27.98,0:07:30.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kehabisan rokok.
Dialogue: 0,0:07:33.70,0:07:36.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yaku Neko, kau sudah pulang?
Dialogue: 0,0:07:36.12,0:07:37.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri aku rokok.
Dialogue: 0,0:07:42.50,0:07:43.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:07:44.71,0:07:47.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri aku rokok. Juga, ini gelap.
Dialogue: 0,0:07:47.30,0:07:49.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya nyalakan lampu.
Dialogue: 0,0:07:49.71,0:07:51.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada di dalam tasku.
Dialogue: 0,0:07:51.51,0:07:53.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sana ambillah.
Dialogue: 0,0:07:54.51,0:07:57.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya kau juga\Nsesekali pulang ke rumahmu.
Dialogue: 0,0:07:59.97,0:08:01.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Kak Yani.
Dialogue: 0,0:08:02.98,0:08:03.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa…
Dialogue: 0,0:08:05.19,0:08:06.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa…
Dialogue: 0,0:08:06.11,0:08:07.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa manusia…
Dialogue: 0,0:08:10.94,0:08:12.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bukan manusia.
Dialogue: 0,0:08:14.03,0:08:15.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Chainsmoker Cat!{\i0}
Dialogue: 0,0:08:33.55,0:08:35.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kabarmu, Yaniko?
Dialogue: 0,0:08:36.64,0:08:40.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya banyak pekerjaan paruh waktu.
Dialogue: 0,0:08:40.18,0:08:41.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:08:41.39,0:08:42.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dipecat dari semuanya itu.
Dialogue: 0,0:08:42.93,0:08:44.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:08:50.86,0:08:52.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shizue, beri aku pemantik.
Dialogue: 0,0:08:52.40,0:08:53.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:08:53.65,0:08:54.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba kita lihat.
Dialogue: 0,0:08:54.90,0:08:56.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana kutaruh pemantiknya?
Dialogue: 0,0:09:03.75,0:09:05.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku pinjam, ya?
Dialogue: 0,0:09:17.97,0:09:20.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya agak berbeda\Njika pakai korek api, 'kan?
Dialogue: 0,0:09:23.47,0:09:26.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh minta satu?
Dialogue: 0,0:09:28.94,0:09:30.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih!
Dialogue: 0,0:09:30.94,0:09:33.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat, cepat!
Dialogue: 0,0:09:39.03,0:09:39.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nikmat sekali.
Dialogue: 0,0:09:42.20,0:09:43.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah pukul segini?
Dialogue: 0,0:09:43.58,0:09:46.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Gawat! Dia akan segera pulang!
Dialogue: 0,0:09:50.84,0:09:52.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pulang.
Dialogue: 0,0:09:53.13,0:09:54.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakakku datang!
Dialogue: 0,0:09:55.51,0:09:56.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sedang merokok!
Dialogue: 0,0:09:56.97,0:09:59.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah berapa kali kukatakan,\Njangan merokok di rumah kita!
Dialogue: 0,0:10:00.34,0:10:02.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Ibu tak melarangnya?
Dialogue: 0,0:10:02.72,0:10:04.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu sangat lunak padanya!
Dialogue: 0,0:10:04.72,0:10:07.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru tempo hari kau berjanji padaku!
Dialogue: 0,0:10:08.64,0:10:10.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajah memelas itu tak bisa meluluhkanku!
Dialogue: 0,0:10:11.23,0:10:12.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana rasanya?
Dialogue: 0,0:10:12.86,0:10:15.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}- Akrab seperti biasanya.{\i0}\N- Pokoknya tidak!
Dialogue: 0,0:10:20.07,0:10:21.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tiket untuk Ibu.
Dialogue: 0,0:10:23.28,0:10:24.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Yang ini tiketmu, Kak.
Dialogue: 0,0:10:25.37,0:10:27.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, sekarang\Ntiket bisa dipesan lebih dulu, ya?
Dialogue: 0,0:10:27.96,0:10:29.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Praktis, bukan?
Dialogue: 0,0:10:29.79,0:10:32.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tempat dudukku jauh dari kalian?
Dialogue: 0,0:10:32.50,0:10:35.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan merokok, 'kan?\NKupesankan tempat duduk yang jauh.
Dialogue: 0,0:10:38.17,0:10:39.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kau selalu bersikap tegas,
Dialogue: 0,0:10:39.93,0:10:42.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau tetap memaklumi\Nkebiasaan merokok kakakmu.
Dialogue: 0,0:10:42.93,0:10:46.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun juga,\Nkau benar-benar menyayangi kakakmu.
Dialogue: 0,0:10:46.18,0:10:48.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diamlah, Ibu.
Dialogue: 0,0:10:48.39,0:10:51.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika orang-orang hidup sampai 80 tahun,{\i0}
Dialogue: 0,0:10:51.52,0:10:54.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}setengahnya saja sudah cukup bagiku.{\i0}
Dialogue: 0,0:10:55.11,0:10:58.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Toshi, kau jangan berakhir sepertiku.{\i0}
Dialogue: 0,0:10:59.45,0:11:00.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku ingin merokok.{\i0}
Dialogue: 0,0:11:01.07,0:11:03.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku sangat ingin merokok sekarang.{\i0}
Dialogue: 0,0:11:04.45,0:11:08.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kenapa banyak adegan merokok\Ndalam film ini?{\i0}
Dialogue: 0,0:11:13.63,0:11:15.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu mau ke toilet.
Dialogue: 0,0:11:18.09,0:11:20.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:11:20.01,0:11:22.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolonglah, Yaniko.
Dialogue: 0,0:11:32.81,0:11:35.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tadi banyak menangis.
Dialogue: 0,0:11:35.19,0:11:37.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah menemaniku hari ini.
Dialogue: 0,0:11:37.40,0:11:41.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teman-temanku tak tertarik\Nmenonton film Yakuza bersamaku.
Dialogue: 0,0:11:41.82,0:11:43.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kalian berdua berdekatan?
Dialogue: 0,0:11:47.20,0:11:50.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang Ibu juga terkena bau rokok!
Dialogue: 0,0:11:50.33,0:11:52.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau tak lebih pengertian?
Dialogue: 0,0:11:52.83,0:11:55.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yani tidak bersalah, nya!
Dialogue: 0,0:11:55.38,0:11:57.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak akan luluh padamu!
Dialogue: 0,0:11:57.55,0:11:59.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu benar!
Dialogue: 0,0:11:59.17,0:12:00.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau kau merokok
Dialogue: 0,0:12:00.80,0:12:03.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- saat menonton film!\N{\i1}- Andai ini berlangsung selamanya.{\i0}
Dialogue: 0,0:12:20.90,0:12:23.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Mengenai pemeriksaan kesehatanmu\Ntempo hari.
Dialogue: 0,0:12:23.36,0:12:28.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar pengambilan darahmu sulit\Nkarena kau kejang-kejang.
Dialogue: 0,0:12:28.62,0:12:31.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu jelas tanda kecanduan.
Dialogue: 0,0:12:31.12,0:12:35.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Juga, kadar AST yang tinggi ini\Nberbanding terbalik dengan IPK-mu.
Dialogue: 0,0:12:37.92,0:12:40.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Itu ciri mahasiswa pemalas.
Dialogue: 0,0:12:40.13,0:12:42.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini mungkin bukan urusanku,
Dialogue: 0,0:12:42.51,0:12:44.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi berhentilah minum miras,\Nkembali belajar.
Dialogue: 0,0:12:44.80,0:12:46.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau kau bisa tewas sebelum lulus.
Dialogue: 0,0:12:49.14,0:12:52.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bahkan sudah berhenti minum\Nseminggu penuh.
Dialogue: 0,0:12:53.52,0:12:54.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awas!
Dialogue: 0,0:12:57.27,0:13:01.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perhatikan langkahmu,\Natau kau bisa tertabrak!
Dialogue: 0,0:13:07.07,0:13:08.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia masih SD?{\i0}
Dialogue: 0,0:13:08.87,0:13:10.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini rute yang dilewati anak sekolah?{\i0}
Dialogue: 0,0:13:11.37,0:13:12.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau sedang pulang ke rumah?
Dialogue: 0,0:13:13.41,0:13:14.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:13:14.54,0:13:17.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau aku temani?
Dialogue: 0,0:13:22.42,0:13:25.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini searah dengan tempat tinggal kakakku.{\i0}
Dialogue: 0,0:13:29.22,0:13:31.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa terjadi hal buruk?
Dialogue: 0,0:13:31.39,0:13:34.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, berkaitan dengan sekolah.
Dialogue: 0,0:13:34.89,0:13:37.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu. Sekolah memang berat.
Dialogue: 0,0:13:41.32,0:13:43.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat aku masih SD,
Dialogue: 0,0:13:43.48,0:13:46.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sempat mengalami perundungan.
Dialogue: 0,0:13:47.32,0:13:50.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seorang anak lelaki\Nmemanggilku gadis kucing,
Dialogue: 0,0:13:50.16,0:13:52.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menyembunyikan sepatu dan rekorderku.
Dialogue: 0,0:13:54.20,0:13:58.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lalu, suatu hari saat SMP,\Nperundung itu menyatakan perasaan padaku.{\i0}
Dialogue: 0,0:14:00.17,0:14:02.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia berkata dia merundungku\Nkarena dia menyukaiku.{\i0}
Dialogue: 0,0:14:03.21,0:14:07.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Saat kudengar kata-katanya,\Npikirku, "Jadi, selama ini karena itu?"{\i0}
Dialogue: 0,0:14:10.72,0:14:15.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi sadar\Nbahwa harusnya aku tak perlu khawatir.
Dialogue: 0,0:14:17.35,0:14:19.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bangga\Nmendapat perhatian yang tak terduga?
Dialogue: 0,0:14:20.19,0:14:23.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu tidak!\NTapi kurasa kedengarannya begitu.
Dialogue: 0,0:14:23.36,0:14:24.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga.
Dialogue: 0,0:14:25.03,0:14:26.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu…
Dialogue: 0,0:14:28.32,0:14:29.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku merasa baikan.
Dialogue: 0,0:14:30.45,0:14:35.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebanyakan masalah\Ntak separah yang kita kira.
Dialogue: 0,0:14:35.62,0:14:38.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti begitu.
Dialogue: 0,0:14:39.37,0:14:40.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:14:46.01,0:14:48.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Terima kasih.\N{\i1}- Dia gadis kecil yang aneh.{\i0}
Dialogue: 0,0:14:49.97,0:14:52.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia sedikit mengingatkanku pada kakakku.{\i0}
Dialogue: 0,0:14:55.31,0:14:56.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gempa bumi.
Dialogue: 0,0:14:56.93,0:14:58.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gedung tua ini sering berguncang.
Dialogue: 0,0:15:01.73,0:15:02.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, terlalu lama.
Dialogue: 0,0:15:02.94,0:15:05.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini intro lagu "Love Phantom"?
Dialogue: 0,0:15:06.11,0:15:08.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Aruko. Kita harus mengungsi.
Dialogue: 0,0:15:10.95,0:15:12.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini gara-gara kau?
Dialogue: 0,0:15:12.82,0:15:16.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menjalani\Npemeriksaan kesehatan lanjutan.
Dialogue: 0,0:15:16.58,0:15:20.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan ibumu, tapi hal terpenting\Nadalah menjaga kesehatan tiap hari.
Dialogue: 0,0:15:20.79,0:15:22.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan terakhir kau minum?
Dialogue: 0,0:15:23.17,0:15:24.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sehari yang lalu?
Dialogue: 0,0:15:25.54,0:15:28.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, sejam lalu.
Dialogue: 0,0:15:28.46,0:15:30.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini berhentilah!
Dialogue: 0,0:15:33.18,0:15:34.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku sedang…{\i0}
Dialogue: 0,0:15:35.80,0:15:37.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}berada di luar.{\i0}
Dialogue: 0,0:15:45.31,0:15:46.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gempa bumi?
Dialogue: 0,0:15:47.02,0:15:49.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gempanya besar! Aku harus lari ke luar!
Dialogue: 0,0:15:49.74,0:15:52.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, tersangkut!\NAku terlalu banyak kejang-kejang!
Dialogue: 0,0:15:53.74,0:15:55.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sampai aku tewas karena ini!
Dialogue: 0,0:15:56.58,0:15:57.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dan akhirnya aku di sini.{\i0}
Dialogue: 0,0:16:00.08,0:16:02.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Gempa itu pasti membuat pintunya macet!{\i0}
Dialogue: 0,0:16:03.87,0:16:04.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dengan kata lain,{\i0}
Dialogue: 0,0:16:05.50,0:16:06.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tamatlah sudah.{\i0}
Dialogue: 0,0:16:07.38,0:16:10.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Jika mereka melihatku seperti ini…{\i0}
Dialogue: 0,0:16:12.13,0:16:15.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku harus lewat belakang\Ndan memecahkan jendela balkonku.{\i0}
Dialogue: 0,0:16:22.56,0:16:26.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Satu atau dua jendela tak berarti,\Ndaripada aku dianggap hina.{\i0}
Dialogue: 0,0:16:29.69,0:16:30.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dewa, tolonglah!
Dialogue: 0,0:16:30.69,0:16:31.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:16:36.12,0:16:37.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo.
Dialogue: 0,0:16:38.70,0:16:41.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kostum kentaur atau semacamnya?
Dialogue: 0,0:16:41.12,0:16:45.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, bukan itu.\NKentaur tak punya dua kepala.
Dialogue: 0,0:16:45.96,0:16:48.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu bentuk baru dari Kerberos?
Dialogue: 0,0:16:48.38,0:16:49.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunuh aku.
Dialogue: 0,0:16:49.67,0:16:50.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:16:50.59,0:16:52.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada gunanya mencoba menjelaskan.
Dialogue: 0,0:16:53.42,0:16:54.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini aku mati.
Dialogue: 0,0:16:54.38,0:16:56.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu! Cobalah untuk tenang!
Dialogue: 0,0:16:57.14,0:17:00.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hanya tebakanku,
Dialogue: 0,0:17:00.14,0:17:02.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat kau bermain\Ndengan boneka manusia hewan,
Dialogue: 0,0:17:02.43,0:17:04.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau berusaha lari saat gempa bumi,
Dialogue: 0,0:17:04.44,0:17:06.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kemaluanmu tersangkut di boneka,
Dialogue: 0,0:17:06.31,0:17:08.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau keluar telanjang, tapi pintunya macet,
Dialogue: 0,0:17:08.56,0:17:10.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau tak bisa masuk ke dalam.
Dialogue: 0,0:17:11.48,0:17:13.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itukah yang terjadi?
Dialogue: 0,0:17:13.78,0:17:14.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar!
Dialogue: 0,0:17:14.70,0:17:16.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengalamanku menulis komik berguna!
Dialogue: 0,0:17:17.78,0:17:20.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa menunggu di kamarku\Nsampai tukang reparasi datang.
Dialogue: 0,0:17:20.83,0:17:23.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubelikan pakaian pria.
Dialogue: 0,0:17:23.12,0:17:25.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sungguh berterima kasih!
Dialogue: 0,0:17:26.42,0:17:28.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah agak mundur beberapa langkah?
Dialogue: 0,0:17:29.25,0:17:30.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:17:36.38,0:17:37.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hampir saja.
Dialogue: 0,0:17:38.43,0:17:41.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terpaksa hentikan Yani Neko,\Nkarena entah dia akan melakukan apa.
Dialogue: 0,0:17:47.69,0:17:50.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan aku tertidur?
Dialogue: 0,0:17:55.53,0:17:57.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bermimpi aneh.
Dialogue: 0,0:17:57.20,0:17:58.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:17:58.41,0:18:00.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menjadi kentaur.
Dialogue: 0,0:18:00.53,0:18:01.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu konyol!
Dialogue: 0,0:18:02.99,0:18:05.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Chainsmoker Cat.{\i0}
Dialogue: 0,0:18:11.29,0:18:13.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menulis sesuatu lagi?
Dialogue: 0,0:18:13.84,0:18:17.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya! Tidak!\NMaksudku, temanku yang menulisnya!
Dialogue: 0,0:18:17.30,0:18:20.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak pernah mengunggahnya ke Kakeyome!
Dialogue: 0,0:18:20.09,0:18:22.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari masukanmu sebelumnya,
Dialogue: 0,0:18:22.05,0:18:25.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ternyata mereka\Nmenggunakan templat populer di Kakeyome!
Dialogue: 0,0:18:25.89,0:18:28.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kau bacalah.
Dialogue: 0,0:18:29.52,0:18:31.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menulis kisah pengasingan.
Dialogue: 0,0:18:31.36,0:18:32.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:18:32.82,0:18:36.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata seru.\NKurasa templat juga tak buruk.
Dialogue: 0,0:18:36.69,0:18:38.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kata temanku.
Dialogue: 0,0:18:40.66,0:18:43.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Pria itu Mayor Naga yang menyendiri.{\i0}
Dialogue: 0,0:18:43.12,0:18:45.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Pria itu tak punya nama.\NDia membuang namanya.{\i0}
Dialogue: 0,0:18:46.29,0:18:49.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Orang-orang hanya memanggilnya Mayor.{\i0}
Dialogue: 0,0:18:49.58,0:18:53.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Sekadar informasi, "Mayor Naga"\Nadalah profesi di dunia fantasi ini…{\i0}
Dialogue: 0,0:18:53.96,0:18:56.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjelasan latar belakang amat panjang.
Dialogue: 0,0:18:56.05,0:18:59.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjelasan perlu\Nuntuk membangun dunia ceritanya.
Dialogue: 0,0:18:59.05,0:19:00.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mayor!
Dialogue: 0,0:19:00.55,0:19:01.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah datang.
Dialogue: 0,0:19:02.55,0:19:05.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang mau kau katakan kepadaku?
Dialogue: 0,0:19:05.01,0:19:06.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, soal itu.
Dialogue: 0,0:19:07.47,0:19:09.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kau kuasingkan dari kelompok ini!\N- Apa?
Dialogue: 0,0:19:10.81,0:19:12.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turunlah dari kapal.
Dialogue: 0,0:19:13.77,0:19:16.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Si Mayor ini bukan tokoh utamanya?
Dialogue: 0,0:19:16.69,0:19:19.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tokoh utamanya.
Dialogue: 0,0:19:20.28,0:19:23.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tokoh utamanya\Nyang mengasingkan orang?
Dialogue: 0,0:19:23.12,0:19:24.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tak biasa.
Dialogue: 0,0:19:24.12,0:19:25.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Sungguh?
Dialogue: 0,0:19:31.50,0:19:33.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, memang begitu templatnya,
Dialogue: 0,0:19:33.33,0:19:37.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi tak ada gunanya\Nmenulis hal yang sama seperti orang lain!
Dialogue: 0,0:19:37.30,0:19:40.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Mayor yang mengasingkannya,\Nkita membalikkan pola yang umum…
Dialogue: 0,0:19:40.76,0:19:43.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau belum pernah baca karya\Nyang mengikuti templat, ya?
Dialogue: 0,0:19:45.01,0:19:46.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Chainsmoker Cat.{\i0}
Dialogue: 0,0:19:46.72,0:19:48.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}- Chainsmoker Cat.\N- Chainsmoker Cat.{\i0}
Dialogue: 0,0:19:50.39,0:19:54.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham\Nkenapa kau tinggal di sini diam-diam.
Dialogue: 0,0:19:54.90,0:19:59.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti sulit tinggal di tepi sungai\Nsetelah topan menerbangkan tendamu.
Dialogue: 0,0:20:02.28,0:20:05.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau masih berhubungan dengan keluargamu?
Dialogue: 0,0:20:05.12,0:20:10.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikatan darah hanya memaksa hubungan\Nmasuk ke pola yang sudah ditentukan.
Dialogue: 0,0:20:10.12,0:20:12.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku bukan begitu.
Dialogue: 0,0:20:14.54,0:20:15.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar,
Dialogue: 0,0:20:16.04,0:20:18.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bukan mau mengusirmu.
Dialogue: 0,0:20:19.42,0:20:21.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bukan orang asing.
Dialogue: 0,0:20:21.34,0:20:24.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah kita hampir seperti keluarga.
Dialogue: 0,0:20:24.13,0:20:25.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Denganmu dan semuanya.
Dialogue: 0,0:20:25.89,0:20:27.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Keluarga?
Dialogue: 0,0:20:28.64,0:20:32.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kalau memang begitu,\Njujurlah dan ungkapkan isi hatimu.
Dialogue: 0,0:20:32.77,0:20:36.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku dengan senang hati\Nakan menyewakanmu tempat di apartemen.
Dialogue: 0,0:20:37.44,0:20:39.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Baik.
Dialogue: 0,0:20:39.90,0:20:41.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terima kasih.
Dialogue: 0,0:20:44.03,0:20:45.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak seperti biasanya.
Dialogue: 0,0:20:46.24,0:20:49.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini kutraktir, mari minum bersama.
Dialogue: 0,0:20:49.28,0:20:50.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:20:51.37,0:20:52.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Angin kencang!
Dialogue: 0,0:20:53.25,0:20:55.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak apa-apa, Pen-Pen?
Dialogue: 0,0:21:02.17,0:21:03.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:21:03.67,0:21:04.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tuing!{\i0}
Dialogue: 0,0:21:08.43,0:21:12.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak! Ini hanya reaksi biologis pria\Nyang tak bisa kukendalikan!
Dialogue: 0,0:21:12.93,0:21:14.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenanglah!
Dialogue: 0,0:21:14.31,0:21:17.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini di luar kendaliku!\NKita keluarga, bukan?
Dialogue: 0,0:21:17.19,0:21:18.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, 'kan?
Dialogue: 0,0:21:18.31,0:21:22.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya keluarga\Ntidak saling membuat ereksi!
Dialogue: 0,0:21:25.95,0:21:28.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ingin aku menyikat rambutmu sebisaku?
Dialogue: 0,0:21:28.07,0:21:29.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tolong bantuannya.
Dialogue: 0,0:21:29.91,0:21:31.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, aku mulai.
Dialogue: 0,0:21:35.04,0:21:37.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini semua rontok hanya dengan disisir?
Dialogue: 0,0:21:37.04,0:21:38.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya musim pergantian bulu.
Dialogue: 0,0:21:38.83,0:21:41.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rambutmu sangat lebat\Nsampai banyak yang rontok.
Dialogue: 0,0:21:41.88,0:21:44.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selalu seperti ini\Nsetiap musim semi dan gugur.
Dialogue: 0,0:21:44.63,0:21:46.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, banyak yang rontok.
Dialogue: 0,0:21:46.17,0:21:48.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa membuat kembaran dari semua ini.
Dialogue: 0,0:21:52.26,0:21:54.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sangat seru! Seru sekali!
Dialogue: 0,0:23:32.91,0:23:37.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terjemahan subtitle oleh Stysa Alverina
