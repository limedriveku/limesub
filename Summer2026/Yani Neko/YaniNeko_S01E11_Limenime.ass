Dialogue: 0,0:03:18.74,0:03:20.65,sign,,0000,0000,0000,,MEONGKAKUJI
Dialogue: 0,0:05:45.13,0:05:46.88,sign,,0000,0000,0000,,MEONGKEIKAN\NHANAMEONGKOJI
Dialogue: 0,0:05:52.89,0:05:54.64,sign,,0000,0000,0000,,KUIL MASTER KUCING
Dialogue: 0,0:06:06.07,0:06:07.32,sign,,0000,0000,0000,,SANGAT MALANG
Dialogue: 0,0:06:07.32,0:06:09.03,sign,,0000,0000,0000,,LEMBAR RAMALAN\NNO. 666
Dialogue: 0,0:06:09.03,0:06:13.91,sign,,0000,0000,0000,,KEMATIAN MENGINTAIMU. WASPADAI\NENERGI NEGATIF DAN SUDUT-SUDUT HARI INI.
Dialogue: 0,0:06:25.55,0:06:27.47,sign,,0000,0000,0000,,NO. 666\NSANGAT MALANG
Dialogue: 0,0:07:37.08,0:07:38.70,sign,,0000,0000,0000,,TORO NYAN
Dialogue: 0,0:12:18.07,0:12:20.53,sign,,0000,0000,0000,,SEMENTARA ITU…
Dialogue: 0,0:14:56.60,0:14:57.52,sign,,0000,0000,0000,,TEKAN AKU!
Dialogue: 0,0:18:16.59,0:18:19.51,sign,,0000,0000,0000,,{\an8}JANGAN BERIKAN ROKOK KEPADA RUSA
Dialogue: 0,0:19:04.39,0:19:06.39,sign,,0000,0000,0000,,RUANG BERMAIN KUCING
Dialogue: 0,0:23:38.04,0:23:39.12,sign,,0000,0000,0000,,INI KARYA FIKSI.
Dialogue: 0,0:23:39.12,0:23:40.96,sign,,0000,0000,0000,,ANAK-ANAK\NDILARANG MEROKOK DAN MINUM-MINUM.
Dialogue: 0,0:00:03.08,0:00:04.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan menikmati.
Dialogue: 0,0:00:09.50,0:00:11.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Akhirnya aku bisa merokok.{\i0}
Dialogue: 0,0:00:12.26,0:00:16.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Akhir-akhir ini sulit menemukan tempat\Nyang memperbolehkan merokok.{\i0}
Dialogue: 0,0:00:17.80,0:00:18.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi{\i0}
Dialogue: 0,0:00:18.76,0:00:22.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}hari ini Imoko-chan\Nmengikuti karyawisata sekolah ke Kyoto.{\i0}
Dialogue: 0,0:00:22.39,0:00:25.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jadi, aku bisa merokok di rumah juga!{\i0}
Dialogue: 0,0:00:25.65,0:00:27.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Nyonya.
Dialogue: 0,0:00:27.77,0:00:30.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya rokok elektrik yang diperbolehkan.
Dialogue: 0,0:00:39.78,0:00:40.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya?
Dialogue: 0,0:02:12.75,0:02:14.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tiba di Kyoto!
Dialogue: 0,0:02:14.75,0:02:17.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, semuanya\Nberwarna emas dan berkilauan!
Dialogue: 0,0:02:17.51,0:02:18.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imo-chan.
Dialogue: 0,0:02:19.01,0:02:21.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami gadis SMA di puncak masa muda.
Dialogue: 0,0:02:21.14,0:02:23.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kami agak sulit tertarik pada kuil.
Dialogue: 0,0:02:23.64,0:02:25.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:02:25.01,0:02:28.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi itu emas!
Dialogue: 0,0:02:28.14,0:02:30.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia hanya peduli dengan emas.
Dialogue: 0,0:02:31.90,0:02:35.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya beberapa ide\Nuntuk membuat Kyoto lebih menarik.
Dialogue: 0,0:02:36.99,0:02:39.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pertama, kumpulkan\Nsemua kuil di satu tempat.{\i0}
Dialogue: 0,0:02:39.78,0:02:40.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hei.{\i0}
Dialogue: 0,0:02:40.86,0:02:44.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bisa mencegah terulangnya kejadian\Npada sebuah menara jam di utara{\i0}
Dialogue: 0,0:02:44.16,0:02:47.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}yang membuat para wisatawan kecewa.{\i0}
Dialogue: 0,0:02:47.25,0:02:48.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu sungguh kurang ajar!{\i0}
Dialogue: 0,0:02:49.79,0:02:52.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ingin ada atraksi!
Dialogue: 0,0:02:52.33,0:02:54.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,
Dialogue: 0,0:02:54.42,0:02:58.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}kita bisa menggelar parade\Nbertema Meongtendo dengan dana asing,{\i0}
Dialogue: 0,0:02:58.09,0:03:02.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}atau buat fasilitas realitas maya besar\Ndan mereka ulang Penyerbuan Ikedaya.{\i0}
Dialogue: 0,0:03:02.51,0:03:03.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa kau serius?{\i0}
Dialogue: 0,0:03:04.72,0:03:08.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kyoto adalah jantungnya Jepang,\Npenuh dengan sejarah.
Dialogue: 0,0:03:08.14,0:03:11.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan kau buat menyimpang\Ndengan nilai-nilai zaman modernmu.
Dialogue: 0,0:03:13.35,0:03:16.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, katamu begitu, tapi…
Dialogue: 0,0:03:16.36,0:03:18.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Telinga kucing itu untuk apa?
Dialogue: 0,0:03:21.28,0:03:24.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabarnya, Ashikaga Yoshimitsu\Ntertarik pada manusia hewan.
Dialogue: 0,0:03:24.74,0:03:27.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang menyimpang itu selera orang-orang.
Dialogue: 0,0:03:27.08,0:03:28.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nuansanya seperti Atami.
Dialogue: 0,0:03:32.67,0:03:33.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:03:33.63,0:03:36.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya ada banyak\Narea merokok di Kyoto.
Dialogue: 0,0:03:36.63,0:03:39.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini destinasi wisata\Nyang dikunjungi puluhan juta wisatawan.
Dialogue: 0,0:03:39.84,0:03:43.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merokok di jalan akan didenda 1.000 yen.
Dialogue: 0,0:03:44.34,0:03:46.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merokok di jalan?
Dialogue: 0,0:03:46.14,0:03:47.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau teringat kakakmu?
Dialogue: 0,0:03:47.97,0:03:48.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:03:50.81,0:03:51.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:03:52.64,0:03:55.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mendadak aku merasa cemas.{\i0}
Dialogue: 0,0:03:55.19,0:03:58.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tak bisa menolong\Njika Kakak terluka atau sakit sekarang!{\i0}
Dialogue: 0,0:03:58.98,0:04:01.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku juga tak bisa\Nmengandalkan Ibu untuk menolong!{\i0}
Dialogue: 0,0:04:01.53,0:04:02.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imoko.
Dialogue: 0,0:04:03.36,0:04:05.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sedang mengikuti karyawisata sekolah.
Dialogue: 0,0:04:05.49,0:04:07.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lupakanlah masalah keluargamu.
Dialogue: 0,0:04:09.62,0:04:10.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benar.
Dialogue: 0,0:04:13.96,0:04:17.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah ada banyak\Narea merokok di Kyoto.
Dialogue: 0,0:04:17.09,0:04:18.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau merokok di sembarang tempat.
Dialogue: 0,0:04:18.80,0:04:20.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembalikan uang 1.000 yenku\Nsetelah pulang.
Dialogue: 0,0:04:22.38,0:04:24.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Chainsmoker Cat.{\i0}
Dialogue: 0,0:04:26.43,0:04:29.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Baik, ayo kita ke Kyoto!
Dialogue: 0,0:04:31.81,0:04:33.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tiba-tiba ke Kyoto?
Dialogue: 0,0:04:33.64,0:04:35.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penelitian untuk komikku.
Dialogue: 0,0:04:35.69,0:04:37.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mati-matian kuselesaikan tepat waktu.
Dialogue: 0,0:04:37.73,0:04:38.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, masuklah!
Dialogue: 0,0:04:41.78,0:04:44.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku sudah lama\Ningin bepergian bersama banyak orang.
Dialogue: 0,0:04:44.82,0:04:46.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maka, kuambil pinjaman,\Nmembeli mobil baru!
Dialogue: 0,0:04:46.99,0:04:49.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yakin\Nboleh mengeluarkan uang sebanyak itu?
Dialogue: 0,0:04:49.83,0:04:52.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan khawatir, aku baru\Ndapat royalti dari seri bukuku!
Dialogue: 0,0:04:53.33,0:04:55.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, ini demi penelitian.
Dialogue: 0,0:04:55.25,0:04:58.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, habiskan uang sesuka kalian.\NPenerbitku yang membayar!
Dialogue: 0,0:04:58.33,0:04:59.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sungguh?\N- Sungguh?
Dialogue: 0,0:04:59.59,0:05:01.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miras.
Dialogue: 0,0:05:01.67,0:05:03.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau rokok Kyoto.
Dialogue: 0,0:05:03.51,0:05:04.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau yakin, Kak?
Dialogue: 0,0:05:04.84,0:05:06.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh tidak apa-apa!
Dialogue: 0,0:05:07.97,0:05:09.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal ada struk pembayarannya!
Dialogue: 0,0:05:15.31,0:05:17.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tiba di Kyoto!
Dialogue: 0,0:05:17.94,0:05:20.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Langitnya terasa begitu luas!
Dialogue: 0,0:05:20.61,0:05:23.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar tinggi bangunan\Ndibatasi demi pemandangan.
Dialogue: 0,0:05:26.32,0:05:28.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lapar.
Dialogue: 0,0:05:28.70,0:05:31.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, ayo makan!\NMakanan khas Kyoto.
Dialogue: 0,0:05:33.70,0:05:35.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa makan nasi dan daging?
Dialogue: 0,0:05:35.20,0:05:37.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yang masuk ke dalam sini, Kak.
Dialogue: 0,0:05:38.29,0:05:40.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupilih yang hemat karena kebiasaan.
Dialogue: 0,0:05:41.00,0:05:45.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tema perjalanan ini adalah foya-foya!\NKita bersenang-senang sepuasnya!
Dialogue: 0,0:05:46.88,0:05:48.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita ke mana-mana naik gerobak kucing!
Dialogue: 0,0:05:49.51,0:05:50.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berfoya-foya!
Dialogue: 0,0:05:50.47,0:05:52.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sungguh yakin mau begini?
Dialogue: 0,0:05:54.64,0:05:58.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Saatnya melihat peruntungan kita!\NBeli jimat sebanyak yang kalian mau!
Dialogue: 0,0:05:59.56,0:06:00.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Beruntung.
Dialogue: 0,0:06:00.48,0:06:01.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beruntung di Masa Depan.
Dialogue: 0,0:06:01.77,0:06:03.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Punyaku Sangat Beruntung.
Dialogue: 0,0:06:04.23,0:06:06.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari lihat apa yang kudapat.
Dialogue: 0,0:06:14.54,0:06:18.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Teruslah mengundi sampai dapat Beruntung\Njika kalian tak suka undiannya!
Dialogue: 0,0:06:18.54,0:06:20.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan beruntung namanya.
Dialogue: 0,0:06:21.04,0:06:23.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengoleksi semuanya.
Dialogue: 0,0:06:28.51,0:06:29.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, ini yang dirumorkan…
Dialogue: 0,0:06:30.34,0:06:31.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggi sekali!
Dialogue: 0,0:06:32.39,0:06:34.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aneh.{\i0}
Dialogue: 0,0:06:34.31,0:06:37.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Seharusnya sekarang\Naku sedang bersenang-senang.{\i0}
Dialogue: 0,0:06:38.39,0:06:39.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lantas, kenapa?{\i0}
Dialogue: 0,0:06:40.23,0:06:43.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kenapa rasanya\Nseperti ada yang memanggilku?{\i0}
Dialogue: 0,0:06:43.19,0:06:45.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati, Kak!
Dialogue: 0,0:06:45.53,0:06:46.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:06:48.44,0:06:51.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa? Tadi kau berbohong\Nsoal perusahaan yang membayar, bukan?
Dialogue: 0,0:06:51.95,0:06:52.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:06:53.91,0:06:57.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja. Itu benar adanya.
Dialogue: 0,0:06:58.83,0:07:00.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hore!\N- Hore!
Dialogue: 0,0:07:00.08,0:07:02.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hotpot bebek, hore!
Dialogue: 0,0:07:02.08,0:07:04.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini enak sekali.
Dialogue: 0,0:07:04.42,0:07:05.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada habisnya.
Dialogue: 0,0:07:05.96,0:07:07.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga!
Dialogue: 0,0:07:08.26,0:07:09.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putar, putar, putar!
Dialogue: 0,0:07:10.80,0:07:12.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lihat, dia begitu bebas.{\i0}
Dialogue: 0,0:07:13.72,0:07:16.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pasti dia tertekan karena pekerjaannya.{\i0}
Dialogue: 0,0:07:16.35,0:07:18.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ya! Oh, ya!
Dialogue: 0,0:07:18.98,0:07:21.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sudah lama aku tak melihatnya\Nbersenang-senang begitu.{\i0}
Dialogue: 0,0:07:22.69,0:07:23.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kurasa tak apa-apa.{\i0}
Dialogue: 0,0:07:24.27,0:07:29.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekadar info, besok kita dengan santai\Nmengunjungi lorong yang gelap dan seram!
Dialogue: 0,0:07:33.95,0:07:37.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya bisa dengan santai\Nmengunjungi tempat seperti itu?
Dialogue: 0,0:07:38.70,0:07:40.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus.
Dialogue: 0,0:07:41.12,0:07:44.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chain! Smoker! Cat!
Dialogue: 0,0:07:52.93,0:07:57.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jauh lebih menyenangkan\Nsaat gadis-gadis itu tak di sini.
Dialogue: 0,0:07:58.22,0:08:00.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memanaskannya terlalu lama.
Dialogue: 0,0:08:00.39,0:08:01.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aru Neko…
Dialogue: 0,0:08:02.64,0:08:03.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}juga tidak ada di sini.
Dialogue: 0,0:08:04.60,0:08:07.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti mereka minum-minum\Ndi penginapan tradisional Jepang.
Dialogue: 0,0:08:08.90,0:08:13.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini adalah video seorang{\i0} streamer\N{\i1}yang mengunjungi reruntuhan.{\i0}
Dialogue: 0,0:08:14.07,0:08:17.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Katanya ada pembunuhan di sini\N20 tahun yang lalu.{\i0}
Dialogue: 0,0:08:17.28,0:08:18.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu menyeramkan.{\i0}
Dialogue: 0,0:08:18.95,0:08:20.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Cepat, kau sedang direkam.{\i0}
Dialogue: 0,0:08:20.66,0:08:24.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belakangan ini,\Nacara paranormal sudah jarang ada.
Dialogue: 0,0:08:25.88,0:08:26.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ada sebuah altar.{\i0}
Dialogue: 0,0:08:27.34,0:08:32.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Salah satu{\i0} streamer\N{\i1}menghampiri altar di sudut ruangan.{\i0}
Dialogue: 0,0:08:32.92,0:08:34.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tepat saat itu.{\i0}
Dialogue: 0,0:08:34.18,0:08:36.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tunggu, ada sesuatu di belakangmu!{\i0}
Dialogue: 0,0:08:37.18,0:08:40.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Efek buatan komputernya jelas sekali.
Dialogue: 0,0:08:40.52,0:08:44.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti sulit bagi mereka\Nuntuk bereaksi terhadap itu.
Dialogue: 0,0:08:48.69,0:08:50.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kau?
Dialogue: 0,0:08:50.32,0:08:52.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gedung apartemen ini harusnya kosong!
Dialogue: 0,0:08:53.65,0:08:55.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia membuatku terkejut.
Dialogue: 0,0:08:55.95,0:09:00.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kamar mana\Nyang sebaiknya kutempati malam ini?
Dialogue: 0,0:09:01.33,0:09:04.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar saja, aku mau tidur.\NAku hanya kelelahan. Pasti.
Dialogue: 0,0:09:06.25,0:09:10.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sunyi sekali karena mereka pergi.
Dialogue: 0,0:09:28.35,0:09:29.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon,
Dialogue: 0,0:09:29.86,0:09:31.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}cepatlah pulang.
Dialogue: 0,0:09:37.15,0:09:38.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak, selanjutnya kita.
Dialogue: 0,0:09:43.08,0:09:46.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lorong gelap gulita ini disebut Tur Anus.
Dialogue: 0,0:09:46.91,0:09:50.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buddha Kucing meratapi jumlah\Nmanusia hewan, lalu dia melahirkan mereka
Dialogue: 0,0:09:50.71,0:09:55.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukan hanya melalui jalan lahir,\Ntapi juga melalui anus.
Dialogue: 0,0:09:55.17,0:09:57.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lorong ini diciptakan\Nberdasarkan kisah itu.
Dialogue: 0,0:09:58.30,0:10:01.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada batu manusia hewan sakral\Ndikeramatkan di dalam.
Dialogue: 0,0:10:01.68,0:10:04.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan menyentuhnya sebelum pergi.
Dialogue: 0,0:10:05.10,0:10:06.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak begitu paham.
Dialogue: 0,0:10:06.52,0:10:08.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar saja. Ayo masuk!
Dialogue: 0,0:10:08.48,0:10:10.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lakukan semua hal yang ada biayanya!
Dialogue: 0,0:10:10.77,0:10:13.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beli enam tiket! Minta struknya!
Dialogue: 0,0:10:13.65,0:10:15.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak, tingkahmu benar-benar aneh!
Dialogue: 0,0:10:15.90,0:10:18.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tunggu…\N- Semoga perjalanan kalian aman.
Dialogue: 0,0:10:20.49,0:10:23.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tur Anus ini, bla, bla, bla.
Dialogue: 0,0:10:25.45,0:10:27.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita lihat.
Dialogue: 0,0:10:27.33,0:10:28.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:10:31.83,0:10:34.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat-tempat gelap sangat menarik.
Dialogue: 0,0:10:34.55,0:10:38.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh gelap.\NAku tak bisa melihat apa pun.
Dialogue: 0,0:10:39.22,0:10:40.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:10:40.22,0:10:42.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu. Kita jalan menyusuri dinding.
Dialogue: 0,0:10:43.26,0:10:44.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau bergandengan?
Dialogue: 0,0:10:44.22,0:10:45.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak apa-apa.
Dialogue: 0,0:10:46.39,0:10:50.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jadi, Imoko tipe yang bersemangat\Ndalam situasi seperti ini.{\i0}
Dialogue: 0,0:10:50.65,0:10:52.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaanku saja, atau ada sesuatu bau?
Dialogue: 0,0:10:54.36,0:10:57.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baunya seperti rokok.
Dialogue: 0,0:10:57.23,0:11:00.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit dipercaya ada orang\Nyang merokok di tempat seperti ini!
Dialogue: 0,0:11:01.28,0:11:04.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada setumpuk puntung di sini!\NTerinjak olehku! Jijik!
Dialogue: 0,0:11:05.12,0:11:09.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Imoko, kulihat ada cahaya di sana.
Dialogue: 0,0:11:09.00,0:11:10.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benar. Ayo!
Dialogue: 0,0:11:14.09,0:11:15.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, Yomuko-chan!
Dialogue: 0,0:11:17.00,0:11:18.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu batu manusia hewan!
Dialogue: 0,0:11:19.13,0:11:22.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Sebuah batu sederhana\Nyang dipercaya melahirkan manusia hewan.
Dialogue: 0,0:11:22.97,0:11:28.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di masa sulit, batu ini menjadi wadah\Nbagi Buddha Kucing memberikan ceramah."
Dialogue: 0,0:11:28.06,0:11:30.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terasa mereka sangat menghargai itu.
Dialogue: 0,0:11:31.02,0:11:32.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa kupakai ini untuk ide cerita?
Dialogue: 0,0:11:32.77,0:11:35.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beban berat dari sejarah…
Dialogue: 0,0:11:36.65,0:11:39.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagian belakangnya penuh bekas\Norang mematikan rokok!
Dialogue: 0,0:11:39.82,0:11:41.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benar.
Dialogue: 0,0:11:41.15,0:11:43.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelakunya perokok macam apa?
Dialogue: 0,0:11:43.28,0:11:46.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlihat mereka mencoba\Nmenghapusnya diam-diam!
Dialogue: 0,0:11:46.20,0:11:50.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meninggalkan bekas seperti itu\Nadalah bukti kesalahan mereka.
Dialogue: 0,0:11:52.79,0:11:55.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Juga banyak puntung rokok\Nsepanjang jalan pulang!
Dialogue: 0,0:11:55.79,0:11:57.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengalaman ini jadi rusak total!
Dialogue: 0,0:11:57.67,0:12:00.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata, merokok tidak dilarang di sini.
Dialogue: 0,0:12:00.71,0:12:02.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi jangan menyampah!
Dialogue: 0,0:12:02.05,0:12:05.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku penasaran seperti apa\Norang tua yang membesarkan mereka!
Dialogue: 0,0:12:09.06,0:12:12.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku merasa mendengar suara adikku barusan.
Dialogue: 0,0:12:12.69,0:12:15.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Yani,\Nbuang puntung rokok kita di minimarket.
Dialogue: 0,0:12:15.81,0:12:17.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Puntungku sudah kubuang.
Dialogue: 0,0:12:17.15,0:12:18.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:12:22.40,0:12:25.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang\Nbisa merokok sepuasnya di rumah!
Dialogue: 0,0:12:27.12,0:12:28.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di kastel Nijyu ini,
Dialogue: 0,0:12:28.70,0:12:33.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tokugawa Yoshinobu\Nmendeklarasikan Meongsei Hokan.
Dialogue: 0,0:12:33.21,0:12:38.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini ada banyak sejarah manusia hewan\Nyang tak diajarkan di sekolah.
Dialogue: 0,0:12:38.09,0:12:39.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau tanya!
Dialogue: 0,0:12:39.09,0:12:41.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu Meongsei Hokan?
Dialogue: 0,0:12:42.34,0:12:44.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Deklarasi di mana faksi Tokugawa
Dialogue: 0,0:12:44.47,0:12:48.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengalihkan kepemilikan manusia hewan\Nkepada pemerintahan baru.
Dialogue: 0,0:12:48.93,0:12:51.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, mari kita ke dalam.
Dialogue: 0,0:12:52.35,0:12:55.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Upacara Teh Meong sangat populer\Ndi masa Keshogunan Edo.
Dialogue: 0,0:12:55.56,0:12:58.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini ada artefak yang dulu
Dialogue: 0,0:12:58.02,0:13:00.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}milik ahli Upacara Teh Meong,\NFuruta Meongsuke.
Dialogue: 0,0:13:00.98,0:13:01.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Upacara Teh Meong?
Dialogue: 0,0:13:01.98,0:13:05.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak zaman kuno, manusia hewan\Ndan manusia berhubungan dekat.
Dialogue: 0,0:13:05.61,0:13:09.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu ada budaya mendandani manusia hewan\Ndengan pakaian khusus
Dialogue: 0,0:13:09.37,0:13:11.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mengajari mereka berbagai trik.
Dialogue: 0,0:13:11.79,0:13:13.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu terlihat tidak wajar.
Dialogue: 0,0:13:13.37,0:13:16.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harga satu stelnya saja\Nbisa membeli sebuah negara.
Dialogue: 0,0:13:16.71,0:13:17.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh?
Dialogue: 0,0:13:17.63,0:13:23.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rupanya, pakaian yang lebih terbuka akan\Nhasilkan suara lebih bagus saat dipukul.
Dialogue: 0,0:13:23.05,0:13:24.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:13:24.63,0:13:27.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dipukul? Apa-apaan?
Dialogue: 0,0:13:27.72,0:13:29.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yomuko-chan?
Dialogue: 0,0:13:29.14,0:13:31.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikuti aku ke area selanjutnya.
Dialogue: 0,0:13:34.31,0:13:36.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untunglah kita boleh merekam ini.
Dialogue: 0,0:13:36.81,0:13:40.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi begini rupanya sejarah manusia hewan.
Dialogue: 0,0:13:40.23,0:13:42.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami dianiaya sedemikian parah.
Dialogue: 0,0:13:42.44,0:13:44.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk apa bikini tali itu?
Dialogue: 0,0:13:45.74,0:13:46.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah…
Dialogue: 0,0:13:46.65,0:13:49.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi keadaannya sudah baik sekarang.
Dialogue: 0,0:13:49.45,0:13:52.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang tidak membunuhmu\Nakan membuatmu lebih kuat.
Dialogue: 0,0:13:52.16,0:13:55.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak sekali bagi kalian, para manusia!
Dialogue: 0,0:13:56.12,0:14:00.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini patung lilin\Nyang menggambarkan Meongsei Hokan.
Dialogue: 0,0:14:00.42,0:14:02.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menyerahkan apa?
Dialogue: 0,0:14:02.42,0:14:05.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu semacam hiasan kepala.
Dialogue: 0,0:14:05.59,0:14:06.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:14:07.51,0:14:11.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Setelah banyak manusia hewan\Ngugur dalam Perang Boshin,{\i0}
Dialogue: 0,0:14:11.43,0:14:14.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}kabarnya mereka pindah\Nke tempat lain setelah Meongsei Hokan{\i0}
Dialogue: 0,0:14:14.52,0:14:17.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan masih tinggal\Ndengan tenang di sana hingga sekarang.
Dialogue: 0,0:14:17.89,0:14:21.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, mereka leluhur kami?
Dialogue: 0,0:14:23.15,0:14:25.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada teori yang lebih kuat
Dialogue: 0,0:14:25.03,0:14:28.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahwa manusia hewan\Nbersembunyi di berbagai wilayah,
Dialogue: 0,0:14:28.20,0:14:31.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sehingga jumlah mereka terus bertambah.
Dialogue: 0,0:14:31.49,0:14:33.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti penindasan\Nterhadap penganut agama.
Dialogue: 0,0:14:35.08,0:14:39.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini senjata-senjata yang dipakai\Nmanusia hewan saat peperangan.
Dialogue: 0,0:14:39.67,0:14:43.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tombak bambu, tombak bambu panjang,\Ntombak bambu melengkung.
Dialogue: 0,0:14:43.04,0:14:44.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa banyak tombak bambu?
Dialogue: 0,0:14:44.59,0:14:46.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tombak bambu yang ini?
Dialogue: 0,0:14:46.59,0:14:48.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Itu tombak bambu mengeong.
Dialogue: 0,0:14:48.88,0:14:53.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tombak bambu yang diberikan\Nkepada manusia hewan yang berjasa besar.
Dialogue: 0,0:14:53.26,0:14:56.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Saat tombolnya ditekan, muncul suara imut.
Dialogue: 0,0:14:59.06,0:14:59.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang mau?
Dialogue: 0,0:14:59.98,0:15:04.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada juga tombak tri-meong\Nyang memiliki fungsi lebih hebat,
Dialogue: 0,0:15:05.19,0:15:07.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi setelah itu diberikan
Dialogue: 0,0:15:07.19,0:15:09.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ke pemimpin manusia hewan,\Ndijuluki Iblis Medan Perang,
Dialogue: 0,0:15:11.11,0:15:14.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia menghilang\Nbersama tombak itu setelah perang.
Dialogue: 0,0:15:14.91,0:15:15.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiks.
Dialogue: 0,0:15:16.49,0:15:19.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bisa menghasilkan tiga suara berbeda,
Dialogue: 0,0:15:19.12,0:15:21.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan bisa menjadi jam alarm!
Dialogue: 0,0:15:21.17,0:15:22.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang mau?
Dialogue: 0,0:15:22.08,0:15:24.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin itu sudah dibuang\Nkarena tak ada yang mau.
Dialogue: 0,0:15:26.34,0:15:27.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketua.
Dialogue: 0,0:15:27.25,0:15:28.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:15:29.30,0:15:32.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhir-akhir ini tombakku jadi aneh.
Dialogue: 0,0:15:32.01,0:15:34.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fungsi jam alarmnya rusak.
Dialogue: 0,0:15:37.93,0:15:39.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, berhasil diperbaiki.
Dialogue: 0,0:15:40.48,0:15:44.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}- Chainsmoker Cat.\N- Chainsmoker Cat.{\i0}
Dialogue: 0,0:15:47.07,0:15:48.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat.
Dialogue: 0,0:15:50.86,0:15:53.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka menunduk dan memohon demi biskuit.
Dialogue: 0,0:15:53.41,0:15:56.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar. Mereka imut sekali.
Dialogue: 0,0:15:57.62,0:16:00.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka mengerumuniku.
Dialogue: 0,0:16:01.79,0:16:03.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kak Yani! Kita harus…\N- Berikan.
Dialogue: 0,0:16:03.50,0:16:06.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikan padaku. Berikan padaku.
Dialogue: 0,0:16:06.00,0:16:07.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Berikan.\N- Apa ini?
Dialogue: 0,0:16:07.63,0:16:10.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Berikan padaku.\N- Menurutku itu bukan rusa.
Dialogue: 0,0:16:14.64,0:16:16.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia diberi biskuit rusa.
Dialogue: 0,0:16:16.14,0:16:18.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Berikan lagi.\N- Memalukan.
Dialogue: 0,0:16:21.77,0:16:24.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hentikan!\N- Dia sedang apa?
Dialogue: 0,0:16:24.48,0:16:28.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mungkin pura-pura memberi biskuit\Ndemi mendapatkan rekaman yang bagus.
Dialogue: 0,0:16:28.27,0:16:29.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sudah selesai?
Dialogue: 0,0:16:34.24,0:16:35.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:16:36.37,0:16:38.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biskuit-biskuit itu milik kami,
Dialogue: 0,0:16:38.91,0:16:41.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dasar kalian manusia hewan hina!
Dialogue: 0,0:16:41.16,0:16:42.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Siapa kau?
Dialogue: 0,0:16:43.71,0:16:44.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku adalah
Dialogue: 0,0:16:45.46,0:16:46.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sang Raja Rusa.
Dialogue: 0,0:16:47.63,0:16:49.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini wilayah kami.
Dialogue: 0,0:16:50.05,0:16:53.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai raja,\Naku tidak akan menoleransi kelancanganmu.
Dialogue: 0,0:16:53.92,0:16:55.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau biskuit?
Dialogue: 0,0:16:56.18,0:16:58.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan. Jika kau berikan itu kepadaku,
Dialogue: 0,0:17:00.81,0:17:03.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tubuhku akan otomatis membungkuk…
Dialogue: 0,0:17:05.06,0:17:06.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Yani.
Dialogue: 0,0:17:06.19,0:17:08.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke mana dia pergi?
Dialogue: 0,0:17:08.73,0:17:10.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin pergi buang air besar.
Dialogue: 0,0:17:17.74,0:17:19.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dahulu kala,
Dialogue: 0,0:17:19.32,0:17:22.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami adalah makhluk yang bermartabat.
Dialogue: 0,0:17:23.83,0:17:29.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami memiliki kecerdasan dan kebanggaan\Nuntuk berada di puncak ekosistem kami.
Dialogue: 0,0:17:29.08,0:17:33.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan pernah bertarung dengan kalian,\Nmanusia hewan, demi mendominasi.
Dialogue: 0,0:17:34.47,0:17:38.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kami satu per satu\Nkehilangan kecerdasan kami,
Dialogue: 0,0:17:39.14,0:17:42.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hingga menjadi binatang menyedihkan,\Nmemohon-mohon kepada wisatawan
Dialogue: 0,0:17:42.97,0:17:44.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}demi mendapat biskuit.
Dialogue: 0,0:17:45.93,0:17:49.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu kami pernah lebih cerdas\Ndari kalian, manusia hewan,
Dialogue: 0,0:17:50.44,0:17:52.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sekarang
Dialogue: 0,0:17:52.02,0:17:54.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya tinggal aku\Nyang memiliki kecerdasan.
Dialogue: 0,0:17:55.53,0:17:59.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih parah lagi, setiap hari\Naku merasa kecerdasanku perlahan memudar.
Dialogue: 0,0:18:00.99,0:18:03.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku iri dengan kalian semua.
Dialogue: 0,0:18:04.37,0:18:06.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih baik tak memiliki kecerdasan ini
Dialogue: 0,0:18:07.16,0:18:08.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jika hanya aku sendiri.
Dialogue: 0,0:18:12.50,0:18:13.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau…
Dialogue: 0,0:18:23.31,0:18:24.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis manusia hewan.
Dialogue: 0,0:18:25.72,0:18:27.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katakan kepadaku,
Dialogue: 0,0:18:27.60,0:18:29.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dari mana kita berasal?{\i0}
Dialogue: 0,0:18:31.23,0:18:33.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kita menuju ke mana?{\i0}
Dialogue: 0,0:18:35.69,0:18:38.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat! Kepalaku…
Dialogue: 0,0:18:39.45,0:18:41.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa kesadaranku memudar lagi.
Dialogue: 0,0:18:45.62,0:18:47.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat tinggal, Gadis Manusia Hewan.
Dialogue: 0,0:18:49.08,0:18:52.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga masa depanmu penuh berkah.
Dialogue: 0,0:18:53.21,0:18:54.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:19:06.39,0:19:07.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yani!
Dialogue: 0,0:19:07.77,0:19:11.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menghilang ke mana\Nsaat aku mendapat masalah?
Dialogue: 0,0:19:11.40,0:19:13.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada seekor rusa yang menyeramkan.
Dialogue: 0,0:19:15.90,0:19:18.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sudah selesai beli suvenir\Ndan siap pulang?
Dialogue: 0,0:19:20.65,0:19:22.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,
Dialogue: 0,0:19:22.78,0:19:25.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selama enam jam ke depan\Nkita berkendara pulang!
Dialogue: 0,0:19:32.92,0:19:37.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku merasa paling kreatif di tempat\Ndi mana aku tak bisa menggambar komik.
Dialogue: 0,0:19:37.80,0:19:39.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat paham maksudmu.
Dialogue: 0,0:19:39.51,0:19:41.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terasa lonjakan dopamin aneh.
Dialogue: 0,0:19:41.05,0:19:45.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar. Seakan-akan hanya itu\Nyang ada di pikiranmu.
Dialogue: 0,0:19:45.26,0:19:48.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menjadi gila\Ndi lingkungan yang tidak bebas.
Dialogue: 0,0:19:48.35,0:19:52.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pena yang kugunakan menulis\Nperlahan terlihat seperti benda lain.
Dialogue: 0,0:19:52.27,0:19:54.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa sadar,\Nlenganku dipenuhi bintik hitam.
Dialogue: 0,0:19:54.94,0:19:56.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo?
Dialogue: 0,0:19:56.15,0:19:58.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo.
Dialogue: 0,0:19:58.78,0:20:00.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya bisa kuhubungi.
Dialogue: 0,0:20:00.49,0:20:02.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau tak menjawab teleponku?
Dialogue: 0,0:20:03.45,0:20:07.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tak mau melihat ponsel\Nsaat sedang berlibur.{\i0}
Dialogue: 0,0:20:07.20,0:20:09.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi berkat itu, kudapat banyak ide baru.{\i0}
Dialogue: 0,0:20:09.70,0:20:11.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Penelitian ke Kyoto sukses!{\i0}
Dialogue: 0,0:20:11.54,0:20:12.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku sangat puas.{\i0}
Dialogue: 0,0:20:13.37,0:20:14.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang mendengarnya.
Dialogue: 0,0:20:15.79,0:20:18.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ada ide bagus\Nuntuk pengembangan berikutnya,{\i0}
Dialogue: 0,0:20:18.09,0:20:20.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}kugambarkan leluhur\Nbertarung dalam alur kilas balik.{\i0}
Dialogue: 0,0:20:20.88,0:20:23.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mau adakan rapat editorial sekarang?{\i0}
Dialogue: 0,0:20:26.68,0:20:28.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lupa memberitahumu,
Dialogue: 0,0:20:29.35,0:20:31.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}bab berikutnya jadi bab terakhirmu.{\i0}
Dialogue: 0,0:20:37.11,0:20:38.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Motifnya sangat imut.
Dialogue: 0,0:20:39.48,0:20:42.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh imut. Itu untuk ibumu?
Dialogue: 0,0:20:42.24,0:20:43.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:20:43.82,0:20:45.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini untuk kakakku.
Dialogue: 0,0:20:45.07,0:20:46.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konon bisa mengusir kesialan.
Dialogue: 0,0:20:46.87,0:20:48.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat menyentuh.
Dialogue: 0,0:20:48.62,0:20:51.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun, dia bisa tewas kapan saja.
Dialogue: 0,0:20:51.12,0:20:53.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata-katamu menyeramkan.
Dialogue: 0,0:20:53.46,0:20:55.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat itu!
Dialogue: 0,0:20:55.50,0:20:57.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada mobil yang terbalik!
Dialogue: 0,0:20:57.13,0:20:58.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru lihat mobil terbalik!
Dialogue: 0,0:21:02.17,0:21:03.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tatsuro.
Dialogue: 0,0:21:03.84,0:21:05.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami semua baik-baik saja.
Dialogue: 0,0:21:08.76,0:21:11.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus bagaimana sekarang?
Dialogue: 0,0:21:11.72,0:21:14.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya polisi\Nakan menyelidiki kejadian.
Dialogue: 0,0:21:14.81,0:21:17.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar. Tentu saja.
Dialogue: 0,0:21:19.15,0:21:22.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}- Chainsmoker Cat.\N- Chainsmoker Cat.{\i0}
Dialogue: 0,0:21:22.48,0:21:24.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Chainsmoker Cat!{\i0}
Dialogue: 0,0:21:29.62,0:21:32.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bulan yang bulat hari ini indah sekali.
Dialogue: 0,0:21:32.87,0:21:34.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bulat? Siapa telanjang bulat?{\i0}
Dialogue: 0,0:21:36.12,0:21:39.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang kau isap hari ini rokok bagus.
Dialogue: 0,0:21:39.00,0:21:41.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kubeli dengan uang\Ndari mengajak anjing jalan-jalan.
Dialogue: 0,0:21:41.63,0:21:42.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:21:42.63,0:21:44.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tunggu, dia berkata gaya anjing?{\i0}
Dialogue: 0,0:21:45.63,0:21:47.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka sedang membicarakan apa?{\i0}
Dialogue: 0,0:21:47.55,0:21:49.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku ingin tahu.{\i0}
Dialogue: 0,0:21:49.09,0:21:50.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kata kuncinya hanya bulat dan anjing.{\i0}
Dialogue: 0,0:21:52.14,0:21:54.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gaya anjing setelah telanjang bulat?
Dialogue: 0,0:21:54.39,0:21:55.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:21:55.48,0:21:58.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menjadi gila\Nsetelah komiknya dibatalkan.
Dialogue: 0,0:21:59.06,0:22:01.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu cuma kebetulan mendapat sial!
Dialogue: 0,0:22:01.23,0:22:03.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita buat dia beruntung\Ndengan suvenir Kyoto ini.
Dialogue: 0,0:22:04.23,0:22:05.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian akan membuatku buntung?
Dialogue: 0,0:22:05.82,0:22:07.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat, kembalilah bekerja.
Dialogue: 0,0:23:32.95,0:23:38.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terjemahan subtitle oleh Stysa Alverina
