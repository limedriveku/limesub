Dialogue: 0,0:00:51.96,0:00:52.96,sign,,0000,0000,0000,,JADI SANGAT BAU
Dialogue: 0,0:02:23.01,0:02:25.51,sign,,0000,0000,0000,,BAR ETAJIMA
Dialogue: 0,0:03:33.08,0:03:33.92,sign,,0000,0000,0000,,MEONG MART
Dialogue: 0,0:03:46.64,0:03:50.02,sign,,0000,0000,0000,,E-?-IMA
Dialogue: 0,0:05:39.08,0:05:40.00,sign,,0000,0000,0000,,{\an8}MUSIM PANAS LALU
Dialogue: 0,0:21:07.72,0:21:08.72,sign,,0000,0000,0000,,PERINGATAN TOPAN
Dialogue: 0,0:23:37.99,0:23:39.04,sign,,0000,0000,0000,,INI KARYA FIKSI.
Dialogue: 0,0:23:39.04,0:23:40.96,sign,,0000,0000,0000,,ANAK-ANAK\NDILARANG MEROKOK DAN MINUM-MINUM.
Dialogue: 0,0:00:09.00,0:00:11.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemantikku habis.
Dialogue: 0,0:00:11.63,0:00:14.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku malas pergi ke minimarket.
Dialogue: 0,0:00:14.13,0:00:16.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditambah lagi, gasku dimatikan.
Dialogue: 0,0:00:20.35,0:00:23.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika rokok ini kumatikan,\Ntak bisa merokok lagi.
Dialogue: 0,0:00:32.28,0:00:34.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat cerdas.
Dialogue: 0,0:00:49.79,0:00:51.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan merokok begini sampai pagi.
Dialogue: 0,0:02:25.52,0:02:27.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku bereskan ini.
Dialogue: 0,0:02:27.52,0:02:30.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ini kawan kalian, Hame-chan.\N- Kau akan makan itu?
Dialogue: 0,0:02:31.15,0:02:34.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi, kubawakan minuman kalian.
Dialogue: 0,0:02:34.23,0:02:37.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hakkaisan, Dassai, dan Koshi no Kanbai.
Dialogue: 0,0:02:37.78,0:02:40.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa kalian butuh tiga gelas?\N- Itu milikku.
Dialogue: 0,0:02:40.82,0:02:43.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami punya gelas! Kita semua bisa berbagi!
Dialogue: 0,0:02:45.95,0:02:47.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau minum langsung dari botolnya?
Dialogue: 0,0:02:49.58,0:02:50.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toilet.
Dialogue: 0,0:02:51.79,0:02:53.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke kiri, lalu kanan di tikungan.
Dialogue: 0,0:02:57.80,0:02:58.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu?
Dialogue: 0,0:03:00.93,0:03:02.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tersandung sempurna.
Dialogue: 0,0:03:03.01,0:03:03.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu?
Dialogue: 0,0:03:12.06,0:03:13.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menuju pintu keluar.
Dialogue: 0,0:03:13.61,0:03:15.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia akan baik-baik saja, dia bawa dompet.
Dialogue: 0,0:03:19.74,0:03:21.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ada pelanggan pulang!\N- Toilet.
Dialogue: 0,0:03:21.45,0:03:24.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Terima kasih sudah datang!\N- Ke kanan di tikungan.
Dialogue: 0,0:03:25.16,0:03:27.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke kanan di…
Dialogue: 0,0:03:27.87,0:03:29.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana?
Dialogue: 0,0:03:31.25,0:03:33.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah datang!
Dialogue: 0,0:03:39.67,0:03:41.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana aku?
Dialogue: 0,0:03:45.43,0:03:46.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau ke mana?
Dialogue: 0,0:03:50.02,0:03:51.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enoshima?
Dialogue: 0,0:04:25.01,0:04:26.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia di sana.
Dialogue: 0,0:04:26.05,0:04:27.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:04:43.90,0:04:45.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu yang terjadi.
Dialogue: 0,0:04:45.78,0:04:47.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matahari terbitnya indah.
Dialogue: 0,0:04:47.66,0:04:49.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk apa kau berswafoto?
Dialogue: 0,0:04:49.78,0:04:51.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan kenapa jauh-jauh ke Enoshima?
Dialogue: 0,0:04:51.91,0:04:54.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sangat kocak, membuatku iri.
Dialogue: 0,0:04:54.33,0:04:55.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh kunyalakan AC-nya?
Dialogue: 0,0:04:55.87,0:04:57.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu.
Dialogue: 0,0:04:58.67,0:05:03.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini panas dan lembap.
Dialogue: 0,0:05:03.55,0:05:06.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyebalkan, rambutku jadi kusut\Ndan mengembang.
Dialogue: 0,0:05:06.80,0:05:09.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aruko, pangkas rambutmu.\NSudah berapa tahun kau…
Dialogue: 0,0:05:13.43,0:05:16.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya kau ini Higumadon\Nsaat dia mendarat di Aomori?
Dialogue: 0,0:05:19.56,0:05:21.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Higumadon rambutnya sangat mengembang.
Dialogue: 0,0:05:22.44,0:05:23.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi…
Dialogue: 0,0:05:23.90,0:05:25.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira kalian paham.
Dialogue: 0,0:05:25.70,0:05:27.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau memang\Nsudah menyiapkan lelucon itu, ya?
Dialogue: 0,0:05:27.99,0:05:30.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Mendengarnya darimu membuatku sakit hati.
Dialogue: 0,0:05:31.08,0:05:33.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Dia jauh lebih besar\Nsaat mendarat di Aomori.
Dialogue: 0,0:05:33.41,0:05:35.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, kritik tepat.
Dialogue: 0,0:05:35.20,0:05:39.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaoruko, itu bukan pertama kalinya\Nkau berkata begitu.
Dialogue: 0,0:05:40.00,0:05:42.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Memangnya kau Higumadon sedang diangkut?
Dialogue: 0,0:05:42.38,0:05:45.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Skalanya sudah mengecil.
Dialogue: 0,0:05:45.34,0:05:48.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kupangkas rambutmu yang lebat itu.
Dialogue: 0,0:05:48.55,0:05:51.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, jangan terus menghajarku\Nsaat aku sudah jatuh.
Dialogue: 0,0:05:51.26,0:05:52.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu.
Dialogue: 0,0:05:55.60,0:05:58.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dus.\N- Kau menarik keluar dus dari sana?
Dialogue: 0,0:05:58.48,0:06:02.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rambut lebat membuatku bisa\Nmenaruh benda lebih besar di dalamnya.
Dialogue: 0,0:06:02.44,0:06:05.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berguna sekali! Tidak!
Dialogue: 0,0:06:05.11,0:06:06.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa menaruhnya di sana?
Dialogue: 0,0:06:06.49,0:06:11.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sering kehilangan barang,\Njadi kusimpan barang penting di sini.
Dialogue: 0,0:06:11.37,0:06:13.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau harus mencobanya juga, Kansai.
Dialogue: 0,0:06:13.70,0:06:18.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak keberatan belakang kepalamu\Nberubah jadi penyimpanan barang?
Dialogue: 0,0:06:18.08,0:06:20.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak peduli.
Dialogue: 0,0:06:21.92,0:06:24.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya kau belajar menolak.
Dialogue: 0,0:06:24.13,0:06:25.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita lihat.
Dialogue: 0,0:06:28.17,0:06:30.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau terlalu banyak\Nmenaruh barang di dalam rambutnya.
Dialogue: 0,0:06:30.97,0:06:34.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa ini, bentuk baru\Ndari pelanggaran hak asasi manusia?
Dialogue: 0,0:06:39.73,0:06:41.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, itu barang-barangku.
Dialogue: 0,0:06:41.77,0:06:44.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mencari tempat menaruhnya,\Nkutaruh di sana.
Dialogue: 0,0:06:45.53,0:06:47.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik. Kalau begitu kukembalikan.
Dialogue: 0,0:06:47.53,0:06:48.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:06:49.24,0:06:51.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rokokku yang tadi kuisap hilang!
Dialogue: 0,0:06:51.53,0:06:53.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin terjatuh di suatu tempat.
Dialogue: 0,0:06:53.83,0:06:55.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat temukan.
Dialogue: 0,0:06:55.24,0:06:57.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apartemen ini bisa terbakar\Ndalam hitungan detik.
Dialogue: 0,0:06:58.20,0:07:00.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau mencium bau hangus?
Dialogue: 0,0:07:04.42,0:07:05.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aru!
Dialogue: 0,0:07:05.55,0:07:06.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apinya begitu dahsyat.{\i0}
Dialogue: 0,0:07:07.26,0:07:09.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia terbakar hebat sampai hampir lucu.{\i0}
Dialogue: 0,0:07:09.30,0:07:11.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dan dia terlihat baik-baik saja.\NApa tidak kepanasan?{\i0}
Dialogue: 0,0:07:11.93,0:07:14.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lagi pula, dia tak langsung terkena api.{\i0}
Dialogue: 0,0:07:14.05,0:07:16.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apakah wajar rokok bisa\Nmembuat terbakar begini?{\i0}
Dialogue: 0,0:07:17.89,0:07:18.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tunggu, aku tahu!{\i0}
Dialogue: 0,0:07:19.77,0:07:23.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Miras yang diminum tiap hari\Nmenyebar dan terakumulasi dalam rambutnya,{\i0}
Dialogue: 0,0:07:23.27,0:07:25.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}itu membuat rambutnya terbakar.{\i0}
Dialogue: 0,0:07:26.36,0:07:28.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Q.E.D. Pembuktian selesai.
Dialogue: 0,0:07:28.44,0:07:30.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kau bisa tenang?
Dialogue: 0,0:07:30.45,0:07:32.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kunyalakan rokokku.
Dialogue: 0,0:07:32.03,0:07:32.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Yani?
Dialogue: 0,0:07:32.95,0:07:33.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan.
Dialogue: 0,0:07:33.95,0:07:34.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar saja?
Dialogue: 0,0:07:36.45,0:07:39.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa denganmu, Cerobong Asap?
Dialogue: 0,0:07:48.42,0:07:50.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, akan kupangkas bagian yang hangus.
Dialogue: 0,0:07:58.68,0:08:00.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Chainsmoker Cat!{\i0}
Dialogue: 0,0:08:04.10,0:08:08.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhir-akhir ini\Naku mengalami kebuntuan menulis.
Dialogue: 0,0:08:08.98,0:08:10.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:08:10.44,0:08:15.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepenggal cerita muncul di benakku,\Nlalu menghilang lagi dan lagi.
Dialogue: 0,0:08:15.32,0:08:18.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kucoba mengumpulkan yang bisa kuingat,\Ntapi tak ada yang melekat.
Dialogue: 0,0:08:19.91,0:08:21.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, itu bisa terjadi.
Dialogue: 0,0:08:21.87,0:08:26.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tepat! Waktunya tak pernah cukup, bukan?
Dialogue: 0,0:08:26.25,0:08:28.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebuah karya baru diakui setelah terbit.
Dialogue: 0,0:08:28.63,0:08:33.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, sebelum terbentuk, karya itu\Nhanyalah rangkaian kata acak dalam diriku!
Dialogue: 0,0:08:33.72,0:08:36.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak terasa, hari berlalu,\Naku belum mengerjakan apa pun!
Dialogue: 0,0:08:36.76,0:08:38.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedengarannya berat.
Dialogue: 0,0:08:38.89,0:08:40.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat waktu pemakaian ponselmu.
Dialogue: 0,0:08:40.64,0:08:41.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu…
Dialogue: 0,0:08:43.39,0:08:44.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sini ponselmu.
Dialogue: 0,0:08:44.39,0:08:45.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini.
Dialogue: 0,0:08:51.98,0:08:55.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia menghabiskan\N60 jam per minggu di Nyax.{\i0}
Dialogue: 0,0:09:00.95,0:09:03.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Chainsmoker Cat!{\i0}
Dialogue: 0,0:09:04.41,0:09:06.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Selamat sore, dua anggota Nyanzoku Bat.{\i0}
Dialogue: 0,0:09:06.92,0:09:08.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Selamat sore.{\i0}
Dialogue: 0,0:09:08.08,0:09:09.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Musim panas ini kembali membara.{\i0}
Dialogue: 0,0:09:09.92,0:09:15.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi kulihat orang bermandikan keringat\Nsambil merokok di area khusus merokok.{\i0}
Dialogue: 0,0:09:15.72,0:09:16.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka sampai begitu?{\i0}
Dialogue: 0,0:09:17.30,0:09:19.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa jauh ke lokasi Aruko?
Dialogue: 0,0:09:20.93,0:09:22.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekitar 20 menit.
Dialogue: 0,0:09:22.77,0:09:26.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang dia lakukan di Enoshima?
Dialogue: 0,0:09:26.23,0:09:27.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertanyaan bagus.
Dialogue: 0,0:09:32.82,0:09:36.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalau aku, saat di ranjang\Ndengan seorang wanita di sampingku.{\i0}
Dialogue: 0,0:09:36.65,0:09:37.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Di ranjang?{\i0}
Dialogue: 0,0:09:42.16,0:09:45.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau mengunjungi orang tuamu\Nsaat liburan?
Dialogue: 0,0:09:45.20,0:09:46.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:09:47.37,0:09:49.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:09:49.25,0:09:51.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hubungan kami agak canggung.
Dialogue: 0,0:09:51.04,0:09:54.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka orang-orang yang baik,\Npasti akan senang melihatmu.
Dialogue: 0,0:09:54.80,0:09:56.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutmu begitu?
Dialogue: 0,0:09:56.63,0:09:57.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:10:03.26,0:10:04.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh aku merokok?
Dialogue: 0,0:10:04.56,0:10:07.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh, tapi pakai asbak.
Dialogue: 0,0:10:07.69,0:10:08.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:10:38.38,0:10:41.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar semua gorila bergolongan darah B.
Dialogue: 0,0:10:41.55,0:10:42.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:10:51.35,0:10:53.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Omong-omong…\N- Kau tahu…
Dialogue: 0,0:10:54.19,0:10:55.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau duluan.
Dialogue: 0,0:10:55.40,0:10:58.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, itu hanya hal konyol. Kau duluan.
Dialogue: 0,0:10:58.40,0:10:59.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:11:26.81,0:11:30.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini waktunya untuk berpamitan.{\i0}
Dialogue: 0,0:11:30.23,0:11:35.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Program ini dipersembahkan\Noleh Komite Produksi Yamiplex Jujo.{\i0}
Dialogue: 0,0:11:35.40,0:11:37.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Semoga sisa harimu menyenangkan.{\i0}
Dialogue: 0,0:11:37.78,0:11:38.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sampai jumpa.{\i0}
Dialogue: 0,0:11:39.32,0:11:41.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Indahnya.\N- Indahnya.
Dialogue: 0,0:11:48.16,0:11:51.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Maaf, Bu Tatsuro.{\i0}
Dialogue: 0,0:11:51.16,0:11:54.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Para asisten yang biasa, tidak tersedia.{\i0}
Dialogue: 0,0:11:54.50,0:11:56.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:11:56.42,0:11:58.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi jangan cemas!
Dialogue: 0,0:11:58.50,0:12:03.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuhubungi penyalur, meminta yang\Nberpengalaman sebagai asisten mangaka.
Dialogue: 0,0:12:03.59,0:12:05.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pastikan kau selesai saat tenggat.\NTerima kasih.
Dialogue: 0,0:12:06.97,0:12:11.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini tidak masalah?\NMinggu ini aku sangat kewalahan.
Dialogue: 0,0:12:11.18,0:12:13.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yani Neko dan lainnya pulang saat liburan.
Dialogue: 0,0:12:14.02,0:12:16.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga bukan orang yang seram.
Dialogue: 0,0:12:19.53,0:12:24.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami diutus oleh perusahaan penyalur\Nmanusia hewan, Beast Hands.
Dialogue: 0,0:12:28.37,0:12:31.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tiga orang asing di kamarku.{\i0}
Dialogue: 0,0:12:31.70,0:12:33.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tak akan bermasalah, 'kan?{\i0}
Dialogue: 0,0:12:33.04,0:12:37.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kebanyakan manusia hewan\Ncukup mudah diajak bekerja sama.{\i0}
Dialogue: 0,0:12:38.92,0:12:40.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Bu Tatsuro.\N- Ya?
Dialogue: 0,0:12:40.92,0:12:41.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah selesai?
Dialogue: 0,0:12:43.01,0:12:44.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuperiksa sekarang.
Dialogue: 0,0:12:44.80,0:12:46.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita lihat.
Dialogue: 0,0:12:47.89,0:12:50.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia masih mengisi\Nbagian hitam panel pertama?{\i0}
Dialogue: 0,0:12:50.26,0:12:52.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia sudah bekerja selama dua jam.{\i0}
Dialogue: 0,0:12:54.69,0:12:56.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diisi dengan bagus.
Dialogue: 0,0:12:56.19,0:12:57.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruskan kerja bagusmu.
Dialogue: 0,0:12:58.56,0:13:00.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dipuji oleh bos.
Dialogue: 0,0:13:00.40,0:13:01.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku iri.
Dialogue: 0,0:13:01.65,0:13:03.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sangat baik.
Dialogue: 0,0:13:03.07,0:13:06.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka kelihatannya orang baik.{\i0}
Dialogue: 0,0:13:06.86,0:13:09.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada di antara kalian yang bukan perokok?
Dialogue: 0,0:13:10.49,0:13:11.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sudah kuduga.{\i0}
Dialogue: 0,0:13:13.41,0:13:14.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu Tatsuro.
Dialogue: 0,0:13:14.33,0:13:16.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Yang ini kusuruh mengerjakan arsiran.{\i0}
Dialogue: 0,0:13:18.38,0:13:22.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Memang kurang rapi, tapi lebih cepat\Ndaripada yang mengisi bagian hitam.{\i0}
Dialogue: 0,0:13:23.01,0:13:25.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, lanjutkan kerja bagus…
Dialogue: 0,0:13:26.80,0:13:28.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia memotong dari tengah lembaran?{\i0}
Dialogue: 0,0:13:28.97,0:13:32.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika dia memakainya dengan boros begitu…{\i0}
Dialogue: 0,0:13:33.18,0:13:36.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak, diam saja.\NYang penting selesai sesuai tenggat.{\i0}
Dialogue: 0,0:13:37.98,0:13:42.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku ingin menambahkan latar lain.
Dialogue: 0,0:13:42.07,0:13:43.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah sampai mana?
Dialogue: 0,0:13:54.08,0:13:55.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:13:57.96,0:14:00.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Akan baik-baik saja.{\i0}
Dialogue: 0,0:14:00.04,0:14:03.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Gaya gambarku sejak awal jelek, tak apa.\NAkan kuusahakan berhasil.{\i0}
Dialogue: 0,0:14:03.38,0:14:05.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Harus kuselesaikan karya ini sekarang.{\i0}
Dialogue: 0,0:14:05.76,0:14:08.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tenggat waktunya tak bisa ditunda!\NKau bisa, Saori!{\i0}
Dialogue: 0,0:14:17.06,0:14:19.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sudah berapa lama aku tidak tidur?{\i0}
Dialogue: 0,0:14:20.06,0:14:22.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pandanganku buram, dan kepalaku sakit.{\i0}
Dialogue: 0,0:14:22.86,0:14:25.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa yang sebenarnya kulakukan?{\i0}
Dialogue: 0,0:14:26.03,0:14:31.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa yang kulakukan,\Nsampai membuat noda kotor di kertas ini?{\i0}
Dialogue: 0,0:14:31.03,0:14:32.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kerjakan sambil makan.
Dialogue: 0,0:14:33.45,0:14:34.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuselesaikan panel ketiga!
Dialogue: 0,0:14:34.79,0:14:38.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan minta bos\Nmemeriksanya lagi, bukan?
Dialogue: 0,0:14:38.16,0:14:40.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak adil!
Dialogue: 0,0:14:40.92,0:14:41.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu Tatsuro!
Dialogue: 0,0:14:42.59,0:14:43.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Yang diwarnai hitam, kan?
Dialogue: 0,0:14:46.92,0:14:49.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia baru mengerjakan dua panel lagi.{\i0}
Dialogue: 0,0:14:49.43,0:14:50.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar,
Dialogue: 0,0:14:51.43,0:14:53.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}daripada menunjukkan panel satu per satu,
Dialogue: 0,0:14:54.56,0:14:57.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisakah menyelesaikan\Nseluruh halaman dulu?
Dialogue: 0,0:14:58.31,0:14:59.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau membuang waktu.
Dialogue: 0,0:15:03.06,0:15:06.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Juga, bisakah kalian\Njangan berisik saat bekerja?
Dialogue: 0,0:15:06.57,0:15:08.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sulit berkonsentrasi.
Dialogue: 0,0:15:38.35,0:15:41.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa yang kulakukan?{\i0}
Dialogue: 0,0:15:43.06,0:15:43.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kawan-Kawan.
Dialogue: 0,0:15:45.23,0:15:47.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan kelakuanku yang buruk tadi!
Dialogue: 0,0:15:48.90,0:15:52.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melampiaskan frustasiku pada kalian.
Dialogue: 0,0:15:52.99,0:15:54.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berjanji tak marah lagi.
Dialogue: 0,0:15:54.91,0:15:58.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong bantu aku menyelesaikan ini!
Dialogue: 0,0:16:09.67,0:16:13.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus, Semuanya.\NTerima kasih waktu yang kalian luangkan.
Dialogue: 0,0:16:13.68,0:16:16.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuberi tahu manajer kalian\Nbahwa kalian bekerja baik.
Dialogue: 0,0:16:16.72,0:16:18.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kalian\Nbisa bantu lagi kapan-kapan.
Dialogue: 0,0:16:22.77,0:16:23.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang.
Dialogue: 0,0:16:27.44,0:16:30.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus kutebalkan dengan tinta\Ndan selesaikan tiga halaman lagi.
Dialogue: 0,0:16:31.15,0:16:32.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua jam lagi sampai tenggatnya.
Dialogue: 0,0:16:33.70,0:16:37.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Konon, orang hanya bisa memakai\Ntenaga cadangan lima kali dalam hidupnya.{\i0}
Dialogue: 0,0:16:38.87,0:16:41.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku ambil satu dari lima kali itu{\i0}
Dialogue: 0,0:16:41.04,0:16:42.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan memakainya sekarang!{\i0}
Dialogue: 0,0:16:47.08,0:16:49.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu Tatsuro sangat baik.
Dialogue: 0,0:16:49.88,0:16:50.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:16:50.84,0:16:54.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus berlatih\Nagar bisa lebih berguna lain kali.
Dialogue: 0,0:17:18.07,0:17:20.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rokok ini sangat nikmat.
Dialogue: 0,0:17:21.24,0:17:25.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu Tatsuro!\NAku datang mengambil hasil gambarmu!
Dialogue: 0,0:17:25.71,0:17:30.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Chainsmoker Cat. Chainsmoker Cat.\NChainsmoker Cat.{\i0}
Dialogue: 0,0:17:33.92,0:17:36.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pen-Pen Neko, kau selalu merebus rumput.
Dialogue: 0,0:17:36.88,0:17:38.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak punya uang?
Dialogue: 0,0:17:39.55,0:17:42.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terikat nilai-nilai\Nyang dipaksakan masyarakat.
Dialogue: 0,0:17:43.35,0:17:44.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beberapa hal
Dialogue: 0,0:17:44.77,0:17:47.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya bisa ditemukan\Nsetelah kau lepaskan hartamu
Dialogue: 0,0:17:47.27,0:17:48.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan berdampingan dengan alam.
Dialogue: 0,0:17:50.31,0:17:52.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kau memakai tenda dan lainnya.
Dialogue: 0,0:17:52.52,0:17:54.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tidak apa-apa\Nkarena kutemukan di jalan.
Dialogue: 0,0:17:57.11,0:17:58.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Itu kucing liar.
Dialogue: 0,0:17:58.95,0:18:01.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Daerah ini wilayah kekuasaannya.
Dialogue: 0,0:18:02.12,0:18:05.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Meski dia mungil,\Ntapi dia lebih tua dariku beberapa tahun.
Dialogue: 0,0:18:06.37,0:18:08.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Merasakan angin,\Nmenganggap tanah ini rumah,
Dialogue: 0,0:18:09.21,0:18:11.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}penjelajah arti kehidupan.
Dialogue: 0,0:18:12.13,0:18:14.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seorang senior yang layak dikagumi\Nkarena hal-hal itu…
Dialogue: 0,0:18:15.59,0:18:16.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menggigitmu.
Dialogue: 0,0:18:16.88,0:18:18.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setiap perasaan ada alasannya.
Dialogue: 0,0:18:19.59,0:18:22.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan rasa sakit ini\Nbagian dari permadani kehidupan.
Dialogue: 0,0:18:22.51,0:18:25.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benar-benar berdarah.
Dialogue: 0,0:18:25.02,0:18:26.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baik-baik saja.
Dialogue: 0,0:18:26.27,0:18:28.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Angin sepoi-sepoi akan menyembuhkannya.
Dialogue: 0,0:18:30.56,0:18:32.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau pulang karena kau kehabisan rokok.
Dialogue: 0,0:18:33.40,0:18:36.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa,\Nkembalilah kapan pun mau merokok lagi.
Dialogue: 0,0:18:41.41,0:18:43.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perutku sakit.
Dialogue: 0,0:18:43.66,0:18:47.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aduh, aduh, aduh.
Dialogue: 0,0:18:47.70,0:18:49.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemantikku tertinggal.
Dialogue: 0,0:18:49.92,0:18:51.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:18:51.21,0:18:52.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemantikmu di sana.
Dialogue: 0,0:18:53.21,0:18:54.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau duduk di pojok?
Dialogue: 0,0:18:54.92,0:18:56.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada apa-apa.
Dialogue: 0,0:18:56.30,0:18:59.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bertingkah mencurigakan\Ndan tatap aku!
Dialogue: 0,0:18:59.01,0:18:59.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:19:02.09,0:19:04.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tak seperti yang kau kira.
Dialogue: 0,0:19:05.51,0:19:08.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Dengan menyatu bersama alam,
Dialogue: 0,0:19:08.98,0:19:10.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}tangisku tak berhenti mengalir.
Dialogue: 0,0:19:12.69,0:19:14.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak kehabisan rokok!
Dialogue: 0,0:19:15.61,0:19:17.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan datang lagi.
Dialogue: 0,0:19:31.12,0:19:34.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Badai seperti ini\Nhanya terjadi sekali seabad!{\i0}
Dialogue: 0,0:19:34.00,0:19:36.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hujan deras!\NMendongak saja bisa tenggelam!{\i0}
Dialogue: 0,0:19:36.63,0:19:38.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menyukai hujan!
Dialogue: 0,0:19:38.51,0:19:40.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menangkap beberapa katak.
Dialogue: 0,0:19:40.67,0:19:43.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pesona bahaya yang menggoda.
Dialogue: 0,0:19:44.47,0:19:47.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham yang kau rasakan,\Ntapi jangan kau lakukan, berbahaya.
Dialogue: 0,0:19:48.18,0:19:53.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Yani Neko, katanya, sejarah umat manusia\Nbermula dari rasa lapar.
Dialogue: 0,0:19:54.02,0:19:57.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lalu keserakahan, nafsu,\Ndan hasrat untuk menaklukkan.{\i0}
Dialogue: 0,0:19:57.77,0:20:00.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Daftarnya tak ada habisnya,{\i0}
Dialogue: 0,0:20:00.03,0:20:02.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tapi semua hasrat itu punya kesamaan{\i0}
Dialogue: 0,0:20:02.36,0:20:05.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}yaitu selalu menjadi pemicu konflik.{\i0}
Dialogue: 0,0:20:06.49,0:20:09.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Alasan aku hidup seperti ini
Dialogue: 0,0:20:09.29,0:20:12.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}adalah aku ingin membuktikan\Nmanusia mampu menahan diri
Dialogue: 0,0:20:12.25,0:20:15.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari hasrat berbahaya yang menggoda itu.
Dialogue: 0,0:20:16.13,0:20:17.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihatlah.
Dialogue: 0,0:20:17.63,0:20:19.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan terus menjalani hidup\Nbebas dari hasrat,
Dialogue: 0,0:20:19.96,0:20:22.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pikiranmu menjadi tak tergoyahkan.
Dialogue: 0,0:20:23.59,0:20:27.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kusarankan kau juga\Nmelepaskan semua keterikatanmu.
Dialogue: 0,0:20:27.72,0:20:30.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa makan katak kapan saja.
Dialogue: 0,0:20:30.14,0:20:32.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau menangkap katak\Nbukan untuk dimakan.
Dialogue: 0,0:20:32.98,0:20:34.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sungai Nyagami banjir!{\i0}
Dialogue: 0,0:20:34.65,0:20:38.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kita bisa melihat\Nsegala macam puing terseret arusnya!{\i0}
Dialogue: 0,0:20:39.61,0:20:41.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kasihan.
Dialogue: 0,0:20:41.03,0:20:44.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia terjebak pekerjaan buruk itu\Nkarena keinginan materialistisnya.
Dialogue: 0,0:20:45.57,0:20:46.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sungai Nyagami?
Dialogue: 0,0:20:46.66,0:20:48.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tempat kau tinggal.
Dialogue: 0,0:20:50.70,0:20:52.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sampah besar terseret arus!{\i0}
Dialogue: 0,0:20:52.75,0:20:54.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lenyap begitu saja!{\i0}
Dialogue: 0,0:20:54.33,0:20:57.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sekarang, mari kita simak Nyanko hari ini!{\i0}
Dialogue: 0,0:20:57.25,0:20:59.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kita kembali ke studio!{\i0}
Dialogue: 0,0:20:59.25,0:21:01.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tendaku!
Dialogue: 0,0:21:03.55,0:21:05.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hentikan! Itu berbahaya!{\i0}
Dialogue: 0,0:21:05.30,0:21:07.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}- Tendaku! Rumahku!\N- Tolong aku!{\i0}
Dialogue: 0,0:21:09.72,0:21:12.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Chainsmoker Cat.{\i0}
Dialogue: 0,0:22:05.86,0:22:07.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musim panas berakhir.
Dialogue: 0,0:23:32.91,0:23:37.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terjemahan subtitle oleh Stysa Alverina
