Dialogue: 0,0:14:06.80,0:14:09.72,sign,,0000,0000,0000,,CARA MENGOLAH TEMBAKAU DESA
Dialogue: 0,0:14:56.43,0:14:58.10,sign,,0000,0000,0000,,10 MENIT KEMUDIAN
Dialogue: 0,0:19:33.75,0:19:37.17,sign,,0000,0000,0000,,STASIUN NYAGAMIHARA
Dialogue: 0,0:20:02.53,0:20:04.78,sign,,0000,0000,0000,,ALFA ARTINYA PERTAMA\NDALAM BAHASA YUNANI
Dialogue: 0,0:23:38.04,0:23:39.04,sign,,0000,0000,0000,,INI KARYA FIKSI.
Dialogue: 0,0:23:39.04,0:23:41.00,sign,,0000,0000,0000,,ANAK-ANAK\NDILARANG MEROKOK DAN MINUM-MINUM.
Dialogue: 0,0:00:03.75,0:00:05.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sita semua ini.
Dialogue: 0,0:00:06.54,0:00:09.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana bisa kau sekejam ini?
Dialogue: 0,0:00:10.46,0:00:11.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembalikan!
Dialogue: 0,0:00:11.59,0:00:14.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini demi kebaikanmu sendiri!
Dialogue: 0,0:00:14.97,0:00:15.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai nanti!
Dialogue: 0,0:00:20.02,0:00:23.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia menangis seperti kucing yang dikurung.{\i0}
Dialogue: 0,0:00:24.19,0:00:26.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak, aku harus tegas padanya.{\i0}
Dialogue: 0,0:00:26.48,0:00:28.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku yakin nanti dia akan mengerti.{\i0}
Dialogue: 0,0:00:29.57,0:00:33.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa aku keterlaluan,\Nmengambil semua rokoknya?{\i0}
Dialogue: 0,0:00:33.74,0:00:35.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkin bisa kukembalikan sebungkus.{\i0}
Dialogue: 0,0:00:36.70,0:00:38.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak.
Dialogue: 0,0:00:45.08,0:00:47.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengambilan selesai.
Dialogue: 0,0:00:47.33,0:00:49.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untunglah kusembunyikan ini
Dialogue: 0,0:00:49.34,0:00:52.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat aku tahu adikku akan datang.
Dialogue: 0,0:00:52.21,0:00:54.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana korek apiku?
Dialogue: 0,0:00:55.76,0:00:57.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:02:39.70,0:02:41.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah datang.
Dialogue: 0,0:02:42.16,0:02:43.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi,
Dialogue: 0,0:02:43.37,0:02:47.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada yang ingin kukatakan\Nsecara pribadi kepadamu.
Dialogue: 0,0:02:50.67,0:02:52.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini.
Dialogue: 0,0:02:52.00,0:02:55.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku menyukaimu.
Dialogue: 0,0:02:55.42,0:02:57.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin berkencan denganmu.
Dialogue: 0,0:02:58.21,0:03:00.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan mungkin,\Nsuatu hari nanti, kita menikah.
Dialogue: 0,0:03:01.13,0:03:03.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini…
Dialogue: 0,0:03:04.30,0:03:06.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:03:07.56,0:03:09.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi…
Dialogue: 0,0:03:10.02,0:03:11.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku minta maaf.
Dialogue: 0,0:03:13.56,0:03:14.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:03:32.33,0:03:34.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lupakan saja dia.
Dialogue: 0,0:03:35.54,0:03:37.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya potong rambut dulu\Nsebelum bicara?
Dialogue: 0,0:03:37.63,0:03:39.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar, kau tak punya peluang.
Dialogue: 0,0:03:40.13,0:03:42.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, masih banyak gadis lain.
Dialogue: 0,0:03:42.38,0:03:45.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi hanya ada satu Imoko!
Dialogue: 0,0:03:46.35,0:03:48.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelankan suaramu, Bodoh!
Dialogue: 0,0:03:50.64,0:03:54.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ada apa dengan dia dan Imoko?\NBukankah itu nama utusan abad keenam?{\i0}
Dialogue: 0,0:04:02.40,0:04:05.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, hati-hati kalau berjalan!
Dialogue: 0,0:04:05.03,0:04:06.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:04:06.66,0:04:07.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buta di siang hari?
Dialogue: 0,0:04:07.87,0:04:09.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan, Mikoto.
Dialogue: 0,0:04:09.91,0:04:12.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan berkata seperti itu.
Dialogue: 0,0:04:12.79,0:04:13.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shu.
Dialogue: 0,0:04:13.83,0:04:15.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baik-baik saja, Imoko?
Dialogue: 0,0:04:15.67,0:04:17.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:04:17.54,0:04:18.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kubantu kau.
Dialogue: 0,0:04:18.92,0:04:21.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Terima kasih.\N- Maafkan Mikoto.
Dialogue: 0,0:04:21.42,0:04:22.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa-apaan?{\i0}
Dialogue: 0,0:04:22.34,0:04:23.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tak apa.\N- Sudah semua?
Dialogue: 0,0:04:24.26,0:04:25.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa-apaan?{\i0}
Dialogue: 0,0:04:26.97,0:04:32.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tahu aku payah!
Dialogue: 0,0:04:32.31,0:04:34.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku tak bisa menahannya!
Dialogue: 0,0:04:34.52,0:04:37.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pikiranku sedang kacau balau!
Dialogue: 0,0:04:38.61,0:04:41.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tenanglah. Aku di pihakmu.
Dialogue: 0,0:04:43.70,0:04:46.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari makan sesuatu di Yoneda\Nsaat perjalanan pulang.
Dialogue: 0,0:04:47.07,0:04:48.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yang traktir.
Dialogue: 0,0:04:50.74,0:04:52.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katakan sesuatu!
Dialogue: 0,0:04:54.21,0:04:56.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kenapa kau menolaknya?{\i0}
Dialogue: 0,0:04:57.46,0:04:59.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pria yang sangat baik.
Dialogue: 0,0:04:59.38,0:05:01.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan lumayan tampan.
Dialogue: 0,0:05:02.34,0:05:05.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Harusnya kencan saja dengannya,\Nsiapa tahu kalian cocok.{\i0}
Dialogue: 0,0:05:07.80,0:05:09.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah.
Dialogue: 0,0:05:10.68,0:05:11.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku
Dialogue: 0,0:05:12.97,0:05:16.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dia terlalu sempurna.{\i0}
Dialogue: 0,0:05:20.48,0:05:22.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih ada yang kau sembunyikan!
Dialogue: 0,0:05:22.28,0:05:24.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ini juga kusita.\N- Kembalikan!
Dialogue: 0,0:05:24.61,0:05:27.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mohon padamu, Adikku!
Dialogue: 0,0:05:27.24,0:05:29.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya tidak!
Dialogue: 0,0:05:30.62,0:05:33.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak bisa menjaga diri tanpa aku.
Dialogue: 0,0:05:37.17,0:05:38.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Chainsmoker Cat!{\i0}
Dialogue: 0,0:05:41.88,0:05:42.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang.
Dialogue: 0,0:05:42.84,0:05:45.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau membayar asuransi kesehatanku.
Dialogue: 0,0:05:45.84,0:05:47.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Baik.\N- Juga…
Dialogue: 0,0:05:48.09,0:05:49.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Nomor 12.\N- Siap!
Dialogue: 0,0:05:54.89,0:05:56.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau pesan?
Dialogue: 0,0:05:56.56,0:05:58.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Burger keju kue ikan, susu kocok.
Dialogue: 0,0:05:58.39,0:06:01.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dapat potongan setengah harga\Ndengan kupon manusia hewan-ku.
Dialogue: 0,0:06:01.40,0:06:05.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Burger keju kue ikan dan susu kocok Nyamu\Nuntuk pesanan nomor 12…
Dialogue: 0,0:06:05.03,0:06:05.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:06:11.49,0:06:13.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Maaf.
Dialogue: 0,0:06:13.74,0:06:15.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku tak bermaksud membuatmu malu.
Dialogue: 0,0:06:15.87,0:06:17.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:06:17.16,0:06:19.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah terbiasa malu karenamu.
Dialogue: 0,0:06:19.96,0:06:21.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak mendukungku.
Dialogue: 0,0:06:22.09,0:06:25.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu aku dipanggil dengan nomor,
Dialogue: 0,0:06:25.88,0:06:28.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi, saat aku mendengar nomor itu,\Naku otomatis bereaksi.
Dialogue: 0,0:06:32.51,0:06:34.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Empat kali tiga sama dengan 12.\N- Siap!
Dialogue: 0,0:06:34.56,0:06:36.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dua kali enam sama dengan 12.\N- Siap!
Dialogue: 0,0:06:36.60,0:06:39.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Pasti kau kesulitan dengan perkalian.
Dialogue: 0,0:06:39.06,0:06:42.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku baik-baik saja saat SD.
Dialogue: 0,0:06:42.02,0:06:44.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini terjadi sesudahnya.
Dialogue: 0,0:06:44.02,0:06:44.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:06:48.86,0:06:51.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku menjadi guru!
Dialogue: 0,0:06:52.07,0:06:55.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tunggu, manusia hewan tak boleh jadi guru.
Dialogue: 0,0:06:55.16,0:06:56.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sepertinya aku digaji upah minimum.
Dialogue: 0,0:06:56.91,0:06:58.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku menjadi pengacara.
Dialogue: 0,0:06:59.25,0:07:01.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Manusia hewan\Ntak boleh jadi pengacara juga.
Dialogue: 0,0:07:01.50,0:07:03.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau digaji upah minimum juga.
Dialogue: 0,0:07:04.34,0:07:06.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, aku menjadi dokter.
Dialogue: 0,0:07:06.71,0:07:07.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dapat banyak uang.
Dialogue: 0,0:07:07.88,0:07:09.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak boleh jadi dokter.
Dialogue: 0,0:07:10.05,0:07:13.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan semua pembatasan pekerjaan\Nuntuk manusia hewan ini?
Dialogue: 0,0:07:13.22,0:07:15.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuno sekali permainan ini!
Dialogue: 0,0:07:15.39,0:07:17.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kita semua digaji upah minimum.
Dialogue: 0,0:07:18.56,0:07:22.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketidakpastian dalam Permainan Kehidupan\Nedisi Manusia Hewan yang buat jadi seru.
Dialogue: 0,0:07:23.52,0:07:24.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi cendekiawan.
Dialogue: 0,0:07:24.90,0:07:26.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti tidak boleh juga.
Dialogue: 0,0:07:26.73,0:07:27.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tidak boleh.
Dialogue: 0,0:07:27.94,0:07:29.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku pilih jadi manusia.
Dialogue: 0,0:07:29.82,0:07:31.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau bohong soal rasmu?
Dialogue: 0,0:07:32.82,0:07:35.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa untuk permainan saja\Naku tidak boleh bohong?
Dialogue: 0,0:07:35.62,0:07:37.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pandai memainkannya.
Dialogue: 0,0:07:38.12,0:07:41.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan jauh lebih baik kalau uang itu\Nkupakai pindah ke Machida.
Dialogue: 0,0:07:41.50,0:07:43.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau terlilit utang.
Dialogue: 0,0:07:43.79,0:07:45.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya perlu mencapai garis finis.
Dialogue: 0,0:07:45.71,0:07:47.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu semua utang itu akan dihapus.
Dialogue: 0,0:07:47.96,0:07:49.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu baru sistem impian.
Dialogue: 0,0:07:50.38,0:07:52.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, acara pernikahan.
Dialogue: 0,0:07:52.43,0:07:54.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putarlah roda\Nuntuk menentukan ras pasanganmu.
Dialogue: 0,0:07:57.51,0:07:59.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menikah dengan manusia hewan.
Dialogue: 0,0:07:59.22,0:08:01.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa tahu ras-nya sebelum menikah?
Dialogue: 0,0:08:01.56,0:08:03.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tak boleh tahu lebih dulu?
Dialogue: 0,0:08:05.52,0:08:08.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menikah dengan manusia.\NAku mau keuntungan finansialnya.
Dialogue: 0,0:08:08.57,0:08:10.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya itu yang kau pedulikan.
Dialogue: 0,0:08:12.20,0:08:13.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menikah dengan manusia.
Dialogue: 0,0:08:14.91,0:08:16.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dengan manusia hewan.
Dialogue: 0,0:08:17.16,0:08:19.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat manusia menikahi manusia hewan…
Dialogue: 0,0:08:20.54,0:08:22.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, bacakan yang lantang.
Dialogue: 0,0:08:22.29,0:08:23.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:08:24.79,0:08:27.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Jangan menikahi manusia hewan.
Dialogue: 0,0:08:27.92,0:08:30.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perbedaan fisiologisnya terlalu besar.
Dialogue: 0,0:08:30.51,0:08:35.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bisa lompat setinggi delapan meter\Ndan cepat menyelinap mendekatimu.
Dialogue: 0,0:08:36.43,0:08:41.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bisa bergerak bebas di dalam air\Ndan berbau badan setelah kering.
Dialogue: 0,0:08:41.68,0:08:44.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka tak menua,\Ndan mengeong sepanjang waktu.
Dialogue: 0,0:08:44.81,0:08:47.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka memicu alergi kucing,
Dialogue: 0,0:08:47.31,0:08:50.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan entah bagaimana,\Nanaknya menjadi manusia hewan juga."
Dialogue: 0,0:08:50.36,0:08:52.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu cara pandang yang kuno.
Dialogue: 0,0:08:52.74,0:08:53.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seseram film horor.
Dialogue: 0,0:08:54.49,0:08:56.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hampir mencapai garis finis.
Dialogue: 0,0:08:56.36,0:08:57.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat sekali!
Dialogue: 0,0:08:58.41,0:08:59.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebakaran.
Dialogue: 0,0:08:59.62,0:09:01.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lupa menyebutkan,
Dialogue: 0,0:09:01.66,0:09:03.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}garis finis permainan ini adalah kematian.
Dialogue: 0,0:09:03.96,0:09:05.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permainan macam apa ini?
Dialogue: 0,0:09:05.25,0:09:08.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuan permainan ini\Nadalah meninggal dengan bahagia.
Dialogue: 0,0:09:08.29,0:09:11.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekali putaran melambangkan satu tahun,
Dialogue: 0,0:09:11.50,0:09:14.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berarti Yani meninggal di usia 11 tahun.
Dialogue: 0,0:09:16.63,0:09:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya kau berhenti merokok lagi.
Dialogue: 0,0:09:19.01,0:09:21.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, selanjutnya aku.
Dialogue: 0,0:09:23.06,0:09:25.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku dapat angka 12.\N- Siap!
Dialogue: 0,0:09:31.07,0:09:32.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Chainsmoker Cat!{\i0}
Dialogue: 0,0:09:41.91,0:09:44.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau berburu kumbang rusa?
Dialogue: 0,0:09:46.37,0:09:49.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumbang rusa! Yang benar saja!
Dialogue: 0,0:09:49.29,0:09:51.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau anak SD?
Dialogue: 0,0:09:51.96,0:09:53.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Juga, kenapa pakaian itu cocok untukmu?
Dialogue: 0,0:09:56.88,0:09:58.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar.
Dialogue: 0,0:09:58.05,0:10:03.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kusebut judul siaranku, "Pengangguran\NUsia 20 Tahun yang Masih Berjiwa Muda."
Dialogue: 0,0:10:03.64,0:10:05.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu aku ikut denganmu…
Dialogue: 0,0:10:06.39,0:10:07.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yaku?
Dialogue: 0,0:10:09.94,0:10:11.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumbang rusa?
Dialogue: 0,0:10:11.65,0:10:14.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku sedang sibuk.
Dialogue: 0,0:10:14.44,0:10:15.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku berbohong.
Dialogue: 0,0:10:15.78,0:10:18.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak suka kumbang rusa. Maaf.
Dialogue: 0,0:10:21.95,0:10:23.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau sendirian?
Dialogue: 0,0:10:23.83,0:10:25.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan Yaniko?
Dialogue: 0,0:10:25.62,0:10:27.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mulai bekerja paruh waktu hari ini.
Dialogue: 0,0:10:27.71,0:10:30.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan Tatsuro sibuk dengan tenggatnya.
Dialogue: 0,0:10:30.21,0:10:32.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan Aruko mabuk seperti biasa.
Dialogue: 0,0:10:35.71,0:10:41.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati saat kau sendirian di hutan!
Dialogue: 0,0:10:41.05,0:10:42.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:10:42.47,0:10:45.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Benar juga, dia baru dipecat\Ndari pekerjaannya.{\i0}
Dialogue: 0,0:10:45.77,0:10:47.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkin dia masih terpuruk.{\i0}
Dialogue: 0,0:10:48.27,0:10:49.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:10:49.98,0:10:53.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti ikut kalau tidak harus\Nmembantu perkumpulan warga.
Dialogue: 0,0:10:53.94,0:10:55.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak apa-apa sendirian?
Dialogue: 0,0:10:55.48,0:10:58.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan baik-baik saja.\NAku bawa ponselku.
Dialogue: 0,0:10:58.11,0:11:01.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, kau orang yang cerdas.
Dialogue: 0,0:11:01.36,0:11:03.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tetap harus berhati-hati.
Dialogue: 0,0:11:05.62,0:11:07.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yaku, hei.
Dialogue: 0,0:11:08.45,0:11:11.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri tahu aku kalau kau tak dapat apa pun.
Dialogue: 0,0:11:11.87,0:11:13.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan cemas.
Dialogue: 0,0:11:13.50,0:11:16.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuambil waktu istirahat ini\Nuntuk memulihkan diri.
Dialogue: 0,0:11:16.50,0:11:18.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih untuk kepedulianmu.
Dialogue: 0,0:11:30.10,0:11:31.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:11:31.73,0:11:33.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Yani Neko.
Dialogue: 0,0:11:35.56,0:11:36.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Yaku.
Dialogue: 0,0:11:37.44,0:11:39.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kau bekerja hari ini?
Dialogue: 0,0:11:39.15,0:11:40.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar, kau takkan percaya ini.
Dialogue: 0,0:11:40.74,0:11:43.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat wawancara,\Nkutanya apakah boleh merokok,
Dialogue: 0,0:11:43.03,0:11:46.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ternyata hari ini area merokok\Nsedang direnovasi.
Dialogue: 0,0:11:46.62,0:11:48.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku kabur\Nbegitu mendapat kesempatan.
Dialogue: 0,0:11:48.87,0:11:51.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sedang berangkat kerja?
Dialogue: 0,0:11:51.33,0:11:52.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:11:53.29,0:11:55.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan berburu kumbang rusa.
Dialogue: 0,0:12:02.26,0:12:05.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ikut.
Dialogue: 0,0:12:06.64,0:12:07.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus!
Dialogue: 0,0:12:09.27,0:12:11.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kumbang rusa rasanya enak?
Dialogue: 0,0:12:11.35,0:12:13.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Kita tak akan memakannya!
Dialogue: 0,0:12:13.73,0:12:16.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah seru mengumpulkannya?
Dialogue: 0,0:12:16.06,0:12:19.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau tahu betapa kerennya kumbang rusa?
Dialogue: 0,0:12:29.91,0:12:34.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, para penonton setia Kanal Hame-ku!
Dialogue: 0,0:12:34.00,0:12:37.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami ke hutan yang belum dijelajahi,\Nyang konon tempat tinggal para Alfa.
Dialogue: 0,0:12:37.92,0:12:39.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu Alfa?
Dialogue: 0,0:12:39.67,0:12:40.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak tahu?
Dialogue: 0,0:12:40.88,0:12:43.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sekelompok manusia hewan\Nyang menguasai area ini.
Dialogue: 0,0:12:43.67,0:12:47.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingat ganja nikmat… maksudku,\Nrokok enak yang kuberikan kepadamu dulu?
Dialogue: 0,0:12:48.39,0:12:51.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merekalah yang menanam daun-daunnya.
Dialogue: 0,0:12:51.93,0:12:53.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya enak.
Dialogue: 0,0:12:54.98,0:12:58.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka baik hati.\NPasti akan berbagi jika kau minta.
Dialogue: 0,0:13:00.57,0:13:01.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dia.
Dialogue: 0,0:13:04.36,0:13:07.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini salah satu desa di Distrik Enam\Ndi mana para Alfa tinggal,
Dialogue: 0,0:13:07.49,0:13:08.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desa Tembakau.
Dialogue: 0,0:13:15.62,0:13:17.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti di zaman Jomon!
Dialogue: 0,0:13:18.88,0:13:20.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kau Yaku?
Dialogue: 0,0:13:22.17,0:13:24.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mereka ini teman-temanmu?
Dialogue: 0,0:13:24.51,0:13:26.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Ketua!
Dialogue: 0,0:13:27.34,0:13:29.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pemimpin di area ini.
Dialogue: 0,0:13:29.97,0:13:31.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Hame-chan!
Dialogue: 0,0:13:31.76,0:13:32.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Yaniko.
Dialogue: 0,0:13:32.97,0:13:34.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:13:34.23,0:13:36.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ketuanya, Lani.
Dialogue: 0,0:13:36.98,0:13:39.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf datang tiba-tiba begini.
Dialogue: 0,0:13:39.52,0:13:42.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bolehkah minta sedikit tembakau itu?
Dialogue: 0,0:13:42.53,0:13:45.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu. Sebenarnya kami sedang musim panen.
Dialogue: 0,0:13:45.40,0:13:48.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daunnya ada banyak,\Njadi silakan merokok sepuasnya.
Dialogue: 0,0:13:48.74,0:13:49.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih!
Dialogue: 0,0:13:50.41,0:13:52.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selagi kalian di sini,
Dialogue: 0,0:13:52.03,0:13:55.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian berdua harus belajar\Ntentang adat istiadat desa kami.
Dialogue: 0,0:13:55.29,0:13:58.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak suka belajar.\NAku hanya ingin merokok.
Dialogue: 0,0:13:58.42,0:13:59.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan kami merokok!
Dialogue: 0,0:13:59.63,0:14:01.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayolah, kalian berdua!
Dialogue: 0,0:14:02.29,0:14:04.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:14:09.72,0:14:12.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, kami memanen anggur\Ndari desa kami.
Dialogue: 0,0:14:12.81,0:14:16.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Buahnya dibuat menjadi minuman anggur,\Ndaunnya dikeringkan.
Dialogue: 0,0:14:16.14,0:14:19.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Daun-daun itu dijemur di tempat teduh\Ntiga hingga enam bulan,
Dialogue: 0,0:14:19.23,0:14:21.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kemudian tulang daunnya dibuang
Dialogue: 0,0:14:21.73,0:14:24.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebelum sisa daunnya dicincang…
Dialogue: 0,0:14:30.78,0:14:32.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hingga akhirnya siap digunakan.
Dialogue: 0,0:14:33.53,0:14:37.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Semua penduduk desa di sini\Nikut dalam produksi tembakau.
Dialogue: 0,0:14:37.45,0:14:40.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tak bekerja, tak bisa merokok.
Dialogue: 0,0:14:40.12,0:14:42.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Artinya, kalian semua\Njuga harus berkontribusi.
Dialogue: 0,0:14:42.54,0:14:44.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merepotkan sekali.
Dialogue: 0,0:14:44.13,0:14:45.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Yani!
Dialogue: 0,0:14:47.21,0:14:51.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru itu alasannya\Nkau harus coba membuat tembakau sendiri.
Dialogue: 0,0:14:51.68,0:14:53.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, bergerak.
Dialogue: 0,0:15:03.40,0:15:04.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kocak sekali.
Dialogue: 0,0:15:04.40,0:15:05.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:15:05.77,0:15:07.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:15:13.20,0:15:15.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat nikmat.
Dialogue: 0,0:15:15.28,0:15:17.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh!
Dialogue: 0,0:15:17.33,0:15:19.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, 'kan?
Dialogue: 0,0:15:19.20,0:15:21.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami semua bangga akan tembakau kami.
Dialogue: 0,0:15:21.37,0:15:23.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aroma pekatnya begitu membuat ketagihan…
Dialogue: 0,0:15:25.04,0:15:29.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jijik! Aku lebih suka vape-ku yang biasa!
Dialogue: 0,0:15:29.59,0:15:33.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nenek, bagaimana kalau ditambahkan mentol?\NAkan lebih mudah diisap.
Dialogue: 0,0:15:33.59,0:15:35.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tutup mulut bodohmu!
Dialogue: 0,0:15:35.22,0:15:38.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Bagaimana bisa kau berkata begitu?\N- Tapi…
Dialogue: 0,0:15:38.85,0:15:40.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:15:40.60,0:15:42.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang punya selera berbeda.
Dialogue: 0,0:15:42.81,0:15:44.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum tentu cocok untuk semua orang.
Dialogue: 0,0:15:44.94,0:15:47.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sangat pengertian!
Dialogue: 0,0:15:48.28,0:15:50.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Ketua.
Dialogue: 0,0:15:50.49,0:15:53.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak akan marah karena hal seperti ini.
Dialogue: 0,0:15:55.03,0:15:56.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat ke sana.
Dialogue: 0,0:15:56.62,0:16:00.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu monumen yang mengabadikan dewa kami,
Dialogue: 0,0:16:00.91,0:16:03.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang turun-temurun dilindungi suku Alfa.
Dialogue: 0,0:16:03.83,0:16:06.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira itu hanya tembok besar.
Dialogue: 0,0:16:06.63,0:16:09.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu, saat negeri ini dilanda konflik,
Dialogue: 0,0:16:09.30,0:16:13.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terdengar banyak suara\Nmengeong dan menjerit,
Dialogue: 0,0:16:13.38,0:16:16.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kini ia hanya diam mengawasi kami.
Dialogue: 0,0:16:17.14,0:16:20.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Saat kami mengolah tembakau,\Nkami memanjatkan doa kepada monumen itu{\i0}
Dialogue: 0,0:16:21.14,0:16:24.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}sembari kami mencacah daun-daun.{\i0}
Dialogue: 0,0:16:24.27,0:16:27.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu untuk menunjukkan dedikasi kami.{\i0}
Dialogue: 0,0:16:27.44,0:16:30.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Setiap hari kami berdoa\Npada para dewa dan leluhur kami{\i0}
Dialogue: 0,0:16:30.82,0:16:35.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}agar kami hidup rukun di tanah ini.{\i0}
Dialogue: 0,0:16:35.66,0:16:38.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tato-tato ini\Njuga memiliki kisah yang sama.
Dialogue: 0,0:16:38.49,0:16:43.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pola-pola ini menggambarkan monumen\Nyang menjulang ke arah matahari.
Dialogue: 0,0:16:43.75,0:16:46.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat mulai merasa goyah,\Naku melihat tato-tato ini
Dialogue: 0,0:16:46.88,0:16:49.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan merenungkan diri.
Dialogue: 0,0:16:52.21,0:16:53.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu gambar p*nis.
Dialogue: 0,0:16:58.05,0:16:59.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gambar p*nis dan v*gina.
Dialogue: 0,0:17:15.45,0:17:20.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Chainsmoker Cat! Chainsmoker Cat!\NChainsmoker Cat!{\i0}
Dialogue: 0,0:17:28.67,0:17:30.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anginnya kencang,\Naku tak bisa nyalakan korek.
Dialogue: 0,0:17:30.92,0:17:36.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penduduk desa melakukan ritual ini\Nuntuk memohon ampun kepada para dewa.
Dialogue: 0,0:17:36.22,0:17:40.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian hanya perlu\Nmelompat dari tebing itu.
Dialogue: 0,0:17:40.14,0:17:43.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ritual ini sangat aman,\Nanak-anak desa pun melakukannya.
Dialogue: 0,0:17:43.18,0:17:45.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak mungkin bisa melakukan ini!
Dialogue: 0,0:17:45.56,0:17:47.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, ini bukan tali!
Dialogue: 0,0:17:47.90,0:17:51.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terbuat dari sulur tanaman.\NSangat kuat dan lentur.
Dialogue: 0,0:17:51.94,0:17:54.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa mati.\NTidak mungkin aku melakukan ini!
Dialogue: 0,0:17:54.94,0:17:57.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepatlah melompat.
Dialogue: 0,0:17:57.99,0:17:59.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, melompat setinggi ini, pasti mati.
Dialogue: 0,0:18:01.28,0:18:03.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau takut mati?
Dialogue: 0,0:18:03.20,0:18:05.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami punya ungkapan.
Dialogue: 0,0:18:05.45,0:18:08.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Dekati kematian dan anggaplah ia teman."
Dialogue: 0,0:18:08.21,0:18:10.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa merokok jika mati.
Dialogue: 0,0:18:11.92,0:18:15.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kalian melompat, kami akan memberi\Nbanyak tembakau untuk dibawa pulang.
Dialogue: 0,0:18:15.92,0:18:16.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:18:28.64,0:18:30.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa minta korek api?
Dialogue: 0,0:18:30.90,0:18:34.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa dengannya? Dia tidak merasa takut?
Dialogue: 0,0:18:35.48,0:18:38.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tunggu, ini lebih mudah dari yang kupikir?{\i0}
Dialogue: 0,0:18:40.95,0:18:45.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka mengancam membunuhku\Njika aku tak melompat.
Dialogue: 0,0:18:45.29,0:18:48.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takut sekali! Aku tidak mau mati!
Dialogue: 0,0:18:48.79,0:18:52.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Orang-orang ini benar-benar brutal.\N- Cepatlah.
Dialogue: 0,0:19:22.20,0:19:25.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tadi lompatan yang luar biasa.
Dialogue: 0,0:19:25.66,0:19:28.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sudah seperti keluarga sekarang.
Dialogue: 0,0:19:28.33,0:19:30.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh datang kapan pun kalian mau.
Dialogue: 0,0:19:31.37,0:19:33.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan datang lagi untuk rokok.
Dialogue: 0,0:19:37.75,0:19:41.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tembakau desa itu sangat nikmat.\NCukup untukku selama tiga hari.
Dialogue: 0,0:19:41.76,0:19:45.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi itu menyenangkan, bukan?\NAyo kita ke sana lagi kapan-kapan!
Dialogue: 0,0:19:45.01,0:19:46.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau ke sana lagi.
Dialogue: 0,0:19:46.85,0:19:49.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tak mau? Alfa sangat menyayangimu.
Dialogue: 0,0:19:49.64,0:19:52.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bahkan memberimu nama suku,\NSang Pembuat Pelangi.
Dialogue: 0,0:19:53.15,0:19:54.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi itu sangat bahaya…
Dialogue: 0,0:19:54.48,0:19:56.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, maksudku bahagia.
Dialogue: 0,0:19:56.86,0:19:58.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tutup mulutmu!
Dialogue: 0,0:19:58.90,0:20:01.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, apa artinya Alfa?
Dialogue: 0,0:20:01.45,0:20:02.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:20:04.78,0:20:07.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu huruf pertama dalam alfabet Yunani,
Dialogue: 0,0:20:07.45,0:20:11.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan artinya pertama atau permulaan.
Dialogue: 0,0:20:12.50,0:20:13.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyeramkan.
Dialogue: 0,0:20:13.50,0:20:15.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan kena tembakan sinar lagi.
Dialogue: 0,0:20:16.67,0:20:18.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lapar.
Dialogue: 0,0:20:18.21,0:20:20.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau makan sesuatu?
Dialogue: 0,0:20:20.26,0:20:22.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau makan kari.
Dialogue: 0,0:20:22.93,0:20:25.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa makan kari\Nsetelah berak di celana?
Dialogue: 0,0:20:25.51,0:20:27.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak berak di celana!
Dialogue: 0,0:20:27.39,0:20:30.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku ingin minum.\N- Kita bisa pesan bir dan kari.
Dialogue: 0,0:20:31.93,0:20:36.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Chainsmoker Cat, Chainsmoker Cat\NChainsmoker Cat{\i0}
Dialogue: 0,0:20:39.44,0:20:40.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:20:41.57,0:20:42.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tonggeret!
Dialogue: 0,0:20:42.57,0:20:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awas!
Dialogue: 0,0:20:53.41,0:20:57.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kau seperti Miyamoto Musashi.\N- Refleksmu tadi luar biasa!
Dialogue: 0,0:20:57.17,0:20:58.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:21:02.01,0:21:03.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau mencuci sumpitku.
Dialogue: 0,0:21:03.92,0:21:05.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan.
Dialogue: 0,0:21:10.60,0:21:13.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa dia mau pamer\Nbahwa dia tak takut serangga?{\i0}
Dialogue: 0,0:21:13.10,0:21:14.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mana ada yang pakai sumpit?{\i0}
Dialogue: 0,0:21:14.89,0:21:17.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kukira dia akan memakan itu.{\i0}
Dialogue: 0,0:21:18.73,0:21:20.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imoko!
Dialogue: 0,0:21:20.73,0:21:22.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau mencuci sumpit sampai kapan?
Dialogue: 0,0:21:24.03,0:21:25.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sumpit sekali pakai?
Dialogue: 0,0:21:25.45,0:21:27.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami dapat sumpit baru dari kafetaria.
Dialogue: 0,0:21:27.91,0:21:30.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:21:30.08,0:21:33.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kafetaria jauh dari sini?
Dialogue: 0,0:21:33.04,0:21:34.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah…
Dialogue: 0,0:21:35.50,0:21:37.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti tak mau makan pakai sumpit itu.
Dialogue: 0,0:21:38.67,0:21:39.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:21:40.63,0:21:42.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengkuranmu senangmu kencang sekali!
Dialogue: 0,0:21:42.63,0:21:44.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau sedang pubertas?
Dialogue: 0,0:21:44.84,0:21:46.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tidak!\N- Sudah, sudah.
Dialogue: 0,0:21:46.51,0:21:47.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:21:48.26,0:21:51.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku, mungkin.
Dialogue: 0,0:22:00.65,0:22:04.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau lakukan?\NSetidaknya masaklah dulu!
Dialogue: 0,0:22:04.28,0:22:05.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu alasanmu?
Dialogue: 0,0:22:05.78,0:22:07.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya enak seperti udang.
Dialogue: 0,0:23:32.95,0:23:38.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terjemahan subtitle oleh Stysa Alverina
