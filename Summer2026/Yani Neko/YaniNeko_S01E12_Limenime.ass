Dialogue: 0,0:02:34.15,0:02:35.27,sign,,0000,0000,0000,,{\an8}32 TAHUN
Dialogue: 0,0:02:43.16,0:02:44.07,sign,,0000,0000,0000,,{\an8}TOKO BUKU MEONG
Dialogue: 0,0:06:07.28,0:06:11.66,sign,,0000,0000,0000,,{\an8}MENGAMUK - MENGAMUK
Dialogue: 0,0:06:11.66,0:06:12.49,sign,,0000,0000,0000,,{\an8}TUMBANG
Dialogue: 0,0:06:17.96,0:06:19.37,sign,,0000,0000,0000,,{\an8}BERHENTILAH BERMAIN SURA6
Dialogue: 0,0:12:50.31,0:12:52.06,sign,,0000,0000,0000,,{\an8}IMOKO MENGIRA DIA SUKA BERPESTA
Dialogue: 0,0:12:52.06,0:12:54.56,sign,,0000,0000,0000,,{\an8}KELIHATANNYA DIA ORANG TUA\NYANG MENGABAIKAN ANAK
Dialogue: 0,0:00:51.05,0:00:52.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Panas! Panas!
Dialogue: 0,0:02:24.06,0:02:26.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku harus bagaimana sekarang?
Dialogue: 0,0:02:26.72,0:02:29.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sepertinya polisi\Nakan menyelidiki kejadian.
Dialogue: 0,0:02:29.77,0:02:32.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Benar. Tentu saja.
Dialogue: 0,0:02:35.28,0:02:38.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Seharusnya sekarang\Nkau sudah terbiasa karyamu dibatalkan.
Dialogue: 0,0:02:38.24,0:02:40.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Pokoknya, kita mulai proyek barumu.
Dialogue: 0,0:02:40.57,0:02:43.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Sekarang harusnya aku sudah terbiasa?{\i0}
Dialogue: 0,0:02:44.08,0:02:45.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Aku tak terbiasa.{\i0}
Dialogue: 0,0:02:47.41,0:02:49.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Selamat datang.\N- Kios krep?
Dialogue: 0,0:02:50.21,0:02:51.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sudah lama aku tak makan krep.
Dialogue: 0,0:02:51.92,0:02:53.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Mungkin akan kubeli sepotong.
Dialogue: 0,0:02:53.75,0:02:56.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Kelihatannya enak!\N- Ayo kita makan ini.
Dialogue: 0,0:02:56.05,0:02:57.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terlihat enak!
Dialogue: 0,0:02:57.26,0:02:58.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Aku baru ingat.{\i0}
Dialogue: 0,0:03:00.05,0:03:03.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Lalu, orang menyedihkan dengan sweter\Nyang longgar itu ikut mengantre.
Dialogue: 0,0:03:03.89,0:03:05.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Menjijikkan!
Dialogue: 0,0:03:05.05,0:03:09.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Dia meringkuk seperti bola\Ndan makan sedikit-sedikit seperti hamster.
Dialogue: 0,0:03:11.14,0:03:13.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Astaga, konyol sekali.
Dialogue: 0,0:03:13.15,0:03:16.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Merusak hariku! Pecundang menyeramkan itu\Ntak berhak makan krep duluan!
Dialogue: 0,0:03:18.48,0:03:23.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Apa aku berhak makan krep? Tidak.{\i0}
Dialogue: 0,0:03:25.24,0:03:27.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Yani Neko, tunggu.
Dialogue: 0,0:03:27.16,0:03:28.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa?
Dialogue: 0,0:03:28.08,0:03:30.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Maaf, aku hanya ingin tahu…
Dialogue: 0,0:03:33.25,0:03:35.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Maaf, lupakan saja.
Dialogue: 0,0:03:37.00,0:03:39.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Di sana menjual krep. Aromanya enak.
Dialogue: 0,0:03:39.26,0:03:41.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau mau makan itu?
Dialogue: 0,0:03:41.34,0:03:42.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku tak punya uang.
Dialogue: 0,0:03:44.51,0:03:46.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau mau belikan aku jika kutraktir?
Dialogue: 0,0:03:46.76,0:03:47.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ya!
Dialogue: 0,0:03:48.18,0:03:49.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ini uangnya.
Dialogue: 0,0:03:51.39,0:03:54.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Stroberi, pisang, es krim.
Dialogue: 0,0:03:55.90,0:03:57.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tunggu, Yani Neko.
Dialogue: 0,0:03:59.19,0:04:01.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku berubah pikiran. Aku ikut.
Dialogue: 0,0:04:04.82,0:04:06.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Rasanya manis dan enak.
Dialogue: 0,0:04:06.24,0:04:09.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Caramu makan seperti hamster itu\Nagak menjijikkan.
Dialogue: 0,0:04:09.16,0:04:10.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Benarkah?
Dialogue: 0,0:04:11.37,0:04:12.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Menjijikkan, ya?
Dialogue: 0,0:04:14.12,0:04:17.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Chainsmoker Cat.{\i0}
Dialogue: 0,0:04:28.93,0:04:31.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sepagi ini membuang sampah.
Dialogue: 0,0:04:31.64,0:04:34.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku pekerja tergiat\Ndi dalam Kisah Tiga Kerajaan.
Dialogue: 0,0:04:34.06,0:04:36.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kak Yani Neko?
Dialogue: 0,0:04:37.31,0:04:39.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau sedang apa sepagi ini?
Dialogue: 0,0:04:39.77,0:04:42.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Adikku mengancam tak akan berkunjung lagi
Dialogue: 0,0:04:42.28,0:04:45.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}kalau aku tidak membuang sampah ke luar.
Dialogue: 0,0:04:45.07,0:04:48.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sedang apa kau, membawa pemukul?
Dialogue: 0,0:04:49.41,0:04:50.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau mau bergabung?
Dialogue: 0,0:05:01.71,0:05:04.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Itu tak seperti yang kuduga.
Dialogue: 0,0:05:08.30,0:05:10.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Berputar sangat cepat.
Dialogue: 0,0:05:12.10,0:05:15.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Astaga, aku suka perasaan ini.
Dialogue: 0,0:05:15.85,0:05:18.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sekarang, ditambah minum miras…
Dialogue: 0,0:05:20.61,0:05:22.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ini dia!
Dialogue: 0,0:05:22.73,0:05:26.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Dunia jadi buram sekarang!\NMinuman ini sungguh membuat mabuk!
Dialogue: 0,0:05:27.57,0:05:28.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ya!
Dialogue: 0,0:05:32.66,0:05:35.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku dipecat dari pekerjaanku.
Dialogue: 0,0:05:36.25,0:05:38.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Siapa yang berhak\Nmenghancurkan masa depan seseorang
Dialogue: 0,0:05:39.38,0:05:42.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}yang hanya berjuang untuk bertahan hidup,
Dialogue: 0,0:05:42.63,0:05:45.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}hanya karena satu catatan\Ndalam rekam jejak masa lalunya?
Dialogue: 0,0:05:48.01,0:05:50.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Manusia melakukan itu ke sesama manusia.
Dialogue: 0,0:05:57.60,0:05:59.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sudah kubilang, kau bukan manusia.
Dialogue: 0,0:06:14.99,0:06:17.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kendalikan diri. Kendalikan diri.
Dialogue: 0,0:06:36.10,0:06:38.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku mempermalukan diriku\Ndi depan Kak Yani Neko.
Dialogue: 0,0:06:42.48,0:06:43.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa? Hame Neko!
Dialogue: 0,0:06:48.32,0:06:51.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau sungguh mengajakku berkelahi?
Dialogue: 0,0:06:52.37,0:06:54.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tunggu, apa yang terjadi?
Dialogue: 0,0:06:54.37,0:06:57.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kenapa aku terbaring\Ndi atas tanah di luar?
Dialogue: 0,0:06:57.29,0:06:58.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Yang benar saja?
Dialogue: 0,0:06:58.50,0:07:00.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tunggu, ini sangat aneh.
Dialogue: 0,0:07:00.96,0:07:04.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Yang kuingat\Ntadi aku sedang memainkan Sura6.
Dialogue: 0,0:07:04.09,0:07:06.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Lalu aku diejek\Noleh pemain Kento yang mengalahkanku.
Dialogue: 0,0:07:09.88,0:07:13.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kenapa kau menghela napas?
Dialogue: 0,0:07:13.51,0:07:16.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku bisa menyadari hal-hal seperti itu!\NAku berpengalaman!
Dialogue: 0,0:07:16.97,0:07:19.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ya. Pokoknya, berhentilah bermain.
Dialogue: 0,0:07:19.56,0:07:22.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau menyuruhku berhenti memainkan Sura6?
Dialogue: 0,0:07:22.40,0:07:23.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Akan kubunuh kau!
Dialogue: 0,0:07:23.98,0:07:24.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ya, ya.
Dialogue: 0,0:07:25.94,0:07:28.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Chainsmoker Cat.{\i0}
Dialogue: 0,0:07:30.49,0:07:33.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Bagaimana menurutmu\Nmanusia hewan pria yang berpakaian wanita?
Dialogue: 0,0:07:35.41,0:07:36.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa katamu?
Dialogue: 0,0:07:36.99,0:07:38.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Pria berpakaian wanita.
Dialogue: 0,0:07:38.70,0:07:39.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa itu?
Dialogue: 0,0:07:39.75,0:07:40.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau tidak tahu?
Dialogue: 0,0:07:40.91,0:07:44.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Tidak lihat.\N- Manusia hewan pria berpakaian wanita.
Dialogue: 0,0:07:44.08,0:07:47.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Bagian dari budaya laki-laki feminin\Nyang berkembang.
Dialogue: 0,0:07:47.17,0:07:48.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tak boleh wanita saja?
Dialogue: 0,0:07:48.67,0:07:50.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sepertinya tidak.
Dialogue: 0,0:07:50.92,0:07:53.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku ingin mendengar sudut pandang pria.
Dialogue: 0,0:07:53.43,0:07:56.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Seimut apa pun dia,\Ntetap saja laki-laki, bukan?
Dialogue: 0,0:07:56.97,0:07:58.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku tak suka yang seperti itu.
Dialogue: 0,0:07:59.56,0:08:00.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ternyata begitu.
Dialogue: 0,0:08:01.56,0:08:04.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku tak punya banyak pengalaman\Nsoal budaya seperti itu.
Dialogue: 0,0:08:05.48,0:08:09.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tapi editorku menyuruh memasukkan\Nkarakter itu ke proyekku berikutnya,
Dialogue: 0,0:08:09.82,0:08:12.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}jadi kupikir\Naku ingin lebih mempelajarinya.
Dialogue: 0,0:08:13.28,0:08:16.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku telah memikirkannya\Nselama tiga hari tanpa tidur.
Dialogue: 0,0:08:16.24,0:08:19.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kurasa aku hanya butuh\Nsemacam dorongan untuk memulai.
Dialogue: 0,0:08:20.70,0:08:23.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Menurutku, kau terlalu memaksakan diri.
Dialogue: 0,0:08:23.92,0:08:26.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ada Tatsuro dan Tuan Pemilik Rumah.
Dialogue: 0,0:08:26.96,0:08:29.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Perpaduan yang cukup mencurigakan.
Dialogue: 0,0:08:30.59,0:08:32.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa kakakku ada?
Dialogue: 0,0:08:32.26,0:08:34.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Shunran!\N- Aduh.
Dialogue: 0,0:08:34.01,0:08:36.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Bisa kau ke kamarku?
Dialogue: 0,0:08:36.72,0:08:37.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Baik.
Dialogue: 0,0:08:42.89,0:08:45.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Maaf membuatmu menunggu.
Dialogue: 0,0:08:48.61,0:08:50.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau cocok memakainya karena tampan!
Dialogue: 0,0:08:50.90,0:08:52.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau harusnya bisa menolak.
Dialogue: 0,0:08:52.86,0:08:54.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Jadi, bagaimana menurutmu?
Dialogue: 0,0:08:54.49,0:08:55.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Maksudku.
Dialogue: 0,0:08:55.66,0:08:57.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tak mungkin aku terangsang oleh Shunran.
Dialogue: 0,0:08:57.91,0:09:00.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sungguh? Tak terangsang?
Dialogue: 0,0:09:00.91,0:09:03.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tapi aku melakukan ini demi kau.
Dialogue: 0,0:09:03.91,0:09:07.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Shunran sedih.\N- Hentikan!
Dialogue: 0,0:09:07.00,0:09:07.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Tak bereaksi.{\i0}
Dialogue: 0,0:09:07.92,0:09:10.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Menjauhlah dariku!\N- Lenganmu amat kekar.
Dialogue: 0,0:09:11.09,0:09:13.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau berlatih bela diri atau apa?
Dialogue: 0,0:09:13.71,0:09:16.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau mendalami peranmu dengan aneh.
Dialogue: 0,0:09:18.43,0:09:21.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku suka digendong\Ndi atas punggung gorila!
Dialogue: 0,0:09:21.85,0:09:23.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tidak!
Dialogue: 0,0:09:23.98,0:09:26.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aduh. Apa kau baik-baik saja, Shunran?
Dialogue: 0,0:09:32.23,0:09:33.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tahukah kau?
Dialogue: 0,0:09:33.61,0:09:38.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kabarnya, pusat Galaksi Bima Sakti\Nberbau seperti rum.
Dialogue: 0,0:09:38.11,0:09:39.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa?
Dialogue: 0,0:09:40.62,0:09:43.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Pemilik Rumah\Nmelakukan hal nakal dengan wanita!
Dialogue: 0,0:09:43.74,0:09:44.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Siapa kau?
Dialogue: 0,0:09:44.79,0:09:46.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Aku Otani Haruko.\N- Otani?
Dialogue: 0,0:09:47.62,0:09:50.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku istri kedua Pak Otani.
Dialogue: 0,0:09:50.33,0:09:51.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Istri kedua?
Dialogue: 0,0:09:51.38,0:09:53.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa yang kau lakukan, Shunran?
Dialogue: 0,0:09:53.25,0:09:54.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Shunran?
Dialogue: 0,0:09:54.26,0:09:56.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terima kasih telah membantu suamiku.
Dialogue: 0,0:09:56.26,0:09:58.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa? Tak mungkin. Tunggu. Apa?
Dialogue: 0,0:09:59.89,0:10:00.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Mati saja kau!
Dialogue: 0,0:10:01.97,0:10:05.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tak kusangka kau begitu pemilih, Pak.
Dialogue: 0,0:10:05.52,0:10:08.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kukira kau tertarik\Ndengan manusia hewan mana pun.
Dialogue: 0,0:10:08.06,0:10:09.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku memang tidak suka yang begitu.
Dialogue: 0,0:10:09.90,0:10:12.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Dan asal kau tahu,\Naku tidak tertarik dengan manusia hewan!
Dialogue: 0,0:10:12.77,0:10:15.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Masuk akal. Kau mengelola\Napartemen manusia hewan.
Dialogue: 0,0:10:16.07,0:10:17.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Mesum!
Dialogue: 0,0:10:17.28,0:10:19.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sudah kubilang tidak begitu!
Dialogue: 0,0:10:19.24,0:10:20.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tunggu, aku lupa menambahkan ini.
Dialogue: 0,0:10:23.91,0:10:25.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kalian sungguh menyebalkan.
Dialogue: 0,0:10:25.70,0:10:27.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terlihat cantik.
Dialogue: 0,0:10:27.29,0:10:28.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Cocok pakai payudara palsu.
Dialogue: 0,0:10:28.66,0:10:30.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kelihatannya itu ukuran D.
Dialogue: 0,0:10:34.13,0:10:35.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tuing! Tuing!
Dialogue: 0,0:10:36.38,0:10:38.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tuing! Peni…
Dialogue: 0,0:10:39.97,0:10:41.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Baik, aku pulang dulu.
Dialogue: 0,0:10:41.55,0:10:43.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Jangan lupa hangatkan karinya.
Dialogue: 0,0:10:43.60,0:10:44.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Baik.
Dialogue: 0,0:10:44.85,0:10:48.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Malam ini akan turun hujan,\Njangan keluar rumah.
Dialogue: 0,0:10:48.31,0:10:49.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku paham.
Dialogue: 0,0:10:51.06,0:10:52.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tunggu, aku ingat dia.
Dialogue: 0,0:10:52.31,0:10:54.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Hei!
Dialogue: 0,0:10:57.69,0:10:59.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Senang bertemu kau lagi.
Dialogue: 0,0:10:59.20,0:11:00.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau tinggal di gedung ini?
Dialogue: 0,0:11:00.82,0:11:02.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kebetulan sekali!
Dialogue: 0,0:11:02.82,0:11:05.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ingat aku? Kita pernah bertemu di stasiun.
Dialogue: 0,0:11:05.03,0:11:06.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Stasiun?
Dialogue: 0,0:11:06.58,0:11:11.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau nyaris ditabrak truk,\Nlalu aku melompat menyelamatkanmu?
Dialogue: 0,0:11:11.21,0:11:13.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Truk?
Dialogue: 0,0:11:13.88,0:11:15.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Oh, ya, benar.
Dialogue: 0,0:11:15.96,0:11:18.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Senang bertemu denganmu lagi.
Dialogue: 0,0:11:19.51,0:11:22.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Pasti itu berat.\NBiar kubawakan ke kamarmu.
Dialogue: 0,0:11:22.26,0:11:24.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sungguh? Terima kasih.
Dialogue: 0,0:11:27.97,0:11:29.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Isinya hanya miras?{\i0}
Dialogue: 0,0:11:31.14,0:11:34.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Menyuruh gadis kecil pergi membeli miras?{\i0}
Dialogue: 0,0:11:34.06,0:11:36.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Apa orang tuanya bermasalah?{\i0}
Dialogue: 0,0:11:37.15,0:11:39.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Aku harus menegur mereka!{\i0}
Dialogue: 0,0:11:39.15,0:11:40.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Permisi.
Dialogue: 0,0:11:42.61,0:11:44.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Orang tuanya tak ada di rumah.{\i0}
Dialogue: 0,0:11:45.07,0:11:48.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Meski tak sejorok kamar kakakku,\Nkamar ini berantakan.{\i0}
Dialogue: 0,0:11:48.83,0:11:51.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Botol-botol kosong berserakan.{\i0}
Dialogue: 0,0:11:53.50,0:11:54.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Hei!
Dialogue: 0,0:11:54.92,0:11:58.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Itu minuman orang dewasa!\NAnak-anak tak boleh…
Dialogue: 0,0:11:59.42,0:12:02.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Apa dia meminumnya\Nkarena dia tak dibelikan jus?{\i0}
Dialogue: 0,0:12:02.80,0:12:05.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Bagaimana bisa kucing selugu ini\Nditelantarkan begini?{\i0}
Dialogue: 0,0:12:05.72,0:12:09.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Rambutnya berbau,\Npasti dia jarang dimandikan.{\i0}
Dialogue: 0,0:12:09.97,0:12:11.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Betapa malangnya!{\i0}
Dialogue: 0,0:12:14.10,0:12:16.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tenang, akan kumasakkan\Nmakan malam untukmu!
Dialogue: 0,0:12:16.31,0:12:18.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Hore!
Dialogue: 0,0:12:32.33,0:12:33.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ada aroma kari.
Dialogue: 0,0:12:34.50,0:12:37.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aruko, kau memasak kari?
Dialogue: 0,0:12:38.17,0:12:40.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tunggu, ada Imoko-chan.
Dialogue: 0,0:12:40.13,0:12:41.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Halo, maaf mengganggu.
Dialogue: 0,0:12:41.80,0:12:46.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Jika kau mau mengganggu, pulang sajalah!\NTunggu, ini bukan kamarku.
Dialogue: 0,0:12:46.68,0:12:48.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Masih ada sisanya.
Dialogue: 0,0:12:48.55,0:12:50.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Akan kuambil semangkuk.\N{\i1}- Kansai…{\i0}
Dialogue: 0,0:12:54.56,0:12:56.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Bisa bicara sebentar?
Dialogue: 0,0:12:56.06,0:12:57.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa?
Dialogue: 0,0:12:58.11,0:13:01.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tolong mandikan\Ndan beri makan anakmu dengan benar!
Dialogue: 0,0:13:01.57,0:13:03.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kesalahpahaman gila macam apa ini?
Dialogue: 0,0:13:03.82,0:13:07.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Juga, jangan biarkan\Nanakmu tinggal sendirian!
Dialogue: 0,0:13:07.28,0:13:09.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Setidaknya, akui dia secara hukum.
Dialogue: 0,0:13:09.28,0:13:11.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau bicara apa? Tingkahmu gila!
Dialogue: 0,0:13:11.74,0:13:13.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa kau sekeluarga gila?
Dialogue: 0,0:13:13.08,0:13:15.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Bicara soal keluarga, kau harus…\N- Bahan rahasia.
Dialogue: 0,0:13:16.58,0:13:19.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Chainsmoker Cat!{\i0}
Dialogue: 0,0:13:27.55,0:13:29.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ada apa, Yomuko?
Dialogue: 0,0:13:29.76,0:13:32.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau tak mau membantuku\Nmenjadi model bikini?
Dialogue: 0,0:13:32.77,0:13:33.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Bukan begitu.
Dialogue: 0,0:13:33.68,0:13:35.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Rambut kemaluanmu menyembul?
Dialogue: 0,0:13:35.27,0:13:36.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Bukan.
Dialogue: 0,0:13:37.27,0:13:38.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Begini,
Dialogue: 0,0:13:38.73,0:13:41.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}kusadari aku tak punya bakat apa pun.
Dialogue: 0,0:13:42.23,0:13:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa terjadi sesuatu?
Dialogue: 0,0:13:43.78,0:13:44.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sebenarnya,
Dialogue: 0,0:13:45.32,0:13:49.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}aku hampir menyelesaikan cerita\Nyang akan kukirim ke lomba novel.
Dialogue: 0,0:13:49.99,0:13:53.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Jadi, kucetak dan kubaca ceritaku.
Dialogue: 0,0:13:53.66,0:13:54.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Lalu aku sadar.
Dialogue: 0,0:13:55.45,0:13:58.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ceritaku membosankan.
Dialogue: 0,0:13:58.83,0:14:00.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Memang semua terasa menyatu,
Dialogue: 0,0:14:00.96,0:14:03.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}tapi perasaan tokoh utamanya\Ntak tersampaikan ke pembaca.
Dialogue: 0,0:14:04.46,0:14:07.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Seperti ada hal penting yang hilang.
Dialogue: 0,0:14:07.84,0:14:11.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sejak itu aku terus\Nmemikirkan tentang tokoh utama,
Dialogue: 0,0:14:11.10,0:14:12.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}tapi tak juga mendapat solusinya.
Dialogue: 0,0:14:13.39,0:14:16.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Aku paham.\N- Tulis saja tentang penjara bawah tanah.
Dialogue: 0,0:14:16.48,0:14:20.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa yang kau lakukan\Njika kau mengalami ini?
Dialogue: 0,0:14:20.19,0:14:22.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tulis tentang tokoh jahat.
Dialogue: 0,0:14:22.11,0:14:26.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku sering mengalami kebuntuan ide.
Dialogue: 0,0:14:26.49,0:14:29.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Yang bisa kusarankan\Nhanyalah terus berpikir.
Dialogue: 0,0:14:29.36,0:14:34.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Setiap detik di luar sekolah\Nkupakai berpikir di depan komputer.
Dialogue: 0,0:14:34.03,0:14:36.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Hampir lima jam setiap hari.
Dialogue: 0,0:14:37.37,0:14:39.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa artinya aku tak punya bakat?
Dialogue: 0,0:14:40.42,0:14:43.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Mungkin aku harus berhenti menulis novel.
Dialogue: 0,0:14:43.96,0:14:45.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ya, berhentilah.
Dialogue: 0,0:14:46.30,0:14:49.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Maaf, maksudku berhenti duduk\Ndepan komputer. Pergilah keluar!
Dialogue: 0,0:14:49.72,0:14:52.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Keluar?
Dialogue: 0,0:14:52.05,0:14:54.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku berjalan-jalan\Nsaat alami kebuntuan ide.
Dialogue: 0,0:14:55.35,0:14:57.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Misalnya…
Dialogue: 0,0:14:58.10,0:15:01.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku melihat sepasang kekasih\Nbergandengan tangan,
Dialogue: 0,0:15:01.85,0:15:04.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}lalu tiba-tiba melepasnya.
Dialogue: 0,0:15:05.73,0:15:07.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Lihat, sudah kubilang.
Dialogue: 0,0:15:07.61,0:15:09.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Atau seorang anak yang terjatuh,
Dialogue: 0,0:15:09.61,0:15:12.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}tapi dia tersenyum, bukannya menangis.
Dialogue: 0,0:15:12.62,0:15:15.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Atau kios krep yang terlihat sangat lezat.
Dialogue: 0,0:15:18.37,0:15:22.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tiba-tiba aku mendapat ide-ide\Ndari tempat-tempat yang tak terduga.
Dialogue: 0,0:15:22.71,0:15:24.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Intinya, menstimulasi otak.
Dialogue: 0,0:15:24.71,0:15:26.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ternyata begitu.
Dialogue: 0,0:15:26.17,0:15:29.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Berapa banyak waktu kusia-siakan,\Nduduk di depan mejaku?
Dialogue: 0,0:15:29.01,0:15:30.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Itu tidak sia-sia.
Dialogue: 0,0:15:31.76,0:15:35.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Pertama, pikirkan sendiri semampumu.
Dialogue: 0,0:15:35.05,0:15:37.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terus berpikir sampai kau bosan,
Dialogue: 0,0:15:37.89,0:15:40.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}lalu idenya akan muncul.
Dialogue: 0,0:15:41.89,0:15:45.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tak banyak orang di dunia ini\Nyang bisa melakukan itu.
Dialogue: 0,0:15:45.52,0:15:48.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Menurutku kau berbakat\Nmenjadi penulis profesional.
Dialogue: 0,0:15:49.28,0:15:51.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tatsuro-sensei.
Dialogue: 0,0:15:52.15,0:15:53.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ini dia.
Dialogue: 0,0:15:56.70,0:15:59.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Rasakan bau ini, Tatsuro. Sangat pekat.
Dialogue: 0,0:16:00.08,0:16:02.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Bau sekali!
Dialogue: 0,0:16:02.29,0:16:04.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa yang kau makan sampai sebau itu?
Dialogue: 0,0:16:04.58,0:16:05.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kue sus.
Dialogue: 0,0:16:05.63,0:16:09.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tidak mungkin bau seperti ini\Nberasal dari kue sus!
Dialogue: 0,0:16:09.21,0:16:10.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku bisa mati!
Dialogue: 0,0:16:29.94,0:16:31.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Maaf!
Dialogue: 0,0:16:31.03,0:16:32.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ada apa?
Dialogue: 0,0:16:32.40,0:16:33.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku harus pergi!
Dialogue: 0,0:16:34.45,0:16:37.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku akan kemari lagi lain kali.\NTerima kasih banyak!
Dialogue: 0,0:16:54.88,0:16:57.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Benar, seperti ini\Nperasaan yang harus kutuliskan.
Dialogue: 0,0:17:07.77,0:17:10.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau penulis komik?
Dialogue: 0,0:17:10.23,0:17:11.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Aku minta maaf.\N- Jadi,
Dialogue: 0,0:17:11.57,0:17:14.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}kenapa kau menyuruh seorang remaja\Nberkeliaran memakai bikini?
Dialogue: 0,0:17:14.82,0:17:18.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Untuk penelitian.\N- Perlihatkan pistolmu.
Dialogue: 0,0:17:19.45,0:17:22.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Chainsmoker Cat.{\i0}
Dialogue: 0,0:17:30.29,0:17:31.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ada apa ini?
Dialogue: 0,0:17:31.34,0:17:34.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Yani Neko, tumben hari ini\Nkau terlihat lelah.
Dialogue: 0,0:17:34.97,0:17:37.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sekujur tubuhku pegal-pegal.
Dialogue: 0,0:17:42.35,0:17:45.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Mereka menyuruh kami\Nbekerja menggali lubang seharian.{\i0}
Dialogue: 0,0:17:45.02,0:17:47.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Lalu besoknya kami timbun kembali.{\i0}
Dialogue: 0,0:17:47.02,0:17:49.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Begitu terus sepanjang minggu.{\i0}
Dialogue: 0,0:17:49.61,0:17:51.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Pekerjaan macam apa itu?{\i0}
Dialogue: 0,0:17:53.36,0:17:56.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Itulah harga untuk hidup\Ndalam masyarakat beradab.
Dialogue: 0,0:17:56.32,0:17:58.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Semua orang sibuk bekerja.
Dialogue: 0,0:17:59.74,0:18:03.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tapi yang dia lakukan\Nhanya menyapu halaman sepanjang hari.
Dialogue: 0,0:18:03.37,0:18:04.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Dia punya waktu luang.
Dialogue: 0,0:18:04.91,0:18:07.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sebenarnya itu pekerjaannya.
Dialogue: 0,0:18:07.87,0:18:10.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Agar tempat tinggal kalian jadi nyaman.
Dialogue: 0,0:18:11.42,0:18:12.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Yani Neko?
Dialogue: 0,0:18:13.80,0:18:15.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ada apa, Cerobong Asap?
Dialogue: 0,0:18:15.76,0:18:17.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Melihat wajah surammu,
Dialogue: 0,0:18:17.63,0:18:20.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}pasti kau baru mengotori paru-parumu lagi.
Dialogue: 0,0:18:20.64,0:18:22.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa yang akan kau lakukan hari ini?
Dialogue: 0,0:18:22.89,0:18:25.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kenapa tiba-tiba menanyakan itu?
Dialogue: 0,0:18:25.10,0:18:27.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Baik, biar kupikir.
Dialogue: 0,0:18:27.39,0:18:32.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku akan bersih-bersih, menyirami kubis,\Nlalu berkeliling membagikan pengumuman.
Dialogue: 0,0:18:34.32,0:18:37.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kebetulan ada\Nlebih banyak waktu luang hari ini!
Dialogue: 0,0:18:37.24,0:18:39.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku tak selalu sesenggang ini.
Dialogue: 0,0:18:40.20,0:18:41.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ada apa dengannya?
Dialogue: 0,0:18:41.78,0:18:43.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Omong-omong, Yani Neko,
Dialogue: 0,0:18:43.62,0:18:45.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}kau belum membayar uang sewa bulan lalu.
Dialogue: 0,0:18:45.79,0:18:47.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau sungguh bekerja, tidak?
Dialogue: 0,0:18:47.33,0:18:50.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau tak akan jadi apa-apa\Njika hanya duduk diam seharian.
Dialogue: 0,0:18:52.54,0:18:55.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ini, kuberi kau lebih banyak kegiatan!
Dialogue: 0,0:19:00.51,0:19:03.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kenapa kau…
Dialogue: 0,0:19:04.22,0:19:06.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau punya masalah apa?
Dialogue: 0,0:19:06.14,0:19:08.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Cerobong Asap bodoh sialan!
Dialogue: 0,0:19:08.35,0:19:10.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau tak akan jadi apa-apa\Njika bermalas-malasan!
Dialogue: 0,0:19:10.73,0:19:12.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Jadi, kuberi kau pekerjaan!
Dialogue: 0,0:19:12.35,0:19:15.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Membersihkan apartemen adalah tugasmu!
Dialogue: 0,0:19:15.48,0:19:18.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Dasar kau… Baik, jika begitu…
Dialogue: 0,0:19:18.86,0:19:21.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Mendidik para penghuni itu tugasku juga!
Dialogue: 0,0:19:22.66,0:19:24.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Akan kubunuh kau!
Dialogue: 0,0:19:24.12,0:19:25.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Coba saja kalau kau bisa…
Dialogue: 0,0:19:29.04,0:19:30.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sialan kau.
Dialogue: 0,0:19:31.37,0:19:32.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Matilah!
Dialogue: 0,0:19:34.79,0:19:36.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Matilah kau!
Dialogue: 0,0:19:39.17,0:19:41.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kalian berdua sedang apa?
Dialogue: 0,0:19:41.26,0:19:43.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Gerakannya bagus!
Dialogue: 0,0:19:43.14,0:19:45.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Akan kugambar komik\Ntentang olahraga seksi.
Dialogue: 0,0:19:45.51,0:19:48.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Hai, Semua! Hari ini di Kanal Hame,
Dialogue: 0,0:19:48.02,0:19:51.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}kusiarkan secara langsung perkelahian\Nantara orang botak dan kucing perokok.
Dialogue: 0,0:19:52.27,0:19:55.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Jangan berisik! Aku belum tidur\Nsetelah sif malam! Kubunuh kalian!
Dialogue: 0,0:19:55.77,0:19:58.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau mau pakai ini?
Dialogue: 0,0:19:58.03,0:20:00.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kak Yani Neko! Tatsuro-sensei.
Dialogue: 0,0:20:00.15,0:20:02.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku baru memosting sesuatu di Kakeyome.
Dialogue: 0,0:20:02.82,0:20:05.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Maksudku, temanku memosting.
Dialogue: 0,0:20:05.16,0:20:09.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Bagaimana bisa pancimu jadi berlubang\Nhanya dengan memanaskan kari?
Dialogue: 0,0:20:09.16,0:20:10.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Pokoknya, kubelikan yang baru…
Dialogue: 0,0:20:11.62,0:20:12.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kak?
Dialogue: 0,0:20:12.79,0:20:14.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Matilah, Botak!
Dialogue: 0,0:20:14.79,0:20:17.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Matilah kau, Cerobong Asap!
Dialogue: 0,0:20:28.47,0:20:30.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ini belum berakhir.
Dialogue: 0,0:20:33.19,0:20:34.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Sedihnya.{\i0}
Dialogue: 0,0:20:35.10,0:20:38.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Mereka bekerja agar bisa bahagia,{\i0}
Dialogue: 0,0:20:38.11,0:20:42.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}tapi tak pernah kulihat orang\Nmenemukan kebahagiaan dengan bekerja.{\i0}
Dialogue: 0,0:20:43.74,0:20:45.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Apakah kebahagiaan itu?{\i0}
Dialogue: 0,0:20:47.87,0:20:49.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Yaitu makan.{\i0}
Dialogue: 0,0:21:12.77,0:21:16.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku lupa mana yang jadi asbak,\Nmana yang masih kuminum.
Dialogue: 0,0:21:16.60,0:21:20.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Rancangan interior fungsional buatanku\Nmalah menjadi bumerang.
Dialogue: 0,0:21:20.44,0:21:23.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Bir ini mahal,\Naku tak mau membuang-buangnya.
Dialogue: 0,0:21:26.03,0:21:30.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Paru-paru Shizue berlubang\Nsetelah minum jus berisi puntung rokok.{\i0}
Dialogue: 0,0:21:30.99,0:21:32.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Itu mengerikan.{\i0}
Dialogue: 0,0:21:36.33,0:21:40.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tak kusangka, dari semua adegan,\Njustru ini adegan terakhirku! Sedihnya!
Dialogue: 0,0:21:44.97,0:21:49.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Tapi aku akan baik-baik saja\Nkarena bersikap lebih baik dari Shizue!{\i0}
Dialogue: 0,0:21:52.76,0:21:56.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku benar menebaknya!\NSudah kuduga aku beruntung.
Dialogue: 0,0:21:59.77,0:22:01.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kenapa?
Dialogue: 0,0:22:01.19,0:22:05.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa salahku sampai mengalami hal ini?
Dialogue: 0,0:22:05.94,0:22:07.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Chainsmoker Cat!{\i0}
Dialogue: 0,0:23:34.95,0:23:37.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terjemahan subtitle oleh Stysa Alverina
