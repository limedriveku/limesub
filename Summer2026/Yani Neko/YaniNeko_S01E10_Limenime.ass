Dialogue: 0,0:00:44.16,0:00:45.83,sign,,0000,0000,0000,,PIPA TANPA ASAP
Dialogue: 0,0:02:59.30,0:03:02.22,sign,,0000,0000,0000,,MOHON DUDUK YANG BENAR\NSAAT KENDARAAN MELAJU.
Dialogue: 0,0:03:41.72,0:03:42.93,sign,,0000,0000,0000,,{\an8}KAMPUNG NEKOTARO
Dialogue: 0,0:03:42.93,0:03:45.35,sign,,0000,0000,0000,,AIR TERJUN SUISHA
Dialogue: 0,0:04:36.23,0:04:37.56,sign,,0000,0000,0000,,PINTU MASUK AIR TERJUN
Dialogue: 0,0:04:37.56,0:04:39.98,sign,,0000,0000,0000,,AIR TERJUN DITUTUP KARENA TANAH LONGSOR
Dialogue: 0,0:07:00.33,0:07:04.59,sign,,0000,0000,0000,,PERASAAN YAKU TELAH DISEGARKAN KEMBALI
Dialogue: 0,0:07:05.29,0:07:07.55,sign,,0000,0000,0000,,SEPULUH MENIT KEMUDIAN
Dialogue: 0,0:07:17.27,0:07:18.68,sign,,0000,0000,0000,,{\an8}KE NYAGAMIHARA
Dialogue: 0,0:10:48.60,0:10:50.85,sign,,0000,0000,0000,,{\an8}HARI ITU = HARI LANGKA\NSAAT YANI NEKO BEKERJA
Dialogue: 0,0:11:00.20,0:11:01.61,sign,,0000,0000,0000,,TERIPANG
Dialogue: 0,0:15:28.30,0:15:29.71,sign,,0000,0000,0000,,{\an8}3 HARI SEBELUM TENGGAT WAKTU
Dialogue: 0,0:15:47.44,0:15:51.36,sign,,0000,0000,0000,,VAGINISIA SEDANG KEBINGUNGAN
Dialogue: 0,0:18:19.97,0:18:20.89,sign,,0000,0000,0000,,{\an8}PENCURI DITANGKAP
Dialogue: 0,0:19:22.78,0:19:24.24,sign,,0000,0000,0000,,MONSTER LANGIT-LANGIT
Dialogue: 0,0:20:25.39,0:20:28.01,sign,,0000,0000,0000,,1 APRIL
Dialogue: 0,0:21:58.02,0:22:00.02,sign,,0000,0000,0000,,{\an8}AKU MENGANDUNG
Dialogue: 0,0:22:00.02,0:22:02.19,sign,,0000,0000,0000,,{\an8}INI AYAHNYA
Dialogue: 0,0:23:38.04,0:23:39.08,sign,,0000,0000,0000,,INI KARYA FIKSI.
Dialogue: 0,0:23:39.08,0:23:41.00,sign,,0000,0000,0000,,ANAK-ANAK\NDILARANG MEROKOK DAN MINUM-MINUM.
Dialogue: 0,0:00:19.76,0:00:23.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bau jari yang beraroma rokok.
Dialogue: 0,0:00:23.06,0:00:26.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harum dan menyengat,\Naku tak bisa hidup tanpanya.
Dialogue: 0,0:00:26.15,0:00:28.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, asbaknya.
Dialogue: 0,0:00:28.31,0:00:31.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penuh puntung rokok\Nsampai filternya terbakar.
Dialogue: 0,0:00:36.53,0:00:38.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka baunya, seperti ubi panggang.
Dialogue: 0,0:00:38.53,0:00:39.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam dan merokok sajalah.
Dialogue: 0,0:00:39.83,0:00:44.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku hampir menyerah\Nmempertahankan rekor terlama tak merokok.
Dialogue: 0,0:02:22.47,0:02:25.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa sudah mulai merekam? Ya, 'kan?
Dialogue: 0,0:02:25.39,0:02:27.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Baiklah, dimulai!
Dialogue: 0,0:02:27.31,0:02:30.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ini Kanal Hame milik Hame-chan!
Dialogue: 0,0:02:30.60,0:02:31.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam!
Dialogue: 0,0:02:31.52,0:02:35.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melakukan siaran langsung\Ndari dalam mobil sewaan hari ini!
Dialogue: 0,0:02:35.82,0:02:38.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang bersamaku adalah Yaku-chan!
Dialogue: 0,0:02:38.24,0:02:40.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Semua, katakan hai!\N- Jangan merekamku.
Dialogue: 0,0:02:40.24,0:02:42.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau siaran sepanjang jalan?
Dialogue: 0,0:02:42.16,0:02:44.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus kusiarkan bahkan setelah tiba.
Dialogue: 0,0:02:44.08,0:02:45.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari pertahankan semangatnya!
Dialogue: 0,0:02:47.16,0:02:50.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, Semuanya!\NGravitasi terbalik di dalam mobil ini!
Dialogue: 0,0:02:50.79,0:02:53.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langit-langit menjadi lantainya!
Dialogue: 0,0:02:53.04,0:02:55.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kita menuju ke bulan…\N- Lampu merah.
Dialogue: 0,0:02:55.55,0:02:59.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aduh. Tolong, aku tak bisa bangun.
Dialogue: 0,0:03:03.68,0:03:05.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau masih bocah?
Dialogue: 0,0:03:05.05,0:03:06.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kita akan ke mana?
Dialogue: 0,0:03:06.89,0:03:08.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau pergi ke pantai.
Dialogue: 0,0:03:09.68,0:03:12.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang,\Nkita ke Air Terjun Suisha di Kanagawa.
Dialogue: 0,0:03:12.44,0:03:14.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini ketiga kalinya kuberi tahu kepadamu.
Dialogue: 0,0:03:14.90,0:03:16.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Air terjun itu bagus untuk kesehatan.
Dialogue: 0,0:03:17.73,0:03:20.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku perlu menyegarkan tubuhku\Nkarena akhir-akhir ini gelisah.
Dialogue: 0,0:03:25.41,0:03:26.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami punya tujuan!
Dialogue: 0,0:03:26.91,0:03:29.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Bagus untuk kesehatan!\N- Jangan merekamku!
Dialogue: 0,0:03:29.16,0:03:31.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sangat menakutkan.
Dialogue: 0,0:03:31.29,0:03:33.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau marah saat kurekam karena kau pemalu.
Dialogue: 0,0:03:33.50,0:03:34.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enyahlah.
Dialogue: 0,0:03:34.42,0:03:36.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Semuanya, ini akan membosankan.
Dialogue: 0,0:03:36.42,0:03:39.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Harusnya aku pergi sendiri.\N- Ayo sambil lakukan hal lain!
Dialogue: 0,0:03:55.10,0:03:56.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak mau ke toilet?
Dialogue: 0,0:03:57.02,0:03:58.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:03:58.32,0:04:00.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti tak ada kesempatan lagi.
Dialogue: 0,0:04:00.36,0:04:03.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak sering buang air sepertimu.
Dialogue: 0,0:04:03.91,0:04:05.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terserahlah. Enyah kau.
Dialogue: 0,0:04:16.58,0:04:17.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku suka perasaan{\i0}
Dialogue: 0,0:04:17.67,0:04:20.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}saat hampir tiba di tujuan.{\i0}
Dialogue: 0,0:04:23.93,0:04:26.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, aku sangat bosan di sini!
Dialogue: 0,0:04:26.80,0:04:29.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau\Nkau ceritakan kisah yang menarik?
Dialogue: 0,0:04:29.81,0:04:33.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayolah, kumohon.
Dialogue: 0,0:04:33.31,0:04:36.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Nanti aku akan disegarkan\Ndari frustrasi ini juga.{\i0}
Dialogue: 0,0:04:45.45,0:04:46.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kocak.
Dialogue: 0,0:04:50.33,0:04:52.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan kau akan berhenti tertawa?
Dialogue: 0,0:04:52.08,0:04:54.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berhasil memotret wajah kocakmu,
Dialogue: 0,0:04:54.00,0:04:56.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lebih menghibur daripada ke air terjun.
Dialogue: 0,0:04:56.04,0:04:56.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam!
Dialogue: 0,0:04:57.71,0:05:00.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini salahku karena tak mencari tahu dulu.
Dialogue: 0,0:05:01.50,0:05:04.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya kita bisa mampir\Nke kedai {\i1}parfait{\i0} terkenal.
Dialogue: 0,0:05:04.72,0:05:07.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hore! Aku suka {\i1}parfait!{\i0}
Dialogue: 0,0:05:09.60,0:05:10.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:05:11.39,0:05:12.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perutku sakit.
Dialogue: 0,0:05:14.60,0:05:17.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Yakuko, aku perlu ke toilet.
Dialogue: 0,0:05:17.60,0:05:19.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah kenapa tadi kusuruh ke toilet!
Dialogue: 0,0:05:19.56,0:05:22.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan salahku kalau tadi aku belum perlu!
Dialogue: 0,0:05:22.44,0:05:26.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, tidak ada apa-apa\Nsampai kita tiba di tempat istirahat.
Dialogue: 0,0:05:26.32,0:05:27.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak tahan lagi!
Dialogue: 0,0:05:29.24,0:05:30.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Baiklah.
Dialogue: 0,0:05:30.62,0:05:31.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini.
Dialogue: 0,0:05:31.83,0:05:33.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau buang air besar, bukan kecil!
Dialogue: 0,0:05:34.37,0:05:37.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa harus kutekan ke bokongku,\Nlalu memasukkannya?
Dialogue: 0,0:05:37.12,0:05:39.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau gila!
Dialogue: 0,0:05:39.17,0:05:43.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ukuran lubang bokongmu,\Naku yakin kau bisa membuatnya muat.
Dialogue: 0,0:05:43.17,0:05:45.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang kau pernah melihatnya?
Dialogue: 0,0:05:46.51,0:05:48.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Yaku.
Dialogue: 0,0:05:50.26,0:05:52.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:05:52.01,0:05:54.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buang air di rerumputan saja.
Dialogue: 0,0:05:58.02,0:05:59.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan meninggalkanku.
Dialogue: 0,0:05:59.48,0:06:00.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:06:00.40,0:06:03.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh, jangan meninggalkanku!\NAku bukannya sengaja!
Dialogue: 0,0:06:03.27,0:06:06.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sungguh!\N- Tak akan kutinggal, cepatlah.
Dialogue: 0,0:06:23.63,0:06:24.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:06:25.96,0:06:28.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau mau meninggalkanku?
Dialogue: 0,0:06:32.55,0:06:34.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:06:34.43,0:06:35.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!
Dialogue: 0,0:06:51.70,0:06:52.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan, Hameko!
Dialogue: 0,0:07:09.80,0:07:10.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga.
Dialogue: 0,0:07:13.64,0:07:14.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Chainsmoker Cat.{\i0}
Dialogue: 0,0:07:21.27,0:07:23.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:07:25.52,0:07:28.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar saja!\NTak ada yang berhenti untukku!
Dialogue: 0,0:07:28.61,0:07:30.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski aku sudah berpakaian seksi!
Dialogue: 0,0:07:31.53,0:07:34.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yaku Bodoh! Orang Hina!
Dialogue: 0,0:07:35.87,0:07:39.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, tolong berhenti!
Dialogue: 0,0:07:40.20,0:07:42.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asyik! Mereka berhenti!
Dialogue: 0,0:07:50.09,0:07:52.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:07:56.68,0:08:00.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku harus bagaimana?\NDia tak berkata apa-apa.{\i0}
Dialogue: 0,0:08:02.73,0:08:03.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:08:03.81,0:08:05.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}…pernapasan, jurus pertama.
Dialogue: 0,0:08:05.56,0:08:07.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa-apaan? Orang ini membuatku takut!{\i0}
Dialogue: 0,0:08:08.44,0:08:12.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, aku cukup sampai di sini,\Nkau bisa menurunkanku.
Dialogue: 0,0:08:12.15,0:08:14.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa teruskan dengan berjalan kaki.
Dialogue: 0,0:08:30.92,0:08:32.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:08:35.34,0:08:36.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:08:40.56,0:08:42.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kau buka…
Dialogue: 0,0:08:42.10,0:08:43.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulutmu.
Dialogue: 0,0:08:43.85,0:08:45.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam mulutmu.
Dialogue: 0,0:08:46.10,0:08:47.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Bagian dalam mulutmu.
Dialogue: 0,0:08:48.69,0:08:49.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunjukkan kepadaku.
Dialogue: 0,0:08:50.98,0:08:52.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Bagian dalam mulutmu!\N- Baik!
Dialogue: 0,0:09:04.50,0:09:08.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, sekali lagi, terima kasih banyak.
Dialogue: 0,0:09:08.25,0:09:09.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:09:41.78,0:09:45.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf. Aku tadi sedang iseng.
Dialogue: 0,0:09:45.04,0:09:47.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, masuklah.
Dialogue: 0,0:09:47.25,0:09:48.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:09:53.30,0:09:55.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, apa kau marah?
Dialogue: 0,0:09:55.88,0:09:58.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah tiba sejauh ini\Npadahal berjalan kaki.
Dialogue: 0,0:09:58.80,0:10:01.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau menumpang mobil orang?
Dialogue: 0,0:10:01.05,0:10:02.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tidak!\N- Apa?
Dialogue: 0,0:10:02.43,0:10:03.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku tak menumpang!
Dialogue: 0,0:10:04.52,0:10:05.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajahmu kocak.
Dialogue: 0,0:10:06.93,0:10:09.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan memotret bagian dalam mulutku!
Dialogue: 0,0:10:09.56,0:10:11.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk apa aku memotret\Nbagian dalam mulutmu?
Dialogue: 0,0:10:11.98,0:10:14.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memotret wajahmu. Tenanglah!
Dialogue: 0,0:10:16.32,0:10:18.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Chainsmoker Cat.{\i0}
Dialogue: 0,0:10:21.95,0:10:25.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah membantuku\Nmengajak Piko-chan jalan-jalan.
Dialogue: 0,0:10:25.04,0:10:26.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini upahmu.
Dialogue: 0,0:10:26.50,0:10:29.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yang harus membuang kotoran Piko-chan.
Dialogue: 0,0:10:33.46,0:10:35.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merepotkan.
Dialogue: 0,0:10:40.97,0:10:42.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pak.
Dialogue: 0,0:10:42.22,0:10:43.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:10:43.26,0:10:44.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini untukmu.
Dialogue: 0,0:10:44.47,0:10:46.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:10:46.47,0:10:48.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Hari ini adalah "hari itu".
Dialogue: 0,0:10:50.85,0:10:52.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Hari itu?
Dialogue: 0,0:11:02.99,0:11:05.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hari Kasih Sayang!{\i0}
Dialogue: 0,0:11:11.46,0:11:12.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tuing!{\i0}
Dialogue: 0,0:11:12.67,0:11:16.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak perlu repot-repot! Sungguh!
Dialogue: 0,0:11:16.46,0:11:18.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi terima kasih, akan kuterima.
Dialogue: 0,0:11:18.71,0:11:19.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menginginkannya?
Dialogue: 0,0:11:19.97,0:11:22.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bohong jika kukatakan aku tak ingin.
Dialogue: 0,0:11:22.97,0:11:24.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sangat menyukainya?
Dialogue: 0,0:11:24.60,0:11:29.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku aku harus mengurangi memakannya,\Nmengingat umurku sekarang.
Dialogue: 0,0:11:29.89,0:11:32.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku tak bisa menolak makanan manis!
Dialogue: 0,0:11:32.85,0:11:35.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau mau, itu sangat membantuku.
Dialogue: 0,0:11:36.61,0:11:40.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan? Ini terlihat seperti kotoran.
Dialogue: 0,0:11:40.69,0:11:41.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang.
Dialogue: 0,0:11:41.86,0:11:44.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat lunak. Ini cokelat buatan sendiri?
Dialogue: 0,0:11:44.99,0:11:48.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Itu kotoran baru.\N- Hentikan! Jangan ucapkan yang jorok!
Dialogue: 0,0:11:48.74,0:11:50.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini agak lengket.
Dialogue: 0,0:11:50.62,0:11:52.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu kotoran anjing baru.
Dialogue: 0,0:11:52.25,0:11:54.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang hentikan!
Dialogue: 0,0:11:54.50,0:11:57.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidungku agak tersumbat\Nkarena alergi serbuk sari,
Dialogue: 0,0:11:57.59,0:12:00.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi akan kucicipi sekarang.
Dialogue: 0,0:12:05.26,0:12:07.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjijikkan! Ini kotoran!
Dialogue: 0,0:12:07.47,0:12:08.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang.
Dialogue: 0,0:12:10.14,0:12:12.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa denganmu?
Dialogue: 0,0:12:14.40,0:12:15.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah manis?
Dialogue: 0,0:12:16.44,0:12:19.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja tidak manis, Bodoh!
Dialogue: 0,0:12:35.17,0:12:37.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paling nikmat\Nmenyantap hot dog di luar rumah!
Dialogue: 0,0:12:41.92,0:12:44.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembalikan hot dog-ku!
Dialogue: 0,0:12:45.68,0:12:48.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membalasmu, Burung!
Dialogue: 0,0:13:07.87,0:13:09.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sedang apa?
Dialogue: 0,0:13:10.33,0:13:13.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu burung? Elang? Layang-layang?
Dialogue: 0,0:13:13.16,0:13:14.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius, kau sedang apa?
Dialogue: 0,0:13:14.79,0:13:17.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kusembelih ini untuk buat "ayam dog".
Dialogue: 0,0:13:17.08,0:13:19.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan ayam.
Dialogue: 0,0:13:19.04,0:13:21.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan burung yang bisa dimakan.
Dialogue: 0,0:13:21.25,0:13:25.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang memutuskan\Nburung apa boleh dimakan?
Dialogue: 0,0:13:25.38,0:13:26.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa sikapmu begitu?
Dialogue: 0,0:13:29.72,0:13:31.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat.
Dialogue: 0,0:13:31.76,0:13:33.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, untukmu membeli makan malam.
Dialogue: 0,0:13:33.56,0:13:34.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh?
Dialogue: 0,0:13:34.77,0:13:37.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sebagai gantinya,\Nbebaskan burung itu.
Dialogue: 0,0:13:37.23,0:13:40.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa membeli rokok dengan ini.
Dialogue: 0,0:13:49.70,0:13:51.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepasang mata itu…
Dialogue: 0,0:13:52.03,0:13:54.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasakan tekad kuat\Ndari tatapan matanya.
Dialogue: 0,0:13:56.04,0:13:57.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tidak mungkin.
Dialogue: 0,0:14:03.71,0:14:05.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kau?
Dialogue: 0,0:14:07.47,0:14:10.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku burung pemangsa\Nyang kau selamatkan sore tadi.
Dialogue: 0,0:14:10.14,0:14:13.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin membalas budi\Nkarena kau menyelamatkanku.
Dialogue: 0,0:14:14.77,0:14:16.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan!
Dialogue: 0,0:14:16.43,0:14:18.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau harus lebih menghargai dirimu!
Dialogue: 0,0:14:23.02,0:14:25.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya ini yang bisa kulakukan\Nuntuk membalas budi.
Dialogue: 0,0:14:51.51,0:14:53.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bahagia sekali.
Dialogue: 0,0:14:58.73,0:15:01.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin itu terjadi.
Dialogue: 0,0:15:11.95,0:15:13.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah pagi.
Dialogue: 0,0:15:15.03,0:15:16.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus bekerja.
Dialogue: 0,0:15:29.72,0:15:32.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku tak bisa mendapat ide! Aku payah!
Dialogue: 0,0:15:32.55,0:15:36.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku muak dengan dunia\Npenuh persaingan ini! Aku ingin keluar.
Dialogue: 0,0:15:36.81,0:15:39.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku juga tak mau kembali ke kampung!
Dialogue: 0,0:15:39.73,0:15:42.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benci ini,\Ntapi aku juga tak ingin menggambar.
Dialogue: 0,0:15:42.60,0:15:43.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tenggat waktunya!
Dialogue: 0,0:15:54.70,0:15:57.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kostum yang kubeli\Nuntuk referensi ini sangat seksi.
Dialogue: 0,0:15:57.41,0:15:59.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya bisa melawan apa\Ndengan memakai ini?
Dialogue: 0,0:16:02.62,0:16:04.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tubuhku lembek begini?
Dialogue: 0,0:16:04.46,0:16:08.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau manga tak bisa menghidupiku,\Nmungkin akan kucoba pekerjaan seperti ini.
Dialogue: 0,0:16:09.71,0:16:12.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau di dalam?\NAku mau bicara soal uang sewa.
Dialogue: 0,0:16:13.84,0:16:16.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pak! Ini tak seperti yang kau kira!
Dialogue: 0,0:16:16.51,0:16:18.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hanya bahan referensi.
Dialogue: 0,0:16:18.35,0:16:19.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tuing!{\i0}
Dialogue: 0,0:16:21.39,0:16:24.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, kau datang menagih uang sewa, bukan?
Dialogue: 0,0:16:24.02,0:16:25.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku malah berpakaian begini.
Dialogue: 0,0:16:25.85,0:16:26.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Syut!{\i0}
Dialogue: 0,0:16:30.73,0:16:32.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tuing!{\i0}
Dialogue: 0,0:16:32.95,0:16:34.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Syut!{\i0}
Dialogue: 0,0:16:35.24,0:16:36.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tuing!{\i0}
Dialogue: 0,0:16:37.41,0:16:40.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tuing, tuing, tuing, bum!{\i0}
Dialogue: 0,0:16:40.12,0:16:41.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tuing.{\i0}
Dialogue: 0,0:16:43.75,0:16:45.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Chainsmoker Cat.{\i0}
Dialogue: 0,0:17:04.81,0:17:06.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tok, tok.
Dialogue: 0,0:17:06.90,0:17:09.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekitar pukul segini\Nkau tidur siang, bukan?
Dialogue: 0,0:17:09.61,0:17:12.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu tidak mengganggu belajarmu?
Dialogue: 0,0:17:15.65,0:17:18.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuaca mulai hangat,
Dialogue: 0,0:17:18.12,0:17:21.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kau bisa sakit\Njika tidur dengan perut terbuka.
Dialogue: 0,0:17:30.04,0:17:34.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia sangat murah hati\Nmengizinkanku menumpang mandi.{\i0}
Dialogue: 0,0:17:34.51,0:17:37.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Keleluasaan yang hilang\Ndari manusia modern, masih ada{\i0}
Dialogue: 0,0:17:37.13,0:17:38.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}di gedung apartemen ini.{\i0}
Dialogue: 0,0:17:41.06,0:17:44.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku percaya dengan menghentikan\Nmonopoli atas sumber daya{\i0}
Dialogue: 0,0:17:44.14,0:17:45.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan bekerja sama,{\i0}
Dialogue: 0,0:17:45.56,0:17:49.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}umat manusia dapat menghadapi\Ndunia yang tidak stabil ini.{\i0}
Dialogue: 0,0:17:53.07,0:17:54.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga.
Dialogue: 0,0:17:54.99,0:17:58.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya ada miras\Ndan camilan pendamping bir di sini.
Dialogue: 0,0:17:58.16,0:18:01.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minum-minum begini\Ntak baik bagi kesehatanmu.
Dialogue: 0,0:18:01.74,0:18:03.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya akan ambil sebotol bir.
Dialogue: 0,0:18:03.99,0:18:07.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu, aku hanya mementingkan kesehatanmu.
Dialogue: 0,0:18:08.37,0:18:10.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin akan kuambil\Nbeberapa camilan juga.
Dialogue: 0,0:18:11.67,0:18:16.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Pagi tadi, seorang pria berusia 31 tahun\Nditangkap di Kota Nyagamihara{\i0}
Dialogue: 0,0:18:16.84,0:18:19.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}saat dipergoki membobol masuk dan mencuri.{\i0}
Dialogue: 0,0:18:20.89,0:18:25.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pencuri itu berkata hanya berbagi\Ndan menyangkal tuduhan tersebut.{\i0}
Dialogue: 0,0:18:25.02,0:18:28.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Polisi yakin\Nada kejahatan lain yang dilakukan.{\i0}
Dialogue: 0,0:18:28.39,0:18:32.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak paham kenapa ada\Norang yang sampai mencuri
Dialogue: 0,0:18:32.69,0:18:34.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}demi memuaskan rasa lapar.
Dialogue: 0,0:18:34.90,0:18:37.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau lapar, minta bantuan saja.
Dialogue: 0,0:18:37.90,0:18:41.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada banyak anggota masyarakat\Nyang mau membantu.
Dialogue: 0,0:18:43.45,0:18:45.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia hanya domba malang lainnya,
Dialogue: 0,0:18:45.70,0:18:49.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dicuci otak oleh anggapan\Nyang terbentuk tentang kapitalisme.
Dialogue: 0,0:18:49.54,0:18:52.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aru Neko, bayar uang sewa!
Dialogue: 0,0:18:52.04,0:18:54.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sedang tidur siang.
Dialogue: 0,0:18:55.05,0:18:57.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bangunlah!
Dialogue: 0,0:18:57.51,0:18:59.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus bagaimana kepadamu?
Dialogue: 0,0:19:00.80,0:19:02.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Pelaku pelecehan.
Dialogue: 0,0:19:02.09,0:19:03.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan!
Dialogue: 0,0:19:03.72,0:19:06.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untunglah hanya aku yang datang.
Dialogue: 0,0:19:06.89,0:19:10.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau harus hati-hati.\NKau bahkan tak mengunci pintu.
Dialogue: 0,0:19:10.02,0:19:13.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak penghuni ilegal\Ndan orang aneh akhir-akhir ini.
Dialogue: 0,0:19:14.57,0:19:16.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau mendengarkanku?
Dialogue: 0,0:19:18.07,0:19:19.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menatap apa?
Dialogue: 0,0:19:21.07,0:19:22.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster di langit-langit?
Dialogue: 0,0:19:24.24,0:19:28.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada monster atau siluman burung.
Dialogue: 0,0:19:28.95,0:19:32.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan imajinasimu dan bayar uang sewa.
Dialogue: 0,0:19:33.46,0:19:36.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang basah dan berlendir!
Dialogue: 0,0:19:36.34,0:19:39.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster Penjilat di langit-langit!
Dialogue: 0,0:19:41.34,0:19:44.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini? Jangan kembali tidur!
Dialogue: 0,0:19:45.55,0:19:46.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Chainsmoker Cat.{\i0}
Dialogue: 0,0:20:07.99,0:20:09.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kansai.\N- Ya?
Dialogue: 0,0:20:10.83,0:20:12.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku perlu bicara padamu.
Dialogue: 0,0:20:16.34,0:20:18.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kena kanker,\Nkata dokter umurku setahun lagi.
Dialogue: 0,0:20:28.01,0:20:31.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu hal yang sulit sekali ditanggapi!
Dialogue: 0,0:20:33.31,0:20:36.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bercanda tentang hal\Nyang terlalu sensitif kalau terjadi!
Dialogue: 0,0:20:36.90,0:20:38.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat lelucon yang lebih lucu!
Dialogue: 0,0:20:42.11,0:20:43.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maka aku berhenti merokok.
Dialogue: 0,0:20:43.74,0:20:45.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bohong,\Nsemua perokok berkata begitu.
Dialogue: 0,0:20:46.53,0:20:48.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau tak beri aku contoh?
Dialogue: 0,0:20:48.91,0:20:50.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memberimu contoh?
Dialogue: 0,0:20:50.62,0:20:52.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada hal lucu yang bisa kukatakan.
Dialogue: 0,0:20:53.08,0:20:58.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau bersikeras, akan kucoba.
Dialogue: 0,0:20:58.54,0:21:00.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak terlalu peduli.
Dialogue: 0,0:21:00.05,0:21:01.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini.
Dialogue: 0,0:21:03.09,0:21:04.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlihat mirip denganmu.
Dialogue: 0,0:21:04.93,0:21:07.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya dua anak.
Dialogue: 0,0:21:07.55,0:21:10.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu reaksi yang bagus. Manis, bukan?
Dialogue: 0,0:21:10.43,0:21:11.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuberi tahu semuanya!
Dialogue: 0,0:21:11.81,0:21:13.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Bodoh!
Dialogue: 0,0:21:15.06,0:21:17.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menyuruhku\Nmenceritakan satu kebohongan!
Dialogue: 0,0:21:19.06,0:21:20.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Bagaimanapun juga,
Dialogue: 0,0:21:20.57,0:21:24.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku terkejut kau membawa-bawa\Nfoto dirimu dan adikmu.
Dialogue: 0,0:21:24.44,0:21:26.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada yang salah dengan itu.
Dialogue: 0,0:21:27.95,0:21:29.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sungguh lucu.
Dialogue: 0,0:21:31.87,0:21:34.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau membuatku tersipu! Ada apa denganmu?
Dialogue: 0,0:21:34.71,0:21:35.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berbohong.
Dialogue: 0,0:21:35.62,0:21:39.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya terpikir sesuatu yang lucu.\NAkan kupinjam Shunran.
Dialogue: 0,0:21:40.34,0:21:41.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga kau bohong.
Dialogue: 0,0:21:42.13,0:21:45.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak sabar menantikan\Nkaryawisata sekolah kita bulan depan.
Dialogue: 0,0:21:45.88,0:21:48.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suvenir apa\Nyang akan kubelikan untuk kakakku?
Dialogue: 0,0:21:48.30,0:21:50.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu! Mari beli camilan bersama!
Dialogue: 0,0:21:52.22,0:21:53.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:21:54.98,0:21:56.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari kakakku.
Dialogue: 0,0:22:03.23,0:22:04.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kehamilan.{\i0}
Dialogue: 0,0:22:06.32,0:22:07.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kehamilan!
Dialogue: 0,0:23:32.95,0:23:38.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terjemahan subtitle oleh Stysa Alverina
