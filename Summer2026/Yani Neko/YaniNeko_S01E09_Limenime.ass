Dialogue: 0,0:00:01.00,0:00:03.42,sign,,0000,0000,0000,,{\an8}KAMAR MANDI
Dialogue: 0,0:02:15.00,0:02:16.88,sign,,0000,0000,0000,,{\an8}OUJI RUKO - PENYUKA MANUSIA HEWAN
Dialogue: 0,0:03:29.37,0:03:30.45,sign,,0000,0000,0000,,INI TINJA
Dialogue: 0,0:03:41.22,0:03:44.64,sign,,0000,0000,0000,,NOTIFIKASI PEMERIKSAAN KESEHATAN
Dialogue: 0,0:08:56.82,0:08:58.24,sign,,0000,0000,0000,,PERSEMBAHAN BUNGA
Dialogue: 0,0:10:42.05,0:10:44.43,sign,,0000,0000,0000,,PUSAT BUSANA NEKOMURA
Dialogue: 0,0:12:38.63,0:12:41.30,sign,,0000,0000,0000,,PAKAIAN CEROBONG ASAP HARI INI
Dialogue: 0,0:12:41.88,0:12:43.72,sign,,0000,0000,0000,,JAKET YANG DIBELI YAKU
Dialogue: 0,0:12:43.72,0:12:44.97,sign,,0000,0000,0000,,PAKAIAN KASUAL KANSAI
Dialogue: 0,0:12:44.97,0:12:46.05,sign,,0000,0000,0000,,PARFUM TEMBAKAU ALAMI
Dialogue: 0,0:13:38.23,0:13:39.31,sign,,0000,0000,0000,,{\an8}HIPNOSIS
Dialogue: 0,0:14:50.18,0:14:51.09,sign,,0000,0000,0000,,AKU BUTUH INI
Dialogue: 0,0:16:02.25,0:16:04.46,sign,,0000,0000,0000,,HASIL TES\NYOMUKO KAKU
Dialogue: 0,0:16:04.46,0:16:06.04,sign,,0000,0000,0000,,PERINGKAT: 45
Dialogue: 0,0:18:48.41,0:18:49.66,sign,,0000,0000,0000,,PASTI KAU SALAH SATUNYA
Dialogue: 0,0:18:49.67,0:18:50.67,sign,,0000,0000,0000,,MENGGELIKAN!
Dialogue: 0,0:18:50.67,0:18:52.04,sign,,0000,0000,0000,,ADA APA DENGANNYA?
Dialogue: 0,0:18:55.30,0:18:57.71,sign,,0000,0000,0000,,DIA MENDAPAT KRITIKAN
Dialogue: 0,0:22:04.57,0:22:07.03,sign,,0000,0000,0000,,{\an8}HATI NURANI SHIZUE TERPUKUL!
Dialogue: 0,0:23:38.04,0:23:39.08,sign,,0000,0000,0000,,INI KARYA FIKSI.
Dialogue: 0,0:23:39.08,0:23:41.00,sign,,0000,0000,0000,,ANAK-ANAK\NDILARANG MEROKOK DAN MINUM-MINUM.
Dialogue: 0,0:00:04.00,0:00:06.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saatnya ke kamar mandi.
Dialogue: 0,0:00:07.79,0:00:10.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh merokok di kamar mandi.
Dialogue: 0,0:00:10.96,0:00:14.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa BAB jika tak sambil merokok.
Dialogue: 0,0:00:14.01,0:00:15.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetap tidak boleh!
Dialogue: 0,0:00:16.14,0:00:18.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti penyiram kebakaran menyala.
Dialogue: 0,0:00:18.39,0:00:21.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah masalah\Nyang ditimbulkan manusia hewan.
Dialogue: 0,0:02:16.88,0:02:17.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Imut sekali.{\i0}
Dialogue: 0,0:02:19.26,0:02:21.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku ingin menjadi temannya.{\i0}
Dialogue: 0,0:02:21.76,0:02:23.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dan jika memungkinkan,{\i0}
Dialogue: 0,0:02:23.81,0:02:26.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}semoga aku boleh\Nmenyentuh telinga dan ekornya.{\i0}
Dialogue: 0,0:02:28.94,0:02:29.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu imut sekali!{\i0}
Dialogue: 0,0:02:32.52,0:02:33.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perutku sampai sakit!
Dialogue: 0,0:02:35.78,0:02:37.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Ruko sedang bermeditasi?
Dialogue: 0,0:02:38.28,0:02:40.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tampan sekali!\NAku bisa lama memandanginya.
Dialogue: 0,0:02:41.07,0:02:43.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}"Menyentuh" yang kumaksud,\Nhanya mengelus lembut.{\i0}
Dialogue: 0,0:02:43.62,0:02:45.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu saja cukup bagiku.{\i0}
Dialogue: 0,0:02:45.08,0:02:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tak akan bersikap kasar.{\i0}
Dialogue: 0,0:02:47.54,0:02:48.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:02:48.79,0:02:50.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imo-chan orang yang seperti apa?
Dialogue: 0,0:02:51.12,0:02:52.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sangat menyayangi kakaknya.
Dialogue: 0,0:02:52.79,0:02:55.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tapi cara dia menunjukkannya aneh.
Dialogue: 0,0:02:55.30,0:02:56.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Imutnya.{\i0}
Dialogue: 0,0:02:56.42,0:02:59.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kakaknya itu sangat bermasalah.
Dialogue: 0,0:02:59.80,0:03:00.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bermasalah?{\i0}
Dialogue: 0,0:03:02.30,0:03:05.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari apa yang kami dengar, dia agak jorok.
Dialogue: 0,0:03:05.01,0:03:06.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jorok bagaimana?
Dialogue: 0,0:03:09.23,0:03:10.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa BAB di tempat umum.
Dialogue: 0,0:03:15.32,0:03:17.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa maksudnya itu?{\i0}
Dialogue: 0,0:03:17.48,0:03:19.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia BAB sembarangan?{\i0}
Dialogue: 0,0:03:19.99,0:03:20.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu mengerikan.{\i0}
Dialogue: 0,0:03:21.70,0:03:22.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak!{\i0}
Dialogue: 0,0:03:26.33,0:03:29.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalau itu yang dia sukai,\Naku bisa menerimanya!{\i0}
Dialogue: 0,0:03:30.46,0:03:35.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi kalau kutunjukkan ketertarikan aneh\Nseperti itu di sekolah, akan jadi skandal.{\i0}
Dialogue: 0,0:03:35.75,0:03:38.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ibu bisa membunuhku!{\i0}
Dialogue: 0,0:03:38.46,0:03:40.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku harus bagaimana?{\i0}
Dialogue: 0,0:03:51.27,0:03:52.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imoko.
Dialogue: 0,0:03:58.19,0:03:59.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruko-chan?
Dialogue: 0,0:03:59.90,0:04:02.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf aku mencegatmu di lorong seperti ini.
Dialogue: 0,0:04:02.99,0:04:05.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa. Ada apa?
Dialogue: 0,0:04:05.16,0:04:06.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menyukaimu.
Dialogue: 0,0:04:06.24,0:04:07.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu. Maksudku…
Dialogue: 0,0:04:07.74,0:04:10.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin memberikan ini kepadamu.
Dialogue: 0,0:04:12.25,0:04:14.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imut sekali! Ini untukmu?
Dialogue: 0,0:04:15.75,0:04:17.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kau boleh membukanya.\N- Sungguh?
Dialogue: 0,0:04:18.54,0:04:19.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku penasaran apa isinya.
Dialogue: 0,0:04:29.81,0:04:30.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:04:39.98,0:04:42.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa salahku?{\i0}
Dialogue: 0,0:04:53.45,0:04:55.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kehabisan rokok.
Dialogue: 0,0:04:55.50,0:04:59.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa BAB jika tidak merokok.
Dialogue: 0,0:04:59.29,0:05:02.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus bagaimana?\NMasih ada yang belum keluar.
Dialogue: 0,0:05:03.01,0:05:05.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada sebungkus rokok baru di dalam kamarku.
Dialogue: 0,0:05:06.38,0:05:09.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa aku bisa merokok\Npakai puntung bekas.
Dialogue: 0,0:05:10.60,0:05:13.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, jangan malas dan ambillah.
Dialogue: 0,0:05:20.52,0:05:24.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rokok baru rasanya lebih nikmat.
Dialogue: 0,0:05:29.66,0:05:31.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum putus.
Dialogue: 0,0:05:32.41,0:05:37.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus bergerak hati-hati,\Nsupaya tidak putus.
Dialogue: 0,0:05:38.42,0:05:41.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yani Neko, kubawakan kau\Npengumuman di lingkungan kita.
Dialogue: 0,0:05:55.18,0:05:57.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siluman kucing berekor dua?
Dialogue: 0,0:05:59.10,0:06:01.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Chainsmoker Cat.{\i0}
Dialogue: 0,0:06:03.19,0:06:06.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, Matsuo Basho berjalan sangat cepat.
Dialogue: 0,0:06:06.78,0:06:09.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutmu apa\Nyang dikatakan muridnya, Kawai Sora?
Dialogue: 0,0:06:09.45,0:06:11.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Jangan berbasa-Basho."
Dialogue: 0,0:06:13.16,0:06:16.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Guru, ini Jalan Sempit\NMenuju Semangkuk Basho."
Dialogue: 0,0:06:16.91,0:06:18.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Ter-Sora-hlah."
Dialogue: 0,0:06:20.21,0:06:22.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mendadak menciptakan lelucon itu.
Dialogue: 0,0:06:22.92,0:06:24.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak bisa berhenti tertawa.
Dialogue: 0,0:06:28.47,0:06:29.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Jangan berbasa-Basho."
Dialogue: 0,0:06:58.08,0:07:03.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Keseharian hidup Yani Neko{\i0}
Dialogue: 0,0:07:03.67,0:07:09.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Biar kuceritakan sesuatu\NTentang Yani Neko{\i0}
Dialogue: 0,0:07:09.51,0:07:12.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa kau siap?{\i0}
Dialogue: 0,0:07:12.51,0:07:16.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Inilah fakta tentang Yani Neko{\i0}
Dialogue: 0,0:07:16.64,0:07:21.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Biar kuceritakan sesuatu\NTentang Yani Neko{\i0}
Dialogue: 0,0:07:21.10,0:07:23.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Ternyata ****nanya tidak berbau{\i0}
Dialogue: 0,0:07:24.94,0:07:26.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo.
Dialogue: 0,0:07:26.65,0:07:27.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunuh aku.
Dialogue: 0,0:07:27.86,0:07:30.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti yang kau rasakan,\Ntapi tenanglah.
Dialogue: 0,0:07:30.70,0:07:31.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat tenang.
Dialogue: 0,0:07:33.11,0:07:34.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunuh aku.
Dialogue: 0,0:07:34.74,0:07:37.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunuh aku. Bunuh aku.
Dialogue: 0,0:07:38.16,0:07:40.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Chainsmoker Cat!{\i0}
Dialogue: 0,0:07:52.05,0:07:55.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kita akan melanjutkan\Ndengan penghormatan dari manusia hewan.{\i0}
Dialogue: 0,0:07:56.05,0:08:00.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Para Pelayat, mundurlah demi keamanan.{\i0}
Dialogue: 0,0:08:02.44,0:08:03.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:08:04.40,0:08:07.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kita harus ke krematorium\Nsetelah upacaranya selesai?
Dialogue: 0,0:08:08.07,0:08:10.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa petinya diletakkan di sana?
Dialogue: 0,0:08:10.65,0:08:13.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan bukankah Kakek benci rokok?
Dialogue: 0,0:08:13.65,0:08:15.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kenapa ada banyak rokok?
Dialogue: 0,0:08:15.24,0:08:16.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah itu tidak sopan?
Dialogue: 0,0:08:18.99,0:08:20.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rokoknya akan segera lenyap.
Dialogue: 0,0:08:20.91,0:08:22.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:08:22.91,0:08:24.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka datang!
Dialogue: 0,0:08:24.00,0:08:27.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Nenek bertingkah tak masuk akal.
Dialogue: 0,0:08:53.07,0:08:54.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia hewan? Kenapa?
Dialogue: 0,0:09:09.09,0:09:11.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga! Apa mereka memakan Kakek?
Dialogue: 0,0:09:11.71,0:09:13.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Nenek tak menghentikan mereka?
Dialogue: 0,0:09:15.30,0:09:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, mari kita beri\Nsalam perpisahan terakhir.
Dialogue: 0,0:09:43.08,0:09:47.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Suamiku menyukai manusia hewan.
Dialogue: 0,0:09:51.42,0:09:54.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, bukankah dia tampak bahagia?
Dialogue: 0,0:10:00.26,0:10:01.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga.
Dialogue: 0,0:10:01.80,0:10:04.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakek sangat konyol\Nsampai saat terakhir pun.
Dialogue: 0,0:10:05.18,0:10:06.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka…
Dialogue: 0,0:10:07.10,0:10:09.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakek.
Dialogue: 0,0:10:24.70,0:10:28.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada satu pun merek yang kusukai.
Dialogue: 0,0:10:28.58,0:10:29.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Amat mengecewakan.
Dialogue: 0,0:10:44.43,0:10:47.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah\Nmenghabiskan hari liburmu bersamaku.
Dialogue: 0,0:10:47.81,0:10:50.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama-sama.\NLagi pula, aku suka melihat-lihat baju.
Dialogue: 0,0:10:50.81,0:10:54.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakaian Kak Yani Neko selalu cepat usang,\Ndan dia tampak kedinginan.
Dialogue: 0,0:10:54.69,0:10:56.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau mau membelikannya baju?
Dialogue: 0,0:10:56.65,0:10:59.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kau sangat murah hati.
Dialogue: 0,0:10:59.53,0:11:03.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hanya ganti rugi atas bajunya
Dialogue: 0,0:11:03.07,0:11:06.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}karena aku pernah\Nmerobek bajunya sangat parah.{\i0}
Dialogue: 0,0:11:06.83,0:11:08.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kapan itu terjadi?{\i0}
Dialogue: 0,0:11:10.71,0:11:14.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana yang ini?\NWarna putih terlihat bagus untuknya.
Dialogue: 0,0:11:16.13,0:11:17.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, ini tak bagus.
Dialogue: 0,0:11:17.46,0:11:20.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa?\N- Kau tahu berapa banyak dia merokok.
Dialogue: 0,0:11:20.67,0:11:23.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya butuh tiga hari\Nsampai semua baju putihnya menguning.
Dialogue: 0,0:11:25.05,0:11:26.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:11:26.43,0:11:27.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu…
Dialogue: 0,0:11:28.81,0:11:30.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana yang ini?
Dialogue: 0,0:11:31.52,0:11:34.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Itu juga tidak bagus.\N- Kenapa?
Dialogue: 0,0:11:34.11,0:11:35.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada bulu-bulu di lengan bajunya.
Dialogue: 0,0:11:37.53,0:11:40.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan terbakar saat dia menyalakan rokok.
Dialogue: 0,0:11:40.99,0:11:42.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Berbahaya jika dia pakai.{\i0}
Dialogue: 0,0:11:42.49,0:11:45.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan dia tidak akan…
Dialogue: 0,0:11:45.03,0:11:46.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti tempo hari, Imo-chan…
Dialogue: 0,0:11:46.62,0:11:48.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini untukmu.
Dialogue: 0,0:11:48.70,0:11:51.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}…memberi kado sarung tangan kepada Yaniko.{\i0}
Dialogue: 0,0:11:53.87,0:11:55.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi…{\i0}
Dialogue: 0,0:12:14.35,0:12:17.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pemantik tersangkut di sarung tangannya.{\i0}
Dialogue: 0,0:12:17.40,0:12:19.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imo-chan sangat kesal.
Dialogue: 0,0:12:19.53,0:12:21.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Cerobong Asap Bodoh, merepotkan saja!{\i0}
Dialogue: 0,0:12:21.86,0:12:23.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kalau begitu, bagaimana yang ini?
Dialogue: 0,0:12:23.99,0:12:26.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abu-abu, tanpa bulu-bulu,\Nantibakteri, bebas bau rokok.
Dialogue: 0,0:12:26.99,0:12:29.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Juga ada banyak saku\Nuntuk dia membawa rokok.
Dialogue: 0,0:12:29.41,0:12:31.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan tak akan membuat pemantik tersangkut!
Dialogue: 0,0:12:31.75,0:12:33.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu.
Dialogue: 0,0:12:33.12,0:12:34.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:12:34.37,0:12:36.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak cukup imut.
Dialogue: 0,0:12:46.05,0:12:47.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus juga!
Dialogue: 0,0:12:47.34,0:12:49.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlihat cocok kau pakai!
Dialogue: 0,0:12:49.39,0:12:53.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya hangat.\NTerima kasih, Yaku. Terima kasih, Kansai.
Dialogue: 0,0:12:54.44,0:12:55.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jagalah dengan baik.
Dialogue: 0,0:12:56.52,0:12:58.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, kenapa sakumu penuh sekali?
Dialogue: 0,0:12:58.77,0:13:01.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau senang sekali\Nsampai memenuhi saku dengan rokok?
Dialogue: 0,0:13:02.07,0:13:03.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:13:03.44,0:13:05.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imut sekali kau!
Dialogue: 0,0:13:05.24,0:13:07.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berhasil\Nmemasukkan banyak puntung rokok.
Dialogue: 0,0:13:08.53,0:13:10.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:13:10.08,0:13:12.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia monster.\NJangan mengharapkan apa-apa darinya.
Dialogue: 0,0:13:13.87,0:13:15.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudapat satu lagi dari tanah.
Dialogue: 0,0:13:18.04,0:13:19.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, setelah susah payah,
Dialogue: 0,0:13:19.67,0:13:23.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}inilah Kak Yani Neko baru\Nyang membenci rokok.
Dialogue: 0,0:13:23.05,0:13:23.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:13:24.55,0:13:26.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rokok itu jahat.
Dialogue: 0,0:13:26.01,0:13:28.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membuat orang\Njadi perokok pasif itu kriminalitas.
Dialogue: 0,0:13:30.01,0:13:31.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kira dirinya komentator daring?
Dialogue: 0,0:13:32.35,0:13:36.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak paham apa yang terjadi.\NBisa kau jelaskan kepadaku?
Dialogue: 0,0:13:36.44,0:13:38.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini…
Dialogue: 0,0:13:39.31,0:13:41.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku dapat\Naplikasi pengubah tabiat di internet.
Dialogue: 0,0:13:43.65,0:13:48.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak akan mau merokok lagi.
Dialogue: 0,0:13:48.03,0:13:50.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan perlahan-lahan membencinya.
Dialogue: 0,0:13:50.37,0:13:53.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melihat sebatang rokok saja\Nmembuatmu jijik.
Dialogue: 0,0:13:56.00,0:13:59.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kucoba kepada Kak Yani Neko,\Nitu cukup ampuh juga.
Dialogue: 0,0:14:01.00,0:14:03.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah melihatnya di komik erotis.
Dialogue: 0,0:14:03.42,0:14:05.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa dia menggosok gigi?
Dialogue: 0,0:14:05.26,0:14:07.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tak bisa hilangkan fiksasi oralnya.
Dialogue: 0,0:14:07.76,0:14:10.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah langkah sedikit,\Nini bisa berubah jadi film porno.
Dialogue: 0,0:14:13.47,0:14:14.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau ke mana?
Dialogue: 0,0:14:19.90,0:14:22.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster itu telah dilepaskan ke dunia.
Dialogue: 0,0:14:34.91,0:14:36.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yani Neko-chan?
Dialogue: 0,0:14:36.83,0:14:38.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini bukan jadwalmu jadi asistenku.
Dialogue: 0,0:14:39.54,0:14:41.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau menggosok gigimu?
Dialogue: 0,0:14:44.09,0:14:46.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Kenapa?
Dialogue: 0,0:14:46.09,0:14:47.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bau sekali!
Dialogue: 0,0:14:47.88,0:14:49.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rokok dipadamkan.
Dialogue: 0,0:14:51.09,0:14:52.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jijik!
Dialogue: 0,0:14:56.68,0:14:59.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lakukan satu hal baik setiap hari.
Dialogue: 0,0:15:00.60,0:15:01.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Berita terkini.{\i0}
Dialogue: 0,0:15:01.69,0:15:04.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sekitar pukul 16.00,\Nseorang wanita muncul,{\i0}
Dialogue: 0,0:15:04.98,0:15:07.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}meludah di area merokok\NStasiun Nyagamihara.{\i0}
Dialogue: 0,0:15:07.78,0:15:10.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Polisi prefektur kini sedang mencarinya{\i0}
Dialogue: 0,0:15:10.20,0:15:12.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan mengumpulkan info dari warga setempat,{\i0}
Dialogue: 0,0:15:12.99,0:15:15.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tapi jagalah jarak dengannya\Njika Anda melihatnya.{\i0}
Dialogue: 0,0:15:15.45,0:15:18.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia lebih bermasalah\Ndaripada waktu merokok!
Dialogue: 0,0:15:18.87,0:15:20.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Menurut saksi mata…{\i0}
Dialogue: 0,0:15:22.71,0:15:24.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Chainsmoker Cat.{\i0}
Dialogue: 0,0:15:26.63,0:15:27.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sato.
Dialogue: 0,0:15:27.71,0:15:28.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:15:36.35,0:15:38.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imo-chan sangat mengagumkan.
Dialogue: 0,0:15:38.14,0:15:40.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia hewan\Npunya kemampuan fisik yang luar biasa.
Dialogue: 0,0:15:41.64,0:15:42.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaku.
Dialogue: 0,0:15:43.48,0:15:44.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:15:55.74,0:15:58.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kurasa belum tentu semuanya begitu.{\i0}
Dialogue: 0,0:16:06.04,0:16:10.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Asyik! Untuk pertama kalinya,\Naku masuk peringkat 50 besar.{\i0}
Dialogue: 0,0:16:10.38,0:16:11.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Syukurlah.{\i0}
Dialogue: 0,0:16:11.67,0:16:14.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Berfokus pada kemampuan matematikaku\Nyang lemah itu tak sia-sia!{\i0}
Dialogue: 0,0:16:14.89,0:16:16.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar, Imoko?
Dialogue: 0,0:16:16.14,0:16:18.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kau peringkat delapan seangkatan?\N- Wah.
Dialogue: 0,0:16:18.31,0:16:19.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau seperti Conan!
Dialogue: 0,0:16:19.89,0:16:21.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya beruntung.
Dialogue: 0,0:16:27.65,0:16:30.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku manusia hewan\Ndengan kemampuan atletik payah.{\i0}
Dialogue: 0,0:16:30.11,0:16:32.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kemampuan akademikku juga payah.{\i0}
Dialogue: 0,0:16:34.07,0:16:35.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Asal tahu saja,{\i0}
Dialogue: 0,0:16:36.12,0:16:38.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}sekelas dengan Sato{\i0}
Dialogue: 0,0:16:39.08,0:16:40.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}agak menyesakkan.{\i0}
Dialogue: 0,0:16:44.33,0:16:45.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau di sana!
Dialogue: 0,0:16:46.75,0:16:48.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sato?
Dialogue: 0,0:16:48.79,0:16:53.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teman sekelas memberitahuku\Nkau selalu makan siang di teras atap.
Dialogue: 0,0:16:53.80,0:16:55.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:16:55.47,0:16:59.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka membaca dan tempat yang sunyi.
Dialogue: 0,0:16:59.89,0:17:04.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham sekali!\NTerkadang aku juga ingin sendirian.
Dialogue: 0,0:17:05.64,0:17:08.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku setiap hari, bukan terkadang.{\i0}
Dialogue: 0,0:17:11.32,0:17:12.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia dekat sekali!{\i0}
Dialogue: 0,0:17:12.57,0:17:16.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku ke sini untuk meminta bantuanmu.
Dialogue: 0,0:17:16.82,0:17:21.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa?\N- Aku tak pandai menulis esai.
Dialogue: 0,0:17:21.08,0:17:22.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa kau mengajariku cara-caranya?
Dialogue: 0,0:17:24.00,0:17:25.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:17:25.58,0:17:29.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata kakakku, kau menulis novel.
Dialogue: 0,0:17:30.50,0:17:32.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, yang menulis itu temanku.
Dialogue: 0,0:17:32.42,0:17:35.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, nilaimu\Ndi pelajaran bahasa sangat baik.
Dialogue: 0,0:17:37.34,0:17:39.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada yang istimewa.
Dialogue: 0,0:17:39.09,0:17:41.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya suka membaca novel.
Dialogue: 0,0:17:41.10,0:17:43.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Itu sangat mengagumkan!
Dialogue: 0,0:17:45.10,0:17:48.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Baiklah.
Dialogue: 0,0:17:48.81,0:17:50.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Jika kau mau aku mengajarimu.
Dialogue: 0,0:17:50.61,0:17:53.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah? Terima kasih!
Dialogue: 0,0:17:54.82,0:18:00.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggil aku Imoko saja.
Dialogue: 0,0:18:05.50,0:18:06.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,
Dialogue: 0,0:18:07.87,0:18:11.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}panggil aku Yomuko.
Dialogue: 0,0:18:11.13,0:18:12.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:18:12.63,0:18:14.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yomuko-chan!
Dialogue: 0,0:18:16.55,0:18:17.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa ini?{\i0}
Dialogue: 0,0:18:18.13,0:18:19.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku belum pernah merasa begini.{\i0}
Dialogue: 0,0:18:20.93,0:18:22.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Perasaan apa ini?{\i0}
Dialogue: 0,0:18:24.01,0:18:26.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Aku selalu mengira orang kreatif{\i0}
Dialogue: 0,0:18:26.02,0:18:29.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}seharusnya menuangkan kesepian mereka\Nke dalam karya,{\i0}
Dialogue: 0,0:18:29.02,0:18:30.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}tapi mungkin aku keliru.{\i0}
Dialogue: 0,0:18:30.40,0:18:34.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Energi seseorang ada batasnya.{\i0}
Dialogue: 0,0:18:34.19,0:18:37.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak ada orang yang bisa hidup sendiri.{\i0}
Dialogue: 0,0:18:37.19,0:18:39.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalau berkaca pada pengalamanku,{\i0}
Dialogue: 0,0:18:39.74,0:18:44.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}orang yang membuat karya membosankan\Nbiasanya terlihat tak punya teman.{\i0}
Dialogue: 0,0:18:58.63,0:19:00.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Chainsmoker Cat! Chainsmoker Cat!{\i0}
Dialogue: 0,0:19:08.68,0:19:12.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imako menginap di rumah temannya,\Njadi aku sendiri di rumah malam ini.
Dialogue: 0,0:19:13.56,0:19:16.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus memanfaatkan kesempatan ini.
Dialogue: 0,0:19:18.65,0:19:21.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Pesta Shizue!{\i0}
Dialogue: 0,0:19:22.57,0:19:25.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tak ada teh\Nyang lebih enak daripada Darjeeling.{\i0}
Dialogue: 0,0:19:25.58,0:19:27.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aromanya enak sekali.{\i0}
Dialogue: 0,0:19:29.66,0:19:33.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kue kering yang kusembunyikan\Ndari Imoko-chan juga enak.{\i0}
Dialogue: 0,0:19:33.13,0:19:34.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi yang terutama,{\i0}
Dialogue: 0,0:19:34.84,0:19:39.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}rokok yang nikmat\Nsungguh cocok dengan teh dan kudapan.{\i0}
Dialogue: 0,0:19:41.55,0:19:43.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serasa di surga.
Dialogue: 0,0:19:49.98,0:19:51.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat. Aku tertidur.
Dialogue: 0,0:19:52.44,0:19:53.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pukul berapa sekarang?
Dialogue: 0,0:19:55.02,0:19:56.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruangan penuh asap!
Dialogue: 0,0:19:57.40,0:20:00.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengingatkan pada bulan maduku di London.
Dialogue: 0,0:20:01.07,0:20:02.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlalu hura-hura di Pesta Shizue.
Dialogue: 0,0:20:02.86,0:20:06.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi besok seharusnya ruangan ini\Nsudah bebas bau asap.
Dialogue: 0,0:20:08.24,0:20:09.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari Imoko-chan.
Dialogue: 0,0:20:10.54,0:20:11.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ibu?{\i0}
Dialogue: 0,0:20:11.62,0:20:16.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, ini ibumu. Apa kau bersenang-senang?
Dialogue: 0,0:20:16.00,0:20:18.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}- Tidak, aku pulang sekarang.{\i0}\N- Apa?
Dialogue: 0,0:20:19.00,0:20:22.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumah Hana didatangi pencuri.
Dialogue: 0,0:20:22.30,0:20:24.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pencuri? Kau pulang?{\i0}
Dialogue: 0,0:20:24.47,0:20:28.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak banyak yang diambil,\Ntapi mereka sudah menelepon polisi.
Dialogue: 0,0:20:28.72,0:20:31.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hana sangat kesal\Nkarena celana dalamnya juga dicuri.
Dialogue: 0,0:20:31.98,0:20:34.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu turut sedih mendengarnya.
Dialogue: 0,0:20:34.60,0:20:36.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku akan tiba dalam sepuluh menit.{\i0}
Dialogue: 0,0:20:36.52,0:20:39.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tak usah siapkan makan malam,\Naku sudah makan.{\i0}
Dialogue: 0,0:20:39.11,0:20:40.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sampai nanti.{\i0}
Dialogue: 0,0:20:42.49,0:20:44.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga.
Dialogue: 0,0:20:46.99,0:20:48.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:20:48.58,0:20:51.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa salahku sampai harus mengalami ini?
Dialogue: 0,0:20:51.50,0:20:55.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini semua\Nkarena rumah Hana dimasuki pencuri!
Dialogue: 0,0:20:55.17,0:20:56.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pencuri Bodoh!
Dialogue: 0,0:21:02.01,0:21:03.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pulang!
Dialogue: 0,0:21:06.05,0:21:07.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi di sini?
Dialogue: 0,0:21:08.55,0:21:11.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu merokok lagi?
Dialogue: 0,0:21:16.40,0:21:17.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu!
Dialogue: 0,0:21:18.61,0:21:20.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu tak apa-apa? Apa yang terjadi?
Dialogue: 0,0:21:22.44,0:21:26.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada perampok datang\Ntepat setelah Ibu menutup telepon darimu.
Dialogue: 0,0:21:28.03,0:21:29.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti yang kau lihat.
Dialogue: 0,0:21:31.03,0:21:32.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:21:32.04,0:21:35.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ibu tak terluka.\NMereka hanya mengikat Ibu.
Dialogue: 0,0:21:35.46,0:21:38.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tapi perampok itu banyak merokok.
Dialogue: 0,0:21:38.67,0:21:41.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti cerobong asap!
Dialogue: 0,0:21:41.92,0:21:43.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu sungguh tidak terluka?
Dialogue: 0,0:21:43.84,0:21:45.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, Ibu tak apa-apa.
Dialogue: 0,0:21:52.68,0:21:56.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak akan pernah pergi menginap lagi!
Dialogue: 0,0:21:57.56,0:21:58.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:21:59.23,0:22:02.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, sungguh tak apa-apa\Njika kau menginap.
Dialogue: 0,0:22:02.07,0:22:03.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak akan pernah pergi!
Dialogue: 0,0:23:32.95,0:23:38.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terjemahan subtitle oleh Stysa Alverina
