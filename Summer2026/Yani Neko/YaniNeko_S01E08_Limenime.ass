Dialogue: 0,0:00:09.00,0:00:12.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Selamat ulang tahun{\i0}
Dialogue: 0,0:00:14.05,0:00:18.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Selamat ulang tahun{\i0}
Dialogue: 0,0:00:18.39,0:00:20.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}11 November?{\i0}
Dialogue: 0,0:00:21.02,0:00:22.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu hari spesial?
Dialogue: 0,0:00:22.64,0:00:24.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, aku tahu.
Dialogue: 0,0:00:24.27,0:00:26.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu, satu, satu, satu.\NHari Lajang.
Dialogue: 0,0:00:26.02,0:00:28.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku punya tenggat penting saat itu.
Dialogue: 0,0:00:29.15,0:00:32.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya rencana hari itu,\Ntak bisa kubatalkan.
Dialogue: 0,0:00:32.19,0:00:33.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Kak.
Dialogue: 0,0:00:35.28,0:00:39.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Selamat ulang tahun{\i0}
Dialogue: 0,0:01:02.72,0:01:05.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Selamat ulang tahun!\N- Selamat ulang tahun!
Dialogue: 0,0:01:05.48,0:01:06.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:01:06.69,0:01:08.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa itu sudah cukup untuk latihan.
Dialogue: 0,0:01:09.48,0:01:12.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka dia peduli\Nakan hari ulang tahunnya.
Dialogue: 0,0:01:12.28,0:01:14.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya dia itu imut juga.
Dialogue: 0,0:01:14.86,0:01:17.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:01:17.78,0:01:20.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu boneka mirip kakakku\Nyang kuberikan sebagai hadiah.
Dialogue: 0,0:01:20.58,0:01:25.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata mirip sekali dengannya\Nsetelah kupakaikan rambut aslinya.
Dialogue: 0,0:01:26.25,0:01:29.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang mirip sekali.\NRambut aslinya, katamu?
Dialogue: 0,0:01:31.34,0:01:34.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, kenapa Yaniko lama sekali?
Dialogue: 0,0:01:34.71,0:01:39.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang kita lakukan hal klise itu,\Ntak ada yang ingat mengundangnya.
Dialogue: 0,0:01:43.97,0:01:44.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:01:45.77,0:01:46.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sekali!
Dialogue: 0,0:03:17.94,0:03:20.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, Para Penonton, lihat baik-baik.
Dialogue: 0,0:03:23.24,0:03:25.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Inilah saat penentuan.
Dialogue: 0,0:03:25.74,0:03:28.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ini dia.
Dialogue: 0,0:03:28.24,0:03:29.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Hei, apa Kaoruko ada?
Dialogue: 0,0:03:35.71,0:03:36.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seorang pria?
Dialogue: 0,0:03:36.63,0:03:38.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaoruko? Orang ini dekat dengannya?
Dialogue: 0,0:03:39.17,0:03:40.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau mudah terkejut?
Dialogue: 0,0:03:40.76,0:03:42.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kau? Kau siapanya Kaorucchi?
Dialogue: 0,0:03:43.68,0:03:45.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa aku?
Dialogue: 0,0:03:47.10,0:03:47.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pacarnya.
Dialogue: 0,0:03:50.60,0:03:52.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia punya pacar?{\i0}
Dialogue: 0,0:03:52.10,0:03:54.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku belum pernah bergandengan dengan pria!{\i0}
Dialogue: 0,0:03:54.35,0:03:56.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia pengkhianat!{\i0}
Dialogue: 0,0:03:56.94,0:03:59.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau apa dengannya?
Dialogue: 0,0:04:01.07,0:04:02.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kubawakan celana dalamnya.
Dialogue: 0,0:04:02.99,0:04:04.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bahkan mereka sudah bercinta!{\i0}
Dialogue: 0,0:04:05.87,0:04:09.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Posisi telungkup?\NSeks di luar ruangan? Gaya anjing?{\i0}
Dialogue: 0,0:04:13.83,0:04:15.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar.
Dialogue: 0,0:04:16.21,0:04:17.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau perawan, bukan?
Dialogue: 0,0:04:18.17,0:04:20.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan kau bertanya\Nbegitu padanya, Bodoh!
Dialogue: 0,0:04:24.13,0:04:25.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembalikan celana dalamku!
Dialogue: 0,0:04:26.14,0:04:29.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Hameko, kau tak apa-apa?\NDia orang bodoh.
Dialogue: 0,0:04:30.68,0:04:32.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pengkhianat.
Dialogue: 0,0:04:32.31,0:04:33.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:04:34.31,0:04:35.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, singkat cerita,
Dialogue: 0,0:04:35.94,0:04:38.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si Bodoh ini adik laki-lakiku.
Dialogue: 0,0:04:38.52,0:04:40.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Shunran. Senang bertemu denganmu.
Dialogue: 0,0:04:40.82,0:04:43.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat membencinya!
Dialogue: 0,0:04:44.07,0:04:46.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, mengerjaimu sangat seru.
Dialogue: 0,0:04:46.32,0:04:47.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan?
Dialogue: 0,0:04:48.57,0:04:50.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, tak apa. Jadi, kalian kakak beradik.
Dialogue: 0,0:04:50.79,0:04:53.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga!
Dialogue: 0,0:04:53.71,0:04:56.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku, mana mungkin kau punya pacar.
Dialogue: 0,0:04:57.67,0:04:59.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak akan bisa menipuku.
Dialogue: 0,0:05:01.34,0:05:04.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, secara teknis, kami saudara tiri.
Dialogue: 0,0:05:05.72,0:05:07.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Seperti di gim porno?{\i0}
Dialogue: 0,0:05:07.68,0:05:09.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Porno hubungan sedarah?{\i0}
Dialogue: 0,0:05:09.18,0:05:10.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Cinta terlarang.{\i0}
Dialogue: 0,0:05:10.43,0:05:14.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan! Dia berbohong!
Dialogue: 0,0:05:17.60,0:05:20.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nishi, mau tambah minum?
Dialogue: 0,0:05:20.40,0:05:22.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, minumanku lebih enak!
Dialogue: 0,0:05:22.78,0:05:24.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minggir, Berengsek!
Dialogue: 0,0:05:24.61,0:05:27.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku yang menuangkan minuman Nishi.
Dialogue: 0,0:05:27.24,0:05:29.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, tapi maaf.
Dialogue: 0,0:05:30.33,0:05:32.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus ke toilet.
Dialogue: 0,0:05:32.24,0:05:35.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, jangan pergi, Nishi!
Dialogue: 0,0:05:35.04,0:05:36.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka padamu, Nishi!
Dialogue: 0,0:05:36.66,0:05:38.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah berapa kali kau katakan itu?
Dialogue: 0,0:05:38.83,0:05:40.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan berpura-pura tak mendengarmu.
Dialogue: 0,0:05:48.47,0:05:50.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau terkena bau rokok.
Dialogue: 0,0:05:50.34,0:05:51.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nishi?
Dialogue: 0,0:05:53.68,0:05:55.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira kau mau ke toilet.
Dialogue: 0,0:05:55.31,0:05:58.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir aku akan cari angin sedikit.
Dialogue: 0,0:06:02.52,0:06:03.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga.
Dialogue: 0,0:06:04.98,0:06:06.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agak dingin.
Dialogue: 0,0:06:09.45,0:06:13.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sangat dewasa dan pengertian,
Dialogue: 0,0:06:13.91,0:06:15.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan sangat anggun.
Dialogue: 0,0:06:16.16,0:06:18.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kebalikannya.
Dialogue: 0,0:06:18.16,0:06:21.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sama sekali tidak benar.
Dialogue: 0,0:06:21.29,0:06:22.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang benar!
Dialogue: 0,0:06:22.42,0:06:24.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak pernah bisa mengatur\Nbanyak hal sepertimu.
Dialogue: 0,0:06:25.55,0:06:27.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tak pandai berbicara.
Dialogue: 0,0:06:28.26,0:06:31.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesempatan mengatur semua ini\Ndatang setelah aku menyelesaikan tesis.
Dialogue: 0,0:06:32.85,0:06:35.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan aku tak pandai bersosialisasi.
Dialogue: 0,0:06:36.06,0:06:38.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awas, ada orang mesum!
Dialogue: 0,0:06:39.69,0:06:41.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjauhlah!
Dialogue: 0,0:06:41.94,0:06:43.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau dengar itu? Ada orang mesum.
Dialogue: 0,0:06:43.56,0:06:44.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kota ini menyeramkan.
Dialogue: 0,0:06:45.57,0:06:47.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita masuk lagi?
Dialogue: 0,0:06:48.28,0:06:49.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:06:55.70,0:06:58.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia orang mesum yang hangus terbakar!
Dialogue: 0,0:06:58.04,0:06:59.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong tangkap dia!
Dialogue: 0,0:06:59.71,0:07:01.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, itu Yaniko!
Dialogue: 0,0:07:01.58,0:07:03.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau lakukan?
Dialogue: 0,0:07:03.25,0:07:04.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau terlibat perang?
Dialogue: 0,0:07:04.59,0:07:06.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terkena api saat menikmati api unggun.
Dialogue: 0,0:07:06.84,0:07:09.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana bisa selamat?\NApa kau makhluk mistis?
Dialogue: 0,0:07:09.22,0:07:13.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau biasanya seperti ini, Nishi?
Dialogue: 0,0:07:14.64,0:07:17.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, maksudku, tidak juga.
Dialogue: 0,0:07:17.52,0:07:19.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bukan Nishi, dia Kansai.
Dialogue: 0,0:07:19.56,0:07:20.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tutup mulutmu!
Dialogue: 0,0:07:25.36,0:07:26.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wa…
Dialogue: 0,0:07:27.15,0:07:28.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Wa…
Dialogue: 0,0:07:28.23,0:07:29.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, bagus sekali!
Dialogue: 0,0:07:29.99,0:07:31.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:07:31.11,0:07:32.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai barusan,
Dialogue: 0,0:07:33.57,0:07:36.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau agak terlalu sempurna\Ndan sulit didekati.
Dialogue: 0,0:07:36.41,0:07:41.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sekarang,\Naku sungguh ingin berteman denganmu.
Dialogue: 0,0:07:41.58,0:07:43.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh?
Dialogue: 0,0:07:43.58,0:07:45.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kansai, beri aku rokok.
Dialogue: 0,0:07:45.71,0:07:46.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau serius?
Dialogue: 0,0:07:46.96,0:07:50.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau merokok, meski kau kuliah\Ndi universitas di Machida?
Dialogue: 0,0:07:51.22,0:07:53.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, begini…
Dialogue: 0,0:07:55.80,0:07:56.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku juga.
Dialogue: 0,0:07:57.89,0:08:00.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ini rahasia di antara kita, ya?
Dialogue: 0,0:08:04.60,0:08:07.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rokok yang kau isap mereknya cukup lawas.
Dialogue: 0,0:08:07.57,0:08:11.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun, aku berharap\Nbisa mengenalmu lebih dekat.
Dialogue: 0,0:08:13.61,0:08:14.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:08:23.33,0:08:25.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sangat pandai berpura-pura.
Dialogue: 0,0:08:26.25,0:08:28.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Butuh banyak usaha.
Dialogue: 0,0:08:28.09,0:08:29.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri aku rokok.
Dialogue: 0,0:08:30.76,0:08:32.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Chainsmoker Cat.{\i0}
Dialogue: 0,0:08:47.02,0:08:49.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa musim semi hampir tiba.
Dialogue: 0,0:08:52.57,0:08:56.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja kerasku\Nselama tiga hari akan sia-sia!
Dialogue: 0,0:08:56.07,0:08:59.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Angin menerbangkan sketsa-sketsaku\Nke luar jendela!
Dialogue: 0,0:08:59.33,0:09:01.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sketsa-sketsa?
Dialogue: 0,0:09:13.55,0:09:16.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kau menyelamatkanku\Ndari masalah besar hari itu.{\i0}
Dialogue: 0,0:09:16.30,0:09:21.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa bantuanmu, aku takkan sempat\Nmenyelesaikannya sebelum tenggat, Yomuko.
Dialogue: 0,0:09:21.06,0:09:22.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak perlu berterima kasih.
Dialogue: 0,0:09:22.60,0:09:23.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat hal itu,
Dialogue: 0,0:09:23.81,0:09:26.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku berkenalan dan berteman\Ndengan penulis profesional sekarang.
Dialogue: 0,0:09:29.40,0:09:31.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetap saja, waktu berlalu cepat.
Dialogue: 0,0:09:31.40,0:09:35.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah setahun sejak saat itu,\Ndan tahun ini segera berakhir.
Dialogue: 0,0:09:35.11,0:09:36.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahun ini sangat padat.
Dialogue: 0,0:09:37.70,0:09:39.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski bukumu sudah diterbitkan,
Dialogue: 0,0:09:39.78,0:09:43.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau dengan baik hati memberi masukan\Nuntuk penulis amatir sepertiku.
Dialogue: 0,0:09:43.74,0:09:46.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa saja.
Dialogue: 0,0:09:46.54,0:09:48.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tak pantas kau kagumi.
Dialogue: 0,0:09:48.58,0:09:50.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja pantas!
Dialogue: 0,0:09:50.88,0:09:54.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa menghasilkan uang\Ndari bidang yang dia sukai,
Dialogue: 0,0:09:54.13,0:09:56.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ingin menjadi sepertinya.
Dialogue: 0,0:09:56.09,0:09:59.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah itu alasanmu menjadi asistennya?
Dialogue: 0,0:09:59.30,0:10:01.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah membaca komiknya.
Dialogue: 0,0:10:03.64,0:10:07.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuharap kau baca setidaknya sekali\Nuntuk mempelajari warna rambut tokoh.
Dialogue: 0,0:10:07.48,0:10:11.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asisten tidak pernah\Nmembaca komik karya penulisnya?
Dialogue: 0,0:10:12.52,0:10:14.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tak bisa diterima!
Dialogue: 0,0:10:14.32,0:10:16.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai kreator,\Nkurangnya kesadaran seperti itu…
Dialogue: 0,0:10:16.82,0:10:19.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau pernah membaca komik buatannya?
Dialogue: 0,0:10:19.66,0:10:21.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu, aku…
Dialogue: 0,0:10:26.25,0:10:30.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah membelinya,\Ntapi kusimpan untuk dibaca nanti.
Dialogue: 0,0:10:30.04,0:10:31.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak perlu memaksakan diri.
Dialogue: 0,0:10:48.43,0:10:51.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia masih percaya akan Sinterklas?
Dialogue: 0,0:10:51.15,0:10:53.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bukan orang semacam itu.
Dialogue: 0,0:10:53.61,0:10:55.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini semacam lelucon terbalik?
Dialogue: 0,0:10:55.52,0:10:58.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mungkin cuma minta\Nsebungkus rokok atau semacamnya.
Dialogue: 0,0:10:58.86,0:11:02.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, sudah kubilang kita\Nakan pergi minum pada hari Natal.
Dialogue: 0,0:11:04.16,0:11:08.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}"Kepada Sinterklas,\Naku ingin area merokok. Yaniko."{\i0}
Dialogue: 0,0:11:08.79,0:11:11.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tetap merokok\Nmeski tak ada area merokok!
Dialogue: 0,0:11:11.71,0:11:13.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Juga, itu tak muat di dalam kaus kaki!
Dialogue: 0,0:11:14.46,0:11:16.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada lagi di baliknya.
Dialogue: 0,0:11:17.63,0:11:20.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}"Aku ingin merokok sambil berjemur\Nbersama semua temanku."{\i0}
Dialogue: 0,0:11:23.59,0:11:26.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal seperti ini membuatku tersentuh.
Dialogue: 0,0:11:26.43,0:11:28.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sangat tak adil.
Dialogue: 0,0:11:28.14,0:11:30.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia jarang bersikap serius.
Dialogue: 0,0:11:38.94,0:11:40.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya mulai terlihat bentuknya.
Dialogue: 0,0:11:41.95,0:11:43.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mulai lelah.
Dialogue: 0,0:11:43.16,0:11:45.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terakhir kali bermain salju\Nsaat aku masih kecil.
Dialogue: 0,0:11:45.66,0:11:47.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:11:47.66,0:11:49.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kubawakan kalian minuman.
Dialogue: 0,0:11:55.42,0:11:57.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sake salju.
Dialogue: 0,0:11:58.59,0:12:00.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sangat enak.
Dialogue: 0,0:12:04.18,0:12:06.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari lakukan ini lagi\Nsaat turun salju lain kali.
Dialogue: 0,0:12:06.55,0:12:07.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:12:19.07,0:12:21.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini mulai menghangatkan tubuhku.
Dialogue: 0,0:12:21.19,0:12:23.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau terlalu banyak minum.
Dialogue: 0,0:12:35.71,0:12:38.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak suka membuang sampah.
Dialogue: 0,0:12:44.18,0:12:45.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!
Dialogue: 0,0:12:45.59,0:12:48.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu area merokok yang terbuat dari salju!
Dialogue: 0,0:13:02.57,0:13:05.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan mereka menambahkan\Nbeberapa patung agar lebih detail.
Dialogue: 0,0:13:14.87,0:13:16.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tak menolong kami!
Dialogue: 0,0:13:17.46,0:13:18.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Chainsmoker Cat.{\i0}
Dialogue: 0,0:13:25.01,0:13:28.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kita terus minum secepat ini,\Nkita tumbang sebelum Tahun Baru.
Dialogue: 0,0:13:28.59,0:13:31.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bicara apa?\NKita akan ke kuil malam ini.
Dialogue: 0,0:13:31.47,0:13:35.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Yang tertidur kalah.\N- Minuman keras ini terlalu ringan.
Dialogue: 0,0:13:35.10,0:13:36.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:13:36.06,0:13:38.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana jika yang kalah
Dialogue: 0,0:13:38.19,0:13:41.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memasukkan celana dalam\Nyang dipakai ke mulut pemilik rumah?
Dialogue: 0,0:13:41.23,0:13:43.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu usul yang bagus! Kocak sekali!
Dialogue: 0,0:13:43.90,0:13:45.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak akan tidur sekarang!
Dialogue: 0,0:13:45.65,0:13:47.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau melakukan itu!
Dialogue: 0,0:13:47.24,0:13:49.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu dia akan menikmatinya!
Dialogue: 0,0:13:49.16,0:13:51.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ada yang tidur.
Dialogue: 0,0:13:51.58,0:13:52.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengantuk.
Dialogue: 0,0:14:01.50,0:14:05.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Chainsmoker Cat.{\i0}
Dialogue: 0,0:14:06.05,0:14:07.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, Kawan-Kawan!
Dialogue: 0,0:14:07.63,0:14:09.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat Tahun Baru!
Dialogue: 0,0:14:09.76,0:14:13.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saatnya menumbuk mochi Tahun Baru\Ndi kompleks apartemen kita!
Dialogue: 0,0:14:13.01,0:14:14.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yani Neko!
Dialogue: 0,0:14:14.39,0:14:15.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuayunkan penumbuk,
Dialogue: 0,0:14:15.81,0:14:18.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tugasmu membasahi dan menguleni mochi!
Dialogue: 0,0:14:18.85,0:14:19.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengerti?
Dialogue: 0,0:14:20.27,0:14:25.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar kalau dia antusias,\Ntapi kenapa Yaniko juga antusias?
Dialogue: 0,0:14:25.36,0:14:27.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dia membayar Yani dengan rokok.
Dialogue: 0,0:14:27.78,0:14:30.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih terlalu pagi untuk melakukan ini.
Dialogue: 0,0:14:30.53,0:14:32.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Yani Neko!
Dialogue: 0,0:14:48.80,0:14:52.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama tak kutunjukkan\Nkemampuanku menumbuk mochi.
Dialogue: 0,0:14:52.18,0:14:54.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kemampuanku sudah menurun.
Dialogue: 0,0:14:55.56,0:14:57.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke mana perginya Yani Neko?
Dialogue: 0,0:14:57.39,0:14:59.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak tahu. Mungkin dia kabur.
Dialogue: 0,0:14:59.56,0:15:03.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus bagaimana lagi dengannya? Sudahlah.
Dialogue: 0,0:15:03.31,0:15:06.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita mulai membentuk mochi\Nsetelah adonannya dingin.
Dialogue: 0,0:15:06.40,0:15:07.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:15:10.20,0:15:12.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pasta kacang merah cocok\Nuntuk sebaris mochi ini?
Dialogue: 0,0:15:12.99,0:15:15.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini memang mochi yomogi.
Dialogue: 0,0:15:15.66,0:15:19.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yomogi dipercaya dapat mengusir roh jahat,\Ndianggap membawa keberuntungan.
Dialogue: 0,0:15:19.33,0:15:21.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa menangkal "Yaku", kesialan!
Dialogue: 0,0:15:23.33,0:15:27.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaanku saja, atau warna mochi ini\Nmemang mirip rambut Yani?
Dialogue: 0,0:15:27.34,0:15:28.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah,
Dialogue: 0,0:15:28.59,0:15:30.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nanti mochi-nya bisa berbau rokok!
Dialogue: 0,0:15:32.38,0:15:34.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya memanggang mochi.
Dialogue: 0,0:15:43.35,0:15:47.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yani Neko! Ternyata kau di sana!
Dialogue: 0,0:15:51.45,0:15:53.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi itu hanya mimpi.
Dialogue: 0,0:15:54.57,0:15:57.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, apa itu mimpi pertamaku tahun ini?
Dialogue: 0,0:15:57.58,0:15:59.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahun baru dimulai dengan hal buruk.
Dialogue: 0,0:16:01.12,0:16:03.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau tidur berapa lama lagi?
Dialogue: 0,0:16:03.08,0:16:04.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bangun.
Dialogue: 0,0:16:08.17,0:16:10.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita menumbuk mochi.
Dialogue: 0,0:16:10.71,0:16:12.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, mari lakukan.
Dialogue: 0,0:16:13.76,0:16:15.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, Kawan-Kawan!
Dialogue: 0,0:16:15.39,0:16:17.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat Tahun Baru!
Dialogue: 0,0:16:17.35,0:16:20.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saatnya menumbuk mochi Tahun Baru\Ndi kompleks apartemen kita!
Dialogue: 0,0:16:20.81,0:16:21.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yani Neko!
Dialogue: 0,0:16:22.14,0:16:23.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuayunkan penumbuk,
Dialogue: 0,0:16:23.39,0:16:26.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tugasmu membasahi dan menguleni mochi!
Dialogue: 0,0:16:26.52,0:16:27.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengerti?
Dialogue: 0,0:16:28.02,0:16:32.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar kalau dia antusias,\Ntapi kenapa Yaniko juga antusias?
Dialogue: 0,0:16:32.95,0:16:35.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dia membayar Yani dengan rokok.
Dialogue: 0,0:16:35.53,0:16:38.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih terlalu pagi untuk melakukan ini.
Dialogue: 0,0:16:38.28,0:16:40.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Yani Neko!
Dialogue: 0,0:16:46.46,0:16:47.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:16:47.75,0:16:49.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, tidak ada apa-apa.
Dialogue: 0,0:16:49.92,0:16:51.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita mulai!
Dialogue: 0,0:16:51.92,0:16:53.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan!
Dialogue: 0,0:16:53.67,0:16:56.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi!
Dialogue: 0,0:16:56.89,0:16:59.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu lagi!
Dialogue: 0,0:17:04.77,0:17:06.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya dia menelan sebatang rokok.
Dialogue: 0,0:17:07.15,0:17:09.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia masih sangat muda.
Dialogue: 0,0:17:09.57,0:17:12.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat pria yang di sana?
Dialogue: 0,0:17:12.36,0:17:15.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rokoknya tercampur\Nke adonan mochi yang dia tumbuk.
Dialogue: 0,0:17:23.41,0:17:26.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita menumbuk mochi.
Dialogue: 0,0:17:27.08,0:17:30.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku terus mengulangi hal yang sama!{\i0}
Dialogue: 0,0:17:34.80,0:17:36.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo menumbuk mochi.
Dialogue: 0,0:17:46.31,0:17:50.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menumbuk mochi.
Dialogue: 0,0:17:50.06,0:17:52.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tak tahu kenapa,{\i0}
Dialogue: 0,0:17:52.23,0:17:55.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tapi aku terus mengulangi\Nhari menumbuk mochi ini.{\i0}
Dialogue: 0,0:17:55.86,0:17:56.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dan…{\i0}
Dialogue: 0,0:17:58.16,0:17:59.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hameko!
Dialogue: 0,0:17:59.32,0:18:01.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}…selalu ada yang tewas,{\i0}
Dialogue: 0,0:18:03.08,0:18:06.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan hari yang sama terulang lagi.{\i0}
Dialogue: 0,0:18:06.87,0:18:08.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo menumbuk mochi.
Dialogue: 0,0:18:09.29,0:18:12.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tak tahu\Ncara keluar dari pengulangan ini.{\i0}
Dialogue: 0,0:18:12.25,0:18:13.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi,{\i0}
Dialogue: 0,0:18:13.34,0:18:16.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}jika kami bisa melalui hari ini\Ntanpa ada yang tewas,{\i0}
Dialogue: 0,0:18:16.51,0:18:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}pasti pengulangan ini akan berhenti.{\i0}
Dialogue: 0,0:18:20.09,0:18:22.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuacanya bagus untuk memulai tahun baru.
Dialogue: 0,0:18:22.89,0:18:24.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sempurna untuk menumbuk mochi.
Dialogue: 0,0:18:24.81,0:18:27.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sepertinya agak lesu.
Dialogue: 0,0:18:27.10,0:18:29.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku sudah ingin makan mochi.\N{\i1}- Selalu saja…{\i0}
Dialogue: 0,0:18:29.60,0:18:30.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kansai!
Dialogue: 0,0:18:30.65,0:18:34.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}…ada yang tewas\Njika terlalu dekat dengan lesung.{\i0}
Dialogue: 0,0:18:35.65,0:18:40.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Maka aku harus melakukan hal yang heboh\Nagar mereka tidak mau mendekat!{\i0}
Dialogue: 0,0:18:43.53,0:18:45.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau lakukan, Pak?
Dialogue: 0,0:18:45.66,0:18:47.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Acara menumbuk mochi yang cabul!
Dialogue: 0,0:18:47.66,0:18:51.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemaluannya menari cabul bersama\Ndengan mochi!
Dialogue: 0,0:18:51.92,0:18:54.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pasti sekarang tak ada yang mau mendekat!{\i0}
Dialogue: 0,0:18:56.17,0:18:58.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yaniko tak bisa menahan insting kucingnya!
Dialogue: 0,0:18:58.55,0:19:00.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yani, hentikan, jijik! Tak boleh!
Dialogue: 0,0:19:00.55,0:19:02.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mendekat padaku!
Dialogue: 0,0:19:06.14,0:19:07.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yaniko!
Dialogue: 0,0:19:07.56,0:19:09.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ohtani cabul!
Dialogue: 0,0:19:09.06,0:19:11.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selesai, sekarang makanlah!
Dialogue: 0,0:19:19.40,0:19:22.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Lembut tapi keras.\N{\i1}- Harinya tidak berulang? Selesai?{\i0}
Dialogue: 0,0:19:23.07,0:19:26.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Akhirnya aku keluar\Ndari pengulangan yang tak ada habisnya?{\i0}
Dialogue: 0,0:19:28.50,0:19:30.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau Tuan Ohtani?
Dialogue: 0,0:19:31.46,0:19:33.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami menerima pengaduan.
Dialogue: 0,0:19:33.00,0:19:34.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa kau ikut kami ke kantor?
Dialogue: 0,0:19:46.10,0:19:48.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini memang yang terbaik.{\i0}
Dialogue: 0,0:19:53.19,0:19:54.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Chainsmoker Cat.{\i0}
Dialogue: 0,0:19:58.40,0:20:00.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bangun!
Dialogue: 0,0:20:00.03,0:20:03.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan pergi\Nmakan burger Awajishima hari ini!
Dialogue: 0,0:20:04.28,0:20:07.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya biarkan aku\Ntidur lebih lama saat liburan.
Dialogue: 0,0:20:07.53,0:20:10.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bicara apa? Ini sudah pukul 08.00.
Dialogue: 0,0:20:10.37,0:20:13.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga harus\Nmembeli minyak tanah sejak pagi.
Dialogue: 0,0:20:13.37,0:20:14.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau suka rumah dingin?
Dialogue: 0,0:20:14.63,0:20:15.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian belilah.
Dialogue: 0,0:20:16.13,0:20:18.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merepotkan sekali.
Dialogue: 0,0:20:18.05,0:20:19.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mendorongku!
Dialogue: 0,0:20:21.84,0:20:23.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan ini?
Dialogue: 0,0:20:23.01,0:20:24.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalanan macet parah!
Dialogue: 0,0:20:24.59,0:20:26.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini masa liburan.
Dialogue: 0,0:20:26.01,0:20:28.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shunran! Tendang mobil-mobil itu\Nkeluar dari jalan!
Dialogue: 0,0:20:29.14,0:20:31.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara mengemudi menunjukkan tabiat orang.
Dialogue: 0,0:20:31.39,0:20:33.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu selalu seperti ini.
Dialogue: 0,0:20:33.39,0:20:37.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak mulai bertingkah mirip Ibu\Nsejak pindah ke apartemen itu.
Dialogue: 0,0:20:37.65,0:20:39.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apanya yang mirip? Kutampar kau!
Dialogue: 0,0:20:39.40,0:20:40.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa marah? Ibu tampar kau!
Dialogue: 0,0:20:42.15,0:20:44.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu lapar, mobil terjebak macet.
Dialogue: 0,0:20:44.57,0:20:45.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo pulang.
Dialogue: 0,0:20:45.57,0:20:46.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar saja!
Dialogue: 0,0:20:47.70,0:20:50.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Burger Awajishima buatan sendiri!
Dialogue: 0,0:20:51.29,0:20:53.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada tempat senyaman rumah!
Dialogue: 0,0:20:53.83,0:20:55.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu yang mengajak pergi keluar.
Dialogue: 0,0:20:59.21,0:21:02.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaoruko, apa berat badanmu\Nbertambah selama liburan?
Dialogue: 0,0:21:03.72,0:21:05.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa memakai baju hamil Ibu dulu.
Dialogue: 0,0:21:05.76,0:21:07.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak segemuk itu!
Dialogue: 0,0:21:07.30,0:21:08.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk Shunran saja.
Dialogue: 0,0:21:08.68,0:21:10.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:21:10.22,0:21:12.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bokong Kakak besar.
Dialogue: 0,0:21:12.81,0:21:17.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau baju hamil itu dipakai terbalik\Nsehingga bagian perutnya di bokongnya…
Dialogue: 0,0:21:20.40,0:21:21.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih makanannya.
Dialogue: 0,0:21:21.94,0:21:23.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih ada lagi burgernya.
Dialogue: 0,0:21:23.94,0:21:26.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, terima kasih. Dua terlalu banyak.
Dialogue: 0,0:21:26.53,0:21:27.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga selesai.
Dialogue: 0,0:21:31.20,0:21:32.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tak boleh ke mana-mana!
Dialogue: 0,0:21:32.79,0:21:35.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu bersama keluarga\Nsetelah makan siang!
Dialogue: 0,0:21:35.16,0:21:36.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:21:36.25,0:21:38.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita semua bermain Monopoli!
Dialogue: 0,0:21:38.42,0:21:39.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sambil menonton TV.
Dialogue: 0,0:21:39.88,0:21:41.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ini buruk.\N- Tunggu.
Dialogue: 0,0:21:41.25,0:21:44.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu sedang bersikap menyebalkan.
Dialogue: 0,0:21:44.97,0:21:46.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak, mendekatlah.
Dialogue: 0,0:21:46.59,0:21:47.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:21:51.01,0:21:53.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mempelajari {\i1}beatbox.{\i0}
Dialogue: 0,0:21:53.22,0:21:54.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lantas kenapa, Bocah!
Dialogue: 0,0:21:54.81,0:21:58.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau kalah,\Nharus menginap semalam lagi!
Dialogue: 0,0:21:58.23,0:22:00.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Ibu tak akan kalah!
Dialogue: 0,0:22:01.32,0:22:03.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga ini sangat melelahkan!
Dialogue: 0,0:22:05.24,0:22:07.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, ini Shunran.
Dialogue: 0,0:23:32.91,0:23:37.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terjemahan subtitle oleh Stysa Alverina
