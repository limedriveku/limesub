Dialogue: 0,0:10:32.63,0:10:38.92,sign,,0000,0000,0000,,JIKAKI NEKO HANYA MENGAGUMINYA\NKARENA DIA PENULIS PROFESIONAL
Dialogue: 0,0:10:47.52,0:10:48.43,sign,,0000,0000,0000,,KEPADA SINTERKLAS
Dialogue: 0,0:13:24.09,0:13:25.01,sign,,0000,0000,0000,,SAKE JEPANG
Dialogue: 0,0:13:52.49,0:13:54.95,sign,,0000,0000,0000,,SELAMAT TAHUN BARU
Dialogue: 0,0:17:36.97,0:17:38.97,sign,,0000,0000,0000,,PENGULANGAN KE-18
Dialogue: 0,0:17:40.39,0:17:42.18,sign,,0000,0000,0000,,PENGULANGAN KE-32
