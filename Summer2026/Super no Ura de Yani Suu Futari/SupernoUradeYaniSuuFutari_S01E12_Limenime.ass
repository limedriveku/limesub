Dialogue: 0,0:00:06.88,0:00:09.63,sign,,0000,0000,0000,,‎PERUSAHAAN HAPPY
Dialogue: 0,0:00:36.91,0:00:37.99,sign,,0000,0000,0000,,{\an8}‎KANTOR PUSAT, NAKAJIMA
Dialogue: 0,0:00:56.89,0:00:57.89,sign,,0000,0000,0000,,‎NAKAJIMA
Dialogue: 0,0:03:27.20,0:03:29.87,sign,,0000,0000,0000,,{\an8}‎TUJUH TANAMAN HERBA MUSIM SEMI\N‎UNTUK KESEHATAN
Dialogue: 0,0:06:15.79,0:06:17.54,sign,,0000,0000,0000,,‎KUHARGAI UNDANGANNYA,\N‎TAPI AKU SIBUK DAN TAK SEMPAT
Dialogue: 0,0:07:17.39,0:07:18.39,sign,,0000,0000,0000,,‎KIRIM
Dialogue: 0,0:12:00.17,0:12:02.68,sign,,0000,0000,0000,,{\an8}‎PERUSAHAAN HAPPY
Dialogue: 0,0:13:48.61,0:13:51.53,sign,,0000,0000,0000,,‎DUA MINGGU KEMUDIAN
Dialogue: 0,0:14:04.63,0:14:05.71,sign,,0000,0000,0000,,‎TIDAK!
Dialogue: 0,0:14:51.43,0:14:53.35,sign,,0000,0000,0000,,‎SASAKI BODOH
Dialogue: 0,0:15:33.51,0:15:35.22,sign,,0000,0000,0000,,‎HOKKAIDO - DORONG\N‎WAH - SEJAUH MUNGKIN
Dialogue: 0,0:17:13.94,0:17:16.61,sign,,0000,0000,0000,,{\an8}‎MENARA JAM SAPPORO
Dialogue: 0,0:00:09.63,0:00:13.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Satu tahun bekerja lagi.
Dialogue: 0,0:00:13.17,0:00:14.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:00:14.63,0:00:17.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kotak masukku sudah penuh.
Dialogue: 0,0:00:17.80,0:00:20.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sesemangat apa orang-orang\N‎kembali bekerja? Yang benar saja.
Dialogue: 0,0:00:20.64,0:00:22.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:00:23.27,0:00:24.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Punggungku sakit.
Dialogue: 0,0:00:25.15,0:00:27.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Leherku sakit karena minum dan karaoke.
Dialogue: 0,0:00:31.15,0:00:32.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, ada apa?
Dialogue: 0,0:00:33.15,0:00:35.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sudah mengacaukan tahun baru?
Dialogue: 0,0:00:37.99,0:00:39.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Nakajima-san, ya?
Dialogue: 0,0:00:40.16,0:00:44.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu orang di kantor pusat\N‎yang dulunya seniormu, 'kan?
Dialogue: 0,0:00:44.96,0:00:48.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku ingat dia. Dia hebat\N‎dalam membuahkan hasil.
Dialogue: 0,0:00:49.21,0:00:51.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎"Dari semua perjalanan bisnis terakhirku,{\i0}
Dialogue: 0,0:00:51.88,0:00:53.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎aku harus ke Hokkaido.{\i0}
Dialogue: 0,0:00:54.42,0:00:56.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kau ingin minum setelah aku selesai?"{\i0}
Dialogue: 0,0:00:58.76,0:01:00.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia mau apa?
Dialogue: 0,0:02:39.57,0:02:42.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sepertinya sudah waktunya pulang.
Dialogue: 0,0:02:42.91,0:02:44.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih, Tayama-san.
Dialogue: 0,0:02:44.53,0:02:45.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tentu.
Dialogue: 0,0:02:45.66,0:02:49.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tetaplah fokus\N‎dan jangan menabrak apa-apa.
Dialogue: 0,0:02:51.50,0:02:54.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih. Kau selalu\N‎mengkhawatirkan hal spesifik.
Dialogue: 0,0:02:57.17,0:02:58.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sampai jumpa.
Dialogue: 0,0:03:01.59,0:03:04.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa itu jam tangan?{\i0}
Dialogue: 0,0:03:08.60,0:03:10.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aduh…
Dialogue: 0,0:03:10.31,0:03:11.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei.
Dialogue: 0,0:03:12.06,0:03:15.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak benar-benar menyuruhmu\N‎melakukan itu, Sasaki-san.
Dialogue: 0,0:03:15.44,0:03:16.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau baik-baik saja?
Dialogue: 0,0:03:16.61,0:03:18.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf.
Dialogue: 0,0:03:20.70,0:03:22.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Musim dingin sangat sulit bagiku.
Dialogue: 0,0:03:22.45,0:03:24.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Membuatku melamun.
Dialogue: 0,0:03:30.71,0:03:32.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih banyak.
Dialogue: 0,0:03:32.92,0:03:34.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yamada-chan.
Dialogue: 0,0:03:35.50,0:03:37.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Waktunya tukar.
Dialogue: 0,0:03:37.92,0:03:39.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baik.
Dialogue: 0,0:03:40.42,0:03:42.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Maaf, Sasaki-san.{\i0}
Dialogue: 0,0:03:43.51,0:03:48.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Senyum pertama Yamada di tahun ini\N‎sudah terjual habis.{\i0}
Dialogue: 0,0:03:53.06,0:03:54.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Permisi.
Dialogue: 0,0:03:56.15,0:03:59.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau baik-baik saja?
Dialogue: 0,0:04:02.03,0:04:03.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yamada-san?
Dialogue: 0,0:04:03.61,0:04:06.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Suaranya keras sekali.
Dialogue: 0,0:04:08.37,0:04:10.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf karena berisik.
Dialogue: 0,0:04:10.79,0:04:13.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku baik-baik saja.
Dialogue: 0,0:04:13.04,0:04:14.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baguslah.
Dialogue: 0,0:04:14.75,0:04:17.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau di sini untuk beli kerupuk beras?
Dialogue: 0,0:04:17.13,0:04:22.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak, ada hal lain yang kubutuhkan\N‎hari ini, jadi aku ingin beli itu.
Dialogue: 0,0:04:22.63,0:04:24.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sesuatu yang kau butuhkan?
Dialogue: 0,0:04:24.01,0:04:25.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya. Itu…
Dialogue: 0,0:04:26.22,0:04:28.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tunggu… Um…
Dialogue: 0,0:04:29.18,0:04:30.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ha?
Dialogue: 0,0:04:31.52,0:04:33.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku ke sini untuk apa?
Dialogue: 0,0:04:34.60,0:04:35.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak mungkin…
Dialogue: 0,0:04:35.69,0:04:38.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau baik-baik saja? Kau butuh tisu toilet?
Dialogue: 0,0:04:39.27,0:04:43.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak, aku punya di rumah,\N‎jadi kurasa bukan itu.
Dialogue: 0,0:04:43.53,0:04:47.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tunggu… Aku pulang kantor,\N‎naik kereta, lalu… Apa?
Dialogue: 0,0:04:48.78,0:04:50.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf. Aku akan pergi sekarang.
Dialogue: 0,0:04:58.08,0:04:59.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa dia?{\i0}
Dialogue: 0,0:05:00.42,0:05:02.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia tak seperti dirinya akhir-akhir ini.{\i0}
Dialogue: 0,0:05:04.80,0:05:06.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada apa, Yamada?
Dialogue: 0,0:05:06.84,0:05:10.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa kau memandangi Sasaki-kun\N‎saat dia pergi?
Dialogue: 0,0:05:10.14,0:05:12.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku hanya khawatir.
Dialogue: 0,0:05:12.72,0:05:13.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau apa?
Dialogue: 0,0:05:15.02,0:05:17.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku menatapnya untuk memastikan\N‎dia tak tertabrak mobil.
Dialogue: 0,0:05:22.07,0:05:23.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukan itu yang kuharapkan.
Dialogue: 0,0:05:24.65,0:05:27.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, Obata.\N‎Bantu aku memasang pemberitahuan ini.
Dialogue: 0,0:05:28.28,0:05:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baik! Dipasang di mana?
Dialogue: 0,0:05:29.70,0:05:32.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kita lihat… Di mana pun kau mau.
Dialogue: 0,0:05:32.04,0:05:33.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini. Pasang yang ini.
Dialogue: 0,0:05:36.08,0:05:40.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku dapat ini dari seniorku dulu sekali,\N‎dan ini sangat penting bagiku.
Dialogue: 0,0:05:41.71,0:05:43.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Benar.{\i0}
Dialogue: 0,0:05:43.84,0:05:45.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jika ingatanku benar…{\i0}
Dialogue: 0,0:05:47.76,0:05:50.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa dia tiba-tiba memakainya?{\i0}
Dialogue: 0,0:06:04.98,0:06:06.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Suzuki-kun!
Dialogue: 0,0:06:07.24,0:06:10.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sudah kubilang, jika tak dapat\N‎kontrak yang dekat dari kantor,
Dialogue: 0,0:06:10.20,0:06:13.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎kau harus pergi lebih jauh lagi!
Dialogue: 0,0:06:13.70,0:06:15.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tak kasihan padaku?
Dialogue: 0,0:06:17.54,0:06:18.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hentikan itu!
Dialogue: 0,0:06:19.79,0:06:22.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau mengerti, Suzuki-kun?
Dialogue: 0,0:06:25.38,0:06:26.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Merengek…
Dialogue: 0,0:06:29.55,0:06:33.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dengarkan aku, Sasaki! Aku mau cerita!
Dialogue: 0,0:06:34.14,0:06:35.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Orang botak bodoh itu!
Dialogue: 0,0:06:35.43,0:06:37.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku diomeli karena kontribusiku kurang.
Dialogue: 0,0:06:37.35,0:06:39.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia bilang jika tak ada di dekat sini,\N‎pergilah yang jauh.
Dialogue: 0,0:06:39.85,0:06:43.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia tak peduli jika aku dikirim\N‎ke belahan dunia lain!
Dialogue: 0,0:06:43.11,0:06:45.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jahat sekali perkataannya.
Dialogue: 0,0:06:45.61,0:06:47.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi aku serius.
Dialogue: 0,0:06:47.44,0:06:50.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau suka kepiting, 'kan?
Dialogue: 0,0:06:50.32,0:06:51.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kepiting?
Dialogue: 0,0:06:51.74,0:06:55.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku harus dinas minggu depan.
Dialogue: 0,0:06:55.08,0:06:56.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Di Hokkaido.
Dialogue: 0,0:06:57.45,0:07:03.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi karena kau sangat suka kepiting.\N‎Mungkin kau saja yang pergi.
Dialogue: 0,0:07:04.59,0:07:06.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu perjalanan dinasmu.
Dialogue: 0,0:07:07.59,0:07:09.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tak kasihan padaku?
Dialogue: 0,0:07:09.55,0:07:11.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Kau…\N‎- Belikan oleh-oleh untuk keluargamu.
Dialogue: 0,0:07:11.97,0:07:15.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Baik, aku bahkan akan membelikanmu!\N‎-{\i1}‎ Tentu saja.{\i0}
Dialogue: 0,0:07:15.22,0:07:17.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Mau apa? Kepiting?\N{\i1}‎- Mana bisa kutemui dia?{\i0}
Dialogue: 0,0:07:30.45,0:07:31.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sasaki-san.
Dialogue: 0,0:07:32.66,0:07:34.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sasaki-san. Kau mendengarkan?
Dialogue: 0,0:07:36.70,0:07:38.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ucapkan moto perusahaan.
Dialogue: 0,0:07:38.45,0:07:40.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan istirahat! Jangan berhenti!\N‎Selalu bekerja!
Dialogue: 0,0:07:42.75,0:07:44.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf, Tayama-san.
Dialogue: 0,0:07:44.25,0:07:46.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Payah sekali motonya.
Dialogue: 0,0:07:50.63,0:07:52.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, ada apa? Kenapa kau melamun?
Dialogue: 0,0:07:52.97,0:07:54.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau banyak melamun akhir-akhir ini.
Dialogue: 0,0:07:55.72,0:07:57.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pasti karena malas setelah liburan.
Dialogue: 0,0:07:57.93,0:08:01.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf aku begini saat kau mengizinkanku\N‎merokok di sini.
Dialogue: 0,0:08:02.27,0:08:03.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu.
Dialogue: 0,0:08:04.69,0:08:07.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau mengenakan jam tangan itu\N‎akhir-akhir ini.
Dialogue: 0,0:08:07.52,0:08:11.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukankah itu jam tangan penting\N‎yang kau dapat dari seniormu?
Dialogue: 0,0:08:11.07,0:08:12.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:08:13.03,0:08:16.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia mantan seniorku.\N‎Dia dulu bekerja di cabangku sekarang.
Dialogue: 0,0:08:17.58,0:08:19.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia menyukaiku
Dialogue: 0,0:08:19.74,0:08:22.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎dan berusaha mengajakku bersamanya\N‎saat dia pindah ke kantor pusat.
Dialogue: 0,0:08:23.12,0:08:25.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Saat itulah dia memberiku ini.{\i0}
Dialogue: 0,0:08:26.92,0:08:29.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kubilang aku tak bisa menerima\N‎hadiah semahal itu,{\i0}
Dialogue: 0,0:08:30.38,0:08:32.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎tapi dia bilang ini acara khusus.{\i0}
Dialogue: 0,0:08:32.72,0:08:35.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia orang baik.\N‎Sangat perhatian dan peduli.
Dialogue: 0,0:08:35.76,0:08:39.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia sangat senang tiap kali\N‎aku memakainya.
Dialogue: 0,0:08:43.89,0:08:46.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kedengarannya seperti orang yang kukenal.{\i0}
Dialogue: 0,0:08:46.94,0:08:50.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia masih bekerja di kantor pusat?
Dialogue: 0,0:08:50.19,0:08:51.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Masih berkomunikasi dengannya?
Dialogue: 0,0:08:53.86,0:08:57.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kudengar dia akan pensiun bulan ini.
Dialogue: 0,0:08:57.20,0:08:58.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia sudah usia pensiun.
Dialogue: 0,0:08:59.12,0:09:00.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia menghubungiku.
Dialogue: 0,0:09:00.87,0:09:04.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, kau akan minum\N‎untuk merayakan pensiun, 'kan?
Dialogue: 0,0:09:10.00,0:09:11.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak.
Dialogue: 0,0:09:11.21,0:09:12.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak akan pergi.
Dialogue: 0,0:09:15.76,0:09:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku hanya menyusahkannya saja.
Dialogue: 0,0:09:19.89,0:09:21.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan aku tak bertemu dia sejak itu.
Dialogue: 0,0:09:23.18,0:09:27.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itulah terakhir kalinya bertemu dia,\N‎jadi aku tak bisa tiba-tiba berkabar.
Dialogue: 0,0:09:28.94,0:09:30.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa maksudmu?
Dialogue: 0,0:09:30.40,0:09:33.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia tak akan menghubungimu\N‎jika itu yang dia rasakan, 'kan?
Dialogue: 0,0:09:35.19,0:09:38.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia pria dengan integritas tinggi.
Dialogue: 0,0:09:38.70,0:09:43.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku yakin itu tak ada hubungannya\N‎dengan moral dan etika sosial.
Dialogue: 0,0:09:43.62,0:09:45.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau melebih-lebihkan.
Dialogue: 0,0:09:45.50,0:09:48.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku melakukan hal yang sangat buruk
Dialogue: 0,0:09:48.00,0:09:50.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lalu kenapa dia repot-repot menghubungimu…
Dialogue: 0,0:09:50.38,0:09:52.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sudah bilang begitu.
Dialogue: 0,0:09:53.21,0:09:56.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia tak akan menusukmu\N‎jika kau menemuinya.
Dialogue: 0,0:09:57.72,0:09:59.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku yakin itu tak akan terjadi.
Dialogue: 0,0:10:01.72,0:10:06.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi aku ingin dia pensiun\N‎dengan gemilang.
Dialogue: 0,0:10:08.31,0:10:09.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi,
Dialogue: 0,0:10:10.06,0:10:11.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku tak akan pergi.
Dialogue: 0,0:10:27.04,0:10:29.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku harus memintamu pergi, Pak.
Dialogue: 0,0:10:31.54,0:10:32.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tunggu…
Dialogue: 0,0:10:36.21,0:10:38.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-san! Aku belum mematikan rokokku.
Dialogue: 0,0:10:38.84,0:10:42.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Biar aku yang mengurusnya nanti.
Dialogue: 0,0:10:48.35,0:10:50.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Wah!
Dialogue: 0,0:10:51.85,0:10:53.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aduh!
Dialogue: 0,0:10:54.02,0:10:55.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-san!
Dialogue: 0,0:10:56.90,0:11:01.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak peduli semenyusahkan apa kau\N‎bagi orang ini.
Dialogue: 0,0:11:02.11,0:11:07.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi aku tak bisa menikmati merokok\N‎bersama orang sepertimu sekarang.
Dialogue: 0,0:11:08.83,0:11:10.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sasaki-san. Kau dilarang ke sini lagi.
Dialogue: 0,0:11:17.34,0:11:19.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan kembali sampai beban\N‎di bahumu hilang.
Dialogue: 0,0:11:44.62,0:11:46.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sasaki-san. Kau dilarang ke sini lagi.
Dialogue: 0,0:11:47.20,0:11:49.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan kembali sampai beban\N‎di bahumu hilang.
Dialogue: 0,0:11:54.83,0:11:55.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-san!
Dialogue: 0,0:11:55.92,0:11:57.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ambil tasmu.
Dialogue: 0,0:11:58.46,0:11:59.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih.
Dialogue: 0,0:12:03.55,0:12:06.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bagaimana aku bisa sekasar itu?{\i0}
Dialogue: 0,0:12:07.56,0:12:12.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tamu di tempatnya\N‎tapi aku sibuk dengan duniaku sendiri.{\i0}
Dialogue: 0,0:12:14.19,0:12:15.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tidak.{\i0}
Dialogue: 0,0:12:15.98,0:12:19.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak bisa menikmati merokok\N‎bersama orang sepertimu sekarang.
Dialogue: 0,0:12:20.65,0:12:23.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi bukan itu\N‎yang membuatnya mengatakan itu.{\i0}
Dialogue: 0,0:12:31.50,0:12:32.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hachim!
Dialogue: 0,0:12:32.66,0:12:34.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Astaga, dingin sekali!
Dialogue: 0,0:12:36.00,0:12:38.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sial, suasana hatimu sedih sekali!
Dialogue: 0,0:12:38.96,0:12:43.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tahu aku bisa menemukanmu\N‎jika aku mengikuti jejak kesedihan.
Dialogue: 0,0:12:43.63,0:12:44.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Spritz.\N‎- Wah!
Dialogue: 0,0:12:45.47,0:12:47.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Merokok di sini sangat dingin.
Dialogue: 0,0:12:48.18,0:12:50.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa yang kau pikirkan?
Dialogue: 0,0:12:50.47,0:12:54.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku hanya butuh\N‎menenangkan pikiranku sebentar, jadi…
Dialogue: 0,0:12:54.19,0:12:57.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo. Jangan di sini.\N‎Merokoklah di area merokok.
Dialogue: 0,0:12:57.27,0:13:02.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku harus merokok dan mengobrol denganmu\N‎saat istirahat.
Dialogue: 0,0:13:03.40,0:13:04.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dingin sekali.
Dialogue: 0,0:13:09.99,0:13:11.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Suzuki.
Dialogue: 0,0:13:11.91,0:13:14.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Boleh aku bertanya…\N‎- Soal kepiting, 'kan?
Dialogue: 0,0:13:14.46,0:13:16.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau sangat suka kepiting.
Dialogue: 0,0:13:17.58,0:13:20.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Bagaimana kau tahu?\N‎- Aku bisa tebak.
Dialogue: 0,0:13:26.01,0:13:29.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Di sanalah senior lamamu bekerja, 'kan?
Dialogue: 0,0:13:30.22,0:13:32.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Belilah kepiting.
Dialogue: 0,0:13:33.39,0:13:38.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Suzuki… Kau benar-benar baik.
Dialogue: 0,0:13:38.27,0:13:39.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Memang.
Dialogue: 0,0:13:39.98,0:13:42.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Hore!{\i0}
Dialogue: 0,0:13:42.02,0:13:45.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kudengar bos di sana\N‎100 kali lebih buruk daripada bos kita,{\i0}
Dialogue: 0,0:13:45.32,0:13:48.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎jadi aku sama sekali tak mau pergi.{\i0}
Dialogue: 0,0:13:52.37,0:13:53.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia benar-benar tak datang.{\i0}
Dialogue: 0,0:13:54.62,0:13:58.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku bahkan tak pernah melihatnya\N‎di toko lagi.{\i0}
Dialogue: 0,0:13:59.04,0:14:02.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bagaimana jika dia tak pernah kembali?{\i0}
Dialogue: 0,0:14:02.92,0:14:04.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎- Pergi!\N‎- Gawat!{\i0}
Dialogue: 0,0:14:05.71,0:14:09.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku membuat Tayama-san marah.\N‎Sudah berakhir sekarang.{\i0}
Dialogue: 0,0:14:10.18,0:14:15.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Seseorang sepertiku tak pantas\N‎melihat senyum Yamada-san yang indah!{\i0}
Dialogue: 0,0:14:16.64,0:14:17.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kedengarannya begitu.{\i0}
Dialogue: 0,0:14:19.27,0:14:24.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kami hanya dua orang yang merokok bersama.\N‎Kenapa aku terlalu ikut campur?
Dialogue: 0,0:14:25.15,0:14:28.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Mungkin ada cara lain untuk mengatakannya?{\i0}
Dialogue: 0,0:14:28.78,0:14:29.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak akan pergi.{\i0}
Dialogue: 0,0:14:31.99,0:14:33.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tahu kau ingin pergi.{\i0}
Dialogue: 0,0:14:35.74,0:14:37.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia menyadari hal yang tak kusadari,{\i0}
Dialogue: 0,0:14:38.41,0:14:41.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎bahkan hal-hal yang tak kupikirkan.{\i0}
Dialogue: 0,0:14:42.46,0:14:46.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia menunjukkannya padaku\N‎seolah-olah itu bukan hal besar.{\i0}
Dialogue: 0,0:14:48.55,0:14:49.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Menyedihkan sekali.{\i0}
Dialogue: 0,0:14:54.35,0:14:59.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jadi, saat dia duduk di sampingku\N‎dan mengabaikan perasaannya sendiri…{\i0}
Dialogue: 0,0:14:59.98,0:15:01.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎itu membuatku kesal.{\i0}
Dialogue: 0,0:15:05.69,0:15:08.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oh, Yamada-san?
Dialogue: 0,0:15:09.74,0:15:11.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau baik-baik saja?
Dialogue: 0,0:15:12.45,0:15:13.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sasaki-san!
Dialogue: 0,0:15:14.07,0:15:17.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sudah lama.
Dialogue: 0,0:15:17.58,0:15:19.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benar.
Dialogue: 0,0:15:19.96,0:15:22.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sudah lama tak ke toko\N‎untuk beli sesuatu.
Dialogue: 0,0:15:22.96,0:15:27.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku harus dinas jauh\N‎dan bertemu seseorang.
Dialogue: 0,0:15:27.17,0:15:28.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau dinas jauh?
Dialogue: 0,0:15:28.46,0:15:31.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, aku ke Hokkaido.
Dialogue: 0,0:15:31.34,0:15:32.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa?{\i0}
Dialogue: 0,0:15:32.43,0:15:33.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Pergi!{\i0}
Dialogue: 0,0:15:35.22,0:15:39.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Wow, pekerjaanmu terdengar sulit.
Dialogue: 0,0:15:39.85,0:15:41.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak. Tak juga.
Dialogue: 0,0:15:42.44,0:15:44.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, um…
Dialogue: 0,0:15:44.10,0:15:45.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau mencari Tayama-chan, 'kan?
Dialogue: 0,0:15:46.52,0:15:49.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-chan tak datang hari ini.
Dialogue: 0,0:15:49.19,0:15:50.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Begitu.
Dialogue: 0,0:15:50.95,0:15:52.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih.
Dialogue: 0,0:15:52.36,0:15:55.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi aku bisa sampaikan pesanmu padanya.
Dialogue: 0,0:15:55.87,0:15:57.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akan kuberi tahu saat aku bertemu dia.
Dialogue: 0,0:16:01.62,0:16:03.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih.
Dialogue: 0,0:16:04.29,0:16:06.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi tak apa-apa.
Dialogue: 0,0:16:08.50,0:16:11.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku ingin dia mendengarnya langsung.
Dialogue: 0,0:16:17.68,0:16:20.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baik. Tak sabar.
Dialogue: 0,0:16:23.02,0:16:26.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku yakin Tayama-chan\N‎tak sabar mendengarnya.
Dialogue: 0,0:16:26.15,0:16:28.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oh, ya. Tentu saja.
Dialogue: 0,0:16:28.90,0:16:30.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tentu saja. Ya.
Dialogue: 0,0:16:30.48,0:16:31.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Semoga begitu.
Dialogue: 0,0:16:31.90,0:16:35.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf. Terima kasih sudah menawarkan.
Dialogue: 0,0:16:35.36,0:16:36.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak apa-apa.
Dialogue: 0,0:16:36.49,0:16:39.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak peduli sebanyak apa aku tidur,\N‎aku tetap saja lelah!
Dialogue: 0,0:16:39.87,0:16:41.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Karena kau sudah tua.
Dialogue: 0,0:16:41.04,0:16:44.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah, semoga pekerjaanmu lancar.
Dialogue: 0,0:16:44.67,0:16:45.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih.
Dialogue: 0,0:17:05.31,0:17:09.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Waktumu sangat buruk, Pak Tua.{\i0}
Dialogue: 0,0:17:30.71,0:17:32.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selamat atas pensiunmu.
Dialogue: 0,0:17:33.46,0:17:34.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau sudah bekerja keras.
Dialogue: 0,0:17:35.05,0:17:36.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih.
Dialogue: 0,0:17:36.18,0:17:37.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau juga sudah bekerja keras.
Dialogue: 0,0:17:42.72,0:17:45.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Seperti masa lalu, 'kan?
Dialogue: 0,0:17:46.14,0:17:47.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benar.
Dialogue: 0,0:17:54.40,0:17:57.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak menyangka\N‎kau akan jauh-jauh ke sini.
Dialogue: 0,0:17:58.41,0:18:00.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tahu aku menghubungimu,
Dialogue: 0,0:18:00.07,0:18:02.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tapi aku tahu kau mungkin akan khawatir.
Dialogue: 0,0:18:03.37,0:18:04.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:18:05.04,0:18:06.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku memang mengkhawatirkan ini.
Dialogue: 0,0:18:12.67,0:18:17.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tahu aku kenangan buruk bagimu.
Dialogue: 0,0:18:17.76,0:18:20.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Menurutku, kita punya lebih banyak\N‎kenangan bagus bersama.
Dialogue: 0,0:18:21.01,0:18:24.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak akan menghubungi\N‎orang yang tak kusuka, 'kan?
Dialogue: 0,0:18:24.64,0:18:26.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, benar.
Dialogue: 0,0:18:32.06,0:18:34.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tahu itu,
Dialogue: 0,0:18:34.53,0:18:38.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tapi aku masih sangat takut\N‎hingga dia meneriakiku.
Dialogue: 0,0:18:38.70,0:18:40.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau punya pacar?
Dialogue: 0,0:18:41.91,0:18:45.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak sadar kau punya pacar sekarang.
Dialogue: 0,0:18:46.45,0:18:48.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Seperti apa dia? Apa status kalian?
Dialogue: 0,0:18:48.87,0:18:50.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Um…
Dialogue: 0,0:18:54.46,0:18:59.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak tahu bagaimana menjelaskannya.
Dialogue: 0,0:19:03.89,0:19:07.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kami tak sejauh itu\N‎untuk dibilang hanya kenalan,{\i0}
Dialogue: 0,0:19:08.14,0:19:10.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎tapi banyak yang kami tak tahu\N‎satu sama lain{\i0}
Dialogue: 0,0:19:10.44,0:19:11.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎hingga kami bukan teman.{\i0}
Dialogue: 0,0:19:12.90,0:19:14.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Orang asing mungkin akan menyebutnya{\i0}
Dialogue: 0,0:19:14.69,0:19:17.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎hubungan yang rapuh.{\i0}
Dialogue: 0,0:19:19.57,0:19:20.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi…{\i0}
Dialogue: 0,0:19:22.49,0:19:24.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi dia…{\i0}
Dialogue: 0,0:19:28.12,0:19:31.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Setiap kali aku merasa malu,
Dialogue: 0,0:19:31.75,0:19:34.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎dia selalu ada untuk bilang,\N‎"itu bukan hal besar"
Dialogue: 0,0:19:35.17,0:19:37.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎dan mendorongku.
Dialogue: 0,0:19:40.34,0:19:41.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Begitu.
Dialogue: 0,0:19:41.72,0:19:45.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, dia pasti penting bagimu.
Dialogue: 0,0:19:50.81,0:19:51.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ya.{\i0}
Dialogue: 0,0:21:48.01,0:21:51.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tahu, aku tak pernah ke Hokkaido.
Dialogue: 0,0:21:51.93,0:21:54.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa di sana selalu dingin?
Dialogue: 0,0:21:54.10,0:21:56.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku pernah ke sana beberapa kali,
Dialogue: 0,0:21:56.81,0:21:59.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tapi di sana tak dingin sepanjang tahun.
Dialogue: 0,0:22:02.52,0:22:05.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi saat musim dingin, di sana\N‎sangat dingin hingga rasanya mau mati.
Dialogue: 0,0:22:05.86,0:22:08.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jika kau berpakaian seperti itu, kau…
Dialogue: 0,0:22:09.16,0:22:11.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lagi-lagi kau mengkhawatirkan pakaianku.
Dialogue: 0,0:22:12.78,0:22:14.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf, Tayama-san.
Dialogue: 0,0:22:14.08,0:22:17.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi aku… Maksudku…
Dialogue: 0,0:22:17.79,0:22:20.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau begitu, berikan aku itu.
Dialogue: 0,0:22:22.04,0:22:23.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Syalmu.
Dialogue: 0,0:22:24.00,0:22:26.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jika kau khawatir, biarkan aku memakainya.
Dialogue: 0,0:22:47.07,0:22:50.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sekarang, apa yang ingin\N‎kau katakan padaku?
Dialogue: 0,0:22:50.28,0:22:54.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Mungkin bahwa\N‎aku baru pulang dari Hokkaido.
Dialogue: 0,0:22:55.08,0:22:56.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah.
Dialogue: 0,0:22:56.41,0:22:58.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ceritakan tentang itu.
Dialogue: 0,0:22:59.33,0:23:01.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku ingin kita bicara lama.
Dialogue: 0,0:23:06.71,0:23:07.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau makan kepiting?
Dialogue: 0,0:23:08.63,0:23:10.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Ada apa?
Dialogue: 0,0:23:10.01,0:23:11.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf.
Dialogue: 0,0:23:11.76,0:23:17.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hanya saja, rekan kerjaku juga terus\N‎mengaitkan Hokkaido dengan kepiting, jadi…
Dialogue: 0,0:23:17.22,0:23:19.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia benar.
Dialogue: 0,0:23:19.02,0:23:20.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ramen miso kepiting.
Dialogue: 0,0:23:20.52,0:23:22.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Kenapa kita membicarakan ramen?
Dialogue: 0,0:23:22.90,0:23:25.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ramen enak dimakan di mana pun.
Dialogue: 0,0:23:25.27,0:23:28.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oh, rasa mentega miso di Sapporo\N‎sangat lezat.
Dialogue: 0,0:23:28.49,0:23:29.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kedengarannya bagus.{\i0}
Dialogue: 0,0:23:29.90,0:23:32.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi aku hanya butuh\N‎setengah porsi akhir-akhir ini.{\i0}
Dialogue: 0,0:23:32.57,0:23:33.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Itu karena kau sudah tua.{\i0}
Dialogue: 0,0:23:33.91,0:23:35.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terjemahan subtitle oleh Rahayu Kinasih
