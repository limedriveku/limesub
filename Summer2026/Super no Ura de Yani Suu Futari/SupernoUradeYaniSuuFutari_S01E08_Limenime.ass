Dialogue: 0,0:00:02.00,0:00:03.67,sign,,0000,0000,0000,,{\an8}‎BUKA 24 JAM - SUPER S
Dialogue: 0,0:00:09.13,0:00:10.21,sign,,0000,0000,0000,,‎TUGAS BERSIH-BERSIH
Dialogue: 0,0:03:06.93,0:03:07.97,sign,,0000,0000,0000,,‎REMUK
Dialogue: 0,0:03:53.56,0:03:55.98,sign,,0000,0000,0000,,‎MOHON DAUR ULANG - DISKON 5%\N‎NAMPAN MAKANAN - BOTOL PLASTIK
Dialogue: 0,0:04:48.37,0:04:51.54,sign,,0000,0000,0000,,‎YANG TERKUAT
Dialogue: 0,0:10:01.39,0:10:02.47,sign,,0000,0000,0000,,‎PERUSAHAAN HAPPY
Dialogue: 0,0:12:04.43,0:12:05.51,sign,,0000,0000,0000,,‎ORANG YANG SAMA
Dialogue: 0,0:12:23.78,0:12:25.11,sign,,0000,0000,0000,,{\an8}‎DOG CHU-CHURU
Dialogue: 0,0:13:24.76,0:13:26.22,sign,,0000,0000,0000,,‎MENUJU SHIMAIDA\N‎LAYANAN DIHENTIKAN SEMENTARA
Dialogue: 0,0:13:26.22,0:13:28.51,sign,,0000,0000,0000,,‎LAYANAN KERETA DIHENTIKAN SEMENTARA\N‎KARENA ANGIN TOPAN
Dialogue: 0,0:13:28.51,0:13:31.18,sign,,0000,0000,0000,,{\an8}‎BUKA 24 JAM - SUPER S
Dialogue: 0,0:13:35.18,0:13:36.68,sign,,0000,0000,0000,,‎PERUBAHAN JAM BUKA
Dialogue: 0,0:13:36.69,0:13:39.02,sign,,0000,0000,0000,,‎KAMI MINTA MAAF ATAS KETIDAKNYAMANANNYA
Dialogue: 0,0:13:39.02,0:13:41.52,sign,,0000,0000,0000,,‎KAMI AKAN TUTUP PADA PUKUL 21.00 HARI INI\N‎KARENA ANGIN TOPAN - MANAJER TOKO
Dialogue: 0,0:15:57.16,0:15:59.37,sign,,0000,0000,0000,,‎KITA SELALU MENGOBROL\N‎JADI APA MASALAHNYA?
Dialogue: 0,0:00:10.21,0:00:13.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Manajer, aku sudah selesai\N‎mengisi ulang barang-barang.
Dialogue: 0,0:00:13.63,0:00:16.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baik. Kerja bagus. Kau boleh pulang.
Dialogue: 0,0:00:20.72,0:00:23.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sampai jumpa, Yamada-chan.
Dialogue: 0,0:00:23.44,0:00:24.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sampai jumpa.
Dialogue: 0,0:00:25.40,0:00:27.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku akan merokok sebentar, lalu pulang.{\i0}
Dialogue: 0,0:00:28.31,0:00:30.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku sudah lama tak melihat Sasaki-san.{\i0}
Dialogue: 0,0:00:30.86,0:00:33.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Semoga dia tak mati karena bekerja.{\i0}
Dialogue: 0,0:00:35.03,0:00:37.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sakuku terasa lebih ringan\N‎daripada biasanya…{\i0}
Dialogue: 0,0:00:43.16,0:00:44.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hilang.
Dialogue: 0,0:02:30.69,0:02:31.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei.
Dialogue: 0,0:02:33.27,0:02:36.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Gajimu kurang untuk kebutuhanmu?
Dialogue: 0,0:02:36.78,0:02:40.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Manajer! Kau lihat asbakku?
Dialogue: 0,0:02:40.53,0:02:41.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Asbak?
Dialogue: 0,0:02:41.78,0:02:45.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Warnanya biru, bundar,\N‎dan ada tulang anjingnya.
Dialogue: 0,0:02:45.83,0:02:46.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Seperti ini.
Dialogue: 0,0:02:47.00,0:02:51.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maksudmu barang\N‎yang Sasaki-kun berikan kepadamu?
Dialogue: 0,0:02:54.29,0:02:56.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau memang suka barang itu,
Dialogue: 0,0:02:56.50,0:02:58.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎padahal kau tak pernah suka apa pun.
Dialogue: 0,0:02:59.34,0:03:02.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak melihatnya.
Dialogue: 0,0:03:03.05,0:03:06.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oh? Kau akan merokok tanpa asbak?
Dialogue: 0,0:03:08.52,0:03:10.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tak membantu.
Dialogue: 0,0:03:10.64,0:03:13.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ya, ini seru.{\i0}
Dialogue: 0,0:03:15.94,0:03:19.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, kau sudah periksa di depan?
Dialogue: 0,0:03:19.78,0:03:20.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Di depan?
Dialogue: 0,0:03:21.36,0:03:23.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Di dekat tempat daur ulang.
Dialogue: 0,0:03:24.20,0:03:26.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau yang menggantinya hari ini.
Dialogue: 0,0:03:27.79,0:03:30.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mungkin saja jatuh, lalu…
Dialogue: 0,0:03:39.88,0:03:43.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Proyek itu jadi rumit dan menyulitkanku,\N‎tapi akhirnya sudah berakhir.{\i0}
Dialogue: 0,0:03:45.01,0:03:48.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Semoga ada Yamada-san di kasir hari ini.{\i0}
Dialogue: 0,0:03:51.98,0:03:53.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tunggu, Yamada-san?{\i0}
Dialogue: 0,0:03:55.98,0:03:59.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Haruskah aku menyapa?{\i0}
Dialogue: 0,0:03:59.78,0:04:02.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi aku tak mau mengganggu\N‎saat dia sedang bekerja.{\i0}
Dialogue: 0,0:04:02.90,0:04:05.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bahkan jika dia tak bekerja,\N‎aku tetap akan mengganggu.{\i0}
Dialogue: 0,0:04:06.16,0:04:09.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi Yamada-san menyapaku\N‎bahkan saat dia sedang tak di kasir.{\i0}
Dialogue: 0,0:04:10.45,0:04:12.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bukankah tak sopan jika aku lewat\N‎tanpa menyapanya?{\i0}
Dialogue: 0,0:04:19.21,0:04:22.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bersikap biasa saja, Sasaki.{\i0}
Dialogue: 0,0:04:22.84,0:04:25.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sapalah dengan cara\N‎yang tak menjengkelkan.{\i0}
Dialogue: 0,0:04:26.76,0:04:28.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sepertinya ini.{\i0}
Dialogue: 0,0:04:29.51,0:04:31.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Manajer. Kau ternyata berguna.{\i0}
Dialogue: 0,0:04:31.77,0:04:32.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yamada-san.
Dialogue: 0,0:04:33.64,0:04:36.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Halo.
Dialogue: 0,0:04:38.36,0:04:41.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jika kujatuhkan asbakku sebagai Yamada,{\i0}
Dialogue: 0,0:04:42.61,0:04:44.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎aku akan ketahuan.{\i0}
Dialogue: 0,0:04:54.12,0:04:55.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mainan?
Dialogue: 0,0:04:58.04,0:04:59.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei!
Dialogue: 0,0:04:59.25,0:05:01.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu Bay Bebay Blade milikku!
Dialogue: 0,0:05:01.34,0:05:03.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kembalikan, Pak Tua!
Dialogue: 0,0:05:03.26,0:05:05.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar anak tak sopan!
Dialogue: 0,0:05:05.76,0:05:06.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aduh!
Dialogue: 0,0:05:09.76,0:05:13.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maafkan aku.\N‎Dia tak bisa menjaga mulutnya.
Dialogue: 0,0:05:13.93,0:05:17.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oh, Yamada-chan.
Dialogue: 0,0:05:17.40,0:05:19.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Halo, Kepala Maezawa.
Dialogue: 0,0:05:19.90,0:05:25.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan kau! Kau Penggemar Yamada-chan\N‎No. 28, 'kan?
Dialogue: 0,0:05:25.36,0:05:28.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Halo.
Dialogue: 0,0:05:28.03,0:05:31.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayolah, Kepala. Jangan beri\N‎julukan aneh kepada orang-orang.
Dialogue: 0,0:05:31.41,0:05:33.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan kau. Bilang terima kasih.
Dialogue: 0,0:05:34.25,0:05:37.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih, Pak,\N‎telah menyelamatkan mainanku.
Dialogue: 0,0:05:37.79,0:05:39.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak apa-apa.
Dialogue: 0,0:05:39.67,0:05:42.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukan aku yang menemukannya.
Dialogue: 0,0:05:42.38,0:05:44.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi wanita baik hati ini.
Dialogue: 0,0:05:46.05,0:05:49.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia selalu menjatuhkan barang-barangnya.
Dialogue: 0,0:05:49.22,0:05:52.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Padahal sudah kubilang jangan taruh\N‎barang berharga di saku.
Dialogue: 0,0:05:53.56,0:05:56.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Aku juga begitu saat masih kecil.\N{\i1}‎- Aku berusaha keras mencarinya.{\i0}
Dialogue: 0,0:05:56.98,0:05:59.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Kau makan apa hingga sebesar itu?\N‎-{\i1}‎ Tapi itu hanya mainan.{\i0}
Dialogue: 0,0:06:00.56,0:06:04.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku yakin pada akhirnya\N‎aku akan menemukannya.{\i0}
Dialogue: 0,0:06:12.91,0:06:15.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sudah dua hari kucari,\N‎tapi masih belum ketemu.
Dialogue: 0,0:06:16.16,0:06:19.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tinggal area pinggiran toko\N‎yang belum kucari,
Dialogue: 0,0:06:19.71,0:06:21.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tapi aku tak tahu di mana itu.
Dialogue: 0,0:06:26.80,0:06:29.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau jalan-jalan sendirian lagi?
Dialogue: 0,0:06:30.09,0:06:31.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Manajer akan marah.
Dialogue: 0,0:06:33.68,0:06:35.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Hei, Daigoro.
Dialogue: 0,0:06:37.18,0:06:39.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku kehilangan sesuatu.
Dialogue: 0,0:06:40.60,0:06:41.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa kau tahu?
Dialogue: 0,0:06:42.90,0:06:47.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bentuknya bundar, biru,\N‎dan ada pola anjing sepertimu.{\i0}
Dialogue: 0,0:06:47.82,0:06:52.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Itu cukup imut hingga pria paruh baya\N‎butuh keberanian untuk membelinya.{\i0}
Dialogue: 0,0:06:53.24,0:06:56.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Itu hadiah terima kasih\N‎walaupun kubilang aku tak butuh.{\i0}
Dialogue: 0,0:06:57.58,0:07:01.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia sepertinya suka\N‎saat aku memakainya di depannya.
Dialogue: 0,0:07:05.96,0:07:07.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku harus minta maaf padanya.
Dialogue: 0,0:07:13.47,0:07:16.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak ada gunanya\N‎menceritakan ini pada anjing.
Dialogue: 0,0:07:18.93,0:07:21.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi terima kasih sudah mendengarkan.
Dialogue: 0,0:07:21.98,0:07:23.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sampai jumpa.
Dialogue: 0,0:07:32.49,0:07:34.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu menegangkan.
Dialogue: 0,0:07:35.91,0:07:39.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih telah diam, Daigoro-san.
Dialogue: 0,0:07:42.42,0:07:44.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku bersembunyi\N‎karena kupikir akan canggung,{\i0}
Dialogue: 0,0:07:44.92,0:07:47.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎tapi sekarang aku terlihat\N‎seperti penguping.{\i0}
Dialogue: 0,0:07:52.26,0:07:57.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia terlihat sedih, tapi aku malah senang\N‎karena dia menghargainya.{\i0}
Dialogue: 0,0:07:58.22,0:07:59.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku bodoh sekali{\i0}‎…
Dialogue: 0,0:08:01.39,0:08:03.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, Daigoro-san.
Dialogue: 0,0:08:04.52,0:08:07.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ingin berjalan-jalan\N‎di sekitar toko bersamaku?
Dialogue: 0,0:08:11.53,0:08:14.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Totalnya 1.800 yen.
Dialogue: 0,0:08:14.53,0:08:16.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Boleh kubayar dengan poin?
Dialogue: 0,0:08:16.91,0:08:18.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tentu saja.
Dialogue: 0,0:08:18.78,0:08:23.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Saat dia ke belakang nanti,\N‎aku akan minta maaf.{\i0}
Dialogue: 0,0:08:24.04,0:08:25.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku akan bilang,\N‎"Maaf, aku menghilangkannya."{\i0}
Dialogue: 0,0:08:25.58,0:08:27.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎"Maaf. Asbaknya hilang."{\i0}
Dialogue: 0,0:08:27.59,0:08:29.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yamada-san?
Dialogue: 0,0:08:30.80,0:08:33.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya? Bisa kubantu?
Dialogue: 0,0:08:33.30,0:08:35.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf membahas ini saat kau bekerja,
Dialogue: 0,0:08:35.72,0:08:38.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tapi aku ingin kau memberikan ini\N‎kepada Tayama-san.
Dialogue: 0,0:08:39.43,0:08:40.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini.
Dialogue: 0,0:08:42.93,0:08:46.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku menemukannya di saluran air\N‎di depan toko.
Dialogue: 0,0:08:46.90,0:08:49.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sedang di sana\N‎dan tak sengaja melihatnya.
Dialogue: 0,0:08:49.86,0:08:52.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini tak rusak, jadi aku mengelapnya,
Dialogue: 0,0:08:52.49,0:08:55.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎maaf menyusahkan,\N‎tapi bisa berikan ini kepadanya?
Dialogue: 0,0:08:57.32,0:08:59.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Wah! Apa?
Dialogue: 0,0:08:59.24,0:09:01.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada di saluran air?
Dialogue: 0,0:09:02.58,0:09:03.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benarkah?
Dialogue: 0,0:09:05.33,0:09:07.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Di sana kau menemukannya?
Dialogue: 0,0:09:10.63,0:09:12.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maafkan aku.
Dialogue: 0,0:09:12.17,0:09:14.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku juga mencarinya, jadi aku ikut senang.
Dialogue: 0,0:09:14.84,0:09:17.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pasti akan kuberikan ke Tayama-san.
Dialogue: 0,0:09:20.26,0:09:21.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sasaki-san?
Dialogue: 0,0:09:22.85,0:09:25.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku hanya menemukannya.
Dialogue: 0,0:09:25.06,0:09:27.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, aku minta tolong.
Dialogue: 0,0:09:27.69,0:09:29.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sampai jumpa!
Dialogue: 0,0:09:37.20,0:09:40.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jika kau tak sengaja menemukannya,{\i0}
Dialogue: 0,0:09:40.12,0:09:42.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎kenapa lengan bajumu sangat kotor?{\i0}
Dialogue: 0,0:09:47.42,0:09:50.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Terima kasih, Sasaki-san si Penguping.{\i0}
Dialogue: 0,0:09:52.38,0:09:54.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau agak kotor, ya?
Dialogue: 0,0:09:56.97,0:10:00.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mungkin dia mengejar wanita?
Dialogue: 0,0:10:02.47,0:10:05.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Suzuki, kau punya anjing, 'kan?
Dialogue: 0,0:10:05.31,0:10:06.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:10:06.39,0:10:09.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tahu apa makanan anjing\N‎yang paling populer?
Dialogue: 0,0:10:11.98,0:10:14.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau muak menjadi lajang\N‎dan ingin punya anjing?
Dialogue: 0,0:10:14.78,0:10:16.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak.
Dialogue: 0,0:10:16.65,0:10:19.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak punya keluarga, aku pulang malam,\N‎dan tak pernah libur.
Dialogue: 0,0:10:19.74,0:10:22.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Anjing mana yang ingin\N‎menjadi peliharaanku.
Dialogue: 0,0:10:22.45,0:10:24.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan terdengar menyedihkan.
Dialogue: 0,0:10:25.16,0:10:26.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Biar kupikir…
Dialogue: 0,0:10:27.16,0:10:28.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Makanan populer tak penting
Dialogue: 0,0:10:28.66,0:10:33.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎karena anjing punya kebutuhan berbeda\N‎tergantung umur dan jenisnya.
Dialogue: 0,0:10:33.04,0:10:36.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benarkah? Kurasa itu masuk akal.
Dialogue: 0,0:10:36.55,0:10:40.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi putriku kadang\N‎suka membeli Dog Chu-churu.
Dialogue: 0,0:10:40.38,0:10:41.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:10:43.85,0:10:45.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dog Chu-churu.
Dialogue: 0,0:10:45.68,0:10:48.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baik. Terima kasih.
Dialogue: 0,0:10:49.81,0:10:51.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau…
Dialogue: 0,0:10:52.56,0:10:53.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan kau makan.
Dialogue: 0,0:10:53.94,0:10:56.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tahu kau seperti anjing,\N‎tapi kau manusia!
Dialogue: 0,0:10:56.48,0:10:59.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa kau bilang begitu?
Dialogue: 0,0:10:59.20,0:11:01.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih banyak.
Dialogue: 0,0:11:05.45,0:11:08.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Semoga Daigoro-san suka\N‎hadiah terima kasihnya.{\i0}
Dialogue: 0,0:11:12.46,0:11:13.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini dia.
Dialogue: 0,0:11:14.71,0:11:16.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Daigoro-san.
Dialogue: 0,0:11:16.38,0:11:19.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih telah membantuku mencari.
Dialogue: 0,0:11:19.97,0:11:21.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Sama-sama, guk.
Dialogue: 0,0:11:21.97,0:11:22.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:11:24.51,0:11:28.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎T-T-Tayama-san?\N‎Maaf, aku tak sadar kau di sana.
Dialogue: 0,0:11:28.22,0:11:29.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya. Aku di sini.
Dialogue: 0,0:11:29.73,0:11:32.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak, maksudku bukan begitu.
Dialogue: 0,0:11:37.61,0:11:39.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau sepertinya punya bisnis\N‎dengan Daigoro.
Dialogue: 0,0:11:42.03,0:11:45.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tayama-san dapat asbaknya kembali\N‎lewat Yamada-san. Itu saja.{\i0}
Dialogue: 0,0:11:45.37,0:11:47.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia tak tahu aku tahu dia hilangkan{\i0}
Dialogue: 0,0:11:47.24,0:11:49.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎atau aku mencarinya bersama Daigoro-san.{\i0}
Dialogue: 0,0:11:49.50,0:11:52.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak ingin beri tahu\N‎agar suasananya tak canggung.{\i0}
Dialogue: 0,0:11:52.00,0:11:53.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku harus bagaimana?{\i0}
Dialogue: 0,0:11:53.92,0:11:58.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku mengerti. Dia menemukan asbakku\N‎dengan bantuan Daigoro.{\i0}
Dialogue: 0,0:11:59.26,0:12:02.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa dia tak bilang saja\N‎dia menemukannya?{\i0}
Dialogue: 0,0:12:02.68,0:12:04.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa dia tak mengatakannya?{\i0}
Dialogue: 0,0:12:05.51,0:12:07.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Katakan saja.{\i0}
Dialogue: 0,0:12:07.14,0:12:08.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak bisa berterima kasih jika begini.{\i0}
Dialogue: 0,0:12:11.39,0:12:15.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku ingin memberi Daigoro-san\N‎makanan anjing.
Dialogue: 0,0:12:16.73,0:12:19.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah. Tunggu di sana.
Dialogue: 0,0:12:20.53,0:12:23.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalian berdua sangat akur.
Dialogue: 0,0:12:26.07,0:12:27.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa terjadi sesuatu?
Dialogue: 0,0:12:27.58,0:12:29.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sama sekali tidak.
Dialogue: 0,0:12:29.74,0:12:33.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hanya saja… rekan kerjaku selalu bilang\N‎aku mirip anjing.
Dialogue: 0,0:12:33.83,0:12:38.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, mungkin aku dan Daigoro-san\N‎punya ikatan? Mungkin?
Dialogue: 0,0:12:54.48,0:12:55.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih.
Dialogue: 0,0:12:56.73,0:12:59.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih telah\N‎"tak sengaja menemukan" ini.
Dialogue: 0,0:13:00.48,0:13:02.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tentu…
Dialogue: 0,0:13:04.99,0:13:06.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa yang barusan kau lakukan?
Dialogue: 0,0:13:07.16,0:13:08.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kupikir kau Daigoro.
Dialogue: 0,0:13:08.70,0:13:09.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:13:41.52,0:13:44.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sangat berbeda dibandingkan perusahaanku.{\i0}
Dialogue: 0,0:13:46.15,0:13:47.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-san?
Dialogue: 0,0:13:47.66,0:13:49.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yo.
Dialogue: 0,0:13:49.66,0:13:52.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kupikir tokonya tutup?
Dialogue: 0,0:13:55.50,0:13:58.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Manajer akan mengantarku,\N‎jadi aku menunggunya.
Dialogue: 0,0:13:58.62,0:14:01.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia sedang bekerja,\N‎jadi aku punya waktu luang.
Dialogue: 0,0:14:04.05,0:14:05.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ingin merokok?
Dialogue: 0,0:14:06.42,0:14:09.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sejujurnya, sangat ingin.
Dialogue: 0,0:14:13.56,0:14:17.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf aku meminjam handukmu, Tayama-san.
Dialogue: 0,0:14:17.56,0:14:19.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak apa-apa.
Dialogue: 0,0:14:19.06,0:14:21.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku juga butuh teman.
Dialogue: 0,0:14:21.52,0:14:22.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan…
Dialogue: 0,0:14:26.94,0:14:29.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku suka penampilanmu hari ini.
Dialogue: 0,0:14:29.45,0:14:30.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ha?
Dialogue: 0,0:14:32.12,0:14:33.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Rambutmu berantakan.
Dialogue: 0,0:14:34.66,0:14:37.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu selucu melihatmu memakai kacamata.
Dialogue: 0,0:14:37.71,0:14:39.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benarkah?
Dialogue: 0,0:14:39.87,0:14:41.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benar.
Dialogue: 0,0:14:42.71,0:14:45.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak mengerti apa yang anak muda\N‎zaman sekarang anggap lucu.{\i0}
Dialogue: 0,0:14:47.13,0:14:48.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:14:49.05,0:14:52.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku terlalu sibuk melindungi\N‎tasku yang berisi dokumen
Dialogue: 0,0:14:52.18,0:14:54.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎hingga rokokku…
Dialogue: 0,0:14:54.31,0:14:56.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Nasib budak korporat.
Dialogue: 0,0:14:58.27,0:15:01.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Padahal satu bungkus\N‎sangat mahal akhir-akhir ini…
Dialogue: 0,0:15:03.23,0:15:05.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini karena aku merasa kasihan.
Dialogue: 0,0:15:06.15,0:15:07.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-san!
Dialogue: 0,0:15:09.24,0:15:10.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Atau kau lebih suka begini?
Dialogue: 0,0:15:10.74,0:15:12.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak!
Dialogue: 0,0:15:12.91,0:15:14.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi terima kasih.
Dialogue: 0,0:15:19.04,0:15:21.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Rasanya berat.{\i0}
Dialogue: 0,0:15:21.67,0:15:23.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa ini rokok yang dia isap?{\i0}
Dialogue: 0,0:15:45.77,0:15:48.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Apa?\N‎- Wah! Maaf!
Dialogue: 0,0:15:49.28,0:15:53.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hanya saja cara duduk kita berbeda\N‎daripada biasanya karena hujan.
Dialogue: 0,0:15:53.16,0:15:57.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kita saling berhadapan dan aku gugup\N‎karena tak tahu harus bicara apa.
Dialogue: 0,0:15:59.37,0:16:01.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tahu maksudmu.
Dialogue: 0,0:16:04.42,0:16:06.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah, tak apa-apa.
Dialogue: 0,0:16:07.09,0:16:09.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Haruskah kita cari topik?
Dialogue: 0,0:16:09.25,0:16:10.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu ide bagus.
Dialogue: 0,0:16:11.59,0:16:12.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagaimana dengan…
Dialogue: 0,0:16:14.47,0:16:18.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa kau merokok?
Dialogue: 0,0:16:18.18,0:16:20.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Eh…
Dialogue: 0,0:16:25.19,0:16:27.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Halo? Sasaki-san?
Dialogue: 0,0:16:27.90,0:16:30.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku hanya menyarankan topik obrolan.
Dialogue: 0,0:16:31.40,0:16:35.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Alasan aku merokok…
Dialogue: 0,0:16:35.28,0:16:37.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kurasa ini konyol.
Dialogue: 0,0:16:37.20,0:16:40.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi? Aku ingin dengar,\N‎bahkan jika konyol.
Dialogue: 0,0:16:41.70,0:16:43.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Seseorang membuatku merokok,
Dialogue: 0,0:16:43.79,0:16:45.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎dan aku terus melanjutkan.
Dialogue: 0,0:16:45.96,0:16:47.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Siapa yang membuatmu merokok?
Dialogue: 0,0:16:48.46,0:16:49.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:16:50.46,0:16:51.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu?
Dialogue: 0,0:16:53.13,0:16:56.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Saat aku kuliah. Pa…
Dialogue: 0,0:16:56.93,0:16:58.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Keka…
Dialogue: 0,0:16:58.93,0:17:01.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Orang yang kupacari. Dia memaksaku.
Dialogue: 0,0:17:01.77,0:17:04.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Makanya aku merokok…
Dialogue: 0,0:17:05.48,0:17:08.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Seperti itulah sifatmu.
Dialogue: 0,0:17:08.48,0:17:11.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benarkah?
Dialogue: 0,0:17:11.11,0:17:14.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, kau lebih suka begini.
Dialogue: 0,0:17:14.28,0:17:16.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sudah kubilang! Aku dipaksa!
Dialogue: 0,0:17:17.74,0:17:21.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lupakanlah cerita konyol pria tua ini.
Dialogue: 0,0:17:21.29,0:17:25.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagaimana denganmu? Kenapa kau merokok?
Dialogue: 0,0:17:30.00,0:17:33.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku melihat orang lain melakukannya,
Dialogue: 0,0:17:33.34,0:17:35.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎jadi aku ikut merokok juga.
Dialogue: 0,0:17:36.97,0:17:41.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Delapan tahun lalu,\N‎kami punya area merokok di depan.
Dialogue: 0,0:17:41.60,0:17:43.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Di sanalah para pelanggan merokok.
Dialogue: 0,0:17:44.73,0:17:47.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada satu pelanggan yang kuingat.
Dialogue: 0,0:17:48.40,0:17:49.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia pekerja kantoran.
Dialogue: 0,0:17:49.77,0:17:52.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Rambutnya berantakan dan dia selalu\N‎berhenti merokok saat pulang.
Dialogue: 0,0:17:53.86,0:17:56.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Suatu kali, aku merasa\N‎hanya merepotkan saat bekerja,{\i0}
Dialogue: 0,0:17:56.74,0:17:58.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎dan aku berpikir untuk berhenti.{\i0}
Dialogue: 0,0:17:59.45,0:18:03.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi aku sadar aku suka pekerjaanku\N‎dan tak ingin berhenti.{\i0}
Dialogue: 0,0:18:05.00,0:18:08.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Atau dialah yang membuatku sadar.
Dialogue: 0,0:18:08.87,0:18:13.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku selalu teringat padanya, merokok\N‎di sana, bahkan saat aku berusia 20 tahun,
Dialogue: 0,0:18:14.38,0:18:15.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, itu tak sengaja.
Dialogue: 0,0:18:23.93,0:18:26.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-san, kau…
Dialogue: 0,0:18:27.85,0:18:29.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu bukan "tak sengaja".
Dialogue: 0,0:18:29.90,0:18:31.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau…
Dialogue: 0,0:18:35.11,0:18:38.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau pasti sangat mengagumi pria itu.
Dialogue: 0,0:18:43.66,0:18:47.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf, aku seharusnya tak bilang begitu.
Dialogue: 0,0:18:48.00,0:18:51.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jika aku salah,\N‎atau kau tak suka, lupakan saja.
Dialogue: 0,0:19:03.64,0:19:04.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Menurutmu begitu?
Dialogue: 0,0:19:05.31,0:19:07.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ha? Yah…
Dialogue: 0,0:19:08.23,0:19:09.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku…
Dialogue: 0,0:19:25.20,0:19:27.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf!
Dialogue: 0,0:19:27.58,0:19:28.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak apa-apa.
Dialogue: 0,0:19:28.66,0:19:30.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tak terluka?
Dialogue: 0,0:19:30.04,0:19:31.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku baik-baik saja.
Dialogue: 0,0:19:31.12,0:19:32.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf.
Dialogue: 0,0:19:32.75,0:19:35.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Cuci tanganmulah jika kau merasa jijik.
Dialogue: 0,0:19:36.13,0:19:38.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Daripada itu, kau baik-baik saja?
Dialogue: 0,0:19:38.21,0:19:41.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku? Sangat baik!
Dialogue: 0,0:19:41.05,0:19:42.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ha?
Dialogue: 0,0:19:44.01,0:19:45.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa benar?
Dialogue: 0,0:19:47.14,0:19:48.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Menurutmu begitu?
Dialogue: 0,0:19:48.89,0:19:51.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya! Aku baik-baik saja.
Dialogue: 0,0:19:51.56,0:19:52.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Suaramu besar sekali.
Dialogue: 0,0:19:52.64,0:19:56.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sepertinya hujannya sudah reda.\N‎Aku akan pulang sekarang.
Dialogue: 0,0:19:56.73,0:19:58.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Hujannya masih deras.
Dialogue: 0,0:19:58.90,0:20:00.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Senang melihatmu.
Dialogue: 0,0:20:25.34,0:20:27.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak bisa menutup mulut hari ini.{\i0}
Dialogue: 0,0:20:28.43,0:20:29.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku mengatakan hal tak perlu.{\i0}
Dialogue: 0,0:20:31.23,0:20:34.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tragis sekali.{\i0}
Dialogue: 0,0:20:37.02,0:20:40.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Atau dialah yang membuatku sadar.{\i0}
Dialogue: 0,0:20:41.19,0:20:45.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Punya sesuatu yang membuatmu\N‎tersenyum seperti itu,{\i0}
Dialogue: 0,0:20:46.07,0:20:47.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎tapi menganggapnya "tak sengaja"{\i0}
Dialogue: 0,0:20:47.87,0:20:49.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎tanpa menyadari kekaguman di baliknya…{\i0}
Dialogue: 0,0:20:50.45,0:20:52.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tragis sekali.{\i0}
Dialogue: 0,0:20:56.92,0:21:02.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Saat kau mendambakan seseorang,\N‎itu bisa jadi kekuatanmu untuk terus maju.{\i0}
Dialogue: 0,0:21:03.92,0:21:05.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Begitulah yang terjadi padaku,{\i0}
Dialogue: 0,0:21:05.80,0:21:11.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎jadi aku ingin membantu Tayama-san\N‎menyadarinya juga.{\i0}
Dialogue: 0,0:21:13.56,0:21:16.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku seharusnya tak ikut campur.{\i0}
Dialogue: 0,0:21:17.19,0:21:20.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sifat terburuk dari menjadi tua\N‎mulai muncul.{\i0}
Dialogue: 0,0:21:32.74,0:21:35.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia bilang itu karena aku mengaguminya.{\i0}
Dialogue: 0,0:21:35.87,0:21:39.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bisa-bisanya Lamban-saki bilang begitu.{\i0}
Dialogue: 0,0:21:47.01,0:21:50.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎"Kau pasti sangat mengagumi\N‎orang ini," dia bilang.{\i0}
Dialogue: 0,0:22:07.53,0:22:08.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Syukurlah.{\i0}
Dialogue: 0,0:22:09.91,0:22:13.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku senang aku tak bilang\N‎dia mengingatkanku padanya.{\i0}
Dialogue: 0,0:23:34.91,0:23:39.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terjemahan subtitle oleh Rahayu Kinasih
