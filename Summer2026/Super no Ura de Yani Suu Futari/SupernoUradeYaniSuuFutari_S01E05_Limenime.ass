Dialogue: 0,0:00:12.05,0:00:13.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aspal membara.
Dialogue: 0,0:00:13.68,0:00:14.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Keringat bercucuran.
Dialogue: 0,0:00:15.47,0:00:17.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Matahari menyita energi.
Dialogue: 0,0:00:18.05,0:00:20.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tahu seperti apa rasanya. Aku tahu.
Dialogue: 0,0:00:20.22,0:00:21.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Karena aku juga bekerja di penjualan.
Dialogue: 0,0:00:22.68,0:00:23.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan maafkan aku.
Dialogue: 0,0:00:24.44,0:00:26.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku mengerti bahwa empati
Dialogue: 0,0:00:26.60,0:00:29.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎dari orang yang berada\N‎di ruang merokok yang ber-AC
Dialogue: 0,0:00:29.11,0:00:32.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎pasti terdengar hipokrit.
Dialogue: 0,0:00:38.24,0:00:40.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia bilang, berpura-pura…
Dialogue: 0,0:00:44.41,0:00:47.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa AC-nya harus rusak? Sialan!
Dialogue: 0,0:00:47.21,0:00:49.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini pasti ulah si bos.
Dialogue: 0,0:00:49.00,0:00:52.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku yakin dia menjejalkan\N‎barang-barangnya ke sana.
Dialogue: 0,0:00:52.34,0:00:55.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Dia yang membuat gelombang panas!\N‎- Dia tak sebebas itu.
Dialogue: 0,0:00:55.26,0:00:57.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Sampai jumpa kesejukan!\N‎- Jangan berlebihan.
Dialogue: 0,0:00:57.47,0:00:59.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Tak dingin!\N‎- Itu hanya memperburuknya.
Dialogue: 0,0:00:59.43,0:01:01.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Di sini tak dingin.\N‎- Begitulah.
Dialogue: 0,0:01:01.26,0:01:04.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Tak dingin! Panas!\N‎- {\i1}‎Reparasi besok. Pekan depan.{\i0}
Dialogue: 0,0:01:04.10,0:01:06.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Mengesalkan!\N{\i1}‎- Begini selama musim panas.{\i0}
Dialogue: 0,0:01:09.44,0:01:12.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Berita bagus, Suzuki.\N‎AC akan diperbaiki besok.
Dialogue: 0,0:01:12.40,0:01:14.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Bagaimana kau tahu?
Dialogue: 0,0:01:14.44,0:01:16.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu mantraku.
Dialogue: 0,0:01:16.28,0:01:18.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku selalu begitu.\N‎Itu benar-benar terjadi.
Dialogue: 0,0:01:20.74,0:01:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Wow! Aku sangat senang!
Dialogue: 0,0:01:23.20,0:01:25.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jika tak diperbaiki besok, kau mati!
Dialogue: 0,0:01:25.91,0:01:27.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayolah.
Dialogue: 0,0:01:27.79,0:01:30.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Percayalah dan kita lihat\N‎apa yang akan terjadi.
Dialogue: 0,0:01:30.34,0:01:32.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Besok pasti akan sejuk.
Dialogue: 0,0:01:36.26,0:01:38.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Halo…
Dialogue: 0,0:01:41.60,0:01:42.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf.
Dialogue: 0,0:01:42.72,0:01:46.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kurir kami menumpahkan susu,\N‎jadi aku bermain-main dengan selang.
Dialogue: 0,0:01:48.31,0:01:50.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bermain dengan selang memang seru.
Dialogue: 0,0:03:32.79,0:03:35.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Agak tegang di sini.{\i0}
Dialogue: 0,0:03:35.96,0:03:38.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih telah meminjamkanku\N‎celana dan handuk.
Dialogue: 0,0:03:39.38,0:03:41.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku harus bertanggung jawab.
Dialogue: 0,0:03:41.63,0:03:42.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak, kau…
Dialogue: 0,0:03:45.76,0:03:48.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tak harus canggung\N‎di dekatku, Sasaki-kun.
Dialogue: 0,0:03:49.35,0:03:51.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kita seumuran.
Dialogue: 0,0:03:52.64,0:03:54.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kita seumuran?
Dialogue: 0,0:03:54.65,0:03:57.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau sepertinya berusia 40-an.
Dialogue: 0,0:03:57.48,0:04:00.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku 40 tahun. Jadi, kau bisa santai.
Dialogue: 0,0:04:00.53,0:04:05.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Manajer toko di depan stasiun yang sibuk\N‎seumuran denganku?
Dialogue: 0,0:04:05.45,0:04:07.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku menghormatimu.
Dialogue: 0,0:04:07.12,0:04:09.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Baru kubilang untuk jangan canggung.{\i0}
Dialogue: 0,0:04:10.54,0:04:14.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sasaki-kun. Kau sepertinya tipe orang\N‎yang tersentuh dengan usia orang.
Dialogue: 0,0:04:18.46,0:04:21.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagaimana reaksimu\N‎saat kau tahu usia Tayama-san?
Dialogue: 0,0:04:23.05,0:04:24.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Usia Tayama-san?
Dialogue: 0,0:04:28.72,0:04:29.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:04:30.56,0:04:32.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak pernah bertanya.
Dialogue: 0,0:04:34.44,0:04:36.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Walaupun kalian selalu merokok\N‎di sini bersama?
Dialogue: 0,0:04:36.98,0:04:38.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya…
Dialogue: 0,0:04:38.77,0:04:41.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tak bertanya tentangnya sama sekali?
Dialogue: 0,0:04:41.11,0:04:42.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak.
Dialogue: 0,0:04:42.32,0:04:44.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tak peduli pada orang lain?
Dialogue: 0,0:04:47.12,0:04:49.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukannya aku tak peduli…
Dialogue: 0,0:04:54.16,0:04:56.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kadang dia agak jahil,{\i0}
Dialogue: 0,0:04:56.96,0:05:00.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎tapi dia mau mendengarkan\N‎ocehan pria tua sepertiku.{\i0}
Dialogue: 0,0:05:00.84,0:05:03.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tentu saja, aku ingin tahu tentangnya.{\i0}
Dialogue: 0,0:05:06.47,0:05:11.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi aku hanya senang bicara\N‎tentang apa pun yang ingin dia bicarakan.
Dialogue: 0,0:05:20.98,0:05:25.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku merenungkan tentangnya\N‎dalam perjalanan pulang ke rumah.
Dialogue: 0,0:05:27.16,0:05:29.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Pantas saja dia menyukaimu.{\i0}
Dialogue: 0,0:05:31.03,0:05:32.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Begitu.
Dialogue: 0,0:05:33.08,0:05:35.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dengan kata lain, kau sangat mencintainya.
Dialogue: 0,0:05:35.91,0:05:38.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Bukankah itu terlalu jauh?
Dialogue: 0,0:05:38.46,0:05:39.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, kau benci dia?
Dialogue: 0,0:05:39.71,0:05:40.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tentu saja tidak!
Dialogue: 0,0:05:41.50,0:05:43.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau begitu, yang mana?
Dialogue: 0,0:05:43.25,0:05:45.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tentu saja aku su…
Dialogue: 0,0:05:45.13,0:05:47.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini aku. Baru selesai belanja.
Dialogue: 0,0:06:00.65,0:06:01.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf, Sasaki-kun.
Dialogue: 0,0:06:02.40,0:06:04.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku harus mengurus keluhan.
Dialogue: 0,0:06:05.49,0:06:07.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan berikan uang untuk penatu nanti.
Dialogue: 0,0:06:07.61,0:06:09.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mengobrollah dengan Tayama.
Dialogue: 0,0:06:10.70,0:06:11.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baik.
Dialogue: 0,0:06:11.78,0:06:13.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dah.
Dialogue: 0,0:06:19.17,0:06:21.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau basah kuyup, Sasaki-san.
Dialogue: 0,0:06:23.00,0:06:25.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, ada kecelakaan.
Dialogue: 0,0:06:37.93,0:06:39.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Omong-omong, Tayama-san,
Dialogue: 0,0:06:40.44,0:06:42.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎kau dengar kami tadi?
Dialogue: 0,0:06:43.06,0:06:44.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dengar apa?
Dialogue: 0,0:06:46.15,0:06:49.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukan hal penting.
Dialogue: 0,0:06:49.11,0:06:51.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kami sedang mengobrol, dan…
Dialogue: 0,0:06:54.87,0:06:56.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-san?
Dialogue: 0,0:06:56.08,0:06:58.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau juga harus keringkan rambutmu.
Dialogue: 0,0:06:58.45,0:07:01.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi rambutku tak basah…
Dialogue: 0,0:07:02.83,0:07:04.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dua puluh empat.
Dialogue: 0,0:07:08.76,0:07:12.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dua puluh empat apa?
Dialogue: 0,0:07:14.01,0:07:18.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau bisa renungkan itu\N‎dalam perjalanan pulang.
Dialogue: 0,0:07:31.99,0:07:33.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:07:35.12,0:07:36.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tentu saja. Ya.
Dialogue: 0,0:07:37.12,0:07:38.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akan kukirimkan malam ini.
Dialogue: 0,0:07:40.62,0:07:43.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya. Maaf soal itu.
Dialogue: 0,0:07:43.54,0:07:44.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Semoga ini tidak…
Dialogue: 0,0:07:49.63,0:07:53.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia seharusnya menyerahkan pekerjaannya\N‎sebelum pergi.{\i0}
Dialogue: 0,0:07:54.34,0:07:56.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah, Tim. Kuserahkan pada kalian!
Dialogue: 0,0:07:56.51,0:07:58.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia menelantarkan kita.
Dialogue: 0,0:07:58.64,0:08:00.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia malah ke luar negeri.
Dialogue: 0,0:08:00.81,0:08:04.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sasaki-san! Maaf!\N‎Aku lupa mengirim penawaran harga!
Dialogue: 0,0:08:04.94,0:08:07.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baik. Pertama, kita harus telepon klien.
Dialogue: 0,0:08:07.90,0:08:09.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sasaki-san! Maafkan aku!
Dialogue: 0,0:08:09.40,0:08:12.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Karyawan baru itu, Ito-kun?\N‎Dia tak datang hari ini.
Dialogue: 0,0:08:12.15,0:08:13.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kita harus bagaimana?
Dialogue: 0,0:08:13.36,0:08:16.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Bukankah dia menyimpan\N‎semua dokumennya?
Dialogue: 0,0:08:16.07,0:08:19.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, dan dia membawanya pulang…
Dialogue: 0,0:08:21.25,0:08:25.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah. Aku akan ke rumahnya.\N‎Bisa kirimkan alamatnya?
Dialogue: 0,0:08:25.79,0:08:26.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akan kukirimkan.
Dialogue: 0,0:08:51.57,0:08:52.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Uh-oh!
Dialogue: 0,0:08:56.07,0:08:58.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Aku pulang duluan.\N‎- Ya.
Dialogue: 0,0:09:00.16,0:09:01.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Terima kasih telah menunggu.{\i0}
Dialogue: 0,0:09:01.41,0:09:05.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kereta terakhir menuju Shimaida\N‎berangkat dari platform dua.{\i0}
Dialogue: 0,0:09:15.47,0:09:17.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sial…{\i0}
Dialogue: 0,0:09:42.24,0:09:43.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:09:50.54,0:09:51.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sial…
Dialogue: 0,0:09:56.01,0:10:01.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Hari ini aku harus buat formulir pesanan,\N‎menyapa penyuplai baru, lalu…{\i0}
Dialogue: 0,0:10:01.39,0:10:03.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf, Sasaki-san.
Dialogue: 0,0:10:03.64,0:10:07.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku baru dengar kabar\N‎keluargaku sakit dan masuk rumah sakit.
Dialogue: 0,0:10:08.19,0:10:10.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan khawatir. Pergilah.
Dialogue: 0,0:10:10.06,0:10:12.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akan kuurus pekerjaanmu.
Dialogue: 0,0:10:12.52,0:10:14.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih banyak!
Dialogue: 0,0:10:14.94,0:10:17.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Halo? Ya, aku ke sana sekarang.
Dialogue: 0,0:10:17.53,0:10:18.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:10:23.16,0:10:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf soal ini. Terima kasih banyak.
Dialogue: 0,0:10:25.87,0:10:27.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf, Sasaki-san.
Dialogue: 0,0:10:27.29,0:10:30.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Si karyawan baru, Ito-ku?\N‎Dia tak datang lagi hari ini.
Dialogue: 0,0:10:30.33,0:10:31.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kita harus bagaimana?
Dialogue: 0,0:10:32.79,0:10:34.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sasaki-san?
Dialogue: 0,0:10:54.77,0:10:56.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sasaki!
Dialogue: 0,0:10:56.78,0:10:59.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sudah tak tahan lagi…
Dialogue: 0,0:10:59.95,0:11:02.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau hebat, Kawan. Sungguh.
Dialogue: 0,0:11:02.53,0:11:03.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kita pasti bisa.
Dialogue: 0,0:11:03.91,0:11:05.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baik.
Dialogue: 0,0:11:34.90,0:11:37.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Halo, Semuanya! Aku kembali!
Dialogue: 0,0:11:37.07,0:11:40.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Seseorang tolong sortir\N‎oleh-oleh ini untuk klien kita.
Dialogue: 0,0:11:42.49,0:11:45.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa ini? Bermalas-malasan karena hujan?
Dialogue: 0,0:11:54.08,0:11:55.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sudah berakhir.{\i0}
Dialogue: 0,0:11:55.84,0:11:57.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Empat belas hari berurutan\N‎kerja mati-matian.{\i0}
Dialogue: 0,0:11:58.88,0:12:00.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Entah bagaimana kami berhasil.{\i0}
Dialogue: 0,0:12:01.72,0:12:04.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa yang kami lakukan sampai alami ini?{\i0}
Dialogue: 0,0:12:10.64,0:12:13.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sial, hujan ini menyedihkan.{\i0}
Dialogue: 0,0:12:19.57,0:12:22.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei. Di sana kau. Kerja bagus.
Dialogue: 0,0:12:24.28,0:12:26.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-san. Sudah lama tak bertemu.
Dialogue: 0,0:12:26.70,0:12:30.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tak terlalu lelah, 'kan?\N‎Aku punya pekerjaan untukmu.
Dialogue: 0,0:12:33.21,0:12:34.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dengan senang hati.
Dialogue: 0,0:12:39.17,0:12:40.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Wow, {\i1}‎teru teru bouzu{\i0}‎.
Dialogue: 0,0:12:41.21,0:12:42.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mengingatkanku pada masa lalu.
Dialogue: 0,0:12:43.76,0:12:46.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Manajer suka memajang ini\N‎setiap tahun saat musim hujan.
Dialogue: 0,0:12:47.22,0:12:50.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia membiarkan anak-anak\N‎menggambarnya dan memainkannya
Dialogue: 0,0:12:50.10,0:12:51.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎dan dia melibatkan kami juga.
Dialogue: 0,0:12:51.97,0:12:52.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya?
Dialogue: 0,0:12:53.56,0:12:56.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kubilang aku akan bantu, tapi…
Dialogue: 0,0:12:59.98,0:13:01.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tahu ini jelek.
Dialogue: 0,0:13:01.98,0:13:03.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak…
Dialogue: 0,0:13:03.07,0:13:05.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lihat ini dan katakan.
Dialogue: 0,0:13:05.99,0:13:09.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Semua seni adalah bentuk ekspresi diri!
Dialogue: 0,0:13:12.04,0:13:15.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, aku ingin kau melakukannya juga.
Dialogue: 0,0:13:18.96,0:13:20.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau mau aku gambar wajah?
Dialogue: 0,0:13:20.67,0:13:21.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tak bisa?
Dialogue: 0,0:13:22.51,0:13:23.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yah…
Dialogue: 0,0:13:24.72,0:13:27.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku sering mencoret-coret\N‎agar tetap terbangun saat rapat,{\i0}
Dialogue: 0,0:13:27.84,0:13:30.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎tapi itu tak bisa dibilang gambar.{\i0}
Dialogue: 0,0:13:34.02,0:13:35.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini dia.
Dialogue: 0,0:13:39.86,0:13:41.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa kau menggambar manajer?
Dialogue: 0,0:13:41.98,0:13:43.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan itu sangat mirip dengannya.
Dialogue: 0,0:13:46.15,0:13:47.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu sangat lucu.
Dialogue: 0,0:13:49.37,0:13:51.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku menggambar manajer, jadi…
Dialogue: 0,0:13:55.12,0:13:56.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini kau.
Dialogue: 0,0:13:58.71,0:14:00.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Wow, dia imut.
Dialogue: 0,0:14:00.17,0:14:02.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau mudah digambar.
Dialogue: 0,0:14:05.63,0:14:07.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Karena kau selalu melihatku, 'kan?
Dialogue: 0,0:14:10.93,0:14:12.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku juga akan menggambarmu.
Dialogue: 0,0:14:25.61,0:14:26.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Manis sekali.
Dialogue: 0,0:14:27.70,0:14:28.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini?
Dialogue: 0,0:14:29.20,0:14:30.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Rokoknya.
Dialogue: 0,0:14:32.53,0:14:35.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sebenarnya suka hari hujan.
Dialogue: 0,0:14:36.25,0:14:38.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Melihat asap rokok membumbung di udara…
Dialogue: 0,0:14:39.04,0:14:42.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Entah bagaimana hujan\N‎membuat rasanya lebih enak.
Dialogue: 0,0:14:43.13,0:14:48.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi aku sangat sibuk akhir-akhir ini\N‎aku hampir lupa.
Dialogue: 0,0:14:50.05,0:14:52.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Merokok di sini membuatku merasa…
Dialogue: 0,0:14:53.43,0:14:54.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Merasa…
Dialogue: 0,0:15:00.02,0:15:01.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:15:01.69,0:15:03.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kerja bagus, Sasaki-san.
Dialogue: 0,0:15:31.01,0:15:32.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Menyebalkan.{\i0}
Dialogue: 0,0:15:32.72,0:15:34.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku lupa mematikan alarm.{\i0}
Dialogue: 0,0:15:34.47,0:15:37.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dan aku kelelahan\N‎sampai tertidur di depan Tayama-san.{\i0}
Dialogue: 0,0:15:37.51,0:15:39.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku harus libur hari ini…{\i0}
Dialogue: 0,0:15:41.60,0:15:42.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Apa ini?
Dialogue: 0,0:15:43.44,0:15:45.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jangan bilang…{\i0}
Dialogue: 0,0:15:45.06,0:15:46.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-san?
Dialogue: 0,0:15:50.53,0:15:53.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-san. Ini dari minyak.
Dialogue: 0,0:17:09.19,0:17:10.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Waktunya makan…\N‎- Kau.
Dialogue: 0,0:17:11.19,0:17:14.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Katamu kau mengurangi ramen.
Dialogue: 0,0:17:14.74,0:17:18.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan bekerja mati-matian untuk\N‎membakar yang kumakan. Jangan cemas.
Dialogue: 0,0:17:18.66,0:17:19.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benarkah?
Dialogue: 0,0:17:20.24,0:17:23.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf menyela "bekerja mati-matian"-mu,
Dialogue: 0,0:17:23.58,0:17:25.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tapi kau pulang cepat hari ini.
Dialogue: 0,0:17:25.33,0:17:27.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benarkah?
Dialogue: 0,0:17:27.04,0:17:30.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau seharusnya bilang\N‎sebelum aku istirahat makan.
Dialogue: 0,0:17:31.25,0:17:32.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mau bagaimana lagi?
Dialogue: 0,0:17:32.96,0:17:36.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hari ini sepi. Harus tekan\N‎biaya tenaga kerja.
Dialogue: 0,0:17:36.01,0:17:39.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan kau yang paling fleksibel\N‎soal ganti giliran.
Dialogue: 0,0:17:41.31,0:17:45.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Atau kau mau bantu aku\N‎periksa tanggal kedaluwarsa makanan beku?
Dialogue: 0,0:17:45.31,0:17:46.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku lebih suka pulang.
Dialogue: 0,0:17:53.36,0:17:57.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jika dia bilang sebelum istirahat,\N‎aku bisa makan ramen di restoran.{\i0}
Dialogue: 0,0:17:57.99,0:17:59.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku malas pakai riasan.{\i0}
Dialogue: 0,0:17:59.57,0:18:02.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku akan beli alkohol, merokok di luar,\N‎lalu pulang dan tidur.{\i0}
Dialogue: 0,0:18:03.45,0:18:04.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Maaf, Sasaki-san.{\i0}
Dialogue: 0,0:18:05.37,0:18:08.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tak ada Yamada-san untukmu hari ini.{\i0}
Dialogue: 0,0:18:10.75,0:18:11.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Itu dia.{\i0}
Dialogue: 0,0:18:13.13,0:18:15.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia pulang pada jam normal hari ini.{\i0}
Dialogue: 0,0:18:15.42,0:18:18.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Mungkin akan kukagetkan dia\N‎dari belakang, selagi aku di sini?{\i0}
Dialogue: 0,0:18:18.43,0:18:19.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Yo.{\i0}
Dialogue: 0,0:18:21.72,0:18:24.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tidak, itu terlalu membosankan…{\i0}
Dialogue: 0,0:18:27.64,0:18:28.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sasaki-san?
Dialogue: 0,0:18:30.35,0:18:31.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Halo!
Dialogue: 0,0:18:32.31,0:18:33.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sasaki-san! Keranjangmu?
Dialogue: 0,0:18:36.36,0:18:38.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf! Ya, halo!
Dialogue: 0,0:18:38.78,0:18:40.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau baik-baik saja?
Dialogue: 0,0:18:41.99,0:18:44.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, aku baik-baik saja.
Dialogue: 0,0:18:44.08,0:18:46.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sedang melamun\N‎dan ini terlepas dari tanganku.
Dialogue: 0,0:18:48.91,0:18:50.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Baju kasual?{\i0}
Dialogue: 0,0:18:50.25,0:18:53.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Haruskah kupandangi Yamada-san\N‎saat dia tak berseragam?{\i0}
Dialogue: 0,0:18:53.79,0:18:56.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tentu saja tidak. Berhenti menatapnya!{\i0}
Dialogue: 0,0:18:56.21,0:18:57.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bersikap biasa saja.{\i0}
Dialogue: 0,0:18:57.30,0:18:59.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Semua orang pakai baju kasual. Bahkan aku.{\i0}
Dialogue: 0,0:19:00.30,0:19:01.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sasaki-san?
Dialogue: 0,0:19:02.51,0:19:04.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Ini. Kau menjatuhkan ini.
Dialogue: 0,0:19:11.31,0:19:12.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih banyak.
Dialogue: 0,0:19:13.40,0:19:16.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jugemu Jugemu Goko-no Surikire…{\i0}
Dialogue: 0,0:19:16.69,0:19:19.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau sedang memutuskan\N‎untuk beli camilan apa?
Dialogue: 0,0:19:20.32,0:19:22.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya. Yang cocok dengan alkohol.
Dialogue: 0,0:19:22.66,0:19:24.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mungkin aku harus beli sesuatu juga.
Dialogue: 0,0:19:26.74,0:19:28.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kukis ini enak.
Dialogue: 0,0:19:29.33,0:19:30.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Menurutmu begitu?
Dialogue: 0,0:19:31.92,0:19:33.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan ini baru.
Dialogue: 0,0:19:34.04,0:19:37.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi jika aku beli yang manis,\N‎aku harus beli yang asin juga.
Dialogue: 0,0:19:40.84,0:19:41.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yamada-san.
Dialogue: 0,0:19:44.18,0:19:46.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau lihat tiga rokok berjejer di sini?
Dialogue: 0,0:19:47.64,0:19:50.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bisa tentukan dalam hati\N‎camilan mana untuk masing-masing rokok?
Dialogue: 0,0:19:52.39,0:19:53.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tentu.
Dialogue: 0,0:19:54.86,0:19:55.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sudah.
Dialogue: 0,0:19:55.94,0:19:57.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih.
Dialogue: 0,0:20:00.11,0:20:01.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yang ini.
Dialogue: 0,0:20:01.90,0:20:04.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau harus ambil camilan\N‎yang kau tentukan pada rokok yang keluar.
Dialogue: 0,0:20:07.49,0:20:10.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf. Aku memaksamu begitu.
Dialogue: 0,0:20:10.20,0:20:12.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Ini sama sekali bukan…\N‎- Akan kuambil.
Dialogue: 0,0:20:16.75,0:20:19.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau sering pakai metode ini\N‎untuk memilih sesuatu?
Dialogue: 0,0:20:20.92,0:20:22.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kurasa ya.
Dialogue: 0,0:20:22.59,0:20:25.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini mantraku.
Dialogue: 0,0:20:26.35,0:20:29.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jika yang pertama keluar,\N‎aku bisa pulang cepat.
Dialogue: 0,0:20:29.26,0:20:31.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jika yang kedua keluar,\N‎aku bisa libur minggu itu.
Dialogue: 0,0:20:32.68,0:20:35.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jika yang ketiga keluar,\N‎aku bisa melihatnya di…
Dialogue: 0,0:20:39.19,0:20:40.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf. Bukan apa-apa.
Dialogue: 0,0:20:40.94,0:20:42.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku senang kau pilih camilannya.
Dialogue: 0,0:20:43.61,0:20:44.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku permisi.
Dialogue: 0,0:20:45.53,0:20:47.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hati-hati di jalan.
Dialogue: 0,0:20:47.95,0:20:49.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya. Kau juga.
Dialogue: 0,0:21:01.59,0:21:05.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎"Jika yang ketiga keluar,\N‎aku bisa melihat Yamada-san di kasir."{\i0}
Dialogue: 0,0:21:06.30,0:21:08.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tahu kau akan bilang begitu\N‎walau ucapanmu terhenti.{\i0}
Dialogue: 0,0:21:08.97,0:21:10.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sangat berkelas, tapi ceroboh.{\i0}
Dialogue: 0,0:21:17.94,0:21:19.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jika yang ketiga keluar, dia sadar.{\i0}
Dialogue: 0,0:21:20.48,0:21:22.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jika yang kedua keluar, dia tak sadar.{\i0}
Dialogue: 0,0:21:23.53,0:21:25.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jika yang pertama keluar…{\i0}
Dialogue: 0,0:21:37.17,0:21:41.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Berarti sesuatu yang buruk\N‎akan terjadi pada Sasaki-san.
Dialogue: 0,0:21:48.55,0:21:50.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Tamatlah riwayatku!{\i0}
Dialogue: 0,0:21:50.39,0:21:52.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Aku terlena oleh Yamada-san\N‎pakai baju kasual{\i0}
Dialogue: 0,0:21:52.64,0:21:57.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎aku pulang tanpa membayar majalah\N‎di balik lenganku!{\i0}
Dialogue: 0,0:21:59.06,0:22:00.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pak.
Dialogue: 0,0:22:00.56,0:22:03.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Di sini tak boleh ada pengutil.
Dialogue: 0,0:22:03.40,0:22:05.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf. Aku tak sengaja.
Dialogue: 0,0:22:05.78,0:22:08.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Semua orang bilang begitu, Sasaki-kun.
Dialogue: 0,0:22:11.53,0:22:15.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aku benar-benar minta maaf!
Dialogue: 0,0:23:34.83,0:23:39.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terjemahan subtitle oleh Rahayu Kinasih
