Dialogue: 0,0:00:51.17,0:00:52.25,sign,,0000,0000,0000,,‎MENYERUPUT\N‎MENGUNYAH
Dialogue: 0,0:02:40.03,0:02:42.24,sign,,0000,0000,0000,,‎DESEMBER 28 - SELESAI\N‎HARI KERJA TERAKHIR SEBELUM LIBURAN
Dialogue: 0,0:03:31.96,0:03:34.96,sign,,0000,0000,0000,,‎AKHIR TAHUN
Dialogue: 0,0:03:34.96,0:03:38.38,sign,,0000,0000,0000,,‎DISKON SPESIAL TERIMA KASIH
Dialogue: 0,0:03:44.97,0:03:46.09,sign,,0000,0000,0000,,{\an8}‎YABASU - ALKOHOL
Dialogue: 0,0:03:53.73,0:03:54.81,sign,,0000,0000,0000,,{\an8}‎KERUPUK BERAS LEZAT
Dialogue: 0,0:04:00.24,0:04:02.65,sign,,0000,0000,0000,,{\an8}‎LEMON SODA - ALKOHOL
Dialogue: 0,0:04:38.40,0:04:40.90,sign,,0000,0000,0000,,{\an8}‎JAM KERJA SELAMA TAHUN BARU\N‎TUTUP 31 DES - 4 JAN
Dialogue: 0,0:06:36.81,0:06:38.18,sign,,0000,0000,0000,,‎MINUMAN OLAHRAGA\N‎OBAT BATUK
Dialogue: 0,0:07:11.84,0:07:13.84,sign,,0000,0000,0000,,‎MANAJER - TELEPON\N‎INGATKAN AKU - PESAN
Dialogue: 0,0:07:59.89,0:08:00.97,sign,,0000,0000,0000,,‎YAMA - PANGGILAN SEDANG BERLANGSUNG
Dialogue: 0,0:12:32.46,0:12:33.46,sign,,0000,0000,0000,,‎MENGUNYAH
Dialogue: 0,0:13:13.75,0:13:15.58,sign,,0000,0000,0000,,‎MANAJER MENDAPAT ASUPAN CERITA CINTA
Dialogue: 0,0:13:44.36,0:13:46.69,sign,,0000,0000,0000,,‎PASAR SUPER SEGAR
Dialogue: 0,0:14:36.00,0:14:38.87,sign,,0000,0000,0000,,‎JAM BUKA AKHIR TAHUN
Dialogue: 0,0:14:38.87,0:14:40.79,sign,,0000,0000,0000,,{\an8}‎12/31 & 1/3 PENGURANGAN JAM BUKA\N‎1/1 & 1/2 TUTUP
Dialogue: 0,0:14:40.79,0:14:41.79,sign,,0000,0000,0000,,{\an8}‎1/4 JAM BUKA BIASA
Dialogue: 0,0:15:24.75,0:15:26.04,sign,,0000,0000,0000,,‎SELAMAT TAHUN BARU
Dialogue: 0,0:15:32.43,0:15:34.85,sign,,0000,0000,0000,,{\an8}‎YAMADA
Dialogue: 0,0:15:37.31,0:15:38.39,sign,,0000,0000,0000,,{\an8}‎APA?
Dialogue: 0,0:16:36.45,0:16:39.37,sign,,0000,0000,0000,,{\an8}‎NASIB - SIAL
Dialogue: 0,0:18:03.12,0:18:05.58,sign,,0000,0000,0000,,{\an8}‎BUKA 24 JAM - SUPER S
Dialogue: 0,0:19:10.81,0:19:11.90,sign,,0000,0000,0000,,‎TAK PERNAH DENGAR YANG KUKATAKAN
Dialogue: 0,0:21:23.57,0:21:24.78,sign,,0000,0000,0000,,‎KOMPRES PANAS
Dialogue: 0,0:00:05.75,0:00:08.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Wah, tahun ini berlalu dengan cepat.
Dialogue: 0,0:00:08.75,0:00:09.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benar.
Dialogue: 0,0:00:09.88,0:00:14.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Obata-kun. Aku suka dengan kreasimu\N‎pada bagian makanan segar di Tahun Baru.
Dialogue: 0,0:00:16.64,0:00:17.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benarkah?
Dialogue: 0,0:00:17.72,0:00:20.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku senang\N‎aku mengerjakannya sepanjang malam.
Dialogue: 0,0:00:22.52,0:00:28.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Wortel kintoki dan lobak zoni kita\N‎bagus dan besar, 'kan?
Dialogue: 0,0:00:28.23,0:00:29.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu sangat membantu.
Dialogue: 0,0:00:29.40,0:00:31.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau terlalu memujiku.
Dialogue: 0,0:00:35.03,0:00:37.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yamada-chan. Apa kabar?
Dialogue: 0,0:00:37.53,0:00:39.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hai, Yamada.
Dialogue: 0,0:00:40.04,0:00:41.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei.
Dialogue: 0,0:00:42.83,0:00:45.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mana makan malammu, Yamada-chan?
Dialogue: 0,0:00:45.71,0:00:47.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hari ini aku tak makan.
Dialogue: 0,0:00:47.75,0:00:49.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak terlalu lapar.
Dialogue: 0,0:00:50.09,0:00:51.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oh?
Dialogue: 0,0:00:52.26,0:00:53.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Yamada? Tak makan?{\i0}
Dialogue: 0,0:00:54.63,0:00:56.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Mungkin dia sedang diet?{\i0}
Dialogue: 0,0:01:02.81,0:01:04.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Yamada-chan!\N‎- Yamada!
Dialogue: 0,0:02:42.24,0:02:44.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jreng! Hore, tahun ini berakhir.
Dialogue: 0,0:02:44.03,0:02:45.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ritsleting.
Dialogue: 0,0:02:45.79,0:02:50.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Syukurlah Bos kena flu dan bikin heboh\N‎sehingga aku bisa pulang.
Dialogue: 0,0:02:50.37,0:02:52.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Rasanya senang\N‎menyelesaikan kerja tahun ini, 'kan?
Dialogue: 0,0:02:52.79,0:02:56.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Semua tempat tutup,\N‎jadi kita tak akan dapat pesan teks lagi.
Dialogue: 0,0:02:56.55,0:02:59.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, tak usah merasa bersalah\N‎karena tak bekerja.
Dialogue: 0,0:02:59.92,0:03:02.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku memang tak pernah merasa bersalah\N‎karena tak bekerja!{\i0}
Dialogue: 0,0:03:02.68,0:03:04.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benar.
Dialogue: 0,0:03:04.30,0:03:07.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Walaupun aku ingin minum bersamamu,
Dialogue: 0,0:03:07.52,0:03:09.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku akan ke pemandian air panas\N‎bersama keluarga.
Dialogue: 0,0:03:10.31,0:03:12.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sampai tahun depan. {\i1}‎Adieu.{\i0}
Dialogue: 0,0:03:12.44,0:03:14.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sampai jumpa, Sasaki.
Dialogue: 0,0:03:14.19,0:03:15.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sampai tahun depan.
Dialogue: 0,0:03:18.03,0:03:19.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kurasa aku juga akan pulang.{\i0}
Dialogue: 0,0:03:21.45,0:03:24.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku akan menstok makanan untuk Tahun Baru\N‎dan bermalas-malasan sampai akhir tahun.{\i0}
Dialogue: 0,0:03:25.58,0:03:28.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Semoga aku bisa mengakhiri tahun\N‎bersama Yamada-san!{\i0}
Dialogue: 0,0:03:29.54,0:03:31.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selamat liburan!
Dialogue: 0,0:03:40.97,0:03:44.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sepertinya aku tak bisa\N‎mengantre di kasir dua.{\i0}
Dialogue: 0,0:03:46.10,0:03:47.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Ayolah, Sasaki.{\i0}
Dialogue: 0,0:03:48.72,0:03:52.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jangan mengantre hanya untuk melihatnya\N‎tersenyum saat dia sibuk bekerja.{\i0}
Dialogue: 0,0:03:54.81,0:03:59.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Aku juga tak bisa bilang padanya dialah\N‎yang menyemangatiku sepanjang tahun.{\i0}
Dialogue: 0,0:04:06.28,0:04:10.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak ingin jadi pelanggan\N‎yang mengganggu kelancaran toko.{\i0}
Dialogue: 0,0:04:10.16,0:04:12.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan ambil barang-barangnya.
Dialogue: 0,0:04:12.75,0:04:14.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Satu. Dua.
Dialogue: 0,0:04:14.75,0:04:18.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Terima kasih banyak!\N‎- Tiga. Empat.
Dialogue: 0,0:04:18.34,0:04:21.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kepala dan Obata-san di kasir.{\i0}
Dialogue: 0,0:04:21.51,0:04:24.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Mungkin Yamada-san libur?{\i0}
Dialogue: 0,0:04:25.22,0:04:29.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kalau begitu, aku akan ucapkan\N‎selamat tahun baru dari hati.{\i0}
Dialogue: 0,0:04:30.35,0:04:34.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Semoga aku bisa mengucapkannya\N‎langsung kepada Tayama-san.{\i0}
Dialogue: 0,0:04:35.40,0:04:38.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Diskon spesial akhir tahun.\N‎Ada yang paling segar…{\i0}
Dialogue: 0,0:04:40.90,0:04:42.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dingin sekali!
Dialogue: 0,0:04:42.15,0:04:43.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bahkan denganku di sini?
Dialogue: 0,0:04:43.57,0:04:45.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar bodoh!
Dialogue: 0,0:04:45.82,0:04:46.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mau makan di mana?
Dialogue: 0,0:04:47.57,0:04:51.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku sudah berkali-kali ke sini saat malam,\N‎tapi aku tak pernah melihatnya.{\i0}
Dialogue: 0,0:04:51.79,0:04:54.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sepertinya aku tak bisa\N‎mengucapkan tahun baru padanya.{\i0}
Dialogue: 0,0:04:55.08,0:04:59.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku yakin orang-orang mulai mencurigaiku…{\i0}
Dialogue: 0,0:04:59.17,0:05:01.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Kita harus pesta hot pot.\N‎- Ide bagus!
Dialogue: 0,0:05:01.00,0:05:04.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar bodoh!
Dialogue: 0,0:05:08.18,0:05:12.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak butuh kau! Aku bisa urus sendiri!
Dialogue: 0,0:05:12.81,0:05:14.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Manajer?{\i0}
Dialogue: 0,0:05:15.06,0:05:18.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, apa kau mendengarkanku…
Dialogue: 0,0:05:19.48,0:05:22.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bodoh…
Dialogue: 0,0:05:22.19,0:05:24.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia terlihat sangat marah.{\i0}
Dialogue: 0,0:05:29.32,0:05:30.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu kau, Sasaki-kun.
Dialogue: 0,0:05:32.16,0:05:33.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau sudah selesai kerja tahun ini?
Dialogue: 0,0:05:33.66,0:05:36.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, untungnya.
Dialogue: 0,0:05:43.84,0:05:47.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Omong-omong, Manajer.\N‎Aku sudah lama tak melihat Tayama-san.
Dialogue: 0,0:05:50.26,0:05:52.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia? Dia pingsan. Dia demam.
Dialogue: 0,0:05:54.52,0:05:55.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:05:57.02,0:05:58.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa dia…
Dialogue: 0,0:05:59.02,0:06:01.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa dia baik-baik saja?
Dialogue: 0,0:06:01.02,0:06:02.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa dia harus ke rumah sakit?
Dialogue: 0,0:06:02.98,0:06:05.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak, tidak.
Dialogue: 0,0:06:05.07,0:06:07.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku hanya menyuruhnya libur\N‎sampai tahun baru.
Dialogue: 0,0:06:10.66,0:06:13.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Setidaknya, aku berusaha…
Dialogue: 0,0:06:16.91,0:06:19.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sasaki-kun. Kau boleh merokok sekali.
Dialogue: 0,0:06:21.29,0:06:25.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi ada bayarannya.
Dialogue: 0,0:06:31.30,0:06:33.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bodoh sekali, Manajer.
Dialogue: 0,0:06:33.64,0:06:36.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sudah kubilang. Aku bisa memaksa diriku\N‎agar lebih baik besok.
Dialogue: 0,0:06:38.18,0:06:40.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia benar-benar memarahiku.
Dialogue: 0,0:06:40.94,0:06:42.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku bahkan tak bisa merokok.{\i0}
Dialogue: 0,0:06:43.98,0:06:45.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Payah sekali.{\i0}
Dialogue: 0,0:06:57.50,0:06:59.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku ingin ramen.{\i0}
Dialogue: 0,0:07:05.34,0:07:09.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku yakin dia menderita\N‎karena tak bisa bertemu Yamada.{\i0}
Dialogue: 0,0:07:13.85,0:07:16.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Beraninya kau menutup teleponku!
Dialogue: 0,0:07:16.47,0:07:18.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau sebaiknya istirahat!
Dialogue: 0,0:07:21.85,0:07:24.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku baik-baik saja!
Dialogue: 0,0:07:25.36,0:07:27.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, aku akan bekerja besok!
Dialogue: 0,0:07:29.28,0:07:31.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sasaki-san?{\i0}
Dialogue: 0,0:07:31.61,0:07:32.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa?{\i0}
Dialogue: 0,0:07:33.16,0:07:35.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Maaf tiba-tiba meneleponmu{\i0}
Dialogue: 0,0:07:35.45,0:07:38.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ini Sasaki. Kau baik-baik saja sekarang?{\i0}
Dialogue: 0,0:07:39.75,0:07:41.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia bicara pada siapa?{\i0}
Dialogue: 0,0:07:42.17,0:07:45.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Maaf, kau bisa dengar aku?{\i0}
Dialogue: 0,0:07:45.75,0:07:48.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia bermaksud menelepon siapa?{\i0}
Dialogue: 0,0:07:48.84,0:07:50.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia sangat sopan.{\i0}
Dialogue: 0,0:07:51.55,0:07:53.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Pasti untuk Yamada.{\i0}
Dialogue: 0,0:07:53.01,0:07:55.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Halo? Tayama-san?{\i0}
Dialogue: 0,0:08:00.98,0:08:02.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Hei.{\i0}
Dialogue: 0,0:08:02.48,0:08:03.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Syukurlah.
Dialogue: 0,0:08:04.48,0:08:06.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf meneleponmu saat kau sedang libur.
Dialogue: 0,0:08:07.23,0:08:08.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tak apa-apa.{\i0}
Dialogue: 0,0:08:08.57,0:08:10.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi apa yang terjadi?{\i0}
Dialogue: 0,0:08:10.99,0:08:15.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku ingin mengucapkan Selamat Tahun baru
Dialogue: 0,0:08:15.91,0:08:17.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎dan aku melihat Manajer.
Dialogue: 0,0:08:17.66,0:08:22.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Katanya kau tak datang saat Tahun Baru,\N‎jadi dia meminjamkan ponselnya.{\i0}
Dialogue: 0,0:08:23.50,0:08:25.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jika kau tak cukup sehat untuk bicara,\N‎akan kumatikan.{\i0}
Dialogue: 0,0:08:26.46,0:08:28.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hmm, jadi ini ulah Manajer.
Dialogue: 0,0:08:29.84,0:08:34.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku yakin dia berusaha meyakinkanku\N‎untuk tak datang bekerja besok.{\i0}
Dialogue: 0,0:08:35.80,0:08:40.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak sepertimu, Sasaki-san,\N‎aku bisa tahu itu.
Dialogue: 0,0:08:40.56,0:08:41.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Maaf.{\i0}
Dialogue: 0,0:08:43.43,0:08:44.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Manajer cerita semuanya.{\i0}
Dialogue: 0,0:08:46.06,0:08:49.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau memaksa dirimu saat sakit\N‎untuk menggantikan semua orang,
Dialogue: 0,0:08:49.73,0:08:51.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎lalu kau pingsan.
Dialogue: 0,0:08:51.32,0:08:53.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ya, tapi aku baik-baik saja sekarang.{\i0}
Dialogue: 0,0:08:53.61,0:08:55.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Demamnya bahkan tak parah.{\i0}
Dialogue: 0,0:08:55.36,0:08:57.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku bisa datang besok.{\i0}
Dialogue: 0,0:08:57.03,0:08:59.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Manajer hanya melebih-lebihkan.{\i0}
Dialogue: 0,0:09:01.58,0:09:03.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Maaf. Aku membuatmu batuk\N‎karena mengajakmu bicara.{\i0}
Dialogue: 0,0:09:04.21,0:09:06.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kubilang aku baik-baik saja.
Dialogue: 0,0:09:06.17,0:09:07.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kau sudah makan?{\i0}
Dialogue: 0,0:09:07.67,0:09:10.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Belum, tapi tubuhku bisa bergerak.
Dialogue: 0,0:09:10.63,0:09:11.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Baik.{\i0}
Dialogue: 0,0:09:11.71,0:09:14.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak bisa libur\N‎empat hari berturut-turut.
Dialogue: 0,0:09:14.34,0:09:18.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Besok hari tersibuk kami\N‎dan kami kekurangan staf.{\i0}
Dialogue: 0,0:09:18.14,0:09:19.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dan…{\i0}
Dialogue: 0,0:09:21.10,0:09:22.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kau khawatir, ya?{\i0}
Dialogue: 0,0:09:23.31,0:09:25.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Membuat Manajer bekerja\N‎padahal kau tahu dia batuk.{\i0}
Dialogue: 0,0:09:30.02,0:09:31.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Maaf.{\i0}
Dialogue: 0,0:09:31.48,0:09:35.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kudengar dia meneriakimu tadi.
Dialogue: 0,0:09:35.86,0:09:39.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kutebak dialah yang akan menggantikanmu?
Dialogue: 0,0:09:41.58,0:09:42.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Manajer…{\i0}
Dialogue: 0,0:09:43.24,0:09:47.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia berlarian di luar ke sana kemari\N‎sampai sakit
Dialogue: 0,0:09:47.54,0:09:49.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎gara-gara kesalahan pekerja paruh waktu.
Dialogue: 0,0:09:50.50,0:09:55.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi walaupun aku tahu\N‎aku tak boleh melakukan kesalahan{\i0}
Dialogue: 0,0:09:55.97,0:09:57.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎aku malah pingsan…{\i0}
Dialogue: 0,0:09:57.84,0:10:00.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak membantu. Aku hanya beban.{\i0}
Dialogue: 0,0:10:02.01,0:10:03.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku…{\i0}
Dialogue: 0,0:10:04.68,0:10:07.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sangat benci itu.
Dialogue: 0,0:10:08.89,0:10:10.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tayama-san.{\i0}
Dialogue: 0,0:10:10.86,0:10:15.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau mungkin "benci itu",\N‎tapi cobalah untuk santai.
Dialogue: 0,0:10:20.66,0:10:23.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan bertanya lagi.\N‎Bagaimana perasaanmu?
Dialogue: 0,0:10:32.46,0:10:35.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku panas, lemas,\N‎dan tak bisa berhenti batuk.
Dialogue: 0,0:10:36.30,0:10:37.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Baik.{\i0}
Dialogue: 0,0:10:38.17,0:10:40.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kepalaku sakit dan aku tak bisa makan.
Dialogue: 0,0:10:41.30,0:10:43.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak bisa merokok dan aku kesal.{\i0}
Dialogue: 0,0:10:48.60,0:10:49.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku yakin.{\i0}
Dialogue: 0,0:10:51.94,0:10:55.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Pada saat seperti ini, kau harus biarkan\N‎yang lain bekerja agar kau bisa tidur.{\i0}
Dialogue: 0,0:10:56.82,0:10:58.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak apa-apa.
Dialogue: 0,0:10:58.82,0:11:01.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau pikir harus mengandalkan\N‎orang lain adalah hal terburuk,
Dialogue: 0,0:11:02.28,0:11:04.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tapi itu tak benar.
Dialogue: 0,0:11:09.33,0:11:14.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dari semua orang yang menyuruhku santai,\N‎justru kau yang melakukannya.
Dialogue: 0,0:11:15.54,0:11:17.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selama kau tak masalah kuberi tahu.
Dialogue: 0,0:11:21.93,0:11:23.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Lakukanlah.{\i0}
Dialogue: 0,0:11:24.76,0:11:27.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kau meneleponku\N‎untuk mengucapkan Selamat Tahun Baru.{\i0}
Dialogue: 0,0:11:29.85,0:11:33.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak ingin kau lelah…{\i0}
Dialogue: 0,0:11:33.69,0:11:35.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau harus lakukan sekarang.
Dialogue: 0,0:11:35.23,0:11:37.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kita tak akan bertemu lagi tahun ini.
Dialogue: 0,0:11:37.36,0:11:38.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tidak, tapi…{\i0}
Dialogue: 0,0:11:39.11,0:11:42.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Atau kau akan telepon lagi besok?
Dialogue: 0,0:11:42.78,0:11:44.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tidak!{\i0}
Dialogue: 0,0:11:44.24,0:11:46.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini ponsel manajer.
Dialogue: 0,0:11:46.49,0:11:48.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak mungkin melakukan itu.
Dialogue: 0,0:11:48.74,0:11:51.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, lakukan sekarang.
Dialogue: 0,0:11:52.25,0:11:54.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan cepat.
Dialogue: 0,0:11:54.83,0:12:00.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih telah merokok\N‎di belakang denganku tahun ini.
Dialogue: 0,0:12:00.30,0:12:04.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku menghargaimu menyempatkan waktu\N‎untuk merokok dengan orang tua sepertiku.
Dialogue: 0,0:12:06.01,0:12:07.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Itu saja?{\i0}
Dialogue: 0,0:12:09.77,0:12:13.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tak akan bilang\N‎kau menantikannya lagi tahun depan?
Dialogue: 0,0:12:21.61,0:12:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tayama-san.{\i0}
Dialogue: 0,0:12:24.03,0:12:28.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jika kau tak keberatan…
Dialogue: 0,0:12:30.04,0:12:32.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎- Nyam.\N‎- Nyam?{\i0}
Dialogue: 0,0:12:41.30,0:12:42.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa dia tertidur?
Dialogue: 0,0:12:42.80,0:12:44.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sepertinya.
Dialogue: 0,0:12:49.64,0:12:52.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia merepotkan dengan cara yang tak biasa.
Dialogue: 0,0:12:53.68,0:12:56.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia tak pandai menjaga dirinya.
Dialogue: 0,0:12:57.94,0:13:00.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Omong-omong, kau…
Dialogue: 0,0:13:00.23,0:13:03.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau lupa kau pakai pengeras suara\N‎dan aku bisa dengar semua, ya?
Dialogue: 0,0:13:05.45,0:13:07.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak, aku tahu!
Dialogue: 0,0:13:07.07,0:13:09.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Makanya wajahku tersipu sekarang.
Dialogue: 0,0:13:09.95,0:13:13.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Berkat kau,\N‎aku merasa lebih baik sekarang.
Dialogue: 0,0:13:16.58,0:13:17.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bagaimana?{\i0}
Dialogue: 0,0:13:19.25,0:13:21.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf, Sasaki-kun,
Dialogue: 0,0:13:21.46,0:13:23.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎telah merepotkanmu.
Dialogue: 0,0:13:23.71,0:13:25.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mungkin kau pantas\N‎dapat lebih dari satu rokok?
Dialogue: 0,0:13:25.97,0:13:27.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak apa-apa.
Dialogue: 0,0:13:27.59,0:13:30.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak merasa direpotkan.
Dialogue: 0,0:13:30.76,0:13:32.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku bisa ucapkan Selamat Tahun Baru.
Dialogue: 0,0:13:33.27,0:13:34.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan…
Dialogue: 0,0:13:35.18,0:13:40.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Parah sekali aku membuatnya\N‎harus menyuruhku.{\i0}
Dialogue: 0,0:13:46.70,0:13:49.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau suka pekerjaanmu, 'kan?
Dialogue: 0,0:13:54.33,0:13:55.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa?{\i0}
Dialogue: 0,0:13:55.83,0:13:57.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa aku bermimpi?{\i0}
Dialogue: 0,0:13:58.62,0:14:01.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selama kau terus menikmati pekerjaanmu,
Dialogue: 0,0:14:01.63,0:14:06.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎apa pun yang kau butuhkan untuk sukses\N‎akan bisa kau dapatkan.
Dialogue: 0,0:14:07.34,0:14:08.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Suara itu…{\i0}
Dialogue: 0,0:14:09.97,0:14:12.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku sudah lupa wajahnya,{\i0}
Dialogue: 0,0:14:12.56,0:14:14.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎tapi cara bicaranya seperti Sasaki-san.{\i0}
Dialogue: 0,0:14:16.39,0:14:17.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aneh sekali.{\i0}
Dialogue: 0,0:14:21.15,0:14:24.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Itu tak mungkin dia.{\i0}
Dialogue: 0,0:14:42.42,0:14:43.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selamat Tahun Baru.,
Dialogue: 0,0:14:45.13,0:14:46.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku?
Dialogue: 0,0:14:46.46,0:14:48.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak pulang kampung tahun ini.
Dialogue: 0,0:14:48.22,0:14:50.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku di rumah, membaca tumpukan bukuku.
Dialogue: 0,0:14:50.43,0:14:51.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tumpukan bukumu?{\i0}
Dialogue: 0,0:14:51.76,0:14:53.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku suka itu!
Dialogue: 0,0:14:53.43,0:14:57.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau harus memberiku rekomendasi.
Dialogue: 0,0:14:59.35,0:15:01.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau bahkan tak baca buku.
Dialogue: 0,0:15:01.69,0:15:04.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kalau begitu, kau bisa bacakan untukku.{\i0}
Dialogue: 0,0:15:04.40,0:15:05.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bodoh.
Dialogue: 0,0:15:05.48,0:15:09.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎- Tidak! Lepaskan aku!\N‎- Jangan pergi saat Ibu gantikan baju.{\i0}
Dialogue: 0,0:15:09.99,0:15:13.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Hei, kau sedang apa?\N{\i1}‎- Aku benci semuanya!{\i0}
Dialogue: 0,0:15:13.24,0:15:16.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Kami akan mengunjungi kuil.\N‎- Aku gerah!
Dialogue: 0,0:15:16.16,0:15:19.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎- Benarkah? Jangan terpeleset dan jatuh.{\i0}\N‎- Lepaskan aku!
Dialogue: 0,0:15:23.67,0:15:24.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎OINE dari Yamada-chan.{\i0}
Dialogue: 0,0:15:26.05,0:15:27.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku juga dapat.
Dialogue: 0,0:15:28.01,0:15:31.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hanya dia orang yang pakai stiker ini.
Dialogue: 0,0:15:35.68,0:15:36.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa salahnya?
Dialogue: 0,0:15:38.39,0:15:39.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Selamat Tahun Baru.{\i0}
Dialogue: 0,0:15:39.48,0:15:41.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jaga kesehatanmu saat bekerja.{\i0}
Dialogue: 0,0:15:41.39,0:15:43.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Karakter aneh apa itu?{\i0}
Dialogue: 0,0:15:43.31,0:15:47.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan hanya duduk dan cemberut saja.\N‎Bantu Ibu merapikan tempat ini.
Dialogue: 0,0:15:47.07,0:15:48.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baik.
Dialogue: 0,0:15:52.82,0:15:55.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Dari yang tadinya lucu menjadi mengerikan.{\i0}
Dialogue: 0,0:15:55.32,0:15:57.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Menurutku ini lucu.{\i0}
Dialogue: 0,0:15:57.53,0:15:58.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dan ini seperti dia.{\i0}
Dialogue: 0,0:15:59.75,0:16:00.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:16:03.33,0:16:06.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, karena kau pulang saat liburan,
Dialogue: 0,0:16:06.38,0:16:09.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎haruskah kita berkunjung ke kuil\N‎setelah makan?
Dialogue: 0,0:16:09.17,0:16:11.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku lelah. Biar kupikirkan.
Dialogue: 0,0:16:11.55,0:16:12.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lelah?
Dialogue: 0,0:16:12.93,0:16:17.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hanya kau yang datang\N‎di antara kakak-kakakmu. Kami kesepian.
Dialogue: 0,0:16:17.01,0:16:19.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ikut saja dengan kami.\N‎Akan kami belikan ramen.
Dialogue: 0,0:16:22.06,0:16:23.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah.
Dialogue: 0,0:16:26.19,0:16:28.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sekalian aku berdoa untuk Pak Tua itu{\i0}
Dialogue: 0,0:16:28.23,0:16:31.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎agar dia tak kena sial lagi\N‎selama aku pergi.{\i0}
Dialogue: 0,0:16:32.24,0:16:35.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku yakin dia mengambil nasib sial\N‎di kuil sekarang.{\i0}
Dialogue: 0,0:16:41.04,0:16:42.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Nasib sial lagi, 'Kak?
Dialogue: 0,0:16:42.75,0:16:43.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Nasib sial?
Dialogue: 0,0:16:43.83,0:16:46.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bisa dibilang kau berbakat\N‎mengambil nasib sial.
Dialogue: 0,0:16:46.88,0:16:48.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan terlalu senang.
Dialogue: 0,0:16:49.09,0:16:51.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mau tukar dengan nasib sangat beruntungku?
Dialogue: 0,0:16:51.13,0:16:52.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kita tak boleh tukar.
Dialogue: 0,0:16:52.80,0:16:54.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan aku sudah terbiasa, ta?
Dialogue: 0,0:16:54.97,0:16:57.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku mau merokok dulu.
Dialogue: 0,0:16:57.47,0:16:58.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya?
Dialogue: 0,0:16:58.76,0:17:02.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Akan kubelikan jimat nasib baik.\N‎- Baik.
Dialogue: 0,0:17:02.18,0:17:03.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Paman.
Dialogue: 0,0:17:03.35,0:17:04.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan kembali.
Dialogue: 0,0:17:05.31,0:17:07.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan terpeleset dan jatuh, ya?
Dialogue: 0,0:17:07.52,0:17:08.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak akan!
Dialogue: 0,0:17:24.37,0:17:28.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa sangat aneh mendapat\N‎nasib sial setiap tahun?{\i0}
Dialogue: 0,0:17:28.88,0:17:31.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Mungkin aku harus dirukiah.{\i0}
Dialogue: 0,0:17:35.26,0:17:39.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku mungkin mengambil\N‎nasib sial tahun lalu,{\i0}
Dialogue: 0,0:17:40.72,0:17:42.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎tapi dia membuatku merasa lebih baik.{\i0}
Dialogue: 0,0:17:44.39,0:17:45.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dan…{\i0}
Dialogue: 0,0:17:47.39,0:17:49.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Itu tahun yang bagus.{\i0}
Dialogue: 0,0:17:49.56,0:17:51.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku beruntung dengan orang-orang\N‎yang kutemui.{\i0}
Dialogue: 0,0:17:57.53,0:18:00.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Semoga flunya membaik.{\i0}
Dialogue: 0,0:18:11.92,0:18:12.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-san!
Dialogue: 0,0:18:14.17,0:18:16.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sasaki-san.
Dialogue: 0,0:18:16.30,0:18:18.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf. Aku melihatmu\N‎dan memanggilmu tanpa pikir panjang.
Dialogue: 0,0:18:19.38,0:18:21.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selamat Tahun Baru.
Dialogue: 0,0:18:21.05,0:18:22.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:18:22.55,0:18:25.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa kau libur selama liburan?
Dialogue: 0,0:18:25.31,0:18:26.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:18:26.60,0:18:28.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kebetulan hari ini hari terakhir liburku.
Dialogue: 0,0:18:28.98,0:18:31.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku bisa pulang ke keluargaku tahun ini.
Dialogue: 0,0:18:31.02,0:18:33.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu liburan yang bagus.
Dialogue: 0,0:18:33.11,0:18:34.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku takut dengan yang terjadi nanti.
Dialogue: 0,0:18:36.86,0:18:39.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ekspresimu seperti orang\N‎yang akan mati besok.
Dialogue: 0,0:18:41.82,0:18:46.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku mau merokok di belakang. Mau ikut?
Dialogue: 0,0:18:47.16,0:18:48.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau yakin?
Dialogue: 0,0:18:50.21,0:18:51.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku yakin.
Dialogue: 0,0:18:51.96,0:18:56.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Karena tahun ini kita akan merokok lagi.
Dialogue: 0,0:18:57.76,0:18:59.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benar.
Dialogue: 0,0:18:59.84,0:19:02.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku senang mendengarnya.
Dialogue: 0,0:19:02.51,0:19:04.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Omong-omong, kau dengar aku saat itu?
Dialogue: 0,0:19:04.89,0:19:06.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku yakin…
Dialogue: 0,0:19:09.73,0:19:10.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia pergi!
Dialogue: 0,0:19:12.77,0:19:14.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-san!
Dialogue: 0,0:19:14.11,0:19:15.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Di sana kau.
Dialogue: 0,0:19:15.27,0:19:17.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan lama. Ayo.
Dialogue: 0,0:19:17.48,0:19:19.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi aku senang.
Dialogue: 0,0:19:20.40,0:19:23.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku senang kau sudah lebih baik.
Dialogue: 0,0:19:25.37,0:19:29.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa kau mengkhawatirkanku?
Dialogue: 0,0:19:29.75,0:19:31.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tentu saja.
Dialogue: 0,0:19:32.62,0:19:34.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kita tak bertemu\N‎karena aku pulang selama liburan,
Dialogue: 0,0:19:34.96,0:19:37.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎jadi yang bisa kulakukan\N‎hanya memikirkanmu.
Dialogue: 0,0:19:39.51,0:19:42.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi aku senang bisa melihatmu sekarang.
Dialogue: 0,0:19:44.14,0:19:46.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku senang kau berpakaian tebal.
Dialogue: 0,0:19:47.64,0:19:50.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini hanya pemikiranku,
Dialogue: 0,0:19:50.27,0:19:53.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tapi apa menurutmu aku orang\N‎yang tak pernah pakai baju tebal?
Dialogue: 0,0:19:54.40,0:19:57.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak, aku hanya berpikir\N‎rasanya nyaman bisa merasa hangat.
Dialogue: 0,0:20:00.53,0:20:02.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo. Kita duduk.
Dialogue: 0,0:20:03.28,0:20:04.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baik.
Dialogue: 0,0:20:05.41,0:20:06.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Permisi.
Dialogue: 0,0:20:12.92,0:20:15.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Dengarkan, Pak Tua.\N‎- Ya! Ini aku!
Dialogue: 0,0:20:23.68,0:20:27.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tahun lalu kau sangat cemas\N‎soal perutku kedinginan.
Dialogue: 0,0:20:27.43,0:20:30.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mode tak peduli\N‎soal panas, dingin, atau kenyamanan.
Dialogue: 0,0:20:30.85,0:20:34.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mode adalah memilih pakaian\N‎yang membuatmu merasa senang saat itu.
Dialogue: 0,0:20:34.60,0:20:38.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku bisa pakai celana pendek dan\N‎celana ketat hari ini dan tetap cantik.
Dialogue: 0,0:20:39.48,0:20:42.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mode harus seru walaupun ada risikonya.\N‎Seperti merokok.
Dialogue: 0,0:20:42.19,0:20:43.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, Bu.
Dialogue: 0,0:20:43.95,0:20:44.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Angkat tanganmu.
Dialogue: 0,0:20:45.70,0:20:47.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa?
Dialogue: 0,0:20:49.37,0:20:52.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, apa… Tayama-san! Apa yang kau…
Dialogue: 0,0:20:59.29,0:21:02.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Padahal kau selalu mencemaskanku,
Dialogue: 0,0:21:02.92,0:21:06.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tapi aku lebih tahan dingin\N‎daripada kau, Sasaki-san.
Dialogue: 0,0:21:06.39,0:21:08.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau benar.
Dialogue: 0,0:21:08.93,0:21:11.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sasaki tak mengerti mode.{\i0}
Dialogue: 0,0:21:11.60,0:21:14.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sasaki adalah pria tua berusia 45 tahun.{\i0}
Dialogue: 0,0:21:14.39,0:21:16.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia memilih pakaiannya\N‎berdasarkan suhu hari itu.{\i0}
Dialogue: 0,0:21:17.94,0:21:20.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bagaimana dia tahu\N‎aku pakai kompres panas?{\i0}
Dialogue: 0,0:21:24.78,0:21:28.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku yakin dia akan menempelkannya\N‎di tubuhnya seharian.{\i0}
Dialogue: 0,0:21:34.87,0:21:37.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada yang ingin kau katakan padaku?
Dialogue: 0,0:21:39.33,0:21:42.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf aku menilai selera modemu
Dialogue: 0,0:21:42.63,0:21:45.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎sementara aku pakai kompres panas!
Dialogue: 0,0:21:46.17,0:21:47.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sebenarnya, ya.
Dialogue: 0,0:21:48.14,0:21:51.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku menantikan\N‎merokok lagi bersamamu tahun ini.
Dialogue: 0,0:21:53.72,0:21:57.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau ingin aku mengatakan itu tahun lalu.
Dialogue: 0,0:21:57.02,0:21:58.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sekarang aku bisa mengatakannya.
Dialogue: 0,0:22:01.23,0:22:03.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bukan itu maksudku.{\i0}
Dialogue: 0,0:23:34.87,0:23:39.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terjemahan subtitle oleh Rahayu Kinasih
