Dialogue: 0,0:00:01.37,0:00:02.45,sign,,0000,0000,0000,,‎BERITA EIKYAKU
Dialogue: 0,0:00:02.46,0:00:05.00,sign,,0000,0000,0000,,‎MASA DEPAN\N‎AWAL ERA BARU
Dialogue: 0,0:00:05.00,0:00:06.63,sign,,0000,0000,0000,,‎TARUH CAMILAN DI SINI
Dialogue: 0,0:00:21.68,0:00:23.35,sign,,0000,0000,0000,,{\an8}‎ISTRI - AKU PULANG SEKARANG\N‎BAIK, AKU MENCINTAIMU
Dialogue: 0,0:00:23.35,0:00:24.69,sign,,0000,0000,0000,,{\an8}‎AKU SUKA BEKAL YANG KAU SIAPKAN UNTUKKU
Dialogue: 0,0:00:53.80,0:00:55.22,sign,,0000,0000,0000,,‎JAGA KERAPIAN DAN KETERATURAN
Dialogue: 0,0:02:46.04,0:02:49.54,sign,,0000,0000,0000,,‎BERITA EIKYAKU\N‎UBAH HIDUPMU
Dialogue: 0,0:02:49.54,0:02:51.46,sign,,0000,0000,0000,,‎PESAN - KALENDER - GALERI\N‎KAMERA - MEMO - PENGATURAN
Dialogue: 0,0:02:58.30,0:02:59.55,sign,,0000,0000,0000,,‎DAPATKAN BERITA TERBARU
Dialogue: 0,0:03:09.35,0:03:10.77,sign,,0000,0000,0000,,‎KEBOCORAN DATA PRIBADI\N‎LEWAT PONSEL PINTAR
Dialogue: 0,0:03:11.35,0:03:12.85,sign,,0000,0000,0000,,‎PENTING\N‎10 JUTA YEN HARUS DIBAYAR SEKARANG
Dialogue: 0,0:03:13.35,0:03:15.32,sign,,0000,0000,0000,,‎INFEKSI VIRUS - KO
Dialogue: 0,0:03:21.82,0:03:22.91,sign,,0000,0000,0000,,{\an8}‎FOTO
Dialogue: 0,0:04:16.13,0:04:19.05,sign,,0000,0000,0000,,‎TATAPAN KOSONG
Dialogue: 0,0:04:56.87,0:04:57.96,sign,,0000,0000,0000,,{\an8}‎KI - KU - KE - KO
Dialogue: 0,0:04:59.13,0:05:00.21,sign,,0000,0000,0000,,‎KA
Dialogue: 0,0:05:37.08,0:05:38.17,sign,,0000,0000,0000,,{\an8}‎PANDUAN PENGGUNA
Dialogue: 0,0:05:55.60,0:05:58.02,sign,,0000,0000,0000,,‎BERITA EIKYAKU
Dialogue: 0,0:08:18.03,0:08:20.45,sign,,0000,0000,0000,,‎BUKA 24 JAM - SUPER S
Dialogue: 0,0:09:18.34,0:09:21.35,sign,,0000,0000,0000,,‎JAGA LOKER KALIAN TETAP BERSIH
Dialogue: 0,0:09:48.04,0:09:50.38,sign,,0000,0000,0000,,‎PERUSAHAAN HAPPY
Dialogue: 0,0:10:51.23,0:10:52.48,sign,,0000,0000,0000,,‎DIA BERMAKSUD BAIK
Dialogue: 0,0:11:41.53,0:11:42.53,sign,,0000,0000,0000,,‎DI DALAM - DI LUAR
Dialogue: 0,0:12:14.44,0:12:15.44,sign,,0000,0000,0000,,‎BENCI LELUCON JOROK
Dialogue: 0,0:13:51.37,0:13:53.87,sign,,0000,0000,0000,,‎BUKA 24 JAM - SUPER S
Dialogue: 0,0:13:53.87,0:13:55.41,sign,,0000,0000,0000,,{\an8}‎KERUPUK BERAS LEZAT
Dialogue: 0,0:16:03.50,0:16:04.58,sign,,0000,0000,0000,,‎CUACA BESOK
Dialogue: 0,0:16:30.69,0:16:32.44,sign,,0000,0000,0000,,‎PINTU KELUAR TENGAH
Dialogue: 0,0:16:37.20,0:16:40.62,sign,,0000,0000,0000,,{\an8}‎STASIUN MOROMORO
Dialogue: 0,0:18:08.71,0:18:11.71,sign,,0000,0000,0000,,{\an8}‎ES KRIM STIK
Dialogue: 0,0:20:20.63,0:20:22.63,sign,,0000,0000,0000,,{\an8}‎BAJU LENGAN PENDEK YAMADA
Dialogue: 0,0:20:24.26,0:20:25.43,sign,,0000,0000,0000,,‎PERUT TAYAMA
Dialogue: 0,0:22:04.44,0:22:06.28,sign,,0000,0000,0000,,‎PENCET
Dialogue: 0,0:22:06.86,0:22:08.86,sign,,0000,0000,0000,,‎LEMON CHUHAI
Dialogue: 0,0:00:07.59,0:00:09.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Astaga! Kau seperti orang tua.
Dialogue: 0,0:00:11.26,0:00:13.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Membaca koran dengan kacamata baca…
Dialogue: 0,0:00:14.68,0:00:17.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sepertinya aku belum setua itu.
Dialogue: 0,0:00:17.35,0:00:20.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kebanyakan orang baca berita\N‎dari ponsel pintar.
Dialogue: 0,0:00:20.02,0:00:21.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Belilah ponsel pintar. Lihat?
Dialogue: 0,0:00:26.35,0:00:28.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ponsel pintar, ya?
Dialogue: 0,0:00:29.86,0:00:32.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau akan kesulitan nantinya\N‎jika tak punya OINE.
Dialogue: 0,0:00:33.03,0:00:35.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mereka bahkan menggunakannya untuk berita.
Dialogue: 0,0:00:36.87,0:00:40.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi yang ini masih berfungsi.
Dialogue: 0,0:00:43.75,0:00:44.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Nyam.
Dialogue: 0,0:00:47.04,0:00:49.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aneh. Kenapa layarnya gelap?
Dialogue: 0,0:00:52.42,0:00:53.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hah?
Dialogue: 0,0:00:55.22,0:00:56.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku harus perbaiki ini.
Dialogue: 0,0:00:56.89,0:01:00.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bodoh. Tak ada lagi yang bisa\N‎memperbaiki benda tua seperti itu.
Dialogue: 0,0:01:01.68,0:01:03.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Menyerah saja dan beli ponsel pintar.
Dialogue: 0,0:01:05.89,0:01:06.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Astaga, ini enak!
Dialogue: 0,0:02:53.71,0:02:57.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku akhirnya beli ponsel pintar,\N‎tapi aku tak tahu cara pakainya.{\i0}
Dialogue: 0,0:02:59.55,0:03:01.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Benar. Seharusnya bisa\N‎baca berita di sini.{\i0}
Dialogue: 0,0:03:02.47,0:03:03.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bagaimana caranya?{\i0}
Dialogue: 0,0:03:05.10,0:03:06.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kurasa aku harus cari tahu.{\i0}
Dialogue: 0,0:03:16.82,0:03:19.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Gawat. Aku tak bisa melakukan apa pun!{\i0}
Dialogue: 0,0:03:20.74,0:03:21.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:03:22.91,0:03:24.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Apa yang{\i0}‎…
Dialogue: 0,0:03:24.41,0:03:26.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa layarnya?{\i0}
Dialogue: 0,0:03:26.33,0:03:28.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bagaimana mengembalikannya?{\i0}
Dialogue: 0,0:03:45.89,0:03:47.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau ingin tahu cara pakai ponsel pintar?
Dialogue: 0,0:03:48.51,0:03:51.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak sadar\N‎kau pakai ponsel lipat model lama.
Dialogue: 0,0:03:52.10,0:03:53.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:03:55.61,0:03:57.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau memang tampak seperti itu.
Dialogue: 0,0:03:57.07,0:03:58.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tampak seperti itu?{\i0}
Dialogue: 0,0:03:59.73,0:04:01.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tolong ajari aku, Tayama-sensei.
Dialogue: 0,0:04:02.28,0:04:04.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tentu. Akan kuajari.
Dialogue: 0,0:04:04.24,0:04:06.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benarkah? Terima kasih.
Dialogue: 0,0:04:06.24,0:04:07.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi? Apa yang kau ingin tahu?
Dialogue: 0,0:04:08.70,0:04:10.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya…
Dialogue: 0,0:04:10.12,0:04:14.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku malu mengatakan aku bahkan\N‎tak tahu pengoperasian dasarnya.
Dialogue: 0,0:04:20.00,0:04:21.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-san?
Dialogue: 0,0:04:22.13,0:04:23.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, mulai dari dasar.
Dialogue: 0,0:04:23.63,0:04:27.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baik. Ayo kita mulai dengan\N‎yang paling mungkin kau pakai.
Dialogue: 0,0:04:28.35,0:04:29.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tolong.
Dialogue: 0,0:04:31.18,0:04:33.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar nomor satu.
Dialogue: 0,0:04:33.89,0:04:37.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kuanggap kau tahu cara kembali\N‎ke layar utama, jadi kita lewati itu.
Dialogue: 0,0:04:37.98,0:04:41.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf, bisa tunjukkan caranya?
Dialogue: 0,0:04:46.70,0:04:48.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ponsel pintar menggunakan\N‎metode input geser.
Dialogue: 0,0:04:48.91,0:04:52.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Cobalah. Tekan tombolnya, lalu geser\N‎ke karakter yang ingin kau ketik.
Dialogue: 0,0:04:52.91,0:04:54.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Geser?
Dialogue: 0,0:04:54.41,0:04:55.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah.
Dialogue: 0,0:04:55.67,0:04:56.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎"Ko." Aku mau "ko…"
Dialogue: 0,0:04:57.96,0:04:59.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Geser?
Dialogue: 0,0:05:00.21,0:05:01.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak!
Dialogue: 0,0:05:04.09,0:05:05.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukan begini.
Dialogue: 0,0:05:09.22,0:05:11.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Haruskah kita pakai metode input lain?
Dialogue: 0,0:05:11.81,0:05:13.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, tolong.
Dialogue: 0,0:05:14.39,0:05:18.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan aku ingin baca berita\N‎di ponsel pintar baruku…
Dialogue: 0,0:05:18.48,0:05:20.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, itu bisa.
Dialogue: 0,0:05:20.15,0:05:21.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benarkah?
Dialogue: 0,0:05:21.32,0:05:26.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pertama, kau harus buka Toko Aplikasi\N‎untuk mengunduh aplikasi berita.
Dialogue: 0,0:05:27.07,0:05:29.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Biasanya ada di layar utama.
Dialogue: 0,0:05:30.16,0:05:34.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Untuk pakai Toko Aplikasi,\N‎kau harus buat akun.
Dialogue: 0,0:05:34.58,0:05:37.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Setelah buat akun, masuk…
Dialogue: 0,0:05:38.17,0:05:39.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎…dan unduh aplikasi berita.
Dialogue: 0,0:05:39.50,0:05:42.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lalu kau harus buat akun lain untuk itu.
Dialogue: 0,0:05:48.84,0:05:50.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sini. Biar kulakukan untukmu.
Dialogue: 0,0:05:51.55,0:05:52.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih.
Dialogue: 0,0:05:58.64,0:06:00.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Wow, Tayama-san.
Dialogue: 0,0:06:00.90,0:06:03.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku bisa pakai ini\N‎sebagai ponsel sekarang.
Dialogue: 0,0:06:07.36,0:06:10.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sekarang, kau hanya perlu\N‎membiasakan diri makin sering kau pakai.
Dialogue: 0,0:06:10.99,0:06:13.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-san,
Dialogue: 0,0:06:13.12,0:06:15.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎ada satu hal lagi yang ingin kutanya.
Dialogue: 0,0:06:15.66,0:06:16.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tanyakan.
Dialogue: 0,0:06:17.33,0:06:20.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bisa buat teksnya lebih besar?
Dialogue: 0,0:06:20.75,0:06:24.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:06:24.00,0:06:26.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau seharusnya\N‎tak bisa pakai ponsel pintar.
Dialogue: 0,0:06:26.51,0:06:28.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagaimana kau tahu\N‎teksnya bisa diperbesar?
Dialogue: 0,0:06:28.63,0:06:31.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Karena aku melakukannya di ponsel lipatku.
Dialogue: 0,0:06:35.52,0:06:37.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa terlalu sulit?
Dialogue: 0,0:06:41.52,0:06:44.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Mungkin itu sulit?{\i0}
Dialogue: 0,0:06:58.79,0:07:01.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akan kulakukan, tapi…
Dialogue: 0,0:07:21.10,0:07:23.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukan alasan untukmu menyerah.
Dialogue: 0,0:07:24.69,0:07:25.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah.
Dialogue: 0,0:07:25.98,0:07:27.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kuubah pengaturannya. Berikan.
Dialogue: 0,0:07:33.49,0:07:37.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan, Sasaki-san,\N‎untuk merayakan debut ponsel pintarmu…
Dialogue: 0,0:07:38.08,0:07:40.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎bagaimana kalau kuberi nomor Yamada-san?
Dialogue: 0,0:07:40.54,0:07:42.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak. Aku tak butuh. Terima kasih!
Dialogue: 0,0:07:44.00,0:07:47.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak, jangan, Tayama-san!\N‎Itu informasi pribadi.
Dialogue: 0,0:07:47.59,0:07:50.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan itu informasi pribadi Yamada-san!
Dialogue: 0,0:07:50.72,0:07:53.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yah. Sudah kumasukkan.
Dialogue: 0,0:07:53.18,0:07:54.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:07:57.43,0:08:00.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bisa-bisanya, Tayama-san?
Dialogue: 0,0:08:02.77,0:08:04.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku bohong.
Dialogue: 0,0:08:04.44,0:08:05.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:08:05.52,0:08:07.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baik. Sudah selesai.
Dialogue: 0,0:08:07.90,0:08:09.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-san!
Dialogue: 0,0:08:09.23,0:08:11.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini. Seharusnya lebih mudah dibaca.
Dialogue: 0,0:08:11.94,0:08:13.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih.
Dialogue: 0,0:08:13.03,0:08:14.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak! Tidak terima kasih.
Dialogue: 0,0:08:14.61,0:08:16.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku takut.
Dialogue: 0,0:08:25.33,0:08:27.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, Yamada-chan. Sampai jumpa.
Dialogue: 0,0:08:27.92,0:08:29.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sampai jumpa.
Dialogue: 0,0:09:15.88,0:09:18.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa sif hari ini?
Dialogue: 0,0:09:25.10,0:09:27.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau bahkan tak sadar saat aku memfotomu.
Dialogue: 0,0:09:28.85,0:09:32.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baik. Semangat hari ini.
Dialogue: 0,0:09:50.38,0:09:51.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, Sasaki.
Dialogue: 0,0:09:51.96,0:09:55.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Katanya kau bisa tahu kepribadian pria\N‎dari merek rokoknya.
Dialogue: 0,0:09:56.55,0:09:57.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kata siapa?
Dialogue: 0,0:09:59.51,0:10:01.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sebutannya "pembacaan merek".
Dialogue: 0,0:10:01.47,0:10:05.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Anak muda senang baca ini\N‎di acara minum-minum.
Dialogue: 0,0:10:05.56,0:10:07.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kita lihat apa katanya tentangku.
Dialogue: 0,0:10:07.85,0:10:12.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Katanya aku "setia dan loyal"\N‎dan "tak pernah selingkuh!"
Dialogue: 0,0:10:14.32,0:10:18.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi katanya kau juga "tak peka"\N‎dan "tak bisa baca situasi."
Dialogue: 0,0:10:18.49,0:10:23.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei! Itu detail kecil.\N‎Kau bisa abaikan itu!
Dialogue: 0,0:10:23.12,0:10:24.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa tak baca situasi?
Dialogue: 0,0:10:24.41,0:10:26.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau dengar aku?
Dialogue: 0,0:10:26.04,0:10:27.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak?
Dialogue: 0,0:10:27.41,0:10:30.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎- Topik ini sedang tren?{\i0}\N‎- Yang mana? Kau tersenyum?
Dialogue: 0,0:10:37.80,0:10:40.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya. Aku pernah dengar.
Dialogue: 0,0:10:41.51,0:10:43.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pernah?
Dialogue: 0,0:10:43.10,0:10:44.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hanya tahu itu ada.
Dialogue: 0,0:10:44.56,0:10:47.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi bukankah hal itu biasanya…
Dialogue: 0,0:10:47.77,0:10:51.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tahu dari rekan kerja.\N‎Jadi, kupikir itu menarik.
Dialogue: 0,0:10:54.77,0:10:56.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah. Ayo kita lihat.
Dialogue: 0,0:10:58.19,0:11:00.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa katanya tentangmu?
Dialogue: 0,0:11:00.78,0:11:02.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu…
Dialogue: 0,0:11:02.66,0:11:03.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini dia.
Dialogue: 0,0:11:04.24,0:11:05.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Untukku…
Dialogue: 0,0:11:06.41,0:11:10.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎"Merendahkan orang lain\N‎walaupun cenderung masokhis."
Dialogue: 0,0:11:11.58,0:11:13.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa ini?
Dialogue: 0,0:11:13.08,0:11:15.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak bisa mengisap rokokku…
Dialogue: 0,0:11:15.75,0:11:16.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Serius?
Dialogue: 0,0:11:18.71,0:11:20.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagaimana denganmu?
Dialogue: 0,0:11:23.59,0:11:26.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎"Punya kepribadian ganda\N‎dan libido yang tinggi."
Dialogue: 0,0:11:29.14,0:11:33.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hal seperti ini selalu berakhir jorok.
Dialogue: 0,0:11:33.40,0:11:36.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Orang yang menulisnya\N‎pasti sangat bias.
Dialogue: 0,0:11:38.73,0:11:41.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Walaupun lucunya, mereka benar.{\i0}
Dialogue: 0,0:11:46.12,0:11:47.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maafkan aku.
Dialogue: 0,0:11:49.41,0:11:52.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa kau berlutut?
Dialogue: 0,0:11:52.12,0:11:54.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Di mana rokok dan kacamatamu?
Dialogue: 0,0:11:56.13,0:11:59.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak tahu membaca ini\N‎akan berakhir aneh.
Dialogue: 0,0:11:59.63,0:12:02.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku minta maaf membuatmu mengalami ini.
Dialogue: 0,0:12:02.63,0:12:04.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf kubuat kau katakan itu.
Dialogue: 0,0:12:10.47,0:12:14.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku memang benci lelucon jorok.
Dialogue: 0,0:12:16.02,0:12:20.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi kau membahasnya\N‎karena kau pikir itu trendi, 'kan?
Dialogue: 0,0:12:23.90,0:12:27.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Niatmu baik,\N‎tapi kau minta maaf karena itu?
Dialogue: 0,0:12:28.95,0:12:30.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sasaki-san yang konyol.
Dialogue: 0,0:12:35.71,0:12:37.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak marah.
Dialogue: 0,0:12:38.04,0:12:39.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo kita merokok lagi.
Dialogue: 0,0:12:39.92,0:12:41.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-san.
Dialogue: 0,0:12:41.05,0:12:44.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi menurutku kau memang\N‎punya kepribadian ganda.
Dialogue: 0,0:12:46.43,0:12:50.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terpikir olehku, tapi aku tak tahu\N‎bagaimana bilangnya.
Dialogue: 0,0:12:51.06,0:12:52.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi aku mengerti sekarang.
Dialogue: 0,0:12:56.44,0:12:58.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Coba bersikap cuek,\N‎padahal sebenarnya baik.
Dialogue: 0,0:12:59.19,0:13:01.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itulah dirimu. Ya, 'kan?
Dialogue: 0,0:13:10.58,0:13:11.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-san?
Dialogue: 0,0:13:13.25,0:13:15.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu rokok yang akan kau isap, 'kan?
Dialogue: 0,0:13:17.04,0:13:18.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih.
Dialogue: 0,0:13:19.88,0:13:21.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maafkan aku. Bagaimana aku lupa?
Dialogue: 0,0:13:23.30,0:13:25.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mau kunyalakan?
Dialogue: 0,0:13:29.01,0:13:30.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-san… kau marah?
Dialogue: 0,0:13:30.85,0:13:33.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak marah. Lihat? Aku tersenyum.
Dialogue: 0,0:13:46.07,0:13:47.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maafkan aku.
Dialogue: 0,0:13:47.36,0:13:48.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Untuk apa?
Dialogue: 0,0:13:58.58,0:14:03.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bagaimanapun juga,\N‎kemarin aku memang menyinggungnya.{\i0}
Dialogue: 0,0:14:06.67,0:14:08.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih banyak.
Dialogue: 0,0:14:11.26,0:14:15.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa aku berhak untuk mengantre\N‎di kasir Yamada-san?{\i0}
Dialogue: 0,0:14:15.77,0:14:16.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tidak.{\i0}
Dialogue: 0,0:14:20.23,0:14:21.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selanjutnya!
Dialogue: 0,0:14:22.15,0:14:25.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kasir ini buka.
Dialogue: 0,0:14:26.44,0:14:27.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:14:45.71,0:14:48.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ada masalah?{\i0}
Dialogue: 0,0:14:48.76,0:14:50.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Seandainya aku bisa lihat.{\i0}
Dialogue: 0,0:15:15.95,0:15:20.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf kau jauh-jauh ke sini\N‎saat cuaca panas.
Dialogue: 0,0:15:20.96,0:15:23.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak apa-apa.
Dialogue: 0,0:15:23.42,0:15:25.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Silakan. Ini tehnya.
Dialogue: 0,0:15:26.96,0:15:28.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih.
Dialogue: 0,0:15:28.55,0:15:29.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sama-sama.
Dialogue: 0,0:15:33.93,0:15:36.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Berkas yang kau kirim?
Dialogue: 0,0:15:36.60,0:15:38.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu sangat membantu.
Dialogue: 0,0:15:38.77,0:15:43.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bahkan Presiden senang.\N‎"Perusahaan Happy memang hebat," katanya!
Dialogue: 0,0:15:43.23,0:15:44.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku senang mendengarnya.
Dialogue: 0,0:15:44.90,0:15:46.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Halo, Semuanya.{\i0}
Dialogue: 0,0:15:46.44,0:15:50.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Musim panas ini sangat panas\N‎sejak Pekan Emas, 'kan?{\i0}
Dialogue: 0,0:15:51.28,0:15:54.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kami mulai pakai gaya Cool Biz.
Dialogue: 0,0:15:54.37,0:15:56.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu bagus.
Dialogue: 0,0:15:57.49,0:16:00.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Perusahaan Happy tak mengizinkannya\N‎sampai resmi musim panas.
Dialogue: 0,0:16:01.79,0:16:03.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pasti menyulitkan.
Dialogue: 0,0:16:04.58,0:16:06.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jepang Utara akan mengalami…{\i0}
Dialogue: 0,0:16:06.00,0:16:09.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah. Sampai bertemu lagi.
Dialogue: 0,0:16:09.05,0:16:10.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya. Sama-sama.
Dialogue: 0,0:16:11.13,0:16:13.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau akan ke mana sekarang?\N‎Kembali ke kantor?
Dialogue: 0,0:16:13.63,0:16:16.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak. Aku bisa langsung pulang sekarang.
Dialogue: 0,0:16:16.10,0:16:18.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Senangnya.
Dialogue: 0,0:16:18.06,0:16:20.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tahu kau selalu bekerja keras.
Dialogue: 0,0:16:48.71,0:16:52.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku benci cuacanya tetap panas saat sore.{\i0}
Dialogue: 0,0:16:53.59,0:16:56.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku harus bagaimana\N‎saat musim panas benar-benar datang?{\i0}
Dialogue: 0,0:17:04.44,0:17:05.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau suka es krimnya?
Dialogue: 0,0:17:06.85,0:17:08.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya!
Dialogue: 0,0:17:08.11,0:17:10.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Keringatmu banyak sekali.\N‎- Panas.
Dialogue: 0,0:17:10.98,0:17:13.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Mungkin aku beli es krim juga di jalan?{\i0}
Dialogue: 0,0:17:17.49,0:17:18.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tunggu!
Dialogue: 0,0:17:21.20,0:17:23.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ramai sekali di sore hari.{\i0}
Dialogue: 0,0:17:25.12,0:17:26.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Hei, tunggu!{\i0}
Dialogue: 0,0:17:29.00,0:17:30.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Yamada-san?{\i0}
Dialogue: 0,0:17:31.55,0:17:33.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia juga kerja di sore hari?{\i0}
Dialogue: 0,0:17:34.47,0:17:36.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Hari ini bagus sekali.{\i0}
Dialogue: 0,0:17:36.72,0:17:38.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih banyak.
Dialogue: 0,0:17:41.26,0:17:42.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Lengan pendek?{\i0}
Dialogue: 0,0:17:42.89,0:17:44.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih untuk kartu poinnya.
Dialogue: 0,0:17:45.39,0:17:47.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Wow! Hari ini pergantian seragam musiman?{\i0}
Dialogue: 0,0:17:48.40,0:17:50.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa ini terasa menyegarkan?{\i0}
Dialogue: 0,0:17:51.77,0:17:53.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dan Yamada-san terlihat…{\i0}
Dialogue: 0,0:17:54.40,0:17:55.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎imut…{\i0}
Dialogue: 0,0:17:58.70,0:18:00.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sebenarnya, aku tak butuh es krim.{\i0}
Dialogue: 0,0:18:01.08,0:18:02.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku akan pulang.{\i0}
Dialogue: 0,0:18:11.71,0:18:15.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yamada-san kemarin ada di toko,\N‎tapi kau tak beli apa-apa darinya.
Dialogue: 0,0:18:16.26,0:18:17.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kenapa?
Dialogue: 0,0:18:20.97,0:18:22.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau melihatku dari suatu tempat lagi?
Dialogue: 0,0:18:23.18,0:18:27.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pria besar setengah baya berdiri\N‎di pintu masuk terlihat sangat mencolok.
Dialogue: 0,0:18:28.10,0:18:29.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf mengganggu.
Dialogue: 0,0:18:31.36,0:18:32.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi? Kenapa tak beli?
Dialogue: 0,0:18:37.61,0:18:40.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kemarin sangat panas,\N‎jadi aku ingin beli es krim.
Dialogue: 0,0:18:41.53,0:18:42.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lalu?
Dialogue: 0,0:18:43.33,0:18:47.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi toko itu penuh ion negatif,\N‎sehingga aku langsung merasa sejuk.
Dialogue: 0,0:18:48.41,0:18:49.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ion negatif.
Dialogue: 0,0:18:51.88,0:18:52.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Astaga.
Dialogue: 0,0:18:53.63,0:18:57.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kupikir baju lengan pendek Yamada-san\N‎yang menyejukkan.
Dialogue: 0,0:19:02.01,0:19:03.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bingo.
Dialogue: 0,0:19:03.14,0:19:04.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak.
Dialogue: 0,0:19:07.89,0:19:12.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku berterima kasih kepada karyawan retail\N‎yang pakai baju sesuai musim
Dialogue: 0,0:19:12.60,0:19:14.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎dan itu termasuk Yamada-san.
Dialogue: 0,0:19:14.27,0:19:16.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, menurutmu dia tak imut.
Dialogue: 0,0:19:16.32,0:19:17.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak pernah bilang…
Dialogue: 0,0:19:27.45,0:19:30.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Menurutku dia tipe orang yang bagus\N‎mengenakan baju lengan pendek.
Dialogue: 0,0:19:32.25,0:19:34.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau berkeringat sekali.
Dialogue: 0,0:19:34.42,0:19:36.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hari ini panas…
Dialogue: 0,0:19:40.76,0:19:44.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tak panas mengenakan jaket itu?
Dialogue: 0,0:19:44.05,0:19:46.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku pakai baju tipis di dalamnya.
Dialogue: 0,0:19:46.05,0:19:47.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak bisa mengalahkanmu.
Dialogue: 0,0:19:48.89,0:19:49.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benarkah?
Dialogue: 0,0:19:49.98,0:19:51.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:19:53.48,0:19:54.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lihat?
Dialogue: 0,0:19:56.73,0:19:58.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-san! Maaf…
Dialogue: 0,0:20:01.57,0:20:03.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf aku melihat perutmu!
Dialogue: 0,0:20:04.53,0:20:05.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa…
Dialogue: 0,0:20:09.45,0:20:11.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa perutmu tak dingin?
Dialogue: 0,0:20:14.42,0:20:17.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa perutmu tak dingin?{\i0}
Dialogue: 0,0:20:17.59,0:20:20.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tak dingin?{\i0}
Dialogue: 0,0:20:22.63,0:20:24.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Cantik!{\i0}
Dialogue: 0,0:20:25.43,0:20:26.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Hore!{\i0}
Dialogue: 0,0:20:26.51,0:20:28.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tak dingin? Kau baik-baik saja?
Dialogue: 0,0:20:34.52,0:20:37.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Astaga, pria tua ini…{\i0}
Dialogue: 0,0:20:39.61,0:20:40.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-san.
Dialogue: 0,0:20:41.28,0:20:42.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jika kau mau…
Dialogue: 0,0:20:43.53,0:20:45.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Masih ada angin dingin saat malam.
Dialogue: 0,0:20:51.25,0:20:53.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tak harus memakainya jika tak mau…
Dialogue: 0,0:20:54.04,0:20:56.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Tayama-san. Maaf.
Dialogue: 0,0:20:56.58,0:20:59.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kupikir kau bisa tutupi perutmu.
Dialogue: 0,0:20:59.21,0:21:01.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak menyuruhmu memakainya.
Dialogue: 0,0:21:01.88,0:21:03.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa aku menyinggung…
Dialogue: 0,0:21:04.30,0:21:05.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎dirimu?
Dialogue: 0,0:21:09.05,0:21:10.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-san?
Dialogue: 0,0:21:17.44,0:21:19.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Diam, Pencinta Lengan.
Dialogue: 0,0:21:20.40,0:21:21.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pencinta lengan?
Dialogue: 0,0:21:28.62,0:21:29.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak mengerti.{\i0}
Dialogue: 0,0:21:29.74,0:21:31.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Pencinta lengan? Apa itu?{\i0}
Dialogue: 0,0:21:44.55,0:21:48.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kurasa aku tak peka\N‎soal hal-hal seperti ini.{\i0}
Dialogue: 0,0:21:58.48,0:22:02.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jadi, kau lebih suka lengan\N‎daripada perut, Sasaki.{\i0}
Dialogue: 0,0:22:08.86,0:22:11.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kurasa aku harus kurangi\N‎makan ramen untuk sementara.
Dialogue: 0,0:23:34.87,0:23:39.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terjemahan subtitle oleh Rahayu Kinasih
