Dialogue: 0,0:00:04.12,0:00:06.29,sign,,0000,0000,0000,,‎SASAKI-SAN\N‎RUMAH SAKIT MEMORIAL ORAKA
Dialogue: 0,0:00:45.92,0:00:47.04,sign,,0000,0000,0000,,‎JAGA KERAPIAN DAN KETERATURAN
Dialogue: 0,0:01:24.20,0:01:26.87,sign,,0000,0000,0000,,‎APA KAU MEROKOK? - YA
Dialogue: 0,0:01:26.96,0:01:29.38,sign,,0000,0000,0000,,‎KOTAK MAKAN SIANG IKAN PUTIH\N‎NONALKOHOL
Dialogue: 0,0:04:42.94,0:04:44.49,sign,,0000,0000,0000,,{\an8}‎PENCET
Dialogue: 0,0:07:17.39,0:07:19.52,sign,,0000,0000,0000,,‎SUPER S
Dialogue: 0,0:07:25.40,0:07:27.32,sign,,0000,0000,0000,,{\an8}‎RUMAH SAKIT MEMORIAL ORAKA
Dialogue: 0,0:07:27.40,0:07:29.82,sign,,0000,0000,0000,,‎KEBIASAAN SEHAT UNTUK KESEHATAN
Dialogue: 0,0:07:53.43,0:07:55.34,sign,,0000,0000,0000,,‎SASAKI-SAN\N‎HASIL PEMERIKSAAN
Dialogue: 0,0:08:08.61,0:08:09.61,sign,,0000,0000,0000,,‎SANGAT SEHAT
Dialogue: 0,0:08:48.86,0:08:50.78,sign,,0000,0000,0000,,‎MEJA LAYANAN
Dialogue: 0,0:08:50.86,0:08:51.86,sign,,0000,0000,0000,,‎MENJUAL ROKOK
Dialogue: 0,0:10:10.15,0:10:12.06,sign,,0000,0000,0000,,‎BUKA 24 JAM - SUPER S
Dialogue: 0,0:14:48.38,0:14:51.26,sign,,0000,0000,0000,,{\an8}‎DELAPAN TAHUN LALU\N‎SUPER FRESH MARKET
Dialogue: 0,0:18:53.75,0:18:55.50,sign,,0000,0000,0000,,{\an8}‎SUPER-FRESH MARKET
Dialogue: 0,0:18:56.63,0:18:58.63,sign,,0000,0000,0000,,‎BUKA 24 JAM
Dialogue: 0,0:20:20.34,0:20:22.51,sign,,0000,0000,0000,,‎SELALU MELAYANI DENGAN SENYUM
Dialogue: 0,0:22:12.08,0:22:13.74,sign,,0000,0000,0000,,‎DILARANG MEROKOK
Dialogue: 0,0:22:13.83,0:22:17.25,sign,,0000,0000,0000,,‎PENJUALAN APRESIASI SUPER S
Dialogue: 0,0:00:06.38,0:00:10.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sudah waktunya.{\i0}
Dialogue: 0,0:00:11.21,0:00:14.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dan pada usiaku, ini makin menyeramkan.{\i0}
Dialogue: 0,0:00:14.26,0:00:15.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Pemeriksaan kesehatan tahunan.{\i0}
Dialogue: 0,0:00:18.18,0:00:19.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa yang terjadi?
Dialogue: 0,0:00:19.43,0:00:23.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tahun lalu, hasilmu tak ada\N‎yang di bawah C.
Dialogue: 0,0:00:23.85,0:00:26.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa kau punya masalah kesehatan?
Dialogue: 0,0:00:27.44,0:00:29.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kadar asam urat dan trigliserida…
Dialogue: 0,0:00:29.48,0:00:31.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, kondisi lazim\N‎pada orang bagian penjualan.
Dialogue: 0,0:00:31.78,0:00:33.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi!
Dialogue: 0,0:00:33.61,0:00:36.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tahun ini akan berbeda.
Dialogue: 0,0:00:36.16,0:00:39.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Karena istriku yang cantik, Keiko,\N‎membuatkanku makan siang yang sehat
Dialogue: 0,0:00:39.49,0:00:42.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎sejak pemeriksaan kesehatan tahun lalu.
Dialogue: 0,0:00:43.91,0:00:45.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jreng!
Dialogue: 0,0:00:47.13,0:00:48.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Banyak sekali makanannya…
Dialogue: 0,0:00:48.92,0:00:51.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎"Semoga beruntung!" Terima kasih.
Dialogue: 0,0:00:53.38,0:00:56.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Wow, itu baru cinta.
Dialogue: 0,0:00:56.30,0:00:58.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lihat?
Dialogue: 0,0:00:58.43,0:01:00.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan karena dia begitu mencintaiku,
Dialogue: 0,0:01:00.85,0:01:03.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku mengurangi alkohol dan rokok\N‎sampai pemeriksaan kesehatan.
Dialogue: 0,0:01:03.98,0:01:05.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih makanannya, Sayang.
Dialogue: 0,0:01:05.44,0:01:08.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tunggu, aku mengerti soal alkohol,\N‎tapi rokok juga?
Dialogue: 0,0:01:08.44,0:01:09.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:01:09.86,0:01:13.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku harus hidup lama dan sehat\N‎bersama Keiko-chan tersayang.
Dialogue: 0,0:01:20.78,0:01:23.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Harus kunyah sampai halus sebelum menelan.
Dialogue: 0,0:01:29.46,0:01:31.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Totalnya 1.160 yen.
Dialogue: 0,0:01:32.09,0:01:33.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baik.
Dialogue: 0,0:01:37.47,0:01:39.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini kembaliannya.
Dialogue: 0,0:01:41.51,0:01:42.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan juga…
Dialogue: 0,0:01:43.72,0:01:48.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bir nonalkohol ini produk baru,\N‎jadi kau dapat kupon jika mau.
Dialogue: 0,0:01:49.85,0:01:51.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih.
Dialogue: 0,0:01:51.98,0:01:54.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sebentar lagi ada\N‎pemeriksaan kesehatan tahunan,
Dialogue: 0,0:01:54.57,0:01:57.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎jadi kupikir aku harus kurangi alkohol.
Dialogue: 0,0:01:57.70,0:01:58.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini akan membantu.
Dialogue: 0,0:01:58.99,0:02:00.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Oh?{\i0}
Dialogue: 0,0:03:46.26,0:03:47.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Halo, Tayama-san.
Dialogue: 0,0:03:48.06,0:03:52.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa ini? Kau merokok\N‎padahal akan ada pemeriksaan kesehatan?
Dialogue: 0,0:03:53.81,0:03:55.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagaimana kau tahu?
Dialogue: 0,0:03:57.40,0:03:59.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau dengar dari Yamada-san.
Dialogue: 0,0:03:59.44,0:04:02.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya. Benar. Aku dengar dari Yamada-san.
Dialogue: 0,0:04:02.82,0:04:04.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Lamban-saki.{\i0}
Dialogue: 0,0:04:04.78,0:04:06.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benar.
Dialogue: 0,0:04:06.70,0:04:08.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pemeriksaannya sebentar lagi.
Dialogue: 0,0:04:08.49,0:04:11.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mungkin tak terlihat,\N‎tapi seharian aku mengurangi merokok.
Dialogue: 0,0:04:12.71,0:04:13.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf mengganggu.
Dialogue: 0,0:04:13.92,0:04:17.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Menguranginya, ya? Aku yakin\N‎kau hanya "mengurangi" satu atau dua.
Dialogue: 0,0:04:19.21,0:04:20.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benar.
Dialogue: 0,0:04:27.10,0:04:30.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa karyawan supermarket\N‎juga dapat pemeriksaan kesehatan tahunan?
Dialogue: 0,0:04:30.64,0:04:34.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya. Sepertinya punyaku sebentar lagi.
Dialogue: 0,0:04:35.56,0:04:39.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau juga mengurangi\N‎untuk persiapan pemeriksaan kesehatanmu?
Dialogue: 0,0:04:39.82,0:04:41.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa aku mengurangi?
Dialogue: 0,0:04:45.07,0:04:46.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku hanya akan seruput kuahnya sesuap.
Dialogue: 0,0:04:47.82,0:04:48.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tentu saja.
Dialogue: 0,0:04:49.03,0:04:50.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Wow!
Dialogue: 0,0:04:50.58,0:04:53.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kesehatan adalah aset penting.
Dialogue: 0,0:04:53.62,0:04:56.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak bisa bekerja jika tak jaga diri.
Dialogue: 0,0:04:56.25,0:04:58.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mengagumkan sekali.
Dialogue: 0,0:04:58.08,0:05:00.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau sangat keren, Tayama-san.
Dialogue: 0,0:05:00.30,0:05:03.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Seandainya aku bisa lebih sepertimu.
Dialogue: 0,0:05:04.17,0:05:06.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku bahkan tak bisa berhenti minum bir.
Dialogue: 0,0:05:06.43,0:05:08.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku hanya tunda yang akan terjadi.
Dialogue: 0,0:05:08.09,0:05:11.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selain itu, banyak sekali\N‎makanannya hari ini?
Dialogue: 0,0:05:11.72,0:05:15.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya. Setiap tahun, dokternya memintaku
Dialogue: 0,0:05:15.48,0:05:17.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎untuk menaikkan berat badan.
Dialogue: 0,0:05:18.77,0:05:22.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi sepertinya berat badan tubuhku\N‎tak mau naik.
Dialogue: 0,0:05:23.61,0:05:25.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Andai menaikkan berat badan itu mudah.
Dialogue: 0,0:05:26.07,0:05:27.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Hei.\N‎- Wah!
Dialogue: 0,0:05:27.74,0:05:28.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada apa?
Dialogue: 0,0:05:29.03,0:05:31.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau benar. Kau sangat kurus.
Dialogue: 0,0:05:32.41,0:05:33.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-san?
Dialogue: 0,0:05:33.49,0:05:37.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kami punya makanan siap saji yang lezat.\N‎Makanlah itu, kau akan gemuk.
Dialogue: 0,0:05:38.62,0:05:40.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baik. Terima kasih.
Dialogue: 0,0:05:42.00,0:05:46.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi aku masih belum bisa berhenti lakukan\N‎yang paling buruk untuk kesehatan.
Dialogue: 0,0:05:46.17,0:05:48.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku benar-benar hanya menunda\N‎yang akan terjadi.
Dialogue: 0,0:05:48.63,0:05:50.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu benar.
Dialogue: 0,0:05:52.14,0:05:55.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi bagaimana jika dokternya\N‎menyuruhmu berhenti merokok?
Dialogue: 0,0:05:56.43,0:05:58.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau akan berhenti?
Dialogue: 0,0:06:01.73,0:06:03.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu…
Dialogue: 0,0:06:04.69,0:06:06.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Berhenti…
Dialogue: 0,0:06:06.19,0:06:08.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tak akan mudah…
Dialogue: 0,0:06:10.36,0:06:11.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Karena…
Dialogue: 0,0:06:12.45,0:06:13.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Manajerku…\N‎- Bosmu?
Dialogue: 0,0:06:15.04,0:06:16.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selalu memarahimu.
Dialogue: 0,0:06:18.54,0:06:20.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya. Bagaimana lagi aku menghadapi itu?
Dialogue: 0,0:06:22.67,0:06:24.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku mengerti.
Dialogue: 0,0:06:24.38,0:06:26.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sepertinya aku juga tak bisa.
Dialogue: 0,0:06:26.13,0:06:28.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak tahu harus bagaimana\N‎jika aku harus berhenti.
Dialogue: 0,0:06:32.01,0:06:33.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau pasti bisa.
Dialogue: 0,0:06:35.06,0:06:38.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu dia. Sekarang tubuhmu sangat sehat.
Dialogue: 0,0:06:45.36,0:06:46.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Terima kasih.{\i0}
Dialogue: 0,0:06:48.11,0:06:50.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Pembicaraan tentang "mengurangi" ini.{\i0}
Dialogue: 0,0:06:50.20,0:06:52.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku jelas terlalu memikirkannya.{\i0}
Dialogue: 0,0:06:52.78,0:06:55.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Rasanya sekarang aku akhirnya sadar.{\i0}
Dialogue: 0,0:06:56.58,0:06:58.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Semua itu berkat Tayama-san.{\i0}
Dialogue: 0,0:07:00.62,0:07:03.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi bagaimana jika kau harus\N‎berhenti merokok?{\i0}
Dialogue: 0,0:07:08.92,0:07:12.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kalau begitu, tentu saja,\N‎aku akan berhenti.{\i0}
Dialogue: 0,0:07:55.43,0:07:57.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hore!
Dialogue: 0,0:07:57.43,0:08:01.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kadar asam urat dan trigliseridaku\N‎di bawah rata-rata. Nilaiku A!
Dialogue: 0,0:08:02.48,0:08:05.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Apa? Kenapa berat badanku naik\N‎sejak tahun lalu?
Dialogue: 0,0:08:05.81,0:08:08.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Siapa peduli!\N‎Aku harus beri tahu Keiko-chan!
Dialogue: 0,0:08:09.69,0:08:12.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Cekrek! Kau harus beri tahu\N‎hasilmu padaku nanti.
Dialogue: 0,0:08:12.78,0:08:14.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan merokok!
Dialogue: 0,0:08:22.37,0:08:23.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei.
Dialogue: 0,0:08:24.42,0:08:26.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagaimana pemeriksaan kesehatanmu?
Dialogue: 0,0:08:30.34,0:08:33.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada apa? Bosmu bermasalah lagi?
Dialogue: 0,0:08:33.22,0:08:34.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukan.
Dialogue: 0,0:08:34.84,0:08:37.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yang bermasalah adalah tubuhku.
Dialogue: 0,0:08:39.10,0:08:40.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-san, um…
Dialogue: 0,0:08:42.14,0:08:45.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Merokok sangat buruk\N‎untuk kesehatan, kau tahu?
Dialogue: 0,0:08:51.94,0:08:56.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Paru-paru Sasaki-kun harus diperiksa\N‎dan dia harus dirawat?
Dialogue: 0,0:08:57.03,0:08:58.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Turut prihatin mendengarnya.
Dialogue: 0,0:08:59.12,0:09:01.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, dia bilang\N‎dia harus berhenti merokok.
Dialogue: 0,0:09:01.79,0:09:03.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Harus.
Dialogue: 0,0:09:05.25,0:09:07.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada apa, Yamada?
Dialogue: 0,0:09:08.04,0:09:11.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sekarang dia tak punya alasan\N‎untuk mampir ke belakang.
Dialogue: 0,0:09:14.55,0:09:15.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yamada.
Dialogue: 0,0:09:16.09,0:09:19.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Katakanlah Sasaki-kun melihat sisi baru\N‎mengejutkan dari orang yang dia kenal.
Dialogue: 0,0:09:20.39,0:09:22.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa dia bisa mengatasinya?
Dialogue: 0,0:09:22.93,0:09:24.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tentu saja bisa.
Dialogue: 0,0:09:25.14,0:09:29.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau begitu, katakan ini,\N‎"Aku wanita dari kasir dua."
Dialogue: 0,0:09:30.57,0:09:32.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dengan begitu,\N‎dia tak butuh alasan untuk mampir.
Dialogue: 0,0:09:34.69,0:09:38.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tentu, versi idealnya tentang dirimu\N‎akan hilang,
Dialogue: 0,0:09:39.24,0:09:42.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tapi dia akan merangkul\N‎dirimu yang sebenarnya.
Dialogue: 0,0:09:44.75,0:09:47.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, Yamada. Kau mendengarkan…
Dialogue: 0,0:09:47.79,0:09:49.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Permisi.\N‎- Ya?
Dialogue: 0,0:09:49.08,0:09:50.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selamat datang!
Dialogue: 0,0:09:50.67,0:09:52.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku ingin membungkus kado.
Dialogue: 0,0:09:52.75,0:09:54.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Membungkus kado? Tentu saja.
Dialogue: 0,0:09:58.72,0:10:00.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tahu dia benar.{\i0}
Dialogue: 0,0:10:02.39,0:10:03.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi kenapa…{\i0}
Dialogue: 0,0:10:07.31,0:10:09.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa aku masih takut?{\i0}
Dialogue: 0,0:10:15.15,0:10:17.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Akhirnya aku punya waktu.{\i0}
Dialogue: 0,0:10:18.07,0:10:20.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Mungkin aku akan ke rumah sakit besok.{\i0}
Dialogue: 0,0:10:25.41,0:10:27.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku akan berpamitan dengannya lain kali.{\i0}
Dialogue: 0,0:10:33.63,0:10:34.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-san?
Dialogue: 0,0:10:34.88,0:10:36.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau sibuk?
Dialogue: 0,0:10:37.21,0:10:38.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak juga?
Dialogue: 0,0:10:38.92,0:10:40.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau begitu, ikutlah denganku.
Dialogue: 0,0:10:51.40,0:10:54.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Merokok saja, Tayama-san.
Dialogue: 0,0:10:54.44,0:10:56.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Untuk terakhir kalinya,
Dialogue: 0,0:10:57.36,0:11:00.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku ingin taruh rokok di mulut,\N‎seakan rokokmu adalah rokokku.
Dialogue: 0,0:11:00.28,0:11:01.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah.
Dialogue: 0,0:11:10.79,0:11:13.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau benar-benar akan berhenti merokok?
Dialogue: 0,0:11:14.13,0:11:15.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak bisa bilang aku tak takut.
Dialogue: 0,0:11:16.46,0:11:17.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa menurutmu aku bisa?
Dialogue: 0,0:11:18.96,0:11:20.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan tanya aku.
Dialogue: 0,0:11:24.26,0:11:25.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-san.
Dialogue: 0,0:11:27.97,0:11:31.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih telah memanggilku.
Dialogue: 0,0:11:33.23,0:11:37.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kita mungkin tak punya kesempatan\N‎untuk bicara seperti ini lagi.
Dialogue: 0,0:11:38.53,0:11:41.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi jika aku melihatmu di toko, aku…
Dialogue: 0,0:11:42.82,0:11:43.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan katakan.
Dialogue: 0,0:11:45.41,0:11:46.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sasaki-san.
Dialogue: 0,0:11:47.45,0:11:49.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sebenarnya…
Dialogue: 0,0:11:54.63,0:11:55.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf!
Dialogue: 0,0:11:55.75,0:11:56.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Angkatlah.
Dialogue: 0,0:11:56.92,0:11:57.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baik.
Dialogue: 0,0:11:59.88,0:12:01.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Halo? Ini Sasaki.
Dialogue: 0,0:12:02.43,0:12:04.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:12:04.64,0:12:05.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pemeriksaan kesehatanku?
Dialogue: 0,0:12:06.30,0:12:09.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, aku berencana datang besok.
Dialogue: 0,0:12:10.77,0:12:11.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:12:13.39,0:12:15.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baik. Mengerti.
Dialogue: 0,0:12:17.02,0:12:18.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sampai jumpa.
Dialogue: 0,0:12:30.74,0:12:32.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mereka salah.
Dialogue: 0,0:12:34.29,0:12:38.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mereka bilang organku\N‎terlihat bagus untuk orang seusiaku.
Dialogue: 0,0:12:41.92,0:12:43.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf!
Dialogue: 0,0:12:44.68,0:12:46.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagus untukmu.
Dialogue: 0,0:12:46.68,0:12:48.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf, Tayama-san!
Dialogue: 0,0:12:48.97,0:12:51.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Ya. Bagus sekali.\N‎- Maaf aku membuatmu khawatir.
Dialogue: 0,0:12:51.81,0:12:54.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Bagus sekali. Sungguh.\N‎- Aku benar-benar minta maaf.
Dialogue: 0,0:12:55.60,0:12:57.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi itu bagus, 'kan?
Dialogue: 0,0:12:58.86,0:13:02.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kita masih bisa merokok bersama.
Dialogue: 0,0:13:07.91,0:13:12.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oh, Tayama-san. Kau hendak bilang sesuatu?
Dialogue: 0,0:13:12.24,0:13:13.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf aku menyelamu.
Dialogue: 0,0:13:14.37,0:13:15.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ingin kau katakan?
Dialogue: 0,0:13:24.22,0:13:25.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak.
Dialogue: 0,0:13:27.18,0:13:28.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Belum saatnya.
Dialogue: 0,0:13:30.64,0:13:31.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi…
Dialogue: 0,0:13:33.56,0:13:35.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tetaplah begini untuk sementara.
Dialogue: 0,0:13:37.69,0:13:40.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi aku benci saat orang\N‎membuatku khawatir tanpa alasan.
Dialogue: 0,0:13:42.32,0:13:44.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku benar-benar minta maaf.
Dialogue: 0,0:13:44.69,0:13:47.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi terima kasih telah mengkhawatirkanku.
Dialogue: 0,0:14:03.25,0:14:04.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa ini?
Dialogue: 0,0:14:04.84,0:14:08.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau terlihat cantik\N‎seperti biasa, Yamada-san.
Dialogue: 0,0:14:08.18,0:14:11.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sebaiknya belajar darimu.
Dialogue: 0,0:14:11.43,0:14:14.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Senyummu selalu menawan, Ono-san.
Dialogue: 0,0:14:14.52,0:14:15.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benarkah?
Dialogue: 0,0:14:16.14,0:14:17.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yamada.
Dialogue: 0,0:14:18.02,0:14:20.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bisa kupotret dan mewawancaraimu?
Dialogue: 0,0:14:20.86,0:14:23.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Untuk publisitas lagi?
Dialogue: 0,0:14:24.02,0:14:26.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan menyebalkan, Yamada.
Dialogue: 0,0:14:26.74,0:14:29.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi kita baru melakukannya.
Dialogue: 0,0:14:29.45,0:14:31.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini salahmu sendiri.
Dialogue: 0,0:14:31.45,0:14:34.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau dinominasikan\N‎Penghargaan Senyum lagi tahun ini.
Dialogue: 0,0:14:34.33,0:14:35.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Astaga!
Dialogue: 0,0:14:36.20,0:14:39.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah. Ayo kita lakukan.
Dialogue: 0,0:14:40.29,0:14:41.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia pandai beradaptasi.
Dialogue: 0,0:14:42.42,0:14:45.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku rindu masa-masa\N‎saat kau tak bisa tersenyum dengan benar.
Dialogue: 0,0:14:53.85,0:14:55.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Halo… Selamat datang…
Dialogue: 0,0:14:55.51,0:14:56.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu jelek!
Dialogue: 0,0:14:57.10,0:14:58.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hah?
Dialogue: 0,0:14:58.31,0:15:00.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jelek bagaimana, Kepala?
Dialogue: 0,0:15:00.35,0:15:01.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Matamu tak tersenyum.
Dialogue: 0,0:15:01.65,0:15:03.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mulutmu kaku dan suaramu terlalu rendah.
Dialogue: 0,0:15:03.86,0:15:07.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, semuanya salah.
Dialogue: 0,0:15:07.19,0:15:09.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagus. Kau sadar.
Dialogue: 0,0:15:10.57,0:15:12.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagaimana aku bisa mengajarimu?
Dialogue: 0,0:15:12.74,0:15:15.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau karyawan yang bagus, hanya saja…
Dialogue: 0,0:15:15.49,0:15:17.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak.
Dialogue: 0,0:15:17.70,0:15:20.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Karena aku dapat keluhan\N‎tentang layanan pelanggan yang penting.
Dialogue: 0,0:15:22.58,0:15:25.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf menyulitkan.
Dialogue: 0,0:15:26.75,0:15:28.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dengar, Yamada.
Dialogue: 0,0:15:30.55,0:15:35.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Keluhan yang kau dapat\N‎semuanya dari pelanggan yang sama.
Dialogue: 0,0:15:35.85,0:15:39.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia memanfaatkanmu\N‎untuk memulai konflik dengan toko.
Dialogue: 0,0:15:39.81,0:15:42.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Biar kuatasi. Dan akan kujadikan kau\N‎ahlinya layanan pelanggan.
Dialogue: 0,0:15:43.48,0:15:45.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan cemas. Usahakan yang terbaik.
Dialogue: 0,0:15:46.94,0:15:47.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baik.
Dialogue: 0,0:15:48.94,0:15:50.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kepala sangat baik padaku.{\i0}
Dialogue: 0,0:15:51.70,0:15:55.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi aku malah membuat masalah untuknya.{\i0}
Dialogue: 0,0:15:59.12,0:16:04.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bawa ini ke meja layanan\N‎dan kau bisa tukar untuk kupon.
Dialogue: 0,0:16:04.29,0:16:06.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benarkah?
Dialogue: 0,0:16:06.88,0:16:08.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih, Bu.
Dialogue: 0,0:16:09.76,0:16:11.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih ba…
Dialogue: 0,0:16:16.43,0:16:17.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sel…
Dialogue: 0,0:16:20.47,0:16:22.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selamat datang. Kau punya poin…
Dialogue: 0,0:16:22.94,0:16:26.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau lihat itu di tanganku? Jelas aku lupa.
Dialogue: 0,0:16:27.65,0:16:28.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf.
Dialogue: 0,0:16:30.03,0:16:32.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Apa kau butuh plas…
Dialogue: 0,0:16:32.11,0:16:34.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak melihatnya di keranjang?
Dialogue: 0,0:16:34.57,0:16:36.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, jelas aku butuh.
Dialogue: 0,0:16:36.53,0:16:40.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Berapa kali harus kukatakan?\N‎Kau tak pernah belajar.
Dialogue: 0,0:16:41.33,0:16:43.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau benar. Maaf.
Dialogue: 0,0:16:44.75,0:16:46.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akan kumulai.
Dialogue: 0,0:16:46.50,0:16:47.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei!
Dialogue: 0,0:16:48.00,0:16:51.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan taruh telur lebih dulu!\N‎Bagaimana jika tertindih?
Dialogue: 0,0:16:51.88,0:16:53.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Apa masalahnya?\N‎- Kau tak tahu apa-apa?
Dialogue: 0,0:16:53.97,0:16:56.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Dia baik-baik saja?\N‎- Apa yang mereka ajarkan?
Dialogue: 0,0:16:56.47,0:17:00.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa aku akan dapat pelayanan yang sama\N‎dari semua kasir di sini?
Dialogue: 0,0:17:01.10,0:17:03.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Manajer! Kepala Goto!
Dialogue: 0,0:17:04.14,0:17:06.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pelanggan itu lagi.
Dialogue: 0,0:17:06.65,0:17:08.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia menyerang Yamada-chan.
Dialogue: 0,0:17:10.15,0:17:13.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Astaga, kau selalu\N‎terlihat bosan di kasir.
Dialogue: 0,0:17:13.24,0:17:15.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sikap kerja macam apa itu?
Dialogue: 0,0:17:16.03,0:17:18.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Jangan dengarkan, Sayang.\N‎- Kau hanya berdiri saja.
Dialogue: 0,0:17:18.53,0:17:19.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tak akan katakan apa-apa?
Dialogue: 0,0:17:20.03,0:17:21.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf, Pak.
Dialogue: 0,0:17:21.58,0:17:23.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak itu lagi!
Dialogue: 0,0:17:23.25,0:17:26.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jika kau ingin minta maaf,\N‎lakukan yang tulus.
Dialogue: 0,0:17:26.33,0:17:28.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Makanya aku tak suka\N‎pelajar yang melayani pelanggan.
Dialogue: 0,0:17:28.92,0:17:31.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Anak di minimarket sebelah\N‎juga tak berguna.
Dialogue: 0,0:17:31.59,0:17:33.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau bahkan lebih buruk lagi!
Dialogue: 0,0:17:33.42,0:17:36.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku berusaha mengajarimu,\N‎tapi kau selalu sulit didekati…
Dialogue: 0,0:17:36.68,0:17:37.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Um…
Dialogue: 0,0:17:39.55,0:17:40.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Permisi.
Dialogue: 0,0:17:44.27,0:17:45.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau berisik.
Dialogue: 0,0:17:46.89,0:17:48.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa…
Dialogue: 0,0:17:48.81,0:17:50.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa maksudmu berisik?
Dialogue: 0,0:17:50.40,0:17:53.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tak lihat aku marah\N‎pada karyawan tak kompeten ini?
Dialogue: 0,0:17:53.23,0:17:54.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, aku lihat.
Dialogue: 0,0:17:54.82,0:17:57.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku dengar semua perkataanmu,
Dialogue: 0,0:17:58.16,0:18:02.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tapi sepertinya itu sudah melenceng.
Dialogue: 0,0:18:02.91,0:18:06.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan bukankah kau selalu marah\N‎pada gadis ini?
Dialogue: 0,0:18:08.50,0:18:10.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bisa hentikan?
Dialogue: 0,0:18:11.13,0:18:13.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Ada banyak kasir kosong lain.\N‎- Ayo, Om!
Dialogue: 0,0:18:13.50,0:18:14.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Diam.
Dialogue: 0,0:18:15.09,0:18:16.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa kau selalu begini…
Dialogue: 0,0:18:19.30,0:18:21.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎saat aku di belakangmu?
Dialogue: 0,0:18:26.64,0:18:29.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Permisi, Pak. Tolong kemari.
Dialogue: 0,0:18:34.11,0:18:35.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ganti dengan Ono.
Dialogue: 0,0:18:36.69,0:18:39.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau harus istirahat.
Dialogue: 0,0:18:42.74,0:18:43.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baik.
Dialogue: 0,0:19:08.68,0:19:09.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Um…
Dialogue: 0,0:19:11.02,0:19:12.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oh, kau.
Dialogue: 0,0:19:13.19,0:19:16.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih telah membantuku.
Dialogue: 0,0:19:17.28,0:19:20.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku juga minta maaf meja kasirku\N‎selalu penuh.
Dialogue: 0,0:19:20.45,0:19:22.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak. Tak apa-apa.
Dialogue: 0,0:19:22.41,0:19:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu bukan salahmu.
Dialogue: 0,0:19:25.99,0:19:28.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu karena aku buruk\N‎dalam layanan pelanggan.
Dialogue: 0,0:19:28.83,0:19:30.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, aku minta maaf.
Dialogue: 0,0:19:35.25,0:19:39.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak berusaha membantumu.
Dialogue: 0,0:19:41.38,0:19:44.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku mengalami hari yang buruk di kantorku.
Dialogue: 0,0:19:45.43,0:19:47.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan aku frustrasi.
Dialogue: 0,0:19:48.10,0:19:50.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lalu dia mulai meneriakimu.
Dialogue: 0,0:19:56.19,0:20:00.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kupikir, "Beraninya dia meneriaki\N‎gadis yang selalu membantuku?"
Dialogue: 0,0:20:01.24,0:20:03.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu membuatku marah,\N‎jadi aku mengonfrontasinya.
Dialogue: 0,0:20:04.03,0:20:05.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku membantumu?
Dialogue: 0,0:20:05.66,0:20:07.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:20:07.16,0:20:08.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau cepat dan sopan.
Dialogue: 0,0:20:09.33,0:20:12.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi aku hanya karyawan\N‎yang sulit didekati dan ceroboh…
Dialogue: 0,0:20:13.50,0:20:14.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau pikir kau ceroboh?
Dialogue: 0,0:20:15.46,0:20:17.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi kulihat kau selalu berusaha.
Dialogue: 0,0:20:23.51,0:20:26.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Setidaknya, aku harus cepat.{\i0}
Dialogue: 0,0:20:32.52,0:20:34.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa ini tak mudah bagiku?{\i0}
Dialogue: 0,0:20:40.03,0:20:41.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hah? Apa kau…
Dialogue: 0,0:20:44.99,0:20:46.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf!
Dialogue: 0,0:20:46.32,0:20:48.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau menangis! Apa karena perkataanku?
Dialogue: 0,0:20:48.53,0:20:49.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak menangis.
Dialogue: 0,0:20:49.83,0:20:52.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hanya air mengalir dari mataku.
Dialogue: 0,0:20:52.91,0:20:53.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Air?
Dialogue: 0,0:20:54.50,0:20:56.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Katamu aku berusaha.
Dialogue: 0,0:20:57.00,0:21:01.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi bagaimana kau tahu itu saat aku\N‎masih payah dalam layanan pelanggan?
Dialogue: 0,0:21:02.38,0:21:05.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lalu ada orang aneh yang menggangguku
Dialogue: 0,0:21:06.59,0:21:09.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎dan itu menyebabkan masalah\N‎bagi semua orang…
Dialogue: 0,0:21:12.14,0:21:13.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku ingin menjadi lebih baik.
Dialogue: 0,0:21:14.48,0:21:16.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku suka pekerjaanku.
Dialogue: 0,0:21:16.85,0:21:18.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku benci ini.
Dialogue: 0,0:21:20.77,0:21:22.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau suka pekerjaanmu?
Dialogue: 0,0:21:27.03,0:21:28.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau begitu, semua akan baik.
Dialogue: 0,0:21:32.33,0:21:34.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selama kau terus menikmati pekerjaanmu,
Dialogue: 0,0:21:35.21,0:21:39.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎apa pun yang kau butuhkan untuk sukses\N‎akan bisa kau dapatkan.
Dialogue: 0,0:21:52.35,0:21:53.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau baik-baik saja?
Dialogue: 0,0:21:54.52,0:21:55.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu.
Dialogue: 0,0:21:55.93,0:21:58.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Asapnya masuk ke mataku.
Dialogue: 0,0:21:58.69,0:22:00.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf! Aku terlalu dekat padamu.
Dialogue: 0,0:22:02.23,0:22:04.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Kau baik-baik saja? Apa yang terjadi?
Dialogue: 0,0:22:05.32,0:22:08.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau terlalu mencemaskan semuanya.
Dialogue: 0,0:22:17.96,0:22:20.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah, semua yang perlu kudengar\N‎sudah kudengar.
Dialogue: 0,0:22:21.04,0:22:22.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Wawancaranya selesai.
Dialogue: 0,0:22:22.84,0:22:24.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau bisa istirahat sekarang.
Dialogue: 0,0:22:24.71,0:22:27.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Hei, Manajer?\N‎- Ya?
Dialogue: 0,0:22:27.72,0:22:30.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau ingat di supermarket kita yang lama
Dialogue: 0,0:22:30.14,0:22:34.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎ada orang yang membelaku\N‎dari pria yang selalu mengeluh tentangku?
Dialogue: 0,0:22:34.72,0:22:39.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tahu berapa banyak perkelahian\N‎yang kulihat dalam pekerjaanku?
Dialogue: 0,0:22:40.23,0:22:42.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak mungkin aku ingat itu.
Dialogue: 0,0:22:43.94,0:22:46.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku juga tak ingat seperti apa wajahnya.{\i0}
Dialogue: 0,0:22:48.40,0:22:52.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku ingat dia suka merokok di pintu\N‎dalam perjalanan pulang.{\i0}
Dialogue: 0,0:22:53.37,0:22:56.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku ingat rambutnya berantakan\N‎dan kausnya usang dan lecek.{\i0}
Dialogue: 0,0:22:56.29,0:22:58.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dan di bawah matanya ada lingkaran hitam.{\i0}
Dialogue: 0,0:23:03.50,0:23:06.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Seseorang mengeluh tentang asbak\N‎di depan pintu dan kami membuangnya.{\i0}
Dialogue: 0,0:23:06.88,0:23:08.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sejak itu, aku tak pernah melihatnya lagi.{\i0}
Dialogue: 0,0:23:11.47,0:23:14.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kira-kira dia merokok di mana sekarang?{\i0}
Dialogue: 0,0:23:30.24,0:23:35.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terjemahan subtitle oleh Rahayu Kinasih
