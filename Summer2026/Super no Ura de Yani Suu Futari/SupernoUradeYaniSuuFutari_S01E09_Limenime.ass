Dialogue: 0,0:00:01.00,0:00:02.45,sign,,0000,0000,0000,,‎BAR UMUM
Dialogue: 0,0:01:35.72,0:01:36.80,sign,,0000,0000,0000,,‎PENGGEMAR NO. 28
Dialogue: 0,0:02:02.62,0:02:03.91,sign,,0000,0000,0000,,‎EMPAT MUSIM IBU RUMAH TANGGA
Dialogue: 0,0:05:04.26,0:05:06.68,sign,,0000,0000,0000,,‎BUKA 24 JAM - SUPER S
Dialogue: 0,0:05:54.35,0:05:55.85,sign,,0000,0000,0000,,{\an8}‎OTAK YAMADA MELEBIH-LEBIHKAN
Dialogue: 0,0:07:23.52,0:07:26.02,sign,,0000,0000,0000,,‎BEBERAPA HARI KEMUDIAN
Dialogue: 0,0:07:36.66,0:07:39.58,sign,,0000,0000,0000,,‎DIA MASIH MUDA\N‎DAN AKU ASAL BICARA SAJA
Dialogue: 0,0:07:39.58,0:07:42.33,sign,,0000,0000,0000,,‎DIA MASIH MUDA\N‎DAN AKU TAK SENGAJA MENYENTUHNYA
Dialogue: 0,0:08:40.06,0:08:42.14,sign,,0000,0000,0000,,‎KARENA TAK SENSITIF\N‎KEPADA ORANG YANG LEBIH MUDA
Dialogue: 0,0:11:15.75,0:11:18.25,sign,,0000,0000,0000,,‎BUKA 24 JAM - SUPER S
Dialogue: 0,0:12:17.98,0:12:19.07,sign,,0000,0000,0000,,‎KERUPUK BERAS LEZAT
Dialogue: 0,0:14:20.44,0:14:22.36,sign,,0000,0000,0000,,‎TERKIKIK
Dialogue: 0,0:19:05.35,0:19:06.35,sign,,0000,0000,0000,,{\an8}‎ALARM PUKUL 05.30.
Dialogue: 0,0:19:06.93,0:19:08.43,sign,,0000,0000,0000,,‎ALARM PUKUL 06.00
Dialogue: 0,0:19:08.43,0:19:09.85,sign,,0000,0000,0000,,‎TUNDA\N‎BERHENTI
Dialogue: 0,0:19:13.69,0:19:15.61,sign,,0000,0000,0000,,‎PUKUL 06.00 - ALARM PUKUL 05.30
Dialogue: 0,0:20:23.26,0:20:25.05,sign,,0000,0000,0000,,{\an8}‎PUKUL 06.00 - ALARM PUKUL 05.30
Dialogue: 0,0:20:25.05,0:20:26.68,sign,,0000,0000,0000,,‎KERUPUK BERAS LEZAT
Dialogue: 0,0:00:02.46,0:00:03.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bersulang!
Dialogue: 0,0:00:03.75,0:00:05.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Untuk Tim Konter Layanan!
Dialogue: 0,0:00:05.79,0:00:10.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Untuk pesta semoga beruntung\N‎dalam reservasi hadiah akhir tahun!
Dialogue: 0,0:00:10.05,0:00:11.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hore.
Dialogue: 0,0:00:11.30,0:00:13.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak mau.
Dialogue: 0,0:00:14.09,0:00:15.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau bilang begitu, Zawa,
Dialogue: 0,0:00:16.39,0:00:19.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tapi kau memastikan semua orang\N‎bisa lakukan konter layanan tahun ini,
Dialogue: 0,0:00:19.72,0:00:21.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎jadi bukankah itu akan lancar?
Dialogue: 0,0:00:21.43,0:00:23.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tentu saja!
Dialogue: 0,0:00:23.06,0:00:26.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Siapa pun bisa menggantikan\N‎yang tak hadir.
Dialogue: 0,0:00:26.23,0:00:29.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau pelatih hebat, Kepala Maezawa.
Dialogue: 0,0:00:30.61,0:00:32.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu benar.
Dialogue: 0,0:00:32.65,0:00:35.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau sangat haus, 'kan, Ono-san?
Dialogue: 0,0:00:35.28,0:00:38.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya! Dia masih tukang minum No. 1\N‎Cabang Stasiun Moromoro.
Dialogue: 0,0:00:38.37,0:00:40.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau ingin bir lagi? Mungkin camilan?
Dialogue: 0,0:00:40.87,0:00:43.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Astaga. Memalukan.
Dialogue: 0,0:00:43.12,0:00:44.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Itu bukan "tak sengaja".{\i0}
Dialogue: 0,0:00:45.92,0:00:49.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau pasti sangat mengagumi pria itu.
Dialogue: 0,0:00:51.38,0:00:53.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Akhir-akhir ini…{\i0}
Dialogue: 0,0:00:53.59,0:00:57.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akhir-akhir ini kau makin suka merokok,\N‎ya, 'kan, Yamada-chan?
Dialogue: 0,0:01:00.31,0:01:02.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau baru sadar?
Dialogue: 0,0:01:02.39,0:01:05.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia suka makanan, bir, dan rokok.
Dialogue: 0,0:01:06.98,0:01:10.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Melihatmu merokok\N‎membuatku ingin merokok lagi.
Dialogue: 0,0:01:11.52,0:01:14.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi kau benar. Merokok sangat\N‎menyenangkan akhir-akhir ini.
Dialogue: 0,0:01:14.86,0:01:17.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Berkat penggemarku itu.
Dialogue: 0,0:01:18.53,0:01:20.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei. Maksudmu Sasaki-kun, 'kan, Yamada?
Dialogue: 0,0:01:20.91,0:01:22.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tak mau ceritakan?
Dialogue: 0,0:01:23.91,0:01:25.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak.
Dialogue: 0,0:01:25.16,0:01:27.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sasaki-kun?
Dialogue: 0,0:01:27.71,0:01:30.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maksudmu, pegawai kantoran\N‎yang tinggi, kurus, dan sopan itu?
Dialogue: 0,0:01:30.84,0:01:31.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:01:32.88,0:01:35.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maksudmu, Penggemar Yamada No. 28?
Dialogue: 0,0:01:36.80,0:01:38.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Halo. Aku Sasaki.
Dialogue: 0,0:01:38.59,0:01:40.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itulah orangnya.
Dialogue: 0,0:01:40.14,0:01:43.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia pelanggan yang baik.
Dialogue: 0,0:01:43.10,0:01:47.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku suka melayaninya karena dia selalu\N‎berterima kasih untuk semuanya.
Dialogue: 0,0:01:47.94,0:01:50.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bisa pesan bir ukuran besar lagi?
Dialogue: 0,0:01:51.73,0:01:56.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak banyak pelanggan\N‎yang dapat persetujuan Yamada-chan.
Dialogue: 0,0:01:56.61,0:01:59.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagus sekali, pria yang sudah menikah!
Dialogue: 0,0:02:00.99,0:02:02.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kereta api?
Dialogue: 0,0:02:03.91,0:02:04.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Majalah musiman?
Dialogue: 0,0:02:06.12,0:02:08.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pria yang sudah menikah?
Dialogue: 0,0:03:45.68,0:03:48.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa kau bilang begitu?\N‎Kau punya bukti apa?
Dialogue: 0,0:03:48.60,0:03:51.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau yakin tak sedang berkhayal?
Dialogue: 0,0:03:51.56,0:03:53.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tenang, Yamada. Tenang.
Dialogue: 0,0:03:53.44,0:03:56.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi aku melihatnya sendiri!
Dialogue: 0,0:03:56.02,0:03:58.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎No. 28 memakai cincin kawin.
Dialogue: 0,0:03:59.40,0:04:02.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku jaga kasir dua saat kau sedang libur.
Dialogue: 0,0:04:02.70,0:04:06.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎No. 28 datang dengan wanita lain, dan…{\i0}
Dialogue: 0,0:04:06.57,0:04:08.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Biar aku yang bayar.
Dialogue: 0,0:04:08.28,0:04:11.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak apa-apa. Sudah lama.
Dialogue: 0,0:04:11.96,0:04:12.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:04:14.08,0:04:17.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Nom… Maksudku,\N‎sepertinya ada yang sudah menikah.
Dialogue: 0,0:04:20.71,0:04:24.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu benar. Apa sudah sepuluh tahun?
Dialogue: 0,0:04:24.97,0:04:26.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau ingat.
Dialogue: 0,0:04:26.43,0:04:28.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tentu saja aku ingat.
Dialogue: 0,0:04:28.10,0:04:31.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Astaga, dengan istri secantik dia di rumah
Dialogue: 0,0:04:31.81,0:04:34.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎dan Yamada-chan\N‎di supermarket dekat rumahnya,
Dialogue: 0,0:04:34.19,0:04:36.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎kehidupannya pasti menyenangkan!
Dialogue: 0,0:04:36.35,0:04:39.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, Zawa.\N‎Kau terus mengatakan hal aneh, dan…
Dialogue: 0,0:04:40.19,0:04:43.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, Yamada. Duduk. Kau baik-baik saja?
Dialogue: 0,0:04:43.78,0:04:44.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku baik-baik saja.
Dialogue: 0,0:04:45.49,0:04:48.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa aku peduli\N‎pada kehidupan pribadi pelanggan kita?
Dialogue: 0,0:04:48.57,0:04:54.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan pria seusianya sudah sewajarnya\N‎pernah menikah sekali atau dua kali.
Dialogue: 0,0:04:56.83,0:04:58.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Yamada.{\i0}
Dialogue: 0,0:04:58.50,0:05:01.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Itu berarti dia pernah bercerai.{\i0}
Dialogue: 0,0:05:07.39,0:05:08.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selamat datang.
Dialogue: 0,0:05:10.35,0:05:14.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Suasana hatinya buruk saat kita minum.
Dialogue: 0,0:05:14.35,0:05:16.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Syukurlah dia kembali seperti semula.
Dialogue: 0,0:05:16.94,0:05:19.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau percaya itu, Zawa?
Dialogue: 0,0:05:20.61,0:05:22.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa tidak?
Dialogue: 0,0:05:22.44,0:05:23.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sifat Yamada…
Dialogue: 0,0:05:23.78,0:05:28.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Makin kesal dia, makin ceria dia di kasir.
Dialogue: 0,0:05:28.66,0:05:31.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Itu tak mengubah apa pun.{\i0}
Dialogue: 0,0:05:31.41,0:05:34.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Fakta bahwa dia sudah menikah\N‎tak mengubah apa pun.{\i0}
Dialogue: 0,0:05:35.04,0:05:39.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Pria yang sudah menikah\N‎boleh punya selebritas favorit.{\i0}
Dialogue: 0,0:05:39.08,0:05:41.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Itu hak mereka.{\i0}
Dialogue: 0,0:05:41.04,0:05:47.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Pria yang sudah menikah boleh ikut merokok\N‎setelah kerja jika diajak.{\i0}
Dialogue: 0,0:05:48.47,0:05:51.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Astaga, dengan istri secantik dia di rumah
Dialogue: 0,0:05:51.22,0:05:54.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎dan wanita yang merokok dengannya,\N‎kehidupannya pasti menyenangkan!
Dialogue: 0,0:05:58.48,0:06:02.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Halo? Permisi.
Dialogue: 0,0:06:04.44,0:06:05.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu dia!
Dialogue: 0,0:06:07.20,0:06:08.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tentu saja. Selamat datang.
Dialogue: 0,0:06:09.36,0:06:11.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Kau punya kartu poin?\N‎- Ya.
Dialogue: 0,0:06:16.08,0:06:21.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, kadang kau memakainya,\N‎kadang kau menyimpannya di rumah.
Dialogue: 0,0:06:21.08,0:06:25.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Maaf, tapi apa yang kau…
Dialogue: 0,0:06:25.80,0:06:29.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tanganmu. Tangan kirimu.\N‎Kau tak memakainya hari ini.
Dialogue: 0,0:06:29.97,0:06:31.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tanganku?
Dialogue: 0,0:06:31.14,0:06:33.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oh, itu?
Dialogue: 0,0:06:34.35,0:06:38.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku hanya tak ingin itu hilang atau rusak,
Dialogue: 0,0:06:38.14,0:06:40.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎jadi aku tak terlalu suka memakainya.
Dialogue: 0,0:06:40.85,0:06:42.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bahkan rekan kerjaku menegurku
Dialogue: 0,0:06:42.48,0:06:45.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎karena itu seharusnya selalu dipakai.
Dialogue: 0,0:06:46.11,0:06:48.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi itu sangat penting bagiku, jadi…
Dialogue: 0,0:06:50.74,0:06:53.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Begitu! Manis sekali.
Dialogue: 0,0:06:53.74,0:06:55.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau ingin memakai poinmu?
Dialogue: 0,0:06:55.45,0:06:57.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:06:57.62,0:07:02.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Keluargaku selalu menyuruhku\N‎memakai poinku sebelum kedaluwarsa.
Dialogue: 0,0:07:03.25,0:07:04.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Begitu.
Dialogue: 0,0:07:06.75,0:07:08.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih banyak.
Dialogue: 0,0:07:09.38,0:07:10.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih.
Dialogue: 0,0:07:12.59,0:07:15.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jadi, aku tak pernah bertanya\N‎dan dia tak pernah bercerita?{\i0}
Dialogue: 0,0:07:15.56,0:07:17.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia tak berusaha menyembunyikannya dariku?{\i0}
Dialogue: 0,0:07:18.98,0:07:21.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ini tak mengubah apa pun.{\i0}
Dialogue: 0,0:07:21.77,0:07:23.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ini tak mengubah apa pun.{\i0}
Dialogue: 0,0:07:26.02,0:07:29.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku terlalu sibuk\N‎untuk mampir akhir-akhir ini.{\i0}
Dialogue: 0,0:07:29.99,0:07:32.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sudah lama.\N‎Aku ingin merokok dengan Tayama-san.{\i0}
Dialogue: 0,0:07:33.41,0:07:36.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jika dipikir-pikir,\N‎aku tak melihatnya sejak saat itu.{\i0}
Dialogue: 0,0:07:42.92,0:07:45.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jika dipikir-pikir,\N‎aku jadi agak khawatir.{\i0}
Dialogue: 0,0:07:45.92,0:07:49.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Semoga dia baik-baik saja.{\i0}
Dialogue: 0,0:07:49.80,0:07:53.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Orang bilang kau baru merasakannya\N‎setelah semua terjadi.{\i0}
Dialogue: 0,0:07:53.89,0:07:57.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pak tua itu membuatku kesal\N‎akhir-akhir ini.
Dialogue: 0,0:07:58.26,0:08:01.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Satu kesalahan dari pria tua sepertiku,{\i0}
Dialogue: 0,0:08:01.93,0:08:04.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎hanya butuh satu momen\N‎untukku menyakiti seseorang.{\i0}
Dialogue: 0,0:08:05.52,0:08:06.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bagaimanapun juga{\i0}‎…
Dialogue: 0,0:08:14.74,0:08:17.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-san. Halo. Sudah la…
Dialogue: 0,0:08:19.58,0:08:22.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia menghindariku?{\i0}
Dialogue: 0,0:08:22.33,0:08:25.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku benar-benar membuatnya kesal.{\i0}
Dialogue: 0,0:08:26.42,0:08:28.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Gara-gara yang kulakukan saat itu…{\i0}
Dialogue: 0,0:08:29.38,0:08:32.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-san. Aku harus minta maaf padamu.
Dialogue: 0,0:08:35.09,0:08:37.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau harus minta maaf?
Dialogue: 0,0:08:37.93,0:08:40.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya. Harus kulakukan dengan benar.
Dialogue: 0,0:08:44.73,0:08:46.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-san?
Dialogue: 0,0:08:47.19,0:08:49.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jika kau merasa harus minta maaf,
Dialogue: 0,0:08:49.61,0:08:52.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎apa artinya kau merasa bersalah\N‎karena sesuatu?
Dialogue: 0,0:08:52.94,0:08:55.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, tentu saja.
Dialogue: 0,0:08:55.53,0:08:57.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sangat khawatir.
Dialogue: 0,0:08:58.45,0:08:59.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak mau.
Dialogue: 0,0:09:00.74,0:09:05.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Minta maaf berarti kau salah.
Dialogue: 0,0:09:07.63,0:09:12.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lupakanlah. Pulang saja.
Dialogue: 0,0:09:13.38,0:09:15.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kepada istrimu.
Dialogue: 0,0:09:20.51,0:09:21.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-san.
Dialogue: 0,0:09:22.52,0:09:25.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku lajang.
Dialogue: 0,0:09:33.48,0:09:37.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi kau belanja bersama wanita\N‎dan pakai cincin di jarimu.
Dialogue: 0,0:09:37.66,0:09:39.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Cincin?
Dialogue: 0,0:09:39.07,0:09:40.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bersama wanita?
Dialogue: 0,0:09:42.41,0:09:44.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu adikku.
Dialogue: 0,0:09:46.00,0:09:49.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Cincinnya punya suaminya.
Dialogue: 0,0:09:49.04,0:09:53.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kami berasal dari Mie\N‎dan dia datang untuk mengunjungiku.
Dialogue: 0,0:09:53.67,0:09:55.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia bilang mereka beli cincin baru
Dialogue: 0,0:09:55.67,0:09:57.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎dan dia memasangkan yang lama ke jariku.
Dialogue: 0,0:09:57.80,0:09:59.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kujadikan kau pria yang sudah menikah.
Dialogue: 0,0:09:59.84,0:10:02.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak perlu!
Dialogue: 0,0:10:02.31,0:10:05.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia memang aneh.
Dialogue: 0,0:10:05.18,0:10:08.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi Yamada-san bilang…
Dialogue: 0,0:10:09.06,0:10:11.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎kau memakai sesuatu yang penting.
Dialogue: 0,0:10:12.40,0:10:13.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu?
Dialogue: 0,0:10:15.99,0:10:17.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maksudku, jam tanganku.
Dialogue: 0,0:10:18.20,0:10:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hadiah dari kolega senior dulu sekali\N‎dan ini sangat penting bagiku.
Dialogue: 0,0:10:24.66,0:10:25.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau serius?
Dialogue: 0,0:10:29.12,0:10:31.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Astaga, aku bodoh.
Dialogue: 0,0:10:39.47,0:10:40.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:10:41.05,0:10:42.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak, maaf.
Dialogue: 0,0:10:43.55,0:10:45.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu hanya sangat lucu.
Dialogue: 0,0:10:45.77,0:10:47.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau pikir aku punya istri?
Dialogue: 0,0:10:50.77,0:10:52.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tahu apa artinya?
Dialogue: 0,0:10:52.73,0:10:56.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Artinya kau pengertian\N‎kepadaku dan istri khayalanku.
Dialogue: 0,0:10:56.86,0:10:58.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau sangat pengertian.
Dialogue: 0,0:11:01.70,0:11:03.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei. Apa?
Dialogue: 0,0:11:04.12,0:11:06.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-san? Hei…
Dialogue: 0,0:11:07.24,0:11:10.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Cepat merokok.
Dialogue: 0,0:11:11.00,0:11:12.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baik.
Dialogue: 0,0:11:18.26,0:11:21.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎No. 28 belum menikah?
Dialogue: 0,0:11:22.26,0:11:25.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Wow, membingungkan sekali orang itu.
Dialogue: 0,0:11:25.72,0:11:27.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukan "Wow". Ini semua salahmu.
Dialogue: 0,0:11:27.47,0:11:30.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan sebar rumor tentang pelanggan kita.
Dialogue: 0,0:11:30.81,0:11:34.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf. Aku jahat sekali padamu,\N‎Yamada-chan.
Dialogue: 0,0:11:34.81,0:11:35.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf.
Dialogue: 0,0:11:37.82,0:11:39.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sudah kubilang. Tak apa-apa.
Dialogue: 0,0:11:39.40,0:11:43.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kehidupan pribadi pelanggan kita\N‎bukan urusanku.
Dialogue: 0,0:11:43.11,0:11:44.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benarkah?
Dialogue: 0,0:11:45.16,0:11:48.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Walaupun kau pakai nama "Tayama"\N‎dan merokok di belakang bersamanya?
Dialogue: 0,0:11:50.16,0:11:52.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sepertinya itu sangat penting bagimu.
Dialogue: 0,0:11:53.62,0:11:54.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Manajer?
Dialogue: 0,0:11:54.71,0:11:57.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukan aku. Aku tak bilang apa-apa.
Dialogue: 0,0:11:57.46,0:12:00.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku juga tak bilang pada siapa-siapa,\N‎jadi santai saja.
Dialogue: 0,0:12:00.97,0:12:03.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau pandai simpan rahasia, Zawa.
Dialogue: 0,0:12:03.55,0:12:06.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hal seperti ini selalu sangat seru!
Dialogue: 0,0:12:19.07,0:12:23.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ono-san. Penggemarku, Sasaki,\N‎ternyata lajang.
Dialogue: 0,0:12:23.99,0:12:26.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Begitu?
Dialogue: 0,0:12:26.74,0:12:27.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:12:28.24,0:12:31.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Harus kutanggapi bagaimana?{\i0}
Dialogue: 0,0:12:31.58,0:12:35.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sejujurnya, hanya dia yang peduli.{\i0}
Dialogue: 0,0:12:36.71,0:12:39.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan dia ternyata dari Prefektur Mie.
Dialogue: 0,0:12:40.59,0:12:41.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Wow.
Dialogue: 0,0:12:42.63,0:12:45.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Prefektur Mie? Orang sana punya aksen.
Dialogue: 0,0:12:45.63,0:12:48.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benarkah?
Dialogue: 0,0:12:48.39,0:12:50.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:12:50.68,0:12:54.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Salah satu teman ibuku dari Prefektur Mie.
Dialogue: 0,0:12:54.81,0:12:57.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aksennya sesekali suka muncul\N‎dan itu sangat lucu.
Dialogue: 0,0:12:58.02,0:13:00.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aksennya mirip dengan aksen Kansai, 'kan?
Dialogue: 0,0:13:00.94,0:13:02.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, benar.
Dialogue: 0,0:13:07.16,0:13:08.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benarkah?
Dialogue: 0,0:13:11.16,0:13:13.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei. Coba tunjukkan aksen Mie-mu.
Dialogue: 0,0:13:17.08,0:13:18.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Halo juga.
Dialogue: 0,0:13:19.00,0:13:20.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf, aku tak begitu…
Dialogue: 0,0:13:20.50,0:13:22.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Katakan sesuatu dengan aksen Mie-mu.
Dialogue: 0,0:13:22.92,0:13:27.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Katamu adikmu mengunjungimu\N‎dari Mie, 'kan?
Dialogue: 0,0:13:27.22,0:13:28.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oh, ya.
Dialogue: 0,0:13:28.97,0:13:30.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, kau dari Mie, 'kan?
Dialogue: 0,0:13:30.97,0:13:32.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:13:32.06,0:13:34.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kudengar aksennya lucu.
Dialogue: 0,0:13:34.10,0:13:35.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Katakan sesuatu.
Dialogue: 0,0:13:35.23,0:13:37.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bicaranya cepat sekali.{\i0}
Dialogue: 0,0:13:37.06,0:13:41.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak berpikir itu "lucu".
Dialogue: 0,0:13:51.33,0:13:52.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, Tayama-san…
Dialogue: 0,0:13:53.58,0:13:55.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan tertawa.
Dialogue: 0,0:13:55.25,0:13:56.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oke.
Dialogue: 0,0:13:57.37,0:13:59.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi…
Dialogue: 0,0:14:00.17,0:14:04.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak bisa pikirkan\N‎jika ditanya mendadak.
Dialogue: 0,0:14:04.55,0:14:07.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini agak memalukan, ta?
Dialogue: 0,0:14:07.97,0:14:09.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎"Ta"?
Dialogue: 0,0:14:09.47,0:14:13.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Adikku masih tinggal di sana,\N‎jadi aksennya lebih kuat.
Dialogue: 0,0:14:13.81,0:14:16.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi seperti yang kau lihat,\N‎aksenku agak berkurang.
Dialogue: 0,0:14:17.18,0:14:20.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, maaf jika aksenku\N‎tak seperti yang kau…
Dialogue: 0,0:14:22.36,0:14:24.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tertawa!
Dialogue: 0,0:14:24.23,0:14:26.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak tertawa.
Dialogue: 0,0:14:27.61,0:14:30.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tertawa. Aku bisa dengar dari suaramu.
Dialogue: 0,0:14:32.16,0:14:33.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak mengejekmu.
Dialogue: 0,0:14:34.45,0:14:36.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku hanya berpikir itu lucu.
Dialogue: 0,0:14:37.91,0:14:39.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎"Ta".
Dialogue: 0,0:14:39.00,0:14:43.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tak bisa hanya\N‎mengakhiri kalimatmu dengan "ta".
Dialogue: 0,0:14:43.42,0:14:44.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa begitu, ta?
Dialogue: 0,0:14:44.63,0:14:45.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-san!
Dialogue: 0,0:14:47.13,0:14:48.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Astaga.
Dialogue: 0,0:14:48.80,0:14:51.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayolah. Pakai lagi jaketmu.
Dialogue: 0,0:14:51.18,0:14:53.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau akan kena flu jika berpakaian…
Dialogue: 0,0:14:55.51,0:14:57.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi kau yang bersin.
Dialogue: 0,0:14:57.39,0:14:58.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf.
Dialogue: 0,0:15:00.14,0:15:01.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Flu?
Dialogue: 0,0:15:01.27,0:15:05.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak, aku jarang kena flu.
Dialogue: 0,0:15:05.11,0:15:08.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku hanya sering bersin\N‎saat suhunya dingin.
Dialogue: 0,0:15:08.07,0:15:11.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan sebagai penjual,\N‎kau harus sering berjalan di luar seharian
Dialogue: 0,0:15:11.91,0:15:14.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ditambah lagi, kau merokok di sini\N‎di malam hari yang dingin?
Dialogue: 0,0:15:15.58,0:15:19.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi sepertinya ini karena hal lain.
Dialogue: 0,0:15:20.83,0:15:22.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benarkah?
Dialogue: 0,0:15:22.21,0:15:26.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akhir-akhir ini,\N‎aku sering merokok di pagi hari.
Dialogue: 0,0:15:27.09,0:15:28.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Di pagi hari?
Dialogue: 0,0:15:29.09,0:15:31.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Seperti sekitar pukul 06.00.
Dialogue: 0,0:15:31.30,0:15:32.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terdengar dingin.
Dialogue: 0,0:15:32.72,0:15:35.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya. Itu sangat dingin.
Dialogue: 0,0:15:35.97,0:15:38.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi aku merokok di jendela yang terbuka.
Dialogue: 0,0:15:39.77,0:15:42.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa kau tak menjaga tubuhmu?
Dialogue: 0,0:15:44.69,0:15:46.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kelihatannya memang begitu.
Dialogue: 0,0:15:48.36,0:15:53.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu metode yang kupelajari\N‎saat aku pulang ke rumah saat kuliah.
Dialogue: 0,0:15:54.49,0:15:58.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau mempelajarinya dari seseorang, ta?
Dialogue: 0,0:15:59.62,0:16:02.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Seseorang yang kupacari. Dia menekanku.
Dialogue: 0,0:16:02.46,0:16:04.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Makanya aku merokok…
Dialogue: 0,0:16:06.59,0:16:09.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu sungguh tak sopan, Tayama-san.
Dialogue: 0,0:16:11.42,0:16:13.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku mengetahuinya sendiri.
Dialogue: 0,0:16:13.93,0:16:16.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku suka merokok sendirian.
Dialogue: 0,0:16:17.10,0:16:18.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sendirian?
Dialogue: 0,0:16:21.89,0:16:26.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Pagi hari di musim dingin sangat sunyi.{\i0}
Dialogue: 0,0:16:27.31,0:16:31.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sangat sunyi sampai aku bisa mendengar\N‎suara gemertak rokokku.{\i0}
Dialogue: 0,0:16:35.45,0:16:37.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku suka itu.
Dialogue: 0,0:16:39.16,0:16:41.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Di kampung halamanku, saat aku kuliah,{\i0}
Dialogue: 0,0:16:42.00,0:16:46.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎bahkan lebih bagus lagi\N‎karena tanahnya akan tertutup salju.{\i0}
Dialogue: 0,0:16:47.63,0:16:52.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Rasanya aku seperti\N‎manusia terakhir di Bumi.{\i0}
Dialogue: 0,0:16:53.38,0:16:54.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Pemikiran yang menyeramkan.{\i0}
Dialogue: 0,0:16:56.55,0:17:00.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi di saat yang sama,\N‎itu juga menyenangkan.{\i0}
Dialogue: 0,0:17:03.68,0:17:05.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bisa kau bayangkan?
Dialogue: 0,0:17:11.03,0:17:14.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku masih bayangkan bagaimana\N‎Prefektur Mie turun banyak salju.
Dialogue: 0,0:17:16.16,0:17:18.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Di sana memang sangat bersalju.
Dialogue: 0,0:17:18.70,0:17:22.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, kau selalu merokok seperti itu\N‎di musim dingin? Sejak kuliah?
Dialogue: 0,0:17:23.58,0:17:29.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak. Setelah aku bekerja,\N‎aku lebih suka tidur.
Dialogue: 0,0:17:29.17,0:17:31.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi aku teringat\N‎dan berpikir untuk mencobanya lagi.
Dialogue: 0,0:17:31.84,0:17:35.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Merokok sangat menyenangkan\N‎akhir-akhir ini.
Dialogue: 0,0:17:40.01,0:17:45.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan hasil pemeriksaan kesehatanku bagus,\N‎jadi aman bagiku melakukannya.
Dialogue: 0,0:17:46.64,0:17:48.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baguslah.
Dialogue: 0,0:17:48.10,0:17:54.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu salah satu alasannya,\N‎tapi selain itu aku sibuk bekerja.
Dialogue: 0,0:17:54.53,0:17:57.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kurasa aku memang pilek.
Dialogue: 0,0:17:58.86,0:18:01.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi kau bilang pakaianku terlalu tipis.
Dialogue: 0,0:18:03.08,0:18:05.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya. Maaf.
Dialogue: 0,0:18:05.37,0:18:10.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, jika kau bisa merokok denganku,\N‎berarti pekerjaanmu sudah berkurang?
Dialogue: 0,0:18:10.63,0:18:12.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:18:12.13,0:18:14.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Besok hari liburku setelah sekian lama.
Dialogue: 0,0:18:14.67,0:18:18.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku berpikir mungkin\N‎akan bangun pagi dan merokok.
Dialogue: 0,0:18:18.26,0:18:21.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi kau harus tidur di hari liburmu.
Dialogue: 0,0:18:21.39,0:18:22.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak apa-apa.
Dialogue: 0,0:18:22.81,0:18:26.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan merokok, lalu saat semua\N‎orang bangun, aku akan kembali tidur.
Dialogue: 0,0:18:26.89,0:18:29.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku bisa menikmati keduanya.
Dialogue: 0,0:18:29.52,0:18:31.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sebaiknya pasang alarm.
Dialogue: 0,0:18:38.03,0:18:41.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mungkin aku juga akan coba.
Dialogue: 0,0:18:41.28,0:18:42.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Cobalah.
Dialogue: 0,0:18:43.87,0:18:48.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi apa tak masalah?\N‎Kau bisa bangun tepat waktu?
Dialogue: 0,0:18:51.67,0:18:53.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf. Maksudku bukan itu.
Dialogue: 0,0:18:53.34,0:18:57.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau mungkin tak bisa bangun pagi\N‎karena kau bekerja malam.
Dialogue: 0,0:18:57.51,0:18:58.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tentu saja aku bisa.
Dialogue: 0,0:19:01.64,0:19:05.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aku akan bangun pagi. Kau sebaiknya juga.
Dialogue: 0,0:19:11.23,0:19:13.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Diamlah.
Dialogue: 0,0:19:18.82,0:19:21.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku hanya sedikit kesiangan.
Dialogue: 0,0:19:32.17,0:19:33.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dingin sekali.
Dialogue: 0,0:19:34.25,0:19:35.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sial.
Dialogue: 0,0:20:27.93,0:20:30.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Suasana hatiku bagus,\N‎lalu aku minum dan sekarang begini.{\i0}
Dialogue: 0,0:20:38.61,0:20:42.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa Tayama-san juga merokok sekarang?{\i0}
Dialogue: 0,0:20:42.74,0:20:45.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Padahal kau tak yakin aku bisa bangun.
Dialogue: 0,0:20:53.33,0:20:54.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dingin sekali.
Dialogue: 0,0:20:56.88,0:21:01.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Semoga dia tak kena flu\N‎karena pagi ini dingin.{\i0}
Dialogue: 0,0:21:02.76,0:21:07.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Pakaiannya biasanya tipis.{\i0}
Dialogue: 0,0:21:08.93,0:21:12.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku agak khawatir karena dia suka\N‎memperlihatkan perutnya.{\i0}
Dialogue: 0,0:21:12.68,0:21:17.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Hentikan. Ingat dia marah padamu\N‎saat kau khawatir tanpa sebab.{\i0}
Dialogue: 0,0:21:17.77,0:21:20.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku serius. Berhenti berpikir begitu.{\i0}
Dialogue: 0,0:21:23.53,0:21:26.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mungkin aku juga akan coba.
Dialogue: 0,0:21:29.07,0:21:33.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kira-kira apa yang akan dia katakan\N‎saat kita bertemu lagi?{\i0}
Dialogue: 0,0:21:36.58,0:21:38.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎"Itu menyenangkan juga."{\i0}
Dialogue: 0,0:21:38.54,0:21:40.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎"Tak buruk."{\i0}
Dialogue: 0,0:21:40.54,0:21:41.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Komentar pendek.{\i0}
Dialogue: 0,0:21:42.34,0:21:46.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi aku tetap ingin mendengarnya.{\i0}
Dialogue: 0,0:21:49.22,0:21:50.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bodoh sekali.{\i0}
Dialogue: 0,0:21:51.64,0:21:55.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku bilang aku suka merasa\N‎seperti sendirian di dunia,{\i0}
Dialogue: 0,0:21:55.06,0:21:56.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎tapi yang kulakukan sejak tadi…{\i0}
Dialogue: 0,0:22:11.95,0:22:14.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini menyenangkan juga.
Dialogue: 0,0:23:34.83,0:23:39.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terjemahan subtitle oleh Rahayu Kinasih
