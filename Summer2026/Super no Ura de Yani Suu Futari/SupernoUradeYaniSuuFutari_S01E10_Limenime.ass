Dialogue: 0,0:00:01.00,0:00:03.42,sign,,0000,0000,0000,,{\an8}‎STASIUN MOROMORO
Dialogue: 0,0:00:43.54,0:00:44.75,sign,,0000,0000,0000,,{\an8}‎MOROMORO GINZA
Dialogue: 0,0:03:49.27,0:03:50.35,sign,,0000,0000,0000,,‎MENGHARGAI
Dialogue: 0,0:03:55.27,0:03:58.27,sign,,0000,0000,0000,,‎SANGAT TERSENTUH
Dialogue: 0,0:04:31.60,0:04:32.72,sign,,0000,0000,0000,,‎DUA ORANG DIBILANG RAMAI?
Dialogue: 0,0:11:12.04,0:11:14.46,sign,,0000,0000,0000,,{\an8}‎DISKON SPESIAL HARI INI\N‎BUKA 24 JAM - SUPER S
Dialogue: 0,0:13:25.42,0:13:27.01,sign,,0000,0000,0000,,‎DAIKON LEZAT - CACAT\N‎SATU ORANG SATU
Dialogue: 0,0:13:36.77,0:13:39.56,sign,,0000,0000,0000,,‎SS\N‎PASAR SEGAR-SUPER
Dialogue: 0,0:13:39.56,0:13:41.06,sign,,0000,0000,0000,,‎WANITA TANGGUH YANG SEMPURNA
Dialogue: 0,0:14:19.44,0:14:20.65,sign,,0000,0000,0000,,‎WAHA
Dialogue: 0,0:14:35.12,0:14:38.12,sign,,0000,0000,0000,,{\an8}‎JERUK
Dialogue: 0,0:14:38.12,0:14:39.83,sign,,0000,0000,0000,,‎KANTOR
Dialogue: 0,0:15:02.77,0:15:04.44,sign,,0000,0000,0000,,{\an8}‎UMAOH\N‎AYAM & KECAP ASIN
Dialogue: 0,0:16:12.97,0:16:14.93,sign,,0000,0000,0000,,{\an8}‎APA ADA YANG SEDANG KAU PIKIRKAN?\N‎BERSIKAP BIASA
Dialogue: 0,0:17:42.72,0:17:44.35,sign,,0000,0000,0000,,{\an8}‎LAPORAN BULANAN\N‎TOKO STASIUN MOROMORO - OBATA
Dialogue: 0,0:21:59.73,0:22:01.23,sign,,0000,0000,0000,,‎PENANGKAP DI KEBUN MELON
Dialogue: 0,0:00:13.13,0:00:15.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Semua orang menyambut Natal.{\i0}
Dialogue: 0,0:00:16.18,0:00:17.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tunggu…{\i0}
Dialogue: 0,0:00:18.01,0:00:20.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku dinas kantor tanpa henti{\i0}
Dialogue: 0,0:00:20.52,0:00:23.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎dan berkeliling mengucapkan\N‎selamat akhir tahun baru…{\i0}
Dialogue: 0,0:00:24.02,0:00:27.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tanpa kusadari, dunia berjalan tanpaku…{\i0}
Dialogue: 0,0:00:28.40,0:00:30.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku jadi ingat…{\i0}
Dialogue: 0,0:00:31.36,0:00:35.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hore! Aku akan adakan pesta Natal\N‎bersama istri dan putriku tahun ini.
Dialogue: 0,0:00:35.70,0:00:36.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jingle bell!{\i0}
Dialogue: 0,0:00:37.62,0:00:43.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tak seperti Suzuki, aku tak punya\N‎rencana apa-apa untuk Natal.{\i0}
Dialogue: 0,0:00:44.75,0:00:47.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Aku yakin kasirnya akan penuh malam ini.{\i0}
Dialogue: 0,0:00:56.97,0:01:00.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sepertinya ada yang menjatuhkan jeruk.{\i0}
Dialogue: 0,0:01:01.14,0:01:03.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa jatuh dari kantong belanja seseorang\N‎saat pulang?{\i0}
Dialogue: 0,0:01:07.81,0:01:08.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak marah!
Dialogue: 0,0:01:08.94,0:01:11.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak apa-apa kau menjatuhkan semuanya.
Dialogue: 0,0:01:12.48,0:01:15.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, tolong tinggalkan aku!
Dialogue: 0,0:01:18.03,0:01:21.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak akan pulang jika begini.
Dialogue: 0,0:01:21.16,0:01:24.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sementara semua orang\N‎pulang dengan semangat Natal.
Dialogue: 0,0:01:24.66,0:01:30.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bekerja lembur saat Natal…\N‎Dunia berjalan tanpaku!
Dialogue: 0,0:01:30.29,0:01:31.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku paham perasaanmu.{\i0}
Dialogue: 0,0:01:33.25,0:01:36.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa ini selalu terjadi padaku?
Dialogue: 0,0:01:36.26,0:01:38.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sangat bodoh. Bodoh!
Dialogue: 0,0:01:39.26,0:01:41.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku ingin pulang!
Dialogue: 0,0:01:42.10,0:01:45.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Walaupun aku tak akan\N‎melakukan apa pun di rumah…
Dialogue: 0,0:01:46.02,0:01:47.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Permisi.
Dialogue: 0,0:01:48.73,0:01:52.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Haruskah kutaruh jeruknya di kardus itu?
Dialogue: 0,0:03:32.54,0:03:33.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih.
Dialogue: 0,0:03:34.96,0:03:40.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau membuang waktumu untukku,\N‎bahkan mengotori mantelmu untukku.
Dialogue: 0,0:03:40.05,0:03:43.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak. Bangunlah. Itu bukan hal besar.
Dialogue: 0,0:03:45.76,0:03:49.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pasti sulit menjual jeruk di musim dingin.
Dialogue: 0,0:03:50.35,0:03:53.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih atas kerja kerasmu.
Dialogue: 0,0:03:58.27,0:03:59.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baik, silakan lanjutkan.
Dialogue: 0,0:03:59.94,0:04:01.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak, tunggu!
Dialogue: 0,0:04:02.90,0:04:07.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tak akan merokok\N‎di belakang malam ini?
Dialogue: 0,0:04:07.28,0:04:10.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa katamu?
Dialogue: 0,0:04:10.79,0:04:12.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagaimana kau tahu?
Dialogue: 0,0:04:13.92,0:04:17.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku juga merokok…
Dialogue: 0,0:04:18.29,0:04:22.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan aku melihat kalian berdua… bersama…
Dialogue: 0,0:04:23.88,0:04:29.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak suka keramaian di tempat sempit,\N‎jadi aku menghindari kalian.
Dialogue: 0,0:04:30.43,0:04:31.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oke?
Dialogue: 0,0:04:32.73,0:04:34.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Keramaian?{\i0}
Dialogue: 0,0:04:34.10,0:04:40.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau perwakilan penjualan untuk…\N‎bumbu atau semacamnya, 'kan?
Dialogue: 0,0:04:40.73,0:04:44.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kupikir kau ingin merokok sebelum pergi…
Dialogue: 0,0:04:45.03,0:04:46.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf…
Dialogue: 0,0:04:52.41,0:04:54.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Canggung sekali.{\i0}
Dialogue: 0,0:04:54.71,0:04:57.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak pernah merasa secanggung ini\N‎sejak berpapasan dengan manajer.{\i0}
Dialogue: 0,0:04:58.75,0:05:02.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku bahkan bohong kepadanya.{\i0}
Dialogue: 0,0:05:02.09,0:05:04.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benar. Aku bekerja di penjualan.
Dialogue: 0,0:05:04.92,0:05:06.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sudah kuduga.
Dialogue: 0,0:05:06.72,0:05:10.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Maafkan aku, Tayama-san.\N‎Sekarang aku harus bagaimana?{\i0}
Dialogue: 0,0:05:10.05,0:05:11.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oh, um…
Dialogue: 0,0:05:13.06,0:05:17.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa boleh aku bertanya… siapa namamu, Pak?
Dialogue: 0,0:05:17.40,0:05:20.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Namaku?
Dialogue: 0,0:05:20.48,0:05:22.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sasaki.
Dialogue: 0,0:05:22.53,0:05:23.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sasaki-san?
Dialogue: 0,0:05:23.86,0:05:27.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku… Obata.
Dialogue: 0,0:05:28.36,0:05:33.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku kepala bagian makanan segar…\N‎Itulah minatku…
Dialogue: 0,0:05:33.66,0:05:34.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Minatmu?{\i0}
Dialogue: 0,0:05:34.91,0:05:36.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Memangnya kita sedang kencan\N‎dan membahas hobi?{\i0}
Dialogue: 0,0:05:36.79,0:05:39.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau kepala bagian makanan segar?
Dialogue: 0,0:05:39.92,0:05:41.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mengesankan untuk orang semuda kau.
Dialogue: 0,0:05:43.09,0:05:45.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sama sekali tak mengesankan.
Dialogue: 0,0:05:45.26,0:05:49.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku hanya sudah lama bekerja di sini…\N‎hingga aku dipromosikan.
Dialogue: 0,0:05:49.76,0:05:51.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan disepelekan.
Dialogue: 0,0:05:53.06,0:05:57.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Omong-omong, akan kau apakan jeruknya?
Dialogue: 0,0:05:58.02,0:06:02.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akan… kubersihkan kulitnya,
Dialogue: 0,0:06:02.90,0:06:05.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎lalu kumasukkan ke kantong untuk dijual.
Dialogue: 0,0:06:05.49,0:06:08.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Kau mengepaknya sendiri?
Dialogue: 0,0:06:08.91,0:06:13.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kami bisa menawarkan harga\N‎yang lebih murah karena beli banyak.
Dialogue: 0,0:06:15.08,0:06:19.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tahu jeruk kami lebih murah\N‎dan enak daripada di tempat lain.
Dialogue: 0,0:06:19.04,0:06:20.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Wah!
Dialogue: 0,0:06:20.67,0:06:23.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku bisa tahu kau sangat berkomitmen.
Dialogue: 0,0:06:23.75,0:06:25.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu keren.
Dialogue: 0,0:06:25.80,0:06:28.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak! Itu bukan komitmen.
Dialogue: 0,0:06:28.97,0:06:31.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lebih seperti aku harus menebusnya…
Dialogue: 0,0:06:31.84,0:06:32.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Menebusnya?
Dialogue: 0,0:06:34.39,0:06:35.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:06:41.65,0:06:45.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku dapat banyak keluhan\N‎soal layanan pelangganku.
Dialogue: 0,0:06:46.78,0:06:49.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku besar dan sangat pemalu.{\i0}
Dialogue: 0,0:06:49.53,0:06:54.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Itu selalu jadi masalah\N‎di mana pun aku bekerja.{\i0}
Dialogue: 0,0:06:55.99,0:06:56.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi…{\i0}
Dialogue: 0,0:06:58.96,0:07:02.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎ada orang di sini yang sangat kuhormati.{\i0}
Dialogue: 0,0:07:02.58,0:07:05.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Meski baginya aku amat membuat repot,{\i0}
Dialogue: 0,0:07:05.59,0:07:08.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎dia bilang ada banyak hal\N‎yang bisa kulakukan,{\i0}
Dialogue: 0,0:07:08.26,0:07:13.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎dan aku harus fokus pada itu.{\i0}
Dialogue: 0,0:07:19.60,0:07:24.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Makanya aku suka mengusulkan\N‎banyak ide untuk menjual.
Dialogue: 0,0:07:24.86,0:07:27.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Untuk menjual dan meningkatkan\N‎reputasi toko.
Dialogue: 0,0:07:28.44,0:07:35.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Karena aku ingin dia berpikir aku layak\N‎walaupun aku merepotkannya.
Dialogue: 0,0:07:37.45,0:07:41.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Wah, dengarkan ocehanku.
Dialogue: 0,0:07:42.00,0:07:45.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sebaiknya berlatih\N‎kemampuan layanan pelangganku dulu, 'kan?
Dialogue: 0,0:07:45.63,0:07:48.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Belum tentu aku bisa menjual lebih banyak…
Dialogue: 0,0:07:51.17,0:07:52.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau pasti bisa, Obata-san.
Dialogue: 0,0:07:54.47,0:07:59.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Setelah dia melihat usahamu,
Dialogue: 0,0:07:59.06,0:08:01.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku yakin dia akan sangat senang.
Dialogue: 0,0:08:02.98,0:08:05.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pak Penjual!
Dialogue: 0,0:08:05.77,0:08:07.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Obata-san!\N‎Hati-hati air matamu kena rokok!
Dialogue: 0,0:08:11.11,0:08:13.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah! Aku akan berusaha keras!
Dialogue: 0,0:08:13.91,0:08:15.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pak Penjual.
Dialogue: 0,0:08:15.87,0:08:19.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih telah meluangkan waktu\N‎untuk bicara dengan orang sepertiku.
Dialogue: 0,0:08:19.45,0:08:21.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sama-sama.
Dialogue: 0,0:08:21.50,0:08:24.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan terus… berusaha keras.
Dialogue: 0,0:08:24.50,0:08:25.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah.
Dialogue: 0,0:08:25.58,0:08:27.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku permisi!
Dialogue: 0,0:08:27.71,0:08:28.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Semoga beruntung.
Dialogue: 0,0:08:28.79,0:08:30.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pak Penjual.
Dialogue: 0,0:08:30.05,0:08:34.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jika kau mau lagi, aku…
Dialogue: 0,0:08:34.47,0:08:36.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia bilang apa?
Dialogue: 0,0:08:39.39,0:08:42.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Anak malang itu sangat pemalu,\N‎tapi dia sepertinya baik.{\i0}
Dialogue: 0,0:08:42.81,0:08:46.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Gawat, sekarang aku hampir berkaca-kaca.{\i0}
Dialogue: 0,0:08:52.57,0:08:53.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku suka itu.{\i0}
Dialogue: 0,0:08:54.36,0:08:57.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku suka anak\N‎yang bekerja sungguh-sungguh.{\i0}
Dialogue: 0,0:08:58.16,0:09:00.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Mengingatkanku pada orang lain\N‎di masa lalu.{\i0}
Dialogue: 0,0:09:05.50,0:09:06.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ha?{\i0}
Dialogue: 0,0:09:07.12,0:09:09.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Omong-omong{\i0}‎… {\i1}‎Apa yang terjadi{\i0}
Dialogue: 0,0:09:10.34,0:09:13.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎pada supermarket lama itu?{\i0}
Dialogue: 0,0:09:14.67,0:09:17.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia imut, 'kan? Obata-kun.
Dialogue: 0,0:09:18.72,0:09:20.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yamada-san?
Dialogue: 0,0:09:20.22,0:09:22.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selamat malam.
Dialogue: 0,0:09:22.47,0:09:24.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selamat malam juga.
Dialogue: 0,0:09:24.56,0:09:26.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf, aku tahu aku tak seharusnya di sini.
Dialogue: 0,0:09:26.77,0:09:31.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Aku bisa jelaskan…\N‎- Kalian sepertinya dekat.
Dialogue: 0,0:09:32.69,0:09:33.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oh, kurasa…
Dialogue: 0,0:09:34.57,0:09:37.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau orang baik, Sasaki-san.
Dialogue: 0,0:09:37.24,0:09:41.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sangat baik hingga bisa dekat\N‎dengan semua perokok di toko ini.
Dialogue: 0,0:09:41.99,0:09:45.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku yakin kau tak hanya merokok\N‎bersama Tayama-chan.
Dialogue: 0,0:09:49.63,0:09:50.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yamada-san?
Dialogue: 0,0:09:52.34,0:09:55.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku hanya ke sini\N‎untuk merokok bersama Tayama-san.
Dialogue: 0,0:09:58.59,0:09:59.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak akan pernah lupa!{\i0}
Dialogue: 0,0:10:00.34,0:10:04.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tayama-san yang mengajakku\N‎ke area merokok ini.{\i0}
Dialogue: 0,0:10:05.93,0:10:07.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Merokoklah bersamaku, Pak Tua.
Dialogue: 0,0:10:08.69,0:10:10.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-san akan mengizinkannya.
Dialogue: 0,0:10:12.65,0:10:16.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ini bukanlah tempat merokok\N‎bagi seorang pria tua asing.{\i0}
Dialogue: 0,0:10:16.53,0:10:20.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tayama-san yang memberikan hak itu.{\i0}
Dialogue: 0,0:10:20.91,0:10:23.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, kau tak ingin merokok\N‎dengan orang lain selain Tayama-chan?
Dialogue: 0,0:10:23.28,0:10:24.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak.
Dialogue: 0,0:10:24.74,0:10:28.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Saat kau melakukannya dengan Obata-kun\N‎atau manajer, itu berbeda?
Dialogue: 0,0:10:28.25,0:10:29.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:10:29.37,0:10:31.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benarkah?
Dialogue: 0,0:10:31.00,0:10:32.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kurasa itu masuk akal.
Dialogue: 0,0:10:34.00,0:10:36.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu bagus!
Dialogue: 0,0:10:42.93,0:10:44.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sasaki-san?
Dialogue: 0,0:10:44.39,0:10:45.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau baik-baik saja?
Dialogue: 0,0:10:45.85,0:10:47.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau berkeringat.
Dialogue: 0,0:10:47.89,0:10:49.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya. Aku baik-baik saja.
Dialogue: 0,0:10:50.39,0:10:52.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini hanya menopause laki-laki.
Dialogue: 0,0:10:53.06,0:10:55.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Natal ini membawa berkah bagiku…{\i0}
Dialogue: 0,0:10:56.48,0:10:57.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benarkah?
Dialogue: 0,0:10:58.44,0:10:59.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pasti sulit.
Dialogue: 0,0:11:00.15,0:11:02.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Astaga, aku tak tahan dengan pria ini!{\i0}
Dialogue: 0,0:11:02.07,0:11:03.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia mudah terpengaruh, terlalu baik,{\i0}
Dialogue: 0,0:11:03.78,0:11:06.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎lamban, kikuk, budak korporat,\N‎dan dia menopause.{\i0}
Dialogue: 0,0:11:06.37,0:11:09.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia hanya makan kerupuk beras,\N‎dia besar, dan dia penggemarku.{\i0}
Dialogue: 0,0:11:09.00,0:11:11.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku benar-benar tak tahan dengannya!{\i0}
Dialogue: 0,0:11:15.13,0:11:18.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah, Tim. Kerja bagus selama Natal.
Dialogue: 0,0:11:19.30,0:11:22.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sesuai dugaan,\N‎semua toko bagus dalam penjualan daging,
Dialogue: 0,0:11:23.34,0:11:26.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tapi berkat kerja sama semua departemen,
Dialogue: 0,0:11:26.35,0:11:28.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎penjualan di departemen lain juga tinggi.
Dialogue: 0,0:11:29.43,0:11:31.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku terutama ingin memuji…
Dialogue: 0,0:11:31.94,0:11:32.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oba.
Dialogue: 0,0:11:33.56,0:11:36.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Penjualan buah kita yang terbaik\N‎di antara toko lain.
Dialogue: 0,0:11:36.94,0:11:38.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagus!
Dialogue: 0,0:11:38.28,0:11:40.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih…
Dialogue: 0,0:11:40.07,0:11:41.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:11:42.24,0:11:44.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kerjamu bagus dengan kemampuanmu.
Dialogue: 0,0:11:45.07,0:11:47.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi jangan terlalu sering lembur.
Dialogue: 0,0:11:49.62,0:11:50.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baik.
Dialogue: 0,0:11:56.92,0:11:58.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oba.
Dialogue: 0,0:11:59.21,0:12:00.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yamada?
Dialogue: 0,0:12:00.59,0:12:03.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau kemarin merokok\N‎dengan Sasaki-san, 'kan?
Dialogue: 0,0:12:03.34,0:12:05.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:12:05.43,0:12:07.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia membantuku mengambil jeruk.
Dialogue: 0,0:12:07.64,0:12:08.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jeruk?{\i0}
Dialogue: 0,0:12:09.52,0:12:11.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia menarik, 'kan?
Dialogue: 0,0:12:12.85,0:12:15.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, dia menarik. Dia baik.
Dialogue: 0,0:12:17.77,0:12:19.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ekspresi apa itu?{\i0}
Dialogue: 0,0:12:19.94,0:12:21.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau masih mengawasinya?
Dialogue: 0,0:12:23.07,0:12:25.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan hanya mengintip\N‎dan bicaralah padanya.
Dialogue: 0,0:12:25.74,0:12:26.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ingin aku menemanimu?
Dialogue: 0,0:12:27.95,0:12:28.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak.
Dialogue: 0,0:12:37.21,0:12:41.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa yang biasanya kau bicarakan\N‎dengan perwakilan penjualan itu, Yamada?
Dialogue: 0,0:12:44.01,0:12:46.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Biasanya aku hanya menggodanya.
Dialogue: 0,0:12:48.30,0:12:50.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kau memang berbeda…
Dialogue: 0,0:13:10.53,0:13:14.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tolong serahkan laporan bulanan kalian\N‎pada akhir bulan ini.
Dialogue: 0,0:13:15.25,0:13:19.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Seperti biasa, tolong buat dengan jelas\N‎apa yang ingin kalian jual.
Dialogue: 0,0:13:20.04,0:13:22.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia hanya butuh satu tahun bekerja\N‎setelah lulus{\i0}
Dialogue: 0,0:13:23.17,0:13:25.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎untuk menjadi kepala kasir.{\i0}
Dialogue: 0,0:13:27.01,0:13:29.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Acara yang dia usulkan\N‎karena "bisnis sedang lambat"{\i0}
Dialogue: 0,0:13:30.22,0:13:32.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎dan membuat penjualan di toko\N‎naik tiga kali lipat{\i0}
Dialogue: 0,0:13:33.47,0:13:36.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎membuatnya dipromosikan\N‎ke perencanaan toko pada tahun ketiga.{\i0}
Dialogue: 0,0:13:41.07,0:13:45.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Lalu, tujuh tahun kemudian, dia kembali\N‎karena "lebih cepat dikerjakan sendiri."{\i0}
Dialogue: 0,0:13:45.57,0:13:52.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sekarang, tak ada yang tak kenal\N‎Goto si "Wanita Tangguh yang Sempurna".{\i0}
Dialogue: 0,0:13:54.33,0:13:58.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia ketus dan berwajah datar,\N‎sehingga sulit dibaca,{\i0}
Dialogue: 0,0:13:59.29,0:14:03.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎tapi dia memperhatikan para karyawannya\N‎dan kami menyukai dan menghormatinya.{\i0}
Dialogue: 0,0:14:04.34,0:14:07.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Termasuk aku.{\i0}
Dialogue: 0,0:14:08.05,0:14:10.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa Manajer pernah salah saat bekerja?
Dialogue: 0,0:14:11.43,0:14:13.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak pernah lihat.
Dialogue: 0,0:14:13.72,0:14:16.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku bahkan tak pernah lihat dia\N‎tak masuk karena sakit.
Dialogue: 0,0:14:16.98,0:14:19.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Karena Goto-senpai monster!
Dialogue: 0,0:14:21.56,0:14:24.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Manajer tak pernah menunjukkan kelemahan.{\i0}
Dialogue: 0,0:14:24.69,0:14:25.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kepada siapa pun.{\i0}
Dialogue: 0,0:14:30.16,0:14:32.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Laporan bulananku sudah selesai.{\i0}
Dialogue: 0,0:14:32.45,0:14:35.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku akan jadi yang pertama menyerahkan.{\i0}
Dialogue: 0,0:14:41.08,0:14:43.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Manajer… Maaf mengganggu…
Dialogue: 0,0:14:44.00,0:14:46.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini laporan…
Dialogue: 0,0:14:57.81,0:14:59.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa aku salah dengar?
Dialogue: 0,0:15:05.02,0:15:07.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ini pasti akan lezat.{\i0}
Dialogue: 0,0:15:10.07,0:15:11.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yamada!
Dialogue: 0,0:15:11.53,0:15:13.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada apa, Oba?
Dialogue: 0,0:15:13.20,0:15:14.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak ada orang di konter layanan?
Dialogue: 0,0:15:14.83,0:15:17.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak… Bukan itu.
Dialogue: 0,0:15:18.08,0:15:19.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lalu apa?
Dialogue: 0,0:15:19.37,0:15:21.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Manajer.
Dialogue: 0,0:15:22.79,0:15:24.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa aku boleh menceritakannya?{\i0}
Dialogue: 0,0:15:24.79,0:15:28.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa aku harus ceritakan kondisinya\N‎pada karyawannya?{\i0}
Dialogue: 0,0:15:29.97,0:15:32.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kita semua menyukai Manajer.{\i0}
Dialogue: 0,0:15:32.97,0:15:35.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jika kuceritakan berita sedih ini\N‎kepada Yamada,{\i0}
Dialogue: 0,0:15:35.47,0:15:39.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎beritanya akan menyebar\N‎dan toko ini akan berhenti beroperasi!{\i0}
Dialogue: 0,0:15:41.02,0:15:44.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jika Manajer menderita,\N‎aku juga akan menderita.
Dialogue: 0,0:15:45.06,0:15:47.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan sebagainya…
Dialogue: 0,0:15:47.07,0:15:48.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu tak boleh terjadi!
Dialogue: 0,0:15:48.48,0:15:50.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Apa dia baik-baik saja?\N‎- Dan sebagainya…
Dialogue: 0,0:15:52.70,0:15:54.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, ada apa, Oba?
Dialogue: 0,0:15:54.62,0:15:56.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada apa dengan Manajer?
Dialogue: 0,0:15:56.28,0:15:57.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak!
Dialogue: 0,0:15:58.58,0:16:00.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sebenarnya, itu bukan apa-apa.
Dialogue: 0,0:16:01.71,0:16:03.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf mengganggu saat kau sedang makan.
Dialogue: 0,0:16:03.96,0:16:06.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan terima kasih…\N‎atas semua yang telah kau lakukan untukku.
Dialogue: 0,0:16:09.00,0:16:10.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa dia akan meninggal?{\i0}
Dialogue: 0,0:16:10.97,0:16:12.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎"Apa ada yang sedang kau pikirkan…"
Dialogue: 0,0:16:14.93,0:16:17.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku akan melakukannya.{\i0}
Dialogue: 0,0:16:17.89,0:16:21.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia menjagaku dengan baik,\N‎jadi akan kutunjukkan rasa terima kasihku.{\i0}
Dialogue: 0,0:16:22.31,0:16:24.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Akan kuhilangkan kekhawatirannya!{\i0}
Dialogue: 0,0:16:24.60,0:16:28.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kumohon, Pak Penjual, berikan kekuatanmu.{\i0}
Dialogue: 0,0:16:29.32,0:16:31.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kau pasti bisa, Obata-san!{\i0}
Dialogue: 0,0:16:34.82,0:16:37.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oh, Oba. Kerja bagus.
Dialogue: 0,0:16:37.07,0:16:38.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kerja bagus, Manajer!
Dialogue: 0,0:16:42.79,0:16:44.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akhir-akhir ini…
Dialogue: 0,0:16:47.71,0:16:49.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎rasanya berat.
Dialogue: 0,0:16:49.71,0:16:52.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Manajer… Apa mungkin…
Dialogue: 0,0:16:52.13,0:16:54.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa ada yang sedang kau pikirkan?
Dialogue: 0,0:16:56.89,0:16:58.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa kau bertanya?
Dialogue: 0,0:16:58.10,0:17:00.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Seperti kau selalu memperhatikan kami,
Dialogue: 0,0:17:00.97,0:17:04.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎kami juga selalu memperhatikanmu.
Dialogue: 0,0:17:04.69,0:17:05.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Obata!
Dialogue: 0,0:17:06.73,0:17:09.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak tahu\N‎aku punya karyawan yang pengertian.
Dialogue: 0,0:17:10.40,0:17:12.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tersentuh!
Dialogue: 0,0:17:13.40,0:17:14.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku pasti bisa!{\i0}
Dialogue: 0,0:17:15.15,0:17:17.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dengan begitu, semuanya alami.
Dialogue: 0,0:17:17.20,0:17:18.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apanya yang alami?
Dialogue: 0,0:17:21.16,0:17:23.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak perlu sekaget itu.
Dialogue: 0,0:17:24.83,0:17:26.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Halo, Manajer.
Dialogue: 0,0:17:26.96,0:17:28.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya. Halo.
Dialogue: 0,0:17:29.50,0:17:31.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf.
Dialogue: 0,0:17:31.55,0:17:34.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kursinya goyang.
Dialogue: 0,0:17:35.01,0:17:39.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sebenarnya, Oba,\N‎ada yang ingin kutanyakan padamu.
Dialogue: 0,0:17:40.55,0:17:41.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya?
Dialogue: 0,0:17:44.35,0:17:46.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kuanggap laporan bulanan ini\N‎sudah selesai?
Dialogue: 0,0:17:47.85,0:17:49.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kutemukan di lantai di luar kantorku.
Dialogue: 0,0:17:51.02,0:17:54.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku bahkan merasa mendengar\N‎seseorang memanggil namaku.
Dialogue: 0,0:17:54.69,0:17:56.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa itu kau?
Dialogue: 0,0:17:56.82,0:17:59.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jika ada yang ingin kau tanyakan,\N‎tanyakan saja.
Dialogue: 0,0:17:59.45,0:18:01.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku…
Dialogue: 0,0:18:01.62,0:18:05.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sumpah aku tak melihatmu menangis!
Dialogue: 0,0:18:10.75,0:18:11.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tentu.
Dialogue: 0,0:18:12.71,0:18:14.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau ingin merokok bersamaku?
Dialogue: 0,0:18:15.46,0:18:17.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lalu kau bisa dengarkan aku.
Dialogue: 0,0:18:19.68,0:18:25.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak percaya kau melihatku menangis\N‎saat aku baca manga di jam istirahatku.
Dialogue: 0,0:18:26.81,0:18:29.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya… Bunuh saja aku.
Dialogue: 0,0:18:29.98,0:18:32.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukan sifatku membunuh orang\N‎yang menurutku menarik.
Dialogue: 0,0:18:33.61,0:18:36.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Manajer bisa menyikapi semua\N‎dengan santai. Dia luar biasa…{\i0}
Dialogue: 0,0:18:39.53,0:18:42.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf. Tak seharusnya aku menyimpulkan.
Dialogue: 0,0:18:42.83,0:18:44.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak apa-apa.
Dialogue: 0,0:18:44.16,0:18:46.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku hanya lega kau tak lagi khawatir.
Dialogue: 0,0:18:47.25,0:18:50.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan aku senang\N‎aku tak mengecewakan karyawanku.
Dialogue: 0,0:18:54.80,0:18:56.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagaimana kau mengecewakan kami?
Dialogue: 0,0:18:58.30,0:19:01.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukankah kau merasa\N‎tak bisa bicara pada siapa-siapa
Dialogue: 0,0:19:01.51,0:19:03.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎karena melihat atasanmu menangis?
Dialogue: 0,0:19:04.22,0:19:08.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu memang benar,
Dialogue: 0,0:19:10.31,0:19:11.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tapi aku…
Dialogue: 0,0:19:12.31,0:19:15.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kupikir jika kau punya masalah,
Dialogue: 0,0:19:15.69,0:19:20.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎kau mungkin bisa minta tolong kepadaku…
Dialogue: 0,0:19:22.95,0:19:26.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi tentu saja,\N‎aku hanya ikut campur urusanmu.
Dialogue: 0,0:19:27.58,0:19:31.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau sudah luar biasa\N‎dan aku malah punya pikiran sendiri.
Dialogue: 0,0:19:32.79,0:19:36.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Malah, jika manga itu\N‎bisa membuatmu menangis,
Dialogue: 0,0:19:36.21,0:19:39.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku mungkin juga ingin membacanya…
Dialogue: 0,0:19:39.21,0:19:40.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Obata.
Dialogue: 0,0:19:41.18,0:19:45.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sebenarnya, aku selalu ingin bekerja\N‎sebagai penulis manga.
Dialogue: 0,0:19:47.97,0:19:49.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:19:49.06,0:19:53.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi kutinggalkan mimpi itu\N‎dan di sinilah aku.
Dialogue: 0,0:19:53.85,0:19:55.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Manajer sebagai penulis manga?{\i0}
Dialogue: 0,0:19:56.27,0:19:57.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Keren sekali.{\i0}
Dialogue: 0,0:19:58.07,0:20:01.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa kau tinggalkan?
Dialogue: 0,0:20:01.78,0:20:02.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Karena…
Dialogue: 0,0:20:07.74,0:20:12.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak mau duduk seharian di mejaku.
Dialogue: 0,0:20:12.75,0:20:15.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sayang sekali.
Dialogue: 0,0:20:16.54,0:20:17.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Obata.
Dialogue: 0,0:20:18.13,0:20:20.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku yakin kau pernah dengar rumor
Dialogue: 0,0:20:20.96,0:20:23.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎alasanku tetap di toko ini.
Dialogue: 0,0:20:24.72,0:20:25.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya…
Dialogue: 0,0:20:25.89,0:20:29.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau pikir akan lebih cepat\N‎jika kau lakukan sendiri.
Dialogue: 0,0:20:29.72,0:20:30.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu juga sama.
Dialogue: 0,0:20:32.06,0:20:35.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku hanya tak bisa duduk seharian di meja.
Dialogue: 0,0:20:36.52,0:20:39.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi itu malah dibesar-besarkan.
Dialogue: 0,0:20:51.58,0:20:52.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Um…
Dialogue: 0,0:20:54.04,0:20:59.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa kau memberitahuku\N‎rahasia besar ini?
Dialogue: 0,0:21:00.84,0:21:03.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:21:03.22,0:21:05.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau benar-benar menanyakan itu?
Dialogue: 0,0:21:06.34,0:21:07.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:21:09.05,0:21:13.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kurasa aku ingin kau tahu\N‎kekhawatiranmu padaku tak salah.
Dialogue: 0,0:21:15.81,0:21:18.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maafkan aku.
Dialogue: 0,0:21:18.19,0:21:19.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi aku tak mengerti!
Dialogue: 0,0:21:21.02,0:21:22.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak, itu salahku.
Dialogue: 0,0:21:22.69,0:21:27.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi jika kau melihatku\N‎bersikap aneh lagi,
Dialogue: 0,0:21:27.20,0:21:29.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎jadilah pendengarku, apa pun yang terjadi.
Dialogue: 0,0:21:32.49,0:21:34.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau serius memintaku?
Dialogue: 0,0:21:39.42,0:21:41.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak ada lagi yang ingin kumintai.
Dialogue: 0,0:21:42.75,0:21:43.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku…
Dialogue: 0,0:21:45.42,0:21:46.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan berusaha yang terbaik.
Dialogue: 0,0:21:49.72,0:21:52.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sejak saat itu,{\i0}
Dialogue: 0,0:21:52.85,0:21:55.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎aku mulai menantikan{\i0}
Dialogue: 0,0:21:56.39,0:21:58.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎saat Manajer mendatangiku.{\i0}
Dialogue: 0,0:22:01.23,0:22:03.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Katamu kau ingin membacanya, 'kan?
Dialogue: 0,0:22:03.44,0:22:05.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kutandai bagian yang bagusnya,\N‎jangan dilewatkan.
Dialogue: 0,0:22:07.11,0:22:08.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Manga itu punya banyak volume.
Dialogue: 0,0:22:08.82,0:22:10.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau harus baca sampai habis.
Dialogue: 0,0:22:10.99,0:22:13.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih banyak!
Dialogue: 0,0:22:13.54,0:22:15.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sangat senang!
Dialogue: 0,0:23:34.87,0:23:39.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terjemahan subtitle oleh Rahayu Kinasih
