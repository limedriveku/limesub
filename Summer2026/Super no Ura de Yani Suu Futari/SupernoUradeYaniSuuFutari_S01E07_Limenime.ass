Dialogue: 0,0:00:53.67,0:00:54.76,sign,,0000,0000,0000,,‎SUPER S\N‎BUKA 24 JAM
Dialogue: 0,0:02:34.98,0:02:36.19,sign,,0000,0000,0000,,‎FESTIVAL MUSIM PANAS
Dialogue: 0,0:02:55.30,0:02:57.55,sign,,0000,0000,0000,,‎MASALAH - KECELAKAAN - PENYAKIT
Dialogue: 0,0:02:57.55,0:02:59.63,sign,,0000,0000,0000,,‎CEDERA - KESEHATAN MENTAL - BERHENTI
Dialogue: 0,0:06:34.60,0:06:35.85,sign,,0000,0000,0000,,‎TEMAN BAIK
Dialogue: 0,0:06:51.20,0:06:52.28,sign,,0000,0000,0000,,‎PERUSAHAAN HAPPY
Dialogue: 0,0:07:13.47,0:07:15.64,sign,,0000,0000,0000,,‎HAJAR DIA - TAYAMA
Dialogue: 0,0:08:04.65,0:08:07.06,sign,,0000,0000,0000,,‎SEMOGA BERUNTUNG\N‎AKU MENDUKUNGMU - SASAKI
Dialogue: 0,0:11:33.52,0:11:34.94,sign,,0000,0000,0000,,{\an8}‎BUANG DALAM TIGA HARI
Dialogue: 0,0:12:16.15,0:12:17.56,sign,,0000,0000,0000,,{\an8}‎*SEBUTAN SUPER S
Dialogue: 0,0:13:08.16,0:13:09.28,sign,,0000,0000,0000,,‎MENYERAMKAN
Dialogue: 0,0:13:14.71,0:13:16.62,sign,,0000,0000,0000,,‎TAK BEREAKSI
Dialogue: 0,0:14:09.22,0:14:11.18,sign,,0000,0000,0000,,{\an8}‎KERJA - KLIEN - BOS\N‎JUNIOR - LEMBUR - PELECEHAN
Dialogue: 0,0:16:09.30,0:16:10.97,sign,,0000,0000,0000,,{\an8}‎GO
Dialogue: 0,0:18:29.81,0:18:31.02,sign,,0000,0000,0000,,‎BALON AIR - FESTIVAL
Dialogue: 0,0:00:02.33,0:00:06.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Manajer! Aku tak butuh kenaikan gaji.
Dialogue: 0,0:00:06.13,0:00:09.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bekerja di toko ini saja\N‎sudah membuatku senang.
Dialogue: 0,0:00:09.59,0:00:12.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benarkah? Aku tak pernah\N‎dengar orang seperti itu.
Dialogue: 0,0:00:12.88,0:00:14.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak apa-apa. Lakukan saja ujiannya.
Dialogue: 0,0:00:17.64,0:00:20.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku ada di sini untuk mengajarimu\N‎semua yang kau butuhkan agar lolos.
Dialogue: 0,0:00:21.64,0:00:24.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku juga menyiapkan buku latihan\N‎untuk semua orang di departemen
Dialogue: 0,0:00:24.81,0:00:26.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎yang mengambil ujian kenaikan gaji.
Dialogue: 0,0:00:27.48,0:00:28.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo kita mulai.
Dialogue: 0,0:00:30.03,0:00:32.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pastikan kau ingat bagian ini.
Dialogue: 0,0:00:33.78,0:00:35.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yang ini mudah salah.
Dialogue: 0,0:00:36.07,0:00:37.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pahami dulu alurnya sebelum menjawab.
Dialogue: 0,0:00:38.41,0:00:42.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mereka selalu menyertakan ini\N‎di buku latihan, tapi tak pernah di tes…
Dialogue: 0,0:00:44.08,0:00:46.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Wow. Kau bisa paham dengan cepat.
Dialogue: 0,0:00:48.59,0:00:52.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jika ada yang tak kau mengerti,\N‎jangan ragu untuk bertanya…
Dialogue: 0,0:00:54.76,0:00:56.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Jangan tidur, Yamada!
Dialogue: 0,0:02:33.52,0:02:34.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selamat datang.
Dialogue: 0,0:02:38.78,0:02:42.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sudah lama aku tak melihat Yamada-san.{\i0}
Dialogue: 0,0:02:42.53,0:02:45.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini kartumu.
Dialogue: 0,0:02:45.33,0:02:46.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih.
Dialogue: 0,0:02:46.41,0:02:49.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Mungkin waktuku tak tepat.{\i0}
Dialogue: 0,0:02:49.75,0:02:53.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi sudah dua minggu\N‎aku tak melihatnya di kasir.{\i0}
Dialogue: 0,0:02:59.63,0:03:00.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku khawatir.{\i0}
Dialogue: 0,0:03:00.97,0:03:02.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pak?
Dialogue: 0,0:03:03.05,0:03:04.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf.
Dialogue: 0,0:03:08.10,0:03:11.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku hanya seorang pelanggan.\N‎Apa gunanya rasa khawatirku baginya?{\i0}
Dialogue: 0,0:03:12.44,0:03:15.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bukankah ini disebut mengganggu?{\i0}
Dialogue: 0,0:03:19.53,0:03:24.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia selalu memberiku senyuman,\N‎jadi asalkan dia tak apa-apa, aku…
Dialogue: 0,0:03:24.07,0:03:26.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Asalkan dia tak apa-apa, kenapa?
Dialogue: 0,0:03:27.33,0:03:29.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-san!
Dialogue: 0,0:03:29.04,0:03:30.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yo.
Dialogue: 0,0:03:30.83,0:03:33.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku hanya…
Dialogue: 0,0:03:34.13,0:03:35.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tahu…
Dialogue: 0,0:03:36.92,0:03:38.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak apa-apa. Jangan khawatir.
Dialogue: 0,0:03:39.42,0:03:40.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan tanya lagi nanti.
Dialogue: 0,0:03:43.38,0:03:44.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa kau…
Dialogue: 0,0:03:46.05,0:03:47.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎mau merokok di belakang?
Dialogue: 0,0:03:55.65,0:03:59.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, kau khawatir dan sedih\N‎karena sudah lama tak melihat Yamada-san.
Dialogue: 0,0:03:59.69,0:04:02.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tak harus diucapkan begitu.{\i0}
Dialogue: 0,0:04:02.70,0:04:05.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan khawatir. Dia tak sakit.
Dialogue: 0,0:04:06.12,0:04:08.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia hanya sedang belajar.
Dialogue: 0,0:04:08.53,0:04:09.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Belajar?
Dialogue: 0,0:04:10.16,0:04:12.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ujian kenaikan gajinya sebentar lagi.
Dialogue: 0,0:04:13.21,0:04:15.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Manajer menyuruhnya ikut ujian.
Dialogue: 0,0:04:15.21,0:04:16.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itulah alasannya.
Dialogue: 0,0:04:20.13,0:04:23.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagus, 'kan? Kau lega dia tak berhenti.
Dialogue: 0,0:04:24.43,0:04:26.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukannya aku lega.
Dialogue: 0,0:04:26.26,0:04:29.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku hanya mengkhawatirkannya.
Dialogue: 0,0:04:34.81,0:04:37.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku juga minta maaf padamu, Tayama-san.
Dialogue: 0,0:04:37.77,0:04:39.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa?
Dialogue: 0,0:04:39.07,0:04:43.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku membuatmu bercerita\N‎tentang Yamada-san.
Dialogue: 0,0:04:46.70,0:04:48.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar Lamban-saki.
Dialogue: 0,0:04:49.66,0:04:50.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau bilang sesuatu?
Dialogue: 0,0:04:50.87,0:04:52.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak.
Dialogue: 0,0:04:52.91,0:04:56.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sebentar lagi keadaan akan kembali normal.
Dialogue: 0,0:04:56.79,0:04:59.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Entah dia berhasil atau gagal.
Dialogue: 0,0:04:59.13,0:05:01.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi Yamada-san hebat.
Dialogue: 0,0:05:02.67,0:05:05.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bekerja dan belajar di saat yang sama.
Dialogue: 0,0:05:06.59,0:05:08.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Semoga semuanya berjalan lancar untuknya.
Dialogue: 0,0:05:11.43,0:05:12.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, Sasaki-san.
Dialogue: 0,0:05:12.97,0:05:14.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya?
Dialogue: 0,0:05:19.81,0:05:21.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini. Tulislah sesuatu.
Dialogue: 0,0:05:22.61,0:05:23.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Seperti apa?
Dialogue: 0,0:05:24.19,0:05:25.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎"Semoga beruntung" atau semacamnya.
Dialogue: 0,0:05:26.61,0:05:28.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini untuk acara lain di toko?
Dialogue: 0,0:05:28.74,0:05:31.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayolah. Tulis saja.
Dialogue: 0,0:05:44.96,0:05:47.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa ini tak apa-apa?
Dialogue: 0,0:05:54.18,0:05:56.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih, Sasaki-san.
Dialogue: 0,0:05:59.40,0:06:02.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akan kuberikan ini kepada Yamada-san.
Dialogue: 0,0:06:02.48,0:06:04.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tunggu!
Dialogue: 0,0:06:04.40,0:06:07.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan! Tolong jangan. Kumohon.
Dialogue: 0,0:06:07.15,0:06:08.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa tidak? Tak apa-apa.
Dialogue: 0,0:06:08.86,0:06:10.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sama sekali tak boleh!
Dialogue: 0,0:06:10.78,0:06:13.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yamada-san tak akan mau\N‎terima sesuatu seperti itu.
Dialogue: 0,0:06:13.20,0:06:17.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku hanya seorang pelanggan.\N‎Hanya seorang pria tua.
Dialogue: 0,0:06:17.37,0:06:18.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Andai dia jadi tak semangat?
Dialogue: 0,0:06:19.29,0:06:23.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan jika aku tahu itu untuknya,\N‎aku akan menulis yang lebih baik.
Dialogue: 0,0:06:26.42,0:06:28.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia akan termotivasi.
Dialogue: 0,0:06:30.47,0:06:32.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku janji.
Dialogue: 0,0:06:35.85,0:06:38.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jika rekan kerjanya bilang begitu…
Dialogue: 0,0:06:40.69,0:06:44.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akan kuberikan kau ini sebagai gantinya.
Dialogue: 0,0:06:44.69,0:06:46.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bacalah saat bosmu memarahimu.
Dialogue: 0,0:06:47.99,0:06:50.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah. Terima kasih.
Dialogue: 0,0:06:52.28,0:06:53.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sasaki-kun!
Dialogue: 0,0:06:53.37,0:06:55.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya! Maafkan aku!
Dialogue: 0,0:06:57.91,0:07:00.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa yang kau lakukan\N‎yang membuatnya marah kali ini?
Dialogue: 0,0:07:00.87,0:07:03.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia bertengkar dengan klien yang kubawa.
Dialogue: 0,0:07:03.50,0:07:05.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Begitu. Jadi, dia hanya\N‎melampiaskan amarah.
Dialogue: 0,0:07:06.34,0:07:10.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Benar. Tayama-san memberiku kertas ini.{\i0}
Dialogue: 0,0:07:11.22,0:07:12.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia menyuruhku membacanya saat…{\i0}
Dialogue: 0,0:07:17.47,0:07:19.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei. Ada apa? Sasaki?
Dialogue: 0,0:07:19.81,0:07:22.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukan apa-apa. Itu seperti dia.
Dialogue: 0,0:07:25.77,0:07:26.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei.
Dialogue: 0,0:07:27.48,0:07:29.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kantor pusat menelepon.
Dialogue: 0,0:07:29.86,0:07:32.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Katanya kau lolos ujian kenaikan gajimu.
Dialogue: 0,0:07:32.49,0:07:34.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu mudah.
Dialogue: 0,0:07:34.45,0:07:36.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagus sekali!
Dialogue: 0,0:07:36.49,0:07:38.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa maksudmu itu mudah?
Dialogue: 0,0:07:38.74,0:07:41.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kupikir kau tak mau mengambilnya.
Dialogue: 0,0:07:42.87,0:07:47.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, kau memutuskan untuk giat belajar\N‎setelah ragu-ragu?
Dialogue: 0,0:07:47.88,0:07:50.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa kau berubah pikiran?
Dialogue: 0,0:07:53.38,0:07:56.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku hanya melakukan\N‎yang diharapkan dariku.
Dialogue: 0,0:07:56.89,0:07:58.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan…
Dialogue: 0,0:07:58.43,0:08:02.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku dapat jimat keberuntungan\N‎dari penggemarku yang lamban.
Dialogue: 0,0:08:10.40,0:08:12.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hari yang melelahkan lagi.
Dialogue: 0,0:08:13.57,0:08:16.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sudah cukup! Aku akan makan siang.
Dialogue: 0,0:08:16.41,0:08:18.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pop!
Dialogue: 0,0:08:18.37,0:08:20.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Wow, ini terlihat enak!\N‎Aku tak sabar untuk makan.
Dialogue: 0,0:08:21.00,0:08:23.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini hari yang berat.
Dialogue: 0,0:08:23.87,0:08:26.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hari ini lebih daripada berat.
Dialogue: 0,0:08:27.75,0:08:30.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa yang kau lakukan\N‎hingga bisa santai hari ini?
Dialogue: 0,0:08:30.25,0:08:31.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau pikir aku santai?
Dialogue: 0,0:08:31.63,0:08:34.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Setelah aku makan bekal\N‎dari Keiko tersayangku,
Dialogue: 0,0:08:34.51,0:08:36.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku tak peduli lagi.
Dialogue: 0,0:08:42.14,0:08:44.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei? Apa itu?
Dialogue: 0,0:08:44.44,0:08:47.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Semacam jimat keberuntungan?
Dialogue: 0,0:08:47.23,0:08:49.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei! Sasaki-kun!
Dialogue: 0,0:08:49.27,0:08:50.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya!
Dialogue: 0,0:08:50.57,0:08:53.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Gawat.\N‎- "Gawat"? Apa maksudmu "Gawat"?
Dialogue: 0,0:08:53.82,0:08:57.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa kau hanya akan duduk saja?\N‎Gunakan kakimu dan bekerjalah!
Dialogue: 0,0:08:57.78,0:08:58.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, Pak!
Dialogue: 0,0:08:58.87,0:08:59.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maafkan aku.
Dialogue: 0,0:08:59.95,0:09:01.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan langsung pergi.
Dialogue: 0,0:09:02.41,0:09:03.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kukerjakan setelah makan.
Dialogue: 0,0:09:07.29,0:09:09.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tak apa-apa. Tak benar-benar rusak.{\i0}
Dialogue: 0,0:09:10.29,0:09:12.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jika kuratakan…{\i0}
Dialogue: 0,0:09:15.26,0:09:18.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Pasti aman jika kutaruh di sini.{\i0}
Dialogue: 0,0:09:20.60,0:09:21.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yo.
Dialogue: 0,0:09:22.47,0:09:24.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yamada-san lulus ujian kenaikan gajinya.
Dialogue: 0,0:09:25.48,0:09:26.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagus, 'kan?
Dialogue: 0,0:09:27.23,0:09:30.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu bukan urusanku.
Dialogue: 0,0:09:30.19,0:09:32.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Informasi itu hanya untuk\N‎orang yang berkepentingan.
Dialogue: 0,0:09:34.49,0:09:36.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi kau bahagia untuknya.
Dialogue: 0,0:09:39.07,0:09:41.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu berkat jimat keberuntungan\N‎yang kau berikan padanya.
Dialogue: 0,0:09:42.83,0:09:44.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau benar-benar memberikannya padanya?
Dialogue: 0,0:09:44.75,0:09:46.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kubilang akan kuberikan, 'kan?
Dialogue: 0,0:09:48.00,0:09:50.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dan akulah yang memaksamu melakukannya.{\i0}
Dialogue: 0,0:09:58.80,0:10:01.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak. Itu pasti karena\N‎dia berusaha keras.
Dialogue: 0,0:10:02.51,0:10:05.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku ragu kertas kecil itu membantunya.
Dialogue: 0,0:10:15.23,0:10:17.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Astaga. Aku menjatuhkannya.
Dialogue: 0,0:10:17.32,0:10:18.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Cepat sekali!
Dialogue: 0,0:10:27.83,0:10:31.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Dia bilang kertas kecil ini\N‎tak akan membantu,{\i0}
Dialogue: 0,0:10:31.42,0:10:34.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎tapi dia sendiri sangat menjaga ini.{\i0}
Dialogue: 0,0:10:37.34,0:10:40.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa ini membantumu?
Dialogue: 0,0:10:43.18,0:10:45.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:10:46.10,0:10:47.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini seperti kaki kelinciku.
Dialogue: 0,0:10:54.15,0:10:57.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tunggu. Apa maksudnya "kaki kelinci"?{\i0}
Dialogue: 0,0:10:59.65,0:11:00.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Terlalu panjang. Intinya.{\i0}
Dialogue: 0,0:11:01.91,0:11:04.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jadi, itu jimat keberuntungan.{\i0}
Dialogue: 0,0:11:04.83,0:11:07.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Pria tua memang suka pakai kata-kata aneh.{\i0}
Dialogue: 0,0:11:09.71,0:11:12.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia masih menyimpan itu\N‎walaupun sudah lecek.{\i0}
Dialogue: 0,0:11:17.46,0:11:19.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Akan kuberikan yang baru\N‎jika dia memintanya.{\i0}
Dialogue: 0,0:11:34.94,0:11:35.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Ada penampakan?
Dialogue: 0,0:11:36.94,0:11:39.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa maksudmu, Kepala Maezawa?
Dialogue: 0,0:11:39.28,0:11:42.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hantu!
Dialogue: 0,0:11:42.03,0:11:44.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Di gudang?
Dialogue: 0,0:11:44.82,0:11:47.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukan. Di belakang.
Dialogue: 0,0:11:47.12,0:11:52.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sedang merokok di luar\N‎saat kudengar suara langkah kaki.
Dialogue: 0,0:11:52.54,0:11:57.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kudengar itu penyebab Obata dari\N‎bagian buah dan sayuran berhenti merokok.
Dialogue: 0,0:11:59.05,0:12:00.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lucu sekali!
Dialogue: 0,0:12:00.88,0:12:03.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mungkin dia harus dilatih\N‎oleh Yamada-chan yang tenang.
Dialogue: 0,0:12:04.30,0:12:05.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:12:05.68,0:12:09.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi aku lebih takut pada harga ganda.
Dialogue: 0,0:12:09.06,0:12:10.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau bercanda!
Dialogue: 0,0:12:11.06,0:12:14.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Harga ganda adalah saat harga produk\N‎lebih mahal saat dipindai di kasir
Dialogue: 0,0:12:14.52,0:12:16.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎daripada harga di label, Yamada.
Dialogue: 0,0:12:17.57,0:12:19.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itulah Yamada-chan.
Dialogue: 0,0:12:19.94,0:12:21.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia tak takut pada apa pun.
Dialogue: 0,0:12:23.07,0:12:25.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa hari ini dia akan datang?{\i0}
Dialogue: 0,0:12:29.62,0:12:31.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Udara masih panas, padahal sudah malam.
Dialogue: 0,0:12:36.83,0:12:39.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tayama-san tak ada di sini.{\i0}
Dialogue: 0,0:12:40.17,0:12:42.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Yamada-san juga tak ada di kasir.{\i0}
Dialogue: 0,0:12:42.38,0:12:44.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sepertinya waktuku tak tepat.{\i0}
Dialogue: 0,0:12:47.09,0:12:48.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-san!
Dialogue: 0,0:12:49.60,0:12:50.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Halo.
Dialogue: 0,0:12:51.56,0:12:52.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yo.
Dialogue: 0,0:12:56.10,0:12:58.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Karena reaksimu selalu bagus,
Dialogue: 0,0:12:59.36,0:13:01.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎akan kuberi tahu kau sebuah rahasia.
Dialogue: 0,0:13:02.32,0:13:03.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa itu?
Dialogue: 0,0:13:05.95,0:13:08.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Orang bilang di sini ada penampakan.
Dialogue: 0,0:13:10.03,0:13:12.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Penampakan? Maksudmu, hantu?
Dialogue: 0,0:13:12.54,0:13:13.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:13:16.62,0:13:18.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu tak terdengar bagus.
Dialogue: 0,0:13:22.25,0:13:25.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lihat! Itu Yamada-san\N‎mengenakan baju kasual berlengan pendek!
Dialogue: 0,0:13:25.51,0:13:28.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Tak mungkin!\N‎Haruskah kita matikan rokok?
Dialogue: 0,0:13:28.76,0:13:31.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kubilang di sini ada hantu, Sasaki-san.
Dialogue: 0,0:13:33.22,0:13:35.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya? Itu tak terdengar bagus.
Dialogue: 0,0:13:38.19,0:13:39.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Omong-omong,
Dialogue: 0,0:13:40.06,0:13:42.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku tak melihat Yamada-san.
Dialogue: 0,0:13:43.23,0:13:45.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau aneh, Sasaki-san.
Dialogue: 0,0:13:46.32,0:13:48.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa kau tak ketakutan?
Dialogue: 0,0:13:49.11,0:13:50.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ketakutan?
Dialogue: 0,0:13:50.53,0:13:54.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Di sini ada hantu.
Dialogue: 0,0:13:54.54,0:13:56.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak terlalu terganggu.
Dialogue: 0,0:13:56.87,0:13:59.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Kenapa tidak?
Dialogue: 0,0:13:59.50,0:14:01.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa? Aku…
Dialogue: 0,0:14:05.92,0:14:09.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aku sudah muak dengan yang masih hidup.
Dialogue: 0,0:14:11.18,0:14:13.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Itu membosankan.{\i0}
Dialogue: 0,0:14:13.43,0:14:15.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kupikir dia akan amat ketakutan.{\i0}
Dialogue: 0,0:14:15.85,0:14:16.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Lebih seperti…{\i0}
Dialogue: 0,0:14:16.98,0:14:19.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oh, tidak! Takut! Aku takut!
Dialogue: 0,0:14:19.69,0:14:22.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-san, apa kau
Dialogue: 0,0:14:23.23,0:14:25.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎takut pada hal-hal seperti itu?
Dialogue: 0,0:14:32.16,0:14:33.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak takut.
Dialogue: 0,0:14:33.78,0:14:35.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa kau berpikir begitu?
Dialogue: 0,0:14:38.16,0:14:42.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maksudku… Maaf aku berpikir begitu.
Dialogue: 0,0:14:43.13,0:14:44.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yo.
Dialogue: 0,0:14:47.59,0:14:50.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak. Maaf telah membahasnya.
Dialogue: 0,0:14:50.47,0:14:52.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kupikir itu arah percakapan kita.
Dialogue: 0,0:14:53.35,0:14:55.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sudah tua.\N‎Kami ingin buat percakapan mengalir.
Dialogue: 0,0:14:55.97,0:14:58.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak ada yang bisa kami tambahkan.\N‎Menyebalkan, 'kan?
Dialogue: 0,0:14:59.23,0:15:00.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Alur percakapan, ya?
Dialogue: 0,0:15:00.73,0:15:03.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benar. Aku tak bermaksud apa-apa.
Dialogue: 0,0:15:03.86,0:15:06.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, ayolah, Tayama-san.\N‎Duduklah dan tetap merokok…
Dialogue: 0,0:15:08.99,0:15:10.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, apa itu?
Dialogue: 0,0:15:11.78,0:15:13.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akan kuperiksa.
Dialogue: 0,0:15:13.95,0:15:16.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tetaplah di sana.
Dialogue: 0,0:15:17.49,0:15:18.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sasaki-san…
Dialogue: 0,0:15:23.17,0:15:26.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf, Tayama-san. Apa aku menyakitimu…
Dialogue: 0,0:15:36.10,0:15:38.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak apa-apa, Tayama-san.
Dialogue: 0,0:15:40.02,0:15:41.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lihat.
Dialogue: 0,0:15:43.73,0:15:44.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu hanya anjing.
Dialogue: 0,0:15:49.69,0:15:51.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa ada anjing?
Dialogue: 0,0:15:51.11,0:15:52.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Siapa yang tahu?
Dialogue: 0,0:15:52.53,0:15:55.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sepertinya itu peliharaan seseorang.
Dialogue: 0,0:15:56.66,0:15:58.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Di sana kau, Daigoro.
Dialogue: 0,0:15:58.54,0:16:00.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Manajer!
Dialogue: 0,0:16:00.79,0:16:02.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau juga di luar sini?
Dialogue: 0,0:16:02.96,0:16:06.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Pasti ada hal menarik di sini.{\i0}
Dialogue: 0,0:16:07.34,0:16:09.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu milik pelanggan?
Dialogue: 0,0:16:11.55,0:16:15.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Salah satu pelanggan kami, wanita tua,\N‎memenangkan liburan dari mesin lotre,
Dialogue: 0,0:16:15.84,0:16:17.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tapi dia mengeluh tak bisa pergi
Dialogue: 0,0:16:17.89,0:16:19.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎karena tak ada keluarga\N‎untuk jaga Daigoro.
Dialogue: 0,0:16:20.47,0:16:23.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, aku menjaganya untuknya,\N‎dan kadang kubawa ke sini.
Dialogue: 0,0:16:24.02,0:16:27.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa talimu lepas\N‎dan kau berkeliaran lagi, Daigoro?
Dialogue: 0,0:16:27.90,0:16:30.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau hanya ingin berada di luar, ya?
Dialogue: 0,0:16:32.44,0:16:34.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah. Kami akan pergi sekarang.
Dialogue: 0,0:16:36.20,0:16:38.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Habiskan rokok kalian dan cepatlah pulang.
Dialogue: 0,0:16:41.20,0:16:45.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yama… Tayama.\N‎Nanti ceritakan semua yang terjadi, ya?
Dialogue: 0,0:16:49.17,0:16:51.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Manajer benar-benar tak bisa dipercaya.
Dialogue: 0,0:16:53.47,0:16:56.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kurasa aku juga mau pulang saja.
Dialogue: 0,0:16:57.14,0:16:58.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Ya?\N‎- Ya.
Dialogue: 0,0:17:00.06,0:17:01.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sampai jumpa.
Dialogue: 0,0:17:01.93,0:17:03.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf tadi aku menabrakmu.
Dialogue: 0,0:17:04.64,0:17:06.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan terima kasih\N‎telah mengizinkanku mampir.
Dialogue: 0,0:17:16.03,0:17:19.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa maksudmu, "Maaf telah menabrakmu"?{\i0}
Dialogue: 0,0:17:20.08,0:17:21.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kau tahu yang kau lakukan.{\i0}
Dialogue: 0,0:17:22.29,0:17:24.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kau bahkan bilang, "Tak apa-apa."{\i0}
Dialogue: 0,0:17:28.75,0:17:30.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Berengsek!
Dialogue: 0,0:17:36.09,0:17:38.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, kau hantunya?
Dialogue: 0,0:17:38.64,0:17:43.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan Goto-senpai merahasiakan si imut ini?\N‎Goto nakal!
Dialogue: 0,0:17:43.18,0:17:45.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Siapa namamu, Anjing Manis?
Dialogue: 0,0:17:45.85,0:17:47.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sasaki.
Dialogue: 0,0:17:48.02,0:17:51.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Nama anjing itu Sasaki.
Dialogue: 0,0:17:52.27,0:17:53.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa maksudmu, Yamada!
Dialogue: 0,0:17:53.90,0:17:56.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Omong kosong apa yang kau katakan?
Dialogue: 0,0:17:56.78,0:18:00.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sasaki adalah nama pria itu.\N‎Nama anjingnya Daigoro.
Dialogue: 0,0:18:02.33,0:18:04.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Begitu. Jadi, itu namamu?
Dialogue: 0,0:18:04.83,0:18:07.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, kau Goro-chan?
Dialogue: 0,0:18:08.54,0:18:10.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yah,
Dialogue: 0,0:18:10.96,0:18:13.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎dia membuatku kesal.
Dialogue: 0,0:18:13.17,0:18:14.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sial.{\i0}
Dialogue: 0,0:18:14.88,0:18:18.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sesuatu yang menarik\N‎pasti terjadi di antara mereka.{\i0}
Dialogue: 0,0:18:18.47,0:18:22.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Hei, Goto-senpai. Apa yang kau bawa?
Dialogue: 0,0:18:22.43,0:18:24.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Di dalam kardus itu.
Dialogue: 0,0:18:25.10,0:18:26.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oh, ini.
Dialogue: 0,0:18:26.43,0:18:29.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku berpikir sudah waktunya\N‎kita mendekorasi toko.
Dialogue: 0,0:18:31.02,0:18:32.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kumpulan barang-barang musim panas.
Dialogue: 0,0:18:33.77,0:18:35.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baskom!
Dialogue: 0,0:18:35.57,0:18:37.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kami boleh merendam kaki lagi tahun ini?
Dialogue: 0,0:18:37.57,0:18:39.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lakukan sesuka kalian\N‎asal kalian bereskan lagi.
Dialogue: 0,0:18:46.41,0:18:49.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bos mematikan AC{\i0}
Dialogue: 0,0:18:49.00,0:18:51.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎karena ini "akhir musim panas",\N‎"terlalu dingin",{\i0}
Dialogue: 0,0:18:51.21,0:18:54.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎lalu marah saat kami\N‎pakai kompres pendingin.{\i0}
Dialogue: 0,0:18:55.21,0:18:58.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Penjual tak boleh berkeliaran\N‎memakai itu di kepalanya!
Dialogue: 0,0:19:01.09,0:19:04.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa begini akhir musim panasku tahun ini?{\i0}
Dialogue: 0,0:19:09.69,0:19:11.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hari ini juga tak ada Tayama-san?
Dialogue: 0,0:19:14.06,0:19:15.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baskom?
Dialogue: 0,0:19:15.48,0:19:17.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa ada di area merokok?{\i0}
Dialogue: 0,0:19:20.49,0:19:22.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tayama-san? Kau sudah selesai kerja?
Dialogue: 0,0:19:24.03,0:19:25.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Astaga.
Dialogue: 0,0:19:25.83,0:19:28.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa kau muncul saat aku keluar?
Dialogue: 0,0:19:29.08,0:19:31.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan bilang waktuku tak pas?
Dialogue: 0,0:19:31.46,0:19:32.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sangat tak pas.
Dialogue: 0,0:19:32.62,0:19:33.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf.
Dialogue: 0,0:19:33.83,0:19:35.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Haruskah aku pulang hari ini?
Dialogue: 0,0:19:36.38,0:19:39.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa yang kau lakukan? Ayo. Duduk.
Dialogue: 0,0:19:46.39,0:19:48.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Padahal aku menunggumu di depan.
Dialogue: 0,0:19:49.73,0:19:51.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf, kau bilang sesuatu?
Dialogue: 0,0:19:51.56,0:19:53.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukan apa-apa.
Dialogue: 0,0:19:53.27,0:19:56.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Entah bagaimana,\N‎aku pasti membuatnya kesal.{\i0}
Dialogue: 0,0:19:59.94,0:20:02.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, baskomnya untuk itu.
Dialogue: 0,0:20:03.28,0:20:05.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Cara yang bagus untuk merokok.
Dialogue: 0,0:20:06.03,0:20:08.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kami selalu melakukan ini di sini.
Dialogue: 0,0:20:08.16,0:20:12.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Manajer bilang kami boleh melakukannya\N‎asal pekerjaan kami sudah selesai.
Dialogue: 0,0:20:12.12,0:20:15.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Di kantorku, kami tak boleh pakai AC\N‎atau kompres pendingin.
Dialogue: 0,0:20:16.59,0:20:19.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Kenapa? Cuacanya masih panas.
Dialogue: 0,0:20:19.09,0:20:20.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu bodoh.
Dialogue: 0,0:20:20.17,0:20:22.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku setuju.
Dialogue: 0,0:20:24.89,0:20:27.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lepaskan kaus kakimu, Sasaki-san.
Dialogue: 0,0:20:32.81,0:20:36.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak, aku tak mau\N‎menaruh kakiku bersamamu.
Dialogue: 0,0:20:36.36,0:20:38.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akan kubasahi dengan selang.
Dialogue: 0,0:20:43.95,0:20:48.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf membuatmu berharap seperti itu.
Dialogue: 0,0:20:48.37,0:20:50.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hentikan, Tayama-san! Jangan minta maaf!
Dialogue: 0,0:20:51.58,0:20:53.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo. Lepaskan.
Dialogue: 0,0:20:53.62,0:20:55.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah. Akan kulepas.
Dialogue: 0,0:20:58.96,0:21:00.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Rasanya enak.
Dialogue: 0,0:21:03.01,0:21:04.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau benar-benar pria tua.
Dialogue: 0,0:21:04.72,0:21:07.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Rasa dingin ini…{\i0}
Dialogue: 0,0:21:07.18,0:21:11.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku berjalan kaki\N‎di trotoar panas seharian.{\i0}
Dialogue: 0,0:21:11.77,0:21:13.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Inilah yang dibutuhkan kaki yang…{\i0}
Dialogue: 0,0:21:15.14,0:21:17.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kena kau!
Dialogue: 0,0:21:17.27,0:21:20.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sasaki-san. Aku mengagetkanmu, 'kan?
Dialogue: 0,0:21:21.23,0:21:25.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku menunggumu selama ini\N‎agar aku bisa mengagetkanmu dengan ini.
Dialogue: 0,0:21:31.24,0:21:32.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa kau tersenyum seperti itu?
Dialogue: 0,0:21:33.50,0:21:34.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf.
Dialogue: 0,0:21:35.41,0:21:37.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku hanya berpikir itu menyenangkan.
Dialogue: 0,0:21:39.50,0:21:42.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tak seru digoda.
Dialogue: 0,0:21:42.80,0:21:44.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau menggodaku?
Dialogue: 0,0:21:45.05,0:21:46.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mungkin.
Dialogue: 0,0:21:46.93,0:21:49.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kemari. Akan kuberi tahu\N‎jika kau bisa menghindariku.
Dialogue: 0,0:21:53.22,0:21:54.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo. Kemarilah.
Dialogue: 0,0:21:56.39,0:21:58.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau siap?
Dialogue: 0,0:21:59.02,0:22:02.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sasaki-san! Kau bahkan tak menghindar.
Dialogue: 0,0:22:02.36,0:22:03.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Reaksiku lamban.
Dialogue: 0,0:22:11.28,0:22:15.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa begini akhir musim panasku tahun ini?{\i0}
Dialogue: 0,0:23:45.92,0:23:50.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terjemahan subtitle oleh Rahayu Kinasih
