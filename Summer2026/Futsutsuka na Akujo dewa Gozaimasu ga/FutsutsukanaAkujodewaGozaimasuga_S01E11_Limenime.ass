Dialogue: 0,0:00:05.75,0:00:08.75,sign,,0000,0000,0000,,SELIR KEKAISARAN, SHU GABI
Dialogue: 0,0:00:28.90,0:00:29.90,sign,,0000,0000,0000,,PERMAISURI - KOU KENSHUU
Dialogue: 0,0:00:54.67,0:00:55.67,sign,,0000,0000,0000,,SELIR MURNI - KIN REIGA
Dialogue: 0,0:02:18.17,0:02:19.17,sign,,0000,0000,0000,,SHU KEIGETSU (JIWA REIRIN)
Dialogue: 0,0:02:22.18,0:02:23.18,sign,,0000,0000,0000,,DAYANG KLAN SHU, LEELEE
Dialogue: 0,0:02:23.18,0:02:24.76,sign,,0000,0000,0000,,GADIS KLAN KOU - KOU REIRIN\N(JIWA KEIGETSU)
Dialogue: 0,0:04:26.30,0:04:27.22,sign,,0000,0000,0000,,KEPALA DAYANG REIRIN\NKOU TOUSETSU
Dialogue: 0,0:17:57.45,0:17:59.70,sign,,0000,0000,0000,,BEBERAPA HARI KEMUDIAN
Dialogue: 0,0:21:55.35,0:21:56.35,sign,,0000,0000,0000,,KOU KEIKOU
Dialogue: 0,0:21:58.98,0:21:59.98,sign,,0000,0000,0000,,KOU KEISHOU
Dialogue: 0,0:00:10.13,0:00:14.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu suara sorakan\Nuntuk kelahiran Putra Mahkota.
Dialogue: 0,0:00:15.09,0:00:16.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:00:19.14,0:00:21.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Selir Kekaisaran!\N- Selir Kekaisaran!
Dialogue: 0,0:00:21.02,0:00:22.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Bukan begitu.
Dialogue: 0,0:00:22.73,0:00:26.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku lega Nyonya Kenshuu baik-baik saja.
Dialogue: 0,0:00:27.48,0:00:28.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku sangat takut…{\i0}
Dialogue: 0,0:00:29.90,0:00:35.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}bahwa aku akan iri jika Nyonya Kenshuu\Nmelahirkan putra mahkota.{\i0}
Dialogue: 0,0:00:35.78,0:00:39.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Namun, sekarang,\Naku bahagia dari lubuk hatiku.{\i0}
Dialogue: 0,0:00:40.66,0:00:43.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Aku ingin segera bertemu dengannya lagi.{\i0}
Dialogue: 0,0:00:45.79,0:00:48.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga!
Dialogue: 0,0:00:48.04,0:00:53.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau memakai pembakar dupa\Nyang kuberikan sebagai hadiah kunjungan!
Dialogue: 0,0:00:53.17,0:00:54.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:00:55.68,0:00:57.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:00:57.05,0:01:02.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, aku bertanya-tanya\Napa aku tak perlu menjengukmu
Dialogue: 0,0:01:02.18,0:01:03.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sama seperti orang itu.
Dialogue: 0,0:01:04.60,0:01:05.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Orang itu"?
Dialogue: 0,0:01:05.81,0:01:07.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Maha Mulia Permaisuri.
Dialogue: 0,0:01:08.94,0:01:13.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berteman baik,\Ntapi mungkin karena ini pertanda buruk,
Dialogue: 0,0:01:13.44,0:01:15.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia bahkan belum datang ke sini.
Dialogue: 0,0:01:15.57,0:01:17.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah itu kejam?
Dialogue: 0,0:01:18.78,0:01:22.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Meski berteman,\Npada akhirnya kalian orang asing.
Dialogue: 0,0:01:22.91,0:01:26.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin bagi siapa pun,\Nanak mereka lebih penting.
Dialogue: 0,0:01:26.92,0:01:28.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, bunga besar mekar
Dialogue: 0,0:01:28.83,0:01:31.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di atas pengorbanan memetik bunga lain.
Dialogue: 0,0:01:31.67,0:01:36.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan seorang raja meletakkan takhtanya\Ndi atas banyak mayat.
Dialogue: 0,0:01:36.76,0:01:41.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin takdir pangeranmu\Nyang hilang, Selir Kekaisaran…
Dialogue: 0,0:01:47.39,0:01:49.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyawa pangeranmu…
Dialogue: 0,0:01:49.52,0:01:52.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}telah diterima oleh pangeranku.
Dialogue: 0,0:01:52.90,0:01:57.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau akan menyayanginya\Nseperti putramu sendiri, 'kan, Gabi?
Dialogue: 0,0:01:59.70,0:02:01.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak. Menjauhlah!
Dialogue: 0,0:02:04.29,0:02:05.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa…
Dialogue: 0,0:02:06.54,0:02:08.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa…
Dialogue: 0,0:02:08.12,0:02:09.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pangeranku!
Dialogue: 0,0:02:10.67,0:02:12.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:02:12.29,0:02:15.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kou Kenshuu!
Dialogue: 0,0:02:15.80,0:02:17.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baik-baik saja, Reirin?
Dialogue: 0,0:02:19.18,0:02:20.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepupu…
Dialogue: 0,0:02:20.18,0:02:22.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia.
Dialogue: 0,0:02:24.76,0:02:26.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selir Kekaisaran Shu Gabi.
Dialogue: 0,0:02:27.52,0:02:29.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah mendengar pengakuanmu
Dialogue: 0,0:02:29.19,0:02:31.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atas percobaan pembunuhan\NPermaisuri dengan kutukan.
Dialogue: 0,0:02:32.11,0:02:34.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan mengadakan interogasi mendetail,\Njadi bersiaplah.
Dialogue: 0,0:02:40.53,0:02:42.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:02:43.03,0:02:44.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergi!
Dialogue: 0,0:02:45.83,0:02:47.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reirin.
Dialogue: 0,0:02:48.08,0:02:50.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau Reirin.
Dialogue: 0,0:02:52.00,0:02:54.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku tidak menyadarinya?
Dialogue: 0,0:02:54.63,0:02:56.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Maaf, Sepupu.{\i0}
Dialogue: 0,0:02:57.17,0:03:00.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, sekarang,\Naku tidak bisa mengakuinya.{\i0}
Dialogue: 0,0:03:02.01,0:03:05.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku harus membatalkan pertukaran\Ndengan Nyonya Keigetsu.{\i0}
Dialogue: 0,0:03:07.64,0:03:10.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia, apa yang kau bicarakan?
Dialogue: 0,0:03:11.56,0:03:12.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku…
Dialogue: 0,0:03:13.94,0:03:16.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga.
Dialogue: 0,0:03:17.48,0:03:20.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Qi naga yang kuat.
Dialogue: 0,0:03:20.78,0:03:22.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat bergejolak…
Dialogue: 0,0:03:31.08,0:03:34.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kudengar pendiri kita\Nmemiliki qi naga yang kuat{\i0}
Dialogue: 0,0:03:34.58,0:03:36.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan bisa mengendalikan cuaca.{\i0}
Dialogue: 0,0:03:37.71,0:03:41.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, aku tidak menyadari\Nsepupuku punya bakat seperti itu.{\i0}
Dialogue: 0,0:03:41.59,0:03:44.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku seperti ini,\Nkau tidak bisa memaafkanku lagi?
Dialogue: 0,0:03:44.84,0:03:47.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bukan itu maksudku…{\i0}
Dialogue: 0,0:03:47.72,0:03:49.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tapi sekarang…{\i0}
Dialogue: 0,0:03:49.10,0:03:50.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reirin…
Dialogue: 0,0:03:50.68,0:03:53.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tolong katakan sesuatu!
Dialogue: 0,0:04:02.65,0:04:04.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon!
Dialogue: 0,0:04:04.24,0:04:07.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak peduli! Cepat bicara dengannya!
Dialogue: 0,0:04:09.79,0:04:12.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia, yang lebih penting sekarang\Nadalah Selir Kekaisaran Shu…
Dialogue: 0,0:04:12.96,0:04:15.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tahu gambaran besarnya.
Dialogue: 0,0:04:16.38,0:04:18.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan kutukannya sudah diangkat.
Dialogue: 0,0:04:18.42,0:04:20.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Yang Maha Mulia!\N- Permaisuri!
Dialogue: 0,0:04:20.30,0:04:22.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika kutukannya sudah diangkat,{\i0}
Dialogue: 0,0:04:22.55,0:04:26.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tousetsu akan memastikan nyawa ibuku\Ntidak akan terancam.{\i0}
Dialogue: 0,0:04:27.22,0:04:28.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tousetsu?
Dialogue: 0,0:04:28.30,0:04:29.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:04:29.56,0:04:31.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga diberi tahu Tousetsu.
Dialogue: 0,0:04:32.18,0:04:36.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Shu Keigetsu cemburu padamu\Ndan bertukar tubuh.
Dialogue: 0,0:04:36.90,0:04:41.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kau tahu soal itu,\Ntapi masih berusaha membelanya.
Dialogue: 0,0:04:41.11,0:04:42.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya.
Dialogue: 0,0:04:42.19,0:04:43.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tousetsu!{\i0}
Dialogue: 0,0:04:43.70,0:04:45.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Padahal aku sudah memintamu tutup mulut!{\i0}
Dialogue: 0,0:04:45.95,0:04:49.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga sangat menyesal\Ndari lubuk hatinya
Dialogue: 0,0:04:49.49,0:04:51.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena tak menyadarinya.
Dialogue: 0,0:04:51.70,0:04:54.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat memahami perasaannya.
Dialogue: 0,0:04:56.46,0:04:57.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku…
Dialogue: 0,0:04:58.29,0:05:00.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menyakitimu.
Dialogue: 0,0:05:01.05,0:05:04.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasa bersalah ini seolah akan\Nmenghancurkan hatiku.
Dialogue: 0,0:05:05.09,0:05:09.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus mengeluarkan emosi ini,\Natau aku takkan bisa bernapas!
Dialogue: 0,0:05:09.85,0:05:11.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang harus kulakukan?
Dialogue: 0,0:05:11.76,0:05:12.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia?
Dialogue: 0,0:05:14.93,0:05:16.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana caraku minta maaf?
Dialogue: 0,0:05:16.39,0:05:19.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski aku berlutut bertahun-tahun,
Dialogue: 0,0:05:19.19,0:05:21.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau memberimu harta karun\Ndari seluruh benua,
Dialogue: 0,0:05:22.36,0:05:25.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}dosa karena hampir membunuhmu\Ntakkan hilang!
Dialogue: 0,0:05:29.62,0:05:32.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia!
Dialogue: 0,0:05:32.37,0:05:34.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenanglah!
Dialogue: 0,0:05:36.79,0:05:40.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tak bisa menghindari\Npertukaran ini lagi.{\i0}
Dialogue: 0,0:05:40.79,0:05:43.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia, kau cerdas.
Dialogue: 0,0:05:43.30,0:05:47.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin bukan niatmu\Nmembuat kekacauan di negeri ini.
Dialogue: 0,0:05:47.26,0:05:49.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihatlah.
Dialogue: 0,0:05:49.01,0:05:53.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan hanya semua orang, bahkan pohon\Ndan rumput pun gemetar ketakutan.
Dialogue: 0,0:05:53.97,0:05:59.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan aku akan takut kepadamu\Nsaat hatimu kacau, Yang Mulia.
Dialogue: 0,0:06:04.28,0:06:07.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku di sini.
Dialogue: 0,0:06:08.53,0:06:12.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Keigetsu memang menggunakan\Nmantra pertukaran tubuh.
Dialogue: 0,0:06:12.99,0:06:19.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akibatnya, aku diberi tubuh yang sehat\Ndan dikaruniai seorang teman.
Dialogue: 0,0:06:20.00,0:06:21.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat?
Dialogue: 0,0:06:21.25,0:06:24.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini detak jantung yang sehat, 'kan?
Dialogue: 0,0:06:25.17,0:06:26.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Reirin.
Dialogue: 0,0:06:26.51,0:06:32.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama beberapa hari terakhir,\Naku sangat bahagia.
Dialogue: 0,0:06:34.10,0:06:37.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, tolong jangan\Nmenyiksa dirimu seperti itu.
Dialogue: 0,0:06:43.52,0:06:47.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku tidak bisa\Nmemanfaatkan kebaikanmu.
Dialogue: 0,0:06:48.32,0:06:49.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus menebus dosaku.
Dialogue: 0,0:06:49.95,0:06:51.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu…
Dialogue: 0,0:06:53.28,0:06:56.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah. Aku menerima niat baikmu.
Dialogue: 0,0:06:56.70,0:06:58.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia,
Dialogue: 0,0:06:58.29,0:07:02.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau ingin mendapatkan kembali\Nkepercayaanmu sebelumnya, 'kan?
Dialogue: 0,0:07:02.63,0:07:03.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:07:03.71,0:07:06.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, pertama-tama,
Dialogue: 0,0:07:06.00,0:07:10.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tolong jangan hukum Nyonya Shu Keigetsu\Nkarena pertukaran tubuh ini.
Dialogue: 0,0:07:10.13,0:07:11.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:07:11.22,0:07:14.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula,\NNyonya Keigetsu dikendalikan Selir Shu
Dialogue: 0,0:07:14.39,0:07:17.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan dia malah membuatku sangat bahagia.
Dialogue: 0,0:07:17.47,0:07:20.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, itu tidak bisa\Ndijadikan penebusan…
Dialogue: 0,0:07:20.52,0:07:22.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh membantah.
Dialogue: 0,0:07:22.23,0:07:28.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku orang yang ditegur\NYang Mulia sebagai penjahat.
Dialogue: 0,0:07:29.49,0:07:32.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, Yang Mulia harus\Ndengan tenang melakukan semua
Dialogue: 0,0:07:32.36,0:07:34.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}perintah penjahat ini.
Dialogue: 0,0:07:37.03,0:07:38.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Astaga.{\i0}
Dialogue: 0,0:07:38.79,0:07:40.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini persis seperti saat itu.{\i0}
Dialogue: 0,0:07:40.75,0:07:44.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia Shu Keigetsu, tapi bukan Shu Keigetsu.{\i0}
Dialogue: 0,0:07:45.63,0:07:49.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia Reirin,\Ntapi berbeda dari Reirin yang kukenal.{\i0}
Dialogue: 0,0:07:50.51,0:07:56.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkinkah jatuh cinta\Ndengan wanita yang sama dua kali?{\i0}
Dialogue: 0,0:07:59.27,0:08:02.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah. Aku tidak akan menghukum\NShu Keigetsu.
Dialogue: 0,0:08:03.77,0:08:05.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:08:05.90,0:08:08.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kalau begitu, yang kedua.\N- Apa?
Dialogue: 0,0:08:08.15,0:08:11.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tolong prioritaskan pendapat permaisuri,\Nselaku korban,{\i0}
Dialogue: 0,0:08:11.36,0:08:14.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}untuk hukuman Selir Kekaisaran Shu.{\i0}
Dialogue: 0,0:08:14.53,0:08:19.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tindakan Selir Kekaisaran\Ntak bisa dimaafkan,
Dialogue: 0,0:08:19.24,0:08:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku juga tak bisa menahan diri\Nuntuk melindungi seseorang,
Dialogue: 0,0:08:22.71,0:08:25.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}meski itu berarti menggunakan kutukan…
Dialogue: 0,0:08:26.08,0:08:28.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan jika berbuat salah.
Dialogue: 0,0:08:29.13,0:08:33.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa memahami ini\Nsebagai diriku yang asli,
Dialogue: 0,0:08:34.51,0:08:35.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku yakin
Dialogue: 0,0:08:36.59,0:08:38.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}inilah artinya hidup.
Dialogue: 0,0:08:42.60,0:08:43.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:08:43.81,0:08:45.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kukabulkan.
Dialogue: 0,0:08:47.73,0:08:50.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reirin, aku sungguh minta maaf.
Dialogue: 0,0:08:52.07,0:08:55.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maukah kau memanggilku "sepupu tersayang"\Nseperti sebelumnya?
Dialogue: 0,0:08:58.57,0:09:01.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, satu hal lagi.
Dialogue: 0,0:09:01.24,0:09:02.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:09:02.33,0:09:07.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Karena meski aku tidak kompeten,{\i0}
Dialogue: 0,0:09:07.46,0:09:09.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku ini seorang penjahat!{\i0}
Dialogue: 0,0:09:10.71,0:09:15.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong izinkan pertukaran tubuh\Nberulang kali di masa depan.
Dialogue: 0,0:09:15.97,0:09:17.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:09:17.59,0:09:18.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa…
Dialogue: 0,0:09:18.55,0:09:21.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika Yang Mulia mengabulkannya,
Dialogue: 0,0:09:21.64,0:09:24.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan memanggilmu "sepupu tersayang"
Dialogue: 0,0:09:24.56,0:09:27.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan bersumpah akan terus menjadi Gadismu.
Dialogue: 0,0:09:32.11,0:09:33.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:09:33.32,0:09:39.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kali ini,\Naku pasti akan menangkapmu, kupu-kupuku.
Dialogue: 0,0:09:50.59,0:09:52.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ayo kita bertukar kembali.
Dialogue: 0,0:09:52.92,0:09:53.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:09:54.88,0:09:56.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Keigetsu,
Dialogue: 0,0:09:56.34,0:10:00.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maaf jika aku lancang,\Ntapi sejak kali pertama kita bertukar,
Dialogue: 0,0:10:00.85,0:10:05.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sudah meningkatkan tubuhmu\Nhari demi hari.
Dialogue: 0,0:10:05.81,0:10:11.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kumohon, Nyonya Keigetsu,\Njaga baik-baik tubuh mengagumkan ini.
Dialogue: 0,0:10:12.36,0:10:14.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau berbuat seenaknya lagi.
Dialogue: 0,0:10:16.49,0:10:17.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga.
Dialogue: 0,0:10:18.74,0:10:21.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pastikan kau tidak terlalu gegabah,
Dialogue: 0,0:10:21.45,0:10:24.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan usahakan buat tubuhmu\Nyang lemah ini nyaman.
Dialogue: 0,0:10:28.37,0:10:29.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:10:54.69,0:10:58.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tiga hari setelah insiden itu,\Nsidang Selir Kekaisaran Shu diadakan.{\i0}
Dialogue: 0,0:10:58.99,0:11:00.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shu Gabi.
Dialogue: 0,0:11:01.20,0:11:03.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atas kejahatan penghinaan\Nterhadap Permaisuri,
Dialogue: 0,0:11:03.99,0:11:05.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}gelar Selir Kekaisaranmu dicopot.
Dialogue: 0,0:11:05.74,0:11:07.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan diusir.
Dialogue: 0,0:11:08.00,0:11:12.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shu Keigetsu, karena tidak menghentikan\Nkonspirasi walimu,
Dialogue: 0,0:11:12.12,0:11:14.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau akan dihukum penjara\Nselama tujuh hari.
Dialogue: 0,0:11:15.13,0:11:17.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua anggota Klan Shu lainnya\Ndianggap tidak bersalah.
Dialogue: 0,0:11:19.01,0:11:24.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Karena mengutuk Permaisuri\Ndan membahayakan dua orang Gadis,{\i0}
Dialogue: 0,0:11:24.76,0:11:27.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}ini perlakuan yang sangat lunak.{\i0}
Dialogue: 0,0:11:29.77,0:11:31.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau keberatan, Gyoumei?
Dialogue: 0,0:11:32.40,0:11:34.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya, ini kejahatan yang cukup besar
Dialogue: 0,0:11:34.31,0:11:37.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai Yang Maha Mulia Kaisar\Nbisa memusnahkan klan Shu.
Dialogue: 0,0:11:37.40,0:11:42.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai Permaisuri, aku dipercaya\Nmenangani urusan Istana Dalam.
Dialogue: 0,0:11:42.32,0:11:44.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kalau dilihat sekilas,
Dialogue: 0,0:11:44.03,0:11:48.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku hanya tersiksa karena flu berat\Nselama satu atau dua hari.
Dialogue: 0,0:11:59.51,0:12:01.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus. Kau boleh pergi.
Dialogue: 0,0:12:01.88,0:12:02.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:12:05.34,0:12:10.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini sangat panas,\Ntapi kau tampak kedinginan.
Dialogue: 0,0:12:11.81,0:12:13.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berani sekali kau.
Dialogue: 0,0:12:13.35,0:12:17.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Maha Mulia Permaisuri…
Dialogue: 0,0:12:17.86,0:12:19.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}muncul di hadapanku
Dialogue: 0,0:12:19.65,0:12:23.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tanpa satu orang pun yang menemaninya.
Dialogue: 0,0:12:24.24,0:12:25.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat itu?
Dialogue: 0,0:12:25.57,0:12:27.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau masih bisa sarkastis dalam penjara
Dialogue: 0,0:12:27.45,0:12:30.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di mana wanita biasa\Nbisa gila dalam hitungan jam.
Dialogue: 0,0:12:30.58,0:12:33.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benar-benar wanita tangguh.
Dialogue: 0,0:12:35.58,0:12:38.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik sulaman atau taktik pembunuhan,
Dialogue: 0,0:12:39.04,0:12:42.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau memang suka hal yang rumit.
Dialogue: 0,0:12:42.84,0:12:48.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa banyak usaha yang kau lakukan\Nuntuk menyingkirkan dendammu padaku?
Dialogue: 0,0:12:48.68,0:12:52.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga membimbing Shu Keigetsu\Nuntuk balas dendam?
Dialogue: 0,0:12:54.89,0:12:58.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kekanak-kanakan,\Ndia gadis berhati murni.
Dialogue: 0,0:12:58.06,0:13:02.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan mengendalikan hatinya,\Nkau menodai Reirin,
Dialogue: 0,0:13:02.03,0:13:05.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kenang-kenangan dari adikku,\Nharta terbesarku.
Dialogue: 0,0:13:05.07,0:13:07.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau begitu ingin menyiksaku?
Dialogue: 0,0:13:10.45,0:13:17.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ragu memanfaatkan Keigetsu.
Dialogue: 0,0:13:17.67,0:13:21.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun yang kukatakan, gadis itu…
Dialogue: 0,0:13:21.17,0:13:24.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan bodohnya menerima\Nsemuanya begitu saja.
Dialogue: 0,0:13:24.13,0:13:27.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia percaya padaku.
Dialogue: 0,0:13:28.43,0:13:30.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percaya…
Dialogue: 0,0:13:31.89,0:13:35.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika pangeranku masih hidup…
Dialogue: 0,0:13:36.85,0:13:40.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akankah dia begitu mengagumi ibunya?
Dialogue: 0,0:13:40.77,0:13:43.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah memikirkan itu beberapa kali.
Dialogue: 0,0:13:46.61,0:13:52.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir api kebencian itu ganas\Ndan berwarna merah tua.
Dialogue: 0,0:13:53.29,0:13:54.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski jalannya jahat,
Dialogue: 0,0:13:54.83,0:13:59.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jika itu memberimu semangat hidup,\Nkukira semua akan baik-baik saja.
Dialogue: 0,0:14:01.04,0:14:05.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, api kebencian\Npasti berwarna biru pucat.
Dialogue: 0,0:14:06.59,0:14:11.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seganas apa pun itu, pasti sedingin\Npenjara yang terbuat dari es.
Dialogue: 0,0:14:12.56,0:14:14.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Gabi…
Dialogue: 0,0:14:18.98,0:14:22.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jangan menyimpan dendammu lagi.
Dialogue: 0,0:14:22.19,0:14:27.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu, alih-alih membiarkanmu\Nmenghangatkan diri dengan api kebencian…
Dialogue: 0,0:14:27.86,0:14:31.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seharusnya aku datang\Nuntuk memelukmu seperti ini.
Dialogue: 0,0:14:32.83,0:14:37.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau benar-benar percaya\Nperkataan rubah betina klan Kin itu?
Dialogue: 0,0:14:37.96,0:14:40.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahwa aku mengambil takdir pangeranmu
Dialogue: 0,0:14:40.96,0:14:43.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar Gyoumei dihadiahi qi naga?
Dialogue: 0,0:14:43.59,0:14:45.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau benar-benar percaya?
Dialogue: 0,0:14:45.84,0:14:47.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tentu saja tidak.
Dialogue: 0,0:14:48.30,0:14:52.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Dari lubuk hatiku, aku ingin kau bahagia.
Dialogue: 0,0:15:03.15,0:15:04.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kuberikan padamu.
Dialogue: 0,0:15:04.36,0:15:10.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menarik talinya mungkin membuat kutukan\Nyang menimpamu sedikit takut.
Dialogue: 0,0:15:11.28,0:15:12.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingat kata-kata ini.
Dialogue: 0,0:15:13.37,0:15:16.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang, tidak ada\Nyang akan menarik busur untukmu.
Dialogue: 0,0:15:16.70,0:15:20.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya kau yang bisa menyelamatkan dirimu.
Dialogue: 0,0:15:21.50,0:15:23.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kau ingin balasan apa?{\i0}
Dialogue: 0,0:15:23.58,0:15:25.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang? Tombak?
Dialogue: 0,0:15:25.04,0:15:27.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau busur?
Dialogue: 0,0:15:27.17,0:15:30.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa pilihannya cuma senjata?
Dialogue: 0,0:15:30.34,0:15:32.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menganggapku musuh?
Dialogue: 0,0:15:32.18,0:15:36.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan konyol.\NKau tidak tahu arti memercayakan senjata?
Dialogue: 0,0:15:39.14,0:15:41.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa busur?
Dialogue: 0,0:15:42.14,0:15:44.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau menganggapku musuh?
Dialogue: 0,0:15:45.52,0:15:50.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan konyol.\NKau tidak tahu arti memercayakan senjata?
Dialogue: 0,0:15:50.95,0:15:52.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu.
Dialogue: 0,0:15:53.07,0:15:56.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kita berada jauh\Nhingga aku tak bisa bergegas ke sisimu,
Dialogue: 0,0:15:56.78,0:16:00.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}senjata itu akan terus\Nmelindungimu menggantikanku.
Dialogue: 0,0:16:01.87,0:16:05.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini persahabatan tertinggi.\NTiada yang melebihinya.
Dialogue: 0,0:16:06.63,0:16:09.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu betul.
Dialogue: 0,0:16:15.55,0:16:16.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku…
Dialogue: 0,0:16:18.14,0:16:20.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selama 20 tahun terakhir…
Dialogue: 0,0:16:20.27,0:16:25.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dari lubuk hatiku, aku ingin kau bahagia.{\i0}
Dialogue: 0,0:16:25.65,0:16:31.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}…hanya ingin mendengar\Nkata-kata itu darimu.
Dialogue: 0,0:16:32.32,0:16:33.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Kenshuu.
Dialogue: 0,0:16:41.12,0:16:43.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku datang untuk melaporkan
Dialogue: 0,0:16:43.66,0:16:47.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahwa Nyonya Shu Gabi baru saja\Nmeninggalkan Istana Dalam.
Dialogue: 0,0:16:48.13,0:16:50.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.\NTerima kasih sudah memberitahuku.
Dialogue: 0,0:16:55.18,0:16:59.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memegang karung rami besar\Nseolah itu harta karun.
Dialogue: 0,0:16:59.05,0:17:03.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski lambat, langkahnya tidak goyah.
Dialogue: 0,0:17:04.94,0:17:08.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Busur adalah senjata\Nyang tidak bisa dikendalikan.
Dialogue: 0,0:17:08.94,0:17:12.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada cara mengikuti\Nkeberadaan anak panah setelah dilepaskan.
Dialogue: 0,0:17:15.07,0:17:20.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, busur adalah senjata yang bisa\Nmelindungi seseorang yang sangat jauh.
Dialogue: 0,0:17:21.08,0:17:23.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih dari senjata lain.
Dialogue: 0,0:17:23.95,0:17:26.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah yang kuyakini.
Dialogue: 0,0:17:28.71,0:17:30.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuharap begitu.
Dialogue: 0,0:17:32.96,0:17:34.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reirin.
Dialogue: 0,0:17:35.67,0:17:38.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak boleh mengulangi apa\Nyang telah terjadi.
Dialogue: 0,0:17:39.18,0:17:42.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Aku akan mengingatnya.
Dialogue: 0,0:17:44.06,0:17:45.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reirin…
Dialogue: 0,0:17:45.68,0:17:48.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}makin hari kau makin cantik.
Dialogue: 0,0:17:50.11,0:17:51.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seishuu.
Dialogue: 0,0:17:52.19,0:17:54.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku bisa menepati janjiku?
Dialogue: 0,0:17:59.70,0:18:02.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, silakan dimakan.
Dialogue: 0,0:18:03.37,0:18:07.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau jadi mengunjungiku setiap hari?
Dialogue: 0,0:18:07.21,0:18:11.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa setengah hati\Nmenunjukkan persahabatanku.
Dialogue: 0,0:18:11.13,0:18:13.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini sibuk!
Dialogue: 0,0:18:13.13,0:18:15.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan penganan tak menarik\Nkalau diberikan tiap hari.
Dialogue: 0,0:18:15.67,0:18:17.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:18:17.34,0:18:20.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya aku juga\Nmenyiapkan sesuatu yang gurih.
Dialogue: 0,0:18:20.18,0:18:22.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan itu maksudku!
Dialogue: 0,0:18:24.35,0:18:26.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuacanya bagus.
Dialogue: 0,0:18:26.60,0:18:31.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti menyenangkan menghabiskan\Nhari-hari seperti ini di luar.
Dialogue: 0,0:18:31.19,0:18:32.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu…
Dialogue: 0,0:18:40.41,0:18:43.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, keringatnya banyak sekali.
Dialogue: 0,0:18:43.28,0:18:44.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyedihkan.
Dialogue: 0,0:18:45.24,0:18:48.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau tidak lebih\Nmempertimbangkan penampilanmu?
Dialogue: 0,0:18:48.62,0:18:53.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan hanya berdiri di sana.\NCepat berteduh.
Dialogue: 0,0:18:53.00,0:18:56.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih baik kau pakai ini\Nuntuk menyejukkan pembuluh darah besarmu.
Dialogue: 0,0:18:56.30,0:18:58.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Anu…\N- Menjijikkan sekali.
Dialogue: 0,0:18:58.09,0:19:01.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah selesai mencabut rumput liar.
Dialogue: 0,0:19:01.22,0:19:02.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kau ini genius, ya?\N- Hei…
Dialogue: 0,0:19:02.97,0:19:05.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas-jelas kau Nyonya Reirin.
Dialogue: 0,0:19:05.43,0:19:07.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Bagaimana kau tahu?
Dialogue: 0,0:19:07.93,0:19:10.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku sudah susah payah\Nmembuat daftar
Dialogue: 0,0:19:10.27,0:19:12.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}perkiraan pertanyaan\Ndan menghafal semuanya!
Dialogue: 0,0:19:12.40,0:19:15.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan usaha sia-sia itu.
Dialogue: 0,0:19:15.52,0:19:16.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat dirimu.
Dialogue: 0,0:19:16.82,0:19:19.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau dengan santai bermain\Ndengan kutu kayu!
Dialogue: 0,0:19:19.36,0:19:20.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa menahannya!
Dialogue: 0,0:19:20.86,0:19:25.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuharap Yang Mulia tidak datang hari ini.
Dialogue: 0,0:19:25.16,0:19:29.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar ada perjamuan semalam\Nyang berlangsung sampai hampir subuh.
Dialogue: 0,0:19:29.29,0:19:34.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin dia sangat lelah\Ndan tidak bisa banyak bergerak pagi ini.
Dialogue: 0,0:19:36.25,0:19:40.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sejak saat itu, Yang Mulia\Nmengunjungi Istana Kou dan Istana Shu{\i0}
Dialogue: 0,0:19:40.01,0:19:41.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}minimal tiap tiga hari.{\i0}
Dialogue: 0,0:19:42.26,0:19:46.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, dia sudah dua kali\Nmelewatkan pertukaran para Gadis.{\i0}
Dialogue: 0,0:19:46.97,0:19:51.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Karena Yang Mulia sering\Nmengunjungi Istana Shu,{\i0}
Dialogue: 0,0:19:51.10,0:19:54.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Klan Shu terhindar\Ndari serangan klan lain.{\i0}
Dialogue: 0,0:19:54.27,0:19:56.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku yakin Nyonya Reirin\Nsudah memikirkannya{\i0}
Dialogue: 0,0:19:56.57,0:19:58.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}saat mengusulkan ide itu.{\i0}
Dialogue: 0,0:19:59.78,0:20:03.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kou Reirin, sudah cukup, 'kan?
Dialogue: 0,0:20:04.49,0:20:05.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Keigetsu!
Dialogue: 0,0:20:07.03,0:20:10.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, ampun. Kita, 'kan, baru bertukar.
Dialogue: 0,0:20:10.83,0:20:15.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena wanita itu berniat membunuhku!
Dialogue: 0,0:20:15.58,0:20:16.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga.
Dialogue: 0,0:20:16.84,0:20:19.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggap saja itu cara\NTousetsu menunjukkan kasih sayang.
Dialogue: 0,0:20:20.26,0:20:21.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Setiap kali bertukar,{\i0}
Dialogue: 0,0:20:21.59,0:20:25.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Nyonya Keigetsu menjalani latihan\Nmelelahkan dari kepala dayang.{\i0}
Dialogue: 0,0:20:25.84,0:20:30.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Leelee, kenapa kau\Nmasih memakai pakaian merah menyala?
Dialogue: 0,0:20:30.85,0:20:33.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah memberimu pakaian emas gamboge.
Dialogue: 0,0:20:33.23,0:20:35.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Itu karena
Dialogue: 0,0:20:35.81,0:20:37.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}waktu kalian bertukar seperti ini,
Dialogue: 0,0:20:37.48,0:20:40.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lebih baik ada orang yang tahu\Ndi pihak kalian, 'kan?
Dialogue: 0,0:20:40.69,0:20:43.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang benar, tapi…
Dialogue: 0,0:20:43.03,0:20:46.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada orang sepertimu\Njuga tidak masalah.
Dialogue: 0,0:20:46.20,0:20:47.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:20:47.99,0:20:53.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sejujurnya, ada alasan lain kenapa aku\Ntidak memakai pakaian emas gamboge.{\i0}
Dialogue: 0,0:20:54.12,0:20:58.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika tinggal di sini, aku bisa terus\Nmenjadi orang spesial bagi Nyonya Reirin.{\i0}
Dialogue: 0,0:20:59.71,0:21:04.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kurasa itu juga sama bagi Nyonya Keigetsu\Nyang terus bersedia bertukar.{\i0}
Dialogue: 0,0:21:04.01,0:21:08.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku yakin itu karena dia\Nbisa berbagi rahasia khusus.{\i0}
Dialogue: 0,0:21:08.76,0:21:11.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Yang Mulia dan hasratnya mengenali\Nyang asli.{\i0}
Dialogue: 0,0:21:12.60,0:21:13.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kepala dayang{\i0}
Dialogue: 0,0:21:13.89,0:21:16.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}yang lebih sering berada di dekat\NNyonya Reirin dengan setia.{\i0}
Dialogue: 0,0:21:17.23,0:21:21.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kapten Mata Elang yang sering berkunjung,\Nberpura-pura itu pekerjaannya.{\i0}
Dialogue: 0,0:21:21.69,0:21:24.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bagi semua orang, Nyonya Reirin…{\i0}
Dialogue: 0,0:21:24.95,0:21:28.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}kupu-kupu berkaki ringan\Ndan elegan ini adalah{\i0}
Dialogue: 0,0:21:28.32,0:21:30.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}kupu-kupu yang ingin mereka rengkuh.{\i0}
Dialogue: 0,0:21:31.33,0:21:36.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ini memang cukup jahat, ya.
Dialogue: 0,0:21:40.17,0:21:43.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, ini Istana Vermillion?
Dialogue: 0,0:21:43.09,0:21:46.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan gerbangnya agak mencolok.
Dialogue: 0,0:21:46.01,0:21:49.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak, tidak baik masuk tanpa izin.
Dialogue: 0,0:21:50.47,0:21:52.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bisa dihajar bibi habis-habisan
Dialogue: 0,0:21:52.89,0:21:55.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebelum bertemu kembali\Ndengan adik kita tersayang.
Dialogue: 0,0:21:56.35,0:21:58.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, bukankah kau ingin melihat sekilas?
Dialogue: 0,0:21:59.98,0:22:02.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku wajah si penjahat
Dialogue: 0,0:22:02.11,0:22:05.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang mendorong adik kesayangan kita\Ndari Pagoda Ketujuh.
Dialogue: 0,0:23:38.08,0:23:40.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa. Biar aku saja.
Dialogue: 0,0:23:40.21,0:23:42.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shu Keigetsu.
Dialogue: 0,0:23:42.42,0:23:45.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita buat penjahat\Nyang menyebarkan bencana ini
Dialogue: 0,0:23:45.46,0:23:49.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memahami perasaan kita,\Npara warga yang terpojok.
