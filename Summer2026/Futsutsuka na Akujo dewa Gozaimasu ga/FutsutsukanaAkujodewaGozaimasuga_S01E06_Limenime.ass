Dialogue: 0,0:00:14.01,0:00:15.18,sign,,0000,0000,0000,,GADIS KLAN SHU, SHU KEIGETSU\N(JIWA REIRIN)
Dialogue: 0,0:00:28.31,0:00:29.23,sign,,0000,0000,0000,,GADIS KLAN KIN - KIN SEIKA
Dialogue: 0,0:00:40.58,0:00:42.58,sign,,0000,0000,0000,,KEPALA DAYANG REIRIN\NKOU TOUSETSU
Dialogue: 0,0:01:13.23,0:01:15.74,sign,,0000,0000,0000,,GADIS KLAN KOU - KOU REIRIN\N(JIWA KEIGETSU)
Dialogue: 0,0:13:28.59,0:13:29.51,sign,,0000,0000,0000,,KASIM BUNKOU
Dialogue: 0,0:00:01.71,0:00:07.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kau memanggil Nyonya Gayou\Nyang memakai sutra gading?
Dialogue: 0,0:00:07.75,0:00:12.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, tak ada yang bernama "Gayou"\Ndi antara sutra gading.
Dialogue: 0,0:00:12.76,0:00:14.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:00:18.39,0:00:23.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku dengar seseorang meratapi\Nkehilangan jepit rambutnya.
Dialogue: 0,0:00:24.44,0:00:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Nyonya Seika…
Dialogue: 0,0:00:25.56,0:00:28.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau punya dayang\Nyang kehilangan jepit rambutnya?
Dialogue: 0,0:00:29.23,0:00:31.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira kapan itu terjadi?
Dialogue: 0,0:00:31.36,0:00:34.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya sekitar satu bulan lalu.
Dialogue: 0,0:00:35.24,0:00:36.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu bulan…
Dialogue: 0,0:00:42.58,0:00:45.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf aku sudah lancang selama ritual.
Dialogue: 0,0:00:50.09,0:00:52.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Tousetsu?
Dialogue: 0,0:00:52.21,0:00:56.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Maha Mulia,\Ntolong segera kembali ke Istana Kou!
Dialogue: 0,0:00:56.09,0:00:57.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya…
Dialogue: 0,0:00:57.72,0:01:02.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Nyonya Reirin pingsan karena demam!
Dialogue: 0,0:01:03.60,0:01:04.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:01:15.74,0:01:17.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Reirin!
Dialogue: 0,0:01:17.16,0:01:18.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertahanlah!
Dialogue: 0,0:02:51.96,0:02:54.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tousetsu, kau sudah memanggil tabib?
Dialogue: 0,0:02:54.29,0:02:59.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kami sudah memanggil mereka,\Ntapi tak ada obat yang manjur.
Dialogue: 0,0:02:59.17,0:03:03.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Reirin sering jatuh sakit,\Ntapi hal seperti ini belum pernah terjadi.
Dialogue: 0,0:03:06.56,0:03:07.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam.
Dialogue: 0,0:03:11.14,0:03:13.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti sekarang.
Dialogue: 0,0:03:13.23,0:03:15.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tousetsu, kau adalah kepala dayang.
Dialogue: 0,0:03:15.82,0:03:18.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak boleh menunjukkan kegelisahanmu.
Dialogue: 0,0:03:19.28,0:03:22.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski seperti itu,\Ntekad Reirin cukup kuat.
Dialogue: 0,0:03:22.24,0:03:24.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia dengan berani terus bertahan.
Dialogue: 0,0:03:24.57,0:03:27.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa yang lain malah panik?
Dialogue: 0,0:03:27.04,0:03:28.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, Yang Maha Mulia,
Dialogue: 0,0:03:28.33,0:03:31.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kali ini berbeda dengan biasanya.
Dialogue: 0,0:03:31.71,0:03:36.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku khawatir Nyonya Reirin\Ntakkan bisa bertahan melewati hari ini.
Dialogue: 0,0:03:44.80,0:03:45.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seandainya…
Dialogue: 0,0:03:47.01,0:03:49.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggaplah anak yang sangat kucintai
Dialogue: 0,0:03:49.39,0:03:53.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}benar-benar akan meninggal hari ini.
Dialogue: 0,0:03:53.19,0:03:55.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tetaplah takdirnya.
Dialogue: 0,0:03:57.98,0:03:59.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Maha Mulia!
Dialogue: 0,0:04:01.11,0:04:04.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, jika dia melawannya\Ndan berusaha tetap hidup,
Dialogue: 0,0:04:04.49,0:04:08.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita tidak boleh ragu\Nuntuk membantunya dengan cara apa pun.
Dialogue: 0,0:04:08.99,0:04:11.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Mengerti, Tousetsu?\N- Baik!
Dialogue: 0,0:04:11.41,0:04:12.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kin Seika.
Dialogue: 0,0:04:14.00,0:04:15.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu ritual yang mengagumkan.
Dialogue: 0,0:04:15.88,0:04:17.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf aku harus pergi sebelum selesai.
Dialogue: 0,0:04:18.71,0:04:21.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata-kata itu lebih dari\Nyang pantas kudapatkan.
Dialogue: 0,0:04:25.64,0:04:28.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Yang Mulia Pangeran\Ndan Yang Maha Mulia Permaisuri.
Dialogue: 0,0:04:30.72,0:04:35.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon, izinkan aku\Nmengunjungi Istana Kou juga.
Dialogue: 0,0:04:36.40,0:04:37.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa katamu?
Dialogue: 0,0:04:37.77,0:04:41.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya pengetahuan tentang merawat.
Dialogue: 0,0:04:41.73,0:04:45.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin bisa menyembuhkan penyakitnya.
Dialogue: 0,0:04:45.15,0:04:46.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan konyol!
Dialogue: 0,0:04:46.91,0:04:50.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu kau lebih terampil\Ndaripada seorang tabib?
Dialogue: 0,0:04:50.62,0:04:55.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setahuku, satu-satunya orang\Nyang bisa selancang itu hanya Reirin.
Dialogue: 0,0:04:55.37,0:04:58.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Itu sebabnya…\N- Kau harus tahu diri, Shu Keigetsu.
Dialogue: 0,0:04:58.17,0:05:00.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau begitu bersikeras?
Dialogue: 0,0:05:00.75,0:05:04.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang tahu kau iri pada Reirin
Dialogue: 0,0:05:04.09,0:05:06.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan selalu memelototinya dengan jijik.
Dialogue: 0,0:05:07.22,0:05:09.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:05:13.18,0:05:15.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, Yang Mulia benar.
Dialogue: 0,0:05:15.69,0:05:18.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang memelototinya.
Dialogue: 0,0:05:18.69,0:05:21.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, itu bukan karena niat buruk.
Dialogue: 0,0:05:22.98,0:05:27.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena aku menyukainya!
Dialogue: 0,0:05:27.57,0:05:29.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa wajahmu memerah?
Dialogue: 0,0:05:30.87,0:05:32.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mohon.
Dialogue: 0,0:05:32.45,0:05:35.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggap saja itu hadiah\Nuntuk tarianku tadi.
Dialogue: 0,0:05:36.46,0:05:41.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Karena aku pernah menyusahkannya,\Naku harus menyelamatkannya.
Dialogue: 0,0:05:44.05,0:05:45.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak percaya padamu.
Dialogue: 0,0:05:47.63,0:05:48.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:05:49.22,0:05:52.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shu Keigetsu,\Njika kau akan bertindak sejauh itu,
Dialogue: 0,0:05:52.64,0:05:54.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan memberimu kesempatan.
Dialogue: 0,0:05:54.97,0:05:57.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Maha Mulia! Terima kasih ban…
Dialogue: 0,0:05:57.39,0:05:59.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, itu bukan kesempatan\Nsebagai perawat.
Dialogue: 0,0:05:59.85,0:06:03.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melainkan kesempatan bagimu\Nuntuk mendapatkan kepercayaan kami lagi.
Dialogue: 0,0:06:04.61,0:06:07.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Mata Elang.\NBawakan Busur Pelindung.
Dialogue: 0,0:06:08.40,0:06:09.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hormat, Yang Maha Mulia,
Dialogue: 0,0:06:09.91,0:06:12.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Busur Pelindung adalah harta keramat\Nyang dijaga oleh Klan Gen
Dialogue: 0,0:06:12.83,0:06:14.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan {\i1}qi{\i0} airnya sangat kuat.
Dialogue: 0,0:06:15.24,0:06:17.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin itu tidak cocok
Dialogue: 0,0:06:17.41,0:06:20.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk putri Klan Shu yang diberkati api.
Dialogue: 0,0:06:20.00,0:06:21.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru itu alasannya.
Dialogue: 0,0:06:21.67,0:06:23.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tugas mengukur ketulusan
Dialogue: 0,0:06:23.84,0:06:26.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti tidak sederhana, 'kan?
Dialogue: 0,0:06:26.88,0:06:27.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:06:38.73,0:06:40.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sesuatu seberat ini?{\i0}
Dialogue: 0,0:06:42.90,0:06:46.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Busur itu merasakan penyakit\Nmelalui getaran senar
Dialogue: 0,0:06:46.61,0:06:49.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan memurnikannya\Nlewat suara saat mengenai sasaran.
Dialogue: 0,0:06:49.53,0:06:53.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau bisa menarik busur ini semalaman\Nuntuk mendoakan kesembuhan Reirin,
Dialogue: 0,0:06:53.87,0:06:57.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan menganggapmu tak berniat jahat\Ndan mengizinkanmu merawatnya.
Dialogue: 0,0:06:57.79,0:06:59.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Semalaman?{\i0}
Dialogue: 0,0:07:03.54,0:07:07.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tantangan yang layak dicoba!
Dialogue: 0,0:07:07.05,0:07:09.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Maha Mulia Permaisuri memang hebat.
Dialogue: 0,0:07:13.64,0:07:16.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mewujudkannya, Penjagaan Busur!
Dialogue: 0,0:07:31.07,0:07:34.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu, tolong keluarkan aku! Kumohon!
Dialogue: 0,0:07:35.99,0:07:37.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini mimpi.{\i0}
Dialogue: 0,0:07:37.91,0:07:39.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diamlah.
Dialogue: 0,0:07:39.70,0:07:43.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau membuatku malu,\Njadi aku harus menyembunyikanmu.
Dialogue: 0,0:07:43.25,0:07:46.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuhmu besar dan jelek.\NAnak yang memalukan.
Dialogue: 0,0:07:53.68,0:07:59.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tak ingat kapan, tapi aku mulai bicara\Ndengan api untuk mencari kehangatan.{\i0}
Dialogue: 0,0:08:00.43,0:08:04.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku baru tahu itu sihir terlarang\Nsetelah melihat gulungan Ayah.{\i0}
Dialogue: 0,0:08:04.81,0:08:09.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kemudian, saat aku bisa\Nmengendalikannya sesukaku…{\i0}
Dialogue: 0,0:08:12.53,0:08:15.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kehilangan kedua orang tua di usiamu.
Dialogue: 0,0:08:15.03,0:08:17.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti sangat menyedihkan.
Dialogue: 0,0:08:17.24,0:08:21.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Satu-satunya saat aku mengingat\Nrasa percaya adalah{\i0}
Dialogue: 0,0:08:21.87,0:08:26.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}saat Selir Agung Shu membimbingku.{\i0}
Dialogue: 0,0:08:27.63,0:08:28.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun…{\i0}
Dialogue: 0,0:08:32.26,0:08:37.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai kau juga bisa seperti Nyonya Reirin.
Dialogue: 0,0:08:41.60,0:08:43.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalau begitu, aku akan menjadi dia.{\i0}
Dialogue: 0,0:08:47.44,0:08:51.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kini, akhirnya kemalangan\Nyang aku alami akan berakhir,{\i0}
Dialogue: 0,0:08:51.86,0:08:54.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan hari-hari cemerlang akan dimulai.{\i0}
Dialogue: 0,0:08:54.95,0:08:56.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Atau begitulah yang kukira.{\i0}
Dialogue: 0,0:09:01.12,0:09:03.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!
Dialogue: 0,0:09:10.09,0:09:11.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Nyonya?
Dialogue: 0,0:09:11.09,0:09:12.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Nyonya Reirin!
Dialogue: 0,0:09:17.80,0:09:19.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa aku…{\i0}
Dialogue: 0,0:09:20.18,0:09:21.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}akan mati?{\i0}
Dialogue: 0,0:09:45.33,0:09:47.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya, aku bawakan air.
Dialogue: 0,0:09:50.88,0:09:54.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bilang kali ini pasti makan.
Dialogue: 0,0:09:59.93,0:10:01.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau mendengarkanku?
Dialogue: 0,0:10:02.39,0:10:03.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leelee,
Dialogue: 0,0:10:03.89,0:10:05.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maafkan aku.
Dialogue: 0,0:10:05.27,0:10:10.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kita bicara soal madu atau garam\Nyang lebih enak untuk kentang goreng?
Dialogue: 0,0:10:10.02,0:10:12.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau hanya mereka-reka saja!
Dialogue: 0,0:10:12.90,0:10:16.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku kau harus makan dengan teratur.
Dialogue: 0,0:10:16.07,0:10:17.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga.
Dialogue: 0,0:10:17.65,0:10:20.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bilang, 'kan?
Dialogue: 0,0:10:20.03,0:10:23.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah melakukan Pusaran Sogdian\Nyang intens di ritual Festival Hantu,
Dialogue: 0,0:10:24.62,0:10:27.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}kau langsung kembali untuk meracik obat{\i0}
Dialogue: 0,0:10:28.29,0:10:30.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan mengantarnya ke Istana Kou.{\i0}
Dialogue: 0,0:10:30.12,0:10:34.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ketulusanku diterima,\Ntolong gunakan obat ini.
Dialogue: 0,0:10:34.63,0:10:39.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dan kau sudah memanah\Nselama enam jam berturut-turut.{\i0}
Dialogue: 0,0:10:39.34,0:10:41.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini, kau juga bisa pingsan.
Dialogue: 0,0:10:41.97,0:10:45.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, Leelee, kau mencemaskanku, ya?
Dialogue: 0,0:10:46.89,0:10:48.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau sampai pingsan,
Dialogue: 0,0:10:48.73,0:10:51.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tak punya tempat bermalam lagi.
Dialogue: 0,0:10:51.48,0:10:53.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu saja.
Dialogue: 0,0:10:54.40,0:10:57.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti perasaanmu, Leelee.
Dialogue: 0,0:10:57.23,0:10:58.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:10:59.61,0:11:02.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku tak akan pingsan
Dialogue: 0,0:11:03.37,0:11:05.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai aku menyelamatkannya.
Dialogue: 0,0:11:20.55,0:11:23.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih belum ada kabar dari Istana Kou?
Dialogue: 0,0:11:23.34,0:11:25.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf.
Dialogue: 0,0:11:25.05,0:11:28.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seluruh istana sudah disegel,\Ndan itu cukup sulit.
Dialogue: 0,0:11:28.27,0:11:31.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa. Bukan salahmu.
Dialogue: 0,0:11:37.02,0:11:40.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gyoumei, kembalilah ke Istana Utama.
Dialogue: 0,0:11:40.11,0:11:41.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun…
Dialogue: 0,0:11:41.28,0:11:43.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini juga permintaan dari Klan Kou.
Dialogue: 0,0:11:45.70,0:11:46.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku merasa tak berguna.{\i0}
Dialogue: 0,0:11:47.41,0:11:51.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tak bisa berbuat apa-apa\Nuntuk menolong wanita yang kucintai.{\i0}
Dialogue: 0,0:11:51.71,0:11:53.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Selalu seperti ini.{\i0}
Dialogue: 0,0:11:53.29,0:11:58.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kelihatannya saja aku diberi\Nwewenang tertinggi sebagai putra mahkota,{\i0}
Dialogue: 0,0:11:58.13,0:12:00.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tapi aku selalu dijauhkan dari masalah,{\i0}
Dialogue: 0,0:12:00.42,0:12:03.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}bagai burung dalam sangkar.{\i0}
Dialogue: 0,0:12:05.05,0:12:07.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Senang bertemu denganmu.{\i0}
Dialogue: 0,0:12:07.68,0:12:09.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Reirin.
Dialogue: 0,0:12:15.94,0:12:17.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau memakai riasan?
Dialogue: 0,0:12:19.11,0:12:24.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena jika aku tidak pucat,\Nsemua orang tampak lebih bahagia.
Dialogue: 0,0:12:26.32,0:12:29.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sejak hari itu, aku selalu…{\i0}
Dialogue: 0,0:12:32.04,0:12:33.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia.
Dialogue: 0,0:12:33.58,0:12:36.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan laporan dari Istana Kou,
Dialogue: 0,0:12:36.54,0:12:38.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ada laporan Nyonya Shu Keigetsu
Dialogue: 0,0:12:38.88,0:12:41.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terus menarik Busur Pelindung
Dialogue: 0,0:12:41.59,0:12:43.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selama enam jam.
Dialogue: 0,0:12:43.72,0:12:45.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enam jam, katamu?
Dialogue: 0,0:12:45.18,0:12:48.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Dia menolak makan dan berusaha keras.
Dialogue: 0,0:12:48.93,0:12:52.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak kasim yang mengawasinya terkesan.
Dialogue: 0,0:12:59.11,0:13:00.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kena!
Dialogue: 0,0:13:01.57,0:13:04.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, masih cukup jauh dari sasaran.
Dialogue: 0,0:13:04.61,0:13:06.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kemajuan.
Dialogue: 0,0:13:06.53,0:13:07.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu.
Dialogue: 0,0:13:07.87,0:13:13.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti kau sangat ingin\Nmenyelamatkan Nyonya Kou Reirin,
Dialogue: 0,0:13:13.08,0:13:15.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi bukankah ini sudah cukup?
Dialogue: 0,0:13:15.46,0:13:16.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu benar.
Dialogue: 0,0:13:17.37,0:13:18.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Mata Elang?
Dialogue: 0,0:13:18.92,0:13:20.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Bunkou juga.
Dialogue: 0,0:13:20.42,0:13:21.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang apa di sini?
Dialogue: 0,0:13:21.75,0:13:23.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena dayang dan kasim
Dialogue: 0,0:13:23.55,0:13:27.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menghubungi kami karena tak tahan\Nmelihat Gadis ceroboh ini.
Dialogue: 0,0:13:27.64,0:13:28.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, 'kan, Kapten?
Dialogue: 0,0:13:29.51,0:13:34.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shu Keigetsu, jika kau memanah\Nuntuk menebus dosamu, ini sudah cukup.
Dialogue: 0,0:13:35.14,0:13:37.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami dapat kabar dari Istana Kou
Dialogue: 0,0:13:37.48,0:13:39.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau tak ada gunanya lagi memanah.
Dialogue: 0,0:13:40.15,0:13:42.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, tak perlu menarik busur itu lagi.
Dialogue: 0,0:13:43.40,0:13:47.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, dia sudah minum obatku?
Dialogue: 0,0:13:47.74,0:13:50.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Kou Reirin belum sadar.
Dialogue: 0,0:13:50.32,0:13:52.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tak bisa minum apa pun,
Dialogue: 0,0:13:52.28,0:13:54.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}termasuk obat dari tabib.
Dialogue: 0,0:13:54.58,0:13:56.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:13:57.00,0:14:00.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Naku harus menarik busur ini lagi.
Dialogue: 0,0:14:00.33,0:14:02.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tidak berhenti saja?
Dialogue: 0,0:14:02.46,0:14:05.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang,\Nmereka sudah tahu ketulusanmu.
Dialogue: 0,0:14:06.34,0:14:07.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangan kanan itu.
Dialogue: 0,0:14:08.38,0:14:09.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:14:09.47,0:14:10.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu…
Dialogue: 0,0:14:10.72,0:14:11.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:14:11.72,0:14:12.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini…
Dialogue: 0,0:14:13.76,0:14:15.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau lakukan?
Dialogue: 0,0:14:15.98,0:14:17.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanganmu terluka.
Dialogue: 0,0:14:17.73,0:14:19.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baik-baik saja.
Dialogue: 0,0:14:19.94,0:14:23.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat berhati-hati\Nagar harta keramat ini tak kena darah.
Dialogue: 0,0:14:23.36,0:14:25.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan itu maksudku!
Dialogue: 0,0:14:25.23,0:14:27.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:14:27.61,0:14:28.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bilang
Dialogue: 0,0:14:28.74,0:14:32.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena aku tidak fokus akibat takut\Nmengotorinya, konsentrasiku menipis.
Dialogue: 0,0:14:32.62,0:14:34.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu, dasar bodoh!
Dialogue: 0,0:14:34.37,0:14:36.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku memang bodoh!
Dialogue: 0,0:14:36.62,0:14:38.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan busur itu padaku.
Dialogue: 0,0:14:38.96,0:14:40.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau!
Dialogue: 0,0:14:40.12,0:14:41.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shu Keigetsu!
Dialogue: 0,0:14:41.38,0:14:44.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau menghentikanku,\NKapten Mata Elang?
Dialogue: 0,0:14:44.71,0:14:46.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah aku ini penjahat?
Dialogue: 0,0:14:46.84,0:14:50.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Rasanya tidak masuk akal\Nkalau luka wanita seperti itu
Dialogue: 0,0:14:50.13,0:14:53.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}terlalu dibesar-besarkan semua orang.
Dialogue: 0,0:14:54.31,0:14:56.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kapten Mata Elang! Tuan Bunkou!
Dialogue: 0,0:14:58.06,0:15:03.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demam Nyonya Kou Reirin perlahan turun\Ndan ada tanda-tanda kesembuhan!
Dialogue: 0,0:15:05.73,0:15:07.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan segera memberi tahu Yang Mulia.
Dialogue: 0,0:15:08.61,0:15:11.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti, aku akan mengutus tabib ke sini.
Dialogue: 0,0:15:11.49,0:15:12.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lukamu harus dirawat.
Dialogue: 0,0:15:12.74,0:15:15.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan berhentilah memanah.
Dialogue: 0,0:15:15.53,0:15:17.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski ekspresi wajahmu tenang,
Dialogue: 0,0:15:18.00,0:15:20.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jumlah keringat yang tak normal itu\Nmenguji batasmu.
Dialogue: 0,0:15:22.25,0:15:26.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dayang, jika terjadi sesuatu,\Nsegera hubungi kantor Mata Elang.
Dialogue: 0,0:15:26.13,0:15:27.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:15:31.30,0:15:32.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:15:33.18,0:15:34.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!
Dialogue: 0,0:15:34.64,0:15:37.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya rawat dulu lukamu.
Dialogue: 0,0:15:37.39,0:15:40.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Kou Reirin mulai pulih.
Dialogue: 0,0:15:40.23,0:15:41.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sudah cukup, 'kan?
Dialogue: 0,0:15:43.31,0:15:46.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leelee, entah kenapa aku…
Dialogue: 0,0:15:47.11,0:15:51.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cukup menikmati situasi ini.
Dialogue: 0,0:15:51.45,0:15:52.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:15:53.20,0:15:55.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Meski ini harta suci\Ndengan{\i0} qi {\i1}air yang kuat,{\i0}
Dialogue: 0,0:15:55.66,0:16:00.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}karena{\i0} qi {\i1}tanahku kuat,\Nseharusnya aku bisa mengendalikannya.{\i0}
Dialogue: 0,0:16:00.58,0:16:05.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tanganku mulai mati rasa,\Ntapi akurasinya meningkat secara bertahap.{\i0}
Dialogue: 0,0:16:05.54,0:16:10.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku merasa busurnya perlahan\Nmulai terbiasa denganku.{\i0}
Dialogue: 0,0:16:12.13,0:16:14.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia, ada kabar baik.
Dialogue: 0,0:16:14.47,0:16:17.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.\NAda tanda-tanda kesembuhan.
Dialogue: 0,0:16:17.85,0:16:19.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:16:19.85,0:16:21.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:16:25.02,0:16:26.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan keluar sebentar.
Dialogue: 0,0:16:26.65,0:16:27.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ambil obor.
Dialogue: 0,0:16:27.69,0:16:30.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia,\Naku mengerti kau ingin bergegas,
Dialogue: 0,0:16:30.53,0:16:34.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kenapa tak menunggu sampai fajar\Nuntuk mengunjungi Istana Kou?
Dialogue: 0,0:16:34.53,0:16:37.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu itu.\NAku akan ke Mata Air Naga Ungu.
Dialogue: 0,0:16:37.53,0:16:39.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mata Air Naga Ungu?
Dialogue: 0,0:16:39.49,0:16:41.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya Kota Terlarang…
Dialogue: 0,0:16:42.33,0:16:44.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untungnya tubuhku sudah dimurnikan.
Dialogue: 0,0:16:44.50,0:16:47.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu air dari Mata Air Naga Ungu\Ndengan kekuatan mistis.{\i0}
Dialogue: 0,0:16:48.42,0:16:52.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti lebih bermanfaat\Ndibanding air biasa.
Dialogue: 0,0:16:53.05,0:16:54.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar Shu Keigetsu
Dialogue: 0,0:16:54.76,0:16:57.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan bodohnya terus menarik busur.
Dialogue: 0,0:16:57.64,0:17:01.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia terus menarik busur\Nmeski telapak tangannya berdarah.
Dialogue: 0,0:17:02.10,0:17:03.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru karena itulah alasannya.
Dialogue: 0,0:17:04.27,0:17:07.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin aku bisa\Nmenunggu fajar dengan tenang.
Dialogue: 0,0:17:08.77,0:17:09.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:17:09.86,0:17:11.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat pengumuman.
Dialogue: 0,0:17:11.73,0:17:13.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan minta persetujuan\NYang Maha Mulia Kaisar.
Dialogue: 0,0:17:13.49,0:17:17.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kain bersih, obor yang diminyaki,\Narak sebagai persembahan untuk mata air,
Dialogue: 0,0:17:17.99,0:17:19.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan ember baru…
Dialogue: 0,0:17:21.41,0:17:23.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapkan dua ember.
Dialogue: 0,0:17:24.83,0:17:27.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuserahkan sisanya padamu, Shin-u.
Dialogue: 0,0:17:42.39,0:17:43.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:18:03.29,0:18:05.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:18:11.17,0:18:12.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:18:21.30,0:18:22.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa…
Dialogue: 0,0:18:23.39,0:18:24.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ini?
Dialogue: 0,0:18:27.64,0:18:31.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Nyonya Keigetsu, maafkan aku.{\i0}
Dialogue: 0,0:18:32.15,0:18:36.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sebenarnya saat itu, aku ingin pamer.{\i0}
Dialogue: 0,0:18:37.19,0:18:38.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Setelah kupikir-pikir,{\i0}
Dialogue: 0,0:18:38.90,0:18:42.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}hal pertama yang kuminta\Nsaat Festival Angka Tujuh Ganda{\i0}
Dialogue: 0,0:18:42.16,0:18:47.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}bukan ingin sehat,\Ntapi aku ingin merasa tenang.{\i0}
Dialogue: 0,0:18:48.25,0:18:52.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkin aku sangat kelelahan.{\i0}
Dialogue: 0,0:18:52.25,0:18:54.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku menghabiskan hari-hariku\Npenuh pertimbangan,{\i0}
Dialogue: 0,0:18:54.92,0:18:57.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}bertanya-tanya apa aku\Nmembuat orang lain khawatir.{\i0}
Dialogue: 0,0:18:57.67,0:19:04.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Entah berapa kali aku bertanya saat\Nberbaring, apa besok pagi aku akan mati?{\i0}
Dialogue: 0,0:19:05.76,0:19:09.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lewat pengulangan, kau jadi terbiasa\Ndengan teror dan rasa sakit.{\i0}
Dialogue: 0,0:19:10.44,0:19:16.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkin aku tekun berlatih saat sakit\Nuntuk mengosongkan hatiku.{\i0}
Dialogue: 0,0:19:18.07,0:19:19.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun…{\i0}
Dialogue: 0,0:19:20.70,0:19:22.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}kau tahu, Nyonya Keigetsu?{\i0}
Dialogue: 0,0:19:22.95,0:19:28.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Berkat dirimu, saat ini aku penuh stamina.{\i0}
Dialogue: 0,0:19:29.00,0:19:33.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Energi luar biasa yang membuat hatiku\Nbersemangat untuk beraksi.{\i0}
Dialogue: 0,0:19:35.71,0:19:36.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Karena itulah…{\i0}
Dialogue: 0,0:19:47.93,0:19:51.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Izinkan aku berjuang tanpa malu,\Nbersikap ceroboh…{\i0}
Dialogue: 0,0:19:52.64,0:19:55.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan menyelamatkanmu!{\i0}
Dialogue: 0,0:19:57.15,0:19:59.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tidak akan membiarkanmu mati!{\i0}
Dialogue: 0,0:20:06.91,0:20:08.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Keigetsu!
Dialogue: 0,0:20:09.58,0:20:11.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemarilah!
Dialogue: 0,0:20:21.42,0:20:23.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Reirin?
Dialogue: 0,0:20:23.76,0:20:25.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Reirin!
Dialogue: 0,0:20:25.34,0:20:28.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah! Kau sudah bangun!
Dialogue: 0,0:20:30.60,0:20:32.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kena!
Dialogue: 0,0:20:32.39,0:20:33.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berhasil!
Dialogue: 0,0:20:33.85,0:20:35.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berhasil, Leelee!
Dialogue: 0,0:20:35.85,0:20:36.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:20:37.56,0:20:40.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau dengar itu?
Dialogue: 0,0:20:40.11,0:20:43.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya! Sorakan dari arah Istana Kou!
Dialogue: 0,0:20:45.45,0:20:47.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Reirin sudah sadar!
Dialogue: 0,0:20:48.78,0:20:51.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya, Nyonya Kou Reirin…
Dialogue: 0,0:20:51.41,0:20:53.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:20:53.12,0:20:54.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:21:00.38,0:21:01.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak mungkin.{\i0}
Dialogue: 0,0:21:02.42,0:21:07.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Padahal aku berhasil tidak tidur\Nselama delapan hari tanpa pingsan.{\i0}
Dialogue: 0,0:21:07.43,0:21:08.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu.
Dialogue: 0,0:21:08.43,0:21:10.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya!
Dialogue: 0,0:22:51.32,0:22:53.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Leelee, kau sudah merawatku.{\i0}
Dialogue: 0,0:23:07.34,0:23:09.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Astaga.{\i0}
Dialogue: 0,0:23:09.67,0:23:11.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tidak tahu…{\i0}
Dialogue: 0,0:23:12.18,0:23:16.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}air mata bisa berlinang\Nsaat kau merasa lega.{\i0}
Dialogue: 0,0:23:17.60,0:23:19.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Nyonya Keigetsu.{\i0}
Dialogue: 0,0:23:19.56,0:23:22.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Syukurlah kau selamat.{\i0}
Dialogue: 0,0:23:23.52,0:23:24.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sungguh.{\i0}
Dialogue: 0,0:23:24.86,0:23:27.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah bangun?
Dialogue: 0,0:23:30.49,0:23:32.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tousetsu.
Dialogue: 0,0:23:34.16,0:23:35.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Tousetsu.
Dialogue: 0,0:23:40.25,0:23:41.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sudah kuduga.
Dialogue: 0,0:23:41.46,0:23:42.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:23:42.96,0:23:44.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:23:44.79,0:23:47.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau Nyonya Reirin, 'kan?
