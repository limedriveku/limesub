Dialogue: 0,0:00:10.21,0:00:11.13,sign,,0000,0000,0000,,GADIS KLAN SHU - SHU KEIGETSU\N(JIWA REIRIN)
Dialogue: 0,0:12:26.82,0:12:27.74,sign,,0000,0000,0000,,KIN REIGA\NKIN SEIKA
Dialogue: 0,0:12:29.79,0:12:31.79,sign,,0000,0000,0000,,SELIR SUCI - RAN HOURIN\NGADIS KLAN RAN - RAN HOUSHUN
Dialogue: 0,0:12:31.79,0:12:33.79,sign,,0000,0000,0000,,SELIR LAYAK - GEN GOUSETSU\NGADIS KLAN GEN - GEN KASUI
Dialogue: 0,0:13:17.83,0:13:18.92,sign,,0000,0000,0000,,SELIR AGUNG - SHU GABI
Dialogue: 0,0:16:32.44,0:16:33.44,sign,,0000,0000,0000,,DUA PULUH DUA TAHUN LALU
Dialogue: 0,0:19:58.53,0:20:00.15,sign,,0000,0000,0000,,SATU PEKAN KEMUDIAN
Dialogue: 0,0:20:10.62,0:20:11.54,sign,,0000,0000,0000,,ENAM BULAN KEMUDIAN,\NRITUAL KENAIKAN SELIR
Dialogue: 0,0:00:01.71,0:00:05.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga. Kau Nyonya Reirin, 'kan?
Dialogue: 0,0:00:06.33,0:00:08.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Caramu mengikat turniket.
Dialogue: 0,0:00:08.67,0:00:10.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Caramu tersenyum.
Dialogue: 0,0:00:11.13,0:00:13.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebiasaan meletakkan tangan di pipi\Nsaat kau dalam masalah.
Dialogue: 0,0:00:14.30,0:00:16.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, itu benar?
Dialogue: 0,0:00:17.43,0:00:18.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku…
Dialogue: 0,0:00:21.18,0:00:23.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sungguh minta maaf!
Dialogue: 0,0:00:24.23,0:00:25.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tousetsu…
Dialogue: 0,0:00:25.81,0:00:27.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}angkat kepalamu.
Dialogue: 0,0:00:27.73,0:00:28.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:00:29.32,0:00:33.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku, Tousetsu,\Ntidak pantas melihatmu, Nyonya Reirin!
Dialogue: 0,0:00:35.11,0:00:36.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Baiklah.
Dialogue: 0,0:00:36.99,0:00:37.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu…
Dialogue: 0,0:00:38.58,0:00:40.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan berlutut.
Dialogue: 0,0:00:44.33,0:00:46.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau memang Nyonya Reirin yang kukenal.
Dialogue: 0,0:00:46.42,0:00:48.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama tujuh hari terakhir,
Dialogue: 0,0:00:48.75,0:00:52.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kenapa aku mengira orang seperti\NShu Keigetsu adalah Nyonya Reirin?
Dialogue: 0,0:02:30.60,0:02:33.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tousetsu, bagaimana kau bisa tahu?
Dialogue: 0,0:02:34.19,0:02:36.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku malu mengatakannya,\Ntapi beberapa saat lalu,
Dialogue: 0,0:02:36.65,0:02:41.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}waktu gadis itu bangun,\Nperasaan janggal yang telah menumpuk
Dialogue: 0,0:02:41.20,0:02:43.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}benar-benar meluap.
Dialogue: 0,0:02:43.28,0:02:47.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Reirin! Aku lega sekali!
Dialogue: 0,0:02:47.29,0:02:49.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat khawatir!
Dialogue: 0,0:02:49.71,0:02:53.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bahkan berharap\Npada Busur Pelindung Shu Keigetsu!
Dialogue: 0,0:02:53.75,0:02:55.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shu Keigetsu?
Dialogue: 0,0:02:55.67,0:02:56.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:02:56.75,0:03:01.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya demi Nyonya Reirin,\Ndia menarik busur sepanjang malam.
Dialogue: 0,0:03:02.01,0:03:05.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya, aku bertanya-tanya\Napa yang dia rencanakan,
Dialogue: 0,0:03:05.64,0:03:07.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi dia terus menarik busur Klan Gen
Dialogue: 0,0:03:07.85,0:03:10.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang seharusnya tak cocok dengan Klan Shu.
Dialogue: 0,0:03:10.14,0:03:13.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya seperti melihat sekilas\Nsisi dirinya yang mengejutkan.
Dialogue: 0,0:03:13.02,0:03:15.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan tertipu!
Dialogue: 0,0:03:16.15,0:03:18.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian juga tidak boleh tertipu!
Dialogue: 0,0:03:18.99,0:03:21.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanita itu, Shu Keigetsu, dia egois,
Dialogue: 0,0:03:21.70,0:03:24.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}penjahat terbesar di Istana Para Gadis!
Dialogue: 0,0:03:24.24,0:03:25.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Dia itu tikus got!
Dialogue: 0,0:03:27.37,0:03:31.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya, sepertinya kau sedikit kesal.
Dialogue: 0,0:03:31.37,0:03:34.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bawakan teh obat\Nuntuk menenangkan diri.
Dialogue: 0,0:03:34.25,0:03:38.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, teh ini diseduh Shu Keigetsu.
Dialogue: 0,0:03:38.09,0:03:41.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tabib sudah memeriksa apakah beracun,\Ndan tidak ada masalah,
Dialogue: 0,0:03:41.09,0:03:42.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi jika kau tidak mau…
Dialogue: 0,0:03:44.22,0:03:46.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku mau.
Dialogue: 0,0:04:01.44,0:04:02.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kau?
Dialogue: 0,0:04:03.45,0:04:06.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu, Tousetsu?
Dialogue: 0,0:04:06.74,0:04:08.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Kou Reirin…
Dialogue: 0,0:04:11.54,0:04:15.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan memakai nama majikanku, Penipu!
Dialogue: 0,0:04:15.04,0:04:19.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Nyonya kesayanganku\Ntakkan pernah mengatakan "sial"!
Dialogue: 0,0:04:20.09,0:04:21.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sial!
Dialogue: 0,0:04:23.97,0:04:26.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tak pernah\Nmerendahkan Gadis klan lain.
Dialogue: 0,0:04:26.39,0:04:28.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan dia takkan sudi menerima bantuan
Dialogue: 0,0:04:28.72,0:04:31.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari seseorang yang dia anggap penjahat!
Dialogue: 0,0:04:32.85,0:04:34.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dipikir-pikir,
Dialogue: 0,0:04:34.14,0:04:36.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semua sudah aneh\Nsejak Festival Angka Tujuh Ganda.
Dialogue: 0,0:04:36.73,0:04:40.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang saat ini ada\Ndi dalam tubuh Nyonya Reirin
Dialogue: 0,0:04:40.36,0:04:42.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}adalah kau, 'kan, Shu Keigetsu?
Dialogue: 0,0:04:45.82,0:04:50.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa dia jujur menjelaskan\Nsituasinya padamu?{\i0}
Dialogue: 0,0:04:50.37,0:04:54.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Bahwa kalian berdua bertukar\Nkarena sihir terlarang.
Dialogue: 0,0:04:55.46,0:04:58.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia "bersedia" memberitahuku semuanya.
Dialogue: 0,0:04:59.38,0:05:02.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jadi, dia mengancam Shu Keigetsu.{\i0}
Dialogue: 0,0:05:03.46,0:05:05.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leelee, kau tak terkejut?
Dialogue: 0,0:05:05.80,0:05:09.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah lama curiga.
Dialogue: 0,0:05:09.55,0:05:12.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sedikit kecewa\Nkarena orang yang dikenal
Dialogue: 0,0:05:12.14,0:05:16.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebagai "kupu-kupu tersayang Yang Mulia"\Nternyata agak tidak biasa.
Dialogue: 0,0:05:16.23,0:05:18.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Agak tidak biasa"?
Dialogue: 0,0:05:20.98,0:05:23.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kenapa diam saja\Nsampai sekarang?
Dialogue: 0,0:05:26.03,0:05:27.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa, jika aku bertanya,
Dialogue: 0,0:05:27.82,0:05:32.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hubungan aneh ini akan menghilang\Nbersama keberadaanmu.
Dialogue: 0,0:05:32.99,0:05:34.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi…
Dialogue: 0,0:05:35.50,0:05:36.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leelee.
Dialogue: 0,0:05:37.33,0:05:42.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya, kenapa kau tidak minta\Ndiselamatkan oleh kami?
Dialogue: 0,0:05:42.63,0:05:43.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena…
Dialogue: 0,0:05:45.01,0:05:47.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, kau dibungkam?
Dialogue: 0,0:05:47.47,0:05:49.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shu Keigetsu sialan…
Dialogue: 0,0:05:49.39,0:05:50.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejahat apa dia?
Dialogue: 0,0:05:52.14,0:05:54.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya, saat itu…
Dialogue: 0,0:05:54.60,0:05:57.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kau tidak percaya padaku,\Ntapi aku…
Dialogue: 0,0:05:59.60,0:06:02.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan hanya\Ntidak sadar kalau itu dirimu,
Dialogue: 0,0:06:02.57,0:06:04.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku mengadukanmu dan memberimu racun.
Dialogue: 0,0:06:05.23,0:06:08.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebodohanku pantas diganjar kematian.
Dialogue: 0,0:06:08.65,0:06:14.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, Tousetsu,\Naku malah bersyukur dengan situasi ini.
Dialogue: 0,0:06:14.54,0:06:15.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersyukur?
Dialogue: 0,0:06:17.16,0:06:22.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuh hari terakhir ini\Nterasa seperti harta karun.
Dialogue: 0,0:06:22.04,0:06:28.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku menantang diriku dan menikmati\Npengalaman yang belum pernah kurasakan.{\i0}
Dialogue: 0,0:06:28.80,0:06:32.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika bisa, aku ingin mengakhirinya\Ntanpa dibesar-besarkan.
Dialogue: 0,0:06:32.30,0:06:36.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kau bilang begitu,\Naku tak bisa memaafkan wanita itu.
Dialogue: 0,0:06:36.47,0:06:42.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski jadi masalah besar,\Nakan kupastikan Shu Keigetsu dihukum,
Dialogue: 0,0:06:42.69,0:06:44.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}lalu menebus dosaku dengan kematian!
Dialogue: 0,0:06:44.65,0:06:45.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan kuizinkan.
Dialogue: 0,0:06:46.94,0:06:47.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi…
Dialogue: 0,0:06:47.94,0:06:49.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa.
Dialogue: 0,0:06:49.03,0:06:54.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjalani hidup yang sehat\Njauh lebih sulit daripada mati.
Dialogue: 0,0:06:55.91,0:07:02.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ingin menebus dosa,\Njangan memilih kematian yang mudah.
Dialogue: 0,0:07:02.17,0:07:03.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi…
Dialogue: 0,0:07:03.58,0:07:06.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}semua itu tak bisa dimaafkan.
Dialogue: 0,0:07:08.63,0:07:10.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti, Tousetsu.
Dialogue: 0,0:07:10.80,0:07:12.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, begini saja.
Dialogue: 0,0:07:12.84,0:07:16.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melarangmu menyakiti dia\Natau dirimu sendiri.
Dialogue: 0,0:07:17.18,0:07:20.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan katakan yang sebenarnya\Npada Yang Maha Mulia dan Yang Mulia.
Dialogue: 0,0:07:21.44,0:07:24.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hadapilah takdir yang sama denganku.
Dialogue: 0,0:07:24.40,0:07:28.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu, Tousetsu, adalah hukumanmu.
Dialogue: 0,0:07:28.69,0:07:31.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, itu terlalu mudah bagiku.
Dialogue: 0,0:07:31.45,0:07:34.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan menghadapi kesulitan\Nyang sama dengan majikanmu.
Dialogue: 0,0:07:34.28,0:07:35.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagian mana yang mudah?
Dialogue: 0,0:07:36.41,0:07:37.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi…
Dialogue: 0,0:07:37.70,0:07:41.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski dia diampuni dari kematian,
Dialogue: 0,0:07:41.33,0:07:43.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istana Para Gadis\Nadalah tempat yang kejam.
Dialogue: 0,0:07:43.96,0:07:46.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kau orang yang kupercaya,
Dialogue: 0,0:07:46.46,0:07:49.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ingin kau tetap\Ndi Istana Kou dan melindunginya.
Dialogue: 0,0:07:50.51,0:07:52.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:07:52.22,0:07:55.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika itu perintahmu,\Naku akan melakukan yang terbaik.
Dialogue: 0,0:07:58.01,0:08:01.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf aku sudah membohongimu.
Dialogue: 0,0:08:02.19,0:08:07.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Kou Reirin, aku minta maaf\Nsebagai orang Istana Shu.
Dialogue: 0,0:08:07.40,0:08:09.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leelee, hentikan!
Dialogue: 0,0:08:09.98,0:08:12.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin kau mengurusku seperti biasa.
Dialogue: 0,0:08:13.40,0:08:15.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau tak blak-blakan padaku,
Dialogue: 0,0:08:15.66,0:08:20.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku takkan bisa menikmati hidup\Ndi sini seperti sekarang.
Dialogue: 0,0:08:20.37,0:08:21.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi…
Dialogue: 0,0:08:21.41,0:08:26.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan tiba saatnya\Nkehidupan di tempat ini berakhir.
Dialogue: 0,0:08:26.00,0:08:27.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi,
Dialogue: 0,0:08:27.04,0:08:28.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai saat itu tiba…
Dialogue: 0,0:08:35.80,0:08:37.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya, setelah tahu
Dialogue: 0,0:08:37.30,0:08:39.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kupu-kupu tersayang Yang Mulia\Nsangat suka kentang
Dialogue: 0,0:08:39.76,0:08:41.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan orang aneh yang suka berlatih,
Dialogue: 0,0:08:41.72,0:08:43.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mana mungkin aku menghormatimu?
Dialogue: 0,0:08:44.27,0:08:46.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leelee, itu keterlaluan.
Dialogue: 0,0:08:46.31,0:08:47.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!
Dialogue: 0,0:08:47.61,0:08:49.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak percaya ini.
Dialogue: 0,0:08:49.32,0:08:51.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pucat sekali!
Dialogue: 0,0:08:51.07,0:08:52.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:08:52.78,0:08:55.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seseorang yang pingsan karena ceroboh
Dialogue: 0,0:08:55.53,0:08:58.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak akan bisa langsung bangun\Ndengan santai.
Dialogue: 0,0:08:58.57,0:09:00.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo cepat tidur!
Dialogue: 0,0:09:00.03,0:09:02.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leelee, kau berlebihan.
Dialogue: 0,0:09:02.08,0:09:03.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam!
Dialogue: 0,0:09:03.08,0:09:06.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, jangan beranjak\Ndari ranjang ini!
Dialogue: 0,0:09:06.54,0:09:08.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya izinkan aku menyulam…
Dialogue: 0,0:09:08.54,0:09:09.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh!
Dialogue: 0,0:09:09.59,0:09:11.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menyulam! Jangan lakukan apa pun!
Dialogue: 0,0:09:11.59,0:09:12.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidurlah!
Dialogue: 0,0:09:13.34,0:09:17.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leelee, kau tidak ada segan-segannya\Ndi dekat majikanmu.
Dialogue: 0,0:09:17.64,0:09:20.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yang melarangku segan!
Dialogue: 0,0:09:22.35,0:09:24.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Leelee.
Dialogue: 0,0:09:25.98,0:09:28.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis yang merepotkan.
Dialogue: 0,0:09:38.41,0:09:41.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kurang ajar! Perbuatan busuk\Nseperti sihir terlarang!{\i0}
Dialogue: 0,0:09:42.62,0:09:44.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau mau, lakukan saja.
Dialogue: 0,0:09:44.87,0:09:50.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Namun, hanya aku yang bisa\Nmengembalikan jiwa Kou Reirin.
Dialogue: 0,0:09:56.17,0:09:58.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak peduli apa\Nyang terjadi pada tubuh ini?
Dialogue: 0,0:10:01.18,0:10:03.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menemui guruku.
Dialogue: 0,0:10:03.60,0:10:05.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan kira ini sudah berakhir.
Dialogue: 0,0:10:16.07,0:10:18.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua sudah berakhir.
Dialogue: 0,0:10:18.95,0:10:20.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reaksi dayang saja begitu.
Dialogue: 0,0:10:21.12,0:10:24.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Jika Yang Mulia tahu…{\i0}
Dialogue: 0,0:10:25.20,0:10:27.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pada akhirnya, semua sama saja.{\i0}
Dialogue: 0,0:10:28.83,0:10:31.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bahkan setelah bertukar\Ndengan kesayangan semua orang,{\i0}
Dialogue: 0,0:10:31.71,0:10:35.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku menghadapi kebencian besar\Nhanya dalam tujuh hari.{\i0}
Dialogue: 0,0:10:36.01,0:10:38.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak ada yang akan menyelamatkanku.{\i0}
Dialogue: 0,0:10:41.30,0:10:46.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku hanya bersenang-senang\Nsetelah pertukaran itu.
Dialogue: 0,0:10:46.22,0:10:50.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kita bisa mengobrol,\Naku yakin angin baru akan berembus.
Dialogue: 0,0:10:50.81,0:10:55.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya demi Nyonya Reirin,\Ndia menarik busur sepanjang malam.
Dialogue: 0,0:10:57.15,0:10:58.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:11:01.36,0:11:02.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa…
Dialogue: 0,0:11:04.62,0:11:11.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kenapa kau selalu cantik dalam segala hal?{\i0}
Dialogue: 0,0:11:25.72,0:11:26.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu…{\i0}
Dialogue: 0,0:11:27.89,0:11:29.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalau dipikir-pikir,{\i0}
Dialogue: 0,0:11:29.52,0:11:32.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}bola mata tak terhitung\Nyang menyerangku dalam mimpi,{\i0}
Dialogue: 0,0:11:33.06,0:11:36.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}mungkin itu penampakan penyakit.{\i0}
Dialogue: 0,0:11:36.15,0:11:40.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dan mereka hilang setelah mendengar\Ngetaran senar Busur Pelindung.{\i0}
Dialogue: 0,0:11:40.61,0:11:45.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aneh sekali, penyakit bisa disembuhkan\Ndengan getaran senar.{\i0}
Dialogue: 0,0:11:45.16,0:11:47.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika bisa dimurnikan, artinya…{\i0}
Dialogue: 0,0:11:48.24,0:11:49.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}itu kutukan.{\i0}
Dialogue: 0,0:11:50.08,0:11:52.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kenapa hadiah dari Klan Kin…{\i0}
Dialogue: 0,0:12:00.01,0:12:02.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir racun.
Dialogue: 0,0:12:02.01,0:12:07.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu sihir kutukan agar mati karena sakit.{\i0}
Dialogue: 0,0:12:07.14,0:12:08.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak mungkin.{\i0}
Dialogue: 0,0:12:08.76,0:12:13.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Karena orang yang bisa menciptakan ini\Nhanya aku dan satu orang lagi.{\i0}
Dialogue: 0,0:12:17.27,0:12:18.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tidak mungkin.
Dialogue: 0,0:12:25.28,0:12:26.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hadiah kunjungan.
Dialogue: 0,0:12:27.74,0:12:29.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan, ini untuk Nyonya Reirin.
Dialogue: 0,0:12:33.79,0:12:39.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pesta teh untuk merayakan kesembuhan\NNyonya Reirin hanyalah kedok kepolosan.{\i0}
Dialogue: 0,0:12:39.42,0:12:43.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tujuanmu adalah mengkritik\Nkesehatan Nyonya Reirin yang lemah.{\i0}
Dialogue: 0,0:12:43.05,0:12:48.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba lihat itu.\NBunga terompet emas yang manis.
Dialogue: 0,0:12:48.72,0:12:52.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, sepertinya agak layu.
Dialogue: 0,0:12:52.68,0:12:56.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunga kuning seperti itu terlalu lembut.
Dialogue: 0,0:12:56.69,0:13:00.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika cepat layu, bahkan di vas mewah,
Dialogue: 0,0:13:00.07,0:13:02.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu cukup menyedihkan.
Dialogue: 0,0:13:05.57,0:13:06.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Shu Keigetsu…{\i0}
Dialogue: 0,0:13:07.28,0:13:11.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}ada satu hal baik\Ndari tikus got sepertimu.{\i0}
Dialogue: 0,0:13:12.50,0:13:14.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Karena kau sangat apak,{\i0}
Dialogue: 0,0:13:14.25,0:13:17.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}bau busuk wanita keji ini\Ntidak menonjol jika ada dirimu.{\i0}
Dialogue: 0,0:13:18.92,0:13:22.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mendoakan kesembuhan Nyonya Reirin.
Dialogue: 0,0:13:26.55,0:13:29.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selir Agung Shu, kakimu kenapa?
Dialogue: 0,0:13:30.72,0:13:32.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:13:35.35,0:13:40.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, hari ini aku minta kalian\Nmeluangkan waktu untuk Nyonya Reirin.
Dialogue: 0,0:13:40.81,0:13:41.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berterima kasih.
Dialogue: 0,0:13:41.86,0:13:45.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana keadaan Nyonya Reirin\Nsejak saat itu?
Dialogue: 0,0:13:45.53,0:13:49.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar dia sudah sadar.
Dialogue: 0,0:13:49.16,0:13:50.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf membuat kalian khawatir.
Dialogue: 0,0:13:50.87,0:13:53.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reirin sudah pulih,
Dialogue: 0,0:13:53.58,0:13:57.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi dia masih dikurung\Noleh para dayang yang terlalu protektif.
Dialogue: 0,0:13:57.54,0:13:58.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terlalu khawatir.
Dialogue: 0,0:13:58.87,0:14:02.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu melegakan.
Dialogue: 0,0:14:02.13,0:14:07.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kesehatannya yang lemah itu\Nsedikit mengkhawatirkan.
Dialogue: 0,0:14:07.34,0:14:14.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suatu hari nanti, para Gadis akan\Nmenghibur Yang Mulia dan mengandung.
Dialogue: 0,0:14:14.06,0:14:17.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Nyonya Reirin\Nakan punya cukup stamina?
Dialogue: 0,0:14:18.14,0:14:20.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Bibi!\N- Selir Murni Kin.
Dialogue: 0,0:14:20.40,0:14:25.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Maha Mulia bilang\Nkau pasangan yang hebat,
Dialogue: 0,0:14:25.36,0:14:28.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi dia terganggu\Noleh suaramu yang keras.
Dialogue: 0,0:14:29.66,0:14:33.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siang-siang begini, vulgar sekali!
Dialogue: 0,0:14:33.66,0:14:38.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Aku hanya bicara soal bermain go.
Dialogue: 0,0:14:38.71,0:14:42.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal cabul apa yang kau pikirkan?
Dialogue: 0,0:14:42.04,0:14:43.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar mesum.
Dialogue: 0,0:14:43.79,0:14:48.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beraninya kau bicara vulgar\Nsebagai permaisuri.
Dialogue: 0,0:14:48.09,0:14:49.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kin Reiga.
Dialogue: 0,0:14:49.43,0:14:51.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pendapatku sama dengan Yang Maha Mulia.
Dialogue: 0,0:14:52.68,0:14:53.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kadang-kadang…
Dialogue: 0,0:14:54.93,0:14:57.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}suaramu membuat telingaku sakit.
Dialogue: 0,0:14:58.68,0:15:02.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin bagi yang bicara,\Nitu tidak ada artinya,
Dialogue: 0,0:15:02.31,0:15:07.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi gema lengkingannya bisa jadi racun\Nbagi mereka yang lemah.
Dialogue: 0,0:15:07.19,0:15:12.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau tahu di sini ada orang sakit,\Ntutup mulutmu yang cerewet itu.
Dialogue: 0,0:15:12.66,0:15:14.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau dilepas ke alam liar?
Dialogue: 0,0:15:16.04,0:15:19.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan kelancangan Selir Murni.
Dialogue: 0,0:15:19.58,0:15:22.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai orang Klan Kin, aku minta maaf.
Dialogue: 0,0:15:27.46,0:15:28.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:15:28.71,0:15:31.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Klan Kin diberkati Gadis yang teguh.
Dialogue: 0,0:15:33.68,0:15:38.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku tahu Selir Murni Kin\Ntidak menghormatiku.
Dialogue: 0,0:15:38.68,0:15:44.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu di Istana Para Gadis, tak seorang pun\Nmenyangka aku akan jadi permaisuri.
Dialogue: 0,0:15:44.69,0:15:47.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Astaga.\N- Benarkah?
Dialogue: 0,0:15:47.19,0:15:50.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Gadis paling tua.\NSama sekali tidak manis.
Dialogue: 0,0:15:50.74,0:15:54.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tertarik dengan hobi wanita.
Dialogue: 0,0:15:54.20,0:15:58.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya suka latihan bertarung\Nmelawan Selir Layak Gen.
Dialogue: 0,0:15:59.20,0:16:03.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kami bertarung, bahkan\Nkapten Mata Elang saat itu akan gemetar.
Dialogue: 0,0:16:03.96,0:16:05.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, 'kan, Gousetsu?
Dialogue: 0,0:16:05.96,0:16:07.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang benar.
Dialogue: 0,0:16:08.55,0:16:12.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Maha Mulia suka wanita anggun.\NSelir Agung Shu yang paling bersinar.
Dialogue: 0,0:16:12.01,0:16:16.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cantik, baik hati,\Nsangat berbudi luhur, dan sopan.
Dialogue: 0,0:16:16.93,0:16:19.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia dipuji sebagai\N"mawar kapas Yang Mulia".
Dialogue: 0,0:16:19.68,0:16:21.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu cerita masa lalu.
Dialogue: 0,0:16:21.77,0:16:24.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembicaraan berlebihan\Nseperti itu membuatku malu.
Dialogue: 0,0:16:24.85,0:16:26.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tidak berlebihan.
Dialogue: 0,0:16:26.77,0:16:28.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa campur tanganmu,
Dialogue: 0,0:16:28.69,0:16:31.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tak tahu apa aku bisa\Ntetap berada di Istana Para Gadis.
Dialogue: 0,0:16:33.45,0:16:34.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Kenshuu?
Dialogue: 0,0:16:34.95,0:16:37.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang apa kau di tempat seperti ini?
Dialogue: 0,0:16:37.70,0:16:42.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir kalau tidur di sini,\Naku bisa sakit dan tidak usah ikut ritual.
Dialogue: 0,0:16:42.66,0:16:46.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhentilah mengambil risiko\Nkarena alasan semacam itu!
Dialogue: 0,0:16:47.46,0:16:50.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Secerdas apa pun Nyonya Kenshuu,
Dialogue: 0,0:16:50.09,0:16:52.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jika ini sulamanmu\Nuntuk Festival Angka Tujuh Ganda,
Dialogue: 0,0:16:52.92,0:16:55.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis lain akan meremehkanmu.
Dialogue: 0,0:16:55.84,0:16:57.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau tidak kesal?
Dialogue: 0,0:16:57.47,0:16:59.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali tidak.
Dialogue: 0,0:16:59.05,0:17:01.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menjadi pejabat pemerintah.
Dialogue: 0,0:17:01.60,0:17:04.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak keberatan jadi permaisuri,
Dialogue: 0,0:17:04.56,0:17:06.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kau sudah duduk di kursi permaisuri.
Dialogue: 0,0:17:06.73,0:17:10.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sesuatu yang akan\Ndiputuskan Yang Mulia.
Dialogue: 0,0:17:10.36,0:17:14.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku benci\Nsaat orang lain meremehkanmu.
Dialogue: 0,0:17:14.32,0:17:15.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu,
Dialogue: 0,0:17:15.74,0:17:17.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ambillah ini.
Dialogue: 0,0:17:17.61,0:17:19.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:17:19.03,0:17:23.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika keberuntungan memberkatiku\Ndan aku menjadi permaisuri,
Dialogue: 0,0:17:23.54,0:17:27.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ingin kau berada di sisiku\Nsebagai selir agung, tangan kananku.
Dialogue: 0,0:17:28.79,0:17:32.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau terus terang, tidak berbohong.
Dialogue: 0,0:17:32.13,0:17:36.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti bisa mendukungku\Ndan hatiku yang lemah dengan baik.
Dialogue: 0,0:17:36.05,0:17:39.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati yang lemah? Kau pasti bercanda.
Dialogue: 0,0:17:39.55,0:17:42.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karakter seseorang bisa terlihat\Ndari sulamannya.
Dialogue: 0,0:17:42.06,0:17:45.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin ini terlihat lembut,\Ntapi warnanya dinamis,
Dialogue: 0,0:17:45.81,0:17:48.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan jahitannya hati-hati.
Dialogue: 0,0:17:48.31,0:17:50.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menusuk kain keras berulang kali\Ndengan jarum,
Dialogue: 0,0:17:50.77,0:17:53.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}artinya kau gigih dan berani.
Dialogue: 0,0:17:53.90,0:17:57.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, kedengarannya mengerikan.
Dialogue: 0,0:17:57.11,0:18:00.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, benar, 'kan?\NKau adalah wanita yang gigih
Dialogue: 0,0:18:00.82,0:18:03.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang memegang teguh keputusanmu.
Dialogue: 0,0:18:03.91,0:18:05.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu yang kusukai darimu.
Dialogue: 0,0:18:07.37,0:18:09.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlepas dari penilaianmu itu,
Dialogue: 0,0:18:09.58,0:18:13.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jika sulamannya bisa berguna,\Nitu yang terbaik.
Dialogue: 0,0:18:13.13,0:18:17.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak. Sia-sia saja memberikan ini\Npada Yang Mulia.
Dialogue: 0,0:18:17.13,0:18:19.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan jadikan ini saputanganku.
Dialogue: 0,0:18:21.30,0:18:22.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga.
Dialogue: 0,0:18:22.89,0:18:24.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imbalan apa yang kau inginkan?
Dialogue: 0,0:18:24.64,0:18:26.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang? Tombak?
Dialogue: 0,0:18:26.31,0:18:28.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, bagaimana kalau busur?
Dialogue: 0,0:18:28.27,0:18:31.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa pilihannya hanya senjata?
Dialogue: 0,0:18:31.40,0:18:33.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menganggapku musuh?
Dialogue: 0,0:18:33.02,0:18:37.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan konyol.\NKau tidak tahu arti memercayakan senjata?
Dialogue: 0,0:18:37.61,0:18:40.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kita jauh,\Ndan aku tak bisa segera datang ke sisimu,
Dialogue: 0,0:18:40.99,0:18:44.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}senjata itu akan terus melindungimu\Nsebagai pengganti diriku.
Dialogue: 0,0:18:46.04,0:18:49.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu lambang persahabatan tertinggi.\NTak ada yang seperti itu.
Dialogue: 0,0:18:51.79,0:18:54.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, ya, lagi-lagi begitu.
Dialogue: 0,0:18:54.63,0:18:57.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, berikan padaku saat kau mau.
Dialogue: 0,0:18:57.09,0:18:59.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak peduli\Nkapan menerima hadiah senjata,
Dialogue: 0,0:18:59.30,0:19:01.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mau tahun depan,\Natau kehidupan berikutnya.
Dialogue: 0,0:19:03.80,0:19:07.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Karena kedudukanmu jelas\Ndi mata semua orang.{\i0}
Dialogue: 0,0:19:07.31,0:19:09.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu hari-hari yang damai.{\i0}
Dialogue: 0,0:19:09.81,0:19:11.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun…{\i0}
Dialogue: 0,0:19:11.81,0:19:13.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia infeksi?
Dialogue: 0,0:19:13.65,0:19:15.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia muntah berulang kali.
Dialogue: 0,0:19:15.57,0:19:18.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan tidak bisa mencerna obat\Nyang diseduh tabib.
Dialogue: 0,0:19:19.40,0:19:21.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinan bisa menular.
Dialogue: 0,0:19:21.24,0:19:23.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua Gadis harus dikurung\Ndi istana masing-masing.
Dialogue: 0,0:19:23.74,0:19:24.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin!
Dialogue: 0,0:19:24.74,0:19:26.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menakutkan sekali.
Dialogue: 0,0:19:27.33,0:19:29.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo cepat pergi.
Dialogue: 0,0:19:29.08,0:19:30.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengurung diri di gudang.
Dialogue: 0,0:19:30.83,0:19:34.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya menjauh sampai kalian tahu\Nkalian tidak terinfeksi.
Dialogue: 0,0:19:34.29,0:19:35.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Baik!\N- Baik!
Dialogue: 0,0:19:35.34,0:19:37.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Gabi, saatnya bergegas.
Dialogue: 0,0:19:39.09,0:19:42.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Kenshuu! Apa yang kau lakukan?
Dialogue: 0,0:19:42.34,0:19:44.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan merawatnya.
Dialogue: 0,0:19:44.97,0:19:48.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tugas seorang istri adalah\Nmelindungi suaminya sampai akhir.
Dialogue: 0,0:19:48.31,0:19:51.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak berniat menghibur pria\Nsebagai selirnya,
Dialogue: 0,0:19:51.23,0:19:54.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku bertekad\Nmengorbankan hidupku demi suamiku.
Dialogue: 0,0:20:05.24,0:20:07.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya Yang Mulia sadar.
Dialogue: 0,0:20:08.49,0:20:10.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Putra Mahkota mewarisi takhta kaisar…{\i0}
Dialogue: 0,0:20:11.54,0:20:13.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}…dan para Gadis\Nsudah ditunjuk sebagai selir.{\i0}
Dialogue: 0,0:20:14.50,0:20:17.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dan karena keberuntungan, aku…{\i0}
Dialogue: 0,0:20:21.05,0:20:22.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Maha Mulia?
Dialogue: 0,0:20:24.89,0:20:26.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, begitulah.
Dialogue: 0,0:20:26.68,0:20:29.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Posisi semua orang berubah dalam sekejap.
Dialogue: 0,0:20:29.06,0:20:32.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada yang tahu kapan\Ndan bagaimana mereka digulingkan.
Dialogue: 0,0:20:32.64,0:20:37.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun gelarmu,\Nsaling menghormati itu penting.
Dialogue: 0,0:20:37.40,0:20:40.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata-katamu benar.
Dialogue: 0,0:20:40.48,0:20:45.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, posisimu sebagai Yang Maha Mulia\NPermaisuri tidak tergoyahkan.
Dialogue: 0,0:20:45.03,0:20:47.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau satu-satunya\Nyang melahirkan putra mahkota
Dialogue: 0,0:20:47.62,0:20:50.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}luar biasa seperti Yang Mulia Gyoumei.
Dialogue: 0,0:20:53.08,0:20:56.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, ampun, tanganku licin.
Dialogue: 0,0:20:57.83,0:21:01.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, mangkuk teh yang pecah\Ndi hari kunjungan adalah pertanda buruk.
Dialogue: 0,0:21:01.63,0:21:03.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini kita sudahi dulu.
Dialogue: 0,0:21:03.72,0:21:07.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada yang salah dengan kata-kataku?
Dialogue: 0,0:21:07.22,0:21:10.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menyiapkan hadiah\Nsebagai tanda terima kasih.
Dialogue: 0,0:21:10.35,0:21:13.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pilihlah gulungan kain yang kalian suka.
Dialogue: 0,0:21:13.10,0:21:16.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuharap kalian terus menjaga Reirin\Ndengan baik di masa depan.
Dialogue: 0,0:21:23.32,0:21:25.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu tadi demi aku?
Dialogue: 0,0:21:26.24,0:21:27.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:21:28.70,0:21:29.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan apa-apa.
Dialogue: 0,0:21:29.83,0:21:34.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula,\Nkau memang tipe orang seperti ini.
Dialogue: 0,0:21:40.59,0:21:42.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hei, Gabi…{\i0}
Dialogue: 0,0:21:42.25,0:21:45.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}apa kau belum selesai\Nmenjahit pola kebencianmu?{\i0}
Dialogue: 0,0:23:28.86,0:23:32.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ya ampun, aku ketiduran.{\i0}
Dialogue: 0,0:23:33.07,0:23:35.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aduh! Aku juga lapar!{\i0}
Dialogue: 0,0:23:35.91,0:23:37.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku merasa hidup!{\i0}
Dialogue: 0,0:23:39.08,0:23:40.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa?{\i0}
Dialogue: 0,0:23:40.12,0:23:43.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kamarnya sudah dibersihkan.{\i0}
Dialogue: 0,0:23:45.54,0:23:47.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah bangun.
Dialogue: 0,0:23:47.75,0:23:49.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:23:49.55,0:23:50.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leelee?
