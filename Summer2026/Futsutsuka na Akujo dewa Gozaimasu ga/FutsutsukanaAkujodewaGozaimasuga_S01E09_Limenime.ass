Dialogue: 0,0:00:01.50,0:00:02.41,sign,,0000,0000,0000,,KAPTEN MATA ELANG, SHIN-U
Dialogue: 0,0:00:06.88,0:00:08.38,sign,,0000,0000,0000,,{\an8}DAYANG KLAN SHU, LEELEE\NPUTRA MAHKOTA, EI GYOUMEI
Dialogue: 0,0:00:08.38,0:00:09.29,sign,,0000,0000,0000,,GADIS KLAN SHU, SHU KEIGETSU (JIWA REIRIN)
Dialogue: 0,0:00:33.53,0:00:34.61,sign,,0000,0000,0000,,SELIR AGUNG - SHU GABI
Dialogue: 0,0:06:44.94,0:06:46.36,sign,,0000,0000,0000,,SEGEL
Dialogue: 0,0:15:18.25,0:15:20.75,sign,,0000,0000,0000,,KEPALA DAYANG PRIBADI REIRIN, KOU TOUSETSU
Dialogue: 0,0:00:02.41,0:00:04.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permaisuri pingsan.
Dialogue: 0,0:00:04.00,0:00:06.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa itu penyakit menular?\N- Tidak.
Dialogue: 0,0:00:09.30,0:00:11.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin itu kutukan.
Dialogue: 0,0:00:13.59,0:00:16.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kutukan racun yang diberikan\Npada Nyonya Keigetsu.{\i0}
Dialogue: 0,0:00:16.89,0:00:21.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika sekarang itu menimpa bibiku…{\i0}
Dialogue: 0,0:00:21.60,0:00:25.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuan sebenarnya Selir Agung\Nkemungkinan besar…
Dialogue: 0,0:00:26.52,0:00:29.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Yang waktu itu\Ningin dikatakan Nyonya Keigetsu…{\i0}
Dialogue: 0,0:00:29.86,0:00:33.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kemungkinan besar\Nadalah pembunuhan permaisuri.{\i0}
Dialogue: 0,0:00:34.61,0:00:37.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya, kukira dia ingin menyingkirkanmu
Dialogue: 0,0:00:37.62,0:00:39.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena kau menghalangi rencananya.
Dialogue: 0,0:00:40.45,0:00:43.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Menghalangi rencananya mungkin artinya,{\i0}
Dialogue: 0,0:00:43.25,0:00:46.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}karena aku mengubah taman\Nmenjadi ladang herba obat{\i0}
Dialogue: 0,0:00:46.92,0:00:49.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan hama kujadikan makanan tikus\Ndalam eksperimenku,{\i0}
Dialogue: 0,0:00:49.96,0:00:53.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}serta menjaga Istana Kou tetap bersih.{\i0}
Dialogue: 0,0:00:53.97,0:00:56.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tanpa kusadari, aku menciptakan lingkungan{\i0}
Dialogue: 0,0:00:56.89,0:00:58.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}di mana sihir racun takkan aktif.{\i0}
Dialogue: 0,0:00:58.97,0:01:01.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu sebabnya dia ingin menyingkirkanku.{\i0}
Dialogue: 0,0:01:01.81,0:01:05.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Setelah menukar tubuhku\Ndengan Nyonya Keigetsu,{\i0}
Dialogue: 0,0:01:05.56,0:01:07.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dia akan membuat kami berdua terbunuh.{\i0}
Dialogue: 0,0:01:07.98,0:01:10.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itulah skenario Selir Agung Shu.{\i0}
Dialogue: 0,0:01:11.11,0:01:15.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia rela berusaha sekeras itu\Nuntuk membunuh bibiku!{\i0}
Dialogue: 0,0:01:16.70,0:01:18.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku harus menghentikannya.{\i0}
Dialogue: 0,0:01:20.12,0:01:23.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shu Keigetsu,\Nkenapa kau bilang itu kutukan?
Dialogue: 0,0:01:23.58,0:01:25.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika itu penyakit menular,\Npara dayang yang melayaninya
Dialogue: 0,0:01:25.83,0:01:27.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti akan tertular sebelum Yang Mulia.
Dialogue: 0,0:01:28.37,0:01:29.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:01:29.38,0:01:32.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, getaran senar Busur Pelindung
Dialogue: 0,0:01:32.21,0:01:35.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}meringankan gejala putri Klan Kou, 'kan?
Dialogue: 0,0:01:35.01,0:01:39.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah itu bukti kalau ini\Nbukan penyakit, melainkan kutukan?
Dialogue: 0,0:01:40.85,0:01:43.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia, kumohon.
Dialogue: 0,0:01:43.81,0:01:48.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izinkan aku meminjam\NBusur Pelindung sekali lagi!
Dialogue: 0,0:03:19.86,0:03:21.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau katakan?
Dialogue: 0,0:03:21.49,0:03:23.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ingin menarik Busur lagi?
Dialogue: 0,0:03:23.32,0:03:26.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar. Aku akan memakainya\Nuntuk memurnikan kutukan itu.
Dialogue: 0,0:03:28.70,0:03:31.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak. Kau harus istirahat.
Dialogue: 0,0:03:31.08,0:03:32.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:03:33.54,0:03:38.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya, dulu aku tak percaya\Nkutukan dan takhayul,
Dialogue: 0,0:03:39.59,0:03:41.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sekarang berbeda.
Dialogue: 0,0:03:41.97,0:03:43.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ada kutukan di dunia ini,{\i0}
Dialogue: 0,0:03:43.97,0:03:45.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan keajaiban bisa terjadi.
Dialogue: 0,0:03:47.14,0:03:48.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon padamu.
Dialogue: 0,0:03:48.47,0:03:50.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Busur Pelindung…\N- Hentikan!
Dialogue: 0,0:03:50.85,0:03:52.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sampai aku mengulanginya.
Dialogue: 0,0:03:52.69,0:03:54.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa meminjamimu Busur Pelindung.
Dialogue: 0,0:03:55.19,0:03:58.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang harus kulakukan\Nagar kau memercayaiku?
Dialogue: 0,0:03:59.07,0:04:01.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Wanita ini jelas mulai berubah.{\i0}
Dialogue: 0,0:04:02.49,0:04:03.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun…{\i0}
Dialogue: 0,0:04:05.41,0:04:08.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yang sekarang\Ntak cocok menangani harta keramat.
Dialogue: 0,0:04:08.91,0:04:14.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, akan kuingat bahwa kau\Ningin memurnikan penyakit ibuku.
Dialogue: 0,0:04:14.04,0:04:17.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Nanti…\N- Kalau begitu, itu sudah cukup.
Dialogue: 0,0:04:20.30,0:04:22.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat Penghakiman Singa,
Dialogue: 0,0:04:22.34,0:04:24.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat ritual Festival Hantu,
Dialogue: 0,0:04:24.18,0:04:25.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan sekarang…
Dialogue: 0,0:04:26.30,0:04:29.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Aku sudah memberitahumu, Yang Mulia,{\i0}
Dialogue: 0,0:04:29.56,0:04:33.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}untuk mendengarkan perkataanku\Ndan memercayaiku.{\i0}
Dialogue: 0,0:04:34.39,0:04:38.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, sudah tiga kali\Nkau tidak mengabulkan permintaanku.
Dialogue: 0,0:04:40.69,0:04:43.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, sudah cukup.
Dialogue: 0,0:04:45.70,0:04:50.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalau begini, aku harus minta\NNyonya Keigetsu membatalkan pertukaran{\i0}
Dialogue: 0,0:04:50.20,0:04:54.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}agar aku bisa kembali\Nke tubuh asliku dan menarik busur!{\i0}
Dialogue: 0,0:04:54.83,0:04:57.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei. Kenapa kau pergi?
Dialogue: 0,0:04:57.13,0:05:00.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takkan minta izinmu lagi, Yang Mulia.
Dialogue: 0,0:05:00.59,0:05:02.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan berbuat sesukaku.
Dialogue: 0,0:05:06.97,0:05:09.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau ke mana, Nyonya?
Dialogue: 0,0:05:09.39,0:05:10.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi!
Dialogue: 0,0:05:11.97,0:05:13.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tak apa-apa membiarkannya pergi?
Dialogue: 0,0:05:15.23,0:05:17.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan melindungi busurnya.
Dialogue: 0,0:05:18.10,0:05:19.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:05:22.44,0:05:25.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Konon katanya, Mata Air Naga Ungu\Nmenunjukkan kebenaran.{\i0}
Dialogue: 0,0:05:26.28,0:05:28.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Gambar yang muncul di permukaannya…{\i0}
Dialogue: 0,0:05:33.58,0:05:34.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkinkah?{\i0}
Dialogue: 0,0:05:35.25,0:05:37.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mohon.
Dialogue: 0,0:05:37.29,0:05:42.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar saja, dengarkan perkataanku.
Dialogue: 0,0:05:42.13,0:05:44.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau disebut penguasa bijaksana,
Dialogue: 0,0:05:44.26,0:05:46.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}dan kau baik hati, Sepupu…
Dialogue: 0,0:05:46.97,0:05:50.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Saat itu, dia menggunakan julukan\Nyang hanya digunakan Reirin.{\i0}
Dialogue: 0,0:05:51.14,0:05:53.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kutukan di dunia ini,
Dialogue: 0,0:05:53.43,0:05:55.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan keajaiban bisa terjadi.
Dialogue: 0,0:05:56.02,0:05:57.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sejak kapan?{\i0}
Dialogue: 0,0:05:57.60,0:05:58.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka tertukar.{\i0}
Dialogue: 0,0:05:58.98,0:06:00.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hanya itu yang terpikirkan.{\i0}
Dialogue: 0,0:06:01.23,0:06:04.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika mereka tertukar\Ndi Festival Angka Tujuh Ganda…{\i0}
Dialogue: 0,0:06:04.73,0:06:07.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa yang telah kulakukan padanya?{\i0}
Dialogue: 0,0:06:08.24,0:06:09.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa yang telah kukatakan?{\i0}
Dialogue: 0,0:06:10.78,0:06:14.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku mengurungnya di penjara bawah tanah,\Nmengurungnya bersama singa.{\i0}
Dialogue: 0,0:06:14.08,0:06:15.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku menghinanya penjahat.{\i0}
Dialogue: 0,0:06:15.45,0:06:17.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku diam saja\Nsaat seorang dayang menyerangnya.{\i0}
Dialogue: 0,0:06:17.75,0:06:21.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah memberitahumu, Yang Mulia,
Dialogue: 0,0:06:21.17,0:06:24.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk mendengarkan perkataanku\Ndan memercayaiku.
Dialogue: 0,0:06:25.80,0:06:29.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Terlebih lagi, aku tak bisa melihat\Njati dirinya yang sebenarnya.{\i0}
Dialogue: 0,0:06:30.80,0:06:33.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, itu sudah cukup.
Dialogue: 0,0:06:37.43,0:06:38.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reirin!
Dialogue: 0,0:06:48.19,0:06:50.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya tersusul juga.
Dialogue: 0,0:06:51.11,0:06:53.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau cepat sekali?
Dialogue: 0,0:06:53.95,0:06:57.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leelee! Kau datang di saat yang tepat!
Dialogue: 0,0:06:57.20,0:07:01.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, tapi apa kau bisa\Nberjongkok di sana?
Dialogue: 0,0:07:01.33,0:07:05.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mau. Aku yakin kau punya ide buruk.
Dialogue: 0,0:07:05.21,0:07:07.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya ingin memanjat dinding ini.
Dialogue: 0,0:07:07.63,0:07:10.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah yang kusebut ide buruk!
Dialogue: 0,0:07:10.26,0:07:11.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu masuk tanpa izin, tahu?
Dialogue: 0,0:07:11.72,0:07:17.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku harus segera bertemu dengannya.
Dialogue: 0,0:07:17.06,0:07:18.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun begitu,
Dialogue: 0,0:07:18.72,0:07:22.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau tak bisa menemui Permaisuri\Ndengan penampilan seperti itu.
Dialogue: 0,0:07:22.60,0:07:24.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan Permaisuri.
Dialogue: 0,0:07:24.52,0:07:25.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:07:25.52,0:07:28.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu Shu Keigetsu?
Dialogue: 0,0:07:28.94,0:07:29.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:07:29.94,0:07:31.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa gunanya menemuinya?
Dialogue: 0,0:07:32.66,0:07:33.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan kau…
Dialogue: 0,0:07:33.95,0:07:37.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski aku bukan lagi diriku yang sekarang…
Dialogue: 0,0:07:40.00,0:07:43.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku masih boleh menemuimu, Leelee?
Dialogue: 0,0:07:43.50,0:07:45.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tidak.\N- Apa?
Dialogue: 0,0:07:45.13,0:07:48.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau.
Dialogue: 0,0:07:48.75,0:07:52.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau majikan pertamaku.
Dialogue: 0,0:07:53.01,0:07:58.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau kembali menjadi Kou Reirin,\Naku bukan lagi…
Dialogue: 0,0:07:59.39,0:08:01.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan meremehkanku.
Dialogue: 0,0:08:02.52,0:08:07.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sentimen mengalir sangat dalam\Ndi Klan Kou.
Dialogue: 0,0:08:07.90,0:08:09.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:08:09.15,0:08:13.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leelee, kau sudah punya tempat\Ndi dalam hatiku.
Dialogue: 0,0:08:13.07,0:08:16.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takkan pernah\Nmemutuskan hubungan ini di sini.
Dialogue: 0,0:08:17.83,0:08:19.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya.
Dialogue: 0,0:08:19.49,0:08:24.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan terus melindungi mereka\Nyang kubiarkan masuk ke dalam hatiku
Dialogue: 0,0:08:24.54,0:08:27.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan cara apa pun, dari siapa pun.
Dialogue: 0,0:08:27.88,0:08:31.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau, Permaisuri…
Dialogue: 0,0:08:31.76,0:08:34.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan satu orang lagi.
Dialogue: 0,0:08:43.27,0:08:46.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau terlalu baik.
Dialogue: 0,0:08:46.44,0:08:48.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau kau tidak pandai menilai karakter.
Dialogue: 0,0:08:48.90,0:08:52.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak keberatan berlutut untukmu.
Dialogue: 0,0:08:52.53,0:08:55.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Namun, tak kusangka\Nitu untuk melompati dinding.
Dialogue: 0,0:08:56.32,0:08:58.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak, Leelee.
Dialogue: 0,0:08:58.57,0:09:01.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan patahkan tulang punggungku.
Dialogue: 0,0:09:02.12,0:09:03.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan berusaha.
Dialogue: 0,0:09:04.12,0:09:07.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan melompat di hitungan ketiga,\Njadi bertahanlah.
Dialogue: 0,0:09:07.96,0:09:09.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:09:09.00,0:09:10.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemudian…
Dialogue: 0,0:09:10.63,0:09:14.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa kau tertarik dengan\Npakaian emas gamboge dari Klan Kou?
Dialogue: 0,0:09:17.55,0:09:18.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:09:20.05,0:09:22.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja tertarik.
Dialogue: 0,0:09:22.89,0:09:27.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku akan membawanya\Nsebagai suvenir saat mengunjungimu.
Dialogue: 0,0:09:32.78,0:09:35.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu… dua… tiga!
Dialogue: 0,0:09:40.28,0:09:43.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leelee, aku pasti\Nakan mengunjungimu nanti!
Dialogue: 0,0:09:47.83,0:09:50.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga semuanya berjalan lancar.
Dialogue: 0,0:09:57.38,0:09:58.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buka gerbangnya!
Dialogue: 0,0:09:59.05,0:10:01.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia, berhenti!
Dialogue: 0,0:10:01.14,0:10:03.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istana Kou sudah dipasangi jimat penyegel!
Dialogue: 0,0:10:03.39,0:10:07.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tak bisa membiarkan risiko\Npenularan sekecil apa pun pada Yang Mulia!
Dialogue: 0,0:10:07.85,0:10:09.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong kembali ke Istana Utama!
Dialogue: 0,0:10:09.98,0:10:11.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua, mundur.
Dialogue: 0,0:10:11.77,0:10:13.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan sebagai putra mahkota,
Dialogue: 0,0:10:13.48,0:10:16.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku datang secara tak resmi\Nuntuk melihat keadaannya.
Dialogue: 0,0:10:16.65,0:10:20.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini ibuku ada di dalam istana ini,\Ndan kemungkinan besar…
Dialogue: 0,0:10:23.12,0:10:25.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buka gerbangnya! Sekarang juga!
Dialogue: 0,0:10:26.41,0:10:27.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau datang kemari, 'kan?
Dialogue: 0,0:10:29.17,0:10:30.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Reirin!
Dialogue: 0,0:10:30.79,0:10:33.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kami mengerti perasaanmu, tapi…\N- {\i1}"Datang kemari"?{\i0}
Dialogue: 0,0:10:33.29,0:10:36.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Jika terjadi sesuatu…\N- {\i1}Dia sudah tahu mereka tertukar?{\i0}
Dialogue: 0,0:10:37.09,0:10:40.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Meski dia putra kandungnya,\Nkurasa Istana Kou takkan menyambut{\i0}
Dialogue: 0,0:10:40.84,0:10:43.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Putra Mahkota di tempat\Nyang dipenuhi penyakit.{\i0}
Dialogue: 0,0:10:43.55,0:10:44.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang, Yang Mulia!
Dialogue: 0,0:10:44.56,0:10:49.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika Yang Mulia kembali,\Naku harus menyiapkan sesuatu.{\i0}
Dialogue: 0,0:11:19.38,0:11:20.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gabi…
Dialogue: 0,0:11:22.47,0:11:23.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dingin sekali.{\i0}
Dialogue: 0,0:11:24.26,0:11:26.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Seperti musim dingin…{\i0}
Dialogue: 0,0:11:28.47,0:11:30.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dua puluh tahun lalu.{\i0}
Dialogue: 0,0:11:30.14,0:11:32.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Gabi, yang hamil bersamaan denganku{\i0}
Dialogue: 0,0:11:32.98,0:11:35.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}melahirkan lebih awal dari rencana.{\i0}
Dialogue: 0,0:11:35.90,0:11:41.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Saat semua orang mengunjungi Gabi,\Naku tidak mengunjunginya satu kali pun.{\i0}
Dialogue: 0,0:11:42.45,0:11:44.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bagaimana aku bisa menemuinya?{\i0}
Dialogue: 0,0:11:44.49,0:11:48.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pangeran kecil Gabi sudah meninggal,\Nsedangkan anakku masih hidup.{\i0}
Dialogue: 0,0:11:52.96,0:11:57.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengucapkan selamat kepadamu.
Dialogue: 0,0:11:57.17,0:12:02.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar {\i1}qi{\i0} naga bergema\Ndi seluruh Ibu Kota saat Yang Mulia lahir.
Dialogue: 0,0:12:02.68,0:12:08.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti mengumpulkan semua {\i1}qi{\i0} yang\Nsebelum mewujudkan diri di dunia ini.
Dialogue: 0,0:12:08.35,0:12:11.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selir Agung Shu bernasib malang.
Dialogue: 0,0:12:11.85,0:12:13.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, bunga besar mekar
Dialogue: 0,0:12:13.39,0:12:16.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di atas pengorbanan yang dilakukan\Ndengan memetik bunga lain.
Dialogue: 0,0:12:16.36,0:12:20.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan seorang raja meletakkan takhtanya\Ndi atas banyak mayat.
Dialogue: 0,0:12:21.74,0:12:24.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia Gyoumei\Npasti juga mewarisi takdir
Dialogue: 0,0:12:24.95,0:12:28.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang diberikan kepadanya\Noleh pangeran yang gugur.
Dialogue: 0,0:12:28.83,0:12:34.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selir Agung Shu harus menyayangi\NYang Mulia seperti anaknya sendiri.
Dialogue: 0,0:12:35.21,0:12:38.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak mengatakan itu\Npada Selir Agung Shu, 'kan?
Dialogue: 0,0:12:38.29,0:12:42.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kenapa kau marah?
Dialogue: 0,0:12:42.67,0:12:47.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya memuji Pangeran\Nyang diberkati {\i1}qi{\i0} naga
Dialogue: 0,0:12:47.09,0:12:50.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan Permaisuri\Nyang diberkati seorang pangeran.
Dialogue: 0,0:12:50.68,0:12:55.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, tampaknya\NSelir Agung Shu berpikiran sempit.
Dialogue: 0,0:12:55.81,0:13:01.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tampak sangat marah sampai siap\Nmengutuk Yang Maha Mulia kapan saja.
Dialogue: 0,0:13:01.07,0:13:02.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Benar.
Dialogue: 0,0:13:02.61,0:13:04.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku juga sudah bilang padanya
Dialogue: 0,0:13:04.28,0:13:07.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}bahwa hanya Yang Maha Mulia\Nyang belum mengunjunginya.
Dialogue: 0,0:13:07.24,0:13:11.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia sangat marah\Nhingga membanting bantalnya ke lantai.{\i0}
Dialogue: 0,0:13:13.25,0:13:15.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membanting bantal?
Dialogue: 0,0:13:15.66,0:13:18.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Gabi yang selama ini terbaring sakit{\i0}
Dialogue: 0,0:13:18.00,0:13:20.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}bisa bangun dan mengayunkan lengannya?{\i0}
Dialogue: 0,0:13:20.46,0:13:25.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Dia mengerutkan wajah cantiknya\Nuntuk menghina Yang Maha Mulia.
Dialogue: 0,0:13:25.47,0:13:29.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Benar-benar menunjukkan\Nsikap tidak hormat.
Dialogue: 0,0:13:30.47,0:13:31.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:13:32.47,0:13:36.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Saat itu aku mengerti apa\Nyang Gabi butuhkan.{\i0}
Dialogue: 0,0:13:37.39,0:13:39.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Target untuk kemarahannya.{\i0}
Dialogue: 0,0:13:39.94,0:13:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Yang dia butuhkan\Nuntuk bangkit dari jurang keputusasaan{\i0}
Dialogue: 0,0:13:43.78,0:13:49.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}bukan penghiburan, tapi api kebencian\Nyang akan membakar seluruh tubuhnya.{\i0}
Dialogue: 0,0:13:49.20,0:13:53.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Gabi, ambil jarum dan tusuk aku.{\i0}
Dialogue: 0,0:13:53.45,0:13:55.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kau tak boleh berhenti\Nmenggerakkan tanganmu.{\i0}
Dialogue: 0,0:13:55.96,0:13:59.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Gunakan kebencianmu\Nsebagai tongkat untuk bangkit kembali.{\i0}
Dialogue: 0,0:13:59.17,0:14:02.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sampai suatu hari,\Nsaat tiba waktunya lukamu sembuh…{\i0}
Dialogue: 0,0:14:05.97,0:14:07.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Gabi…{\i0}
Dialogue: 0,0:14:08.09,0:14:11.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}apa kau belum selesai\Nmenjahit pola kebencianmu?{\i0}
Dialogue: 0,0:14:25.69,0:14:27.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa kebencianmu…{\i0}
Dialogue: 0,0:14:27.90,0:14:29.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}malah semakin kuat?{\i0}
Dialogue: 0,0:14:40.75,0:14:43.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Maha Mulia! Bertahanlah!
Dialogue: 0,0:14:48.09,0:14:49.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Maha Mulia!
Dialogue: 0,0:14:52.60,0:14:54.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bibi.
Dialogue: 0,0:14:54.35,0:14:55.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ambilkan sekantong es!
Dialogue: 0,0:14:55.97,0:14:58.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, hangatkan kakinya!
Dialogue: 0,0:14:58.35,0:14:59.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong tenanglah.
Dialogue: 0,0:15:01.35,0:15:03.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian anggota Istana Kou\Nyang melayani Bumi.
Dialogue: 0,0:15:03.98,0:15:06.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tidak boleh plin-plan.
Dialogue: 0,0:15:08.36,0:15:10.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Shu Keigetsu?
Dialogue: 0,0:15:10.45,0:15:11.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa orang klan lain…
Dialogue: 0,0:15:12.49,0:15:14.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan minta Mata Elang mengusirmu.
Dialogue: 0,0:15:14.66,0:15:16.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong tunggu sebentar.
Dialogue: 0,0:15:20.75,0:15:22.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Tousetsu.
Dialogue: 0,0:15:25.92,0:15:29.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanita ini adalah Gadis yang berharga.
Dialogue: 0,0:15:29.88,0:15:34.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesetiaannya terlihat\Ndari tindakannya dengan Busur Pelindung.
Dialogue: 0,0:15:34.05,0:15:35.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dia dengar\NYang Maha Mulia terancam
Dialogue: 0,0:15:35.85,0:15:38.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tak bisa menahan diri\Nuntuk bergegas kemari.
Dialogue: 0,0:15:39.18,0:15:43.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bibi, aku pasti akan menyelamatkanmu.{\i0}
Dialogue: 0,0:15:44.10,0:15:46.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Apa pun yang harus kuberikan\Nsebagai gantinya…{\i0}
Dialogue: 0,0:15:46.61,0:15:47.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Tidak apa-apa.{\i0}
Dialogue: 0,0:15:47.90,0:15:49.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Semua akan baik-baik saja.{\i0}
Dialogue: 0,0:15:51.07,0:15:55.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kepala Dayang Tousetsu,\Nterima kasih banyak.
Dialogue: 0,0:15:55.95,0:15:59.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku minta maaf telah mengganggu\Nsebagai orang dari klan lain.
Dialogue: 0,0:16:00.62,0:16:05.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, Yang Maha Mulia Permaisuri\Nsedang berjuang melawan penyakitnya.
Dialogue: 0,0:16:06.38,0:16:09.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuharap kalian semua juga\Nmenjalankan tugas kalian.
Dialogue: 0,0:16:12.26,0:16:13.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kuantar keluar.
Dialogue: 0,0:16:17.01,0:16:20.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tousetsu, napas Yang Maha Mulia\Nmakin lemah.
Dialogue: 0,0:16:20.72,0:16:23.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong gunakan obat\Nuntuk memperlebar jalur udara.
Dialogue: 0,0:16:23.60,0:16:26.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, dia tidak bisa menelan\Nobat bubuk dalam kondisinya.
Dialogue: 0,0:16:26.73,0:16:28.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada obat topikal yang bisa digunakan.
Dialogue: 0,0:16:28.86,0:16:32.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oleskan salep nomor 53 yang kutinggalkan\Ndi ruang es di dada dan punggungnya.
Dialogue: 0,0:16:32.86,0:16:33.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:16:33.90,0:16:38.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika dia terus muntah,\Njangan sampai dia dehidrasi.
Dialogue: 0,0:16:38.37,0:16:42.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rendam kapas dengan air yang dicampur\Ngaram dan gula, lalu lembapkan mulutnya.
Dialogue: 0,0:16:42.91,0:16:44.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:16:45.33,0:16:47.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang kau datang ke sini.
Dialogue: 0,0:16:47.29,0:16:50.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak tahu betapa ini membuatku lega.
Dialogue: 0,0:16:52.63,0:16:55.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar minta maaf, Tousetsu.
Dialogue: 0,0:16:57.14,0:16:59.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, tinggal sebentar lagi.
Dialogue: 0,0:16:59.89,0:17:02.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan berusaha menanganinya,
Dialogue: 0,0:17:02.39,0:17:04.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi untuk sementara,\Ntolong jaga Yang Maha Mulia.
Dialogue: 0,0:17:08.40,0:17:09.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:17:12.40,0:17:16.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Selama ini aku terlalu arogan dan jemawa.{\i0}
Dialogue: 0,0:17:17.03,0:17:19.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Biasanya di situasi seperti ini,\N"Kou Reirin"{\i0}
Dialogue: 0,0:17:19.66,0:17:21.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}sebagai wakil Istana Kou{\i0}
Dialogue: 0,0:17:21.20,0:17:23.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}seharusnya mengambil alih\Ndan memberikan arahan.{\i0}
Dialogue: 0,0:17:24.04,0:17:27.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tak terlalu khawatir\Nsetelah bertukar tubuh.{\i0}
Dialogue: 0,0:17:27.62,0:17:32.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku malah bersantai\Nmenikmati tubuh yang sehat.{\i0}
Dialogue: 0,0:17:32.71,0:17:36.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kehidupan impian dengan tubuh\Nyang tertukar sudah berakhir.{\i0}
Dialogue: 0,0:17:37.68,0:17:44.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Nyonya Keigetsu, aku akan kembali\Nke tubuhku, meski kau menentangnya.{\i0}
Dialogue: 0,0:17:44.02,0:17:49.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kemudian masalahmu,\Ndan semua tentang insiden ini,{\i0}
Dialogue: 0,0:17:49.61,0:17:51.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}akan kuselesaikan sendiri!{\i0}
Dialogue: 0,0:17:53.78,0:17:54.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya.
Dialogue: 0,0:17:55.86,0:17:57.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini aku.
Dialogue: 0,0:17:57.95,0:17:59.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong buka pintunya.
Dialogue: 0,0:18:01.45,0:18:02.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu kau?
Dialogue: 0,0:18:03.54,0:18:05.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada orang lain bersamamu?
Dialogue: 0,0:18:05.79,0:18:08.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak. Aku sendirian.
Dialogue: 0,0:18:27.77,0:18:30.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah sembilan hari\Nsejak Festival Angka Tujuh Ganda.
Dialogue: 0,0:18:30.90,0:18:35.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya, aku bisa bertemu langsung\Ndenganmu, Nyonya Keigetsu.
Dialogue: 0,0:18:35.90,0:18:38.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku tidak akan basa-basi.
Dialogue: 0,0:18:38.99,0:18:42.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku ingin kau\Nmembatalkan pertukaran ini sekarang.
Dialogue: 0,0:18:43.91,0:18:49.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya, aku ingin mengulur waktu\Nselama yang kau inginkan,
Dialogue: 0,0:18:49.37,0:18:50.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi situasinya sudah berubah.
Dialogue: 0,0:18:51.92,0:18:55.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permaisuri pingsan karena sihir racun.
Dialogue: 0,0:18:56.67,0:19:01.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku ingin kembali ke wujud asliku\Nuntuk menyelamatkannya.
Dialogue: 0,0:19:01.55,0:19:03.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:19:04.22,0:19:08.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, tujuan\NSelir Agung Shu yang sebenarnya
Dialogue: 0,0:19:08.14,0:19:10.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah membunuh Permaisuri.
Dialogue: 0,0:19:10.81,0:19:14.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya aku ingin\Nsegera menarik Busur Pelindung
Dialogue: 0,0:19:14.31,0:19:16.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk memurnikan kutukan.
Dialogue: 0,0:19:17.07,0:19:21.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, Yang Mulia tidak mau\Nmeminjamkan busur pada "Shu Keigetsu".
Dialogue: 0,0:19:21.82,0:19:24.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, aku ingin\Nsegera kembali ke tubuh asliku
Dialogue: 0,0:19:24.74,0:19:28.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan meminjam busur\Nsebagai keponakan Yang Mulia!
Dialogue: 0,0:19:29.08,0:19:31.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu! Darah apa itu?
Dialogue: 0,0:19:32.79,0:19:36.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sungguh minta maaf\Nkarena telah melukai tubuhmu!
Dialogue: 0,0:19:36.21,0:19:39.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terlalu lama menarik busurnya.
Dialogue: 0,0:19:40.38,0:19:43.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa harus kau yang menariknya?
Dialogue: 0,0:19:43.39,0:19:44.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:19:44.39,0:19:46.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa minta bantuan\Nsalah satu perwira militer.
Dialogue: 0,0:19:46.89,0:19:50.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Seingatku, harta keramat\Nada di bawah yurisdiksi Klan Gen.
Dialogue: 0,0:19:50.10,0:19:52.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Mata Elang juga keturunan Gen.
Dialogue: 0,0:19:52.64,0:19:57.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah getaran senarnya akan\Nlebih menonjol jika dia menarik busurnya?
Dialogue: 0,0:19:57.02,0:19:58.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Keigetsu.
Dialogue: 0,0:19:58.94,0:20:00.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:20:00.61,0:20:04.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benar.
Dialogue: 0,0:20:04.57,0:20:07.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya berpikir\Nharus melakukan sesuatu.
Dialogue: 0,0:20:07.66,0:20:11.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku gelisah karena harus\Nmenyelesaikan semuanya sendiri.
Dialogue: 0,0:20:11.75,0:20:17.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara itu, aku sudah bicara kasar\Npada Yang Mulia.
Dialogue: 0,0:20:17.50,0:20:20.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga menyombong ke Leelee.
Dialogue: 0,0:20:20.26,0:20:24.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini yang namanya tidak ada kemajuan?
Dialogue: 0,0:20:24.09,0:20:25.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tiba-tiba begini?
Dialogue: 0,0:20:25.76,0:20:28.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sungguh minta maaf, Nyonya Keigetsu.
Dialogue: 0,0:20:28.85,0:20:31.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sama sekali tak bisa bergerak
Dialogue: 0,0:20:31.39,0:20:34.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena rasa malu terbesar\Nyang pernah kurasakan seumur hidupku.
Dialogue: 0,0:20:35.73,0:20:40.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kau lemah\Npada hal-hal yang paling aneh!
Dialogue: 0,0:20:41.44,0:20:45.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, caramu menanganinya\Nterlalu lembut.
Dialogue: 0,0:20:45.57,0:20:48.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena ini kutukan, kau ingin\Nmenarik busur untuk menghilangkannya?
Dialogue: 0,0:20:49.58,0:20:54.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sama saja seperti melambaikan tangan\Nuntuk mengusir nyamuk yang beterbangan.{\i0}
Dialogue: 0,0:20:54.67,0:20:57.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu tidak menyelesaikan apa pun.{\i0}
Dialogue: 0,0:20:57.08,0:20:58.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:20:58.09,0:21:01.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika dikutuk,\Nkau harus melawannya dengan kutukan.
Dialogue: 0,0:21:02.55,0:21:05.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Balas dengan kutukan.
Dialogue: 0,0:21:05.30,0:21:09.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, ini akan membahayakan\NSelir Agung Shu?
Dialogue: 0,0:21:09.97,0:21:12.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak keberatan, Nyonya Keigetsu?
Dialogue: 0,0:21:13.85,0:21:16.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kutukan memang seperti itu.
Dialogue: 0,0:21:17.56,0:21:18.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Meski begitu…
Dialogue: 0,0:21:18.94,0:21:21.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}jika ingin melawan api dengan api,\Npertama-tama…
Dialogue: 0,0:21:22.48,0:21:26.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}kita harus mengumpulkan serangga\Nuntuk membuat sihir racun.{\i0}
Dialogue: 0,0:21:26.99,0:21:30.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, butuh beberapa hari\Nuntuk menyelesaikannya.{\i0}
Dialogue: 0,0:21:30.95,0:21:31.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa?{\i0}
Dialogue: 0,0:21:31.99,0:21:37.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kita hanya butuh satu serangga\Nyang selamat dari kanibalisme?
Dialogue: 0,0:21:37.25,0:21:38.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:21:38.58,0:21:42.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, racun Selir Agung\Nsepertinya menggunakan laba-laba,
Dialogue: 0,0:21:42.25,0:21:45.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi kita butuh serangga besar\Nyang memangsa laba-laba.
Dialogue: 0,0:21:47.51,0:21:49.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wadahnya tidak cukup,
Dialogue: 0,0:21:49.47,0:21:51.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi laba-laba dan lipan masuk bersama!
Dialogue: 0,0:21:51.93,0:21:54.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti mereka bisa saling memangsa!
Dialogue: 0,0:21:54.14,0:21:56.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Keigetsu! Ayo ikut!
Dialogue: 0,0:21:56.02,0:21:57.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:21:57.14,0:21:59.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti kujelaskan di jalan.
Dialogue: 0,0:21:59.23,0:22:01.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan keluar lewat pintu belakang!
Dialogue: 0,0:22:01.36,0:22:02.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!
Dialogue: 0,0:22:05.61,0:22:06.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Qi-{\i1}nya berantakan.{\i0}
Dialogue: 0,0:22:06.99,0:22:09.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia, di sini berbahaya!
Dialogue: 0,0:22:09.03,0:22:12.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong segera kembali ke tempat\Nyang layak untuk Putra Mahkota!
Dialogue: 0,0:22:15.83,0:22:18.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bibi, aku akan segera menyelamatkanmu!{\i0}
Dialogue: 0,0:22:18.67,0:22:20.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tunggu aku!{\i0}
