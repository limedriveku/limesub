Dialogue: 0,0:00:07.85,0:00:11.09,sign,,0000,0000,0000,,"SHU KEIGETSU, GADIS KLAN SHU (JIWA REIRIN)"
Dialogue: 0,0:01:32.38,0:01:34.19,sign,,0000,0000,0000,,LEELEE, DAYANG KLAN SHU
Dialogue: 0,0:10:44.66,0:10:46.85,sign,,0000,0000,0000,,"EI GYOUMEI, PUTRA MAHKOTA"
Dialogue: 0,0:10:49.04,0:10:51.26,sign,,0000,0000,0000,,"SHIN-U, KAPTEN MATA ELANG"
Dialogue: 0,0:12:42.99,0:12:44.55,sign,,0000,0000,0000,,"BUNKOU, KASIM"
Dialogue: 0,0:00:05.56,0:00:07.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh cuaca yang cerah.
Dialogue: 0,0:00:07.85,0:00:11.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu yang sempurna untuk bercocok tanam!
Dialogue: 0,0:00:12.11,0:00:14.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah empat hari sejak aku bertukar tubuh,
Dialogue: 0,0:00:14.85,0:00:17.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan hidup di sini benar-benar yang terbaik.
Dialogue: 0,0:00:17.37,0:00:21.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahan pangan dan tanaman obat\Ntumbuh subur luar biasa.
Dialogue: 0,0:00:21.62,0:00:24.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski setiap hari\Nkucurahkan seluruh waktu untuk bertani,
Dialogue: 0,0:00:24.14,0:00:26.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sama sekali tidak pingsan.
Dialogue: 0,0:00:28.03,0:00:29.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan kalau bergadang,
Dialogue: 0,0:00:29.75,0:00:32.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak bikin khawatir.
Dialogue: 0,0:00:32.63,0:00:35.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanannya juga enak.
Dialogue: 0,0:00:35.01,0:00:38.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesehatan itu sungguh luar biasa!
Dialogue: 0,0:00:38.14,0:00:44.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh Dewa Leluhur,\Napa boleh aku sebahagia ini?
Dialogue: 0,0:00:44.64,0:00:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangan dan kaki yang panjang ini,
Dialogue: 0,0:00:47.04,0:00:50.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}cuma dengan olahraga yang biasa kulakukan,
Dialogue: 0,0:00:50.30,0:00:52.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa langsung terlatih dengan cepat.
Dialogue: 0,0:00:52.03,0:00:53.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hmph!
Dialogue: 0,0:00:53.15,0:00:57.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenikmatan ini, otot, itulah kekuatan!
Dialogue: 0,0:00:57.60,0:01:00.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ingin coba\Nmembentuk perut rata berotot,
Dialogue: 0,0:01:00.50,0:01:03.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi jelas tak mungkin\Ndalam tiga hari tersisa, ya.
Dialogue: 0,0:01:04.56,0:01:07.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Upacara Festival Hantu tiga hari lagi.
Dialogue: 0,0:01:07.60,0:01:10.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa hukuman kurunganku juga akan dicabut
Dialogue: 0,0:01:10.11,0:01:12.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan aku seharusnya\Nbisa bertemu Nona Keigetsu.
Dialogue: 0,0:01:12.84,0:01:14.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takkan kumaafkan!
Dialogue: 0,0:01:14.80,0:01:18.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kami bicara di penjara bawah tanah,\Ntak ada kabar sama sekali,
Dialogue: 0,0:01:18.89,0:01:22.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi apa yang sedang dipikirkan\NNona Keigetsu, ya?
Dialogue: 0,0:01:23.80,0:01:28.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun juga,\Naku harus menemuinya sekali.
Dialogue: 0,0:01:29.19,0:01:32.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apaan, sih, pagi-pagi buta begini\Nsudah komat-kamit sendiri?
Dialogue: 0,0:01:34.19,0:01:37.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, Leelee. Selamat pagi.
Dialogue: 0,0:01:37.01,0:01:38.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bangun pagi sekali, ya.
Dialogue: 0,0:01:38.75,0:01:42.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata orang yang bangun lebih pagi dariku...
Dialogue: 0,0:01:48.63,0:01:49.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak hari itu,
Dialogue: 0,0:01:50.00,0:01:54.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leelee tinggal dan makan bersama denganku.
Dialogue: 0,0:01:54.46,0:01:59.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang melihatnya menghabiskan\Nhari-hari penuh semangat di sini.
Dialogue: 0,0:01:59.43,0:02:01.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Apaan, sih?
Dialogue: 0,0:02:01.96,0:02:06.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku tidak sabar menantikan\Nhari seperti apa lagi hari ini.
Dialogue: 0,0:02:06.01,0:02:07.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita bersuara lantang!
Dialogue: 0,0:02:26.93,0:02:30.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Though I Am an Inept Villainess
Dialogue: 0,0:03:40.99,0:03:44.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, mari kita beralih ke sarapan.
Dialogue: 0,0:03:44.51,0:03:46.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu. Cukup,\Nubi lagi ubi lagi itu sudah...
Dialogue: 0,0:03:46.95,0:03:48.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja,
Dialogue: 0,0:03:48.25,0:03:49.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bumbunya akan kuganti, kok.
Dialogue: 0,0:03:50.11,0:03:51.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan itu masalahnya.
Dialogue: 0,0:03:54.33,0:03:55.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, lebah?
Dialogue: 0,0:03:56.71,0:03:58.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia ini...
Dialogue: 0,0:03:58.09,0:04:01.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak datang ke sini,\Nsuasana hatinya selalu baik.
Dialogue: 0,0:04:01.84,0:04:03.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan ini!
Dialogue: 0,0:04:03.18,0:04:07.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, cacing tanah!\NTolong gemburkan tanahnya terus, ya.
Dialogue: 0,0:04:07.81,0:04:10.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, bahkan ada laba-laba dan kelabang juga.
Dialogue: 0,0:04:12.44,0:04:14.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkutuklah kau!
Dialogue: 0,0:04:14.40,0:04:16.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, gunting dan...
Dialogue: 0,0:04:16.51,0:04:20.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ini sangat cocok untuk bantalan jarum.\NAku bisa menjahit.
Dialogue: 0,0:04:22.65,0:04:24.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bau banget.
Dialogue: 0,0:04:24.01,0:04:26.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini pasti akan kubuat dia menangis.
Dialogue: 0,0:04:26.03,0:04:28.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan kotoran ini!
Dialogue: 0,0:04:28.41,0:04:30.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat cocok untuk pupuk kompos.
Dialogue: 0,0:04:30.58,0:04:32.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?!
Dialogue: 0,0:04:32.16,0:04:36.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal setiap hari sudah kuusili,\Ntapi tak mempan.
Dialogue: 0,0:04:36.06,0:04:39.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku ingin kabur dari Istana Shu.
Dialogue: 0,0:04:39.55,0:04:40.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini pasti akan...
Dialogue: 0,0:04:41.50,0:04:42.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau berbuat apa, ya?
Dialogue: 0,0:04:44.96,0:04:48.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya hari ini pun\NLeelee sedang memikirkan keusilan.
Dialogue: 0,0:04:48.75,0:04:52.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ralat, maksudku aktivitas\Npelayanan untukku, ya.
Dialogue: 0,0:04:53.81,0:04:59.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa, aku senang sekali kalau\Ndiberi pisau dapur atau pewarna lagi.
Dialogue: 0,0:04:59.19,0:05:02.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sekarang pasti lagi\Nmemikirkan hal yang tidak-tidak, 'kan?
Dialogue: 0,0:05:02.77,0:05:03.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kok.
Dialogue: 0,0:05:04.43,0:05:05.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebah-lebah sekalian,
Dialogue: 0,0:05:05.66,0:05:08.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terima kasih atas berkah luar biasa ini.
Dialogue: 0,0:05:09.53,0:05:13.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leelee lebih suka garam daripada madu?
Dialogue: 0,0:05:13.40,0:05:15.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau yang mana saja boleh, kok.
Dialogue: 0,0:05:20.92,0:05:24.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa manusia bisa berubah secepat ini?
Dialogue: 0,0:05:24.63,0:05:26.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanita menyebalkan itu...
Dialogue: 0,0:05:26.97,0:05:30.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bangun bareng matahari terbit,\Nbahkan lebih pagi dariku,
Dialogue: 0,0:05:30.55,0:05:31.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu merapikan halaman...
Dialogue: 0,0:05:31.89,0:05:34.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, sudah jadi, lo.
Dialogue: 0,0:05:36.39,0:05:38.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan mengurus segalanya\Ndengan begitu telaten.
Dialogue: 0,0:05:39.36,0:05:42.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, padahal seingatku\Ndia benci serangga,
Dialogue: 0,0:05:42.51,0:05:45.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kemarin dia menyentuhnya langsung\Ndengan tangan.
Dialogue: 0,0:05:45.32,0:05:47.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena wadahnya tak cukup,
Dialogue: 0,0:05:47.18,0:05:49.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}laba-laba dan kelabang\Ndi satu tempat saja, ya.
Dialogue: 0,0:05:49.85,0:05:51.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Nmereka bakal saling memakan, lo!
Dialogue: 0,0:05:52.49,0:05:55.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu juga bagian dari hukum alam.
Dialogue: 0,0:05:56.96,0:05:58.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat makan.
Dialogue: 0,0:06:01.46,0:06:04.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Leelee sedang dalam masa pertumbuhan,
Dialogue: 0,0:06:04.75,0:06:06.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}silakan ambil bagian yang lebih besar.
Dialogue: 0,0:06:07.97,0:06:10.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:06:16.36,0:06:17.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahagianya.
Dialogue: 0,0:06:17.98,0:06:21.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia yang sekarang ini\Nmungkin agak imut juga.
Dialogue: 0,0:06:21.50,0:06:22.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tidak!
Dialogue: 0,0:06:22.90,0:06:25.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sadarlah, diriku!\N- Maafkan aku.
Dialogue: 0,0:06:25.48,0:06:28.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leelee juga pasti\Npunya alasan sendiri, 'kan?
Dialogue: 0,0:06:28.20,0:06:30.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berbagai hal yang kau lakukan, anu...
Dialogue: 0,0:06:30.20,0:06:33.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kepadaku akhir-akhir ini,\Npasti demi tujuan itu, 'kan?
Dialogue: 0,0:06:34.12,0:06:38.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya aku pun berharap bisa\Nmemberikan reaksi seperti muntah darah
Dialogue: 0,0:06:38.35,0:06:42.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena ketakutan atau\Nmengucurkan air mata darah, tapi...
Dialogue: 0,0:06:42.38,0:06:47.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kalau kau bicara sampai sejauh itu,\Naku jadi kelihatan jahat sekali.
Dialogue: 0,0:06:47.38,0:06:51.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, bagaimana kalau berhenti saja?
Dialogue: 0,0:06:53.55,0:06:57.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ini dayang istana\Nyang jujur dan mengagumkan.
Dialogue: 0,0:06:57.06,0:07:00.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mengerahkan seluruh kemampuanmu\Nke dalam pekerjaan dayang,
Dialogue: 0,0:07:00.51,0:07:04.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hatimu pasti juga akan merasa senang.
Dialogue: 0,0:07:05.70,0:07:07.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan, sih, itu?
Dialogue: 0,0:07:07.32,0:07:12.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kau yang sudah merendahkanku,\Nkenapa sekarang malah memuji?
Dialogue: 0,0:07:12.20,0:07:13.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:07:13.20,0:07:16.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dipaksa mengurus kriminal\Ndi rumah bobrok begini,
Dialogue: 0,0:07:16.51,0:07:20.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai tak bisa lagi\Nmenjadi dayang istana sungguhan,
Dialogue: 0,0:07:20.13,0:07:20.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semua gara-gara kau!
Dialogue: 0,0:07:20.96,0:07:22.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku mengabdi dengan sepenuh hati,
Dialogue: 0,0:07:22.81,0:07:26.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau bisa jamin posisi dan imbalanku\Nsebagai dayang istana?
Dialogue: 0,0:07:26.34,0:07:27.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal itu...
Dialogue: 0,0:07:27.76,0:07:31.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}U-Untuk diriku yang sekarang,\Naku tak bisa, tapi...
Dialogue: 0,0:07:31.23,0:07:31.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, 'kan?
Dialogue: 0,0:07:31.84,0:07:34.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, jangan asal bicara besar!
Dialogue: 0,0:07:38.23,0:07:39.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan!
Dialogue: 0,0:07:39.41,0:07:40.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak salah.
Dialogue: 0,0:07:40.88,0:07:43.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah pembalasan dendam yang adil.
Dialogue: 0,0:07:44.02,0:07:45.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leelee! Mau ke mana?!
Dialogue: 0,0:07:45.90,0:07:46.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik!
Dialogue: 0,0:07:51.76,0:07:54.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal selama ini selalu\Nmembuatku menderita.
Dialogue: 0,0:07:54.88,0:07:57.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa harus menunjukkan\Nekspresi wajah seperti itu?
Dialogue: 0,0:08:02.16,0:08:03.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhentilah.
Dialogue: 0,0:08:04.81,0:08:06.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}No-Nona Gayou?
Dialogue: 0,0:08:06.84,0:08:09.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal seharusnya\Nkami bertemu waktu petang.
Dialogue: 0,0:08:10.92,0:08:13.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kecewa padamu.
Dialogue: 0,0:08:14.30,0:08:16.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah dengar rumornya.
Dialogue: 0,0:08:16.30,0:08:18.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku memercayai laporan darimu,
Dialogue: 0,0:08:18.61,0:08:21.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan selalu memberimu imbalan\Nsetiap kali menerimanya.
Dialogue: 0,0:08:21.56,0:08:24.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar Shu Keigetsu malah\Nmelewatkan harinya dengan tertawa gembira.
Dialogue: 0,0:08:24.80,0:08:26.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:08:26.56,0:08:31.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa orang yang sedang diusili\Nmalah kelihatan senang?
Dialogue: 0,0:08:31.76,0:08:33.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan kau
Dialogue: 0,0:08:33.20,0:08:35.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berbohong padaku?
Dialogue: 0,0:08:35.42,0:08:37.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak! Mana mungkin begitu!
Dialogue: 0,0:08:37.28,0:08:39.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar sudah mengusilinya!
Dialogue: 0,0:08:39.21,0:08:40.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bersumpah demi Dewa Leluhur!
Dialogue: 0,0:08:40.83,0:08:43.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh. Kau berani bersumpah.
Dialogue: 0,0:08:43.76,0:08:47.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kau benar-benar sudah\Nmembuang kesetiaanmu pada Shu Keigetsu?
Dialogue: 0,0:08:47.63,0:08:49.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali tak salah lagi.
Dialogue: 0,0:08:49.21,0:08:52.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kau tidak dijinakkan oleh Shu Keigetsu?
Dialogue: 0,0:08:52.86,0:08:54.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja tidak.
Dialogue: 0,0:08:56.66,0:09:00.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah. Kalau begitu,\Nkali ini akan kumaafkan.
Dialogue: 0,0:09:02.40,0:09:04.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:09:04.10,0:09:05.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun,
Dialogue: 0,0:09:05.60,0:09:09.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berikutnya gunakan ini untuk mengusilinya.
Dialogue: 0,0:09:09.00,0:09:12.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Digunakan untuk... apa?
Dialogue: 0,0:09:12.10,0:09:15.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah tugasmu adalah memikirkan itu?
Dialogue: 0,0:09:20.49,0:09:24.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asalkan ada bukti yang bisa diserahkan\Nkepada Nona Seika, itu sudah cukup.
Dialogue: 0,0:09:24.36,0:09:26.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cabik saja bagian mana pun yang kau suka.
Dialogue: 0,0:09:26.37,0:09:30.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah itu pakaian, rambut,\Natau bahkan jantungnya.
Dialogue: 0,0:09:30.88,0:09:34.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, mengusili dengan melukai\Nsampai membunuh itu beda cerita.
Dialogue: 0,0:09:34.80,0:09:37.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun keadaannya,\Nkalau aku melukai seorang Gadis Muda,
Dialogue: 0,0:09:37.51,0:09:39.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku pasti akan dihukum mati.
Dialogue: 0,0:09:39.89,0:09:42.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya kenapa?
Dialogue: 0,0:09:42.89,0:09:44.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:09:44.39,0:09:47.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau rupanya tak paham\Ndengan posisimu sendiri, ya.
Dialogue: 0,0:09:47.96,0:09:50.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kau menerima tusuk konde itu,
Dialogue: 0,0:09:50.41,0:09:54.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nyawamu sudah berada dalam genggamanku.
Dialogue: 0,0:09:57.15,0:10:01.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tak bisa, aku tinggal menyerahkanmu\Nkepada Kapten Mata Elang.
Dialogue: 0,0:10:01.36,0:10:04.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atas kejahatan mencuri tusuk konde\Nmilik Klan Kin.
Dialogue: 0,0:10:04.86,0:10:06.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak mungkin...
Dialogue: 0,0:10:06.29,0:10:08.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Antara aku yang mengenakan putih gading
Dialogue: 0,0:10:08.55,0:10:11.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan kau, si merah pudar\Nyang cuma orang asing,
Dialogue: 0,0:10:11.10,0:10:13.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kira-kira mereka akan percaya siapa, ya?
Dialogue: 0,0:10:13.53,0:10:15.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Tapi...
Dialogue: 0,0:10:15.67,0:10:19.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis penari rendahan yang tak punya keahlian\Nselain menggoda pria
Dialogue: 0,0:10:19.93,0:10:22.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lakukan saja tanpa banyak bicara.
Dialogue: 0,0:10:22.06,0:10:24.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong tunggu sebentar!
Dialogue: 0,0:10:26.64,0:10:28.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menyentuhku.
Dialogue: 0,0:10:29.65,0:10:33.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baru bisa dapat makanan\Nsetelah melakukan pekerjaanmu, 'kan?
Dialogue: 0,0:10:33.76,0:10:35.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tikus kecil.
Dialogue: 0,0:10:44.66,0:10:46.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kau lakukan sesuatu
Dialogue: 0,0:10:46.85,0:10:49.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan wajah bosanmu itu, Shin-u?
Dialogue: 0,0:10:49.04,0:10:51.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf.
Dialogue: 0,0:10:51.26,0:10:54.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus ikut menemanimu\Nmenjenguk Nona Kou Reirin berhari-hari,
Dialogue: 0,0:10:54.70,0:10:57.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai tanpa sadar perasaan muak ini\Nmuncul di wajahku.
Dialogue: 0,0:10:57.42,0:11:00.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hmph, jangan mengajak ribut\Ndengan nada minta maaf begitu.
Dialogue: 0,0:11:00.56,0:11:04.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat pertama kali aku bertemu denganmu dulu,\Nmatamu juga begitu, ya.
Dialogue: 0,0:11:07.93,0:11:10.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kau adik tiriku, ya?
Dialogue: 0,0:11:10.06,0:11:12.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kita satu ayah,\Nternyata sama sekali tidak mirip.
Dialogue: 0,0:11:12.69,0:11:15.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mata birumu itu keturunan dari ibumu?
Dialogue: 0,0:11:15.55,0:11:16.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya memang begitu.
Dialogue: 0,0:11:16.90,0:11:19.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bicara seolah itu\Nurusan orang lain saja, ya.
Dialogue: 0,0:11:19.60,0:11:21.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku tak terlalu mengingatnya.
Dialogue: 0,0:11:21.91,0:11:24.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana situasi di medan perang?
Dialogue: 0,0:11:24.36,0:11:28.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wilayah tak berguna yang dijadikan\Narena saling bunuh antarmanusia.
Dialogue: 0,0:11:30.76,0:11:34.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus juga, sorot matamu\Nyang seperti ikan mati itu.
Dialogue: 0,0:11:34.08,0:11:35.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menyukainya.
Dialogue: 0,0:11:35.50,0:11:37.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Yang Mulia Pangeran pernah memujinya,
Dialogue: 0,0:11:37.97,0:11:40.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku pun tumbuh besar\Ndengan mata yang tetap begini.
Dialogue: 0,0:11:40.76,0:11:42.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu,
Dialogue: 0,0:11:42.63,0:11:45.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sempat mengira Yang Mulia Pangeran\Ntak suka perempuan rapuh
Dialogue: 0,0:11:45.62,0:11:47.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang cuma mengandalkan kemolekan saja.
Dialogue: 0,0:11:49.56,0:11:52.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pikir Reirin cuma perempuan yang molek?
Dialogue: 0,0:11:52.60,0:11:55.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia perempuan dari Klan Kou\Nyang berpendirian sangat teguh.
Dialogue: 0,0:11:55.90,0:11:57.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat pertama kali diperkenalkan padaku,
Dialogue: 0,0:11:57.61,0:12:01.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat semua orang tanpa terkecuali terpesona\Noleh aura naga yang kumiliki,
Dialogue: 0,0:12:01.36,0:12:04.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia satu-satunya perempuan\Nyang pipinya sama sekali tak memerah.
Dialogue: 0,0:12:04.83,0:12:06.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan kesulitan kalau kau meremehkannya.
Dialogue: 0,0:12:07.60,0:12:11.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, entah karena masalah Shu Keigetsu\Nberdampak besar baginya,
Dialogue: 0,0:12:11.70,0:12:15.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sejak Festival Tujuh Malam,\Naku merasa gelagatnya sedikit berbeda.
Dialogue: 0,0:12:15.38,0:12:17.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bicara soal perbedaan,
Dialogue: 0,0:12:17.30,0:12:19.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shu Keigetsu juga sejak Pengadilan Singa,
Dialogue: 0,0:12:19.85,0:12:22.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tampaknya jadi sangat tenang.
Dialogue: 0,0:12:23.10,0:12:26.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya aku ingin menyerang\NShu Keigetsu berlebihan, tapi...
Dialogue: 0,0:12:26.76,0:12:31.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang benar dia sudah berulang kali\Nberbuat kejahatan sampai disebut wanita keji.
Dialogue: 0,0:12:31.27,0:12:33.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum kau jadi Kapten Mata Elang,
Dialogue: 0,0:12:33.41,0:12:35.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia pernah berbohong "hampir diserang"
Dialogue: 0,0:12:35.31,0:12:38.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hingga hampir memenggal\Nkepala seorang kasim.
Dialogue: 0,0:12:38.43,0:12:39.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kejadian seperti itu juga...
Dialogue: 0,0:12:40.83,0:12:42.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Mata Elang!
Dialogue: 0,0:12:42.99,0:12:44.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia Pangeran Gyoumei,
Dialogue: 0,0:12:44.55,0:12:45.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mohon maaf sebesar-besarnya.
Dialogue: 0,0:12:45.85,0:12:48.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izinkan aku sampaikan laporan\Nkepada Kapten Mata Elang.
Dialogue: 0,0:12:49.74,0:12:53.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini laporan dari pengawal Mata Elang\Ndi Istana Gadis.
Dialogue: 0,0:12:53.01,0:12:54.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya, seorang dayang istana
Dialogue: 0,0:12:54.61,0:12:57.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berpakaian merah pudar\Nmembawa pisau belati menuju Istana Shu.
Dialogue: 0,0:12:57.38,0:12:59.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langkahnya gontai
Dialogue: 0,0:12:59.45,0:13:01.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan gerak-geriknya sangat\Nmencurigakan serta berbahaya.
Dialogue: 0,0:13:01.65,0:13:03.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tak dihentikan saat itu juga?
Dialogue: 0,0:13:03.22,0:13:08.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tak bisa masuk ke istana\Nsemudah Kapten Mata Elang.
Dialogue: 0,0:13:08.06,0:13:10.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, kalau tak salah lihat,
Dialogue: 0,0:13:10.43,0:13:13.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}katanya dia berjalan lurus\Nmenuju gubuk Shu Keigetsu...
Dialogue: 0,0:13:13.90,0:13:18.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi maksudmu, asal korbannya Shu Keigetsu,\Ntak apa-apa?
Dialogue: 0,0:13:32.95,0:13:35.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya bersemangat sekali, ya.
Dialogue: 0,0:13:35.96,0:13:38.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh tidak berguna.
Dialogue: 0,0:13:38.26,0:13:43.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ternyata sama sekali belum bisa\Nmembalas apa pun ke Leelee.
Dialogue: 0,0:13:43.96,0:13:47.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal jarang sekali ada orang\Nyang mau meluapkan perasaannya
Dialogue: 0,0:13:47.38,0:13:49.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan begitu jujur padaku.
Dialogue: 0,0:13:49.85,0:13:53.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tusuk konde maupun sisir pribadi\Nyang ada di Istana Kou
Dialogue: 0,0:13:53.35,0:13:56.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}juga tak mungkin bisa kuberikan\Ndalam situasi ini.
Dialogue: 0,0:13:58.03,0:14:00.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah!\NMari kita bersuara lantang!
Dialogue: 0,0:14:06.16,0:14:08.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, Leelee!
Dialogue: 0,0:14:08.49,0:14:10.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kau sudah kembali...
Dialogue: 0,0:14:11.19,0:14:15.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang apa kau? Itu...
Dialogue: 0,0:14:15.00,0:14:17.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini semua gara-gara kau.
Dialogue: 0,0:14:19.50,0:14:24.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah menghancurkan hidupku.
Dialogue: 0,0:14:24.90,0:14:27.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leelee, tenanglah.
Dialogue: 0,0:14:27.41,0:14:30.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik! Sekeras apa pun aku berusaha,\Nujung-ujungnya
Dialogue: 0,0:14:30.51,0:14:32.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tetap dipanggil "gadis penari rendahan"!
Dialogue: 0,0:14:32.64,0:14:34.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bercanda!
Dialogue: 0,0:14:34.21,0:14:37.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leelee, pokoknya tenang dulu, ya.
Dialogue: 0,0:14:37.21,0:14:38.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sentuh aku!
Dialogue: 0,0:14:39.53,0:14:41.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya sudah berakhir untukku!
Dialogue: 0,0:14:41.65,0:14:43.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal seperti itu...
Dialogue: 0,0:14:47.86,0:14:50.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rambut Nona Keigetsu...
Dialogue: 0,0:14:50.98,0:14:54.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan kau!
Dialogue: 0,0:14:54.87,0:14:56.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau lakukan?!
Dialogue: 0,0:14:59.08,0:15:00.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak apa?
Dialogue: 0,0:15:02.08,0:15:05.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Kapten Mata Elang dan Tuan Bunkou...
Dialogue: 0,0:15:05.63,0:15:07.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa bisa ada di sini?
Dialogue: 0,0:15:07.21,0:15:09.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku datang memastikan\Natas perintah Pangeran.
Dialogue: 0,0:15:09.38,0:15:11.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau orang-orang di istana dalam
Dialogue: 0,0:15:11.35,0:15:15.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menganggap tak apa main hakim sendiri\Nasalkan itu Shu Keigetsu,
Dialogue: 0,0:15:15.06,0:15:16.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu semua salahku.
Dialogue: 0,0:15:16.64,0:15:19.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti sikapku yang membuat mereka\Nbertindak begitu.
Dialogue: 0,0:15:19.64,0:15:22.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergilah, Kapten Mata Elang.
Dialogue: 0,0:15:22.11,0:15:23.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:15:24.90,0:15:27.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dilarang keras melakukan kekerasan\Ndengan senjata tajam di istana dalam.
Dialogue: 0,0:15:27.96,0:15:30.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa pun yang melanggar\Nakan dijatuhi hukuman berat.
Dialogue: 0,0:15:32.90,0:15:35.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu,\Naku akan menanyai kedua belah pihak.
Dialogue: 0,0:15:35.16,0:15:36.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang telah terjadi?
Dialogue: 0,0:15:46.66,0:15:48.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kujawab...
Dialogue: 0,0:15:49.17,0:15:52.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi aku sedang minta tolong\Nmemotong rambutku yang bercabang.
Dialogue: 0,0:15:53.09,0:15:54.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa katamu?
Dialogue: 0,0:15:54.72,0:15:58.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti yang kubilang tadi,\Naku memintanya merapikan rambut.
Dialogue: 0,0:15:59.73,0:16:02.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yang dijuluki wanita keji\Nkini mencoba melindungi orang?
Dialogue: 0,0:16:02.96,0:16:05.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lakukan hal\Nyang tidak biasa kau lakukan.
Dialogue: 0,0:16:05.48,0:16:09.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pikir alasan itu bisa diterima\Ndalam situasi ini?
Dialogue: 0,0:16:09.11,0:16:11.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan alasan.
Dialogue: 0,0:16:11.20,0:16:14.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya fakta yang murni.
Dialogue: 0,0:16:14.06,0:16:18.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlepas dari perasaan apa pun\Nyang dipendam Leelee,
Dialogue: 0,0:16:18.25,0:16:23.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang sebenarnya terjadi\Ncuma rambut bercabangku telah dipotong.
Dialogue: 0,0:16:23.87,0:16:29.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kita terus-menerus curiga\Natau mencela hal yang tak terjadi,
Dialogue: 0,0:16:29.16,0:16:31.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu cuma buang-buang tenaga saja.
Dialogue: 0,0:16:36.83,0:16:38.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perempuan ini...
Dialogue: 0,0:16:39.36,0:16:41.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}siapa?
Dialogue: 0,0:16:41.14,0:16:42.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena keadaannya sudah begitu,
Dialogue: 0,0:16:42.92,0:16:45.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami mohon izin undur diri\Ndari hadapan kalian, ya.
Dialogue: 0,0:16:45.60,0:16:48.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena dayang istanaku\Nsudah basah kuyup begini,
Dialogue: 0,0:16:48.61,0:16:51.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku harus menyuruhnya berganti pakaian.
Dialogue: 0,0:16:52.26,0:16:55.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, apa tidak ada\Nyang ingin Anda sampaikan?
Dialogue: 0,0:16:56.42,0:16:58.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ingin kusampaikan?
Dialogue: 0,0:16:58.26,0:17:01.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena saat ini ada hal lain\Nyang harus lebih diprioritaskan.
Dialogue: 0,0:17:09.54,0:17:12.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga, ada yang aneh\Ndengan Shu Keigetsu.
Dialogue: 0,0:17:12.71,0:17:14.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setuju.
Dialogue: 0,0:17:14.55,0:17:17.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laporan untuk Yang Mulia Pangeran\Nperlu kehati-hatian mendalam.
Dialogue: 0,0:17:17.14,0:17:19.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setuju.
Dialogue: 0,0:17:19.55,0:17:23.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, menurutku sebaiknya\Nkau saja yang tulis lembar laporannya.
Dialogue: 0,0:17:23.45,0:17:25.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak setuju.
Dialogue: 0,0:17:28.00,0:17:29.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Leelee.
Dialogue: 0,0:17:29.45,0:17:32.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lepaskan pakaian kotormu itu.
Dialogue: 0,0:17:32.48,0:17:34.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu berbaliklah membelakangiku.
Dialogue: 0,0:17:35.23,0:17:37.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku akan dicambuk?
Dialogue: 0,0:17:37.32,0:17:40.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, kau ini bicara apa, sih?
Dialogue: 0,0:17:40.03,0:17:43.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, ada apa dengan nada bicaramu\Nyang biasanya bersemangat?
Dialogue: 0,0:17:43.83,0:17:48.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku sudah mencoba membunuhmu.
Dialogue: 0,0:17:50.59,0:17:54.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ternyata orang yang baik, ya, Leelee.
Dialogue: 0,0:17:57.60,0:18:00.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bagian bahunya dikecilkan sedikit,\Nukurannya pasti pas.
Dialogue: 0,0:18:00.20,0:18:03.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untunglah kain lapisan dalamnya tak apa-apa.
Dialogue: 0,0:18:04.66,0:18:05.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa, sih?
Dialogue: 0,0:18:05.98,0:18:10.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, aku sedang mencocokkan pakaian\Nyang akan kuberikan padamu, Leelee.
Dialogue: 0,0:18:12.48,0:18:15.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan sekali,\Nini pakaian merah vermilion.
Dialogue: 0,0:18:15.61,0:18:17.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merah pudar juga manis, sih,
Dialogue: 0,0:18:17.65,0:18:22.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi pakaian ini pasti sangat cocok\Ndengan sosokmu yang cekatan.
Dialogue: 0,0:18:22.23,0:18:23.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin...
Dialogue: 0,0:18:23.50,0:18:28.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa aku pakai merah vermilion\Nyang dikenakan dayang tingkat tinggi?
Dialogue: 0,0:18:28.00,0:18:31.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula,\Nkau dayang istanaku yang berharga.
Dialogue: 0,0:18:31.75,0:18:34.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya ada masalah?
Dialogue: 0,0:18:34.10,0:18:38.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang karena ada sesuatu\Nyang bisa kuberikan kepadamu.
Dialogue: 0,0:18:42.26,0:18:44.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengarkan aku, Leelee.
Dialogue: 0,0:18:44.66,0:18:48.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuci tangan, berpenampilan bersih,\Nlalu tersenyum.
Dialogue: 0,0:18:48.63,0:18:51.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua itu rahasia dari kesehatan.
Dialogue: 0,0:18:51.63,0:18:53.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau dayang istana yang mendampingiku,
Dialogue: 0,0:18:53.66,0:18:56.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau harus pertahankan hal ini\Napa pun yang terjadi, tahu.
Dialogue: 0,0:18:56.94,0:18:59.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin...
Dialogue: 0,0:18:59.36,0:19:02.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku sudah mengarahkan\Nsenjata tajam berniat menebasmu.
Dialogue: 0,0:19:04.10,0:19:06.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau cuma memotong\Nsedikit rambutku saja, bukan?
Dialogue: 0,0:19:13.09,0:19:17.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Postur bungkuk hanya membawa\Ndampak buruk bagi tubuh.
Dialogue: 0,0:19:17.34,0:19:22.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Busungkan dada, tarik napas dalam-dalam,\Nlalu tatap lurus ke depan.
Dialogue: 0,0:19:22.86,0:19:27.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau terus menunduk\Nsampai merusak kesehatan, ibumu pasti marah.
Dialogue: 0,0:19:27.60,0:19:29.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu?
Dialogue: 0,0:19:29.05,0:19:31.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beliau dulunya\Npenari dari negeri asing, bukan?
Dialogue: 0,0:19:31.85,0:19:35.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal seorang perwira militer pun\Ntak bisa bertarung tanpa pedang,
Dialogue: 0,0:19:35.15,0:19:38.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi beliau mampu bertahan hidup\Ndi tanah asing hanya dengan tubuhnya.
Dialogue: 0,0:19:38.83,0:19:41.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beliau sosok yang sangat hebat, ya.
Dialogue: 0,0:19:41.11,0:19:44.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau harus hidup baik-baik\Nagar tak membuat ibumu malu.
Dialogue: 0,0:19:48.26,0:19:50.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa, sih?
Dialogue: 0,0:19:50.06,0:19:53.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa dia bisa mengatakan hal seperti itu?
Dialogue: 0,0:19:53.63,0:19:56.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar, ya, Lily.
Dialogue: 0,0:19:56.23,0:20:00.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anakku tersayang.\NIngatlah baik-baik, ya.
Dialogue: 0,0:20:00.01,0:20:03.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perempuan itu kapan pun\Nharus selalu membusungkan dada.
Dialogue: 0,0:20:03.20,0:20:05.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jaga tubuhmu agar tetap tegak, ya.
Dialogue: 0,0:20:10.02,0:20:11.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:20:13.23,0:20:15.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena sudah bicara kasar,
Dialogue: 0,0:20:15.36,0:20:18.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan melakukan berbagai macam keusilan.
Dialogue: 0,0:20:19.63,0:20:23.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merobek pakaianmu, memotong rambutmu.
Dialogue: 0,0:20:23.05,0:20:26.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, mohon maaf sebesar-besarnya\Natas kesalahanku.
Dialogue: 0,0:20:29.06,0:20:31.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, kok, Leelee.
Dialogue: 0,0:20:34.54,0:20:36.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, 'kan?
Dialogue: 0,0:20:36.30,0:20:39.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sama sekali tak memasukkannya\Nke dalam hati.
Dialogue: 0,0:20:39.83,0:20:43.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaliknya, kau sampai terpojok\Nsedemikian rupa begini.
Dialogue: 0,0:20:43.55,0:20:48.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku karena terlambat menyadarinya.
Dialogue: 0,0:20:51.56,0:20:52.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah berubah.
Dialogue: 0,0:20:53.46,0:20:58.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang ini, benar-benar\Nsudah sepenuhnya berubah.
Dialogue: 0,0:21:00.16,0:21:04.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin bersamanya.
Dialogue: 0,0:21:05.86,0:21:09.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan pergi mengembalikan\Ntusuk konde ini ke Nona Gayou.
Dialogue: 0,0:21:09.33,0:21:13.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi diriku yang sekarang,\Naku sudah tak bisa lagi mengkhianati,
Dialogue: 0,0:21:13.26,0:21:15.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ataupun membuatnya merasa putus asa.
Dialogue: 0,0:21:16.30,0:21:20.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walaupun, setelah itu aku harus dimintai\Npertanggungjawaban atas kejahatan.
Dialogue: 0,0:21:29.60,0:21:34.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, bagaimana kalau sekarang\Nkita beralih ke topik sebenarnya, Leelee?
Dialogue: 0,0:21:34.10,0:21:36.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Topik sebenarnya?
Dialogue: 0,0:21:36.10,0:21:38.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seseorang sudah merebut senyummu\Ndan bahkan membuatmu
Dialogue: 0,0:21:38.91,0:21:42.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai berpikir bahwa semuanya\Nsudah berakhir, ya.
Dialogue: 0,0:21:43.86,0:21:46.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong beri tahu aku, Leelee.
Dialogue: 0,0:21:47.46,0:21:52.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa dan dari mana asal si bodoh kurang ajar\Nyang menyudutkan dayangku
Dialogue: 0,0:21:52.40,0:21:54.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang berharga ini?
Dialogue: 0,0:23:33.47,0:23:35.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panas.
Dialogue: 0,0:23:35.26,0:23:38.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesak, sesak, sesak.
Dialogue: 0,0:23:38.70,0:23:40.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan ini?
Dialogue: 0,0:23:40.56,0:23:43.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa sudah lima hari\Ndemamnya tidak turun juga?
Dialogue: 0,0:23:43.48,0:23:47.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kalau begini terus, aku akan mati?
