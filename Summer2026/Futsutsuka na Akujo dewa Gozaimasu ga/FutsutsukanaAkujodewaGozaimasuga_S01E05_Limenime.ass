Dialogue: 0,0:00:00.29,0:00:03.00,sign,,0000,0000,0000,,FESTIVAL HANTU
Dialogue: 0,0:00:15.39,0:00:17.05,sign,,0000,0000,0000,,SHIN-U, KAPTEN MATA ELANG
Dialogue: 0,0:00:21.00,0:00:23.48,sign,,0000,0000,0000,,"EI GYOUMEI, PUTRA MAHKOTA"
Dialogue: 0,0:00:43.73,0:00:46.51,sign,,0000,0000,0000,,"KOU REIRIN, GADIS MUDA KLAN KOU (SHU KEIGETSU)"
Dialogue: 0,0:01:46.66,0:01:47.94,sign,,0000,0000,0000,,"LEELEE, DAYANG KLAN SHU"
Dialogue: 0,0:01:47.94,0:01:50.00,sign,,0000,0000,0000,,"SHU KEIGETSU, GADIS MUDA KLAN SHU (KOU REIRIN)"
Dialogue: 0,0:03:49.03,0:03:52.75,sign,,0000,0000,0000,,"SEDANG MEMAKAI MASKER GAMBAS"
Dialogue: 0,0:04:24.91,0:04:25.63,sign,,0000,0000,0000,,KIN SEIKA, GADIS MUDA KLAN KIN
Dialogue: 0,0:06:31.90,0:06:32.91,sign,,0000,0000,0000,,GEN KASUI, GADIS MUDA KLAN GEN
Dialogue: 0,0:08:32.23,0:08:33.70,sign,,0000,0000,0000,,"RAN HOUSHUN, GADIS MUDA KLAN RAN"
Dialogue: 0,0:13:48.99,0:13:49.65,sign,,0000,0000,0000,,SELIR MULIA, SHU GABI
Dialogue: 0,0:00:17.06,0:00:21.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira ekspresi apa yang akan\Nditunjukkan wanita itu di sini?
Dialogue: 0,0:00:21.00,0:00:23.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal dia dibenci semua orang di Istana Gadis,
Dialogue: 0,0:00:23.48,0:00:25.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dimusuhi,
Dialogue: 0,0:00:25.10,0:00:28.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan didesak absen oleh Selir Mulia Shu,\Nwalinya sendiri.
Dialogue: 0,0:00:28.59,0:00:31.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu,\Ndia tetap memaksakan diri hadir.
Dialogue: 0,0:00:31.63,0:00:33.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada yang terjadi?
Dialogue: 0,0:00:35.43,0:00:37.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat aku menjenguknya tadi pagi,
Dialogue: 0,0:00:37.86,0:00:39.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reirin sedang menangis.
Dialogue: 0,0:00:40.46,0:00:43.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa sangat sedih.
Dialogue: 0,0:00:43.73,0:00:46.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin terlihat sebaik mungkin di hadapan Kakanda.
Dialogue: 0,0:00:46.51,0:00:48.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal cuma itu yang kupikirkan,
Dialogue: 0,0:00:48.91,0:00:51.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan selalu berusaha keras\Nmelakukan yang terbaik...
Dialogue: 0,0:00:58.20,0:01:01.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru kali ini aku melihat\Nwanita setegar dia menangis.
Dialogue: 0,0:01:01.46,0:01:02.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru kali ini?
Dialogue: 0,0:01:02.45,0:01:03.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:01:05.83,0:01:07.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:01:09.59,0:01:14.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanita yang kubiarkan masuk\Nke dalam hatiku hanyalah Reirin.
Dialogue: 0,0:01:14.50,0:01:15.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi
Dialogue: 0,0:01:15.84,0:01:18.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apakah dia benar-benar
Dialogue: 0,0:01:18.06,0:01:21.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kou Reirin yang kucintai selama ini?
Dialogue: 0,0:01:26.10,0:01:29.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shu Keigetsu yang Anda khawatirkan\Ntelah tiba.
Dialogue: 0,0:01:29.10,0:01:33.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya dia cuma berhasil\Nmembawa satu dayang pendamping.
Dialogue: 0,0:01:35.36,0:01:39.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf karena aku terlambat\Nmenghadiri upacara ritual.
Dialogue: 0,0:01:46.66,0:01:47.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam sejahtera
Dialogue: 0,0:01:47.94,0:01:50.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagi Anda sekalian.
Dialogue: 0,0:02:08.96,0:02:13.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Though I Am an Inept Villainess
Dialogue: 0,0:03:28.22,0:03:30.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia luar biasa cantik, bukan?
Dialogue: 0,0:03:30.98,0:03:33.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dayangku ini.
Dialogue: 0,0:03:34.98,0:03:37.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Busungkan dada, tatap ke depan...
Dialogue: 0,0:03:37.51,0:03:38.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Busungkan dada, tatap ke depan.
Dialogue: 0,0:03:38.07,0:03:41.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, aku juga\Nsudah berusaha keras, tapi...
Dialogue: 0,0:03:41.61,0:03:45.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiga hari kuhabiskan dengan melakukan\Nhal kesukaanku, yaitu menyulam,
Dialogue: 0,0:03:45.68,0:03:49.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}serta merawat berbagai hal\Ntanpa kenal siang dan malam.
Dialogue: 0,0:03:49.03,0:03:52.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh hari-hari yang memuaskan.
Dialogue: 0,0:03:53.60,0:03:56.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlebih lagi, kulit Nona Keigetsu...
Dialogue: 0,0:03:56.38,0:04:00.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tak peduli sebanyak apa pun perona dipoles,\Nkulitnya tak jadi kasar.
Dialogue: 0,0:04:02.01,0:04:04.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak boleh terlalu kegirangan terus.
Dialogue: 0,0:04:04.39,0:04:06.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuan hari ini adalah
Dialogue: 0,0:04:06.61,0:04:10.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengembalikan tusuk konde ini ke Nona Seika.
Dialogue: 0,0:04:12.83,0:04:15.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis Muda, kursinya...
Dialogue: 0,0:04:16.26,0:04:17.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm.
Dialogue: 0,0:04:17.63,0:04:22.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya mereka sudah berasumsi\Nkalau Shu Keigetsu pasti absen.
Dialogue: 0,0:04:23.80,0:04:24.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Seika.
Dialogue: 0,0:04:25.64,0:04:30.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya tak ada kursi\Nyang disediakan untukku dan dayangku...
Dialogue: 0,0:04:30.54,0:04:32.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:04:32.04,0:04:37.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal sudah didesak absen\Noleh Selir Mulia Shu, tapi kau tetap datang.
Dialogue: 0,0:04:37.29,0:04:41.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak menyangka mukamu setebal itu.
Dialogue: 0,0:04:41.55,0:04:44.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengingat kau punya kulit\Nyang begitu tangguh,
Dialogue: 0,0:04:44.66,0:04:47.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagaimana kalau kau duduk di lantai saja?
Dialogue: 0,0:04:54.43,0:04:56.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang aku tangguh.
Dialogue: 0,0:05:02.57,0:05:04.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kin Seika.
Dialogue: 0,0:05:04.76,0:05:06.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:05:06.20,0:05:08.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyambut tamu dengan sopan
Dialogue: 0,0:05:08.35,0:05:13.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}meski hadir tanpa diduga,\Nbukankah di situlah kemampuan Klan Kin diuji?
Dialogue: 0,0:05:13.20,0:05:15.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat, bawakan kursi!
Dialogue: 0,0:05:15.08,0:05:16.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:05:16.25,0:05:19.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak\Natas perhatian Anda, Pangeran.
Dialogue: 0,0:05:19.05,0:05:20.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan tetapi, aku...
Dialogue: 0,0:05:21.86,0:05:24.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}duduk di sini saja sudah cukup.
Dialogue: 0,0:05:24.59,0:05:26.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa katamu?
Dialogue: 0,0:05:26.09,0:05:27.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa katanya?
Dialogue: 0,0:05:29.76,0:05:33.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis Muda, kenapa kau malah gembira\Ndi situasi begini, sih?
Dialogue: 0,0:05:33.72,0:05:37.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya, Leelee, dia bilang aku tangguh.
Dialogue: 0,0:05:39.96,0:05:44.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Shu Keigetsu sama sekali\Ntak tergoyahkan oleh provokasiku?
Dialogue: 0,0:05:44.36,0:05:46.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya ini?
Dialogue: 0,0:05:46.73,0:05:47.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu,
Dialogue: 0,0:05:49.20,0:05:52.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa dia memang\Nwanita secantik ini sebelumnya?
Dialogue: 0,0:05:55.70,0:05:59.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat.\NAku ini penyelenggaranya.
Dialogue: 0,0:05:59.35,0:06:02.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak boleh sampai abaikan jalannya acara.
Dialogue: 0,0:06:02.13,0:06:06.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, semuanya, karena seluruh hadirin\Ntelah berkumpul di sini...
Dialogue: 0,0:06:06.86,0:06:08.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seraya memohon kesuburan hasil bumi,
Dialogue: 0,0:06:08.63,0:06:12.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan ini,\Nupacara ritual Festival Hantu kita mulai.
Dialogue: 0,0:06:26.46,0:06:28.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, persembahan tarian suci
Dialogue: 0,0:06:28.65,0:06:31.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan dibawakan Nona Gen Kasui,\Nwaktu dan tempat kami persilakan.
Dialogue: 0,0:06:40.46,0:06:43.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maka, seraya memanjatkan doa\Nagar sang dewi kesuburan tersenyum
Dialogue: 0,0:06:43.92,0:06:48.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pada hari musim gugur\Nyang akan datang nanti.
Dialogue: 0,0:06:58.30,0:07:01.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara genta yang berdenting keras itu,
Dialogue: 0,0:07:01.10,0:07:04.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}alih-alih seperti alat musik,\Nmalah terasa bagaikan senjata.
Dialogue: 0,0:07:13.63,0:07:18.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, tarian yang aman begitu\Nmemang sangat cocok sebagai pembuka.
Dialogue: 0,0:07:22.25,0:07:24.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi yang menari dengan apik,
Dialogue: 0,0:07:24.68,0:07:28.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah jadi adat bagi penonton\Nuntuk memberikan hadiah penghargaan, tapi...
Dialogue: 0,0:07:32.20,0:07:36.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, sekarang apa yang akan dilakukan\NShu Keigetsu yang sudah diusir
Dialogue: 0,0:07:36.51,0:07:38.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ke gudang sebatang kara itu?
Dialogue: 0,0:07:39.77,0:07:41.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leelee.
Dialogue: 0,0:07:41.21,0:07:42.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:07:45.86,0:07:48.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tarian yang benar-benar luar biasa.
Dialogue: 0,0:07:48.40,0:07:50.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kusudama?
Dialogue: 0,0:07:59.66,0:08:04.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aslinya, kusudama itu benda\Nuntuk festival awal musim panas.
Dialogue: 0,0:08:04.56,0:08:09.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ini masuk akal untuk Gadis Muda\Ndari Klan Shu penguasa elemen musim panas.
Dialogue: 0,0:08:09.17,0:08:13.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang terpenting, sulamannya\Nyang begitu detail tampak sangat indah.
Dialogue: 0,0:08:15.43,0:08:18.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk ukuran seonggok tikus got\Nyang biasanya tak berguna,
Dialogue: 0,0:08:18.85,0:08:21.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}barang ini lumayan mengagumkan juga, ya.
Dialogue: 0,0:08:21.18,0:08:25.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kita lihat saja\Napa itu akan bertahan sampai akhir.
Dialogue: 0,0:08:27.23,0:08:32.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, Nona Ran Houshun.\NWaktu dan tempat dipersilakan.
Dialogue: 0,0:08:32.23,0:08:33.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:08:33.70,0:08:36.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maka, anu...
Dialogue: 0,0:08:36.90,0:08:39.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seraya memanjatkan doa\Nagar sang dewi kesuburan tersenyum
Dialogue: 0,0:08:39.17,0:08:43.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pada hari musim gugur\Nyang akan datang nanti.
Dialogue: 0,0:08:48.30,0:08:49.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:08:49.63,0:08:53.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski gerakannya agak canggung,\Ntampaknya dia sudah banyak berlatih.
Dialogue: 0,0:08:53.56,0:08:56.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali tak ada keraguan\Ndi tiap gerakannya.
Dialogue: 0,0:09:11.90,0:09:15.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, mau bagaimanapun,\Nitu cuma tarian gadis kecil.
Dialogue: 0,0:09:17.20,0:09:19.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikutnya giliranku, bukan?
Dialogue: 0,0:09:22.70,0:09:24.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa sudah giliran beliau?
Dialogue: 0,0:09:24.28,0:09:25.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tak sabar.
Dialogue: 0,0:09:28.80,0:09:33.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kutunjukkan tarian\Nyang sesungguhnya pada kalian semua.
Dialogue: 0,0:09:33.71,0:09:35.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maka dari itu,
Dialogue: 0,0:09:35.50,0:09:37.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seraya memanjatkan doa\Nagar sang dewi kesuburan tersenyum
Dialogue: 0,0:09:37.91,0:09:42.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pada hari musim gugur\Nyang akan datang nanti.
Dialogue: 0,0:10:14.96,0:10:17.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tarian yang sangat luar biasa.
Dialogue: 0,0:10:17.96,0:10:19.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:10:26.02,0:10:28.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ini pemberian dari Pangeran Gyoumei.
Dialogue: 0,0:10:29.00,0:10:31.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu yang ini pemberian dari Selir Mulia Shu.
Dialogue: 0,0:10:34.80,0:10:38.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa sangat tersanjung\Ndan bahagia luar biasa karena bisa
Dialogue: 0,0:10:38.31,0:10:41.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menerima begitu banyak hadiah penghargaan\Nyang megah dari kalian.
Dialogue: 0,0:10:41.03,0:10:44.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menghadiahi tarian yang bahkan\Ndipuji oleh Pangeran Mahkota
Dialogue: 0,0:10:44.81,0:10:47.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya dengan sekelas kusudama itu\Nsebuah penghinaan.
Dialogue: 0,0:10:47.86,0:10:50.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, sekarang apa yang akan kau lakukan,
Dialogue: 0,0:10:50.54,0:10:53.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shu Keigetsu?
Dialogue: 0,0:10:53.17,0:10:56.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tarian yang sangat indah.
Dialogue: 0,0:10:56.96,0:10:58.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai gantinya,
Dialogue: 0,0:10:58.66,0:11:01.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}meski ini pemberian\Nyang teramat sederhana...
Dialogue: 0,0:11:02.40,0:11:04.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan.
Dialogue: 0,0:11:06.40,0:11:07.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon terimalah
Dialogue: 0,0:11:07.43,0:11:10.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pemberian yang satu ini.
Dialogue: 0,0:11:19.66,0:11:22.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira, tindakan apa yang akan diambil\NNona Kin Seika selanjutnya?
Dialogue: 0,0:11:24.43,0:11:26.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana menurutmu?
Dialogue: 0,0:11:27.23,0:11:32.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pikir, kalau Nona Seika\Npunya hati yang murah hati
Dialogue: 0,0:11:32.08,0:11:33.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}layaknya sang dewi kesuburan,
Dialogue: 0,0:11:33.91,0:11:36.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti akan menerimanya\Ntanpa perlu berkata apa-apa.
Dialogue: 0,0:11:37.26,0:11:42.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Dengan kata lain, kalau ingin\Ntunjukkan kemurahan hati sang tuan rumah...
Dialogue: 0,0:11:42.30,0:11:44.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kau menerima tusuk konde itu,
Dialogue: 0,0:11:44.47,0:11:48.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nyawamu sudah berada dalam genggamanku.
Dialogue: 0,0:11:48.52,0:11:50.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya, tanpa perlu berkata apa-apa,
Dialogue: 0,0:11:50.52,0:11:54.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terima saja pengembalian barang\Nyang dijadikan alat ancaman ini, ya?
Dialogue: 0,0:11:56.03,0:11:59.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alamak, barang yang sungguh\Nluar biasa indah.
Dialogue: 0,0:11:59.75,0:12:03.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Bukankah dia seharusnya sedang diasingkan sebatang kara?\N- Leelee, mari kita cari dayang yang waktu itu.
Dialogue: 0,0:12:03.56,0:12:07.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kalau begitu, bagaimana bisa dia punya barang seperti ini?\N- Kira-kira, di mana keberadaan Nona Gayou sekarang?
Dialogue: 0,0:12:07.08,0:12:10.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah dia habiskan harinya\Ndengan menindas para dayang?
Dialogue: 0,0:12:10.83,0:12:12.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama seperti yang dilakukannya selama ini.
Dialogue: 0,0:12:12.50,0:12:14.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, mengerikan sekali!
Dialogue: 0,0:12:14.46,0:12:15.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang ini?
Dialogue: 0,0:12:16.84,0:12:18.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan hal bodoh itu.
Dialogue: 0,0:12:18.90,0:12:20.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Nona Seika...
Dialogue: 0,0:12:20.63,0:12:21.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau memang begitu,
Dialogue: 0,0:12:21.65,0:12:24.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kenapa dia bisa dapat barang semegah ini?
Dialogue: 0,0:12:24.38,0:12:26.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Benar juga, ya. Agak aneh.\N- Orang yang ini?
Dialogue: 0,0:12:26.50,0:12:27.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:12:27.64,0:12:31.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, itu hasil curian?
Dialogue: 0,0:12:31.14,0:12:34.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelumnya, aku pernah dengar\Nseseorang menangis
Dialogue: 0,0:12:34.46,0:12:36.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}meratapi tusuk kondenya yang hilang.
Dialogue: 0,0:12:38.02,0:12:42.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya juga manusia, kalau sudah tersudut,\Nakan nekat melakukan apa saja.
Dialogue: 0,0:12:42.15,0:12:45.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dayang pendampingnya pun cuma satu orang.
Dialogue: 0,0:12:45.30,0:12:48.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kehidupannya pasti teramat menyedihkan.
Dialogue: 0,0:12:48.60,0:12:50.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlebih lagi, dayang itu...
Dialogue: 0,0:12:50.54,0:12:55.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau diperhatikan baik-baik,\Nbukankah dia anak seorang gadis penari?
Dialogue: 0,0:12:55.04,0:12:58.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajahnya benar-benar\Nterlihat murahan dan genit.
Dialogue: 0,0:12:59.50,0:13:00.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti,
Dialogue: 0,0:13:00.21,0:13:02.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia sengaja suruh dayang itu mencurinya?
Dialogue: 0,0:13:02.61,0:13:04.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yang di sebelah sana.
Dialogue: 0,0:13:05.26,0:13:11.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barusan, sepertinya ada ucapan\Nyang merendahkan dayangku, ya.
Dialogue: 0,0:13:11.22,0:13:13.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekspresi menyeramkan itu muncul lagi!
Dialogue: 0,0:13:14.30,0:13:18.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Seika, padahal aku\Ncuma mengutarakan pendapatku...
Dialogue: 0,0:13:18.60,0:13:20.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, mengutarakan pendapat\Ndengan cara begitu,
Dialogue: 0,0:13:20.94,0:13:24.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}boleh kami anggap\Nsebagai tata krama khas Klan Kin, ya.
Dialogue: 0,0:13:25.95,0:13:27.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Seika.
Dialogue: 0,0:13:27.70,0:13:30.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izinkan aku yang lancang ini untuk bicara.
Dialogue: 0,0:13:30.30,0:13:32.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di Istana Gadis,\Nseorang Gadis Muda dan dayangnya
Dialogue: 0,0:13:32.95,0:13:35.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah seharusnya terikat\Noleh ikatan yang kuat.
Dialogue: 0,0:13:35.96,0:13:38.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada yang kurang berkenan\Ndari sikap dayangmu,
Dialogue: 0,0:13:38.71,0:13:40.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukankah sudah semestinya
Dialogue: 0,0:13:40.51,0:13:43.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau selaku Gadis Muda\Nyang menegurnya lebih dulu?
Dialogue: 0,0:13:43.96,0:13:45.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan, Keigetsu!
Dialogue: 0,0:13:49.66,0:13:51.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketahuilah rasa malu.
Dialogue: 0,0:13:51.81,0:13:55.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga. Jarang sekali melihat\NSelir Mulia Shu angkat bicara.
Dialogue: 0,0:13:56.31,0:13:59.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah bermuka tebal\Nmenghadiri upacara ritual,
Dialogue: 0,0:13:59.16,0:14:02.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}malah berani-beraninya\Nmengganggu jalannya acara
Dialogue: 0,0:14:02.41,0:14:04.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mencari keributan dengan klan lain.
Dialogue: 0,0:14:04.83,0:14:08.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya seberapa banyak lagi kau\Ningin mencoreng mukaku baru kau puas?
Dialogue: 0,0:14:08.49,0:14:10.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan tetapi, Selir Mulia Shu...
Dialogue: 0,0:14:10.55,0:14:13.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah selesaikan\Nmasa pengasingan yang diperintahkan.
Dialogue: 0,0:14:13.68,0:14:18.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, aku tak mencari keributan,\Ncuma ingin berdiskusi baik-baik.
Dialogue: 0,0:14:18.12,0:14:21.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan alasan konyolmu itu!
Dialogue: 0,0:14:21.26,0:14:24.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang juga, cepat kembali ke istanamu!
Dialogue: 0,0:14:24.70,0:14:26.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum kau makin\Nmempermalukan diri di sini.
Dialogue: 0,0:14:26.88,0:14:30.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paham, 'kan?\NIni peringatan terakhir.
Dialogue: 0,0:14:30.86,0:14:32.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:14:33.20,0:14:36.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kata lain, asalkan aku\Ntak mengganggu jalannya upacara ritual
Dialogue: 0,0:14:36.41,0:14:38.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tak mempermalukan diri,
Dialogue: 0,0:14:38.28,0:14:42.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku boleh terus mengobrol\Ndengan Nona Seika, 'kan?
Dialogue: 0,0:14:43.15,0:14:46.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Naku akan menari sebentar sekarang.
Dialogue: 0,0:14:46.53,0:14:49.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Seika, mohon pegang janjimu.
Dialogue: 0,0:14:49.91,0:14:53.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tarianku tak sampai merusak\Npemandangan mata kalian
Dialogue: 0,0:14:53.45,0:14:56.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan aku bisa selesaikan\Nupacara ritual ini dengan selamat,
Dialogue: 0,0:14:56.16,0:14:58.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mari lanjutkan pembicaraan kita.
Dialogue: 0,0:15:00.67,0:15:03.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lakukan saja kalau kau memang bisa.
Dialogue: 0,0:15:22.56,0:15:24.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian ini!
Dialogue: 0,0:15:24.30,0:15:28.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Seika orangnya jujur\Ndan tak suka trik-trik picik.
Dialogue: 0,0:15:28.90,0:15:32.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pasti cuma kecelakaan\Nyang tak disengaja.
Dialogue: 0,0:15:33.26,0:15:35.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, ketidaksengajaan membawa kesialan.
Dialogue: 0,0:15:35.74,0:15:37.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam upacara ritual\Nuntuk memohon kesuburan hasil bumi,
Dialogue: 0,0:15:37.98,0:15:40.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sama sekali tak boleh\Nada unsur pembawa petaka.
Dialogue: 0,0:15:41.56,0:15:42.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oleh karena itu,
Dialogue: 0,0:15:42.90,0:15:46.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan ubah jadi tarian yang bisa\Nmengempas jauh ketidakpastian itu.
Dialogue: 0,0:15:46.42,0:15:49.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ini sebenarnya mau apa?
Dialogue: 0,0:15:54.03,0:15:56.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seraya memanjatkan doa\Nagar sang dewi kesuburan tersenyum
Dialogue: 0,0:15:56.46,0:15:59.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pada hari musim gugur\Nyang akan datang nanti.
Dialogue: 0,0:16:33.05,0:16:35.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan ini?
Dialogue: 0,0:16:36.01,0:16:38.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara dia merendahkan posisi pinggangnya...
Dialogue: 0,0:16:38.18,0:16:40.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara dia menekuk pergelangan tangannya...
Dialogue: 0,0:16:42.36,0:16:46.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tarian yang cuma bisa dilakukan\Noleh orang yang berlatih keras.
Dialogue: 0,0:16:48.28,0:16:51.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keanggunan yang didasari\Nusaha keras sedemikian rupa ini
Dialogue: 0,0:16:51.11,0:16:54.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagaikan Nona Reirin sendiri.
Dialogue: 0,0:16:57.32,0:17:00.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, atau mungkin sedikit berbeda.
Dialogue: 0,0:17:00.91,0:17:04.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tarian Nona Reirin teramat anggun\Ndan halus di tiap gerakannya.
Dialogue: 0,0:17:04.88,0:17:05.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun,
Dialogue: 0,0:17:06.70,0:17:08.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}gerakan tarian yang satu ini,
Dialogue: 0,0:17:09.33,0:17:13.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tarian yang sedang\NShu Keigetsu lakukan ini...
Dialogue: 0,0:17:15.06,0:17:16.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tarian berputar!
Dialogue: 0,0:17:24.09,0:17:25.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang itu...
Dialogue: 0,0:17:30.57,0:17:31.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanita itu...
Dialogue: 0,0:17:33.76,0:17:34.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}siapa?
Dialogue: 0,0:17:43.93,0:17:45.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa!
Dialogue: 0,0:17:45.14,0:17:47.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat memukau!
Dialogue: 0,0:17:54.16,0:17:56.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan ini?
Dialogue: 0,0:17:57.03,0:18:00.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa hatiku jadi segelisah ini?
Dialogue: 0,0:18:06.60,0:18:09.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pangeran, mohon berikan\Nhadiah penghargaannya.
Dialogue: 0,0:18:10.73,0:18:11.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pangeran!
Dialogue: 0,0:18:12.98,0:18:15.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikanlah hadiah terbesar\Nyang pernah ada pada dewi kahyangan,
Dialogue: 0,0:18:15.95,0:18:18.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang baru saja menari di Istana Gadis ini.
Dialogue: 0,0:18:23.08,0:18:24.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:18:24.43,0:18:27.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk sementara,\Nkita berhasil menghindari hukuman.
Dialogue: 0,0:18:29.86,0:18:35.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sungguh beruntung karena pernah\Ndiajari tarian berputar oleh Leelee.
Dialogue: 0,0:18:36.06,0:18:38.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi tarian itu memang\Nsudah lama sekali kuimpikan.
Dialogue: 0,0:18:38.86,0:18:40.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:18:41.00,0:18:46.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau membawakan tarian berputar\Nyang bahkan konon sulit dilakukan
Dialogue: 0,0:18:46.00,0:18:48.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}oleh gadis penari profesional sekalipun?
Dialogue: 0,0:18:48.76,0:18:52.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena aku memohon bimbingan\Ndari dayangku yang sangat hebat.
Dialogue: 0,0:18:53.15,0:18:58.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat didikan yang sangat baik\Ndari mendiang ibundanya,
Dialogue: 0,0:18:58.10,0:19:00.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dayangku ini juga sangat mahir\Nmembawakan tarian berputar.
Dialogue: 0,0:19:02.91,0:19:05.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Dia menangis?
Dialogue: 0,0:19:05.16,0:19:07.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melakukan kesalahan, ya?
Dialogue: 0,0:19:07.16,0:19:10.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, rupanya karena hal itu.
Dialogue: 0,0:19:11.67,0:19:13.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tarianmu tadi sungguh luar biasa.
Dialogue: 0,0:19:15.66,0:19:17.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:19:22.56,0:19:25.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, karena aku sudah selesaikan\Ntarian suci ini dengan selamat,
Dialogue: 0,0:19:25.98,0:19:27.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mari kembali\Nke pembicaraan kita yang tadi...
Dialogue: 0,0:19:27.98,0:19:29.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar!
Dialogue: 0,0:19:29.26,0:19:32.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum ada satu pun dari kami\Nyang beri hadiah penghargaan, lo.
Dialogue: 0,0:19:32.81,0:19:35.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menerima tepuk tangan dari kalian saja
Dialogue: 0,0:19:35.08,0:19:36.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah lebih dari cukup bagiku.
Dialogue: 0,0:19:36.63,0:19:38.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong tunggu dulu!
Dialogue: 0,0:19:38.07,0:19:40.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah tunjukkan tarian\Nyang luar biasa begini pada kami.
Dialogue: 0,0:19:40.81,0:19:44.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izinkan kami wujudkan\Nrasa takjub kami sebagai hadiah.
Dialogue: 0,0:19:44.50,0:19:46.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesenian yang hebat
Dialogue: 0,0:19:46.21,0:19:48.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah sepatutnya\Ndapat pujian dari semua orang.
Dialogue: 0,0:19:50.16,0:19:53.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak peduli meski orang itu\Nadalah Shu Keigetsu.
Dialogue: 0,0:19:53.42,0:19:55.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shu Keigetsu.
Dialogue: 0,0:19:56.10,0:19:57.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:19:57.42,0:20:00.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tarian yang jauh lebih memukau\Ndari tarian mana pun sebelumnya,
Dialogue: 0,0:20:00.43,0:20:03.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tarian yang benar-benar\Nmemancarkan keindahan dewi kesuburan.
Dialogue: 0,0:20:03.93,0:20:06.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan sebongkah kristal\Nberhias emas murni pun
Dialogue: 0,0:20:06.31,0:20:09.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rasanya masih belum cukup pantas\Nuntuk memuji tarianmu.
Dialogue: 0,0:20:09.93,0:20:12.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menyiapkannya nanti,
Dialogue: 0,0:20:12.36,0:20:14.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi untuk sekarang, terimalah benda ini.
Dialogue: 0,0:20:15.44,0:20:18.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pangeran memberikan\Nbarang milik pribadinya sendiri?
Dialogue: 0,0:20:18.30,0:20:19.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:20:19.19,0:20:21.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan salah paham.
Dialogue: 0,0:20:21.40,0:20:23.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan hadiah untuk dirimu sendiri,
Dialogue: 0,0:20:23.58,0:20:26.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}melainkan murni penghargaan\Natas tarianmu tadi.
Dialogue: 0,0:20:27.83,0:20:30.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:20:30.08,0:20:33.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa tersanjung hingga\Nserasa terbang atas kebaikanmu, Pangeran.
Dialogue: 0,0:20:33.37,0:20:36.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuterima dengan penuh rasa syukur\Ndan akan berusaha lebih keras lagi.
Dialogue: 0,0:20:38.34,0:20:39.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leelee.
Dialogue: 0,0:20:39.47,0:20:40.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:20:41.30,0:20:43.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, Nona Seika...
Dialogue: 0,0:20:44.03,0:20:46.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita bahas soal tuduhan
Dialogue: 0,0:20:46.36,0:20:48.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tunggu sebentar, kau ini...\N- pencurian orang berbaju putih gading itu...
Dialogue: 0,0:20:48.85,0:20:50.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:20:50.04,0:20:50.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain masalah kali ini,
Dialogue: 0,0:20:50.72,0:20:52.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Beraninya dia, padahal Pangeran Mahkota...\N- sebenarnya ada hal lain
Dialogue: 0,0:20:52.36,0:20:55.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Benda itu bukan kipas murahan hadiah partisipasi upacara, tahu!\N- yang sudah tak bisa kutoleransi.
Dialogue: 0,0:20:55.48,0:20:56.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula,
Dialogue: 0,0:20:56.30,0:20:59.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tidak, tunggu. Maksudku...\N- Nona Seika, sejauh mana kau mengawasi
Dialogue: 0,0:20:59.63,0:21:00.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tahu gerak-gerik dayangmu?
Dialogue: 0,0:21:00.73,0:21:04.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu, bisa kau menjauh\Nsedikit dariku?!
Dialogue: 0,0:21:04.61,0:21:07.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, harusnya kau itu\Nmerasa lebih gembira, tahu!
Dialogue: 0,0:21:07.56,0:21:09.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sikapmu bisa dianggap tak sopan\Npada Pangeran!
Dialogue: 0,0:21:09.37,0:21:14.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sedang bicara soal tindakan tidak sopan\Nyang terjadi jauh sebelum itu.
Dialogue: 0,0:21:14.37,0:21:16.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengarkan baik-baik, Nona Seika.
Dialogue: 0,0:21:16.51,0:21:20.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masalah ini harus diselesaikan\Ndengan tuntas terlebih dahulu.
Dialogue: 0,0:21:20.13,0:21:21.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kita sudah berjanji tadi?
Dialogue: 0,0:21:21.88,0:21:25.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku telah penuhi bagianku\Ndengan mengikuti aturan main dengan benar.
Dialogue: 0,0:21:25.31,0:21:28.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, sekarang giliran Nona Seika\Nyang harus patuhi aturan main dengan benar.
Dialogue: 0,0:21:28.35,0:21:32.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak berniat membiarkan masalah ini\Nberlalu begitu saja, 'kan?
Dialogue: 0,0:21:32.14,0:21:35.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, sudahlah, aku mengerti!\NAku mengerti, tahu!
Dialogue: 0,0:21:35.39,0:21:40.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal ucapan yang dilontarkan\Ndayangku barusan, aku minta maaf.
Dialogue: 0,0:21:42.15,0:21:48.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dayang pendampingmu itu wanita luar biasa\Nyang dianugerahi paras dan bakat memukau.
Dialogue: 0,0:21:50.60,0:21:52.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa sekarang sudah cukup bagimu?
Dialogue: 0,0:21:52.20,0:21:53.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:21:53.66,0:21:57.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, bisakah kau panggil\NNona Gayou yang berbaju putih gading itu
Dialogue: 0,0:21:57.81,0:22:00.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk datang ke sini juga?
Dialogue: 0,0:22:01.06,0:22:02.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gayou?
Dialogue: 0,0:22:07.23,0:22:09.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di antara para dayang berbaju putih gading,
Dialogue: 0,0:22:09.08,0:22:12.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sama sekali tak ada orang bernama Gayou, lo.
Dialogue: 0,0:22:12.68,0:22:13.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:22:16.96,0:22:18.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya ini?
