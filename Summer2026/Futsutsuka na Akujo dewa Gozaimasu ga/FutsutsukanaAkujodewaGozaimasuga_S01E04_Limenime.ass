Dialogue: 0,0:00:13.13,0:00:14.05,sign,,0000,0000,0000,,GADIS KLAN KOU, KOU REIRIN (JIWA KEIGETSU)
Dialogue: 0,0:02:52.25,0:02:53.42,sign,,0000,0000,0000,,GADIS KLAN SHU, SHU KEIGETSU (JIWA REIRIN)
Dialogue: 0,0:02:59.67,0:03:00.67,sign,,0000,0000,0000,,DAYANG KLAN SHU, LEELEE
Dialogue: 0,0:04:16.79,0:04:17.79,sign,,0000,0000,0000,,PERMAISURI, KOU KENSHUU
Dialogue: 0,0:04:19.71,0:04:21.96,sign,,0000,0000,0000,,KEBERANIAN
Dialogue: 0,0:13:11.08,0:13:12.08,sign,,0000,0000,0000,,KAPTEN MATA ELANG, SHIN-U
Dialogue: 0,0:20:33.44,0:20:36.36,sign,,0000,0000,0000,,FESTIVAL HANTU
Dialogue: 0,0:20:46.70,0:20:47.62,sign,,0000,0000,0000,,GADIS KLAN KIN, KIN SEIKA
Dialogue: 0,0:20:50.99,0:20:51.91,sign,,0000,0000,0000,,GADIS KLAN GEN, GEN KASUI
Dialogue: 0,0:20:53.66,0:20:54.41,sign,,0000,0000,0000,,GADIS KLAN RAN, RAN HOUSHUN
Dialogue: 0,0:00:14.05,0:00:16.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Sulit… bernapas.{\i0}
Dialogue: 0,0:00:17.51,0:00:20.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demamnya tidak terlalu tinggi.
Dialogue: 0,0:00:21.22,0:00:24.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Reirin,\Nkau merasa lebih buruk dari biasanya?
Dialogue: 0,0:00:25.40,0:00:31.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Maksudmu dia bisa bersikap normal\Nsaat demam setinggi ini?{\i0}
Dialogue: 0,0:00:33.74,0:00:37.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kou Reirin tidak pernah absen dari ritual.{\i0}
Dialogue: 0,0:00:37.66,0:00:41.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bahkan Selir Agung Shu, yang memujinya,{\i0}
Dialogue: 0,0:00:41.24,0:00:43.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tidak pernah bilang kalau dia selemah ini.{\i0}
Dialogue: 0,0:00:45.83,0:00:47.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obat.
Dialogue: 0,0:00:48.54,0:00:50.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang mana obatnya?
Dialogue: 0,0:00:52.92,0:00:54.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang mana?
Dialogue: 0,0:00:55.97,0:00:57.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obat!
Dialogue: 0,0:01:03.35,0:01:04.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini tidak masuk akal.{\i0}
Dialogue: 0,0:01:06.23,0:01:10.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bahkan setelah bertukar tubuh,\Nkenapa aku merasa sengsara?{\i0}
Dialogue: 0,0:01:12.07,0:01:13.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong aku.
Dialogue: 0,0:01:14.28,0:01:19.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau harus menolongku, Kou Reirin!
Dialogue: 0,0:02:53.42,0:02:55.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leelee terlambat.
Dialogue: 0,0:02:56.25,0:02:59.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengembalikan jepit rambut ini\Npada Nyonya Gayou.
Dialogue: 0,0:03:00.68,0:03:02.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tidak, Leelee.\N- Apa?
Dialogue: 0,0:03:02.43,0:03:05.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menyelesaikan perselisihan ini.
Dialogue: 0,0:03:05.81,0:03:08.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Biarkan aku yang pergi!
Dialogue: 0,0:03:08.06,0:03:11.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, ekspresimu sangat menakutkan,
Dialogue: 0,0:03:11.02,0:03:13.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seperti saat membantai hama di gudang!
Dialogue: 0,0:03:13.23,0:03:14.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:03:15.23,0:03:16.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu…
Dialogue: 0,0:03:17.98,0:03:20.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai nanti.
Dialogue: 0,0:03:23.32,0:03:24.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jaga dirimu.
Dialogue: 0,0:03:26.20,0:03:31.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, Nyonya Seika dari Klan Kin\Nmenyuruhku dirundung?{\i0}
Dialogue: 0,0:03:32.25,0:03:36.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kukira dia orang yang teguh\Ndan berprinsip.{\i0}
Dialogue: 0,0:03:36.88,0:03:40.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku sangat ingin menjadi bugar,{\i0}
Dialogue: 0,0:03:40.63,0:03:45.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}sampai mungkin tidak bisa berinteraksi\Ndengan semua orang.{\i0}
Dialogue: 0,0:03:46.64,0:03:50.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Di sisi lain, di tubuh Nyonya Keigetsu,{\i0}
Dialogue: 0,0:03:50.14,0:03:52.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}meski tidak fokus, aku tidak pingsan.{\i0}
Dialogue: 0,0:03:53.39,0:03:55.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tidak kehabisan napas\Nkarena bersemangat.{\i0}
Dialogue: 0,0:03:56.65,0:03:59.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku iri karena tubuhnya sangat sehat.{\i0}
Dialogue: 0,0:04:00.19,0:04:01.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini gawat!{\i0}
Dialogue: 0,0:04:01.53,0:04:06.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalau Yang Mulia Permaisuri\Nmelihatku begini, dia pasti terkejut.{\i0}
Dialogue: 0,0:04:07.28,0:04:12.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hari pertama masuk ke Istana Para Gadis,\Naku selalu mengingat pesannya.{\i0}
Dialogue: 0,0:04:12.33,0:04:14.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reirin.
Dialogue: 0,0:04:14.12,0:04:16.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya satu yang kucari dari seorang Gadis.
Dialogue: 0,0:04:17.79,0:04:19.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingat selalu pesanku ini.
Dialogue: 0,0:04:21.97,0:04:28.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Yang Mulia memilihku sebagai Gadis\Nhanya karena aku punya keberanian.{\i0}
Dialogue: 0,0:04:28.76,0:04:30.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tidak boleh goyah.{\i0}
Dialogue: 0,0:04:30.85,0:04:33.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini tubuh Nyonya Keigetsu.{\i0}
Dialogue: 0,0:04:33.52,0:04:37.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pada akhirnya, aku masih Kou Reirin.{\i0}
Dialogue: 0,0:04:37.15,0:04:38.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kou Reirin!{\i0}
Dialogue: 0,0:04:45.41,0:04:47.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu kau, Nyonya Keigetsu?
Dialogue: 0,0:04:49.62,0:04:51.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:04:52.70,0:04:55.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kau sedang mengalami kesulitan.
Dialogue: 0,0:04:55.58,0:04:59.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demamku sama sekali tidak turun,
Dialogue: 0,0:04:59.04,0:05:01.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan aku tidak bisa bernapas.
Dialogue: 0,0:05:01.96,0:05:04.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat lakukan sesuatu!
Dialogue: 0,0:05:04.17,0:05:05.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa bernapas.
Dialogue: 0,0:05:05.72,0:05:07.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa sulit bernapas?
Dialogue: 0,0:05:07.68,0:05:10.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kubilang tidak bisa, ya tidak bisa!
Dialogue: 0,0:05:11.68,0:05:14.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terus mencoba menarik napas,\Ntapi masih sakit.
Dialogue: 0,0:05:15.18,0:05:18.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti mengalami hiperventilasi.
Dialogue: 0,0:05:18.60,0:05:20.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan baik-baik saja, Nyonya Keigetsu.
Dialogue: 0,0:05:20.61,0:05:22.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak mengembuskan napas dengan benar.
Dialogue: 0,0:05:22.94,0:05:25.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mengembuskan napas dengan benar?
Dialogue: 0,0:05:25.28,0:05:27.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bilang\Ntidak bisa bernapas, 'kan?
Dialogue: 0,0:05:27.45,0:05:32.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuhmu tidak sadar kalau kau\Nmengembuskan napas dengan benar.
Dialogue: 0,0:05:32.04,0:05:35.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Keigetsu,\Ntutup mulutmu dengan kedua tangan.
Dialogue: 0,0:05:35.20,0:05:38.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku kesakitan,\Ndan kau ingin aku menutup mulutku?
Dialogue: 0,0:05:38.58,0:05:41.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baik-baik saja.\NLagi pula, bisa bicara sebanyak ini.
Dialogue: 0,0:05:41.88,0:05:44.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, tutup mulutmu.
Dialogue: 0,0:05:47.22,0:05:52.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar. Sampai aku bilang selesai,\Nterus embuskan napas.
Dialogue: 0,0:05:53.22,0:05:54.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlahan.
Dialogue: 0,0:05:56.06,0:05:57.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buang napas.
Dialogue: 0,0:05:58.56,0:05:59.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua baik-baik saja.
Dialogue: 0,0:06:02.07,0:06:03.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:06:03.57,0:06:05.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, tarik napas.
Dialogue: 0,0:06:06.44,0:06:08.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlahan, buang napas lagi.
Dialogue: 0,0:06:11.41,0:06:13.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah tenang?
Dialogue: 0,0:06:14.20,0:06:17.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika sudah, campurkan\Nobat nomor sembilan dan 15
Dialogue: 0,0:06:17.16,0:06:21.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di bagian kiri atas lemari obat\Ndan hiruplah nanti.
Dialogue: 0,0:06:23.67,0:06:26.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuh macam apa yang kau miliki?
Dialogue: 0,0:06:26.51,0:06:27.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:06:27.51,0:06:29.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini mustahil.
Dialogue: 0,0:06:29.01,0:06:32.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sangat lemah.\NSedikit pun tidak pernah sehat.
Dialogue: 0,0:06:32.55,0:06:34.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak masuk akal!
Dialogue: 0,0:06:34.01,0:06:36.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sungguh minta maaf.
Dialogue: 0,0:06:36.68,0:06:41.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kehidupanku sehari-hari,\Njadi aku sudah terbiasa.
Dialogue: 0,0:06:43.90,0:06:44.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini saja,
Dialogue: 0,0:06:44.90,0:06:48.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagaimana jika kita batalkan\Npertukarannya sekarang?
Dialogue: 0,0:06:49.36,0:06:55.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa tidak enak merepotkanmu\Ndengan tubuh itu, Nyonya Keigetsu.
Dialogue: 0,0:06:57.16,0:06:59.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti bercanda.
Dialogue: 0,0:06:59.12,0:07:02.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau pura-pura baik\Nuntuk mendapatkan keuntungan?
Dialogue: 0,0:07:02.75,0:07:04.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan itu maksudku.
Dialogue: 0,0:07:04.25,0:07:08.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru bisa menikmati\Nsituasi yang memuaskan ini sekarang.
Dialogue: 0,0:07:08.38,0:07:13.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Situasi di mana semua orang melayaniku\Nadalah yang terbaik.
Dialogue: 0,0:07:13.85,0:07:19.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan Kin Seika yang sombong itu membawa\Npembakar dupa sebagai hadiah cepat sembuh.
Dialogue: 0,0:07:19.48,0:07:22.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Seika melakukan itu?
Dialogue: 0,0:07:22.52,0:07:27.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kau harus hati-hati\Ndengan barang itu.
Dialogue: 0,0:07:28.28,0:07:29.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau iri?
Dialogue: 0,0:07:29.94,0:07:31.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan itu.
Dialogue: 0,0:07:31.74,0:07:36.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau boleh iri padaku\Nyang sekarang seperti ini.
Dialogue: 0,0:07:36.37,0:07:40.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai Shu Keigetsu si Tikus Got\Ntanpa kecantikan atau bakat,
Dialogue: 0,0:07:40.29,0:07:42.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang tak diperhatikan siapa pun.
Dialogue: 0,0:07:42.33,0:07:45.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak perlu mengatakan\Nkau punya banyak kekurangan.
Dialogue: 0,0:07:45.63,0:07:50.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Keigetsu,\Nkau punya tubuh yang sehat.
Dialogue: 0,0:07:50.34,0:07:52.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa gunanya itu?
Dialogue: 0,0:07:52.72,0:07:57.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuh itu tidak memiliki bakat\Nyang diperlukan sebagai seorang putri.
Dialogue: 0,0:07:57.64,0:08:00.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kecantikan, keberuntungan,\Npria yang membisikkan cintanya,
Dialogue: 0,0:08:00.64,0:08:02.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}teman yang bisa dipercaya,
Dialogue: 0,0:08:02.02,0:08:04.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}orang tua yang melindungi.
Dialogue: 0,0:08:05.19,0:08:06.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Benar.
Dialogue: 0,0:08:06.94,0:08:12.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Orang tuaku tidak memberikan apa pun\Nyang berguna bagiku.
Dialogue: 0,0:08:12.65,0:08:17.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, mereka memberimu nama yang indah.
Dialogue: 0,0:08:18.08,0:08:19.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:08:19.12,0:08:22.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Keigetsu, apa harapanmu
Dialogue: 0,0:08:22.33,0:08:24.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di Festival Angka Tujuh Ganda?
Dialogue: 0,0:08:24.33,0:08:25.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:08:25.67,0:08:28.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku membuat dua permintaan.
Dialogue: 0,0:08:28.88,0:08:33.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pertama, tentu saja, agar aku bisa sehat.{\i0}
Dialogue: 0,0:08:34.18,0:08:38.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku mengharapkan itu setiap hari.{\i0}
Dialogue: 0,0:08:39.43,0:08:40.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:08:40.93,0:08:45.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, dulu aku tidak percaya\Ndengan membuat permohonan.
Dialogue: 0,0:08:46.44,0:08:50.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, setelah bertukar tubuh\Ndan jadi sehat, aku berpikir,
Dialogue: 0,0:08:51.23,0:08:57.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin komet itu benar-benar\Npunya kekuatan untuk mewujudkan keajaiban.
Dialogue: 0,0:08:57.03,0:09:01.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa hubungannya itu dengan namaku?
Dialogue: 0,0:09:02.12,0:09:06.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karakter yang digunakan untuk "Kei"\Ndalam namamu, Nyonya Keigetsu,
Dialogue: 0,0:09:06.29,0:09:11.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah bagian pertama dari kata "komet"\Ndigabung dengan karakter "hati".
Dialogue: 0,0:09:11.38,0:09:13.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama yang megah dan indah.
Dialogue: 0,0:09:15.17,0:09:18.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku merasa berterima kasih kepadamu.
Dialogue: 0,0:09:22.81,0:09:24.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya kau adalah…
Dialogue: 0,0:09:25.81,0:09:28.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}komet ajaibku.
Dialogue: 0,0:09:30.90,0:09:33.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa…
Dialogue: 0,0:09:35.07,0:09:36.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau katakan?
Dialogue: 0,0:09:36.49,0:09:37.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar bodoh!
Dialogue: 0,0:09:37.91,0:09:39.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bilang aku seperti bintang.
Dialogue: 0,0:09:40.66,0:09:42.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Keigetsu,
Dialogue: 0,0:09:42.24,0:09:45.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisakah kita bertemu langsung\Ndan berbincang?
Dialogue: 0,0:09:45.33,0:09:49.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kau bilang tidak adil karena aku\Nyang mendapat semua restu,{\i0}
Dialogue: 0,0:09:49.46,0:09:52.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan kita bertukar tubuh\Nuntuk memperbaiki keadaan.{\i0}
Dialogue: 0,0:09:52.71,0:09:58.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, aku hanya bersenang-senang\Nsetelah pertukaran itu.{\i0}
Dialogue: 0,0:10:00.85,0:10:06.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kita bisa mengobrol,\Naku yakin angin baru akan berembus.
Dialogue: 0,0:10:09.40,0:10:10.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau.
Dialogue: 0,0:10:10.61,0:10:16.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah kondisi fisikku pulih,\Naku tak membutuhkanmu lagi.
Dialogue: 0,0:10:16.44,0:10:17.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Keigetsu.
Dialogue: 0,0:10:18.11,0:10:22.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersenang-senang sebagai Shu Keigetsu?
Dialogue: 0,0:10:22.16,0:10:25.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tunggu berapa lama lagi\Nkau bisa berkata begitu.
Dialogue: 0,0:10:25.83,0:10:28.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Keigetsu, tunggu dulu…
Dialogue: 0,0:10:33.67,0:10:34.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Keigetsu!
Dialogue: 0,0:10:36.13,0:10:37.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leelee.
Dialogue: 0,0:10:37.42,0:10:39.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tadi menungguku?
Dialogue: 0,0:10:39.63,0:10:40.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:10:40.89,0:10:42.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu aku sudah kembali
Dialogue: 0,0:10:42.89,0:10:44.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan memadamkan apinya, 'kan?
Dialogue: 0,0:10:44.76,0:10:46.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu jelas sekali.
Dialogue: 0,0:10:49.48,0:10:51.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang kembali.
Dialogue: 0,0:10:52.52,0:10:53.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enaknya!
Dialogue: 0,0:10:56.53,0:10:59.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jepit rambutnya sudah dikembalikan?
Dialogue: 0,0:10:59.90,0:11:04.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, aku sudah lama menunggu,\Ntapi dia tak kunjung muncul.
Dialogue: 0,0:11:05.58,0:11:07.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dia sudah bersiap
Dialogue: 0,0:11:07.37,0:11:10.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk membawaku\Nke hadapan Kapten Mata Elang.
Dialogue: 0,0:11:10.41,0:11:14.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika begitu, mereka pasti\Nsudah datang untuk menangkapmu.
Dialogue: 0,0:11:14.67,0:11:16.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu belum terjadi,
Dialogue: 0,0:11:16.38,0:11:20.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berarti pihak lain memutuskan bahwa\Nberbahaya jika terus berurusan denganmu
Dialogue: 0,0:11:20.93,0:11:22.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan memutuskan mundur.
Dialogue: 0,0:11:22.43,0:11:24.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, anggap saja begitu.
Dialogue: 0,0:11:24.89,0:11:27.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga akan sepenuhnya…
Dialogue: 0,0:11:27.72,0:11:30.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa yang kau bicarakan?\N- Apa?
Dialogue: 0,0:11:30.81,0:11:35.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu berarti dendam yang tak selesai\Ndi antara dayang istana.
Dialogue: 0,0:11:35.06,0:11:38.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya, majikan mereka,\Nyaitu aku dan Nyonya Seika
Dialogue: 0,0:11:38.90,0:11:41.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang harus menyelesaikan semuanya, 'kan?
Dialogue: 0,0:11:41.74,0:11:42.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:11:42.86,0:11:45.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan tiga hari lagi\Nada Festival Hantu.
Dialogue: 0,0:11:45.87,0:11:47.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, tapi…
Dialogue: 0,0:11:47.20,0:11:51.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kita ikut ritual,\Nkita bisa bertemu Nyonya Seika.
Dialogue: 0,0:11:51.16,0:11:55.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, Selir Agung Shu bilang\Nkau tidak perlu ikut.
Dialogue: 0,0:11:55.00,0:11:59.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku "tidak perlu" ikut,\Nartinya aku juga bisa ikut.
Dialogue: 0,0:11:59.42,0:12:00.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:12:00.55,0:12:03.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, Nyonya Keigetsu,\Ndengan keadaanmu saat ini,
Dialogue: 0,0:12:03.05,0:12:05.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}para dayang istana\Nakan menolak menemanimu.
Dialogue: 0,0:12:05.80,0:12:07.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seorang Gadis tanpa pendamping…
Dialogue: 0,0:12:07.85,0:12:11.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika punya tiga hari, aku bisa menjahit\Npakaian merah menyala yang indah,
Dialogue: 0,0:12:11.39,0:12:12.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi tenang saja.
Dialogue: 0,0:12:13.06,0:12:15.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, 'kan, Dayang Istana Atas, Leelee?
Dialogue: 0,0:12:15.81,0:12:18.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dayang Istana Atas?
Dialogue: 0,0:12:19.44,0:12:21.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, ritual Festival Hantu
Dialogue: 0,0:12:21.69,0:12:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengharapkan panen melimpah\Ndan menampilkan tarian.
Dialogue: 0,0:12:25.20,0:12:29.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur, Nyonya Keigetsu,\Nkau tidak berbakat menari.
Dialogue: 0,0:12:29.66,0:12:31.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Leelee.\N- Apa?
Dialogue: 0,0:12:31.83,0:12:35.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku tidak bisa membalas mereka
Dialogue: 0,0:12:35.12,0:12:38.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang merusak kesehatan mental\Ndayang kesayanganku,
Dialogue: 0,0:12:38.38,0:12:40.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku takkan merasa puas\Nsebagai seorang Gadis.
Dialogue: 0,0:12:43.09,0:12:45.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, terserah kau saja.
Dialogue: 0,0:12:45.13,0:12:47.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan masalahku jika kau menyesal.
Dialogue: 0,0:12:47.55,0:12:52.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini kita harus berpegangan tangan\Ndan berteriak "hip hip hura", 'kan?
Dialogue: 0,0:12:52.73,0:12:54.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat apa begitu selarut ini?
Dialogue: 0,0:12:55.64,0:12:56.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dasar.{\i0}
Dialogue: 0,0:12:56.94,0:12:59.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Membalas dendam untuk dayang istana?{\i0}
Dialogue: 0,0:12:59.82,0:13:00.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sebenarnya…{\i0}
Dialogue: 0,0:13:02.19,0:13:04.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}kau ini siapa?{\i0}
Dialogue: 0,0:13:07.32,0:13:09.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah ini, kita bisa beristirahat.
Dialogue: 0,0:13:09.78,0:13:11.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:13:12.08,0:13:15.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia. Soal pertumpahan darah\Noleh dayang di Istana Shu…
Dialogue: 0,0:13:15.46,0:13:18.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.\NAku sudah membaca laporannya.
Dialogue: 0,0:13:18.71,0:13:22.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shu Keigetsu melindungi dayang istana\Ndan mengabaikan masalah itu, 'kan?
Dialogue: 0,0:13:23.46,0:13:24.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:13:25.22,0:13:26.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:13:26.88,0:13:30.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu, Shu Keigetsu memang jahat,
Dialogue: 0,0:13:30.47,0:13:33.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi dia berusaha berubah sekarang.
Dialogue: 0,0:13:33.72,0:13:35.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya, itu yang kurasakan.
Dialogue: 0,0:13:35.81,0:13:38.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika benar, itu bagus.
Dialogue: 0,0:13:39.23,0:13:43.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, mungkin dia meniru Reirin\Ndan pura-pura penuh belas kasihan.
Dialogue: 0,0:13:45.78,0:13:48.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bilang padanya,\Nkalau dia meniru Reirin lagi,
Dialogue: 0,0:13:48.74,0:13:51.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan memenggal kepalanya.
Dialogue: 0,0:13:56.41,0:13:57.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah.
Dialogue: 0,0:13:58.37,0:14:01.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita memang harus mematuhi\Nkeputusan Penghakiman Singa,
Dialogue: 0,0:14:01.92,0:14:04.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi melihat Reirin\Nyang makin lemah sejak saat itu,
Dialogue: 0,0:14:04.80,0:14:08.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rasanya amarahku\Npada Shu Keigetsu muncul kembali.
Dialogue: 0,0:14:08.68,0:14:12.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melihat betapa putus asanya\NReirin sekarang…
Dialogue: 0,0:14:13.39,0:14:14.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membuatku takut.
Dialogue: 0,0:14:15.85,0:14:19.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sama seperti saat dia menghilang\Ndari susuran tangga malam itu…{\i0}
Dialogue: 0,0:14:20.06,0:14:21.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sekali lagi.
Dialogue: 0,0:14:39.83,0:14:41.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aneh sekali.{\i0}
Dialogue: 0,0:14:42.13,0:14:44.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kenapa dia terlihat begitu cantik?{\i0}
Dialogue: 0,0:14:46.26,0:14:47.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:14:47.34,0:14:49.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leelee. Selamat pagi.
Dialogue: 0,0:14:49.59,0:14:52.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku membangunkanmu?
Dialogue: 0,0:14:52.22,0:14:56.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak. Mana ada dayang\Nyang mengabaikan majikannya
Dialogue: 0,0:14:56.35,0:14:58.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan terus tidur sesuka hati?
Dialogue: 0,0:14:58.60,0:14:59.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:15:00.48,0:15:02.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah selesai?
Dialogue: 0,0:15:03.48,0:15:06.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menjahit\Nsemua bagian yang robek.
Dialogue: 0,0:15:06.36,0:15:08.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam waktu sesingkat ini?
Dialogue: 0,0:15:09.19,0:15:13.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau mencuri pakaian baru\Ndari kamar dayang Istana Atas?
Dialogue: 0,0:15:13.37,0:15:15.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leelee.
Dialogue: 0,0:15:15.49,0:15:17.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya menjahitnya satu demi satu.
Dialogue: 0,0:15:17.91,0:15:20.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin\Nmelakukannya dalam beberapa jam!
Dialogue: 0,0:15:20.12,0:15:25.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku sangat senang akhirnya ada\Nyang bisa kuberikan kepadamu.
Dialogue: 0,0:15:25.50,0:15:30.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa menahan rasa gembiraku\Ndan bangun sedikit lebih awal darimu.
Dialogue: 0,0:15:30.26,0:15:33.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, kau bangun pukul berapa?
Dialogue: 0,0:15:35.39,0:15:38.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat malam berubah menjadi pagi.
Dialogue: 0,0:15:38.93,0:15:42.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betapa mistisnya saat tanah\Nberubah menjadi biru pucat
Dialogue: 0,0:15:42.90,0:15:45.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membuka selubung malam yang panjang,
Dialogue: 0,0:15:45.23,0:15:48.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mencoba melompat\Nke dunia penuh cahaya.
Dialogue: 0,0:15:48.07,0:15:52.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betapa murninya,\Nseperti mata bayi yang pucat.
Dialogue: 0,0:15:52.03,0:15:54.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu, kau bergadang?
Dialogue: 0,0:15:54.24,0:15:58.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis mana yang bergadang\Ndemi memperbaiki barang milik dayang?
Dialogue: 0,0:15:58.74,0:16:01.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tunggu…\N- Warnanya sempurna!
Dialogue: 0,0:16:01.75,0:16:04.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rambutmu yang cerah\Nserasi dengan merah menyala ini.
Dialogue: 0,0:16:04.71,0:16:06.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menakjubkan.
Dialogue: 0,0:16:06.17,0:16:09.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa ditemani dayang istana yang cantik
Dialogue: 0,0:16:09.59,0:16:11.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membuatku merasa sangat bangga.
Dialogue: 0,0:16:12.68,0:16:14.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong hentikan.
Dialogue: 0,0:16:14.59,0:16:17.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat memahami watakku sendiri.
Dialogue: 0,0:16:17.68,0:16:18.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leelee?
Dialogue: 0,0:16:18.68,0:16:22.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Bahkan saat akan menemui\NNyonya Gayou kemarin,
Dialogue: 0,0:16:22.60,0:16:24.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}dayang merah menyala itu berkata…
Dialogue: 0,0:16:24.35,0:16:29.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tikus Merah menyedihkan, kau mau ke mana?
Dialogue: 0,0:16:29.07,0:16:31.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kotor sekali!
Dialogue: 0,0:16:32.78,0:16:35.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku pelototi mereka sebagai balasannya!{\i0}
Dialogue: 0,0:16:35.82,0:16:39.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya aku tidak bersemangat,
Dialogue: 0,0:16:39.74,0:16:42.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi memakai\Npakaian merah menyala sekarang…
Dialogue: 0,0:16:43.12,0:16:48.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak pernah belajar tata krama\Ndayang Istana Atas.
Dialogue: 0,0:16:50.09,0:16:54.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau merespons mereka dengan baik, 'kan?
Dialogue: 0,0:16:55.26,0:16:56.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Ya.
Dialogue: 0,0:16:56.89,0:17:00.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bahkan berdecak pada mereka,\Ndan mereka kabur.
Dialogue: 0,0:17:00.26,0:17:04.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, itu sebabnya aku tak tahu\Napa merah menyala cocok untukku.
Dialogue: 0,0:17:04.81,0:17:05.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:17:08.61,0:17:09.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia marah?{\i0}
Dialogue: 0,0:17:11.86,0:17:13.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu…
Dialogue: 0,0:17:14.03,0:17:16.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan pakai benang berwarna
Dialogue: 0,0:17:16.24,0:17:20.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menyulam\Npakaian merah menyala paling mewah!
Dialogue: 0,0:17:20.16,0:17:21.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, ya!
Dialogue: 0,0:17:21.66,0:17:22.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:17:22.79,0:17:25.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dipikir-pikir, aku bodoh sekali
Dialogue: 0,0:17:25.79,0:17:30.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena menjahit pakaian biasa\Nuntuk momen sepenting itu.
Dialogue: 0,0:17:30.42,0:17:31.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:17:31.42,0:17:32.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk upacara formal,
Dialogue: 0,0:17:32.96,0:17:36.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dayang istana juga diizinkan\Nmemakai pakaian dengan sulaman.
Dialogue: 0,0:17:36.09,0:17:40.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya, tidak ada alasan\Nuntuk tidak berdandan total, 'kan?
Dialogue: 0,0:17:40.18,0:17:41.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tunggu.
Dialogue: 0,0:17:41.35,0:17:46.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru bilang tidak cocok\Nmemakai pakaian merah menyala.
Dialogue: 0,0:17:46.31,0:17:49.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Dengan kata lain, cepat atau lambat
Dialogue: 0,0:17:49.35,0:17:52.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau ingin jadi wanita\Nyang cocok memakainya.
Dialogue: 0,0:17:52.15,0:17:53.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu indah sekali!
Dialogue: 0,0:17:53.86,0:17:57.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leelee, aku tidak tahu kau\Npunya aspirasi setinggi itu!
Dialogue: 0,0:17:57.65,0:17:59.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak punya aspirasi seperti itu.
Dialogue: 0,0:17:59.74,0:18:00.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun!
Dialogue: 0,0:18:00.74,0:18:01.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka padamu!
Dialogue: 0,0:18:02.41,0:18:03.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keberanian itu.
Dialogue: 0,0:18:03.91,0:18:05.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inspirasi tak berujung itu.
Dialogue: 0,0:18:05.54,0:18:09.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jiwamu cocok menjadi dayang Istana Atas!
Dialogue: 0,0:18:09.75,0:18:10.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku…
Dialogue: 0,0:18:10.96,0:18:12.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita sama-sama berusaha.
Dialogue: 0,0:18:12.84,0:18:15.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mendukungmu sekuat tenaga.
Dialogue: 0,0:18:15.09,0:18:16.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu…
Dialogue: 0,0:18:16.09,0:18:18.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, kita harus perbaiki posturmu.
Dialogue: 0,0:18:18.93,0:18:20.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Latihan meningkatkan kekuatan otot
Dialogue: 0,0:18:20.64,0:18:22.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selama 15 menit, pagi dan malam.
Dialogue: 0,0:18:22.35,0:18:25.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Untuk pernapasan,\Ndi semua kegiatan kita sehari-hari,{\i0}
Dialogue: 0,0:18:25.97,0:18:28.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}ganti ke pernapasan perut.{\i0}
Dialogue: 0,0:18:28.23,0:18:32.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kemudian menghafal kitab suci,\Nberlatih dengan kuas,{\i0}
Dialogue: 0,0:18:32.36,0:18:34.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan sedikit latihan menyulam.{\i0}
Dialogue: 0,0:18:34.73,0:18:35.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemudian…
Dialogue: 0,0:18:35.86,0:18:39.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa hubungannya semua itu\Ndengan menjadi dayang Istana Atas?
Dialogue: 0,0:18:39.36,0:18:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kau satu-satunya\Ndayang kesayanganku, 'kan?
Dialogue: 0,0:18:46.95,0:18:53.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin kau juga sangat cantik\Nmemakai pakaian emas gamboge.
Dialogue: 0,0:18:54.67,0:18:56.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Emas gamboge?{\i0}
Dialogue: 0,0:18:56.38,0:19:01.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Emas gamboge adalah warna\Nyang dipakai dayang Istana Kou.{\i0}
Dialogue: 0,0:19:02.26,0:19:03.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jangan-jangan…{\i0}
Dialogue: 0,0:19:04.43,0:19:06.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada masalah?
Dialogue: 0,0:19:06.10,0:19:07.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:19:08.10,0:19:10.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa aku salah bicara?{\i0}
Dialogue: 0,0:19:10.94,0:19:15.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dipikir-pikir,\Nbintang ritualnya adalah para Gadis, 'kan?
Dialogue: 0,0:19:15.27,0:19:17.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga harus bersiap.
Dialogue: 0,0:19:17.78,0:19:20.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakaian upacara saja tidak punya.
Dialogue: 0,0:19:20.07,0:19:24.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang, aku akan pakai\Npakaian merah muda pucatmu itu
Dialogue: 0,0:19:24.07,0:19:25.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan diproses sedikit.
Dialogue: 0,0:19:25.53,0:19:27.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bahkan sudah menyiapkan bunga
Dialogue: 0,0:19:27.29,0:19:30.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk diwarnai\Ndan kuas dari potongan rambut kemarin.
Dialogue: 0,0:19:30.71,0:19:33.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau seorang Gadis, tapi terlalu terbiasa\Ndengan gaya hidup ini!
Dialogue: 0,0:19:34.33,0:19:40.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, karena hanya aku\Nyang dirawat dan dibimbing seorang Gadis,
Dialogue: 0,0:19:40.59,0:19:42.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku jadi merasa tidak berguna.
Dialogue: 0,0:19:42.80,0:19:44.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga!
Dialogue: 0,0:19:44.14,0:19:49.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, bisa ajari aku\NPusaran Sogdian sebagai gantinya?
Dialogue: 0,0:19:49.31,0:19:50.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:19:50.31,0:19:54.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin aku bisa\Nmembawakan tarian sesulit itu!
Dialogue: 0,0:19:54.35,0:19:56.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sungguh rendah hati.
Dialogue: 0,0:19:56.23,0:19:58.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibumu ahlinya Pusaran Sogdian,
Dialogue: 0,0:19:58.28,0:20:00.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan kau tumbuh melihatnya, 'kan?{\i0}
Dialogue: 0,0:20:00.78,0:20:03.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalau begitu, kau pasti ingat.{\i0}
Dialogue: 0,0:20:07.78,0:20:10.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tariannya kurang cocok untuk ritual nanti,
Dialogue: 0,0:20:10.75,0:20:13.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku hanya ingin mempelajarinya.
Dialogue: 0,0:20:13.62,0:20:15.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak perlu dianggap serius.
Dialogue: 0,0:20:15.29,0:20:17.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi…
Dialogue: 0,0:20:17.29,0:20:18.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon?
Dialogue: 0,0:20:24.05,0:20:27.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, sedikit saja.
Dialogue: 0,0:20:27.30,0:20:29.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah!
Dialogue: 0,0:20:29.81,0:20:32.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Nayo kita mulai dengan semangat!
Dialogue: 0,0:20:47.62,0:20:49.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Membosankan sekali.{\i0}
Dialogue: 0,0:20:49.16,0:20:50.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tak ada kecantikan bersinar di sini.{\i0}
Dialogue: 0,0:20:51.91,0:20:53.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini sama sekali tidak menarik.{\i0}
Dialogue: 0,0:20:54.41,0:20:58.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Festival Hantu, saat para putri\Nmenampilkan tarian panen melimpah{\i0}
Dialogue: 0,0:20:58.63,0:21:01.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}adalah bagian tugas Klan Kin\Nsebagai pemimpin musim gugur.{\i0}
Dialogue: 0,0:21:01.80,0:21:06.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, persiapan ritualnya terhenti\Nsetelah ritual penyucian{\i0}
Dialogue: 0,0:21:06.72,0:21:09.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}karena Shu Keigetsu.\NSkala ritualnya juga menyusut.{\i0}
Dialogue: 0,0:21:09.81,0:21:15.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apalagi Nyonya Reirin juga tidak bisa\Nmenghadiri ritual ini.{\i0}
Dialogue: 0,0:21:16.10,0:21:20.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Nyonya Reirin yang cantik,\Nkupu-kupu tersayang Yang Mulia.{\i0}
Dialogue: 0,0:21:20.82,0:21:23.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika dia nanti menjadi permaisuri,{\i0}
Dialogue: 0,0:21:23.40,0:21:27.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku ingin membantu Yang Mulia dengannya\Nsebagai selir agung.{\i0}
Dialogue: 0,0:21:27.70,0:21:33.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, sejak Shu Keigetsu mendorongnya,\Ndia terbaring di tempat tidur.{\i0}
Dialogue: 0,0:21:34.45,0:21:37.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hanya tarianku dan Nyonya Reirin{\i0}
Dialogue: 0,0:21:37.67,0:21:40.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}yang layak ditunjukkan\Ndi hadapan Yang Mulia.{\i0}
Dialogue: 0,0:21:41.30,0:21:46.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tarian gadis Gen yang tampak merajuk\Ndan Ran si tupai kecil itu{\i0}
Dialogue: 0,0:21:46.93,0:21:48.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}sama sekali tak bisa mengisi kekosongan.{\i0}
Dialogue: 0,0:21:48.97,0:21:51.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apalagi Shu Keigetsu.{\i0}
Dialogue: 0,0:21:51.85,0:21:54.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Gadis busuk yang tidak berbakat dan bodoh.{\i0}
Dialogue: 0,0:21:54.89,0:21:56.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tidak mengacuhkannya{\i0}
Dialogue: 0,0:21:56.31,0:21:58.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}karena merasa tak elegan\Nmengurusi tikus got.{\i0}
Dialogue: 0,0:21:59.35,0:22:01.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, aku tak tahan lagi.{\i0}
Dialogue: 0,0:22:01.61,0:22:05.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Akan kupastikan dia sangat menderita{\i0}
Dialogue: 0,0:22:05.28,0:22:08.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}hingga menyesal tinggal\Ndi Istana Para Gadis.{\i0}
Dialogue: 0,0:22:08.24,0:22:13.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tunjukkan dirimu, Shu Keigetsu!{\i0}
