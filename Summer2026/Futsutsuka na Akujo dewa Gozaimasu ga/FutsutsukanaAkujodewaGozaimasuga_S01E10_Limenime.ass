Dialogue: 0,0:00:05.71,0:00:08.50,sign,,0000,0000,0000,,{\an8}SEGEL
Dialogue: 0,0:00:08.50,0:00:11.38,sign,,0000,0000,0000,,PUTRA MAHKOTA - EI GYOUMEI
Dialogue: 0,0:00:44.54,0:00:46.88,sign,,0000,0000,0000,,SEGEL
Dialogue: 0,0:01:10.86,0:01:13.86,sign,,0000,0000,0000,,KEPALA DAYANG PRIBADI REIRIN\NKOU TOUSETSU
Dialogue: 0,0:01:18.49,0:01:22.41,sign,,0000,0000,0000,,SEGEL
Dialogue: 0,0:05:06.05,0:05:08.55,sign,,0000,0000,0000,,GADIS KLAN SHU - SHU KEIGETSU\N(JIWA REIRIN)
Dialogue: 0,0:05:21.19,0:05:23.11,sign,,0000,0000,0000,,DAYANG KLAN SHU - LEELEE
Dialogue: 0,0:05:52.51,0:05:53.68,sign,,0000,0000,0000,,KAPTEN MATA ELANG - SHIN-U
Dialogue: 0,0:13:12.50,0:13:15.46,sign,,0000,0000,0000,,{\an8}LABA-LABA YANG MENGUTUK BANGSAWAN\NDI ISTANA KOU
Dialogue: 0,0:17:02.18,0:17:03.18,sign,,0000,0000,0000,,SELIR AGUNG - SHU GABI
Dialogue: 0,0:21:25.57,0:21:28.24,sign,,0000,0000,0000,,PERMAISURI - KOU KENSHUU
Dialogue: 0,0:00:12.42,0:00:13.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggil dukun.
Dialogue: 0,0:00:13.76,0:00:16.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perintahkan lagi agar staf medis bungkam.
Dialogue: 0,0:00:16.51,0:00:17.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:00:17.68,0:00:21.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ungkapkan kondisi medis Permaisuri.
Dialogue: 0,0:00:21.52,0:00:25.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katakan saja dia cukup tenang\Nuntuk menerima kunjunganku.
Dialogue: 0,0:00:25.94,0:00:29.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembalilah ke Istana terlebih dahulu\Nsambil tersenyum.
Dialogue: 0,0:00:29.52,0:00:30.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi…
Dialogue: 0,0:00:30.94,0:00:32.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiga puluh menit.
Dialogue: 0,0:00:32.65,0:00:34.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takkan lebih lama dari itu.
Dialogue: 0,0:00:34.95,0:00:37.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, tolong izinkan aku tetap di sini.
Dialogue: 0,0:00:40.20,0:00:41.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:00:48.29,0:00:49.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buka.
Dialogue: 0,0:00:50.42,0:00:51.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon!
Dialogue: 0,0:00:52.30,0:00:53.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau Yang Mulia Putra Mahkota?
Dialogue: 0,0:00:54.97,0:00:56.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tousetsu?
Dialogue: 0,0:00:56.55,0:00:58.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jimat penyegel telah dipasang\Ndi Istana Kou
Dialogue: 0,0:00:58.43,0:01:00.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk mencegah penyebaran penyakit.
Dialogue: 0,0:01:00.35,0:01:04.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ini masalah mendesak,\Naku akan mendengarnya di sini.
Dialogue: 0,0:01:04.23,0:01:06.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tousetsu, apa Reirin…
Dialogue: 0,0:01:06.98,0:01:09.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, apa Shu Keigetsu datang kemari?
Dialogue: 0,0:01:13.86,0:01:15.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buka gerbangnya, Tousetsu.
Dialogue: 0,0:01:15.99,0:01:18.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau tidak mau mendengarkan\Nperintah putra mahkota?
Dialogue: 0,0:03:02.51,0:03:05.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tousetsu, kau sudah tahu, 'kan?
Dialogue: 0,0:03:07.43,0:03:08.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawab aku, Tousetsu.
Dialogue: 0,0:03:10.02,0:03:11.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa menjawabnya.
Dialogue: 0,0:03:11.44,0:03:12.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:03:19.32,0:03:22.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reirin bertukar tubuh\Ndengan Shu Keigetsu, 'kan?
Dialogue: 0,0:03:23.36,0:03:26.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah wanita itu mengambil tubuhnya?
Dialogue: 0,0:03:26.28,0:03:28.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Majikanmu telah dilecehkan.
Dialogue: 0,0:03:28.95,0:03:31.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau tidak melapor padaku?
Dialogue: 0,0:03:32.92,0:03:36.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melarangmu menyakitinya\Natau dirimu sendiri.
Dialogue: 0,0:03:36.71,0:03:39.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan katakan yang sebenarnya\Npada Yang Maha Mulia dan Yang Mulia.
Dialogue: 0,0:03:42.09,0:03:44.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu hukumanku.
Dialogue: 0,0:03:44.68,0:03:45.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa katamu?
Dialogue: 0,0:03:45.68,0:03:47.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu hukuman untuk diriku sendiri
Dialogue: 0,0:03:47.85,0:03:51.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena tak bisa mengulurkan tangan\Nsaat majikanku dalam bahaya!
Dialogue: 0,0:03:52.94,0:03:55.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reirin membujukmu melakukan ini, 'kan?
Dialogue: 0,0:03:57.82,0:04:00.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon, katakan padaku, Tousetsu.
Dialogue: 0,0:04:01.44,0:04:03.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia,
Dialogue: 0,0:04:03.32,0:04:07.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau bisa mewujudkan harapan Nyonya Reirin\Ndan mengubah situasi secara drastis.
Dialogue: 0,0:04:08.12,0:04:09.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong ampuni aku.
Dialogue: 0,0:04:10.33,0:04:13.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengubah situasi secara drastis?
Dialogue: 0,0:04:13.67,0:04:16.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu karena aku bisa\Nmenentang keinginan Reirin
Dialogue: 0,0:04:16.29,0:04:19.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menghukum Shu Keigetsu\Nsebagai putra mahkota?
Dialogue: 0,0:04:25.43,0:04:26.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia, apa yang kau…
Dialogue: 0,0:04:28.81,0:04:30.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, tidak ada mahkota di kepalaku.
Dialogue: 0,0:04:31.22,0:04:34.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bersumpah tidak akan\Nmenggunakan wewenangku.
Dialogue: 0,0:04:34.89,0:04:37.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, tolong biarkan aku lewat.
Dialogue: 0,0:04:38.56,0:04:39.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti yang kau lihat…
Dialogue: 0,0:04:39.98,0:04:41.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong hentikan itu, Yang Mulia!
Dialogue: 0,0:04:47.62,0:04:49.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan, lewat sini.
Dialogue: 0,0:04:50.37,0:04:54.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memberitahumu semua\Nyang kuketahui di perjalanan.
Dialogue: 0,0:04:54.91,0:04:57.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Tousetsu.
Dialogue: 0,0:04:57.04,0:04:59.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak awal, tidak ada alasan
Dialogue: 0,0:04:59.42,0:05:03.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seorang dayang bisa\Nmenolak kedatangan Putra Mahkota.
Dialogue: 0,0:05:08.55,0:05:11.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru saja sembuh dari sakit!
Dialogue: 0,0:05:15.31,0:05:16.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahan lagi.
Dialogue: 0,0:05:16.94,0:05:18.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan khawatir, Nyonya Keigetsu!
Dialogue: 0,0:05:19.48,0:05:20.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah sampai!
Dialogue: 0,0:05:24.78,0:05:26.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya!
Dialogue: 0,0:05:26.15,0:05:27.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana pembatalan…
Dialogue: 0,0:05:27.45,0:05:30.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Leelee! Bicaranya nanti saja!
Dialogue: 0,0:05:30.45,0:05:31.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yang di sana!
Dialogue: 0,0:05:31.95,0:05:33.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan berdiri saja!
Dialogue: 0,0:05:33.29,0:05:35.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cegah dia lepas kendali!
Dialogue: 0,0:05:35.33,0:05:37.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata belum selesai, ya.
Dialogue: 0,0:05:37.96,0:05:40.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dia, Nyonya Keigetsu.
Dialogue: 0,0:05:40.33,0:05:43.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lipan yang memenangkan\Npertarungan kanibalisme!
Dialogue: 0,0:05:43.50,0:05:45.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bisa membuat sihir racun dengan ini!
Dialogue: 0,0:05:53.68,0:05:54.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten!
Dialogue: 0,0:05:56.06,0:05:57.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat!
Dialogue: 0,0:05:57.14,0:06:00.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan keluarkan harta nasional\Nseperti Busur Pelindung tanpa izin!
Dialogue: 0,0:06:00.52,0:06:01.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam.
Dialogue: 0,0:06:01.52,0:06:04.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam? Jahat sekali!
Dialogue: 0,0:06:04.48,0:06:08.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Shu Keigetsu tidak datang\Nuntuk mengambil Busur Pelindung.{\i0}
Dialogue: 0,0:06:08.65,0:06:11.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia mungkin menggunakan cara lain.{\i0}
Dialogue: 0,0:06:11.87,0:06:13.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini keputusanku sendiri.
Dialogue: 0,0:06:13.66,0:06:17.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan bersaksi kau berusaha\Nmenghentikanku, jadi tutup mulutmu.
Dialogue: 0,0:06:17.87,0:06:19.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan bersaksi begitu?
Dialogue: 0,0:06:19.92,0:06:21.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku diam.
Dialogue: 0,0:06:21.88,0:06:24.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kali ini, kau yang akan melakukannya
Dialogue: 0,0:06:24.30,0:06:26.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}demi mendoakan kesembuhan Permaisuri?
Dialogue: 0,0:06:26.13,0:06:30.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya, kupikir kau\Ntidak percaya kutukan dan takhayul,
Dialogue: 0,0:06:30.97,0:06:32.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi ini mengejutkan.
Dialogue: 0,0:06:32.14,0:06:33.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya aku tak percaya,
Dialogue: 0,0:06:33.76,0:06:37.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi saat Gadis Klan Shu itu\Nmenarik busur ini,
Dialogue: 0,0:06:37.06,0:06:40.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}penyakit Nyonya Kou Reirin mereda.
Dialogue: 0,0:06:40.06,0:06:40.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula,
Dialogue: 0,0:06:43.06,0:06:45.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan orang paling jahat\Ndi Istana Para Gadis
Dialogue: 0,0:06:45.61,0:06:48.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mau menarik busur untuk Yang Maha Mulia.
Dialogue: 0,0:06:48.53,0:06:51.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku, sebagai kapten Mata Elang,\Ntidak bisa diam saja.
Dialogue: 0,0:06:52.53,0:06:55.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Yang Mulia pasti menjaga Shu Keigetsu.{\i0}
Dialogue: 0,0:06:56.66,0:06:58.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, kenapa dia malah menjauhinya?{\i0}
Dialogue: 0,0:06:59.21,0:07:02.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak. Mengamati bukan tugas\Nkapten Mata Elang.{\i0}
Dialogue: 0,0:07:02.96,0:07:07.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tugasku mengawasi kedisiplinan\Ndi Istana Dalam dan menghilangkan risiko.{\i0}
Dialogue: 0,0:07:08.76,0:07:10.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Darah Kaisar mengalir dalam diriku{\i0}
Dialogue: 0,0:07:10.55,0:07:13.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan aku bagian Keluarga Gen,\Ndi bawah perlindungan air.{\i0}
Dialogue: 0,0:07:14.18,0:07:17.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Penggunaan Busur Pelindung\Nakan melepaskan potensi penuhnya.{\i0}
Dialogue: 0,0:07:20.35,0:07:21.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:07:21.48,0:07:24.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Busur Pelindungnya…
Dialogue: 0,0:07:24.27,0:07:27.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merusak harta nasional artinya dieksekusi!
Dialogue: 0,0:07:27.73,0:07:29.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menariknya terlalu kuat!
Dialogue: 0,0:07:29.61,0:07:33.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, busur sekuat ini\Ntidak mungkin tertandingi.
Dialogue: 0,0:07:33.74,0:07:36.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar tali busurnya belum pernah putus
Dialogue: 0,0:07:36.74,0:07:38.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sejak diikat beberapa ratus tahun lalu.
Dialogue: 0,0:07:38.70,0:07:41.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, kenapa harus sekarang?
Dialogue: 0,0:07:42.42,0:07:46.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Saat aku menarik busurnya,\Nseolah ia gemetar ketakutan akan sesuatu.{\i0}
Dialogue: 0,0:07:47.21,0:07:49.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Seolah tekanannya terlepas{\i0}
Dialogue: 0,0:07:49.84,0:07:52.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dalam tangan Klan Gen yang tidak asing,{\i0}
Dialogue: 0,0:07:52.84,0:07:56.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan ketegangan yang terlepas itu\Nmemutus talinya.{\i0}
Dialogue: 0,0:07:57.39,0:07:59.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Klan Gen mengawasi air dan perang.{\i0}
Dialogue: 0,0:07:59.97,0:08:03.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Busur Pelindung diciptakan\Noleh perajin ahli di antara mereka.{\i0}
Dialogue: 0,0:08:03.81,0:08:07.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ia menembus musuh mana pun,\Nbahkan tidak takut akan api yang membara.{\i0}
Dialogue: 0,0:08:07.86,0:08:11.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika ada satu hal\Nyang bisa menandingi busur ini…{\i0}
Dialogue: 0,0:08:12.57,0:08:14.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Qi{\i0} tanah?
Dialogue: 0,0:08:14.11,0:08:15.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tanah mengalahkan air.{\i0}
Dialogue: 0,0:08:15.82,0:08:18.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tanah yang berat bahkan bisa\Nmeredam air yang bergolak.{\i0}
Dialogue: 0,0:08:18.74,0:08:20.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Klan Kou menguasai tanah.{\i0}
Dialogue: 0,0:08:21.37,0:08:24.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Gadis Klan Shu terus menarik Busur\NPelindung selama lebih dari enam jam.{\i0}
Dialogue: 0,0:08:24.50,0:08:26.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Klan Shu dikuasai api.{\i0}
Dialogue: 0,0:08:26.88,0:08:29.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Seharusnya tidak cocok dengan air.{\i0}
Dialogue: 0,0:08:29.80,0:08:32.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak mungkin. Namun, tetap saja…{\i0}
Dialogue: 0,0:08:37.22,0:08:41.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau disebut penguasa bijaksana,\Ndan kau baik hati, Sepupu…
Dialogue: 0,0:08:42.85,0:08:44.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, begitu rupanya.
Dialogue: 0,0:08:45.56,0:08:47.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:08:47.48,0:08:50.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten? Kau mau ke mana?
Dialogue: 0,0:08:50.23,0:08:52.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan kembali ke Istana Shu.
Dialogue: 0,0:08:52.99,0:08:54.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:08:55.15,0:08:59.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kesaksianmu!
Dialogue: 0,0:08:59.99,0:09:02.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau punya sesuatu seperti itu?
Dialogue: 0,0:09:02.12,0:09:04.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya…
Dialogue: 0,0:09:04.12,0:09:06.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menggunakan laba-laba dan lipan
Dialogue: 0,0:09:06.96,0:09:11.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pemberian Leelee\Nsebagai makanan untuk teman tikusku.
Dialogue: 0,0:09:11.17,0:09:12.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Pemberian"?
Dialogue: 0,0:09:12.59,0:09:14.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku tak punya wadahnya.
Dialogue: 0,0:09:14.84,0:09:17.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak ingin memakai barang orang lain,
Dialogue: 0,0:09:17.97,0:09:21.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi kumasukkan saja\Nke satu-satunya guci yang ada.
Dialogue: 0,0:09:21.35,0:09:24.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, lipannya memakan laba-laba itu.
Dialogue: 0,0:09:24.39,0:09:28.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menciptakan sihir racun\Nkarena kerendahan hatinya, ya.
Dialogue: 0,0:09:28.85,0:09:32.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, apa yang akan kau lakukan\Ndengan itu?
Dialogue: 0,0:09:32.65,0:09:36.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leelee, Permaisuri menderita penyakit\Nyang berasal dari kutukan.
Dialogue: 0,0:09:37.82,0:09:41.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selir Agung Shu yang mengutuknya.
Dialogue: 0,0:09:41.03,0:09:42.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:09:42.03,0:09:47.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kami ingin membuat penangkalnya\Ndengan sihir racun ini
Dialogue: 0,0:09:47.08,0:09:48.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menyelamatkan Permaisuri.
Dialogue: 0,0:09:48.92,0:09:50.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin.
Dialogue: 0,0:09:50.84,0:09:52.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selir Agung Shu?
Dialogue: 0,0:09:53.17,0:09:55.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah mengatakannya pada Yang Mulia?
Dialogue: 0,0:09:55.92,0:09:57.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Yang Mulia?
Dialogue: 0,0:09:58.05,0:10:03.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sebenarnya, setelah kau melompati pagar,\NYang Mulia datang.
Dialogue: 0,0:10:03.06,0:10:05.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menggedor gerbang
Dialogue: 0,0:10:05.02,0:10:07.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan berteriak,\N"Kau di sini, 'kan, Reirin?"
Dialogue: 0,0:10:08.06,0:10:11.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seolah dia yakin\NNyonya Kou Reirin tak ada di dalam,
Dialogue: 0,0:10:11.77,0:10:16.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi Nyonya yang baru\Nmelompat masuk beberapa saat lalu.
Dialogue: 0,0:10:16.57,0:10:17.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu…
Dialogue: 0,0:10:17.57,0:10:19.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah tahu.
Dialogue: 0,0:10:19.16,0:10:20.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia akhirnya…
Dialogue: 0,0:10:20.82,0:10:22.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa juga begitu.
Dialogue: 0,0:10:23.58,0:10:26.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku yakin Yang Mulia marah.{\i0}
Dialogue: 0,0:10:26.66,0:10:32.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Saat kamar di Istana Kou kosong,\Ndia mungkin akan kembali ke sini.{\i0}
Dialogue: 0,0:10:33.34,0:10:39.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Keigetsu, mungkin lebih baik\Nkita batalkan dulu pertukarannya.
Dialogue: 0,0:10:42.22,0:10:44.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan membatalkannya.
Dialogue: 0,0:10:44.60,0:10:45.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:10:47.60,0:10:49.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bercanda!
Dialogue: 0,0:10:49.31,0:10:52.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak bisa katakan itu di situasi ini!
Dialogue: 0,0:10:52.19,0:10:55.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dayang Istana Bawah cerewet.
Dialogue: 0,0:10:56.15,0:10:57.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya!
Dialogue: 0,0:10:57.61,0:10:59.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang aku dayang Istana Atas!
Dialogue: 0,0:10:59.78,0:11:02.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyawamu diselamatkan Nyonya Reirin!
Dialogue: 0,0:11:02.87,0:11:05.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau tidak punya hati nurani?
Dialogue: 0,0:11:05.37,0:11:06.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leelee…
Dialogue: 0,0:11:06.37,0:11:08.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat batalkan pertukarannya.
Dialogue: 0,0:11:08.95,0:11:11.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau tak berani\Nmenghapus semua omong kosong
Dialogue: 0,0:11:11.37,0:11:13.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}penyebab banyak masalah ini,\Nmeski hanya sedikit?
Dialogue: 0,0:11:13.63,0:11:14.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berani.
Dialogue: 0,0:11:14.84,0:11:15.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:11:16.17,0:11:19.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berani bertanggung jawab\Natas tindakanku sendiri!
Dialogue: 0,0:11:21.09,0:11:25.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, membatalkan pertukaran\Nmembutuhkan banyak {\i1}qi.{\i0}
Dialogue: 0,0:11:25.43,0:11:27.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, tak bisa di hari yang sama!
Dialogue: 0,0:11:28.81,0:11:32.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa melakukannya sekarang.
Dialogue: 0,0:11:32.31,0:11:36.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu artinya kau akan\Nmengabulkan permintaanku lebih dahulu?
Dialogue: 0,0:11:36.82,0:11:39.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan salah paham!
Dialogue: 0,0:11:39.24,0:11:41.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan demi kau, mengerti?
Dialogue: 0,0:11:41.28,0:11:45.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya ingin menunjukkan kemampuanku\Npada orang yang mengejekku!
Dialogue: 0,0:11:45.41,0:11:47.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tapi…\N- Diam!
Dialogue: 0,0:11:47.41,0:11:50.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berusaha memperbaiki kesalahan\Nselir Klan Shu
Dialogue: 0,0:11:50.37,0:11:52.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebagai anggota Klan Shu!
Dialogue: 0,0:11:52.96,0:11:54.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Berusaha memperbaiki…"
Dialogue: 0,0:11:54.38,0:11:58.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, jika aku membantu\NYang Maha Mulia Permaisuri,
Dialogue: 0,0:11:58.42,0:12:01.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}situasinya akan lebih mudah\Nsetelah pertukaran dibatalkan.
Dialogue: 0,0:12:01.63,0:12:03.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Leelee.
Dialogue: 0,0:12:03.34,0:12:07.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Keigetsu memang anak yang manis.
Dialogue: 0,0:12:07.05,0:12:09.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu soal itu.
Dialogue: 0,0:12:11.98,0:12:15.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, pikirkan siapa\Nyang ingin kau kutuk.
Dialogue: 0,0:12:15.69,0:12:18.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ambil benda perwakilannya, yaitu guci ini.
Dialogue: 0,0:12:18.19,0:12:20.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tulis detailnya di atasnya.
Dialogue: 0,0:12:23.45,0:12:26.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Laba-laba yang mengutuk bangsawan\Ndi Istana Kou."
Dialogue: 0,0:12:26.70,0:12:31.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, ini lebih seperti kutukan balasan\Nmelawan sihir racun laba-laba
Dialogue: 0,0:12:31.41,0:12:33.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}daripada mengutuk Selir Agung Shu.
Dialogue: 0,0:12:33.96,0:12:36.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini lebih mudah ditangani\Nsecara emosional.
Dialogue: 0,0:12:36.08,0:12:38.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kutukan akan memantul ke Selir Agung Shu
Dialogue: 0,0:12:38.42,0:12:39.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}setelah dipatahkan.
Dialogue: 0,0:12:39.92,0:12:42.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, hasilnya sama saja.
Dialogue: 0,0:12:44.22,0:12:45.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita mulai.
Dialogue: 0,0:12:47.93,0:12:53.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi hukum yang ditetapkan sejak awal mula\Ndunia, dengarkan perintahku.
Dialogue: 0,0:13:04.49,0:13:07.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Binasakan laba-laba sumber kutukan ini
Dialogue: 0,0:13:07.53,0:13:09.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan hancurkan tubuhnya.
Dialogue: 0,0:13:11.08,0:13:12.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hancurkan…{\i0}
Dialogue: 0,0:13:22.34,0:13:23.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang pengorbanan.
Dialogue: 0,0:13:24.72,0:13:27.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita hanya perlu membunuh lipan ini.
Dialogue: 0,0:13:30.97,0:13:33.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau aku yang melakukannya?
Dialogue: 0,0:13:33.85,0:13:35.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku saja!
Dialogue: 0,0:13:36.73,0:13:38.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Nyonya Keigetsu.
Dialogue: 0,0:13:39.61,0:13:42.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kutukan yang dipatahkan\Nakan kembali ke perapalnya,
Dialogue: 0,0:13:42.73,0:13:46.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan dengan tumbal, mantranya selesai.
Dialogue: 0,0:13:46.99,0:13:50.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kata lain,\Nperapalnya yang membunuh tumbal.
Dialogue: 0,0:13:51.41,0:13:55.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kita gagal, kutukan itu\Nakan berbalik menyerang.
Dialogue: 0,0:13:55.50,0:13:59.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah itu artinya\Nkau akan terluka sebagai perapalnya?
Dialogue: 0,0:14:01.54,0:14:05.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Keigetsu,\Napa kau ingin membahayakan nyawamu
Dialogue: 0,0:14:05.38,0:14:08.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}demi menyelamatkan Yang Maha Mulia?
Dialogue: 0,0:14:09.55,0:14:11.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong beri tahu aku, Nyonya Keigetsu.
Dialogue: 0,0:14:14.14,0:14:19.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau selalu terlihat sembrono,\Ntapi cerdas di saat yang paling aneh.
Dialogue: 0,0:14:19.31,0:14:22.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau belum menjawabku, Nyonya Keigetsu.
Dialogue: 0,0:14:23.52,0:14:25.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya ini cara yang kutahu.
Dialogue: 0,0:14:25.19,0:14:26.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:14:26.19,0:14:28.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara meminta maaf kepadamu.
Dialogue: 0,0:14:28.57,0:14:30.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara menyelesaikan semuanya.
Dialogue: 0,0:14:30.66,0:14:31.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemudian…
Dialogue: 0,0:14:31.95,0:14:34.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}cara memenuhi harapan.
Dialogue: 0,0:14:36.70,0:14:39.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang pernah\Nmemberiku kesempatan.
Dialogue: 0,0:14:39.92,0:14:42.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak ada yang mengajariku harga diri.{\i0}
Dialogue: 0,0:14:42.59,0:14:44.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka tak berharap padaku.{\i0}
Dialogue: 0,0:14:45.13,0:14:46.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku tidak tahu.
Dialogue: 0,0:14:47.72,0:14:49.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu, tapi…
Dialogue: 0,0:14:49.80,0:14:51.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin melakukan sesuatu!
Dialogue: 0,0:14:51.84,0:14:55.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kau bilang aku bintangmu!
Dialogue: 0,0:14:55.06,0:14:59.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski aku hidup selama ini\Nberkeliaran dalam lumpur…
Dialogue: 0,0:15:00.52,0:15:02.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ingin sekali saja…
Dialogue: 0,0:15:02.44,0:15:04.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sekecil apa pun…
Dialogue: 0,0:15:04.27,0:15:07.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin melakukan sesuatu\Nyang cemerlang.
Dialogue: 0,0:15:07.69,0:15:08.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa itu salah?
Dialogue: 0,0:15:11.82,0:15:14.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan komet…
Dialogue: 0,0:15:14.24,0:15:16.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}benar-benar luar biasa.
Dialogue: 0,0:15:21.79,0:15:27.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kukatakan kalau aku memanjatkan\Ndua permintaan pada komet, 'kan?
Dialogue: 0,0:15:30.34,0:15:32.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Yang pertama adalah kesehatan.{\i0}
Dialogue: 0,0:15:33.39,0:15:35.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemudian satu lagi…
Dialogue: 0,0:15:36.76,0:15:38.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku menginginkan seorang teman.
Dialogue: 0,0:15:41.27,0:15:46.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sadar bahwa aku tumbuh\Ndi lingkungan yang istimewa.
Dialogue: 0,0:15:47.27,0:15:51.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia yang lembut, seperti buaian.
Dialogue: 0,0:15:51.03,0:15:54.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, aku tetap anggota Keluarga Kou.{\i0}
Dialogue: 0,0:15:55.49,0:16:00.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku ingin menyayangi seseorang,\Nbukan hanya disayangi.{\i0}
Dialogue: 0,0:16:00.91,0:16:04.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin pasangan\Nyang bisa saling mendukung,
Dialogue: 0,0:16:04.04,0:16:06.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}teman yang memperlakukanku dengan setara.
Dialogue: 0,0:16:06.67,0:16:12.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau punya hati yang mudah berubah\Ndan emosi kuat di luar kendalimu.
Dialogue: 0,0:16:12.97,0:16:15.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau amat murni sampai rela\Nmempertaruhkan nyawamu
Dialogue: 0,0:16:15.30,0:16:17.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}demi meminta maaf\Npada gadis yang kau benci.
Dialogue: 0,0:16:18.93,0:16:22.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau punya banyak hal yang tidak kumiliki.
Dialogue: 0,0:16:24.85,0:16:29.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon, maukah kau berteman denganku?
Dialogue: 0,0:16:29.69,0:16:30.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:16:30.82,0:16:33.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kau bilang tidak mau,
Dialogue: 0,0:16:33.53,0:16:35.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan tetap menganggapmu teman.
Dialogue: 0,0:16:35.82,0:16:36.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:16:37.95,0:16:41.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika pisau ini harus diayunkan,\Nkita akan mengayunnya bersama.
Dialogue: 0,0:16:41.62,0:16:44.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bisa membagi kutukannya.
Dialogue: 0,0:16:44.08,0:16:46.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ini…
Dialogue: 0,0:16:46.58,0:16:47.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:16:48.17,0:16:49.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ini…
Dialogue: 0,0:16:49.84,0:16:50.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan.
Dialogue: 0,0:16:57.26,0:17:02.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau lakukan tanpa meminta izinku…
Dialogue: 0,0:17:03.18,0:17:04.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keigetsu?
Dialogue: 0,0:17:05.81,0:17:07.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selir Agung!
Dialogue: 0,0:17:07.86,0:17:09.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tundukkan kepalamu,
Dialogue: 0,0:17:10.40,0:17:12.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri Orang Asing.
Dialogue: 0,0:17:14.07,0:17:16.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kin Gayou…
Dialogue: 0,0:17:16.57,0:17:19.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seseorang! Kapten Mata Elang!
Dialogue: 0,0:17:19.41,0:17:20.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma.
Dialogue: 0,0:17:20.91,0:17:23.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, Yang Maha Mulia Permaisuri…
Dialogue: 0,0:17:23.54,0:17:26.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}wanita menjengkelkan itu dalam bahaya.
Dialogue: 0,0:17:26.87,0:17:29.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang mengawasi\Nsetiap gerakan Istana Kou.
Dialogue: 0,0:17:30.50,0:17:33.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan ada yang datang ke sini.
Dialogue: 0,0:17:37.13,0:17:40.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jantung dan kaki kanannya…
Dialogue: 0,0:17:40.68,0:17:44.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, bagian mana yang kau tusuk\Ndengan Busur Pelindung?
Dialogue: 0,0:17:44.27,0:17:47.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekali di tengah\Ndan beberapa kali di tepi kanan.
Dialogue: 0,0:17:47.94,0:17:49.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Ternyata memang benar{\i0}
Dialogue: 0,0:17:49.44,0:17:51.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Selir Agung Shu.{\i0}
Dialogue: 0,0:17:51.07,0:17:53.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, tunggu sebentar…
Dialogue: 0,0:18:01.45,0:18:02.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Leelee!
Dialogue: 0,0:18:07.33,0:18:08.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kou Reirin!
Dialogue: 0,0:18:08.58,0:18:09.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Reirin?
Dialogue: 0,0:18:09.83,0:18:11.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga.
Dialogue: 0,0:18:11.59,0:18:14.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nampaknya identitas aslimu\Nsudah cukup tersebar,
Dialogue: 0,0:18:15.13,0:18:16.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keigetsu.
Dialogue: 0,0:18:17.09,0:18:19.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata memang mustahil
Dialogue: 0,0:18:19.30,0:18:23.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagi seekor tikus got\Nuntuk berpura-pura menjadi kupu-kupu.
Dialogue: 0,0:18:23.76,0:18:27.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar gadis tidak berguna.
Dialogue: 0,0:18:28.14,0:18:29.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:18:29.27,0:18:30.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski aku bodoh,
Dialogue: 0,0:18:30.81,0:18:34.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akhirnya aku tahu ambisimu, Selir Agung.
Dialogue: 0,0:18:35.03,0:18:38.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan aku akan menghancurkannya sekarang.
Dialogue: 0,0:18:39.78,0:18:44.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika masih sayang nyawamu,\Nlebih baik letakkan belati itu.
Dialogue: 0,0:18:44.99,0:18:46.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru sebaliknya.
Dialogue: 0,0:18:46.62,0:18:49.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yang harus meletakkannya, Keigetsu.
Dialogue: 0,0:18:49.00,0:18:52.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kutukan balasannya belum selesai, 'kan?
Dialogue: 0,0:18:52.29,0:18:56.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau menghargai nyawa orang\Nyang akhirnya jadi temanmu ini,
Dialogue: 0,0:18:56.38,0:19:00.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan jika kau menghargai tubuhmu sendiri,
Dialogue: 0,0:19:00.26,0:19:03.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}letakkan guci dan belati itu, Keigetsu.
Dialogue: 0,0:19:03.64,0:19:05.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon, Nyonya Keigetsu.
Dialogue: 0,0:19:05.93,0:19:07.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letakkan belatinya.
Dialogue: 0,0:19:07.31,0:19:10.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, jangan khawatirkan aku.
Dialogue: 0,0:19:10.44,0:19:11.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lakukan tugasmu.
Dialogue: 0,0:19:13.56,0:19:15.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupu-kupu kecil cerewet.
Dialogue: 0,0:19:16.48,0:19:20.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keigetsu-ku yang malang.\NKau pasti sangat bingung.
Dialogue: 0,0:19:20.82,0:19:23.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadisku tersayang.
Dialogue: 0,0:19:23.45,0:19:25.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, akan kuberi tahu…
Dialogue: 0,0:19:26.79,0:19:31.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa yang akan terjadi jika kau\Nmenyelesaikan sihir racun itu di sini.
Dialogue: 0,0:19:31.96,0:19:34.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti akan mati.
Dialogue: 0,0:19:34.59,0:19:39.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan sebagai anggota Klan Shu\Nyang memberontak,
Dialogue: 0,0:19:39.01,0:19:41.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau tidak akan bisa lolos\Ndari hukuman mati.
Dialogue: 0,0:19:41.76,0:19:44.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, jika kau letakkan belatinya,
Dialogue: 0,0:19:44.76,0:19:49.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}wanita itu akan mati,\Ndan aku akan menjadi permaisuri.
Dialogue: 0,0:19:49.27,0:19:53.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu terjadi,\Naku akan memperlakukanmu dengan hormat.
Dialogue: 0,0:19:53.77,0:19:56.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bahkan bisa\Nmembiarkan "temanmu" hidup.
Dialogue: 0,0:19:56.32,0:20:00.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, hanya jika kesadarannya dihapus.
Dialogue: 0,0:20:03.16,0:20:04.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan!
Dialogue: 0,0:20:04.91,0:20:07.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat, Keigetsu.
Dialogue: 0,0:20:07.74,0:20:11.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belati ini berat,\Ntanganku bisa tergelincir.
Dialogue: 0,0:20:11.29,0:20:12.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya!
Dialogue: 0,0:20:12.79,0:20:15.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang akan kau lakukan, Keigetsu?
Dialogue: 0,0:20:28.81,0:20:30.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan, Nyonya Keigetsu…
Dialogue: 0,0:20:30.39,0:20:31.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam.
Dialogue: 0,0:20:39.61,0:20:41.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau anak pintar, Keigetsu.
Dialogue: 0,0:20:41.99,0:20:43.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu yang harus kau lakukan!
Dialogue: 0,0:20:43.90,0:20:48.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kau tikus got\Nyang tidak kompeten dan kotor!
Dialogue: 0,0:20:50.58,0:20:51.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau lengah!
Dialogue: 0,0:20:58.96,0:21:00.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tertangkap!
Dialogue: 0,0:21:03.13,0:21:04.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga.
Dialogue: 0,0:21:04.17,0:21:05.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:21:05.34,0:21:08.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal sudah kuajak bersama,\Ntapi malah kulakukan sendiri.
Dialogue: 0,0:21:08.35,0:21:11.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Keigetsu, ia masih bergerak,
Dialogue: 0,0:21:11.47,0:21:13.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi sebagai serangan terakhir…
Dialogue: 0,0:21:13.56,0:21:15.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau!
Dialogue: 0,0:21:15.52,0:21:17.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan dekat-dekat denganku!
Dialogue: 0,0:21:17.77,0:21:19.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lipannya mati.
Dialogue: 0,0:21:37.00,0:21:38.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mendekat!
Dialogue: 0,0:21:38.71,0:21:40.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjauhlah, Monster!
Dialogue: 0,0:21:40.21,0:21:41.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:21:41.59,0:21:43.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kutukannya telah dibalas.
Dialogue: 0,0:21:44.97,0:21:46.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enyah!
Dialogue: 0,0:21:46.84,0:21:50.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lahap dan bunuh permaisuri\Npenuh kebencian itu!
Dialogue: 0,0:21:50.05,0:21:53.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Wanita yang merenggut pangeranku dariku!
Dialogue: 0,0:21:58.73,0:21:59.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!
Dialogue: 0,0:22:02.11,0:22:05.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Dasar tikus got!
Dialogue: 0,0:22:07.24,0:22:09.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baik-baik saja, Reirin?
Dialogue: 0,0:22:09.28,0:22:10.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepupu…
Dialogue: 0,0:22:11.78,0:22:12.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia.
