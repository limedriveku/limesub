Dialogue: 0,0:00:03.00,0:00:04.08,sign,,0000,0000,0000,,SHU KEIGETSU\N(JIWA REIRIN)
Dialogue: 0,0:00:05.25,0:00:06.21,sign,,0000,0000,0000,,DAYANG KLAN SHU, LEELEE
Dialogue: 0,0:00:22.31,0:00:24.73,sign,,0000,0000,0000,,KEPALA DAYANG REIRIN, KOU TOUSETSU
Dialogue: 0,0:04:15.63,0:04:16.54,sign,,0000,0000,0000,,GADIS KLAN KIN, KIN SEIKA
Dialogue: 0,0:05:55.31,0:05:56.22,sign,,0000,0000,0000,,KAPTEN MATA ELANG - SHIN-U
Dialogue: 0,0:07:51.88,0:07:53.38,sign,,0000,0000,0000,,GADIS KLAN KOU - KOU REIRIN\N(JIWA KEIGETSU)
Dialogue: 0,0:07:58.85,0:07:59.76,sign,,0000,0000,0000,,PUTRA MAHKOTA - EI GYOUMEI
Dialogue: 0,0:11:10.12,0:11:13.04,sign,,0000,0000,0000,,SELIR KEKAISARAN - SHU GABI
Dialogue: 0,0:22:07.49,0:22:08.49,sign,,0000,0000,0000,,PERMAISURI, KOU KENSHUU
Dialogue: 0,0:00:04.08,0:00:05.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leelee, ada apa?
Dialogue: 0,0:00:06.21,0:00:07.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga.
Dialogue: 0,0:00:07.13,0:00:11.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong lakukan sesuatu tentang Tousetsu\Nyang terlalu bersemangat itu.
Dialogue: 0,0:00:11.88,0:00:14.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Tousetsu melakukan sesuatu?
Dialogue: 0,0:00:14.26,0:00:18.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Dua malam lalu, setelah kau tidur…
Dialogue: 0,0:00:25.35,0:00:26.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:00:26.44,0:00:28.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia masih pendarahan.
Dialogue: 0,0:00:28.15,0:00:29.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangan dominannya cedera.
Dialogue: 0,0:00:29.69,0:00:31.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubalut ulang.
Dialogue: 0,0:00:33.45,0:00:35.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu…
Dialogue: 0,0:00:36.95,0:00:39.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa lagi kali ini?
Dialogue: 0,0:00:39.58,0:00:42.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa meninggalkan\NNyonya Reirin di lingkungan seperti ini.
Dialogue: 0,0:00:43.46,0:00:45.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bantu aku merenovasi.
Dialogue: 0,0:00:45.21,0:00:46.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:00:47.21,0:00:50.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas kamarnya tampak berbeda.
Dialogue: 0,0:00:50.46,0:00:53.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi masalahnya belum selesai.
Dialogue: 0,0:00:53.47,0:00:56.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak awal, orang Istana Kou\Ndatang ke Istana Shu
Dialogue: 0,0:00:56.68,0:00:58.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah melanggar peraturan.
Dialogue: 0,0:00:58.05,0:01:00.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku mengusirnya\Ndan mengatakan dia harus berhenti.
Dialogue: 0,0:01:00.97,0:01:02.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemudian, keesokan paginya…
Dialogue: 0,0:01:05.85,0:01:07.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau…
Dialogue: 0,0:01:08.31,0:01:09.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dindingnya kugeser sedikit.
Dialogue: 0,0:01:10.36,0:01:11.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:01:11.36,0:01:15.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warnanya sudah pudar,\Njadi tak bisa lagi disebut pembatas.
Dialogue: 0,0:01:15.99,0:01:17.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya aku mengecat dinding baru.
Dialogue: 0,0:01:17.99,0:01:21.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, tempat ini tempat umum,\Nbukan bagian klan mana pun.
Dialogue: 0,0:01:21.83,0:01:24.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa pun bisa datang dan pergi sesukanya.
Dialogue: 0,0:01:24.95,0:01:28.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh mengagumkan.
Dialogue: 0,0:01:28.04,0:01:29.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tousetsu memang hebat.
Dialogue: 0,0:01:29.75,0:01:31.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu membuatmu terkesan?
Dialogue: 0,0:01:31.21,0:01:33.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak saat itu…
Dialogue: 0,0:01:33.00,0:01:35.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kondisi Nyonya Reirin?
Dialogue: 0,0:01:35.92,0:01:38.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini air jernih untuk mandi\Nsaat dia bangun.
Dialogue: 0,0:01:38.18,0:01:40.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pakaian dan jepit rambut.
Dialogue: 0,0:01:40.26,0:01:41.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu…
Dialogue: 0,0:01:41.47,0:01:44.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengajarimu seni bela diri.
Dialogue: 0,0:01:45.81,0:01:48.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara itu, sekujur tubuhku sakit.
Dialogue: 0,0:01:49.65,0:01:52.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tousetsu adalah guru seni bela diriku.
Dialogue: 0,0:01:52.73,0:01:56.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung kemarin ada pesta minum teh\Ndi Istana Para Gadis
Dialogue: 0,0:01:56.69,0:01:58.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk merayakan kesembuhan\NNyonya Kou Reirin,
Dialogue: 0,0:01:58.82,0:02:03.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi dia terpaksa pergi menyiapkannya,\Ntapi sekarang…
Dialogue: 0,0:02:03.12,0:02:08.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Klan Kin, Gen, dan Ran satu per satu\Ndatang membawa hadiah kunjungan,
Dialogue: 0,0:02:08.46,0:02:10.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan aku harus mengurusnya.
Dialogue: 0,0:02:10.67,0:02:12.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak sekali!
Dialogue: 0,0:02:12.29,0:02:14.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu kau mengurus banyak hal.
Dialogue: 0,0:02:14.92,0:02:16.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Leelee.
Dialogue: 0,0:02:16.71,0:02:19.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku yang mengaturnya\Ndan menulis ucapan terima kasih
Dialogue: 0,0:02:19.80,0:02:20.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar kau bisa istirahat.
Dialogue: 0,0:02:20.97,0:02:22.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:02:22.68,0:02:25.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanganmu butuh sebulan penuh untuk sembuh!
Dialogue: 0,0:02:25.39,0:02:28.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tugasmu hari ini diam dan tidur!
Dialogue: 0,0:02:29.94,0:02:31.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:02:34.15,0:02:36.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa kita bisa makan dulu.
Dialogue: 0,0:02:38.03,0:02:38.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:04:09.79,0:04:11.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Selamat makan!\N- Selamat makan!
Dialogue: 0,0:04:11.75,0:04:15.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dibawa langsung oleh Nyonya Kin Seika.
Dialogue: 0,0:04:16.54,0:04:18.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan berarti aku khawatir.
Dialogue: 0,0:04:22.05,0:04:23.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini lezat sekali!
Dialogue: 0,0:04:23.38,0:04:25.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:04:26.55,0:04:29.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leelee, soal jepit rambut itu,
Dialogue: 0,0:04:29.68,0:04:32.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kurasa Nyonya Seika tidak terlibat.
Dialogue: 0,0:04:33.85,0:04:37.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di saat seperti ini,\NNyonya Seika sendiri membawakan buah
Dialogue: 0,0:04:37.19,0:04:40.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang mudah dimakan orang terluka.
Dialogue: 0,0:04:40.61,0:04:43.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mengirim buah\Nkepada orang yang disukainya,
Dialogue: 0,0:04:43.95,0:04:47.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menyiram orang\Nyang tidak disukainya dengan air.
Dialogue: 0,0:04:48.37,0:04:49.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti tempo hari.
Dialogue: 0,0:04:53.33,0:04:56.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin dia orang\Nyang berbudi seperti itu.
Dialogue: 0,0:04:57.17,0:05:00.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, apa sutra gading\NKin Gayou yang mengancamku
Dialogue: 0,0:05:00.71,0:05:02.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bertindak atas kemauan sendiri?
Dialogue: 0,0:05:02.84,0:05:05.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyebutkan wasiat tuannya tanpa izin.
Dialogue: 0,0:05:08.64,0:05:11.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil Nyonya Seika\Ntak bisa mengendalikan dayang
Dialogue: 0,0:05:11.81,0:05:15.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan kesetiaan sebesar itu.
Dialogue: 0,0:05:15.85,0:05:19.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin Selir Murni Klan Kin\Nyang memberi perintah.
Dialogue: 0,0:05:20.40,0:05:22.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ada yang aneh.
Dialogue: 0,0:05:23.32,0:05:24.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Leelee.
Dialogue: 0,0:05:24.99,0:05:28.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku pura-pura berani\Nmengatakan akan balas dendam,
Dialogue: 0,0:05:28.03,0:05:29.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi menyelidikinya saja tak bisa.
Dialogue: 0,0:05:29.91,0:05:31.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja, tidak apa-apa.
Dialogue: 0,0:05:31.99,0:05:36.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih tepatnya, aku tak keberatan\Nkalau masalah ini dilupakan saja.
Dialogue: 0,0:05:36.12,0:05:38.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa melakukan itu.
Dialogue: 0,0:05:38.21,0:05:42.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka melukai dayangku\Nyang paling berharga dan manis,
Dialogue: 0,0:05:42.80,0:05:45.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan aku sama sekali tak bisa balas dendam?
Dialogue: 0,0:05:47.55,0:05:48.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:05:48.55,0:05:49.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu Tousetsu?
Dialogue: 0,0:05:50.18,0:05:52.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketukannya, itu orang lain.
Dialogue: 0,0:05:56.23,0:05:57.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Mata Elang!
Dialogue: 0,0:05:57.81,0:05:59.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah bangun.
Dialogue: 0,0:06:00.23,0:06:01.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:06:01.73,0:06:02.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat semua orang.
Dialogue: 0,0:06:03.57,0:06:06.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini salep pereda nyeri\Nyang dipakai perwira militer.
Dialogue: 0,0:06:06.19,0:06:08.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:06:08.32,0:06:10.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana perasaanmu?
Dialogue: 0,0:06:10.07,0:06:13.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Aku sudah mulai pulih.
Dialogue: 0,0:06:13.33,0:06:16.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, tubuhku ini kuat!
Dialogue: 0,0:06:16.58,0:06:19.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanita mana yang terus\Nmenarik busur berat sampai malam,
Dialogue: 0,0:06:19.21,0:06:21.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang bahkan sulit dilakukan pria?
Dialogue: 0,0:06:21.54,0:06:23.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku meragukan kewarasanmu.
Dialogue: 0,0:06:23.17,0:06:25.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, posturmu sangat indah.
Dialogue: 0,0:06:25.88,0:06:29.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:06:29.09,0:06:32.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat senang mendengarnya.
Dialogue: 0,0:06:32.39,0:06:38.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kenapa putri yang bukan\Ndari Klan Gen tiba-tiba menarik busur?
Dialogue: 0,0:06:39.44,0:06:43.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya wajahmu juga berbeda\Ndari sebelumnya.
Dialogue: 0,0:06:43.86,0:06:45.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu…
Dialogue: 0,0:06:45.73,0:06:48.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin karena aku belum sepenuhnya sehat.
Dialogue: 0,0:06:48.36,0:06:49.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, 'kan, Leelee?
Dialogue: 0,0:06:49.99,0:06:50.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!
Dialogue: 0,0:06:51.57,0:06:56.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang ingin kutanyakan padamu,\NKapten Mata Elang.
Dialogue: 0,0:06:56.29,0:06:58.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:06:58.41,0:07:02.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempo hari,\Nkudengar tidak ada dayang bernama Gayou
Dialogue: 0,0:07:02.71,0:07:04.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di Klan Kin.
Dialogue: 0,0:07:04.04,0:07:06.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu di saat ritual?
Dialogue: 0,0:07:06.88,0:07:11.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada juga rumor tentang dayang\Nyang jepit rambutnya dicuri.
Dialogue: 0,0:07:11.59,0:07:14.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada yang melapor ke Mata Elang?
Dialogue: 0,0:07:14.18,0:07:17.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Kalau tidak salah, sebulan yang lalu.
Dialogue: 0,0:07:17.27,0:07:19.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:07:19.89,0:07:23.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingat dengan baik,\Nkarena Klan Kin sudah marah-marah
Dialogue: 0,0:07:23.23,0:07:26.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena pakaian sutra gading juga dicuri.
Dialogue: 0,0:07:26.02,0:07:27.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:07:29.44,0:07:32.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dayang bernama Kin Gayou tidak ada,{\i0}
Dialogue: 0,0:07:32.99,0:07:36.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan pakaian sutra gading telah dicuri.{\i0}
Dialogue: 0,0:07:36.91,0:07:41.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Wajar kalau mengira seseorang\Nmenyuruh merundung "Shu Keigetsu"{\i0}
Dialogue: 0,0:07:41.33,0:07:46.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan membuat seolah-olah\NKlan Kin dalangnya.{\i0}
Dialogue: 0,0:07:46.21,0:07:48.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kurasa Nyonya Keigetsu{\i0}
Dialogue: 0,0:07:48.13,0:07:51.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}menghadapi permusuhan yang akarnya\Njauh lebih dalam dari dugaanku.{\i0}
Dialogue: 0,0:07:59.77,0:08:01.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia kembali! Buka gerbangnya!
Dialogue: 0,0:08:10.86,0:08:12.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarlah, Leelee!
Dialogue: 0,0:08:12.82,0:08:15.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau memindahkan dinding Istana Shu
Dialogue: 0,0:08:15.24,0:08:16.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tanpa mengabari Selir Kekaisaran!
Dialogue: 0,0:08:16.95,0:08:18.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya apa maksudmu?
Dialogue: 0,0:08:18.58,0:08:20.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku yang mengurusnya.
Dialogue: 0,0:08:20.08,0:08:23.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada majikan\Nyang keluar mendahului dayangnya.
Dialogue: 0,0:08:23.21,0:08:24.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berbaringlah dan tunggu.
Dialogue: 0,0:08:24.96,0:08:26.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Apa maumu?
Dialogue: 0,0:08:26.75,0:08:29.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan dinding itu?
Dialogue: 0,0:08:29.46,0:08:30.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!
Dialogue: 0,0:08:30.46,0:08:33.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelaskan kenapa bisa begini!
Dialogue: 0,0:08:33.22,0:08:34.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, ampun, berisik sekali.
Dialogue: 0,0:08:34.76,0:08:38.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku penasaran bagaimana keadaan\NNyonya Keigetsu sekarang?{\i0}
Dialogue: 0,0:08:44.39,0:08:47.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Nyonya Keigetsu, kau bisa mendengarku?{\i0}
Dialogue: 0,0:08:47.86,0:08:50.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tolong, panggil aku.{\i0}
Dialogue: 0,0:08:51.07,0:08:52.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku ingin bicara denganmu.{\i0}
Dialogue: 0,0:08:59.99,0:09:02.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kou… Reirin…{\i0}
Dialogue: 0,0:09:03.41,0:09:07.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kau harus membantuku.{\i0}
Dialogue: 0,0:09:07.00,0:09:08.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Keigetsu!
Dialogue: 0,0:09:08.54,0:09:11.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini luar biasa!\NKita benar-benar terhubung!
Dialogue: 0,0:09:11.55,0:09:14.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita memang sangat akrab!
Dialogue: 0,0:09:14.63,0:09:17.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sepertinya kau selalu gembira.{\i0}
Dialogue: 0,0:09:18.51,0:09:19.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Keigetsu,
Dialogue: 0,0:09:19.93,0:09:24.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa kau minum semua obat\Nyang kuberikan kepadamu?
Dialogue: 0,0:09:24.10,0:09:25.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku meminumnya.
Dialogue: 0,0:09:25.39,0:09:29.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, semua sudah berakhir bagiku.
Dialogue: 0,0:09:29.98,0:09:33.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tousetsu tahu tentang pertukaran kita…
Dialogue: 0,0:09:34.24,0:09:35.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan dia bilang padaku…
Dialogue: 0,0:09:35.57,0:09:37.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika sayang nyawamu, tetap di sini!
Dialogue: 0,0:09:41.24,0:09:43.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sejak saat itu,\Ntidak ada yang mengunjungiku.{\i0}
Dialogue: 0,0:09:44.45,0:09:49.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang aku harus berpura-pura\Nmenjalani ritual pemurnian,
Dialogue: 0,0:09:49.25,0:09:50.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi itu pasti bohong!
Dialogue: 0,0:09:50.59,0:09:54.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku yakin dia sudah\Nmenyebarluaskan kebenarannya sekarang.
Dialogue: 0,0:09:54.88,0:09:57.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Yang Maha Mulia Permaisuri\Ndan Yang Mulia Gyoumei
Dialogue: 0,0:09:57.26,0:09:59.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}pasti akan mengeksekusiku!
Dialogue: 0,0:10:00.39,0:10:04.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Keigetsu,\Naku akan meyakinkan Tousetsu.
Dialogue: 0,0:10:04.81,0:10:07.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, sebelum semuanya terungkap,
Dialogue: 0,0:10:07.44,0:10:10.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagaimana kalau kita\Nbatalkan saja pertukarannya?
Dialogue: 0,0:10:11.73,0:10:13.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak akan jadi solusi!
Dialogue: 0,0:10:14.40,0:10:16.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Semua orang akan menyiksaku!
Dialogue: 0,0:10:16.32,0:10:20.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Aku akan disiksa dan dibunuh.{\i0}
Dialogue: 0,0:10:20.07,0:10:21.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Semua orang akan meninggalkanku.{\i0}
Dialogue: 0,0:10:24.24,0:10:26.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan berkata menyedihkan seperti itu.
Dialogue: 0,0:10:26.75,0:10:32.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya, aku ingin\Nmenyelesaikan masalah ini bersamamu.
Dialogue: 0,0:10:32.79,0:10:35.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, Nyonya Keigetsu,
Dialogue: 0,0:10:35.59,0:10:39.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada walimu, Selir Kekaisaran Shu,\Ndi sisimu.
Dialogue: 0,0:10:42.89,0:10:44.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selir Kekaisaran, katamu.
Dialogue: 0,0:10:48.10,0:10:49.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dengar.{\i0}
Dialogue: 0,0:10:50.06,0:10:54.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyakitku ini dan pertukaran kita,
Dialogue: 0,0:10:54.36,0:10:56.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu semua ulah Selir Kekaisaran Shu.
Dialogue: 0,0:10:56.61,0:10:57.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:11:21.88,0:11:24.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu sihir racun?
Dialogue: 0,0:11:24.76,0:11:26.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:11:26.47,0:11:30.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu saat serangga saling memakan\Nuntuk mendapatkan racun, 'kan?
Dialogue: 0,0:11:30.68,0:11:32.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Benar.{\i0}
Dialogue: 0,0:11:32.10,0:11:35.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, membuat serangga saling memakan{\i0}
Dialogue: 0,0:11:35.77,0:11:38.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}hanya menghasilkan semacam jimat kecil.{\i0}
Dialogue: 0,0:11:38.82,0:11:43.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dengan ritual tepat dan mantra yang asli,\Nbarulah ia punya kekuatan.{\i0}
Dialogue: 0,0:11:43.99,0:11:48.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku pernah menderita\Nkarena sihir racun seperti itu.{\i0}
Dialogue: 0,0:11:48.12,0:11:50.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu sebabnya aku pulih\Nbukan hanya berkat teh obat,{\i0}
Dialogue: 0,0:11:50.83,0:11:52.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tapi getaran senar Busur Pelindung.{\i0}
Dialogue: 0,0:11:53.37,0:11:57.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dengan kata lain,\Npenyakit ini sebenarnya kutukan.{\i0}
Dialogue: 0,0:11:58.09,0:11:59.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kutukan?
Dialogue: 0,0:11:59.42,0:12:02.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kutukan itu ditanam dalam pembakar dupa
Dialogue: 0,0:12:02.05,0:12:06.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang diberikan Kin Seika\Npadaku tepat setelah pertukaran.
Dialogue: 0,0:12:06.55,0:12:10.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun kenyataannya,\Nkurasa itu bukan hadiah dari klan Kin.
Dialogue: 0,0:12:12.60,0:12:16.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sama seperti jepit rambut yang kita yakini\Nperbuatan klan Kin.{\i0}
Dialogue: 0,0:12:16.56,0:12:20.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena teknik sihir racun itu,\NGaya Araknida,
Dialogue: 0,0:12:20.23,0:12:23.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya diketahui olehku\Ndan satu orang lagi.
Dialogue: 0,0:12:23.07,0:12:26.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang seorang lagi adalah…
Dialogue: 0,0:12:26.49,0:12:27.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shu Gabi.
Dialogue: 0,0:12:28.28,0:12:31.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menggunakan mantra\Nyang bersikeras dia pelajari dariku.
Dialogue: 0,0:12:32.20,0:12:34.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seseorang sebaik Selir Shu…
Dialogue: 0,0:12:34.83,0:12:36.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Setelah kupikir-pikir,
Dialogue: 0,0:12:36.75,0:12:40.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}salah satu komentarnya yang membuatku\Nmemutuskan melakukan pertukaran ini.
Dialogue: 0,0:12:41.30,0:12:46.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai saja kau bisa seperti\NNyonya Reirin. Benar, 'kan?
Dialogue: 0,0:12:47.47,0:12:52.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bertaruh jika kita bertukar tempat,\Nkita berdua akan segera mati.
Dialogue: 0,0:12:53.02,0:12:58.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kau di Penghakiman Singa dan aku\Nkarena tubuh yang lemah dan sihir racun.{\i0}
Dialogue: 0,0:12:58.98,0:13:00.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil.
Dialogue: 0,0:13:00.90,0:13:03.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti dia mengincarku\Nkarena aku dari klan lain,
Dialogue: 0,0:13:03.69,0:13:05.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kenapa dia juga mengincarmu?
Dialogue: 0,0:13:05.74,0:13:08.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar aku bungkam.
Dialogue: 0,0:13:08.49,0:13:13.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Dia hanya memilihku sebagai Gadis\Nkarena aku menguasai sihir terlarang.
Dialogue: 0,0:13:13.29,0:13:15.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Meski aku mati, dia sama sekali tak rugi.
Dialogue: 0,0:13:16.00,0:13:19.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lucu sekali.
Dialogue: 0,0:13:19.00,0:13:21.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang sebatang kara.
Dialogue: 0,0:13:22.34,0:13:26.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyedihkan, diperlakukan seenaknya.
Dialogue: 0,0:13:26.34,0:13:27.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Keigetsu.
Dialogue: 0,0:13:27.97,0:13:29.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keinginanku…
Dialogue: 0,0:13:30.14,0:13:33.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keinginanku saat\NFestival Angka Tujuh Ganda
Dialogue: 0,0:13:33.39,0:13:36.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}benar-benar seperti\Nyang kuteriakkan saat itu.
Dialogue: 0,0:13:36.98,0:13:40.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enyah kau, Wanita Menjengkelkan!
Dialogue: 0,0:13:41.52,0:13:45.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku berteriak pada diriku sendiri.
Dialogue: 0,0:13:48.16,0:13:49.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku…
Dialogue: 0,0:13:49.53,0:13:52.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ingin menghilang.
Dialogue: 0,0:13:52.08,0:13:54.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya aku ingin menjadi dirimu.
Dialogue: 0,0:13:55.20,0:13:58.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau, kupu-kupu yang dicintai semua orang.
Dialogue: 0,0:14:00.08,0:14:01.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku tidak bisa.
Dialogue: 0,0:14:03.50,0:14:04.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:14:05.59,0:14:07.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini…
Dialogue: 0,0:14:07.84,0:14:12.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}aku lebih membenci diriku\Ndibanding sebelum kita bertukar.
Dialogue: 0,0:14:13.26,0:14:15.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Kou Reirin…
Dialogue: 0,0:14:16.35,0:14:20.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kenapa kau tak membunuhku saja?
Dialogue: 0,0:14:25.65,0:14:27.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau memang terlalu ekstrem, ya.
Dialogue: 0,0:14:28.45,0:14:32.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kata lain,\Nkau ingin minta maaf padaku, 'kan?
Dialogue: 0,0:14:34.03,0:14:38.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau melewatkan kesempatan untuk minta maaf\Ndan menyuruhku membunuhmu.
Dialogue: 0,0:14:38.50,0:14:41.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau memang galak.
Dialogue: 0,0:14:41.00,0:14:43.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama seperti api…
Dialogue: 0,0:14:43.21,0:14:47.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau putri klan Shu sang pelayan api.
Dialogue: 0,0:14:48.42,0:14:50.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu yang kusuka darimu, Nyonya Keigetsu,
Dialogue: 0,0:14:50.97,0:14:53.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}caramu menunjukkan emosi dengan jelas.
Dialogue: 0,0:14:53.97,0:14:56.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:14:56.60,0:15:01.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya tenang melihatmu\Nmengekspresikan emosimu sesuka hati.
Dialogue: 0,0:15:01.98,0:15:05.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini wanita yang dijuluki\NTikus Got Istana Para Gadis!
Dialogue: 0,0:15:05.61,0:15:07.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin!
Dialogue: 0,0:15:07.11,0:15:11.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Keigetsu,\Nkenapa kau menilai dirimu begitu kejam?
Dialogue: 0,0:15:12.24,0:15:15.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada banyak hal baik tentangmu.
Dialogue: 0,0:15:15.16,0:15:17.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada!
Dialogue: 0,0:15:17.08,0:15:18.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada.
Dialogue: 0,0:15:19.04,0:15:21.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, kau bisa sihir terlarang, 'kan?
Dialogue: 0,0:15:21.96,0:15:24.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan dan keberanian
Dialogue: 0,0:15:24.17,0:15:27.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk melakukan hal memalukan\Nseperti bertukar tubuh.
Dialogue: 0,0:15:27.00,0:15:30.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Emosi yang begitu kuat\Nhingga terasa menyakitkan.
Dialogue: 0,0:15:30.67,0:15:32.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sedang menyindirku?
Dialogue: 0,0:15:35.05,0:15:37.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Juga ketabahan hati.
Dialogue: 0,0:15:37.26,0:15:40.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah berjuang melawan\Npenderitaan yang dirasakan tubuh itu.
Dialogue: 0,0:15:41.77,0:15:43.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau mengerti?
Dialogue: 0,0:15:43.98,0:15:48.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mencoba membunuhmu.
Dialogue: 0,0:15:48.28,0:15:49.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kau tidak bisa.
Dialogue: 0,0:15:51.36,0:15:58.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya, kau meminjamiku tubuh\Nyang sehat dan membuatku merasa beruntung.
Dialogue: 0,0:15:59.95,0:16:02.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Keigetsu,
Dialogue: 0,0:16:02.33,0:16:06.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau tidak berbakat memberi kemalangan\Npada orang lain!
Dialogue: 0,0:16:09.17,0:16:10.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sedang apa?
Dialogue: 0,0:16:10.63,0:16:13.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berpura-pura menjadi penjahat.
Dialogue: 0,0:16:13.13,0:16:16.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana? Bukankah rasa frustrasi\Nmembuatmu bersemangat?
Dialogue: 0,0:16:20.10,0:16:22.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketidakbecusanmu juga ada batasnya.
Dialogue: 0,0:16:24.90,0:16:26.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kou Reirin…
Dialogue: 0,0:16:27.52,0:16:28.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:16:29.44,0:16:32.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar merasa bersalah.
Dialogue: 0,0:16:33.53,0:16:35.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku yang harus minta maaf.
Dialogue: 0,0:16:36.74,0:16:39.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau harus menanggung penyakitku\Nselama hampir sepuluh hari.
Dialogue: 0,0:16:41.29,0:16:44.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang bisa bicara denganmu\Nseperti ini, Nyonya Keigetsu.
Dialogue: 0,0:16:45.54,0:16:47.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, setelah kita bertukar,
Dialogue: 0,0:16:47.54,0:16:50.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada orang yang berpura-pura menjadi\Ndayang klan Kin
Dialogue: 0,0:16:50.71,0:16:53.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk mencelakai "Shu Keigetsu".
Dialogue: 0,0:16:54.72,0:16:56.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang aku mengerti alasannya.
Dialogue: 0,0:16:57.76,0:16:59.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selir Kekaisaran.
Dialogue: 0,0:17:00.26,0:17:04.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku tak tahu\Nkenapa dia begitu bersikeras soal ini.
Dialogue: 0,0:17:04.35,0:17:06.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya, kukira dia ingin menyingkirkanmu
Dialogue: 0,0:17:06.65,0:17:08.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena kau menghalangi rencananya.
Dialogue: 0,0:17:09.44,0:17:11.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menghalangi rencananya.
Dialogue: 0,0:17:11.40,0:17:16.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, kini dia takut\Nkau akan mengungkap situasinya.{\i0}
Dialogue: 0,0:17:17.11,0:17:18.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkinkah?
Dialogue: 0,0:17:19.66,0:17:23.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuan sebenarnya Selir Kekaisaran\Nkemungkinan besar…
Dialogue: 0,0:17:24.46,0:17:26.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya! Ini gawat!
Dialogue: 0,0:17:26.33,0:17:27.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leelee?
Dialogue: 0,0:17:27.46,0:17:29.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia Gyoumei datang!
Dialogue: 0,0:17:29.17,0:17:30.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segera bersiap!
Dialogue: 0,0:17:30.34,0:17:31.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa?\N- Apa?
Dialogue: 0,0:17:31.25,0:17:34.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dia sudah menyadari\Npertukaran ini.
Dialogue: 0,0:17:34.51,0:17:37.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kurasa dia belum tahu.
Dialogue: 0,0:17:37.47,0:17:38.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Yang Mulia tahu,
Dialogue: 0,0:17:38.97,0:17:42.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia pasti langsung mendatangimu\Ndan mulai menyiksamu.
Dialogue: 0,0:17:42.97,0:17:44.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu ancaman?
Dialogue: 0,0:17:44.14,0:17:46.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, aku akan menanganinya.
Dialogue: 0,0:17:46.98,0:17:49.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama aku bersikap sepertimu…
Dialogue: 0,0:17:49.40,0:17:51.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, kutiup dulu, ya!
Dialogue: 0,0:17:52.98,0:17:55.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shu Keigetsu. Kau sudah bangun?
Dialogue: 0,0:17:55.61,0:17:57.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya, aku buka pintunya!
Dialogue: 0,0:17:59.36,0:18:02.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku sudah bangun!
Dialogue: 0,0:18:02.95,0:18:04.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku harus bersikap seperti penjahat!{\i0}
Dialogue: 0,0:18:04.75,0:18:07.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Bawa kemari.\N- Baik!
Dialogue: 0,0:18:07.12,0:18:09.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua kecuali dayang pribadinya, mundur.
Dialogue: 0,0:18:09.08,0:18:10.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, Yang Mulia.
Dialogue: 0,0:18:12.09,0:18:15.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti penjahat.
Dialogue: 0,0:18:15.09,0:18:16.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei…
Dialogue: 0,0:18:16.09,0:18:21.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih terluka,\Njadi rasanya menyakitkan menyambutmu.
Dialogue: 0,0:18:21.72,0:18:26.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Kau mengizinkan Shin-u, Kin Seika,\Ndan dayang Klan Kou masuk,
Dialogue: 0,0:18:26.81,0:18:28.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku tak boleh?
Dialogue: 0,0:18:29.39,0:18:33.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, penampilanku ini\Nhanya merusak pemandangan.
Dialogue: 0,0:18:33.44,0:18:35.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah semua ini?
Dialogue: 0,0:18:35.57,0:18:37.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat ini sangat suram.
Dialogue: 0,0:18:37.24,0:18:40.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak sesuram itu.
Dialogue: 0,0:18:40.74,0:18:42.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tempat terbaik!
Dialogue: 0,0:18:42.12,0:18:44.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di tempat seperti ini,
Dialogue: 0,0:18:44.12,0:18:46.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}luka biasa pun takkan sembuh.
Dialogue: 0,0:18:46.25,0:18:48.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini air Mata Air Naga Ungu
Dialogue: 0,0:18:48.50,0:18:51.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di bagian terdalam istana utama\Nyang sudah didoakan.
Dialogue: 0,0:18:51.21,0:18:53.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Gunakan untuk membersihkan lukamu.\N- Apa?
Dialogue: 0,0:18:53.96,0:18:57.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mata Air Naga Ungu yang airnya mistis?
Dialogue: 0,0:19:00.80,0:19:04.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar dari Shin-u,\Nkau menarik Busur Pelindung
Dialogue: 0,0:19:04.56,0:19:06.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai telapak tanganmu terluka.
Dialogue: 0,0:19:06.31,0:19:09.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau memberiku sesuatu\Nyang berharga seperti ini?
Dialogue: 0,0:19:09.64,0:19:11.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan salah paham.
Dialogue: 0,0:19:11.23,0:19:14.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadinya ini hadiah untuk Reirin,\Ntapi terlalu banyak.
Dialogue: 0,0:19:14.19,0:19:15.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:19:15.19,0:19:18.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu,\Naku mengambil air ini sendiri.
Dialogue: 0,0:19:21.45,0:19:23.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa, kau tidak mau?
Dialogue: 0,0:19:23.45,0:19:26.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Tidak, bukan begitu…
Dialogue: 0,0:19:27.41,0:19:28.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunjukkan padaku.
Dialogue: 0,0:19:32.04,0:19:33.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:19:33.58,0:19:37.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu… Luka gores?
Dialogue: 0,0:19:37.42,0:19:40.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa aku akan mengategorikannya\Nseperti itu.
Dialogue: 0,0:19:40.92,0:19:43.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini lebih parah dari luka gores biasa.
Dialogue: 0,0:19:43.30,0:19:44.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini tidak sakit?
Dialogue: 0,0:19:45.18,0:19:46.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana, ya…
Dialogue: 0,0:19:46.81,0:19:49.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang sedikit sakit.
Dialogue: 0,0:19:49.68,0:19:51.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:19:51.73,0:19:53.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kesakitan.
Dialogue: 0,0:19:53.65,0:19:55.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat kesakitan.
Dialogue: 0,0:19:55.02,0:19:56.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tertawa?
Dialogue: 0,0:19:56.90,0:19:58.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sikapmu sangat aneh belakangan ini.
Dialogue: 0,0:19:58.73,0:20:01.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak benar.
Dialogue: 0,0:20:09.20,0:20:11.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar demam Reirin mulai turun
Dialogue: 0,0:20:11.75,0:20:13.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}begitu getaran senar terdengar.
Dialogue: 0,0:20:13.92,0:20:16.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berterima kasih padamu,
Dialogue: 0,0:20:17.34,0:20:18.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan sedikit menyesal.
Dialogue: 0,0:20:19.55,0:20:22.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Terlepas dari perasaanku\Ntentang tindakanmu di masa lalu,{\i0}
Dialogue: 0,0:20:22.55,0:20:25.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku masih meragukan integritasmu\Ndan menghinamu.{\i0}
Dialogue: 0,0:20:26.14,0:20:28.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bersikap tidak tulus padamu.
Dialogue: 0,0:20:29.35,0:20:30.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:20:33.14,0:20:34.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:20:34.23,0:20:36.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melakukannya karena keinginanku.
Dialogue: 0,0:20:36.48,0:20:38.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak perlu berterima kasih
Dialogue: 0,0:20:38.36,0:20:41.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau meminta maaf karena itu, Yang Mulia.
Dialogue: 0,0:20:43.24,0:20:44.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau…
Dialogue: 0,0:20:44.28,0:20:45.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya?
Dialogue: 0,0:20:45.45,0:20:47.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah banyak berubah.
Dialogue: 0,0:20:48.99,0:20:51.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, gawat, Nyonya!
Dialogue: 0,0:20:51.83,0:20:53.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Air suci yang berharga itu
Dialogue: 0,0:20:53.87,0:20:56.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menetes dari kain ke pakaian Yang Mulia!
Dialogue: 0,0:20:56.12,0:20:58.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sampai ketahuan bertukar tubuh!
Dialogue: 0,0:20:59.75,0:21:02.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Benar, aku harus bersikap\Nseperti penjahat!{\i0}
Dialogue: 0,0:21:02.63,0:21:07.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kata-kata indah itu\Nhanya bohong belaka.
Dialogue: 0,0:21:07.14,0:21:13.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, putri dari Klan Kou\Nseharusnya merasa berterima kasih padaku.
Dialogue: 0,0:21:14.10,0:21:15.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa katamu?
Dialogue: 0,0:21:15.14,0:21:18.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia, kau terlalu melindunginya.
Dialogue: 0,0:21:18.81,0:21:22.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah sebagai penguasa Istana\NPara Gadis, kau harus bersikap adil?
Dialogue: 0,0:21:22.48,0:21:25.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku tersenyum pada kupu-kupu\Ndan tikus got,
Dialogue: 0,0:21:25.65,0:21:27.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukankah itu tidak adil?
Dialogue: 0,0:21:27.78,0:21:31.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau harus memanggilku begitu?
Dialogue: 0,0:21:31.45,0:21:34.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula,\Ntikus-tikus kecil itu manis, 'kan?
Dialogue: 0,0:21:34.37,0:21:38.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi kupu-kupu dan ngengat\Ntidak berbeda jauh.
Dialogue: 0,0:21:38.21,0:21:40.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menyebut Reirin ngengat?
Dialogue: 0,0:21:41.17,0:21:42.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi!
Dialogue: 0,0:21:43.21,0:21:45.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia, ada insiden di Istana Kou.
Dialogue: 0,0:21:45.42,0:21:46.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:21:46.63,0:21:47.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terjadi sesuatu pada Reirin?
Dialogue: 0,0:21:49.89,0:21:51.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permaisuri pingsan.
Dialogue: 0,0:21:52.93,0:21:54.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa katamu?
Dialogue: 0,0:21:54.31,0:21:58.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya gejalanya sama\Ndengan yang dialami Nyonya Kou Reirin.
Dialogue: 0,0:21:58.52,0:21:59.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama?
Dialogue: 0,0:21:59.65,0:22:02.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tiba-tiba jatuh sakit kemarin.
Dialogue: 0,0:22:03.15,0:22:05.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak bisa minum air lagi.
Dialogue: 0,0:22:05.44,0:22:07.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Yang Maha Mulia ingin merahasiakannya,{\i0}
Dialogue: 0,0:22:08.49,0:22:10.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ada laporan dari dayang
Dialogue: 0,0:22:10.49,0:22:12.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau ini tak bisa dirahasiakan lagi.
Dialogue: 0,0:22:12.37,0:22:13.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu penyakit menular?
Dialogue: 0,0:22:14.45,0:22:15.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:22:18.08,0:22:20.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin itu kutukan.
