Dialogue: 0,0:00:47.48,0:00:49.69,sign,,0000,0000,0000,,MEI 1927 KALENDER BERSATU
Dialogue: 0,0:00:52.08,0:00:55.08,sign,,0000,0000,0000,,TENTARA KEKAISARAN\NTERUS MERAIH KEMENANGAN...
Dialogue: 0,0:02:39.80,0:02:47.14,sign,,0000,0000,0000,,(Saga of Tanya the Evil 2)
Dialogue: 0,0:04:02.51,0:04:03.93,sign,,0000,0000,0000,,ANIMASI INI BERSIFAT FIKTIF
Dialogue: 0,0:04:03.93,0:04:05.52,sign,,0000,0000,0000,,ISI DRAMA TIDAK IDENTIK DENGAN DUNIA NYATA
Dialogue: 0,0:04:46.74,0:04:49.34,sign,,0000,0000,0000,,(Episode 4: Pertempuran Martil)
Dialogue: 0,0:14:54.95,0:15:00.96,sign,,0000,0000,0000,,(Saga of Tanya the Evil 2)
Dialogue: 0,0:17:52.06,0:17:56.67,sign,,0000,0000,0000,,SYARAT PERUNDINGAN YANG MENGUNGGULI
Dialogue: 0,0:17:57.13,0:17:59.55,sign,,0000,0000,0000,,GANTI RUGI YANG SANGAT BESAR
Dialogue: 0,0:18:13.94,0:18:15.94,sign,,0000,0000,0000,,KEKAISARAN, KANTOR PANGLIMA TERTINGGI
Dialogue: 0,0:23:36.26,0:23:40.02,sign,,0000,0000,0000,,(Episode Berikutnya: Lamaran Terburuk)
Dialogue: 0,0:01:20.90,0:01:24.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka kau\Nmeninggalkan pos selama operasi.
Dialogue: 0,0:01:24.59,0:01:26.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka kau akan masuk tanpa izin.
Dialogue: 0,0:01:28.68,0:01:31.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kau tahu arti kata "rahasia"?
Dialogue: 0,0:01:31.28,0:01:35.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan apa-apa. Aku hanya ingin\Nmengajakmu sarapan bersama.
Dialogue: 0,0:01:36.81,0:01:38.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bermalam di sini lagi?
Dialogue: 0,0:01:39.10,0:01:42.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski pulang ke rumah,\Njuga tidak ada siapa-siapa di sana.
Dialogue: 0,0:01:42.68,0:01:46.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istri dan putrimu masih\Ndi kampung halaman di selatan?
Dialogue: 0,0:01:46.62,0:01:47.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:01:47.52,0:01:50.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak menantu meninggal,\Nmereka terus berada di sana.
Dialogue: 0,0:01:50.68,0:01:53.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya suasana mereka belum membaik.
Dialogue: 0,0:01:54.83,0:01:57.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sudah siap secara mental,
Dialogue: 0,0:01:57.85,0:02:01.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi di Kekaisaran saat ini,\Ntragedi seperti ini sudah biasa.
Dialogue: 0,0:02:06.01,0:02:09.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak, kau bisa tinggal di rumahku.
Dialogue: 0,0:02:09.50,0:02:12.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa menyiapkan tempat tidur\Nyang lebih baik untukmu.
Dialogue: 0,0:02:12.01,0:02:13.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu.
Dialogue: 0,0:02:13.00,0:02:14.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidur di mana pun sama saja.
Dialogue: 0,0:02:16.43,0:02:18.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Operasi sudah dimulai.
Dialogue: 0,0:02:19.27,0:02:22.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah serangan balik besar-besaran\Nyang mempertaruhkan segalanya.
Dialogue: 0,0:02:23.96,0:02:25.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun juga,
Dialogue: 0,0:02:25.40,0:02:27.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kuharap ini bisa menjadi akhir\Ndari segalanya.
Dialogue: 0,0:02:29.75,0:02:30.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:04:04.80,0:04:05.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak masalah.
Dialogue: 0,0:04:05.52,0:04:06.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada kekuatan udara musuh\Nyang terdeteksi di wilayah udara ini.
Dialogue: 0,0:04:06.14,0:04:06.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada kekuatan udara musuh\Nyang terdeteksi di wilayah udara ini.
Dialogue: 0,0:04:06.89,0:04:11.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak menerima syarat gencatan senjata\N"tanpa ganti rugi, tanpa penyerahan wilayah, tanpa syarat".
Dialogue: 0,0:04:11.69,0:04:13.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah kesimpulan dari atasan.
Dialogue: 0,0:04:14.13,0:04:15.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,
Dialogue: 0,0:04:15.51,0:04:18.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita harus mendapatkan\Npersyaratan yang lebih baik.
Dialogue: 0,0:04:19.34,0:04:21.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jaminan keamanan adalah prioritas utama.
Dialogue: 0,0:04:21.87,0:04:25.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menetapkan zona demiliterisasi\Nsebagai zona penyangga.
Dialogue: 0,0:04:25.13,0:04:27.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika memungkinkan,\Nsekalian mengusahakan ganti rugi.
Dialogue: 0,0:04:27.40,0:04:30.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melanjutkan negosiasi memang baik,
Dialogue: 0,0:04:30.26,0:04:32.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ternyata karena\Npertimbangan politik...
Dialogue: 0,0:04:32.57,0:04:35.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah keputusan\Ndari Kantor Panglima Tertinggi.
Dialogue: 0,0:04:35.10,0:04:37.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kalian sebagai pelaksana\Nmungkin memiliki pendapat lain,
Dialogue: 0,0:04:37.69,0:04:39.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi mohon dimaklumi.
Dialogue: 0,0:04:39.59,0:04:40.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya sudah tiba.
Dialogue: 0,0:04:46.74,0:04:49.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita mulai.
Dialogue: 0,0:04:56.85,0:04:58.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah perintah pembukaan segel\Ndari markas komando.
Dialogue: 0,0:05:00.42,0:05:01.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:05:01.53,0:05:03.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya apa lagi yang diperintahkan?
Dialogue: 0,0:05:06.94,0:05:08.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lintas udara?
Dialogue: 0,0:05:08.20,0:05:09.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar sembarangan.
Dialogue: 0,0:05:09.84,0:05:11.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terlalu jauh dari jembatan...
Dialogue: 0,0:05:12.50,0:05:13.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumpulkan semua perwira.
Dialogue: 0,0:05:13.86,0:05:15.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang juga.
Dialogue: 0,0:05:15.54,0:05:16.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diterima.
Dialogue: 0,0:05:20.04,0:05:22.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal garis depan saja belum dirapikan.
Dialogue: 0,0:05:22.75,0:05:27.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun maju ke garis depan,\Nhanya akan dipukul mundur lagi.
Dialogue: 0,0:05:27.18,0:05:30.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, masalah pasokan\Njuga belum teratasi.
Dialogue: 0,0:05:30.63,0:05:33.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira perundingan damai tanpa syarat\Nsudah disepakati.
Dialogue: 0,0:05:33.71,0:05:36.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alhasil, sampai tahap ini masih\Nmelancarkan serangan besar-besaran.
Dialogue: 0,0:05:37.03,0:05:38.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mayor.
Dialogue: 0,0:05:38.11,0:05:41.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang harus kulakukan\Ndalam operasi ini?
Dialogue: 0,0:05:41.73,0:05:42.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang istimewa.
Dialogue: 0,0:05:42.50,0:05:45.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu berpikir terlalu rumit.
Dialogue: 0,0:05:45.47,0:05:48.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau disuruh maju, majulah.\NKalau disuruh mundur, mundurlah.
Dialogue: 0,0:05:48.84,0:05:52.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kita sibuk sendiri,\Npertempuran sudah selesai.
Dialogue: 0,0:05:54.45,0:05:58.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perwira yang terlatih benar-benar\Nbisa cepat menyesuaikan mental.
Dialogue: 0,0:05:59.37,0:06:02.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat bertempur, memang harus\Nmakan yang manis-manis.
Dialogue: 0,0:06:02.62,0:06:04.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, dimakan sendiri. Licik sekali.
Dialogue: 0,0:06:06.95,0:06:09.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tunggu. Kau menghabiskan semuanya...
Dialogue: 0,0:06:09.62,0:06:12.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga harus belajar dari mereka.
Dialogue: 0,0:06:13.00,0:06:15.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, perundingan damai\Njuga bukan sepenuhnya gagal.
Dialogue: 0,0:06:15.99,0:06:18.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya perlu melakukan\Ntugasku dengan baik.
Dialogue: 0,0:06:20.62,0:06:22.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, maaf membuat kalian menunggu.
Dialogue: 0,0:06:22.65,0:06:23.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:06:24.12,0:06:28.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuan operasi kali ini adalah mengepung\Ndan menghancurkan tentara lapangan musuh.
Dialogue: 0,0:06:28.70,0:06:31.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menghancurkan total\Npasukan utama Federasi.
Dialogue: 0,0:06:31.22,0:06:34.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merampas kemampuan mereka\Nuntuk melanjutkan perang.
Dialogue: 0,0:06:35.06,0:06:40.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kunci dari operasi ini adalah menjadikan\Nsungai besar di belakang musuh sebagai penghalang raksasa.
Dialogue: 0,0:06:40.90,0:06:43.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar sungai besar ini berfungsi,
Dialogue: 0,0:06:43.12,0:06:46.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasukan lintas udara\Nsudah menyelesaikan pendaratan,
Dialogue: 0,0:06:46.06,0:06:48.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan melakukan blokade\Ndi beberapa jembatan.
Dialogue: 0,0:06:49.21,0:06:53.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, pasukan lintas udara yang\Ndikirim duluan juga terus memberi bantuan.
Dialogue: 0,0:06:53.36,0:06:56.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih lanjut memblokir total rute\Ndan pasokan musuh.
Dialogue: 0,0:06:56.27,0:07:00.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, musuh juga akan mati-matian\Nmerebut kembali jembatan.
Dialogue: 0,0:07:00.57,0:07:04.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun, kita harus mendukung\Npasukan lintas udara//untuk mempertahankan jembatan.
Dialogue: 0,0:07:05.08,0:07:08.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oleh karena itu, selanjutnya adalah\Ninti dari taktik gerak cepat.
Dialogue: 0,0:07:08.18,0:07:12.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Martil" yang mengutamakan//kekuatan tempur lapis baja,\Nmenembus wilayah pertempuran musuh
Dialogue: 0,0:07:12.16,0:07:14.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bergabung dengan pasukan udara\Ndi belakang garis musuh.
Dialogue: 0,0:07:14.90,0:07:17.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memutus total jalur mundur\Ndan jalur pasokan musuh.
Dialogue: 0,0:07:17.78,0:07:20.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memblokir dan mengepung\Ntentara lapangan musuh.
Dialogue: 0,0:07:20.39,0:07:21.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu,
Dialogue: 0,0:07:21.19,0:07:25.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasukan sekutu akan menghancurkan total\NTentara Federal yang terkepung.
Dialogue: 0,0:07:25.36,0:07:29.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hingga para petinggi Federasi itu\Ntidak berani lagi melancarkan perang.
Dialogue: 0,0:07:30.35,0:07:34.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tugas kita dalam operasi ini\Nadalah menjadi pelopor serangan.
Dialogue: 0,0:07:34.59,0:07:36.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yaitu "Tim Penembus Pusat".
Dialogue: 0,0:07:37.18,0:07:40.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau lambat, para pasukan lintas udara\Nmungkin akan dimusnahkan seluruhnya.
Dialogue: 0,0:07:40.44,0:07:42.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanggung jawabnya bisa dibilang\Nsangat besar.
Dialogue: 0,0:07:43.85,0:07:44.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letnan Kolonel.
Dialogue: 0,0:07:44.92,0:07:47.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taktik gerak cepat harus menguasai\Nsupremasi udara terlebih dahulu.
Dialogue: 0,0:07:47.96,0:07:50.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tidak dapat bergerak\Njika ada ancaman serangan udara.
Dialogue: 0,0:07:51.23,0:07:52.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:07:52.54,0:07:55.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya, pasukan sekutu sudah berhasil\Nmerebut supremasi udara.
Dialogue: 0,0:07:55.84,0:07:57.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun begitu,
Dialogue: 0,0:07:57.13,0:07:59.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jaringan pertahanan musuh sangat ketat.
Dialogue: 0,0:07:59.26,0:08:01.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun mereka tidak membangun\Ngaris pertahanan perang parit,
Dialogue: 0,0:08:01.71,0:08:03.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi bagaimana kita menerobos?
Dialogue: 0,0:08:04.27,0:08:05.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, lihat ke sini.
Dialogue: 0,0:08:08.47,0:08:12.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah ini peta wilayah yurisdiksi\NTentara Federal?
Dialogue: 0,0:08:12.30,0:08:13.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:08:13.44,0:08:15.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para personel intelijen\Ndi Markas Besar Staf Umum,
Dialogue: 0,0:08:15.87,0:08:18.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tampaknya ingin kita menembus celah\Ndi antara wilayah pertempuran musuh.
Dialogue: 0,0:08:19.88,0:08:23.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bergerak dalam skala Kampfgruppe\Ndi celah formasi musuh,
Dialogue: 0,0:08:23.85,0:08:26.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apakah benar-benar bisa dilakukan?
Dialogue: 0,0:08:26.01,0:08:28.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita juga tidak akan mendapat dukungan\Ndari pasukan sekutu, 'kan?
Dialogue: 0,0:08:28.79,0:08:31.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti kekhawatiran kalian semua.
Dialogue: 0,0:08:31.34,0:08:33.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku memutuskan untuk\Nmenggunakan sedikit trik.
Dialogue: 0,0:08:34.48,0:08:36.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Trik?
Dialogue: 0,0:08:38.75,0:08:41.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tepat sekali, Kapten Ahrens.
Dialogue: 0,0:08:41.61,0:08:43.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun caranya,
Dialogue: 0,0:08:43.10,0:08:46.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pastikan kau mengantarkan kami\Ndengan selamat ke tepi sungai.
Dialogue: 0,0:08:48.92,0:08:53.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duduk di atas tank kavaleri\Nlebih sakit dari yang kubayangkan.
Dialogue: 0,0:08:53.34,0:08:54.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:08:54.95,0:08:58.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, selama kita menekan\Nreaksi sihir yang dihasilkan saat terbang,
Dialogue: 0,0:08:58.82,0:09:02.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maka bisa mengalihkan perhatian musuh\Nke unit archmage lainnya.
Dialogue: 0,0:09:02.65,0:09:06.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Tentara Federal hanya waspada\Nterhadap para archmage di langit,
Dialogue: 0,0:09:06.51,0:09:09.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maka tingkat keberhasilan penerobosan kita\Nmeningkat drastis.
Dialogue: 0,0:09:09.31,0:09:11.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, jarak pandang pengintaian\Njuga cukup baik.
Dialogue: 0,0:09:13.58,0:09:15.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuh datang!
Dialogue: 0,0:09:15.64,0:09:16.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arah jam 3.
Dialogue: 0,0:09:21.90,0:09:24.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sekeliling adalah posisi musuh.
Dialogue: 0,0:09:25.06,0:09:27.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sampai ketahuan musuh,
Dialogue: 0,0:09:27.23,0:09:29.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami yang tidak berlapis baja ini\Nadalah sasaran empuk.
Dialogue: 0,0:09:39.45,0:09:40.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uwaa.
Dialogue: 0,0:09:41.00,0:09:42.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pegangan yang kuat.
Dialogue: 0,0:10:32.07,0:10:34.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arah jam 1, penyergapan musuh.
Dialogue: 0,0:10:38.44,0:10:40.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-tunggu, jangan tembak!
Dialogue: 0,0:10:41.37,0:10:42.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Helm itu...
Dialogue: 0,0:10:42.61,0:10:43.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kawan kita.
Dialogue: 0,0:10:43.67,0:10:45.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu adalah pasukan lintas udara kita.
Dialogue: 0,0:10:45.65,0:10:47.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, lambaikan topi!
Dialogue: 0,0:10:47.35,0:10:48.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat!
Dialogue: 0,0:10:55.36,0:10:57.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kawan seperjuangan.\N- Sungguh hebat kalian bisa bertahan.
Dialogue: 0,0:10:57.99,0:10:58.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:10:58.80,0:11:00.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian akhirnya datang.
Dialogue: 0,0:11:01.02,0:11:04.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku adalah komandan tertinggi Kampfgruppe,\NLetnan Kolonel Degurechaff.
Dialogue: 0,0:11:04.96,0:11:06.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kalian butuh pasokan?
Dialogue: 0,0:11:06.81,0:11:10.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami terisolasi hampir tiga hari,\Namunisi sudah menipis.
Dialogue: 0,0:11:11.10,0:11:12.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan segera kuatur.
Dialogue: 0,0:11:12.88,0:11:14.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedengarannya seperti pertukaran,
Dialogue: 0,0:11:14.75,0:11:16.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi tolong berikan sedikit air\Nuntuk kami.
Dialogue: 0,0:11:17.31,0:11:18.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Air?
Dialogue: 0,0:11:18.90,0:11:20.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian bisa ambil sebanyak\Nyang kalian mau, 'kan?
Dialogue: 0,0:11:20.81,0:11:23.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu barang rampasan perang\Nyang kalian dapatkan, 'kan?
Dialogue: 0,0:11:25.05,0:11:28.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita barter dengan air dan amunisi.
Dialogue: 0,0:11:29.54,0:11:30.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang benar.
Dialogue: 0,0:11:30.69,0:11:32.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu memang barang rampasan perang kami.
Dialogue: 0,0:11:33.16,0:11:35.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti kita foto kenang-kenangan.
Dialogue: 0,0:11:35.78,0:11:36.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:11:36.61,0:11:39.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan siapkan peralatan kameranya.
Dialogue: 0,0:11:39.97,0:11:41.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhasil menerobos.
Dialogue: 0,0:11:41.13,0:11:45.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Resimen pasukan lintas udara keenam telah\Nbergabung dengan Kampfgruppe Rerugen.
Dialogue: 0,0:11:45.01,0:11:46.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kampfgruppe Rerugen?
Dialogue: 0,0:11:47.20,0:11:50.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, itu adalah kode rahasia\Nuntuk Kampfgruppe Salamander.
Dialogue: 0,0:11:50.93,0:11:53.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seluruh pasukan segera beralih\Nke pertempuran pengepungan.
Dialogue: 0,0:11:53.43,0:11:55.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini sudah mulai bergerak.
Dialogue: 0,0:11:55.80,0:11:57.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, manfaatkan kesempatan.
Dialogue: 0,0:11:57.88,0:11:59.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya adalah bagian puncaknya.
Dialogue: 0,0:11:59.67,0:12:01.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus menggagalkan upaya pembebasan musuh.
Dialogue: 0,0:12:02.20,0:12:06.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu cara tercepat adalah langsung\Nhancurkan pusat pasukan//penyerang balik, 'kan?
Dialogue: 0,0:12:06.85,0:12:09.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau langsung menyerbu markas komando?
Dialogue: 0,0:12:09.04,0:12:11.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang ini, unit mana yang masih\Npunya kemampuan seperti itu?
Dialogue: 0,0:12:11.80,0:12:14.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pura-pura, Zettour.
Dialogue: 0,0:12:14.46,0:12:19.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kita memelihara seekor anjing pemburu di timur\Nyang paling cocok untuk menangani tugas seperti ini?
Dialogue: 0,0:12:20.83,0:12:21.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang itu?
Dialogue: 0,0:12:22.53,0:12:23.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:12:27.18,0:12:29.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Garis pertahanan musuh ternyata\Njauh lebih kokoh dari yang dibayangkan.
Dialogue: 0,0:12:29.23,0:12:30.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana-mana mengalami pertempuran sengit.
Dialogue: 0,0:12:31.00,0:12:31.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial.
Dialogue: 0,0:12:31.88,0:12:34.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Markas Besar Staf Umum masih saja\Ntidak menganggap orang sebagai manusia.
Dialogue: 0,0:12:34.99,0:12:36.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mundur sementara!
Dialogue: 0,0:12:36.21,0:12:38.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mayor Weiß, laporkan kerugian tempur.
Dialogue: 0,0:12:38.47,0:12:39.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Delapan orang luka ringan.
Dialogue: 0,0:12:39.65,0:12:43.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang paling parah adalah prajurit konyol\Nyang kena tembak di pantat.
Dialogue: 0,0:12:43.05,0:12:44.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mempengaruhi operasi.
Dialogue: 0,0:12:45.35,0:12:46.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada pengaruhnya.
Dialogue: 0,0:12:47.31,0:12:50.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kita harus diperas dengan\Npekerjaan tambahan seperti ini?
Dialogue: 0,0:12:53.44,0:12:55.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mempertimbangkan kemungkinan\Nadanya bala bantuan musuh,
Dialogue: 0,0:12:55.59,0:12:57.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita mundur dari sini.
Dialogue: 0,0:12:58.00,0:13:00.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski berhasil menembus garis pertahanan\Ndan menemukan markas komando,
Dialogue: 0,0:13:00.91,0:13:03.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}juga tidak bisa menjamin\Nitu adalah markas komando yang asli.
Dialogue: 0,0:13:03.95,0:13:06.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksud Anda...
Dialogue: 0,0:13:06.09,0:13:08.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinan besar itu palsu.
Dialogue: 0,0:13:08.68,0:13:10.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kata lain, itu adalah jebakan.
Dialogue: 0,0:13:10.10,0:13:11.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti jebakan.
Dialogue: 0,0:13:12.14,0:13:15.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ingin kita menjadi sapi yang langsung\Nmenerjang kain merah?
Dialogue: 0,0:13:15.74,0:13:16.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uh.
Dialogue: 0,0:13:16.75,0:13:19.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski benar-benar beruntung\Ndan menemukan markas komando musuh,
Dialogue: 0,0:13:19.63,0:13:22.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apakah itu benar-benar markas komando?
Dialogue: 0,0:13:22.76,0:13:23.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tidak mungkin itu palsu?
Dialogue: 0,0:13:24.40,0:13:25.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oleh karena itu,
Dialogue: 0,0:13:25.35,0:13:30.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita tetap dalam formasi serangan darat, sambil mundur, kita\Nberusaha mencari dan menghancurkan musuh semaksimal mungkin.
Dialogue: 0,0:13:30.16,0:13:31.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sambil mencari, sambil mundur, ya.
Dialogue: 0,0:13:35.10,0:13:37.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun pekerjaan memang\Nharus dilaksanakan,
Dialogue: 0,0:13:37.64,0:13:39.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi juga harus dalam batas\Nimbalan yang wajar...
Dialogue: 0,0:13:39.50,0:13:41.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketemu, arah jam 8!
Dialogue: 0,0:13:42.04,0:13:42.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:13:44.16,0:13:45.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini markas komando musuh.
Dialogue: 0,0:13:45.79,0:13:47.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak diragukan lagi.
Dialogue: 0,0:13:47.34,0:13:50.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-benar-benar ketemu.
Dialogue: 0,0:13:50.04,0:13:54.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si bodoh itu, padahal sering salah lihat,\Ntapi sekarang malah menemukannya.
Dialogue: 0,0:13:55.13,0:13:56.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letnan Kolonel.
Dialogue: 0,0:13:56.44,0:13:58.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan berubah menjadi sapi, ya?
Dialogue: 0,0:13:59.21,0:13:59.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hii.
Dialogue: 0,0:14:00.38,0:14:01.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial.
Dialogue: 0,0:14:05.48,0:14:06.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri tahu ke seluruh anggota pasukan.
Dialogue: 0,0:14:06.83,0:14:11.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan yang beroperasi di dekat musuh\Ndan markas komando harus segera mundur.
Dialogue: 0,0:14:11.07,0:14:12.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat bergerak!
Dialogue: 0,0:14:15.02,0:14:16.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bajingan sialan!
Dialogue: 0,0:14:20.62,0:14:22.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Markas komando musuh\Nmengalami kerusakan parah.
Dialogue: 0,0:14:22.11,0:14:24.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kampfgruppe Rerugen berhasil melakukannya.
Dialogue: 0,0:14:26.78,0:14:27.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus sekali!
Dialogue: 0,0:14:28.82,0:14:31.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya terpantau tanda-tanda\Nmusuh mundur secara terorganisir,
Dialogue: 0,0:14:32.54,0:14:36.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kita mencegah mereka mundur total\Ndari jaring pengepungan.
Dialogue: 0,0:14:36.91,0:14:40.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk situasi saat ini,\Nini sudah merupakan hasil terbaik.
Dialogue: 0,0:14:41.31,0:14:42.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya!
Dialogue: 0,0:14:42.62,0:14:45.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita berhasil.
Dialogue: 0,0:14:45.56,0:14:47.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letnan Jenderal Rudersdorf.
Dialogue: 0,0:14:47.45,0:14:49.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Selamat.\N- Kita menang.
Dialogue: 0,0:14:50.39,0:14:51.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:14:52.10,0:14:53.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menang sekali lagi.
Dialogue: 0,0:15:05.52,0:15:07.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hai, Letnan Kolonel Degurechaff.
Dialogue: 0,0:15:07.90,0:15:10.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah ini Kolonel Calandro?
Dialogue: 0,0:15:10.64,0:15:12.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda melakukannya dengan sangat baik.
Dialogue: 0,0:15:13.04,0:15:15.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Federasi dipukul telak seperti ini,
Dialogue: 0,0:15:15.26,0:15:17.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}gencatan senjata seharusnya\Nhanya tinggal menunggu waktu.
Dialogue: 0,0:15:17.03,0:15:21.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ada juga laporan yang menunjukkan beberapa jembatan\Ndirebut dan membiarkan mereka mundur secara terorganisir.
Dialogue: 0,0:15:22.09,0:15:24.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa. Ada yang lolos\Nadalah hal yang tidak bisa dihindari.
Dialogue: 0,0:15:24.81,0:15:26.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun juga,
Dialogue: 0,0:15:26.17,0:15:28.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sepertinya pertempuran ini harus berlanjut\Nsampai perundingan damai benaran terwujud.
Dialogue: 0,0:15:29.34,0:15:30.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun.
Dialogue: 0,0:15:31.15,0:15:33.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetap waspada memang hal yang baik.
Dialogue: 0,0:15:35.32,0:15:38.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua, mau foto kenang-kenangan?
Dialogue: 0,0:15:40.00,0:15:40.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:15:40.94,0:15:42.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak perlu.
Dialogue: 0,0:15:42.57,0:15:43.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah kemenangan negara Anda.
Dialogue: 0,0:15:44.62,0:15:45.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku permisi dulu.
Dialogue: 0,0:15:48.24,0:15:49.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Letnan Kolonel.
Dialogue: 0,0:15:49.75,0:15:50.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat pose.
Dialogue: 0,0:15:51.19,0:15:53.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong senyumnya lebih natural lagi.
Dialogue: 0,0:15:53.40,0:15:53.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hehe.
Dialogue: 0,0:15:53.93,0:15:55.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senyum sedikit lagi.
Dialogue: 0,0:15:55.00,0:15:57.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hehe.
Dialogue: 0,0:16:00.16,0:16:03.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah ini sudah sedikit menebus dosa?
Dialogue: 0,0:16:18.10,0:16:22.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begini, kenaikanmu menjadi\NMarsekal juga tinggal menunggu waktu, ya?
Dialogue: 0,0:16:22.46,0:16:24.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu menyenangkan mendengarmu\Nberkata seperti itu,
Dialogue: 0,0:16:24.69,0:16:27.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kau juga seharusnya\Nmenikmati kehormatan ini.
Dialogue: 0,0:16:27.37,0:16:30.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tidak. Semua orang tahu\Nsiapa yang memegang kendali.
Dialogue: 0,0:16:31.00,0:16:32.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sahabatku.
Dialogue: 0,0:16:32.00,0:16:34.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaulah yang menyelesaikan semua ini.
Dialogue: 0,0:16:34.04,0:16:35.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berbanggalah.
Dialogue: 0,0:16:37.03,0:16:39.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Haruskah aku berterima kasih?
Dialogue: 0,0:16:40.26,0:16:41.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepadaku?
Dialogue: 0,0:16:41.83,0:16:43.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau kepada para prajurit?
Dialogue: 0,0:16:43.86,0:16:45.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya kepada para prajurit, 'kan?
Dialogue: 0,0:16:46.84,0:16:50.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang ini, bahkan bergerak maju\Nke Moskow pun bisa menjadi pilihan.
Dialogue: 0,0:16:52.81,0:16:55.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu hanya secara teori saja.
Dialogue: 0,0:16:56.26,0:16:59.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah pasokan logistik\Nmemang masih sangat terbatas?
Dialogue: 0,0:17:00.09,0:17:02.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rekonstruksi jaringan kereta api\Nmembuat putus asa.
Dialogue: 0,0:17:02.98,0:17:05.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun, negosiasi gencatan senjata\Ntetap jadi prioritas utama, 'kan?
Dialogue: 0,0:17:06.46,0:17:10.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru saja menerima\Nlaporan dari Kolonel Rerugen.
Dialogue: 0,0:17:11.03,0:17:13.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gencatan senjata hanyalah masalah waktu.
Dialogue: 0,0:17:13.54,0:17:17.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabarnya, pihak Federal juga sedang\Nmenyempurnakan usulan perundingan…
Dialogue: 0,0:17:17.02,0:17:18.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:17:18.02,0:17:22.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada pesan, Kantor Panglima Tertinggi\Nakan mengadakan rapat darurat.
Dialogue: 0,0:17:25.52,0:17:28.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun berhasil mempertahankan\Nkekuatan tempur,
Dialogue: 0,0:17:28.64,0:17:30.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi situasi menjadi canggung begini...
Dialogue: 0,0:17:30.78,0:17:34.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang salah\Njika Biro Politik ingin berdamai,
Dialogue: 0,0:17:34.55,0:17:37.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi haruskah aku melepaskan\Nperi kecil kesayanganku begitu saja?
Dialogue: 0,0:17:43.31,0:17:44.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh?
Dialogue: 0,0:17:45.40,0:17:47.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, aduh, aduh?
Dialogue: 0,0:17:52.06,0:17:54.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Kekaisaran terbuai dalam kemenangan?
Dialogue: 0,0:17:54.68,0:17:56.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak memahami situasi di dalam negeri,
Dialogue: 0,0:17:56.67,0:17:59.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dipermainkan oleh trik propaganda?
Dialogue: 0,0:17:59.76,0:18:04.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun. Politik rakyat bodoh\Nyang tidak beradab memang seperti ini.
Dialogue: 0,0:18:05.77,0:18:08.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita memang seharusnya\Nbertempur di level politik.
Dialogue: 0,0:18:09.20,0:18:10.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh.
Dialogue: 0,0:18:10.44,0:18:13.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalan cinta memang harus ada\Nyang memberi semangat.
Dialogue: 0,0:18:16.22,0:18:20.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seluruh pasukan melakukan gencatan senjata\Ndengan garis batas militer tahap saat ini sebagai perbatasan.
Dialogue: 0,0:18:20.35,0:18:23.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wilayah yang saat ini diduduki dianggap\Nsebagai wilayah pemerintahan sementara.
Dialogue: 0,0:18:23.45,0:18:25.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak dilakukan pemindahan hak wilayah.
Dialogue: 0,0:18:26.00,0:18:29.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wilayah seluas puluhan kilometer di sepanjang perbatasan\Nditetapkan sebagai zona demiliterisasi.
Dialogue: 0,0:18:29.12,0:18:31.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wilayah Federasi yang saat ini\Ndiduduki Kekaisaran,
Dialogue: 0,0:18:31.69,0:18:35.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menerima pengawasan beberapa negara\Ndengan syarat agar penduduknya dapat
Dialogue: 0,0:18:35.05,0:18:36.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}melakukan referendum\Nmengenai afiliasi dan kemerdekaan.
Dialogue: 0,0:18:36.97,0:18:39.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan pemungutan suara dilaksanakan\Nsaat perjanjian damai disepakati.
Dialogue: 0,0:18:39.53,0:18:43.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kesepakatan diplomatik yang dicapai\Npihak militer melalui Yirudoya, 'kan?
Dialogue: 0,0:18:43.82,0:18:44.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:18:44.76,0:18:46.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:18:48.58,0:18:52.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda berpikir bahwa hal seperti ini\Nbisa dianggap syarat menguntungkan?
Dialogue: 0,0:18:53.23,0:18:54.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:18:54.48,0:18:55.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:18:55.74,0:19:00.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Militer merasa syarat ini adalah\Npilihan terbaik dan menyatakan dukungan.
Dialogue: 0,0:19:00.34,0:19:04.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan kelancanganku, apakah Anda masih\Npantas disebut sebagai prajurit Kekaisaran?
Dialogue: 0,0:19:04.35,0:19:06.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana mungkin berdamai\Ndengan syarat seperti ini...
Dialogue: 0,0:19:06.49,0:19:08.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syarat seperti ini?
Dialogue: 0,0:19:08.09,0:19:10.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru karena ada pengorbanan\Npara prajurit,
Dialogue: 0,0:19:10.36,0:19:13.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita bisa membuat pihak lawan\Nmenerima syarat seperti ini.
Dialogue: 0,0:19:13.69,0:19:17.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya Anda belum menguasai\Nopini publik di dalam negeri.
Dialogue: 0,0:19:17.09,0:19:21.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rakyat tidak mungkin menerima gencatan senjata\Natau perundingan damai dengan syarat seperti ini.
Dialogue: 0,0:19:21.45,0:19:24.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerugian yang dialami Kekaisaran\Nsangat besar.
Dialogue: 0,0:19:24.31,0:19:26.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak menuntut ganti rugi,\Nkeuangan negara akan...
Dialogue: 0,0:19:26.68,0:19:28.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin akan runtuh, 'kan?
Dialogue: 0,0:19:28.75,0:19:31.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih parah lagi, mungkin bisa\Nmembahayakan institusi negara.
Dialogue: 0,0:19:31.70,0:19:35.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika harus berbicara terus terang\Nmeskipun berisiko tidak sopan,
Dialogue: 0,0:19:35.77,0:19:38.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin ketenangan keluarga kekaisaran pun\Nakan sulit dipertahankan.
Dialogue: 0,0:19:39.20,0:19:40.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia.
Dialogue: 0,0:19:40.32,0:19:42.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu adalah pernyataan yang tidak pantas.
Dialogue: 0,0:19:42.11,0:19:45.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai seorang prajurit, yang harus\Nditakuti hanyalah musuh dari luar.
Dialogue: 0,0:19:45.80,0:19:49.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika karena takut akan kekacauan internal,\Nmengabaikan urusan negara yang penting,
Dialogue: 0,0:19:49.80,0:19:51.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagaimana kalau langsung memicu\Nkerusuhan internal saja?
Dialogue: 0,0:19:53.04,0:19:55.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letnan Jenderal Rudersdorf.
Dialogue: 0,0:19:55.17,0:19:58.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin bertanya kepada Yang Mulia\Nsebagai penanggung jawab operasi.
Dialogue: 0,0:19:58.72,0:20:03.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa menurut Anda Pasukan Kekaisaran sudah\Ntidak bisa meraih kemenangan lebih besar?
Dialogue: 0,0:20:04.35,0:20:06.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus terang,
Dialogue: 0,0:20:06.37,0:20:08.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin sulit.
Dialogue: 0,0:20:08.23,0:20:09.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit?
Dialogue: 0,0:20:10.08,0:20:11.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:20:11.28,0:20:12.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit.
Dialogue: 0,0:20:12.75,0:20:14.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan tidak mungkin, 'kan?
Dialogue: 0,0:20:15.76,0:20:20.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tugas kita sebagai prajurit adalah\Nmelindungi tanah air dari serangan musuh.
Dialogue: 0,0:20:21.19,0:20:25.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai saat ini, sudah banyak prajurit\Nyang gugur karenanya.
Dialogue: 0,0:20:26.28,0:20:29.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak yakin apakah pantas membayar\Ndengan lebih banyak pengorbanan.
Dialogue: 0,0:20:30.32,0:20:33.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, jika hal itu didasarkan pada\Npengorbanan yang tak terbatas
Dialogue: 0,0:20:34.57,0:20:38.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagaimana mungkin kita berkata tidak bisa\Nmenang secara tidak bertanggung jawab?
Dialogue: 0,0:20:38.90,0:20:43.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya, selama mengambil langkah yang\Ndiperlukan untuk meraih kemenangan,
Dialogue: 0,0:20:43.59,0:20:45.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita memiliki peluang untuk menang?
Dialogue: 0,0:20:46.95,0:20:50.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, demi masa depan negara kita,\Nkalian semua harus bertempur sampai akhir.
Dialogue: 0,0:20:50.69,0:20:53.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak peduli berapa pun pengorbanan\Nyang harus dibayar?
Dialogue: 0,0:20:53.70,0:20:56.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak bisa membiarkan\Npengorbanan selama ini sia-sia.
Dialogue: 0,0:20:56.41,0:20:59.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kita harus siap dengan tekad\Nuntuk menanggung lebih banyak pengorbanan.
Dialogue: 0,0:21:02.60,0:21:04.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:21:09.98,0:21:11.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam.
Dialogue: 0,0:21:11.30,0:21:13.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika Anda bersikeras\Ningin meraih kemenangan...
Dialogue: 0,0:21:14.09,0:21:15.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, jangan bicara lagi.
Dialogue: 0,0:21:15.24,0:21:17.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kami akan\Ntunjukkan kemenangan pada Anda.
Dialogue: 0,0:21:17.29,0:21:19.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tutup mulutmu!
Dialogue: 0,0:21:19.40,0:21:21.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rudersdorf!
Dialogue: 0,0:21:23.64,0:21:26.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak peduli berapa pun\Npengorbanan yang harus dibayar,
Dialogue: 0,0:21:27.53,0:21:29.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasukan kita
Dialogue: 0,0:21:30.12,0:21:32.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harus meraih kemenangan.
Dialogue: 0,0:23:14.62,0:23:16.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memotretnya, ya.
Dialogue: 0,0:23:26.43,0:23:27.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aneh.
Dialogue: 0,0:23:32.69,0:23:34.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
