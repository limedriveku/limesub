Dialogue: 0,0:00:01.48,0:00:04.90,sign,,0,0,0,,3 JULI 1927 KALENDER BERSATU,\NIBU KOTA KEKAISARAN
Dialogue: 0,0:00:56.82,0:01:04.16,sign,,0,0,0,,(Saga of Tanya the Evil 2)
Dialogue: 0,0:02:20.69,0:02:22.86,sign,,0,0,0,,ANIMASI INI BERSIFAT FIKTIF
Dialogue: 0,0:02:22.87,0:02:23.63,sign,,0,0,0,,ISI DRAMA TIDAK IDENTIK DENGAN DUNIA NYATA
Dialogue: 0,0:02:23.64,0:02:24.62,sign,,0,0,0,,ISI DRAMA TIDAK IDENTIK DENGAN DUNIA NYATA
Dialogue: 0,0:02:44.05,0:02:46.22,sign,,0,0,0,,KERAJAAN YIRUDOYA,\NMARKAS BESAR ANGKATAN DARAT
Dialogue: 0,0:03:24.13,0:03:26.33,sign,,0,0,0,,IBU KOTA KERAJAAN BERSATU, GEDUNG PUTIH
Dialogue: 0,0:04:09.56,0:04:12.56,sign,,0,0,0,,(Episode 8: Sambaran Petir)
Dialogue: 0,0:09:43.18,0:09:44.46,sign,,0,0,0,,BEBERAPA BULAN YANG LALU
Dialogue: 0,0:09:51.11,0:09:55.29,sign,,0,0,0,,BAGIAN RISET TEKNOLOGI DIREKTORAT LOGISTIK MILITER KEKAISARAN
Dialogue: 0,0:11:32.00,0:11:38.00,sign,,0,0,0,,(Saga of Tanya the Evil 2)
Dialogue: 0,0:11:41.51,0:11:44.51,sign,,0,0,0,,DARATAN SELATAN, PELABUHAN MILITER CHURS
Dialogue: 0,0:11:59.56,0:12:01.74,sign,,0,0,0,,KOMANDAN PASUKAN EKSPEDISI SELATAN, LETNAN JENDERAL ROMMEL
Dialogue: 0,0:12:05.74,0:12:16.63,sign,,0,0,0,,PADA HARI YANG SAMA DI PERAIRAN LUAR DHAKA
Dialogue: 0,0:14:14.58,0:14:17.21,sign,,0,0,0,,LAPORAN KHUSUS: MENGUNGKAP RAHASIA\NKEKUATAN PASUKAN ARCHMAGE
Dialogue: 0,0:14:18.25,0:14:22.09,sign,,0,0,0,,ARCHMAGE MAMPU MENYUPLAI OKSIGEN SENDIRI\NUNTUK BERTEMPUR DI KETINGGIAN
Dialogue: 0,0:15:46.34,0:15:50.59,sign,,0,0,0,,ARMADA KERAJAAN BERSATU, SKUADRON TEMPUR 2
Dialogue: 0,0:18:44.56,0:18:46.12,sign,,0,0,0,,IZIN MASUK YIRUDOYA
Dialogue: 0,0:23:35.97,0:23:39.98,sign,,0,0,0,,(Episode Berikutnya: Perjalanan Wisata)
Dialogue: 0,0:00:25.34,0:00:26.42,Default,,0,0,0,,{\blur3}{\fad(00,40)}Letnan Kolonel.
Dialogue: 0,0:00:26.42,0:00:28.41,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ada perintah pemanggilan\Ndari Markas Besar Staf Umum.
Dialogue: 0,0:00:33.47,0:00:37.90,Default,,0,0,0,,{\blur3}{\fad(00,40)}Memanggilku yang sedang cuti jam segini,\Npasti bukan hal sepele.
Dialogue: 0,0:00:38.52,0:00:39.50,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hah.
Dialogue: 0,0:00:39.50,0:00:43.02,Default,,0,0,0,,{\blur3}{\fad(00,40)}Entah kenapa, tenggorokanku\Nterasa kering sekali.
Dialogue: 0,0:02:20.69,0:02:22.86,Default,,0,0,0,,{\blur3}{\fad(00,40)}Front timur memasuki fase tarik ulur.
Dialogue: 0,0:02:22.87,0:02:23.63,Default,,0,0,0,,{\blur3}{\fad(00,40)}Front timur memasuki fase tarik ulur.
Dialogue: 0,0:02:23.64,0:02:25.76,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pertempuran udara di barat kian memanas.
Dialogue: 0,0:02:26.30,0:02:29.05,Default,,0,0,0,,{\blur3}{\fad(00,40)}Untuk meminimalkan kerugian\Nsebisa mungkin,
Dialogue: 0,0:02:29.05,0:02:32.61,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kekaisaran memutuskan untuk mengakhiri\Nperang panjang dengan Republik Bebas.
Dialogue: 0,0:02:32.61,0:02:35.66,Default,,0,0,0,,{\blur3}{\fad(00,40)}Penarikan pasukan dari daratan Selatan,
Dialogue: 0,0:02:35.66,0:02:38.46,Default,,0,0,0,,{\blur3}{\fad(00,40)}juga demi menunjukkan aliansi\Nkepada negara lain.
Dialogue: 0,0:02:38.46,0:02:41.64,Default,,0,0,0,,{\blur3}{\fad(00,40)}Mereka memilih menarik pasukan ekspedisi\Npulang melalui Yirudoya.
Dialogue: 0,0:02:42.17,0:02:43.53,Default,,0,0,0,,{\blur3}{\fad(00,40)}Itu tadi adalah "rencana awal".
Dialogue: 0,0:02:46.90,0:02:48.44,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa ini benar-benar baik?
Dialogue: 0,0:02:48.85,0:02:52.23,Default,,0,0,0,,{\blur3}{\fad(00,40)}Setidaknya kita termasuk\Nsekutu negara itu.
Dialogue: 0,0:02:52.81,0:02:53.81,Default,,0,0,0,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:02:53.81,0:02:55.85,Default,,0,0,0,,{\blur3}{\fad(00,40)}Justru karena kita sekutu,
Dialogue: 0,0:02:55.86,0:02:58.52,Default,,0,0,0,,{\blur3}{\fad(00,40)}barulah kita membantu menjadi\Nperantara perundingan damai.
Dialogue: 0,0:02:58.52,0:03:00.95,Default,,0,0,0,,{\blur3}{\fad(00,40)}Alhasil orang-orang itu
Dialogue: 0,0:03:02.44,0:03:05.58,Default,,0,0,0,,{\blur3}{\fad(00,40)}malah mau meminjam jalan\Nkarena kita sekutu.
Dialogue: 0,0:03:06.17,0:03:10.55,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sekarang perundingan damai\Nbelum sepenuhnya gagal.
Dialogue: 0,0:03:10.55,0:03:12.30,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jika penarikan dilakukan\Nsetelah perjanjian damai,
Dialogue: 0,0:03:12.30,0:03:14.90,Default,,0,0,0,,{\blur3}{\fad(00,40)}kita masih bisa mengawal mereka pergi.
Dialogue: 0,0:03:14.90,0:03:15.96,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:03:15.96,0:03:19.39,Default,,0,0,0,,{\blur3}{\fad(00,40)}kalau kita ikut terlibat,\Nakan jadi masalah besar.
Dialogue: 0,0:03:20.80,0:03:22.89,Default,,0,0,0,,{\blur3}{\fad(00,40)}Memang benar.
Dialogue: 0,0:03:24.13,0:03:26.33,Default,,0,0,0,,{\blur3}{\fad(00,40)}Menolak pasukan Kekaisaran melintas,
Dialogue: 0,0:03:26.60,0:03:29.95,Default,,0,0,0,,{\blur3}{\fad(00,40)}juga harus mematuhi aturan singgah\Nselama 24 jam?
Dialogue: 0,0:03:29.95,0:03:31.66,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sungguh jawaban yang memuaskan.
Dialogue: 0,0:03:32.05,0:03:33.02,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:03:33.02,0:03:36.06,Default,,0,0,0,,{\blur3}{\fad(00,40)}Duta besar kita bertindak dengan baik.
Dialogue: 0,0:03:36.06,0:03:39.28,Default,,0,0,0,,{\blur3}{\fad(00,40)}Yirudoya berjanji akan mempertahankan\N"netralitas yang tegas".
Dialogue: 0,0:03:39.79,0:03:42.15,Default,,0,0,0,,{\blur3}{\fad(00,40)}Rute darat terpendek telah diblokir.
Dialogue: 0,0:03:42.15,0:03:46.22,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lagi pula, meski Kekaisaran\Npaksa menarik pasukan lewat jalur laut...
Dialogue: 0,0:03:46.49,0:03:52.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}Mau melakukan pelayaran anggun di samudra\Ndi hadapan kita, para penguasa lautan ini?
Dialogue: 0,0:03:52.39,0:03:54.19,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau begitu, harus mengadakan\Npesta penyambutan.
Dialogue: 0,0:03:54.19,0:03:58.97,Default,,0,0,0,,{\blur3}{\fad(00,40)}Soal biaya peluru penyambutannya,\Nmohon dimaklumi.
Dialogue: 0,0:03:59.48,0:04:02.55,Default,,0,0,0,,{\blur3}{\fad(00,40)}Angkatan Laut Kerajaan Bersatu\Nadalah yang terkuat.
Dialogue: 0,0:04:03.08,0:04:06.18,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kekaisaran harus mempertahankan\Nposisi pasukan sekutu
Dialogue: 0,0:04:06.18,0:04:08.89,Default,,0,0,0,,{\blur3}{\fad(00,40)}meskipun kekuatan beda jauh.
Dialogue: 0,0:04:14.89,0:04:15.94,Default,,0,0,0,,{\blur3}{\fad(00,40)}Saudara sekalian.
Dialogue: 0,0:04:15.94,0:04:19.78,Default,,0,0,0,,{\blur3}{\fad(00,40)}Meski sebagian besar Kampfgruppe\Nsedang cuti dan reorganisasi...
Dialogue: 0,0:04:20.33,0:04:20.97,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:04:20.97,0:04:23.23,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi gerilyawan yang berada langsung\Ndi bawah Markas Besar Staf Umum,
Dialogue: 0,0:04:23.23,0:04:26.87,Default,,0,0,0,,{\blur3}{\fad(00,40)}kami Batalion Archmage Udara 203\Nadalah pengecualian.
Dialogue: 0,0:04:27.84,0:04:30.51,Default,,0,0,0,,{\blur3}{\fad(00,40)}Baik, kujelaskan misinya.
Dialogue: 0,0:04:30.52,0:04:32.28,Default,,0,0,0,,{\blur3}{\fad(00,40)}Nama rencananya adalah "Barbar".
Dialogue: 0,0:04:32.29,0:04:33.97,Default,,0,0,0,,{\blur3}{\fad(00,40)}Garis besar misinya,
Dialogue: 0,0:04:33.97,0:04:36.26,Default,,0,0,0,,{\blur3}{\fad(00,40)}pada dasarnya seperti yang dilakukan\Nagen perjalanan.
Dialogue: 0,0:04:38.25,0:04:41.92,Default,,0,0,0,,{\blur3}{\fad(00,40)}Mengusir armada Kerajaan Bersatu\Ndari laut dalam.
Dialogue: 0,0:04:41.92,0:04:46.68,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lalu memulangkan pasukan ekspedisi daratan\NSelatan, Jenderal Rommel dan lainnya.
Dialogue: 0,0:04:47.03,0:04:50.10,Default,,0,0,0,,{\blur3}{\fad(00,40)}Menjemput rekan seperjuangan\Ndi selatan, ya?
Dialogue: 0,0:04:50.46,0:04:53.48,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau begitu, perlu siapkan\Nbuket penyambutan.
Dialogue: 0,0:04:53.49,0:04:57.48,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bisa sekalian siapkan bir\Ndan sosis untuk jamuan malam?
Dialogue: 0,0:04:58.99,0:05:01.07,Default,,0,0,0,,{\blur3}{\fad(00,40)}Niat kalian memang bagus,
Dialogue: 0,0:05:01.08,0:05:03.57,Default,,0,0,0,,{\blur3}{\fad(00,40)}tapi Yang Mulia Rommel itu sangat populer.
Dialogue: 0,0:05:03.57,0:05:07.38,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pasti ada penggemar berat\Nbersenjata lengkap mengejarnya.
Dialogue: 0,0:05:07.38,0:05:09.68,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau begitu, harus adakan\Npesta perpisahan untuk mereka
Dialogue: 0,0:05:09.68,0:05:12.25,Default,,0,0,0,,{\blur3}{\fad(00,40)}dengan peluru timah sebagai hadiah.
Dialogue: 0,0:05:12.25,0:05:14.32,Default,,0,0,0,,{\blur3}{\fad(00,40)}Benar sekali, Letnan.
Dialogue: 0,0:05:14.32,0:05:17.74,Default,,0,0,0,,{\blur3}{\fad(00,40)}Meski begitu, kekuatan armada di selatan\Nbisa dibilang minim.
Dialogue: 0,0:05:17.74,0:05:21.94,Default,,0,0,0,,{\blur3}{\fad(00,40)}Awalnya ingin pulang\Nlewat Yirudoya yang aman,
Dialogue: 0,0:05:21.95,0:05:24.40,Default,,0,0,0,,{\blur3}{\fad(00,40)}tapi mereka menolak pasukan kita lewat.
Dialogue: 0,0:05:24.41,0:05:27.14,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sungguh sekutu yang bisa diandalkan.
Dialogue: 0,0:05:27.94,0:05:29.84,Default,,0,0,0,,{\blur3}{\fad(00,40)}Karena tetangga tak bisa diharapkan,
Dialogue: 0,0:05:29.84,0:05:32.84,Default,,0,0,0,,{\blur3}{\fad(00,40)}kita harus menyelesaikan semua masalah\Ndengan kekuatan sendiri.
Dialogue: 0,0:05:32.84,0:05:34.47,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kita menghajar para penjilat\NKerajaan Bersatu
Dialogue: 0,0:05:34.47,0:05:37.73,Default,,0,0,0,,{\blur3}{\fad(00,40)}dan masukkan mereka ke neraka.
Dialogue: 0,0:05:37.95,0:05:38.86,Default,,0,0,0,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:05:40.58,0:05:44.63,Default,,0,0,0,,{\blur3}{\fad(00,40)}Untuk detail operasi, aku akan persilakan\NStaf Umum menjelaskan.
Dialogue: 0,0:05:45.17,0:05:47.03,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hormat kepada Kolonel Rerugen.
Dialogue: 0,0:05:47.58,0:05:48.41,Default,,0,0,0,,{\blur3}{\fad(00,40)}Siap.
Dialogue: 0,0:05:48.41,0:05:49.52,Default,,0,0,0,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:05:49.53,0:05:52.96,Default,,0,0,0,,{\blur3}{\fad(00,40)}Baik, mengenai Operasi Barbar kali ini...
Dialogue: 0,0:05:52.96,0:05:53.83,Default,,0,0,0,,{\blur3}{\fad(00,40)}Letnan Kolonel.
Dialogue: 0,0:05:54.24,0:05:56.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}Harus agak merepotkanmu.
Dialogue: 0,0:05:58.09,0:05:59.46,Default,,0,0,0,,{\blur3}{\fad(00,40)}Silakan perintahkan.
Dialogue: 0,0:06:00.01,0:06:01.15,Default,,0,0,0,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:06:01.15,0:06:03.50,Default,,0,0,0,,{\blur3}{\fad(00,40)}Senang kau bisa berkata begitu.
Dialogue: 0,0:06:03.50,0:06:08.60,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sejujurnya, pihak pabrik teknologi sudah\Nmenyiapkan solusi untuk berbagai masalah.
Dialogue: 0,0:06:10.46,0:06:13.77,Default,,0,0,0,,{\blur3}{\fad(00,40)}Untuk bagian ini, biarkan dia\Nyang menjelaskan.
Dialogue: 0,0:06:26.03,0:06:27.72,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dok...
Dialogue: 0,0:06:27.72,0:06:28.99,Default,,0,0,0,,{\blur3}{\fad(00,40)}Doktor?
Dialogue: 0,0:06:28.99,0:06:33.25,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ah, lama sekali tidak berjumpa,\NLetnan Kolonel Degurechaff.
Dialogue: 0,0:06:34.28,0:06:36.06,Default,,0,0,0,,{\blur3}{\fad(00,40)}Senang melihatmu selamat.
Dialogue: 0,0:06:36.06,0:06:39.47,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sepertinya kau juga\Nmendapat anugerah dewa.
Dialogue: 0,0:06:39.47,0:06:40.94,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ya...
Dialogue: 0,0:06:41.18,0:06:41.91,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ah.
Dialogue: 0,0:06:41.91,0:06:44.87,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kau khawatir tidak bisa\Nmelindungi rekanmu, ya?
Dialogue: 0,0:06:44.87,0:06:46.18,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak masalah.
Dialogue: 0,0:06:46.18,0:06:48.66,Default,,0,0,0,,{\blur3}{\fad(00,40)}Serahkan semuanya padaku.
Dialogue: 0,0:06:48.67,0:06:52.43,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku sudah siapkan kunci operasi kali ini.
Dialogue: 0,0:06:52.44,0:06:54.03,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lihatlah!
Dialogue: 0,0:06:54.03,0:06:55.31,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ini dia!
Dialogue: 0,0:06:55.88,0:06:57.66,Default,,0,0,0,,{\blur3}{\fad(00,40)}V-2.
Dialogue: 0,0:06:57.66,0:07:01.39,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ini adalah senjata revolusioner\Nyang hadir berkat perlindungan dewa.
Dialogue: 0,0:07:01.64,0:07:05.28,Default,,0,0,0,,{\blur3}{\fad(00,40)}Torpedo pelacak yang sangat presisi!
Dialogue: 0,0:07:07.29,0:07:08.65,Default,,0,0,0,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:07:08.65,0:07:10.20,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa itu kokpit?
Dialogue: 0,0:07:10.74,0:07:14.37,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau dipikir, V-1 hanya bisa\Nmelaju lurus.
Dialogue: 0,0:07:14.37,0:07:17.97,Default,,0,0,0,,{\blur3}{\fad(00,40)}Seperti imanku, tanpa penyimpangan.
Dialogue: 0,0:07:17.98,0:07:19.88,Default,,0,0,0,,{\blur3}{\fad(00,40)}Terbang lurus saja.
Dialogue: 0,0:07:19.88,0:07:23.22,Default,,0,0,0,,{\blur3}{\fad(00,40)}Terbang lurus menuju Tanah Perjanjian.
Dialogue: 0,0:07:24.02,0:07:25.32,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:07:25.33,0:07:29.65,Default,,0,0,0,,{\blur3}{\fad(00,40)}V-2 dapat melesat bebas menuju tujuannya,\Nbersama mereka yang beriman.
Dialogue: 0,0:07:29.66,0:07:33.97,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bisa dikatakan ini produk\Nuntuk menghadapi kenyataan pahit.
Dialogue: 0,0:07:35.27,0:07:38.77,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa yang dibicarakan Dokter?
Dialogue: 0,0:07:40.10,0:07:45.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jalan mana pun yang ditempuh, terakhir\Nakan sampai di tempat ideal di atas bukit.
Dialogue: 0,0:07:45.04,0:07:48.20,Default,,0,0,0,,{\blur3}{\fad(00,40)}Demi mengulangi perjalanan\Nmenuju Tanah Suci,
Dialogue: 0,0:07:48.20,0:07:51.93,Default,,0,0,0,,{\blur3}{\fad(00,40)}aku telah melengkapi V-2\Ndengan sistem pelacakan tercanggih.
Dialogue: 0,0:07:51.93,0:07:55.12,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sama seperti kalian yang dibimbing iman.
Dialogue: 0,0:07:55.12,0:07:58.29,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak akan pernah tersesat!
Dialogue: 0,0:07:59.84,0:08:02.43,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi aku sama sekali tak punya iman.
Dialogue: 0,0:08:02.43,0:08:04.33,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jangan khawatir, Letnan Kolonel.
Dialogue: 0,0:08:04.33,0:08:07.39,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku tidak akan merebut\Nkesempatan tampilmu.
Dialogue: 0,0:08:07.39,0:08:11.76,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bukankah kita mitra baik\Nyang sama-sama memuji kuasa dewa?
Dialogue: 0,0:08:13.41,0:08:16.08,Default,,0,0,0,,{\blur3}{\fad(00,40)}Cara penggunaannya sama seperti V-1.
Dialogue: 0,0:08:16.08,0:08:19.50,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalian hanya perlu menabrakkan\Nbenda ini ke musuh.
Dialogue: 0,0:08:19.50,0:08:22.44,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ah, jangan lupa segera mundur tepat waktu.
Dialogue: 0,0:08:22.44,0:08:28.61,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalian akan saksikan dari dekat bagaimana\Nledakan dahsyat membersihkan rintangan.
Dialogue: 0,0:08:29.59,0:08:32.97,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bi-bisakah menjamin kami\Ntidak ikut terkena ledakan?
Dialogue: 0,0:08:32.97,0:08:33.79,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ehm.
Dialogue: 0,0:08:33.79,0:08:36.99,Default,,0,0,0,,{\blur3}{\fad(00,40)}Itu sepenuhnya tergantung\Npada kehendak langit.
Dialogue: 0,0:08:36.99,0:08:38.35,Default,,0,0,0,,{\blur3}{\fad(00,40)}Artinya,
Dialogue: 0,0:08:38.35,0:08:40.27,Default,,0,0,0,,{\blur3}{\fad(00,40)}pergilah dengan tenang.
Dialogue: 0,0:08:41.68,0:08:42.74,Default,,0,0,0,,{\blur3}{\fad(00,40)}Letnan Kolonel.
Dialogue: 0,0:08:42.75,0:08:45.06,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku paham kekhawatiranmu.
Dialogue: 0,0:08:45.07,0:08:48.42,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bagaimanapun, kalau senjata baru terkait\Ntorpedo ini terus-menerus rusak...
Dialogue: 0,0:08:48.42,0:08:50.28,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tak perlu khawatir.
Dialogue: 0,0:08:50.28,0:08:54.80,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ini berbeda dengan belut buatan\Npara idiot di Angkatan Laut.
Dialogue: 0,0:08:54.80,0:08:59.32,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bahkan bagian sekecil pemicunya pun\Nsudah kuperhitungkan dengan saksama.
Dialogue: 0,0:08:59.32,0:09:01.39,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ini adalah ikan...
Dialogue: 0,0:09:03.47,0:09:05.28,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ah, maaf.
Dialogue: 0,0:09:05.28,0:09:07.32,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sungguh, maafkan aku.
Dialogue: 0,0:09:09.01,0:09:12.37,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bisakah maafkan kesombonganku,
Dialogue: 0,0:09:12.38,0:09:14.02,Default,,0,0,0,,{\blur3}{\fad(00,40)}Letnan Kolonel Degurechaff?
Dialogue: 0,0:09:14.03,0:09:15.55,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dok-Doktor?
Dialogue: 0,0:09:15.88,0:09:17.60,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tak kusangka
Dialogue: 0,0:09:17.60,0:09:20.25,Default,,0,0,0,,{\blur3}{\fad(00,40)}aku nyaris ditelan kesombongan.
Dialogue: 0,0:09:20.25,0:09:25.09,Default,,0,0,0,,{\blur3}{\fad(00,40)}Padahal ini adalah keajaiban\Nyang lahir dari kerja sama kita.
Dialogue: 0,0:09:25.66,0:09:26.33,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:09:26.33,0:09:31.24,Default,,0,0,0,,{\blur3}{\fad(00,40)}V-2 dikembangkan berkat usulan\Ndan saran darimu.
Dialogue: 0,0:09:31.24,0:09:35.48,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bisa dikatakan ini adalah kerja sama antar\Norang beriman yang dilandasi keyakinan.
Dialogue: 0,0:09:35.48,0:09:37.10,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ini bagaikan
Dialogue: 0,0:09:37.52,0:09:40.70,Default,,0,0,0,,{\blur3}{\fad(00,40)}anak kita berdua.
Dialogue: 0,0:09:40.70,0:09:43.17,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa-apaan?
Dialogue: 0,0:09:44.46,0:09:47.88,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dulu, aku pernah diundang\Nsebagai perwira lapangan
Dialogue: 0,0:09:47.88,0:09:50.24,Default,,0,0,0,,{\blur3}{\fad(00,40)}ke rapat staf teknis.
Dialogue: 0,0:09:51.11,0:09:55.29,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pada akhirnya, tanpa meriam kapal tempur utama,
Dialogue: 0,0:09:55.29,0:09:59.94,Default,,0,0,0,,{\blur3}{\fad(00,40)}jangankan supremasi laut,\Nmenantang armada musuh pun mustahil.
Dialogue: 0,0:10:00.24,0:10:02.75,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dalam jangka panjang,\Nitu memang jawaban yang benar.
Dialogue: 0,0:10:02.75,0:10:05.07,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi kalau sekarang\Nnekat maju tanpa strategi,
Dialogue: 0,0:10:05.08,0:10:07.25,Default,,0,0,0,,{\blur3}{\fad(00,40)}hanya akan jadi pemborosan saja.
Dialogue: 0,0:10:07.92,0:10:10.76,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kau pintar bicara teori.
Dialogue: 0,0:10:10.76,0:10:13.68,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau begitu, apa kau punya\Nsolusi jangka pendek?
Dialogue: 0,0:10:14.12,0:10:15.34,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ada.
Dialogue: 0,0:10:15.35,0:10:16.55,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ranjau laut.
Dialogue: 0,0:10:16.55,0:10:20.06,Default,,0,0,0,,{\blur3}{\fad(00,40)}Khususnya serangan torpedo udara,\Nmenurutku punya potensi besar.
Dialogue: 0,0:10:20.06,0:10:23.88,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kita bahkan belum menguasai\Nteknologi torpedo kapal,
Dialogue: 0,0:10:23.88,0:10:26.08,Default,,0,0,0,,{\blur3}{\fad(00,40)}apalagi torpedo udara.
Dialogue: 0,0:10:26.46,0:10:29.64,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau begitu, bagaimana jika\Nkita perbaiki metode operasinya?
Dialogue: 0,0:10:29.64,0:10:31.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}Gunakan kapal selam\Nuntuk melemahkan musuh...
Dialogue: 0,0:10:31.71,0:10:35.36,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bisakah kapal selam berkecepatan rendah\Nmengunci kapal tempur utama?
Dialogue: 0,0:10:35.36,0:10:38.62,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ini bukan perang yang bisa dimenangkan\Ndengan senjata rahasia andalan orang awam
Dialogue: 0,0:10:38.62,0:10:40.57,Default,,0,0,0,,{\blur3}{\fad(00,40)}yang bisa menang sekali serang.
Dialogue: 0,0:10:41.10,0:10:42.95,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau begitu,
Dialogue: 0,0:10:42.96,0:10:45.79,Default,,0,0,0,,{\blur3}{\fad(00,40)}bagaimana jika archmage langsung\Nmenaiki torpedo?
Dialogue: 0,0:10:46.54,0:10:47.53,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:10:47.53,0:10:50.62,Default,,0,0,0,,{\blur3}{\fad(00,40)}Biarkan archmage mengarahkan\Ntorpedo ke depan kapal musuh,
Dialogue: 0,0:10:50.62,0:10:52.28,Default,,0,0,0,,{\blur3}{\fad(00,40)}lalu meloloskan diri sebelum benturan.
Dialogue: 0,0:10:52.28,0:10:54.77,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pastikan torpedo tepat mengenai sasaran.
Dialogue: 0,0:10:54.77,0:10:57.76,Default,,0,0,0,,{\blur3}{\fad(00,40)}Selain itu, archmage masih bisa\Nmelanjutkan serangan setelah hantaman.
Dialogue: 0,0:11:04.50,0:11:05.54,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau dipikir lagi,
Dialogue: 0,0:11:05.54,0:11:08.32,Default,,0,0,0,,{\blur3}{\fad(00,40)}rasanya aku memang pernah\Nmengatakan hal seperti itu.
Dialogue: 0,0:11:08.33,0:11:09.34,Default,,0,0,0,,{\blur3}{\fad(00,40)}Maklum,
Dialogue: 0,0:11:09.34,0:11:11.18,Default,,0,0,0,,{\blur3}{\fad(00,40)}selama tidak berniat memakainya sendiri,
Dialogue: 0,0:11:11.19,0:11:14.99,Default,,0,0,0,,{\blur3}{\fad(00,40)}semua bisa dengan tak bertanggung jawab\Nmelempar "ide bagus" ke garis depan.
Dialogue: 0,0:11:15.55,0:11:18.48,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apakah ini juga ulah Existence X?
Dialogue: 0,0:11:18.49,0:11:19.98,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pasti begitu, 'kan?
Dialogue: 0,0:11:19.98,0:11:21.28,Default,,0,0,0,,{\blur3}{\fad(00,40)}Karma ini sangat menargetkan.
Dialogue: 0,0:11:21.70,0:11:23.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ah, sudahlah.
Dialogue: 0,0:11:23.04,0:11:24.77,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku sudah mengerti.
Dialogue: 0,0:11:24.77,0:11:27.08,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau kau mau main seperti ini,
Dialogue: 0,0:11:30.11,0:11:31.42,Default,,0,0,0,,{\blur3}{\fad(00,40)}akan kulayani sampai akhir!
Dialogue: 0,0:11:38.00,0:11:41.51,Default,,0,0,0,,{\blur3}{\fad(00,40)}15 Juli 1927 KALENDER BERSATU
Dialogue: 0,0:11:49.55,0:11:50.44,Default,,0,0,0,,{\blur3}{\fad(00,40)}Yang Mulia.
Dialogue: 0,0:11:50.44,0:11:53.00,Default,,0,0,0,,{\blur3}{\fad(00,40)}Persiapan naik kapal sudah rampung.
Dialogue: 0,0:11:53.00,0:11:55.11,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi apakah kita bisa\Nbenar-benar mundur dengan selamat?
Dialogue: 0,0:11:55.69,0:11:59.55,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sepertinya ada armada Kerajaan Bersatu\Nmelebihi perkiraan yang menunggu kita.
Dialogue: 0,0:11:59.56,0:12:01.74,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bisakah kita melewati perairan ini
Dialogue: 0,0:12:01.74,0:12:02.87,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bisakah kita melewat perairan ini\Ndengan lancar?
Dialogue: 0,0:12:19.53,0:12:20.70,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sonar mendeteksi objek.
Dialogue: 0,0:12:20.70,0:12:22.30,Default,,0,0,0,,{\blur3}{\fad(00,40)}Suara kapal perang bergerak.
Dialogue: 0,0:12:22.30,0:12:23.80,Default,,0,0,0,,{\blur3}{\fad(00,40)}Banyak kapal tempur utama.
Dialogue: 0,0:12:24.69,0:12:26.27,Default,,0,0,0,,{\blur3}{\fad(00,40)}Letnan Kolonel Degurechaff.
Dialogue: 0,0:12:26.27,0:12:27.61,Default,,0,0,0,,{\blur3}{\fad(00,40)}Target terdeteksi.
Dialogue: 0,0:12:27.61,0:12:29.34,Default,,0,0,0,,{\blur3}{\fad(00,40)}Semuanya kapal besar.
Dialogue: 0,0:12:29.34,0:12:31.96,Default,,0,0,0,,{\blur3}{\fad(00,40)}Begitu, benar-benar megah ya.
Dialogue: 0,0:12:31.96,0:12:34.34,Default,,0,0,0,,{\blur3}{\fad(00,40)}Makanan pembuka adalah\Nkapal penjelajah besar.
Dialogue: 0,0:12:34.34,0:12:36.78,Default,,0,0,0,,{\blur3}{\fad(00,40)}Menu utama adalah\Nkapal induk dan kapal tempur?
Dialogue: 0,0:12:37.23,0:12:40.00,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi sayang sekali,\Nmatahari akan segera terbenam.
Dialogue: 0,0:12:40.00,0:12:42.11,Default,,0,0,0,,{\blur3}{\fad(00,40)}Seharusnya bisa tanpa V-2,\Npakai belut saja...
Dialogue: 0,0:12:42.50,0:12:44.64,Default,,0,0,0,,{\blur3}{\fad(00,40)}Terima kasih atas pertimbangan Anda.
Dialogue: 0,0:12:44.64,0:12:47.91,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi demi kepastian,\Nkami tetap harus turun tangan, 'kan?
Dialogue: 0,0:12:48.76,0:12:51.17,Default,,0,0,0,,{\blur3}{\fad(00,40)}Biasanya memang begitu.
Dialogue: 0,0:12:51.18,0:12:54.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi di saat jarak pandang\Nmenyusut begini...
Dialogue: 0,0:12:55.60,0:12:57.68,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kami ada memang untuk hal seperti ini.
Dialogue: 0,0:12:57.69,0:12:59.80,Default,,0,0,0,,{\blur3}{\fad(00,40)}Harus bulatkan tekad.
Dialogue: 0,0:13:00.66,0:13:03.68,Default,,0,0,0,,{\blur3}{\fad(00,40)}Karena ini menyangkut\Napakah pasukan sekutu bisa mundur?
Dialogue: 0,0:13:04.99,0:13:06.16,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lagi pula,
Dialogue: 0,0:13:06.16,0:13:08.87,Default,,0,0,0,,{\blur3}{\fad(00,40)}teman baik kita, Yirudoya,\Npasti sedang melihat juga.
Dialogue: 0,0:13:08.87,0:13:12.50,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pada akhirnya, anggota di garis depan\Nhanya bisa berusaha melunasi utang.
Dialogue: 0,0:13:12.50,0:13:14.02,Default,,0,0,0,,{\blur3}{\fad(00,40)}Biarpun harus main pukul,
Dialogue: 0,0:13:14.02,0:13:17.98,Default,,0,0,0,,{\blur3}{\fad(00,40)}aku juga akan menjambak\Nrambut Dewi Keberuntungan itu.
Dialogue: 0,0:13:25.95,0:13:28.16,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sekarang, konfirmasi akhir sebelum naik.
Dialogue: 0,0:13:28.17,0:13:28.80,Default,,0,0,0,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:13:29.41,0:13:31.94,Default,,0,0,0,,{\blur3}{\fad(00,40)}V-2 kita hanya ada 12 unit.
Dialogue: 0,0:13:31.94,0:13:34.39,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pembagiannya harus sangat cermat.
Dialogue: 0,0:13:34.40,0:13:36.89,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kapal induk dan kapal tempur\Nwajib ditenggelamkan total.
Dialogue: 0,0:13:36.89,0:13:38.42,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jangan sampai salah langkah.
Dialogue: 0,0:13:38.82,0:13:42.26,Default,,0,0,0,,{\blur3}{\fad(00,40)}Harus keluar dan muncul ke permukaan\Nsebelum torpedo menghantam.
Dialogue: 0,0:13:42.26,0:13:44.47,Default,,0,0,0,,{\blur3}{\fad(00,40)}Setelah itu, bertempur\Ndengan kapal perusak.
Dialogue: 0,0:13:46.07,0:13:46.95,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:13:46.95,0:13:48.54,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa maksud ekspresi kalian?
Dialogue: 0,0:13:48.54,0:13:50.57,Default,,0,0,0,,{\blur3}{\fad(00,40)}Letnan Kolonel, itu...
Dialogue: 0,0:13:50.57,0:13:52.54,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ini benar-benar...
Dialogue: 0,0:13:52.54,0:13:54.38,Default,,0,0,0,,{\blur3}{\fad(00,40)}Benar-benar apa?
Dialogue: 0,0:13:54.39,0:13:56.58,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sebagai komandan,\Naku akan memimpin di depan.
Dialogue: 0,0:13:56.58,0:13:58.53,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalian cukup ikuti saja.
Dialogue: 0,0:13:58.53,0:14:01.25,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hanya itu.
Dialogue: 0,0:14:01.26,0:14:05.02,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lalu bagaimana cara mengunci\Nkapal musuh di dalam laut?
Dialogue: 0,0:14:11.65,0:14:13.50,Default,,0,0,0,,{\blur3}{\fad(00,40)}Er... oksigen...
Dialogue: 0,0:14:14.06,0:14:14.58,Default,,0,0,0,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:14:22.92,0:14:25.51,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pasti ada tekanan air dan arus kuat, 'kan?
Dialogue: 0,0:14:28.00,0:14:32.77,Default,,0,0,0,,{\blur3}{\fad(00,40)}Artinya, operasi ini justru membutuhkan\Nkekuatan pasukan archmage kita.
Dialogue: 0,0:14:33.42,0:14:35.19,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hanya bisa berdoa.
Dialogue: 0,0:14:35.68,0:14:36.88,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kau bilang berdoa?
Dialogue: 0,0:14:37.65,0:14:39.31,Default,,0,0,0,,{\blur3}{\fad(00,40)}Maaf, Letnan.
Dialogue: 0,0:14:39.31,0:14:41.44,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lakukan dulu yang terbaik.
Dialogue: 0,0:14:42.07,0:14:44.69,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dengan kekuatan sendiri, kehendak manusia.
Dialogue: 0,0:14:44.69,0:14:45.86,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dengan ini...
Dialogue: 0,0:14:50.04,0:14:52.20,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kita jalankan sepenuhnya kewajiban kita.
Dialogue: 0,0:14:53.00,0:14:56.16,Default,,0,0,0,,{\blur3}{\fad(00,40)}Data arah dan kecepatan target\Nsudah dihitung.
Dialogue: 0,0:14:56.17,0:14:58.09,Default,,0,0,0,,{\blur3}{\fad(00,40)}Letnan Kolonel, data sudah dikirim.
Dialogue: 0,0:14:58.10,0:14:59.52,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi ini hanya perhitungan kasar.
Dialogue: 0,0:15:00.01,0:15:00.99,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bagus sekali.
Dialogue: 0,0:15:01.00,0:15:02.82,Default,,0,0,0,,{\blur3}{\fad(00,40)}Data sudah dikonfirmasi.
Dialogue: 0,0:15:02.82,0:15:04.24,Default,,0,0,0,,{\blur3}{\fad(00,40)}Konfirmasi terakhir.
Dialogue: 0,0:15:04.24,0:15:05.42,Default,,0,0,0,,{\blur3}{\fad(00,40)}Siap diluncurkan!
Dialogue: 0,0:15:07.88,0:15:09.08,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bagus sekali.
Dialogue: 0,0:15:09.08,0:15:11.42,Default,,0,0,0,,{\blur3}{\fad(00,40)}Semuanya, tidak masalah, 'kan?
Dialogue: 0,0:15:11.84,0:15:12.38,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:15:12.78,0:15:13.68,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ehm.
Dialogue: 0,0:15:13.68,0:15:14.35,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:15:14.82,0:15:15.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:15:15.72,0:15:16.82,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bagus.
Dialogue: 0,0:15:16.82,0:15:17.96,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sangat bagus.
Dialogue: 0,0:15:17.96,0:15:19.52,Default,,0,0,0,,{\blur3}{\fad(00,40)}Luar biasa.
Dialogue: 0,0:15:21.50,0:15:22.50,Default,,0,0,0,,{\blur3}{\fad(00,40)}Mulai!
Dialogue: 0,0:15:51.14,0:15:53.90,Default,,0,0,0,,{\blur3}{\fad(00,40)}Menumpas tentara kekaisaran\Nyang melarikan diri di malam hari,
Dialogue: 0,0:15:53.90,0:15:56.28,Default,,0,0,0,,{\blur3}{\fad(00,40)}lalu selesaikan Operasi Daratan Selatan?
Dialogue: 0,0:15:56.83,0:15:58.72,Default,,0,0,0,,{\blur3}{\fad(00,40)}Benar-benar kerjaan mudah.
Dialogue: 0,0:15:58.72,0:16:01.11,Default,,0,0,0,,{\blur3}{\fad(00,40)}Yang besar menindas yang kecil\Njuga harus ada batasnya.
Dialogue: 0,0:16:08.93,0:16:10.57,Default,,0,0,0,,{\blur3}{\fad(00,40)}Be-belum sampai?
Dialogue: 0,0:16:11.48,0:16:12.25,Default,,0,0,0,,{\blur3}{\fad(00,40)}Belum.
Dialogue: 0,0:16:12.84,0:16:13.76,Default,,0,0,0,,{\blur3}{\fad(00,40)}Belum bisa.
Dialogue: 0,0:16:14.38,0:16:16.36,Default,,0,0,0,,{\blur3}{\fad(00,40)}T-tidak kuat lagi.
Dialogue: 0,0:16:16.36,0:16:17.12,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sekarang!
Dialogue: 0,0:16:36.68,0:16:38.09,Default,,0,0,0,,{\blur3}{\fad(00,40)}I-ini!
Dialogue: 0,0:16:38.09,0:16:40.23,Default,,0,0,0,,{\blur3}{\fad(00,40)}HMS Hood!
Dialogue: 0,0:16:40.24,0:16:41.85,Default,,0,0,0,,{\blur3}{\fad(00,40)}Juga HMS Ark Royal!
Dialogue: 0,0:16:48.79,0:16:50.28,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak sanggup lagi.
Dialogue: 0,0:16:53.84,0:16:54.84,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bala bantuan!
Dialogue: 0,0:16:54.84,0:16:56.42,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bala bantuan dari pasukan utama!
Dialogue: 0,0:16:56.42,0:16:57.60,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ini Injil!
Dialogue: 0,0:16:57.60,0:16:59.17,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ah, Tuhan.
Dialogue: 0,0:16:59.17,0:17:00.60,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kita selamat!
Dialogue: 0,0:17:00.60,0:17:02.65,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tuhan belum meninggalkan kita?
Dialogue: 0,0:17:07.28,0:17:08.82,Default,,0,0,0,,{\blur3}{\fad(00,40)}Cepat ke sini!
Dialogue: 0,0:17:08.82,0:17:10.38,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hei, di sini!
Dialogue: 0,0:17:13.29,0:17:15.56,Default,,0,0,0,,{\blur3}{\fad(00,40)}La-lambung kanan muncul archmage musuh!
Dialogue: 0,0:17:15.56,0:17:16.38,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:17:24.35,0:17:25.39,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:17:25.40,0:17:27.21,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tuhan meninggalkan kita?
Dialogue: 0,0:17:27.21,0:17:28.73,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pergilah ke neraka!
Dialogue: 0,0:17:28.73,0:17:30.36,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sialan, dasar dewa busuk.
Dialogue: 0,0:17:30.36,0:17:33.12,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sebelum berdoa, belajarlah\Nmenggerakkan tangan.
Dialogue: 0,0:17:33.12,0:17:35.09,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pandai bicara, tapi tak bisa bertindak.
Dialogue: 0,0:17:35.09,0:17:36.83,Default,,0,0,0,,{\blur3}{\fad(00,40)}Benar-benar sekelompok orang naif.
Dialogue: 0,0:17:46.33,0:17:48.27,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lihat itu, Existence X?
Dialogue: 0,0:17:48.27,0:17:51.53,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku tidak akan menyerah\Npada cobaanmu yang tak masuk akal.
Dialogue: 0,0:17:52.01,0:17:55.60,Default,,0,0,0,,{\blur3}{\fad(00,40)}Inilah semangat dan martabat\Nmanusia modern.
Dialogue: 0,0:18:01.73,0:18:04.16,Default,,0,0,0,,{\blur3}{\fad(00,40)}Titah dewa apaan? Enyahlah!
Dialogue: 0,0:18:04.62,0:18:06.86,Default,,0,0,0,,{\blur3}{\fad(00,40)}Demi kehidupan royalti yang kudambakan,
Dialogue: 0,0:18:06.86,0:18:09.11,Default,,0,0,0,,{\blur3}{\fad(00,40)}bagaimanapun aku harus bertahan hidup.
Dialogue: 0,0:18:10.90,0:18:14.42,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku adalah komandan U-091,\NMayor Otto von Elm.
Dialogue: 0,0:18:14.43,0:18:16.53,Default,,0,0,0,,{\blur3}{\fad(00,40)}Luar biasa, Letnan Kolonel.
Dialogue: 0,0:18:17.90,0:18:21.19,Default,,0,0,0,,{\blur3}{\fad(00,40)}Armada utama Kerajaan Bersatu\Nsudah mundur.
Dialogue: 0,0:18:21.19,0:18:24.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pasukan Ekspedisi Selatan akan\Nmenikmati pelayaran yang menyenangkan.
Dialogue: 0,0:18:24.04,0:18:27.42,Default,,0,0,0,,{\blur3}{\fad(00,40)}Wah, rekan seangkatanku, Barholt\Njuga tampak sangat bersemangat, ya.
Dialogue: 0,0:18:27.81,0:18:28.64,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ah.
Dialogue: 0,0:18:28.64,0:18:31.42,Default,,0,0,0,,{\blur3}{\fad(00,40)}Komandan Barholt rekan seangkatanmu?
Dialogue: 0,0:18:31.42,0:18:33.03,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kebetulan sekali.
Dialogue: 0,0:18:33.04,0:18:34.26,Default,,0,0,0,,{\blur3}{\fad(00,40)}Omong-omong,
Dialogue: 0,0:18:34.26,0:18:35.58,Default,,0,0,0,,{\blur3}{\fad(00,40)}ini untuk Anda.
Dialogue: 0,0:18:35.58,0:18:37.22,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dikirim dari negara kita.
Dialogue: 0,0:18:41.78,0:18:43.77,Default,,0,0,0,,{\blur3}{\fad(00,40)}Oh, ini benar-benar...
Dialogue: 0,0:18:44.56,0:18:46.12,Default,,0,0,0,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:18:46.12,0:18:50.33,Default,,0,0,0,,{\blur3}{\fad(00,40)}Balik memanfaatkan aturan 24 jam\Ndan batasan jumlah personel skuadron, ya?
Dialogue: 0,0:18:50.91,0:18:55.70,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau begitu, kali ini biarkan aku\Nmenikmati perjalanan wisata.
Dialogue: 0,0:19:12.66,0:19:17.84,Default,,0,0,0,,{\blur3}{\fad(00,40)}Senang sekali sahabat\Ndatang dari jauh, benar?
Dialogue: 0,0:19:18.40,0:19:20.88,Default,,0,0,0,,{\blur3}{\fad(00,40)}Haruskah kujawab,
Dialogue: 0,0:19:20.88,0:19:24.20,Default,,0,0,0,,{\blur3}{\fad(00,40)}"Orang tak mengenalmu, tapi kau tak marah,\Nbukankah itu menyenangkan"?
Dialogue: 0,0:19:24.21,0:19:26.56,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa maksud ucapan Anda?
Dialogue: 0,0:19:26.56,0:19:29.66,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sebagai sekutu, kami tentu sangat\Nmemahami situasi negara Anda.
Dialogue: 0,0:19:30.06,0:19:32.82,Default,,0,0,0,,{\blur3}{\fad(00,40)}Memberikan mahkota laurel bagi pemenang?
Dialogue: 0,0:19:33.57,0:19:36.95,Default,,0,0,0,,{\blur3}{\fad(00,40)}Angkatan Laut Kerajaan Bersatu\Nkalah agak telak.
Dialogue: 0,0:19:36.95,0:19:38.09,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau begitu,
Dialogue: 0,0:19:38.09,0:19:41.24,Default,,0,0,0,,{\blur3}{\fad(00,40)}tentu saja sikap kami\Nharus sedikit disesuaikan.
Dialogue: 0,0:19:41.61,0:19:42.92,Default,,0,0,0,,{\blur3}{\fad(00,40)}Maklum,
Dialogue: 0,0:19:42.92,0:19:45.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}kami adalah negara netral\Nyang bisa melakukan hal ini.
Dialogue: 0,0:19:46.42,0:19:49.38,Default,,0,0,0,,{\blur3}{\fad(00,40)}Yirudoya benar-benar tebal muka.
Dialogue: 0,0:19:49.94,0:19:53.18,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pantas saja negara kami ingin\Nmemberi mereka sedikit pelajaran.
Dialogue: 0,0:19:53.65,0:19:55.63,Default,,0,0,0,,{\blur3}{\fad(00,40)}Yang akan diterima bukan pasukan,
Dialogue: 0,0:19:55.63,0:19:58.56,Default,,0,0,0,,{\blur3}{\fad(00,40)}melainkan hanya kunjungan resmi 12 orang.
Dialogue: 0,0:19:58.56,0:20:00.90,Default,,0,0,0,,{\blur3}{\fad(00,40)}Meski Yirudoya bersikeras soal ini,
Dialogue: 0,0:20:00.90,0:20:02.93,Default,,0,0,0,,{\blur3}{\fad(00,40)}tapi itu adalah skuadron archmage.
Dialogue: 0,0:20:03.29,0:20:05.35,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ini batu uji yang sempurna.
Dialogue: 0,0:20:05.73,0:20:07.81,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ah, kepalaku pusing sekali.
Dialogue: 0,0:20:07.82,0:20:09.09,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sialnya,
Dialogue: 0,0:20:09.10,0:20:11.69,Default,,0,0,0,,{\blur3}{\fad(00,40)}yang datang justru pasukan\NLetnan Kolonel Degurechaff.
Dialogue: 0,0:20:12.28,0:20:14.42,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dari sudut pandang diplomatik, sungguh
Dialogue: 0,0:20:14.42,0:20:15.40,Default,,0,0,0,,{\blur3}{\fad(00,40)}sangat merepotkan.
Dialogue: 0,0:20:16.06,0:20:18.53,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku sangat merindukan\NLetnan Kolonel Degurechaff.
Dialogue: 0,0:20:18.53,0:20:19.36,Default,,0,0,0,,{\blur3}{\fad(00,40)}Wah.
Dialogue: 0,0:20:19.36,0:20:21.88,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dulu di Timur, aku banyak dibantu olehnya.
Dialogue: 0,0:20:21.88,0:20:25.48,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dengar dia yang akan berkunjung resmi,\Naku sangat senang.
Dialogue: 0,0:20:25.48,0:20:28.66,Default,,0,0,0,,{\blur3}{\fad(00,40)}Untungnya sudah pernah berurusan\Ndengan orang berbahaya itu.
Dialogue: 0,0:20:28.66,0:20:30.62,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jika ini pertemuan pertama,
Dialogue: 0,0:20:30.62,0:20:32.97,Default,,0,0,0,,{\blur3}{\fad(00,40)}mustahil bisa menghadapinya dengan baik.
Dialogue: 0,0:20:32.98,0:20:35.66,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jadi ini reuni yang mengharukan, ya.
Dialogue: 0,0:20:35.66,0:20:36.81,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jarang ada kesempatan seperti ini,
Dialogue: 0,0:20:36.81,0:20:39.65,Default,,0,0,0,,{\blur3}{\fad(00,40)}sungguh kuharap ada panggung megah.
Dialogue: 0,0:20:39.65,0:20:41.55,Default,,0,0,0,,{\blur3}{\fad(00,40)}Wah, benar juga.
Dialogue: 0,0:20:41.56,0:20:44.28,Default,,0,0,0,,{\blur3}{\fad(00,40)}Karena mendadak, anggaran dan tempat\Nuntuk penyambutan sangat terbatas.
Dialogue: 0,0:20:44.28,0:20:45.35,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kami sungguh minta maaf.
Dialogue: 0,0:20:46.07,0:20:47.22,Default,,0,0,0,,{\blur3}{\fad(00,40)}Parah sekali.
Dialogue: 0,0:20:47.22,0:20:49.73,Default,,0,0,0,,{\blur3}{\fad(00,40)}Benar-benar sandiwara konyol.
Dialogue: 0,0:20:49.73,0:20:51.64,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ini murni jalur belakang.
Dialogue: 0,0:20:51.64,0:20:55.07,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hanya kunjungan persahabatan\Nyang sembunyi-sembunyi.
Dialogue: 0,0:20:55.93,0:20:59.62,Default,,0,0,0,,{\blur3}{\fad(00,40)}Meski begitu, kami cuma diam-diam\Nmenerima kapal selam.
Dialogue: 0,0:20:59.62,0:21:01.24,Default,,0,0,0,,{\blur3}{\fad(00,40)}Asal tidak terlalu mencolok...
Dialogue: 0,0:21:17.72,0:21:19.44,Default,,0,0,0,,{\blur3}{\fad(00,40)}Wah, luar biasa!
Dialogue: 0,0:21:19.44,0:21:21.15,Default,,0,0,0,,{\blur3}{\fad(00,40)}Warga Yirudoya sekalian!
Dialogue: 0,0:21:21.15,0:21:23.05,Default,,0,0,0,,{\blur3}{\fad(00,40)}Terima kasih banyak atas sambutannya!
Dialogue: 0,0:21:27.10,0:21:30.14,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bisa-bisanya... begitu menarik perhatian.
Dialogue: 0,0:21:30.14,0:21:33.06,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa benar tidak masalah?
Dialogue: 0,0:23:13.26,0:23:15.02,Default,,0,0,0,,{\blur3}{\fad(00,40)}Semangat!
Dialogue: 0,0:23:15.02,0:23:16.58,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kami mengandalkan kalian!
Dialogue: 0,0:23:17.26,0:23:18.37,Default,,0,0,0,,{\blur3}{\fad(00,40)}Er...
Dialogue: 0,0:23:18.37,0:23:21.63,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kapten, kau juga archmage, tidak ikut?
Dialogue: 0,0:23:22.41,0:23:23.46,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak muat.
Dialogue: 0,0:23:25.22,0:23:27.18,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku tak muat pakai baju selam.
Dialogue: 0,0:23:27.69,0:23:28.96,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ah...
Dialogue: 0,0:23:30.79,0:23:32.85,Default,,0,0,0,,{\blur3}{\fad(00,40)}Semangat!
Dialogue: 0,0:23:32.85,0:23:34.98,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kami mengandalkan kalian!
