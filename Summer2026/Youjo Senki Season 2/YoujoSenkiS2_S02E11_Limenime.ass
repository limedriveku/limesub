Dialogue: 0,0:00:00.00,0:00:02.78,sign,,0000,0000,0000,,27 SEPTEMBER 1927 KALENDER BERSATU\NBAGIAN TIMUR
Dialogue: 0,0:00:07.51,0:00:09.41,sign,,0000,0000,0000,,DENGAN SURAT INI,
Dialogue: 0,0:00:09.41,0:00:11.26,sign,,0000,0000,0000,,ANDA DIANGKAT SEBAGAI JENDERAL INFANTERI
Dialogue: 0,0:00:54.88,0:01:02.12,sign,,0000,0000,0000,,(Saga of Tanya the Evil 2)
Dialogue: 0,0:02:21.18,0:02:22.82,sign,,0000,0000,0000,,ANIMASI INI BERSIFAT FIKTIF
Dialogue: 0,0:02:22.82,0:02:24.82,sign,,0000,0000,0000,,ISI DRAMA TIDAK IDENTIK DENGAN DUNIA NYATA
Dialogue: 0,0:02:24.83,0:02:26.46,sign,,0000,0000,0000,,ISI DRAMA TIDAK IDENTIK DENGAN DUNIA NYATA
Dialogue: 0,0:02:35.57,0:02:38.58,sign,,0000,0000,0000,,(Episode 11: Jam Pasir)
Dialogue: 0,0:06:23.55,0:06:26.74,sign,,0000,0000,0000,,RENCANA PERANG, YIRUDOYA
Dialogue: 0,0:06:32.78,0:06:35.76,sign,,0000,0000,0000,,30 SEPTEMBER 1927 KALENDER BERSATU
Dialogue: 0,0:12:01.97,0:12:04.98,sign,,0000,0000,0000,,(Saga of Tanya the Evil 2)
Dialogue: 0,0:12:04.99,0:12:07.98,sign,,0000,0000,0000,,(Saga of Tanya the Evil 2)
