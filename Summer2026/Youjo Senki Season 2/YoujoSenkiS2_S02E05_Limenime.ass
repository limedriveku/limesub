Dialogue: 0,0:00:48.81,0:00:56.16,sign,,0000,0000,0000,,(Saga of Tanya the Evil 2)
Dialogue: 0,0:02:11.84,0:02:14.61,sign,,0000,0000,0000,,TANGGAL 26 MEI 1927 KALENDER BERSATU\NSTASIUN PUSAT IBU KOTA KEKAISARAN BERUN
Dialogue: 0,0:02:14.86,0:02:17.28,sign,,0000,0000,0000,,ANIMASI INI BERSIFAT FIKTIF
Dialogue: 0,0:02:17.28,0:02:19.74,sign,,0000,0000,0000,,ISI DRAMA TIDAK IDENTIK DENGAN DUNIA NYATA
Dialogue: 0,0:02:36.96,0:02:40.21,sign,,0000,0000,0000,,(Episode 5: Ramalan Buruk)
Dialogue: 0,0:04:49.51,0:04:51.35,sign,,0000,0000,0000,,FRONT TIMUR\NPOS MAJU PASUKAN FRONT TIMUR KEKAISARAN
Dialogue: 0,0:13:17.88,0:13:19.61,sign,,0000,0000,0000,,DEPARTEMEN INTELIJEN MILITER
Dialogue: 0,0:13:19.61,0:13:21.37,sign,,0000,0000,0000,,KERAJAAN BERSATU
Dialogue: 0,0:13:21.37,0:13:24.82,sign,,0000,0000,0000,,KOLONEL SIR ISAAC DUSTIN DRAKE
Dialogue: 0,0:13:54.81,0:13:55.98,sign,,0000,0000,0000,,ULTRA?
Dialogue: 0,0:14:47.94,0:14:53.95,sign,,0000,0000,0000,,(Saga of Tanya the Evil 2)
Dialogue: 0,0:15:59.95,0:16:02.76,sign,,0000,0000,0000,,DEPARTEMEN KERETA API ANGKATAN DARAT, MARKAS BESAR STAF UMUM KEKAISARAN\NLETNAN KOLONEL MAXIMILIAN JOHANN VON UGA
Dialogue: 0,0:17:17.26,0:17:19.26,sign,,0000,0000,0000,,FRONT TIMUR, POS PERTAHANAN SOLDIM 528
Dialogue: 0,0:17:53.07,0:17:54.57,sign,,0000,0000,0000,,RUANG OPERASI TITIK MAJU, FRONT TIMUR
Dialogue: 0,0:20:15.00,0:20:17.48,sign,,0000,0000,0000,,MARKAS PASUKAN PENGEPUNG TENTARA FEDERAL
Dialogue: 0,0:23:36.01,0:23:40.02,sign,,0000,0000,0000,,(Episode Berikutnya: Umpan)
Dialogue: 0,0:02:23.41,0:02:25.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kita perlu saling mengantar?
Dialogue: 0,0:02:26.40,0:02:29.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jarang bisa melihatmu\Nmenyedihkan seperti ini.
Dialogue: 0,0:02:29.51,0:02:31.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana boleh aku melewatkannya?
Dialogue: 0,0:02:36.96,0:02:40.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mendapat ramalan buruk.
Dialogue: 0,0:02:40.63,0:02:41.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat?
Dialogue: 0,0:02:42.45,0:02:45.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun, aku yang melawan\NKantor Panglima Tertinggi.
Dialogue: 0,0:02:46.59,0:02:48.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takutnya perang akan berakhir gagal.
Dialogue: 0,0:02:49.22,0:02:52.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan kedamaian keluarga kekaisaran pun\Nakan terancam.
Dialogue: 0,0:02:52.34,0:02:55.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya aku sudah siap mental dicopot dari\Njabatan Wakil Menteri Urusan Pertahanan.
Dialogue: 0,0:02:55.96,0:02:58.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka hanya dipindahtugaskan,\Nsungguh mengecewakan.
Dialogue: 0,0:02:59.93,0:03:01.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku justru tidak dipindahtugaskan.
Dialogue: 0,0:03:03.68,0:03:06.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kita melawan atasan bersama-sama.
Dialogue: 0,0:03:06.75,0:03:08.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar sangat tidak masuk akal.
Dialogue: 0,0:03:08.75,0:03:10.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita adalah tentara.
Dialogue: 0,0:03:10.73,0:03:13.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya bisa menaati kehendak negara.
Dialogue: 0,0:03:14.07,0:03:15.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemahaman tentang perang,
Dialogue: 0,0:03:15.92,0:03:17.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dalam mediasi politik,
Dialogue: 0,0:03:19.22,0:03:23.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan mencari di seluruh markas besar,\Njuga tidak ada yang bisa menggantikanmu.
Dialogue: 0,0:03:25.72,0:03:27.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan tidak ada tempat untuk mengeluh.
Dialogue: 0,0:03:29.07,0:03:30.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:03:30.40,0:03:33.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang berat berpisah\Ndenganmu seperti ini...
Dialogue: 0,0:03:34.39,0:03:35.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah hampir waktunya.
Dialogue: 0,0:03:40.05,0:03:41.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Front timur kuserahkan padamu.
Dialogue: 0,0:03:42.06,0:03:45.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau dan aku, kita raih kemenangan bersama.
Dialogue: 0,0:03:45.57,0:03:46.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:03:46.57,0:03:47.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:03:48.26,0:03:49.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga kau beruntung dalam pertempuran.
Dialogue: 0,0:03:49.77,0:03:52.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembalilah sebagai jenderal yang menang.
Dialogue: 0,0:03:52.68,0:03:55.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapkan arak yang bagus dan cerutu.
Dialogue: 0,0:03:55.67,0:03:57.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan minum sampai kau bangkrut.
Dialogue: 0,0:04:07.97,0:04:10.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita raih kemenangan bersama?
Dialogue: 0,0:04:12.17,0:04:16.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekaisaran akan goyah jika mengalami\Nkegagalan sekali saja.
Dialogue: 0,0:04:17.16,0:04:21.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, Federasi bisa bangkit kembali\Nmeski terus-menerus kalah.
Dialogue: 0,0:04:26.19,0:04:28.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh sangat tidak adil.
Dialogue: 0,0:04:33.48,0:04:38.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun perwira harus bertugas sendirian\Nsetelah menerima perintah,
Dialogue: 0,0:04:38.58,0:04:41.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi pengaruh di timur\Nakan sangat terbatas.
Dialogue: 0,0:04:41.86,0:04:44.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, dapatkan dikatakan\Nbahwa tidak ada bidak yang bisa digunakan?
Dialogue: 0,0:04:46.13,0:04:49.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, masih ada satu.
Dialogue: 0,0:04:55.11,0:04:56.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:04:56.40,0:05:00.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku dipanggil\Nke Pasukan Front Timur?
Dialogue: 0,0:05:00.07,0:05:02.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah berkaitan dengan perundingan damai?
Dialogue: 0,0:05:02.27,0:05:05.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kenapa tidak ada\Nperintah gencatan senjata?
Dialogue: 0,0:05:05.63,0:05:10.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal perwira pengamat dari Yirudoya pun\Nbilang gencatan senjata hanya soal waktu.
Dialogue: 0,0:05:12.65,0:05:14.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah, bagaimanapun,
Dialogue: 0,0:05:14.16,0:05:17.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}perang ini tidak mungkin dilanjutkan lagi.
Dialogue: 0,0:05:17.70,0:05:21.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa pun yang bisa membuat penilaian\Nrasional, akan mengerti hal ini.
Dialogue: 0,0:05:22.45,0:05:25.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atasan seharusnya tidak akan sebodoh ini.
Dialogue: 0,0:05:26.10,0:05:26.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:05:28.54,0:05:29.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tidak berjumpa,
Dialogue: 0,0:05:30.42,0:05:32.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letnan Kolonel Degurechaff.
Dialogue: 0,0:05:39.80,0:05:41.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda
Dialogue: 0,0:05:41.84,0:05:43.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kenapa ada di sini?
Dialogue: 0,0:05:44.42,0:05:47.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ditugaskan ke perbatasan\Noleh Markas Besar Staf Umum.
Dialogue: 0,0:05:47.29,0:05:49.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk sementara, perlu minta bimbinganmu.
Dialogue: 0,0:05:49.74,0:05:51.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditugaskan ke perbatasan?
Dialogue: 0,0:05:51.77,0:05:54.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bos pihak kami ternyata jatuh?
Dialogue: 0,0:05:55.96,0:05:57.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, ada apa?
Dialogue: 0,0:05:57.60,0:05:59.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-maaf.
Dialogue: 0,0:05:59.10,0:06:00.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku agak pusing karena kurang tidur.
Dialogue: 0,0:06:01.02,0:06:02.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat.
Dialogue: 0,0:06:02.91,0:06:05.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini, rencana karierku...
Dialogue: 0,0:06:05.91,0:06:09.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini, surat rekomendasi dari Bos\Njuga tidak akan dilirik orang, 'kan?
Dialogue: 0,0:06:09.82,0:06:10.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tunggu.
Dialogue: 0,0:06:10.78,0:06:12.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau perundingan damai berhasil,
Dialogue: 0,0:06:12.06,0:06:14.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu masih dalam batas yang bisa diterima.
Dialogue: 0,0:06:14.87,0:06:17.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Omong-omong...\N- Sejujurnya, perundingan damai gagal.
Dialogue: 0,0:06:19.05,0:06:22.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi memperjuangkan syarat\Nyang lebih baik, Kantor Panglima Tertinggi
Dialogue: 0,0:06:22.04,0:06:24.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menuntut hasil perang lebih lanjut.
Dialogue: 0,0:06:24.97,0:06:28.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang menentang dan jadi dibenci,\Ntelah dipindahkan ke sini.
Dialogue: 0,0:06:28.80,0:06:31.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-apa kata Anda?
Dialogue: 0,0:06:31.88,0:06:33.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak hanya perundingan damai gagal,
Dialogue: 0,0:06:33.69,0:06:35.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi Bos malah jadi korban.
Dialogue: 0,0:06:35.31,0:06:36.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini benar-benar parah.
Dialogue: 0,0:06:37.38,0:06:37.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:06:38.41,0:06:39.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:06:39.07,0:06:39.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baik-baik saja?
Dialogue: 0,0:06:40.41,0:06:41.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-maaf.
Dialogue: 0,0:06:41.78,0:06:44.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku agak pusing karena terkejut.
Dialogue: 0,0:06:45.17,0:06:46.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa begitu.
Dialogue: 0,0:06:46.73,0:06:50.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke depannya kau harus\Nbekerja lebih keras dari sebelumnya.
Dialogue: 0,0:06:50.70,0:06:52.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam situasi seperti ini,
Dialogue: 0,0:06:52.54,0:06:54.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia masih mau memeras tenagaku?
Dialogue: 0,0:06:54.54,0:06:57.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, berdasarkan pertimbangan politik\Nyang kusebutkan tadi,
Dialogue: 0,0:06:57.80,0:07:02.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan bertanggung jawab atas\Noperasi ofensif besar-besaran di timur.
Dialogue: 0,0:07:03.13,0:07:05.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencana Andromeda.
Dialogue: 0,0:07:06.03,0:07:09.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuan utamanya untuk mendapatkan syarat\Nperundingan yang lebih menguntungkan.
Dialogue: 0,0:07:10.43,0:07:14.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah satu bagiannya adalah mematahkan\Nsemangat musuh untuk melanjutkan perang.
Dialogue: 0,0:07:14.85,0:07:19.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencana spesifiknya yaitu menguasai daerah\Npenghasil sumber daya Tentara Federal.
Dialogue: 0,0:07:20.40,0:07:21.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam rencana ini,
Dialogue: 0,0:07:21.77,0:07:24.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan Timur akan dibagi jadi Korps A yang\Nbertanggung jawab atas serangan utama,
Dialogue: 0,0:07:24.86,0:07:28.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan Korps B yang bertugas\Nmempertahankan garis depan.
Dialogue: 0,0:07:28.76,0:07:31.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang bertugas menyerang adalah A,\Nyang bertahan adalah B.
Dialogue: 0,0:07:32.56,0:07:35.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal operasi ini berhasil,
Dialogue: 0,0:07:35.48,0:07:38.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasukan kita dapat mempertahankan\Nkemampuan untuk terus bertempur,
Dialogue: 0,0:07:38.09,0:07:39.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan musuh akan melemah.
Dialogue: 0,0:07:39.90,0:07:42.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maka kita bisa berharap mereka membuat\Nkonsesi dalam perundingan damai.
Dialogue: 0,0:07:43.50,0:07:49.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi ini, Zettour pergi ke Korps B untuk\Nmelakukan inspeksi dan bimbingan, benar?
Dialogue: 0,0:07:50.10,0:07:52.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya hanya dikirim\Nke perbatasan saja.
Dialogue: 0,0:07:52.34,0:07:57.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kantor Panglima Tertinggi tidak mau\Nmendengar kata-kata yang menyakitkan.
Dialogue: 0,0:07:57.87,0:08:00.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah mengerti bagian rencananya.
Dialogue: 0,0:08:00.50,0:08:03.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, soal perundingan dengan Yirudoya...
Dialogue: 0,0:08:05.30,0:08:08.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar untuk sementara ditunda.
Dialogue: 0,0:08:10.08,0:08:13.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena atasan menyuruh kita menang,\Nmaka kita harus menang.
Dialogue: 0,0:08:13.93,0:08:15.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan harus menang.
Dialogue: 0,0:08:16.99,0:08:18.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terus terang saja.
Dialogue: 0,0:08:18.76,0:08:21.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pendapatmu mengenai Rencana Andromeda?
Dialogue: 0,0:08:23.09,0:08:25.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku harus jujur,
Dialogue: 0,0:08:25.43,0:08:27.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya ada satu kalimat,\Nberani tapi tidak cerdas.
Dialogue: 0,0:08:28.44,0:08:29.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lanjutkan.
Dialogue: 0,0:08:30.45,0:08:34.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Garis pertahanan yang harus\Ndijaga Korps B sudah terlalu luas,
Dialogue: 0,0:08:34.70,0:08:36.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kekuatan pasukan juga terlalu lemah.
Dialogue: 0,0:08:36.96,0:08:40.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika Korps A terus maju\Ndalam situasi seperti ini,
Dialogue: 0,0:08:40.10,0:08:43.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sisi sayap garis pertahanan yang\Nharus dijaga akan makin memanjang.
Dialogue: 0,0:08:43.32,0:08:44.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,
Dialogue: 0,0:08:44.19,0:08:46.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Korps B akan seperti karet gelang\Nyang ditarik sampai batas maksimal.
Dialogue: 0,0:08:47.08,0:08:48.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu, jangankan melakukan\Nserangan dua arah,
Dialogue: 0,0:08:48.64,0:08:50.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}takutnya bahkan dengan sedikit tusukan pun\Nbisa menyebabkan keruntuhan.
Dialogue: 0,0:08:51.48,0:08:53.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih jauh lagi,
Dialogue: 0,0:08:53.16,0:08:55.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nama rencana ini saja sudah\Nmembuatku tidak senang.
Dialogue: 0,0:08:56.05,0:08:57.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama rencana?
Dialogue: 0,0:08:58.34,0:09:03.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama ini artinya\N"kumpulan bintang di galaksi yang jauh".
Dialogue: 0,0:09:03.32,0:09:05.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski bisa merasakan keromantisannya,
Dialogue: 0,0:09:05.06,0:09:06.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi mungkin ini adalah tujuan\Nyang terlalu jauh.
Dialogue: 0,0:09:08.60,0:09:10.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benar.
Dialogue: 0,0:09:10.24,0:09:14.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemberi namanya adalah orang yang\Ntampak kasar, tapi ternyata cukup teliti.
Dialogue: 0,0:09:15.05,0:09:15.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:09:17.09,0:09:20.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sanggahan yang kau ajukan\Nsangat masuk akal.
Dialogue: 0,0:09:20.24,0:09:24.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sayangnya,\Nrencana tidak akan berubah.
Dialogue: 0,0:09:24.04,0:09:27.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ajukan saja proposal\Nuntuk rencana pertahanan Korps B.
Dialogue: 0,0:09:27.61,0:09:29.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Proposal?
Dialogue: 0,0:09:30.35,0:09:32.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang diperlukan\Nuntuk pertahanan yang baik?
Dialogue: 0,0:09:33.86,0:09:35.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Butuh kendali utama.
Dialogue: 0,0:09:35.37,0:09:38.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa kendali utama, pertahanan\Nsangat mustahil.
Dialogue: 0,0:09:38.84,0:09:40.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah kebenaran perang.
Dialogue: 0,0:09:40.62,0:09:42.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masalahnya ada pada cara konkretnya.
Dialogue: 0,0:09:43.14,0:09:46.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena ini adalah pilihan\Ndari pihak yang lebih lemah.
Dialogue: 0,0:09:46.70,0:09:48.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita ambil kesempatan\Ndan balas dengan tepat.
Dialogue: 0,0:09:48.57,0:09:50.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gunakan umpan untuk memancing musuh,
Dialogue: 0,0:09:50.84,0:09:53.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}setelah musuh masuk perangkap,\Nbaru kita hancurkan sekaligus.
Dialogue: 0,0:09:53.52,0:09:55.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya sangat mudah diucapkan.
Dialogue: 0,0:09:55.21,0:09:55.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:09:55.90,0:09:59.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus menyiapkan umpan yang cukup\Nuntuk membuat musuh terpancing.
Dialogue: 0,0:09:59.01,0:10:04.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan umpannya harus punya ketahanan\Nsampai mereka menelan kail sepenuhnya.
Dialogue: 0,0:10:05.01,0:10:07.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal itu tidak perlu khawatir.
Dialogue: 0,0:10:07.45,0:10:10.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih punya satu andalan.
Dialogue: 0,0:10:10.79,0:10:13.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun tidak tahu siapa orangnya,
Dialogue: 0,0:10:13.12,0:10:14.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kasihan sekali.
Dialogue: 0,0:10:15.46,0:10:20.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, kita juga perlu pemburu yang\Ndapat bunuh musuh begitu mereka terjebak.
Dialogue: 0,0:10:20.92,0:10:21.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm.
Dialogue: 0,0:10:21.99,0:10:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, cadangan strategis yang tersedia\Ndi Front Timur adalah Divisi Lapis Baja,
Dialogue: 0,0:10:25.20,0:10:28.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kekuatan utama Korps B?
Dialogue: 0,0:10:29.12,0:10:31.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi divisi utama pun tidak bisa\Ndimobilisasi dengan mudah.
Dialogue: 0,0:10:31.47,0:10:34.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu, yang bisa\Nsegera dimobilisasi,
Dialogue: 0,0:10:34.23,0:10:36.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin hanya Kampfgruppe milikmu...
Dialogue: 0,0:10:37.76,0:10:39.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, jangan khawatir.
Dialogue: 0,0:10:39.26,0:10:42.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun aku atasan yang keterlaluan,\Ntidak sampai meminta hal itu padamu.
Dialogue: 0,0:10:42.71,0:10:44.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak atas perhatian Anda.
Dialogue: 0,0:10:44.78,0:10:47.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, tidak perlu sungkan.
Dialogue: 0,0:10:47.72,0:10:51.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun, aku masih perlu kau\Nmenjadi umpan.
Dialogue: 0,0:10:51.66,0:10:56.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah jadi umpan, kau jadi pemburu juga,\Naku pun rasa permintaan ini keterlaluan.
Dialogue: 0,0:10:56.97,0:10:57.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:10:58.13,0:10:59.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Er...
Dialogue: 0,0:10:59.53,0:11:01.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya aku?
Dialogue: 0,0:11:01.52,0:11:02.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi umpan?
Dialogue: 0,0:11:02.98,0:11:04.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini usulanmu.
Dialogue: 0,0:11:04.52,0:11:07.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar saja kalau kau yang menjalankannya.
Dialogue: 0,0:11:08.22,0:11:11.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjadikan pasukan yang menyerang\Nibu kota para bocah itu sebagai umpan,
Dialogue: 0,0:11:11.04,0:11:13.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti banyak musuh yang akan terpancing.
Dialogue: 0,0:11:19.81,0:11:22.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, meskipun bisa menggunakan\NDivisi Lapis Baja inti,
Dialogue: 0,0:11:22.96,0:11:26.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kayaknya modalnya masih kurang.
Dialogue: 0,0:11:26.45,0:11:28.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda benar sekali.
Dialogue: 0,0:11:28.19,0:11:29.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus terang, aku sangat malu.
Dialogue: 0,0:11:29.87,0:11:33.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Usulanku ini sepertinya kemungkinan\Nuntuk direalisasikan yang sangat kecil.
Dialogue: 0,0:11:33.39,0:11:35.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan segera menyusun usulan lain.
Dialogue: 0,0:11:35.64,0:11:36.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:11:37.08,0:11:39.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakai saja kompi di bawahmu.
Dialogue: 0,0:11:42.58,0:11:43.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:11:43.48,0:11:45.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak dengar?
Dialogue: 0,0:11:45.25,0:11:47.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau meminjam kompi archmage-mu.
Dialogue: 0,0:11:47.60,0:11:49.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti itu sudah cukup.
Dialogue: 0,0:11:49.27,0:11:51.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anda ingin membagi kekuatan?
Dialogue: 0,0:11:51.38,0:11:52.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:11:52.32,0:11:54.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-izinkan aku bicara terus terang.
Dialogue: 0,0:11:54.01,0:11:56.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukanku bukan kompi biasa.
Dialogue: 0,0:11:56.73,0:12:00.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi, dalam pertempuran defensif,\Npasukan archmage adalah kuncinya.
Dialogue: 0,0:12:00.89,0:12:03.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sama saja memotong\Ntangan dan kakiku...
Dialogue: 0,0:12:03.24,0:12:04.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:12:04.18,0:12:05.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya memotong satu jari saja.
Dialogue: 0,0:12:06.23,0:12:10.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-apa mesti diambil dari kompiku?
Dialogue: 0,0:12:10.47,0:12:14.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak begitu, bagaimana kami\Nmenyelamatkan dirimu yang terkepung?
Dialogue: 0,0:12:20.49,0:12:24.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika Anda dapat menerima tim yang dipimpin\Noleh Letnan Glanz yang lebih muda...
Dialogue: 0,0:12:25.45,0:12:26.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat berterima kasih.
Dialogue: 0,0:12:26.71,0:12:28.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya adalah masalah\Ntempat memancing kali ini.
Dialogue: 0,0:12:29.19,0:12:30.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihatlah.
Dialogue: 0,0:12:30.59,0:12:31.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini.
Dialogue: 0,0:12:32.14,0:12:34.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pos Pertahanan Soldim 528?
Dialogue: 0,0:12:34.90,0:12:38.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya itu adalah pos perbaikan\Nkendaraan Federasi.
Dialogue: 0,0:12:38.72,0:12:42.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun direbut oleh Tentara Kekaisaran\Ndalam Pertempuran Martil sebelumnya,
Dialogue: 0,0:12:42.56,0:12:45.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena pasukan ditarik, saat ini\Ndalam keadaan setengah terbengkalai.
Dialogue: 0,0:12:46.49,0:12:48.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat itu berada\Ndi sepanjang jalur kereta api,
Dialogue: 0,0:12:48.39,0:12:50.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sangat cocok sebagai pos pasokan.
Dialogue: 0,0:12:50.57,0:12:54.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika musuh ingin merebut kembali pos,\Nkemungkinan besar di sini.
Dialogue: 0,0:12:55.03,0:12:58.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kampfgruppe-mu harus\Nmenghadang serangan utama musuh.
Dialogue: 0,0:12:58.90,0:13:01.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus bertahan sampai bantuan datang.
Dialogue: 0,0:13:01.98,0:13:03.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar.
Dialogue: 0,0:13:03.39,0:13:06.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah aku boleh menilai sendiri\Nuntuk mundur sesuai situasi...
Dialogue: 0,0:13:06.11,0:13:07.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak diizinkan.
Dialogue: 0,0:13:08.02,0:13:09.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus bertahan mati-matian.
Dialogue: 0,0:13:17.88,0:13:19.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tidak berjumpa.
Dialogue: 0,0:13:19.61,0:13:21.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman.
Dialogue: 0,0:13:21.37,0:13:22.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}William.
Dialogue: 0,0:13:22.94,0:13:24.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau masih saja berwajah muram, ya.
Dialogue: 0,0:13:25.08,0:13:26.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:13:26.02,0:13:29.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena anak bermasalah di timku\Nsudah mendapat teman.
Dialogue: 0,0:13:30.68,0:13:35.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat berterima kasih kalau Laksamana\NMuda Harbergram mau terima mereka.
Dialogue: 0,0:13:38.16,0:13:40.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sedikit tanda terima kasih dariku.
Dialogue: 0,0:13:40.16,0:13:43.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selundupkan setelah bernegosiasi\Ndengan petugas bea cukai Federasi.
Dialogue: 0,0:13:43.23,0:13:44.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini wiski dari negara kami.
Dialogue: 0,0:13:45.34,0:13:47.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini benar-benar...
Dialogue: 0,0:13:50.27,0:13:52.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakar setelah dibaca.
Dialogue: 0,0:13:52.12,0:13:54.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini informasi terbaru dari ULTRA.
Dialogue: 0,0:13:56.56,0:13:59.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mata-mata yang menyusup\Nke pusat Kekaisaran itu?
Dialogue: 0,0:14:00.80,0:14:02.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa dipercaya?
Dialogue: 0,0:14:02.55,0:14:04.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah dengar soal\Npergerakan Kekaisaran, 'kan?
Dialogue: 0,0:14:04.81,0:14:05.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:14:06.05,0:14:08.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kode aksinya adalah Andromeda.
Dialogue: 0,0:14:08.17,0:14:09.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami juga diinstruksikan\Nuntuk menanganinya.
Dialogue: 0,0:14:10.65,0:14:12.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut informasi dari ULTRA,
Dialogue: 0,0:14:12.07,0:14:15.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di baliknya tampaknya ada pertentangan\Nantara militer Kekaisaran dan pemerintah.
Dialogue: 0,0:14:16.11,0:14:18.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Informasi musuh yang menyenangkan.
Dialogue: 0,0:14:18.33,0:14:20.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, meskipun tahu semua ini...
Dialogue: 0,0:14:20.81,0:14:22.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertentangan ini,
Dialogue: 0,0:14:22.71,0:14:26.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menyebabkan seorang jenderal dari\Nmarkas besar dipindahkan ke front timur.
Dialogue: 0,0:14:28.46,0:14:31.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letnan Jenderal Hans von Zettour.
Dialogue: 0,0:14:31.46,0:14:32.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pria yang merepotkan.
Dialogue: 0,0:14:33.21,0:14:33.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merepotkan?
Dialogue: 0,0:14:34.47,0:14:35.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya kemampuannya sangat kuat?
Dialogue: 0,0:14:35.95,0:14:38.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuat, dan sangat menakutkan.
Dialogue: 0,0:14:38.68,0:14:41.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau punya kesempatan\Nmelihatnya di medan perang,
Dialogue: 0,0:14:41.98,0:14:43.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bunuhlah dia.
Dialogue: 0,0:14:43.28,0:14:44.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun juga, harus singkirkan dia.
Dialogue: 0,0:14:54.99,0:15:01.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir kekuatan udara Tentara Federal\Ntelah dihancurkan dalam Pertempuran Martil,
Dialogue: 0,0:15:01.46,0:15:04.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sudah dibangun kembali dengan\Ndukungan senjata dari Negara Federasi.
Dialogue: 0,0:15:05.27,0:15:09.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Prasyarat Rencana Andromeda\Nsudah runtuh secepat ini?
Dialogue: 0,0:15:09.84,0:15:12.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang itu mungkin akan marah besar.
Dialogue: 0,0:15:15.73,0:15:17.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa ini?
Dialogue: 0,0:15:17.21,0:15:19.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa belum ada kesepakatan\Ndengan Kementerian Luar Negeri?
Dialogue: 0,0:15:20.15,0:15:22.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena sebelumnya negosiasi\Ndengan departemen administratif,
Dialogue: 0,0:15:22.51,0:15:25.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selalu dilakukan oleh Zettour\Nsecara tidak resmi.
Dialogue: 0,0:15:25.40,0:15:26.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sekarang...
Dialogue: 0,0:15:28.33,0:15:32.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan konvoi kapal\Nyang tidak dikenal kewarganegaraannya itu?
Dialogue: 0,0:15:32.02,0:15:35.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut laporan Armada Laut Utara,\Njumlahnya masih terus bertambah.
Dialogue: 0,0:15:35.83,0:15:36.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial.
Dialogue: 0,0:15:36.87,0:15:40.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa langsung melancarkan serangan\Ntanpa pandang bulu dengan kapal selam?
Dialogue: 0,0:15:40.55,0:15:42.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut para ahli hukum,
Dialogue: 0,0:15:42.66,0:15:45.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tindakan seperti ini berisiko tinggi\Nmelanggar hukum internasional.
Dialogue: 0,0:15:46.34,0:15:48.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laporannya terlalu lambat!
Dialogue: 0,0:15:54.60,0:15:56.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Letnan Kolonel Uga.
Dialogue: 0,0:16:02.90,0:16:06.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerajaan Bersatu kembali melancarkan\Npemboman malam ke kawasan industri barat.
Dialogue: 0,0:16:06.56,0:16:09.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini sedang merekap\Nlaporan hasil pertempuran.
Dialogue: 0,0:16:09.00,0:16:12.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kekuatan kita tidak cukup untuk\Nmenghentikan semua pesawat musuh.
Dialogue: 0,0:16:12.17,0:16:14.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang sudah berdampak\Npada efisiensi produksi.
Dialogue: 0,0:16:14.99,0:16:16.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasokan untuk Andromeda\Njuga sudah bermasalah.
Dialogue: 0,0:16:16.49,0:16:18.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Otakmu sudah buntu?
Dialogue: 0,0:16:20.76,0:16:24.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang disampaikan,\Nsemuanya laporan membosankan.
Dialogue: 0,0:16:24.00,0:16:26.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba ceritakan lelucon.
Dialogue: 0,0:16:28.25,0:16:29.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:16:31.21,0:16:34.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah ini benar?
Dialogue: 0,0:16:34.32,0:16:36.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, Loriya.
Dialogue: 0,0:16:36.52,0:16:40.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabarnya kaum reaksioner yang disebut\N"Iblis dari Rhein" telah menduduki posisi.
Dialogue: 0,0:16:40.99,0:16:44.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa bisa begitu payah?
Dialogue: 0,0:16:44.01,0:16:47.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku sudah tergoda?
Dialogue: 0,0:16:47.86,0:16:49.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, mereka meremehkan kita.
Dialogue: 0,0:16:49.84,0:16:52.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri tahu pihak militer,\Nsuruh mereka pergi tangani.
Dialogue: 0,0:16:52.62,0:16:53.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri tahu?
Dialogue: 0,0:16:53.82,0:16:55.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suruh mereka yang menangani?
Dialogue: 0,0:16:56.76,0:16:58.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong kosong apa?
Dialogue: 0,0:16:58.34,0:16:59.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sendiri yang harus\Nmenangkapnya hidup-hidup.
Dialogue: 0,0:17:00.24,0:17:01.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksud Anda menangkap hidup-hidup?
Dialogue: 0,0:17:02.17,0:17:05.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mati dalam pertempuran,\Nbukankah akan jadi pahlawan?
Dialogue: 0,0:17:05.02,0:17:08.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus mengadilinya\Ndi pengadilan umum, dan menghukumnya.
Dialogue: 0,0:17:08.09,0:17:10.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat dia hidup tidak bisa,\Nmati pun tidak bisa.
Dialogue: 0,0:17:10.12,0:17:11.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun yang terjadi...
Dialogue: 0,0:17:25.73,0:17:27.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun pengepungan sudah diduga,
Dialogue: 0,0:17:27.78,0:17:29.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi tak disangka jumlahnya sebanyak ini.
Dialogue: 0,0:17:30.26,0:17:33.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus membayar utang\Natas kekacauan yang dilakukan di Moskow?
Dialogue: 0,0:17:33.75,0:17:34.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial.
Dialogue: 0,0:17:34.54,0:17:36.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iri sekali pada Letnan Glanz.
Dialogue: 0,0:17:36.75,0:17:40.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letnan seharusnya tidak akan\Nmembuat kesalahan di sisi Bos, 'kan?
Dialogue: 0,0:17:40.12,0:17:41.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang tahu?
Dialogue: 0,0:17:41.61,0:17:43.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dihukum pancung saja masih tergolong baik.
Dialogue: 0,0:17:43.99,0:17:46.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih ada yang lebih buruk dari itu?
Dialogue: 0,0:17:48.68,0:17:51.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan bantuan benar-benar\Nakan datang, 'kan?
Dialogue: 0,0:17:53.07,0:17:54.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menerima kontak darurat dari Kampfgruppe Rerugen.
Dialogue: 0,0:17:54.87,0:17:59.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pos Pertahanan Soldim 528 telah dikepung\Noleh banyak pasukan Tentara Federal.
Dialogue: 0,0:17:59.47,0:18:00.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa katamu?
Dialogue: 0,0:18:00.43,0:18:03.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah menyimpang dari rute maju\Nmusuh yang diperkirakan.
Dialogue: 0,0:18:03.37,0:18:05.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Masih ada ruang untuk mundur, 'kan?\N- Apa yang dilakukan penjaga dan jaringan pengawasan?
Dialogue: 0,0:18:10.28,0:18:11.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jumlahnya terlalu banyak.
Dialogue: 0,0:18:11.51,0:18:13.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tidak ada habisnya.\N- Mereka menyerbu dengan paksa.
Dialogue: 0,0:18:13.77,0:18:16.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Posisi garis depan akan segera ditembus.
Dialogue: 0,0:18:16.60,0:18:18.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Garis pertahanan akan ditembus.
Dialogue: 0,0:18:18.50,0:18:20.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlalu cepat, suruh mereka bertahan.
Dialogue: 0,0:18:20.47,0:18:21.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perjuangkan waktu selama mungkin.
Dialogue: 0,0:18:22.20,0:18:23.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat.
Dialogue: 0,0:18:23.31,0:18:25.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat sekali mereka masuk ke area kota.
Dialogue: 0,0:18:26.65,0:18:28.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana situasi setiap unit?
Dialogue: 0,0:18:28.22,0:18:30.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan lapis baja sudah mundur\Ndan menyelesaikan penyamaran.
Dialogue: 0,0:18:31.08,0:18:32.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini tidak ada kerusakan.
Dialogue: 0,0:18:32.63,0:18:34.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artileri juga sama.
Dialogue: 0,0:18:34.24,0:18:37.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain tim yang mendukung infanteri,\Npasukan lainnya utuh tanpa kerusakan.
Dialogue: 0,0:18:37.95,0:18:41.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, tak kusangka bisa mendengar\Nperkataan seperti ini dari mulut kalian.
Dialogue: 0,0:18:41.74,0:18:42.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letnan Kolonel.
Dialogue: 0,0:18:42.73,0:18:44.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letnan Tospan menyampaikan saran.
Dialogue: 0,0:18:44.77,0:18:47.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Letnan Tospan?
Dialogue: 0,0:18:47.18,0:18:50.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan mau berulah lagi?
Dialogue: 0,0:18:50.92,0:18:52.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini Letnan Kolonel Degurechaff.
Dialogue: 0,0:18:52.46,0:18:53.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:18:53.48,0:18:56.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harap Letnan Kolonel\Nbisa memberi kami perintah.
Dialogue: 0,0:18:56.27,0:18:58.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya aku sudah memberikan perintah.
Dialogue: 0,0:18:58.91,0:18:59.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:18:59.87,0:19:02.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, saat menghadapi musuh\Ndalam skala seperti ini,
Dialogue: 0,0:19:02.09,0:19:05.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menurut pelatihan taktik militer,\Nakan meminta pasukan untuk mundur".
Dialogue: 0,0:19:05.72,0:19:10.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, harap memberi perintah "bertahan mati-matian"\Ndengan wewenang komandan unit.
Dialogue: 0,0:19:11.66,0:19:13.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus...
Dialogue: 0,0:19:13.98,0:19:15.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengagumimu, Letnan.
Dialogue: 0,0:19:15.60,0:19:18.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan segera mengirimkan\Nsurat perintah bertahan mati-matian.
Dialogue: 0,0:19:18.05,0:19:19.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, kuterima.
Dialogue: 0,0:19:22.51,0:19:24.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Letnan Tospan?
Dialogue: 0,0:19:25.03,0:19:27.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artileri berat musuh.
Dialogue: 0,0:19:27.08,0:19:30.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka menembak tanpa pandang bulu.
Dialogue: 0,0:19:30.57,0:19:33.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih, benar-benar kejam.
Dialogue: 0,0:19:33.06,0:19:35.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuh menganggap infanteri mereka\Nsebagai pion buangan?
Dialogue: 0,0:19:35.49,0:19:36.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letnan Kolonel.
Dialogue: 0,0:19:36.74,0:19:38.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan kami melakukan\Nserangan balik artileri.
Dialogue: 0,0:19:38.78,0:19:40.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditolak. Biarkan pasukan archmage\Nyang menangani.
Dialogue: 0,0:19:41.44,0:19:44.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mayor Weiß, jatuhkan\Npeluru artileri musuh.
Dialogue: 0,0:19:44.36,0:19:46.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letnan Kolonel, Anda serius?
Dialogue: 0,0:19:46.74,0:19:51.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian seharusnya sudah dilatih untuk ini\Nsejak pembentukan batalion.
Dialogue: 0,0:19:51.85,0:19:53.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepadatan kekuatan militer terlalu lemah.
Dialogue: 0,0:19:53.76,0:19:55.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya dengan dua kompi\Ntidak bisa menangani semuanya.
Dialogue: 0,0:19:55.71,0:19:57.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mayor Weiß.
Dialogue: 0,0:19:57.64,0:20:00.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai perwira senior,\Nkau tidak bisa seperti ini.
Dialogue: 0,0:20:00.48,0:20:02.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau mau dididik ulang?
Dialogue: 0,0:20:07.18,0:20:08.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tidak, tidak...
Dialogue: 0,0:20:08.30,0:20:09.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu.
Dialogue: 0,0:20:09.44,0:20:10.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kompi Kedua, Kompi Ketiga!
Dialogue: 0,0:20:10.68,0:20:13.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jatuhkan peluru meriam dan serang\Nartileri musuh secara bersamaan.
Dialogue: 0,0:20:13.32,0:20:14.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikuti aku!
Dialogue: 0,0:20:20.37,0:20:23.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kau menjadi barisan depan?
Dialogue: 0,0:20:28.65,0:20:30.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata Federasi punya pasukan archmage.
Dialogue: 0,0:20:30.62,0:20:33.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan itu adalah unit sukarelawan\Nyang pernah bertempur di Tiegenhoff?
Dialogue: 0,0:20:33.60,0:20:34.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mundur.
Dialogue: 0,0:20:34.41,0:20:36.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Persiapan teknik penetrasi!
Dialogue: 0,0:20:44.08,0:20:45.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}02, bagaimana situasinya?
Dialogue: 0,0:20:45.88,0:20:47.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}02, bagaimana situasinya?
Dialogue: 0,0:20:47.10,0:20:48.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau lakukan?
Dialogue: 0,0:21:08.28,0:21:09.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Weiß, ada apa?
Dialogue: 0,0:21:09.96,0:21:11.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Weiß!
Dialogue: 0,0:22:43.77,0:22:45.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mohon diri.
Dialogue: 0,0:22:49.53,0:22:50.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Huh...
Dialogue: 0,0:22:50.79,0:22:52.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letnan Kolonel Uga?
Dialogue: 0,0:22:52.87,0:22:54.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Anda, Kolonel Rerugen.
Dialogue: 0,0:22:55.41,0:22:58.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama kita tidak bertemu seperti ini.
Dialogue: 0,0:22:58.36,0:22:59.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Anda agak kurusan?
Dialogue: 0,0:23:00.01,0:23:00.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:23:00.93,0:23:02.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kolonel juga, ya.
Dialogue: 0,0:23:03.25,0:23:06.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita berdua sama-sama\Nmenjalani banyak tugas berat.
Dialogue: 0,0:23:06.04,0:23:07.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesekali, ayo kita pergi minum.
Dialogue: 0,0:23:07.79,0:23:10.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya, aku masih ada pekerjaan...
Dialogue: 0,0:23:10.02,0:23:12.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Otakmu sudah buntu?
Dialogue: 0,0:23:13.90,0:23:15.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kolonel Rerugen.
Dialogue: 0,0:23:21.54,0:23:22.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letnan Kolonel Uga.
Dialogue: 0,0:23:24.04,0:23:27.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka ternyata kau seperti ini.
Dialogue: 0,0:23:27.56,0:23:32.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi kau punya istri dan anak,\Nmemikul tanggung jawab berat,
Dialogue: 0,0:23:32.05,0:23:34.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi tanpa ragu di tempat seperti ini...
