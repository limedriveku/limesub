Dialogue: 0,0:01:01.83,0:01:09.17,sign,,0000,0000,0000,,(Saga of Tanya the Evil 2)
Dialogue: 0,0:02:26.94,0:02:30.91,sign,,0000,0000,0000,,ANIMASI INI BERSIFAT FIKTIF
Dialogue: 0,0:02:30.91,0:02:32.01,sign,,0000,0000,0000,,ISI DRAMA TIDAK IDENTIK DENGAN DUNIA NYATA
Dialogue: 0,0:02:53.36,0:02:54.22,sign,,0000,0000,0000,,(Episode 6: Umpan)
Dialogue: 0,0:02:55.42,0:02:58.03,sign,,0000,0000,0000,,18 JUNI 1927 KALENDER BERSATU, PAGI HARI
Dialogue: 0,0:05:42.02,0:05:44.53,sign,,0000,0000,0000,,POS PERTAHANAN SOLDIM 528
Dialogue: 0,0:06:06.55,0:06:08.00,sign,,0000,0000,0000,,DARI: ZETTOUR\NKEPADA: KAMPFGRUPPE RERUGEN
Dialogue: 0,0:06:08.01,0:06:10.80,sign,,0000,0000,0000,,SEGERA MULAI BERAKSI
Dialogue: 0,0:06:50.05,0:06:51.53,sign,,0000,0000,0000,,MALAM DI HARI YANG SAMA, MARKAS KOMANDO\NPASUKAN PENGEPUNGAN SOLDIM TENTARA FEDERASI
Dialogue: 0,0:08:27.04,0:08:29.53,sign,,0000,0000,0000,,KEESOKAN HARINYA, DINI HARI
Dialogue: 0,0:11:23.99,0:11:29.99,sign,,0000,0000,0000,,(Saga of Tanya the Evil 2)
Dialogue: 0,0:11:45.05,0:11:47.43,sign,,0000,0000,0000,,BERSAMAAN, POS PERTAHANAN SOLDIM 528
Dialogue: 0,0:12:48.53,0:12:51.29,sign,,0000,0000,0000,,DI ATAS POS PERTAHANAN SOLDIM 528
Dialogue: 0,0:13:04.07,0:13:05.17,sign,,0000,0000,0000,,HQ!
Dialogue: 0,0:14:49.28,0:14:50.82,sign,,0000,0000,0000,,DEKAT PASUKAN PENYELAMAT, DI UDARA
Dialogue: 0,0:23:35.97,0:23:39.98,sign,,0000,0000,0000,,(Episode Berikutnya: Api Penyucian)
Dialogue: 0,0:00:01.55,0:00:04.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mayor, kau baik-baik saja?
Dialogue: 0,0:00:06.88,0:00:09.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa orang itu?
Dialogue: 0,0:00:11.45,0:00:13.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus, Kolonel Mikel.
Dialogue: 0,0:00:14.08,0:00:16.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya berkat bimbingan Partai.
Dialogue: 0,0:00:17.46,0:00:19.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau melepaskan musuh?
Dialogue: 0,0:00:19.57,0:00:23.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus jatuhkan semua pasukan\Nyang dipimpin oleh Iblis dari Rhein itu!
Dialogue: 0,0:00:24.35,0:00:27.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perintah Partai adalah mengepung.
Dialogue: 0,0:00:27.34,0:00:29.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kau mau melewatkan\Nkesempatan besar di depan mata ini?
Dialogue: 0,0:00:30.67,0:00:32.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perintah harus dipatuhi.
Dialogue: 0,0:00:32.55,0:00:35.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau menurutmu Partai kita salah?
Dialogue: 0,0:00:35.38,0:00:37.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah bisa memenangkan pertempuran\Njika selalu tunduk pada perintah?
Dialogue: 0,0:00:37.43,0:00:39.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letnan Sue, cukup!
Dialogue: 0,0:00:39.73,0:00:41.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia adalah komandan pasukan sekutu.
Dialogue: 0,0:00:41.60,0:00:43.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunjukkan rasa hormatmu.
Dialogue: 0,0:00:45.31,0:00:46.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:00:49.92,0:00:52.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iblis dari Rhein, ya?
Dialogue: 0,0:02:26.94,0:02:28.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dikalahkan oleh tentara sukarelawan
Dialogue: 0,0:02:28.19,0:02:29.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}multinasional lemah.
Dialogue: 0,0:02:29.37,0:02:30.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh memalukan!
Dialogue: 0,0:02:30.91,0:02:32.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu Federasi.
Dialogue: 0,0:02:32.56,0:02:34.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Archmage Federasi.
Dialogue: 0,0:02:34.44,0:02:35.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:02:35.30,0:02:39.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Federasi seharusnya sudah sejak lama\Nmembersihkan simbol-simbol rezim lama.
Dialogue: 0,0:02:39.87,0:02:42.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-aku tidak mungkin salah lihat.
Dialogue: 0,0:02:44.83,0:02:46.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata Federasi masih memiliki archmage.
Dialogue: 0,0:02:47.31,0:02:49.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah mereka dikeluarkan\Ndari kamp konsentrasi?
Dialogue: 0,0:02:49.54,0:02:53.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak sangka kelompok Partai Komunis sialan\Nbegitu ngotot mengejar kami.
Dialogue: 0,0:02:54.22,0:02:55.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya!
Dialogue: 0,0:02:55.42,0:02:58.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tidak kirim pasukan penyelamat?
Dialogue: 0,0:02:59.82,0:03:04.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyelamatkan pasukan sekutu yang\Nterkepung, seharusnya sangat wajar, 'kan?
Dialogue: 0,0:03:05.07,0:03:08.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan melumpuhkan pasukan musuh\Nyang mengepung Kampfgruppe Rerugen,
Dialogue: 0,0:03:09.19,0:03:13.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}juga dapat memberi dukungan bagi Korps A\Nyang menjadi kekuatan utama kita.
Dialogue: 0,0:03:13.26,0:03:15.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencana Andromeda
Dialogue: 0,0:03:16.00,0:03:20.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah langkah pertama yang berani\Ndemi keberhasilan operasi.
Dialogue: 0,0:03:20.96,0:03:21.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia.
Dialogue: 0,0:03:21.86,0:03:25.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perintah dari atasan kepada Korps B kita\Nadalah bertahan di garis depan.
Dialogue: 0,0:03:26.08,0:03:28.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon pertimbangkan\Nsituasi Kekaisaran saat ini.
Dialogue: 0,0:03:28.38,0:03:31.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang kita bisa runtuh\Nhanya jika gagal satu kali saja.
Dialogue: 0,0:03:31.89,0:03:35.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, cukup jangan gagal saja.
Dialogue: 0,0:03:37.39,0:03:38.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bulatkan tekad.
Dialogue: 0,0:03:38.52,0:03:40.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah tugas seorang komandan.
Dialogue: 0,0:03:41.07,0:03:42.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ingin menggunakan pikiran,
Dialogue: 0,0:03:42.89,0:03:46.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jangan untuk kebimbangan,\Ntapi untuk membuat keputusan.
Dialogue: 0,0:03:52.46,0:03:55.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berlarut-larut hanya membuang waktu.
Dialogue: 0,0:03:55.98,0:03:59.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham kekhawatiran kalian semua.
Dialogue: 0,0:03:59.69,0:04:00.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oleh karena itu,
Dialogue: 0,0:04:01.47,0:04:04.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian bertindaklah sesuai\Nkeyakinan kalian masing-masing.
Dialogue: 0,0:04:11.62,0:04:12.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, er,
Dialogue: 0,0:04:12.69,0:04:16.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maaf, bisakah panggilkan\NLetnan Glanz kemari?
Dialogue: 0,0:04:18.01,0:04:22.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku mengajukan permintaan\Nberdasarkan wewenang dari Markas Besar.
Dialogue: 0,0:04:22.55,0:04:23.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon bantuannya.
Dialogue: 0,0:04:31.51,0:04:33.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letnan Glanz, melapor.
Dialogue: 0,0:04:34.37,0:04:36.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letnan, apakah kau suka berjalan-jalan?
Dialogue: 0,0:04:37.83,0:04:42.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menghubungi Komandan Divisi Kramm\Ndari Pasukan Cadangan Strategis.
Dialogue: 0,0:04:42.20,0:04:44.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Komandan divisi lainnya juga akan ikut.
Dialogue: 0,0:04:44.52,0:04:45.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan kelancanganku.
Dialogue: 0,0:04:45.77,0:04:47.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mengerti maksud Anda.
Dialogue: 0,0:04:47.94,0:04:50.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini menyangkut Pos Pertahanan Soldim 528.
Dialogue: 0,0:04:50.56,0:04:54.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau seharusnya tahu soal\NKampfgruppe Rerugen dikepung, 'kan?
Dialogue: 0,0:04:56.75,0:04:58.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan saja padaku.
Dialogue: 0,0:04:58.08,0:05:01.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan segera bergabung dengan\NKomandan Divisi Kramm dan memberi dukungan.
Dialogue: 0,0:05:03.99,0:05:05.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tunggu.
Dialogue: 0,0:05:07.84,0:05:08.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia?
Dialogue: 0,0:05:09.20,0:05:11.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda tidak perlu repot-repot mengantar.
Dialogue: 0,0:05:19.03,0:05:20.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia!
Dialogue: 0,0:05:20.09,0:05:21.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon mundurlah!
Dialogue: 0,0:05:22.13,0:05:23.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditolak.
Dialogue: 0,0:05:23.84,0:05:28.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak Kekaisaran bentuk tentara, bukankah\Nprinsipnya komandan harus pimpin di depan?
Dialogue: 0,0:05:29.53,0:05:30.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, semuanya.
Dialogue: 0,0:05:30.80,0:05:32.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita terjun ke dalam lumpur.
Dialogue: 0,0:05:32.83,0:05:35.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita mulai perang ini bersama-sama.
Dialogue: 0,0:05:44.99,0:05:47.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waspada, hati-hati terhadap penyergapan!
Dialogue: 0,0:05:50.87,0:05:52.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan tembak dulu.
Dialogue: 0,0:05:52.36,0:05:54.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhasil menanganinya\Ndengan teknik penembak jitu.
Dialogue: 0,0:05:55.99,0:05:57.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kabar baik.
Dialogue: 0,0:05:57.13,0:05:58.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan penyelamat mulai bergerak.
Dialogue: 0,0:05:59.25,0:06:00.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya?
Dialogue: 0,0:06:00.70,0:06:04.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan sepertinya Letnan Jenderal Zettour\Nsedang menuju ke sini.
Dialogue: 0,0:06:04.21,0:06:06.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Yang Mulia datang sendiri?
Dialogue: 0,0:06:08.01,0:06:10.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segera mulai beraksi?
Dialogue: 0,0:06:11.02,0:06:13.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya, kita diperintahkan\Nuntuk melancarkan aksi tempur,
Dialogue: 0,0:06:13.63,0:06:16.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memilih langkah penanggulangan\Nyang paling tepat?
Dialogue: 0,0:06:17.72,0:06:20.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa sebenarnya yang dipikirkan\Noleh Yang Mulia Zettour?
Dialogue: 0,0:06:23.90,0:06:25.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arah jam 2, terlihat tank musuh!
Dialogue: 0,0:06:25.96,0:06:27.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersiap untuk menyerang!
Dialogue: 0,0:06:27.12,0:06:28.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia, kumohon, segeralah mundur.
Dialogue: 0,0:06:28.88,0:06:30.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu khawatir.
Dialogue: 0,0:06:30.73,0:06:33.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah meminjam archmage\Nuntuk menjadi pengawal.
Dialogue: 0,0:06:33.50,0:06:35.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-maafkan aku bicara lancang,\Ntapi bagaimanapun ini terlalu...
Dialogue: 0,0:06:41.53,0:06:43.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus, Letnan.
Dialogue: 0,0:06:43.00,0:06:45.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas pujiannya, Yang Mulia,\Ntapi sebaiknya kita segera mundur.
Dialogue: 0,0:06:45.02,0:06:47.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja aku tahu ada musuh.
Dialogue: 0,0:06:47.21,0:06:49.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuserahkan saja pada kalian\Nuntuk mengatasinya.
Dialogue: 0,0:06:51.53,0:06:53.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan pembebas musuh?
Dialogue: 0,0:06:53.45,0:06:54.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, Letnan Kolonel.
Dialogue: 0,0:06:55.47,0:06:59.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jaringan pengawasan pasukan sekutu yang sedang digelar\Ntelah mendeteksi bala bantuan baru dari Kekaisaran.
Dialogue: 0,0:06:59.94,0:07:04.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan pasukan yang diduga merupakan pasukan pembebas musuh\Ntelah mencapai garis pertahanan kita.
Dialogue: 0,0:07:04.40,0:07:06.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini sedang bertempur\Ndengan pasukan kita.
Dialogue: 0,0:07:06.66,0:07:11.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, apakah komandan musuh\Nbenar-benar adalah Hans von Zettour?
Dialogue: 0,0:07:11.96,0:07:14.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berdasarkan analisis\Ndari penyadapan radio musuh,
Dialogue: 0,0:07:14.45,0:07:17.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kemungkinan seperti itu sangat tinggi.
Dialogue: 0,0:07:17.59,0:07:19.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika memang benar dia sendiri...
Dialogue: 0,0:07:20.20,0:07:22.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunuh dia. Apa pun yang terjadi,\Nsingkirkan dia.
Dialogue: 0,0:07:23.34,0:07:25.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu adalah target strategis\Nbernilai tinggi.
Dialogue: 0,0:07:25.52,0:07:28.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarpun hanya dengan pasukanku sendiri,\Njuga harus menumpaskannya.
Dialogue: 0,0:07:29.24,0:07:30.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letnan Kolonel Drake.
Dialogue: 0,0:07:31.07,0:07:34.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku berbicara lancang, mohon\Npikirkan kembali. Target aksi kali ini...
Dialogue: 0,0:07:34.39,0:07:37.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan kita memiliki hak\Nuntuk menentukan sendiri.
Dialogue: 0,0:07:38.99,0:07:42.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kita harus\Nikut serta sampai akhir.
Dialogue: 0,0:07:43.19,0:07:44.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kolonel.
Dialogue: 0,0:07:44.66,0:07:46.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petugas Politik.
Dialogue: 0,0:07:46.72,0:07:50.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam menghadapi Kekaisaran,\Nkekuatan reaksioner dunia,
Dialogue: 0,0:07:50.93,0:07:53.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita adalah tentara partai yang menjaga\Npersatuan dengan rakyat berbagai negara
Dialogue: 0,0:07:53.88,0:07:57.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tanpa pernah berhenti maju.
Dialogue: 0,0:07:57.78,0:07:59.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam situasi seperti ini,
Dialogue: 0,0:07:59.94,0:08:03.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jika di bawah arahan Partai, kita\Nberaksi bersama pasukan kolaborasi,
Dialogue: 0,0:08:03.70,0:08:05.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita juga tidak bisa membiarkan\Nmereka begitu saja.
Dialogue: 0,0:08:06.86,0:08:08.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat.
Dialogue: 0,0:08:08.77,0:08:10.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:08:10.69,0:08:12.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga akan menandatangani\Nsurat perintah ini.
Dialogue: 0,0:08:13.04,0:08:16.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, tampaknya kita\Nakan beraksi bersama.
Dialogue: 0,0:08:18.62,0:08:20.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar konyol.
Dialogue: 0,0:08:21.05,0:08:24.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan untuk membahas isi operasi saja\Nharus memainkan sandiwara politik dulu.
Dialogue: 0,0:08:34.62,0:08:36.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menemukan musuh baru di arah jam 11!
Dialogue: 0,0:08:36.70,0:08:38.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tamu sudah datang, ya?
Dialogue: 0,0:08:38.44,0:08:40.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia, tidak bisa menerobos.
Dialogue: 0,0:08:40.60,0:08:41.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hmm.
Dialogue: 0,0:08:41.45,0:08:43.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena musuh sudah keluar sendiri,
Dialogue: 0,0:08:43.92,0:08:45.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}biarkan aku menjadi umpannya.
Dialogue: 0,0:08:45.72,0:08:46.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa, Yang Mulia?
Dialogue: 0,0:08:47.21,0:08:49.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan kendaraan.
Dialogue: 0,0:08:54.53,0:08:56.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan jepit?
Dialogue: 0,0:08:56.33,0:08:56.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:08:57.47,0:08:59.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini situasi saat ini.
Dialogue: 0,0:08:59.96,0:09:05.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuh sengaja keluar menyambut\Nsebelum kita tiba.
Dialogue: 0,0:09:05.31,0:09:08.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan Kampfgruppe Rerugen\Nakan merespons kita di sini,
Dialogue: 0,0:09:08.97,0:09:10.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bersama-sama menjepit musuh.
Dialogue: 0,0:09:12.62,0:09:13.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:09:14.39,0:09:17.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda telah berkoordinasi sebelumnya\Ndengan Letnan Kolonel Degurechaff.
Dialogue: 0,0:09:17.29,0:09:18.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,
Dialogue: 0,0:09:18.86,0:09:21.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda bisa saja\Nmemberi tahu kami sebelumnya.
Dialogue: 0,0:09:22.23,0:09:22.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:09:23.50,0:09:25.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini improvisasiku sendiri.
Dialogue: 0,0:09:25.77,0:09:26.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:09:26.79,0:09:28.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia adalah Letnan Kolonel Degurechaff.
Dialogue: 0,0:09:29.26,0:09:31.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Improvisasi baginya hanyalah hal sepele.
Dialogue: 0,0:09:31.46,0:09:33.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini dia pasti sedang bersiap.
Dialogue: 0,0:09:34.94,0:09:37.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Me-meskipun sekuat Letnan Kolonel...
Dialogue: 0,0:09:37.64,0:09:38.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letnan.
Dialogue: 0,0:09:39.08,0:09:43.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar ada yang menyebut\NLetnan Kolonel Degurechaff sebagai monster.
Dialogue: 0,0:09:43.67,0:09:46.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi menurutku,
Dialogue: 0,0:09:47.72,0:09:51.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itulah sikap yang seharusnya dimiliki\Nseorang perwira staf.
Dialogue: 0,0:09:54.88,0:09:57.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letnan Kolonel, isi komunikasi\NTentara Federal ada perubahan.
Dialogue: 0,0:09:58.02,0:09:59.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Cepat terjemahkan.
Dialogue: 0,0:10:01.07,0:10:03.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sedang menghadang\Npasukan penyelamat.
Dialogue: 0,0:10:03.35,0:10:04.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana keadaan pasukan sekutu?
Dialogue: 0,0:10:05.68,0:10:07.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya terjebak dalam pertempuran.
Dialogue: 0,0:10:08.15,0:10:11.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak hanya itu, musuh juga menyebutkan\Ntarget penting, fungsi komando.
Dialogue: 0,0:10:13.44,0:10:16.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuh mengira markas kita sudah terekspos\Ndan sedang besar kepala.
Dialogue: 0,0:10:16.80,0:10:17.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu.
Dialogue: 0,0:10:18.62,0:10:20.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Markas terekspos?
Dialogue: 0,0:10:21.09,0:10:23.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah Yang Mulia akan\Nmelakukan kesalahan seperti itu?
Dialogue: 0,0:10:31.33,0:10:32.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Le-Letnan Kolonel?
Dialogue: 0,0:10:33.62,0:10:37.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin Yang Mulia bodoh sampai\Ntak bisa sembunyi saat main petak umpet?
Dialogue: 0,0:10:37.84,0:10:39.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian masih belum mengerti?
Dialogue: 0,0:10:40.34,0:10:43.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini Yang Mulia bermaksud\Nmenjadi umpan secara langsung.
Dialogue: 0,0:10:44.40,0:10:46.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-kenapa begitu?
Dialogue: 0,0:10:46.65,0:10:49.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alasan memusatkan seluruh\Nperhatian musuh ke satu arah,
Dialogue: 0,0:10:50.59,0:10:53.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selain untuk memaksa kita\Nmaju ke garis depan, bisa apa lagi?
Dialogue: 0,0:10:54.52,0:10:55.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan...
Dialogue: 0,0:10:55.61,0:10:57.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, kita akan menyerang?
Dialogue: 0,0:10:57.48,0:10:58.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah maksudnya.
Dialogue: 0,0:10:58.91,0:11:01.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain archmage, yang lain\Nlanjutkan pertahanan.
Dialogue: 0,0:11:01.42,0:11:03.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dipimpin oleh Mayor Weiß.
Dialogue: 0,0:11:04.71,0:11:07.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya berbicara saja,\Nseharusnya bisa, kan?
Dialogue: 0,0:11:07.95,0:11:08.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:11:08.96,0:11:12.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batalion 203, kurangi reaksi sihir\Ndan serang.
Dialogue: 0,0:11:12.57,0:11:17.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tembus jaring pengepungan Federasi\Nmenuju lokasi pasukan penyelamat.
Dialogue: 0,0:11:19.97,0:11:23.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tusuk pantat musuh dari belakang mereka!
Dialogue: 0,0:11:36.41,0:11:38.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai serang!
Dialogue: 0,0:11:45.05,0:11:46.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah musuh ada pergerakan?
Dialogue: 0,0:11:46.60,0:11:47.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada.
Dialogue: 0,0:11:47.75,0:11:51.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan mereka takut terhadap\Nkepungan kita dan bersembunyi?
Dialogue: 0,0:11:51.61,0:11:54.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mungkin Iblis dari Rhein itu pengecut?
Dialogue: 0,0:11:56.45,0:11:57.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:11:57.69,0:12:00.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan terus mengunci Jenderal Zettour\Ndan melanjutkan pengepungan.
Dialogue: 0,0:12:01.90,0:12:03.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Situasi berubah.
Dialogue: 0,0:12:03.39,0:12:05.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan archmage musuh sudah keluar\Ndari jaring pengepungan.
Dialogue: 0,0:12:06.18,0:12:09.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum serang pasukan penyelamat musuh,\Nkita harus merebut posisi mereka dulu.
Dialogue: 0,0:12:09.42,0:12:12.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu sekaligus habisi pasukan penyelamat\Nmusuh, maka kita bisa menang besar.
Dialogue: 0,0:12:13.58,0:12:16.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letnan Kolonel, perubahan perintah yang\Nmendadak seperti ini sangat merepotkan.
Dialogue: 0,0:12:16.59,0:12:19.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyesuaikan diri dengan perubahan\Ndi medan perang,
Dialogue: 0,0:12:19.63,0:12:20.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa salahnya?
Dialogue: 0,0:12:20.62,0:12:23.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sudah menyiapkan strategi\Nuntuk menyingkirkan Jenderal Zettour.
Dialogue: 0,0:12:24.27,0:12:26.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sekarang semua ini dibatalkan...
Dialogue: 0,0:12:26.08,0:12:28.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iblis dari Rhein sudah tidak ada.
Dialogue: 0,0:12:28.04,0:12:29.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus menyerang saat lengah.
Dialogue: 0,0:12:33.91,0:12:35.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang itu
Dialogue: 0,0:12:36.18,0:12:37.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak ada?
Dialogue: 0,0:12:41.58,0:12:44.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan, gadis tidak sabaran itu.
Dialogue: 0,0:12:54.26,0:12:56.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terdeteksi reaksi sihir di arah jam 3.
Dialogue: 0,0:12:58.90,0:13:00.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mungkin berpangku tangan.
Dialogue: 0,0:13:00.94,0:13:02.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada pilihan,\Nsingkirkan musuh di sana.
Dialogue: 0,0:13:05.17,0:13:08.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami harus mengejar pasukan archmage musuh\Nyang diduga melakukan serangan.
Dialogue: 0,0:13:10.84,0:13:11.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:13:11.88,0:13:14.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan Kerajaan Bersatu\Nsangat sewenang-wenang.
Dialogue: 0,0:13:15.47,0:13:18.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akibatnya hanya mereka yang berangkat\Nmengejar Iblis dari Rhein.
Dialogue: 0,0:13:20.00,0:13:20.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:13:21.45,0:13:23.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petugas Politik?
Dialogue: 0,0:13:25.23,0:13:27.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah instruksi prioritas tertinggi\Ndari Partai.
Dialogue: 0,0:13:27.60,0:13:29.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dukung pasukan Kerajaan Bersatu.
Dialogue: 0,0:13:30.20,0:13:32.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, jika Iblis dari Rhein\Nada di sana, jatuhkan dia.
Dialogue: 0,0:13:33.52,0:13:35.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun yang terjadi,\Ntangkap dia hidup-hidup.
Dialogue: 0,0:13:39.22,0:13:41.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar lagi.
Dialogue: 0,0:13:41.32,0:13:43.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar lagi kita bisa bertemu.
Dialogue: 0,0:13:43.64,0:13:45.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peri Kecil.
Dialogue: 0,0:13:46.90,0:13:49.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepatlah, nanti terdeteksi musuh!
Dialogue: 0,0:13:56.33,0:13:57.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkunci!
Dialogue: 0,0:14:09.70,0:14:10.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini 05.
Dialogue: 0,0:14:11.33,0:14:12.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuh masuk perangkap.
Dialogue: 0,0:14:13.88,0:14:15.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terjebak umpan?
Dialogue: 0,0:14:16.22,0:14:18.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti ini bisa mengurangi\Nbeban pasukan yang bertahan.
Dialogue: 0,0:14:20.56,0:14:21.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, tunggu!
Dialogue: 0,0:14:21.96,0:14:24.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa, tidak...
Dialogue: 0,0:14:24.25,0:14:26.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}05, mundur dari medan perang!
Dialogue: 0,0:14:37.74,0:14:38.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tertipu.
Dialogue: 0,0:14:38.82,0:14:40.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar licik!
Dialogue: 0,0:14:40.36,0:14:41.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu umpan.
Dialogue: 0,0:14:41.44,0:14:43.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan, benar-benar trik hebat.
Dialogue: 0,0:14:44.54,0:14:45.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah ke Soldim
Dialogue: 0,0:14:46.29,0:14:47.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau ke pasukan pembebas?
Dialogue: 0,0:14:47.64,0:14:49.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke mana dia akan pergi?
Dialogue: 0,0:14:50.82,0:14:52.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlihat, itu pasukan sekutu.
Dialogue: 0,0:14:52.87,0:14:54.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersiap melancarkan\Nserangan dukungan darat.
Dialogue: 0,0:14:54.74,0:14:55.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serang musuh dari belakang!
Dialogue: 0,0:14:57.83,0:14:58.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa...
Dialogue: 0,0:15:14.77,0:15:17.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letnan Kolonel, dialah orangnya.
Dialogue: 0,0:15:17.22,0:15:19.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dialah yang telah membuat Mayor Weiß...
Dialogue: 0,0:15:19.68,0:15:21.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi itu archmage Federasi?
Dialogue: 0,0:15:21.61,0:15:23.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya niat kita\Nsudah terbaca olehnya.
Dialogue: 0,0:15:28.73,0:15:30.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buka segel sihir!
Dialogue: 0,0:15:30.36,0:15:35.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar para pahlawan zaman dulu itu\Nmerasakan tembakan jarak jauh modern.
Dialogue: 0,0:15:40.12,0:15:40.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:15:53.80,0:15:55.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Formasi apa itu?
Dialogue: 0,0:15:55.64,0:15:57.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah ini kerja sama yang\Nmereka bangun di kamp konsentrasi?
Dialogue: 0,0:15:59.15,0:15:59.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa.
Dialogue: 0,0:16:00.47,0:16:02.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa menembus lapisan pelindung.
Dialogue: 0,0:16:03.29,0:16:05.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknologi permata milik Partai Komunis
Dialogue: 0,0:16:05.06,0:16:06.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ternyata sudah sehebat ini?
Dialogue: 0,0:16:12.40,0:16:14.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya pertahanan mereka cukup kokoh.
Dialogue: 0,0:16:17.27,0:16:18.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba cara lain.
Dialogue: 0,0:16:18.90,0:16:20.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama-tama adalah ledakan ruang.
Dialogue: 0,0:16:20.73,0:16:22.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubakar habis paru-paru kalian!
Dialogue: 0,0:16:23.95,0:16:26.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya Tuhan, demi nama-Mu yang kudus,
Dialogue: 0,0:16:26.41,0:16:28.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}usirlah musuh-Mu
Dialogue: 0,0:16:28.62,0:16:31.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan berikanlah kedamaian kepada dunia.
Dialogue: 0,0:16:45.71,0:16:47.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibandingkan dengan angin\Ndi kamp konsentrasi,
Dialogue: 0,0:16:48.74,0:16:50.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ini hanyalah angin sepoi-sepoi.
Dialogue: 0,0:16:57.78,0:16:59.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia, mohon mundur.
Dialogue: 0,0:16:59.78,0:17:01.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang justru saatnya penentuan.
Dialogue: 0,0:17:01.83,0:17:04.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak boleh kalah!
Dialogue: 0,0:17:12.42,0:17:13.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia!
Dialogue: 0,0:17:15.42,0:17:16.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar!
Dialogue: 0,0:17:17.67,0:17:21.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya di saat seperti ini,\Naku iri pada anak muda.
Dialogue: 0,0:17:22.34,0:17:23.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah mencapai batas.
Dialogue: 0,0:17:23.45,0:17:26.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan perwira setingkat komandan\Njuga mulai ada yang tewas dan terluka.
Dialogue: 0,0:17:26.50,0:17:28.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan cengeng.
Dialogue: 0,0:17:28.95,0:17:30.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mundur dalam situasi seperti ini,
Dialogue: 0,0:17:30.89,0:17:33.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seluruh pasukan akan runtuh.
Dialogue: 0,0:17:33.78,0:17:34.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:17:37.07,0:17:39.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kibarkan bendera perang!
Dialogue: 0,0:17:39.83,0:17:43.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunjukkan pada musuh\Nbahwa aku ada di sini.
Dialogue: 0,0:17:58.01,0:17:59.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini terus...
Dialogue: 0,0:18:05.69,0:18:07.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letnan Glanz, ini aku!
Dialogue: 0,0:18:07.72,0:18:08.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letnan Kolonel!
Dialogue: 0,0:18:08.94,0:18:10.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda datang?
Dialogue: 0,0:18:10.26,0:18:11.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami kekurangan orang, bantu kami!
Dialogue: 0,0:18:13.93,0:18:15.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan hancurkan lapisan pelindung\Ndengan serangan jarak dekat.
Dialogue: 0,0:18:15.78,0:18:18.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian manfaatkan celah itu\Nuntuk menghajarnya dari belakang.
Dialogue: 0,0:18:18.52,0:18:19.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:18:19.19,0:18:20.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, siapa yang akan\Nmelindungi Yang Mulia?
Dialogue: 0,0:18:22.39,0:18:24.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pedulikan aku, majulah!
Dialogue: 0,0:18:25.49,0:18:26.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:18:26.84,0:18:29.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau melawan perintah?
Dialogue: 0,0:18:29.44,0:18:31.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa begitu saja meninggalkan...
Dialogue: 0,0:18:34.55,0:18:35.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia!
Dialogue: 0,0:18:37.29,0:18:38.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat pergi.
Dialogue: 0,0:18:41.18,0:18:44.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perwira tinggi gugur, lumayan bagus.
Dialogue: 0,0:18:45.11,0:18:48.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini seharusnya bisa membuat orang-orang\Ndi belakang sedikit lebih sadar.
Dialogue: 0,0:18:48.99,0:18:54.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus memanfaatkan mayat prajurit\Ndengan efisiensi tertinggi.
Dialogue: 0,0:18:55.06,0:18:58.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perkembangan perang sampai di titik ini\Nsudah bisa dianggap sebagai puncaknya.
Dialogue: 0,0:18:59.95,0:19:01.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letnan Kolonel Degurechaff.
Dialogue: 0,0:19:01.86,0:19:04.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlihatkan tarianmu padaku.
Dialogue: 0,0:19:07.74,0:19:11.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, izinkan aku mempersembahkan\Nsebuah tarian untukmu.
Dialogue: 0,0:19:23.03,0:19:24.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lakukan pertarungan jarak dekat!
Dialogue: 0,0:19:26.12,0:19:27.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikuti aku!
Dialogue: 0,0:19:35.03,0:19:35.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang!
Dialogue: 0,0:19:36.94,0:19:40.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tembak!
Dialogue: 0,0:19:57.86,0:19:59.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matilah kau!
Dialogue: 0,0:20:07.83,0:20:08.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah berakhir.
Dialogue: 0,0:20:13.70,0:20:14.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan!
Dialogue: 0,0:20:15.10,0:20:16.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah mencapai batas kemampuan?
Dialogue: 0,0:20:31.46,0:20:33.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan archmage musuh, mundur.
Dialogue: 0,0:20:33.48,0:20:34.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai dukungan darat!
Dialogue: 0,0:20:34.81,0:20:36.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersiap serbu!
Dialogue: 0,0:20:36.11,0:20:38.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, selamatkan Yang Mulia!
Dialogue: 0,0:20:38.09,0:20:39.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serbu!
Dialogue: 0,0:20:48.14,0:20:49.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musnahkan pasukan musuh!
Dialogue: 0,0:20:49.54,0:20:50.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tembak!
Dialogue: 0,0:20:58.35,0:20:59.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia.
Dialogue: 0,0:20:59.83,0:21:00.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh.
Dialogue: 0,0:21:00.86,0:21:02.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar tarian yang memikat hati.
Dialogue: 0,0:21:02.50,0:21:06.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah ini selesai, kau harus\Nberkenan minum teh bersamaku.
Dialogue: 0,0:21:06.50,0:21:08.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda sungguh anggun.
Dialogue: 0,0:21:08.44,0:21:10.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengundang di medan perang,\Nsepertinya kurang cocok.
Dialogue: 0,0:21:11.31,0:21:17.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Budaya adalah garis pemisah kita dengan\Nbinatang, keseharian dan yang luar biasa.
Dialogue: 0,0:21:17.22,0:21:19.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah begitu?
Dialogue: 0,0:23:10.90,0:23:12.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letnan.
Dialogue: 0,0:23:12.13,0:23:14.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau kurang rasa setia kawan\Nterhadap rekan seperjuangan.
Dialogue: 0,0:23:15.87,0:23:18.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-apa maksudnya?
Dialogue: 0,0:23:25.42,0:23:28.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku lapar.
