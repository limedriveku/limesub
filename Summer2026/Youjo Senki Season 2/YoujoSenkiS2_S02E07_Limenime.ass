Dialogue: 0,0:01:54.80,0:02:02.14,sign,,0000,0000,0000,,(Saga of Tanya the Evil 2)
Dialogue: 0,0:03:17.61,0:03:20.05,sign,,0000,0000,0000,,ANIMASI INI BERSIFAT FIKTIF
Dialogue: 0,0:03:20.05,0:03:22.39,sign,,0000,0000,0000,,ISI DRAMA TIDAK IDENTIK DENGAN DUNIA NYATA
Dialogue: 0,0:05:45.94,0:05:49.95,sign,,0000,0000,0000,,(Episode 7: Api Penyucian)
Dialogue: 0,0:05:49.95,0:05:54.04,sign,,0000,0000,0000,,TANGGAL 29 JUNI 1927, KALENDER BERSATU
Dialogue: 0,0:08:27.96,0:08:33.97,sign,,0000,0000,0000,,(Saga of Tanya the Evil 2)
Dialogue: 0,0:08:33.97,0:08:37.51,sign,,0000,0000,0000,,MARKAS BESAR STAF UMUM KEKAISARAN
Dialogue: 0,0:20:36.33,0:20:39.34,sign,,0000,0000,0000,,FRONT TIMUR, TENTARA KEKAISARAN\NMENIKMATI DAGING DAN SUP PANAS
Dialogue: 0,0:20:45.96,0:20:49.08,sign,,0000,0000,0000,,KEMENANGAN TELAK ATAS ARMADA KERAJAAN BERSATU
Dialogue: 0,0:20:49.86,0:20:53.79,sign,,0000,0000,0000,,UNIT ARCHMAGE BERAKSI, KEMENANGAN SUDAH DEKAT
Dialogue: 0,0:23:38.49,0:23:39.92,sign,,0000,0000,0000,,(Episode Berikutnya: Sambaran Petir)
Dialogue: 0,0:00:07.23,0:00:09.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini teh hitam yang kujanjikan.
Dialogue: 0,0:00:11.34,0:00:14.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seleramu bagus juga.
Dialogue: 0,0:00:14.72,0:00:16.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pemberian dari teman di Yirudoya?
Dialogue: 0,0:00:17.95,0:00:20.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus berterima kasih\Natas persahabatan sekutu.
Dialogue: 0,0:00:21.41,0:00:23.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya saat ini begitu.
Dialogue: 0,0:00:24.78,0:00:27.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sekali lagi,\Nsudah datang membantu.
Dialogue: 0,0:00:27.12,0:00:29.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh hebat, Letnan Kolonel Degurechaff.
Dialogue: 0,0:00:30.22,0:00:34.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi unit pendukung serangan utama,\Nini hasil pertempuran terbaik.
Dialogue: 0,0:00:34.06,0:00:37.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya korbankan prajurit\Nsebagai tameng saja.
Dialogue: 0,0:00:37.66,0:00:39.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan kecerdasan pribadiku.
Dialogue: 0,0:00:40.07,0:00:43.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, ini tanggung jawab dari orang\Nyang memberi perintah?
Dialogue: 0,0:00:43.73,0:00:45.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh ironi yang menarik.
Dialogue: 0,0:00:45.69,0:00:47.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku, berdasarkan posisiku,
Dialogue: 0,0:00:47.35,0:00:51.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seharusnya hormati etika formal\Ndan tetap diam.
Dialogue: 0,0:00:52.00,0:00:53.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau masih tetap sama.
Dialogue: 0,0:00:53.59,0:00:55.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetap teguh dan tak tergoyahkan.
Dialogue: 0,0:00:55.79,0:00:58.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku selalu percaya\Npada diri sendiri.
Dialogue: 0,0:00:59.58,0:01:02.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan pun itu, aku akan\Nmenempuh jalanku sendiri.
Dialogue: 0,0:01:02.94,0:01:06.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada menyerahkan nasib\Nkepada orang seperti Existence X,
Dialogue: 0,0:01:06.99,0:01:09.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku lebih percaya pada\Nhak keputusanku sendiri.
Dialogue: 0,0:01:09.99,0:01:13.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah martabatku sebagai manusia modern.
Dialogue: 0,0:01:14.11,0:01:17.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf mengganggu waktu yang elegan ini.
Dialogue: 0,0:01:17.07,0:01:18.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami menerima kabar buruk.
Dialogue: 0,0:01:19.55,0:01:21.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencana Andromeda telah gagal.
Dialogue: 0,0:01:22.92,0:01:24.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak...
Dialogue: 0,0:01:24.03,0:01:27.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak berhasil menaklukkan\Nkota-kota di Selatan?
Dialogue: 0,0:01:27.35,0:01:29.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masalahnya lebih serius dari itu.
Dialogue: 0,0:01:29.43,0:01:33.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun berhasil maju hingga ke Josefgrad\Ndengan serangan kilat,
Dialogue: 0,0:01:33.23,0:01:35.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi jalur pasokan runtuh setelah itu.
Dialogue: 0,0:01:35.34,0:01:37.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentara Federal juga\Nmemperkuat pertahanan.
Dialogue: 0,0:01:37.87,0:01:39.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sudah merupakan batas serangan.
Dialogue: 0,0:01:40.02,0:01:43.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, zona sumber daya\Nyang menjadi target rencana...
Dialogue: 0,0:01:43.44,0:01:45.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sama sekali tidak terjangkau.
Dialogue: 0,0:03:23.89,0:03:25.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh mengejutkan.
Dialogue: 0,0:03:25.28,0:03:28.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka Yang Mulia Rudersdorf\Nbisa gagal.
Dialogue: 0,0:03:28.68,0:03:32.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya pasokan pentingnya\Nterlambat sampai.
Dialogue: 0,0:03:32.29,0:03:34.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya Departemen Perkeretaapian\Nsudah bekerja dengan sangat baik.
Dialogue: 0,0:03:35.25,0:03:38.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata pasokannya sendiri\Nsudah tidak mencukupi, 'kan?
Dialogue: 0,0:03:39.38,0:03:41.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya begitu.
Dialogue: 0,0:03:43.67,0:03:45.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangankan prajurit,
Dialogue: 0,0:03:45.26,0:03:48.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sepertinya pasokan makanan dan amunisi pun\Ntidak bisa diberikan sesuai keinginan.
Dialogue: 0,0:03:48.20,0:03:53.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu aku menangani urusan perang, meski\Ndana terbatas, aku tetap menggalang.
Dialogue: 0,0:03:54.54,0:03:56.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar Yang Mulia datang\Nke wilayah timur
Dialogue: 0,0:03:56.78,0:04:00.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena ada perselisihan\Ndengan Kantor Panglima Tertinggi.
Dialogue: 0,0:04:00.86,0:04:01.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:04:02.12,0:04:05.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah negara ini tidak tahu\Nsituasi sebenarnya?
Dialogue: 0,0:04:05.41,0:04:06.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letnan Kolonel.
Dialogue: 0,0:04:07.08,0:04:10.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini Kekaisaran\Nsudah kecanduan akan kemenangan.
Dialogue: 0,0:04:10.01,0:04:11.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa dibilang sangat menyedihkan.
Dialogue: 0,0:04:13.73,0:04:17.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus mengalahkan masalah internal.
Dialogue: 0,0:04:17.91,0:04:19.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oleh karena itu,
Dialogue: 0,0:04:19.17,0:04:22.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin kita juga harus\Nmempelajari cara-cara yang keji.
Dialogue: 0,0:04:23.69,0:04:25.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia.
Dialogue: 0,0:04:25.10,0:04:26.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:04:26.96,0:04:29.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk fokus ke Timur,
Dialogue: 0,0:04:29.41,0:04:32.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita harus memenangkan\Npertempuran di Barat.
Dialogue: 0,0:04:32.79,0:04:35.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wilayah Barat yang Anda maksud,
Dialogue: 0,0:04:35.09,0:04:37.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apakah soal pertempuran udara Barat?
Dialogue: 0,0:04:39.18,0:04:42.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedikit lebih ke timur lagi dari itu.
Dialogue: 0,0:04:43.45,0:04:45.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:04:45.48,0:04:48.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya soal menyerang orang sendiri,\Naku benar-benar tidak ingin melakukannya.
Dialogue: 0,0:04:50.87,0:04:55.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin memintamu\Nuntuk menjadi kaki tangan bersama.
Dialogue: 0,0:04:58.40,0:05:00.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan kelancanganku.
Dialogue: 0,0:05:00.09,0:05:02.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku adalah prajurit Kekaisaran.
Dialogue: 0,0:05:02.89,0:05:08.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun wajib mematuhi perintah sah,\Ntapi aku hanya anggota organisasi militer.
Dialogue: 0,0:05:09.08,0:05:11.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa mengabaikan kewajiban.
Dialogue: 0,0:05:11.37,0:05:16.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengabaikan kewajiban sama saja dengan\Nmengkhianati Kekaisaran dan tanah air.
Dialogue: 0,0:05:16.55,0:05:18.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjalankan kewajiban sepenuhnya.
Dialogue: 0,0:05:19.71,0:05:22.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak menyangkal, juga tidak membenarkan?
Dialogue: 0,0:05:25.24,0:05:27.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat bagus.
Dialogue: 0,0:05:27.06,0:05:29.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seandainya kau memberikan\Njawaban yang berbeda,
Dialogue: 0,0:05:29.23,0:05:31.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku harus menembakmu.
Dialogue: 0,0:05:33.85,0:05:37.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kau salah paham.
Dialogue: 0,0:05:39.18,0:05:40.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah.
Dialogue: 0,0:05:40.45,0:05:45.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, pergilah lihat sendiri kondisi\Nnegara ini, yaitu Kekaisaran saat ini.
Dialogue: 0,0:05:56.67,0:05:57.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ini ibu kota.\N- Luar biasa!
Dialogue: 0,0:05:57.88,0:05:59.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah libur!
Dialogue: 0,0:06:02.91,0:06:04.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letnan Kolonel Degurechaff.
Dialogue: 0,0:06:04.71,0:06:06.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang kembali.
Dialogue: 0,0:06:06.74,0:06:07.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kolonel.
Dialogue: 0,0:06:07.99,0:06:09.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda sudah kembali rupanya.
Dialogue: 0,0:06:10.47,0:06:14.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kampfgruppe Rerugen\Nkembali ke ibu kota untuk liburan.
Dialogue: 0,0:06:14.04,0:06:16.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, wajar kalau aku ada di sini, 'kan?
Dialogue: 0,0:06:16.21,0:06:17.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda benar sekali.
Dialogue: 0,0:06:18.67,0:06:20.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saudara-saudara dari Kampfgruppe,
Dialogue: 0,0:06:20.42,0:06:23.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk liburan kali ini, tempat liburan\Nsudah diatur untuk kalian semua.
Dialogue: 0,0:06:25.30,0:06:26.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letnan Kolonel.
Dialogue: 0,0:06:26.31,0:06:27.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa bicara sebentar?
Dialogue: 0,0:06:28.98,0:06:32.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mayor Weiß, bagikan surat izin libur\Ndan kupon diskon.
Dialogue: 0,0:06:32.60,0:06:34.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letnan Serebryakov, atur kendaraan.
Dialogue: 0,0:06:34.82,0:06:35.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:06:36.64,0:06:39.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang akan dibagikan\Nsurat izin libur dan kupon diskon.
Dialogue: 0,0:06:39.97,0:06:41.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, berbaris!
Dialogue: 0,0:06:41.77,0:06:44.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka adalah bawahan\Nyang dapat kupercayai.
Dialogue: 0,0:06:44.47,0:06:46.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini juga tuntutan situasi.
Dialogue: 0,0:06:47.73,0:06:50.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Singkatnya, ada tiga hal\Nyang perlu kusampaikan.
Dialogue: 0,0:06:50.06,0:06:50.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:06:51.28,0:06:52.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama,
Dialogue: 0,0:06:52.68,0:06:55.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Markas Besar Staf Umum\Ndan Kantor Panglima Tertinggi
Dialogue: 0,0:06:55.33,0:06:59.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sedang berselisih soal tanggung jawab\Noperasi besar di Timur.
Dialogue: 0,0:07:01.00,0:07:04.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Militer kembali dibebani harapan\Nyang mustahil tercapai.
Dialogue: 0,0:07:04.23,0:07:08.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Segera akhiri perang\Ndengan kemenangan gemilang."
Dialogue: 0,0:07:08.96,0:07:12.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, jika tidak mengamankan\Nsepenuhnya supremasi udara di Timur...
Dialogue: 0,0:07:13.46,0:07:15.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah poin kedua.
Dialogue: 0,0:07:15.17,0:07:18.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Situasi pertempuran udara di Barat\Nmemburuk drastis.
Dialogue: 0,0:07:18.96,0:07:20.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangankan Timur,
Dialogue: 0,0:07:20.30,0:07:23.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai-sampai harus dipertimbangkan untuk\Nmenarik pasukan dari daratan Selatan.
Dialogue: 0,0:07:24.54,0:07:26.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Separah itu?
Dialogue: 0,0:07:26.64,0:07:28.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Poin terakhir,
Dialogue: 0,0:07:28.96,0:07:32.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin kalian akan diminta melakukan\Nserangan udara ke ibu kota.
Dialogue: 0,0:07:33.82,0:07:36.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan menyerang langsung Londinium?
Dialogue: 0,0:07:36.55,0:07:38.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, bukan itu.
Dialogue: 0,0:07:38.32,0:07:40.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau menyerang Moscow lagi?
Dialogue: 0,0:07:40.72,0:07:42.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu, Letnan Kolonel.
Dialogue: 0,0:07:43.90,0:07:45.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Targetnya adalah...
Dialogue: 0,0:07:55.75,0:07:58.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, lupakan saja.
Dialogue: 0,0:07:58.59,0:08:02.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita meraih kemenangan besar\Ndalam Pertempuran Martil.
Dialogue: 0,0:08:02.18,0:08:06.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya aku bertugas mendorong\Nperundingan damai melalui Yirudoya.
Dialogue: 0,0:08:09.47,0:08:11.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah solusi sesungguhnya.
Dialogue: 0,0:08:12.19,0:08:17.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seandainya para politisi itu mau menerima\Nproposal gencatan senjata dari militer...
Dialogue: 0,0:08:21.44,0:08:24.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata untuk mengubah keadaan saat ini,
Dialogue: 0,0:08:24.01,0:08:27.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya bisa membuat\Npara politisi itu sadar, ya?
Dialogue: 0,0:08:37.51,0:08:41.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letnan Kolonel Degurechaff, melapor.
Dialogue: 0,0:08:41.62,0:08:43.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tidak bertemu, Letnan Kolonel.
Dialogue: 0,0:08:43.65,0:08:45.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang melihatmu begitu bersemangat.
Dialogue: 0,0:08:46.31,0:08:48.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia juga tetap berwibawa.
Dialogue: 0,0:08:49.56,0:08:52.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bertambah banyak pekerjaan\Nyang tidak berarti.
Dialogue: 0,0:08:53.41,0:08:56.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah bekerja keras\Nperjuangan di Timur.
Dialogue: 0,0:08:56.43,0:08:58.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku yakin Yang Mulia juga
Dialogue: 0,0:08:58.98,0:09:01.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengalami kesulitan\Ndalam Rencana Andromeda...
Dialogue: 0,0:09:01.01,0:09:03.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu berbasa-basi.
Dialogue: 0,0:09:03.85,0:09:07.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun alasannya, fakta kegagalan\Ntidak akan berubah.
Dialogue: 0,0:09:08.03,0:09:09.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi,
Dialogue: 0,0:09:09.25,0:09:12.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ingin kau memberikan saran tanpa ragu\Ndari sudut pandang garis depan.
Dialogue: 0,0:09:12.85,0:09:13.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap.
Dialogue: 0,0:09:14.25,0:09:17.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami telah menyelesaikan penataan\Ngaris depan seminimal mungkin.
Dialogue: 0,0:09:17.27,0:09:19.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ini hanyalah solusi sementara,\Ntidak menyelesaikan akar masalahnya.
Dialogue: 0,0:09:19.22,0:09:23.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mempertahankan keadaan untuk sementara\Ntidak akan membawa kemenangan nyata.
Dialogue: 0,0:09:23.48,0:09:25.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya tekad yang pasti berdasarkan\Nperspektif jangka panjang yang...
Dialogue: 0,0:09:25.85,0:09:26.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti.
Dialogue: 0,0:09:27.35,0:09:29.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan Zettour.
Dialogue: 0,0:09:29.60,0:09:32.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak punya kebiasaan buruk\Nsuka diskusi panjang.
Dialogue: 0,0:09:33.45,0:09:34.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katakan kesimpulannya.
Dialogue: 0,0:09:34.73,0:09:36.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katakan kesimpulannya dulu.
Dialogue: 0,0:09:36.86,0:09:37.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia.
Dialogue: 0,0:09:37.87,0:09:40.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanyalah seorang\NLetnan Kolonel Archmage.
Dialogue: 0,0:09:40.93,0:09:43.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski pernah menjalani pelatihan staf,
Dialogue: 0,0:09:43.15,0:09:45.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi karena waktu tugas lapangan\Nterlalu lama...
Dialogue: 0,0:09:46.57,0:09:49.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikan kesimpulan atau keluar,\Npilih satu.
Dialogue: 0,0:09:51.44,0:09:55.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku akan menurut.
Dialogue: 0,0:09:55.20,0:09:57.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak melihat jalan menuju kemenangan.
Dialogue: 0,0:09:58.48,0:09:59.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari sudut pandang garis depan,
Dialogue: 0,0:09:59.76,0:10:02.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak dapat memahami\Nkeputusan perang dari pihak atasan.
Dialogue: 0,0:10:02.97,0:10:06.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana rencana kita\Nmengakhiri perang ini?
Dialogue: 0,0:10:06.48,0:10:08.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa rencana spesifiknya?
Dialogue: 0,0:10:08.24,0:10:10.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau menghancurkan pasukan lapangan musuh?
Dialogue: 0,0:10:10.88,0:10:13.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau menduduki titik strategis?
Dialogue: 0,0:10:13.74,0:10:15.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tujuan akhir yang dikejar?
Dialogue: 0,0:10:15.89,0:10:20.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya ke mana arah tujuan nasional\Nyang ingin dicapai Kekaisaran?
Dialogue: 0,0:10:21.80,0:10:23.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemenangan.
Dialogue: 0,0:10:23.65,0:10:24.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemenangan?
Dialogue: 0,0:10:24.93,0:10:28.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya untuk mengakhiri perang ini,\Nkemenangan "macam apa" yang harus kita...
Dialogue: 0,0:10:28.55,0:10:29.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yaitu kemenangan.
Dialogue: 0,0:10:30.48,0:10:32.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya itu.
Dialogue: 0,0:10:33.50,0:10:34.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya,
Dialogue: 0,0:10:34.79,0:10:38.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}perintah yang diterima militer\Nhanya kata "kemenangan" saja?
Dialogue: 0,0:10:38.47,0:10:39.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul.
Dialogue: 0,0:10:41.44,0:10:44.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya?
Dialogue: 0,0:10:45.97,0:10:47.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya, Kantor Panglima Tertinggi
Dialogue: 0,0:10:47.99,0:10:51.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan tidak memiliki target nyata\Nuntuk masa depan?
Dialogue: 0,0:10:52.25,0:10:53.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:10:53.91,0:10:56.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa ada hal yang begitu konyol?
Dialogue: 0,0:10:56.02,0:10:57.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:10:58.01,0:11:01.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika bukan karena sekelompok idiot\Nyang meninggalkan opsi gencatan senjata,
Dialogue: 0,0:11:01.82,0:11:04.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}perang ini sudah lama berakhir.
Dialogue: 0,0:11:05.45,0:11:08.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun menghela napas dan berdoa,\Nsemua ini tidak akan berubah.
Dialogue: 0,0:11:08.82,0:11:12.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kolonel Rerugen juga tampak sangat letih.
Dialogue: 0,0:11:12.60,0:11:16.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana cara membuat pihak belakang\Nmemahami situasi nyata saat ini?
Dialogue: 0,0:11:16.70,0:11:19.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kau salah paham.
Dialogue: 0,0:11:20.83,0:11:22.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana mengatakannya, ya?
Dialogue: 0,0:11:22.51,0:11:25.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kita terlalu fokus pada hal kecil\Nsampai melupakan keseluruhannya?
Dialogue: 0,0:11:25.97,0:11:27.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letnan Kolonel.
Dialogue: 0,0:11:27.15,0:11:29.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para politisi\Ndi Kantor Panglima Tertinggi,
Dialogue: 0,0:11:29.74,0:11:34.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pada dasarnya hanyalah manusia biasa\Nyang takut pada opini publik.
Dialogue: 0,0:11:34.35,0:11:38.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka juga tidak ingin ditelan\Noleh opini publik yang seperti lahar.
Dialogue: 0,0:11:38.56,0:11:40.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Opini publik, ya?
Dialogue: 0,0:11:40.77,0:11:41.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:11:41.63,0:11:44.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi kau yang sejak kecil\Nadalah prajurit murni,
Dialogue: 0,0:11:44.51,0:11:50.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang sebagian besar hidupnya dihabiskan\Ndi garis depan, mungkin sulit memahaminya.
Dialogue: 0,0:11:51.74,0:11:52.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hmm.
Dialogue: 0,0:11:53.24,0:11:56.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya perlu membuatmu\Nmerasakan sendiri ibu kota saat ini.
Dialogue: 0,0:11:56.09,0:11:59.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memahami sendiri opini publik\Ndi tanah air.
Dialogue: 0,0:12:00.52,0:12:02.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok pukul 15.00,
Dialogue: 0,0:12:02.37,0:12:04.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}datanglah ke alun-alun\Ndepan stasiun pusat.
Dialogue: 0,0:12:05.14,0:12:08.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan suruh pembawa pesan\Nmengurusnya nanti ketika waktunya tiba.
Dialogue: 0,0:12:10.59,0:12:13.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia Rudersdorf mengatakan\Nsemua ini kepadamu?
Dialogue: 0,0:12:13.78,0:12:14.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:12:14.55,0:12:16.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agak mengejutkanku.
Dialogue: 0,0:12:16.50,0:12:19.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun keberaniannya masih seperti dulu,
Dialogue: 0,0:12:19.25,0:12:21.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi bagaimana mengatakannya, ya.
Dialogue: 0,0:12:21.81,0:12:26.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya sebagian dari yang dikatakan\NYang Mulia sudah ada di depan matamu.
Dialogue: 0,0:12:27.88,0:12:29.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letnan Kolonel Uga.
Dialogue: 0,0:12:29.43,0:12:30.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:12:30.86,0:12:33.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Teh herbal" yang sedang populer\Nakhir-akhir ini.
Dialogue: 0,0:12:33.33,0:12:35.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya bagus untuk kesehatan.
Dialogue: 0,0:12:38.99,0:12:41.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski aku tidak menentang konsep\Nmengejar kesehatan,
Dialogue: 0,0:12:41.85,0:12:45.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sebagai orang beradab,\Nsaat seperti ini aku tetap ingin kafein.
Dialogue: 0,0:12:45.91,0:12:47.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf lama.
Dialogue: 0,0:12:49.86,0:12:52.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daging sintetis dan roti masa perang?
Dialogue: 0,0:12:52.64,0:12:55.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak disangka restoran yang terkenal\Ndengan makanan lezat ini
Dialogue: 0,0:12:55.61,0:12:58.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}juga terpuruk seperti ini.
Dialogue: 0,0:12:58.28,0:12:59.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi mendukung garis depan,
Dialogue: 0,0:12:59.95,0:13:03.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sekarang di lini belakang semuanya\Nditopang dengan barang pengganti.
Dialogue: 0,0:13:04.85,0:13:05.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh.
Dialogue: 0,0:13:05.80,0:13:09.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perang total ternyata memang mengerikan.
Dialogue: 0,0:13:10.89,0:13:14.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, ini tetaplah\Npenderitaan yang ringan.
Dialogue: 0,0:13:14.08,0:13:15.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun ini masa perang.
Dialogue: 0,0:13:15.99,0:13:19.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya bisa meminta semua orang untuk\Nbersama-sama menghadapi masa sulit ini.
Dialogue: 0,0:13:21.99,0:13:23.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letnan Kolonel.
Dialogue: 0,0:13:23.96,0:13:25.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya saran.
Dialogue: 0,0:13:27.35,0:13:29.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga kau jangan salah paham,
Dialogue: 0,0:13:29.68,0:13:33.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kuharap kau bisa\Nsedikit memahami perasaan manusia.
Dialogue: 0,0:13:34.30,0:13:35.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Secara sederhana,
Dialogue: 0,0:13:36.38,0:13:39.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kuharap kau melakukan hal-hal yang wajar\Nsebagai manusia.
Dialogue: 0,0:13:40.49,0:13:45.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu, kau meragukan\Nsifat kemanusiaanku?
Dialogue: 0,0:13:45.01,0:13:47.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sama sekali tidak bermaksud\Nmerendahkan kepribadianmu.
Dialogue: 0,0:13:47.66,0:13:48.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuharap kau mengerti.
Dialogue: 0,0:13:51.86,0:13:53.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja,
Dialogue: 0,0:13:53.45,0:13:57.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau selalu menuntut diri sendiri untuk\Nsegera menilai benar salahnya suatu hal.
Dialogue: 0,0:13:57.63,0:14:00.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akibatnya, kau terlalu menyangkali\Norang yang tidak bisa melakukannya.
Dialogue: 0,0:14:01.29,0:14:03.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaan itu sangat keras kepala.
Dialogue: 0,0:14:03.69,0:14:05.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk mengurai perasaan yang terbelit,
Dialogue: 0,0:14:05.70,0:14:08.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti butuh waktu dan tenaga.
Dialogue: 0,0:14:09.43,0:14:11.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memahami perasaanmu.
Dialogue: 0,0:14:11.73,0:14:12.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:14:12.78,0:14:15.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat ini perlu berpikir rasional.
Dialogue: 0,0:14:15.07,0:14:18.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurangnya tekad yang kuat sama saja\Ndengan kehilangan kesempatan.
Dialogue: 0,0:14:18.43,0:14:20.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya akan menjadi hambatan.
Dialogue: 0,0:14:21.01,0:14:22.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu dia.
Dialogue: 0,0:14:22.56,0:14:24.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa memahami\Nsemangat seperti itu.
Dialogue: 0,0:14:24.98,0:14:28.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak semua orang bisa hidup sepertimu.
Dialogue: 0,0:14:29.33,0:14:32.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga orang dewasa yang sudah berumur.
Dialogue: 0,0:14:32.19,0:14:35.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Juga pernah menjalani\Npelatihan standar perwira staf.
Dialogue: 0,0:14:36.09,0:14:37.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun begitu...
Dialogue: 0,0:14:38.19,0:14:41.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini aku seperti anak kecil,
Dialogue: 0,0:14:42.28,0:14:44.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tak tahan ingin menangis sekeras-kerasnya.
Dialogue: 0,0:14:45.84,0:14:47.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letnan Kolonel.
Dialogue: 0,0:14:47.60,0:14:52.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa terus berperan\Nsebagai monster perwira staf.
Dialogue: 0,0:14:53.33,0:14:56.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin sejak putriku lahir.
Dialogue: 0,0:14:56.71,0:15:02.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur, aku berterima kasih atas saranmu\Nuntuk pindah ke dinas belakang dulu.
Dialogue: 0,0:15:02.10,0:15:05.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan aku sebagai prajurit saja begini,
Dialogue: 0,0:15:05.61,0:15:08.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti besok kau juga akan\Nmenyaksikan sendiri,
Dialogue: 0,0:15:09.59,0:15:11.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekaisaran yang sudah kelelahan itu,
Dialogue: 0,0:15:12.12,0:15:14.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}serta kondisi ibu kota saat ini.
Dialogue: 0,0:15:19.09,0:15:22.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka ternyata disuruh\Nmenghadiri upacara bagi yang gugur.
Dialogue: 0,0:15:23.78,0:15:26.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku dan Yang Mulia berdiri bersama\Ndengan memakai seragam militer,
Dialogue: 0,0:15:26.28,0:15:28.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti menyilaukan di mata sebagian orang.
Dialogue: 0,0:15:28.41,0:15:31.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untungnya menyiapkan pakaian duka untukku.
Dialogue: 0,0:15:43.88,0:15:45.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa melihat?
Dialogue: 0,0:15:45.54,0:15:48.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Er, dengan tinggi badanku...
Dialogue: 0,0:15:48.98,0:15:52.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun di acara seperti ini,\Naku juga tidak bisa mengangkatmu.
Dialogue: 0,0:15:54.13,0:15:55.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:15:55.33,0:15:57.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa beri jalan untuk anak ini?
Dialogue: 0,0:16:01.82,0:16:03.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihatlah mereka.
Dialogue: 0,0:16:04.74,0:16:07.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di peti mati seperti itu\Ntidak ada jenazah.
Dialogue: 0,0:16:08.32,0:16:10.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun mereka sudah berpura-pura\Nmengangkatnya dengan berat,
Dialogue: 0,0:16:11.92,0:16:14.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi dengan melihatnya saja\Nsudah tahu situasinya mengerikan.
Dialogue: 0,0:16:15.01,0:16:17.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, inikah yang dimaksud\Ndengan "penyimpangan"?
Dialogue: 0,0:16:18.17,0:16:19.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:16:19.59,0:16:22.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peti jenazah diangkat\Noleh pasien dan anak muda.
Dialogue: 0,0:16:23.52,0:16:27.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemandangan ini benar-benar\Nmenceritakan kondisi Kekaisaran.
Dialogue: 0,0:16:29.79,0:16:32.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ada juga interpretasi yang berbeda.
Dialogue: 0,0:16:33.23,0:16:35.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perhatikan baik-baik ekspresi orang-orang.
Dialogue: 0,0:17:20.32,0:17:23.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ada di sini adalah\Nkeseharian yang menyimpang.
Dialogue: 0,0:17:24.65,0:17:29.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang tidak biasa menjadi biasa,\Nketenangan sudah hancur.
Dialogue: 0,0:17:30.55,0:17:33.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagian belakang perlahan-lahan\Nmenjadi gila.
Dialogue: 0,0:17:33.75,0:17:36.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pikir yang menghilangkan kemanusiaan
Dialogue: 0,0:17:36.78,0:17:39.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya garis depan?
Dialogue: 0,0:17:39.60,0:17:42.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasionalitas dunia sudah hancur.
Dialogue: 0,0:17:42.11,0:17:44.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekacauan makin parah.
Dialogue: 0,0:17:44.80,0:17:48.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, manusia mendambakan\Neksistensi yang melampaui batas.
Dialogue: 0,0:17:48.74,0:17:50.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mencari keyakinan.
Dialogue: 0,0:17:51.88,0:17:55.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang ketakutan.
Dialogue: 0,0:18:03.40,0:18:08.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi penduduk ibu kota saat ini, peti mati\Nprajurit gugur sudah jadi keseharian.
Dialogue: 0,0:18:09.12,0:18:10.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika itu Zettour,
Dialogue: 0,0:18:10.92,0:18:14.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin akan bilang ini adalah\N"normalisasi kematian".
Dialogue: 0,0:18:15.35,0:18:18.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kita juga bisa\Nmenemukan harapan dari sini.
Dialogue: 0,0:18:19.50,0:18:20.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:18:20.57,0:18:23.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang tidak terlalu emosional,
Dialogue: 0,0:18:23.43,0:18:26.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu bukti bahwa rasionalitas negara\Nmasih ada.
Dialogue: 0,0:18:26.77,0:18:30.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama kita berkomunikasi dan bernegosiasi\Nsecara wajar dengan berlandaskan
Dialogue: 0,0:18:30.85,0:18:32.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kehendak bebas manusia modern…
Dialogue: 0,0:18:32.46,0:18:33.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bodoh, ya?
Dialogue: 0,0:18:34.88,0:18:35.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:18:36.38,0:18:38.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau memang bodoh.
Dialogue: 0,0:18:38.52,0:18:40.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba gunakan otakmu sedikit lagi,
Dialogue: 0,0:18:40.87,0:18:43.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan cari kembali akal sehatmu.
Dialogue: 0,0:18:43.56,0:18:48.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemarahan itu, saat sudah melewati batas,\Njustru akan kembali menjadi tenang.
Dialogue: 0,0:18:48.08,0:18:52.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makin marah seseorang,\Npenampilannya malah tampak tenang.
Dialogue: 0,0:18:52.51,0:18:54.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat masih bisa berteriak,\Norang akan bersuara.
Dialogue: 0,0:18:55.27,0:18:57.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi begitu jatuh ke dasar,
Dialogue: 0,0:18:57.09,0:18:59.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}setelah tidak bisa mengeluarkan suara...
Dialogue: 0,0:18:59.79,0:19:01.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksud Yang Mulia,
Dialogue: 0,0:19:01.20,0:19:03.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ketenangan inilah yang paling berbahaya?
Dialogue: 0,0:19:04.09,0:19:05.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:19:05.70,0:19:09.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kini ibu kota sudah bagaikan\Ngudang mesiu yang hampir meledak.
Dialogue: 0,0:19:11.23,0:19:14.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Negara Kekaisaran ini\Nsedang berada di api penyucian.
Dialogue: 0,0:19:15.46,0:19:16.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letnan Kolonel.
Dialogue: 0,0:19:16.79,0:19:18.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Opini publik yang tersulut\Nsangat menakutkan.
Dialogue: 0,0:19:19.82,0:19:21.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih menakutkan daripada monster.
Dialogue: 0,0:19:22.45,0:19:24.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang, jika meremehkan opini publik,
Dialogue: 0,0:19:24.96,0:19:29.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}meskipun perang berakhir,\Nmungkin kekacauan tidak terhindarkan.
Dialogue: 0,0:19:29.97,0:19:33.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di zaman mana pun, opini publik\Nadalah hal yang sulit dipahami.
Dialogue: 0,0:19:34.33,0:19:36.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,
Dialogue: 0,0:19:36.07,0:19:39.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita lebih harus melakukan\Nhal yang seharusnya kita lakukan.
Dialogue: 0,0:19:39.59,0:19:40.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini demi perdamaian.
Dialogue: 0,0:19:42.54,0:19:46.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak menyangka ternyata kau\Nbegitu mencintai perdamaian.
Dialogue: 0,0:19:46.78,0:19:48.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku pengecut.
Dialogue: 0,0:19:48.83,0:19:50.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengecut?
Dialogue: 0,0:19:50.51,0:19:52.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau?
Dialogue: 0,0:19:52.07,0:19:53.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sungguh mengejutkan.
Dialogue: 0,0:19:53.46,0:19:55.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa ditulis jadi semacam dongeng.
Dialogue: 0,0:19:55.86,0:20:00.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minta Markas Staf Umum terbitkan,\Nbiar aku dapat pemasukan dari royalti.
Dialogue: 0,0:20:01.36,0:20:03.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan bicara royalti?
Dialogue: 0,0:20:04.21,0:20:06.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak masalah, aku setuju.
Dialogue: 0,0:20:07.06,0:20:12.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah perang berakhir, aku akan\Nterbitkan pengakuanmu jadi buku bergambar.
Dialogue: 0,0:20:12.28,0:20:14.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kehormatan terbesarku.
Dialogue: 0,0:20:15.48,0:20:16.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Judulnya,
Dialogue: 0,0:20:16.81,0:20:18.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}coba kupikirkan.
Dialogue: 0,0:20:19.16,0:20:22.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau "Pahlawan Pengecut"?
Dialogue: 0,0:20:39.56,0:20:41.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar omong kosong.
Dialogue: 0,0:20:41.84,0:20:45.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Propaganda seharusnya\Nmembuat orang percaya, 'kan?
Dialogue: 0,0:20:45.96,0:20:49.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setiap orang mendambakan mimpi indah.
Dialogue: 0,0:20:49.86,0:20:53.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mendambakan kemenangan besar tanah air.
Dialogue: 0,0:20:54.23,0:20:57.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya, melihatnya membuat\Npikiranku hampir kacau.
Dialogue: 0,0:21:05.45,0:21:10.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak semua orang bisa hidup sepertimu.
Dialogue: 0,0:21:10.17,0:21:12.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau memang bodoh.
Dialogue: 0,0:21:12.32,0:21:14.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba gunakan otakmu sedikit lagi,
Dialogue: 0,0:21:14.88,0:21:17.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan cari kembali akal sehatmu.
Dialogue: 0,0:21:18.39,0:21:21.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, sebenarnya aku yang tidak waras?
Dialogue: 0,0:21:23.40,0:21:28.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama ini aku berharap\Nbisa hidup beradab di belakang.
Dialogue: 0,0:21:28.14,0:21:30.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi untuk hidup di Kekaisaran saat ini,
Dialogue: 0,0:21:30.36,0:21:32.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harapan ini sepertinya\Ntidak bisa terwujud.
Dialogue: 0,0:21:33.05,0:21:36.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berani-beraninya melemparkanku\Nke dunia seperti ini.
Dialogue: 0,0:21:37.39,0:21:40.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Existence X sialan!
Dialogue: 0,0:23:14.50,0:23:15.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:23:16.37,0:23:18.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan ini?
Dialogue: 0,0:23:18.62,0:23:20.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia Rudersdorf menyuruh kami\Nmenyiapkan satu set pakaian
Dialogue: 0,0:23:20.27,0:23:23.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang terlihat seperti keluar bersama cucu.
Dialogue: 0,0:23:23.85,0:23:26.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kami menyiapkan pakaian koleksi kami.
Dialogue: 0,0:23:26.44,0:23:30.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kudengar akan menghadiri\Nupacara prajurit gugur, 'kan?
Dialogue: 0,0:23:30.57,0:23:31.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh.
Dialogue: 0,0:23:32.82,0:23:34.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,
Dialogue: 0,0:23:34.35,0:23:36.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagaimana dengan yang ini?
Dialogue: 0,0:23:36.11,0:23:37.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menolak.
Dialogue: 0,0:23:37.19,0:23:38.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
