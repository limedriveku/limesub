Dialogue: 0,0:07:57.58,0:08:01.15,sign,,0000,0000,0000,,MENDETEKSI ANOMALI, TIDAK DAPAT DIHITUNG
Dialogue: 0,0:08:08.13,0:08:08.46,sign,,0000,0000,0000,,PERINGATAN
Dialogue: 0,0:17:34.53,0:17:37.03,sign,,0000,0000,0000,,AKHIR DARI DUA DUNIA
Dialogue: 0,0:23:48.44,0:23:50.07,sign,,0000,0000,0000,,PEDANG
Dialogue: 0,0:00:02.10,0:00:04.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia seolah menantang kita mengejarnya.
Dialogue: 0,0:00:04.91,0:00:07.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keparat itu meremehkan kita.
Dialogue: 0,0:00:07.53,0:00:09.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat sembuhkan mereka, Shinigami!
Dialogue: 0,0:00:11.90,0:00:17.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai saja Kapten Unohana...\NRalat, Wakil Kapten Kotetsu ada di sini.
Dialogue: 0,0:00:38.60,0:00:40.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan memaksakan diri lagi.
Dialogue: 0,0:00:44.81,0:00:47.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wakil Kapten... Ise.
Dialogue: 0,0:00:48.21,0:00:51.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong sembuhkan\NIchigo dan Renji lebih dulu.
Dialogue: 0,0:00:51.07,0:00:52.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:00:52.95,0:00:55.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ada yang bisa kalahkan Yhwach, maka...
Dialogue: 0,0:00:58.55,0:00:59.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:01:00.75,0:01:02.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon.
Dialogue: 0,0:02:50.81,0:02:54.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bleach:\NThousand-Year Blood War - The Calamity
Dialogue: 0,0:03:07.78,0:03:08.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Genryusai!
Dialogue: 0,0:03:12.00,0:03:14.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar, Tuan Genryusai!
Dialogue: 0,0:03:22.35,0:03:23.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memintaku
Dialogue: 0,0:03:24.31,0:03:25.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pergi melindungi.
Dialogue: 0,0:03:41.35,0:03:44.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten, reiatsu ini...
Dialogue: 0,0:03:51.44,0:03:54.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo berangkat, Kapten.
Dialogue: 0,0:03:54.41,0:03:55.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus menghabisinya
Dialogue: 0,0:03:56.25,0:03:57.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan tangan kita sendiri.
Dialogue: 0,0:04:02.26,0:04:03.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wakil Kapten Abarai!
Dialogue: 0,0:04:07.41,0:04:09.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurosaki.
Dialogue: 0,0:04:10.25,0:04:11.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurosaki?
Dialogue: 0,0:04:12.91,0:04:15.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf, ya.
Dialogue: 0,0:04:15.99,0:04:17.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa memperbaiki
Dialogue: 0,0:04:18.11,0:04:20.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tensa Zangetsu.
Dialogue: 0,0:04:20.14,0:04:21.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:04:21.51,0:04:23.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan Yhwach adalah
Dialogue: 0,0:04:23.93,0:04:26.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}melihat seluruh kemungkinan di masa depan,
Dialogue: 0,0:04:27.31,0:04:30.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memilih salah satu sesuka hatinya,\Nlalu mengubah isinya.
Dialogue: 0,0:04:30.29,0:04:31.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau benar begitu,
Dialogue: 0,0:04:31.95,0:04:34.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagaimana kita bisa kalahkan dia?
Dialogue: 0,0:04:34.34,0:04:37.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segala hal yang sudah dipatahkan dari masa depan
Dialogue: 0,0:04:38.29,0:04:40.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tak dapat dikembalikan dengan "penolakan".
Dialogue: 0,0:04:41.35,0:04:43.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin begitu cara kerjanya.
Dialogue: 0,0:04:43.55,0:04:44.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya.
Dialogue: 0,0:04:45.31,0:04:46.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini...
Dialogue: 0,0:04:46.95,0:04:48.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tak bisa bertarung lagi.
Dialogue: 0,0:04:52.14,0:04:53.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo berangkat.
Dialogue: 0,0:04:55.14,0:04:56.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Renji!
Dialogue: 0,0:04:56.55,0:04:58.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, kamu mau ke mana?
Dialogue: 0,0:04:58.65,0:05:00.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah jelas, lah.
Dialogue: 0,0:05:00.41,0:05:02.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengejar orang itu.
Dialogue: 0,0:05:02.03,0:05:03.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bodoh.
Dialogue: 0,0:05:03.81,0:05:07.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya pikirkan strategi lain\Nsebelum pergi menantangnya!
Dialogue: 0,0:05:07.16,0:05:10.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Strategi macam apa yang bisa\Nkita pikirkan untuk kalahkan monster itu?
Dialogue: 0,0:05:11.38,0:05:13.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kalau itu...
Dialogue: 0,0:05:14.58,0:05:16.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Dia benar.
Dialogue: 0,0:05:17.81,0:05:19.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa lagi.
Dialogue: 0,0:05:24.30,0:05:25.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu...
Dialogue: 0,0:05:27.11,0:05:28.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tsukishima!
Dialogue: 0,0:05:30.24,0:05:33.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa yang kamu lakukan? Sialan.
Dialogue: 0,0:05:33.81,0:05:36.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bertanya-tanya?
Dialogue: 0,0:05:36.05,0:05:38.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma saja menanyakan itu padaku.
Dialogue: 0,0:05:38.75,0:05:43.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terpaksa lakukan ini\Nkarena Ginjo menyuruhku memihakmu.
Dialogue: 0,0:05:43.90,0:05:46.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memihakku?
Dialogue: 0,0:05:46.07,0:05:47.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak saja.
Dialogue: 0,0:05:47.61,0:05:49.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak menyuruhmu memihaknya.
Dialogue: 0,0:05:49.57,0:05:51.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak bilang begitu.
Dialogue: 0,0:05:51.52,0:05:53.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku bilang, sih!
Dialogue: 0,0:05:53.54,0:05:56.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya menyuruhnya membalas budi baikmu.
Dialogue: 0,0:05:58.33,0:06:02.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orihime, gunakan Sotenkishun lagi pada pedangnya.
Dialogue: 0,0:06:02.59,0:06:05.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin masa depannya\Ntelah diubah dengan kekuatan
Dialogue: 0,0:06:05.15,0:06:07.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang begitu besar\Nhingga tidak bisa "ditolak" olehmu,
Dialogue: 0,0:06:08.22,0:06:12.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kamu masih bisa "menolak" asalkan\Nmasa lalu ia belum patah masih ada.
Dialogue: 0,0:06:16.60,0:06:18.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuselipkan, kok.
Dialogue: 0,0:06:19.19,0:06:21.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Pedangmu
Dialogue: 0,0:06:21.19,0:06:23.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak dipatahkan".
Dialogue: 0,0:06:49.10,0:06:53.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah. Sekarang\Nutang budiku padamu sudah lunas, 'kan?
Dialogue: 0,0:06:55.81,0:06:56.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah.
Dialogue: 0,0:07:03.18,0:07:04.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa...?
Dialogue: 0,0:07:06.31,0:07:07.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ryuuken?!
Dialogue: 0,0:07:07.69,0:07:10.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan... Ayahnya Kurosaki?
Dialogue: 0,0:07:11.38,0:07:13.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kalian berdua ada di sini?
Dialogue: 0,0:07:15.65,0:07:16.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:07:16.83,0:07:20.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seluruh Quincy yang terkena Auswahlen
Dialogue: 0,0:07:20.35,0:07:22.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan memiliki gumpalan darah perak\Ndi jantungnya sebelum mati.
Dialogue: 0,0:07:23.46,0:07:26.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mata panah ini dibuat\Ndengan kumpulan gumpalan darah itu.
Dialogue: 0,0:07:27.67,0:07:30.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mata panah yang harus kamu tembakkan.
Dialogue: 0,0:07:57.58,0:07:59.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jumlah invasi menjadi 8,2!
Dialogue: 0,0:07:59.28,0:08:01.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ia berada di luar kategori skala Shutara!
Dialogue: 0,0:08:01.15,0:08:04.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada sosok dengan reishi berkonsentrasi tinggi\Nmuncul di dalam Shakonmaku!
Dialogue: 0,0:08:04.25,0:08:05.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sebenarnya terjadi?!
Dialogue: 0,0:08:05.88,0:08:06.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunjukkan visualnya!
Dialogue: 0,0:08:07.37,0:08:08.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:08:12.36,0:08:13.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yhwach!
Dialogue: 0,0:08:13.60,0:08:15.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bola mata menjijikkan apa itu?
Dialogue: 0,0:08:16.03,0:08:19.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial. Berarti kekuatan\Nsetara kapten pun gagal, ya.
Dialogue: 0,0:08:20.31,0:08:21.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bajingan.
Dialogue: 0,0:08:23.98,0:08:26.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tak perlu bertukar kata lagi.
Dialogue: 0,0:08:26.48,0:08:30.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak bisa... Semua sudah berakhir.
Dialogue: 0,0:08:30.05,0:08:31.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mendekat! Jangan mendekat!
Dialogue: 0,0:08:44.98,0:08:46.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di luar dugaan.
Dialogue: 0,0:08:46.35,0:08:51.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak menyangka bisa bertemu\Ndenganmu lagi di Soul Society.
Dialogue: 0,0:08:52.41,0:08:55.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang di Soul Society-ku.
Dialogue: 0,0:09:03.38,0:09:04.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo berangkat.
Dialogue: 0,0:09:04.70,0:09:05.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke!
Dialogue: 0,0:09:20.14,0:09:23.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih. Kakiku masih lemas.
Dialogue: 0,0:09:25.73,0:09:27.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak apa-apa, Ichigo?
Dialogue: 0,0:09:27.41,0:09:29.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, maaf.
Dialogue: 0,0:09:29.94,0:09:31.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baik-baik saja.
Dialogue: 0,0:09:31.70,0:09:33.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, berdiri!
Dialogue: 0,0:09:33.85,0:09:36.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Renji, kamu yakin...?
Dialogue: 0,0:09:36.01,0:09:37.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Yakin apa?
Dialogue: 0,0:09:38.15,0:09:39.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lukamu masih...
Dialogue: 0,0:09:40.23,0:09:43.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah lebih baik kalau kamu\Ntetap bersama Rukia?
Dialogue: 0,0:09:45.39,0:09:48.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, sialan!\NKamu mau tinju berapa kali, sih?!
Dialogue: 0,0:09:50.56,0:09:54.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena hanya ada kamu di sini,\Naku akan katakan langsung.
Dialogue: 0,0:09:55.98,0:09:57.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selalu.
Dialogue: 0,0:09:58.05,0:09:59.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama ini, selalu.
Dialogue: 0,0:09:59.45,0:10:00.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama puluhan tahun...
Dialogue: 0,0:10:01.15,0:10:06.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan Rukia sudah sangat jauh\Nhingga tak berpapasan lagi.
Dialogue: 0,0:10:06.88,0:10:10.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamulah yang sudah membuat kami dekat lagi.
Dialogue: 0,0:10:11.38,0:10:13.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi aku sudah putuskan.
Dialogue: 0,0:10:13.75,0:10:16.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kamu tidak bisa melangkah maju lagi,
Dialogue: 0,0:10:16.01,0:10:18.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan maju bahkan sambil menggendongmu.
Dialogue: 0,0:10:19.51,0:10:20.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari dulu sampai sekarang,
Dialogue: 0,0:10:21.51,0:10:22.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan untuk ke depannya.
Dialogue: 0,0:10:23.15,0:10:25.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selalu. Sampai kamu mati.
Dialogue: 0,0:10:27.55,0:10:30.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sudah paham,\Njangan suruh aku diam di belakang lagi.
Dialogue: 0,0:10:31.58,0:10:35.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya aku juga tidak akan katakan itu lagi.
Dialogue: 0,0:10:50.01,0:10:51.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar di luar dugaan.
Dialogue: 0,0:10:53.55,0:10:57.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir pertarungan di atas,\NIstana Raja Jiwa, sudah usai.
Dialogue: 0,0:10:57.80,0:11:02.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya Kurosaki Ichigo jauh lebih\Nmerepotkan dari yang kamu kira.
Dialogue: 0,0:11:02.43,0:11:06.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan samakan kesulitanmu denganku.
Dialogue: 0,0:11:06.37,0:11:09.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamulah yang sudah dikalahkan Kurosaki Ichigo.
Dialogue: 0,0:11:11.79,0:11:17.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun, aku harus berterima kasih\Nkarena kamu hancurkan kursi terkutuk itu.
Dialogue: 0,0:11:17.59,0:11:21.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat itu, aku bisa menghentikanmu sekarang.
Dialogue: 0,0:11:21.64,0:11:26.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau bertarung melawanku?\NDemi Soul Society?
Dialogue: 0,0:11:26.18,0:11:29.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak merasa kamu akan\Ndiuntungkan dalam hal ini.
Dialogue: 0,0:11:29.77,0:11:31.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan soal keuntungan.
Dialogue: 0,0:11:31.65,0:11:37.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya akan bertindak dan hancurkan\Nsesuatu yang berusaha menguasai aku.
Dialogue: 0,0:11:44.71,0:11:46.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ichigo, Renji.
Dialogue: 0,0:11:47.25,0:11:49.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian datang lebih cepat.
Dialogue: 0,0:11:50.08,0:11:53.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa melihat kalian datang ke sini.
Dialogue: 0,0:11:53.90,0:11:57.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu pula dengan pedangmu\Nyang kembali seperti semula.
Dialogue: 0,0:11:58.13,0:11:59.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu...
Dialogue: 0,0:12:00.15,0:12:03.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang itu kembali patah.
Dialogue: 0,0:12:05.78,0:12:08.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku berniat patahkan dengan rapi.
Dialogue: 0,0:12:09.25,0:12:13.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh keberuntungan yang menyebalkan, Ichigo.
Dialogue: 0,0:12:26.26,0:12:30.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sekarat, Ichigo.\NAku tak tega melihatmu.
Dialogue: 0,0:12:30.55,0:12:35.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu tidak datang\Nsetelah Inoue Orihime menyembuhkanmu?
Dialogue: 0,0:12:36.90,0:12:40.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa karena dia sendiri juga sekarat?
Dialogue: 0,0:12:40.01,0:12:44.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau kamu mengira tidak akan sempat\Njika mengejarku setelah diobati?
Dialogue: 0,0:12:45.74,0:12:47.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kamu datang ke tempat ini
Dialogue: 0,0:12:47.91,0:12:51.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak akan mengubah apa pun.
Dialogue: 0,0:12:55.71,0:12:58.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga, Abarai Renji!
Dialogue: 0,0:13:00.98,0:13:02.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bankai!
Dialogue: 0,0:13:02.74,0:13:04.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soo Zabimaru!
Dialogue: 0,0:13:08.81,0:13:09.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan!
Dialogue: 0,0:13:09.60,0:13:11.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih belum paham juga, ya?
Dialogue: 0,0:13:13.31,0:13:14.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Renji!
Dialogue: 0,0:13:14.50,0:13:17.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bankai tidak akan berguna melawanku.
Dialogue: 0,0:13:17.18,0:13:21.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seluruh Bankai sudah kupatahkan di masa depan.
Dialogue: 0,0:13:21.84,0:13:24.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah patahkan dengan kedua tanganku sendiri
Dialogue: 0,0:13:24.55,0:13:27.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar kalian, orang-orang yang melawanku,
Dialogue: 0,0:13:27.20,0:13:30.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}paham maksud perkataanku!
Dialogue: 0,0:13:33.95,0:13:35.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aizen!
Dialogue: 0,0:13:35.33,0:13:39.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu berusaha melindungi Abarai Renji?\NMenarik!
Dialogue: 0,0:13:39.71,0:13:45.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah bersatu melawan musuh yang sama\Nadalah mental pecundang yang kamu benci?
Dialogue: 0,0:13:50.61,0:13:52.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hado 99.
Dialogue: 0,0:13:52.78,0:13:54.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Goryuu Tenmetsu".
Dialogue: 0,0:14:04.69,0:14:09.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, apa kamu sadar, Aizen Sosuke?
Dialogue: 0,0:14:09.45,0:14:13.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kyoka Suigetsu milikmu juga sudah patah!
Dialogue: 0,0:14:20.11,0:14:21.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma.
Dialogue: 0,0:14:21.37,0:14:23.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sudah melihat itu.
Dialogue: 0,0:14:23.38,0:14:25.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ichigo.
Dialogue: 0,0:14:26.75,0:14:28.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali.
Dialogue: 0,0:14:29.09,0:14:34.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus beralih membantu Aizen Sosuke\Nsetelah melihat situasi di medan pertempuran.
Dialogue: 0,0:14:35.12,0:14:39.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kekuatan Kyoka Suigetsu pun\Ntak mampu menandingi kekuatanku.
Dialogue: 0,0:14:39.67,0:14:44.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abarai Renji-lah yang terpental\Nkarena dorongan kekuatanku.
Dialogue: 0,0:14:44.43,0:14:49.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, kamulah yang berusaha\Nmenebas lenganku, Ichigo.
Dialogue: 0,0:14:50.41,0:14:52.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa lihat semuanya.
Dialogue: 0,0:14:56.14,0:14:58.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah berakhir, Ichigo!
Dialogue: 0,0:15:04.46,0:15:06.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat tinggal, Ichigo.
Dialogue: 0,0:15:06.95,0:15:09.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlawanan darimu memberiku kesenangan.
Dialogue: 0,0:15:10.37,0:15:14.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya, hancurlah kau bersama Soul Society.
Dialogue: 0,0:15:16.98,0:15:18.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:15:20.15,0:15:22.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di matamu, aku terlihat seperti
Dialogue: 0,0:15:22.55,0:15:24.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurosaki Ichigo, ya.
Dialogue: 0,0:15:31.27,0:15:35.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Getsuga Tensho!
Dialogue: 0,0:15:54.06,0:15:55.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lumayan.
Dialogue: 0,0:15:56.59,0:16:00.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu hebat karena\Nlangsung bereaksi pada Kyoka Suigetsu-ku.
Dialogue: 0,0:16:00.93,0:16:04.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah merasa aneh dalam perjalanan ke sini.
Dialogue: 0,0:16:04.82,0:16:08.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya persis seperti saat kamu\Nmenggunakan Kyoka Suigetsu pada semua orang.
Dialogue: 0,0:16:09.52,0:16:10.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:16:10.90,0:16:15.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengaktifan Kyoka Suigetsu\Nsebelum kalian sampai di sini.
Dialogue: 0,0:16:15.83,0:16:19.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, aku sadar bahwa Kyoka Suigetsu mampu
Dialogue: 0,0:16:19.52,0:16:23.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memengaruhi penglihatan masa depan\N"The Almighty" miliknya.
Dialogue: 0,0:16:23.58,0:16:27.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisanya ada padamu\Nyang tak terpengaruh Kyoka Suigetsu.
Dialogue: 0,0:16:28.08,0:16:32.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak menyangka tak memperlihatkanmu
Dialogue: 0,0:16:32.04,0:16:34.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pengaktifan Kyoka Suigetsu\Nbisa berguna seperti ini.
Dialogue: 0,0:16:36.57,0:16:37.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurosaki Ichigo.
Dialogue: 0,0:16:42.09,0:16:43.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aizen!
Dialogue: 0,0:16:46.36,0:16:49.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah mengaktifkan Kyoka Suigetsu, ya.
Dialogue: 0,0:16:49.11,0:16:51.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bentuk arogansi, atau sudah mencapai batas?
Dialogue: 0,0:16:52.85,0:16:54.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Ichigo.
Dialogue: 0,0:16:54.86,0:16:59.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu mengira bisa membunuhku\Ndengan serangan remeh itu?
Dialogue: 0,0:17:01.06,0:17:04.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatanku bisa mengubah masa depan.
Dialogue: 0,0:17:04.49,0:17:08.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bahkan bisa menulis ulang\Nmasa depan berisi kematianku!
Dialogue: 0,0:17:10.20,0:17:11.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma saja!
Dialogue: 0,0:17:20.05,0:17:21.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah berakhir.
Dialogue: 0,0:17:21.45,0:17:24.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik dunia nyata dan Soul Society...
Dialogue: 0,0:17:24.70,0:17:27.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keduanya akan menghilang dan menyatu
Dialogue: 0,0:17:27.63,0:17:29.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di hadapan kekuatanku!
Dialogue: 0,0:19:02.53,0:19:07.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bleach:\NThousand-Year Blood War - The Calamity
Dialogue: 0,0:19:35.52,0:19:36.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?
Dialogue: 0,0:19:37.25,0:19:40.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar! Setidaknya pakai otakmu saat bertarung!
Dialogue: 0,0:19:40.23,0:19:41.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hampir saja aku tertimpa itu!
Dialogue: 0,0:19:41.80,0:19:43.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maafkan aku!
Dialogue: 0,0:19:43.75,0:19:47.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, kenapa aku dimarahi\Norang dari dunia nyata, ya?
Dialogue: 0,0:19:47.81,0:19:50.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena kamu tidak fokus, tahu!
Dialogue: 0,0:19:50.29,0:19:52.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga... Aku paham, kok!
Dialogue: 0,0:20:48.93,0:20:50.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:20:51.47,0:20:52.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga dia akan datang.
Dialogue: 0,0:20:53.80,0:20:55.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yhwach.
Dialogue: 0,0:20:56.05,0:21:00.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku telah menyatu dengan dunia ini.
Dialogue: 0,0:21:00.89,0:21:03.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu dan tempat tak lagi bermakna di hadapanku.
Dialogue: 0,0:21:03.74,0:21:06.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kamu tak menginginkan itu,
Dialogue: 0,0:21:06.58,0:21:09.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan selalu ada di seluruh dunia ini.
Dialogue: 0,0:21:09.28,0:21:15.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan melihat masa depan dan memilihnya,\Nkini terasa begitu naif.
Dialogue: 0,0:21:15.13,0:21:17.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku, "The Almighty",
Dialogue: 0,0:21:17.78,0:21:19.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan menjadi raja ketiga dunia,
Dialogue: 0,0:21:19.92,0:21:22.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan membinasakan segalanya.
Dialogue: 0,0:21:23.13,0:21:25.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, dengan kedua tanganku,
Dialogue: 0,0:21:25.44,0:21:28.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan menciptakan dunia baru!
Dialogue: 0,0:22:01.69,0:22:04.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan kubiarkan!
Dialogue: 0,0:22:04.80,0:22:07.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia benar, dunia ini...
Dialogue: 0,0:22:07.97,0:22:09.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kami lindungi!
Dialogue: 0,0:22:10.34,0:22:11.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus.
Dialogue: 0,0:22:14.35,0:22:18.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan bilang Gotei harus mati.
Dialogue: 0,0:22:18.22,0:22:19.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Komandan Kyoraku!
Dialogue: 0,0:22:20.39,0:22:21.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar baik-baik.
Dialogue: 0,0:22:21.65,0:22:25.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus lindungi dunia ini\Ndan kembali dengan selamat.
Dialogue: 0,0:22:25.90,0:22:28.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus semua, tanpa terkecuali.
Dialogue: 0,0:22:28.90,0:22:30.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ada yang tidak bisa pulang,
Dialogue: 0,0:22:31.26,0:22:33.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maka itu kejahatan yang harus dihukum mati.
Dialogue: 0,0:22:33.91,0:22:37.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan harap kau bisa\Nmenginjak-injak dunia kami lagi!
Dialogue: 0,0:22:38.01,0:22:41.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti akan lindungi Hueco Mundo!
Dialogue: 0,0:22:41.99,0:22:43.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raja ketiga dunia, katanya?
Dialogue: 0,0:22:45.33,0:22:47.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, sebelum bisa membunuh Kurosaki,
Dialogue: 0,0:22:47.72,0:22:50.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku harus mengalahkanmu terlebih dahulu!
Dialogue: 0,0:23:05.59,0:23:06.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ishida?
Dialogue: 0,0:23:11.41,0:23:13.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf membuatmu menunggu, Kurosaki.
Dialogue: 0,0:23:16.27,0:23:18.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Angkuh sekali lagakmu itu.
Dialogue: 0,0:23:18.62,0:23:19.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu telat.
Dialogue: 0,0:23:25.52,0:23:26.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo lakukan.
Dialogue: 0,0:23:26.93,0:23:27.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:23:35.96,0:23:40.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ingin menyelamatkan,\Npercayalah pada diri sendiri.
Dialogue: 0,0:23:40.92,0:23:44.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau percaya pada diri sendiri
Dialogue: 0,0:23:44.28,0:23:48.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang yang percaya\Npasti akan terselamatkan.
