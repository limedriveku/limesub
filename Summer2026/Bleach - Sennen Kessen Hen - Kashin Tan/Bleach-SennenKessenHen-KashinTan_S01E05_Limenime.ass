Dialogue: 0,0:00:00.00,0:00:01.91,sign,,0000,0000,0000,,BLEACH EPISODE 45
Dialogue: 0,0:00:34.03,0:00:36.95,sign,,0000,0000,0000,,MELINDUNGIMU
Dialogue: 0,0:02:04.62,0:02:06.91,sign,,0000,0000,0000,,{\an8}BLEACH: THOUSAND-YEAR BLOOD WAR
Dialogue: 0,0:25:07.46,0:25:09.59,sign,,0000,0000,0000,,{\an8}BLEACH EPISODE 45
Dialogue: 0,0:25:15.51,0:25:19.89,sign,,0000,0000,0000,,{\an8}MELINDUNGIMU DENGAN NYAWAKU
Dialogue: 0,0:00:04.62,0:00:08.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Getsuga Tensho menyatu\Ndengan Gran Rey Cero.
Dialogue: 0,0:00:08.75,0:00:12.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yang lahir dari perpaduan segalanya
Dialogue: 0,0:00:12.26,0:00:14.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sangat cocok dengan kekuatan ini.
Dialogue: 0,0:00:15.18,0:00:16.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun…
Dialogue: 0,0:00:16.43,0:00:20.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kendati demikian, tetap belum cukup.
Dialogue: 0,0:02:08.71,0:02:11.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Brazo Izquierdo Del Diablo,
Dialogue: 0,0:02:12.17,0:02:13.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}La Muerte!
Dialogue: 0,0:02:15.55,0:02:17.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus!
Dialogue: 0,0:02:17.34,0:02:19.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lanjutkan terus seperti ini\Ndan kalahkan yang lainnya.
Dialogue: 0,0:02:31.02,0:02:32.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan?
Dialogue: 0,0:02:32.48,0:02:34.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hanya kalian berdua?\N- Di mana Ichigo?
Dialogue: 0,0:02:34.98,0:02:37.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia dan Inoue naik untuk mencari Yhwach.
Dialogue: 0,0:02:38.19,0:02:39.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar.
Dialogue: 0,0:02:39.20,0:02:41.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya, dia tidak menerjang sendirian.
Dialogue: 0,0:02:43.12,0:02:45.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Renji?\N- Rukia, kau pergi dulu saja.
Dialogue: 0,0:02:45.41,0:02:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan yang di sini kepadaku.
Dialogue: 0,0:02:48.00,0:02:48.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:02:56.46,0:02:58.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kalian\Nmasih belum memahami situasinya.
Dialogue: 0,0:02:58.76,0:03:03.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian semua hanya figuran bagiku.
Dialogue: 0,0:03:11.48,0:03:13.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uryu Ishida, apakah kau hanya bisa kabur?
Dialogue: 0,0:03:31.25,0:03:35.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, pasanglah anak panahmu,\NQuincy terakhir.
Dialogue: 0,0:03:36.50,0:03:38.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menebas panahmu
Dialogue: 0,0:03:39.42,0:03:42.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan akan kuungkapkan\Nsegala sesuatu tentang dirimu.
Dialogue: 0,0:03:47.06,0:03:50.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba saja\Nkalau pedangmu bisa mengenaiku.
Dialogue: 0,0:04:05.32,0:04:08.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pusaran kekacauan yang tidak tertandingi.
Dialogue: 0,0:04:08.62,0:04:10.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah
Dialogue: 0,0:04:11.33,0:04:13.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kekuatan Raja Arwah.
Dialogue: 0,0:04:16.42,0:04:18.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak bisa menghentikannya.
Dialogue: 0,0:04:21.46,0:04:22.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shiten Koshun!
Dialogue: 0,0:04:36.35,0:04:40.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ichigo, apa arti kekuatan?
Dialogue: 0,0:04:40.07,0:04:42.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk apa kekuatan itu ada?
Dialogue: 0,0:04:42.36,0:04:46.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mungkin akan menjawab\N"untuk melindungi", 'kan?
Dialogue: 0,0:04:47.24,0:04:51.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, itu adalah kekuatan yang lemah.
Dialogue: 0,0:04:55.62,0:04:58.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan yang benar-benar dahsyat adalah\Nmenghancurkan banyak orang
Dialogue: 0,0:04:58.75,0:05:00.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan membuat dunia tunduk kepadanya.
Dialogue: 0,0:05:00.96,0:05:04.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan untuk mengendalikan\Nsegala sesuatu di dunia ini.
Dialogue: 0,0:05:04.80,0:05:07.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kau bilang akan mengalahkanku,
Dialogue: 0,0:05:08.64,0:05:12.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kekuatan itu seharusnya adalah\Nkekuatan seperti itu.
Dialogue: 0,0:05:12.60,0:05:14.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Melindungi" hanyalah sebuah kebohongan.
Dialogue: 0,0:05:14.81,0:05:16.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan berlagak menjadi pahlawan,
Dialogue: 0,0:05:16.98,0:05:17.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ichigo.
Dialogue: 0,0:05:18.52,0:05:19.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Melindungi.{\i0}
Dialogue: 0,0:05:21.11,0:05:24.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Padahal aku ingin melindungi Kurosaki.{\i0}
Dialogue: 0,0:05:26.61,0:05:28.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini semua karena kekuatanku terlalu lemah.{\i0}
Dialogue: 0,0:05:30.16,0:05:33.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Andai saja kekuatanku lebih besar…{\i0}
Dialogue: 0,0:05:49.39,0:05:50.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar trik murahan.
Dialogue: 0,0:05:51.68,0:05:53.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menolak.
Dialogue: 0,0:06:00.73,0:06:02.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menolak!
Dialogue: 0,0:06:14.29,0:06:15.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inoue!
Dialogue: 0,0:06:16.33,0:06:20.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau masih sempat mengkhawatirkan\Norang lain?
Dialogue: 0,0:06:33.26,0:06:36.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, lanjutkan saja.
Dialogue: 0,0:06:36.97,0:06:39.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lanjutkan sampai kekuatanmu\Nterkuras habis.
Dialogue: 0,0:06:45.98,0:06:50.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku me… menolak.
Dialogue: 0,0:07:05.09,0:07:06.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inoue…
Dialogue: 0,0:07:08.26,0:07:10.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}He-Hentikan.
Dialogue: 0,0:07:11.51,0:07:16.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku… menolak.
Dialogue: 0,0:07:26.94,0:07:28.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sudah cukup, Inoue!\N- Berisik sekali.
Dialogue: 0,0:07:28.99,0:07:30.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menolak!
Dialogue: 0,0:07:38.20,0:07:42.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menggunakan\Nkekuatan terakhirmu untuk Ichigo?
Dialogue: 0,0:07:45.71,0:07:49.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, memangnya kenapa?
Dialogue: 0,0:07:51.84,0:07:53.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Andai saja kekuatanku{\i0}
Dialogue: 0,0:07:56.43,0:07:59.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}lebih besar…{\i0}
Dialogue: 0,0:08:06.02,0:08:09.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah bertahan\Nsampai sejauh ini, Inoue.
Dialogue: 0,0:08:10.15,0:08:12.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuchiki.
Dialogue: 0,0:08:13.24,0:08:14.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rukia.
Dialogue: 0,0:08:15.16,0:08:17.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ichigo, aku datang untuk menyelamatkanmu.
Dialogue: 0,0:08:22.58,0:08:25.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inoue, kau baik-baik saja?
Dialogue: 0,0:08:25.04,0:08:26.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:08:26.04,0:08:28.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah menyelamatkanku.
Dialogue: 0,0:08:29.34,0:08:31.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya serahkan padaku.
Dialogue: 0,0:08:37.89,0:08:40.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beberapa waktu tidak bertemu,\Nkau telah banyak berubah.
Dialogue: 0,0:08:41.52,0:08:43.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terbungkus selimut hitam seperti bacang,
Dialogue: 0,0:08:43.39,0:08:45.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan telah tumbuh tanduk.
Dialogue: 0,0:08:45.06,0:08:45.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik sekali!
Dialogue: 0,0:08:45.98,0:08:47.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sendiri juga tidak mau\Nterbungkus seperti ini.
Dialogue: 0,0:08:47.98,0:08:49.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlebih lagi, tanduk ini keren, tahu?
Dialogue: 0,0:08:49.57,0:08:50.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, ada apa denganmu?
Dialogue: 0,0:08:50.57,0:08:52.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan tiba-tiba datang\Ndan berbicara omong kosong.
Dialogue: 0,0:08:52.07,0:08:53.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa katamu?
Dialogue: 0,0:08:53.15,0:08:55.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inikah caramu berbicara\Nkepada orang yang menyelamatkanmu?
Dialogue: 0,0:08:55.32,0:08:56.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak memintamu\Nuntuk menyelamatkanku.
Dialogue: 0,0:08:56.66,0:08:58.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beraninya orang yang\Ndibungkus seperti bacang
Dialogue: 0,0:08:58.07,0:08:59.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan dihajar\Nhabis-habisan berbicara seperti ini.
Dialogue: 0,0:08:59.49,0:09:02.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu, aku baru saja\Nmau menyerang balik.
Dialogue: 0,0:09:06.17,0:09:08.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sepertinya tidak gentar.
Dialogue: 0,0:09:08.96,0:09:10.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:09:10.38,0:09:12.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rukia Kuchiki.
Dialogue: 0,0:09:12.42,0:09:16.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shinigami yang membimbing Ichigo, benar?
Dialogue: 0,0:09:17.84,0:09:20.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku harus berterima kasih\Npada Shinigami,
Dialogue: 0,0:09:20.85,0:09:22.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seharusnya orang itu adalah kau.
Dialogue: 0,0:09:22.27,0:09:25.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yang menarik pelatuk\Nuntuk kebangkitannya.
Dialogue: 0,0:09:26.69,0:09:29.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku tidak perlu\Nmeminta maaf atas ketidaksopananku.
Dialogue: 0,0:09:31.15,0:09:34.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang akan mengalahkanmu\Njuga adalah aku dan dia.
Dialogue: 0,0:09:38.74,0:09:41.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Rukia, ayo maju.\N- Baik.
Dialogue: 0,0:09:43.95,0:09:44.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:09:44.91,0:09:46.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh tidak kreatif.
Dialogue: 0,0:09:52.63,0:09:53.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Satu.{\i0}
Dialogue: 0,0:09:54.13,0:09:55.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dua.{\i0}
Dialogue: 0,0:09:57.59,0:09:59.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tiga.{\i0}
Dialogue: 0,0:09:59.09,0:10:00.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa melihatnya.
Dialogue: 0,0:10:02.72,0:10:05.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya Quincy terakhir\Nmenyerang dari belakang dengan pedang.
Dialogue: 0,0:10:05.77,0:10:07.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini panah.
Dialogue: 0,0:10:07.35,0:10:09.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba ramalkan juga\Napa yang akan kukatakan.
Dialogue: 0,0:10:09.73,0:10:11.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Grand Master!
Dialogue: 0,0:10:13.44,0:10:15.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Prasyaratnya adalah\Nada kesempatan berikutnya.
Dialogue: 0,0:10:24.41,0:10:26.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh penampilan yang memalukan.
Dialogue: 0,0:10:26.87,0:10:30.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, itu sangat cocok denganmu,\NUryu Ishida.
Dialogue: 0,0:10:51.77,0:10:54.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan yang menarik.
Dialogue: 0,0:10:54.07,0:10:58.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, bertarung bersama teman\Nsepertinya justru menjadi belenggu.
Dialogue: 0,0:10:58.69,0:11:00.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rukia, lebih cepat lagi.
Dialogue: 0,0:11:01.41,0:11:02.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jatuhkan dia.
Dialogue: 0,0:11:03.62,0:11:05.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu kau katakan.
Dialogue: 0,0:11:48.08,0:11:51.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Andai saja aku punya kekuatan,{\i0}
Dialogue: 0,0:11:52.71,0:11:58.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kurosaki dan Kuchiki\Ntidak akan terluka separah ini.{\i0}
Dialogue: 0,0:11:59.76,0:12:01.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini semua karena kekuatanku terlalu lemah.{\i0}
Dialogue: 0,0:12:03.01,0:12:07.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Karena itu, Kurosaki dan Kuchiki\Nmenjadi menderita.{\i0}
Dialogue: 0,0:12:08.89,0:12:12.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Andai saja kekuatanku bisa menjadi{\i0}
Dialogue: 0,0:12:13.81,0:12:14.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}lebih besar.{\i0}
Dialogue: 0,0:12:29.20,0:12:33.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kembalilah ke kehampaan,\Nwahai orang-orang lemah.
Dialogue: 0,0:12:43.88,0:12:47.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat tinggal, Putraku.
Dialogue: 0,0:13:01.07,0:13:03.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bulan.
Dialogue: 0,0:13:04.82,0:13:05.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ban
Dialogue: 0,0:13:10.87,0:13:11.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kai.
Dialogue: 0,0:13:19.00,0:13:21.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya kau menunjukkannya?
Dialogue: 0,0:13:22.13,0:13:24.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bankai milikmu.
Dialogue: 0,0:13:42.15,0:13:43.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurosaki.
Dialogue: 0,0:13:43.69,0:13:44.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata begitu.
Dialogue: 0,0:13:45.19,0:13:47.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, itu adalah Zangetsu-mu.
Dialogue: 0,0:13:55.08,0:13:57.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membuat semua kekuatan
Dialogue: 0,0:13:58.75,0:14:01.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang kau miliki tunduk padaku.
Dialogue: 0,0:14:12.30,0:14:13.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan ini
Dialogue: 0,0:14:14.89,0:14:18.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah kekuatan yang dibutuhkan
Dialogue: 0,0:14:19.27,0:14:21.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk melindungi semua orang darimu.
Dialogue: 0,0:14:22.73,0:14:24.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ichigo, kau terlalu lemah.
Dialogue: 0,0:14:24.69,0:14:27.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yhwach, aku akan menyerang.
Dialogue: 0,0:14:33.41,0:14:36.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa? Serangan tebasannya melambat?{\i0}
Dialogue: 0,0:14:37.04,0:14:40.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, aku hanya perlu menangkisnya.{\i0}
Dialogue: 0,0:14:43.00,0:14:45.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal ada perasaan tertebas,
Dialogue: 0,0:14:45.25,0:14:46.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kenapa kau masih ada di sana?
Dialogue: 0,0:14:53.85,0:14:54.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa?
Dialogue: 0,0:15:00.60,0:15:03.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tekanan Spiritual yang mengesalkan.
Dialogue: 0,0:15:36.60,0:15:39.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah kekuatan\Nyang melampaui batas Shinigami.
Dialogue: 0,0:15:39.85,0:15:43.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun,\Nsudah kubilang, kau terlalu lemah, Ichigo.
Dialogue: 0,0:15:51.24,0:15:54.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan ini seperti berkata\Nbahwa ia tidak butuh teman.
Dialogue: 0,0:16:08.46,0:16:09.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Getsuga…
Dialogue: 0,0:16:18.72,0:16:23.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tensho!
Dialogue: 0,0:16:43.79,0:16:44.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurosaki.
Dialogue: 0,0:17:03.89,0:17:05.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Dia sedang meremehkanku."
Dialogue: 0,0:17:06.77,0:17:09.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Aku harus mengalahkannya\Ndalam sekejap waktu."
Dialogue: 0,0:17:09.23,0:17:11.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah yang kau pikirkan tadi, 'kan?
Dialogue: 0,0:17:12.40,0:17:15.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak meremehkanmu.
Dialogue: 0,0:17:15.15,0:17:18.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus memahamimu dulu\Nagar bisa menelanmu.
Dialogue: 0,0:17:18.41,0:17:20.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ichigo, cepat tebas! Sekarang juga!
Dialogue: 0,0:17:20.62,0:17:22.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, pada detik itu…
Dialogue: 0,0:17:22.95,0:17:23.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Getsuga…
Dialogue: 0,0:17:24.41,0:17:26.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang sudah berakhir!
Dialogue: 0,0:17:35.13,0:17:36.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurosaki.
Dialogue: 0,0:17:42.18,0:17:44.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau adalah saksi terakhir.
Dialogue: 0,0:17:45.06,0:17:48.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membuatmu menyaksikan sendiri\Ndirimu lenyap dari dunia ini.
Dialogue: 0,0:17:48.40,0:17:49.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa bisa melindungi apa pun,
Dialogue: 0,0:17:49.77,0:17:51.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tanpa meninggalkan apa pun,
Dialogue: 0,0:17:51.23,0:17:52.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tanpa bisa melakukan apa pun,
Dialogue: 0,0:17:52.82,0:17:54.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau akan dilenyapkan begitu saja.
Dialogue: 0,0:17:55.36,0:17:59.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan melindungi Kurosaki.
Dialogue: 0,0:17:59.91,0:18:03.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tekadmu yang kuat patut dipuji.
Dialogue: 0,0:18:03.37,0:18:08.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, dengan kekuatanmu itu,\Njangankan melindungi Ichigo,
Dialogue: 0,0:18:08.04,0:18:11.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}kau bahkan masih jauh dari layak\Nuntuk bertarung bersama di sisinya.
Dialogue: 0,0:18:11.29,0:18:13.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Alasan kau bisa berada di sini
Dialogue: 0,0:18:13.42,0:18:16.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}adalah karena Ichigo belum dewasa\Ndan tidak bisa melepaskan kenaifannya.
Dialogue: 0,0:18:16.38,0:18:17.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yhwach!
Dialogue: 0,0:18:26.27,0:18:30.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari dulu sampai sekarang,\Nwanita itu selalu menjadi kelemahanmu.
Dialogue: 0,0:18:30.77,0:18:34.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal yang menghalangi pertarunganmu
Dialogue: 0,0:18:34.32,0:18:37.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}justru adalah alasanmu memegang pedang,
Dialogue: 0,0:18:37.32,0:18:39.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yaitu hati untuk melindungi.
Dialogue: 0,0:18:40.61,0:18:44.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau justru akan kalah karena bertarung.
Dialogue: 0,0:18:45.37,0:18:46.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ichigo.
Dialogue: 0,0:19:11.94,0:19:12.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bankai.
Dialogue: 0,0:19:18.65,0:19:20.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hakka no Togame.
Dialogue: 0,0:19:26.74,0:19:27.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Getsuga
Dialogue: 0,0:19:27.87,0:19:30.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tensho!
Dialogue: 0,0:20:04.28,0:20:05.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuchiki…
Dialogue: 0,0:20:10.04,0:20:12.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah kekuatan.
Dialogue: 0,0:20:13.42,0:20:15.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau terlalu bodoh.
Dialogue: 0,0:20:17.92,0:20:19.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ichigo.
Dialogue: 0,0:20:21.30,0:20:25.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah akhir dari kekuatan melindungi\Nyang kau katakan.
Dialogue: 0,0:20:26.55,0:20:32.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, ini juga bukti dari kekuatan dahsyat\Nyang kukatakan.
Dialogue: 0,0:20:33.89,0:20:35.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Andai saja kekuatanku{\i0}
Dialogue: 0,0:20:36.90,0:20:42.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}bisa menjadi lebih besar.{\i0}
Dialogue: 0,0:20:48.95,0:20:52.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hancurlah menjadi abu, Uryu Ishida.
Dialogue: 0,0:20:55.50,0:20:58.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuai dugaanku, Uryu Ishida.
Dialogue: 0,0:20:58.00,0:20:59.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senjata andalanmu,
Dialogue: 0,0:21:00.46,0:21:02.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leiden Hant.
Dialogue: 0,0:21:02.38,0:21:05.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, langkah selanjutnya\Njuga sudah kutebak.
Dialogue: 0,0:21:06.22,0:21:09.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sebaiknya jangan asal
Dialogue: 0,0:21:09.35,0:21:12.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menggunakan kekuatan Yang Mulia Yhwach\Ntanpa pertimbangan.
Dialogue: 0,0:21:13.18,0:21:14.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu akan memunculkan celah.
Dialogue: 0,0:21:14.60,0:21:15.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Celah?
Dialogue: 0,0:21:16.73,0:21:21.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kau berkata begitu\Nkarena sudah berada di belakangku?
Dialogue: 0,0:21:25.36,0:21:26.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shuno.
Dialogue: 0,0:21:32.33,0:21:33.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tsubaki.
Dialogue: 0,0:21:36.08,0:21:37.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayame.
Dialogue: 0,0:21:38.21,0:21:39.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hinagiku.
Dialogue: 0,0:21:42.92,0:21:43.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baigon.
Dialogue: 0,0:21:44.59,0:21:45.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily.
Dialogue: 0,0:22:04.28,0:22:06.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kenapa aku begitu lemah?{\i0}
Dialogue: 0,0:22:09.28,0:22:12.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kenapa kekuatanku begitu kecil?{\i0}
Dialogue: 0,0:22:17.83,0:22:19.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sternenstaub!
Dialogue: 0,0:22:20.00,0:22:21.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa melihatnya.
Dialogue: 0,0:22:25.34,0:22:27.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Berengsek.\N- Tiga detik.
Dialogue: 0,0:22:27.30,0:22:30.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kalau aku terlihat\Nseperti berlarian ke sana kemari,
Dialogue: 0,0:22:30.18,0:22:32.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}itulah penyebab kekalahanmu.
Dialogue: 0,0:22:32.35,0:22:34.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Begitu kau menggunakan sekali\Npenglihatan masa depan,
Dialogue: 0,0:22:34.60,0:22:36.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}kau tidak bisa menggunakan\Nkekuatan itu lagi selama tiga detik.
Dialogue: 0,0:22:37.31,0:22:40.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tiga detik saja tidak mungkin bisa\Nmemberimu peluang untuk menang.
Dialogue: 0,0:22:43.02,0:22:44.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku tetap mendapat tiga detik.
Dialogue: 0,0:22:52.37,0:22:55.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Andai saja kekuatanku{\i0}
Dialogue: 0,0:22:56.29,0:22:59.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}lebih besar dari saat ini.{\i0}
Dialogue: 0,0:23:01.63,0:23:04.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Begitu besar sampai diriku sendiri\Ntidak sanggup menahannya.{\i0}
Dialogue: 0,0:23:04.96,0:23:07.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Andai saja bisa besar\Nhingga tidak terbatas…{\i0}
Dialogue: 0,0:23:12.22,0:23:15.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Padahal, selama menyelimuti seluruh dunia,{\i0}
Dialogue: 0,0:23:15.93,0:23:22.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}maka bisa menghilangkan\Npertarungan, luka, dan penderitaan,{\i0}
Dialogue: 0,0:23:23.31,0:23:25.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}serta segala sesuatu.{\i0}
Dialogue: 0,0:23:39.20,0:23:42.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jadi, aku…{\i0}
Dialogue: 0,0:23:43.54,0:23:47.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kau akan\Nmembuang nyawamu, Orihime Inoue?
Dialogue: 0,0:23:57.18,0:23:58.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan benda ini…
Dialogue: 0,0:23:58.43,0:24:02.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan benda ini,\Naku bisa melenyapkan kekuatanmu.
Dialogue: 0,0:24:13.24,0:24:14.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu.
Dialogue: 0,0:24:16.45,0:24:17.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inoue!
Dialogue: 0,0:24:17.99,0:24:20.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inoue…
Dialogue: 0,0:25:09.59,0:25:11.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Kurosaki, sampai jumpa.{\i0}
Dialogue: 0,0:25:12.30,0:25:15.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Aku akan mengadang semuanya untukmu.{\i0}
