Dialogue: 0,0:00:00.70,0:00:02.10,sign,,0000,0000,0000,,PERINGATAN
Dialogue: 0,0:12:17.11,0:12:20.01,sign,,0000,0000,0000,,MERAH KIRMIZI SEMPURNA
Dialogue: 0,0:19:59.01,0:19:59.95,sign,,0000,0000,0000,,PERINGATAN
Dialogue: 0,0:20:03.39,0:20:04.55,sign,,0000,0000,0000,,PERINGATAN
Dialogue: 0,0:23:46.92,0:23:51.08,sign,,0000,0000,0000,,MEMPERTAHANKAN DIRIMU
Dialogue: 0,0:00:11.11,0:00:11.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?!
Dialogue: 0,0:00:12.16,0:00:14.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jumlah invasi perbatasannya\Nbertambah menjadi 1,02!
Dialogue: 0,0:00:14.82,0:00:16.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tiba-tiba bertambah sebanyak itu?
Dialogue: 0,0:00:16.66,0:00:17.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana kutahu!
Dialogue: 0,0:00:17.53,0:00:21.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti ada sesuatu yang mendorong\Nperbatasan itu secara paksa.
Dialogue: 0,0:00:22.22,0:00:24.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sebenarnya terjadi?
Dialogue: 0,0:00:24.96,0:00:26.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinannya adalah
Dialogue: 0,0:00:28.03,0:00:31.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kekuatan Kapten Ukitake makin melemah.
Dialogue: 0,0:00:37.14,0:00:39.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akon, kalau dibiarkan saja...!
Dialogue: 0,0:00:39.23,0:00:40.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tahu!
Dialogue: 0,0:00:48.67,0:00:51.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketiga dunia akan lenyap.
Dialogue: 0,0:02:20.26,0:02:22.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bleach:\NThousand-Year Blood War - The Calamity
Dialogue: 0,0:02:24.30,0:02:26.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kalian begitu mengidamkan keputusasaan?
Dialogue: 0,0:02:27.41,0:02:28.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan ini?
Dialogue: 0,0:02:28.91,0:02:30.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana bisa?
Dialogue: 0,0:02:30.63,0:02:32.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kalian bingung?
Dialogue: 0,0:02:32.48,0:02:34.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatanku adalah "Miracle".
Dialogue: 0,0:02:34.38,0:02:37.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Miracle" adalah mewujudkan\Nharapan orang-orang menjadi nyata!
Dialogue: 0,0:02:38.31,0:02:41.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Gerard Valkyrie!
Dialogue: 0,0:02:41.46,0:02:45.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku adalah mukjizat, dan mukjizat adalah aku!
Dialogue: 0,0:02:51.90,0:02:55.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar tak menangkap\Nmaksud ucapannya,
Dialogue: 0,0:02:55.06,0:02:59.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku paham kekuatannya bukan sesuatu\Nyang bisa dipikir dengan logika.
Dialogue: 0,0:02:59.34,0:03:00.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:03:01.09,0:03:04.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya, aku hanya perlu membunuhmu\Ntanpa membuat pedangnya patah, 'kan?
Dialogue: 0,0:03:04.76,0:03:07.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau malah menjelaskan solusinya sendiri.
Dialogue: 0,0:03:07.35,0:03:10.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar keparat bodoh,\Nakan kubuat kau menyesal!
Dialogue: 0,0:03:10.61,0:03:14.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memberitahumu demi menutup\Nselisih kekuatan di antara kita.
Dialogue: 0,0:03:14.55,0:03:18.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena bodohnya kau tak memahami itu,\Nkau pasti akan menyesal!
Dialogue: 0,0:03:18.94,0:03:22.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa...\NAku mulai merasa mereka berdua mirip.
Dialogue: 0,0:03:33.29,0:03:34.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rupanya bisa mengelak!
Dialogue: 0,0:03:35.04,0:03:37.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu jauh lebih gesit daripada kelihatannya!
Dialogue: 0,0:03:37.76,0:03:42.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku berniat meremukkan tubuhmu\Ndengan satu kepalan!
Dialogue: 0,0:03:42.53,0:03:44.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu gesit juga!
Dialogue: 0,0:03:44.45,0:03:46.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guncho Tsurara!
Dialogue: 0,0:03:46.28,0:03:47.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mengganggu!
Dialogue: 0,0:03:47.58,0:03:49.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bukanlah lawanku!
Dialogue: 0,0:03:52.00,0:03:54.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kamu lakukan, Zaraki?!
Dialogue: 0,0:03:54.25,0:03:56.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang seharusnya mengatakan itu!
Dialogue: 0,0:03:56.15,0:03:57.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ganggu!
Dialogue: 0,0:03:57.48,0:04:00.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua pergi saja ke tempat lain!
Dialogue: 0,0:04:00.38,0:04:01.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berengsek...
Dialogue: 0,0:04:01.90,0:04:02.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan.
Dialogue: 0,0:04:02.76,0:04:04.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma.
Dialogue: 0,0:04:04.11,0:04:08.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zaraki juga sama sepertinya,\Ntak bisa diajak bicara dengan logika.
Dialogue: 0,0:04:08.36,0:04:09.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu.
Dialogue: 0,0:04:09.90,0:04:13.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku juga tak bisa pergi\Nmeninggalkan Zaraki di sini.
Dialogue: 0,0:04:13.81,0:04:16.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bukan lawan yang bisa\NZaraki kalahkan sendirian.
Dialogue: 0,0:04:17.30,0:04:18.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat saja buktinya sendiri.
Dialogue: 0,0:04:19.35,0:04:23.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zaraki sudah melepas\Npenutup matanya sejak tadi.
Dialogue: 0,0:04:23.57,0:04:26.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Instingnya saja sudah paham
Dialogue: 0,0:04:26.65,0:04:30.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahwa lawannya tak bisa dikalahkan\Ntanpa membuka penutup mata.
Dialogue: 0,0:04:31.65,0:04:34.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembang esnya sudah banyak yang berguguran.
Dialogue: 0,0:04:35.39,0:04:38.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak aneh. Kami semua sudah kelelahan.
Dialogue: 0,0:04:39.38,0:04:42.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang sudah kehabisan waktu.
Dialogue: 0,0:04:42.39,0:04:43.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuchiki.
Dialogue: 0,0:04:44.08,0:04:47.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membekukan raksasa itu\Nsaat ada kesempatan.
Dialogue: 0,0:04:48.21,0:04:50.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong hancurkan dia dengan Senbonzakura.
Dialogue: 0,0:04:51.22,0:04:52.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari yang kurasakan sejauh ini,
Dialogue: 0,0:04:52.99,0:04:56.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku seharusnya bisa membekukannya\Nsampai ke tulang dengan daya maksimum.
Dialogue: 0,0:04:56.76,0:04:58.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Prosesnya butuh waktu.
Dialogue: 0,0:04:58.79,0:05:00.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong bantu aku.
Dialogue: 0,0:05:00.72,0:05:01.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengerti.
Dialogue: 0,0:05:06.40,0:05:10.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa? Daya serang pedangmu menurun!
Dialogue: 0,0:05:10.49,0:05:12.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, tidak heran.
Dialogue: 0,0:05:12.53,0:05:16.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil kamu bisa bertarung\Ntanpa membuat pedangku gompal!
Dialogue: 0,0:05:16.80,0:05:19.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang akan gompal saat bertarung,
Dialogue: 0,0:05:19.19,0:05:23.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu "keputusasaan" akan terukir\Ndi atas tubuhmu!
Dialogue: 0,0:05:24.35,0:05:25.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak tergoyahkan!
Dialogue: 0,0:05:25.80,0:05:27.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mentalmu sungguh sekuat baja!
Dialogue: 0,0:05:27.86,0:05:31.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, perbedaan kekuatan kita\Ntak bisa ditambal dengan mental baja!
Dialogue: 0,0:05:35.22,0:05:37.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa melihatmu, Kuchiki Byakuya!
Dialogue: 0,0:05:38.22,0:05:41.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu juga denganmu, Hitsugaya Toshiro!
Dialogue: 0,0:05:42.89,0:05:46.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua sedang\Nmenyusun rencana saat aku lengah.
Dialogue: 0,0:05:46.69,0:05:49.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku bisa lihat semuanya!
Dialogue: 0,0:05:49.25,0:05:53.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akulah Quincy terbesar,\Nterkuat, dan tercepat!
Dialogue: 0,0:05:53.40,0:05:56.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akulah pejuang yang mendapatkan segalanya!
Dialogue: 0,0:05:56.68,0:06:00.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan harap kalian bisa menjebakku!
Dialogue: 0,0:06:02.13,0:06:03.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang apa?
Dialogue: 0,0:06:05.43,0:06:06.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:06:06.84,0:06:09.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenchan sedang apa?
Dialogue: 0,0:06:12.16,0:06:13.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yachiru.
Dialogue: 0,0:06:13.89,0:06:15.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, bangun.
Dialogue: 0,0:06:15.46,0:06:19.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo lanjut lagi. Lanjutkan. Ayolah.
Dialogue: 0,0:06:20.36,0:06:22.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yachiru...?
Dialogue: 0,0:06:22.00,0:06:24.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu... Selama ini ada di mana...?
Dialogue: 0,0:06:24.18,0:06:25.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama Kenchan...
Dialogue: 0,0:06:25.76,0:06:28.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama Kenchan memakaiku dengan baik,
Dialogue: 0,0:06:28.41,0:06:31.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tak ada lawan yang tak bisa kamu tebas.
Dialogue: 0,0:06:36.03,0:06:39.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini? Apa yang baru saja kamu lakukan?
Dialogue: 0,0:06:39.86,0:06:41.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatannya...
Dialogue: 0,0:06:41.67,0:06:45.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayolah.\NKenchan ini benar-benar tidak tahu apa-apa.
Dialogue: 0,0:06:46.14,0:06:48.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama kekuatan itu adalah...
Dialogue: 0,0:06:49.39,0:06:51.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bankai.
Dialogue: 0,0:06:57.43,0:06:59.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu? Zaraki, ya?
Dialogue: 0,0:07:01.63,0:07:03.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reiatsu ini...
Dialogue: 0,0:07:03.05,0:07:05.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan ini milik Kapten Zaraki...?
Dialogue: 0,0:07:13.29,0:07:14.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:07:14.38,0:07:17.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, kulit Zaraki... merah pekat.
Dialogue: 0,0:07:18.02,0:07:21.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hmph. Peningkatan reiatsu secara drastis.
Dialogue: 0,0:07:21.56,0:07:25.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir Bankai,\Ntapi tak ada perubahan signifikan.
Dialogue: 0,0:07:25.28,0:07:27.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh mengecewakan!
Dialogue: 0,0:07:27.91,0:07:32.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin pedang patah itu wujud Bankai.
Dialogue: 0,0:07:32.75,0:07:35.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sungguh membosankan, Zaraki Kenpachi.
Dialogue: 0,0:07:35.95,0:07:37.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu dan pedang patahmu itu
Dialogue: 0,0:07:37.81,0:07:40.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan tak pantas mendapatkan\Nayunan dari Hoffnung.
Dialogue: 0,0:07:41.02,0:07:42.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hancur dan lenyaplah kau!
Dialogue: 0,0:07:56.95,0:07:58.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodohnya!
Dialogue: 0,0:07:58.41,0:08:01.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang percuma saja\Nmemutuskan lenganku!
Dialogue: 0,0:08:05.72,0:08:08.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak mungkin! Perisaiku...
Dialogue: 0,0:08:13.40,0:08:16.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Tak mungkin! Kekuatan macam apa itu?
Dialogue: 0,0:08:20.02,0:08:22.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan! Dia malah menjatuhkannya.
Dialogue: 0,0:08:25.17,0:08:26.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak mungkin.
Dialogue: 0,0:08:26.45,0:08:28.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak mungkin, tak mungkin, tak mungkin!
Dialogue: 0,0:08:28.80,0:08:32.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seorang shinigami mampu memojokkanku...!
Dialogue: 0,0:08:32.83,0:08:36.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak sudi mengakui omong kosong ini!
Dialogue: 0,0:08:37.90,0:08:40.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betapa bodohnya dirimu karena tidak kabur.
Dialogue: 0,0:08:40.37,0:08:42.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hancurlah kau menjadi abu!
Dialogue: 0,0:08:54.20,0:08:56.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Kapten berhasil?
Dialogue: 0,0:08:56.75,0:08:58.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mengerikan sekali.
Dialogue: 0,0:09:01.23,0:09:02.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mukjizat.
Dialogue: 0,0:09:04.16,0:09:05.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Hirako!
Dialogue: 0,0:09:07.26,0:09:08.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menolongmu sekarang!
Dialogue: 0,0:09:09.28,0:09:12.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Momo, abaikan saja aku.
Dialogue: 0,0:09:12.10,0:09:13.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong urus mereka saja.
Dialogue: 0,0:09:13.90,0:09:15.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:09:15.11,0:09:17.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuchiki, Abarai!
Dialogue: 0,0:09:18.10,0:09:21.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sana, kuserahkan padamu.
Dialogue: 0,0:09:31.63,0:09:32.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zara...
Dialogue: 0,0:09:33.46,0:09:37.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa menurutmu...\Nkita sebaiknya jangan mendekatinya?
Dialogue: 0,0:09:37.40,0:09:39.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dilihat dari mana pun,
Dialogue: 0,0:09:39.03,0:09:42.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia tampak lebih sulit\Ndiajak berkomunikasi daripada biasanya.
Dialogue: 0,0:09:46.17,0:09:46.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?!
Dialogue: 0,0:09:57.55,0:09:58.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:10:01.06,0:10:02.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan itu?
Dialogue: 0,0:10:06.42,0:10:07.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak mungkin!
Dialogue: 0,0:10:07.52,0:10:09.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar monster!
Dialogue: 0,0:10:30.94,0:10:32.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Celaka!
Dialogue: 0,0:10:33.65,0:10:35.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuchiki, Abarai!
Dialogue: 0,0:10:41.74,0:10:44.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah bagaimana,\Naku berhasil mencegah semuanya jatuh.
Dialogue: 0,0:10:52.81,0:10:54.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akulah "Aschtonig".
Dialogue: 0,0:10:54.96,0:10:58.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pejuang Dewa yang berbudi luhur.
Dialogue: 0,0:11:00.09,0:11:01.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan setelah diriku meninggal,
Dialogue: 0,0:11:01.70,0:11:04.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan tetap mengayunkan pedang\Ndemi sang Dewa!
Dialogue: 0,0:11:14.57,0:11:16.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Kenchan!
Dialogue: 0,0:11:16.11,0:11:18.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melepas terlalu banyak kekuatanmu.
Dialogue: 0,0:11:19.16,0:11:22.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya tubuhmu tak sanggup menahannya.
Dialogue: 0,0:11:29.14,0:11:30.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Za... Zaraki.
Dialogue: 0,0:11:31.87,0:11:33.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau masih bernapas, ya?!
Dialogue: 0,0:11:40.57,0:11:41.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuchiki.
Dialogue: 0,0:11:42.87,0:11:45.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lepaskan Bankai-mu, Kapten Hitsugaya.
Dialogue: 0,0:11:48.61,0:11:50.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah mencapai batasmu.
Dialogue: 0,0:11:50.77,0:11:53.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak. Masih belum.
Dialogue: 0,0:11:53.64,0:11:55.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Hitsugaya.
Dialogue: 0,0:11:58.18,0:12:01.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak ingat pernah mengatakan\Nbahwa saat seluruh kembang esnya gugur,
Dialogue: 0,0:12:02.26,0:12:04.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maka semuanya akan berakhir.
Dialogue: 0,0:12:05.19,0:12:07.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah seluruh kembang esnya gugur...
Dialogue: 0,0:12:08.78,0:12:10.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di saat itu pula...
Dialogue: 0,0:12:11.25,0:12:14.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daiguren Hyorinmaru berhasil disempurnakan.
Dialogue: 0,0:12:24.46,0:12:27.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatanku masih belum cukup
Dialogue: 0,0:12:27.81,0:12:30.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menggunakan seluruh potensi Hyorinmaru.
Dialogue: 0,0:12:30.87,0:12:33.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin itu juga alasannya...
Dialogue: 0,0:12:33.00,0:12:37.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat Daiguren Hyorinmaru sempurna, aku akan
Dialogue: 0,0:12:39.63,0:12:41.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tumbuh sedikit lebih dewasa.
Dialogue: 0,0:12:41.90,0:12:45.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya aku tak terlalu suka wujud ini.
Dialogue: 0,0:12:46.78,0:12:49.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kau?
Dialogue: 0,0:12:49.76,0:12:52.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hitsugaya Toshiro.
Dialogue: 0,0:12:52.04,0:12:53.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bankai, ya?
Dialogue: 0,0:12:53.61,0:12:57.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, seharusnya kamu sudah\Nmemakai Bankai milikmu.
Dialogue: 0,0:12:57.04,0:13:00.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa berubah sekali lagi?
Dialogue: 0,0:13:00.06,0:13:02.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, tidak terlalu penting!
Dialogue: 0,0:13:04.55,0:13:07.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibandingkan dengan dirimu yang sebelumnya,
Dialogue: 0,0:13:07.19,0:13:11.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu yang sekarang lebih pantas\Nbertarung melawanku!
Dialogue: 0,0:13:11.10,0:13:12.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ya?
Dialogue: 0,0:13:12.27,0:13:15.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu malah kabur setelah berubah, ya?
Dialogue: 0,0:13:24.88,0:13:27.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan melempar benda sebesar itu.
Dialogue: 0,0:13:27.65,0:13:30.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kan sudah bilang bakal repot\Nkalau sampai jatuh ke Seireitei.
Dialogue: 0,0:13:33.03,0:13:35.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodohnya! Apa kamu sudah lupa?
Dialogue: 0,0:13:35.38,0:13:37.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika Hoffnung terluka...
Dialogue: 0,0:13:37.25,0:13:41.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat dibekukan,\Nfungsi benda mana pun akan mati.
Dialogue: 0,0:13:47.64,0:13:51.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fungsi "harapan"-mu itu sudah kumatikan, lo.
Dialogue: 0,0:13:51.52,0:13:53.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:13:53.10,0:13:54.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:13:55.56,0:13:58.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuhancurkan kau dengan luapan kekuatan
Dialogue: 0,0:13:58.65,0:14:02.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang masih berada dalam jangkauan manusia!
Dialogue: 0,0:14:02.32,0:14:04.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Busur Quincy, ya.
Dialogue: 0,0:14:05.01,0:14:08.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu agak terlambat.
Dialogue: 0,0:14:08.86,0:14:10.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shikai Hyouketsu.
Dialogue: 0,0:14:10.97,0:14:13.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah menggunakan Daiguren Hyorinmaru,
Dialogue: 0,0:14:13.52,0:14:16.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}segala sesuatu yang kupijak\Ndalam empat langkah...
Dialogue: 0,0:14:16.48,0:14:19.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanah, air, api, dan angin,\Nsemuanya akan membeku.
Dialogue: 0,0:14:19.54,0:14:23.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau saja kamu menembakkan\Npanah Quincy dalam tiga langkah,
Dialogue: 0,0:14:23.21,0:14:25.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin kamu masih bisa menembus tubuhku.
Dialogue: 0,0:14:30.98,0:14:34.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takkan membeku,\Nkarena akulah pejuang sang Dewa!
Dialogue: 0,0:14:34.60,0:14:38.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya aku tak terjebak\Ndalam konsep empat elemen di dunia ini.
Dialogue: 0,0:14:39.43,0:14:42.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keparat, akan kuremukkan seluruh tubuhmu itu!
Dialogue: 0,0:14:43.82,0:14:45.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa...?!
Dialogue: 0,0:14:49.20,0:14:53.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zaraki, rupanya kau yang sudah\Nmembuat kakiku...!
Dialogue: 0,0:14:55.99,0:15:00.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pikir kamu akan baik-baik saja\Nsetelah menyentuhku dalam wujud ini?
Dialogue: 0,0:15:00.50,0:15:04.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kubilang aku tak bisa beku, Shinigami!
Dialogue: 0,0:15:09.13,0:15:12.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senkei: Senbonzakura Kageyoshi.
Dialogue: 0,0:15:15.89,0:15:19.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ougi: Ikka Senjinka.
Dialogue: 0,0:15:40.61,0:15:41.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuchiki.
Dialogue: 0,0:15:42.16,0:15:46.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya itu Bankai\Nyang sangat membebani tubuh.
Dialogue: 0,0:15:46.03,0:15:48.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bertahan lebih lama daripada dugaanku.
Dialogue: 0,0:15:49.06,0:15:51.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Prediksimu tepat sasaran.
Dialogue: 0,0:15:51.00,0:15:53.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang sudah mendekati batasku.
Dialogue: 0,0:15:54.69,0:15:55.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:15:59.22,0:16:02.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia... masih hidup?
Dialogue: 0,0:16:08.69,0:16:10.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa-apaan itu?
Dialogue: 0,0:16:13.28,0:16:16.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rupanya kalian masih hidup, Kuchiki, Abarai!
Dialogue: 0,0:16:16.53,0:16:20.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia adalah wujud terakhir musuh\Nyang kalian lawan tadi!
Dialogue: 0,0:16:20.15,0:16:22.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia monster, hati-hati!
Dialogue: 0,0:16:22.96,0:16:24.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si... Siapa kau?!
Dialogue: 0,0:16:24.88,0:16:27.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh! Masa kamu tidak kenal suaranya?
Dialogue: 0,0:16:27.56,0:16:30.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mungkin kakaknya Kapten Hitsugaya!
Dialogue: 0,0:16:30.18,0:16:32.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masuk akal.\NSenang bertemu denganmu!
Dialogue: 0,0:16:32.18,0:16:34.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, benar. Salam kenal juga.
Dialogue: 0,0:16:34.78,0:16:35.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menimpali.
Dialogue: 0,0:16:37.17,0:16:39.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memutar lewat sana, Renji!
Dialogue: 0,0:16:39.63,0:16:40.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke!
Dialogue: 0,0:16:42.06,0:16:42.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh!
Dialogue: 0,0:16:44.86,0:16:46.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Renji, Rukia.
Dialogue: 0,0:16:46.99,0:16:49.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua pergilah\Nke tempat Kurosaki Ichigo.
Dialogue: 0,0:16:50.03,0:16:51.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, Kakak...!
Dialogue: 0,0:16:51.91,0:16:53.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat saja reiatsu-nya.
Dialogue: 0,0:16:53.69,0:16:56.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti yang bisa kalian berdua rasakan,
Dialogue: 0,0:16:56.01,0:16:58.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia sudah berhadapan dengan Yhwach.
Dialogue: 0,0:17:00.71,0:17:02.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Me-Meski begitu...
Dialogue: 0,0:17:02.40,0:17:04.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa masih ragu?
Dialogue: 0,0:17:04.00,0:17:05.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan besar kepala.
Dialogue: 0,0:17:08.20,0:17:12.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan bilang Kurosaki\Nbutuh kekuatan kalian.
Dialogue: 0,0:17:12.67,0:17:17.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku adalah kekuatan kalian\Ntak dibutuhkan di tempat ini.
Dialogue: 0,0:17:18.74,0:17:20.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sudah paham, pergilah.
Dialogue: 0,0:17:20.93,0:17:23.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap! Terima kasih banyak!
Dialogue: 0,0:17:26.35,0:17:28.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang kembali.
Dialogue: 0,0:17:28.06,0:17:31.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka menyadari kebaikan hatimu, lo.
Dialogue: 0,0:17:32.10,0:17:35.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang sengaja ingin mereka sadar.
Dialogue: 0,0:17:35.80,0:17:37.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu...
Dialogue: 0,0:17:37.85,0:17:39.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu keputusan yang bijak.
Dialogue: 0,0:17:40.16,0:17:43.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berdua harus pergi\Nke tempat Kurosaki.
Dialogue: 0,0:17:44.21,0:17:47.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak tahu kamu pernah belajar\Ndi Akademi Reijutsu atau tidak...
Dialogue: 0,0:17:48.18,0:17:50.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di Akademi Reijutsu
Dialogue: 0,0:17:50.05,0:17:54.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mentorku tak mengajariku\Nbertarung demi keluarga.
Dialogue: 0,0:17:54.72,0:17:57.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shinigami, semuanya tanpa kecuali,
Dialogue: 0,0:17:57.43,0:18:00.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harus mati melindungi kawan dan manusia.
Dialogue: 0,0:18:02.72,0:18:05.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita dan Kurosaki memang teman,
Dialogue: 0,0:18:05.73,0:18:07.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi mereka berdua
Dialogue: 0,0:18:07.14,0:18:10.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kawannya Kurosaki Ichigo.
Dialogue: 0,0:18:10.36,0:18:12.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika harus bertarung sebagai shinigami,
Dialogue: 0,0:18:12.91,0:18:16.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah benar mengirim mereka\Nke tempat Kurosaki.
Dialogue: 0,0:18:16.86,0:18:19.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Neraca benar dan salah, ya.
Dialogue: 0,0:18:19.60,0:18:22.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengajaran yang khas shinigami.
Dialogue: 0,0:18:22.12,0:18:24.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau benar dan salahnya terbalik,
Dialogue: 0,0:18:24.21,0:18:27.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pada akhirnya,\Nmereka berdua akan tetap pergi.
Dialogue: 0,0:19:54.65,0:19:59.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bleach:\NThousand-Year Blood War - The Calamity
Dialogue: 0,0:19:59.96,0:20:03.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siklus jiwanya mulai tidak stabil!
Dialogue: 0,0:20:04.56,0:20:06.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dibiarkan saja...
Dialogue: 0,0:20:12.86,0:20:15.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hollow tumpah ke dunia nyata!
Dialogue: 0,0:20:15.45,0:20:18.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sudah disibukkan monster burung itu!
Dialogue: 0,0:20:18.28,0:20:20.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang bisa ke dunia nyata sekarang...
Dialogue: 0,0:20:22.61,0:20:26.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Izinkan aku pergi!
Dialogue: 0,0:20:26.03,0:20:29.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada awalnya, Kota Karakura\Nberada di bawah tanggung jawab kami.
Dialogue: 0,0:20:29.29,0:20:32.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melindungi orang-orang yang tinggal di sana
Dialogue: 0,0:20:33.10,0:20:35.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah kewajiban kami.
Dialogue: 0,0:20:35.67,0:20:38.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski aku tak tahu bisa\Nberbuat seberapa banyak...
Dialogue: 0,0:20:39.40,0:20:41.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu... Sebisa mungkin...
Dialogue: 0,0:20:41.86,0:20:44.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sakit! Tolong jangan main pukul, Shino!
Dialogue: 0,0:20:44.97,0:20:46.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beranikan dirimu!
Dialogue: 0,0:20:46.48,0:20:48.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sudah bilang ingin melakukannya,
Dialogue: 0,0:20:48.18,0:20:51.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maka lakukan sampai akhir\Ndengan percaya diri, Ryuunosuke!
Dialogue: 0,0:20:53.23,0:20:55.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak sendirian.
Dialogue: 0,0:20:55.15,0:20:57.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski emosimu mengerucut 100 kali,
Dialogue: 0,0:20:57.58,0:21:00.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan memukul punggungmu\Nsebanyak 101 kali.
Dialogue: 0,0:21:02.15,0:21:04.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shino...
Dialogue: 0,0:21:04.45,0:21:05.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelebihan satu kali.
Dialogue: 0,0:21:05.62,0:21:07.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Argh! Berisik, berisik.
Dialogue: 0,0:21:13.68,0:21:15.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wakil Kapten Okikiba.
Dialogue: 0,0:21:21.60,0:21:23.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo lindungi.
Dialogue: 0,0:21:23.28,0:21:24.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersama-sama!
Dialogue: 0,0:21:24.29,0:21:25.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:21:29.77,0:21:33.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya. Ternyata itu yang kamu incar.
Dialogue: 0,0:21:53.16,0:21:55.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ku-Kurosaki...?
Dialogue: 0,0:21:55.58,0:21:56.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:22:06.19,0:22:09.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja, Inoue. Aku masih "aku".
Dialogue: 0,0:22:12.04,0:22:14.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu terlihat seperti Hollow.
Dialogue: 0,0:22:14.87,0:22:19.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu wujud Hollow yang telah\Nmenyatu dengan kekuatanmu?
Dialogue: 0,0:22:19.93,0:22:20.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:22:21.96,0:22:25.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, karena sudah menyatu\Ndengan kekuatanku,
Dialogue: 0,0:22:25.39,0:22:28.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan lebih baik jika aku bisa\Nmengaktifkan dan menonaktifkannya sendiri.
Dialogue: 0,0:22:29.20,0:22:31.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku belum bisa\Nmengendalikannya sepenuhnya.
Dialogue: 0,0:22:32.11,0:22:33.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi aku
Dialogue: 0,0:22:33.63,0:22:35.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memanfaatkan kekuatanmu.
Dialogue: 0,0:22:38.43,0:22:41.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kapan Kurosaki ada di depan Rikka?
Dialogue: 0,0:22:41.89,0:22:44.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inoue, mundurlah dari tempat itu.
Dialogue: 0,0:22:44.95,0:22:46.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin memperluasnya sedikit.
Dialogue: 0,0:22:47.31,0:22:48.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:22:54.66,0:22:57.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan yang menakjubkan.
Dialogue: 0,0:22:57.48,0:22:58.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:22:58.83,0:23:02.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menghunus pedang saat menghadapimu.
Dialogue: 0,0:23:08.82,0:23:10.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lemah.
Dialogue: 0,0:23:10.82,0:23:13.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pikir bisa membunuhku\Ndengan serangan ini?
Dialogue: 0,0:23:15.68,0:23:17.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Getsuga Tensho, ya.
Dialogue: 0,0:23:17.76,0:23:20.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hasilnya akan sama saja.
Dialogue: 0,0:23:22.90,0:23:26.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan. Itu bukan Getsuga Tensho.
Dialogue: 0,0:23:26.07,0:23:28.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu adalah Getsuga Tensho
Dialogue: 0,0:23:28.72,0:23:30.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang dicampur ke dalam Gran Rey Cero.
Dialogue: 0,0:23:35.88,0:23:37.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak mampu berbuat apa pun
Dialogue: 0,0:23:38.17,0:23:41.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya menginginkan kekuatan
Dialogue: 0,0:23:42.20,0:23:45.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melindungi — kekuatan yang mampu melakukannya
