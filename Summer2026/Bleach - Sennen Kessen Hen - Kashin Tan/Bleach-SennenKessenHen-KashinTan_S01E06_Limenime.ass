Dialogue: 0,0:09:19.07,0:09:22.37,sign,,0000,0000,0000,,MENDETEKSI ANOMALI
Dialogue: 0,0:10:03.24,0:10:06.00,sign,,0000,0000,0000,,PERINGATAN
Dialogue: 0,0:19:46.58,0:19:49.58,sign,,0000,0000,0000,,AKHIR
Dialogue: 0,0:23:48.28,0:23:50.20,sign,,0000,0000,0000,,AKHIR 2
Dialogue: 0,0:00:20.12,0:00:21.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Air mata?
Dialogue: 0,0:00:29.68,0:00:32.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, oi. Apa yang terjadi di tempat ini?
Dialogue: 0,0:00:32.11,0:00:33.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana Inoue?
Dialogue: 0,0:00:34.10,0:00:35.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inoue, dia...
Dialogue: 0,0:00:35.70,0:00:40.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengorbankan jiwanya untuk melenyapkan Yhwach.
Dialogue: 0,0:00:45.75,0:00:46.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak apa-apa?
Dialogue: 0,0:00:47.07,0:00:47.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:00:50.96,0:00:53.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inoue telah mempertaruhkan segalanya
Dialogue: 0,0:00:54.38,0:00:56.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar kita semua bisa bertahan.
Dialogue: 0,0:00:58.23,0:00:59.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ichigo...
Dialogue: 0,0:00:59.85,0:01:02.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, dunia sudah aman, 'kan?
Dialogue: 0,0:01:05.58,0:01:06.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum.
Dialogue: 0,0:01:06.58,0:01:07.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:01:34.70,0:01:36.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ichigo, kamu...!
Dialogue: 0,0:01:37.21,0:01:39.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau apa?!
Dialogue: 0,0:01:40.97,0:01:41.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ichigo?
Dialogue: 0,0:01:43.03,0:01:44.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Osho sialan itu, ya!
Dialogue: 0,0:01:48.59,0:01:49.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ichigo!
Dialogue: 0,0:01:52.19,0:01:53.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar bodoh.
Dialogue: 0,0:02:04.85,0:02:05.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:02:07.75,0:02:11.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu membelakangi aku?
Dialogue: 0,0:02:32.37,0:02:34.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inoue...?
Dialogue: 0,0:02:41.15,0:02:42.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah pagi.
Dialogue: 0,0:02:43.18,0:02:44.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Haschwalth.
Dialogue: 0,0:02:45.17,0:02:47.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batas waktu telah berakhir.
Dialogue: 0,0:03:01.24,0:03:03.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}The Almighty.
Dialogue: 0,0:03:10.59,0:03:12.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yhwach...
Dialogue: 0,0:03:13.30,0:03:14.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu ada di sini?
Dialogue: 0,0:03:15.25,0:03:16.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu...
Dialogue: 0,0:03:16.08,0:03:18.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sedang membicarakan apa?
Dialogue: 0,0:03:19.41,0:03:23.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa depan itu tidak pernah ada.
Dialogue: 0,0:04:50.68,0:04:54.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bleach:\NThousand-Year Blood War - The Calamity
Dialogue: 0,0:04:55.89,0:05:00.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar jika kamu tidak sadar karena tak ada cahaya\Nyang mencapai dasar Wahrwelt.
Dialogue: 0,0:05:01.18,0:05:04.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tepat sebelum kamu mengaktifkan\NLeiden Hant,
Dialogue: 0,0:05:04.68,0:05:07.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kekuatanku dan Yang Mulia telah bertukar tempat.
Dialogue: 0,0:05:08.00,0:05:08.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu...
Dialogue: 0,0:05:09.27,0:05:12.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibandingkan kekuatan Yang Mulia,\Nkekuatanku sendiri
Dialogue: 0,0:05:12.64,0:05:14.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jauh lebih cocok untuk bertarung.
Dialogue: 0,0:05:15.13,0:05:16.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terutama saat melawan orang sepertimu.
Dialogue: 0,0:05:17.00,0:05:19.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang kesalahannya harus diperbaiki.
Dialogue: 0,0:05:21.24,0:05:22.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Timbangan telah bergerak.
Dialogue: 0,0:05:24.45,0:05:26.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya kabar baik untukmu.
Dialogue: 0,0:05:27.22,0:05:29.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, hal yang membuat\N"The Almighty" menyeramkan
Dialogue: 0,0:05:30.14,0:05:32.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukanlah "bisa melihat masa depan".
Dialogue: 0,0:05:32.68,0:05:33.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu...?
Dialogue: 0,0:05:34.16,0:05:36.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuberi tahu saat pertarungan kita berakhir.
Dialogue: 0,0:05:37.70,0:05:38.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah.
Dialogue: 0,0:05:38.85,0:05:41.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertaruhkanlah segalanya\Nke atas timbangan, Ishida Uryuu!
Dialogue: 0,0:05:42.21,0:05:44.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan timbanganmu yang telah patah itu
Dialogue: 0,0:05:44.62,0:05:46.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terus menunjukkan jalan\Ntanpa jalan kembali!
Dialogue: 0,0:05:51.88,0:05:52.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teman-teman!
Dialogue: 0,0:06:00.26,0:06:03.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pikir pedang ganda\Nhanya kelebihan milikmu?
Dialogue: 0,0:06:04.17,0:06:08.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sedang mencari\Ntitik kelemahan kekuatanku, ya?
Dialogue: 0,0:06:11.03,0:06:12.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ichigo.
Dialogue: 0,0:06:12.67,0:06:14.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu salah paham tentang sesuatu.
Dialogue: 0,0:06:15.59,0:06:19.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa depan tidak berada di atas jalan tunggal.
Dialogue: 0,0:06:20.82,0:06:22.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa depan itu
Dialogue: 0,0:06:22.15,0:06:27.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagaikan butiran pasir yang tak terhitung,\Nterbentang di hadapan kita.
Dialogue: 0,0:06:28.10,0:06:30.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sekilas terlihat berserakan,
Dialogue: 0,0:06:30.79,0:06:34.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tiap butir pasir yang tak terhitung jumlahnya itu
Dialogue: 0,0:06:34.59,0:06:35.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah "masa depan".
Dialogue: 0,0:06:36.75,0:06:40.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ia juga bisa disebut "kemungkinan"\Nyang tak terhitung jumlahnya.
Dialogue: 0,0:06:41.27,0:06:42.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ichigo.
Dialogue: 0,0:06:42.44,0:06:45.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka membicarakan "harapan".
Dialogue: 0,0:06:47.13,0:06:48.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Masa depan bisa diubah",
Dialogue: 0,0:06:48.85,0:06:50.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu memang kenyataan.
Dialogue: 0,0:06:50.98,0:06:54.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenyataan indah yang dipenuhi "harapan".
Dialogue: 0,0:06:54.76,0:06:57.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, "mengubah masa depan"
Dialogue: 0,0:06:57.13,0:07:02.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya berpindah\Ndari satu butiran pasir ke butiran selanjutnya.
Dialogue: 0,0:07:02.74,0:07:06.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, aku dapat melihat seluruh butiran pasir itu
Dialogue: 0,0:07:06.41,0:07:09.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari tempat yang jauh lebih tinggi,\Ndan memengaruhi isinya.
Dialogue: 0,0:07:11.12,0:07:15.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"The Almighty" bukan\Nkekuatan untuk "melihat masa depan",
Dialogue: 0,0:07:16.06,0:07:18.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kekuatan untuk "memodifikasi masa depan".
Dialogue: 0,0:07:23.03,0:07:23.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inoue!
Dialogue: 0,0:07:27.69,0:07:29.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya...
Dialogue: 0,0:07:31.67,0:07:32.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Ichigo.
Dialogue: 0,0:07:33.23,0:07:35.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak bisa melindungimu.
Dialogue: 0,0:07:35.92,0:07:38.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu adalah masa depan milik perempuan itu.
Dialogue: 0,0:07:39.41,0:07:42.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akulah yang modifikasi\Nhingga seperti itu.
Dialogue: 0,0:07:42.88,0:07:45.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ichigo, teruslah menggenggam harapan.
Dialogue: 0,0:07:46.19,0:07:47.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama seperti selama ini,
Dialogue: 0,0:07:47.54,0:07:52.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}teruslah melompat dan berpindah\Nke atas gulungan butiran pasir
Dialogue: 0,0:07:52.59,0:07:56.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang disebut "takdir" atau "kemungkinan"\Ndengan mata tertutup.
Dialogue: 0,0:07:57.10,0:08:00.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah "harapan" bagi manusia.
Dialogue: 0,0:08:01.21,0:08:04.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang berjalan di atas sebuah timbangan.
Dialogue: 0,0:08:05.50,0:08:10.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menentukan batas antara benar\Ndan salah menurut mereka.
Dialogue: 0,0:08:10.76,0:08:15.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemudian, kepingan benar dan salah itu\Nsaling bertumpuk, membentuk manusia.
Dialogue: 0,0:08:16.81,0:08:18.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu adalah dirimu sendiri.
Dialogue: 0,0:08:20.46,0:08:22.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin kamu juga melakukan hal yang sama.
Dialogue: 0,0:08:22.62,0:08:23.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ishida Uryuu.
Dialogue: 0,0:08:25.17,0:08:27.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa melihat wujudmu.
Dialogue: 0,0:08:28.35,0:08:32.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wujud yang seharusnya lahir\Nsetelah kamu menaruh sesuatu
Dialogue: 0,0:08:32.44,0:08:34.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di atas timbangan dan memilih.
Dialogue: 0,0:08:35.62,0:08:38.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa sebenarnya kamu, Ishida Uryuu?
Dialogue: 0,0:08:40.48,0:08:43.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mempertaruhkan nyawa\Ndemi orang-orang dangkal itu
Dialogue: 0,0:08:43.53,0:08:47.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah hal yang kamu inginkan?
Dialogue: 0,0:08:48.00,0:08:49.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Basa-basimu panjang sekali.
Dialogue: 0,0:08:50.97,0:08:54.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tanya, siapa aku?
Dialogue: 0,0:08:55.87,0:08:59.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana bisa aku...\Nmenjawab pertanyaan itu...?
Dialogue: 0,0:09:06.18,0:09:07.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagiku, jawaban dari pertanyaan itu
Dialogue: 0,0:09:08.30,0:09:12.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}baru kudapatkan setelah\Nmengalahkan kalian semua!
Dialogue: 0,0:09:13.26,0:09:14.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:09:19.07,0:09:21.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Angka invasi di perbatasan meningkat drastis!
Dialogue: 0,0:09:21.28,0:09:22.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak berhenti sama sekali!
Dialogue: 0,0:09:23.53,0:09:25.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sebenarnya para Quincy ingin lakukan?!
Dialogue: 0,0:09:25.57,0:09:26.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia bisa hancur!
Dialogue: 0,0:09:27.36,0:09:31.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku coba menabrakkan reishi melalui Garganta,
Dialogue: 0,0:09:31.24,0:09:34.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ia sempat mengecil dalam sekejap\Nsebelum kembali seperti semula.
Dialogue: 0,0:09:34.64,0:09:36.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ia mengecil meski hanya sekejap, 'kan?
Dialogue: 0,0:09:37.03,0:09:38.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, tapi jangan berharap banyak.
Dialogue: 0,0:09:38.87,0:09:41.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau meningkatkan efeknya,\Ntarget harus sampai dihancurkan.
Dialogue: 0,0:09:42.42,0:09:46.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu, satu-satunya cara adalah\Nmenabrakkan energi yang setara dengannya?
Dialogue: 0,0:09:46.46,0:09:48.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari mana kita bisa dapat energi sebesar itu?
Dialogue: 0,0:09:48.93,0:09:51.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kalian tahu, kita tidak akan susah!
Dialogue: 0,0:09:52.31,0:09:54.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah usahakan semua yang kubisa.
Dialogue: 0,0:09:54.47,0:09:55.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana, Akon?
Dialogue: 0,0:09:56.50,0:10:02.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Distorsi ini meluas karena keseimbangan jiwa\Ndi dunia nyata dan Soul Society hancur, 'kan?
Dialogue: 0,0:10:03.24,0:10:04.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:10:04.42,0:10:06.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa malah bahas itu lagi sekarang?
Dialogue: 0,0:10:07.30,0:10:09.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita, Seireitei,\Nyang menyeimbangkannya?
Dialogue: 0,0:10:09.99,0:10:10.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:10:14.73,0:10:16.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan buka gerbang menuju Hueco Mundo.
Dialogue: 0,0:10:17.90,0:10:20.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga boleh tanya satu hal?
Dialogue: 0,0:10:21.08,0:10:24.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu bertanya orang seperti apakah aku?
Dialogue: 0,0:10:25.55,0:10:27.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada menanyakan hal seperti itu,
Dialogue: 0,0:10:28.10,0:10:30.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukankah lebih baik kalahkan aku\Nsatu detik lebih cepat
Dialogue: 0,0:10:30.33,0:10:33.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan segera pergi menyusul ke tempat Yhwach?
Dialogue: 0,0:10:34.34,0:10:35.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka akan mati.
Dialogue: 0,0:10:36.51,0:10:39.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak peduli berapa lama\Naku bermain-main denganmu,
Dialogue: 0,0:10:39.64,0:10:42.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia takkan pernah\Nberada dalam bahaya.
Dialogue: 0,0:10:58.45,0:11:00.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu beruntung, Ishida Uryuu.
Dialogue: 0,0:11:01.72,0:11:04.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu berhasil memasangkan\N"Leiden Hant" pada tanganku,
Dialogue: 0,0:11:04.92,0:11:08.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menembakkan Heilig Pfeil\Nyang tak terhitung jumlahnya.
Dialogue: 0,0:11:08.44,0:11:11.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keberuntungan itu akan kembali kepadamu
Dialogue: 0,0:11:11.40,0:11:12.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dalam bentuk kemalangan rekanmu.
Dialogue: 0,0:11:15.72,0:11:17.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Schrift-ku adalah "B".
Dialogue: 0,0:11:18.42,0:11:19.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"The Balance".
Dialogue: 0,0:11:20.51,0:11:24.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menjaga keseimbangan dunia di sekitar\Ndengan membagikan kemalangan
Dialogue: 0,0:11:24.87,0:11:26.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kepada mereka yang diliputi keberuntungan.
Dialogue: 0,0:11:27.74,0:11:30.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak mungkin menang, Ishida Uryuu.
Dialogue: 0,0:11:31.12,0:11:33.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya tidak ada hal\Nyang perlu kutanyakan lagi padamu.
Dialogue: 0,0:11:34.76,0:11:36.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tak ingin bicara lagi, ya sudah.
Dialogue: 0,0:11:37.45,0:11:38.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah akhirnya.
Dialogue: 0,0:11:38.75,0:11:39.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu.
Dialogue: 0,0:11:40.05,0:11:42.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya kamu tidak mau lihat?
Dialogue: 0,0:11:43.01,0:11:45.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Schrift-ku.
Dialogue: 0,0:11:46.18,0:11:47.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perpanjangan hidup yang sia-sia.
Dialogue: 0,0:11:48.35,0:11:51.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu bisa menang dengan itu,\Npasti sudah kamu pakai sejak tadi.
Dialogue: 0,0:11:52.38,0:11:53.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru kebalikannya.
Dialogue: 0,0:11:54.49,0:11:56.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir ini waktu yang tepat...
Dialogue: 0,0:11:57.49,0:11:59.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:11:59.39,0:12:02.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Schrift-ku adalah "A".
Dialogue: 0,0:12:02.82,0:12:04.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Antithesis".
Dialogue: 0,0:12:06.55,0:12:08.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Antithesis",
Dialogue: 0,0:12:08.57,0:12:13.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"membalikkan peristiwa yang telah terjadi"\Ndi antara dua titik yang telah ditentukan.
Dialogue: 0,0:12:14.54,0:12:16.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini simpel saja.
Dialogue: 0,0:12:16.17,0:12:19.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku "membalikkan luka" yang tubuh kita terima.
Dialogue: 0,0:12:20.12,0:12:21.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:12:25.30,0:12:27.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan yang luar biasa.
Dialogue: 0,0:12:29.61,0:12:32.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas saja Yang Mulia\Nmenaruh perhatian padamu.
Dialogue: 0,0:12:33.34,0:12:36.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kekuatan itu membalikkan\Nperistiwa yang telah terjadi,
Dialogue: 0,0:12:36.24,0:12:41.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin hanya kamu yang mampu\Nmelawan kekuatan Yang Mulia.
Dialogue: 0,0:12:41.70,0:12:43.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:12:43.61,0:12:47.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sedang membicarakan\Nkekuatan "The Almighty" yang sesungguhnya?
Dialogue: 0,0:12:48.05,0:12:50.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bebas menyimpulkan kalimatku.
Dialogue: 0,0:12:50.83,0:12:52.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya bisa berkata...
Dialogue: 0,0:12:52.73,0:12:57.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata menahanmu di tempat ini\Nadalah keputusan yang tepat.
Dialogue: 0,0:12:58.60,0:13:00.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan harap kamu bisa pergi.
Dialogue: 0,0:13:02.16,0:13:04.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Antithesis"-mu memang luar biasa.
Dialogue: 0,0:13:04.98,0:13:07.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ia tidak cocok melawan\N"The Balance"-ku.
Dialogue: 0,0:13:08.86,0:13:10.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bilang.
Dialogue: 0,0:13:10.53,0:13:12.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa membagikan "kemalangan".
Dialogue: 0,0:13:12.86,0:13:16.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, "seluruh kemalangan" yang menimpa tubuhku
Dialogue: 0,0:13:16.35,0:13:19.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dapat diterima oleh Freund Schild ini.
Dialogue: 0,0:13:19.96,0:13:21.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Singkatnya seperti ini.
Dialogue: 0,0:13:22.02,0:13:24.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Keberuntungan" yang membuatmu\Nbisa melukaiku
Dialogue: 0,0:13:25.11,0:13:27.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan kembali kepadamu sebagai\N"kemalangan" rekan.
Dialogue: 0,0:13:28.36,0:13:30.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sementara "kemalangan" yang menimpa tubuhku
Dialogue: 0,0:13:31.14,0:13:33.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan berpindah ke atas Freund Schild ini,
Dialogue: 0,0:13:34.55,0:13:37.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan ikut kembali padamu\Ndalam bentuk "kemalangan".
Dialogue: 0,0:13:39.19,0:13:41.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bilang\Nkamu tidak mungkin menang.
Dialogue: 0,0:13:41.71,0:13:42.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ishida Uryuu.
Dialogue: 0,0:13:48.39,0:13:50.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih belum menyerah juga.
Dialogue: 0,0:13:51.20,0:13:53.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pria yang cerdas.
Dialogue: 0,0:13:53.80,0:13:57.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya kamu paham\Nkamu bukanlah tandinganku, atau Yang Mulia.
Dialogue: 0,0:13:59.80,0:14:02.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah bilang tak bisa melihat wujudmu,
Dialogue: 0,0:14:02.58,0:14:03.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sekarang aku tarik kembali.
Dialogue: 0,0:14:04.25,0:14:08.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar-benar mirip dengan orang-orang
Dialogue: 0,0:14:08.77,0:14:10.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang bodohnya bukan main itu.
Dialogue: 0,0:14:11.95,0:14:14.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sama sekali tak paham.
Dialogue: 0,0:14:14.47,0:14:20.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia baru yang kuimpikan\Nsama seperti dunia yang perempuan itu idamkan.
Dialogue: 0,0:14:21.86,0:14:23.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa pertarungan,
Dialogue: 0,0:14:23.50,0:14:26.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tak ada rasa sakit, kebencian, dan kesedihan.
Dialogue: 0,0:14:26.70,0:14:28.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia yang damai.
Dialogue: 0,0:14:29.02,0:14:33.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah dunia baru yang kuidamkan.
Dialogue: 0,0:14:34.21,0:14:37.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ichigo, kamu terlihat berputus asa.
Dialogue: 0,0:14:37.59,0:14:40.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang lebih menyakitkan bagi orang tua
Dialogue: 0,0:14:40.52,0:14:44.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selain membunuh putranya yang berputus asa.
Dialogue: 0,0:14:47.76,0:14:49.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu masih bisa bergerak?
Dialogue: 0,0:14:50.18,0:14:51.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bilang...
Dialogue: 0,0:14:53.11,0:14:55.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mirip dengan Kurosaki dan yang lain?
Dialogue: 0,0:14:55.98,0:14:57.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama ini, aku...
Dialogue: 0,0:14:58.09,0:15:00.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selalu bertindak dengan kepala dingin...
Dialogue: 0,0:15:00.18,0:15:04.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menimbang semuanya dengan timbangan\Nyang kamu sebut tadi.
Dialogue: 0,0:15:05.60,0:15:09.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi Kurosaki itu bodoh,\Ndia tak bisa lakukan itu.
Dialogue: 0,0:15:10.58,0:15:13.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat sudah memutuskan untuk menolong,\Ndia akan pergi menolong.
Dialogue: 0,0:15:15.08,0:15:17.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa bodoh dengan arah timbangan.
Dialogue: 0,0:15:18.17,0:15:20.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bahkan tidak melihat ke arah timbangan.
Dialogue: 0,0:15:21.96,0:15:23.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inoue juga bodoh.
Dialogue: 0,0:15:23.88,0:15:25.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sado juga bodoh.
Dialogue: 0,0:15:25.58,0:15:27.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuchiki juga bodoh.
Dialogue: 0,0:15:27.39,0:15:28.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abarai juga bodoh.
Dialogue: 0,0:15:31.14,0:15:35.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku terlihat mirip\Ndengan orang-orang bodoh itu...
Dialogue: 0,0:15:36.85,0:15:38.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang.
Dialogue: 0,0:15:39.63,0:15:40.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham sekarang.
Dialogue: 0,0:15:41.02,0:15:44.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu takut pada "harapan"\Ndan "keputusasaan", ya.
Dialogue: 0,0:15:46.20,0:15:48.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Disebut mahakuasa dan mahamengetahui pun
Dialogue: 0,0:15:48.33,0:15:50.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetap tidak bisa melihat sampai ke isi hati.
Dialogue: 0,0:15:54.56,0:15:56.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bilang apa soal "keputusasaan"?
Dialogue: 0,0:15:56.79,0:15:58.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kenal betul emosi itu.
Dialogue: 0,0:16:05.40,0:16:06.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena selama ini
Dialogue: 0,0:16:07.77,0:16:10.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sudah berulang kali melewati hal seperti itu!
Dialogue: 0,0:16:11.70,0:16:15.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku membutuhkanmu untuk momen ini.
Dialogue: 0,0:16:16.54,0:16:18.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai putraku.
Dialogue: 0,0:16:20.29,0:16:22.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang, katamu?
Dialogue: 0,0:16:23.17,0:16:26.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak pernah menanyakan soal perasaanmu.
Dialogue: 0,0:16:27.28,0:16:30.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagiku, bersama mereka tidak membawa\Nkeuntungan apa pun untukmu.
Dialogue: 0,0:16:31.25,0:16:32.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah maksud ucapanku.
Dialogue: 0,0:16:33.70,0:16:36.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu bertambah kuat saat bersama mereka?
Dialogue: 0,0:16:37.63,0:16:39.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibandingkan bertahun-tahun bersama mereka,
Dialogue: 0,0:16:39.58,0:16:42.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}perkembanganmu dalam sesaat setelah menerima
Dialogue: 0,0:16:42.75,0:16:44.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kekuatan dari Yang Mulia\Nseharusnya jauh lebih besar.
Dialogue: 0,0:16:45.66,0:16:48.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kawan adalah sosok\Nyang saling memperkuat diri,
Dialogue: 0,0:16:48.44,0:16:51.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maka kamu seharusnya\Nmembuang nyawa untuk Yang Mulia,
Dialogue: 0,0:16:51.45,0:16:52.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukan mereka.
Dialogue: 0,0:16:53.12,0:16:56.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bilang timbangan itu pilihan, 'kan?
Dialogue: 0,0:16:57.10,0:17:01.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku telah memilih untuk bersama dengan mereka.
Dialogue: 0,0:17:01.98,0:17:04.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada untung dan rugi di sana,
Dialogue: 0,0:17:04.68,0:17:06.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}begitu juga dengan benar dan salah.
Dialogue: 0,0:17:07.50,0:17:08.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kami
Dialogue: 0,0:17:09.13,0:17:10.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}teman.
Dialogue: 0,0:17:13.57,0:17:14.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:17:14.78,0:17:15.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham sekarang.
Dialogue: 0,0:17:16.53,0:17:19.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski Yang Mulia telah mengakui kemampuanmu,
Dialogue: 0,0:17:19.44,0:17:21.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu sama sekali tak berniat membuang apa pun.
Dialogue: 0,0:17:22.90,0:17:25.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya buang nyawamu itu!
Dialogue: 0,0:17:25.28,0:17:26.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ishida Uryuu!
Dialogue: 0,0:17:34.15,0:17:35.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bankai!
Dialogue: 0,0:17:36.94,0:17:37.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tensa
Dialogue: 0,0:17:38.70,0:17:40.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zangetsu!
Dialogue: 0,0:17:48.21,0:17:51.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menunjukkan wajah seseram itu, Ichigo.
Dialogue: 0,0:17:51.30,0:17:55.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sedang menunjukkan\Nrasa hormat pada kekuatanmu.
Dialogue: 0,0:17:55.97,0:17:58.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Tensa Zangetsu" yang baru.
Dialogue: 0,0:17:58.57,0:18:00.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Bankai yang mengerikan".
Dialogue: 0,0:18:00.90,0:18:03.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku telah memutuskan itu,
Dialogue: 0,0:18:03.81,0:18:06.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maka kupatahkan ia di masa depan.
Dialogue: 0,0:18:31.30,0:18:32.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bankai!
Dialogue: 0,0:18:33.63,0:18:35.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Bankai", ya.
Dialogue: 0,0:18:36.28,0:18:38.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka kata itu.
Dialogue: 0,0:18:39.86,0:18:40.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ren...!
Dialogue: 0,0:18:43.89,0:18:46.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kata itu mampu\Nmembuat kalian, para shinigami,
Dialogue: 0,0:18:46.06,0:18:49.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kembali bangkit dalam situasi seburuk apa pun.
Dialogue: 0,0:18:49.50,0:18:51.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata itu benar-benar kuat.
Dialogue: 0,0:18:55.72,0:18:57.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat kata itu pula,
Dialogue: 0,0:18:57.55,0:19:03.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa menghancurkan mental shinigami\Nyang terus bangkit berulang kali.
Dialogue: 0,0:19:04.90,0:19:08.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu telah bangkit\Ndari begitu banyak keputusasaan,
Dialogue: 0,0:19:08.20,0:19:10.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mengubah masa depan, bukan?
Dialogue: 0,0:19:11.02,0:19:13.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tahu kenapa kamu bisa lakukan itu?
Dialogue: 0,0:19:14.33,0:19:17.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku tidak ada di sana!
Dialogue: 0,0:19:18.15,0:19:19.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Ichigo.
Dialogue: 0,0:19:19.67,0:19:21.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cobalah mengubah masa depan.
Dialogue: 0,0:19:21.77,0:19:25.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak peduli seberapa indahnya masa depan itu,
Dialogue: 0,0:19:25.51,0:19:28.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku pasti bisa "melihatnya".
Dialogue: 0,0:19:32.17,0:19:36.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, bahkan masa depan\Nyang telah kamu ubah pun
Dialogue: 0,0:19:36.40,0:19:39.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan kuhancurkan hingga berkeping-keping.
Dialogue: 0,0:19:40.44,0:19:41.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah...
Dialogue: 0,0:19:41.55,0:19:44.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Janganlah berputus asa,
Dialogue: 0,0:19:44.41,0:19:46.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ichigo.
Dialogue: 0,0:21:17.71,0:21:22.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bleach:\NThousand-Year Blood War - The Calamity
Dialogue: 0,0:21:25.23,0:21:28.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekspresi macam apa itu?
Dialogue: 0,0:21:28.53,0:21:30.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pikir aku kesal?
Dialogue: 0,0:21:31.10,0:21:34.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Yang Mulia merebut kekuatanku.
Dialogue: 0,0:21:35.93,0:21:36.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru kebalikannya.
Dialogue: 0,0:21:37.50,0:21:43.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bangga karena Yang Mulia\Ntidak merebut kekuatanmu.
Dialogue: 0,0:21:44.13,0:21:47.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fakta beliau merebut kekuatanku...
Dialogue: 0,0:21:47.86,0:21:49.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh membanggakan.
Dialogue: 0,0:21:50.46,0:21:51.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena hanya aku
Dialogue: 0,0:21:52.23,0:21:54.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang berguna untuk Yang Mulia.
Dialogue: 0,0:21:59.48,0:22:00.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:22:01.02,0:22:03.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Ishida Uryuu.
Dialogue: 0,0:22:04.22,0:22:08.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergilah setelah pindahkan\Nlukamu ke tubuhku.
Dialogue: 0,0:22:09.88,0:22:12.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mati sebentar lagi.
Dialogue: 0,0:22:13.63,0:22:15.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada luka, atau tidak...
Dialogue: 0,0:22:16.65,0:22:18.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada bedanya.
Dialogue: 0,0:22:18.49,0:22:21.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu... bilang apa barusan?
Dialogue: 0,0:22:21.74,0:22:22.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:22:23.31,0:22:24.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kasihan padaku?
Dialogue: 0,0:22:25.52,0:22:30.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal tadi kamu bertarung\Nuntuk membunuhku, bukan begitu?
Dialogue: 0,0:22:30.37,0:22:31.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetap saja...!
Dialogue: 0,0:22:31.83,0:22:33.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk apa ragu?
Dialogue: 0,0:22:34.27,0:22:37.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menyuruhmu\Npertaruhkan semua ke atas timbangan.
Dialogue: 0,0:22:38.00,0:22:39.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak sanggup bertaruh ke atas timbangan,
Dialogue: 0,0:22:40.35,0:22:42.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mengambil keputusan saat dilanda keraguan...
Dialogue: 0,0:22:42.95,0:22:45.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya akan mendatangkan penyesalan.
Dialogue: 0,0:22:46.37,0:22:51.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maka pertaruhkan hal itu juga\Nke atas timbangan, Ishida Uryuu.
Dialogue: 0,0:22:52.26,0:22:53.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu harus...
Dialogue: 0,0:22:54.15,0:22:56.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pergi menolong teman-temanmu.
Dialogue: 0,0:23:13.28,0:23:15.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski hasil akhirnya tidak berubah,
Dialogue: 0,0:23:15.86,0:23:17.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memilih sesuai keinginan sendiri,
Dialogue: 0,0:23:18.29,0:23:20.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan melangkah atas kehendak sendiri\Ntetaplah bermakna.
Dialogue: 0,0:23:24.07,0:23:25.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak menyesal.
Dialogue: 0,0:23:27.37,0:23:28.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak sedikit pun.
Dialogue: 0,0:23:36.05,0:23:38.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita saling menarik
Dialogue: 0,0:23:38.99,0:23:40.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laksana tetesan air,
Dialogue: 0,0:23:40.54,0:23:42.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}laksana planet.
Dialogue: 0,0:23:43.04,0:23:45.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita saling menolak
Dialogue: 0,0:23:46.27,0:23:47.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laksana magnet,
Dialogue: 0,0:23:48.02,0:23:49.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}laksana warna kulit.
