Dialogue: 0,0:18:23.86,0:18:25.71,sign,,0000,0000,0000,,KUROSAKI KAZUI
Dialogue: 0,0:18:27.07,0:18:30.04,sign,,0000,0000,0000,,KEMATIAN DAN STROBERI
Dialogue: 0,0:18:37.22,0:18:43.82,sign,,0000,0000,0000,,BLEACH
Dialogue: 0,0:22:46.37,0:22:50.07,sign,,0000,0000,0000,,DAN JIWAMU
Dialogue: 0,0:22:53.23,0:22:58.20,sign,,0000,0000,0000,,KEPUTUSASAAN
Dialogue: 0,0:22:58.73,0:23:00.87,sign,,0000,0000,0000,,BLEACH
Dialogue: 0,0:23:02.36,0:23:04.74,sign,,0000,0000,0000,,KISAH SANG
Dialogue: 0,0:23:06.94,0:23:10.06,sign,,0000,0000,0000,,PEMBERANI
Dialogue: 0,0:00:05.33,0:00:09.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kami tak berwujud,
Dialogue: 0,0:00:09.40,0:00:11.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami tetap melangkah maju.
Dialogue: 0,0:00:25.82,0:00:28.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beres-beresnya sudah hampir selesai.
Dialogue: 0,0:00:33.63,0:00:37.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya, pemasangan jalan batu\Ndi area terakhir akan menjadi
Dialogue: 0,0:00:37.39,0:00:39.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pekerjaan terakhir untuk saat ini.
Dialogue: 0,0:00:43.93,0:00:45.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepuluh tahun, ya.
Dialogue: 0,0:00:46.49,0:00:47.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski butuh waktu
Dialogue: 0,0:00:47.60,0:00:48.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang cukup lama,
Dialogue: 0,0:00:48.26,0:00:50.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan setelah kekacauan sebesar itu,
Dialogue: 0,0:00:50.25,0:00:52.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita masih bisa membangun semuanya lagi.
Dialogue: 0,0:00:55.85,0:00:57.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Komandan!
Dialogue: 0,0:00:57.48,0:01:01.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu kita terbatas. Cepatlah!
Dialogue: 0,0:01:01.46,0:01:02.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga.
Dialogue: 0,0:01:03.38,0:01:06.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih belum terbiasa\Nsibuk sebagai Kapten Komandan.
Dialogue: 0,0:01:06.62,0:01:09.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang aku paham\Nsehebat apa Kakek Yama.
Dialogue: 0,0:01:11.92,0:01:13.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:01:13.04,0:01:15.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai nanti, Ukitake.
Dialogue: 0,0:01:17.93,0:01:19.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Komandan!
Dialogue: 0,0:01:19.70,0:01:22.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, ya. Aku segera ke sana.
Dialogue: 0,0:02:54.39,0:02:58.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}BLEACH: Thousand-Year Blood War
Dialogue: 0,0:03:03.59,0:03:07.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya bagian barat\NDistrik 55 selesai dibangun.
Dialogue: 0,0:03:07.24,0:03:10.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar, deh.\NMereka membuatku menunggu lama.
Dialogue: 0,0:03:11.02,0:03:16.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya aku bisa menyebar\Njaringan rahasiaku ke seluruh Seireitei.
Dialogue: 0,0:03:16.87,0:03:18.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:03:18.07,0:03:21.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya memeriksa langsung ke lokasi.
Dialogue: 0,0:03:21.44,0:03:22.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikuti aku,
Dialogue: 0,0:03:22.56,0:03:23.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nemuri No. 8.
Dialogue: 0,0:03:24.19,0:03:25.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, Tuan Mayuri!
Dialogue: 0,0:03:26.43,0:03:28.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suaramu terlalu kencang.
Dialogue: 0,0:03:28.23,0:03:30.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik! Maafkan aku, Tuan Mayuri!
Dialogue: 0,0:03:30.96,0:03:33.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ini, ya...
Dialogue: 0,0:03:33.59,0:03:36.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu jadi seperti ini, sih?
Dialogue: 0,0:03:36.04,0:03:38.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa, ya, Tuan Mayuri?
Dialogue: 0,0:03:39.71,0:03:41.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas kerja kerasmu,\NKapten Zaraki!
Dialogue: 0,0:03:41.46,0:03:45.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih!
Dialogue: 0,0:03:45.26,0:03:46.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik!
Dialogue: 0,0:03:46.76,0:03:48.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini masih siang bolong.\NAku belum capek!
Dialogue: 0,0:03:49.82,0:03:52.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dimengerti! Mohon maaf!
Dialogue: 0,0:03:52.60,0:03:54.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam sejahtera, Kapten Zaraki!
Dialogue: 0,0:03:54.51,0:03:57.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam sejahtera!
Dialogue: 0,0:03:57.19,0:03:58.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Kapten.
Dialogue: 0,0:03:58.75,0:04:01.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini kita harus ke asrama Skuad 1, 'kan?
Dialogue: 0,0:04:01.38,0:04:02.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa betul lewat sini?
Dialogue: 0,0:04:02.99,0:04:05.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Bicara apa kau?
Dialogue: 0,0:04:05.34,0:04:07.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Acaranya punya Skuad 13,
Dialogue: 0,0:04:07.33,0:04:09.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tentu saja kita ke asrama Skuad 13.
Dialogue: 0,0:04:10.01,0:04:12.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di asrama Skuad 1, 'kan, ya?
Dialogue: 0,0:04:12.08,0:04:14.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan tanya aku. Aku hanya Kursi Ke-3.
Dialogue: 0,0:04:14.95,0:04:16.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu yang harusnya tahu itu.
Dialogue: 0,0:04:16.41,0:04:18.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar baik-baik, Ikkaku.
Dialogue: 0,0:04:18.82,0:04:23.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu, aku sering tersesat karena Yachiru.
Dialogue: 0,0:04:23.26,0:04:25.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Yachiru sudah tidak ada,
Dialogue: 0,0:04:25.87,0:04:28.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak akan tersesat lagi!
Dialogue: 0,0:04:31.60,0:04:32.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok aku?!
Dialogue: 0,0:04:32.67,0:04:35.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir Kapten ada benarnya.
Dialogue: 0,0:04:35.55,0:04:37.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sudah paham, kita berangkat!
Dialogue: 0,0:04:37.35,0:04:38.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan banyak bersantai!
Dialogue: 0,0:04:38.68,0:04:41.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu dulu, Kapten!
Dialogue: 0,0:04:43.49,0:04:45.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu Skuad 11, 'kan?
Dialogue: 0,0:04:45.34,0:04:47.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa mereka lari ke arah yang berlawanan?
Dialogue: 0,0:04:47.44,0:04:50.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mungkin... mereka tersesat?
Dialogue: 0,0:04:50.06,0:04:52.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang tersesat mana\Nyang larinya secepat itu?
Dialogue: 0,0:04:52.72,0:04:54.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan hentikan mereka!
Dialogue: 0,0:04:54.50,0:04:56.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, jangan repot-repot!
Dialogue: 0,0:04:56.33,0:05:00.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita terlambat seperti mereka?
Dialogue: 0,0:05:00.00,0:05:00.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:05:00.95,0:05:02.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada tapi-tapian!
Dialogue: 0,0:05:02.80,0:05:05.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sudah dewasa. Biarkan saja.
Dialogue: 0,0:05:05.91,0:05:07.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perintah kapten!
Dialogue: 0,0:05:08.60,0:05:13.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Hirako, kamu selalu keluarkan\Nperintah kapten untuk hal remeh, ya.
Dialogue: 0,0:05:14.83,0:05:17.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pola pikir kita saja yang berbeda!
Dialogue: 0,0:05:17.06,0:05:19.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa bilang aku hanya\Nmemerintahkan hal remeh?
Dialogue: 0,0:05:19.72,0:05:21.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memerintah kapan pun aku mau!
Dialogue: 0,0:05:28.28,0:05:31.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kami tidak akan bisa, Kapten!
Dialogue: 0,0:05:31.67,0:05:34.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa. Kalian bisa menyusul nanti!
Dialogue: 0,0:05:34.73,0:05:36.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berangkat dari tempat latihan, ya?
Dialogue: 0,0:05:36.86,0:05:39.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Iba memang pekerja keras, ya.
Dialogue: 0,0:05:39.68,0:05:41.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Hitsugaya.
Dialogue: 0,0:05:41.38,0:05:45.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, bukan. Aku masih belum pantas\Nmenjabat posisi kapten.
Dialogue: 0,0:05:45.61,0:05:47.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku sampai melewatkan latihan,
Dialogue: 0,0:05:47.93,0:05:50.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku merasa tidak cocok berada di posisi ini.
Dialogue: 0,0:05:52.15,0:05:53.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:05:56.73,0:05:58.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat yang bagus.
Dialogue: 0,0:05:58.79,0:06:02.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah yang diperlukan seorang kapten.
Dialogue: 0,0:06:02.96,0:06:05.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi ingin seseorang mencontoh sikap itu.
Dialogue: 0,0:06:05.25,0:06:08.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa, ya? Shuhei, mungkin?
Dialogue: 0,0:06:08.65,0:06:09.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:06:09.81,0:06:11.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shuhei, dengar baik-baik.
Dialogue: 0,0:06:11.56,0:06:13.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Rangiku, aku tidak bisa terima, ya!
Dialogue: 0,0:06:13.78,0:06:14.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kuperjelas dulu, ya.
Dialogue: 0,0:06:14.94,0:06:18.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ucapan kaptenmu tadi\Nmenunjukkan beliau di pihak kami.
Dialogue: 0,0:06:18.86,0:06:21.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga perjelas satu hal untukmu!
Dialogue: 0,0:06:21.03,0:06:24.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menguasai Bankai sejak lama sekali, ya!
Dialogue: 0,0:06:24.19,0:06:26.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku belum pernah lihat.
Dialogue: 0,0:06:26.71,0:06:28.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga.
Dialogue: 0,0:06:28.08,0:06:30.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau menipu orang pakai Bankai, ya?
Dialogue: 0,0:06:30.38,0:06:31.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga belum pernah lihat.
Dialogue: 0,0:06:31.73,0:06:35.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembohong! Kapten pernah lihat!
Dialogue: 0,0:06:35.05,0:06:37.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Me-Memangnya aku bisa apa?!
Dialogue: 0,0:06:37.46,0:06:40.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak hari itu, aku tidak punya\Nkesempatan pakai Bankai!
Dialogue: 0,0:06:40.20,0:06:41.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cari-cari alasan, ya?
Dialogue: 0,0:06:41.16,0:06:42.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cari-cari alasan saja.
Dialogue: 0,0:06:42.07,0:06:44.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten, tolong jangan memihak mereka!
Dialogue: 0,0:06:45.01,0:06:50.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, bukankah bagus kalau selama\N10 tahun ini tidak sempat pakai?
Dialogue: 0,0:06:50.90,0:06:54.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya kita berhasil mempertahankan\Nkedamaian selama 10 tahun.
Dialogue: 0,0:06:58.58,0:07:01.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa upacara hari ini
Dialogue: 0,0:07:01.11,0:07:04.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah penutup yang tepat untuk 10 tahun itu.
Dialogue: 0,0:07:04.90,0:07:07.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu terlambat!\NDari mana saja, sih?
Dialogue: 0,0:07:07.20,0:07:11.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Kami memutari Seireitei satu kali.
Dialogue: 0,0:07:11.03,0:07:12.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah seharusnya lebih cepat?
Dialogue: 0,0:07:12.94,0:07:16.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sedang mempertanyakan\Nkeputusan kalian lari memutari Seireitei
Dialogue: 0,0:07:16.60,0:07:18.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di hari sepenting ini.
Dialogue: 0,0:07:20.86,0:07:25.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kalian berdua masuk dulu saja, ya?
Dialogue: 0,0:07:25.06,0:07:26.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan. Lewat sini.
Dialogue: 0,0:07:30.87,0:07:33.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak, kamu juga kapten.
Dialogue: 0,0:07:33.21,0:07:35.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan membungkukkan badan saja, dong!
Dialogue: 0,0:07:35.35,0:07:37.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa!
Dialogue: 0,0:07:37.54,0:07:39.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetap tidak boleh, ya?
Dialogue: 0,0:07:39.71,0:07:42.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku buat lagu baru untuk upacara ini.
Dialogue: 0,0:07:42.52,0:07:43.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua pasti terharu.
Dialogue: 0,0:07:43.65,0:07:46.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh. Simpan itu sebelum masuk.
Dialogue: 0,0:07:46.71,0:07:49.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bawa lampu panggung.
Dialogue: 0,0:07:49.29,0:07:52.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong simpan semuanya!
Dialogue: 0,0:07:52.59,0:07:56.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wakil Kapten Ise makin gagah saja tiap tahunnya.
Dialogue: 0,0:07:56.28,0:07:59.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita simpan ini untuk pesta nanti malam.
Dialogue: 0,0:07:59.39,0:08:00.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setuju.
Dialogue: 0,0:08:01.43,0:08:02.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:08:02.44,0:08:06.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita mulai inaugurasi\Nkapten baru Gotei 13 sekarang.
Dialogue: 0,0:08:08.58,0:08:10.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten baru, silakan masuk.
Dialogue: 0,0:08:11.42,0:08:13.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa cemberut begitu, sih?
Dialogue: 0,0:08:13.63,0:08:14.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:08:14.83,0:08:16.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu grogi dan tersandung,
Dialogue: 0,0:08:16.56,0:08:18.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan menggendongmu di bahuku.
Dialogue: 0,0:08:18.36,0:08:19.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di-Diam!
Dialogue: 0,0:08:23.19,0:08:26.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Skuad 13, Kuchiki Rukia.
Dialogue: 0,0:08:26.54,0:08:27.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hadir!
Dialogue: 0,0:08:28.82,0:08:31.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Kapten ke mana?
Dialogue: 0,0:08:31.54,0:08:33.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, benar juga.
Dialogue: 0,0:08:33.23,0:08:35.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini inaugurasi kapten baru.
Dialogue: 0,0:08:35.71,0:08:39.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, sepertinya beliau pergi\Ninspeksi ke area konstruksi.
Dialogue: 0,0:08:39.49,0:08:40.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:08:40.70,0:08:43.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu yang Wakil Kapten saja tidak tahu,
Dialogue: 0,0:08:43.11,0:08:44.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apalagi aku?
Dialogue: 0,0:08:44.72,0:08:46.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun.
Dialogue: 0,0:08:46.21,0:08:49.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat, aku panggil saja.
Dialogue: 0,0:08:49.06,0:08:50.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa terjadi sesuatu?
Dialogue: 0,0:08:50.59,0:08:54.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan apa-apa.\NAlat kita menangkap reaksi aneh.
Dialogue: 0,0:08:54.75,0:08:56.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reaksinya mirip sekali
Dialogue: 0,0:08:56.46,0:08:59.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan reiatsu Yhwach\Ndari 10 tahun yang lalu.
Dialogue: 0,0:09:09.76,0:09:10.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:09:10.29,0:09:11.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:09:11.03,0:09:12.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau apa setelah pulang nanti?
Dialogue: 0,0:09:12.30,0:09:14.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah. Main gim, mungkin?
Dialogue: 0,0:09:14.13,0:09:15.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Main gim? Ide bagus.
Dialogue: 0,0:09:15.58,0:09:16.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, 'kan?
Dialogue: 0,0:09:16.24,0:09:18.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kamu terlalu jago.
Dialogue: 0,0:09:18.44,0:09:20.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tahu saja, deh.
Dialogue: 0,0:09:35.85,0:09:39.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei! Sedang apa di sana, anak nakal?!
Dialogue: 0,0:09:39.08,0:09:40.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu masuk dari mana...?
Dialogue: 0,0:09:42.06,0:09:43.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba lihat itu.
Dialogue: 0,0:09:43.24,0:09:45.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Larinya cepat sekali.
Dialogue: 0,0:09:48.72,0:09:52.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami mendeteksi reaksi\Nyang serupa dengan sisa kekuatan Yhwach
Dialogue: 0,0:09:52.16,0:09:53.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di bagian barat Distrik 55.
Dialogue: 0,0:09:53.60,0:09:56.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Area konstruksi terakhir\Ndekat asrama Skuad 13.
Dialogue: 0,0:09:57.69,0:09:58.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuchiki!
Dialogue: 0,0:09:59.59,0:10:01.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabarnya Kapten Skuad 13
Dialogue: 0,0:10:01.32,0:10:03.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berangkat tepat setelah inaugurasi.
Dialogue: 0,0:10:03.34,0:10:05.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya aku mengirim orang untuk mengabarimu.
Dialogue: 0,0:10:05.20,0:10:06.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:10:06.51,0:10:09.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini cuti Rukia dan yang lain\Nsetelah sekian lama.
Dialogue: 0,0:10:09.29,0:10:13.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu menghubungi mereka.\NBiar aku yang atasi.
Dialogue: 0,0:10:13.11,0:10:15.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh? Ada yang aneh.
Dialogue: 0,0:10:15.57,0:10:18.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ingat menghubungi kalian semua.
Dialogue: 0,0:10:18.88,0:10:22.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan remehkan jaringan intel\NPasukan Rahasia.
Dialogue: 0,0:10:22.19,0:10:26.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kamu ada di sini,\Nberarti intel itu benar.
Dialogue: 0,0:10:26.65,0:10:29.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga. Ini bukan masalah benar atau tidak...
Dialogue: 0,0:10:30.19,0:10:32.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian bisa lihat\Ndengan mata kepala kalian sendiri.
Dialogue: 0,0:10:43.91,0:10:44.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo.
Dialogue: 0,0:10:45.33,0:10:46.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo.
Dialogue: 0,0:10:48.14,0:10:50.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih sepi seperti biasanya.
Dialogue: 0,0:10:50.33,0:10:51.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar tidak ada orang!
Dialogue: 0,0:10:51.78,0:10:54.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Klinik kosong itu pertanda yang baik.
Dialogue: 0,0:10:54.42,0:10:56.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan banyak protes dan masuk saja.
Dialogue: 0,0:10:56.85,0:10:58.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang lain juga baru sampai.
Dialogue: 0,0:11:00.02,0:11:01.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada Rukia!
Dialogue: 0,0:11:01.08,0:11:02.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang, Rukia!
Dialogue: 0,0:11:02.94,0:11:05.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bertingkah seolah ini rumahmu.
Dialogue: 0,0:11:05.53,0:11:07.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tidak bertemu, Rukia.
Dialogue: 0,0:11:07.18,0:11:08.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rambutmu panjang.
Dialogue: 0,0:11:08.38,0:11:09.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cocok banget, lo.
Dialogue: 0,0:11:09.52,0:11:11.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minggir, Kak!
Dialogue: 0,0:11:11.36,0:11:13.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami bawa jagung berondong dan soda!
Dialogue: 0,0:11:16.19,0:11:18.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, Rukia! Lama tidak ketemu.
Dialogue: 0,0:11:18.42,0:11:20.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tidak bertemu, kalian berdua.
Dialogue: 0,0:11:20.40,0:11:21.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sudah besar.
Dialogue: 0,0:11:21.99,0:11:23.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, sudah mulai, tuh!
Dialogue: 0,0:11:23.61,0:11:24.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Ichi, duduk di sini.
Dialogue: 0,0:11:24.72,0:11:25.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sini, sini.\N- Disponsori oleh Y. Hans.
Dialogue: 0,0:11:25.82,0:11:27.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai!
Dialogue: 0,0:11:27.49,0:11:29.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laga Kejuaraan Kelas Berat Dunia!
Dialogue: 0,0:11:29.51,0:11:31.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, penantang Sado Yasutora...
Dialogue: 0,0:11:31.12,0:11:33.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chad keren banget, ya.
Dialogue: 0,0:11:33.27,0:11:34.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya dia jadi orang
Dialogue: 0,0:11:34.56,0:11:34.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}paling terkenal
Dialogue: 0,0:11:34.99,0:11:36.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di antara kita semua.
Dialogue: 0,0:11:36.75,0:11:38.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kita" ini termasuk kamu?
Dialogue: 0,0:11:38.73,0:11:39.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas, lah.
Dialogue: 0,0:11:39.86,0:11:41.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bakal ikut dihitung!
Dialogue: 0,0:11:43.48,0:11:44.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dokter Ishida di mana?
Dialogue: 0,0:11:44.82,0:11:47.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang memperpanjang\Nistirahat makan siangnya di atap.
Dialogue: 0,0:11:47.15,0:11:49.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tumben banget, ya?
Dialogue: 0,0:11:49.15,0:11:52.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya jadwal kerjanya tidak pernah pas,
Dialogue: 0,0:11:52.32,0:11:54.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi ingin menonton acara
Dialogue: 0,0:11:54.57,0:11:56.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang seharusnya ditonton\Nbersama teman-temannya.
Dialogue: 0,0:11:56.76,0:11:59.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alasannya imut banget!
Dialogue: 0,0:12:02.13,0:12:03.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuh, kan, tersambung.
Dialogue: 0,0:12:03.68,0:12:05.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, dia angkat.
Dialogue: 0,0:12:05.42,0:12:06.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:12:06.32,0:12:08.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bicara seolah aku pasti tidak angkat.
Dialogue: 0,0:12:08.61,0:12:09.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan itu maksudku.
Dialogue: 0,0:12:09.83,0:12:11.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bilang tidak bisa ambil cuti,
Dialogue: 0,0:12:11.80,0:12:13.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku minta dia jangan ganggu.
Dialogue: 0,0:12:14.31,0:12:16.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa pergi dari rumah sakit,
Dialogue: 0,0:12:16.71,0:12:19.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku bisa luangkan waktu.
Dialogue: 0,0:12:19.25,0:12:21.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan tonton pertandingan Chad dari sini.
Dialogue: 0,0:12:21.86,0:12:22.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:12:22.76,0:12:25.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ishida! Apa kabar?
Dialogue: 0,0:12:25.41,0:12:27.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, jangan ganggu!
Dialogue: 0,0:12:29.05,0:12:30.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat perbuatanmu, Keigo.
Dialogue: 0,0:12:30.40,0:12:32.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa jadi salahku?!
Dialogue: 0,0:12:32.47,0:12:34.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tertawa?
Dialogue: 0,0:12:34.22,0:12:36.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tidak apa-apa.
Dialogue: 0,0:12:36.30,0:12:37.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruskan saja seperti itu.
Dialogue: 0,0:12:37.61,0:12:40.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu masih tidak jelas seperti biasa.
Dialogue: 0,0:12:40.40,0:12:42.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau dengar itu dari mulutmu.
Dialogue: 0,0:12:43.91,0:12:45.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chad muncul di televisi!
Dialogue: 0,0:12:46.26,0:12:48.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah ceritanya. Aku matikan teleponnya, ya.
Dialogue: 0,0:12:48.51,0:12:49.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dah, Ishida.
Dialogue: 0,0:12:49.52,0:12:50.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Kurosaki...!
Dialogue: 0,0:12:51.76,0:12:54.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kenapa, sih?
Dialogue: 0,0:12:56.61,0:12:58.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orihime, sudah mulai.
Dialogue: 0,0:12:59.18,0:13:00.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:13:00.81,0:13:01.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harimau!
Dialogue: 0,0:13:01.81,0:13:04.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadilah harimau sungguhan, Yasutora!
Dialogue: 0,0:13:05.88,0:13:08.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sado benar-benar bersemangat, ya.
Dialogue: 0,0:13:08.75,0:13:10.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti akan menang.
Dialogue: 0,0:13:12.28,0:13:13.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana Kazui?
Dialogue: 0,0:13:13.28,0:13:15.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang dia sedang di atas.
Dialogue: 0,0:13:15.99,0:13:17.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut laporan Tsubaki dan yang lain,
Dialogue: 0,0:13:17.97,0:13:21.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tadi dia pergi main ke tempatnya Hiyori.
Dialogue: 0,0:13:22.12,0:13:23.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dia di kamarmu, Kak.
Dialogue: 0,0:13:23.97,0:13:26.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kazu suka sekali kamarmu.
Dialogue: 0,0:13:26.10,0:13:27.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang itu kamarmu.
Dialogue: 0,0:13:27.91,0:13:28.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak masalah?
Dialogue: 0,0:13:28.94,0:13:29.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kok.
Dialogue: 0,0:13:29.85,0:13:31.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kazu boleh masuk kapan saja.
Dialogue: 0,0:13:31.66,0:13:34.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya Kazui mirip sekali dengan Kak Ichi.
Dialogue: 0,0:13:34.40,0:13:35.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karin.
Dialogue: 0,0:13:36.57,0:13:37.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar.
Dialogue: 0,0:13:37.35,0:13:40.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kalian bilang\Nmau mengajak anak kalian ke sini?
Dialogue: 0,0:13:41.38,0:13:42.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah.
Dialogue: 0,0:13:42.38,0:13:45.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia akhirnya jadi calon anggota Gotei
Dialogue: 0,0:13:45.37,0:13:48.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan dapat izin berkunjung\Nsaat festival Obon.
Dialogue: 0,0:13:48.74,0:13:50.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masuklah!
Dialogue: 0,0:13:54.33,0:13:55.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dia menghilang.
Dialogue: 0,0:13:55.78,0:13:56.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa bisa?!
Dialogue: 0,0:13:57.49,0:14:01.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar, deh.\NSudah kubilang tak perlu mencarinya.
Dialogue: 0,0:14:01.18,0:14:02.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tanya, kenapa bisa hilang?!
Dialogue: 0,0:14:02.77,0:14:05.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santai. Dia shinigami.
Dialogue: 0,0:14:05.26,0:14:07.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada manusia yang bisa menyakitinya.
Dialogue: 0,0:14:07.30,0:14:10.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya dia akan mengajak kelahi manusia?!
Dialogue: 0,0:14:10.12,0:14:11.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kita cari...
Dialogue: 0,0:14:12.27,0:14:13.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ichigo.
Dialogue: 0,0:14:13.35,0:14:14.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa, sih?
Dialogue: 0,0:14:14.81,0:14:18.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau diingat lagi,\Nsemua bermula dari tempat ini.
Dialogue: 0,0:14:23.17,0:14:25.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pinjamkan katanamu, Shinigami!
Dialogue: 0,0:14:25.37,0:14:27.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan lakukan yang kamu mau.
Dialogue: 0,0:14:28.64,0:14:31.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan "Shinigami".\NNamaku Kuchiki Rukia.
Dialogue: 0,0:14:32.46,0:14:35.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ya?\NAku Kurosaki Ichigo.
Dialogue: 0,0:14:36.53,0:14:40.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuharap ini bukan salam terakhir kita.
Dialogue: 0,0:14:46.13,0:14:47.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita mulai.
Dialogue: 0,0:14:47.19,0:14:48.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:15:29.14,0:15:32.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa disadari, kita sudah pergi sejauh ini.
Dialogue: 0,0:15:33.32,0:15:34.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, waktunya kembali.
Dialogue: 0,0:15:34.81,0:15:36.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke tempat orang-orang menunggu kita.
Dialogue: 0,0:15:36.47,0:15:37.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:15:38.28,0:15:40.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah kita temukan anakmu.
Dialogue: 0,0:15:41.65,0:15:43.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menghela napas, dia anakmu, tahu!
Dialogue: 0,0:15:43.55,0:15:45.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, gongnya berbunyi.
Dialogue: 0,0:15:45.33,0:15:47.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga ikut cari, dong!
Dialogue: 0,0:15:47.23,0:15:48.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kamu juga!
Dialogue: 0,0:15:50.50,0:15:51.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, dia kembali.
Dialogue: 0,0:15:51.50,0:15:53.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu reiatsu milik anakmu?
Dialogue: 0,0:15:53.67,0:15:54.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke. Waktunya nonton.
Dialogue: 0,0:15:54.82,0:15:56.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:15:56.01,0:15:57.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Semangat, Chad!\N- Ya, di sana!
Dialogue: 0,0:15:57.81,0:16:00.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Di sana! Hajar dia!\N- Hajar dia, Chad!
Dialogue: 0,0:16:12.56,0:16:14.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mendekat! Mundur!
Dialogue: 0,0:16:17.43,0:16:18.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:16:18.73,0:16:22.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisa-sisa kekuatan Yhwach... menghilang?
Dialogue: 0,0:16:26.31,0:16:29.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kekuatan terakhir Yhwach
Dialogue: 0,0:16:29.45,0:16:31.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah sepenuhnya menghilang?
Dialogue: 0,0:16:34.72,0:16:38.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ichigo, jalannya telah tertutup.
Dialogue: 0,0:16:38.76,0:16:42.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalan menuju dunia tanpa ketakutan.
Dialogue: 0,0:16:43.04,0:16:50.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia nyata, Soul Society,\Ndan Hueco Mundo harus menyatu.
Dialogue: 0,0:16:50.82,0:16:56.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidup dan mati harus menjadi satu.
Dialogue: 0,0:16:56.84,0:17:00.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, tak satu pun akhirnya terwujud.
Dialogue: 0,0:17:02.50,0:17:06.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya karena kamu, Ichigo.
Dialogue: 0,0:17:06.98,0:17:08.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh disayangkan.
Dialogue: 0,0:17:08.75,0:17:10.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kamu,
Dialogue: 0,0:17:10.18,0:17:12.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hidup dan mati masih mempertahankan wujudnya.
Dialogue: 0,0:17:12.88,0:17:15.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segala yang hidup,
Dialogue: 0,0:17:15.31,0:17:20.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan takut pada kematian
Dialogue: 0,0:17:21.70,0:17:24.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk selamanya.
Dialogue: 0,0:17:27.66,0:17:29.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yhwach,
Dialogue: 0,0:17:29.16,0:17:31.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dunia yang kamu impikan
Dialogue: 0,0:17:31.73,0:17:33.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin benar-benar terbebas dari rasa takut.
Dialogue: 0,0:17:34.43,0:17:37.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi orang-orang dalam dunia\Ntanpa rasa takut pada kematian
Dialogue: 0,0:17:37.91,0:17:42.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak akan berusaha mengalahkan\Nrasa takut mereka, atau mencari harapan.
Dialogue: 0,0:17:43.35,0:17:47.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia bisa melangkah maju dengan terus hidup,
Dialogue: 0,0:17:47.64,0:17:51.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi itu berbeda dengan melangkah maju
Dialogue: 0,0:17:51.32,0:17:52.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}setelah mengalahkan rasa takut.
Dialogue: 0,0:17:53.79,0:17:58.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pula yang membuat manusia\Nmemberinya nama khusus,
Dialogue: 0,0:18:01.82,0:18:03.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ia disebut "keberanian".
Dialogue: 0,0:18:08.17,0:18:09.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kamu?
Dialogue: 0,0:18:09.31,0:18:10.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abarai Ichika.
Dialogue: 0,0:18:10.96,0:18:12.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kadet shinigami!
Dialogue: 0,0:18:14.70,0:18:15.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu siapa?
Dialogue: 0,0:18:16.40,0:18:19.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Kurosaki Kazui.
Dialogue: 0,0:18:21.86,0:18:23.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku shinigami juga.
Dialogue: 0,0:18:26.12,0:18:27.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
