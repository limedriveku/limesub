Dialogue: 0,0:09:36.53,0:09:39.01,sign,,0000,0000,0000,,DARAH UNTUK TULANGKU
Dialogue: 0,0:23:45.46,0:23:51.70,sign,,0000,0000,0000,,MERAH KIRMIZI SEMPURNA
Dialogue: 0,0:00:03.68,0:00:07.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini? Gelap sekali.
Dialogue: 0,0:00:07.66,0:00:09.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana ini?
Dialogue: 0,0:01:46.69,0:01:50.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bleach:\NThousand-Year Blood War - The Calamity
Dialogue: 0,0:01:50.43,0:01:54.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matilah setelah mengerahkan\Nseluruh kemampuanmu,
Dialogue: 0,0:01:54.00,0:01:56.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ichigo!
Dialogue: 0,0:01:56.01,0:01:57.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santen Kesshun!
Dialogue: 0,0:02:00.70,0:02:02.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shiten Koushun!
Dialogue: 0,0:02:02.79,0:02:04.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan penolakan, ya.
Dialogue: 0,0:02:04.93,0:02:06.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku
Dialogue: 0,0:02:06.26,0:02:07.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menolak!
Dialogue: 0,0:02:08.22,0:02:09.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak akan bisa.
Dialogue: 0,0:02:16.64,0:02:21.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dalam kekuatanku, mengalir kekuatan\Nyang sama seperti milik Ichigo.
Dialogue: 0,0:02:21.94,0:02:26.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu akan menerima kekuatan itu\Ntanpa menyadarinya.
Dialogue: 0,0:02:57.37,0:03:00.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai wanita, berbanggalah.
Dialogue: 0,0:03:00.47,0:03:04.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu hanya manusia biasa,\Ntak menyadari posisimu,
Dialogue: 0,0:03:04.65,0:03:07.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi mampu datang ke tempat ini.
Dialogue: 0,0:03:08.25,0:03:10.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takkan kubiarkan kau lukai dia.
Dialogue: 0,0:03:13.90,0:03:15.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan melindunginya.
Dialogue: 0,0:03:20.89,0:03:22.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu...
Dialogue: 0,0:03:22.84,0:03:23.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Aku akan
Dialogue: 0,0:03:25.64,0:03:27.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menolakmu!"
Dialogue: 0,0:03:42.56,0:03:44.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Getsuga Tensho!
Dialogue: 0,0:03:51.20,0:03:52.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membunuhmu.
Dialogue: 0,0:03:53.69,0:03:55.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betapa angkuhnya dirimu, Ichigo.
Dialogue: 0,0:03:55.75,0:03:58.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perbuatan itu sama saja\Ndengan membunuh dunia ini.
Dialogue: 0,0:04:00.46,0:04:05.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku telah menjadi dunia itu sendiri.
Dialogue: 0,0:04:05.88,0:04:08.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat aku mewarisi kekuatan Yang Mulia,
Dialogue: 0,0:04:08.70,0:04:12.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku dapat menggunakan\Nkekuatan itu dengan bebas.
Dialogue: 0,0:04:12.70,0:04:16.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah kekuatanku sebagai\Nbelahan diri Yang Mulia.
Dialogue: 0,0:04:16.31,0:04:18.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ishida Uryuu.
Dialogue: 0,0:04:18.20,0:04:22.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kamu memang "bertahan hidup"\Ndari "Auswählen" Yang Mulia,
Dialogue: 0,0:04:22.78,0:04:27.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}cobalah bertahan hidup sekali lagi\Ndi hadapan kekuatanku.
Dialogue: 0,0:04:42.35,0:04:45.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak awal,\Npertarungan kalian penuh kontradiksi.
Dialogue: 0,0:04:45.63,0:04:47.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pasti sudah melihatnya.
Dialogue: 0,0:04:47.43,0:04:50.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betapa rapuhnya keseimbangan dunia ini,
Dialogue: 0,0:04:50.37,0:04:53.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}juga betapa mudahnya\Nkeseimbangan itu digoyahkan...
Dialogue: 0,0:04:53.27,0:04:57.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membunuh Yang Mulia\Nyang menyatu dengan Raja Jiwa
Dialogue: 0,0:04:57.03,0:05:01.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sama saja seperti mengantarkan\Ndunia ini pada kematian.
Dialogue: 0,0:05:19.10,0:05:20.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyedihkan sekali.
Dialogue: 0,0:05:26.44,0:05:29.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia akan hancur saat Yhwach dikalahkan.
Dialogue: 0,0:05:30.43,0:05:33.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham betul risikonya.
Dialogue: 0,0:05:35.18,0:05:36.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:05:36.38,0:05:37.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu,
Dialogue: 0,0:05:38.10,0:05:40.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurosaki pasti akan mengatakan ini.
Dialogue: 0,0:05:41.30,0:05:43.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku tetap akan mengalahkanmu.
Dialogue: 0,0:05:43.65,0:05:47.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kenal orang-orang\Nyang selalu melindungi dunia ini.
Dialogue: 0,0:05:47.95,0:05:49.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu telah menginjak-injak
Dialogue: 0,0:05:50.09,0:05:51.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hal yang ingin mereka lindungi.
Dialogue: 0,0:05:53.31,0:05:55.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin melindungi begitu banyak orang.
Dialogue: 0,0:05:56.28,0:05:59.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin melindungi semua harapan mereka,
Dialogue: 0,0:05:59.58,0:06:01.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}serta hal-hal yang mereka anggap berharga.
Dialogue: 0,0:06:02.00,0:06:05.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika itu berarti aku harus "membunuh dunia",
Dialogue: 0,0:06:05.01,0:06:06.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tetap akan melakukannya.
Dialogue: 0,0:06:06.59,0:06:08.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita mulai.
Dialogue: 0,0:06:08.20,0:06:11.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Getsuga Jyuujisho!
Dialogue: 0,0:06:12.06,0:06:13.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu sadar?
Dialogue: 0,0:06:15.34,0:06:18.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggaplah kalian menang dari Yang Mulia,
Dialogue: 0,0:06:18.36,0:06:20.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sepeninggal Raja Jiwa,
Dialogue: 0,0:06:20.20,0:06:24.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian butuh "sesuatu" untuk mempertahankan\Ndunia yang ada selama ini.
Dialogue: 0,0:06:30.47,0:06:31.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu saja belum cukup?
Dialogue: 0,0:06:32.70,0:06:33.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ichigo.
Dialogue: 0,0:06:33.86,0:06:37.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai putraku yang terlahir dari kegelapan.
Dialogue: 0,0:06:37.12,0:06:39.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski dirimu tak mengetahui segalanya,
Dialogue: 0,0:06:39.80,0:06:42.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku yakin instingmu sudah paham.\NBenar, bukan?
Dialogue: 0,0:06:42.76,0:06:45.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena sudah memahami semuanya,
Dialogue: 0,0:06:45.05,0:06:47.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu sama sekali tak segan\Nuntuk mengalahkanku.
Dialogue: 0,0:06:50.00,0:06:52.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hyousube Ichibe.
Dialogue: 0,0:06:52.39,0:06:55.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua berjalan sesuai rencananya.
Dialogue: 0,0:06:55.51,0:06:57.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menerima Kurosaki Ichigo,
Dialogue: 0,0:06:57.81,0:07:01.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu memberinya ingatan\Ndan interpretasi Raja Jiwa.
Dialogue: 0,0:07:01.80,0:07:08.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk menguji apakah Kurosaki Ichigo\Nlayak menjadi tandingannya atau tidak.
Dialogue: 0,0:07:08.40,0:07:10.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kamu mukjizat.
Dialogue: 0,0:07:10.10,0:07:13.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu adalah manusia, shinigami,
Dialogue: 0,0:07:13.98,0:07:19.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hollow, Fullbringer, dan Quincy.
Dialogue: 0,0:07:19.50,0:07:22.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak perlu dipikirkan lagi.
Dialogue: 0,0:07:22.11,0:07:24.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hakikat kekuatanmu.
Dialogue: 0,0:07:24.92,0:07:28.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alasan kamu berselimut "hitam".
Dialogue: 0,0:07:28.17,0:07:30.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Hitam" adalah warna kekacauan.
Dialogue: 0,0:07:30.83,0:07:33.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekacauan adalah kekuatan Raja Jiwa.
Dialogue: 0,0:07:33.96,0:07:38.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warna hitam itu sendiri sesungguhnya\Nmerupakan reiatsu Raja Jiwa.
Dialogue: 0,0:07:38.93,0:07:41.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, orang yang mengendalikan hitam itu
Dialogue: 0,0:07:41.91,0:07:43.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah Hyousube Ichibe.
Dialogue: 0,0:07:44.05,0:07:46.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin orang itu telah memintamu
Dialogue: 0,0:07:46.61,0:07:49.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk melindungi Raja Jiwa.
Dialogue: 0,0:07:50.20,0:07:51.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya.
Dialogue: 0,0:07:52.46,0:07:54.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya.
Dialogue: 0,0:08:08.66,0:08:11.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan kubawa dengan alasan yang berbeda.
Dialogue: 0,0:08:12.37,0:08:17.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kau wadah yang mampu menahan\Nbesarnya kekuatan yang mengalir masuk,
Dialogue: 0,0:08:17.03,0:08:19.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau pecah bagaikan cangkir teh.
Dialogue: 0,0:08:19.22,0:08:24.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menerima sedikit kekuatanmu\Nuntuk memperbaiki tubuhku.
Dialogue: 0,0:08:24.48,0:08:28.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lindungilah "Raja Jiwa", Ichigo.
Dialogue: 0,0:08:28.48,0:08:31.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kuberi tahu kebenarannya.
Dialogue: 0,0:08:32.20,0:08:38.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hyousube Ichibe ingin menjadikanmu\NRaja Jiwa yang selanjutnya.
Dialogue: 0,0:08:39.65,0:08:41.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin...
Dialogue: 0,0:08:41.25,0:08:46.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia ingin menjadikanmu patung pemujaan\Nyang hanya berfungsi menjaga tiga dunia,
Dialogue: 0,0:08:46.69,0:08:51.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menjaga tatanan dunia\Nyang menempatkan shinigami di puncak.
Dialogue: 0,0:08:51.66,0:08:55.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah "kedamaian"\Nyang dilihat Hyousube Ichibe.
Dialogue: 0,0:08:55.55,0:08:59.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal itu sama seperti "kematian" untukmu.
Dialogue: 0,0:09:03.80,0:09:06.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya kenapa?
Dialogue: 0,0:09:06.80,0:09:08.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Memangnya kenapa?"
Dialogue: 0,0:09:08.86,0:09:09.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:09:09.90,0:09:11.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:09:11.36,0:09:14.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir Kurosaki pasti akan mengatakannya.
Dialogue: 0,0:09:14.66,0:09:17.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah aku menjadi Raja Jiwa atau tidak,
Dialogue: 0,0:09:17.75,0:09:20.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memangnya kenapa?!
Dialogue: 0,0:09:21.99,0:09:24.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal yang kupahami sekarang...
Dialogue: 0,0:09:25.29,0:09:27.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama aku tidak mengalahkanmu,
Dialogue: 0,0:09:27.58,0:09:30.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak akan bisa melindungi apa pun!
Dialogue: 0,0:09:30.80,0:09:32.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yhwach!
Dialogue: 0,0:09:46.56,0:09:48.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan monster itu?
Dialogue: 0,0:09:48.57,0:09:50.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia begitu kuat sampai Hacchi saja ciut.
Dialogue: 0,0:09:50.96,0:09:53.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ciut.
Dialogue: 0,0:09:57.23,0:09:58.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlalu mudah.
Dialogue: 0,0:09:58.79,0:10:01.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau kalian setara dengan Kapten Gotei 13,
Dialogue: 0,0:10:01.31,0:10:04.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kalian bukan apa-apa\Ndi hadapan "mukjizat".
Dialogue: 0,0:10:04.70,0:10:09.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reiatsu kalian pun begitu kecil\Nsampai nyaris tak terasa lagi.
Dialogue: 0,0:10:09.96,0:10:14.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar. Ini sama saja dengan\Nmenginjak semut di atas pasir.
Dialogue: 0,0:10:14.17,0:10:16.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah nyaris mustahil.
Dialogue: 0,0:10:18.46,0:10:20.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu pula aku harus temukan!
Dialogue: 0,0:10:20.68,0:10:23.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian pikir aku tak bisa menemukannya\Nkarena mustahil?
Dialogue: 0,0:10:23.93,0:10:27.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Mukjizat" adalah membuat hal mustahil\Nmenjadi mungkin terjadi!
Dialogue: 0,0:10:27.00,0:10:29.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tidak menyimak obrolan sebelumnya.
Dialogue: 0,0:10:29.32,0:10:31.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kalaupun kamu menyebut "mukjizat",
Dialogue: 0,0:10:31.29,0:10:33.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak akan paham\Nmaksud ucapanmu. Dasar botak!
Dialogue: 0,0:10:33.96,0:10:35.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak botak!
Dialogue: 0,0:10:35.94,0:10:37.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa dibalas, coba?
Dialogue: 0,0:10:39.86,0:10:41.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius banget, dah!
Dialogue: 0,0:10:43.68,0:10:46.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pikir serangan itu mempan padaku?
Dialogue: 0,0:10:47.00,0:10:48.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak sama sekali.
Dialogue: 0,0:10:48.57,0:10:50.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau hanya satu seranganku, ya.
Dialogue: 0,0:10:51.88,0:10:53.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakanade.
Dialogue: 0,0:10:57.02,0:10:58.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langit dan bumi pun terbalik!
Dialogue: 0,0:11:00.22,0:11:02.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya terbalik.
Dialogue: 0,0:11:08.52,0:11:10.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, sekarang!
Dialogue: 0,0:11:12.77,0:11:15.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kuperdengarkan tritonus.
Dialogue: 0,0:11:15.82,0:11:17.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tekken Tachikaze!
Dialogue: 0,0:11:17.44,0:11:20.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Super Mashiro Kick!
Dialogue: 0,0:11:24.33,0:11:26.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chocolate Bar Slider.
Dialogue: 0,0:11:26.68,0:11:28.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hifuki no Kozuchi!
Dialogue: 0,0:11:28.62,0:11:30.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nijuu Ichi-jo Tonbokudari!
Dialogue: 0,0:11:32.63,0:11:34.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua sudah berakhir.
Dialogue: 0,0:11:40.83,0:11:42.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhasil.
Dialogue: 0,0:11:52.76,0:11:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun. Kalau seperti ini terus\Ntidak akan ada habisnya.
Dialogue: 0,0:11:57.40,0:11:58.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:11:58.53,0:12:04.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kujatuhkan saja mereka semua\Nbersama seluruh wilayah ini!
Dialogue: 0,0:12:08.16,0:12:11.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takkan kubiarkan.
Dialogue: 0,0:12:16.50,0:12:19.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membekulah kau di sini, selamanya.
Dialogue: 0,0:12:20.16,0:12:21.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa?
Dialogue: 0,0:12:22.32,0:12:25.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Skuad 10 Gotei 13,
Dialogue: 0,0:12:26.01,0:12:27.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hitsugaya Toshiro.
Dialogue: 0,0:12:28.71,0:12:34.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya. Aku Sternritter Pasukan Elite,\NGerard Valkyrie!
Dialogue: 0,0:12:38.79,0:12:41.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga kita bisa akrab!
Dialogue: 0,0:12:41.92,0:12:42.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf saja.
Dialogue: 0,0:12:43.83,0:12:46.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan datang untuk berteman.
Dialogue: 0,0:12:48.11,0:12:49.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bankai.
Dialogue: 0,0:12:49.66,0:12:52.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daiguren Hyorinmaru.
Dialogue: 0,0:12:58.95,0:13:00.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shiro.
Dialogue: 0,0:13:06.76,0:13:07.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:13:14.27,0:13:16.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawaban yang kekanakan.
Dialogue: 0,0:13:19.22,0:13:20.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurosaki!
Dialogue: 0,0:13:22.00,0:13:25.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memperbaiki kesalahan ini\Njuga kewajiban seorang ayah.
Dialogue: 0,0:13:42.76,0:13:44.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ce-Cepat sekali.
Dialogue: 0,0:13:44.09,0:13:47.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa mengimbangi kecepatan Kurosaki.
Dialogue: 0,0:14:13.74,0:14:15.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Kurosaki!
Dialogue: 0,0:14:15.38,0:14:17.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang... Tenangkan dirimu sebentar!
Dialogue: 0,0:14:33.43,0:14:34.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit kupahami.
Dialogue: 0,0:14:34.81,0:14:37.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu ingin cepat mati?
Dialogue: 0,0:14:41.31,0:14:45.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu enggan menunjukkan\Nseluruh kekuatanmu?
Dialogue: 0,0:14:45.03,0:14:49.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu tak sudi memperlihatkan\Ndan membiarkanku merebut kekuatanmu?
Dialogue: 0,0:14:49.66,0:14:52.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, apa kamu yakin, Ichigo?
Dialogue: 0,0:14:52.41,0:14:57.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kamu mati seperti ini,\Ndunia nyata dan Soul Society akan musnah.
Dialogue: 0,0:14:57.78,0:14:59.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang akan musnahkan semua.
Dialogue: 0,0:15:00.13,0:15:02.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu ingin itu terjadi, Ichigo?
Dialogue: 0,0:15:10.94,0:15:15.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat. Temanmu saja bilang\Ntak bisa terus begini.
Dialogue: 0,0:15:15.46,0:15:19.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menyembuhkan lukamu\Ndan memintamu bertarung.
Dialogue: 0,0:15:19.63,0:15:24.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak awal, kamu tak punya pilihan lain.
Dialogue: 0,0:15:24.44,0:15:28.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawab mereka, Ichigo.\NSuara mereka yang tak memiliki kekuatan.
Dialogue: 0,0:15:29.63,0:15:35.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi orang-orang lemah yang bahkan\Ntak mampu bernapas tanpa dirimu.
Dialogue: 0,0:15:36.80,0:15:37.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berdiri.
Dialogue: 0,0:15:39.58,0:15:41.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertarung.
Dialogue: 0,0:15:41.70,0:15:44.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, mati!
Dialogue: 0,0:16:05.48,0:16:07.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Inoue.
Dialogue: 0,0:16:08.37,0:16:09.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:16:09.65,0:16:14.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku cuma menarik bajumu sedikit,\Ntapi Kurosaki mau berhenti.
Dialogue: 0,0:16:14.82,0:16:18.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajahmu saat menoleh tak terlihat\Nseperti orang yang kehilangan kendali.
Dialogue: 0,0:16:18.91,0:16:22.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir kamu punya alasan tertentu.
Dialogue: 0,0:16:22.99,0:16:24.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:16:24.63,0:16:29.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada orang yang ingin kubangunkan\Ndengan menabrakkan kekuatan Quincy.
Dialogue: 0,0:16:30.76,0:16:34.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katana-nya... memutih...
Dialogue: 0,0:16:38.62,0:16:42.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.\NTernyata itu yang kamu incar.
Dialogue: 0,0:18:15.55,0:18:19.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bleach:\NThousand-Year Blood War - The Calamity
Dialogue: 0,0:18:23.60,0:18:25.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah. Sudah berakhir.
Dialogue: 0,0:18:30.22,0:18:33.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dihentikan sebentar saja tak bisa, ya.\NTangguh juga dia.
Dialogue: 0,0:18:33.84,0:18:39.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pikir bisa menghentikanku\Ndengan trik es seperti ini, hah?!
Dialogue: 0,0:18:46.60,0:18:47.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:18:51.60,0:18:54.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak terlalu suka "mukjizat"...
Dialogue: 0,0:18:54.80,0:18:55.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kuat.
Dialogue: 0,0:18:56.76,0:18:57.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar.
Dialogue: 0,0:18:57.94,0:19:02.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bukan lawan mudah untuk satu lawan satu.\NBiar kubantu.
Dialogue: 0,0:19:02.18,0:19:03.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:19:03.28,0:19:07.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau selisih tingginya sebesar ini,\Ndua lawan satu pun tak terhitung curang.
Dialogue: 0,0:19:09.30,0:19:10.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa menatapku begitu?
Dialogue: 0,0:19:10.95,0:19:13.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau bilang selisih tinggi kita\Nsudah ada sejak awal?
Dialogue: 0,0:19:15.03,0:19:16.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:19:16.40,0:19:18.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku... tidak bermaksud begitu.
Dialogue: 0,0:19:19.30,0:19:20.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:19:20.15,0:19:21.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa minta maaf?!
Dialogue: 0,0:19:21.31,0:19:24.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah terbata-bata begitu,\Ntapi tetap minta maaf. Lihat ke sini!
Dialogue: 0,0:19:29.85,0:19:34.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini? Apa semua orang setingkat Kapten\Nsudah dikalahkan?
Dialogue: 0,0:19:35.80,0:19:37.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memalukan!
Dialogue: 0,0:19:37.57,0:19:40.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang merepotkan itu datang.
Dialogue: 0,0:19:42.16,0:19:45.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangan kanan... Tangan kananku!
Dialogue: 0,0:19:46.79,0:19:49.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kini bertambah kuat!
Dialogue: 0,0:19:49.33,0:19:52.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan itu? Kenapa bisa?
Dialogue: 0,0:19:52.06,0:19:56.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kekuatannya. Bagian tubuh yang terluka\Nakan membesar dan menguat.
Dialogue: 0,0:19:56.59,0:19:58.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:19:58.31,0:20:01.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti awalnya dia tak setinggi ini.
Dialogue: 0,0:20:02.90,0:20:06.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Kalau mau bilang sesuatu, katakan saja.
Dialogue: 0,0:20:06.26,0:20:08.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada. Kamu terlalu sensitif.
Dialogue: 0,0:20:09.76,0:20:11.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menarik!
Dialogue: 0,0:20:11.44,0:20:16.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku jadi ingin lihat apa yang\Nterjadi kalau kucincang dia sampai kecil!
Dialogue: 0,0:20:16.23,0:20:18.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si bodoh itu...!
Dialogue: 0,0:20:21.29,0:20:22.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang apa kau?
Dialogue: 0,0:20:23.03,0:20:26.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku tidak menahan diri,\Nkau akan ikut terbelah dua.
Dialogue: 0,0:20:26.74,0:20:29.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kamu lebih perhatian\Ndaripada kelihatannya.
Dialogue: 0,0:20:29.28,0:20:31.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Ntolong tambah lagi perhatiannya.
Dialogue: 0,0:20:31.66,0:20:34.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Maksudmu?
Dialogue: 0,0:20:34.16,0:20:38.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku, bagaimana kalau dia makin besar\Nlalu jatuh ke bawah sana?
Dialogue: 0,0:20:38.72,0:20:42.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kenapa-kenapa.\NAku akan ikut turun dan menebasnya.
Dialogue: 0,0:20:42.92,0:20:46.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada orang sebesar dia\Njatuh dari ketinggian ini,
Dialogue: 0,0:20:46.18,0:20:48.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seluruh Seireitei bisa hancur!
Dialogue: 0,0:21:04.65,0:21:07.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau terlalu bawel!
Dialogue: 0,0:21:07.28,0:21:12.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya, aku tak boleh main-main\Ndan langsung menghancurkan kepalanya, 'kan?
Dialogue: 0,0:21:14.60,0:21:15.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zaraki!
Dialogue: 0,0:21:17.63,0:21:22.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kuat juga karena\Nbisa membuatku terjatuh.
Dialogue: 0,0:21:22.51,0:21:25.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggan berbuat terlalu kejam,\Ntapi apa boleh buat.
Dialogue: 0,0:21:25.97,0:21:29.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perwujudan kegelapan sekuat dirimu
Dialogue: 0,0:21:29.41,0:21:32.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan menjadi noda di atas Hoffnung milikku!
Dialogue: 0,0:21:33.36,0:21:36.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka itu tak mempan ditebas.
Dialogue: 0,0:21:36.00,0:21:39.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tameng yang kokoh\Ndan tubuh yang tangguh, ya.
Dialogue: 0,0:21:39.86,0:21:42.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi makin ingin membunuhmu.
Dialogue: 0,0:21:42.61,0:21:44.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Telan.
Dialogue: 0,0:21:46.56,0:21:48.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nozarashi.
Dialogue: 0,0:21:48.49,0:21:51.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu? Shikai?
Dialogue: 0,0:21:51.49,0:21:54.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kapan si Zaraki itu...
Dialogue: 0,0:21:54.04,0:21:59.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti katana miliknya\Nbukan tipe pelepasan konstan, ya.
Dialogue: 0,0:21:59.30,0:22:01.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan. Lebih tepatnya,
Dialogue: 0,0:22:01.61,0:22:06.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pelepasan konstan itu memang tak pernah ada.
Dialogue: 0,0:22:21.83,0:22:26.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodohnya kau. Bilah Hoffnung-nya gompal!
Dialogue: 0,0:22:31.72,0:22:33.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senbonzakura Kageyoshi.
Dialogue: 0,0:22:33.53,0:22:35.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hyouryuu Senbi
Dialogue: 0,0:22:37.36,0:22:38.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zekkuu!
Dialogue: 0,0:22:49.16,0:22:52.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kalian begitu mengidamkan keputusasaan?
Dialogue: 0,0:22:52.10,0:22:55.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan ini? Bagaimana bisa?
Dialogue: 0,0:22:55.72,0:22:59.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kalian bingung?\NKekuatanku adalah "Miracle".
Dialogue: 0,0:22:59.55,0:23:03.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Miracle" adalah mewujudkan\Nharapan orang-orang menjadi nyata!
Dialogue: 0,0:23:03.48,0:23:08.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuhku yang tak bisa dihancurkan ini\Nmembesar mengikuti "ketakutan" orang lain.
Dialogue: 0,0:23:08.16,0:23:12.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hoffnung adalah pedang yang terbuat\Ndari kumpulan harapan orang-orang.
Dialogue: 0,0:23:12.12,0:23:15.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika patah, ia akan menjadi keputusasaan!
Dialogue: 0,0:23:15.33,0:23:18.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Gerard Valkyrie!
Dialogue: 0,0:23:18.86,0:23:23.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku adalah mukjizat, dan mukjizat adalah aku!
Dialogue: 0,0:23:37.86,0:23:39.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Transformasi
Dialogue: 0,0:23:41.36,0:23:42.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari nyawaku.
