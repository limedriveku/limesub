Dialogue: 0,0:16:08.63,0:16:12.63,sign,,0000,0000,0000,,BLEACH #41 DEWA PETIR
Dialogue: 0,0:17:41.18,0:17:43.54,sign,,0000,0000,0000,,SAAT HALAMAN KUBALIK, KAMU PUN BERUBAH
Dialogue: 0,0:23:45.21,0:23:51.76,sign,,0000,0000,0000,,BLEACH #42 PUTRA KEGELAPAN
Dialogue: 0,0:00:29.90,0:00:31.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah pagi, ya.
Dialogue: 0,0:00:31.88,0:00:34.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mimpi yang indah.
Dialogue: 0,0:00:41.25,0:00:44.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makin buruk mimpinya, makin baik.
Dialogue: 0,0:00:47.06,0:00:49.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa lihat.
Dialogue: 0,0:00:49.07,0:00:53.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga bisa lihat penderitaan kalian.
Dialogue: 0,0:00:53.99,0:00:58.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kalah, Jugo.
Dialogue: 0,0:00:58.90,0:01:02.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga bisa melihat kesetiaanmu.
Dialogue: 0,0:01:02.80,0:01:06.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai putra yang terlahir dalam kegelapan.
Dialogue: 0,0:01:08.90,0:01:10.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Datanglah.
Dialogue: 0,0:01:13.20,0:01:16.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak seorang pun mampu hentikan aku.
Dialogue: 0,0:02:44.83,0:02:49.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bleach:\NThousand-Year Blood War - The Calamity
Dialogue: 0,0:03:22.01,0:03:23.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatannya dan Yhwach
Dialogue: 0,0:03:23.70,0:03:26.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan tertukar saat Yhwach sedang terlelap.
Dialogue: 0,0:03:27.50,0:03:28.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul.
Dialogue: 0,0:03:28.52,0:03:32.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini Yhwach kehilangan\Nkekuatan "Mahakuasa dan Mahatahu".
Dialogue: 0,0:03:32.30,0:03:35.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yhwach ada di lantai teratas Wahrwelt.
Dialogue: 0,0:03:35.30,0:03:37.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergilah ke atas, Kurosaki.
Dialogue: 0,0:03:37.46,0:03:38.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ishida.
Dialogue: 0,0:03:38.90,0:03:41.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu tetap akan tinggal di sini?
Dialogue: 0,0:03:41.66,0:03:45.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, jika dia mewarisi kekuatan Yhwach,\Nbukankah lebih baik...
Dialogue: 0,0:03:45.31,0:03:48.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan banyak omong!\NCepat pergi!
Dialogue: 0,0:03:49.00,0:03:51.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan kata-kata terakhirku, kok.
Dialogue: 0,0:04:17.61,0:04:19.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tak apa, Inoue?
Dialogue: 0,0:04:20.57,0:04:23.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Aku baik-baik saja. Entah kenapa...
Dialogue: 0,0:04:23.90,0:04:26.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal ini membuatku sedikit lega.
Dialogue: 0,0:04:26.36,0:04:27.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lega?
Dialogue: 0,0:04:28.58,0:04:29.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:04:29.61,0:04:30.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana bilangnya, ya...?
Dialogue: 0,0:04:31.27,0:04:36.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan berpikir Ishida\Nakan memihak para Quincy,
Dialogue: 0,0:04:37.76,0:04:42.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi mendengar hal itu langsung\Ndari mulutnya justru membuatku lega.
Dialogue: 0,0:04:43.04,0:04:48.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi berpikir,\N"Ah, rupanya Ishida tetaplah Ishida"...
Dialogue: 0,0:04:51.43,0:04:52.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa ini?!
Dialogue: 0,0:05:10.90,0:05:11.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chad!
Dialogue: 0,0:05:11.71,0:05:12.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sado!
Dialogue: 0,0:05:12.94,0:05:15.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku aman. Kalian pergi saja!
Dialogue: 0,0:05:22.36,0:05:23.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:05:23.70,0:05:25.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita mulai.
Dialogue: 0,0:05:25.67,0:05:28.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadilah pasir!
Dialogue: 0,0:05:30.09,0:05:31.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rupanya Ganju.
Dialogue: 0,0:05:31.16,0:05:32.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu dari mana saja?
Dialogue: 0,0:05:32.27,0:05:34.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok malah tanya aku, sih?!
Dialogue: 0,0:05:34.30,0:05:36.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian yang meninggalkan aku, tahu!
Dialogue: 0,0:05:36.48,0:05:38.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tersesat karena terpisah dari kalian!
Dialogue: 0,0:05:38.80,0:05:42.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, aku malah muncul\Ndi momen yang sangat pas.
Dialogue: 0,0:05:42.66,0:05:45.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jarang-jarang bisa ketemu patung batu!
Dialogue: 0,0:05:45.06,0:05:47.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak sabar ingin\Ngunakan Seppa pada mereka!
Dialogue: 0,0:05:47.81,0:05:49.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Heh, dengarkan aku!
Dialogue: 0,0:05:49.66,0:05:50.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menyimak, kok.
Dialogue: 0,0:05:50.75,0:05:51.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ternyata kamu menyimak!
Dialogue: 0,0:05:51.91,0:05:54.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus, kenapa tidak tunjukkan reaksi?!
Dialogue: 0,0:05:56.46,0:05:59.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ganju, kamu suka pekerjaan yang membosankan?
Dialogue: 0,0:06:02.14,0:06:05.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ichigo hanya melihat jalan\Nyang ada di depannya.
Dialogue: 0,0:06:05.40,0:06:06.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti itulah dia.
Dialogue: 0,0:06:07.30,0:06:09.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tugas kita adalah
Dialogue: 0,0:06:09.10,0:06:11.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membereskan semua yang ada di istana
Dialogue: 0,0:06:11.91,0:06:14.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mengamankan jalan pulang\Nuntuk Ichigo dan yang lain.
Dialogue: 0,0:06:30.16,0:06:34.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Haschwalth tak bisa melihat masa depan\Ndengan sempurna.
Dialogue: 0,0:06:34.66,0:06:37.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terkejut. Ishida Uryuu.
Dialogue: 0,0:06:37.90,0:06:40.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu terlihat berbeda\Ndengan beberapa saat lalu.
Dialogue: 0,0:06:40.90,0:06:45.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajahmu yang sekarang\Nterlihat penuh akan harapan.
Dialogue: 0,0:06:45.23,0:06:46.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham sekarang.
Dialogue: 0,0:06:46.86,0:06:50.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlepas dari fakta wajahku\Npenuh harapan atau tidak,
Dialogue: 0,0:06:50.64,0:06:53.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau kamu terkejut saat melihatnya,
Dialogue: 0,0:06:53.86,0:06:58.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berarti sosokku yang penuh harapan ini\N"tidak tertangkap oleh matamu".
Dialogue: 0,0:06:59.98,0:07:04.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu, dia tidak mengiyakan,\Natau membantahku.
Dialogue: 0,0:07:09.78,0:07:11.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bilang padamu,
Dialogue: 0,0:07:11.96,0:07:14.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa melihat semuanya.
Dialogue: 0,0:07:22.50,0:07:24.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku hanya perlu pastikan
Dialogue: 0,0:07:24.76,0:07:27.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia bisa melihat sejauh apa.
Dialogue: 0,0:07:46.73,0:07:48.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kena?
Dialogue: 0,0:07:48.20,0:07:50.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia memang bisa melihat semuanya?
Dialogue: 0,0:07:56.90,0:07:59.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kamu sengaja\Nmempersempit ruang gerak seranganku
Dialogue: 0,0:07:59.70,0:08:02.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan menempatkan tembok\Ndan langit-langit di belakangmu.
Dialogue: 0,0:08:02.96,0:08:06.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang benar,\Naku hanya perlu fokus pada hal di depanku.
Dialogue: 0,0:08:06.43,0:08:10.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ishida Uryuu, pujian untukmu karena\Nbertarung menggunakan otakmu.
Dialogue: 0,0:08:10.76,0:08:14.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas saja kamu menyandang\Njabatan "Grandmaster".
Dialogue: 0,0:08:14.16,0:08:17.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, pujian itu tak membuatku senang.
Dialogue: 0,0:08:29.11,0:08:32.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyawamu berada dalam genggamanku.
Dialogue: 0,0:08:48.50,0:08:52.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, tubuhku dipenuhi\Noleh kekuatan Yang Mulia.
Dialogue: 0,0:08:52.86,0:08:56.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil kamu bisa merebut\Nkekuatan ini dariku.
Dialogue: 0,0:08:57.39,0:09:01.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ishida Uryuu,\Nkamu tidak akan bisa menjadi aku.
Dialogue: 0,0:09:01.46,0:09:03.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku adalah belahan diri Yang Mulia.
Dialogue: 0,0:09:03.63,0:09:07.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akulah Quincy yang lahir\Nuntuk berada di samping beliau.
Dialogue: 0,0:09:07.57,0:09:11.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maka dari itu, Yang Mulia memercayakan\Nkekuatan ini padaku.
Dialogue: 0,0:09:14.40,0:09:15.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa lihat
Dialogue: 0,0:09:15.80,0:09:18.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa yang akan terjadi saat ini?
Dialogue: 0,0:09:22.08,0:09:25.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu...?!
Dialogue: 0,0:09:25.52,0:09:27.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah tujuan sejati Yang Mulia.
Dialogue: 0,0:09:29.64,0:09:31.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kena!
Dialogue: 0,0:09:31.31,0:09:35.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jinta Homerun!
Dialogue: 0,0:09:39.72,0:09:42.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Retakan apa itu?
Dialogue: 0,0:09:43.13,0:09:46.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu mirip dengan "distorsi"\Nyang Pak Kisuke selidiki.
Dialogue: 0,0:09:47.38,0:09:48.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahan dulu sebentar!
Dialogue: 0,0:09:48.83,0:09:51.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Distorsi" itu kan gumpalan\Nenergi yang berbahaya!
Dialogue: 0,0:09:51.88,0:09:54.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah Manajer dan yang lain\Nsudah pergi memperbaikinya?
Dialogue: 0,0:09:54.53,0:09:57.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya, sih... begitu.
Dialogue: 0,0:09:57.46,0:10:00.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kota ini dalam bahaya, dong...
Dialogue: 0,0:10:00.20,0:10:03.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, ralat. Dunia ini yang dalam bahaya.\NYa, 'kan? Tessai.
Dialogue: 0,0:10:04.59,0:10:06.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manajer...
Dialogue: 0,0:10:08.92,0:10:11.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuan sejati, katamu?
Dialogue: 0,0:10:11.42,0:10:14.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua berjalan sesuai rencana Yang Mulia.
Dialogue: 0,0:10:14.86,0:10:18.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua dimulai saat kami\Nmelancarkan invasi ke Soul Society.
Dialogue: 0,0:10:18.80,0:10:21.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan memusnahkan\Nsejumlah besar Hollow di dunia nyata,
Dialogue: 0,0:10:21.80,0:10:24.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}keseimbangan jiwa kini\Nterganggu secara besar-besaran.
Dialogue: 0,0:10:25.26,0:10:29.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak shinigami yang tertipu\Nkarena invasi kami.
Dialogue: 0,0:10:29.48,0:10:33.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditambah gugurnya Yamamoto Genryusai\Ndan para anggota Skuad 0,
Dialogue: 0,0:10:33.77,0:10:38.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}keseimbangan dunia ini telah terguncang\Nhingga ke akarnya.
Dialogue: 0,0:10:39.15,0:10:42.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, Raja Jiwa yang menopang tiga dunia
Dialogue: 0,0:10:42.24,0:10:45.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kini menjadi bagian dari kekuatan Yang Mulia.
Dialogue: 0,0:10:45.08,0:10:47.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Retakan itu adalah
Dialogue: 0,0:10:47.09,0:10:49.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tanda awal lenyapnya ketiga dunia.
Dialogue: 0,0:10:50.37,0:10:52.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menghilangnya dunia...
Dialogue: 0,0:10:54.37,0:10:56.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sebenarnya ingin kalian lakukan?
Dialogue: 0,0:10:56.83,0:10:58.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pernah dengar juga, bukan?
Dialogue: 0,0:10:59.70,0:11:00.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Welt".
Dialogue: 0,0:11:02.39,0:11:05.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menciptakan dunia yang baru.
Dialogue: 0,0:11:05.35,0:11:07.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menghancurkan seluruh tiga dunia,
Dialogue: 0,0:11:07.65,0:11:11.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan membangun kerajaan Quincy untuk Quincy.
Dialogue: 0,0:11:11.86,0:11:14.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu adalah tujuan sejati Yang Mulia Raja,
Dialogue: 0,0:11:14.25,0:11:18.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kewajiban Sternritter\Nkepada saudara sebangsa.
Dialogue: 0,0:11:19.86,0:11:23.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak "melihatmu" di tempat itu.
Dialogue: 0,0:11:27.28,0:11:29.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menghukum pengkhianat
Dialogue: 0,0:11:30.62,0:11:32.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah kewajibanku juga.
Dialogue: 0,0:11:41.70,0:11:44.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu berbicara\Nseperti juru bicara Yang Mulia saja.
Dialogue: 0,0:11:47.13,0:11:51.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah mendengar perkataanmu tadi,\Naku dapat satu tugas baru.
Dialogue: 0,0:11:51.64,0:11:57.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, mengalahkanmu dan melenyapkan\N"Mahakuasa dan Mahatahu".
Dialogue: 0,0:11:57.11,0:12:00.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang satu lagi adalah melenyapkan retakan ini
Dialogue: 0,0:12:01.63,0:12:03.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk melindungi ketiga dunia.
Dialogue: 0,0:12:19.45,0:12:22.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa sangka tanpa bergerak pun...
Dialogue: 0,0:12:30.26,0:12:32.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa selamat dari itu.
Dialogue: 0,0:12:33.13,0:12:34.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa rasakan.
Dialogue: 0,0:12:34.56,0:12:37.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasakan kematian makin menjauh dariku.
Dialogue: 0,0:12:38.15,0:12:42.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika "imunitas" adalah metode pemungkas\Nuntuk menghindari kematian,
Dialogue: 0,0:12:42.46,0:12:45.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berarti ini juga berkat "imunitas".
Dialogue: 0,0:12:46.80,0:12:48.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada pendapat?
Dialogue: 0,0:12:49.10,0:12:51.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shihoin Yoruichi.
Dialogue: 0,0:12:52.77,0:12:54.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, maaf.
Dialogue: 0,0:12:54.96,0:12:57.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak menyimak karena\Nkukira kamu bicara sendiri.
Dialogue: 0,0:12:58.05,0:13:01.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin yang benar itu "tak sempat menyimak".
Dialogue: 0,0:13:01.09,0:13:06.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melempar Gift Ball berisi campuran\Nreishi, oksigen, dan nitrogen ke arahmu.
Dialogue: 0,0:13:06.56,0:13:10.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin kamu sempat\Nmenyimak monolog tidak jelas.
Dialogue: 0,0:13:10.50,0:13:11.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, tapi...
Dialogue: 0,0:13:11.94,0:13:15.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur, aku heran kamu\Ntidak mati dalam kondisi itu.
Dialogue: 0,0:13:16.24,0:13:17.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga sama.
Dialogue: 0,0:13:17.70,0:13:20.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kamu sudah mengatur\Ndosis fatal seperti itu...
Dialogue: 0,0:13:20.70,0:13:24.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku heran kamu masih mengatur dosisnya\Nsupaya tidak membunuhku,
Dialogue: 0,0:13:24.80,0:13:26.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi juga tak membiarkanku pulih.
Dialogue: 0,0:13:26.95,0:13:31.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu salah.\NAku sudah berusaha sebisaku.
Dialogue: 0,0:13:31.43,0:13:34.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang selain kamu sudah pasti mati.
Dialogue: 0,0:13:35.79,0:13:38.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa berhenti bicara seolah\Naku ini berbelas kasih,
Dialogue: 0,0:13:38.63,0:13:42.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}cuma untuk menutupi fakta\Nbahwa kamu memang monster?
Dialogue: 0,0:13:42.91,0:13:44.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga bisa sedih.
Dialogue: 0,0:13:51.86,0:13:55.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dibiarkan saja,\NYushiro tidak akan bertahan lama.
Dialogue: 0,0:13:55.06,0:13:59.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku tak bisa mengobatinya\Ndengan kondisiku sekarang.
Dialogue: 0,0:14:00.37,0:14:01.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:14:01.97,0:14:03.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma saja.
Dialogue: 0,0:14:04.42,0:14:07.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak tahu kamu sedang merencanakan apa,
Dialogue: 0,0:14:07.20,0:14:09.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kamu sudah terlalu sekarat\Nuntuk bisa bereaksi
Dialogue: 0,0:14:09.50,0:14:11.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ketika aku sudah sedekat ini.
Dialogue: 0,0:14:13.41,0:14:15.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun rencana yang terpikir olehmu,
Dialogue: 0,0:14:15.70,0:14:18.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku yakin bisa bertindak lebih dulu.
Dialogue: 0,0:14:18.74,0:14:21.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidakkah kamu berpikir ini cukup fatal?
Dialogue: 0,0:14:21.43,0:14:24.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Shihoin Yoruichi.
Dialogue: 0,0:14:24.06,0:14:24.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar!
Dialogue: 0,0:14:25.70,0:14:28.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagian itu\Nmemang ketatnya fatal, ya, Yoruichi.
Dialogue: 0,0:14:28.45,0:14:30.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daguku!
Dialogue: 0,0:14:30.19,0:14:33.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu menendangku\Nyang datang jauh-jauh untuk membantu?
Dialogue: 0,0:14:33.05,0:14:35.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaliknya, kenapa kamu berpikir\Ntidak akan kutendang?!
Dialogue: 0,0:14:35.18,0:14:37.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat ke sini, berhenti menatap bokongku!
Dialogue: 0,0:14:38.20,0:14:42.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf. Pilihan kataku tadi\Nkedengaran cukup vulgar, ya.
Dialogue: 0,0:14:42.71,0:14:44.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak menendangmu karena itu!
Dialogue: 0,0:14:44.61,0:14:46.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan minta maaf sambil memegang bokongku!
Dialogue: 0,0:14:46.44,0:14:48.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urahara Kisuke, ya.
Dialogue: 0,0:14:48.67,0:14:51.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada orang merepotkan lain yang datang.
Dialogue: 0,0:14:51.59,0:14:53.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kamu kenal aku?
Dialogue: 0,0:14:53.98,0:14:55.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebuah kehormatan.
Dialogue: 0,0:14:55.41,0:14:57.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih dari sekadar kenal.
Dialogue: 0,0:14:57.16,0:14:59.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mungkin tidak tahu,
Dialogue: 0,0:14:59.00,0:15:03.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kamu termasuk Kekuatan Perang Khusus\Nyang disebutkan Yang Mulia.
Dialogue: 0,0:15:03.50,0:15:08.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh, aku baru tahu dimasukkan\Nke dalam grup sehebat itu.
Dialogue: 0,0:15:08.56,0:15:11.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang, sih, tapi kalian berlebihan.
Dialogue: 0,0:15:11.64,0:15:14.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, 'kan? Yoruichi.
Dialogue: 0,0:15:17.06,0:15:18.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?!
Dialogue: 0,0:15:20.56,0:15:22.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang dia lakukan?
Dialogue: 0,0:15:22.47,0:15:24.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Shihoin Yoruichi bisa bergerak?
Dialogue: 0,0:15:25.05,0:15:27.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia menetralkan Deathdealing-ku?
Dialogue: 0,0:15:27.55,0:15:28.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana bisa?!
Dialogue: 0,0:15:30.86,0:15:33.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, dia seperti yang kudengar.
Dialogue: 0,0:15:34.69,0:15:38.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lima orang Kekuatan Perang Khusus terpilih\Nkarena "variabel yang tak terhitung".
Dialogue: 0,0:15:38.34,0:15:40.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurosaki Ichigo karena "potensi"-nya.
Dialogue: 0,0:15:41.26,0:15:43.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zaraki Kenpachi karena\N"kekuatan bertarung"-nya.
Dialogue: 0,0:15:43.80,0:15:46.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hyousube Ichibe karena "kebijaksanaan"-nya.
Dialogue: 0,0:15:46.21,0:15:48.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aizen Sousuke karena "reiatsu"-nya.
Dialogue: 0,0:15:49.34,0:15:52.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, variabel tak terhitung\Ndari Urahara Kisuke adalah
Dialogue: 0,0:15:52.20,0:15:54.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"metode"!
Dialogue: 0,0:15:54.33,0:15:56.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebanyak apa pun siasat yang kugunakan,
Dialogue: 0,0:15:56.91,0:15:58.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia selalu selangkah di depan!
Dialogue: 0,0:15:58.80,0:16:01.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar ahli segala intrik\Ndan tipu muslihat!
Dialogue: 0,0:16:02.08,0:16:05.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, kenapa selalu aku
Dialogue: 0,0:16:05.46,0:16:08.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang bertemu orang-orang seperti ini?!
Dialogue: 0,0:16:15.26,0:16:17.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menyuntikkan apa ke bokongku?
Dialogue: 0,0:16:18.54,0:16:20.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rahasia.
Dialogue: 0,0:16:20.41,0:16:23.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paling-paling peningkat imunitas\Nyang diam-diam kamu buat
Dialogue: 0,0:16:23.40,0:16:26.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selama menguping pembicaraan kami.
Dialogue: 0,0:16:26.71,0:16:28.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yoruichi memang jagonya.
Dialogue: 0,0:16:28.60,0:16:29.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu cepat paham, deh!
Dialogue: 0,0:16:29.96,0:16:32.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena dibuat dadakan, efeknya cuma sebentar.
Dialogue: 0,0:16:32.86,0:16:33.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa lama?
Dialogue: 0,0:16:34.73,0:16:36.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurang lebih, lima menit.
Dialogue: 0,0:16:37.06,0:16:38.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu cukup!
Dialogue: 0,0:16:38.06,0:16:39.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shunko:
Dialogue: 0,0:16:39.45,0:16:42.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Raijin Senkei!\N- Tunggu dulu, Yoruichi.
Dialogue: 0,0:16:43.14,0:16:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa, sih?
Dialogue: 0,0:16:43.78,0:16:45.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu masih perlu denganku?
Dialogue: 0,0:16:45.52,0:16:47.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita pakai "itu", yuk.
Dialogue: 0,0:16:47.48,0:16:48.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mau!
Dialogue: 0,0:16:48.66,0:16:50.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawabnya cepat banget.
Dialogue: 0,0:16:50.74,0:16:54.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya, kasih kesempatan untuk jelaskan,\Natau negosiasi, dong.
Dialogue: 0,0:16:54.64,0:16:58.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak sudi pakai wujud setengah-setengah\Ndan menjijikkan itu lagi!
Dialogue: 0,0:16:59.23,0:17:01.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya. Sayang sekali.
Dialogue: 0,0:17:01.93,0:17:04.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya aku enggan, tapi bisa paksa...
Dialogue: 0,0:17:07.26,0:17:09.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ups. Sayang, aku meleset.
Dialogue: 0,0:17:13.92,0:17:14.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ini, ya.
Dialogue: 0,0:17:15.43,0:17:18.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan saja mengamuk sekarang
Dialogue: 0,0:17:18.01,0:17:19.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}setelah bisa bergerak lagi.
Dialogue: 0,0:17:24.68,0:17:30.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang menghantammu dengan Gift Ball\Nsaat kamu dalam kondisi prima, lo.
Dialogue: 0,0:17:30.36,0:17:33.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru pulih sedikit sudah merasa\Nbisa menang, ya?
Dialogue: 0,0:17:36.40,0:17:37.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yoruichi!
Dialogue: 0,0:17:43.67,0:17:44.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:17:51.63,0:17:54.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Apa yang terjadi?
Dialogue: 0,0:18:02.68,0:18:06.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pe-Penampilan macam apa itu?
Dialogue: 0,0:18:08.70,0:18:11.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apaan, sih? Jangan abaikan aku!
Dialogue: 0,0:18:11.86,0:18:14.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shunko: Raiju Senkei.
Dialogue: 0,0:18:14.74,0:18:16.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Shunryu Kokubyo Senki."
Dialogue: 0,0:18:17.50,0:18:18.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah.
Dialogue: 0,0:18:19.44,0:18:21.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang "begitulah".
Dialogue: 0,0:18:21.30,0:18:23.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa malah kamu yang jawab?
Dialogue: 0,0:18:25.54,0:18:27.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Jangan bilang...
Dialogue: 0,0:18:27.60,0:18:30.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang itu tidak mengerti bahasa manusia lagi?
Dialogue: 0,0:18:41.51,0:18:43.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar saja!
Dialogue: 0,0:18:51.90,0:18:53.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?!
Dialogue: 0,0:18:53.30,0:18:56.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya aku sudah imun\Npada reiatsu miliknya!
Dialogue: 0,0:18:56.74,0:18:58.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reiatsu shinigami yang sama
Dialogue: 0,0:18:58.61,0:19:00.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mustahil berubah di tengah pertarungan.
Dialogue: 0,0:19:00.43,0:19:01.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya ini?!
Dialogue: 0,0:19:01.91,0:19:03.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena "suasana hati".
Dialogue: 0,0:19:04.23,0:19:07.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya suasana hati kucing itu\Nberubah-ubah, 'kan?
Dialogue: 0,0:19:07.36,0:19:09.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reiatsu Yoruichi\Ndalam kondisi "Kokubyo Senki"
Dialogue: 0,0:19:09.89,0:19:11.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan menunjukkan sifat itu.
Dialogue: 0,0:19:11.92,0:19:15.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, dia tidak mengejarmu lagi, 'kan?
Dialogue: 0,0:19:15.00,0:19:16.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena memang "sedang ingin" begitu.
Dialogue: 0,0:19:17.23,0:19:20.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yoruichi yang biasanya juga\Nmudah berubah suasana hatinya,
Dialogue: 0,0:19:20.05,0:19:22.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan akan makin parah\Nsaat sedang seperti itu.
Dialogue: 0,0:19:22.89,0:19:25.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reiatsu-nya juga sama,
Dialogue: 0,0:19:25.73,0:19:27.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ia mudah terpengaruh kondisi itu.
Dialogue: 0,0:19:28.36,0:19:31.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai seperti reiatsu milik orang lain.
Dialogue: 0,0:19:34.66,0:19:37.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Virus influenza\Nbisa mewabah setiap tahunnya, 'kan?
Dialogue: 0,0:19:37.07,0:19:39.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal bukan varian baru,
Dialogue: 0,0:19:39.25,0:19:41.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sedikit perubahan\Npada sifat antigeniknya,
Dialogue: 0,0:19:41.62,0:19:44.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}virus tipe A yang sama seperti tahun lalu\Nbisa kembali mewabah.
Dialogue: 0,0:19:44.26,0:19:46.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira seperti itu.
Dialogue: 0,0:19:46.20,0:19:49.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau tubuh sudah membangun\Nimunitas berkali-kali,
Dialogue: 0,0:19:49.20,0:19:51.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}satu perubahan kecil saja semua jadi percuma.
Dialogue: 0,0:19:52.17,0:19:58.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu, proses mendapatkan imunitasmu\Nluar biasa cepat.
Dialogue: 0,0:19:58.17,0:20:02.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setiap menerima serangan dari musuh,\Nkamu secara refleks meneliti reiatsu mereka,
Dialogue: 0,0:20:02.80,0:20:05.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu menciptakan imunitas\Ndarinya dengan sangat cepat.
Dialogue: 0,0:20:06.56,0:20:11.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam satu menit,\Nkamu bisa menetralkan serangan apa pun.
Dialogue: 0,0:20:11.06,0:20:13.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kamu masih kurang cepat.
Dialogue: 0,0:20:13.23,0:20:15.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena reiatsu Yoruichi\Ndalam mode Kokubyo Senki
Dialogue: 0,0:20:16.23,0:20:18.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa berubah 48 kali dalam satu detik.
Dialogue: 0,0:20:40.50,0:20:42.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke!
Dialogue: 0,0:20:43.73,0:20:45.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yoruichi!
Dialogue: 0,0:20:45.38,0:20:47.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya "Yorumata", lo.
Dialogue: 0,0:20:47.16,0:20:48.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sini, sini.
Dialogue: 0,0:20:49.17,0:20:50.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meong?
Dialogue: 0,0:20:50.24,0:20:51.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meong!
Dialogue: 0,0:20:51.65,0:20:52.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh!
Dialogue: 0,0:21:00.43,0:21:02.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang, sayang.
Dialogue: 0,0:21:03.03,0:21:04.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada-ada saja.
Dialogue: 0,0:21:04.56,0:21:07.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelemahannya memang\N"hanya aku yang bisa kendalikan"
Dialogue: 0,0:21:07.00,0:21:11.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan "hanya bisa kembali seperti semula\Nkalau dia sendiri mau".
Dialogue: 0,0:21:11.08,0:21:15.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, Yoruichi dalam wujud ini\Njuga manis, sih,
Dialogue: 0,0:21:15.53,0:21:18.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku tidak keberatan sama sekali.
Dialogue: 0,0:21:18.08,0:21:21.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, benar juga. Sudah hampir lima menit.
Dialogue: 0,0:21:21.65,0:21:24.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Efek peningkat imunitasnya\Nsudah hampir habis.
Dialogue: 0,0:21:24.27,0:21:26.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus, Yoruichi.
Dialogue: 0,0:21:26.86,0:21:29.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti racunnya\Nkita keluarkan pelan-pelan, ya.
Dialogue: 0,0:21:29.55,0:21:33.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pergi cari mayatnya dulu sebentar,\Ndan pastikan dia sudah mati.
Dialogue: 0,0:21:43.61,0:21:45.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan... ini?
Dialogue: 0,0:21:46.56,0:21:48.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gift Ball Deluxe.
Dialogue: 0,0:21:49.58,0:21:52.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gift Ball terbesar yang bisa kubuat.
Dialogue: 0,0:21:52.60,0:21:53.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ups.
Dialogue: 0,0:21:53.87,0:21:56.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan yang itu, ya?
Dialogue: 0,0:21:56.06,0:21:59.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu lebih penasaran dengan wujud ini?
Dialogue: 0,0:21:59.20,0:22:01.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya "Hass Hein".
Dialogue: 0,0:22:01.96,0:22:04.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan nama yang keren, 'kan?
Dialogue: 0,0:23:30.53,0:23:35.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bleach:\NThousand-Year Blood War - The Calamity
Dialogue: 0,0:23:38.43,0:23:40.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tebar racun sana-sini,
Dialogue: 0,0:23:42.03,0:23:44.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kepala pusing tak berhenti, 'kan?
