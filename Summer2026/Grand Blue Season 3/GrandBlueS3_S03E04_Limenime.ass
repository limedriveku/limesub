Dialogue: 0,0:00:00.00,0:00:00.27,sign,,0000,0000,0000,,ACARA INI ADALAH KARYA FIKSI.
Dialogue: 0,0:00:00.27,0:00:00.58,sign,,0000,0000,0000,,ANAK DI BAWAH UMUR DILARANG KERAS\NMINUM ALKOHOL OLEH HUKUM.
Dialogue: 0,0:00:00.58,0:00:01.09,sign,,0000,0000,0000,,KAMI JUGA TIDAK BERMAKSUD MENGANJURKAN\NPEMAKSAAN MINUM ALKOHOL,
Dialogue: 0,0:00:01.09,0:00:01.79,sign,,0000,0000,0000,,KONSUMSI ALKOHOL BERLEBIHAN, MAUPUN TINDAKAN\NTIDAK SENONOH SAAT PESTA MINUM.
Dialogue: 0,0:00:01.79,0:00:02.40,sign,,0000,0000,0000,,MOHON ANGGAP INI SEMATA-MATA\NSEBAGAI ANIME KOMEDI.
Dialogue: 0,0:00:02.40,0:00:03.10,sign,,0000,0000,0000,,SELURUH KARAKTER YANG MENGONSUMSI\NALKOHOL DALAM KARYA INI
Dialogue: 0,0:00:03.10,0:00:03.68,sign,,0000,0000,0000,,TELAH BERUSIA 20 TAHUN ATAU LEBIH.
Dialogue: 0,0:00:03.68,0:00:04.38,sign,,0000,0000,0000,,DEMI MENYESUAIKAN DENGAN STANDAR\NKEPATUHAN TERKINI.
Dialogue: 0,0:00:04.38,0:00:04.98,sign,,0000,0000,0000,,MULAI MUSIM INI\NUKURAN SENSOR HITAM KAMI NAIK 5%.
Dialogue: 0,0:00:04.98,0:00:06.99,sign,,0000,0000,0000,,TERMINAL 12 BANDARA NARITA
Dialogue: 0,0:01:05.92,0:01:07.30,sign,,0000,0000,0000,,BANDARA INTERNASIONAL PALAU
Dialogue: 0,0:01:22.94,0:01:24.94,sign,,0000,0000,0000,,DOLPHIN
Dialogue: 0,0:01:36.45,0:01:39.45,sign,,0000,0000,0000,,DOLPHIN
Dialogue: 0,0:02:12.28,0:02:20.33,sign,,0000,0000,0000,,GRAND BLUE MUSIM 3
Dialogue: 0,0:03:54.51,0:03:56.51,sign,,0000,0000,0000,,BESOK ADA KEMAH DADAKAN DI PULAU\NTIDAK BERPENGHUNI, SIAPA MAU IKUT?
Dialogue: 0,0:04:04.67,0:04:07.27,sign,,0000,0000,0000,,HARI SELANJUTNYA
Dialogue: 0,0:04:07.27,0:04:11.77,sign,,0000,0000,0000,,BERSULANG
Dialogue: 0,0:04:16.77,0:04:18.77,sign,,0000,0000,0000,,PERTEMUAN TIDAK TERDUGA!
Dialogue: 0,0:04:20.82,0:04:23.78,sign,,0000,0000,0000,,BAHAYA, RAWA TAK BERDASAR
Dialogue: 0,0:04:28.79,0:04:31.70,sign,,0000,0000,0000,,HAMAOKA AZUSA
Dialogue: 0,0:04:31.70,0:04:34.80,sign,,0000,0000,0000,,PERTEMUAN TIDAK TERDUGA!
Dialogue: 0,0:09:37.97,0:09:41.98,sign,,0000,0000,0000,,PUSAT PENYELAMAN PALAU PASIFIK
Dialogue: 0,0:09:48.98,0:09:51.25,sign,,0000,0000,0000,,PUSAT PENYELAMAN PALAU PASIFIK
Dialogue: 0,0:11:38.59,0:11:42.37,sign,,0000,0000,0000,,DAFTAR TUGAS
Dialogue: 0,0:11:42.37,0:11:43.52,sign,,0000,0000,0000,,DEKORASI TOKO (SUDAH)
Dialogue: 0,0:11:43.52,0:11:47.10,sign,,0000,0000,0000,,SIMULASI MELAYANI TAMU (BELUM)
Dialogue: 0,0:11:54.61,0:12:00.12,sign,,0000,0000,0000,,MANAJER KOTEGAWA
Dialogue: 0,0:13:42.34,0:13:43.61,sign,,0000,0000,0000,,CATATAN KESEHATAN, RIWAYAT PARTISIPASI
Dialogue: 0,0:13:43.61,0:13:46.85,sign,,0000,0000,0000,,BACA DENGAN SAKSAMA SEBELUM MENGISI
Dialogue: 0,0:13:52.35,0:13:54.52,sign,,0000,0000,0000,,PERNAH PINGSAN ATAU TIDAK SADARKAN DIRI
Dialogue: 0,0:13:54.52,0:13:55.44,sign,,0000,0000,0000,,SERING MABUK KENDARAAN ATAU PUNYA
Dialogue: 0,0:13:55.44,0:13:56.48,sign,,0000,0000,0000,,MABUK KENDARAAN YANG PARAH
Dialogue: 0,0:13:56.48,0:13:57.36,sign,,0000,0000,0000,,TIDAK DAPAT MELAKUKAN AKTIVITAS BERAT
Dialogue: 0,0:18:53.04,0:18:56.91,sign,,0000,0000,0000,,LAUT ALAMI PALAU
Dialogue: 0,0:18:56.91,0:18:58.45,sign,,0000,0000,0000,,DUNIA BIRU
Dialogue: 0,0:20:51.81,0:20:54.93,sign,,0000,0000,0000,,PENYEMANGATNYA APA? TENTU SAJA CHISA...
Dialogue: 0,0:20:54.93,0:20:56.53,sign,,0000,0000,0000,,MAKSUDNYA SENYUMAN PELANGGAN
Dialogue: 0,0:23:44.94,0:23:49.95,sign,,0000,0000,0000,,SELANJUTNYA: LIPUTAN TV
Dialogue: 0,0:00:09.44,0:00:11.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti kita transit di Guam, ya?
Dialogue: 0,0:00:11.89,0:00:12.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:00:12.99,0:00:16.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti kita akan menginjak Amerika dulu?
Dialogue: 0,0:00:16.72,0:00:19.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan tertangkap\Nkarena barang bokep, ya, Kouhei.
Dialogue: 0,0:00:19.79,0:00:22.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar aturan di sana ketat.
Dialogue: 0,0:00:24.99,0:00:26.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlihatkan isi tasmu.
Dialogue: 0,0:00:26.72,0:00:29.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau bawa apa, sih?
Dialogue: 0,0:00:33.76,0:00:36.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih baik daripada kena sita, kan?
Dialogue: 0,0:00:36.46,0:00:38.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung ketahuan sebelum terbang.
Dialogue: 0,0:00:38.94,0:00:41.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa berabe nantinya.
Dialogue: 0,0:00:41.27,0:00:47.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, jadi kalau di Guam ada buku porno,\Nkamu tidak akan beli, kan?
Dialogue: 0,0:00:47.28,0:00:49.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:00:51.31,0:00:52.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikan tasmu.
Dialogue: 0,0:00:52.46,0:00:54.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuh, kan.
Dialogue: 0,0:01:07.30,0:01:09.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, akhirnya sampai.
Dialogue: 0,0:01:09.62,0:01:11.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah larut malam.
Dialogue: 0,0:01:12.91,0:01:15.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Transit ke Guam lumayan makan waktu.
Dialogue: 0,0:01:15.81,0:01:18.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, dari sini harus bagaimana?
Dialogue: 0,0:01:18.72,0:01:21.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setahuku akan ada yang menjemput.
Dialogue: 0,0:01:21.44,0:01:22.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang itu?
Dialogue: 0,0:01:24.94,0:01:28.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,\Njadwal musim panas kali ini padat, ya.
Dialogue: 0,0:01:28.56,0:01:29.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:01:29.19,0:01:32.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemah di pulau tidak berpenghuni\Ndengan Nona Kaya.
Dialogue: 0,0:01:32.05,0:01:33.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergi ke rumah Iori juga.
Dialogue: 0,0:01:33.66,0:01:36.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang mesum itu konyol banget.
Dialogue: 0,0:01:36.45,0:01:39.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Onsennya nikmat sekali.
Dialogue: 0,0:01:39.45,0:01:41.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedengarannya seru, tuh.
Dialogue: 0,0:01:41.74,0:01:42.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, halo.
Dialogue: 0,0:01:42.96,0:01:45.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak sebegitunya, kok.
Dialogue: 0,0:01:45.84,0:01:48.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, itu pasti seru banget.
Dialogue: 0,0:01:48.46,0:01:49.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:01:52.22,0:01:55.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya seru banget pas tidak ada aku.
Dialogue: 0,0:01:56.35,0:01:57.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Me...
Dialogue: 0,0:01:57.22,0:01:59.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menor?
Dialogue: 0,0:03:30.45,0:03:32.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok kamu bisa di sini?
Dialogue: 0,0:03:32.26,0:03:33.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak pulang kampung?
Dialogue: 0,0:03:33.73,0:03:36.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulang, kok, ini baru bebas.
Dialogue: 0,0:03:36.34,0:03:39.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiap hari aku banting tulang.
Dialogue: 0,0:03:39.60,0:03:42.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari-hari itu sangat berat.
Dialogue: 0,0:03:42.53,0:03:45.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja yang gesit, woi!
Dialogue: 0,0:03:45.31,0:03:47.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja keras bagai kuda!
Dialogue: 0,0:03:48.25,0:03:52.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, para senior juga\Nmungkin sedang sibuk cari kerja.
Dialogue: 0,0:03:52.24,0:03:54.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti semuanya sedang susah.
Dialogue: 0,0:03:56.51,0:03:57.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakek.
Dialogue: 0,0:03:57.74,0:03:58.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:03:58.67,0:04:01.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini, aku tidak sanggup kerja lagi.
Dialogue: 0,0:04:02.22,0:04:04.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:04:04.67,0:04:07.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tebus dosamu kemarin!
Dialogue: 0,0:04:07.27,0:04:10.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti mereka sedang bersenang-senang
Dialogue: 0,0:04:10.33,0:04:11.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di pulau tidak berpenghuni.
Dialogue: 0,0:04:11.77,0:04:16.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paling orangnya itu-itu juga,\Ntidak perlu khawatir...
Dialogue: 0,0:04:18.77,0:04:21.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok ada dia, sih?
Dialogue: 0,0:04:21.92,0:04:23.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi?
Dialogue: 0,0:04:23.78,0:04:25.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aina, kamu baik-baik saja?
Dialogue: 0,0:04:25.79,0:04:28.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baik-baik saja, tapi...
Dialogue: 0,0:04:28.79,0:04:31.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa mudaku di ujung tanduk!
Dialogue: 0,0:04:31.70,0:04:34.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang diujung tanduk itu mobilnya!
Dialogue: 0,0:04:34.80,0:04:38.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benda ini bikin kerjamu kacau!
Dialogue: 0,0:04:38.02,0:04:40.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, ponselku!
Dialogue: 0,0:04:40.24,0:04:42.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya miris banget.
Dialogue: 0,0:04:42.22,0:04:43.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oh.
Dialogue: 0,0:04:43.50,0:04:46.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah karena apa,\Ntampaknya kamu menderita.
Dialogue: 0,0:04:46.31,0:04:49.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, setelah ponselku kembali.
Dialogue: 0,0:04:49.04,0:04:52.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahunya kalian pesta takoyaki\Ndan ke rumah Iori.
Dialogue: 0,0:04:52.27,0:04:53.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ponselmu disita?
Dialogue: 0,0:04:53.94,0:04:56.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas saja tidak bisa dihubungi.
Dialogue: 0,0:04:56.57,0:04:59.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang malah ke Palau pula!
Dialogue: 0,0:04:59.57,0:05:05.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal sudah dibilang,\Njangan seru-seruan tanpa aku.
Dialogue: 0,0:05:05.08,0:05:06.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya seru?
Dialogue: 0,0:05:06.58,0:05:09.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih banyak ricuhnya.
Dialogue: 0,0:05:09.73,0:05:11.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kapan kamu kemari?
Dialogue: 0,0:05:11.68,0:05:14.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua hari lalu, transit dari Taipei.
Dialogue: 0,0:05:14.09,0:05:16.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti kamu sudah tahu tempatnya?
Dialogue: 0,0:05:16.37,0:05:18.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, yang lebih penting...
Dialogue: 0,0:05:18.75,0:05:20.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau tanya.
Dialogue: 0,0:05:20.56,0:05:21.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, tunggu sebentar.
Dialogue: 0,0:05:23.92,0:05:26.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo ke penginapan dulu.
Dialogue: 0,0:05:28.60,0:05:31.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia John, karyawan Dolphin.
Dialogue: 0,0:05:31.14,0:05:32.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo.
Dialogue: 0,0:05:34.36,0:05:36.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bisa bahasa Jepang?
Dialogue: 0,0:05:36.22,0:05:38.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya aku juga kaget.
Dialogue: 0,0:05:38.08,0:05:40.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa sedikit bahasa Jepang.
Dialogue: 0,0:05:41.07,0:05:42.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Kouhei.
Dialogue: 0,0:05:42.32,0:05:43.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa, Kitahara?
Dialogue: 0,0:05:43.65,0:05:45.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah lama\Ntidak bertemu si Menor, kan?
Dialogue: 0,0:05:45.97,0:05:49.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, entah apa yang terjadi di sana.
Dialogue: 0,0:05:49.37,0:05:51.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, bikin penasaran.
Dialogue: 0,0:05:53.87,0:05:56.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bikin penasaran banget!
Dialogue: 0,0:05:56.38,0:05:57.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba tanya sana.
Dialogue: 0,0:05:57.55,0:05:59.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ogah, kamu saja sana.
Dialogue: 0,0:05:59.82,0:06:01.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau dia menunggu ditanggapi?
Dialogue: 0,0:06:01.65,0:06:03.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa saja, sih.
Dialogue: 0,0:06:04.70,0:06:07.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa dadaku dipandangi terus?
Dialogue: 0,0:06:08.03,0:06:09.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian...
Dialogue: 0,0:06:10.35,0:06:12.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penasaran, ya?
Dialogue: 0,0:06:13.27,0:06:15.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau direspons begitu...
Dialogue: 0,0:06:15.13,0:06:17.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan sangat memuakkan.
Dialogue: 0,0:06:17.71,0:06:19.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, abaikan saja.
Dialogue: 0,0:06:19.58,0:06:21.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, abaikan sa—
Dialogue: 0,0:06:24.51,0:06:26.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melorot, jir!
Dialogue: 0,0:06:26.28,0:06:27.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minimal pasang yang benar!
Dialogue: 0,0:06:27.98,0:06:30.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ceroboh banget jadi orang!
Dialogue: 0,0:06:30.29,0:06:32.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba suruh Kotegawa.
Dialogue: 0,0:06:32.00,0:06:35.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang cuma Chisa\Nyang bisa menanyakannya, sih.
Dialogue: 0,0:06:35.76,0:06:38.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya, bahasa Jepang\Nlumayan umum di Palau.
Dialogue: 0,0:06:38.78,0:06:40.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakai bahasa Jepang saja.
Dialogue: 0,0:06:40.55,0:06:44.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti "sampai besok"\Natau "udaranya dingin".
Dialogue: 0,0:06:44.55,0:06:47.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata bersulang disebut "lepas penat".
Dialogue: 0,0:06:47.89,0:06:49.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu?
Dialogue: 0,0:06:49.87,0:06:52.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, lepas penat.
Dialogue: 0,0:06:52.56,0:06:54.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu,
Dialogue: 0,0:06:54.06,0:06:57.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bra disebut "penyangga dada".
Dialogue: 0,0:06:57.06,0:06:58.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantap!
Dialogue: 0,0:06:58.51,0:07:00.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga penasaran, ya, Chisa?
Dialogue: 0,0:07:00.14,0:07:02.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Trik yang luar biasa!
Dialogue: 0,0:07:05.82,0:07:07.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:07:08.26,0:07:10.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pura-pura tidak tahu!
Dialogue: 0,0:07:10.10,0:07:12.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mentalnya sekuat baja!
Dialogue: 0,0:07:12.08,0:07:14.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi buat apa pakai begituan?
Dialogue: 0,0:07:14.45,0:07:16.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah.
Dialogue: 0,0:07:17.09,0:07:19.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aina, ini tempatnya?
Dialogue: 0,0:07:19.09,0:07:21.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, ini asrama sementara untuk kita.
Dialogue: 0,0:07:21.96,0:07:24.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya asrama utamanya belum jadi.
Dialogue: 0,0:07:24.39,0:07:25.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:07:25.39,0:07:26.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ajib!
Dialogue: 0,0:07:26.84,0:07:29.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini ruang tengahnya.
Dialogue: 0,0:07:30.85,0:07:33.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayak rumah bersama, ya.\NBahkan ada loteng.
Dialogue: 0,0:07:33.83,0:07:34.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:07:34.35,0:07:37.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruang tengah buat bersama,\Ntapi kamarnya terpisah.
Dialogue: 0,0:07:37.50,0:07:38.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:07:38.43,0:07:41.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayak vila sewaan waktu di Okinawa, ya.
Dialogue: 0,0:07:41.79,0:07:42.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin ada kolam renang!
Dialogue: 0,0:07:42.98,0:07:44.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruang bioskop juga!
Dialogue: 0,0:07:44.09,0:07:46.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan keliling sembarangan!
Dialogue: 0,0:07:46.95,0:07:48.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja, Menor!
Dialogue: 0,0:07:48.68,0:07:50.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tidak akan masuk ke kamarmu!
Dialogue: 0,0:07:54.85,0:07:55.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menor...
Dialogue: 0,0:07:55.77,0:07:57.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng, itu...
Dialogue: 0,0:07:57.62,0:08:01.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku niatnya mau bikin sesuatu\Nbuat menyambut kalian,
Dialogue: 0,0:08:01.09,0:08:02.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi gagal...
Dialogue: 0,0:08:02.63,0:08:04.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus!
Dialogue: 0,0:08:04.16,0:08:04.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lah?
Dialogue: 0,0:08:05.88,0:08:08.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu beli itu buat kami, kan?
Dialogue: 0,0:08:08.76,0:08:10.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peka banget!
Dialogue: 0,0:08:10.46,0:08:11.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, iya.
Dialogue: 0,0:08:11.39,0:08:14.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa tahu kalian mau minum saat tiba.
Dialogue: 0,0:08:15.39,0:08:17.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memang hebat!
Dialogue: 0,0:08:17.02,0:08:19.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengertian banget sama kami!
Dialogue: 0,0:08:19.41,0:08:19.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:08:19.90,0:08:21.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dapurnya agak...
Dialogue: 0,0:08:21.68,0:08:23.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Levelnya bukan "agak" lagi, sih.
Dialogue: 0,0:08:23.42,0:08:24.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya juga kamu.
Dialogue: 0,0:08:24.90,0:08:26.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru inilah...
Dialogue: 0,0:08:26.69,0:08:28.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ciri khas si Menor.
Dialogue: 0,0:08:28.51,0:08:30.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian masih saja kurang ajar!
Dialogue: 0,0:08:30.41,0:08:31.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, ayo minum-minum!
Dialogue: 0,0:08:31.99,0:08:32.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:08:33.85,0:08:34.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka kenapa?
Dialogue: 0,0:08:34.85,0:08:36.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, seperti biasa.
Dialogue: 0,0:08:36.89,0:08:37.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:08:37.40,0:08:39.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar.
Dialogue: 0,0:08:39.90,0:08:42.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang kamu ikut juga.
Dialogue: 0,0:08:46.42,0:08:47.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:08:48.92,0:08:50.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk Palau dan...
Dialogue: 0,0:08:50.60,0:08:52.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk kembalinya si Menor.
Dialogue: 0,0:08:52.25,0:08:53.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersulang!
Dialogue: 0,0:08:57.68,0:08:59.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bir di sini enak juga.
Dialogue: 0,0:08:59.57,0:09:02.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minum bir di pulau tropis\Nmemang mantap.
Dialogue: 0,0:09:02.56,0:09:04.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana-mana juga kamu minum.
Dialogue: 0,0:09:05.69,0:09:08.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, besok kita harus apa?
Dialogue: 0,0:09:08.19,0:09:10.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus sudah di toko jam enam pagi.
Dialogue: 0,0:09:10.76,0:09:12.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pagi banget.
Dialogue: 0,0:09:12.40,0:09:14.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tokonya dekat?
Dialogue: 0,0:09:14.37,0:09:16.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, lima menit kalau jalan kaki.
Dialogue: 0,0:09:16.20,0:09:17.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku agak khawatir.
Dialogue: 0,0:09:17.73,0:09:18.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:09:18.36,0:09:19.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal apa?
Dialogue: 0,0:09:19.16,0:09:21.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku susah bangun pagi.
Dialogue: 0,0:09:21.71,0:09:23.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, betul juga.
Dialogue: 0,0:09:23.67,0:09:26.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga kurang yakin kalau besok.
Dialogue: 0,0:09:26.01,0:09:29.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga, soalnya\Nsudah capek di perjalanan.
Dialogue: 0,0:09:29.54,0:09:32.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, waktu kerja kita sudah dekat.
Dialogue: 0,0:09:32.28,0:09:35.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul, ayo tidur supaya tidak telat.
Dialogue: 0,0:09:35.45,0:09:36.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setuju.
Dialogue: 0,0:09:46.85,0:09:48.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pagi yang kacau.
Dialogue: 0,0:09:51.25,0:09:53.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu aku diajarkan para senior.
Dialogue: 0,0:09:53.99,0:09:57.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidur di tempat janjian,\Npasti tidak akan telat.
Dialogue: 0,0:09:57.44,0:10:00.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Idenya bodoh banget!
Dialogue: 0,0:10:00.00,0:10:01.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat bereskan!
Dialogue: 0,0:10:01.56,0:10:04.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di pulau tropis harus pakai baju?
Dialogue: 0,0:10:04.00,0:10:06.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya harus kalau hari pertama kerja.
Dialogue: 0,0:10:06.57,0:10:09.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai akhir juga harus tetap pakai.
Dialogue: 0,0:10:09.01,0:10:11.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Mustahil, lah.\N- Sudahlah, ayo cepat!
Dialogue: 0,0:10:11.84,0:10:13.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berdiri! Jangan diam saja!
Dialogue: 0,0:10:13.95,0:10:18.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah cukup!\NAyo bergegas!
Dialogue: 0,0:10:19.09,0:10:21.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah datang jauh-jauh.
Dialogue: 0,0:10:21.13,0:10:23.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bos?\NSelamat pagi!
Dialogue: 0,0:10:23.52,0:10:24.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pagi.
Dialogue: 0,0:10:24.60,0:10:26.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nih, ambillah juga.
Dialogue: 0,0:10:26.90,0:10:29.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang, Iori, ini permenmu.
Dialogue: 0,0:10:29.72,0:10:31.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:10:32.81,0:10:34.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian saling kenal?
Dialogue: 0,0:10:34.25,0:10:36.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku belum bilang, ya?
Dialogue: 0,0:10:36.73,0:10:38.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tidak berjumpa juga, Chisa.
Dialogue: 0,0:10:39.75,0:10:41.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tidak berjumpa.
Dialogue: 0,0:10:43.35,0:10:44.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu.
Dialogue: 0,0:10:47.00,0:10:48.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibunya...
Dialogue: 0,0:10:48.25,0:10:49.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chisa?
Dialogue: 0,0:10:49.50,0:10:50.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:10:50.80,0:10:53.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga baru tahu?
Dialogue: 0,0:10:53.01,0:10:54.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya sudah ketemu duluan?
Dialogue: 0,0:10:54.84,0:10:56.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, dia tidak bilang apa-apa.
Dialogue: 0,0:10:56.80,0:10:58.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok enggak mirip, ya?
Dialogue: 0,0:10:58.79,0:11:01.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matanya lumayan mirip.
Dialogue: 0,0:11:01.81,0:11:04.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanaka mirip Manajer, ya?
Dialogue: 0,0:11:04.16,0:11:06.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sepemikiran.
Dialogue: 0,0:11:06.75,0:11:09.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemarilah, akan kuperkenalkan para staf.
Dialogue: 0,0:11:10.32,0:11:12.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama tidak berjumpa, kan?
Dialogue: 0,0:11:12.27,0:11:13.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setahuku, iya.
Dialogue: 0,0:11:13.68,0:11:15.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok dingin banget?
Dialogue: 0,0:11:15.47,0:11:16.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:11:16.82,0:11:19.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, begitulah sifatnya.
Dialogue: 0,0:11:19.44,0:11:22.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan diam saja,\Naku benci orang lamban.
Dialogue: 0,0:11:22.83,0:11:24.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf!
Dialogue: 0,0:11:28.83,0:11:32.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal.
Dialogue: 0,0:11:33.13,0:11:35.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pekerjaannya akan dijelaskan Maki.
Dialogue: 0,0:11:36.08,0:11:38.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Maki, instruktur baru.
Dialogue: 0,0:11:38.59,0:11:42.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sudah tahu toko ini baru mau dibuka, kan?
Dialogue: 0,0:11:42.37,0:11:43.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah.
Dialogue: 0,0:11:43.52,0:11:47.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, kita perlu sentuhan terakhir.
Dialogue: 0,0:11:47.64,0:11:50.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami ingin kalian berakting\Njadi tamu yang kesusahan.
Dialogue: 0,0:11:50.72,0:11:53.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat menguji kecakapan staf.
Dialogue: 0,0:11:54.61,0:11:57.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manajer Kotegawa bilang,
Dialogue: 0,0:11:57.28,0:12:00.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian baru dapat lisensi menyelam, kan?
Dialogue: 0,0:12:00.12,0:12:00.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:12:00.71,0:12:02.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:12:02.12,0:12:05.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, katanya kalian kurang waras.
Dialogue: 0,0:12:05.33,0:12:06.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:12:06.12,0:12:08.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar om-om sialan!
Dialogue: 0,0:12:08.12,0:12:12.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami memang cari tukang bantu-bantu,\Ntahunya dapat barang bagus.
Dialogue: 0,0:12:12.45,0:12:15.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah dapat orang yang tepat!
Dialogue: 0,0:12:15.13,0:12:16.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah kaprah, tuh.
Dialogue: 0,0:12:16.96,0:12:19.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manajer suka mengada-ada.
Dialogue: 0,0:12:19.15,0:12:22.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini normal, enggak kayak Kitahara.
Dialogue: 0,0:12:22.39,0:12:26.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, Manajer mengirimkan\Nfoto ini tempo hari.
Dialogue: 0,0:12:26.68,0:12:29.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian memang cocok\Njadi peran enggak waras!
Dialogue: 0,0:12:29.90,0:12:32.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak waras sebelah mananya?
Dialogue: 0,0:12:32.80,0:12:35.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bos, mereka pas banget.
Dialogue: 0,0:12:35.55,0:12:38.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pucuk dicinta, ulam pun tiba.
Dialogue: 0,0:12:38.56,0:12:41.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kita harus berakting jadi tamu?
Dialogue: 0,0:12:41.71,0:12:44.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggal datang saja?
Dialogue: 0,0:12:44.01,0:12:45.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul, tolong, ya.
Dialogue: 0,0:12:46.44,0:12:47.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chisa.
Dialogue: 0,0:12:48.41,0:12:50.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bertugas jadi staf.
Dialogue: 0,0:12:52.31,0:12:53.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:12:54.05,0:12:56.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, harus bagaimana?
Dialogue: 0,0:12:56.51,0:12:57.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Susah juga.
Dialogue: 0,0:12:57.88,0:12:59.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa bingung?
Dialogue: 0,0:12:59.64,0:13:02.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersikap saja seperti biasa.
Dialogue: 0,0:13:03.30,0:13:06.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi.
Dialogue: 0,0:13:06.07,0:13:09.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi, apa tidurmu cukup?
Dialogue: 0,0:13:09.06,0:13:10.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi.
Dialogue: 0,0:13:10.88,0:13:13.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi,\Napa perjalananmu melelahkan?
Dialogue: 0,0:13:14.31,0:13:17.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi.
Dialogue: 0,0:13:19.75,0:13:23.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maki, jangan lupa tanya kondisinya.
Dialogue: 0,0:13:23.12,0:13:25.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik! Eng...
Dialogue: 0,0:13:25.83,0:13:28.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa otakmu sehat?
Dialogue: 0,0:13:28.71,0:13:30.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa begitu?
Dialogue: 0,0:13:30.33,0:13:33.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan gagal fokus oleh penampilan tamu.
Dialogue: 0,0:13:33.08,0:13:36.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, habisnya menor banget.
Dialogue: 0,0:13:36.08,0:13:37.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar seperti biasa.
Dialogue: 0,0:13:37.85,0:13:39.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ucapanmu masuk akal.
Dialogue: 0,0:13:39.77,0:13:42.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi biasanya aku tidak begini, kok.
Dialogue: 0,0:13:42.34,0:13:43.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para tamu.
Dialogue: 0,0:13:43.61,0:13:46.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan baca formulir ketentuannya.
Dialogue: 0,0:13:46.85,0:13:49.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus kesusahan di sesi ini, ya.
Dialogue: 0,0:13:49.61,0:13:51.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana caranya?
Dialogue: 0,0:13:51.19,0:13:52.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:13:52.35,0:13:54.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau bahas poin ini.
Dialogue: 0,0:13:54.52,0:13:57.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mabuk kendaraanku cukup parah.
Dialogue: 0,0:13:57.36,0:13:59.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:13:59.16,0:14:01.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami menyiapkan langkah pencegahan, kok.
Dialogue: 0,0:14:01.52,0:14:03.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketua hebat, bisa fokus!
Dialogue: 0,0:14:03.36,0:14:04.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:14:04.55,0:14:06.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita tiru.
Dialogue: 0,0:14:06.37,0:14:11.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, sebenarnya aku punya asma\Ndan suka sesak kalau melihat Rarako.
Dialogue: 0,0:14:11.87,0:14:14.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seberapa sering gejalanya kambuh?
Dialogue: 0,0:14:14.45,0:14:15.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rarako...
Dialogue: 0,0:14:15.17,0:14:16.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:14:16.03,0:14:16.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya?
Dialogue: 0,0:14:16.88,0:14:20.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, aku hamil.
Dialogue: 0,0:14:20.38,0:14:22.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mentertawakan kondisi tamu.
Dialogue: 0,0:14:22.77,0:14:24.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha-Habisnya...
Dialogue: 0,0:14:24.53,0:14:26.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok malah hamil?
Dialogue: 0,0:14:26.48,0:14:28.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan poin itu yang kubaca.
Dialogue: 0,0:14:28.44,0:14:30.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat.
Dialogue: 0,0:14:31.64,0:14:34.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baju selamnya sewa dari sini, kan?
Dialogue: 0,0:14:34.28,0:14:35.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:14:35.07,0:14:37.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita cek ukuran dulu, ya.
Dialogue: 0,0:14:37.40,0:14:39.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakai ukuran L, ya?
Dialogue: 0,0:14:39.36,0:14:40.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:14:40.40,0:14:42.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ini XL.
Dialogue: 0,0:14:42.17,0:14:43.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:14:43.40,0:14:45.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ukuranmu M.
Dialogue: 0,0:14:45.89,0:14:47.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:14:49.41,0:14:52.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip, ukurannya pas.
Dialogue: 0,0:14:58.54,0:15:01.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maki, kamu sudah kelewatan.
Dialogue: 0,0:15:01.39,0:15:03.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal ini benaran bisa terjadi.
Dialogue: 0,0:15:03.79,0:15:05.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf!
Dialogue: 0,0:15:07.16,0:15:09.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chisa, beri tahu dia.
Dialogue: 0,0:15:09.15,0:15:09.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:15:09.81,0:15:12.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Tapi takutnya...
Dialogue: 0,0:15:12.03,0:15:14.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa malah bingung?
Dialogue: 0,0:15:14.01,0:15:14.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketua.
Dialogue: 0,0:15:15.27,0:15:16.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:15:17.73,0:15:19.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bantalannya geser, tuh.
Dialogue: 0,0:15:19.48,0:15:20.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:15:20.44,0:15:21.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:15:21.88,0:15:23.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama-sama.
Dialogue: 0,0:15:23.17,0:15:25.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gila, jago banget!
Dialogue: 0,0:15:25.45,0:15:28.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memang tidak becus.
Dialogue: 0,0:15:28.45,0:15:32.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bukankah menyadarkannya\Nsecara halus juga benar?
Dialogue: 0,0:15:32.47,0:15:35.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah, kamu tidak memahami\Nperasaan tamu.
Dialogue: 0,0:15:37.46,0:15:40.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut kalian,\Nkenapa dia pakai bantalan?
Dialogue: 0,0:15:40.44,0:15:41.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng...
Dialogue: 0,0:15:41.64,0:15:43.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:15:44.46,0:15:47.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, karena ada cowok yang dia sukai.
Dialogue: 0,0:15:51.22,0:15:55.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Staf cewek bertugas memberitahunya
Dialogue: 0,0:15:55.59,0:15:58.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebelum si cowok sadar lebih dulu.
Dialogue: 0,0:15:58.29,0:15:59.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masuk akal.
Dialogue: 0,0:15:59.24,0:16:01.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:16:01.01,0:16:05.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, seharusnya cewek paham soal ini.
Dialogue: 0,0:16:05.48,0:16:07.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kamu tidak.
Dialogue: 0,0:16:09.17,0:16:11.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lanjutkanlah sampai ke laut nanti.
Dialogue: 0,0:16:11.79,0:16:12.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lah?
Dialogue: 0,0:16:12.49,0:16:14.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami boleh menyelam?
Dialogue: 0,0:16:14.35,0:16:16.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski baru hari pertama?
Dialogue: 0,0:16:16.61,0:16:18.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru bolehnya cuma sekarang.
Dialogue: 0,0:16:18.60,0:16:20.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sudah buka,\Nkalian bakal sibuk bantu-bantu.
Dialogue: 0,0:16:21.23,0:16:22.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih!
Dialogue: 0,0:16:25.26,0:16:27.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lajunya cepat sekali!
Dialogue: 0,0:16:27.23,0:16:28.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inikah yang disebut kapal cepat?
Dialogue: 0,0:16:28.76,0:16:31.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian bisa duduk\Ndi depan kursi kemudi, lo.
Dialogue: 0,0:16:31.16,0:16:32.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, aku mau coba!
Dialogue: 0,0:16:38.27,0:16:40.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantap!
Dialogue: 0,0:16:40.27,0:16:43.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski laut Okinawa bagus,\Nini juga tidak kalah!
Dialogue: 0,0:16:44.21,0:16:45.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Indah, ya?
Dialogue: 0,0:16:49.84,0:16:51.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menor?
Dialogue: 0,0:16:53.78,0:16:55.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Airnya jernih banget.
Dialogue: 0,0:16:55.77,0:16:58.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak ada ombak,\Nmungkin dasarnya kelihatan.
Dialogue: 0,0:16:58.79,0:17:01.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi enggak sabar menyelam.
Dialogue: 0,0:17:01.95,0:17:03.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama.
Dialogue: 0,0:17:03.29,0:17:05.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah mencari tahu soal laut Palau?
Dialogue: 0,0:17:05.89,0:17:07.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sedikit.
Dialogue: 0,0:17:07.80,0:17:10.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin melihat pusaran barakuda.
Dialogue: 0,0:17:10.56,0:17:12.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, pasti keren!
Dialogue: 0,0:17:12.25,0:17:15.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau kawanan ikan kuwe\Nyang menyerupai dinding.
Dialogue: 0,0:17:15.25,0:17:18.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, aku pernah lihat fotonya\Nsebelum kemari!
Dialogue: 0,0:17:18.08,0:17:19.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan yang terpenting...
Dialogue: 0,0:17:19.81,0:17:21.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manta!
Dialogue: 0,0:17:21.00,0:17:23.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pengin banget melihatnya langsung!
Dialogue: 0,0:17:23.81,0:17:26.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manta sudah kayak maskotnya Palau.
Dialogue: 0,0:17:26.56,0:17:28.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, ada juga...
Dialogue: 0,0:17:30.07,0:17:31.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, lihat ke sana.
Dialogue: 0,0:17:41.83,0:17:43.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lumba-lumba liar!
Dialogue: 0,0:17:43.31,0:17:45.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menakjubkan!
Dialogue: 0,0:17:45.34,0:17:46.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:17:46.87,0:17:48.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian beruntung, ya.
Dialogue: 0,0:17:48.65,0:17:50.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ja-Jangan terlalu ke pinggir.
Dialogue: 0,0:17:50.84,0:17:51.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chisa.
Dialogue: 0,0:17:51.75,0:17:52.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya?
Dialogue: 0,0:17:52.53,0:17:54.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terlalu kaku.
Dialogue: 0,0:17:54.85,0:17:55.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya...
Dialogue: 0,0:17:55.89,0:17:57.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tugas instruktur adalah
Dialogue: 0,0:17:57.85,0:18:00.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menjamin keselamatan semaksimal mungkin
Dialogue: 0,0:18:00.56,0:18:03.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan memberikan pengalaman menyenangkan.
Dialogue: 0,0:18:04.29,0:18:07.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan kita juga harus selalu tersenyum.
Dialogue: 0,0:18:08.51,0:18:10.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, akan kuperbaiki.
Dialogue: 0,0:18:10.76,0:18:14.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, yang terakhir memang sulit, sih.
Dialogue: 0,0:18:14.11,0:18:17.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya, instruktur juga manusia.
Dialogue: 0,0:18:22.87,0:18:25.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Spot ini disebut Blue Corner.
Dialogue: 0,0:18:25.73,0:18:29.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini spot paling terkenal di Palau,\Nnikmatilah penyelamannya.
Dialogue: 0,0:18:29.49,0:18:30.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:18:46.69,0:18:48.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:18:48.44,0:18:51.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru masuk langsung banyak ikan.
Dialogue: 0,0:18:51.44,0:18:53.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya...
Dialogue: 0,0:18:53.04,0:18:54.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu menyelam saat masih kecil,
Dialogue: 0,0:18:54.95,0:18:56.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku langsung terpukau.
Dialogue: 0,0:18:56.91,0:18:58.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:19:07.55,0:19:09.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas saja.
Dialogue: 0,0:19:13.01,0:19:17.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak heran kalau ini\Nmengubah pandangan hidupku.
Dialogue: 0,0:19:23.70,0:19:27.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus.
Dialogue: 0,0:19:27.23,0:19:29.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana laut Palaunya?
Dialogue: 0,0:19:29.02,0:19:30.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa!
Dialogue: 0,0:19:30.98,0:19:33.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka seindah ini.
Dialogue: 0,0:19:33.42,0:19:35.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bersyukur ikut klub menyelam.
Dialogue: 0,0:19:35.74,0:19:37.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang mendengarnya.
Dialogue: 0,0:19:40.24,0:19:41.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah selesai?
Dialogue: 0,0:19:41.81,0:19:43.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah.
Dialogue: 0,0:19:43.25,0:19:44.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat.
Dialogue: 0,0:19:44.37,0:19:45.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:19:45.75,0:19:49.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita terlena dan lupa jadi tamu kesusahan.
Dialogue: 0,0:19:49.62,0:19:51.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya juga.
Dialogue: 0,0:19:51.25,0:19:52.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:19:52.88,0:19:54.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:19:54.76,0:19:59.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertingkah antusias sebagai pemula saja\Ncukup buat simulasi, kerja bagus.
Dialogue: 0,0:19:59.41,0:20:01.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kadang bikin waswas, sih.
Dialogue: 0,0:20:01.68,0:20:02.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setuju.
Dialogue: 0,0:20:02.69,0:20:04.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baguslah kalau begitu.
Dialogue: 0,0:20:04.78,0:20:06.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa, sih?
Dialogue: 0,0:20:06.77,0:20:09.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian pasti lelah\Nhabis menyelam tiga sesi.
Dialogue: 0,0:20:09.18,0:20:10.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:20:10.53,0:20:12.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya juga masuk air.
Dialogue: 0,0:20:12.52,0:20:14.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kerja sambilannya seru.
Dialogue: 0,0:20:14.77,0:20:17.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengalaman yang menyenangkan.
Dialogue: 0,0:20:17.27,0:20:19.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bos baik banget.
Dialogue: 0,0:20:19.03,0:20:21.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara apa kalian?
Dialogue: 0,0:20:21.37,0:20:23.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pekerjaan utamanya baru dimulai.
Dialogue: 0,0:20:23.29,0:20:24.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:20:25.04,0:20:27.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Latihan melayani tamu selesai.
Dialogue: 0,0:20:27.37,0:20:29.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat angkut tangki kosongnya.
Dialogue: 0,0:20:29.35,0:20:31.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rawat dan bersihkan peralatannya.
Dialogue: 0,0:20:31.39,0:20:34.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu siapkan perlengkapan untuk besok,\Nbersih-bersih, dan...
Dialogue: 0,0:20:34.77,0:20:37.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar saja!
Dialogue: 0,0:20:39.80,0:20:41.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Badanku lemas.
Dialogue: 0,0:20:41.69,0:20:44.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habis bangun pagi dan berenang di laut...
Dialogue: 0,0:20:44.75,0:20:47.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langsung kerja berat\Ndan menyiapkan ini dan itu.
Dialogue: 0,0:20:47.81,0:20:50.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah terbiasa begini?
Dialogue: 0,0:20:50.16,0:20:51.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lumayan.
Dialogue: 0,0:20:51.81,0:20:54.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanaka hebat, bisa begini tiap hari
Dialogue: 0,0:20:54.93,0:20:56.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sambil tetap tersenyum.
Dialogue: 0,0:20:56.53,0:20:57.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setuju.
Dialogue: 0,0:20:57.94,0:21:00.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal pasti ada kalanya dia lelah.
Dialogue: 0,0:21:03.45,0:21:07.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, ayo minum sedikit saja\Ndan tidur cepat biar besok aman.
Dialogue: 0,0:21:07.29,0:21:08.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul.
Dialogue: 0,0:21:08.41,0:21:10.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih tetap minum?
Dialogue: 0,0:21:12.21,0:21:18.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat tidur.
Dialogue: 0,0:21:18.19,0:21:20.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menghabiskan ini dulu.
Dialogue: 0,0:21:20.72,0:21:23.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, ternyata memang tidak bisa\Nnonton anime!
Dialogue: 0,0:21:23.44,0:21:25.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu belum berubah, ya.
Dialogue: 0,0:21:31.02,0:21:34.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah, copot saja itu.
Dialogue: 0,0:21:34.09,0:21:36.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, tidak enak dipandang, ya.
Dialogue: 0,0:21:36.54,0:21:38.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi-lagi begini.
Dialogue: 0,0:21:39.03,0:21:42.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum terbiasa\Ndan ini suka geser karena kebesaran.
Dialogue: 0,0:21:42.34,0:21:44.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:21:44.03,0:21:47.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus kenapa pakai begituan?
Dialogue: 0,0:21:49.52,0:21:50.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terserah aku, lah.
Dialogue: 0,0:21:50.90,0:21:53.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku, sih, tidak peduli.
Dialogue: 0,0:21:55.04,0:21:59.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meja dingin ini nyaman sekali.
Dialogue: 0,0:22:02.24,0:22:03.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Menor.
Dialogue: 0,0:22:03.58,0:22:04.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:22:04.53,0:22:07.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf kalau aku salah paham.
Dialogue: 0,0:22:08.05,0:22:11.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaanmu pada Kitahara...
