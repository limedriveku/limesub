Dialogue: 0,0:00:00.00,0:00:00.27,sign,,0000,0000,0000,,ACARA INI ADALAH KARYA FIKSI.
Dialogue: 0,0:00:00.27,0:00:00.58,sign,,0000,0000,0000,,ANAK DI BAWAH UMUR DILARANG KERAS\NMINUM ALKOHOL OLEH HUKUM.
Dialogue: 0,0:00:00.58,0:00:01.09,sign,,0000,0000,0000,,KAMI JUGA TIDAK BERMAKSUD MENGANJURKAN\NPEMAKSAAN MINUM ALKOHOL,
Dialogue: 0,0:00:01.09,0:00:01.79,sign,,0000,0000,0000,,KONSUMSI ALKOHOL BERLEBIHAN, MAUPUN TINDAKAN\NTIDAK SENONOH SAAT PESTA MINUM.
Dialogue: 0,0:00:01.79,0:00:02.40,sign,,0000,0000,0000,,MOHON ANGGAP INI SEMATA-MATA\NSEBAGAI ANIME KOMEDI.
Dialogue: 0,0:00:02.40,0:00:03.10,sign,,0000,0000,0000,,SELURUH KARAKTER YANG MENGONSUMSI\NALKOHOL DALAM KARYA INI
Dialogue: 0,0:00:03.10,0:00:03.68,sign,,0000,0000,0000,,TELAH BERUSIA 20 TAHUN ATAU LEBIH.
Dialogue: 0,0:00:03.68,0:00:04.38,sign,,0000,0000,0000,,DEMI MENYESUAIKAN DENGAN STANDAR\NKEPATUHAN TERKINI.
Dialogue: 0,0:00:04.38,0:00:05.00,sign,,0000,0000,0000,,MULAI MUSIM INI\NUKURAN SENSOR HITAM KAMI NAIK 5%.
Dialogue: 0,0:00:27.30,0:00:35.31,sign,,0000,0000,0000,,GRAND BLUE MUSIM 3
Dialogue: 0,0:05:51.75,0:05:52.27,sign,,0000,0000,0000,,ATASAN
Dialogue: 0,0:06:00.93,0:06:04.51,sign,,0000,0000,0000,,BAHAYA
Dialogue: 0,0:10:13.18,0:10:13.72,sign,,0000,0000,0000,,PUSAT PENYELAMAN PALAU PASIFIK
Dialogue: 0,0:10:31.94,0:10:36.85,sign,,0000,0000,0000,,PUSAT PENYELAMAN PALAU PASIFIK
Dialogue: 0,0:12:15.05,0:12:19.23,sign,,0000,0000,0000,,OBSESI PORNOGRAFI TIDAK WAJAR
Dialogue: 0,0:12:19.23,0:12:21.05,sign,,0000,0000,0000,,TATAPAN CABUL SAAT MELIHAT LAWAN JENIS
Dialogue: 0,0:13:37.50,0:13:41.76,sign,,0000,0000,0000,,BIASANYA
Dialogue: 0,0:14:33.69,0:14:35.69,sign,,0000,0000,0000,,HANCUR
Dialogue: 0,0:17:08.08,0:17:09.04,sign,,0000,0000,0000,,PAB KELAS SATU
Dialogue: 0,0:17:57.79,0:17:58.88,sign,,0000,0000,0000,,LOVE HOTEL, PENYELAMAT HIDUP 2 MINGGU SEKALI
Dialogue: 0,0:17:58.88,0:18:00.07,sign,,0000,0000,0000,,ISTIRAHAT (2 JAM) 4.000 YEN
Dialogue: 0,0:18:00.07,0:18:00.80,sign,,0000,0000,0000,,MENGINAP (PUKUL 10 MALAM–12 SIANG) 7.000 YEN
Dialogue: 0,0:18:21.16,0:18:23.81,sign,,0000,0000,0000,,DUNIA BIRU 2
Dialogue: 0,0:20:58.49,0:21:04.49,sign,,0000,0000,0000,,GRRRRR
Dialogue: 0,0:23:44.99,0:23:49.99,sign,,0000,0000,0000,,SELANJUTNYA: IBU
Dialogue: 0,0:00:05.00,0:00:06.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun.
Dialogue: 0,0:00:06.47,0:00:08.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sungguh bodoh.
Dialogue: 0,0:00:09.53,0:00:14.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah jelas begitu, masih saja mengelak.
Dialogue: 0,0:01:50.26,0:01:54.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka Kouhei menyadarinya.
Dialogue: 0,0:01:54.79,0:01:57.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaanmu pada Kitahara...
Dialogue: 0,0:01:57.73,0:02:01.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi seharusnya belum ketahuan sepenuhnya.
Dialogue: 0,0:02:03.37,0:02:06.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya aku harus pura-pura bodoh!
Dialogue: 0,0:02:07.02,0:02:08.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi.
Dialogue: 0,0:02:08.15,0:02:10.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pagi.
Dialogue: 0,0:02:11.03,0:02:14.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Giliran kita yang bikin sarapan, ya?
Dialogue: 0,0:02:14.28,0:02:16.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, mau bikin apa?
Dialogue: 0,0:02:16.24,0:02:18.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daging kaleng masih ada...
Dialogue: 0,0:02:18.23,0:02:19.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Kitahara.
Dialogue: 0,0:02:20.55,0:02:23.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menggantikanmu bikin sarapan.
Dialogue: 0,0:02:23.29,0:02:25.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa tiba-tiba?
Dialogue: 0,0:02:25.04,0:02:28.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pengin saja.\NAyo, Kotegawa.
Dialogue: 0,0:02:34.30,0:02:36.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kenapa, sih?
Dialogue: 0,0:02:38.81,0:02:43.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pagi ini kita harus mengambil peralatan,\Nmemperbarui blog, dan menyusun nota.
Dialogue: 0,0:02:43.91,0:02:45.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana bagi tugasnya?
Dialogue: 0,0:02:45.81,0:02:48.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Blog dan nota enak karena dalam ruangan.
Dialogue: 0,0:02:48.97,0:02:50.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita suit.
Dialogue: 0,0:02:50.59,0:02:53.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku saja yang ambil peralatan.
Dialogue: 0,0:02:53.24,0:02:54.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:02:54.32,0:02:55.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di luar panas, lo.
Dialogue: 0,0:02:55.97,0:02:59.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aman, aku memang pengin berjemur.
Dialogue: 0,0:02:59.83,0:03:03.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, karena pasti fokus bekerja...
Dialogue: 0,0:03:03.58,0:03:07.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan kembali selama dua jam.
Dialogue: 0,0:03:09.28,0:03:11.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia lagi demam, ya?
Dialogue: 0,0:03:16.85,0:03:19.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menor, tolong berikan tehnya.
Dialogue: 0,0:03:19.21,0:03:20.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:03:20.35,0:03:21.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sini gelasnya.
Dialogue: 0,0:03:22.43,0:03:23.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:03:24.77,0:03:26.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harmonis sekali, ya.
Dialogue: 0,0:03:26.84,0:03:28.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa, sih?
Dialogue: 0,0:03:28.10,0:03:31.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian kayak pasutri\Nyang sudah lama menikah.
Dialogue: 0,0:03:31.65,0:03:34.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma minta teh, lo.
Dialogue: 0,0:03:34.11,0:03:36.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya, sih...
Dialogue: 0,0:03:36.36,0:03:39.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian pacaran saja!
Dialogue: 0,0:03:39.37,0:03:41.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar bego!
Dialogue: 0,0:03:41.91,0:03:42.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kenapa?
Dialogue: 0,0:03:42.87,0:03:44.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu yang kenapa!
Dialogue: 0,0:03:44.41,0:03:46.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan kamu dari pagi?
Dialogue: 0,0:03:46.87,0:03:49.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa lihat sendiri, kan?
Dialogue: 0,0:03:49.72,0:03:52.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, mau menjailiku?
Dialogue: 0,0:03:52.25,0:03:53.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jail apanya?
Dialogue: 0,0:03:53.38,0:03:57.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andaikan! Secara ajaib!\NWalau mustahil!
Dialogue: 0,0:03:57.69,0:03:59.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalaupun aku jatuh cinta!
Dialogue: 0,0:03:59.89,0:04:03.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tingkah kayak tadi\Ncuma memperburuk situasi!
Dialogue: 0,0:04:06.95,0:04:08.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paham?
Dialogue: 0,0:04:08.35,0:04:09.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham.
Dialogue: 0,0:04:09.90,0:04:11.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tsundere, ya?
Dialogue: 0,0:04:11.77,0:04:14.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuharap dia hilang di gunung saja!
Dialogue: 0,0:04:14.15,0:04:17.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku sudah menyangkal mati-matian.
Dialogue: 0,0:04:18.23,0:04:21.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal yang kita bahas kemarin\Nbenaran cuma salah paham!
Dialogue: 0,0:04:21.91,0:04:26.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, mungkin malah mencurigakan\Nkalau aku menyangkal.
Dialogue: 0,0:04:26.53,0:04:30.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus cuek biar dia bosan sendiri.
Dialogue: 0,0:04:31.32,0:04:33.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terserah kamu saja, lah.
Dialogue: 0,0:04:33.21,0:04:34.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:04:35.67,0:04:38.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan saja padaku.
Dialogue: 0,0:04:38.19,0:04:39.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ogah banget.
Dialogue: 0,0:04:41.93,0:04:43.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Kitahara.
Dialogue: 0,0:04:43.48,0:04:44.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:04:44.43,0:04:46.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu suka ramalan cinta?
Dialogue: 0,0:04:46.41,0:04:47.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:04:48.51,0:04:50.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obrolanmu menjijikkan.
Dialogue: 0,0:04:50.83,0:04:54.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga ABG sepertimu pasti suka!
Dialogue: 0,0:04:54.37,0:04:56.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu budek, ya?
Dialogue: 0,0:04:56.19,0:04:59.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan meramalmu.
Dialogue: 0,0:05:00.13,0:05:01.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan saja.
Dialogue: 0,0:05:01.70,0:05:04.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ambil satu kartu.
Dialogue: 0,0:05:04.32,0:05:05.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:05:06.20,0:05:07.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu dapat apa?
Dialogue: 0,0:05:07.73,0:05:09.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiga wajik.
Dialogue: 0,0:05:09.21,0:05:11.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip, semua sudah jelas!
Dialogue: 0,0:05:11.28,0:05:14.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa cuma dari satu kartu?
Dialogue: 0,0:05:14.21,0:05:16.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiga wajik berarti...
Dialogue: 0,0:05:16.96,0:05:20.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jodohmu dekat, sebaya, gadis desa,\Nkalau dandan menor abis,
Dialogue: 0,0:05:20.95,0:05:23.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mendambakan kisah cinta
Dialogue: 0,0:05:23.85,0:05:25.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seperti di drama.
Dialogue: 0,0:05:25.04,0:05:26.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ramalannya detail banget!
Dialogue: 0,0:05:28.47,0:05:30.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak usah meramal, deh.
Dialogue: 0,0:05:30.59,0:05:31.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:05:33.48,0:05:35.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Kitahara.
Dialogue: 0,0:05:35.03,0:05:36.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa lagi?
Dialogue: 0,0:05:36.48,0:05:38.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau coba tes kepribadian?
Dialogue: 0,0:05:38.48,0:05:39.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:05:39.45,0:05:40.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa bedanya!
Dialogue: 0,0:05:41.12,0:05:42.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuanmu apa, sih?
Dialogue: 0,0:05:42.93,0:05:45.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin tahu perasaanmu.
Dialogue: 0,0:05:45.57,0:05:47.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Amit-amit jabang bayi.
Dialogue: 0,0:05:47.24,0:05:48.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita mulai.
Dialogue: 0,0:05:48.59,0:05:50.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun.
Dialogue: 0,0:05:50.07,0:05:51.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia masih saja bersedia.
Dialogue: 0,0:05:52.27,0:05:56.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang penting di tempat kerja\Nmengajakmu makan-makan.
Dialogue: 0,0:05:56.47,0:06:00.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di jamuan itu, ada makanan\Nyang sangat kamu tidak sukai.
Dialogue: 0,0:06:00.93,0:06:03.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tindakanmu?
Dialogue: 0,0:06:03.03,0:06:04.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah pertanyaannya.
Dialogue: 0,0:06:04.51,0:06:07.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanan yang tidak kusukai, ya?
Dialogue: 0,0:06:07.99,0:06:09.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tindakanmu?
Dialogue: 0,0:06:09.15,0:06:10.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Eh, aku juga?
Dialogue: 0,0:06:10.52,0:06:14.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan berusaha menghabiskannya.
Dialogue: 0,0:06:14.05,0:06:15.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:06:15.43,0:06:19.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertanyaan ini menunjukkan\Npasangan yang cocok untuk kita.
Dialogue: 0,0:06:19.71,0:06:20.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:06:20.53,0:06:25.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu cocok sama orang cekatan\Ndan pandai bergaul.
Dialogue: 0,0:06:27.03,0:06:28.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Giliranmu, Kitahara.
Dialogue: 0,0:06:28.77,0:06:30.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit menjawabnya.
Dialogue: 0,0:06:30.29,0:06:33.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya aku suka semua makanan.
Dialogue: 0,0:06:34.17,0:06:37.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin, tes ini tidak berlaku buatku...
Dialogue: 0,0:06:37.48,0:06:40.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.\NBerarti...
Dialogue: 0,0:06:40.30,0:06:42.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria toleran sepertimu
Dialogue: 0,0:06:42.05,0:06:45.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}cocok sama yang mukanya\Nmenor minta ampun!
Dialogue: 0,0:06:47.05,0:06:49.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak kumakan?
Dialogue: 0,0:06:49.01,0:06:53.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria jujur sepertimu serasi sama\Nyang mukanya menor minta ampun!
Dialogue: 0,0:06:53.21,0:06:54.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau cuma kucicip sedikit?
Dialogue: 0,0:06:54.83,0:07:00.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria petualang sepertimu bagusnya sama\Nyang mukanya menor minta ampun!
Dialogue: 0,0:07:00.11,0:07:01.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sengaja kutumpahkan?
Dialogue: 0,0:07:01.30,0:07:03.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria licik sepertimu—
Dialogue: 0,0:07:03.24,0:07:04.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kouhei, ikut aku.
Dialogue: 0,0:07:04.72,0:07:05.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:07:05.56,0:07:06.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:07:06.82,0:07:08.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah cukup!
Dialogue: 0,0:07:08.82,0:07:11.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya terserah aku?
Dialogue: 0,0:07:11.43,0:07:14.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Parahnya dia enggak berniat buruk!
Dialogue: 0,0:07:14.33,0:07:15.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar kamu.
Dialogue: 0,0:07:15.81,0:07:16.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:07:16.83,0:07:19.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misalkan! Cuma misalkan!
Dialogue: 0,0:07:19.32,0:07:21.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misalkan aku
Dialogue: 0,0:07:21.60,0:07:24.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}me-memang mencintainya!
Dialogue: 0,0:07:24.28,0:07:25.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya?
Dialogue: 0,0:07:25.09,0:07:28.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat apa kamu susah payah membantuku?
Dialogue: 0,0:07:29.10,0:07:32.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada untungnya, kan?
Dialogue: 0,0:07:36.65,0:07:37.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kouhei?
Dialogue: 0,0:07:37.85,0:07:39.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul juga.
Dialogue: 0,0:07:39.86,0:07:40.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:07:40.93,0:07:43.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi penasaran
Dialogue: 0,0:07:43.16,0:07:45.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk apa melakukan semua ini?
Dialogue: 0,0:07:45.81,0:07:49.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sendiri tidak tahu alasannya?
Dialogue: 0,0:07:49.12,0:07:51.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin saja.
Dialogue: 0,0:07:51.37,0:07:54.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku juga tahu
Dialogue: 0,0:07:54.81,0:07:56.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sesaknya jatuh cinta.
Dialogue: 0,0:08:01.59,0:08:02.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya,
Dialogue: 0,0:08:03.43,0:08:05.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu juga pernah jatuh cinta?
Dialogue: 0,0:08:05.59,0:08:08.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, mungkin kamu tidak tahu.
Dialogue: 0,0:08:08.13,0:08:12.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu aku seorang otaku\Ndengan hasrat membara.
Dialogue: 0,0:08:12.01,0:08:14.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wow, mengejutkan.
Dialogue: 0,0:08:14.15,0:08:16.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, aku mau membantumu.
Dialogue: 0,0:08:18.03,0:08:21.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibiarkan juga bisa bahaya.
Dialogue: 0,0:08:21.33,0:08:24.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minimal dia harus aku kontrol.
Dialogue: 0,0:08:25.27,0:08:28.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, coba tanya dia secara halus.
Dialogue: 0,0:08:28.01,0:08:30.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, mau tanya apa?
Dialogue: 0,0:08:32.15,0:08:35.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka merencanakan apa, sih?
Dialogue: 0,0:08:41.39,0:08:43.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, Dolphin di sini.
Dialogue: 0,0:08:43.60,0:08:44.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo.
Dialogue: 0,0:08:44.97,0:08:48.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Sugita dari Worldwide Tours.
Dialogue: 0,0:08:48.17,0:08:48.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:08:48.69,0:08:50.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Kotegawa ada?
Dialogue: 0,0:08:50.63,0:08:53.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada, tunggu sebentar.
Dialogue: 0,0:08:53.25,0:08:57.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bibi, ada telepon.
Dialogue: 0,0:09:02.69,0:09:04.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bos.
Dialogue: 0,0:09:04.04,0:09:05.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm? Ada apa?
Dialogue: 0,0:09:05.94,0:09:07.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada telepon.
Dialogue: 0,0:09:08.88,0:09:09.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo.
Dialogue: 0,0:09:09.53,0:09:11.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak mau dipanggil bibi, ya.
Dialogue: 0,0:09:11.95,0:09:13.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yo, Kitahara.
Dialogue: 0,0:09:13.56,0:09:14.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kouhei, ya.
Dialogue: 0,0:09:14.95,0:09:16.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau apa lagi?
Dialogue: 0,0:09:16.49,0:09:18.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau tanya.
Dialogue: 0,0:09:19.28,0:09:22.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba tanya, apakah dia tertarik padaku?
Dialogue: 0,0:09:22.68,0:09:25.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, akan kutanya secara halus.
Dialogue: 0,0:09:25.95,0:09:27.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu...
Dialogue: 0,0:09:31.22,0:09:33.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau esek-esek sama si Menor?
Dialogue: 0,0:09:36.04,0:09:37.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh!
Dialogue: 0,0:09:37.07,0:09:40.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka apa-apaan, sih?
Dialogue: 0,0:09:42.47,0:09:44.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih untuk malam ini.
Dialogue: 0,0:09:44.65,0:09:47.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian kuat minum juga, ya.
Dialogue: 0,0:09:47.93,0:09:50.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aina, terima kasih untuk hari ini.
Dialogue: 0,0:09:50.00,0:09:51.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama-sama.
Dialogue: 0,0:09:51.90,0:09:54.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih barbekunya.
Dialogue: 0,0:09:54.71,0:09:57.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari minum-minum lagi di Jepang nanti.
Dialogue: 0,0:09:57.12,0:09:59.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati di jalan.
Dialogue: 0,0:09:59.41,0:10:03.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aina disukai para tamu, ya.
Dialogue: 0,0:10:03.17,0:10:06.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak pusing minum banyak alkohol?
Dialogue: 0,0:10:06.65,0:10:08.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, bukan masalah.
Dialogue: 0,0:10:08.67,0:10:11.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan membersihkan panggangan.
Dialogue: 0,0:10:11.96,0:10:13.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong, ya.
Dialogue: 0,0:10:13.72,0:10:16.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya mereka juga mulai\Nterbiasa dengan pekerjaannya.
Dialogue: 0,0:10:16.39,0:10:17.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:10:17.57,0:10:20.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sudah sepuluh hari di sini, kan?
Dialogue: 0,0:10:20.36,0:10:22.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah kira-kira.
Dialogue: 0,0:10:23.12,0:10:26.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepuluh hari tinggal sama lawan jenis.
Dialogue: 0,0:10:26.19,0:10:29.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berdua sudah begini, belum, ya?
Dialogue: 0,0:10:29.81,0:10:31.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar kamu ini.
Dialogue: 0,0:10:31.94,0:10:34.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya, cowok bisa mati kalau tidak "keluar"
Dialogue: 0,0:10:34.56,0:10:36.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lebih dari dua minggu, kan?
Dialogue: 0,0:10:36.85,0:10:40.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, selangkangannya bakal meledak.
Dialogue: 0,0:10:40.40,0:10:43.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku penasaran kapan mereka menyalurkannya.
Dialogue: 0,0:10:43.51,0:10:46.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, pasti sulit buat mereka.
Dialogue: 0,0:10:46.71,0:10:48.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benaran?
Dialogue: 0,0:10:50.21,0:10:52.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketua sudah cerita soal siang tadi.
Dialogue: 0,0:10:53.63,0:10:57.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mencoba memperbaiki\Npenyangga tamu yang longgar, kan?
Dialogue: 0,0:10:57.97,0:11:01.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kemaluannya malah terjepit.
Dialogue: 0,0:11:02.47,0:11:03.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kurang hati-hati.
Dialogue: 0,0:11:03.98,0:11:06.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tidak terlalu keras, kok.
Dialogue: 0,0:11:06.09,0:11:09.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu titik kelemahan terbesar pria.
Dialogue: 0,0:11:09.48,0:11:13.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, kamu benar-benar kikuk.
Dialogue: 0,0:11:13.76,0:11:14.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:11:16.04,0:11:20.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal Nanaka yang polos saja\Nbisa melakukannya.
Dialogue: 0,0:11:21.01,0:11:26.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, pelajarilah soal lawan jenis\Nselain dari buku pelajaran.
Dialogue: 0,0:11:31.83,0:11:33.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chisa!
Dialogue: 0,0:11:34.01,0:11:35.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:11:35.08,0:11:37.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini gawat!
Dialogue: 0,0:11:37.76,0:11:39.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada masalah dengan tamu?
Dialogue: 0,0:11:39.49,0:11:41.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:11:41.76,0:11:43.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iori dan Kouhei bakal mati!
Dialogue: 0,0:11:43.61,0:11:46.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya mereka sedang mengantar tamu?
Dialogue: 0,0:11:46.27,0:11:48.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka kecelakaan?
Dialogue: 0,0:11:48.23,0:11:50.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan itu.
Dialogue: 0,0:11:50.27,0:11:52.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selangkangan mereka akan meledak!
Dialogue: 0,0:11:52.45,0:11:54.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di luar dugaan banget!
Dialogue: 0,0:11:54.28,0:11:56.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jelaskan detailnya.
Dialogue: 0,0:11:56.43,0:12:00.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya aku juga\Nkurang paham soal cowok, sih.
Dialogue: 0,0:12:00.53,0:12:05.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya cowok bisa mati kalau tidak\N"keluar" lebih dari dua minggu.
Dialogue: 0,0:12:05.43,0:12:06.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:12:06.04,0:12:07.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu terlalu konyol.
Dialogue: 0,0:12:07.79,0:12:09.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya kukira begitu!
Dialogue: 0,0:12:09.76,0:12:13.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dilihat dari kelakuan mereka...
Dialogue: 0,0:12:13.28,0:12:15.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelakuan mereka?
Dialogue: 0,0:12:15.05,0:12:19.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelakuan yang tidak bisa cewek mengerti!
Dialogue: 0,0:12:21.05,0:12:23.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dipikir-pikir, iya juga.
Dialogue: 0,0:12:23.81,0:12:27.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang tidak bisa memahaminya.
Dialogue: 0,0:12:27.51,0:12:29.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi jangan-jangan
Dialogue: 0,0:12:29.31,0:12:31.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nyawa mereka bergantung pada itu!
Dialogue: 0,0:12:31.52,0:12:33.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masuk akal, kan?
Dialogue: 0,0:12:33.32,0:12:36.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kenapa di Okinawa tidak begitu?
Dialogue: 0,0:12:36.67,0:12:41.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu cuma lima hari,\Ndan waktu Iori sakit...
Dialogue: 0,0:12:41.52,0:12:43.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengajak Iori esek-esek.
Dialogue: 0,0:12:45.08,0:12:47.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya itu langkah pengobatan.
Dialogue: 0,0:12:47.51,0:12:49.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata begitu?
Dialogue: 0,0:12:49.46,0:12:51.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku baru tahu ada kondisi begitu.
Dialogue: 0,0:12:51.71,0:12:53.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sama!
Dialogue: 0,0:12:53.71,0:12:56.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kita cuma baru tahu saja.
Dialogue: 0,0:12:57.84,0:13:01.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, pelajarilah soal lawan jenis
Dialogue: 0,0:13:01.48,0:13:03.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selain dari buku pelajaran.
Dialogue: 0,0:13:04.91,0:13:06.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita periksa.
Dialogue: 0,0:13:06.72,0:13:07.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apanya?
Dialogue: 0,0:13:08.47,0:13:10.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kondisi Iori dan Imamura.
Dialogue: 0,0:13:12.73,0:13:14.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sedang apa?
Dialogue: 0,0:13:14.51,0:13:15.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersih-bersihnya sudah...
Dialogue: 0,0:13:15.73,0:13:16.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kelar...
Dialogue: 0,0:13:17.76,0:13:20.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertahanlah, Kouhei!\NPasti sakit, ya?
Dialogue: 0,0:13:20.74,0:13:23.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong usap punggungku.
Dialogue: 0,0:13:23.97,0:13:24.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:13:25.27,0:13:26.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan memaksakan dirimu.
Dialogue: 0,0:13:29.50,0:13:31.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuh, kan!
Dialogue: 0,0:13:31.92,0:13:33.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit dipercaya.
Dialogue: 0,0:13:33.45,0:13:37.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Iori tidak biasanya\Nkhawatir pada Kouhei.
Dialogue: 0,0:13:37.50,0:13:40.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya dia akan mentertawakannya.
Dialogue: 0,0:13:40.20,0:13:41.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul juga.
Dialogue: 0,0:13:41.76,0:13:45.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nasib para pria sungguh malang.
Dialogue: 0,0:13:45.03,0:13:47.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku baru tahu.
Dialogue: 0,0:13:47.01,0:13:51.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kenapa mereka tidak ada persiapan?
Dialogue: 0,0:13:51.01,0:13:53.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya juga, aku juga heran...
Dialogue: 0,0:13:53.76,0:13:54.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:13:54.48,0:13:55.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:13:55.52,0:13:58.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa, mereka sudah bersiap.
Dialogue: 0,0:14:01.40,0:14:04.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, semuanya disita?
Dialogue: 0,0:14:04.71,0:14:07.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya memang bukan buat dibawa-bawa.
Dialogue: 0,0:14:07.41,0:14:10.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada waktu dua minggu sebelum meledak, kan?
Dialogue: 0,0:14:10.64,0:14:12.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, katanya begitu.
Dialogue: 0,0:14:12.95,0:14:14.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti...
Dialogue: 0,0:14:17.42,0:14:19.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tersisa tiga hari.
Dialogue: 0,0:14:23.43,0:14:25.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah mendingan?
Dialogue: 0,0:14:26.19,0:14:28.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, lumayan.
Dialogue: 0,0:14:28.18,0:14:30.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak tega\Nkalau celakanya di situ.
Dialogue: 0,0:14:30.95,0:14:33.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka ada tiang di situ.
Dialogue: 0,0:14:35.69,0:14:38.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kerjaan kita sudah hampir kelar.
Dialogue: 0,0:14:38.77,0:14:41.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya minum bir.
Dialogue: 0,0:14:47.20,0:14:51.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Janggal sekali!\NTatapan mereka dipenuhi rasa iba!
Dialogue: 0,0:14:51.77,0:14:56.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seolah-olah kami akan mati besok!
Dialogue: 0,0:14:56.21,0:14:57.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iori.
Dialogue: 0,0:14:58.28,0:14:59.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kouhei.
Dialogue: 0,0:15:00.11,0:15:01.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas segalanya.
Dialogue: 0,0:15:01.59,0:15:02.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Woi!
Dialogue: 0,0:15:02.71,0:15:04.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih buat apa?
Dialogue: 0,0:15:04.51,0:15:06.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, sih?
Dialogue: 0,0:15:06.67,0:15:08.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan khawatir.
Dialogue: 0,0:15:08.15,0:15:10.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sudah ikhlas.
Dialogue: 0,0:15:10.76,0:15:14.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bahagia kita pernah saling jumpa.
Dialogue: 0,0:15:14.83,0:15:16.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa pakai rima segala!
Dialogue: 0,0:15:17.23,0:15:19.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian mau minum bir, kan?
Dialogue: 0,0:15:19.93,0:15:21.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakailah uang ini.
Dialogue: 0,0:15:21.73,0:15:24.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan kami yang membersihkan toko.
Dialogue: 0,0:15:24.87,0:15:27.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istirahat saja duluan.
Dialogue: 0,0:15:27.43,0:15:29.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oke.
Dialogue: 0,0:15:32.05,0:15:33.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang tidak beres.
Dialogue: 0,0:15:33.80,0:15:34.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:15:34.50,0:15:37.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita memang sering bikin emosi...
Dialogue: 0,0:15:37.01,0:15:40.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi baru kali ini tatapan mereka begitu.
Dialogue: 0,0:15:40.01,0:15:43.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan mereka melihatnya ke bawah, kan?
Dialogue: 0,0:15:43.19,0:15:44.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke bawah?
Dialogue: 0,0:15:46.51,0:15:47.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:15:47.63,0:15:52.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagian bawah, tatapan iba, luar negeri.
Dialogue: 0,0:15:52.64,0:15:54.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:15:54.19,0:15:56.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga paham, kan?
Dialogue: 0,0:15:56.39,0:16:00.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Barang" kita dibandingkan sama warga sini!
Dialogue: 0,0:16:00.00,0:16:01.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!
Dialogue: 0,0:16:01.40,0:16:03.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kamu yakin?
Dialogue: 0,0:16:03.46,0:16:05.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum terlalu, sih.
Dialogue: 0,0:16:05.40,0:16:07.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo coba reka adegan.
Dialogue: 0,0:16:07.16,0:16:08.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reka adegan?
Dialogue: 0,0:16:08.41,0:16:10.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bayangkan si Menor mabuk
Dialogue: 0,0:16:10.63,0:16:15.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu buka baju di samping Nanaka dan Azusa!
Dialogue: 0,0:16:20.32,0:16:22.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, itu ekspresi mereka!
Dialogue: 0,0:16:22.79,0:16:26.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti kita dikasihani karena kalah ukuran?
Dialogue: 0,0:16:26.33,0:16:29.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinan besarnya begitu.
Dialogue: 0,0:16:29.13,0:16:32.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, kenyataan begitu pahit!
Dialogue: 0,0:16:32.20,0:16:35.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia nyata memang ampas!
Dialogue: 0,0:16:35.06,0:16:38.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi mau bagaimana lagi.
Dialogue: 0,0:16:38.06,0:16:39.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu memang fakta.
Dialogue: 0,0:16:39.65,0:16:41.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski nyelekit, sih.
Dialogue: 0,0:16:41.81,0:16:45.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita nikmati saja alkohol\Ndari rasa iba mereka.
Dialogue: 0,0:16:45.59,0:16:47.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat.
Dialogue: 0,0:16:50.40,0:16:51.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi,
Dialogue: 0,0:16:51.57,0:16:54.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita harus apa?
Dialogue: 0,0:16:54.19,0:16:56.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Solusi tercepatnya...
Dialogue: 0,0:16:59.08,0:16:59.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ogah.
Dialogue: 0,0:16:59.92,0:17:01.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya, kan?
Dialogue: 0,0:17:01.58,0:17:04.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada cara lain?
Dialogue: 0,0:17:09.04,0:17:12.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tidak akan pulang dua jam ke depan\Nkarena urusan mendadak.
Dialogue: 0,0:17:12.86,0:17:14.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berjuanglah!
Dialogue: 0,0:17:14.77,0:17:16.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka kenapa, sih?
Dialogue: 0,0:17:16.59,0:17:17.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:17:17.95,0:17:21.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya berhasil, mungkin.
Dialogue: 0,0:17:22.59,0:17:25.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian masih di sini?
Dialogue: 0,0:17:25.00,0:17:27.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bos dan Ketua sudah pulang, lo.
Dialogue: 0,0:17:27.53,0:17:28.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maki.
Dialogue: 0,0:17:28.61,0:17:30.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena alasan tertentu...
Dialogue: 0,0:17:30.67,0:17:33.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami mau di sini dulu selama dua jam.
Dialogue: 0,0:17:34.87,0:17:37.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, ini kunci tokonya.
Dialogue: 0,0:17:37.44,0:17:39.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:17:40.12,0:17:43.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lupa mengembalikannya besok.
Dialogue: 0,0:17:43.04,0:17:44.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:17:46.89,0:17:49.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, kenapa dua jam?
Dialogue: 0,0:17:49.45,0:17:51.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, itu...
Dialogue: 0,0:17:51.38,0:17:56.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena urusan intim Iori dan Kouhei.
Dialogue: 0,0:17:56.39,0:17:57.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:17:57.79,0:18:00.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di tulisannya istirahat butuh dua jam!
Dialogue: 0,0:18:00.80,0:18:03.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya, mereka...\NEh?
Dialogue: 0,0:18:03.55,0:18:05.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itulah...
Dialogue: 0,0:18:05.37,0:18:08.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami berniat pulang belakangan.
Dialogue: 0,0:18:08.49,0:18:10.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oh, begitu.
Dialogue: 0,0:18:10.40,0:18:12.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata mereka...
Dialogue: 0,0:18:12.09,0:18:13.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati di jalan.
Dialogue: 0,0:18:13.80,0:18:14.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati.
Dialogue: 0,0:18:17.41,0:18:19.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisa satu jam lagi.
Dialogue: 0,0:18:19.61,0:18:21.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau apa, nih?
Dialogue: 0,0:18:21.16,0:18:23.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nonton video menyelam, yuk.
Dialogue: 0,0:18:23.81,0:18:27.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya lebih asyik menyelam sungguhan.
Dialogue: 0,0:18:27.17,0:18:30.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Videonya juga seru, kok.
Dialogue: 0,0:18:30.31,0:18:33.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar-benar cinta menyelam, ya.
Dialogue: 0,0:18:33.43,0:18:34.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:18:34.93,0:18:36.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:18:37.68,0:18:39.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku agak iri.
Dialogue: 0,0:18:42.18,0:18:43.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:18:43.48,0:18:47.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya ada hal yang sangat kamu tekuni.
Dialogue: 0,0:18:47.15,0:18:49.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa, sih?
Dialogue: 0,0:18:49.24,0:18:50.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:18:51.15,0:18:53.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya, aku iri.
Dialogue: 0,0:18:54.33,0:18:58.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang sangat menekuni suatu hal\Nmemang keren.
Dialogue: 0,0:19:01.12,0:19:03.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cita-citamu jadi instruktur, kan?
Dialogue: 0,0:19:03.96,0:19:04.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:19:04.71,0:19:07.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok kuliah jurusan teknik?
Dialogue: 0,0:19:10.65,0:19:11.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chisa?
Dialogue: 0,0:19:11.71,0:19:14.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, pertanyaanku sensitif, ya?
Dialogue: 0,0:19:14.80,0:19:16.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kok.
Dialogue: 0,0:19:16.97,0:19:20.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan aku cukup mahir\Nmatematika dan sains.
Dialogue: 0,0:19:20.16,0:19:21.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu...
Dialogue: 0,0:19:21.47,0:19:24.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini caraku negosiasi
Dialogue: 0,0:19:24.56,0:19:26.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan Ibu.
Dialogue: 0,0:19:26.35,0:19:27.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:19:28.16,0:19:31.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya Ibu tidak mau aku jadi instruktur.
Dialogue: 0,0:19:32.29,0:19:33.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:19:37.44,0:19:38.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku
Dialogue: 0,0:19:39.22,0:19:41.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ingin jadi kakakku.
Dialogue: 0,0:19:41.49,0:19:44.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu berharap lahir duluan?
Dialogue: 0,0:19:44.51,0:19:46.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan cuma itu.
Dialogue: 0,0:19:46.25,0:19:49.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia ramah, murah senyum,
Dialogue: 0,0:19:49.67,0:19:53.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}cinta lautan, dan pandai bekerja.
Dialogue: 0,0:19:53.45,0:19:57.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti enak kalau jadi Kakak.
Dialogue: 0,0:19:59.55,0:20:02.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingin jadi orang lain, ya.
Dialogue: 0,0:20:03.04,0:20:04.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku tahu
Dialogue: 0,0:20:06.77,0:20:09.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengucapkan ini akan memalukan...
Dialogue: 0,0:20:13.09,0:20:15.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin jadi kamu.
Dialogue: 0,0:20:16.56,0:20:17.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku?
Dialogue: 0,0:20:18.49,0:20:20.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng, maksudnya...
Dialogue: 0,0:20:20.78,0:20:23.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ingin jadi kamu.
Dialogue: 0,0:20:23.05,0:20:24.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:20:24.04,0:20:26.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat apa jadi aku?
Dialogue: 0,0:20:26.67,0:20:30.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa bergaul sama para tamu, kan?
Dialogue: 0,0:20:30.63,0:20:33.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku susah mau begitu.
Dialogue: 0,0:20:34.52,0:20:35.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chisa...
Dialogue: 0,0:20:39.05,0:20:41.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma kita membahas ini.
Dialogue: 0,0:20:41.72,0:20:44.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumput tetangga selalu lebih hijau.
Dialogue: 0,0:20:44.31,0:20:47.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, kita harus terima nasib.
Dialogue: 0,0:20:47.43,0:20:50.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona-nona kelihatan asyik, ya.
Dialogue: 0,0:20:53.73,0:20:56.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iori? Imamura?
Dialogue: 0,0:20:56.73,0:20:58.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kalian marah?
Dialogue: 0,0:20:58.49,0:21:00.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup sandiwaranya.
Dialogue: 0,0:21:00.64,0:21:04.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi Maki mengintip kami.
Dialogue: 0,0:21:04.49,0:21:07.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kami dituduh begituan?
Dialogue: 0,0:21:07.50,0:21:09.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya?
Dialogue: 0,0:21:09.13,0:21:12.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami cuma memberi waktu...
Dialogue: 0,0:21:12.01,0:21:14.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kami bisa begituan?
Dialogue: 0,0:21:14.27,0:21:16.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jail juga ada batasnya!
Dialogue: 0,0:21:18.03,0:21:19.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu ceritanya.
Dialogue: 0,0:21:19.26,0:21:22.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu salah paham soal Iori dan Kouhei.
Dialogue: 0,0:21:22.27,0:21:26.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.\NAku minta maaf.
Dialogue: 0,0:21:26.26,0:21:27.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami yang salah...
Dialogue: 0,0:21:27.73,0:21:30.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena menganggap serius candaan kalian.
Dialogue: 0,0:21:30.27,0:21:34.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi Iori dan Kouhei tidak begitu, kok.
Dialogue: 0,0:21:34.28,0:21:36.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan?
Dialogue: 0,0:21:38.28,0:21:39.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku, dong?
Dialogue: 0,0:21:41.52,0:21:43.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok malah diam?
Dialogue: 0,0:21:43.53,0:21:44.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan benaran...
Dialogue: 0,0:21:44.77,0:21:45.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:21:45.61,0:21:46.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, lah!
Dialogue: 0,0:21:46.57,0:21:48.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fitnah!
Dialogue: 0,0:21:48.63,0:21:52.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masalah kemarin bikin kamu kepikiran, ya.
Dialogue: 0,0:21:52.05,0:21:53.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:21:53.54,0:21:56.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terlalu tegang.
Dialogue: 0,0:21:57.55,0:22:01.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sikap seperti itu tidak cocok\Ndi bidang pelayanan.
