Dialogue: 0,0:00:00.00,0:00:00.27,sign,,0000,0000,0000,,ACARA INI ADALAH KARYA FIKSI.
Dialogue: 0,0:00:00.27,0:00:00.58,sign,,0000,0000,0000,,ANAK DI BAWAH UMUR DILARANG KERAS\NMINUM ALKOHOL OLEH HUKUM.
Dialogue: 0,0:00:00.58,0:00:01.09,sign,,0000,0000,0000,,KAMI JUGA TIDAK BERMAKSUD MENGANJURKAN\NPEMAKSAAN MINUM ALKOHOL,
Dialogue: 0,0:00:01.09,0:00:01.79,sign,,0000,0000,0000,,KONSUMSI ALKOHOL BERLEBIHAN, MAUPUN TINDAKAN\NTIDAK SENONOH SAAT PESTA MINUM.
Dialogue: 0,0:00:01.79,0:00:02.40,sign,,0000,0000,0000,,MOHON ANGGAP INI SEMATA-MATA\NSEBAGAI ANIME KOMEDI.
Dialogue: 0,0:00:02.40,0:00:03.10,sign,,0000,0000,0000,,SELURUH KARAKTER YANG MENGONSUMSI\NALKOHOL DALAM KARYA INI
Dialogue: 0,0:00:03.10,0:00:03.68,sign,,0000,0000,0000,,TELAH BERUSIA 20 TAHUN ATAU LEBIH.
Dialogue: 0,0:00:03.68,0:00:04.38,sign,,0000,0000,0000,,DEMI MENYESUAIKAN DENGAN STANDAR\NKEPATUHAN TERKINI.
Dialogue: 0,0:00:04.38,0:00:05.00,sign,,0000,0000,0000,,MULAI MUSIM INI\NUKURAN SENSOR HITAM KAMI NAIK 5%.
Dialogue: 0,0:00:51.28,0:00:59.33,sign,,0000,0000,0000,,GRAND BLUE MUSIM 3
Dialogue: 0,0:02:17.24,0:02:23.25,sign,,0000,0000,0000,,HARI INI DOLPHIN DILIPUT TV
Dialogue: 0,0:02:42.27,0:02:44.27,sign,,0000,0000,0000,,TIM SYUTING\NDUM
Dialogue: 0,0:02:44.27,0:02:46.27,sign,,0000,0000,0000,,TIM BANTU-BANTU\NDUM
Dialogue: 0,0:03:24.69,0:03:27.56,sign,,0000,0000,0000,,TETEK YANG SANGAT MANTAP
Dialogue: 0,0:04:21.82,0:04:24.20,sign,,0000,0000,0000,,SATU JAM KEMUDIAN
Dialogue: 0,0:04:24.33,0:04:26.70,sign,,0000,0000,0000,,DUA JAM KEMUDIAN
Dialogue: 0,0:04:26.83,0:04:29.21,sign,,0000,0000,0000,,TIGA JAM KEMUDIAN
Dialogue: 0,0:06:16.96,0:06:18.69,sign,,0000,0000,0000,,MURANAKA YURIKA, SEIYU KELAS STADION
Dialogue: 0,0:13:23.99,0:13:25.99,sign,,0000,0000,0000,,PAKAI PERUMPAMAAN ANIME!
Dialogue: 0,0:13:35.00,0:13:36.00,sign,,0000,0000,0000,,PAKAI PERUMPAMAAN SEIYU!
Dialogue: 0,0:13:45.58,0:13:46.51,sign,,0000,0000,0000,,LANJUTKAN PAKAI BAHASA UMUM!
Dialogue: 0,0:15:42.38,0:15:44.38,sign,,0000,0000,0000,,MIZUKI KAYA
Dialogue: 0,0:23:44.99,0:23:49.99,sign,,0000,0000,0000,,SELANJUTNYA: MAKCOMBLANG
Dialogue: 0,0:00:05.00,0:00:07.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaanmu pada Kitahara...
Dialogue: 0,0:00:12.67,0:00:13.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma...
Dialogue: 0,0:00:13.74,0:00:16.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin.
Dialogue: 0,0:00:16.25,0:00:17.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:00:17.62,0:00:21.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertanyaanmu aneh sekali.
Dialogue: 0,0:00:21.23,0:00:22.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mabuk, ya?
Dialogue: 0,0:00:22.58,0:00:25.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, maaf kalau salah.
Dialogue: 0,0:00:25.26,0:00:27.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya itu mustahil.
Dialogue: 0,0:00:27.71,0:00:30.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau tidur, ah.\NSelamat tidur.
Dialogue: 0,0:00:30.98,0:00:33.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, selamat tidur.
Dialogue: 0,0:02:08.97,0:02:11.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi.
Dialogue: 0,0:02:12.53,0:02:14.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian masih ngantuk, ya?
Dialogue: 0,0:02:14.06,0:02:15.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:02:15.38,0:02:17.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lelah kemarin belum hilang.
Dialogue: 0,0:02:17.24,0:02:21.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini, kita masuk liputan TV.
Dialogue: 0,0:02:21.25,0:02:23.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:02:23.25,0:02:25.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diliput TV di pembukaan perdana?
Dialogue: 0,0:02:25.33,0:02:28.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toko ini cukup terkenal, ya.
Dialogue: 0,0:02:28.08,0:02:29.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, lah.
Dialogue: 0,0:02:29.46,0:02:30.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:02:30.25,0:02:31.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang memanggilnya.
Dialogue: 0,0:02:31.81,0:02:33.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cerdik juga.
Dialogue: 0,0:02:33.76,0:02:37.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bagi jadi tim syuting\Ndan tim bantu-bantu.
Dialogue: 0,0:02:37.36,0:02:42.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim bantu-bantu dilarang tersorot kamera.
Dialogue: 0,0:02:46.27,0:02:48.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersiaplah di posisi masing-masing.
Dialogue: 0,0:02:48.77,0:02:52.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar, kok aku tim bantu-bantu?
Dialogue: 0,0:02:52.30,0:02:55.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seleksi ini sudah sesuai arahan Bos.
Dialogue: 0,0:02:55.42,0:02:59.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya Bos suka jutek kalau sedang gugup.
Dialogue: 0,0:03:05.10,0:03:06.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Kitahara.
Dialogue: 0,0:03:06.72,0:03:08.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:03:08.46,0:03:11.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memilih cewek dari apanya?
Dialogue: 0,0:03:12.05,0:03:14.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malu bilangnya, tapi tubuh.
Dialogue: 0,0:03:14.33,0:03:17.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak usah sok-sokan malu, deh!
Dialogue: 0,0:03:17.50,0:03:20.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain sisi seksual, dari apa lagi?
Dialogue: 0,0:03:20.56,0:03:22.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa, ya...
Dialogue: 0,0:03:23.04,0:03:24.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin teteknya.
Dialogue: 0,0:03:24.69,0:03:27.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu mah sama saja.
Dialogue: 0,0:03:27.56,0:03:29.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, mungkin dari rasa nyaman.
Dialogue: 0,0:03:29.95,0:03:31.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:03:31.07,0:03:34.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang punya hobi.
Dialogue: 0,0:03:34.26,0:03:36.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang mengenalkanku hal-hal baru.
Dialogue: 0,0:03:36.77,0:03:37.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:03:37.82,0:03:42.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti orang yang bersamamu\Nsepanjang waktu, sehobi,
Dialogue: 0,0:03:42.02,0:03:44.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mengenalkan hal-hal baru.
Dialogue: 0,0:03:44.37,0:03:46.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira begitu.
Dialogue: 0,0:03:47.79,0:03:48.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku, dong?
Dialogue: 0,0:03:48.98,0:03:51.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya kita lagi bahas cewek?
Dialogue: 0,0:03:51.67,0:03:54.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim peliput sudah datang.
Dialogue: 0,0:03:54.67,0:03:57.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia adalah Ikegoshi Yuichi.
Dialogue: 0,0:03:57.24,0:03:58.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal.
Dialogue: 0,0:04:00.21,0:04:02.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aura artisnya terpancar.
Dialogue: 0,0:04:02.38,0:04:03.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana?
Dialogue: 0,0:04:03.43,0:04:05.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tipe cowokmu kayak begitu, kan?
Dialogue: 0,0:04:05.68,0:04:07.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu dulu!
Dialogue: 0,0:04:07.71,0:04:08.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa?
Dialogue: 0,0:04:08.56,0:04:09.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:04:11.34,0:04:13.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang sudah berbeda!
Dialogue: 0,0:04:17.74,0:04:20.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita kerja lagi.
Dialogue: 0,0:04:32.02,0:04:33.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sudah kembali?
Dialogue: 0,0:04:34.83,0:04:36.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:04:36.32,0:04:37.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iori.
Dialogue: 0,0:04:37.47,0:04:40.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu menyelam tadi, Ikegoshi...
Dialogue: 0,0:04:43.47,0:04:44.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh.
Dialogue: 0,0:04:44.56,0:04:46.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tergores karang.
Dialogue: 0,0:04:46.72,0:04:49.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari lanjutkan tanpa Ikegoshi.
Dialogue: 0,0:04:49.07,0:04:50.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan!
Dialogue: 0,0:04:50.27,0:04:52.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini cuma luka kecil, kok!
Dialogue: 0,0:04:52.50,0:04:54.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kecil, lukanya di wajah.
Dialogue: 0,0:04:54.91,0:04:56.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisanya biar Ai sendiri saja.
Dialogue: 0,0:04:56.73,0:04:59.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lakukan itu, kumohon!
Dialogue: 0,0:05:00.18,0:05:01.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia semangat sekali.
Dialogue: 0,0:05:01.74,0:05:04.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar ini acara solo pertamanya.
Dialogue: 0,0:05:04.24,0:05:06.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakai riasan si Menor saja.
Dialogue: 0,0:05:06.48,0:05:08.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti malah dilarang tayang.
Dialogue: 0,0:05:08.08,0:05:09.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jahat banget.
Dialogue: 0,0:05:12.50,0:05:13.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kamu!
Dialogue: 0,0:05:13.65,0:05:17.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:05:17.26,0:05:19.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Mau apa kamu?
Dialogue: 0,0:05:19.30,0:05:22.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, orang ini sangat pemalu.
Dialogue: 0,0:05:22.90,0:05:25.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, justru aku yang salah.
Dialogue: 0,0:05:25.76,0:05:27.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ada perlu apa?
Dialogue: 0,0:05:27.86,0:05:30.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku agak penasaran.
Dialogue: 0,0:05:30.27,0:05:31.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi sebentar.
Dialogue: 0,0:05:34.54,0:05:37.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pak Produser, lihat ini!
Dialogue: 0,0:05:39.74,0:05:41.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau rambutnya dihitamkan...
Dialogue: 0,0:05:41.60,0:05:43.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirip, kan?
Dialogue: 0,0:05:43.28,0:05:45.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang pengganti?
Dialogue: 0,0:05:45.28,0:05:49.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon, sejak debut, aku dicap\Ntidak punya ciri khas selama tujuh tahun.
Dialogue: 0,0:05:49.79,0:05:52.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan ini kesempatan emasku!
Dialogue: 0,0:05:52.91,0:05:55.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin dikenal sebagai idola penyelam!
Dialogue: 0,0:05:55.79,0:05:57.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Idola penyelam, ya...
Dialogue: 0,0:05:57.95,0:06:00.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedengarannya kurang menjual.
Dialogue: 0,0:06:00.38,0:06:02.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku itu bagus.
Dialogue: 0,0:06:02.61,0:06:04.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kouhei, sudah dengar, kan?
Dialogue: 0,0:06:04.38,0:06:05.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ogah banget!
Dialogue: 0,0:06:05.84,0:06:06.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak mau.
Dialogue: 0,0:06:06.80,0:06:08.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mohon!
Dialogue: 0,0:06:08.62,0:06:10.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau membujuknya,
Dialogue: 0,0:06:10.56,0:06:12.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}minimal bawa tanda tangan seiyu.
Dialogue: 0,0:06:12.58,0:06:14.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seiyu?
Dialogue: 0,0:06:14.81,0:06:16.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Muranaka Yurika, mau?
Dialogue: 0,0:06:16.96,0:06:18.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Muranaka Yurika.
Dialogue: 0,0:06:18.69,0:06:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Muranaka Yurika\Nsang seiyu kelas stadion?
Dialogue: 0,0:06:24.20,0:06:26.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan salahkan aku kalau gagal.
Dialogue: 0,0:06:26.34,0:06:28.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya dia mau, tuh.
Dialogue: 0,0:06:28.93,0:06:31.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kita sepakat, ya?
Dialogue: 0,0:06:31.20,0:06:32.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sih.
Dialogue: 0,0:06:32.78,0:06:33.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:06:33.55,0:06:35.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya pikirkan lagi.
Dialogue: 0,0:06:35.95,0:06:37.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setuju.
Dialogue: 0,0:06:37.38,0:06:38.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:06:38.71,0:06:41.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia orangnya nyeleneh.
Dialogue: 0,0:06:41.23,0:06:43.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, sayang sekali...
Dialogue: 0,0:06:43.80,0:06:45.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu berubah pikiran?
Dialogue: 0,0:06:45.58,0:06:46.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:06:46.98,0:06:48.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali
Dialogue: 0,0:06:48.22,0:06:49.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia cocok banget.
Dialogue: 0,0:06:49.76,0:06:51.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tata bahasamu ngawur!
Dialogue: 0,0:06:51.66,0:06:54.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aman, justru bagus kalau nyeleneh.
Dialogue: 0,0:06:54.32,0:06:55.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah.
Dialogue: 0,0:06:55.89,0:06:57.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terserah kamu, sih.
Dialogue: 0,0:06:57.86,0:06:59.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi yang penting...
Dialogue: 0,0:06:59.48,0:07:02.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sudah memperingatimu, ya!
Dialogue: 0,0:07:08.99,0:07:11.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong ambil dia lagi.
Dialogue: 0,0:07:11.26,0:07:13.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyesalnya cepat banget.
Dialogue: 0,0:07:13.00,0:07:16.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, tadi memang berlebihan, tapi...
Dialogue: 0,0:07:16.77,0:07:18.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berulah apa kamu?
Dialogue: 0,0:07:18.26,0:07:21.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka menyuruhku buka-bukaan.
Dialogue: 0,0:07:21.09,0:07:25.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya tunjukkan\Ndadamu sedikit saja.
Dialogue: 0,0:07:25.01,0:07:27.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti kamu malah bugil, ya?
Dialogue: 0,0:07:27.51,0:07:30.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah sepakat,\Njadi jangan bugil!
Dialogue: 0,0:07:30.59,0:07:32.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit, tapi baiklah.
Dialogue: 0,0:07:32.52,0:07:35.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah bersedia,\Nminimal cobalah di segmen kuliner!
Dialogue: 0,0:07:35.90,0:07:38.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata dia sulit, tuh.
Dialogue: 0,0:07:38.52,0:07:40.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikegoshi, segeralah ke rumah sakit.
Dialogue: 0,0:07:40.62,0:07:41.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:07:42.27,0:07:43.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu.
Dialogue: 0,0:07:44.21,0:07:46.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sungguh minta tolong.
Dialogue: 0,0:07:46.42,0:07:49.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuusahakan, demi tanda tangan.
Dialogue: 0,0:07:51.81,0:07:53.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi.
Dialogue: 0,0:07:59.39,0:08:02.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Takahashi Ai, salam kenal.
Dialogue: 0,0:08:02.80,0:08:04.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi, Ai.
Dialogue: 0,0:08:12.08,0:08:13.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaki yang menggoda.
Dialogue: 0,0:08:13.92,0:08:15.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajahnya kecil banget.
Dialogue: 0,0:08:15.10,0:08:16.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah.
Dialogue: 0,0:08:16.31,0:08:18.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus mendekatinya!
Dialogue: 0,0:08:18.31,0:08:19.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan aneh-aneh!
Dialogue: 0,0:08:19.98,0:08:22.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu itu bukan levelnya!
Dialogue: 0,0:08:22.54,0:08:24.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan aku bermimpi!
Dialogue: 0,0:08:25.78,0:08:28.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awas kalau bugil di kamera lagi!
Dialogue: 0,0:08:28.14,0:08:30.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salahkan bajunya.
Dialogue: 0,0:08:30.16,0:08:31.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya salahmu?
Dialogue: 0,0:08:31.18,0:08:32.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar.
Dialogue: 0,0:08:32.32,0:08:34.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kouhei, tunggu sebentar.
Dialogue: 0,0:08:35.45,0:08:37.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikegoshi, selamat pagi.
Dialogue: 0,0:08:38.05,0:08:39.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat jawab.
Dialogue: 0,0:08:39.54,0:08:40.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pagi.
Dialogue: 0,0:08:40.51,0:08:42.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu temannya Ikegoshi?
Dialogue: 0,0:08:42.74,0:08:43.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas bukan!
Dialogue: 0,0:08:43.96,0:08:47.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, aku cuma staf toko ini.
Dialogue: 0,0:08:47.15,0:08:49.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, staf toko?
Dialogue: 0,0:08:49.47,0:08:52.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:08:52.47,0:08:55.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kamu mengajakku\Nkeliling saat tidak syuting?
Dialogue: 0,0:08:57.84,0:08:58.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:08:58.98,0:09:00.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama aku?
Dialogue: 0,0:09:00.42,0:09:03.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, mumpung di pulau tropis,
Dialogue: 0,0:09:03.26,0:09:05.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ingin main ke laut sebelum pulang.
Dialogue: 0,0:09:07.33,0:09:09.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:09:09.24,0:09:11.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantap jiwa!
Dialogue: 0,0:09:11.74,0:09:14.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulau tropis, lautan lepas!
Dialogue: 0,0:09:14.32,0:09:18.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria asing yang bisa diandalkan\Ndi tempat baru!
Dialogue: 0,0:09:18.50,0:09:20.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kesempatan langka!
Dialogue: 0,0:09:21.27,0:09:23.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap, sebuah kehormatan bagiku!
Dialogue: 0,0:09:23.70,0:09:26.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, terima kasih banyak!
Dialogue: 0,0:09:26.75,0:09:28.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau.
Dialogue: 0,0:09:29.76,0:09:32.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah ikut saja, demi aku.
Dialogue: 0,0:09:32.70,0:09:34.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ogah.
Dialogue: 0,0:09:34.26,0:09:36.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesekali bantu, dong!
Dialogue: 0,0:09:36.74,0:09:38.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bacot, mampus sana.
Dialogue: 0,0:09:38.67,0:09:41.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Ikegoshi tidak bisa ikut?
Dialogue: 0,0:09:41.82,0:09:43.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, ini...
Dialogue: 0,0:09:43.27,0:09:46.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kita berdua saja.
Dialogue: 0,0:09:46.77,0:09:48.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Se-Serius?
Dialogue: 0,0:09:48.54,0:09:50.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm? Iya.
Dialogue: 0,0:09:50.05,0:09:51.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar lagi syuting dimulai.
Dialogue: 0,0:09:51.95,0:09:54.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, nanti kita bahas lagi.
Dialogue: 0,0:09:56.28,0:09:59.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu Kouhe—\NMaksudku, Ikegoshi.
Dialogue: 0,0:10:00.37,0:10:04.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakailah ini supaya tidak bisa\Ndibuka dari depan.
Dialogue: 0,0:10:04.32,0:10:06.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingat, jangan buka baju!
Dialogue: 0,0:10:06.70,0:10:08.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:10:10.21,0:10:12.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu lupa siapa aku?
Dialogue: 0,0:10:14.30,0:10:17.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua di posisi!
Dialogue: 0,0:10:17.30,0:10:19.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap, mulai...
Dialogue: 0,0:10:19.47,0:10:21.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cut!
Dialogue: 0,0:10:21.81,0:10:23.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan kamu?
Dialogue: 0,0:10:23.67,0:10:25.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini gaya ciptaanku.
Dialogue: 0,0:10:25.65,0:10:27.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minimal pakai akal sehat!
Dialogue: 0,0:10:27.31,0:10:29.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Ikegoshi?
Dialogue: 0,0:10:29.36,0:10:31.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan khawatir, kalau lagi makan...
Dialogue: 0,0:10:32.43,0:10:33.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan pakai serbet.
Dialogue: 0,0:10:33.82,0:10:36.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah makin parah, tahu!
Dialogue: 0,0:10:36.32,0:10:38.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru memperingatimu, lo!
Dialogue: 0,0:10:38.67,0:10:41.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sudah hati-hati, kok.
Dialogue: 0,0:10:41.17,0:10:44.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau hati-hati seharusnya tidak kejadian!
Dialogue: 0,0:10:44.33,0:10:47.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf atas ketidaknyamanannya.
Dialogue: 0,0:10:47.23,0:10:48.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak apa-apa.
Dialogue: 0,0:10:48.87,0:10:52.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Ikegoshi sampai melakukan ini?
Dialogue: 0,0:10:52.59,0:10:56.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng, sebenarnya\Nkepalanya terbentur keras.
Dialogue: 0,0:10:56.02,0:10:57.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara apa kamu?
Dialogue: 0,0:10:57.09,0:11:00.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya juga kita bugil.
Dialogue: 0,0:11:00.42,0:11:02.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu, woi!
Dialogue: 0,0:11:02.10,0:11:04.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bi-Biasanya kalian begini?
Dialogue: 0,0:11:04.22,0:11:06.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak, kok!
Dialogue: 0,0:11:06.10,0:11:09.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Eits.\N- Kayaknya dia halusinasi.
Dialogue: 0,0:11:12.61,0:11:15.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lupa mengembalikannya.
Dialogue: 0,0:11:17.18,0:11:20.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kamu salah paham!
Dialogue: 0,0:11:21.22,0:11:22.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:11:22.86,0:11:24.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo syuting lagi!
Dialogue: 0,0:11:24.59,0:11:26.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, aku harus ke sana.
Dialogue: 0,0:11:26.61,0:11:30.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti kita bahas sambil makan, ya?
Dialogue: 0,0:11:30.74,0:11:34.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku ada urusan mendadak.
Dialogue: 0,0:11:34.63,0:11:36.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Ikegoshi.
Dialogue: 0,0:11:36.18,0:11:36.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:11:40.14,0:11:43.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini gara-gara bajingan itu!
Dialogue: 0,0:11:43.36,0:11:45.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa dia kesal?
Dialogue: 0,0:11:45.00,0:11:46.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paling karena hal bodoh.
Dialogue: 0,0:11:47.65,0:11:50.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bajingan itu!
Dialogue: 0,0:11:50.27,0:11:57.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dendam ini harus terbalaskan!
Dialogue: 0,0:11:59.44,0:12:02.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, luar biasa!
Dialogue: 0,0:12:02.13,0:12:04.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemandangannya tiada dua!
Dialogue: 0,0:12:04.77,0:12:06.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, seperti...
Dialogue: 0,0:12:06.91,0:12:09.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti pulau tropis.
Dialogue: 0,0:12:09.30,0:12:11.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya juga Palau.
Dialogue: 0,0:12:11.11,0:12:12.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cut!
Dialogue: 0,0:12:13.42,0:12:16.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, ini kerang kima!
Dialogue: 0,0:12:16.42,0:12:18.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Empuknya.
Dialogue: 0,0:12:18.00,0:12:21.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski dagingnya tebal,\Nteksturnya empuk, ya, Ikegoshi.
Dialogue: 0,0:12:21.81,0:12:23.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:12:23.18,0:12:25.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya kayak kerang.
Dialogue: 0,0:12:25.86,0:12:27.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul.
Dialogue: 0,0:12:30.19,0:12:32.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Itu saja?
Dialogue: 0,0:12:33.27,0:12:36.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kepiting bakau, ini cukup langka!
Dialogue: 0,0:12:36.19,0:12:39.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasa pahitnya yang ringan bikin ketagihan.
Dialogue: 0,0:12:39.52,0:12:41.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, pahit.
Dialogue: 0,0:12:41.50,0:12:43.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu talas ini rasanya...
Dialogue: 0,0:12:43.34,0:12:45.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasa talas.
Dialogue: 0,0:12:47.45,0:12:49.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Komentarnya cupu banget.
Dialogue: 0,0:12:49.49,0:12:50.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya juga Kouhei.
Dialogue: 0,0:12:50.98,0:12:52.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dia gugup.
Dialogue: 0,0:12:52.54,0:12:57.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai pencinta lautan,\Nkamu pasti tahu banyak!
Dialogue: 0,0:12:57.09,0:12:58.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar sekali.
Dialogue: 0,0:12:58.97,0:13:02.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dilihat-lihat, kerang kima\Nmenjijikkan karena terlalu besar.
Dialogue: 0,0:13:03.44,0:13:06.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepiting bakau, di Jepang juga ada.
Dialogue: 0,0:13:06.42,0:13:09.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikan napoleon jelek\Ndan jauh dari kata imut.
Dialogue: 0,0:13:09.98,0:13:12.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ucapkan hal positif, kek.
Dialogue: 0,0:13:12.98,0:13:14.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya ada lobster!
Dialogue: 0,0:13:14.66,0:13:15.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, udang, ya.
Dialogue: 0,0:13:15.98,0:13:18.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aromanya menggugah selera!
Dialogue: 0,0:13:18.71,0:13:20.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baunya kayak udang goreng.
Dialogue: 0,0:13:21.99,0:13:23.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, ada komentar lain?
Dialogue: 0,0:13:25.99,0:13:29.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sekilas tampak gagah,\Nbentuknya indah dan rapi
Dialogue: 0,0:13:29.12,0:13:31.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}perpaduan aksi dan keanggunannya\Nmirip anime gadis sihir.
Dialogue: 0,0:13:31.74,0:13:35.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berubah warna saat direbus\Nkayak adegan transformasi...
Dialogue: 0,0:13:36.00,0:13:39.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyantapnya di tepi pantai\Nterkesan sederhana,
Dialogue: 0,0:13:39.33,0:13:42.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi hanya bisa disajikan karena\Nsudah yakin akan rasanya.
Dialogue: 0,0:13:42.56,0:13:44.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirip konser Nona Kaya
Dialogue: 0,0:13:44.10,0:13:45.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang mengandalkan kualitas vokal...
Dialogue: 0,0:13:46.51,0:13:48.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasa udang.
Dialogue: 0,0:13:48.22,0:13:49.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sia-sia.
Dialogue: 0,0:13:49.77,0:13:52.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat, ayo pakai itu.
Dialogue: 0,0:13:52.27,0:13:56.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sup kelelawar dan minuman keras,\Nini demi pertunjukan.
Dialogue: 0,0:13:56.77,0:13:58.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin...
Dialogue: 0,0:13:58.11,0:13:59.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya jangan.
Dialogue: 0,0:13:59.53,0:14:02.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini hidangan apa, ya?
Dialogue: 0,0:14:04.16,0:14:06.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip, reaksinya bagus!
Dialogue: 0,0:14:06.26,0:14:07.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:14:08.66,0:14:12.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak apa-apa, cuma agak terkejut.
Dialogue: 0,0:14:15.44,0:14:17.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus, Ai!
Dialogue: 0,0:14:17.50,0:14:19.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, giliran Ikegoshi!
Dialogue: 0,0:14:27.54,0:14:28.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:14:28.93,0:14:30.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi kesulitan, ya?
Dialogue: 0,0:14:32.03,0:14:33.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Butuh bantuan?
Dialogue: 0,0:14:33.28,0:14:34.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iori?
Dialogue: 0,0:14:34.44,0:14:36.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu punya solusi?
Dialogue: 0,0:14:36.67,0:14:39.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang mampu\Nmenanganinya sejago aku.
Dialogue: 0,0:14:39.94,0:14:41.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tertolong.
Dialogue: 0,0:14:41.66,0:14:43.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia enggak bohong, sih.
Dialogue: 0,0:14:43.45,0:14:45.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu pinjamkan itu.
Dialogue: 0,0:14:45.32,0:14:46.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Headset-nya?
Dialogue: 0,0:14:46.95,0:14:48.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau mengarahkan pakai itu?
Dialogue: 0,0:14:48.67,0:14:51.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ukurannya terlalu besar.
Dialogue: 0,0:14:51.45,0:14:53.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat saja dulu.
Dialogue: 0,0:14:53.96,0:14:55.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita mulai lagi syutingnya!
Dialogue: 0,0:14:55.81,0:14:56.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:14:56.85,0:14:59.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Headset-nya sudah disembunyikan\Nsesuai arahanmu.
Dialogue: 0,0:14:59.84,0:15:00.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sudah cukup?
Dialogue: 0,0:15:00.90,0:15:01.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:15:02.58,0:15:05.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuharap ekspresinya\Nbisa lebih menikmati.
Dialogue: 0,0:15:05.38,0:15:06.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku coba kasih tau, ya.
Dialogue: 0,0:15:07.54,0:15:09.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kouhei, cobalah lebih menikmati.
Dialogue: 0,0:15:09.47,0:15:11.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya dia tidak dengar.
Dialogue: 0,0:15:11.36,0:15:12.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gagal lagi, deh.
Dialogue: 0,0:15:12.98,0:15:17.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul, volume sekecil itu\Nnormalnya tidak terdengar.
Dialogue: 0,0:15:17.28,0:15:18.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma, dong?
Dialogue: 0,0:15:18.48,0:15:21.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya kita butuh ini.
Dialogue: 0,0:15:22.96,0:15:24.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kouhei.
Dialogue: 0,0:15:26.11,0:15:27.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, dia bereaksi!
Dialogue: 0,0:15:27.87,0:15:29.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:15:29.17,0:15:29.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini suara...
Dialogue: 0,0:15:29.93,0:15:30.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:15:30.74,0:15:32.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini suaranya Mizuki Kaya.
Dialogue: 0,0:15:33.37,0:15:36.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara Mizuki Kaya pasti terdengar\Nsekecil apa pun itu.
Dialogue: 0,0:15:36.90,0:15:39.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah keahlian khususnya.
Dialogue: 0,0:15:39.40,0:15:40.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mencarinya.
Dialogue: 0,0:15:40.62,0:15:42.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat suruh berhenti.
Dialogue: 0,0:15:42.38,0:15:43.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aman.
Dialogue: 0,0:15:44.38,0:15:46.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kouhei, jangan lihat kemari.
Dialogue: 0,0:15:47.91,0:15:49.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiba-tiba jinak.
Dialogue: 0,0:15:50.14,0:15:52.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan inilah saatnya.
Dialogue: 0,0:15:52.89,0:15:55.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu masakan buatanku.
Dialogue: 0,0:16:00.90,0:16:02.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:16:02.18,0:16:03.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak.
Dialogue: 0,0:16:03.41,0:16:04.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:16:04.40,0:16:05.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak banget!
Dialogue: 0,0:16:05.99,0:16:08.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum ada makanan senikmat ini!
Dialogue: 0,0:16:08.41,0:16:12.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya bak embun anugerah dewa!\NCandu dari kayangan!
Dialogue: 0,0:16:12.10,0:16:15.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cita rasa memesona laksana bidadari\Ndan suasana tropisnya
Dialogue: 0,0:16:15.97,0:16:18.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berpadu jadi harmoni paling sempurna!
Dialogue: 0,0:16:18.94,0:16:20.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku setuju!
Dialogue: 0,0:16:20.42,0:16:23.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hasil editan suara Maya?
Dialogue: 0,0:16:23.64,0:16:26.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya sudah kuduga bakal begini.
Dialogue: 0,0:16:26.42,0:16:29.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang normal tidak akan menduganya.
Dialogue: 0,0:16:29.18,0:16:31.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, bagaimana?
Dialogue: 0,0:16:31.15,0:16:32.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong lanjutkan!
Dialogue: 0,0:16:32.68,0:16:36.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, percayakan padaku.
Dialogue: 0,0:16:36.68,0:16:40.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kouhei, apa wine-nya enak?
Dialogue: 0,0:16:40.69,0:16:47.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, wine ini membelai lidah dengan sentuhan\Ncita rasa buah persik yang begitu memikat.
Dialogue: 0,0:16:47.00,0:16:49.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya, aku sependapat!
Dialogue: 0,0:16:49.20,0:16:50.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat juga kamu.
Dialogue: 0,0:16:50.85,0:16:51.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas, dong.
Dialogue: 0,0:16:51.99,0:16:54.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira kamu mau balas dendam.
Dialogue: 0,0:16:54.60,0:16:56.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin, ah.
Dialogue: 0,0:16:57.65,0:16:59.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mampus sana!
Dialogue: 0,0:16:59.96,0:17:01.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kouhei.
Dialogue: 0,0:17:02.02,0:17:03.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, Nona Kaya?
Dialogue: 0,0:17:03.96,0:17:06.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya permintaan.
Dialogue: 0,0:17:06.50,0:17:08.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makan cangkang kerangnya, dong?
Dialogue: 0,0:17:10.69,0:17:13.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikegoshi!
Dialogue: 0,0:17:13.14,0:17:14.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok jadi begini?
Dialogue: 0,0:17:14.48,0:17:15.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menyuruh apa, sih?
Dialogue: 0,0:17:15.75,0:17:17.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini demi pertunjukan!
Dialogue: 0,0:17:17.40,0:17:19.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi kamu bilang "mampus", lo?
Dialogue: 0,0:17:19.48,0:17:22.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kouhei, ayo minum spirtus-nya.
Dialogue: 0,0:17:22.98,0:17:24.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya minum spirtus!
Dialogue: 0,0:17:24.78,0:17:26.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kenapa, sih?
Dialogue: 0,0:17:26.48,0:17:27.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makan, nih!
Dialogue: 0,0:17:27.93,0:17:28.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup, Iori!
Dialogue: 0,0:17:28.98,0:17:29.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan!
Dialogue: 0,0:17:29.99,0:17:33.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berputar tiga kali lalu terjun, dong.
Dialogue: 0,0:17:33.49,0:17:34.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu, dua, tiga!
Dialogue: 0,0:17:39.25,0:17:41.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya ada yang aneh.
Dialogue: 0,0:17:41.50,0:17:43.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas-jelas memang aneh!
Dialogue: 0,0:17:43.50,0:17:44.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kouhei.
Dialogue: 0,0:17:45.50,0:17:47.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percayalah padaku.
Dialogue: 0,0:17:47.21,0:17:49.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang aneh!
Dialogue: 0,0:17:49.01,0:17:52.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisa syutingnya berantaka—
Dialogue: 0,0:17:56.01,0:17:58.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh, gawat!
Dialogue: 0,0:17:58.02,0:17:59.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini?
Dialogue: 0,0:18:00.27,0:18:01.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakai ini saja!
Dialogue: 0,0:18:02.77,0:18:04.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, itu...
Dialogue: 0,0:18:06.77,0:18:08.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ai, cepat lari!
Dialogue: 0,0:18:08.06,0:18:10.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- A-Apa...\N- Berbahaya!
Dialogue: 0,0:18:11.78,0:18:13.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang telah kulakukan...
Dialogue: 0,0:18:13.02,0:18:14.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mundur!
Dialogue: 0,0:18:17.44,0:18:18.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kouhei!
Dialogue: 0,0:18:18.51,0:18:19.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke!
Dialogue: 0,0:18:32.05,0:18:33.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?
Dialogue: 0,0:18:33.70,0:18:35.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya.
Dialogue: 0,0:18:38.75,0:18:40.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:18:43.81,0:18:46.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung kamu terbiasa\Nsama air yang bisa terbakar.
Dialogue: 0,0:18:46.66,0:18:49.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama kali aku bersyukur ada Iori.
Dialogue: 0,0:18:49.32,0:18:52.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pujianmu tanggung banget.
Dialogue: 0,0:18:53.34,0:18:54.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikegoshi.
Dialogue: 0,0:18:54.56,0:18:55.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:18:56.22,0:18:58.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Temanmu
Dialogue: 0,0:18:58.83,0:19:01.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa diandalkan, ya.
Dialogue: 0,0:19:06.33,0:19:08.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, ayo lanjutkan.
Dialogue: 0,0:19:08.84,0:19:10.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap.
Dialogue: 0,0:19:10.64,0:19:11.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mula—
Dialogue: 0,0:19:11.39,0:19:14.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cut!
Dialogue: 0,0:19:14.86,0:19:17.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami kembali.
Dialogue: 0,0:19:17.34,0:19:19.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang, jadi bagaimana?
Dialogue: 0,0:19:19.35,0:19:20.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kacau balau.
Dialogue: 0,0:19:20.78,0:19:24.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya Ikegoshi merasa puas.
Dialogue: 0,0:19:24.43,0:19:28.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar syutingnya liar\Ndan tidak terduga, ya?
Dialogue: 0,0:19:28.11,0:19:30.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa dia akan pingsan\Nkalau lihat tayangannya.
Dialogue: 0,0:19:30.57,0:19:31.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh.
Dialogue: 0,0:19:31.34,0:19:33.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya kacau gara-gara kamu!
Dialogue: 0,0:19:33.57,0:19:34.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fitnah.
Dialogue: 0,0:19:34.61,0:19:36.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maki, asal kamu tahu saja!
Dialogue: 0,0:19:36.45,0:19:37.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:19:37.61,0:19:40.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara dia bugil, kencannya gagal!
Dialogue: 0,0:19:41.46,0:19:43.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:19:43.12,0:19:46.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan bukan sekali, tapi dua kali!
Dialogue: 0,0:19:46.82,0:19:47.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Chisa.
Dialogue: 0,0:19:47.99,0:19:48.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:19:48.29,0:19:49.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iori bahas kencan siapa?
Dialogue: 0,0:19:49.97,0:19:51.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Kamu tidak tahu?
Dialogue: 0,0:19:51.88,0:19:54.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis itu minta diantar Iori keliling.
Dialogue: 0,0:19:54.54,0:19:55.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:19:55.38,0:19:58.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi katanya gagal gara-gara Imamura.
Dialogue: 0,0:19:58.58,0:20:00.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oh, begitu.
Dialogue: 0,0:20:00.66,0:20:01.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa lega?
Dialogue: 0,0:20:01.89,0:20:03.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak, kok.
Dialogue: 0,0:20:03.55,0:20:06.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal dia sudah kuingatkan terus.
Dialogue: 0,0:20:06.39,0:20:08.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma telanjang kayak biasa.
Dialogue: 0,0:20:08.80,0:20:10.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasa gundulmu!
Dialogue: 0,0:20:10.90,0:20:13.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak akan telanjang\Nkalau diingatkan berkali-kali!
Dialogue: 0,0:20:13.90,0:20:18.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi... Tapi...\NBedebah ini sengaja banget!
Dialogue: 0,0:20:18.90,0:20:20.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bertengkar.
Dialogue: 0,0:20:21.52,0:20:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:20:23.46,0:20:24.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan apa-apa.
Dialogue: 0,0:20:24.91,0:20:27.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat beres-beres!
Dialogue: 0,0:20:29.42,0:20:32.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saldo terkuras!\NMenguap seketika!
Dialogue: 0,0:20:32.53,0:20:34.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan sekali ayun tongkat ajaib.
Dialogue: 0,0:20:34.98,0:20:37.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadilah Gadis Sihir Rarako!
Dialogue: 0,0:20:40.05,0:20:41.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kouhei.
Dialogue: 0,0:20:44.93,0:20:48.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menor, kamu belum tidur?
Dialogue: 0,0:20:48.08,0:20:50.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang ingin kutanyakan.
Dialogue: 0,0:20:50.74,0:20:53.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menanyakan apa?
Dialogue: 0,0:20:53.19,0:20:56.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan perkara penting, sih.
Dialogue: 0,0:20:57.31,0:21:00.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa hari ini,\Nkamu selalu mengganggu Iori?
Dialogue: 0,0:21:02.29,0:21:04.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:21:04.80,0:21:07.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah berkali-kali diingatkan,
Dialogue: 0,0:21:07.01,0:21:10.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mana mungkin kamu masih bugil\Nkalau bukan disengaja.
Dialogue: 0,0:21:10.00,0:21:13.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kira aku sengaja bugil\Nbiar dia gagal kencan?
Dialogue: 0,0:21:13.46,0:21:15.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan?
Dialogue: 0,0:21:15.02,0:21:19.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, aku memang tidak sudi\Nmelihatnya bahagia.
Dialogue: 0,0:21:20.76,0:21:23.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku tegaskan.
Dialogue: 0,0:21:23.76,0:21:27.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal yang kita bahas kemarin\Nbenaran cuma salah paham!
Dialogue: 0,0:21:28.22,0:21:33.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tingkahku memang\Nbikin salah paham, sih.
Dialogue: 0,0:21:33.90,0:21:36.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terbawa euforia suasana tropis.
Dialogue: 0,0:21:36.78,0:21:40.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terbawa suasananya luar biasa, ya.
Dialogue: 0,0:21:40.78,0:21:43.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian biasanya juga\Naku bertingkah bodoh, kan?
Dialogue: 0,0:21:43.59,0:21:45.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul banget.
Dialogue: 0,0:21:45.00,0:21:46.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam!
Dialogue: 0,0:21:46.79,0:21:49.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku duluan, selamat tidur.
Dialogue: 0,0:21:49.10,0:21:50.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:21:54.40,0:21:55.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun.
Dialogue: 0,0:21:56.77,0:21:58.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sungguh bodoh.
Dialogue: 0,0:22:08.81,0:22:14.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah jelas begitu, masih saja mengelak.
