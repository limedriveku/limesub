Dialogue: 0,0:00:00.00,0:00:00.27,sign,,0000,0000,0000,,ACARA INI ADALAH KARYA FIKSI.
Dialogue: 0,0:00:00.27,0:00:00.58,sign,,0000,0000,0000,,ANAK DI BAWAH UMUR DILARANG KERAS\NMINUM ALKOHOL OLEH HUKUM.
Dialogue: 0,0:00:00.58,0:00:01.09,sign,,0000,0000,0000,,KAMI JUGA TIDAK BERMAKSUD MENGANJURKAN\NPEMAKSAAN MINUM ALKOHOL,
Dialogue: 0,0:00:01.09,0:00:01.79,sign,,0000,0000,0000,,KONSUMSI ALKOHOL BERLEBIHAN, MAUPUN TINDAKAN\NTIDAK SENONOH SAAT PESTA MINUM.
Dialogue: 0,0:00:01.79,0:00:02.40,sign,,0000,0000,0000,,MOHON ANGGAP INI SEMATA-MATA\NSEBAGAI ANIME KOMEDI.
Dialogue: 0,0:00:02.40,0:00:03.10,sign,,0000,0000,0000,,SELURUH KARAKTER YANG MENGONSUMSI\NALKOHOL DALAM KARYA INI
Dialogue: 0,0:00:03.10,0:00:03.68,sign,,0000,0000,0000,,TELAH BERUSIA 20 TAHUN ATAU LEBIH.
Dialogue: 0,0:00:03.68,0:00:04.38,sign,,0000,0000,0000,,DEMI MENYESUAIKAN DENGAN STANDAR\NKEPATUHAN TERKINI.
Dialogue: 0,0:00:04.38,0:00:05.00,sign,,0000,0000,0000,,MULAI MUSIM INI\NUKURAN SENSOR HITAM KAMI NAIK 5%.
Dialogue: 0,0:00:17.33,0:00:25.34,sign,,0000,0000,0000,,GRAND BLUE MUSIM 3
Dialogue: 0,0:01:34.99,0:01:36.99,sign,,0000,0000,0000,,PENGINAPAN KITAHARA
Dialogue: 0,0:01:56.51,0:01:59.02,sign,,0000,0000,0000,,NASI KASTANYA
Dialogue: 0,0:03:00.45,0:03:05.46,sign,,0000,0000,0000,,AKAMIZU (JELATANG JEPANG)
Dialogue: 0,0:14:13.12,0:14:15.13,sign,,0000,0000,0000,,TOKO SELAM, GRAND BLUE
Dialogue: 0,0:14:31.02,0:14:32.24,sign,,0000,0000,0000,,DREAM SCRATCH!
Dialogue: 0,0:14:32.24,0:14:35.02,sign,,0000,0000,0000,,COCOKKAN ANGKA DAN MENANGKAN HADIAH!
Dialogue: 0,0:15:22.57,0:15:28.68,sign,,0000,0000,0000,,DREAM SCRATCH!
Dialogue: 0,0:15:28.68,0:15:29.58,sign,,0000,0000,0000,,COCOKKAN ANGKA DAN MENANGKAN HADIAH!
Dialogue: 0,0:17:19.43,0:17:21.44,sign,,0000,0000,0000,,TOKO SELAM, GRAND BLUE
Dialogue: 0,0:17:43.34,0:17:48.02,sign,,0000,0000,0000,,BERTINGKAH MENCURIGAKAN
Dialogue: 0,0:17:48.02,0:17:51.72,sign,,0000,0000,0000,,KECEPLOSAN SAAT MABUK
Dialogue: 0,0:20:15.74,0:20:17.38,sign,,0000,0000,0000,,TOKO SELAM, GRAND BLUE
Dialogue: 0,0:21:41.70,0:21:43.50,sign,,0000,0000,0000,,DREAM SCRATCH!
Dialogue: 0,0:21:43.50,0:21:44.70,sign,,0000,0000,0000,,COCOKKAN ANGKA DAN MENANGKAN HADIAH!
Dialogue: 0,0:23:44.99,0:23:49.99,sign,,0000,0000,0000,,SELANJUTNYA: KEMBALI KE OKINAWA (BAGIAN A)
Dialogue: 0,0:01:35.52,0:01:36.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam hormat.
Dialogue: 0,0:01:36.99,0:01:37.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak.
Dialogue: 0,0:01:37.66,0:01:40.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langit mulai berwarna musim gugur.
Dialogue: 0,0:01:40.04,0:01:42.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kabarmu?
Dialogue: 0,0:01:42.42,0:01:45.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pohon kastanya di gunung juga mulai berbuah.
Dialogue: 0,0:01:45.00,0:01:49.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya tahun ini kita bisa kembali\Nmenikmati cita rasa musim gugur.
Dialogue: 0,0:01:49.44,0:01:51.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak pasti teringat rasa itu
Dialogue: 0,0:01:51.56,0:01:55.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan merindukan kampung halaman.
Dialogue: 0,0:01:55.44,0:01:56.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi aku mengirimkan
Dialogue: 0,0:01:56.51,0:01:59.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nasi kastanya kesukaanmu.
Dialogue: 0,0:01:59.02,0:02:01.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nasi kastanya!
Dialogue: 0,0:02:01.02,0:02:02.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cihuy!
Dialogue: 0,0:02:02.38,0:02:03.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa dengan nasi kastanya?
Dialogue: 0,0:02:03.98,0:02:06.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu makanan favoritku!
Dialogue: 0,0:02:12.74,0:02:14.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedikit banget!
Dialogue: 0,0:02:14.88,0:02:17.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku malah makin kepengin!
Dialogue: 0,0:02:17.44,0:02:18.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik.
Dialogue: 0,0:02:18.58,0:02:21.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dia memang\Ndipancing biar pulang.
Dialogue: 0,0:02:21.41,0:02:22.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:02:22.44,0:02:23.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:02:24.42,0:02:27.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Nasi kastanyanya...\N- Berisik.
Dialogue: 0,0:02:27.02,0:02:28.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Nasi kastanyanya...\N- Berisik amat.
Dialogue: 0,0:02:28.42,0:02:29.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kenapa?
Dialogue: 0,0:02:29.88,0:02:31.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan saja.
Dialogue: 0,0:02:36.24,0:02:40.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, biar Iori berhenti merengek,
Dialogue: 0,0:02:40.01,0:02:41.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita bakal pergi memetik kastanya.
Dialogue: 0,0:02:41.58,0:02:42.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:02:42.98,0:02:45.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakai kata yang lebih baik, dong.
Dialogue: 0,0:02:45.44,0:02:49.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada tamu lain juga,\Njangan lupa menjaga sikap.
Dialogue: 0,0:02:49.44,0:02:51.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:02:56.45,0:02:58.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sayuran liar, kan?
Dialogue: 0,0:02:58.45,0:03:00.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana?
Dialogue: 0,0:03:00.45,0:03:03.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akamizu atau Jelatang Jepang.
Dialogue: 0,0:03:03.16,0:03:05.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa diolah jadi sayuran berbumbu atau rebusan.
Dialogue: 0,0:03:05.46,0:03:06.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu jeli juga.
Dialogue: 0,0:03:06.90,0:03:09.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelatang identik sama kita, ya.
Dialogue: 0,0:03:09.88,0:03:11.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul juga.
Dialogue: 0,0:03:12.60,0:03:14.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada jamur maitake.
Dialogue: 0,0:03:14.22,0:03:15.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini jamur?
Dialogue: 0,0:03:15.54,0:03:17.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita pakai buat kaldu sayuran.
Dialogue: 0,0:03:17.42,0:03:20.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditumis sama wortel juga mantap.
Dialogue: 0,0:03:20.94,0:03:22.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ini bawang liar.
Dialogue: 0,0:03:22.22,0:03:24.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chi luar biasa.
Dialogue: 0,0:03:24.10,0:03:25.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa menemukan ini itu.
Dialogue: 0,0:03:25.90,0:03:27.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sempat mencari tahu sedikit.
Dialogue: 0,0:03:27.98,0:03:31.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini, makan malamnya bakal mewah.
Dialogue: 0,0:03:37.72,0:03:38.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok?
Dialogue: 0,0:03:38.74,0:03:42.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal Senior sudah bilang ada tamu lain!
Dialogue: 0,0:03:42.92,0:03:43.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:03:43.60,0:03:44.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu benar.
Dialogue: 0,0:03:44.54,0:03:46.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ucapannya tidak bisa dipegang!
Dialogue: 0,0:03:46.87,0:03:48.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu salah paham, Menor.
Dialogue: 0,0:03:48.88,0:03:52.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami bukan bugil karena ingin.
Dialogue: 0,0:03:53.28,0:03:56.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, onsen!
Dialogue: 0,0:03:56.13,0:03:58.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo masuk!
Dialogue: 0,0:04:00.66,0:04:02.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kejadiannya tidak terduga.
Dialogue: 0,0:04:02.94,0:04:05.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baju kami dicuri kawanan monyet.
Dialogue: 0,0:04:05.27,0:04:08.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat kenakan sesuatu\Ndan ambil kembali baju kalian!
Dialogue: 0,0:04:09.82,0:04:11.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cut!
Dialogue: 0,0:04:11.27,0:04:14.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikegoshi, tonjolkan ciri khasmu!
Dialogue: 0,0:04:15.36,0:04:16.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:04:16.54,0:04:18.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang bagus darimu cuma muka!
Dialogue: 0,0:04:18.88,0:04:23.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kami tertarik karena mendengar\Nkamu sangat liar di acara lain.
Dialogue: 0,0:04:24.29,0:04:25.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah.
Dialogue: 0,0:04:25.74,0:04:27.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku izin cuci muka dulu.
Dialogue: 0,0:04:27.79,0:04:30.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga sudah berusaha, kok.
Dialogue: 0,0:04:30.08,0:04:32.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan sampai mewarnai rambut.
Dialogue: 0,0:04:32.36,0:04:33.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak cukup.
Dialogue: 0,0:04:33.79,0:04:37.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai staf acara hiburan,\Nkalian paham, kan?
Dialogue: 0,0:04:37.12,0:04:38.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pentingnya ciri khas, ya.
Dialogue: 0,0:04:38.80,0:04:40.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dia...
Dialogue: 0,0:04:46.31,0:04:49.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berubahnya drastis banget!
Dialogue: 0,0:04:49.31,0:04:51.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Idola itu sudah seniat ini!
Dialogue: 0,0:04:51.02,0:04:53.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari beri dia kesempatan!
Dialogue: 0,0:04:53.66,0:04:57.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku sering melihat itu\Ndi acara jadul.
Dialogue: 0,0:04:57.24,0:04:59.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Citra idolanya belum dibuang sepenuh...
Dialogue: 0,0:05:01.32,0:05:03.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak tahu malu, ya?
Dialogue: 0,0:05:03.68,0:05:04.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat itu!
Dialogue: 0,0:05:04.82,0:05:07.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menonjolkan ciri khas!
Dialogue: 0,0:05:08.08,0:05:10.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, putar kameranya!
Dialogue: 0,0:05:10.14,0:05:11.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:05:20.22,0:05:23.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Kok sepi?
Dialogue: 0,0:05:25.10,0:05:27.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, untung...
Dialogue: 0,0:05:28.60,0:05:31.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada orang cabul!
Dialogue: 0,0:05:31.50,0:05:32.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang cabul?
Dialogue: 0,0:05:32.40,0:05:33.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana?
Dialogue: 0,0:05:33.00,0:05:36.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas-jelas di depan mata!
Dialogue: 0,0:05:36.60,0:05:38.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok kamu panik, Kouhei?
Dialogue: 0,0:05:38.80,0:05:40.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minum air dan tenanglah.
Dialogue: 0,0:05:41.28,0:05:43.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, terima kasih.
Dialogue: 0,0:05:43.14,0:05:45.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mataku!
Dialogue: 0,0:05:45.12,0:05:47.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pasti bukan air!
Dialogue: 0,0:05:47.12,0:05:48.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bicara apa, sih?
Dialogue: 0,0:05:48.34,0:05:50.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warnanya persis air, kan?
Dialogue: 0,0:05:50.25,0:05:53.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kandungannya bukan air, kan?
Dialogue: 0,0:05:53.25,0:05:54.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kenapa?
Dialogue: 0,0:05:54.46,0:05:56.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayak waktu baru gabung saja.
Dialogue: 0,0:05:56.80,0:05:59.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok jadi seakan aku yang aneh?
Dialogue: 0,0:05:59.26,0:06:02.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa saat bicara dengan mereka...
Dialogue: 0,0:06:02.44,0:06:03.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teh oolong juga ada, nih.
Dialogue: 0,0:06:03.82,0:06:06.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini juga bikin mata perih!
Dialogue: 0,0:06:06.14,0:06:09.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}...aku serasa bisa mengikuti\Nritme acara hiburan!
Dialogue: 0,0:06:09.27,0:06:11.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo lanjut, Kouhei.
Dialogue: 0,0:06:11.12,0:06:12.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita panen kastanya lagi.
Dialogue: 0,0:06:12.46,0:06:14.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa sambil bugil?
Dialogue: 0,0:06:14.40,0:06:17.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sering dikatai tidak punya ciri khas,
Dialogue: 0,0:06:17.27,0:06:21.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan mempelajari sesuatu dari mereka!
Dialogue: 0,0:06:21.28,0:06:24.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini kastanyanya lumayan banyak.
Dialogue: 0,0:06:24.28,0:06:25.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:06:25.00,0:06:26.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu hebat juga, Kouhei.
Dialogue: 0,0:06:26.76,0:06:28.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang bawa?
Dialogue: 0,0:06:28.12,0:06:29.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Main suit buka baju?
Dialogue: 0,0:06:29.36,0:06:31.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalian sudah bugil!
Dialogue: 0,0:06:33.44,0:06:35.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kalian di sini?
Dialogue: 0,0:06:35.76,0:06:37.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak juga, ya.
Dialogue: 0,0:06:37.79,0:06:38.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:06:38.78,0:06:40.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini berkat Kouhei.
Dialogue: 0,0:06:40.10,0:06:43.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok mereka bisa mengobrol\Nsama perempuan meski bugil?
Dialogue: 0,0:06:45.30,0:06:48.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seingatku dia pria yang di Palau.
Dialogue: 0,0:06:48.30,0:06:53.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, jadi aku sedang dikira orang itu.
Dialogue: 0,0:06:53.28,0:06:54.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Woi, Kouhei.
Dialogue: 0,0:06:55.31,0:06:57.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan bajumu?
Dialogue: 0,0:06:57.02,0:06:57.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:06:57.81,0:07:00.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, aku akan ketahuan dari baju ini!
Dialogue: 0,0:07:00.78,0:07:02.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu pakai baju?
Dialogue: 0,0:07:02.82,0:07:06.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arah topiknya di luar nalar!
Dialogue: 0,0:07:06.32,0:07:11.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baju ini setelan cadanganku.
Dialogue: 0,0:07:14.83,0:07:17.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benaran Kouhei?
Dialogue: 0,0:07:17.33,0:07:18.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Glek!
Dialogue: 0,0:07:18.38,0:07:20.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Kouhei agak ane—
Dialogue: 0,0:07:24.84,0:07:26.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudahlah.
Dialogue: 0,0:07:27.80,0:07:29.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia hidup habis minum ini?
Dialogue: 0,0:07:30.40,0:07:32.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggulah, Produser.
Dialogue: 0,0:07:32.34,0:07:35.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan kembali setelah berkembang!
Dialogue: 0,0:07:36.85,0:07:40.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari bernyanyi, Rarako!
Dialogue: 0,0:07:40.86,0:07:45.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Investasikan seluruh jiwa ragamu ke saham!
Dialogue: 0,0:07:45.86,0:07:49.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kalau habis menguap seketika...\N- Kali ini menyanyi lagu anime.
Dialogue: 0,0:07:49.68,0:07:51.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar ciri yang mencolok.
Dialogue: 0,0:07:52.80,0:07:56.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Otaku idola sudah tidak aneh, tapi...
Dialogue: 0,0:07:56.62,0:08:00.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu lagu yang hanya bisa dinyanyikan\Norang yang betulan paham Rarako.
Dialogue: 0,0:08:00.98,0:08:03.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akui dia tidak asal belajar.
Dialogue: 0,0:08:03.92,0:08:05.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tahu banyak, ya.
Dialogue: 0,0:08:06.22,0:08:09.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah ciri khas Ikegoshi ini karena "itu"?
Dialogue: 0,0:08:09.00,0:08:12.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, gosip panas di seisi industri "itu", ya?
Dialogue: 0,0:08:12.14,0:08:15.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahun depan dia akan menikah\Ndengan Muranaka Yurika.
Dialogue: 0,0:08:18.14,0:08:19.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:08:19.00,0:08:21.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelaskan padaku
Dialogue: 0,0:08:21.15,0:08:23.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}soal yang tadi!
Dialogue: 0,0:08:24.56,0:08:26.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini juga ada!
Dialogue: 0,0:08:26.20,0:08:27.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh!
Dialogue: 0,0:08:27.15,0:08:28.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak sekali.
Dialogue: 0,0:08:28.70,0:08:30.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu jeli juga.
Dialogue: 0,0:08:30.04,0:08:31.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:08:31.16,0:08:33.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu jeli juga walau pakai baju.
Dialogue: 0,0:08:33.91,0:08:36.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kalau bugil\Nbisa menemukan lebih banyak.
Dialogue: 0,0:08:36.65,0:08:40.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru kalian yang luar biasa\Nbisa panen kastanya sambil bugil.
Dialogue: 0,0:08:40.16,0:08:45.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip, kalau terus begini\Nrasanya aku bisa dapat sesuatu!
Dialogue: 0,0:08:45.17,0:08:47.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kouhei hari ini agak beda, ya.
Dialogue: 0,0:08:47.70,0:08:50.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia lebih berguna dari biasanya.
Dialogue: 0,0:08:50.26,0:08:52.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan ingin pakai baju pula.
Dialogue: 0,0:08:52.18,0:08:55.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski rasanya ada sesuatu\Nyang tidak boleh kuturuti.
Dialogue: 0,0:08:55.84,0:08:58.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini saatnya aku melawak—
Dialogue: 0,0:09:01.19,0:09:02.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, bedebah!
Dialogue: 0,0:09:02.86,0:09:04.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kamu...
Dialogue: 0,0:09:04.19,0:09:07.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu punya kata-kata terakhir?
Dialogue: 0,0:09:07.19,0:09:09.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, dia sangat marah
Dialogue: 0,0:09:09.52,0:09:12.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena aku seenaknya tukar posisi.
Dialogue: 0,0:09:12.20,0:09:13.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:09:14.20,0:09:18.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus minta maaf dengan tulus.
Dialogue: 0,0:09:18.94,0:09:21.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf tukar tempat seenaknya!
Dialogue: 0,0:09:21.62,0:09:22.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tukar tempat?
Dialogue: 0,0:09:22.74,0:09:24.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dilihat-lihat, ada dua Kouhei.
Dialogue: 0,0:09:24.71,0:09:27.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku tidak berniat buruk!
Dialogue: 0,0:09:27.71,0:09:30.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah, tapi dia bilang\Ntidak berniat buruk, tuh.
Dialogue: 0,0:09:30.34,0:09:32.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah tulus, maafkan saja.
Dialogue: 0,0:09:32.64,0:09:34.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toh, cuma tukar posisi.
Dialogue: 0,0:09:35.16,0:09:36.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya...
Dialogue: 0,0:09:37.92,0:09:40.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meniru bisa kumaafkan.
Dialogue: 0,0:09:40.73,0:09:41.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar, tuh.
Dialogue: 0,0:09:41.84,0:09:43.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah siapa dirimu, tapi baguslah.
Dialogue: 0,0:09:43.73,0:09:44.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:09:45.02,0:09:45.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh!
Dialogue: 0,0:09:45.96,0:09:50.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pernikahanmu dengan seiyu\Ntidak bisa diampuni!
Dialogue: 0,0:09:50.74,0:09:55.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang asing, larilah!
Dialogue: 0,0:09:56.06,0:09:57.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah tenang?
Dialogue: 0,0:09:57.18,0:09:58.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan berat hati.
Dialogue: 0,0:09:58.24,0:10:01.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkadang tenagamu gila, ya.
Dialogue: 0,0:10:01.02,0:10:03.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang daripada ribut\Nmending main gim.
Dialogue: 0,0:10:03.68,0:10:04.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:10:04.25,0:10:05.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gim?
Dialogue: 0,0:10:05.60,0:10:08.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada pertikaian,\Nkami selesaikan dengan gim.
Dialogue: 0,0:10:08.84,0:10:10.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:10:10.63,0:10:11.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:10:11.92,0:10:14.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya kami tidak suka pertikaian.
Dialogue: 0,0:10:14.39,0:10:17.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah penyelesaiannya damai.
Dialogue: 0,0:10:17.32,0:10:19.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, kalau aku kalah...
Dialogue: 0,0:10:19.39,0:10:22.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu akan dibunuh sesuai keinginan Kouhei.
Dialogue: 0,0:10:22.18,0:10:24.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata tidak damai.
Dialogue: 0,0:10:25.40,0:10:28.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa menolongku, tidak?
Dialogue: 0,0:10:28.06,0:10:30.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang tampan memang layak mati.
Dialogue: 0,0:10:30.14,0:10:32.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kejam amat, sih!
Dialogue: 0,0:10:32.40,0:10:35.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua kastanyaku buat kamu, deh!
Dialogue: 0,0:10:35.41,0:10:36.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kastanya?
Dialogue: 0,0:10:36.80,0:10:39.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, meski terhitung murah\Nbuat bayar nyawa.
Dialogue: 0,0:10:39.91,0:10:41.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih!
Dialogue: 0,0:10:41.16,0:10:43.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, bagaimana cara menolongku?
Dialogue: 0,0:10:43.80,0:10:48.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan pura-pura netral dan mengusulkan\Ngim yang mengunggulkanmu.
Dialogue: 0,0:10:48.42,0:10:50.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maka dari itu...
Dialogue: 0,0:10:50.42,0:10:54.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hukuman Mati Babak Pertama!\NVoli Kastanya Berduri!
Dialogue: 0,0:10:54.93,0:10:55.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yey!
Dialogue: 0,0:10:55.82,0:10:58.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana letak amannya?
Dialogue: 0,0:10:58.43,0:11:00.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aturannya mudah.
Dialogue: 0,0:11:00.16,0:11:04.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama saja dengan voli pantai,\Ntapi bolanya pakai kastanya.
Dialogue: 0,0:11:04.88,0:11:05.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:11:05.76,0:11:06.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak oke.
Dialogue: 0,0:11:08.94,0:11:12.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikegoshi dan aku melawan\NKouhei dan Senior Kotobuki.
Dialogue: 0,0:11:12.42,0:11:15.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada Senior, aku pasti menang.
Dialogue: 0,0:11:15.95,0:11:19.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu yakin bisa menang melawannya?
Dialogue: 0,0:11:19.45,0:11:21.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:11:21.08,0:11:25.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita cuma perlu menghabisi Kouhei\Nsebelum bolanya ke Senior.
Dialogue: 0,0:11:25.76,0:11:28.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kalian teman?
Dialogue: 0,0:11:28.46,0:11:31.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, biar Kouhei yang servis.
Dialogue: 0,0:11:31.10,0:11:34.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memberi kami keuntungan?\NDasar bodoh.
Dialogue: 0,0:11:35.34,0:11:36.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai duelnya!
Dialogue: 0,0:11:36.97,0:11:39.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu yakin aman?
Dialogue: 0,0:11:39.26,0:11:41.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, aman.
Dialogue: 0,0:11:41.22,0:11:44.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian mana bisa servis pakai bola itu.
Dialogue: 0,0:11:45.46,0:11:46.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul juga.
Dialogue: 0,0:11:54.23,0:11:57.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mengorbankan tangannya, tuh!
Dialogue: 0,0:11:57.26,0:11:59.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Amarah membuatnya lupa rasa sakit.
Dialogue: 0,0:11:59.74,0:12:01.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada pilihan lain.
Dialogue: 0,0:12:01.32,0:12:03.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada rencana lain?
Dialogue: 0,0:12:04.22,0:12:06.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertahanlah sampai dia lelah.
Dialogue: 0,0:12:06.18,0:12:07.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menyuruhku mati?
Dialogue: 0,0:12:07.75,0:12:11.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Servisku mustahil ditangkap\Npria yang masih pakai baju!
Dialogue: 0,0:12:11.75,0:12:14.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya salah kalau pakai baju?
Dialogue: 0,0:12:18.76,0:12:21.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepatlah mati!
Dialogue: 0,0:12:23.26,0:12:25.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar keras kepala!
Dialogue: 0,0:12:25.50,0:12:28.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena taruhannya nyawa.
Dialogue: 0,0:12:28.27,0:12:30.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi berikutnya aku akan menang!
Dialogue: 0,0:12:30.94,0:12:33.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu akan tetap mati!
Dialogue: 0,0:12:35.72,0:12:39.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buatlah syair kematianmu, makhluk jahat!
Dialogue: 0,0:12:39.82,0:12:45.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu, otak Ikegoshi yang terpojok\Nberpikir secepat kilat,
Dialogue: 0,0:12:45.56,0:12:49.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mencari semua celah untuk bertahan hidup.
Dialogue: 0,0:12:49.04,0:12:51.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajah kita mirip!
Dialogue: 0,0:12:51.29,0:12:52.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus?
Dialogue: 0,0:12:52.79,0:12:56.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku bisa menikah dengan Yurika\Nyang seorang seiyu,
Dialogue: 0,0:12:56.06,0:13:02.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berarti kamu juga bisa\Nmenikahi seiyu juga!
Dialogue: 0,0:13:05.81,0:13:08.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Eng...
Dialogue: 0,0:13:13.56,0:13:15.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanganku sakit sekali.
Dialogue: 0,0:13:16.36,0:13:17.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:13:17.82,0:13:20.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Amarahnya sudah reda.
Dialogue: 0,0:13:20.22,0:13:22.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah memaksakan diri.
Dialogue: 0,0:13:22.82,0:13:24.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas saja pingsan.
Dialogue: 0,0:13:24.38,0:13:26.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kouhei memang cinta hobinya.
Dialogue: 0,0:13:26.44,0:13:28.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok kalian malah tertawa?
Dialogue: 0,0:13:29.86,0:13:30.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:13:30.83,0:13:34.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar Ikegoshi,\Ndia sudah jadi talenta hebat.
Dialogue: 0,0:13:34.17,0:13:36.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kita boleh merekam semua ini?
Dialogue: 0,0:13:36.14,0:13:37.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terlalu dipikirkan.
Dialogue: 0,0:13:37.72,0:13:39.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi terharu.
Dialogue: 0,0:14:15.13,0:14:18.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus, sudah kusiapkan makan siang.
Dialogue: 0,0:14:18.25,0:14:20.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman, aku memungut ini di laut.
Dialogue: 0,0:14:20.84,0:14:23.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu rajin sekali.
Dialogue: 0,0:14:23.52,0:14:26.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menyelam di laut yang bersih.
Dialogue: 0,0:14:26.01,0:14:28.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, biar kuberi hadiah.
Dialogue: 0,0:14:28.50,0:14:31.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sisa promo, sih.
Dialogue: 0,0:14:32.24,0:14:35.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lotre? Terima kasih!
Dialogue: 0,0:14:36.04,0:14:38.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat makan!
Dialogue: 0,0:14:40.53,0:14:42.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enaknya!
Dialogue: 0,0:14:43.03,0:14:45.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak sekali!
Dialogue: 0,0:14:45.18,0:14:46.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah, ya.
Dialogue: 0,0:14:46.28,0:14:48.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kita panen kastanya.
Dialogue: 0,0:14:48.53,0:14:50.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baguslah.
Dialogue: 0,0:14:50.20,0:14:52.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berterimakasihlah ke Chisa.
Dialogue: 0,0:14:52.54,0:14:54.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Chisa?
Dialogue: 0,0:14:54.54,0:14:58.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia yang mengatur\Nagar kita panen kastanya.
Dialogue: 0,0:14:58.06,0:14:59.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:14:59.55,0:15:01.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di gunung pun dia bekerja keras.
Dialogue: 0,0:15:01.80,0:15:04.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan mencari tahu ini itu.
Dialogue: 0,0:15:04.05,0:15:04.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:15:04.92,0:15:08.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berterimakasihlah juga pada kami.
Dialogue: 0,0:15:08.80,0:15:11.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu cuma bawa masalah.
Dialogue: 0,0:15:11.58,0:15:14.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku berterima kasih.
Dialogue: 0,0:15:14.02,0:15:16.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku tidak bisa balas budi.
Dialogue: 0,0:15:16.56,0:15:17.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Balas uang saja.
Dialogue: 0,0:15:17.86,0:15:18.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uang.
Dialogue: 0,0:15:18.88,0:15:20.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uang memang ajaib.
Dialogue: 0,0:15:20.70,0:15:22.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunjukkan ketulusanmu pakai uang.
Dialogue: 0,0:15:22.57,0:15:25.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kesal tidak bisa apa-apa!
Dialogue: 0,0:15:25.50,0:15:28.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada uang, aku bisa tunjukkan ketulusan!
Dialogue: 0,0:15:30.10,0:15:32.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata dapat!
Dialogue: 0,0:15:32.96,0:15:35.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa sangka aku dapat hadiahnya!
Dialogue: 0,0:15:35.70,0:15:39.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini rezeki nomplok,\Ntapi momennya kurang pas!
Dialogue: 0,0:15:39.64,0:15:42.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mereka pada tahu...
Dialogue: 0,0:15:44.34,0:15:46.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus hati-hati.
Dialogue: 0,0:15:46.38,0:15:49.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iori, kita akan berangkat!
Dialogue: 0,0:15:49.22,0:15:51.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sebentar lagi!
Dialogue: 0,0:15:54.94,0:15:56.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf terlambat.
Dialogue: 0,0:15:56.35,0:16:00.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, jangan merepotkan partnermu.
Dialogue: 0,0:16:01.82,0:16:05.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya harus kusimpan\Nrapat-rapat di tubuhku.
Dialogue: 0,0:16:05.36,0:16:07.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya cek tubuh.
Dialogue: 0,0:16:07.18,0:16:08.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:16:09.08,0:16:09.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:16:09.70,0:16:11.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, talimu terpelintir, tuh.
Dialogue: 0,0:16:11.78,0:16:12.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Mana?
Dialogue: 0,0:16:12.98,0:16:14.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini.
Dialogue: 0,0:16:18.87,0:16:21.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sentuh!
Dialogue: 0,0:16:21.38,0:16:23.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian kenapa?
Dialogue: 0,0:16:23.32,0:16:24.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terjadi sesuatu?
Dialogue: 0,0:16:24.60,0:16:26.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada apa-apa.
Dialogue: 0,0:16:27.48,0:16:30.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenanglah, diriku.\NHarus santai.
Dialogue: 0,0:16:30.89,0:16:33.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka belum tahu soal ini.
Dialogue: 0,0:16:48.40,0:16:50.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti.
Dialogue: 0,0:16:50.28,0:16:51.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke?
Dialogue: 0,0:16:52.26,0:16:54.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tarik napas perlahan.
Dialogue: 0,0:16:56.41,0:16:58.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup.
Dialogue: 0,0:16:58.32,0:17:00.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu punya uang, kan?
Dialogue: 0,0:17:00.36,0:17:02.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan semuanya padaku.
Dialogue: 0,0:17:03.26,0:17:05.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:17:05.90,0:17:07.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan
Dialogue: 0,0:17:08.30,0:17:10.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membunuh kalian semua di sini!
Dialogue: 0,0:17:11.06,0:17:12.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku naik.
Dialogue: 0,0:17:12.42,0:17:14.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat ke sini.
Dialogue: 0,0:17:14.26,0:17:16.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku turun.
Dialogue: 0,0:17:21.44,0:17:23.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terjadi sesuatu, Iori?
Dialogue: 0,0:17:23.07,0:17:26.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku cuma batuk-batuk.
Dialogue: 0,0:17:26.52,0:17:28.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kalau tidak kenapa-kenapa.
Dialogue: 0,0:17:31.84,0:17:33.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung tidak ketahuan.
Dialogue: 0,0:17:33.45,0:17:37.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibandingkan kedalaman laut yang sunyi,\Ndi sinilah ujian sebenarnya dimulai.
Dialogue: 0,0:17:37.28,0:17:39.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih belum boleh lengah.
Dialogue: 0,0:17:39.22,0:17:43.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk merahasiakan ini,\Naku harus berhati-hati sama dua hal.
Dialogue: 0,0:17:43.34,0:17:44.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:17:44.18,0:17:46.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak menang lotre, kok.
Dialogue: 0,0:17:46.90,0:17:48.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:17:48.02,0:17:50.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menang lotre!
Dialogue: 0,0:17:50.46,0:17:51.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, wah!
Dialogue: 0,0:17:52.26,0:17:56.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini mah gampang buat aku\Nyang jago jaga ekspresi.
Dialogue: 0,0:17:56.22,0:17:58.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini birmu.
Dialogue: 0,0:17:58.20,0:18:00.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini enggak dulu.
Dialogue: 0,0:18:02.70,0:18:04.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, ada apa?
Dialogue: 0,0:18:04.38,0:18:06.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak ada!
Dialogue: 0,0:18:06.23,0:18:08.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau jujur,\Nkamu bisa mati dengan tenang!
Dialogue: 0,0:18:08.54,0:18:10.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku jujur, biarkan aku hidup!
Dialogue: 0,0:18:10.24,0:18:12.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iori, kami sedih.
Dialogue: 0,0:18:12.66,0:18:13.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:18:13.70,0:18:17.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tahu kamu punya seratus atau\Ndua ratus masalah yang dipendam.
Dialogue: 0,0:18:17.88,0:18:19.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa enggak kebanyakan?
Dialogue: 0,0:18:19.20,0:18:21.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kami sudah tahu itu,
Dialogue: 0,0:18:21.30,0:18:24.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kamu tetap junior kami yang manis.
Dialogue: 0,0:18:24.75,0:18:28.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah apa yang mengganggumu,\Ntapi ceritakan saja.
Dialogue: 0,0:18:28.06,0:18:30.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tidak akan mengejekmu.
Dialogue: 0,0:18:31.64,0:18:33.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior...
Dialogue: 0,0:18:33.88,0:18:37.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga bakal begini!
Dialogue: 0,0:18:37.39,0:18:40.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa sangka kamu menang lotre!
Dialogue: 0,0:18:40.89,0:18:43.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan main rahasia-rahasiaan\Nsama sesama anggota, dong!
Dialogue: 0,0:18:43.89,0:18:45.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menang berapa?
Dialogue: 0,0:18:45.58,0:18:46.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak mau bilang!
Dialogue: 0,0:18:46.90,0:18:49.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kasih siksaan air gaya Pab saja kali, ya?
Dialogue: 0,0:18:49.40,0:18:51.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siksaan itu kayaknya seram banget!
Dialogue: 0,0:18:51.90,0:18:55.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior, bukannya kita harus menyelesaikan\Nmasalah lewat gim?
Dialogue: 0,0:18:55.62,0:18:56.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:18:56.26,0:18:57.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya juga.
Dialogue: 0,0:18:57.91,0:19:00.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku punya gim seru.
Dialogue: 0,0:19:00.46,0:19:03.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mendebarkan!\NPermainan Detektor Kebohongan!
Dialogue: 0,0:19:04.79,0:19:07.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu interogasi berkedok gim namanya!
Dialogue: 0,0:19:09.56,0:19:13.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu menang di atas 100.000 yen?
Dialogue: 0,0:19:13.42,0:19:14.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:19:14.28,0:19:16.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, apa alatnya rusak?
Dialogue: 0,0:19:16.43,0:19:18.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara waktu itu, ya?
Dialogue: 0,0:19:19.43,0:19:20.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun.
Dialogue: 0,0:19:20.66,0:19:22.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau bagaimana lagi.
Dialogue: 0,0:19:22.43,0:19:24.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya kalian menyerah juga.
Dialogue: 0,0:19:25.84,0:19:30.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa sangka keahlian yang kupelajari\Ndi Jurusan Teknik bisa berguna.
Dialogue: 0,0:19:30.44,0:19:32.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karya yang luar biasa!
Dialogue: 0,0:19:32.32,0:19:35.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia ini selalu begitu kejam padaku!
Dialogue: 0,0:19:35.80,0:19:37.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabel-kabel apa ini?
Dialogue: 0,0:19:37.20,0:19:41.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, itu pembatas yang dipasang\Ndemi alasan keamanan.
Dialogue: 0,0:19:41.45,0:19:45.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dirancang untuk memutus arus listrik\Ntepat sebelum kamu pingsan.
Dialogue: 0,0:19:45.46,0:19:50.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu mah buat menahan korban tetap sadar\Nsambil menyiksanya tanpa henti!
Dialogue: 0,0:19:50.46,0:19:51.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengaku saja!
Dialogue: 0,0:19:51.62,0:19:54.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak sudi!
Dialogue: 0,0:19:54.34,0:19:56.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chisa, kamu pasti memahamiku, kan?
Dialogue: 0,0:19:57.20,0:19:59.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Paham apanya?
Dialogue: 0,0:19:59.72,0:20:02.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil kalau aku merahasiakan sesuatu.
Dialogue: 0,0:20:08.86,0:20:10.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti merahasiakan sesuatu.
Dialogue: 0,0:20:10.73,0:20:15.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chisa!
Dialogue: 0,0:20:15.74,0:20:17.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sembunyikan di kamar?
Dialogue: 0,0:20:17.38,0:20:18.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak...
Dialogue: 0,0:20:19.24,0:20:21.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dalam toko?
Dialogue: 0,0:20:21.10,0:20:22.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak di mana-mana...
Dialogue: 0,0:20:27.96,0:20:29.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar orang-orang biadab.
Dialogue: 0,0:20:30.36,0:20:33.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedikit lagi tadi aku hampir menyerah.
Dialogue: 0,0:20:35.84,0:20:37.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kita kebablasan?
Dialogue: 0,0:20:42.10,0:20:43.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih hidup, toh.
Dialogue: 0,0:20:43.68,0:20:46.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Khawatirlah sedikit sama aku.
Dialogue: 0,0:20:46.48,0:20:48.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teganya kamu mengkhianatiku.
Dialogue: 0,0:20:49.36,0:20:50.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengkhianati?
Dialogue: 0,0:20:51.34,0:20:52.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal apa?
Dialogue: 0,0:20:52.16,0:20:56.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia benar-benar enggak ingat rupanya.
Dialogue: 0,0:20:56.90,0:21:00.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya rahasiakan lotreku\Nsebagai sesama kawan.
Dialogue: 0,0:21:00.80,0:21:03.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan panggil aku\Npakai sebutan aneh begitu.
Dialogue: 0,0:21:04.37,0:21:05.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya kita memang kawan?
Dialogue: 0,0:21:05.91,0:21:08.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Kenapa aku harus...
Dialogue: 0,0:21:08.91,0:21:11.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu lupa janji kita?
Dialogue: 0,0:21:13.18,0:21:16.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kalau aku menang lotre,\Naku akan mengajakmu ke sana.
Dialogue: 0,0:21:16.90,0:21:19.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kutunggu tanpa berharap.
Dialogue: 0,0:21:20.68,0:21:23.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita pergi ke Okinawa.
Dialogue: 0,0:21:27.10,0:21:29.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu serius soal itu?
Dialogue: 0,0:21:29.18,0:21:32.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku senang\Ndengan perhatianmu waktu itu.
Dialogue: 0,0:21:32.69,0:21:33.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh...
Dialogue: 0,0:21:34.48,0:21:35.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:21:35.69,0:21:38.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar kamu yang mengusulkan\Nide memetik kastanya itu.
Dialogue: 0,0:21:38.92,0:21:41.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kamu sebenarnya menang berapa?
Dialogue: 0,0:21:41.70,0:21:43.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}300.000 yen.
Dialogue: 0,0:21:44.70,0:21:47.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai dapat sepuluh juta,\Naku mau ajak semuanya.
Dialogue: 0,0:21:47.50,0:21:49.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekspektasimu ketinggian.
Dialogue: 0,0:21:49.74,0:21:51.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya berandai-andai.
Dialogue: 0,0:21:51.54,0:21:53.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, ayo kita pergi berdua!
Dialogue: 0,0:21:59.14,0:22:00.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:22:00.02,0:22:01.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu...
Dialogue: 0,0:22:01.74,0:22:03.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu keberatan?
Dialogue: 0,0:22:03.34,0:22:05.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, aku...
Dialogue: 0,0:22:06.64,0:22:08.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak keberatan.
Dialogue: 0,0:22:11.10,0:22:15.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan!
