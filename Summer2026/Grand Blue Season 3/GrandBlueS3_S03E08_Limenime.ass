Dialogue: 0,0:00:00.00,0:00:00.27,sign,,0000,0000,0000,,ACARA INI ADALAH KARYA FIKSI.
Dialogue: 0,0:00:00.27,0:00:00.58,sign,,0000,0000,0000,,ANAK DI BAWAH UMUR DILARANG KERAS\NMINUM ALKOHOL OLEH HUKUM.
Dialogue: 0,0:00:00.58,0:00:01.09,sign,,0000,0000,0000,,KAMI JUGA TIDAK BERMAKSUD MENGANJURKAN\NPEMAKSAAN MINUM ALKOHOL,
Dialogue: 0,0:00:01.09,0:00:01.79,sign,,0000,0000,0000,,KONSUMSI ALKOHOL BERLEBIHAN, MAUPUN TINDAKAN\NTIDAK SENONOH SAAT PESTA MINUM.
Dialogue: 0,0:00:01.79,0:00:02.40,sign,,0000,0000,0000,,MOHON ANGGAP INI SEMATA-MATA\NSEBAGAI ANIME KOMEDI.
Dialogue: 0,0:00:02.40,0:00:03.10,sign,,0000,0000,0000,,SELURUH KARAKTER YANG MENGONSUMSI\NALKOHOL DALAM KARYA INI
Dialogue: 0,0:00:03.10,0:00:03.68,sign,,0000,0000,0000,,TELAH BERUSIA 20 TAHUN ATAU LEBIH.
Dialogue: 0,0:00:03.68,0:00:04.38,sign,,0000,0000,0000,,DEMI MENYESUAIKAN DENGAN STANDAR\NKEPATUHAN TERKINI.
Dialogue: 0,0:00:04.38,0:00:05.00,sign,,0000,0000,0000,,MULAI MUSIM INI\NUKURAN SENSOR HITAM KAMI NAIK 5%.
Dialogue: 0,0:00:17.29,0:00:25.30,sign,,0000,0000,0000,,GRAND BLUE MUSIM 3
Dialogue: 0,0:01:53.51,0:01:56.26,sign,,0000,0000,0000,,LAB TEKNIK MESIN 2, SEDANG REMEDIAL
Dialogue: 0,0:03:29.61,0:03:31.61,sign,,0000,0000,0000,,PENDETEKSI KEBOHONGAN\N(1980 YEN)
Dialogue: 0,0:03:43.12,0:03:46.41,sign,,0000,0000,0000,,MEKANISME PENDETEKSI KEBOHONGAN (1980 YEN)
Dialogue: 0,0:03:46.41,0:03:47.50,sign,,0000,0000,0000,,AKU TIDAK MINAT SAMA ANIME
Dialogue: 0,0:03:47.50,0:03:48.37,sign,,0000,0000,0000,,TEEET
Dialogue: 0,0:03:48.37,0:03:50.13,sign,,0000,0000,0000,,BOHONG
Dialogue: 0,0:04:00.89,0:04:02.64,sign,,0000,0000,0000,,PENDETEKSI KEBOHONGAN\NVERSI UJI BENTURAN CHARPY
Dialogue: 0,0:09:38.47,0:09:40.48,sign,,0000,0000,0000,,IZAKAYA MUMBO JUMBO\NSENANG, BIR SEGAR
Dialogue: 0,0:11:12.32,0:11:14.32,sign,,0000,0000,0000,,JUNIOR
Dialogue: 0,0:11:14.32,0:11:16.32,sign,,0000,0000,0000,,ADIK PEREMPUAN
Dialogue: 0,0:11:16.32,0:11:18.32,sign,,0000,0000,0000,,PACARNYA MITARAI
Dialogue: 0,0:11:37.84,0:11:41.85,sign,,0000,0000,0000,,MITARAI YUU
Dialogue: 0,0:12:01.87,0:12:03.87,sign,,0000,0000,0000,,CADANGAN
Dialogue: 0,0:12:03.87,0:12:07.37,sign,,0000,0000,0000,,HIKS
Dialogue: 0,0:12:18.63,0:12:22.26,sign,,0000,0000,0000,,CUMA KENAL VERSI INI
Dialogue: 0,0:13:30.33,0:13:32.44,sign,,0000,0000,0000,,MERINDING
Dialogue: 0,0:15:18.94,0:15:22.44,sign,,0000,0000,0000,,GADIS SIHIR RARAKO
Dialogue: 0,0:16:19.75,0:16:23.25,sign,,0000,0000,0000,,PENDETEKSI KEBOHONGAN
Dialogue: 0,0:17:21.69,0:17:23.81,sign,,0000,0000,0000,,CINTA
Dialogue: 0,0:18:03.85,0:18:05.86,sign,,0000,0000,0000,,HAHA
Dialogue: 0,0:18:44.90,0:18:51.40,sign,,0000,0000,0000,,HEHE
Dialogue: 0,0:19:18.43,0:19:23.49,sign,,0000,0000,0000,,MAUT, X 200
Dialogue: 0,0:19:23.49,0:19:25.44,sign,,0000,0000,0000,,KUAT, SEDANG, RENDAH
Dialogue: 0,0:23:44.94,0:23:49.95,sign,,0000,0000,0000,,SELANJUTNYA: PENDERITAAN
Dialogue: 0,0:01:37.40,0:01:40.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu kelas 1 SMA di musim panas,
Dialogue: 0,0:01:40.96,0:01:42.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}keperjakaanku hilang.
Dialogue: 0,0:01:43.25,0:01:44.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:01:44.75,0:01:46.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok cuek amat?
Dialogue: 0,0:01:46.75,0:01:48.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya...
Dialogue: 0,0:01:49.21,0:01:53.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami enggak minat mendengarkan dongeng.
Dialogue: 0,0:01:53.51,0:01:56.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan dongeng, woi!
Dialogue: 0,0:01:56.67,0:02:01.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kisah nyataku dan Elena,\Nmahasiswi yang jadi guru privatku.
Dialogue: 0,0:02:01.21,0:02:02.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, cerita film bokep?
Dialogue: 0,0:02:02.92,0:02:04.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau gim porno?
Dialogue: 0,0:02:04.51,0:02:06.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini cerita asli, kok.
Dialogue: 0,0:02:06.52,0:02:10.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau saja ada Elena,\Ndia pasti mengiyakan.
Dialogue: 0,0:02:10.31,0:02:11.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:02:11.49,0:02:13.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali.
Dialogue: 0,0:02:13.03,0:02:15.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kisah begitu mah aku juga punya.
Dialogue: 0,0:02:16.03,0:02:16.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:02:16.75,0:02:18.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ceritakan.
Dialogue: 0,0:02:18.56,0:02:22.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu SMP, aku bahkan\Npunya klub penggemar.
Dialogue: 0,0:02:22.29,0:02:26.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?\NJangan mengarang, deh!
Dialogue: 0,0:02:26.23,0:02:27.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ngaca, gih.
Dialogue: 0,0:02:27.79,0:02:31.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada teman SMP-ku,\Ndia pasti mengiyakan.
Dialogue: 0,0:02:31.28,0:02:34.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih, dasar pendongeng handal!
Dialogue: 0,0:02:34.05,0:02:36.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, masa kalian enggak pernah?
Dialogue: 0,0:02:36.80,0:02:39.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ih, kasihan banget!
Dialogue: 0,0:02:39.06,0:02:40.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak saja!
Dialogue: 0,0:02:40.56,0:02:42.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas pernah, lah!
Dialogue: 0,0:02:42.56,0:02:46.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak SD aku dijuluki anak ajaib!
Dialogue: 0,0:02:46.00,0:02:48.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu aku preman kampung!
Dialogue: 0,0:02:48.56,0:02:49.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, masa?
Dialogue: 0,0:02:49.83,0:02:52.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatan bohongnya, tuh.
Dialogue: 0,0:02:52.07,0:02:53.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa katamu?
Dialogue: 0,0:02:54.07,0:02:57.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berisik sekali!
Dialogue: 0,0:02:58.57,0:03:00.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersiaplah dengan khidmat
Dialogue: 0,0:03:00.93,0:03:04.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk kelasku yang suci ini.
Dialogue: 0,0:03:04.51,0:03:05.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Pak!
Dialogue: 0,0:03:05.80,0:03:07.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berbohong!
Dialogue: 0,0:03:07.59,0:03:08.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bohong.
Dialogue: 0,0:03:08.97,0:03:10.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bilang saja iri!
Dialogue: 0,0:03:10.59,0:03:12.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bohong?
Dialogue: 0,0:03:13.53,0:03:16.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian masih gampang dibodohi?
Dialogue: 0,0:03:16.77,0:03:18.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya tidak.
Dialogue: 0,0:03:18.81,0:03:21.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi mereka tidak mengaku.
Dialogue: 0,0:03:21.97,0:03:23.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu!
Dialogue: 0,0:03:23.60,0:03:26.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari buktikan dengan sains!
Dialogue: 0,0:03:26.10,0:03:27.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan sains?
Dialogue: 0,0:03:27.27,0:03:28.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Caranya?
Dialogue: 0,0:03:31.61,0:03:33.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pak Dosen.
Dialogue: 0,0:03:33.24,0:03:35.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya ini mainan?
Dialogue: 0,0:03:35.49,0:03:37.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana bisa diandalkan?
Dialogue: 0,0:03:37.76,0:03:39.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar murid bego.
Dialogue: 0,0:03:39.13,0:03:40.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:03:40.62,0:03:43.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahu cara kerja benda ini, kan?
Dialogue: 0,0:03:43.12,0:03:46.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benda ini mendeteksi denyut jantung
Dialogue: 0,0:03:46.41,0:03:48.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mendeteksi kebohongan
Dialogue: 0,0:03:48.37,0:03:50.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari perubahannya.
Dialogue: 0,0:03:50.13,0:03:52.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan mempan buat mereka.
Dialogue: 0,0:03:52.68,0:03:55.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berbohongnya sudah kayak bernapas.
Dialogue: 0,0:03:55.77,0:03:57.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tahu.
Dialogue: 0,0:03:57.97,0:04:00.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya kita pakai ilmu teknik.
Dialogue: 0,0:04:02.64,0:04:07.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini mental yang berbohong\Nakan lebih terbebani.
Dialogue: 0,0:04:07.39,0:04:09.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dosen kita memang genius!
Dialogue: 0,0:04:09.72,0:04:12.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang berbohong bakal tamat, nih!
Dialogue: 0,0:04:12.90,0:04:16.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, ayo kita tes alatnya.
Dialogue: 0,0:04:16.12,0:04:18.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, Yamamoto, cobalah berbohong.
Dialogue: 0,0:04:18.81,0:04:19.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku?
Dialogue: 0,0:04:19.91,0:04:21.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa saja boleh.
Dialogue: 0,0:04:21.20,0:04:23.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya,
Dialogue: 0,0:04:24.43,0:04:27.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selama ini aku hidup dengan jujur.
Dialogue: 0,0:04:36.25,0:04:37.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berfungsi normal.
Dialogue: 0,0:04:37.72,0:04:40.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alat eksperimen yang hebat.
Dialogue: 0,0:04:40.24,0:04:42.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya hancurnya mematikan.
Dialogue: 0,0:04:42.43,0:04:45.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur adalah ciri khasku.
Dialogue: 0,0:04:45.87,0:04:47.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup bohongnya.
Dialogue: 0,0:04:47.20,0:04:49.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunyi terus, tuh.
Dialogue: 0,0:04:49.44,0:04:51.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo mulai dari yang pasti bohong.
Dialogue: 0,0:04:51.79,0:04:52.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul.
Dialogue: 0,0:04:52.56,0:04:54.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat sana, Nojima.
Dialogue: 0,0:04:54.29,0:04:55.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurang ajar!
Dialogue: 0,0:04:55.94,0:04:58.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beraninya mengataiku pembohong!
Dialogue: 0,0:04:58.84,0:05:01.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ogah! Aku pulang saja!
Dialogue: 0,0:05:02.27,0:05:06.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kebenaran harus diungkap.\N- Enak saja.
Dialogue: 0,0:05:06.00,0:05:07.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih!
Dialogue: 0,0:05:07.95,0:05:10.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan berniat kabur!
Dialogue: 0,0:05:10.60,0:05:11.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus?
Dialogue: 0,0:05:11.67,0:05:14.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma muak dianggap berbohong!
Dialogue: 0,0:05:14.91,0:05:15.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:05:15.75,0:05:17.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:05:17.88,0:05:19.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kouhei, majulah duluan.
Dialogue: 0,0:05:20.19,0:05:22.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah.
Dialogue: 0,0:05:22.15,0:05:23.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu yakin?
Dialogue: 0,0:05:23.33,0:05:26.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santai, aku cuma harus berkata jujur.
Dialogue: 0,0:05:26.72,0:05:28.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya juga.
Dialogue: 0,0:05:28.28,0:05:30.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba katakan sesuatu.
Dialogue: 0,0:05:30.01,0:05:30.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:05:31.27,0:05:34.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya aku diam saja...
Dialogue: 0,0:05:37.23,0:05:38.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa...
Dialogue: 0,0:05:38.43,0:05:41.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya kamu bicara, tidak diam saja.
Dialogue: 0,0:05:41.65,0:05:43.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu juga dihitung bohong?
Dialogue: 0,0:05:43.67,0:05:45.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kan baru kata pembuka!
Dialogue: 0,0:05:46.81,0:05:49.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggil aku kalau kalian selesai.
Dialogue: 0,0:05:49.51,0:05:50.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok malah pergi?
Dialogue: 0,0:05:50.77,0:05:52.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tidak diawasi?
Dialogue: 0,0:05:52.25,0:05:54.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beraninya kamu menjebakku!
Dialogue: 0,0:05:54.72,0:05:57.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok aku yang disalahkan?
Dialogue: 0,0:05:57.09,0:05:59.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan banyak alasan!
Dialogue: 0,0:05:59.26,0:06:01.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan, ikat Kitahara.
Dialogue: 0,0:06:01.52,0:06:02.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:06:02.76,0:06:04.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bedebah kalian!
Dialogue: 0,0:06:06.55,0:06:09.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, tinggal berkata jujur saja.
Dialogue: 0,0:06:09.95,0:06:12.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya waktu SMA,
Dialogue: 0,0:06:12.52,0:06:14.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku pacara...
Dialogue: 0,0:06:16.12,0:06:16.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah.
Dialogue: 0,0:06:17.52,0:06:18.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bangun!
Dialogue: 0,0:06:18.95,0:06:22.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selesaikan ucapanmu, baru mati!
Dialogue: 0,0:06:22.03,0:06:24.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang giliran Mitarai.
Dialogue: 0,0:06:24.40,0:06:25.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul.
Dialogue: 0,0:06:25.43,0:06:27.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu punya klub penggemar\Nwaktu SMP, kan?
Dialogue: 0,0:06:27.88,0:06:29.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya.
Dialogue: 0,0:06:29.29,0:06:31.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat buktikan sana.
Dialogue: 0,0:06:31.93,0:06:34.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertaruhkan nyawamu.
Dialogue: 0,0:06:35.77,0:06:37.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:06:37.76,0:06:39.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau tanya.
Dialogue: 0,0:06:39.64,0:06:40.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:06:40.73,0:06:44.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benaran populer waktu SMP?
Dialogue: 0,0:06:44.05,0:06:45.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:06:46.93,0:06:48.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak bohong.
Dialogue: 0,0:06:48.67,0:06:50.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:06:50.20,0:06:52.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba lebih spesifik!
Dialogue: 0,0:06:52.06,0:06:54.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sering ditembak?
Dialogue: 0,0:06:54.36,0:06:55.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:06:55.55,0:06:56.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi!
Dialogue: 0,0:06:56.47,0:06:59.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benaran punya klub penggemar?
Dialogue: 0,0:06:59.27,0:07:00.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:07:00.57,0:07:01.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil!
Dialogue: 0,0:07:01.28,0:07:03.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata itu fakta!
Dialogue: 0,0:07:03.76,0:07:04.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh.
Dialogue: 0,0:07:04.57,0:07:06.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah puas, kan?
Dialogue: 0,0:07:08.57,0:07:11.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin aku bohong soal ini...
Dialogue: 0,0:07:11.07,0:07:12.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa...
Dialogue: 0,0:07:12.20,0:07:13.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:07:13.08,0:07:14.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kitahara?
Dialogue: 0,0:07:14.57,0:07:17.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa...
Dialogue: 0,0:07:17.53,0:07:20.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah penggemarmu
Dialogue: 0,0:07:20.57,0:07:23.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}isinya cewek manusia?
Dialogue: 0,0:07:30.10,0:07:31.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Woi, Mitarai!
Dialogue: 0,0:07:31.65,0:07:33.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penggemarmu makhluk apa?
Dialogue: 0,0:07:34.87,0:07:35.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip.
Dialogue: 0,0:07:36.07,0:07:37.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang,
Dialogue: 0,0:07:37.49,0:07:40.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}giliran bintang utama kita.
Dialogue: 0,0:07:47.26,0:07:48.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sederhananya,
Dialogue: 0,0:07:49.19,0:07:52.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ini bukan pendeteksi kebohongan.
Dialogue: 0,0:07:52.60,0:07:55.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini alat ukur perubahan denyut jantung.
Dialogue: 0,0:07:55.77,0:07:58.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa bereaksi meski tidak berbohong.
Dialogue: 0,0:07:59.13,0:08:00.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti,
Dialogue: 0,0:08:01.08,0:08:05.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kebenaran bisa aku sulap\Njadi kebohongan!
Dialogue: 0,0:08:05.13,0:08:08.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paling kenangan SMA-nya cuma dongeng.
Dialogue: 0,0:08:08.40,0:08:10.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh menyedihkan.
Dialogue: 0,0:08:10.28,0:08:13.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sehina itulah pria bernama Nojima.
Dialogue: 0,0:08:16.36,0:08:17.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlebih lagi!
Dialogue: 0,0:08:18.33,0:08:21.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian telah mengotori nama baikku!
Dialogue: 0,0:08:21.90,0:08:24.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepatlah, dasar pinokio!
Dialogue: 0,0:08:24.20,0:08:26.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katakan bahwa kamu tidak perjaka!
Dialogue: 0,0:08:26.63,0:08:28.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akuilah kebohonganmu!
Dialogue: 0,0:08:28.83,0:08:29.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:08:30.91,0:08:31.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya,
Dialogue: 0,0:08:32.55,0:08:36.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}waktu kelas 1 SMA, keperjakaanku...
Dialogue: 0,0:08:40.27,0:08:42.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak hilang!
Dialogue: 0,0:08:45.96,0:08:48.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia masih enggan mengaku!
Dialogue: 0,0:08:48.01,0:08:51.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski berkata jujur, bijinya hancur!
Dialogue: 0,0:08:51.61,0:08:54.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pak, ini produk gagal.
Dialogue: 0,0:08:54.01,0:08:56.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahan napas saja bisa kena.
Dialogue: 0,0:08:56.59,0:08:59.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ucapan jujur malah dianggap bohong.
Dialogue: 0,0:08:59.21,0:08:59.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:09:00.49,0:09:02.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kucatat.
Dialogue: 0,0:09:06.07,0:09:07.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, Kitahara!
Dialogue: 0,0:09:07.63,0:09:09.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nojima, ada apa?
Dialogue: 0,0:09:09.20,0:09:11.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izin nyontek PR buat besok!
Dialogue: 0,0:09:11.79,0:09:14.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum kamu kerjakan?
Dialogue: 0,0:09:14.00,0:09:16.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira itu buat minggu depan!
Dialogue: 0,0:09:16.70,0:09:19.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong siapkan,\Nselagi aku menuju rumahmu!
Dialogue: 0,0:09:19.92,0:09:21.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Rumahku?
Dialogue: 0,0:09:21.35,0:09:23.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, aku belum siap!
Dialogue: 0,0:09:23.93,0:09:26.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aman, kamarmu kotor pun
Dialogue: 0,0:09:26.21,0:09:27.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukan masalah!
Dialogue: 0,0:09:29.15,0:09:30.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah.
Dialogue: 0,0:09:30.67,0:09:32.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu teman Iori?
Dialogue: 0,0:09:33.22,0:09:35.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kitahara!
Dialogue: 0,0:09:35.69,0:09:38.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kulakukan apa saja\Ndemi pengampunan!
Dialogue: 0,0:09:40.48,0:09:42.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maka dari itu,
Dialogue: 0,0:09:42.48,0:09:44.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kitahara menyiapkan kencan buta.
Dialogue: 0,0:09:45.51,0:09:47.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Indahnya persahabatan.
Dialogue: 0,0:09:47.48,0:09:49.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bravo.
Dialogue: 0,0:09:49.81,0:09:52.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku disiksa dulu lima jam.
Dialogue: 0,0:09:52.49,0:09:54.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ceweknya dari mana?
Dialogue: 0,0:09:55.33,0:09:57.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti diajak Nanaka.
Dialogue: 0,0:09:57.73,0:10:00.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengajak teman-temanku?
Dialogue: 0,0:10:00.05,0:10:01.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf merepotkan.
Dialogue: 0,0:10:03.08,0:10:04.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat malam.
Dialogue: 0,0:10:06.61,0:10:08.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian cepat sekali.
Dialogue: 0,0:10:10.88,0:10:12.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buru-buru amat!
Dialogue: 0,0:10:12.51,0:10:15.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kamu kenal malaikatku?
Dialogue: 0,0:10:15.23,0:10:17.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan asal klaim, Nyet!
Dialogue: 0,0:10:19.77,0:10:23.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bertemu malaikat.
Dialogue: 0,0:10:24.55,0:10:28.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, aku belum kepikiran\Nnama anak kami.
Dialogue: 0,0:10:28.33,0:10:30.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mengkhayalkan istriku!
Dialogue: 0,0:10:30.39,0:10:32.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu istriku!
Dialogue: 0,0:10:32.19,0:10:34.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal tahu saja.
Dialogue: 0,0:10:34.49,0:10:38.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau macam-macam ke Nanaka,\Nkalian akan kubunuh!
Dialogue: 0,0:10:41.54,0:10:43.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku siap.
Dialogue: 0,0:10:44.54,0:10:48.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal bisa dekat gadis cantik itu\Nnyawa memang sepele!
Dialogue: 0,0:10:48.63,0:10:50.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setuju!
Dialogue: 0,0:10:51.55,0:10:54.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang, aku akan membuatnya bahagia!
Dialogue: 0,0:10:54.21,0:10:55.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan kubuat menangis!
Dialogue: 0,0:10:55.85,0:10:58.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku janji setia seumur hidup!
Dialogue: 0,0:10:59.20,0:11:00.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian...
Dialogue: 0,0:11:00.80,0:11:02.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:11:02.92,0:11:04.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terlambat?
Dialogue: 0,0:11:06.72,0:11:08.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya mau setia?
Dialogue: 0,0:11:08.31,0:11:10.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mengundang Azusa?
Dialogue: 0,0:11:10.56,0:11:12.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, selain itu...
Dialogue: 0,0:11:12.32,0:11:14.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo.
Dialogue: 0,0:11:20.33,0:11:21.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lah, kok?
Dialogue: 0,0:11:22.52,0:11:24.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aina yang mengajaknya.
Dialogue: 0,0:11:24.21,0:11:27.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia teman baruku, Oohashi Rie.
Dialogue: 0,0:11:27.15,0:11:29.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, aku izin menumpang.
Dialogue: 0,0:11:30.53,0:11:31.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menumpang?
Dialogue: 0,0:11:31.84,0:11:33.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:11:33.15,0:11:35.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai mangsaku terjebak.
Dialogue: 0,0:11:36.57,0:11:37.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:11:37.84,0:11:39.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini ada kencan buta?
Dialogue: 0,0:11:39.40,0:11:41.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku segera datang, tunggu!
Dialogue: 0,0:11:41.85,0:11:44.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak diajak,\Nsebaiknya jangan datang.
Dialogue: 0,0:11:44.69,0:11:46.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bercanda!
Dialogue: 0,0:11:46.31,0:11:49.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengganas malam ini!
Dialogue: 0,0:11:49.86,0:11:52.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, dia sudah dekat.
Dialogue: 0,0:11:52.33,0:11:53.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:11:53.85,0:11:57.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kupanggilkan cadangan,\Nmaaf merepotkan.
Dialogue: 0,0:12:03.87,0:12:06.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, jangan menangis!
Dialogue: 0,0:12:07.37,0:12:09.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok malah kamu, sih?
Dialogue: 0,0:12:09.32,0:12:11.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kata-kataku!
Dialogue: 0,0:12:12.29,0:12:16.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira kencan butanya sama orang baru.
Dialogue: 0,0:12:16.61,0:12:17.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga.
Dialogue: 0,0:12:17.68,0:12:18.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:12:18.63,0:12:22.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya kami baru kenal.
Dialogue: 0,0:12:22.97,0:12:25.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau itu semacam rayuan?
Dialogue: 0,0:12:25.14,0:12:28.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti dia tertarik padaku?
Dialogue: 0,0:12:38.61,0:12:41.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setiamu sama tiga orang?
Dialogue: 0,0:12:41.47,0:12:43.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sumpitnya patah sendiri.
Dialogue: 0,0:12:43.66,0:12:45.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo bersulang dulu.
Dialogue: 0,0:12:46.24,0:12:48.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersulang!
Dialogue: 0,0:12:48.29,0:12:51.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian pernah ke festival\Nuniversitas kami, kan?
Dialogue: 0,0:12:51.31,0:12:52.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian akrab, ya?
Dialogue: 0,0:12:52.51,0:12:53.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kok.
Dialogue: 0,0:12:54.20,0:12:55.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dikira teman mereka.
Dialogue: 0,0:12:55.77,0:12:56.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi malu.
Dialogue: 0,0:12:56.80,0:12:57.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi
Dialogue: 0,0:12:57.81,0:12:58.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesengsaraan.
Dialogue: 0,0:12:58.52,0:13:00.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}teman, apa pun kulakukan.
Dialogue: 0,0:13:00.30,0:13:04.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, siapa incaran mereka?
Dialogue: 0,0:13:04.65,0:13:06.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gegabah!
Dialogue: 0,0:13:06.31,0:13:08.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nekat!
Dialogue: 0,0:13:08.31,0:13:11.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ideal memang mereka berdua.
Dialogue: 0,0:13:11.53,0:13:14.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi mustahil buat orang selevel kami.
Dialogue: 0,0:13:14.82,0:13:18.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan yang kayaknya tertarik padaku...
Dialogue: 0,0:13:20.82,0:13:21.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ih?
Dialogue: 0,0:13:22.32,0:13:24.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng...
Dialogue: 0,0:13:28.55,0:13:30.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa, Menor?
Dialogue: 0,0:13:32.44,0:13:33.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kenapa?
Dialogue: 0,0:13:33.59,0:13:36.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok tiba-tiba syok begitu?
Dialogue: 0,0:13:36.69,0:13:40.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah kuberi sinyal, selanjutnya...
Dialogue: 0,0:13:40.05,0:13:42.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku keren?
Dialogue: 0,0:13:43.41,0:13:44.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:13:44.79,0:13:46.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya?
Dialogue: 0,0:13:46.97,0:13:48.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu suka perjaka?
Dialogue: 0,0:13:48.73,0:13:51.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang ini kenapa, sih?
Dialogue: 0,0:13:51.10,0:13:53.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si bodoh ini enggak jelas!
Dialogue: 0,0:13:53.29,0:13:55.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merusak suasana saja!
Dialogue: 0,0:13:59.48,0:14:00.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perjaka, ya.
Dialogue: 0,0:14:00.99,0:14:02.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak keberatan, sih.
Dialogue: 0,0:14:03.86,0:14:05.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dewi!
Dialogue: 0,0:14:05.35,0:14:08.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemarilah, anak-anak.
Dialogue: 0,0:14:08.87,0:14:10.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang lain bagaimana?
Dialogue: 0,0:14:10.87,0:14:14.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kurang paham soal itu.
Dialogue: 0,0:14:14.37,0:14:17.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak kepikiran ke situ.
Dialogue: 0,0:14:17.88,0:14:19.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tertarik.
Dialogue: 0,0:14:22.53,0:14:25.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Najis banget harus sama perjaka jelek.
Dialogue: 0,0:14:25.32,0:14:26.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedas sekali!
Dialogue: 0,0:14:26.85,0:14:29.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, jangan dipikirkan.
Dialogue: 0,0:14:29.85,0:14:32.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung aku tidak jelek.
Dialogue: 0,0:14:32.24,0:14:33.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Positif banget!
Dialogue: 0,0:14:34.31,0:14:36.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, perjaka juga boleh?
Dialogue: 0,0:14:36.87,0:14:39.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai dari posisi apa pun bebas?
Dialogue: 0,0:14:39.63,0:14:41.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa situasi kesukaanmu?\N- Sabar dulu.
Dialogue: 0,0:14:41.90,0:14:44.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang lain kurang nyaman sama topiknya.
Dialogue: 0,0:14:44.72,0:14:46.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo bahas hal umum.
Dialogue: 0,0:14:46.15,0:14:46.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:14:46.96,0:14:48.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kurang peka.
Dialogue: 0,0:14:48.59,0:14:50.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari bahas hal umum!
Dialogue: 0,0:14:57.77,0:15:00.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bokep baru yang kutonton bagus banget.
Dialogue: 0,0:15:00.93,0:15:02.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, yang itu!
Dialogue: 0,0:15:02.44,0:15:03.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang bagus, sih.
Dialogue: 0,0:15:04.79,0:15:06.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:15:06.91,0:15:08.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:15:08.43,0:15:11.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kencannya membosankan.
Dialogue: 0,0:15:11.12,0:15:13.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba ceritakan hal seru.
Dialogue: 0,0:15:13.84,0:15:16.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belagu banget.
Dialogue: 0,0:15:16.41,0:15:18.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kouhei, minta cerita seru.
Dialogue: 0,0:15:18.94,0:15:20.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:15:20.40,0:15:22.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bahas hal tidak penting.
Dialogue: 0,0:15:22.44,0:15:25.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus cerita apa yang seru?
Dialogue: 0,0:15:25.01,0:15:26.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa, ya...
Dialogue: 0,0:15:26.70,0:15:28.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba cerita waktu kamu putus.
Dialogue: 0,0:15:28.80,0:15:31.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sungguh gadis busuk.
Dialogue: 0,0:15:31.70,0:15:35.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Libur musim panas pun\Nkalian tidak ke mana-mana, kan?
Dialogue: 0,0:15:36.40,0:15:38.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu salah.
Dialogue: 0,0:15:38.21,0:15:41.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka ke rumah Iori dan ke Palau.
Dialogue: 0,0:15:42.21,0:15:46.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kalian sudah berkomitmen\Ndan bulan madu?
Dialogue: 0,0:15:46.19,0:15:48.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukan.
Dialogue: 0,0:15:50.99,0:15:51.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:15:51.67,0:15:52.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:15:53.12,0:15:54.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malang sekali.
Dialogue: 0,0:15:54.47,0:15:56.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak memaksanya!
Dialogue: 0,0:15:57.12,0:15:58.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kitahara.
Dialogue: 0,0:15:58.73,0:16:00.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:16:01.73,0:16:04.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka mati kutu.
Dialogue: 0,0:16:05.74,0:16:07.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berusahalah sendiri.
Dialogue: 0,0:16:07.57,0:16:08.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bokep 30 kaset.
Dialogue: 0,0:16:08.84,0:16:12.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, karena sudah\Nbincang-bincang sedikit,
Dialogue: 0,0:16:12.49,0:16:14.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagaimana kalau kita bermain?
Dialogue: 0,0:16:14.75,0:16:16.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menarik.
Dialogue: 0,0:16:16.15,0:16:17.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Main apa?
Dialogue: 0,0:16:17.75,0:16:19.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Main alat ini!
Dialogue: 0,0:16:19.75,0:16:21.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pendeteksi kebohongan, ya.
Dialogue: 0,0:16:21.68,0:16:23.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara kerjanya bagaimana?
Dialogue: 0,0:16:23.25,0:16:25.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini mengukur denyut jantungmu.
Dialogue: 0,0:16:25.76,0:16:27.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau jarumnya sampai sini,
Dialogue: 0,0:16:27.64,0:16:30.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}artinya kamu berbohong\Ndan akan disetrum.
Dialogue: 0,0:16:30.16,0:16:31.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit, ya?
Dialogue: 0,0:16:31.28,0:16:33.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma kayak kesemutan.
Dialogue: 0,0:16:33.26,0:16:36.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan inilah pertanyaannya!
Dialogue: 0,0:16:36.25,0:16:38.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa di sini ada yang sesuai tipemu?
Dialogue: 0,0:16:38.14,0:16:39.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, Kitahara!
Dialogue: 0,0:16:39.39,0:16:40.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertanyaan jitu!
Dialogue: 0,0:16:40.95,0:16:43.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memang sahabatku!
Dialogue: 0,0:16:43.27,0:16:46.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tipeku, ya.
Dialogue: 0,0:16:47.28,0:16:48.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada.
Dialogue: 0,0:16:51.03,0:16:53.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada, toh.
Dialogue: 0,0:16:53.03,0:16:55.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, wah.
Dialogue: 0,0:16:55.04,0:16:57.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa, ya?
Dialogue: 0,0:16:59.54,0:17:01.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, Nanaka!
Dialogue: 0,0:17:01.60,0:17:05.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng, orang yang masuk tipeku.
Dialogue: 0,0:17:05.43,0:17:06.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada.
Dialogue: 0,0:17:08.05,0:17:09.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:17:09.25,0:17:11.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada tipe cowoknya di sini?
Dialogue: 0,0:17:11.71,0:17:15.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kitahara sudah pacaran,\NImamura beda dimensi!
Dialogue: 0,0:17:15.27,0:17:17.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti sisa kami bertiga!
Dialogue: 0,0:17:17.72,0:17:21.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan aku yang paling keren!
Dialogue: 0,0:17:23.81,0:17:25.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun.
Dialogue: 0,0:17:25.28,0:17:26.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hari yang indah.
Dialogue: 0,0:17:26.92,0:17:28.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus dirayakan.
Dialogue: 0,0:17:29.32,0:17:31.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tipeku di sini?
Dialogue: 0,0:17:31.79,0:17:33.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas tidak ada.
Dialogue: 0,0:17:35.68,0:17:36.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh!
Dialogue: 0,0:17:38.43,0:17:40.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang bohong, tuh.
Dialogue: 0,0:17:40.36,0:17:42.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya ada, ya?
Dialogue: 0,0:17:42.77,0:17:45.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Mainan ini rusak!
Dialogue: 0,0:17:45.80,0:17:50.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian waktu festival juga\Nkamu mendekati Imamura.
Dialogue: 0,0:17:50.00,0:17:51.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia dihitung tipemu, kan?
Dialogue: 0,0:17:51.95,0:17:54.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm? Kalian membahas apa?
Dialogue: 0,0:17:55.04,0:17:58.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti alat ini akurat!
Dialogue: 0,0:17:58.35,0:18:01.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng, ada.
Dialogue: 0,0:18:01.24,0:18:03.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya saja dia mengajakmu bicara.
Dialogue: 0,0:18:03.85,0:18:05.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi nostalgia, ya.
Dialogue: 0,0:18:05.86,0:18:07.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada.
Dialogue: 0,0:18:07.29,0:18:09.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal pacarmu di sini, lo?
Dialogue: 0,0:18:09.36,0:18:11.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini mengasyikkan, ya.
Dialogue: 0,0:18:11.45,0:18:12.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan?
Dialogue: 0,0:18:12.48,0:18:14.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini baru kencan buta!
Dialogue: 0,0:18:14.87,0:18:16.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Kitahara!
Dialogue: 0,0:18:16.40,0:18:18.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kencannya jadi meriah!
Dialogue: 0,0:18:18.51,0:18:20.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memang kawanku!
Dialogue: 0,0:18:20.93,0:18:22.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baguslah.
Dialogue: 0,0:18:23.40,0:18:26.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah bergaul cukup lama,
Dialogue: 0,0:18:27.52,0:18:31.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}baru pertama aku melihat\Nmereka sebahagia ini.
Dialogue: 0,0:18:36.83,0:18:39.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekspresi yang sangat buruk rupa.
Dialogue: 0,0:18:40.40,0:18:43.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kouhei, saatnya mengurus mereka.
Dialogue: 0,0:18:43.15,0:18:44.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok dadakan?
Dialogue: 0,0:18:44.90,0:18:46.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kencan buta ini memang
Dialogue: 0,0:18:46.56,0:18:49.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kujanjikan pada mereka.
Dialogue: 0,0:18:49.09,0:18:50.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:18:51.40,0:18:54.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bukan berarti mereka\Nboleh pulang hidup-hidup.
Dialogue: 0,0:18:54.03,0:18:56.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, masuk akal.
Dialogue: 0,0:18:56.31,0:18:57.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak sama sekali.
Dialogue: 0,0:18:58.79,0:19:04.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya tidak ada tipeku\Ndi sini, tapi bohong!
Dialogue: 0,0:19:04.66,0:19:07.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, rasanya agak...
Dialogue: 0,0:19:08.17,0:19:10.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mematikan!
Dialogue: 0,0:19:14.17,0:19:15.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:19:15.16,0:19:16.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nojima?
Dialogue: 0,0:19:16.33,0:19:18.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, omong-omong.
Dialogue: 0,0:19:18.43,0:19:20.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar meriah,
Dialogue: 0,0:19:20.01,0:19:21.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau kalian bohong,
Dialogue: 0,0:19:21.52,0:19:23.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tegangannya naik 200 kali lipat.
Dialogue: 0,0:19:23.49,0:19:25.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Woi!
Dialogue: 0,0:19:26.01,0:19:26.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo.
Dialogue: 0,0:19:27.40,0:19:28.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Majulah, Fujiwara.
Dialogue: 0,0:19:28.75,0:19:29.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar saja!
Dialogue: 0,0:19:30.84,0:19:34.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tinggal bicara jujur,\Nmumpung meriah, lo.
Dialogue: 0,0:19:35.45,0:19:38.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya tipeku ada di...
Dialogue: 0,0:19:38.64,0:19:40.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Azusa, sumpitmu jatuh.
Dialogue: 0,0:19:40.67,0:19:42.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, mana?
Dialogue: 0,0:19:42.20,0:19:43.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}...sini.
Dialogue: 0,0:19:47.20,0:19:48.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Yamamoto.
Dialogue: 0,0:19:48.77,0:19:50.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ogah!
Dialogue: 0,0:19:50.53,0:19:55.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minimal turunkan tegangannya\Nbiar kalaupun bohong,
Dialogue: 0,0:19:55.37,0:19:58.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- keamanannya...\N- Bawel, mati sana.
Dialogue: 0,0:20:01.69,0:20:03.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misi berhasil.
Dialogue: 0,0:20:03.55,0:20:06.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kasar banget, tapi oke.
Dialogue: 0,0:20:07.39,0:20:10.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, terima kasih untuk hari ini!
Dialogue: 0,0:20:10.83,0:20:13.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku yang buang para sampahnya.
Dialogue: 0,0:20:14.27,0:20:16.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, selesai?
Dialogue: 0,0:20:16.24,0:20:17.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih mau minum?
Dialogue: 0,0:20:17.76,0:20:19.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan di toko lain.
Dialogue: 0,0:20:19.76,0:20:22.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, bukan begitu.
Dialogue: 0,0:20:22.37,0:20:23.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini.
Dialogue: 0,0:20:23.79,0:20:26.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum semuanya, kan?
Dialogue: 0,0:20:26.65,0:20:27.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:20:27.33,0:20:31.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku coba juga percuma,\Nsudah pada tahu.
Dialogue: 0,0:20:31.05,0:20:35.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pernah bilang menatapku\Ndan Nanaka dengan pikiran mesum, kan?
Dialogue: 0,0:20:35.53,0:20:37.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kulakukan, deh.
Dialogue: 0,0:20:38.91,0:20:42.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, di sini...
Dialogue: 0,0:20:42.04,0:20:43.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu.
Dialogue: 0,0:20:43.07,0:20:43.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:20:43.85,0:20:46.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak seru kalau jawabannya jelas, kan?
Dialogue: 0,0:20:46.76,0:20:50.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba kecualikan dua orang itu.
Dialogue: 0,0:20:50.85,0:20:55.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?\NTiba-tiba banget?
Dialogue: 0,0:20:55.04,0:20:55.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:20:56.31,0:20:58.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turuti saja, Kitahara.
Dialogue: 0,0:20:58.73,0:21:02.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesekali cobalah sadar diri.
Dialogue: 0,0:21:02.45,0:21:05.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya kamu perlu cermin.
Dialogue: 0,0:21:05.80,0:21:08.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa saja bilang tidak ada...
Dialogue: 0,0:21:08.67,0:21:11.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Jangan sok ganteng, deh.\N- Aduh!
Dialogue: 0,0:21:11.84,0:21:13.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau bilang ada...
Dialogue: 0,0:21:14.31,0:21:16.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata memang Kouhei, ya.
Dialogue: 0,0:21:16.80,0:21:18.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:21:18.85,0:21:20.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya jawabanku!
Dialogue: 0,0:21:20.88,0:21:23.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tipeku di sini...
Dialogue: 0,0:21:25.39,0:21:26.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada beberapa orang!
Dialogue: 0,0:21:26.45,0:21:27.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan satu?
Dialogue: 0,0:21:27.89,0:21:32.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, habisnya kalian punya\Ndaya tarik tersendiri.
Dialogue: 0,0:21:34.29,0:21:36.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:21:36.15,0:21:39.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Susah kalau harus memilih!
Dialogue: 0,0:21:40.28,0:21:42.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, giliran Kouhei.
Dialogue: 0,0:21:42.75,0:21:44.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iori.
Dialogue: 0,0:21:44.57,0:21:45.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:21:46.25,0:21:50.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, ada yang kamu cintai selain Chisa?
Dialogue: 0,0:22:02.24,0:22:05.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berdua ditinggal saja?
Dialogue: 0,0:22:05.01,0:22:06.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan dipikirkan.
Dialogue: 0,0:22:06.49,0:22:10.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Doakan saja biar dia selamat.
Dialogue: 0,0:22:10.65,0:22:12.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian membahas apa?
Dialogue: 0,0:22:12.20,0:22:14.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membahas cinta keluarga.
