Dialogue: 0,0:17:15.31,0:17:16.31,sign,,0000,0000,0000,,KOUHEI
Dialogue: 0,0:17:22.17,0:17:23.56,sign,,0000,0000,0000,,RANGIROA, PULAU IMPIAN PENYELAM SEDUNIA
Dialogue: 0,0:17:23.56,0:17:25.56,sign,,0000,0000,0000,,MENANG
Dialogue: 0,0:17:25.56,0:17:29.07,sign,,0000,0000,0000,,TIKET
Dialogue: 0,0:19:44.66,0:19:46.67,sign,,0000,0000,0000,,LAUT DALAM INDAH\NALKOHOL
Dialogue: 0,0:23:32.64,0:23:38.75,sign,,0000,0000,0000,,BERSAMBUNG
Dialogue: 0,0:01:34.99,0:01:37.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemarin aku tidak sadar karena mabuk,
Dialogue: 0,0:01:37.83,0:01:39.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ternyata ini kawasan hotel cinta.
Dialogue: 0,0:01:59.49,0:02:01.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku di sini?
Dialogue: 0,0:02:01.60,0:02:03.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang kita mau menyelam, kan?
Dialogue: 0,0:02:03.83,0:02:08.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka bakal di Okinawa,\Ncuma berdua pula.
Dialogue: 0,0:02:08.02,0:02:11.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat,\Npara senior ada urusan lain.
Dialogue: 0,0:02:11.51,0:02:14.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar saja kalau dadakan begini.
Dialogue: 0,0:02:15.21,0:02:19.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya, aku juga cuma ikut\Ndemi melihat siaran radio Nona Kaya.
Dialogue: 0,0:02:19.79,0:02:22.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, itu bohong.
Dialogue: 0,0:02:22.04,0:02:23.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:02:24.04,0:02:26.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita berangkat!
Dialogue: 0,0:02:27.31,0:02:28.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau ke mana?
Dialogue: 0,0:02:28.84,0:02:30.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke rental mobil.
Dialogue: 0,0:02:30.36,0:02:33.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau sewa mobil biasa, kan?
Dialogue: 0,0:02:35.05,0:02:37.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mesin tengah!
Dialogue: 0,0:02:37.05,0:02:39.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Transmisi manual enam gigi!
Dialogue: 0,0:02:39.81,0:02:41.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua pintu empat roda penggerak!
Dialogue: 0,0:02:41.69,0:02:44.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mobil bak lagi!
Dialogue: 0,0:02:44.06,0:02:45.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kendaraan ini, sih?
Dialogue: 0,0:02:45.91,0:02:48.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya aku juga muak!
Dialogue: 0,0:02:48.82,0:02:51.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ini cocok buat menyamar jadi warlok.
Dialogue: 0,0:02:51.71,0:02:54.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, benar juga.
Dialogue: 0,0:02:54.07,0:02:57.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kembali ke bandara\Ndan menunggu target kita.
Dialogue: 0,0:02:57.07,0:02:58.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh.
Dialogue: 0,0:03:00.83,0:03:04.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita datang lagi ke Okinawa!
Dialogue: 0,0:03:04.29,0:03:06.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuacanya bagus, ya, Chisa?
Dialogue: 0,0:03:07.33,0:03:09.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Target terlihat.
Dialogue: 0,0:03:09.03,0:03:11.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip, jangan sampai lepas.
Dialogue: 0,0:03:11.13,0:03:12.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aman.
Dialogue: 0,0:03:12.76,0:03:15.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana cara mengganggu mereka?
Dialogue: 0,0:03:15.93,0:03:17.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jebakan sudah kupasang.
Dialogue: 0,0:03:17.83,0:03:19.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Sudah?
Dialogue: 0,0:03:19.10,0:03:22.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin Kitahara akan gagal fokus.
Dialogue: 0,0:03:22.64,0:03:25.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat sekali, nanti kamu aku traktir.
Dialogue: 0,0:03:28.35,0:03:30.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka terlihat senang.
Dialogue: 0,0:03:30.11,0:03:31.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:03:31.61,0:03:34.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal awalnya Chisa terlihat gugup.
Dialogue: 0,0:03:34.57,0:03:36.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:03:36.36,0:03:40.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dia mulai rileks setelah Kitahara\Nmenunjukkan celana.
Dialogue: 0,0:03:42.12,0:03:43.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok bisa?
Dialogue: 0,0:03:43.62,0:03:47.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin tampilan biasa Kitahara\Nmembuatnya tenang.
Dialogue: 0,0:03:47.12,0:03:49.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Begitu, ya.
Dialogue: 0,0:03:49.37,0:03:52.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti di balik wajah senang itu...
Dialogue: 0,0:03:52.53,0:03:54.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beginilah penampakannya.
Dialogue: 0,0:03:55.13,0:03:56.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok Chisa sudi?
Dialogue: 0,0:03:56.90,0:03:59.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buktinya mereka terlihat ceria.
Dialogue: 0,0:04:00.89,0:04:02.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kouhei, mana gangguannya?
Dialogue: 0,0:04:02.81,0:04:04.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya tidak mempan.
Dialogue: 0,0:04:04.51,0:04:05.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok bisa?
Dialogue: 0,0:04:07.14,0:04:11.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya orang biasa akan teralihkan.
Dialogue: 0,0:04:11.15,0:04:13.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak melihat kaca spion, ya?
Dialogue: 0,0:04:13.63,0:04:15.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, mereka menepi.
Dialogue: 0,0:04:17.64,0:04:18.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beli makan siang?
Dialogue: 0,0:04:18.91,0:04:20.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya iya.
Dialogue: 0,0:04:20.49,0:04:23.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita gagal mengganggu mereka, ya?
Dialogue: 0,0:04:23.41,0:04:25.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya iya.
Dialogue: 0,0:04:25.33,0:04:27.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal rencanaku sudah sempurna.
Dialogue: 0,0:04:27.69,0:04:29.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa, sih?
Dialogue: 0,0:04:30.17,0:04:32.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya apa trikmu?
Dialogue: 0,0:04:32.25,0:04:36.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memasang stiker di depan\Ndan samping mobil ini.
Dialogue: 0,0:04:40.68,0:04:44.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas saja orang-orang memandangi kita!
Dialogue: 0,0:04:44.18,0:04:45.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sadomasokis?
Dialogue: 0,0:04:45.21,0:04:45.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau main di luar?
Dialogue: 0,0:04:45.97,0:04:47.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan!
Dialogue: 0,0:04:47.43,0:04:50.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ini efektif, kan?
Dialogue: 0,0:04:50.49,0:04:53.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sih, aku juga jadi gagal fokus.
Dialogue: 0,0:04:53.94,0:04:57.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi karena tidak berhasil,\Nubah rencananya!
Dialogue: 0,0:04:57.91,0:04:59.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat.
Dialogue: 0,0:05:00.33,0:05:02.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, tadi Iori beli apa?
Dialogue: 0,0:05:02.84,0:05:04.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hamburger.
Dialogue: 0,0:05:04.45,0:05:05.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hamburger?
Dialogue: 0,0:05:08.20,0:05:11.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, gawat sekali!
Dialogue: 0,0:05:11.04,0:05:12.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:05:12.12,0:05:15.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti beli kentangnya juga, kan?
Dialogue: 0,0:05:15.21,0:05:17.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, benar juga.
Dialogue: 0,0:05:17.46,0:05:19.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku iri.
Dialogue: 0,0:05:19.08,0:05:20.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat ke depan!
Dialogue: 0,0:05:20.72,0:05:23.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sabar, biar aku ganggu lagi!
Dialogue: 0,0:05:24.97,0:05:26.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Caranya?
Dialogue: 0,0:05:26.44,0:05:29.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka pasti gengsi kalau dilihat orang.
Dialogue: 0,0:05:29.33,0:05:31.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kita tidak boleh kelihatan.
Dialogue: 0,0:05:31.48,0:05:35.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang, aku menemukan\Nbarang bagus di bak kita.
Dialogue: 0,0:05:35.23,0:05:38.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salip mereka kalau sudah siap.
Dialogue: 0,0:05:38.15,0:05:39.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:05:42.24,0:05:46.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kitahara yang kecerdasannya\Ndi bawah gagak pasti kena.
Dialogue: 0,0:05:46.24,0:05:51.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa rencana sesimpel ini\Nrasanya akan berhasil.
Dialogue: 0,0:05:51.75,0:05:54.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia benaran teralihkan pula.
Dialogue: 0,0:05:54.32,0:05:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya juga Kitahara.
Dialogue: 0,0:05:57.00,0:06:01.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, yang tadi itu bikin iri banget.
Dialogue: 0,0:06:01.88,0:06:03.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya itu bagus?
Dialogue: 0,0:06:03.29,0:06:05.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, bagus, lah.
Dialogue: 0,0:06:05.44,0:06:07.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, tunggu sebentar.
Dialogue: 0,0:06:07.48,0:06:08.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:06:08.26,0:06:10.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nih, buka mulutmu.
Dialogue: 0,0:06:10.02,0:06:12.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, tu-tunggu...
Dialogue: 0,0:06:12.00,0:06:15.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kouhei?\NAku tidak bermaksud...
Dialogue: 0,0:06:20.78,0:06:23.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya mereka mau nyebur ke laut.
Dialogue: 0,0:06:23.60,0:06:25.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku siap-siap dulu.
Dialogue: 0,0:06:25.53,0:06:27.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap-siap apa?
Dialogue: 0,0:06:28.78,0:06:30.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan!
Dialogue: 0,0:06:30.79,0:06:33.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini buat penangkal matahari\Ndan penyamaran!
Dialogue: 0,0:06:33.56,0:06:36.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Riasan itu sudah kayak jati dirimu!
Dialogue: 0,0:06:36.54,0:06:39.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal biar terlihat beda.
Dialogue: 0,0:06:39.48,0:06:41.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pinjamkan itu.
Dialogue: 0,0:06:41.19,0:06:43.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Buat apa?
Dialogue: 0,0:06:50.06,0:06:53.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini cukup, kan?\NWignya juga kuwarnai hitam.
Dialogue: 0,0:06:54.06,0:06:56.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata Kouhei punya keahlian!
Dialogue: 0,0:06:56.33,0:06:58.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menangis riasannya luntur!
Dialogue: 0,0:06:58.81,0:07:01.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang giliranmu...
Dialogue: 0,0:07:03.32,0:07:05.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imamura?
Dialogue: 0,0:07:05.09,0:07:06.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Eng...
Dialogue: 0,0:07:07.19,0:07:09.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kamu Ikegoshi, ya?
Dialogue: 0,0:07:10.08,0:07:12.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka bertemu di sini.
Dialogue: 0,0:07:12.33,0:07:14.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oh, halo.
Dialogue: 0,0:07:14.08,0:07:16.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, bagaimana ini?
Dialogue: 0,0:07:16.13,0:07:18.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau tidak mau harus pura-pura!
Dialogue: 0,0:07:20.11,0:07:23.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja, akan kurahasiakan.
Dialogue: 0,0:07:23.21,0:07:24.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merahasiakan?
Dialogue: 0,0:07:24.35,0:07:25.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apanya?
Dialogue: 0,0:07:25.75,0:07:29.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat atas pertunanganmu\Ndengan seiyu.
Dialogue: 0,0:07:30.72,0:07:33.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertunangan dengan seiyu?
Dialogue: 0,0:07:33.01,0:07:35.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, tahan dirimu!
Dialogue: 0,0:07:35.60,0:07:37.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:07:37.23,0:07:38.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:07:38.03,0:07:40.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya kami bulan madu diam-diam.
Dialogue: 0,0:07:40.85,0:07:43.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar bagi pasangan terkenal.
Dialogue: 0,0:07:43.23,0:07:46.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senangnya bisa memahami\Nposisi satu sama lain.
Dialogue: 0,0:07:47.17,0:07:48.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul.
Dialogue: 0,0:07:53.49,0:07:57.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena mustahil orang biasa\Nberpacaran dengan seiyu.
Dialogue: 0,0:07:57.27,0:07:59.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kouhei, kamu...
Dialogue: 0,0:07:59.72,0:08:01.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikegoshi, kamu berdarah!
Dialogue: 0,0:08:01.21,0:08:03.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh, aku terluka.
Dialogue: 0,0:08:03.16,0:08:06.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kubawakan P3K!
Dialogue: 0,0:08:06.01,0:08:09.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku malah\Nmerendahkan diri sendiri...
Dialogue: 0,0:08:09.71,0:08:12.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup, kamu sudah berjuang!
Dialogue: 0,0:08:14.77,0:08:18.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya Kitahara cuma bersenang-senang.
Dialogue: 0,0:08:18.65,0:08:20.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sih.
Dialogue: 0,0:08:21.05,0:08:22.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:08:22.02,0:08:23.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baju renangnya Chisa!
Dialogue: 0,0:08:23.79,0:08:25.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang salah?
Dialogue: 0,0:08:26.65,0:08:27.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu barang baru!
Dialogue: 0,0:08:27.78,0:08:30.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan membesar-besarkan hal kecil, lah.
Dialogue: 0,0:08:30.63,0:08:31.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:08:32.12,0:08:34.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahun ini aku beli dua setel baju renang.
Dialogue: 0,0:08:34.55,0:08:36.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku beli tiga.
Dialogue: 0,0:08:36.15,0:08:40.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena suka lautan,\Nkamu beli banyak tiap tahun?
Dialogue: 0,0:08:40.00,0:08:44.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, tapi mungkin tahun ini\Ncukup tiga saja.
Dialogue: 0,0:08:44.67,0:08:46.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:08:46.30,0:08:48.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata dia malah beli lagi.
Dialogue: 0,0:08:49.30,0:08:50.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan Iori juga!
Dialogue: 0,0:08:50.92,0:08:53.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baju renangnya baru juga?
Dialogue: 0,0:08:53.05,0:08:56.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya dia pakai celana!
Dialogue: 0,0:08:56.31,0:08:56.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:08:56.92,0:09:00.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf, dia agak sinting.
Dialogue: 0,0:09:01.67,0:09:03.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak berenang?
Dialogue: 0,0:09:03.88,0:09:05.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku?
Dialogue: 0,0:09:05.29,0:09:07.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak mau, aku sendirian saja.
Dialogue: 0,0:09:07.82,0:09:09.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seorang Kouhei berenang sendirian?
Dialogue: 0,0:09:09.95,0:09:12.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mumpung di pantai Okinawa.
Dialogue: 0,0:09:12.82,0:09:16.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa pun pasti ingin berenang\Nkalau melihat laut ini.
Dialogue: 0,0:09:18.59,0:09:21.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ucapan itu jauh sama sifatmu.
Dialogue: 0,0:09:21.33,0:09:23.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawel.
Dialogue: 0,0:09:23.21,0:09:25.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau kamu pengin lihat baju renangku?
Dialogue: 0,0:09:25.53,0:09:26.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas tidak.
Dialogue: 0,0:09:26.84,0:09:31.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu adalah pengguna baju renang langka\Nyang mustahil membuatku berdebar.
Dialogue: 0,0:09:31.97,0:09:34.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gila, kurang ajar banget!
Dialogue: 0,0:09:35.00,0:09:37.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi malas memberimu hadiah.
Dialogue: 0,0:09:37.45,0:09:38.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hadiah apa?
Dialogue: 0,0:09:38.32,0:09:41.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena merasa bersalah melibatkanmu,
Dialogue: 0,0:09:41.10,0:09:43.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku minta Kanako membuatkan
Dialogue: 0,0:09:43.21,0:09:45.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jam beker dengan suara Kaya.
Dialogue: 0,0:09:46.93,0:09:48.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, Kouhei?
Dialogue: 0,0:09:48.36,0:09:50.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terharu.
Dialogue: 0,0:09:50.33,0:09:51.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya.
Dialogue: 0,0:09:51.36,0:09:54.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hadiahnya luar biasa.
Dialogue: 0,0:09:54.00,0:09:55.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu senang?
Dialogue: 0,0:09:55.12,0:09:57.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu cinta padaku, ya?
Dialogue: 0,0:09:57.60,0:09:59.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menilaiku pakai standarmu.
Dialogue: 0,0:10:00.47,0:10:03.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo berenang agak jauh\Nbiar tidak ketahuan.
Dialogue: 0,0:10:03.64,0:10:04.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo.
Dialogue: 0,0:10:15.89,0:10:18.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bir wajib di Okinawa!
Dialogue: 0,0:10:18.51,0:10:20.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka minum kayak biasa.
Dialogue: 0,0:10:20.64,0:10:23.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa tidak akan terjadi lebih.
Dialogue: 0,0:10:24.45,0:10:26.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kita juga...
Dialogue: 0,0:10:26.09,0:10:27.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersulang!
Dialogue: 0,0:10:30.40,0:10:31.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat ini bagus.
Dialogue: 0,0:10:31.77,0:10:32.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:10:32.97,0:10:35.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan katanya suka ada artis berkunjung.
Dialogue: 0,0:10:35.66,0:10:36.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:10:37.51,0:10:38.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul juga.
Dialogue: 0,0:10:38.66,0:10:41.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo minum sepuasnya!
Dialogue: 0,0:10:41.39,0:10:42.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditraktir?
Dialogue: 0,0:10:42.21,0:10:43.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Patungan, dong!
Dialogue: 0,0:10:43.66,0:10:45.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul juga?
Dialogue: 0,0:10:45.51,0:10:46.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lupakan saja.
Dialogue: 0,0:10:53.30,0:10:54.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Menor.
Dialogue: 0,0:10:54.81,0:10:57.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?\NYang ini juga enak!
Dialogue: 0,0:10:57.30,0:11:00.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kamu sudah mengakui\Nmencintai Kitahara?
Dialogue: 0,0:11:03.84,0:11:06.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang dan bicaralah yang benar.
Dialogue: 0,0:11:06.06,0:11:09.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lupa merahasiakannya dari Kouhei!
Dialogue: 0,0:11:09.24,0:11:10.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng, itu!
Dialogue: 0,0:11:10.85,0:11:14.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah sejelas ini masih mau menyangkal?
Dialogue: 0,0:11:15.57,0:11:20.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kenapa ke seonggok Iori?\NAku gagal paham.
Dialogue: 0,0:11:20.08,0:11:23.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terserah, lah!\NSelera orang beda-beda.
Dialogue: 0,0:11:23.81,0:11:25.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sih.
Dialogue: 0,0:11:25.71,0:11:29.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak bisa memilih\Nmau jatuh cinta ke siapa.
Dialogue: 0,0:11:30.84,0:11:33.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, berjuanglah.
Dialogue: 0,0:11:33.36,0:11:34.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:11:37.34,0:11:38.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan ini?
Dialogue: 0,0:11:38.81,0:11:40.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana kutahu.
Dialogue: 0,0:11:40.80,0:11:42.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang...
Dialogue: 0,0:11:42.07,0:11:44.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah, tentu saja tidak.
Dialogue: 0,0:11:44.35,0:11:46.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa bisa begini?
Dialogue: 0,0:11:46.39,0:11:50.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma memesan kamar di tempat\Nyang sama dengan Iori dan Chisa.
Dialogue: 0,0:11:50.86,0:11:52.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya cuma ada double room.
Dialogue: 0,0:11:52.92,0:11:54.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal banget.
Dialogue: 0,0:11:54.72,0:11:56.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti kamar mereka juga...
Dialogue: 0,0:11:57.36,0:11:59.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tidak punya yang seperti itu.
Dialogue: 0,0:11:59.49,0:12:01.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajahnya tidak asing!
Dialogue: 0,0:12:01.25,0:12:02.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga!
Dialogue: 0,0:12:02.12,0:12:04.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira apa reaksi mereka?
Dialogue: 0,0:12:04.52,0:12:06.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin akan pesan kamar lagi.
Dialogue: 0,0:12:06.62,0:12:09.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu aku bisa tenang.
Dialogue: 0,0:12:09.63,0:12:11.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua kamar penuh, jadi tidak bisa.
Dialogue: 0,0:12:11.88,0:12:13.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh!
Dialogue: 0,0:12:14.15,0:12:15.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, ini gawat.
Dialogue: 0,0:12:15.79,0:12:18.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin mereka akan menyerah\Ndan tidur bareng saja.
Dialogue: 0,0:12:18.63,0:12:21.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, takutnya terjadi sesuatu...
Dialogue: 0,0:12:21.26,0:12:23.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pikiranmu kejauhan.
Dialogue: 0,0:12:23.61,0:12:24.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:12:24.89,0:12:27.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka itu tinggal serumah, lo.
Dialogue: 0,0:12:27.05,0:12:28.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sih.
Dialogue: 0,0:12:28.89,0:12:31.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bukan jaminan akan aman.
Dialogue: 0,0:12:31.88,0:12:35.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun, coba saja periksa sana.
Dialogue: 0,0:12:35.21,0:12:36.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti, lah.
Dialogue: 0,0:12:36.65,0:12:39.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali kamu harus tidur di luar.
Dialogue: 0,0:12:39.66,0:12:42.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Sejak kapan jadi begitu?
Dialogue: 0,0:12:42.39,0:12:44.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kalau mau di bak mandi juga boleh.\N- Seperti biasa, ya.
Dialogue: 0,0:12:44.88,0:12:46.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuh, kan?
Dialogue: 0,0:12:46.16,0:12:48.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urus kamar kita saja...
Dialogue: 0,0:12:48.85,0:12:51.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian kita pernah tidur bertindihan.
Dialogue: 0,0:12:51.25,0:12:52.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buset!
Dialogue: 0,0:12:53.25,0:12:54.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kita salah dengar?
Dialogue: 0,0:12:54.77,0:12:56.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu cuma kecelakaan.
Dialogue: 0,0:12:57.43,0:12:59.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakitnya cukup tahan lama.
Dialogue: 0,0:13:00.72,0:13:02.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menor!
Dialogue: 0,0:13:02.55,0:13:05.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat tinggal, masa mudaku.
Dialogue: 0,0:13:05.21,0:13:08.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenanglah, paling cuma salah paham!
Dialogue: 0,0:13:09.37,0:13:12.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi salah paham itu\Nakan jadi nyata malam ini.
Dialogue: 0,0:13:12.83,0:13:15.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sabar, biar aku urus!
Dialogue: 0,0:13:15.19,0:13:16.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kouhei...
Dialogue: 0,0:13:19.19,0:13:22.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada kamar kosong,\Nmereka akan tidur terpisah.
Dialogue: 0,0:13:22.85,0:13:24.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cerdik sekali!
Dialogue: 0,0:13:24.45,0:13:27.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masalahnya kita tidur di mana?
Dialogue: 0,0:13:27.59,0:13:28.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:13:28.81,0:13:29.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cari, ah.
Dialogue: 0,0:13:29.96,0:13:32.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menginap di mana, ya...
Dialogue: 0,0:13:34.46,0:13:35.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketemu.
Dialogue: 0,0:13:35.77,0:13:37.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketemu, sih.
Dialogue: 0,0:13:37.96,0:13:41.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan di sini!\NAyo cari hotel lain!
Dialogue: 0,0:13:44.21,0:13:45.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Kouhei?
Dialogue: 0,0:13:46.45,0:13:48.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kouhei!
Dialogue: 0,0:13:49.43,0:13:51.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kenapa?
Dialogue: 0,0:13:52.21,0:13:52.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:13:54.59,0:13:59.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tahu begini, mending aku\Nhidup jadi bunga atau rerumputan.
Dialogue: 0,0:13:59.11,0:14:00.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bicara apa, sih?
Dialogue: 0,0:14:00.53,0:14:02.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kamu lihat?
Dialogue: 0,0:14:05.92,0:14:09.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuhan telah menyuruhku mati.
Dialogue: 0,0:14:09.24,0:14:11.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunuh aku...\NBunuh aku...
Dialogue: 0,0:14:11.95,0:14:15.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu kamu sedih,\Ntapi ayo cari penginapan.
Dialogue: 0,0:14:15.75,0:14:17.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa cuma karena itu...
Dialogue: 0,0:14:17.68,0:14:21.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak bisa memilih\Nmau jatuh cinta ke siapa.
Dialogue: 0,0:14:22.17,0:14:24.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus pesan penginapan.
Dialogue: 0,0:14:25.51,0:14:28.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bunuh aku...
Dialogue: 0,0:14:28.51,0:14:30.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunuh...
Dialogue: 0,0:14:32.84,0:14:35.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada pilihan lain!
Dialogue: 0,0:14:39.39,0:14:41.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami menginap...
Dialogue: 0,0:14:41.96,0:14:45.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tidak punya pilihan,\Nkenapa sama Kouhei...
Dialogue: 0,0:14:49.54,0:14:52.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapalnya akan berangkat!
Dialogue: 0,0:14:52.54,0:14:54.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berdirilah yang benar!
Dialogue: 0,0:14:55.56,0:14:57.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita masih sempat...
Dialogue: 0,0:15:07.45,0:15:09.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kalian...
Dialogue: 0,0:15:09.43,0:15:11.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng, anu...
Dialogue: 0,0:15:11.93,0:15:15.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku seiyu bernama Muranaka Yurika.
Dialogue: 0,0:15:15.77,0:15:16.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Seiyu?
Dialogue: 0,0:15:16.85,0:15:18.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul!
Dialogue: 0,0:15:18.19,0:15:22.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan ini tunanganku, Ikegoshi Yuuichi.
Dialogue: 0,0:15:22.69,0:15:28.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo Ikego...\NYuuichi, ayo sapa kenalanmu.
Dialogue: 0,0:15:30.20,0:15:32.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kelihatan lesu.
Dialogue: 0,0:15:32.35,0:15:33.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, tidak...
Dialogue: 0,0:15:33.37,0:15:35.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Yuuichi!
Dialogue: 0,0:15:36.46,0:15:40.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Persetan soal Ikegoshi...
Dialogue: 0,0:15:40.46,0:15:42.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Woi!
Dialogue: 0,0:15:42.16,0:15:45.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, semalam dia syok\Nkarena suatu hal!
Dialogue: 0,0:15:45.43,0:15:46.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm.
Dialogue: 0,0:15:46.22,0:15:48.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sedang kehilangan jati diri,
Dialogue: 0,0:15:48.52,0:15:50.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia Ikegoshi Yuuichi sungguhan, kok!
Dialogue: 0,0:15:50.63,0:15:51.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, hm.
Dialogue: 0,0:15:52.20,0:15:55.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kalian Ikegoshi\Ndan seiyu yang bertunangan?
Dialogue: 0,0:15:55.33,0:15:56.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul!
Dialogue: 0,0:15:56.48,0:15:57.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,
Dialogue: 0,0:15:57.73,0:15:59.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bajunya bagus, ya.
Dialogue: 0,0:16:00.73,0:16:04.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian, jelas-jelas kamu si Menor.
Dialogue: 0,0:16:04.74,0:16:08.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya kalian salah orang!
Dialogue: 0,0:16:11.18,0:16:12.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pendapatmu?
Dialogue: 0,0:16:12.48,0:16:13.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada.
Dialogue: 0,0:16:14.64,0:16:16.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teleponku tidak diangkat.
Dialogue: 0,0:16:16.16,0:16:19.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti sudah pasti itu mereka.
Dialogue: 0,0:16:19.25,0:16:22.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, si Menor tidak pandai berbohong.
Dialogue: 0,0:16:23.63,0:16:24.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari Aina?
Dialogue: 0,0:16:24.28,0:16:27.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, dari orang lain.
Dialogue: 0,0:16:27.52,0:16:30.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka mereka pacaran.
Dialogue: 0,0:16:30.26,0:16:33.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya tidak begitu, sih.
Dialogue: 0,0:16:33.26,0:16:35.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin saja kita salah paham.
Dialogue: 0,0:16:35.64,0:16:39.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal buktinya sudah jelas banget.
Dialogue: 0,0:16:39.52,0:16:42.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, mereka Aina dan Imamura.
Dialogue: 0,0:16:43.32,0:16:46.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata-katamu meyakinkan juga.
Dialogue: 0,0:16:46.53,0:16:48.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya kita harus pastikan...
Dialogue: 0,0:16:48.80,0:16:50.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pastikan apa?
Dialogue: 0,0:16:51.11,0:16:55.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahkah Kouhei\Nnaik tangga kedewasaan.
Dialogue: 0,0:16:55.04,0:16:57.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penasaranmu ke situ?
Dialogue: 0,0:17:00.80,0:17:03.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa jengkel begitu?
Dialogue: 0,0:17:03.60,0:17:05.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar, lah!
Dialogue: 0,0:17:05.80,0:17:11.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa aku kalah sama Kouhei\Ndalam lomba penting para pria?
Dialogue: 0,0:17:11.30,0:17:12.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditambah lagi,
Dialogue: 0,0:17:12.30,0:17:15.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia selalu berlagak tidak minat
Dialogue: 0,0:17:15.31,0:17:16.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ke wanita tiga dimensi!
Dialogue: 0,0:17:16.31,0:17:18.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terserah dia, lah.
Dialogue: 0,0:17:18.00,0:17:19.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak saja!
Dialogue: 0,0:17:19.56,0:17:22.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bayangkan kalau di depanmu
Dialogue: 0,0:17:22.17,0:17:23.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakurako menang lotre
Dialogue: 0,0:17:23.56,0:17:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}liburan ke Rangiroa lalu berkata...
Dialogue: 0,0:17:25.56,0:17:29.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lebih suka belanja daripada menyelam.
Dialogue: 0,0:17:29.07,0:17:30.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana menurutmu?
Dialogue: 0,0:17:31.76,0:17:33.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa diampuni.
Dialogue: 0,0:17:33.36,0:17:34.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuh, kan!
Dialogue: 0,0:17:34.32,0:17:36.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, bikin gelisah!
Dialogue: 0,0:17:36.77,0:17:40.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, aku akan menunggu di...
Dialogue: 0,0:17:42.08,0:17:43.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu "gelisah"?
Dialogue: 0,0:17:43.28,0:17:45.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm? Kenapa? Aneh?
Dialogue: 0,0:17:45.31,0:17:46.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:17:46.34,0:17:49.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya seharusnya "emosi"?
Dialogue: 0,0:17:52.48,0:17:55.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari berkumpul di bawah pelampung.
Dialogue: 0,0:17:55.01,0:17:56.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:17:56.35,0:17:58.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus menyelam.
Dialogue: 0,0:17:58.08,0:17:59.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahu!
Dialogue: 0,0:17:59.55,0:18:00.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iori.
Dialogue: 0,0:18:00.45,0:18:01.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:18:01.43,0:18:04.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lupakan dulu hal-hal rumit.
Dialogue: 0,0:18:06.61,0:18:07.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku duluan.
Dialogue: 0,0:18:15.62,0:18:19.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lupakan dulu hal-hal rumit, ya.
Dialogue: 0,0:18:20.16,0:18:24.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya juga, mumpung aku\Nkembali ke Okinawa.
Dialogue: 0,0:18:24.79,0:18:29.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu aku cuma bisa melihat dari atas.
Dialogue: 0,0:18:29.99,0:18:31.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini...
Dialogue: 0,0:19:11.63,0:19:12.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chisa!
Dialogue: 0,0:19:13.05,0:19:13.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:19:13.99,0:19:15.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau lihat juga!
Dialogue: 0,0:19:16.01,0:19:17.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu foto hari ini, kan?
Dialogue: 0,0:19:17.43,0:19:18.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya.
Dialogue: 0,0:19:18.64,0:19:22.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melihat penyu dari dekat memang mantap!
Dialogue: 0,0:19:22.19,0:19:23.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suasana hatimu membaik?
Dialogue: 0,0:19:24.59,0:19:26.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya.
Dialogue: 0,0:19:26.75,0:19:29.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat berada di dalam laut,
Dialogue: 0,0:19:29.19,0:19:33.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}senang sekali bisa melihat pemandangan\Nyang dulu gagal aku lihat.
Dialogue: 0,0:19:33.83,0:19:36.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gelisahnya jadi hilang, deh.
Dialogue: 0,0:19:38.81,0:19:41.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi sudah tidak penasaran soal mereka?
Dialogue: 0,0:19:41.71,0:19:44.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sih beda cerita.
Dialogue: 0,0:19:46.67,0:19:51.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kalian iri karena kami ke Okinawa?
Dialogue: 0,0:19:51.37,0:19:56.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu kalian pergi dadakan\Ntapi tidak punya tempat singgah?
Dialogue: 0,0:19:56.15,0:19:58.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya kami terpaksa menginap di sana!
Dialogue: 0,0:19:59.29,0:20:01.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu dia muram begini...
Dialogue: 0,0:20:01.76,0:20:04.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena pernikahannya Maya.
Dialogue: 0,0:20:04.53,0:20:05.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan karena aku.
Dialogue: 0,0:20:05.93,0:20:07.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:20:07.29,0:20:08.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masuk akal.
Dialogue: 0,0:20:08.60,0:20:11.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah mengiranya, sih.
Dialogue: 0,0:20:11.19,0:20:13.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah tidak salah paham, kan?
Dialogue: 0,0:20:13.37,0:20:15.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kalian sesuai ekspektasi.
Dialogue: 0,0:20:15.81,0:20:17.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:20:17.67,0:20:21.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggap saja kalian sudah tepercaya.
Dialogue: 0,0:20:21.20,0:20:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti masalahnya tinggal satu...
Dialogue: 0,0:20:25.20,0:20:28.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya Kaya semangat hidup Kouhei.
Dialogue: 0,0:20:28.04,0:20:30.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin besok dia tidak bisa menyelam.
Dialogue: 0,0:20:30.71,0:20:32.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kouhei, minumlah bir ini.
Dialogue: 0,0:20:32.87,0:20:34.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa?
Dialogue: 0,0:20:34.01,0:20:36.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau minuman ringan saja?
Dialogue: 0,0:20:36.21,0:20:39.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, minumlah buat melupakannya
Dialogue: 0,0:20:39.72,0:20:42.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}meski kamu tidak nafsu.
Dialogue: 0,0:20:44.07,0:20:45.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kouhei?
Dialogue: 0,0:20:47.00,0:20:51.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saking sedihnya,\Nhatiku seakan hancur lebur.
Dialogue: 0,0:20:51.61,0:20:56.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai penggemar sejati,\Naku doakan semoga dia bahagia!
Dialogue: 0,0:20:56.49,0:20:58.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus sekali, Kouhei!
Dialogue: 0,0:20:58.24,0:21:00.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu penggemar terbaik!
Dialogue: 0,0:21:00.21,0:21:01.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengesankan!
Dialogue: 0,0:21:01.77,0:21:04.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, terima kasih semuanya!
Dialogue: 0,0:21:04.49,0:21:06.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, ayo bersulang lagi.
Dialogue: 0,0:21:06.68,0:21:07.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:21:07.48,0:21:08.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo.
Dialogue: 0,0:21:08.88,0:21:11.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk malam kedua di Okinawa!
Dialogue: 0,0:21:11.00,0:21:14.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk menyelam bersama-sama lagi!
Dialogue: 0,0:21:14.00,0:21:17.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk kenangan indah lainnya!
Dialogue: 0,0:21:17.26,0:21:21.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk kebahagiaan Nona Kaya!
Dialogue: 0,0:21:21.26,0:21:24.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersulang!
Dialogue: 0,0:22:58.50,0:22:59.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kitahara!
Dialogue: 0,0:22:59.37,0:22:59.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:23:04.77,0:23:06.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya ketemu.
Dialogue: 0,0:23:06.36,0:23:07.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakurako?
Dialogue: 0,0:23:09.59,0:23:12.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok kamu ada di sini?
Dialogue: 0,0:23:29.31,0:23:31.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih hidangannya.
