Dialogue: 0,0:15:09.43,0:15:10.41,sign,,0000,0000,0000,,HOTEL CINTA SAMPAI KERING
Dialogue: 0,0:15:10.41,0:15:11.21,sign,,0000,0000,0000,,SENIN-JUMAT, 90 MENIT 2500 YEN
Dialogue: 0,0:15:11.21,0:15:11.93,sign,,0000,0000,0000,,SABTU-MINGGU, 90 MENIT 2999 YEN
Dialogue: 0,0:16:46.53,0:16:50.03,sign,,0000,0000,0000,,KERIPIK KENTANG
Dialogue: 0,0:17:12.30,0:17:13.55,sign,,0000,0000,0000,,DUNIA NYATA?
