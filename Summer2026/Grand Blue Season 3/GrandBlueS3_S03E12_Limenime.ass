Dialogue: 0,0:11:50.86,0:11:52.92,sign,,0000,0000,0000,,AKU BISA MENIKAH BERKATMU
Dialogue: 0,0:11:52.92,0:11:53.75,sign,,0000,0000,0000,,MESKI TERTULIS ADA DOUBLE DAN TWIN,
Dialogue: 0,0:11:53.75,0:11:54.36,sign,,0000,0000,0000,,DI SINI CUMA BISA PESAN DOUBLE ROOM, HATI-HATI
Dialogue: 0,0:13:32.71,0:13:34.46,sign,,0000,0000,0000,,DISTRIK HOTEL CINTA\NSARANG CINTA
Dialogue: 0,0:14:02.74,0:14:05.24,sign,,0000,0000,0000,,MIZUKI KAYA AKAN MENIKAH!
Dialogue: 0,0:14:24.01,0:14:25.51,sign,,0000,0000,0000,,HOTEL CINTA SAMPAI KERING
Dialogue: 0,0:14:27.01,0:14:28.51,sign,,0000,0000,0000,,HOTEL CINTA SAMPAI KERING
