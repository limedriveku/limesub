Dialogue: 0,0:00:00.00,0:00:00.27,sign,,0000,0000,0000,,ACARA INI ADALAH KARYA FIKSI.
Dialogue: 0,0:00:00.27,0:00:00.58,sign,,0000,0000,0000,,ANAK DI BAWAH UMUR DILARANG KERAS\NMINUM ALKOHOL OLEH HUKUM.
Dialogue: 0,0:00:00.58,0:00:01.09,sign,,0000,0000,0000,,KAMI JUGA TIDAK BERMAKSUD MENGANJURKAN\NPEMAKSAAN MINUM ALKOHOL,
Dialogue: 0,0:00:01.09,0:00:01.79,sign,,0000,0000,0000,,KONSUMSI ALKOHOL BERLEBIHAN, MAUPUN TINDAKAN\NTIDAK SENONOH SAAT PESTA MINUM.
Dialogue: 0,0:00:01.79,0:00:02.40,sign,,0000,0000,0000,,MOHON ANGGAP INI SEMATA-MATA\NSEBAGAI ANIME KOMEDI.
Dialogue: 0,0:00:02.40,0:00:03.10,sign,,0000,0000,0000,,SELURUH KARAKTER YANG MENGONSUMSI\NALKOHOL DALAM KARYA INI
Dialogue: 0,0:00:03.10,0:00:03.68,sign,,0000,0000,0000,,TELAH BERUSIA 20 TAHUN ATAU LEBIH.
Dialogue: 0,0:00:03.68,0:00:04.38,sign,,0000,0000,0000,,DEMI MENYESUAIKAN DENGAN STANDAR\NKEPATUHAN TERKINI.
Dialogue: 0,0:00:04.38,0:00:05.00,sign,,0000,0000,0000,,MULAI MUSIM INI\NUKURAN SENSOR HITAM KAMI NAIK 5%.
Dialogue: 0,0:00:17.29,0:00:25.34,sign,,0000,0000,0000,,GRAND BLUE MUSIM 3
Dialogue: 0,0:01:34.99,0:01:35.89,sign,,0000,0000,0000,,PUSAT PENYELAMAN PALAU PASIFIK
Dialogue: 0,0:08:54.43,0:08:56.43,sign,,0000,0000,0000,,COBA MENUNDUK SEDIKIT
Dialogue: 0,0:09:01.94,0:09:03.94,sign,,0000,0000,0000,,ITU BELUT TAMAN BERTUTUL\NDAN BELUT BERPITA ORANYE
Dialogue: 0,0:09:05.94,0:09:07.94,sign,,0000,0000,0000,,IMUT, KAN?
Dialogue: 0,0:14:38.02,0:14:42.28,sign,,0000,0000,0000,,PENYUMBAT TELINGA
Dialogue: 0,0:14:49.79,0:14:52.80,sign,,0000,0000,0000,,PENYUMBAT TELINGA
Dialogue: 0,0:14:52.80,0:14:54.85,sign,,0000,0000,0000,,PERLINDUNGAN TELINGA TERBAIK SEJAK 1986
Dialogue: 0,0:14:54.85,0:14:55.79,sign,,0000,0000,0000,,TAHAN AIR, SUARA TETAP MASUK
Dialogue: 0,0:15:14.43,0:15:16.94,sign,,0000,0000,0000,,EROTISME TROPIS
Dialogue: 0,0:15:32.58,0:15:34.70,sign,,0000,0000,0000,,KUE BUAH PALAU, PEPAYA, MANGGA, PISANG
Dialogue: 0,0:16:06.11,0:16:11.12,sign,,0000,0000,0000,,GAJI
Dialogue: 0,0:17:27.19,0:17:28.44,sign,,0000,0000,0000,,NY. YOSHIWARA AINA - PALAU > NARITA -\NWAKTU PENERBANGAN 14.30 - UBAH KURSI - CEK IN
Dialogue: 0,0:17:32.45,0:17:34.45,sign,,0000,0000,0000,,BANDARA INTERNASIONAL PALAU
Dialogue: 0,0:18:02.85,0:18:07.61,sign,,0000,0000,0000,,EROTISME TROPIS
Dialogue: 0,0:18:43.84,0:18:46.65,sign,,0000,0000,0000,,TOKO SELAM GRAND BLUE
Dialogue: 0,0:18:51.65,0:18:53.52,sign,,0000,0000,0000,,JEPANG
Dialogue: 0,0:18:53.52,0:18:56.06,sign,,0000,0000,0000,,GUAM
Dialogue: 0,0:18:56.06,0:18:58.91,sign,,0000,0000,0000,,PALAU
Dialogue: 0,0:19:24.18,0:19:26.69,sign,,0000,0000,0000,,GAJI
Dialogue: 0,0:21:11.42,0:21:13.04,sign,,0000,0000,0000,,GAJI
Dialogue: 0,0:21:15.42,0:21:17.92,sign,,0000,0000,0000,,BERJUANGLAH\NPENYUMBAT TELINGA
Dialogue: 0,0:21:22.93,0:21:24.93,sign,,0000,0000,0000,,BERJUANGLAH
Dialogue: 0,0:23:44.99,0:23:49.99,sign,,0000,0000,0000,,SELANJUTNYA: KENCAN BUTA RONDE 2
Dialogue: 0,0:01:35.89,0:01:38.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok hari terakhir kerja di sini, ya.
Dialogue: 0,0:01:38.49,0:01:40.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak terasa, ya.
Dialogue: 0,0:01:41.50,0:01:43.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sudah kembali.
Dialogue: 0,0:01:43.56,0:01:45.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita hampiri.
Dialogue: 0,0:01:45.88,0:01:48.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa anak itu baik-baik saja?
Dialogue: 0,0:01:50.71,0:01:53.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pijakannya licin,\Nturunlah dengan hati-hati.
Dialogue: 0,0:01:54.39,0:01:55.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hup.
Dialogue: 0,0:01:55.71,0:01:58.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turun dari situ berbahaya.
Dialogue: 0,0:01:58.01,0:02:00.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aman, kok.
Dialogue: 0,0:02:00.43,0:02:02.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma pemula yang akan jatuh.
Dialogue: 0,0:02:02.89,0:02:06.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetap saja bahaya,\Ntolong turun dari sana.
Dialogue: 0,0:02:06.73,0:02:09.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?\NKamu kira aku lansia?
Dialogue: 0,0:02:09.78,0:02:11.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu tidak.
Dialogue: 0,0:02:11.51,0:02:14.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja area itu licin\Ndan membahayakan.
Dialogue: 0,0:02:14.51,0:02:16.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bayi juga tahu!
Dialogue: 0,0:02:16.20,0:02:19.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengalaman menyelamku\Njauh di atas kalian!
Dialogue: 0,0:02:19.73,0:02:23.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perkara turun saja ribet banget.
Dialogue: 0,0:02:23.68,0:02:26.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemula sepertimu jangan sok menggurui!
Dialogue: 0,0:02:27.65,0:02:31.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi veteran bebas mengabaikan keamanan?
Dialogue: 0,0:02:31.23,0:02:32.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:02:32.19,0:02:35.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lengah karena terbiasa itu\Njustru paling bahaya!
Dialogue: 0,0:02:35.43,0:02:36.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa katamu?
Dialogue: 0,0:02:36.75,0:02:37.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang dulu.
Dialogue: 0,0:02:37.93,0:02:40.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf terlalu bersikeras.
Dialogue: 0,0:02:40.41,0:02:40.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:02:41.44,0:02:44.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan pasti seorang veteran?
Dialogue: 0,0:02:44.16,0:02:44.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:02:44.97,0:02:49.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maka dari itu, orang-orang\Ncenderung akan menirumu.
Dialogue: 0,0:02:49.75,0:02:50.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:02:50.69,0:02:54.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takutnya, yang amatir malah celaka.
Dialogue: 0,0:02:54.80,0:02:56.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, betul juga.
Dialogue: 0,0:02:56.93,0:02:57.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudahlah!
Dialogue: 0,0:02:58.27,0:02:59.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:02:59.67,0:03:00.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:03:02.57,0:03:04.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iori, kerja bagus!
Dialogue: 0,0:03:04.04,0:03:05.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu hebat!
Dialogue: 0,0:03:06.63,0:03:08.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu cocok sama kerjaan ini.
Dialogue: 0,0:03:08.63,0:03:10.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku tidak bisa berenang.
Dialogue: 0,0:03:10.55,0:03:13.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kepribadianmu pas banget.
Dialogue: 0,0:03:13.21,0:03:16.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pandai bergaul\Ndan menangani pelanggan.
Dialogue: 0,0:03:17.09,0:03:18.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak bakal lulus kuliah pula.
Dialogue: 0,0:03:18.97,0:03:21.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enam tahun lagi juga lulus, kok!
Dialogue: 0,0:03:25.07,0:03:26.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus, semuanya.
Dialogue: 0,0:03:26.98,0:03:29.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini makan-makan, yuk.
Dialogue: 0,0:03:29.52,0:03:31.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekalian pesta penyambutan.
Dialogue: 0,0:03:31.73,0:03:34.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, besok hari terakhir kami.
Dialogue: 0,0:03:34.80,0:03:37.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti sekalian pesta perpisahan!
Dialogue: 0,0:03:37.83,0:03:39.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul juga, ayo.
Dialogue: 0,0:03:39.99,0:03:42.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian bisa?
Dialogue: 0,0:03:42.21,0:03:44.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja!
Dialogue: 0,0:03:50.15,0:03:52.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantap!
Dialogue: 0,0:03:52.00,0:03:53.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak sekali!
Dialogue: 0,0:03:53.65,0:03:55.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan?
Dialogue: 0,0:03:55.40,0:03:57.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chisa, perutmu sakit?
Dialogue: 0,0:03:57.12,0:03:59.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, tidak, kok.
Dialogue: 0,0:03:59.11,0:04:01.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, baguslah.
Dialogue: 0,0:04:02.14,0:04:05.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kesan kalian bekerja di sini?
Dialogue: 0,0:04:05.39,0:04:10.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, ternyata kerja fisiknya\Ncukup melelahkan.
Dialogue: 0,0:04:10.02,0:04:13.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lebih kesulitan melayani tamu.
Dialogue: 0,0:04:13.00,0:04:15.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayak pernah melayani tamu saja.
Dialogue: 0,0:04:16.81,0:04:20.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya aku juga sempat kesulitan, sih.
Dialogue: 0,0:04:20.47,0:04:22.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata semuanya sama, ya.
Dialogue: 0,0:04:22.91,0:04:25.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, apa yang masih sulit?
Dialogue: 0,0:04:27.33,0:04:30.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus selalu tersenyum masih sulit, sih.
Dialogue: 0,0:04:30.42,0:04:31.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:04:31.37,0:04:32.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka.
Dialogue: 0,0:04:32.42,0:04:33.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa?
Dialogue: 0,0:04:33.12,0:04:35.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya kamu selalu ceria.
Dialogue: 0,0:04:36.45,0:04:38.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berusaha keras untuk itu.
Dialogue: 0,0:04:38.93,0:04:43.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sebagai manusia, ada kalanya\Nterasa berat buat tersenyum.
Dialogue: 0,0:04:43.93,0:04:48.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi para tamu, satu hari di sini\Nadalah momen spesial, kan?
Dialogue: 0,0:04:48.94,0:04:50.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul.
Dialogue: 0,0:04:50.44,0:04:54.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi itu cuma hari biasa bagi kami.
Dialogue: 0,0:04:54.44,0:04:59.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kalanya kami kurang sehat\Natau kurang semangat.
Dialogue: 0,0:04:59.15,0:05:02.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di situlah tersenyum rasanya sulit.
Dialogue: 0,0:05:02.45,0:05:04.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:05:04.20,0:05:07.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chisa juga pasti kesusahan\Ndi pekerjaan ini.
Dialogue: 0,0:05:08.59,0:05:10.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, apakah
Dialogue: 0,0:05:10.96,0:05:13.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pekerjaan ini tidak cocok buatku?
Dialogue: 0,0:05:13.71,0:05:15.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng, itu...
Dialogue: 0,0:05:15.44,0:05:17.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tergantung gaya kerja kita.
Dialogue: 0,0:05:17.71,0:05:19.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak cocok.
Dialogue: 0,0:05:19.72,0:05:21.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bos!
Dialogue: 0,0:05:21.00,0:05:24.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sekadar suka lautan\Ndan menyelam saja.
Dialogue: 0,0:05:24.89,0:05:27.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kikuk dan kurang ramah,
Dialogue: 0,0:05:27.29,0:05:29.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu pasti kesulitan di bidang ini.
Dialogue: 0,0:05:29.71,0:05:33.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mending, kerja formal saja\Ndan anggap ini hobi...
Dialogue: 0,0:05:33.23,0:05:34.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak...
Dialogue: 0,0:05:36.23,0:05:38.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bertanya pada Ibu!
Dialogue: 0,0:05:41.35,0:05:42.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:05:50.81,0:05:53.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kotegawa marah besar, tuh.
Dialogue: 0,0:05:53.84,0:05:54.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:05:54.69,0:05:56.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kitahara, kok dia begitu?
Dialogue: 0,0:05:57.25,0:05:58.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah.
Dialogue: 0,0:05:58.81,0:06:02.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah sifat Bibi,\Nwajar mereka berselisih.
Dialogue: 0,0:06:02.51,0:06:04.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya juga.
Dialogue: 0,0:06:06.11,0:06:09.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya Ibu tidak mau aku jadi instruktur.
Dialogue: 0,0:06:10.27,0:06:11.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Menor?
Dialogue: 0,0:06:11.60,0:06:14.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukan apa-apa.
Dialogue: 0,0:06:14.27,0:06:17.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok aku coba tanya, deh.
Dialogue: 0,0:06:17.69,0:06:18.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dah.
Dialogue: 0,0:06:18.77,0:06:19.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:06:19.73,0:06:21.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat tidur.
Dialogue: 0,0:06:27.28,0:06:28.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini doang?
Dialogue: 0,0:06:28.76,0:06:29.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:06:29.91,0:06:31.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apanya?
Dialogue: 0,0:06:31.37,0:06:34.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita di Palau cuma dua malam lagi.
Dialogue: 0,0:06:35.21,0:06:38.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya ada yang ingin kamu lakukan?
Dialogue: 0,0:06:39.03,0:06:41.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak ada, tuh.
Dialogue: 0,0:06:41.30,0:06:43.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terserah, sih.
Dialogue: 0,0:06:43.80,0:06:48.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tidak akan ada perubahan\Nkalau kita cuma diam.
Dialogue: 0,0:06:48.25,0:06:50.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sok tahu banget.
Dialogue: 0,0:06:50.19,0:06:53.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini pakarnya soal gim asmara.
Dialogue: 0,0:06:54.29,0:06:56.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau tidur saja.
Dialogue: 0,0:06:57.06,0:06:59.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, selamat tidur.
Dialogue: 0,0:07:03.41,0:07:05.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh.
Dialogue: 0,0:07:05.07,0:07:09.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit sekali jadi peran pembantu\Ndi gim asmara.
Dialogue: 0,0:07:16.96,0:07:18.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:07:18.10,0:07:19.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak tertolong.
Dialogue: 0,0:07:19.46,0:07:21.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia akan membaik kalau menyelam?
Dialogue: 0,0:07:21.76,0:07:23.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga saja.
Dialogue: 0,0:07:23.73,0:07:26.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tamu hari ini batal datang.
Dialogue: 0,0:07:26.29,0:07:27.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lah?
Dialogue: 0,0:07:27.34,0:07:29.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka keracunan makanan.
Dialogue: 0,0:07:29.32,0:07:30.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh.
Dialogue: 0,0:07:30.25,0:07:32.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial sekali.
Dialogue: 0,0:07:32.07,0:07:34.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti tidak jadi, ya.
Dialogue: 0,0:07:34.35,0:07:36.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alat-alatnya bawa balik lagi?
Dialogue: 0,0:07:36.46,0:07:38.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal sudah kusiapkan.
Dialogue: 0,0:07:38.23,0:07:40.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mengeluh!
Dialogue: 0,0:07:40.36,0:07:42.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, soal itu...
Dialogue: 0,0:07:48.99,0:07:50.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benaran, nih?
Dialogue: 0,0:07:50.60,0:07:53.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita boleh menyelam dan bolos kerja?
Dialogue: 0,0:07:53.49,0:07:55.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mumpung alatnya sudah siap.
Dialogue: 0,0:07:55.92,0:07:58.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan kalian baru menyelam sekali, kan?
Dialogue: 0,0:07:58.93,0:08:01.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang kalau di Palau\Ncuma menyelam sekali.
Dialogue: 0,0:08:01.43,0:08:03.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih!
Dialogue: 0,0:08:04.00,0:08:05.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita beruntung, Chisa!
Dialogue: 0,0:08:05.73,0:08:09.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiap hari juga aku menyelam.
Dialogue: 0,0:08:09.01,0:08:11.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu hitungannya kerja.
Dialogue: 0,0:08:11.17,0:08:13.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyelam sama teman rasanya beda lagi.
Dialogue: 0,0:08:14.37,0:08:15.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:08:15.12,0:08:16.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu benar, Chisa.
Dialogue: 0,0:08:16.89,0:08:22.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya, kamu mau kenangan kita\Ncuma soal selangkangan meledak?
Dialogue: 0,0:08:22.27,0:08:24.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ogah banget!
Dialogue: 0,0:08:24.65,0:08:28.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, ayo kita buat kenangan indah!
Dialogue: 0,0:08:39.16,0:08:41.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemandangannya selalu indah.
Dialogue: 0,0:09:47.23,0:09:48.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gi...
Dialogue: 0,0:09:48.53,0:09:49.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gila!
Dialogue: 0,0:09:49.96,0:09:51.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi ada manta!
Dialogue: 0,0:09:51.08,0:09:52.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata gede banget!
Dialogue: 0,0:09:52.99,0:09:54.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keren banget, ya!
Dialogue: 0,0:09:54.99,0:09:57.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sering melihatnya saat kerja?
Dialogue: 0,0:09:57.56,0:09:58.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jarang.
Dialogue: 0,0:09:58.87,0:10:00.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan belum pernah sedekat tadi.
Dialogue: 0,0:10:00.72,0:10:02.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:10:02.21,0:10:04.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti kita hoki!
Dialogue: 0,0:10:04.49,0:10:06.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beruntung sekali!
Dialogue: 0,0:10:06.38,0:10:08.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!\NTernyata
Dialogue: 0,0:10:08.38,0:10:10.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menyelam itu menyenangkan!
Dialogue: 0,0:10:10.72,0:10:11.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:10:11.43,0:10:12.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul!
Dialogue: 0,0:10:21.39,0:10:23.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku setuju.
Dialogue: 0,0:10:26.40,0:10:28.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?\NSeru?
Dialogue: 0,0:10:28.38,0:10:29.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:10:29.40,0:10:31.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:10:31.19,0:10:32.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya aku cemas.
Dialogue: 0,0:10:32.84,0:10:34.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal apa?
Dialogue: 0,0:10:34.17,0:10:36.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena serius dan kaku,
Dialogue: 0,0:10:36.66,0:10:40.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu seakan tidak menikmati\Npekerjaan menyelam.
Dialogue: 0,0:10:40.64,0:10:42.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:10:42.53,0:10:46.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau tamu menikmatinya,\Nkita juga harus menikmati.
Dialogue: 0,0:10:46.89,0:10:48.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul juga.
Dialogue: 0,0:10:48.48,0:10:50.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hubungan antarmanusia pun sama.
Dialogue: 0,0:10:50.67,0:10:53.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau orang lain terbuka?
Dialogue: 0,0:10:53.30,0:10:55.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga harus terbuka.
Dialogue: 0,0:10:55.75,0:10:57.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak pintar.
Dialogue: 0,0:11:04.07,0:11:05.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi apa?
Dialogue: 0,0:11:06.31,0:11:07.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan apa-apa.
Dialogue: 0,0:11:07.60,0:11:10.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, mau minta maaf soal kemarin?
Dialogue: 0,0:11:10.20,0:11:12.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergilah sana.
Dialogue: 0,0:11:12.21,0:11:12.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:11:12.83,0:11:16.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang, kalian sangat mirip.
Dialogue: 0,0:11:17.32,0:11:20.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian mudah diperdaya, percayalah!
Dialogue: 0,0:11:20.21,0:11:22.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jaga mulutmu!
Dialogue: 0,0:11:24.52,0:11:25.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kucoba.
Dialogue: 0,0:11:25.48,0:11:27.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, semangat.
Dialogue: 0,0:11:30.07,0:11:32.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, Ibu.
Dialogue: 0,0:11:32.55,0:11:35.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf membentakmu kemarin.
Dialogue: 0,0:11:35.72,0:11:38.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu Ibu khawatir.
Dialogue: 0,0:11:38.72,0:11:42.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku ingin jadi instruktur.
Dialogue: 0,0:11:42.10,0:11:44.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu aku akan giat belajar
Dialogue: 0,0:11:44.56,0:11:46.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan lulus kuliah.
Dialogue: 0,0:11:46.60,0:11:50.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong beri aku kesempatan\Njadi instruktur!
Dialogue: 0,0:11:55.44,0:11:57.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bilang apa, Chisa?
Dialogue: 0,0:11:58.86,0:12:01.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak ada perlu, keluarlah.
Dialogue: 0,0:12:02.87,0:12:04.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sedang sibuk.
Dialogue: 0,0:12:15.04,0:12:17.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu keterlaluan.
Dialogue: 0,0:12:18.86,0:12:21.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, tapi aku sibuk.
Dialogue: 0,0:12:21.04,0:12:22.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sibuk bagaimana?
Dialogue: 0,0:12:22.64,0:12:25.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kalian lama tidak bertemu.
Dialogue: 0,0:12:29.70,0:12:31.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, Dolphin di sini.
Dialogue: 0,0:12:31.76,0:12:36.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku Sugita dari Worldwide Tours,\Nmau membahas soal minggu depan.
Dialogue: 0,0:12:36.29,0:12:38.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng, ke siapa?
Dialogue: 0,0:12:38.53,0:12:41.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, maaf, ke Nyonya Kotegawa.
Dialogue: 0,0:12:41.26,0:12:43.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar.
Dialogue: 0,0:12:43.50,0:12:44.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bibi.
Dialogue: 0,0:12:44.43,0:12:45.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawakan kemari.
Dialogue: 0,0:12:47.73,0:12:48.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan.
Dialogue: 0,0:12:55.07,0:12:57.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada masalah lagi?
Dialogue: 0,0:12:57.30,0:13:00.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?\NAku tidak paham, pelan-pelan.
Dialogue: 0,0:13:00.98,0:13:02.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicaralah perlahan.
Dialogue: 0,0:13:03.30,0:13:06.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iori, Chisa kenapa lagi?
Dialogue: 0,0:13:06.14,0:13:07.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apanya?
Dialogue: 0,0:13:07.76,0:13:09.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat saja itu.
Dialogue: 0,0:13:11.23,0:13:12.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tersenyum.
Dialogue: 0,0:13:12.56,0:13:14.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:13:14.18,0:13:17.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya Chisa begitu\Ncuma saat menyelam.
Dialogue: 0,0:13:17.78,0:13:20.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omonganmu nyelekit, tuh.
Dialogue: 0,0:13:20.57,0:13:23.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya dia luar biasa marah.
Dialogue: 0,0:13:23.14,0:13:24.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin.
Dialogue: 0,0:13:24.26,0:13:26.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa semarah itu?
Dialogue: 0,0:13:26.21,0:13:28.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba saja kamu tes.
Dialogue: 0,0:13:36.98,0:13:38.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan muntah, woi.
Dialogue: 0,0:13:39.06,0:13:43.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasa murkanya menekan ulu hatiku!
Dialogue: 0,0:13:43.79,0:13:45.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi?
Dialogue: 0,0:13:45.10,0:13:47.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, kayaknya...
Dialogue: 0,0:13:47.82,0:13:50.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih lanjutan soal kemarin.
Dialogue: 0,0:13:50.60,0:13:51.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:13:51.82,0:13:55.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Susah komentarnya kalau urusan keluarga.
Dialogue: 0,0:13:55.11,0:13:57.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ini hari terakhir kita, kan?
Dialogue: 0,0:13:57.46,0:14:00.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masalahnya tidak akan sempat redam.
Dialogue: 0,0:14:00.82,0:14:04.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melihat dari sifat mereka,\Naku juga bingung.
Dialogue: 0,0:14:04.64,0:14:06.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kalian.
Dialogue: 0,0:14:07.62,0:14:08.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya?
Dialogue: 0,0:14:08.74,0:14:10.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersih-bersih kios, ya?
Dialogue: 0,0:14:10.54,0:14:13.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, aku mau berterima kasih\Nbuat selama ini.
Dialogue: 0,0:14:14.63,0:14:18.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita mau dikasih satu barang\Nbuat kenang-kenangan.
Dialogue: 0,0:14:20.59,0:14:21.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kenapa?
Dialogue: 0,0:14:21.90,0:14:23.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah.
Dialogue: 0,0:14:24.13,0:14:26.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan yang mahal, ya.
Dialogue: 0,0:14:26.42,0:14:28.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlengkapan menyelam saja, deh.
Dialogue: 0,0:14:28.76,0:14:30.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tas tahan air boleh juga.
Dialogue: 0,0:14:30.91,0:14:33.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar barang-barangku tetap kering.
Dialogue: 0,0:14:33.50,0:14:36.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, aku tidak butuh.
Dialogue: 0,0:14:36.13,0:14:37.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan baju ganti?
Dialogue: 0,0:14:37.41,0:14:38.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh.
Dialogue: 0,0:14:38.02,0:14:40.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada benda ini juga.
Dialogue: 0,0:14:40.29,0:14:42.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyumbat telinga untuk menyelam?
Dialogue: 0,0:14:42.69,0:14:45.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya dilarang pakai itu?
Dialogue: 0,0:14:45.60,0:14:48.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takutnya masuk ke telinga\Noleh tekanan air.
Dialogue: 0,0:14:48.53,0:14:49.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng...
Dialogue: 0,0:14:49.79,0:14:52.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya ini punya beberapa lubang
Dialogue: 0,0:14:52.80,0:14:54.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}biar mudah mengatur tekanan telinga.
Dialogue: 0,0:14:54.85,0:14:55.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:14:56.32,0:14:59.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin Chisa lebih butuh itu.
Dialogue: 0,0:14:59.57,0:15:01.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Telinganya bermasalah\Nwaktu di Okinawa, kan?
Dialogue: 0,0:15:01.71,0:15:03.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya juga.
Dialogue: 0,0:15:03.55,0:15:05.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah selesai memilih?
Dialogue: 0,0:15:05.71,0:15:08.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku maunya tas tahan air.
Dialogue: 0,0:15:08.26,0:15:09.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum tahu.
Dialogue: 0,0:15:09.93,0:15:11.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:15:11.25,0:15:16.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan, tamu yang iseng meninggalkan ini.
Dialogue: 0,0:15:16.94,0:15:20.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bercanda!\NMasa kenangannya begini?
Dialogue: 0,0:15:21.32,0:15:24.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:15:24.06,0:15:24.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai nangis?
Dialogue: 0,0:15:24.99,0:15:27.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beginilah dia.
Dialogue: 0,0:15:29.60,0:15:31.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pilih perlengkapan menyelam?
Dialogue: 0,0:15:31.89,0:15:32.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:15:32.58,0:15:34.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau camilan ini.
Dialogue: 0,0:15:34.70,0:15:37.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?\NTapi kenangan di sini...
Dialogue: 0,0:15:38.58,0:15:41.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang, aku tidak membutuhkannya.
Dialogue: 0,0:15:44.38,0:15:45.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:15:49.55,0:15:51.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih untuk selama ini.
Dialogue: 0,0:15:52.34,0:15:54.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih!
Dialogue: 0,0:15:54.10,0:15:57.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah mau direkrut dadakan.
Dialogue: 0,0:15:57.14,0:16:00.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai besok sudah aman\Nkarena ada anak baru.
Dialogue: 0,0:16:00.11,0:16:02.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami juga senang di sini.
Dialogue: 0,0:16:02.38,0:16:04.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bib...\NBos mana?
Dialogue: 0,0:16:04.26,0:16:06.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya sedang sibuk.
Dialogue: 0,0:16:06.11,0:16:08.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dia menitipkan ini.
Dialogue: 0,0:16:08.32,0:16:09.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, gaji!
Dialogue: 0,0:16:09.68,0:16:11.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat beli anime blu-ray!
Dialogue: 0,0:16:11.12,0:16:13.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah tahu buat apa, ya.
Dialogue: 0,0:16:14.40,0:16:17.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf bayarannya tunai begini.
Dialogue: 0,0:16:17.07,0:16:18.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, kok.
Dialogue: 0,0:16:19.25,0:16:19.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hore!
