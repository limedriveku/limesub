Dialogue: 0,0:16:29.73,0:16:30.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:16:30.70,0:16:32.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya.
Dialogue: 0,0:16:32.51,0:16:35.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, terima kasih.
Dialogue: 0,0:16:35.18,0:16:37.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyenangkan sekali!
Dialogue: 0,0:16:37.02,0:16:39.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:16:41.77,0:16:45.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok tinggal naik pesawat, deh.
Dialogue: 0,0:16:45.12,0:16:47.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senangnya bisa bangun siang.
Dialogue: 0,0:16:48.06,0:16:49.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti,
