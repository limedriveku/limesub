Dialogue: 0,0:00:00.00,0:00:00.27,sign,,0000,0000,0000,,ACARA INI ADALAH KARYA FIKSI.
Dialogue: 0,0:00:00.27,0:00:00.58,sign,,0000,0000,0000,,ANAK DI BAWAH UMUR DILARANG KERAS\NMINUM ALKOHOL OLEH HUKUM.
Dialogue: 0,0:00:00.58,0:00:01.09,sign,,0000,0000,0000,,KAMI JUGA TIDAK BERMAKSUD MENGANJURKAN\NPEMAKSAAN MINUM ALKOHOL,
Dialogue: 0,0:00:01.09,0:00:01.79,sign,,0000,0000,0000,,KONSUMSI ALKOHOL BERLEBIHAN, MAUPUN TINDAKAN\NTIDAK SENONOH SAAT PESTA MINUM.
Dialogue: 0,0:00:01.79,0:00:02.40,sign,,0000,0000,0000,,MOHON ANGGAP INI SEMATA-MATA\NSEBAGAI ANIME KOMEDI.
Dialogue: 0,0:00:02.40,0:00:03.10,sign,,0000,0000,0000,,SELURUH KARAKTER YANG MENGONSUMSI\NALKOHOL DALAM KARYA INI
Dialogue: 0,0:00:03.10,0:00:03.68,sign,,0000,0000,0000,,TELAH BERUSIA 20 TAHUN ATAU LEBIH.
Dialogue: 0,0:00:03.68,0:00:04.38,sign,,0000,0000,0000,,DEMI MENYESUAIKAN DENGAN STANDAR\NKEPATUHAN TERKINI.
Dialogue: 0,0:00:04.38,0:00:05.00,sign,,0000,0000,0000,,MULAI MUSIM INI\NUKURAN SENSOR HITAM KAMI NAIK 5%.
Dialogue: 0,0:00:05.84,0:00:09.99,sign,,0000,0000,0000,,TOKO SELAM, GRAND BLUE
Dialogue: 0,0:01:52.34,0:01:54.34,sign,,0000,0000,0000,,MITARAI
Dialogue: 0,0:02:29.13,0:02:31.38,sign,,0000,0000,0000,,PERGANTIAN PENGURUS KLUB
Dialogue: 0,0:02:31.38,0:02:33.51,sign,,0000,0000,0000,,KENCINGKU KELUAR NANAH
Dialogue: 0,0:02:33.51,0:02:34.13,sign,,0000,0000,0000,,WADUH
Dialogue: 0,0:03:27.81,0:03:28.53,sign,,0000,0000,0000,,BIR KINNAMA, ALKOHOL 5.5%, ISI 350ML
Dialogue: 0,0:05:36.94,0:05:39.94,sign,,0000,0000,0000,,IMAMURA KOUHEI
Dialogue: 0,0:06:32.25,0:06:33.25,sign,,0000,0000,0000,,HAPUS APLIKASI?\NBATALKAN, HAPUS
Dialogue: 0,0:09:57.70,0:09:59.70,sign,,0000,0000,0000,,TOKO SELAM, GRAND BLUE
Dialogue: 0,0:09:59.70,0:10:02.03,sign,,0000,0000,0000,,MITARAI
Dialogue: 0,0:10:09.46,0:10:18.97,sign,,0000,0000,0000,,SEBENTAR SAJA, KOK
Dialogue: 0,0:10:31.28,0:10:39.29,sign,,0000,0000,0000,,GRAND BLUE MUSIM 3
Dialogue: 0,0:12:57.42,0:12:58.30,sign,,0000,0000,0000,,YAMAMOTO JUNIOR
Dialogue: 0,0:12:58.30,0:13:00.43,sign,,0000,0000,0000,,DIAMETER
Dialogue: 0,0:13:10.29,0:13:12.88,sign,,0000,0000,0000,,KARAOKE
Dialogue: 0,0:13:28.93,0:13:30.46,sign,,0000,0000,0000,,YAMAMOTO
Dialogue: 0,0:13:41.47,0:13:44.22,sign,,0000,0000,0000,,YAMAMOTO
Dialogue: 0,0:13:51.48,0:13:55.23,sign,,0000,0000,0000,,MAKAN YAKINIKU SEPUASNYA
Dialogue: 0,0:14:09.50,0:14:14.45,sign,,0000,0000,0000,,TIPS RAHASIA MENGHADAPI SENGATAN PANAS
Dialogue: 0,0:14:14.45,0:14:15.25,sign,,0000,0000,0000,,CARA MENDINGINKAN SELANGKANGAN\NKOMITE PENDINGIN SELANGKANGAN
Dialogue: 0,0:14:19.76,0:14:21.76,sign,,0000,0000,0000,,YAMAMOTO JUNIOR
Dialogue: 0,0:14:24.26,0:14:26.26,sign,,0000,0000,0000,,YAMAMOTO
Dialogue: 0,0:14:30.30,0:14:33.77,sign,,0000,0000,0000,,ALKOHOL
Dialogue: 0,0:15:17.30,0:15:22.07,sign,,0000,0000,0000,,BELUM ADA BUKTI ILMIAH
Dialogue: 0,0:15:24.82,0:15:37.37,sign,,0000,0000,0000,,JANGAN DICOBA KARENA SANGAT BERBAHAYA, SERIUS!
Dialogue: 0,0:15:41.84,0:15:43.04,sign,,0000,0000,0000,,YAMAMOTO JUNIOR
Dialogue: 0,0:15:46.09,0:15:47.09,sign,,0000,0000,0000,,TINGTONG
Dialogue: 0,0:18:21.87,0:18:23.87,sign,,0000,0000,0000,,PRIA
