Dialogue: 0,0:18:44.70,0:18:45.40,sign,,0000,0000,0000,,SEMPROT BOKONG
Dialogue: 0,0:19:16.68,0:19:18.47,sign,,0000,0000,0000,,STOP, SEMPROT BOKONG, SEMPROT BIDET,
Dialogue: 0,0:19:18.47,0:19:20.18,sign,,0000,0000,0000,,KERINGKAN, SEMPROTAN KUAT
Dialogue: 0,0:19:37.70,0:19:40.20,sign,,0000,0000,0000,,SEMPROTAN KUAT
Dialogue: 0,0:20:03.47,0:20:07.48,sign,,0000,0000,0000,,SEMPROTAN KUAT
Dialogue: 0,0:20:08.98,0:20:12.98,sign,,0000,0000,0000,,TEKAN DUA KALI UNTUK SEMPROTAN SUPER KUAT
Dialogue: 0,0:20:35.46,0:20:38.47,sign,,0000,0000,0000,,SEMPROT BIDET
Dialogue: 0,0:21:03.99,0:21:06.26,sign,,0000,0000,0000,,STOP, SEMPROT BOKONG, SEMPROT BIDET,
Dialogue: 0,0:21:06.26,0:21:08.67,sign,,0000,0000,0000,,KERINGKAN, SEMPROTAN KUAT,
Dialogue: 0,0:21:08.67,0:21:10.75,sign,,0000,0000,0000,,TEKAN DUA KALI UNTUK SEMPROTAN SUPER KUAT
Dialogue: 0,0:22:12.06,0:22:15.02,sign,,0000,0000,0000,,MEREKA TIDAK TERKEJUT SAMA SEKALI
Dialogue: 0,0:23:44.99,0:23:49.99,sign,,0000,0000,0000,,SELANJUTNYA: LOTRE
Dialogue: 0,0:00:05.84,0:00:08.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf soal kencan buta tempo hari.
Dialogue: 0,0:00:08.32,0:00:09.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:00:10.50,0:00:12.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Libur musim panas berlalu pun
Dialogue: 0,0:00:12.88,0:00:16.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka masih saja bodoh.
Dialogue: 0,0:00:16.00,0:00:18.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, libur musim panas itu pendek.
Dialogue: 0,0:00:18.94,0:00:21.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil orang berubah secepat itu.
Dialogue: 0,0:00:21.87,0:00:23.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul.
Dialogue: 0,0:00:26.01,0:00:27.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:00:27.57,0:00:29.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kayaknya...
Dialogue: 0,0:00:29.97,0:00:32.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya ada yang janggal.
Dialogue: 0,0:00:35.36,0:00:35.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ih!
Dialogue: 0,0:00:35.95,0:00:37.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster!
Dialogue: 0,0:00:37.39,0:00:39.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa sapaan kalian begitu?
Dialogue: 0,0:00:39.78,0:00:41.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tokki!\NKamu di sini?
Dialogue: 0,0:00:41.52,0:00:45.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku kira kamu makhluk spesies baru.
Dialogue: 0,0:00:45.36,0:00:47.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata mamalia juga.
Dialogue: 0,0:00:47.57,0:00:48.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:00:48.86,0:00:51.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bantah, dong!
Dialogue: 0,0:00:51.28,0:00:52.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong.
Dialogue: 0,0:00:52.99,0:00:54.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya?
Dialogue: 0,0:00:54.28,0:00:57.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu tujuan hidup?
Dialogue: 0,0:00:57.41,0:00:59.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat telepon dokter!
Dialogue: 0,0:01:00.62,0:01:03.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wawancara kerja, ya.
Dialogue: 0,0:01:03.04,0:01:06.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malam ini ada kumpul-kumpul\Nsama alumni,
Dialogue: 0,0:01:06.62,0:01:10.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku mau menyiapkan tujuan\Nmasa depan dan evaluasi diri.
Dialogue: 0,0:01:10.62,0:01:13.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Topik umum buat wawancara, ya.
Dialogue: 0,0:01:13.49,0:01:14.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:01:14.55,0:01:18.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin aku juga harus siap-siap.
Dialogue: 0,0:01:18.24,0:01:21.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para senior sudah mulai cari kerja, ya.
Dialogue: 0,0:01:21.62,0:01:25.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus mulai memikirkan\Nacara perpisahannya.
Dialogue: 0,0:01:25.44,0:01:28.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konsultasi ke siapa, ya?
Dialogue: 0,0:01:29.82,0:01:33.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin curhat, bisakah kita kumpul?
Dialogue: 0,0:01:33.62,0:01:36.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku tanya mereka, ya?
Dialogue: 0,0:01:36.70,0:01:39.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan aku juga mau.
Dialogue: 0,0:01:39.62,0:01:42.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku juga mau curhat.
Dialogue: 0,0:01:44.83,0:01:48.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudahlah, mumpung kumpul.
Dialogue: 0,0:01:54.93,0:01:56.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini kamar Mitarai?
Dialogue: 0,0:01:56.99,0:01:58.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru pertama aku masuk.
Dialogue: 0,0:01:58.85,0:02:01.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya kamu ogah mengajak\Norang mampir.
Dialogue: 0,0:02:01.95,0:02:03.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini boleh?
Dialogue: 0,0:02:03.36,0:02:05.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, sesekali saja.
Dialogue: 0,0:02:05.86,0:02:08.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo bersulang dulu.
Dialogue: 0,0:02:08.11,0:02:10.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersulang!
Dialogue: 0,0:02:14.11,0:02:16.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Curhatan orang-orang bodoh ini
Dialogue: 0,0:02:16.68,0:02:20.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}paling cuma hal sepele.
Dialogue: 0,0:02:20.69,0:02:22.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajah mereka
Dialogue: 0,0:02:22.62,0:02:26.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sok serius banget.
Dialogue: 0,0:02:27.38,0:02:29.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau banyak yang curhat,
Dialogue: 0,0:02:29.81,0:02:33.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}biasanya yang kurang penting akan diabaikan.
Dialogue: 0,0:02:34.13,0:02:37.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi curhatan para cecunguk ini
Dialogue: 0,0:02:37.30,0:02:40.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Jadi, mau curhat apa?\N- mustahil serius...
Dialogue: 0,0:02:40.24,0:02:42.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya aku
Dialogue: 0,0:02:42.70,0:02:45.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mau berhenti kuliah dan jadi youtuber.
Dialogue: 0,0:02:46.45,0:02:49.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata serius banget!
Dialogue: 0,0:02:49.40,0:02:51.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, nekat juga.
Dialogue: 0,0:02:51.86,0:02:54.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa alasannya?
Dialogue: 0,0:02:54.05,0:02:57.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya sayang kalau hidup\Nbiasa-biasa saja.
Dialogue: 0,0:02:57.79,0:03:00.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya, wajahku tampan, kan?
Dialogue: 0,0:03:02.29,0:03:03.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajahku tampan, kan?
Dialogue: 0,0:03:05.36,0:03:07.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuulangi sampai dijawab.
Dialogue: 0,0:03:07.63,0:03:08.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tergantung sudut.
Dialogue: 0,0:03:08.69,0:03:09.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tergantung zaman.
Dialogue: 0,0:03:09.86,0:03:11.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kalau mataku dicongkel...
Dialogue: 0,0:03:11.87,0:03:14.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok semuanya bersyarat?
Dialogue: 0,0:03:14.17,0:03:16.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus, kontennya apa?
Dialogue: 0,0:03:16.70,0:03:19.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru aku curhat buat minta ide.
Dialogue: 0,0:03:19.46,0:03:21.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya aku mau dipuja-puja.
Dialogue: 0,0:03:21.63,0:03:25.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merepotkan sekali curhatan si bodoh ini!
Dialogue: 0,0:03:25.15,0:03:27.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuberi jawaban aman, deh.
Dialogue: 0,0:03:28.53,0:03:30.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini, Nojima.
Dialogue: 0,0:03:30.50,0:03:32.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kamu seakan kabur?
Dialogue: 0,0:03:32.53,0:03:33.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:03:33.34,0:03:35.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempuh saja kalau itu maumu.
Dialogue: 0,0:03:35.92,0:03:38.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tidak perlu berhenti kuliah, kan?
Dialogue: 0,0:03:38.56,0:03:40.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai sesimpel itu.
Dialogue: 0,0:03:40.32,0:03:44.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau menggapai mimpi,\Nbuatlah lingkungan yang mumpuni.
Dialogue: 0,0:03:44.83,0:03:46.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya?
Dialogue: 0,0:03:46.58,0:03:49.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau berhenti kuliah,\Nortumu akan berhenti membiayai.
Dialogue: 0,0:03:49.95,0:03:54.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan tetap kuliah,\Nkamu bisa mengejar impian berkali-kali.
Dialogue: 0,0:03:55.74,0:03:57.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkali-kali?
Dialogue: 0,0:03:57.59,0:04:01.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba pikirkan dengan kepala dingin.
Dialogue: 0,0:04:02.37,0:04:03.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:04:03.97,0:04:06.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip, Nojima terkendali!
Dialogue: 0,0:04:06.58,0:04:07.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya...
Dialogue: 0,0:04:07.60,0:04:10.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, sekarang giliranku.
Dialogue: 0,0:04:10.46,0:04:12.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini Yamamoto, ya.
Dialogue: 0,0:04:12.06,0:04:13.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau curhat apa?
Dialogue: 0,0:04:14.29,0:04:18.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jatuh cinta pada seseorang.
Dialogue: 0,0:04:19.74,0:04:21.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari kebun binatang mana?
Dialogue: 0,0:04:21.74,0:04:24.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian pikir aku ini apa, sih?
Dialogue: 0,0:04:24.74,0:04:26.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius!
Dialogue: 0,0:04:26.34,0:04:28.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini orangnya!
Dialogue: 0,0:04:28.50,0:04:33.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, aku Sakuya si idola virtual!
Dialogue: 0,0:04:33.50,0:04:35.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi-lagi halu!
Dialogue: 0,0:04:35.63,0:04:38.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya dia nyata!
Dialogue: 0,0:04:38.13,0:04:42.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi bersemangat tiap melihatnya.
Dialogue: 0,0:04:42.27,0:04:45.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata inilah cinta sesungguhnya.
Dialogue: 0,0:04:45.63,0:04:47.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oh.
Dialogue: 0,0:04:47.43,0:04:50.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai teman, aku dukung, sih...
Dialogue: 0,0:04:50.90,0:04:54.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tadi pagi aku muntah-muntah terus.\N- Aku ingin menikahi suara indahnya!
Dialogue: 0,0:04:54.34,0:04:55.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana bisa!
Dialogue: 0,0:04:55.79,0:05:00.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku muntah banyak demi kalian, lo!\N- Kali ini cinta parasosial, ya.
Dialogue: 0,0:05:00.67,0:05:05.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kouhei, coba tiru suaranya pakai teknik\Nmix voice-mu yang waktu itu.
Dialogue: 0,0:05:07.31,0:05:10.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang satu itu, mustahil.
Dialogue: 0,0:05:10.67,0:05:13.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Kamu tidak bisa menirunya?
Dialogue: 0,0:05:13.94,0:05:16.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu.
Dialogue: 0,0:05:16.83,0:05:18.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus kenapa?
Dialogue: 0,0:05:18.42,0:05:21.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga punya masalah tersendiri.
Dialogue: 0,0:05:21.07,0:05:23.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Kamu punya masalah?
Dialogue: 0,0:05:23.47,0:05:26.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masalahnya baru saja muncul.
Dialogue: 0,0:05:26.18,0:05:27.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aneh banget.
Dialogue: 0,0:05:27.76,0:05:29.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar, Yamamoto.
Dialogue: 0,0:05:29.42,0:05:32.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau belum pernah berjumpa,\Nmustahil menjalin asmara.
Dialogue: 0,0:05:32.85,0:05:35.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minimal bisa kenalan dulu.
Dialogue: 0,0:05:36.94,0:05:39.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akulah sosok di balik Sakuya.
Dialogue: 0,0:05:40.44,0:05:43.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian itu kenapa, sih?
Dialogue: 0,0:05:44.43,0:05:48.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma jatuh cinta padanya, aku jamin!
Dialogue: 0,0:05:48.31,0:05:50.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok kamu seyakin itu?
Dialogue: 0,0:05:50.37,0:05:52.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya dia adalah Kouhei.
Dialogue: 0,0:05:52.96,0:05:56.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga menyamakan dia\Ndengan gambar dua dimensi, ya?
Dialogue: 0,0:05:56.86,0:05:58.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tiga dimensi, lo!
Dialogue: 0,0:05:59.99,0:06:01.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, terserahlah.
Dialogue: 0,0:06:04.70,0:06:06.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, kenapa begini?
Dialogue: 0,0:06:07.65,0:06:13.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:06:20.48,0:06:22.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mengerti perasaanku, Imamura?
Dialogue: 0,0:06:22.74,0:06:25.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya itu kata-kataku, Yamamoto!
Dialogue: 0,0:06:25.74,0:06:28.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, meski buatku tidak penting.
Dialogue: 0,0:06:29.73,0:06:32.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu akan tetap perjaka\Nkalau sama dua dimensi.
Dialogue: 0,0:06:33.87,0:06:35.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu dibahas lagi!
Dialogue: 0,0:06:37.38,0:06:39.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berubah dalam sekejap!
Dialogue: 0,0:06:39.00,0:06:41.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu berkhianat, Yamamoto?
Dialogue: 0,0:06:41.10,0:06:45.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak awal kita bukan rekan,\Ndasar Tukang Halu!
Dialogue: 0,0:06:45.20,0:06:48.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip, masalah selesai!
Dialogue: 0,0:06:48.37,0:06:49.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisanya...
Dialogue: 0,0:06:49.85,0:06:53.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masalahku tidak sekecil kalian.
Dialogue: 0,0:06:53.02,0:06:54.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:06:54.67,0:06:58.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini soal Rie, teman masa kecilku.
Dialogue: 0,0:06:58.27,0:07:01.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku nyaris dia bunuh\Nkarena ketahuan selingkuh!
Dialogue: 0,0:07:01.17,0:07:05.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rahangmu aku patahkan, nih?
Dialogue: 0,0:07:05.63,0:07:06.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuih!
Dialogue: 0,0:07:06.56,0:07:07.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak penting!
Dialogue: 0,0:07:07.81,0:07:11.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih, hubungi konseling anak-anak saja sana!
Dialogue: 0,0:07:11.55,0:07:13.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawab yang serius, dong!
Dialogue: 0,0:07:13.79,0:07:15.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minta maaf lalu mati saja!
Dialogue: 0,0:07:15.47,0:07:17.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lakukan seppuku kalau jantan!
Dialogue: 0,0:07:17.20,0:07:19.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau diarak keliling kota!
Dialogue: 0,0:07:19.31,0:07:22.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terjun lenting saja, tapi tanpa tali!
Dialogue: 0,0:07:22.55,0:07:24.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar kalian!
Dialogue: 0,0:07:24.55,0:07:27.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma bertukar kontak, tahu!
Dialogue: 0,0:07:27.70,0:07:28.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu salah.
Dialogue: 0,0:07:28.91,0:07:29.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mampus sana!
Dialogue: 0,0:07:29.73,0:07:30.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langsung mampus!
Dialogue: 0,0:07:30.96,0:07:32.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mampus secepatnya!
Dialogue: 0,0:07:32.58,0:07:33.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jahat banget!
Dialogue: 0,0:07:34.24,0:07:36.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenangkan diri kalian!
Dialogue: 0,0:07:36.91,0:07:38.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:07:38.00,0:07:41.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rie tipe yang fokus ke satu hal\Nkalau sudah telanjur yakin.
Dialogue: 0,0:07:41.82,0:07:43.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih, terus kenapa?
Dialogue: 0,0:07:43.96,0:07:46.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu salah orang kalau mau pamer.
Dialogue: 0,0:07:46.72,0:07:48.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah bosan hidup, ya?
Dialogue: 0,0:07:48.85,0:07:50.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bilang padanya
Dialogue: 0,0:07:50.32,0:07:53.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahwa kalian yang menghasutku\Nmelakukan hal itu.
Dialogue: 0,0:07:53.97,0:07:56.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok kami dilibatkan?
Dialogue: 0,0:07:56.33,0:08:00.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat lakukan sesuatu!\NSebentar lagi dia datang!
Dialogue: 0,0:08:00.18,0:08:01.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar bedebah!
Dialogue: 0,0:08:01.60,0:08:04.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas saja kami diajak ke sini!
Dialogue: 0,0:08:04.06,0:08:06.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak awal inilah rencanamu, ya?
Dialogue: 0,0:08:09.22,0:08:10.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat pergi!
Dialogue: 0,0:08:10.29,0:08:11.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mampus sana!
Dialogue: 0,0:08:11.87,0:08:15.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tega banget kalian!
Dialogue: 0,0:08:24.06,0:08:25.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:08:25.92,0:08:27.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Yuu.
Dialogue: 0,0:08:28.49,0:08:31.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya?
Dialogue: 0,0:08:31.49,0:08:36.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang jangan bicara\Nke gadis lain, kan?
Dialogue: 0,0:08:36.92,0:08:40.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya, iya.
Dialogue: 0,0:08:40.92,0:08:46.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, kenapa kamu tidak menurut?
Dialogue: 0,0:08:46.34,0:08:49.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu!\NDia rekan kerjaku, lo!
Dialogue: 0,0:08:49.87,0:08:53.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertukar kontak itu wajar, kan?
Dialogue: 0,0:08:53.46,0:08:56.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan itu yang kutanyakan.
Dialogue: 0,0:08:57.60,0:09:00.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bilang kalau selingkuh lagi\Nrahangmu bayarannya, kan?
Dialogue: 0,0:09:08.03,0:09:10.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana nasibnya?
Dialogue: 0,0:09:10.46,0:09:12.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah jelas, kan?
Dialogue: 0,0:09:12.43,0:09:15.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rahangnya hancur dan selesai.
Dialogue: 0,0:09:15.28,0:09:16.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu.
Dialogue: 0,0:09:16.77,0:09:18.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa, Kitahara?
Dialogue: 0,0:09:18.29,0:09:19.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi-lagi itu?
Dialogue: 0,0:09:19.94,0:09:22.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu merasakan aura bajingan darinya?
Dialogue: 0,0:09:22.43,0:09:23.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:09:23.71,0:09:25.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat terasa!
Dialogue: 0,0:09:25.17,0:09:27.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Instingmu aneh sekali.
Dialogue: 0,0:09:28.55,0:09:29.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rie.
Dialogue: 0,0:09:29.71,0:09:30.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:09:30.86,0:09:36.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, itu, eng, begini...
Dialogue: 0,0:09:37.07,0:09:38.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo menikah!
Dialogue: 0,0:09:46.78,0:09:48.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah.
Dialogue: 0,0:09:53.15,0:09:54.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak pintar.
Dialogue: 0,0:09:59.70,0:10:02.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong adakan sesi curhat lagi.
Dialogue: 0,0:10:03.20,0:10:06.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius, ini sudah tidak terkendali.
Dialogue: 0,0:10:06.18,0:10:07.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon!\NKita teman, kan?
Dialogue: 0,0:10:07.78,0:10:09.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah.
Dialogue: 0,0:10:10.22,0:10:12.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nada deringnya berisik.
Dialogue: 0,0:10:12.56,0:10:15.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senyapkan saja pesan darinya.
Dialogue: 0,0:10:15.68,0:10:16.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setuju.
Dialogue: 0,0:11:59.41,0:12:00.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panas.
Dialogue: 0,0:12:01.47,0:12:04.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya AC-ku rusak.
Dialogue: 0,0:12:12.75,0:12:15.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, gerah banget!
Dialogue: 0,0:12:15.74,0:12:17.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Es krimnya sudah habis.
Dialogue: 0,0:12:17.50,0:12:20.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku butuh minuman dingin.
Dialogue: 0,0:12:20.26,0:12:22.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Apa ini?
Dialogue: 0,0:12:25.39,0:12:27.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, waktu itu mereka...
Dialogue: 0,0:12:28.03,0:12:29.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alkoholnya kami taruh di sini.
Dialogue: 0,0:12:29.41,0:12:31.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Simpanlah di pembeku.
Dialogue: 0,0:12:31.71,0:12:33.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah katanya.
Dialogue: 0,0:12:34.42,0:12:36.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di pembeku saja tetap cair.
Dialogue: 0,0:12:36.91,0:12:39.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alkoholnya pasti keras.
Dialogue: 0,0:12:47.60,0:12:51.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh!\NKalau minum ini aku bisa mati!
Dialogue: 0,0:13:10.29,0:13:12.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya birnya sudah cukup.
Dialogue: 0,0:13:12.88,0:13:14.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul.
Dialogue: 0,0:13:14.11,0:13:16.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit menyimpannya kalau kebanyakan.
Dialogue: 0,0:13:17.12,0:13:19.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Spirtus-nya juga lima botol saja, ya?
Dialogue: 0,0:13:19.70,0:13:22.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu wajib diborong!
Dialogue: 0,0:13:22.22,0:13:23.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:13:25.62,0:13:26.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ponsel siapa itu?
Dialogue: 0,0:13:26.90,0:13:28.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, punyaku.
Dialogue: 0,0:13:30.46,0:13:32.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa, Yamamoto?
Dialogue: 0,0:13:32.58,0:13:34.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Kitahara.
Dialogue: 0,0:13:34.54,0:13:36.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, sih?
Dialogue: 0,0:13:36.24,0:13:39.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini soal alkohol yang kamu taruh di sini.
Dialogue: 0,0:13:39.38,0:13:41.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Alkoholnya kenapa?
Dialogue: 0,0:13:42.53,0:13:44.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi tidak bisa diminum.
Dialogue: 0,0:13:44.22,0:13:47.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Kamu minum sendirian?
Dialogue: 0,0:13:47.52,0:13:48.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:13:48.80,0:13:50.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tumpah?
Dialogue: 0,0:13:50.50,0:13:51.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan juga.
Dialogue: 0,0:13:51.48,0:13:53.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus kenapa, dong?
Dialogue: 0,0:13:53.55,0:13:55.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak...
Dialogue: 0,0:13:55.23,0:13:58.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa kuceritakan.
Dialogue: 0,0:13:58.53,0:14:00.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu, sih?
Dialogue: 0,0:14:00.49,0:14:02.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya begitu.
Dialogue: 0,0:14:02.62,0:14:04.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Hei?
Dialogue: 0,0:14:07.60,0:14:09.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kacau.
Dialogue: 0,0:14:09.50,0:14:12.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku teringat mendinginkan si joni
Dialogue: 0,0:14:12.21,0:14:14.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa menyejukkan tubuh.
Dialogue: 0,0:14:15.25,0:14:19.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tidak bisa begini terus,\Nsaatnya aku cabut.
Dialogue: 0,0:14:27.26,0:14:30.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yamamoto?\NApa maksudmu tadi?
Dialogue: 0,0:14:30.30,0:14:33.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan basa-basi, cepat jawab aku.
Dialogue: 0,0:14:34.35,0:14:36.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa isi botol ini?
Dialogue: 0,0:14:36.27,0:14:37.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Spirtus.
Dialogue: 0,0:14:40.91,0:14:42.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kamu kenapa?
Dialogue: 0,0:14:43.30,0:14:46.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tamat sudah riwayatku.
Dialogue: 0,0:14:46.16,0:14:48.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, sebenarnya ada apa, sih?
Dialogue: 0,0:14:52.13,0:14:56.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bahkan lebih bahaya\Ndari cairan antiseptik.
Dialogue: 0,0:14:58.29,0:15:01.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya ini harus lepas!
Dialogue: 0,0:15:01.58,0:15:04.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit sebentar bisa kutahan!
Dialogue: 0,0:15:04.55,0:15:05.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hup.
Dialogue: 0,0:15:05.80,0:15:09.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alkohol diserap perlahan di lambung.
Dialogue: 0,0:15:09.78,0:15:13.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi di selaput semacam usus halus,\Npenyerapannya jadi cepat.
Dialogue: 0,0:15:13.92,0:15:17.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membuat lonjakan kadar alkohol\Ndalam darah.
Dialogue: 0,0:15:17.30,0:15:21.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya, penyerapan via selaput berlendir
Dialogue: 0,0:15:21.02,0:15:22.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bikin cepat mabuk.
Dialogue: 0,0:15:38.00,0:15:41.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Parah, ini cara mabuk terburuk!
Dialogue: 0,0:15:43.04,0:15:46.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan saatnya mabuk!\NBotolnya harus kupotong!
Dialogue: 0,0:15:49.09,0:15:51.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf jadi harus mampir dulu.
Dialogue: 0,0:15:51.44,0:15:53.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:15:53.38,0:15:55.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekalian lewat juga.
Dialogue: 0,0:15:55.10,0:15:57.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kamu kenapa?
Dialogue: 0,0:15:57.41,0:15:58.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak dijawab.
Dialogue: 0,0:15:58.53,0:15:59.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aneh sekali.
Dialogue: 0,0:15:59.86,0:16:02.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, hari ini panas sekali.
Dialogue: 0,0:16:02.42,0:16:03.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:16:03.61,0:16:06.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, giliran lagi begini...
Dialogue: 0,0:16:36.66,0:16:39.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada suara orang kesakitan di dalam!
Dialogue: 0,0:16:39.79,0:16:41.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yamamoto, kamu baik-baik saja?
Dialogue: 0,0:16:55.50,0:16:57.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi hening lagi.
Dialogue: 0,0:16:57.33,0:16:58.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia baik-baik saja?
Dialogue: 0,0:16:58.91,0:17:01.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iori, cepat minta kunci\Nke pengelola kosan!
Dialogue: 0,0:17:01.90,0:17:02.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:17:07.92,0:17:10.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Ini...
Dialogue: 0,0:17:16.43,0:17:17.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:17:17.71,0:17:18.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul.
Dialogue: 0,0:17:18.91,0:17:22.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata, dia cuma habis minum alkohol.
Dialogue: 0,0:17:22.69,0:17:25.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bikin kaget saja.
Dialogue: 0,0:17:25.41,0:17:27.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kalau aman.
Dialogue: 0,0:17:27.73,0:17:30.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kamu baik-baik saja?
Dialogue: 0,0:17:35.04,0:17:38.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemarin dia minum spirtus pakai si joni!
Dialogue: 0,0:17:38.40,0:17:39.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kocak amat!
Dialogue: 0,0:17:39.60,0:17:41.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sinting, ya?
Dialogue: 0,0:17:41.06,0:17:43.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami saja tidak melakukannya!
Dialogue: 0,0:17:47.40,0:17:48.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kan?
Dialogue: 0,0:17:48.90,0:17:51.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah curiga begitu.
Dialogue: 0,0:17:51.47,0:17:54.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian juga pasti sama\Nkalau ada di posisiku!
Dialogue: 0,0:17:54.88,0:17:56.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan!
Dialogue: 0,0:17:56.22,0:18:00.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang gila mana yang memasukkan\Nsi joni ke spirtus?
Dialogue: 0,0:18:02.96,0:18:03.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:18:03.90,0:18:05.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Nojima?
Dialogue: 0,0:18:06.38,0:18:08.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ke toilet dulu.
Dialogue: 0,0:18:10.27,0:18:12.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke toilet kok mukanya begitu?
Dialogue: 0,0:18:12.59,0:18:14.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bilang saja mau berak.
Dialogue: 0,0:18:14.87,0:18:17.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkadang dia menjijikkan, ya.
Dialogue: 0,0:18:17.63,0:18:20.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekitar 28 hari dalam sebulan.
Dialogue: 0,0:18:20.18,0:18:21.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Februari, tiap hari, dong?
Dialogue: 0,0:18:25.36,0:18:29.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kelamaan sama mereka,\Nmartabatku bisa rusak.
Dialogue: 0,0:18:37.28,0:18:40.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak yang tidak butuh toilet bidet,
Dialogue: 0,0:18:40.35,0:18:43.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi bagiku itu sangat penting.
Dialogue: 0,0:18:43.14,0:18:44.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:18:59.60,0:19:02.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Airnya tidak berhenti.
Dialogue: 0,0:19:02.91,0:19:07.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa sudah kuaktifkan\Ntapi tidak berhenti?
Dialogue: 0,0:19:07.17,0:19:10.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa perintahku tidak dipatuhi?
Dialogue: 0,0:19:10.22,0:19:12.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seolah-olah diriku
Dialogue: 0,0:19:13.14,0:19:16.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karakter utama dalam anime robot!
Dialogue: 0,0:19:16.68,0:19:20.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial! Tidak terkendali!
Dialogue: 0,0:19:20.66,0:19:22.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bohong.
Dialogue: 0,0:19:34.44,0:19:37.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?\NApa yang terjadi?
Dialogue: 0,0:19:40.72,0:19:44.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok cuma tombol itu yang nyala?
Dialogue: 0,0:19:45.21,0:19:47.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, masih tidak berhenti!
Dialogue: 0,0:19:48.27,0:19:49.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski butuh bantuan...
Dialogue: 0,0:19:50.46,0:19:52.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nojima tidak pakai celana?
Dialogue: 0,0:19:52.54,0:19:55.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tombolnya rusak,\Nmasa sebegitunya?
Dialogue: 0,0:19:55.71,0:19:57.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reputasinya hancur!
Dialogue: 0,0:19:57.01,0:20:00.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kukira kamu pria terhormat.\N- Martabatku terancam!
Dialogue: 0,0:20:01.22,0:20:03.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba kutekan lagi!
Dialogue: 0,0:20:16.95,0:20:21.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar dulu!\NTenagamu terlalu besar buatku!
Dialogue: 0,0:20:21.42,0:20:26.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon, berhentilah!\NAku tidak tahan lagi!
Dialogue: 0,0:20:33.47,0:20:35.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah berhenti?
Dialogue: 0,0:20:43.60,0:20:47.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:20:48.98,0:20:51.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, gawat.
Dialogue: 0,0:20:51.31,0:20:52.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa gila.
Dialogue: 0,0:20:53.46,0:20:56.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau tidak mau harus minta tolong.
Dialogue: 0,0:21:01.49,0:21:03.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum berakhir!
Dialogue: 0,0:21:03.99,0:21:06.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toilet bidet itu alat elektronik!
Dialogue: 0,0:21:06.26,0:21:08.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia akan mati tanpa listrik!
Dialogue: 0,0:21:08.67,0:21:11.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan unit ini tidak pakai baterai!
Dialogue: 0,0:21:11.40,0:21:13.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Solusinya adalah mencabut itu!
Dialogue: 0,0:21:14.69,0:21:16.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan kalah!
Dialogue: 0,0:21:18.14,0:21:20.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedikit lagi!
Dialogue: 0,0:21:21.95,0:21:23.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terjagalah!
Dialogue: 0,0:21:24.37,0:21:28.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Citraku!
Dialogue: 0,0:21:32.05,0:21:34.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nojima lama banget.
Dialogue: 0,0:21:34.66,0:21:37.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisa dia telat masuk kelas.
Dialogue: 0,0:21:42.59,0:21:43.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu suaranya Nojima?
Dialogue: 0,0:21:43.93,0:21:45.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kenapa?
Dialogue: 0,0:21:47.38,0:21:50.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Ini...
Dialogue: 0,0:22:02.05,0:22:05.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia keramas pakai bidet toilet.
Dialogue: 0,0:22:05.01,0:22:08.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, pasti lagi mainin joninya\Npakai air bidet.
Dialogue: 0,0:22:08.40,0:22:09.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah Nojima.
Dialogue: 0,0:22:09.76,0:22:12.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aura cabulnya kuat banget.
