Dialogue: 0,0:06:46.93,0:06:55.56,sign,,0000,0000,0000,,YOSHIWARA
Dialogue: 0,0:06:58.81,0:07:01.32,sign,,0000,0000,0000,,CINTA POLOS
Dialogue: 0,0:07:38.60,0:07:41.68,sign,,0000,0000,0000,,GEDUNG SEKOLAH
Dialogue: 0,0:07:41.68,0:07:42.86,sign,,0000,0000,0000,,YUUTA: MAAF LIBURANNYA BATAL
Dialogue: 0,0:09:44.52,0:09:47.15,sign,,0000,0000,0000,,BUSUJIMA
Dialogue: 0,0:11:26.00,0:11:33.26,sign,,0000,0000,0000,,HARI PERTAMA
Dialogue: 0,0:12:06.04,0:12:08.54,sign,,0000,0000,0000,,RENTAL MOBIL
Dialogue: 0,0:12:47.71,0:12:51.71,sign,,0000,0000,0000,,BURGER SELAMAT DATANG
Dialogue: 0,0:13:07.85,0:13:10.85,sign,,0000,0000,0000,,BURGER SELAMAT DATANG
Dialogue: 0,0:17:38.91,0:17:40.91,sign,,0000,0000,0000,,LAUT DALAM INDAH\NALKOHOL
Dialogue: 0,0:17:59.06,0:18:15.95,sign,,0000,0000,0000,,KOREGUSU
Dialogue: 0,0:19:13.01,0:19:16.80,sign,,0000,0000,0000,,LAUT DALAM INDAH\NALKOHOL
Dialogue: 0,0:19:40.03,0:19:42.04,sign,,0000,0000,0000,,HOTEL BUENA VISTA OKINAWA
Dialogue: 0,0:21:40.65,0:21:42.66,sign,,0000,0000,0000,,HARI KEDUA\NHOTEL BUENA VISTA OKINAWA
Dialogue: 0,0:21:53.42,0:21:54.05,sign,,0000,0000,0000,,HOTEL CINTA, SEMUANYA SALAH CINTA,
Dialogue: 0,0:21:54.05,0:21:56.05,sign,,0000,0000,0000,,SARANG CINTA
Dialogue: 0,0:21:56.05,0:21:57.92,sign,,0000,0000,0000,,MUSIM PANAS ITU
Dialogue: 0,0:23:44.99,0:23:49.99,sign,,0000,0000,0000,,SELANJUTNYA: KEMBALI KE OKINAWA (BAGIAN B)
Dialogue: 0,0:01:41.39,0:01:42.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kouhei.
Dialogue: 0,0:01:43.25,0:01:46.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bantu aku!
Dialogue: 0,0:01:46.94,0:01:49.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tiba-tiba bertingkah memalukan?
Dialogue: 0,0:01:49.78,0:01:53.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah kehabisan akal!
Dialogue: 0,0:01:53.92,0:01:57.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ahlinya soal cara licik,\Nkotor, dan curang, kan?
Dialogue: 0,0:01:57.96,0:01:59.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ucapanmu pedas sekali.
Dialogue: 0,0:01:59.52,0:02:00.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku salah?
Dialogue: 0,0:02:00.61,0:02:01.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul, kok.
Dialogue: 0,0:02:01.89,0:02:04.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya tolong bantu aku berpikir!
Dialogue: 0,0:02:04.96,0:02:07.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ogah, aku sibuk.
Dialogue: 0,0:02:07.27,0:02:08.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti gim cewek cantik yang Kikko
Dialogue: 0,0:02:08.91,0:02:11.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sodorkan padaku ini buatmu, deh!
Dialogue: 0,0:02:11.03,0:02:13.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun.
Dialogue: 0,0:02:13.03,0:02:15.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi mau memikirkan apa?
Dialogue: 0,0:02:15.31,0:02:16.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini.
Dialogue: 0,0:02:17.10,0:02:20.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin mencegah dua orang pergi liburan.
Dialogue: 0,0:02:20.16,0:02:21.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya?
Dialogue: 0,0:02:21.65,0:02:25.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tentang temanku.
Dialogue: 0,0:02:25.42,0:02:27.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cowok yang disukainya
Dialogue: 0,0:02:27.42,0:02:29.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kebetulan dapat uang lebih.
Dialogue: 0,0:02:29.42,0:02:29.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:02:29.98,0:02:32.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi uang itu mau dipakai mengajak
Dialogue: 0,0:02:32.17,0:02:33.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}cewek lain.
Dialogue: 0,0:02:33.67,0:02:34.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paham.
Dialogue: 0,0:02:34.37,0:02:36.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin mencegahnya
Dialogue: 0,0:02:36.18,0:02:38.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}biar mereka tidak makin dekat.
Dialogue: 0,0:02:38.18,0:02:41.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, liburannya Kitahara dan Kotegawa?
Dialogue: 0,0:02:41.56,0:02:44.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah dibilang ini soal temanku!
Dialogue: 0,0:02:44.06,0:02:46.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, sebaiknya bagaimana?
Dialogue: 0,0:02:46.83,0:02:48.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bilang saja...
Dialogue: 0,0:02:48.56,0:02:50.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pergi.
Dialogue: 0,0:02:50.75,0:02:52.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur akan lebih baik.
Dialogue: 0,0:02:52.69,0:02:55.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana bisa begitu!
Dialogue: 0,0:02:55.02,0:02:55.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:02:55.95,0:02:58.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha-Habisnya aneh.
Dialogue: 0,0:02:58.95,0:03:01.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian aku bukan siapa-siapanya.
Dialogue: 0,0:03:03.52,0:03:05.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti tembak saja baru hentikan.
Dialogue: 0,0:03:05.96,0:03:06.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tembak?
Dialogue: 0,0:03:07.46,0:03:09.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mau?
Dialogue: 0,0:03:09.07,0:03:10.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu, sih...
Dialogue: 0,0:03:11.39,0:03:15.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hubungan kami bisa rusak kalau gagal.
Dialogue: 0,0:03:15.95,0:03:17.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takut.
Dialogue: 0,0:03:20.49,0:03:24.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Temanku!\NTemanku yang bilang begitu.
Dialogue: 0,0:03:24.48,0:03:26.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Capek banget.
Dialogue: 0,0:03:26.48,0:03:28.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jam sebegini baru selesai kerja?
Dialogue: 0,0:03:28.48,0:03:30.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bantu-bantu sif siang.
Dialogue: 0,0:03:30.48,0:03:34.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belakangan ini mereka kurang orang.
Dialogue: 0,0:03:34.10,0:03:35.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian kayaknya gabut, ya.
Dialogue: 0,0:03:35.89,0:03:37.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dipanggil sama di—
Dialogue: 0,0:03:37.41,0:03:40.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sedang konsultasi!
Dialogue: 0,0:03:41.20,0:03:42.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konsultasi?
Dialogue: 0,0:03:42.24,0:03:46.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maksudnya, konsultasi soal temanku.
Dialogue: 0,0:03:46.59,0:03:49.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya masih belum kelar.
Dialogue: 0,0:03:49.00,0:03:50.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa!
Dialogue: 0,0:03:51.00,0:03:53.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Apa coba?
Dialogue: 0,0:03:54.01,0:03:55.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih lanjut?
Dialogue: 0,0:03:55.66,0:03:57.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya belum ada solusi.
Dialogue: 0,0:03:57.76,0:04:00.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa konsultasinya di sini?
Dialogue: 0,0:04:00.27,0:04:02.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya harus pindah tempat.
Dialogue: 0,0:04:02.80,0:04:03.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sini.
Dialogue: 0,0:04:03.82,0:04:05.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau ke mana lagi?
Dialogue: 0,0:04:05.52,0:04:08.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok kamu pakai kacamata dan topi?
Dialogue: 0,0:04:08.43,0:04:12.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belakangan ini aku sering dikira Ikegoshi.
Dialogue: 0,0:04:13.86,0:04:17.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barusan Aina sama cowok?
Dialogue: 0,0:04:18.88,0:04:20.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan ini...
Dialogue: 0,0:04:20.42,0:04:21.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, ini kamarku.
Dialogue: 0,0:04:21.52,0:04:22.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pulang saja!
Dialogue: 0,0:04:22.59,0:04:23.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:04:23.53,0:04:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada urusan pribadi!
Dialogue: 0,0:04:25.20,0:04:27.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paling nonton anime, kan?
Dialogue: 0,0:04:27.79,0:04:28.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat masuk!
Dialogue: 0,0:04:28.62,0:04:31.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Woi, aku enggak mau masuk!
Dialogue: 0,0:04:31.89,0:04:32.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa, sih?
Dialogue: 0,0:04:32.75,0:04:34.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Mentalku belum siap!\N- Set.
Dialogue: 0,0:04:34.51,0:04:36.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ogah!\N- Cepat masuk!
Dialogue: 0,0:04:37.07,0:04:40.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aina membawa paksa seorang cowok?
Dialogue: 0,0:04:40.74,0:04:42.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duduklah di mana saja.
Dialogue: 0,0:04:42.96,0:04:43.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:04:43.82,0:04:44.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:04:44.81,0:04:49.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku syok karena kamar cewek yang pertama\Nkumasuki adalah kamarmu.
Dialogue: 0,0:04:49.81,0:04:54.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga baru pertama membiarkan\Ncowok masuk kamar.
Dialogue: 0,0:04:54.85,0:04:56.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengalaman pertamaku malah Kouhei.
Dialogue: 0,0:04:56.80,0:04:59.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengalaman pertamaku malah si Menor.
Dialogue: 0,0:04:59.45,0:05:01.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi belum tentu buat begituan.
Dialogue: 0,0:05:01.76,0:05:03.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama...
Dialogue: 0,0:05:03.42,0:05:05.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengalaman pertamaku...
Dialogue: 0,0:05:05.95,0:05:09.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengalaman pertama?\Nberarti begituan, dong?
Dialogue: 0,0:05:09.96,0:05:12.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan baru dua menit sejak mereka masuk.
Dialogue: 0,0:05:12.66,0:05:14.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Liar banget!
Dialogue: 0,0:05:14.10,0:05:16.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, tapi sudah kepalang.
Dialogue: 0,0:05:16.11,0:05:20.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski enggan, mari kita lakukan.
Dialogue: 0,0:05:20.09,0:05:22.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tahu metode yang bagus?
Dialogue: 0,0:05:22.72,0:05:23.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba kupikirkan.
Dialogue: 0,0:05:23.65,0:05:24.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Metode?
Dialogue: 0,0:05:24.42,0:05:26.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo panggil temanmu.
Dialogue: 0,0:05:26.10,0:05:27.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara apa dia?
Dialogue: 0,0:05:27.97,0:05:30.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana, ya?
Dialogue: 0,0:05:30.02,0:05:32.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok kamu tidak menolak?
Dialogue: 0,0:05:32.32,0:05:34.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bakal dipanggil?
Dialogue: 0,0:05:34.48,0:05:38.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau susah, cari aibnya buat diperas.
Dialogue: 0,0:05:38.23,0:05:40.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pacaran sama cowok kayak begitu!
Dialogue: 0,0:05:40.74,0:05:42.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:05:42.86,0:05:46.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sadarlah! Kamu itu cantik!\NHargailah dirimu!
Dialogue: 0,0:05:46.62,0:05:47.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke?
Dialogue: 0,0:05:47.39,0:05:50.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu adiknya Nona Kaya, kan?
Dialogue: 0,0:05:50.25,0:05:51.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Kouhei?
Dialogue: 0,0:05:51.66,0:05:53.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo.
Dialogue: 0,0:05:54.72,0:05:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ternyata begitu.
Dialogue: 0,0:05:57.00,0:05:58.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kira apa?
Dialogue: 0,0:06:00.37,0:06:04.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi mana janjimu?\NCepatlah!
Dialogue: 0,0:06:04.03,0:06:05.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Janji?
Dialogue: 0,0:06:05.64,0:06:07.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, aku lupa.
Dialogue: 0,0:06:07.20,0:06:10.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku janji mau memberikan\Ngim pemberian Kikko.
Dialogue: 0,0:06:10.90,0:06:13.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, gim yang semuanya tolak itu?
Dialogue: 0,0:06:13.89,0:06:15.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan.
Dialogue: 0,0:06:16.90,0:06:18.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya ini...
Dialogue: 0,0:06:18.90,0:06:21.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah punya?
Dialogue: 0,0:06:21.01,0:06:22.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum, sih.
Dialogue: 0,0:06:22.90,0:06:24.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat saja biar tahu.
Dialogue: 0,0:06:26.41,0:06:28.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Keiko.
Dialogue: 0,0:06:28.21,0:06:29.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo.
Dialogue: 0,0:06:29.66,0:06:32.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Aina memanggil kita, ya?
Dialogue: 0,0:06:32.27,0:06:35.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar ada situasi mendesak.
Dialogue: 0,0:06:35.17,0:06:38.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paling mau mengajak nonton film...
Dialogue: 0,0:06:41.80,0:06:43.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perkembangannya mendadak banget.
Dialogue: 0,0:06:43.97,0:06:46.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini mah sudah level evolusi.
Dialogue: 0,0:06:46.93,0:06:49.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi normal bagi mahasiswi, sih.
Dialogue: 0,0:06:49.38,0:06:50.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul juga.
Dialogue: 0,0:06:50.86,0:06:53.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Aku juga ikut?
Dialogue: 0,0:06:53.28,0:06:55.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kamu juga ikut.
Dialogue: 0,0:06:55.56,0:06:57.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlalu dini kalau ramai-ramai!
Dialogue: 0,0:06:57.56,0:06:58.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apaan?
Dialogue: 0,0:06:58.81,0:07:01.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gim porno waktu itu, ya.
Dialogue: 0,0:07:01.32,0:07:04.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Aina kadang aneh-aneh,\Nkukira apa...
Dialogue: 0,0:07:04.32,0:07:05.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kira apa?
Dialogue: 0,0:07:05.82,0:07:08.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan Kikko, itu gim porno?
Dialogue: 0,0:07:08.43,0:07:09.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa? Membosankan?
Dialogue: 0,0:07:09.97,0:07:12.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan itu!
Dialogue: 0,0:07:12.08,0:07:14.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batas usianya aman, kok.
Dialogue: 0,0:07:14.52,0:07:16.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sih!
Dialogue: 0,0:07:16.38,0:07:19.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minimal kasih tahu kalau gimnya begitu!
Dialogue: 0,0:07:19.34,0:07:22.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pamit dulu, ya.
Dialogue: 0,0:07:22.35,0:07:25.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, Aina sedang curhat soal asmara.
Dialogue: 0,0:07:25.59,0:07:26.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:07:26.70,0:07:29.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus kenapa main gim porno?
Dialogue: 0,0:07:29.09,0:07:30.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada-ada saja.
Dialogue: 0,0:07:30.32,0:07:32.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu itu gim porno!
Dialogue: 0,0:07:32.35,0:07:36.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelajari saja asmara dari gim itu.
Dialogue: 0,0:07:36.10,0:07:38.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana bisa?
Dialogue: 0,0:07:38.60,0:07:41.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, liburannya batal.
Dialogue: 0,0:07:41.68,0:07:42.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:07:42.86,0:07:46.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa sif kerjaku jadi banyak.
Dialogue: 0,0:07:46.62,0:07:49.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sif kerja?
Dialogue: 0,0:07:49.12,0:07:53.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bantu-bantu sif siang.\NBelakangan ini mereka kurang orang.
Dialogue: 0,0:07:54.29,0:07:55.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:07:59.04,0:08:01.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang berguna, kan?
Dialogue: 0,0:08:01.62,0:08:04.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajahmu menyebalkan.
Dialogue: 0,0:08:04.05,0:08:06.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan dia juga kerja sambilan.
Dialogue: 0,0:08:06.93,0:08:09.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cowok yang disukai temanmu, kan?
Dialogue: 0,0:08:09.66,0:08:13.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya aku ingin bikin sif kerjanya banyak.
Dialogue: 0,0:08:13.31,0:08:17.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aman, aku sudah punya rencana.
Dialogue: 0,0:08:17.44,0:08:19.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?\NKamu hebat!
Dialogue: 0,0:08:19.81,0:08:23.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sudah punya rencana,\Nbuat apa kita di sini?
Dialogue: 0,0:08:23.44,0:08:25.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan dipikirkan.
Dialogue: 0,0:08:25.10,0:08:26.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang.
Dialogue: 0,0:08:26.44,0:08:29.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Otoya?\NBukannya posisimu di dapur?
Dialogue: 0,0:08:29.98,0:08:32.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belakangan ini kami kurang orang.
Dialogue: 0,0:08:32.95,0:08:35.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau pesan apa?
Dialogue: 0,0:08:35.07,0:08:36.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, sebentar.
Dialogue: 0,0:08:36.79,0:08:38.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau yang ini.
Dialogue: 0,0:08:38.58,0:08:40.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku...
Dialogue: 0,0:08:40.46,0:08:42.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Otoya.
Dialogue: 0,0:08:42.22,0:08:43.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya?
Dialogue: 0,0:08:43.09,0:08:46.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Kitahara sempat mentraktirmu?
Dialogue: 0,0:08:46.34,0:08:48.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:08:48.64,0:08:49.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:08:49.98,0:08:51.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang kenapa?
Dialogue: 0,0:08:51.34,0:08:55.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya dia menang lotre.
Dialogue: 0,0:08:55.44,0:08:57.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beruntung sekali!
Dialogue: 0,0:08:57.35,0:09:00.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, aku juga turut gembira.
Dialogue: 0,0:09:00.54,0:09:03.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi masalahnya cara dia\Nmemakai hadiahnya.
Dialogue: 0,0:09:03.08,0:09:04.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya?
Dialogue: 0,0:09:04.36,0:09:07.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si bodoh itu mau menghamburkannya\Nuntuk wanita.
Dialogue: 0,0:09:07.36,0:09:08.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:09:08.86,0:09:12.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Segepok, nih.\N- Masa Kitahara sebejat itu?
Dialogue: 0,0:09:12.62,0:09:14.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak sejauh itu, sih.
Dialogue: 0,0:09:14.58,0:09:19.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bedebah itu berniat liburan sama cewek!
Dialogue: 0,0:09:19.12,0:09:23.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kitahara liburan sama cewek?\NBerduaan?
Dialogue: 0,0:09:23.38,0:09:24.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berduaan.
Dialogue: 0,0:09:25.81,0:09:27.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya agak...
Dialogue: 0,0:09:27.78,0:09:30.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tengil banget, kan?
Dialogue: 0,0:09:30.66,0:09:33.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga dia mendadak sibuk biar batal pergi!
Dialogue: 0,0:09:33.57,0:09:35.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu, sih...
Dialogue: 0,0:09:35.41,0:09:37.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, aku pesan peperoncino!
Dialogue: 0,0:09:37.77,0:09:42.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuharap ada yang bikin sif dia menumpuk.
Dialogue: 0,0:09:43.10,0:09:44.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian bahas apa?
Dialogue: 0,0:09:47.15,0:09:50.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si bodoh mau liburan bareng cewek?
Dialogue: 0,0:09:55.53,0:09:57.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?
Dialogue: 0,0:09:57.73,0:10:00.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kebanyakan kerja.
Dialogue: 0,0:10:00.18,0:10:01.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu dirundung?
Dialogue: 0,0:10:01.79,0:10:04.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu sudah biasa.
Dialogue: 0,0:10:04.10,0:10:05.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti masih, ya.
Dialogue: 0,0:10:05.79,0:10:09.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa sifku jadi menumpuk.
Dialogue: 0,0:10:09.92,0:10:11.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terutama di akhir pekan.
Dialogue: 0,0:10:11.89,0:10:13.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, benarkah?
Dialogue: 0,0:10:13.68,0:10:15.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok kamu senang?
Dialogue: 0,0:10:15.62,0:10:17.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kok.
Dialogue: 0,0:10:17.68,0:10:21.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asyik, tiba-tiba rencanaku berhasil.
Dialogue: 0,0:10:21.43,0:10:24.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal ada kuliah,\Nrepot juga kalau tidak ada libur.
Dialogue: 0,0:10:24.69,0:10:28.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untungnya minggu depan tokonya renovasi.
Dialogue: 0,0:10:28.27,0:10:30.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma perlu sabar.
Dialogue: 0,0:10:33.52,0:10:35.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baguslah, Iori.
Dialogue: 0,0:10:35.60,0:10:36.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:10:37.58,0:10:39.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu ceritanya.
Dialogue: 0,0:10:39.73,0:10:41.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:10:41.95,0:10:44.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku gagal total.
Dialogue: 0,0:10:44.46,0:10:45.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sih.
Dialogue: 0,0:10:46.40,0:10:49.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kamu juga liburan?
Dialogue: 0,0:10:49.89,0:10:50.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lah?
Dialogue: 0,0:10:50.46,0:10:56.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Liburan ke Okinawa buat menyelam itu wajar,\Ndan bisa saja kalian bertemu di sana.
Dialogue: 0,0:10:56.53,0:10:58.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu punya tabungan, kan?
Dialogue: 0,0:10:58.47,0:10:59.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ide bagus!
Dialogue: 0,0:10:59.85,0:11:02.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih!\NAkan kulakukan!
Dialogue: 0,0:11:02.56,0:11:03.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat, ya.
Dialogue: 0,0:11:04.27,0:11:06.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau pergi sendirian?
Dialogue: 0,0:11:06.08,0:11:09.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku mau mengajak Kouhei\Nmumpung menyelam.
Dialogue: 0,0:11:09.74,0:11:10.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:11:10.61,0:11:13.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau siap-siap dulu, dadah!
Dialogue: 0,0:11:16.56,0:11:22.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, Aina juga liburan berdua\Nsama cowok, dong?
Dialogue: 0,0:11:26.00,0:11:29.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita datang lagi ke Okinawa!
Dialogue: 0,0:11:29.38,0:11:32.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuacanya bagus, ya, Chisa?
Dialogue: 0,0:11:32.14,0:11:33.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:11:33.26,0:11:35.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana semangatnya?
Dialogue: 0,0:11:35.46,0:11:37.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya juga begini.
Dialogue: 0,0:11:37.01,0:11:40.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan murung cuma karena tidak bisa\Nmenyelam di hari pertama...
Dialogue: 0,0:11:42.51,0:11:43.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:11:43.39,0:11:46.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kelihatan gugup.
Dialogue: 0,0:11:46.11,0:11:48.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Mana ada?
Dialogue: 0,0:11:48.69,0:11:51.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baguslah kalau tidak.
Dialogue: 0,0:11:51.81,0:11:53.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini jalan-jalan pakai mobil rental?
Dialogue: 0,0:11:53.92,0:11:55.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, tolong kemudikan, ya.
Dialogue: 0,0:11:55.90,0:11:59.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau minum alkohol, kan?\NSilakan saja, sih.
Dialogue: 0,0:11:59.57,0:12:02.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kamu yakin tidak memilih Miyako?
Dialogue: 0,0:12:02.16,0:12:05.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku suka pulau utama juga, kok.
Dialogue: 0,0:12:05.01,0:12:06.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:12:08.54,0:12:10.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita ke mana dulu?
Dialogue: 0,0:12:10.38,0:12:13.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari susuri garis pantai.
Dialogue: 0,0:12:13.05,0:12:17.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, ayo menyelam tiap ada\Npantai yang indah!
Dialogue: 0,0:12:19.05,0:12:20.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh juga!
Dialogue: 0,0:12:20.51,0:12:22.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedengaran seru, kan?
Dialogue: 0,0:12:22.54,0:12:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo berangkat!
Dialogue: 0,0:12:28.06,0:12:31.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru dapat resep kari yang enak.
Dialogue: 0,0:12:31.79,0:12:34.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang pakai tiga jenis bumbu?
Dialogue: 0,0:12:34.32,0:12:36.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, yang itu!
Dialogue: 0,0:12:36.19,0:12:38.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga penasaran sama itu.
Dialogue: 0,0:12:38.20,0:12:40.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita buat akhir pekan depan.
Dialogue: 0,0:12:42.74,0:12:44.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, belok kanan di depan.
Dialogue: 0,0:12:44.82,0:12:47.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm? Ada yang mau kamu kunjungi?
Dialogue: 0,0:12:51.71,0:12:53.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pas buat berkendara.
Dialogue: 0,0:12:53.98,0:12:55.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:12:55.42,0:12:57.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi belum jam makan siang, lo.
Dialogue: 0,0:12:57.59,0:12:59.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini mah hitungannya camilan.
Dialogue: 0,0:12:59.97,0:13:00.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh.
Dialogue: 0,0:13:00.83,0:13:01.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:13:01.82,0:13:03.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaca spionnya belum diatur.
Dialogue: 0,0:13:03.85,0:13:06.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kamu atur waktu mengemudi?
Dialogue: 0,0:13:06.03,0:13:07.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lupa.
Dialogue: 0,0:13:10.85,0:13:14.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Liburan begini bawaannya\Npengin makan terus, ya.
Dialogue: 0,0:13:14.36,0:13:16.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setuju.
Dialogue: 0,0:13:16.14,0:13:16.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nih.
Dialogue: 0,0:13:17.70,0:13:18.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau minum juga?
Dialogue: 0,0:13:18.70,0:13:19.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau.
Dialogue: 0,0:13:19.55,0:13:20.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:13:22.93,0:13:25.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sekitar sini suka ada gagak?
Dialogue: 0,0:13:25.12,0:13:27.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada rambu soal gagak?
Dialogue: 0,0:13:27.41,0:13:29.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, lihat mobil di depan.
Dialogue: 0,0:13:29.62,0:13:32.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengusir burung, ya.\NSudah lama tidak melihatnya.
Dialogue: 0,0:13:32.69,0:13:34.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya di daerah kita tidak ada.
Dialogue: 0,0:13:34.63,0:13:37.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di kampungku benda itu sia-sia.
Dialogue: 0,0:13:37.65,0:13:39.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya juga pegunungan.
Dialogue: 0,0:13:41.57,0:13:43.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari ponselku, toh.
Dialogue: 0,0:13:43.76,0:13:44.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:13:44.64,0:13:48.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah, tapi katanya\Nada orang mati karena aku.
Dialogue: 0,0:13:48.51,0:13:50.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Info macam apa itu?
Dialogue: 0,0:13:58.90,0:14:01.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Indah sekali!
Dialogue: 0,0:14:02.40,0:14:06.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi kangen waktu naik mobil bak.
Dialogue: 0,0:14:06.14,0:14:08.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang waktu itu, ya.
Dialogue: 0,0:14:08.16,0:14:11.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski pegawai rentalnya agak unik, sih.
Dialogue: 0,0:14:11.16,0:14:15.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai dari sini, jalannya milik pribadi.
Dialogue: 0,0:14:15.42,0:14:18.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku heran bisnisnya bisa jalan.
Dialogue: 0,0:14:18.50,0:14:21.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi naik mobil bak kayaknya seru.
Dialogue: 0,0:14:21.67,0:14:24.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok mau sewa mobil bak saja?
Dialogue: 0,0:14:24.18,0:14:25.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah, deh.
Dialogue: 0,0:14:25.79,0:14:27.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chisa, ayo ke sana.
Dialogue: 0,0:14:33.69,0:14:37.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke mana pun itu, kita ke pantai dulu!
Dialogue: 0,0:14:38.69,0:14:41.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lupa pakai baju renang.
Dialogue: 0,0:14:41.26,0:14:42.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku usahakan.
Dialogue: 0,0:14:42.61,0:14:44.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya harus.
Dialogue: 0,0:14:44.70,0:14:46.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ganti baju dulu di toilet.
Dialogue: 0,0:14:46.72,0:14:49.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti aku di mobil, jangan mengintip.
Dialogue: 0,0:14:49.20,0:14:51.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibayar pun ogah.
Dialogue: 0,0:14:57.21,0:15:01.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah sok-sokan malu,\Ndan tutupilah bagian bawah.
Dialogue: 0,0:15:01.46,0:15:04.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya juga kaget!
Dialogue: 0,0:15:04.09,0:15:06.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iori, ambilkan kotak P3K.
Dialogue: 0,0:15:06.00,0:15:08.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu terluka?
Dialogue: 0,0:15:08.10,0:15:09.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan aku.
Dialogue: 0,0:15:09.73,0:15:11.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau kutemani?
Dialogue: 0,0:15:12.48,0:15:14.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minimal pakai celana dulu.
Dialogue: 0,0:15:16.16,0:15:19.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantap!
Dialogue: 0,0:15:19.86,0:15:21.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Airnya tidak lengket, ya.
Dialogue: 0,0:15:21.86,0:15:25.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, airnya berbeda tergantung tempat.
Dialogue: 0,0:15:25.90,0:15:28.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di air dangkal pun ada banyak ikan.
Dialogue: 0,0:15:28.69,0:15:30.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau coba snorkeling?
Dialogue: 0,0:15:30.48,0:15:32.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh juga!
Dialogue: 0,0:15:32.12,0:15:33.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaki katak!
Dialogue: 0,0:15:34.12,0:15:36.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kapan kamu membelinya?
Dialogue: 0,0:15:36.13,0:15:38.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini berkat lotre.
Dialogue: 0,0:15:39.81,0:15:40.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Curang.
Dialogue: 0,0:15:40.75,0:15:43.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barangmu juga lengkap, kan?
Dialogue: 0,0:15:43.51,0:15:46.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan sampai punya baju renang.
Dialogue: 0,0:15:48.11,0:15:49.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terserah aku, lah.
Dialogue: 0,0:15:49.26,0:15:51.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, baju renang itu bagus.
Dialogue: 0,0:15:51.39,0:15:53.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan itu maksudku.
Dialogue: 0,0:15:53.92,0:15:56.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak takut air lagi?
Dialogue: 0,0:15:56.14,0:15:58.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku sudah terbiasa.
Dialogue: 0,0:15:58.83,0:16:01.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggal belajar berenang saja.
Dialogue: 0,0:16:01.18,0:16:02.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:16:02.85,0:16:05.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pandai olahraga, pasti cepat bisa.
Dialogue: 0,0:16:06.77,0:16:08.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekspresi apa itu?
Dialogue: 0,0:16:08.91,0:16:11.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya baru kali ini kamu memujiku.
Dialogue: 0,0:16:11.81,0:16:15.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya tindakanmu biasanya tidak terpuji.
Dialogue: 0,0:16:15.16,0:16:17.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan ini bukan yang pertama...
Dialogue: 0,0:16:19.22,0:16:22.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bersyukur ada kamu.
Dialogue: 0,0:16:25.80,0:16:27.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:16:27.04,0:16:28.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan apa-apa.
Dialogue: 0,0:16:28.77,0:16:29.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,
Dialogue: 0,0:16:30.24,0:16:32.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mau kuajari berenang?
Dialogue: 0,0:16:32.16,0:16:33.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu yakin?
Dialogue: 0,0:16:33.90,0:16:35.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pun kalau kamu mau.
Dialogue: 0,0:16:36.88,0:16:38.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas mau, lah!
Dialogue: 0,0:17:12.19,0:17:14.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, seru banget.
Dialogue: 0,0:17:14.24,0:17:15.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:17:15.14,0:17:17.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada pesan masuk lagi.
Dialogue: 0,0:17:17.68,0:17:19.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin urusan penting.
Dialogue: 0,0:17:21.46,0:17:23.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah, tapi kayaknya bukan.
Dialogue: 0,0:17:23.90,0:17:27.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baguslah.\NKita makan malam pakai mobil?
Dialogue: 0,0:17:27.90,0:17:31.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku sudah pesan izakaya\Nyang ada pertunjukan sanshin-nya.
Dialogue: 0,0:17:31.94,0:17:33.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, sepertinya menarik.
Dialogue: 0,0:17:33.91,0:17:37.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan habis minum-minum,\Nkita pulang pakai sopir.
Dialogue: 0,0:17:37.68,0:17:38.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:17:40.91,0:17:42.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersulang!
Dialogue: 0,0:17:42.92,0:17:45.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bir wajib di Okinawa!
Dialogue: 0,0:17:45.46,0:17:47.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ringan dan mudah diminum.
Dialogue: 0,0:17:48.90,0:17:51.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bir tropis memang mantap.
Dialogue: 0,0:17:51.55,0:17:55.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini anggur laut, tahu jimami,\Ndan somen tumis.
Dialogue: 0,0:17:57.55,0:17:59.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatan enak.
Dialogue: 0,0:17:59.06,0:18:03.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini cocok pakai koregusu.
Dialogue: 0,0:18:03.56,0:18:05.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga coba, ah.
Dialogue: 0,0:18:05.42,0:18:07.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh, tapi hati-hati.
Dialogue: 0,0:18:07.23,0:18:07.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:18:07.94,0:18:11.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu cabai yang direndam alkohol.
Dialogue: 0,0:18:11.34,0:18:12.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa bikin mabuk.
Dialogue: 0,0:18:12.45,0:18:15.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang Pab pasti suka bumbu ini.
Dialogue: 0,0:18:16.96,0:18:19.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertunjukan sanshin-nya akan dimulai.
Dialogue: 0,0:18:24.96,0:18:26.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat ini bagus.
Dialogue: 0,0:18:26.22,0:18:27.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:18:27.74,0:18:30.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan katanya suka ada artis berkunjung.
Dialogue: 0,0:18:30.77,0:18:32.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Oh.\N- Konsernya sukses!
Dialogue: 0,0:18:32.11,0:18:33.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Betul juga.\N- Kerja bagus!
Dialogue: 0,0:18:33.72,0:18:36.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus!\NAyo minum sepuasnya!
Dialogue: 0,0:18:36.27,0:18:37.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditraktir?
Dialogue: 0,0:18:37.18,0:18:38.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Patungan, dong!
Dialogue: 0,0:18:38.72,0:18:40.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul juga?
Dialogue: 0,0:18:40.59,0:18:41.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lupakan saja.
Dialogue: 0,0:18:43.41,0:18:47.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para tamu, mari menari Kachaashi!
Dialogue: 0,0:18:47.23,0:18:49.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo ikut, Chisa!
Dialogue: 0,0:18:49.17,0:18:50.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mau.
Dialogue: 0,0:18:50.48,0:18:53.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak pandai menari, ya?
Dialogue: 0,0:18:53.15,0:18:55.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang gantian, biar kuajari menari.
Dialogue: 0,0:18:55.28,0:18:57.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan itu masalahnya.
Dialogue: 0,0:18:57.49,0:18:59.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Angkat tangan kalian!
Dialogue: 0,0:18:59.47,0:19:01.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayunkan ke kanan dan kiri!
Dialogue: 0,0:19:01.04,0:19:04.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yay, yay!
Dialogue: 0,0:19:18.26,0:19:20.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertemu orang baru\Ndi tempat baru lumayan seru.
Dialogue: 0,0:19:20.99,0:19:22.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa?
Dialogue: 0,0:19:22.52,0:19:25.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada unek-unek\Ntinggal lupakan dengan minum.
Dialogue: 0,0:19:25.63,0:19:28.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kurang setuju soal itu.
Dialogue: 0,0:19:28.52,0:19:31.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya besok bisa menyelam.
Dialogue: 0,0:19:31.78,0:19:35.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kita harus tidur cepat malam ini.
Dialogue: 0,0:19:35.28,0:19:37.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahunya karena antusias\Nmalah susah tidur.
Dialogue: 0,0:19:37.65,0:19:39.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana ada.
Dialogue: 0,0:19:45.46,0:19:46.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang...
Dialogue: 0,0:19:46.69,0:19:50.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu, aku sudah pesan twin room.
Dialogue: 0,0:19:50.17,0:19:53.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, kami dapat double room.
Dialogue: 0,0:19:53.92,0:19:56.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa tukar ke twin room?
Dialogue: 0,0:19:56.93,0:19:58.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Twin room?
Dialogue: 0,0:19:58.68,0:20:01.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tidak punya yang seperti itu.
Dialogue: 0,0:20:01.47,0:20:02.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajahnya tidak asing!
Dialogue: 0,0:20:02.93,0:20:04.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu...
Dialogue: 0,0:20:04.94,0:20:07.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Adakah kamar yang ranjangnya dua?
Dialogue: 0,0:20:08.43,0:20:10.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, maksudnya itu.
Dialogue: 0,0:20:10.22,0:20:12.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau kami pesan satu lagi kamar murah.
Dialogue: 0,0:20:12.45,0:20:14.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harga bukan masalah.
Dialogue: 0,0:20:14.19,0:20:17.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua kamar penuh, jadi tidak bisa.
Dialogue: 0,0:20:17.01,0:20:18.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman!
Dialogue: 0,0:20:18.95,0:20:22.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau pasangan, satu ranjang cukup, kan?
Dialogue: 0,0:20:22.19,0:20:23.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasang...
Dialogue: 0,0:20:23.20,0:20:25.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pencemaran nama baik, tolong ralat.
Dialogue: 0,0:20:25.58,0:20:27.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami bukan pasangan.
Dialogue: 0,0:20:27.65,0:20:29.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:20:29.06,0:20:31.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teman tapi mesra, ya?
Dialogue: 0,0:20:32.34,0:20:34.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan paman itu...
Dialogue: 0,0:20:34.09,0:20:38.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya dia punya banyak usaha\Ndengan pelayanan itu.
Dialogue: 0,0:20:38.09,0:20:40.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, apa boleh buat.
Dialogue: 0,0:20:40.06,0:20:40.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:20:40.84,0:20:43.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali kamu harus tidur di luar.
Dialogue: 0,0:20:43.66,0:20:45.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Sejak kapan jadi begitu?
Dialogue: 0,0:20:46.45,0:20:49.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau di bak mandi juga boleh.
Dialogue: 0,0:20:49.48,0:20:51.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di kedua ujung kasurnya bisa, kan?
Dialogue: 0,0:20:51.71,0:20:54.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian kita pernah tidur bertindihan.
Dialogue: 0,0:20:54.96,0:20:57.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu cuma kecelakaan.
Dialogue: 0,0:20:57.38,0:21:01.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kita kepergok Nanaka\Ndan hampir dipaksa menikah.
Dialogue: 0,0:21:01.36,0:21:03.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakitnya cukup tahan lama.
Dialogue: 0,0:21:03.81,0:21:05.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf soal itu.
Dialogue: 0,0:21:05.37,0:21:08.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kali ini tidak akan sakit, kok.
Dialogue: 0,0:21:09.23,0:21:10.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luas banget.
Dialogue: 0,0:21:10.54,0:21:12.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini saja, ya.
Dialogue: 0,0:21:12.74,0:21:13.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip!
Dialogue: 0,0:21:14.19,0:21:16.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mandilah duluan.
Dialogue: 0,0:21:16.11,0:21:17.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bicara begitu...
Dialogue: 0,0:21:25.78,0:21:26.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kuangkat.
Dialogue: 0,0:21:29.07,0:21:30.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:21:30.39,0:21:32.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya kamar sebelah kosong.
Dialogue: 0,0:21:32.90,0:21:35.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi aku akan pindah.
Dialogue: 0,0:21:35.65,0:21:37.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:21:37.15,0:21:38.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kesepian?
Dialogue: 0,0:21:38.65,0:21:40.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas tidak!
Dialogue: 0,0:21:42.66,0:21:44.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pagi.
Dialogue: 0,0:21:44.00,0:21:46.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pagi, kita dijemput orang toko?
Dialogue: 0,0:21:46.66,0:21:49.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak minta,\Nkita ke sana pakai mobil.
Dialogue: 0,0:21:50.98,0:21:53.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemarin aku tidak sadar karena mabuk,
Dialogue: 0,0:21:54.05,0:21:56.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ternyata ini kawasan hotel cinta.
Dialogue: 0,0:21:56.05,0:21:57.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, banyak papan iklan.
Dialogue: 0,0:21:57.92,0:22:01.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinan orang-orang yang keluar\Nbaru kelar begituan.
Dialogue: 0,0:22:01.93,0:22:03.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan dibahas.
Dialogue: 0,0:22:03.17,0:22:04.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:22:04.55,0:22:07.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita ke mobil.
