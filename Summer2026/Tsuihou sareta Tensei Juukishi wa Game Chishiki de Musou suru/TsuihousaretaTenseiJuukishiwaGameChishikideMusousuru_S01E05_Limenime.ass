Dialogue: 0,0:00:07.32,0:00:08.91,sign,,0000,0000,0000,,SKILL BOOK: BUKU KEMAMPUAN
Dialogue: 0,0:00:08.91,0:00:10.16,sign,,0000,0000,0000,,TARING BARA KEGILAAN
Dialogue: 0,0:00:23.59,0:00:24.67,sign,,0000,0000,0000,,SISA SKILL POINT: 5
Dialogue: 0,0:00:24.67,0:00:25.84,sign,,0000,0000,0000,,IKRAR ZIRAH BERAT
Dialogue: 0,0:01:16.68,0:01:19.35,sign,,0000,0000,0000,,KESATRIA KELAS BERAT TEREINKARNASI YANG DIASINGKAN\NJADI TANPA TANDING DENGAN PENGETAHUAN GIMNYA
Dialogue: 0,0:02:31.01,0:02:35.51,sign,,0000,0000,0000,,EPISODE 5: TARING BARA KEGILAAN
Dialogue: 0,0:08:45.34,0:08:48.17,sign,,0000,0000,0000,,ILMU PANAH DASAR, HARGA PASAR: 2 JUTA G
Dialogue: 0,0:09:45.27,0:09:48.07,sign,,0000,0000,0000,,UANG DI TANGAN SEKITAR 900 RIBU GOLD
Dialogue: 0,0:13:20.11,0:13:21.91,sign,,0000,0000,0000,,SIP
Dialogue: 0,0:13:21.91,0:13:24.45,sign,,0000,0000,0000,,RAWR! UWAH!
Dialogue: 0,0:13:26.87,0:13:27.91,sign,,0000,0000,0000,,TIDAK BISA
Dialogue: 0,0:13:28.45,0:13:31.08,sign,,0000,0000,0000,,HMPH! GUBRAK, GUBRAK, GUBRAK
Dialogue: 0,0:13:31.08,0:13:32.42,sign,,0000,0000,0000,,HMPH!
Dialogue: 0,0:13:35.04,0:13:36.09,sign,,0000,0000,0000,,TIDAK BISA
Dialogue: 0,0:13:36.09,0:13:41.51,sign,,0000,0000,0000,,ILMU PEDANG DASAR - SKILL SERANGAN
Dialogue: 0,0:13:48.10,0:13:48.81,sign,,0000,0000,0000,,ILMU PEDANG DASAR - SKILL SERANGAN
Dialogue: 0,0:13:51.77,0:13:52.60,sign,,0000,0000,0000,,TIDAK BISA
Dialogue: 0,0:15:06.34,0:15:09.81,sign,,0000,0000,0000,,CUEK
Dialogue: 0,0:17:51.09,0:17:51.43,sign,,0000,0000,0000,,TEKAN UNTUK MEMULAI
Dialogue: 0,0:00:00.40,0:00:03.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu, mau gabung enggak\Nsama lini depan yang jago ini?
Dialogue: 0,0:00:03.32,0:00:05.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benaran kuat, tidak?
Dialogue: 0,0:00:07.32,0:00:10.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill Book Taring Bara Kegilaan.
Dialogue: 0,0:00:10.16,0:00:15.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill Book adalah item yang diperlukan\Nuntuk mempelajari Skill Tree.
Dialogue: 0,0:00:15.58,0:00:19.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu item yang berharga,\Nsulit dapat dengan cepat.
Dialogue: 0,0:00:19.58,0:00:22.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi mencoba cari itu tidak dipungut biaya!
Dialogue: 0,0:00:23.59,0:00:27.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikrar Zirah Berat dan Taring Bara Kegilaan.
Dialogue: 0,0:00:27.84,0:00:30.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedua skill ini akan bersinergi
Dialogue: 0,0:00:30.18,0:00:32.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}barulah Kesatria Kelas Berat jadi sempurna.
Dialogue: 0,0:00:34.10,0:00:38.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesatria Kelas Berat yang sudah sempurna\Nbukanlah kelas ahli pertahanan lagi.
Dialogue: 0,0:00:38.77,0:00:41.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Disebut kelas ahli serangan\Njuga masih kurang tepat.
Dialogue: 0,0:00:41.85,0:00:45.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wujudnya itu benar-benar\Nseperti senjata manusia.
Dialogue: 0,0:00:46.36,0:00:48.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taring Bara Kegilaan.
Dialogue: 0,0:00:48.53,0:00:53.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu item terpenting Kesatria Kelas Berat\Nuntuk menunjukkan kekuatan sejatinya.
Dialogue: 0,0:02:58.87,0:03:00.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan boros-boros.
Dialogue: 0,0:03:00.08,0:03:01.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu.
Dialogue: 0,0:03:01.62,0:03:03.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Ayah!
Dialogue: 0,0:03:03.33,0:03:08.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Item penting Kesatria Kelas Berat,\NSkill Book Taring Bara Kegilaan.
Dialogue: 0,0:03:08.63,0:03:12.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bakal untung kalau bisa\Nmenemukannya di kota ini.
Dialogue: 0,0:03:37.53,0:03:38.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:03:39.16,0:03:41.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau beli tiga ramuan penyembuh.
Dialogue: 0,0:03:41.28,0:03:42.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, baik.
Dialogue: 0,0:03:42.41,0:03:44.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Totalnya 72 ribu Gold.
Dialogue: 0,0:03:46.16,0:03:49.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harganya jauh lebih mahal\Ndari saat masih gim dulu.
Dialogue: 0,0:03:50.17,0:03:53.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, nyawa tidak boleh\Nkujadikan taruhan.
Dialogue: 0,0:03:53.67,0:03:55.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:03:57.09,0:03:59.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, aku ingin tanya sesuatu.
Dialogue: 0,0:04:00.39,0:04:02.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana aku bisa beli Skill Book?
Dialogue: 0,0:04:04.89,0:04:08.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah mencari ke segala toko,\Ntapi tidak menemukannya.
Dialogue: 0,0:04:08.90,0:04:12.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai Kesatria Kelas Berat\Nmendapat Taring Bara Kegilaan,
Dialogue: 0,0:04:12.61,0:04:14.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa dibilang masih dalam tutorial.
Dialogue: 0,0:04:14.40,0:04:16.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Karena belum bisa apa-apa tanpanya.\N- Dapat!
Dialogue: 0,0:04:16.39,0:04:20.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan ini tidak tahu apa-apa, ya?
Dialogue: 0,0:04:20.11,0:04:24.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau Anda pemula tahun pertama\Nyang baru saja mendapat kelas?
Dialogue: 0,0:04:24.83,0:04:26.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, benar.
Dialogue: 0,0:04:26.83,0:04:30.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jual beli Skill Book itu dilarang.
Dialogue: 0,0:04:31.67,0:04:35.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang mendapatkannya\Nmemang boleh menggunakannya sendiri.
Dialogue: 0,0:04:35.84,0:04:37.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau selain itu
Dialogue: 0,0:04:37.01,0:04:41.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan dibeli serikat petualang,\Nlalu diserahkan ke bangsawan dan gereja.
Dialogue: 0,0:04:41.84,0:04:44.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak mungkin!
Dialogue: 0,0:04:45.08,0:04:49.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada dasarnya, Skill Book hanya jatuh\Ndengan peluang sangat kecil.
Dialogue: 0,0:04:49.06,0:04:50.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuannya memang dijual beli.
Dialogue: 0,0:04:50.60,0:04:55.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang diincar memang tidak\Nsemudah itu didapatkan sendiri.
Dialogue: 0,0:04:55.11,0:04:59.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terasa kalau kuasa bangsawan jadi\Nlebih kuat dibanding dalam gim.
Dialogue: 0,0:04:59.78,0:05:01.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tetap saja!
Dialogue: 0,0:05:01.74,0:05:05.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka bakal jadi begini!
Dialogue: 0,0:05:05.74,0:05:10.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti Skill Book yang dikumpulkan\Ndari kota Rondalm ini
Dialogue: 0,0:05:10.25,0:05:14.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}besar kemungkinan dikuasai sendiri\Nkeluarga Edvaughn tempatku berasal.
Dialogue: 0,0:05:17.71,0:05:19.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat.
Dialogue: 0,0:05:19.84,0:05:23.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya dilarang keras\Nuntuk memberi tahu ini sembarangan,
Dialogue: 0,0:05:23.01,0:05:24.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kali ini khusus.
Dialogue: 0,0:05:24.85,0:05:27.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggap saja bonus dari ramuan penyembuh.
Dialogue: 0,0:05:30.77,0:05:33.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan, Anda bisa ke sini.
Dialogue: 0,0:05:35.61,0:05:37.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini apa?
Dialogue: 0,0:05:39.07,0:05:42.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toko yang menjual item\Ndari para penjarah.
Dialogue: 0,0:05:42.07,0:05:43.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjarah?
Dialogue: 0,0:05:43.41,0:05:45.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjarah dari mayat petualang, ya?
Dialogue: 0,0:05:46.33,0:05:47.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah seharusnya
Dialogue: 0,0:05:47.91,0:05:53.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}barang peninggalan seperti itu\Ndilaporkan ke serikat petualang?
Dialogue: 0,0:05:53.46,0:05:56.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu ada kesepakatan tidak tertulis.
Dialogue: 0,0:05:56.00,0:06:00.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serikat sendiri juga tahu keberadaan\Ntoko ilegal seperti ini dan membiarkannya.
Dialogue: 0,0:06:01.34,0:06:05.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada juga petualang yang tidak bisa hidup\Nkalau tidak jadi penjarah.
Dialogue: 0,0:06:05.85,0:06:08.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu,\Nmeski diurus sebagaimana mestinya,
Dialogue: 0,0:06:08.85,0:06:11.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak akan kembali ke keluarga mendiang
Dialogue: 0,0:06:11.02,0:06:14.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan sebagian besar akan masuk\Nke kantong para bangsawan.
Dialogue: 0,0:06:15.15,0:06:16.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill Book pun sama.
Dialogue: 0,0:06:16.86,0:06:21.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diborong murah oleh para bangsawan\Ndan ditimbun tanpa pernah dipakai.
Dialogue: 0,0:06:21.32,0:06:24.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa peduli kesusahan para petualang.
Dialogue: 0,0:06:27.62,0:06:30.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku benar-benar buta\Nakan dunia luar.
Dialogue: 0,0:06:31.54,0:06:33.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau saja ingatanku tidak kembali
Dialogue: 0,0:06:33.96,0:06:36.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu jadi Pedang Suci\Nsebagaimana mestinya, aku juga...
Dialogue: 0,0:06:36.83,0:06:41.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tolong rahasiakan toko ini\Ndari para pembesar, ya.
Dialogue: 0,0:06:41.34,0:06:43.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, tentu saja.
Dialogue: 0,0:06:47.14,0:06:49.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Aku juga salah satu dari mereka."
Dialogue: 0,0:06:49.39,0:06:53.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak akan sanggup mengatakan itu.
Dialogue: 0,0:07:08.57,0:07:10.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sekarang sudah jadi sobat!
Dialogue: 0,0:07:10.20,0:07:11.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ada kelas pengguna sihir!
Dialogue: 0,0:08:01.09,0:08:04.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa benar di tempat seperti ini\Nada Skill Book?
Dialogue: 0,0:08:09.51,0:08:10.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada!
Dialogue: 0,0:08:10.51,0:08:12.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lima buku pula!
Dialogue: 0,0:08:12.97,0:08:14.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlengkapanmu lemah sekali.
Dialogue: 0,0:08:17.18,0:08:23.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aula Buku Sihir Rusak ini bukanlah tempat\Nuntuk didatangi pemula sepertimu.
Dialogue: 0,0:08:24.61,0:08:26.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, kalau masalah uang, aku punya.
Dialogue: 0,0:08:26.86,0:08:29.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh aku lihat Skill Book itu?
Dialogue: 0,0:08:29.28,0:08:31.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bebas saja kalau mau lihat-lihat.
Dialogue: 0,0:08:31.37,0:08:35.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harganya tidak akan berubah\Nmeski bekas disentuh bocah.
Dialogue: 0,0:08:36.75,0:08:38.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:08:42.84,0:08:45.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill Book Ilmu Panah Dasar,
Dialogue: 0,0:08:45.34,0:08:48.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harga pasar: 2 juta Gold.
Dialogue: 0,0:08:48.17,0:08:50.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Du-Dua juta Gold?
Dialogue: 0,0:08:50.34,0:08:53.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harganya naik 500 ribu Gold dari gim!
Dialogue: 0,0:08:53.93,0:09:00.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harga pasar saat di gim seharusnya dihitung\Ndari riwayat transaksi antarpemain.
Dialogue: 0,0:09:00.10,0:09:06.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harga ini kemungkinan diambil\Ndari transaksi yang sebenarnya.
Dialogue: 0,0:09:06.03,0:09:12.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harga Skill Book meroket\Nkarena dimonopoli bangsawan, ya?
Dialogue: 0,0:09:12.03,0:09:16.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuberi tahu saja, di sini\Nbuku itu kujual tiga juta Gold.
Dialogue: 0,0:09:16.24,0:09:18.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tiga juta?
Dialogue: 0,0:09:18.50,0:09:19.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu harga wajar.
Dialogue: 0,0:09:19.79,0:09:22.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sendiri juga ambil risiko di sini.
Dialogue: 0,0:09:22.58,0:09:26.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pejabat memang pura-pura tidak tahu,
Dialogue: 0,0:09:26.46,0:09:30.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kalau yang lebih tinggi sampai tahu,\Naku bisa saja dipenggal.
Dialogue: 0,0:09:36.76,0:09:41.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill Tree Dasar saja harganya\Nsudah semahal ini.
Dialogue: 0,0:09:42.23,0:09:45.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan kalau Tameng Setan Gila\Nberhasil kujual,
Dialogue: 0,0:09:45.27,0:09:48.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}totalnya aku cuma punya tiga juta Gold.
Dialogue: 0,0:09:48.57,0:09:50.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa dibilang banyak,
Dialogue: 0,0:09:50.03,0:09:53.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi tidak cukup\Nuntuk beli Skill Book langka.
Dialogue: 0,0:10:00.08,0:10:03.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ilmu Panah Dasar, Peningkat Daya Sihir,
Dialogue: 0,0:10:03.46,0:10:06.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kotak Kejutan, Elemental Guard.
Dialogue: 0,0:10:07.09,0:10:09.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini memang ada item\Nyang lumayan langka,
Dialogue: 0,0:10:09.84,0:10:12.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi yang kucari tidak ada, ya.
Dialogue: 0,0:10:12.55,0:10:14.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buku yang terakhir...
Dialogue: 0,0:10:23.89,0:10:25.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada!
Dialogue: 0,0:10:27.36,0:10:31.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill Tree penting Kesatria Kelas Berat,\NTaring Bara Kegilaan!
Dialogue: 0,0:10:31.28,0:10:34.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal bisa mendapatkan ini,\Nsemua akan mudah!
Dialogue: 0,0:10:34.11,0:10:37.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?\NSampai bermuka senang begitu.
Dialogue: 0,0:10:38.41,0:10:41.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai menginginkan benda seperti itu,\Nkamu ini benar-benar aneh.
Dialogue: 0,0:10:41.87,0:10:43.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Nyonya, ini berapa harganya?
Dialogue: 0,0:10:43.79,0:10:45.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh...
Dialogue: 0,0:10:45.83,0:10:49.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kujual 50 juta Gold.
Dialogue: 0,0:11:00.22,0:11:04.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya memajang benda semahal ini\Ntanpa menaruh penjaga.
Dialogue: 0,0:11:05.31,0:11:08.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menurutmu aku lemah,\Nbagaimana kalau diadu dulu?
Dialogue: 0,0:11:08.94,0:11:11.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempo hari aku baru menghajar lima orang.
Dialogue: 0,0:11:21.29,0:11:25.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa tidak kalau Skill Book ini\Ndisimpan dulu jangan dijual?
Dialogue: 0,0:11:26.17,0:11:29.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti kembali lagi\Ndengan menyiapkan 50 Juta Gold!
Dialogue: 0,0:11:37.76,0:11:41.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang apa untungnya buatku?
Dialogue: 0,0:11:42.35,0:11:44.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal itu...
Dialogue: 0,0:11:44.93,0:11:48.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lumayan suka bocah sepertimu.
Dialogue: 0,0:11:50.65,0:11:53.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh saja, akan kusimpan untukmu.
Dialogue: 0,0:11:53.82,0:11:55.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:11:55.24,0:11:56.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:11:58.82,0:12:01.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dengan tambahan lima juta Gold.
Dialogue: 0,0:12:02.58,0:12:05.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jiwa bisnisnya ngeri sekali!
Dialogue: 0,0:12:10.58,0:12:15.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya untuk sementara waktu\Naku harus putar otak cari uang.
Dialogue: 0,0:12:21.30,0:12:23.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana orang yang kemarin?
Dialogue: 0,0:12:23.88,0:12:25.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin sama dia lagi.
Dialogue: 0,0:12:25.77,0:12:28.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, masih bocah!
Dialogue: 0,0:12:28.98,0:12:29.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan dipikirkan.
Dialogue: 0,0:12:29.85,0:12:31.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baju ini coba kupadukan sendiri.
Dialogue: 0,0:12:31.73,0:12:34.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, imut sekali!
Dialogue: 0,0:12:41.91,0:12:44.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}55 juta Gold, ya?
Dialogue: 0,0:12:44.45,0:12:48.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harganya setara 60 kali raid kemarin.
Dialogue: 0,0:12:49.46,0:12:53.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petualang tingkat tinggi\Ndan pemilik toko yang melayani mereka
Dialogue: 0,0:12:53.48,0:12:56.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}standar harganya benaran rusak.
Dialogue: 0,0:12:56.88,0:13:00.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taring Bara Kegilaan\Nmemang Skill Tree langka.
Dialogue: 0,0:13:00.72,0:13:03.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, yang menginginkannya\Ncuma Kesatria Kelas Berat
Dialogue: 0,0:13:03.39,0:13:07.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau penggila pertarungan yang ingin mati.
Dialogue: 0,0:13:08.10,0:13:13.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill Book yang lebih kuat dan mudah\Ndimengerti pasti jauh lebih mahal.
Dialogue: 0,0:13:13.65,0:13:17.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang aku harus memikirkan\Ndengan detail caranya cari uang.
Dialogue: 0,0:13:17.82,0:13:20.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa saja mengincar drop langka di dungeon
Dialogue: 0,0:13:20.11,0:13:21.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar kaya dalam sekejap.
Dialogue: 0,0:13:21.91,0:13:24.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Kesatria Kelas Berat
Dialogue: 0,0:13:24.45,0:13:26.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kekurangan skill serangan\Ndengan dampak yang konsisten.
Dialogue: 0,0:13:28.45,0:13:31.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berburu keroco memakai Tolakan Tembok Benteng?
Dialogue: 0,0:13:32.42,0:13:35.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakal makan terlalu banyak waktu.
Dialogue: 0,0:13:36.09,0:13:38.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengembangkan Ilmu Pedang Dasar
Dialogue: 0,0:13:38.05,0:13:41.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau mempelajari Skill Book lain?
Dialogue: 0,0:13:42.01,0:13:43.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:13:43.14,0:13:47.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu dapat Taring Bara Kegilaan,\Nsemua skill itu tidak akan kugunakan lagi.
Dialogue: 0,0:13:48.81,0:13:51.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebisa mungkin aku tidak mau\Nmenyia-nyiakan poin skill.
Dialogue: 0,0:14:00.90,0:14:03.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reputasi Kesatria Kelas Berat memang ampas,
Dialogue: 0,0:14:03.91,0:14:06.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi namaku pasti cukup terkenal\Ndari raid kemarin.
Dialogue: 0,0:14:06.87,0:14:10.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bekerja sama dengan petualang lain,\Nopsi strategiku akan tambah luas.
Dialogue: 0,0:14:11.54,0:14:13.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rekan...
Dialogue: 0,0:14:16.00,0:14:20.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bi-Biar aku yang menghadapinya!\NKamu larilah selagi sempat!
Dialogue: 0,0:14:29.97,0:14:33.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian semua mau meragukan Elymas?
Dialogue: 0,0:14:33.02,0:14:38.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sama saja menghinaku\Nyang sudah mengakuinya naik kelas!
Dialogue: 0,0:14:38.65,0:14:41.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kucoba cari rekan.
Dialogue: 0,0:14:42.03,0:14:48.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka bakal dapat drop\NPedang Berlumur Darah.
Dialogue: 0,0:14:49.41,0:14:52.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harga pasarannya dua juta Gold!
Dialogue: 0,0:14:52.41,0:14:55.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk sementara waktu kita bisa\Nhidup santai dengan ini!
Dialogue: 0,0:15:00.63,0:15:03.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kubilang,\Nini berkat skill milikku!
Dialogue: 0,0:15:03.72,0:15:05.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill milikku!
Dialogue: 0,0:15:12.10,0:15:17.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa kubilang,\Nbenaran ada efeknya, kan?
Dialogue: 0,0:15:17.94,0:15:21.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Grup berisi Pendekar Pedang,\NBandit, dan Badut, ya?
Dialogue: 0,0:15:22.94,0:15:25.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkatmu, ya?
Dialogue: 0,0:15:26.95,0:15:31.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini drop langka yang muncul setelah\Nberulang kali masuk dungeon.
Dialogue: 0,0:15:31.70,0:15:36.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ragu kalau ini benaran\Nberkat skill milikmu.
Dialogue: 0,0:15:36.71,0:15:40.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, benar juga.
Dialogue: 0,0:15:40.04,0:15:41.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Tapi...
Dialogue: 0,0:15:41.42,0:15:46.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terus berkeliling\Npasti kelihatan bedanya!
Dialogue: 0,0:15:46.26,0:15:48.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru akan terasa, mulai dari sini!
Dialogue: 0,0:15:48.18,0:15:50.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche, jangan-jangan kamu...
Dialogue: 0,0:15:50.39,0:15:51.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:15:53.31,0:15:59.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang lemah sepertimu berharap\Ndapat jatah dari pedang ini?
Dialogue: 0,0:16:06.53,0:16:08.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta...
Dialogue: 0,0:16:08.03,0:16:12.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku juga bertaruh nyawa di lini depan!
Dialogue: 0,0:16:12.03,0:16:14.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya seperlima...
Dialogue: 0,0:16:14.33,0:16:16.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, 200 ribu saja...
Dialogue: 0,0:16:16.29,0:16:20.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}100 ribu! Dibagi 100 ribu Gold saja\Naku sudah senang!
Dialogue: 0,0:16:20.25,0:16:21.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:16:21.00,0:16:22.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Canda...
Dialogue: 0,0:16:24.42,0:16:26.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar, ya.
Dialogue: 0,0:16:26.05,0:16:29.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski bertaruh nyawa,\Nskill seranganmu tidak ada yang berarti
Dialogue: 0,0:16:29.30,0:16:34.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan cuma bisa memecah serangan\Nyang jadi masalahnya!
Dialogue: 0,0:16:35.39,0:16:38.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betulan tidak berguna, kan?
Dialogue: 0,0:16:49.66,0:16:53.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku tidak punya skill serangan...
Dialogue: 0,0:16:55.24,0:16:59.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu karena Cline menyuruhku\Nmeningkatkan Skill Tree.
Dialogue: 0,0:17:01.67,0:17:07.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu dapat uang banyak,\Nmalah bilang begitu menurutku kejam.
Dialogue: 0,0:17:08.22,0:17:10.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kejam?
Dialogue: 0,0:17:11.13,0:17:15.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kejam, ya?
Dialogue: 0,0:17:16.93,0:17:20.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sepertinya salah paham.
Dialogue: 0,0:17:21.44,0:17:27.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masalahnya jatah kami berkurang\Npadahal kamu yang tidak berguna.
Dialogue: 0,0:17:27.44,0:17:29.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian, aku cuma kasih saran sedikit,
Dialogue: 0,0:17:29.95,0:17:33.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi yang membagi poin\Nke skill tree itu kamu sendiri, kan?
Dialogue: 0,0:17:33.95,0:17:37.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus menyalahkan orang lain\Ndan tidak ikut kontribusi,
Dialogue: 0,0:17:37.95,0:17:40.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi malah minta bagian.
Dialogue: 0,0:17:40.54,0:17:42.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cline?
Dialogue: 0,0:17:42.92,0:17:47.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah membagi Skill Tree\Ndan masalah pembagian jatah, ya?
Dialogue: 0,0:17:47.46,0:17:49.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Masalah yang juga sering terjadi\N- Janjinya enggak begitu!
Dialogue: 0,0:17:49.38,0:17:51.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- di Magic World.\N- Itu salahmu sendiri!
Dialogue: 0,0:17:51.43,0:17:55.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal sudah membagi Skill Tree\Nagar sesuai dengan rekan,
Dialogue: 0,0:17:55.47,0:17:57.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi sia-sia karena situasi berubah.
Dialogue: 0,0:17:57.81,0:17:59.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya.
Dialogue: 0,0:17:59.56,0:18:00.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nih!
Dialogue: 0,0:18:02.89,0:18:04.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seratus ribu Gold.
Dialogue: 0,0:18:06.77,0:18:08.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah beres, kan?
Dialogue: 0,0:18:08.53,0:18:10.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat ambil dan enyah sana!
Dialogue: 0,0:18:11.65,0:18:17.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal sudah baik-baik menerimamu\Nyang lemah dan tidak punya skill serangan,
Dialogue: 0,0:18:17.78,0:18:21.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}malah kalap sama uang receh begini\Ndan menunjukkan muka aslimu.
Dialogue: 0,0:18:21.66,0:18:23.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, kan, Reiss?
Dialogue: 0,0:18:24.12,0:18:26.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutmu juga begitu, kan?
Dialogue: 0,0:18:29.09,0:18:31.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kamu benar.
Dialogue: 0,0:18:33.76,0:18:35.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kami juga sedang tipis,
Dialogue: 0,0:18:36.22,0:18:39.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}uang gede yang kebetulan masuk\Nsekarang harus dibagi-bagi.
Dialogue: 0,0:18:39.51,0:18:42.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukan begitu niatku!
Dialogue: 0,0:18:42.06,0:18:46.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf, Cline, Reiss!
Dialogue: 0,0:18:46.02,0:18:49.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak perlu uang dari pedang itu!
Dialogue: 0,0:18:49.52,0:18:51.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan soal maaf!
Dialogue: 0,0:18:51.94,0:18:53.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sudah tidak sanggup.
Dialogue: 0,0:18:57.45,0:19:00.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, berjuanglah di tempat baru.
Dialogue: 0,0:19:00.79,0:19:05.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku, enggak tahu bakal ada\Nyang mau tidak menerima orang
Dialogue: 0,0:19:05.33,0:19:09.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang sudah macet gara-gara salah atur skill\Ndan enggak bisa naik level.
Dialogue: 0,0:19:11.09,0:19:15.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uang memang sering dibilang\Nbisa memutus hubungan.
Dialogue: 0,0:19:15.76,0:19:19.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sistem skill point memanglah kejam.
Dialogue: 0,0:19:19.85,0:19:22.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut mekanisme sistem,
Dialogue: 0,0:19:22.02,0:19:25.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau tidak memburu monster yang setara\Natau lebih kuat dari dirimu,
Dialogue: 0,0:19:25.31,0:19:27.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan sulit menaikkan level.
Dialogue: 0,0:19:28.86,0:19:30.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar, ya.
Dialogue: 0,0:19:30.07,0:19:31.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill seranganmu tidak ada yang berarti
Dialogue: 0,0:19:31.73,0:19:36.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan cuma bisa memecah serangan\Nyang jadi masalahnya!
Dialogue: 0,0:19:36.66,0:19:38.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betulan tidak berguna, kan?
Dialogue: 0,0:19:40.37,0:19:41.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja.
Dialogue: 0,0:19:41.58,0:19:43.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau punya kombinasi skill yang buruk
Dialogue: 0,0:19:43.62,0:19:46.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kesulitan melawan monster yang setara,
Dialogue: 0,0:19:46.42,0:19:50.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tidak! Seram! Takut!\N- menaikkan level akan jadi sangat sulit.
Dialogue: 0,0:19:53.67,0:19:55.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Antara peningkatan kecepatan
Dialogue: 0,0:19:55.92,0:19:59.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau menaikkan Skill Tree\Ntipe senjata yang tidak perlu?
Dialogue: 0,0:20:00.76,0:20:03.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelasnya badut, berarti tipe pendukung, ya?
Dialogue: 0,0:20:05.56,0:20:08.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka bakal dapat drop\NPedang Berlumur Darah.
Dialogue: 0,0:20:15.32,0:20:18.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kubilang,\Nini berkat skill milikku!
Dialogue: 0,0:20:18.20,0:20:19.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill milikku!
Dialogue: 0,0:20:23.08,0:20:27.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa kubilang,\Nbenaran ada efeknya, kan?
Dialogue: 0,0:20:29.71,0:20:32.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkatmu, ya?
Dialogue: 0,0:20:33.71,0:20:38.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini drop langka yang muncul setelah\Nberulang kali masuk dungeon.
Dialogue: 0,0:20:38.34,0:20:43.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ragu kalau ini benaran\Nberkat skill milikmu.
Dialogue: 0,0:20:43.85,0:20:45.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang?
Dialogue: 0,0:20:45.77,0:20:48.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill Tree yang itu?
Dialogue: 0,0:20:48.27,0:20:52.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, mana ada yang bakal\Nmembuang orang dengan Skill Tree itu?
Dialogue: 0,0:20:52.27,0:20:54.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dari yang kudengar,\Nhanya itu kemungkinannya!
Dialogue: 0,0:20:54.94,0:21:00.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tebakanku benar,\Ndia pemilik Skill Tree yang sakti!
Dialogue: 0,0:21:02.24,0:21:04.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah minta yang tidak-tidak!
Dialogue: 0,0:21:04.62,0:21:06.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak butuh uang sepeser pun!
Dialogue: 0,0:21:06.95,0:21:08.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong biarkan aku tetap di grup!
Dialogue: 0,0:21:08.87,0:21:10.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon—
Dialogue: 0,0:21:13.92,0:21:15.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anda siapa?
Dialogue: 0,0:21:15.88,0:21:17.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon!
Dialogue: 0,0:21:21.80,0:21:26.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon, maukah kamu\Nmembuat grup denganku?
Dialogue: 0,0:21:27.89,0:21:29.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:23:10.99,0:23:15.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang tanpa sadar kuajak\Nsaat sedang cari rekan membuat grup
Dialogue: 0,0:23:15.79,0:23:18.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah seorang gadis badut.
Dialogue: 0,0:23:18.08,0:23:23.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah tenang, tindakanku tadi\Nagak mencurigakan, ya?
Dialogue: 0,0:23:23.21,0:23:28.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, orang-orang yang membuangnya dari grup\Nsama sekali tidak tahu apa-apa!
Dialogue: 0,0:23:28.89,0:23:32.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka tidak paham kekuatan\Nyang tersembunyi dalam dirinya.
Dialogue: 0,0:23:32.43,0:23:35.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, Ruche si Badut.
Dialogue: 0,0:23:35.44,0:23:38.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku membutuhkannya!
