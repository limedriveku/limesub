Dialogue: 0,0:18:16.53,0:18:19.37,sign,,0000,0000,0000,,KRITIKAL
Dialogue: 0,0:18:33.93,0:18:37.43,sign,,0000,0000,0000,,TOTAL PENINGKATAN: 1,95 KALI
Dialogue: 0,0:18:40.68,0:18:42.73,sign,,0000,0000,0000,,PENETRASI 15% PENEMBUS BESI
Dialogue: 0,0:18:42.73,0:18:44.69,sign,,0000,0000,0000,,PENETRASI 50% KRITIKAL
Dialogue: 0,0:18:44.69,0:18:48.02,sign,,0000,0000,0000,,DAYA SERANG 1,95 KALI
Dialogue: 0,0:18:48.02,0:18:51.36,sign,,0000,0000,0000,,PENETRASI DAYA PERTAHANAN 65%
Dialogue: 0,0:18:52.61,0:18:56.11,sign,,0000,0000,0000,,PANIK, PANIK
