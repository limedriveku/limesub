Dialogue: 0,0:17:11.80,0:17:13.55,sign,,0000,0000,0000,,MENGINJAK BAYANGAN TARGET AGAK TIDAK KABUR
Dialogue: 0,0:19:38.70,0:19:42.20,sign,,0000,0000,0000,,BEAR SHIELD, REKOMENDASI LV:10
Dialogue: 0,0:19:42.20,0:19:44.16,sign,,0000,0000,0000,,DAYA PERTAHANAN +12, HARGA PASAR: 200.000 GOLD
Dialogue: 0,0:19:44.16,0:19:45.29,sign,,0000,0000,0000,,LEVEL REKOMENDASINYA TERHITUNG RENDAH
Dialogue: 0,0:19:45.29,0:19:46.16,sign,,0000,0000,0000,,UNTUK KEGUNAANNYA
Dialogue: 0,0:20:08.60,0:20:10.23,sign,,0000,0000,0000,,SKILL KHUSUS: MEONG PENARIK HOKI
Dialogue: 0,0:20:10.23,0:20:11.36,sign,,0000,0000,0000,,DAYA KEBERUNTUNGAN NAIK 500%
Dialogue: 0,0:00:04.93,0:00:06.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sudah tidak sanggup.
Dialogue: 0,0:00:10.57,0:00:13.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, berjuanglah di tempat baru.
Dialogue: 0,0:00:13.62,0:00:18.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak tahu bakal ada\Nyang mau tidak menerima orang
Dialogue: 0,0:00:18.21,0:00:22.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang sudah macet gara-gara salah atur skill\Ndan enggak bisa naik level.
Dialogue: 0,0:00:23.84,0:00:28.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uang memang sering dibilang\Nbisa memutus hubungan.
Dialogue: 0,0:00:28.59,0:00:32.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sistem skill point memanglah kejam.
Dialogue: 0,0:00:34.47,0:00:37.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka bakal dapat drop\NPedang Berlumur Darah.
Dialogue: 0,0:00:42.73,0:00:45.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kubilang,\Nini berkat skill milikku!
Dialogue: 0,0:00:45.82,0:00:47.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill milikku!
Dialogue: 0,0:00:48.44,0:00:52.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa kubilang,\Nbenaran ada efeknya, kan?
Dialogue: 0,0:00:55.91,0:00:58.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkatmu, ya?
Dialogue: 0,0:00:59.62,0:01:04.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini drop langka yang muncul setelah\Nberulang kali masuk ke dungeon.
Dialogue: 0,0:01:04.37,0:01:09.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ragu kalau ini benaran\Nberkat skill milikmu.
Dialogue: 0,0:01:09.38,0:01:11.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang?
Dialogue: 0,0:01:11.22,0:01:13.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia punya Skill Tree itu?
Dialogue: 0,0:01:13.72,0:01:17.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, mana ada yang bakal\Nmembuang orang dengan Skill Tree itu?
Dialogue: 0,0:01:17.72,0:01:20.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dari yang kudengar,\Nhanya itu kemungkinannya!
Dialogue: 0,0:01:20.73,0:01:26.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tebakanku benar,\Ndia pemilik Skill Tree yang sakti!
Dialogue: 0,0:01:28.23,0:01:30.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah minta yang tidak-tidak!
Dialogue: 0,0:01:30.70,0:01:33.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak butuh uang sepeser pun!
Dialogue: 0,0:01:33.03,0:01:34.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong biarkan aku tetap di grup!
Dialogue: 0,0:01:34.95,0:01:36.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon—
Dialogue: 0,0:01:40.04,0:01:41.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anda siapa?
Dialogue: 0,0:01:41.96,0:01:43.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon!
Dialogue: 0,0:01:47.84,0:01:52.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon, maukah kamu\Nmembuat grup denganku?
Dialogue: 0,0:01:52.84,0:01:55.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa?
Dialogue: 0,0:03:58.18,0:04:00.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa jadi begini?
Dialogue: 0,0:04:00.01,0:04:01.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kadang memang ada hari kayak begitu.
Dialogue: 0,0:04:06.52,0:04:07.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon!
Dialogue: 0,0:04:07.56,0:04:10.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kujamin tidak akan rugi,\Njadi tolong buatlah grup denganku!
Dialogue: 0,0:04:10.73,0:04:13.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bagi hasil 80:20, bagaimana?
Dialogue: 0,0:04:13.36,0:04:16.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau cuma dapat 20% terus-terusan...
Dialogue: 0,0:04:16.02,0:04:19.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti tidak bisa buat biaya hidup...
Dialogue: 0,0:04:19.52,0:04:22.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu, kamu yang 80%,\Naku 20% saja tidak apa-apa!
Dialogue: 0,0:04:22.53,0:04:24.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Masih tidak mau?
Dialogue: 0,0:04:24.33,0:04:25.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah kamu yang sebegitu?
Dialogue: 0,0:04:25.91,0:04:28.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}To-Tolong tenang dulu!
Dialogue: 0,0:04:28.54,0:04:33.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, boleh tidak lepaskan dulu tanganmu?
Dialogue: 0,0:04:33.04,0:04:34.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, maaf!
Dialogue: 0,0:04:34.50,0:04:36.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, hei, ada apa ini?
Dialogue: 0,0:04:36.84,0:04:39.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiba-tiba main potong seenaknya,\Nsiapa kamu ini?
Dialogue: 0,0:04:39.84,0:04:41.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Elymas.
Dialogue: 0,0:04:41.18,0:04:44.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kebetulan saja dengar\Nkalau dia akan keluar dari grup.
Dialogue: 0,0:04:44.22,0:04:46.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku ingin merekrutnya.
Dialogue: 0,0:04:46.97,0:04:49.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kamu waras?
Dialogue: 0,0:04:49.73,0:04:52.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya tempurnya terlalu rendah
Dialogue: 0,0:04:52.19,0:04:55.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tidak bisa menaikkan level\Ndengan benar.
Dialogue: 0,0:04:55.36,0:04:57.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja, itu bukan masalah.
Dialogue: 0,0:05:00.28,0:05:01.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih.
Dialogue: 0,0:05:09.08,0:05:10.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menyesal, ya!
Dialogue: 0,0:05:10.79,0:05:14.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kalau kamu mau memungut\Nbadut tidak berguna ini,
Dialogue: 0,0:05:14.04,0:05:17.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hati kami bisa lega tanpa merasa bersalah.
Dialogue: 0,0:05:18.76,0:05:22.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh, bawa saja dia sesukamu.
Dialogue: 0,0:05:22.80,0:05:25.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak meminta izinmu.
Dialogue: 0,0:05:39.97,0:05:40.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih.
Dialogue: 0,0:05:40.82,0:05:43.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, berapa levelmu?
Dialogue: 0,0:05:43.32,0:05:45.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu punya rekan lain, tidak?
Dialogue: 0,0:05:45.07,0:05:49.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Levelku 23, Kesatria Kelas Berat solo.
Dialogue: 0,0:05:49.00,0:05:51.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga petualang kelas E.
Dialogue: 0,0:05:51.58,0:05:55.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesatria Kelas Berat solo level 23?
Dialogue: 0,0:05:55.21,0:06:00.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya di level itu kamu paham\Nbetapa tidak bergunanya dia.
Dialogue: 0,0:06:01.59,0:06:03.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf...
Dialogue: 0,0:06:03.30,0:06:07.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Levelku baru 13...
Dialogue: 0,0:06:07.64,0:06:09.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin sebaiknya diurungkan saja...
Dialogue: 0,0:06:09.56,0:06:12.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja, itu bukan masalah.
Dialogue: 0,0:06:17.27,0:06:18.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Cline.
Dialogue: 0,0:06:18.98,0:06:20.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa, Reiss?
Dialogue: 0,0:06:20.74,0:06:21.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih!
Dialogue: 0,0:06:23.42,0:06:29.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tidak aneh, petualang kelas E sampai\Nseantusias itu untuk merekrut Ruche?
Dialogue: 0,0:06:32.75,0:06:34.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan keuntungan dari "itu"
Dialogue: 0,0:06:34.79,0:06:36.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memang besar?
Dialogue: 0,0:06:36.04,0:06:38.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terlalu antusias, ya?
Dialogue: 0,0:06:38.38,0:06:41.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak ada efeknya, kan?
Dialogue: 0,0:06:41.55,0:06:44.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aslinya tidak ada gunanya.
Dialogue: 0,0:06:44.01,0:06:44.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:06:44.80,0:06:46.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara apa kamu, Reiss?
Dialogue: 0,0:06:46.84,0:06:49.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam dan biarkan saja dia pergi.
Dialogue: 0,0:06:50.56,0:06:54.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia mau pergi secara damai,\Nmalah lebih baik, kan?
Dialogue: 0,0:06:54.39,0:06:57.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, coba kamu pikir\Ndengan kepala dingin.
Dialogue: 0,0:06:57.40,0:07:01.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin Kesatria Kelas Berat bisa\Nmenaikkan level sampai 23 secara solo?
Dialogue: 0,0:07:01.69,0:07:04.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Antara cuma membual\Natau ditendang dari grup.
Dialogue: 0,0:07:04.70,0:07:06.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau malah cuma ingin menggoda.
Dialogue: 0,0:07:06.70,0:07:09.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang bagus dari Ruche cuma tampangnya.
Dialogue: 0,0:07:09.58,0:07:11.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:07:11.58,0:07:14.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, pas sekali, kan?
Dialogue: 0,0:07:14.66,0:07:16.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau beredar rumor buruk
Dialogue: 0,0:07:16.65,0:07:19.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahwa mengusir anggota yang salah atur skill,
Dialogue: 0,0:07:19.17,0:07:22.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu tidak baik untuk kita, kan?
Dialogue: 0,0:07:22.96,0:07:25.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, benar juga, ya.
Dialogue: 0,0:07:30.10,0:07:34.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elymas! Kami memang sudah\Nmenunggu orang sepertimu!
Dialogue: 0,0:07:34.06,0:07:35.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jaga Ruche, ya!
Dialogue: 0,0:07:40.73,0:07:43.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kalau begitu...
Dialogue: 0,0:07:47.32,0:07:50.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izinkan aku menerima niat baikmu.
Dialogue: 0,0:07:50.29,0:07:53.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon kerja samanya, Elymas!
Dialogue: 0,0:07:54.41,0:07:55.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:07:55.41,0:07:57.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon kerja samanya juga, Ruche!
Dialogue: 0,0:08:00.96,0:08:04.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah momen mendapat\Nanggota grup pertamaku!
Dialogue: 0,0:08:06.94,0:08:10.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat atas terbentuknya grup kalian!
Dialogue: 0,0:08:10.34,0:08:13.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama ini, kamu belum sempat\Nbeli perlengkapan yang layak, kan?
Dialogue: 0,0:08:13.89,0:08:16.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah begitu, Ruche?
Dialogue: 0,0:08:19.60,0:08:23.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seratus ribu Gold ini\Nhadiah perpisahan dari kami.
Dialogue: 0,0:08:24.53,0:08:27.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gunakanlah baik-baik.
Dialogue: 0,0:08:33.03,0:08:36.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak, Cline.
Dialogue: 0,0:08:37.96,0:08:39.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, jangan kamu pungut.
Dialogue: 0,0:08:41.71,0:08:43.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namamu Cline, ya?
Dialogue: 0,0:08:43.91,0:08:47.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pungutlah sendiri\Napa yang sudah kamu sebar.
Dialogue: 0,0:08:48.21,0:08:49.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak kecil pun bisa melakukan itu.
Dialogue: 0,0:08:50.21,0:08:54.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menggelikan sekali menyebut hadiah perpisahan\Nuntuk sesuatu yang kamu buang di tanah.
Dialogue: 0,0:08:58.73,0:09:00.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo pergi, Ruche.
Dialogue: 0,0:09:00.10,0:09:03.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Tapi, 100.000 Gold itu uang\Nyang sangat banyak...
Dialogue: 0,0:09:03.15,0:09:07.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya jangan berutang sedikit pun\Npada orang sepertinya.
Dialogue: 0,0:09:09.53,0:09:10.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik.
Dialogue: 0,0:09:10.70,0:09:13.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih, malah meremehkanku!
Dialogue: 0,0:09:13.03,0:09:17.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelas apes sepertimu memang cocok dengannya\Nsebagai sesama orang tidak berguna!
Dialogue: 0,0:09:20.58,0:09:22.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo pergi, Reiss!
Dialogue: 0,0:09:23.08,0:09:26.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti uang ini boleh kuambil?
Dialogue: 0,0:09:27.96,0:09:29.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas tidak boleh!
Dialogue: 0,0:09:29.59,0:09:31.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini punyaku!\NPunyaku!
Dialogue: 0,0:09:31.47,0:09:33.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, itu masalah sepele.
Dialogue: 0,0:09:33.18,0:09:35.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Maaf membuat menunggu.\N- Halo.
Dialogue: 0,0:09:37.47,0:09:39.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segera datang!
Dialogue: 0,0:09:39.06,0:09:40.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan menikmati.
Dialogue: 0,0:09:41.02,0:09:47.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak, Elymas,\Nsudah mengundangku masuk ke grup!
Dialogue: 0,0:09:48.27,0:09:53.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, maaf, sepertinya aku\Nmemang kurang mumpuni...
Dialogue: 0,0:09:53.69,0:09:55.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah cemas.
Dialogue: 0,0:09:55.45,0:09:58.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal mengalahkan monster\Nyang sesuai Skill Tree—
Dialogue: 0,0:09:58.20,0:09:59.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, maaf.
Dialogue: 0,0:09:59.97,0:10:02.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu membuatku kepikiran sesuatu.
Dialogue: 0,0:10:02.04,0:10:03.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan Elymas,
Dialogue: 0,0:10:03.50,0:10:07.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu menolongku karena jatuh cinta\Npada pandangan pertama?
Dialogue: 0,0:10:08.25,0:10:09.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kamu bicarakan?
Dialogue: 0,0:10:09.80,0:10:16.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terus kepikiran, kenapa orang dengan\Nlevel lebih tinggi mau membelaku.
Dialogue: 0,0:10:16.05,0:10:18.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu kurasa cuma itulah alasannya!
Dialogue: 0,0:10:19.31,0:10:22.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi, aku ini memang imut.
Dialogue: 0,0:10:22.31,0:10:23.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, begini.
Dialogue: 0,0:10:23.39,0:10:27.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga merasa kalau Elymas\Nmemang menawan.
Dialogue: 0,0:10:27.15,0:10:31.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kurasa sebaiknya mulai dulu\Ndengan berteman.
Dialogue: 0,0:10:33.53,0:10:37.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan wanita murahan seperti itu, ya!
Dialogue: 0,0:10:37.45,0:10:38.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche.
Dialogue: 0,0:10:38.70,0:10:39.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:10:41.37,0:10:45.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu punya Skill Tree Hoki Gila, kan?
Dialogue: 0,0:11:00.47,0:11:01.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche.
Dialogue: 0,0:11:01.39,0:11:02.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:11:03.64,0:11:07.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu punya Skill Tree Hoki Gila, kan?
Dialogue: 0,0:11:41.47,0:11:44.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dungeon dalam Magic World adalah
Dialogue: 0,0:11:44.39,0:11:45.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mimpi buruk yang dilihat Alxeros,
Dialogue: 0,0:11:45.84,0:11:48.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sang dewa pencipta yang tertidur.
Dialogue: 0,0:11:49.46,0:11:51.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alxeros telah melewati waktu panjang
Dialogue: 0,0:11:51.94,0:11:55.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menciptakan berbagai dunia\Ndan dewa dari ketiadaan.
Dialogue: 0,0:11:55.36,0:11:59.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja,\Ndalam waktu yang nyaris kekal itu,
Dialogue: 0,0:11:59.03,0:12:02.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alxeros yang merupakan dewa absolut\Nkehilangan kewarasannya
Dialogue: 0,0:12:02.37,0:12:07.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan berakhir disegel\Noleh para dewa ciptaannya sendiri.
Dialogue: 0,0:12:08.83,0:12:14.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, hingga saat ini mimpi buruk Alxeros\Nmasih memberi pengaruh ke dunia nyata.
Dialogue: 0,0:12:15.01,0:12:17.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mimpi buruk Alxeros menciptakan gerbang
Dialogue: 0,0:12:17.97,0:12:21.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang melahirkan makhluk aneh\Nserta monster ke dunia nyata.
Dialogue: 0,0:12:27.31,0:12:28.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kelihatan.
Dialogue: 0,0:12:32.73,0:12:34.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah Dungeon.
Dialogue: 0,0:12:34.61,0:12:37.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serta alasannya disebut Lubang Mimpi.
Dialogue: 0,0:12:37.81,0:12:42.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pintu Masuk Kotak Mainan Malaikat,\Nrekomendasi level: 50.
Dialogue: 0,0:12:42.41,0:12:46.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa betulan tidak jadi masalah\Nkalau bersamaku, Elymas?
Dialogue: 0,0:12:46.12,0:12:48.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Statusku masih separah ini!
Dialogue: 0,0:12:48.62,0:12:50.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Separah ini.
Dialogue: 0,0:12:50.96,0:12:54.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan sesuatu yang seharusnya\Ndiperlihatkan ke orang lain.
Dialogue: 0,0:12:54.38,0:12:56.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:12:57.13,0:12:58.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa!
Dialogue: 0,0:12:58.67,0:13:02.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tahu kalau Elymas bukan orang\Nyang akan menyebarkan ini sesuka hati.
Dialogue: 0,0:13:03.38,0:13:06.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, daripada nanti kecewa\Npadahal sudah berekspektasi.
Dialogue: 0,0:13:06.68,0:13:10.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih tenang kalau kamu tahu\Ndan meninggalkanku di sini.
Dialogue: 0,0:13:12.86,0:13:14.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu-satunya skill serangan milikku,
Dialogue: 0,0:13:14.69,0:13:16.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dice Thrust tidak bisa dipakai\N- Miss.
Dialogue: 0,0:13:16.86,0:13:19.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau tidak dapat angka enam.
Dialogue: 0,0:13:20.45,0:13:22.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya aku juga membagi poin
Dialogue: 0,0:13:22.61,0:13:26.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ke Akrobat Badut dan Peningkat Daya Serang.
Dialogue: 0,0:13:26.70,0:13:31.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, statusku benaran kacau balau.
Dialogue: 0,0:13:31.21,0:13:32.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:13:35.04,0:13:38.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche, aku membutuhkanmu.
Dialogue: 0,0:13:39.76,0:13:42.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa maksudnya itu?
Dialogue: 0,0:13:42.30,0:13:44.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf...
Dialogue: 0,0:13:44.55,0:13:48.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku tidak begitu paham\Nsama yang seperti itu...
Dialogue: 0,0:13:48.10,0:13:53.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak diutarakan lebih terbuka,\Naku tidak bisa mengerti...
Dialogue: 0,0:13:53.10,0:13:55.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, anu...
Dialogue: 0,0:13:55.81,0:14:00.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Tapi, mungkin tidak baik\Nkalau diucapkan seperti ini.
Dialogue: 0,0:14:00.28,0:14:02.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya pengecut...
Dialogue: 0,0:14:02.11,0:14:03.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, begitu.
Dialogue: 0,0:14:04.20,0:14:07.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di penjelajahan kali ini,\Nayo kita dapatkan 30 juta Gold
Dialogue: 0,0:14:07.95,0:14:10.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan naikkan levelmu sampai 30!
Dialogue: 0,0:14:10.33,0:14:11.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:14:11.25,0:14:13.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa malah begitu?
Dialogue: 0,0:14:19.01,0:14:20.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo.
Dialogue: 0,0:14:20.05,0:14:21.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:14:57.21,0:14:59.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rekomendasi levelnya memang 50,
Dialogue: 0,0:14:59.46,0:15:02.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi informasi soal monster\Nyang muncul di sini sudah di kepalaku.
Dialogue: 0,0:15:05.68,0:15:08.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya tidak akan bertemu\Nbahaya sebesar itu.
Dialogue: 0,0:15:09.18,0:15:13.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuan kami hanya menaikkan level\Ndi lantai rendah.
Dialogue: 0,0:15:13.06,0:15:15.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang akan memancing musuh,
Dialogue: 0,0:15:15.35,0:15:16.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu gunakanlah pisau
Dialogue: 0,0:15:16.73,0:15:19.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penembus Besi untuk mengalahkan musuh.
Dialogue: 0,0:15:19.86,0:15:23.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Datang sejauh ini juga keputusanku.
Dialogue: 0,0:15:23.24,0:15:26.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, aku juga sudah dibelikan\Nbarang semahal ini.
Dialogue: 0,0:15:26.74,0:15:28.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti tidak boleh pesimis, kan?
Dialogue: 0,0:15:28.78,0:15:31.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penembus Besi, daya serang +3.
Dialogue: 0,0:15:31.95,0:15:34.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harga pasar: 550.000 Gold.
Dialogue: 0,0:15:34.25,0:15:37.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan dari pisau ini\Nmudah menembus musuh yang keras.
Dialogue: 0,0:15:37.50,0:15:38.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat berhasil menyerang,
Dialogue: 0,0:15:38.96,0:15:42.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menurunkan daya pertahanan musuh sebesar\N15% dan memberikan kerusakan.
Dialogue: 0,0:15:42.75,0:15:45.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, serahkan padaku, Elymas!
Dialogue: 0,0:15:45.42,0:15:49.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan sekuat tenaga memenuhi\Nkepercayaan diri dan ekspektasi anehmu itu!
Dialogue: 0,0:15:49.26,0:15:53.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Yay, yay, yay!\N- Si-Sip, baguslah kalau kamu semangat.
Dialogue: 0,0:15:53.77,0:15:58.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan melindungimu sekuat tenaga\Nagar Penembus Besi ini tidak sia-sia!
Dialogue: 0,0:15:58.52,0:16:01.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melindungi itu tugasku.
Dialogue: 0,0:16:15.37,0:16:18.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Muncul juga, Beruang Tambalan.
Dialogue: 0,0:16:18.67,0:16:23.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penampilannya imut,\Ntapi levelnya tidak imut sama sekali.
Dialogue: 0,0:16:23.09,0:16:25.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, daya serangnya 22.
Dialogue: 0,0:16:25.59,0:16:29.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misalkan kena satu serangannya,\NHP Ruche masih akan tersisa.
Dialogue: 0,0:16:29.09,0:16:32.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetap tidak akan bertahan\Nkalau serangannya kritikal.
Dialogue: 0,0:16:32.43,0:16:37.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bisa sepenuhnya dicegah asal dapat\Nmengacaukan posisinya saat mulai menyerang.
Dialogue: 0,0:16:38.23,0:16:41.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa bisa langsung tahu sampai sana?
Dialogue: 0,0:16:41.67,0:16:44.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu suka Beruang Tambalan?
Dialogue: 0,0:16:45.61,0:16:48.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukannya suka, sih.
Dialogue: 0,0:16:49.24,0:16:51.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang akan menangkis serangannya.
Dialogue: 0,0:16:51.74,0:16:54.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi tolong serang dan kalahkan dia\Ndari titik buta.
Dialogue: 0,0:16:54.16,0:16:55.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik!
Dialogue: 0,0:16:55.37,0:16:57.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waspada sama cakar dan gigitannya!
Dialogue: 0,0:16:57.50,0:16:58.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:17:05.05,0:17:06.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penginjak Bayang!
Dialogue: 0,0:17:07.55,0:17:10.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill ini kudapat dari poin setelah\Nmengalahkan Mad Headder.
Dialogue: 0,0:17:10.55,0:17:13.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini aku akan menaikkan level Ruche!
Dialogue: 0,0:17:16.52,0:17:19.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati, bayangannya memanjang\Nlebih jauh dari dugaan.
Dialogue: 0,0:17:19.31,0:17:21.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku mengerti!
Dialogue: 0,0:17:22.36,0:17:23.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:17:23.40,0:17:27.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi, katanya harus waspada\Nsama cakar dan gigitannya.
Dialogue: 0,0:17:27.03,0:17:30.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Beruang Tambalan\Nkelihatan tidak punya cakar atau taring...
Dialogue: 0,0:17:55.72,0:17:57.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah aku punya tameng.
Dialogue: 0,0:17:57.76,0:18:02.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menangkis penuh serangan musuh\Ntanpa menggerakkan kaki itu repot.
Dialogue: 0,0:18:03.15,0:18:04.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, Ruche!
Dialogue: 0,0:18:04.56,0:18:06.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seranglah dia sebanyak-banyaknya!
Dialogue: 0,0:18:06.52,0:18:08.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik!
Dialogue: 0,0:18:11.36,0:18:16.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukan cuma levelnya,\Npenampilannya juga tidak imut!
Dialogue: 0,0:18:16.83,0:18:18.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hi-Hiyak!
Dialogue: 0,0:18:18.54,0:18:21.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tusuk! Tusuk!
Dialogue: 0,0:18:30.05,0:18:33.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Ternyata butuh diserang lumayan banyak.
Dialogue: 0,0:18:33.43,0:18:36.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kita berhasil mengalahkannya!
Dialogue: 0,0:18:38.01,0:18:40.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche, levelmu naik berapa—
Dialogue: 0,0:18:40.27,0:18:41.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:18:41.56,0:18:42.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin!
Dialogue: 0,0:18:42.43,0:18:46.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beruang Tambalan,\Ntolong jatuhkan suatu item, dong!
Dialogue: 0,0:18:47.86,0:18:52.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini, nanti aku\Nkehilangan tempat berada lagi!
Dialogue: 0,0:18:53.40,0:18:57.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, dia cuma untuk menaikkan level,\Njadi tenang saja.
Dialogue: 0,0:18:58.45,0:19:01.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, rencananya aku ingin\Nmengalahkan beberapa lagi.
Dialogue: 0,0:19:01.33,0:19:02.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti juga akan ada drop—
Dialogue: 0,0:19:05.08,0:19:07.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru juga dibilang, sudah datang lagi.
Dialogue: 0,0:19:08.54,0:19:10.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Caranya masih sama dengan tadi!
Dialogue: 0,0:19:10.17,0:19:10.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:19:10.96,0:19:12.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:19:30.36,0:19:31.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sana juga!
Dialogue: 0,0:19:31.78,0:19:33.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba lihat ini!
Dialogue: 0,0:19:33.40,0:19:35.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya ada yang muncul!
Dialogue: 0,0:19:35.36,0:19:36.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Item drop!
Dialogue: 0,0:19:36.91,0:19:38.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua kali berturut-turut pula!
Dialogue: 0,0:19:38.70,0:19:42.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bear Shield, daya pertahanan +12.
Dialogue: 0,0:19:42.20,0:19:44.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harga pasar: 200.000 Gold.
Dialogue: 0,0:19:44.16,0:19:46.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tameng bundar bermotif beruang yang imut.
Dialogue: 0,0:19:46.16,0:19:48.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung saja kamu mengajakku, kan?
Dialogue: 0,0:19:48.83,0:19:49.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan?
Dialogue: 0,0:19:49.54,0:19:51.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau kamu pakai, Elymas?
Dialogue: 0,0:19:52.05,0:19:54.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bo-Boleh.
Dialogue: 0,0:19:54.01,0:19:55.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, biar kuterima saja.
Dialogue: 0,0:19:55.67,0:19:58.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, memang sebaiknya begitu!
Dialogue: 0,0:19:58.64,0:20:00.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini aneh.
Dialogue: 0,0:20:00.26,0:20:03.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya bukan item\Nyang akan jatuh beruntun begitu.
Dialogue: 0,0:20:03.93,0:20:07.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku salah mengingat peluang jatuhnya?
Dialogue: 0,0:20:07.06,0:20:08.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tapi...
Dialogue: 0,0:20:08.60,0:20:11.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill Meong Penarik Hoki milik Ruche
Dialogue: 0,0:20:11.36,0:20:14.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah skill khusus yang meningkatkan\Ndaya keberuntungan 500%.
Dialogue: 0,0:20:15.17,0:20:18.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misalkan status keberuntungan awal Ruche\Npada dasarnya memang besar,
Dialogue: 0,0:20:19.03,0:20:22.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kecenderungan seperti ini tidaklah mustahil.
Dialogue: 0,0:20:22.12,0:20:25.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka bakal dapat drop\NPedang Berlumur Darah.
Dialogue: 0,0:20:25.91,0:20:28.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kubilang,\Nini berkat skill milikku!
Dialogue: 0,0:20:28.79,0:20:29.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill milikku!
Dialogue: 0,0:20:29.88,0:20:34.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ragu kalau ini benaran\Nberkat skill milikmu.
Dialogue: 0,0:20:35.61,0:20:40.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, kenapa Cline dan kawannya tidak\Nmenyadari efek peningkatan drop ini?
Dialogue: 0,0:20:40.43,0:20:42.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang lemah sepertimu
Dialogue: 0,0:20:42.32,0:20:44.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- berharap dapat jatah dari pedang ini?\N- Ah, grup mereka masih awal,
Dialogue: 0,0:20:44.47,0:20:46.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- berharap dapat jatah dari pedang ini?\N- jadi tidak tahu seberapa berharganya itu, ya?
Dialogue: 0,0:20:46.60,0:20:49.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Informasi monster di dunia ini\Nsangatlah sedikit.
Dialogue: 0,0:20:49.73,0:20:53.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti telanjur terbiasa dengan\Npeluang drop item yang mudah sejak awal.
Dialogue: 0,0:20:54.94,0:20:57.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elymas, apa aku sudah berguna?
Dialogue: 0,0:20:58.45,0:20:59.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:20:59.40,0:21:03.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche, terima kasih banyak\Nsudah mau membuat grup denganku!
Dialogue: 0,0:21:06.95,0:21:10.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sangat menginginkan\NBear Shield ini, ya?
Dialogue: 0,0:21:10.42,0:21:13.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, hari ini ayo kita\Nkumpulkan sampai dapat sepuluh!
Dialogue: 0,0:21:13.96,0:21:16.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah, level kita sudah naik\Ncukup banyak.
Dialogue: 0,0:21:16.81,0:21:18.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang baru acara utamanya.
Dialogue: 0,0:21:20.30,0:21:22.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Telah naik ke level 20.
Dialogue: 0,0:21:22.64,0:21:24.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, benar!
Dialogue: 0,0:21:24.26,0:21:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kapan?
Dialogue: 0,0:21:26.35,0:21:28.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang saatnya tujuan utama kita.
Dialogue: 0,0:21:29.56,0:21:31.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo memburu Raana Emas!
Dialogue: 0,0:21:34.15,0:21:37.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ra-Raana Emas?
Dialogue: 0,0:21:37.23,0:21:38.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Webek.
Dialogue: 0,0:23:10.41,0:23:14.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan Ruche ternyata jauh\Ndi atas perkiraanku.
Dialogue: 0,0:23:14.25,0:23:18.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, ini bahkan baru secuil\Ndari kekuatannya.
Dialogue: 0,0:23:18.67,0:23:22.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, aku tidak sedang\Nmembahas Bear Shield.
Dialogue: 0,0:23:22.34,0:23:24.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan menggunakannya.
Dialogue: 0,0:23:24.41,0:23:25.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya!
Dialogue: 0,0:23:25.43,0:23:30.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini akhirnya kami siap menghadapi\Ntujuan utama datang ke dungeon ini!
Dialogue: 0,0:23:30.85,0:23:32.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Acara utamanya baru akan dimulai!
Dialogue: 0,0:23:33.93,0:23:36.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, Berburu Raana Emas.
Dialogue: 0,0:23:36.19,0:23:39.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dalam gim,\Nharus ada karakter bonusnya!
