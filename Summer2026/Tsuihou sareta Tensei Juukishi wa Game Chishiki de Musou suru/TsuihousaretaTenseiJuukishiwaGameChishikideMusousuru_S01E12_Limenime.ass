Dialogue: 0,0:05:31.14,0:05:33.65,sign,,0000,0000,0000,,SKILL TREE KESATRIA KELAS BERAT: LV41\NSISA SKILL POINT: 6
Dialogue: 0,0:05:55.92,0:05:56.50,sign,,0000,0000,0000,,SKILL TREE KESATRIA KELAS BERAT: LV41\NSISA SKILL POINT: 1
Dialogue: 0,0:05:56.50,0:05:59.80,sign,,0000,0000,0000,,KARENA TARING BARA KEGILAAN NAIK KE LEVEL 5
Dialogue: 0,0:05:59.80,0:06:03.43,sign,,0000,0000,0000,,MENDAPAT SKILL AMUKAN NAGA DI AMBANG AJAL
