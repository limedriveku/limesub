Dialogue: 0,0:06:59.02,0:07:01.03,sign,,0000,0000,0000,,ELYMAS EDVAUGHN
Dialogue: 0,0:07:04.45,0:07:07.03,sign,,0000,0000,0000,,LIFE SHIELD [SKILL BIASA]
Dialogue: 0,0:07:07.03,0:07:09.70,sign,,0000,0000,0000,,DIAKTIFKAN DENGAN BAYARAN 20%
Dialogue: 0,0:07:09.70,0:07:11.29,sign,,0000,0000,0000,,DARI HP MAKSIMUM
Dialogue: 0,0:07:11.29,0:07:14.00,sign,,0000,0000,0000,,PERISAI DENGAN DAYA TAHAN SEBESAR HP
Dialogue: 0,0:07:14.00,0:07:16.46,sign,,0000,0000,0000,,YANG DIBAYARKAN AKAN MENYELIMUTI TUBUH
Dialogue: 0,0:07:32.72,0:07:33.68,sign,,0000,0000,0000,,ELYMAS EDVAUGHN
Dialogue: 0,0:08:10.05,0:08:11.43,sign,,0000,0000,0000,,AMUKAN NAGA DI AMBANG AJAL
Dialogue: 0,0:08:55.89,0:08:58.14,sign,,0000,0000,0000,,AMUKAN NAGA DI AMBANG AJAL
Dialogue: 0,0:09:51.40,0:09:52.24,sign,,0000,0000,0000,,SKILL AMUKAN NAGA DI AMBANG AJAL
Dialogue: 0,0:09:52.24,0:09:52.86,sign,,0000,0000,0000,,DAYA SERANG, KECEPATAN +100%
Dialogue: 0,0:09:52.86,0:09:53.66,sign,,0000,0000,0000,,JULUKAN PENGACAU ESTIMASI
Dialogue: 0,0:09:53.66,0:09:54.28,sign,,0000,0000,0000,,DAYA SERANG, KECEPATAN +15
Dialogue: 0,0:11:24.58,0:11:25.79,sign,,0000,0000,0000,,AIR MENGALIR
Dialogue: 0,0:13:13.19,0:13:14.69,sign,,0000,0000,0000,,SHIELD BASH
Dialogue: 0,0:00:17.16,0:00:21.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kutunjukkan skill Pedang Suci!
Dialogue: 0,0:00:22.50,0:00:25.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan Beruntun Bajra!
Dialogue: 0,0:00:26.33,0:00:30.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu skill serangan beruntun secepat kilat\Nyang jadi simbol Pedang Suci!
Dialogue: 0,0:00:45.53,0:00:47.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berhasil menahannya?
Dialogue: 0,0:00:55.58,0:00:58.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekali lagi.
Dialogue: 0,0:01:00.04,0:01:01.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elymas!
Dialogue: 0,0:01:14.22,0:01:15.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti—
Dialogue: 0,0:01:15.57,0:01:18.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka sejomplang ini!
Dialogue: 0,0:01:30.36,0:01:34.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sudah fokus bertahan,\Ntidak bisa kutembus, ya.
Dialogue: 0,0:01:34.70,0:01:36.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:01:47.42,0:01:49.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya kamu mulai melemah.
Dialogue: 0,0:02:07.02,0:02:09.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita akhiri.
Dialogue: 0,0:03:49.38,0:03:52.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elymas!\NIni sudah batasmu!
Dialogue: 0,0:03:52.38,0:03:53.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah hentikan!
Dialogue: 0,0:03:55.88,0:03:57.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malice.
Dialogue: 0,0:03:57.76,0:04:02.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya tiga tugas di pertarungan ini.
Dialogue: 0,0:04:04.52,0:04:08.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, memastikan\NSerangan Beruntun Bajra milikmu.
Dialogue: 0,0:04:10.19,0:04:13.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan Beruntun Bajra!
Dialogue: 0,0:04:21.12,0:04:26.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedua, menemukan kelemahan terbesarmu.
Dialogue: 0,0:04:29.00,0:04:31.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berhasil menahannya?
Dialogue: 0,0:04:31.29,0:04:33.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekali lagi.
Dialogue: 0,0:04:34.42,0:04:36.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ketiga...
Dialogue: 0,0:04:41.51,0:04:47.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengatur agar HP milikku di bawah 40%!
Dialogue: 0,0:04:53.19,0:04:56.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pikir aku akan gentar karena digertak?
Dialogue: 0,0:04:57.19,0:05:00.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Angka kemampuan Pedang Magis Gagak Air.
Dialogue: 0,0:05:01.32,0:05:06.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru menyelesaikan Transfer Daya Hidup\Ndan naik ke level 45.
Dialogue: 0,0:05:06.33,0:05:09.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, levelmu yang sekarang...
Dialogue: 0,0:05:09.91,0:05:13.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, sudah sesuai perhitunganku!
Dialogue: 0,0:05:20.01,0:05:21.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begini, akhirnya
Dialogue: 0,0:05:21.72,0:05:24.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa memberi poin ke Taring Bara Kegilaan.
Dialogue: 0,0:05:26.22,0:05:27.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tos!\N- Tos!
Dialogue: 0,0:05:27.68,0:05:30.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat Ruche, aku berhasil\Nmendapatkannya tepat waktu!
Dialogue: 0,0:05:33.65,0:05:37.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa meninggalkanmu\Nyang tampak tersiksa begitu!
Dialogue: 0,0:05:38.28,0:05:41.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menyemangati agar aku bisa\Nbertarung dengan kepala dingin.
Dialogue: 0,0:05:41.65,0:05:43.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis cilik,
Dialogue: 0,0:05:43.07,0:05:44.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- rakyat jelata sepertimu\N- Menyela obrolan Count
Dialogue: 0,0:05:44.70,0:05:47.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- ingin mencampuri urusan kami?\N- rasanya pasti sangat menakutkan.
Dialogue: 0,0:05:52.75,0:05:55.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, pertarungan ini...
Dialogue: 0,0:05:56.50,0:05:59.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Taring Bara Kegilaan telah naik ke level 5,
Dialogue: 0,0:05:59.80,0:06:03.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mendapat skill Amukan Naga di Ambang Ajal.
Dialogue: 0,0:06:04.09,0:06:07.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan kami menangkan!
Dialogue: 0,0:06:12.44,0:06:14.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong kosong!
Dialogue: 0,0:06:16.11,0:06:18.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Amukan Naga di Ambang Ajal
Dialogue: 0,0:06:18.19,0:06:20.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah skill yang hanya bisa diaktifkan
Dialogue: 0,0:06:20.82,0:06:22.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat HP tersisa 20% atau kurang.
Dialogue: 0,0:06:24.07,0:06:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Punya efek luar biasa yang meningkatkan\Ndaya serang dan kecepatan sebesar 100%.
Dialogue: 0,0:06:30.20,0:06:32.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, meski ingin mengincar aktivasinya,
Dialogue: 0,0:06:32.25,0:06:36.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada satu kesalahan saja bisa membuat\Nterbunuh sebelum efeknya sempat aktif.
Dialogue: 0,0:06:36.50,0:06:38.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski punya efek dahsyat,
Dialogue: 0,0:06:38.71,0:06:41.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mencapai limitasi HP ini sangatlah sulit,
Dialogue: 0,0:06:41.30,0:06:46.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi dianggap skill berdaya guna rendah\Ndi masa-masa awal gim.
Dialogue: 0,0:06:47.05,0:06:52.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja, Kesatria Kelas Berat punya skill\Nyang bisa mengatasi kelemahan ini!
Dialogue: 0,0:06:53.23,0:06:57.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Life Shield!
Dialogue: 0,0:07:01.44,0:07:04.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memakai Life Shield di saat seperti ini?
Dialogue: 0,0:07:04.45,0:07:07.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill, Life Shield.
Dialogue: 0,0:07:07.03,0:07:09.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diaktifkan dengan bayaran 20%
Dialogue: 0,0:07:09.70,0:07:11.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari HP maksimum.
Dialogue: 0,0:07:11.29,0:07:14.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perisai dengan daya tahan sebesar HP
Dialogue: 0,0:07:14.00,0:07:16.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang dibayarkan akan menyelimuti tubuh.
Dialogue: 0,0:07:17.04,0:07:19.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah putus asa, ya.
Dialogue: 0,0:07:19.75,0:07:23.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Life Shield yang memakan HP\Nsebagai syarat aktivasinya
Dialogue: 0,0:07:23.05,0:07:25.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sangat sempurna untuk mengatur jumlah HP!
Dialogue: 0,0:07:25.72,0:07:29.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain bisa konsisten mengaktifkan\NAmukan Naga di Ambang Ajal,
Dialogue: 0,0:07:29.64,0:07:32.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}juga dapat tambahan perisai yang kuat!
Dialogue: 0,0:07:33.68,0:07:35.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kombo mematikan yang bisa sepenuhnya
Dialogue: 0,0:07:35.73,0:07:38.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengatasi risiko dan ketidakstabilan\Ndari efek status luar biasa
Dialogue: 0,0:07:38.98,0:07:42.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang diberikan Amukan Naga di Ambang Ajal!
Dialogue: 0,0:07:45.70,0:07:48.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuakhiri ini dalam sekejap, Malice!
Dialogue: 0,0:08:07.59,0:08:10.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Amukan Naga di Ambang Ajal!
Dialogue: 0,0:08:11.93,0:08:13.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kutunjukkan padamu!
Dialogue: 0,0:08:13.63,0:08:18.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah kekuatan sejati\NKesatria Kelas Berat!
Dialogue: 0,0:08:38.25,0:08:41.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya kamu baru saja\Nmengaktifkan suatu skill.
Dialogue: 0,0:08:41.50,0:08:44.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu kamu pikir bisa\Nmengalahkanku dengan itu?
Dialogue: 0,0:08:55.89,0:08:58.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Amukan Naga di Ambang Ajal!
Dialogue: 0,0:09:39.39,0:09:44.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan dan kecepatannya bisa menyamaiku\Nyang seorang Pedang Suci?
Dialogue: 0,0:09:45.23,0:09:48.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat efek Pengacau Estimasi\Ndan Amukan Naga di Ambang Ajal,
Dialogue: 0,0:09:48.53,0:09:54.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}daya serang dan kecepatanku meningkat 115%!
Dialogue: 0,0:09:54.28,0:09:58.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekalahan statusku sudah kubalikkan!
Dialogue: 0,0:10:12.34,0:10:15.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar-benar menarik!
Dialogue: 0,0:10:17.85,0:10:21.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahu dongeng Malaikat Bersayap Lilin?
Dialogue: 0,0:10:23.06,0:10:27.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malaikat yang terlahir tanpa sayap\Ndan dijatuhkan ke Bumi,
Dialogue: 0,0:10:27.77,0:10:32.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bermimpi kembali ke tanah airnya,\Nia pun mencoba terbang dengan sayap lilin.
Dialogue: 0,0:10:32.53,0:10:36.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, panas matahari\Nmelelehkan sayapnya, lalu ia jatuh,
Dialogue: 0,0:10:36.82,0:10:39.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mati begitu saja.
Dialogue: 0,0:10:39.58,0:10:41.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti itulah kisahnya.
Dialogue: 0,0:10:46.54,0:10:49.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat menyukai kisah ini.
Dialogue: 0,0:10:49.75,0:10:53.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia yang berjuang sekuat tenaga\Nhancur berkeping-keping.
Dialogue: 0,0:10:55.93,0:10:58.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat menyukainya!
Dialogue: 0,0:10:59.14,0:11:03.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi kalau itu dirimu\Nyang sangat kukagumi...
Dialogue: 0,0:11:03.14,0:11:05.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti rasanya akan lebih spesial!
Dialogue: 0,0:11:07.31,0:11:08.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Parry!
Dialogue: 0,0:11:09.40,0:11:11.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf saja, tapi itu tak akan terjadi.
Dialogue: 0,0:11:12.94,0:11:15.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Parry yang kamu banggakan itu,
Dialogue: 0,0:11:15.36,0:11:18.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pada akhirnya hanyalah versi\Nlebih lemah dari skill milikku!
Dialogue: 0,0:11:24.58,0:11:25.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Air Mengalir!
Dialogue: 0,0:11:26.79,0:11:29.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mengacaukan tempo seranganku?
Dialogue: 0,0:11:33.96,0:11:37.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa malah aku yang jadi terus bertahan?
Dialogue: 0,0:11:37.01,0:11:43.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tak akan bisa memojokkanku\Nsaat perbedaan statusnya terpaut jauh.
Dialogue: 0,0:11:44.93,0:11:46.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu saja alasannya.
Dialogue: 0,0:11:50.11,0:11:52.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:11:55.57,0:11:58.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan ini?
Dialogue: 0,0:12:01.37,0:12:05.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan Beruntun Bajra!
Dialogue: 0,0:12:23.97,0:12:28.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malice, Serangan Beruntun Bajra milikmu\Npunya celah yang sangat fatal.
Dialogue: 0,0:12:44.95,0:12:48.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kamu memaksa melepaskan\Nayunan keempat,
Dialogue: 0,0:12:48.12,0:12:51.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kuda-kudamu jadi sangat goyah\Ndan membuka celah.
Dialogue: 0,0:12:51.63,0:12:56.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan Beruntun Bajra adalah skill\Nyang menaikkan kemampuan fisik untuk sesaat.
Dialogue: 0,0:12:56.26,0:12:58.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa berapa kali melakukan tebasan,
Dialogue: 0,0:12:58.13,0:13:00.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu tergantung kemampuan penggunanya.
Dialogue: 0,0:13:00.63,0:13:04.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya kamu berhenti\Ndalam tiga tebasan saja.
Dialogue: 0,0:13:07.10,0:13:09.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal sudah kehilangan senjata...
Dialogue: 0,0:13:09.02,0:13:11.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kegigihannya memang luar biasa,\Nhanya saja...
Dialogue: 0,0:13:13.19,0:13:14.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shield Bash!
Dialogue: 0,0:13:56.40,0:13:58.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menang...
Dialogue: 0,0:14:01.20,0:14:04.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elymas yang menang!\NKamu menang!
Dialogue: 0,0:14:04.70,0:14:07.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kamu kenapa, Ruche?
Dialogue: 0,0:14:07.28,0:14:10.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah!\NAku benar-benar bersyukur!
Dialogue: 0,0:14:10.20,0:14:14.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah memutuskan\Nuntuk percaya padamu!
Dialogue: 0,0:14:14.04,0:14:17.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, gadis yang melawanmu\Nsangat mengerikan
Dialogue: 0,0:14:17.34,0:14:20.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menyerang dengan niat membunuhmu!
Dialogue: 0,0:14:20.05,0:14:22.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi cemas!
Dialogue: 0,0:14:26.89,0:14:29.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini berkatmu, Ruche.
Dialogue: 0,0:14:33.31,0:14:35.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elymas, bagaimana dengannya?
Dialogue: 0,0:14:35.69,0:14:38.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu cemas, dia cuma pingsan.
Dialogue: 0,0:14:39.48,0:14:42.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak mungkin.
Dialogue: 0,0:14:42.85,0:14:44.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini mustahil!
Dialogue: 0,0:14:47.53,0:14:49.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malice...
Dialogue: 0,0:14:49.49,0:14:53.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Suci dikalahkan Kesatria Kelas Berat?
Dialogue: 0,0:15:00.63,0:15:02.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Count Aizas.
Dialogue: 0,0:15:02.48,0:15:04.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini Anda sudah mengakuiku, kan?
Dialogue: 0,0:15:21.36,0:15:23.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuakui.
Dialogue: 0,0:15:23.36,0:15:26.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada kecurangan di serikat ini.
Dialogue: 0,0:15:28.70,0:15:30.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elymas.
Dialogue: 0,0:15:30.78,0:15:37.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kamu memang punya kemampuan\Nuntuk menumpas Master.
Dialogue: 0,0:15:45.25,0:15:50.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seorang bangsawan pantang bergumul,\Npantang bergaul dengan rakyat jelata.
Dialogue: 0,0:15:50.93,0:15:53.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pernah mengasihani mereka.
Dialogue: 0,0:15:54.41,0:15:57.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mempertahankan wibawa kitalah
Dialogue: 0,0:15:59.56,0:16:02.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang nantinya akan melindungi\Nrakyat serta wilayah kita.
Dialogue: 0,0:16:07.15,0:16:09.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan sekarang pun,
Dialogue: 0,0:16:09.03,0:16:13.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak buta dalam memercayai\Natau menghormati ayahku.
Dialogue: 0,0:16:13.54,0:16:19.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pria tanpa belas kasih,\Nkeras kepala, kejam, dan egois.
Dialogue: 0,0:16:19.97,0:16:21.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja,
Dialogue: 0,0:16:22.17,0:16:26.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalimat inilah yang selalu terngiang\Ndalam hatiku.
Dialogue: 0,0:16:27.09,0:16:31.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang hidup sebagai Elymas Edvaughn dan penerus\Nyang melindungi wilayah kekuasaan count...
Dialogue: 0,0:16:31.89,0:16:33.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:16:33.06,0:16:35.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak salah lagi adalah diriku.
Dialogue: 0,0:16:38.52,0:16:40.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahanda!
Dialogue: 0,0:16:42.27,0:16:46.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atas jasamu yang telah\Nmembesarkanku selama ini.
Dialogue: 0,0:16:48.32,0:16:50.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuucapkan terima kasih banyak!
Dialogue: 0,0:16:55.24,0:16:59.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}To-Tolong tunggu sebentar,\NCount Aizas!
Dialogue: 0,0:16:59.37,0:17:01.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong minta maaf pada Elymas!
Dialogue: 0,0:17:01.88,0:17:04.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah dibentak dan disalahkan seperti itu.
Dialogue: 0,0:17:04.04,0:17:06.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah tahu bahwa Anda yang salah,
Dialogue: 0,0:17:06.38,0:17:09.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa mau diakhiri dengan diam\Ndan pergi begitu saja?
Dialogue: 0,0:17:09.05,0:17:10.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche, tidak perlu begitu.
Dialogue: 0,0:17:10.58,0:17:14.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dia ayah kandungmu, kan?
Dialogue: 0,0:17:14.55,0:17:17.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah paham ini sudah teratasi,
Dialogue: 0,0:17:17.09,0:17:21.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kalau perpisahannya seperti ini,\Nrasanya sangat menyedihkan!
Dialogue: 0,0:17:24.48,0:17:26.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, gadis cilik.
Dialogue: 0,0:17:32.78,0:17:36.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jaga Elymas.
Dialogue: 0,0:18:03.91,0:18:07.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keesokan harinya,\Nkami yang telah beristirahat,
Dialogue: 0,0:18:08.44,0:18:11.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memutuskan pergi dari Kota Rondalm ini.
Dialogue: 0,0:18:17.45,0:18:19.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, apa kamu yakin?
Dialogue: 0,0:18:19.87,0:18:22.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sekarang meninggalkan\Nkampung halamanmu.
Dialogue: 0,0:18:22.50,0:18:24.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja bukan masalah!
Dialogue: 0,0:18:24.75,0:18:28.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahanda sudah memintaku menjagamu!
Dialogue: 0,0:18:28.25,0:18:29.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahanda?
Dialogue: 0,0:18:30.09,0:18:36.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, pada akhirnya orang itu\Ntetap tidak meminta maaf padamu.
Dialogue: 0,0:18:36.49,0:18:40.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena posisinya tidak mengizinkan\Nuntuk minta maaf semudah itu.
Dialogue: 0,0:18:40.02,0:18:45.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti dia juga sudah memperhatikan\Nsekitar dengan caranya sendiri.
Dialogue: 0,0:18:47.73,0:18:51.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu tak keberatan, ya sudah.
Dialogue: 0,0:18:52.99,0:18:55.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bangsawan akan tamat kalau diremehkan.
Dialogue: 0,0:18:56.41,0:19:01.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam arti lain, tidak meminta maaf\Njuga termasuk pekerjaannya.
Dialogue: 0,0:19:01.24,0:19:06.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedengarannya memang berat,\Ntapi aku tetap tidak suka.
Dialogue: 0,0:19:06.42,0:19:09.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elymas jangan jadi begitu, ya.
Dialogue: 0,0:19:09.25,0:19:14.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terjadi sesuatu,\Naku akan minta maaf bersamamu!
Dialogue: 0,0:19:14.01,0:19:15.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan begitu.
Dialogue: 0,0:19:15.59,0:19:17.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru, aku sudah tidak bisa\Njadi seperti itu.
Dialogue: 0,0:19:19.93,0:19:23.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, namaku sudah dicopot\Ndan diasingkan dari keluarga.
Dialogue: 0,0:19:23.64,0:19:24.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ehem!
Dialogue: 0,0:19:26.69,0:19:28.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf!\NAku minta maaf!
Dialogue: 0,0:19:28.40,0:19:32.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bilang begitu bukan karena\Ningin meledekmu!
Dialogue: 0,0:19:32.07,0:19:33.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini, maksudku...
Dialogue: 0,0:19:34.32,0:19:40.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku justru terkejut pria seangkuh itu\Nmau menyerahkanku padamu.
Dialogue: 0,0:19:40.66,0:19:43.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dia juga mengakuimu.
Dialogue: 0,0:19:45.75,0:19:50.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku dengan enteng bilang\Nbersyukur sudah keluar dari rumah itu,
Dialogue: 0,0:19:50.79,0:19:54.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa jadi itu hanya pura-pura tegar.
Dialogue: 0,0:19:54.42,0:19:58.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tidak salah lagi kondisi sekarang\Nlebih cocok bagiku.
Dialogue: 0,0:19:58.72,0:20:01.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang jelas, untuk ke depannya
Dialogue: 0,0:20:01.51,0:20:04.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aizas tidak akan merencanakan\Nsesuatu padaku lagi.
Dialogue: 0,0:20:05.52,0:20:09.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang jadi masalah justru Malice.
Dialogue: 0,0:20:10.31,0:20:13.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat menyukai kisah ini.
Dialogue: 0,0:20:13.40,0:20:17.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia yang berjuang sekuat tenaga\Nhancur berkeping-keping.
Dialogue: 0,0:20:19.66,0:20:21.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat menyukainya!
Dialogue: 0,0:20:21.58,0:20:24.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal dulunya dia tidak seperti itu.
Dialogue: 0,0:20:25.37,0:20:27.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Elymas?
Dialogue: 0,0:20:32.50,0:20:34.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, bukan apa-apa.
Dialogue: 0,0:20:37.88,0:20:40.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah mengucapkan perpisahan pada Aizas,
Dialogue: 0,0:20:40.43,0:20:45.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia pun memberiku ucapan penyemangat\Nmeski dengan cara yang berbelit.
Dialogue: 0,0:20:45.64,0:20:48.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Ruche tidak bersikeras memaksa Aizas,
Dialogue: 0,0:20:48.44,0:20:52.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti sekarang masih ada rasa tidak enak\Nyang tersisa di dalam hati.
Dialogue: 0,0:20:53.32,0:20:58.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, masalah dengan keluarga Edvaughn\Nbagiku sudah selesai.
Dialogue: 0,0:21:12.67,0:21:15.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Raid kali ini berjalan lancar, ya.\N- Bukankah senjata itu drop langka
Dialogue: 0,0:21:15.42,0:21:17.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari dungeon dengan rekomendasi level 50?
Dialogue: 0,0:21:17.46,0:21:19.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Maaf merepotkan terus.\N- Pelan-pelan saja bukan masalah.
Dialogue: 0,0:21:19.76,0:21:21.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, tunggu aku!
Dialogue: 0,0:21:22.18,0:21:23.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah sampai.
Dialogue: 0,0:21:33.15,0:21:37.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah kota petualang, Lacoryna!
Dialogue: 0,0:23:10.70,0:23:12.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertarungan melawan Malice.
Dialogue: 0,0:23:12.62,0:23:15.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perpisahan dengan Ayah\Ndan keluarga Count Edvaughn.
Dialogue: 0,0:23:15.71,0:23:19.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat Ruche, aku berhasil\Nmenuntaskan satu masalah hidupku.
Dialogue: 0,0:23:20.00,0:23:22.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, tempat baru yang kami datangi.
Dialogue: 0,0:23:22.26,0:23:25.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wilayah yang disebut sebagai\NTanah Suci Petualang, Lacoryna.
Dialogue: 0,0:23:25.43,0:23:29.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski bukan dalam gim, kota baru\Nmemang membuat hati berdebar!
Dialogue: 0,0:23:29.60,0:23:32.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, banyak yang harus dilakukan!
Dialogue: 0,0:23:32.97,0:23:36.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, Kota Petualang Lacoryna.
Dialogue: 0,0:23:36.35,0:23:39.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita mulai dulu\Ndari mencari perlengkapan!
