Dialogue: 0,0:01:40.46,0:01:43.79,sign,,0000,0000,0000,,KESATRIA KELAS BERAT TEREINKARNASI YANG DIASINGKAN\NJADI TANPA TANDING DENGAN PENGETAHUAN GIMNYA
Dialogue: 0,0:02:58.61,0:03:03.09,sign,,0000,0000,0000,,EPISODE 20: HILDE SI PENDEKAR PEDANG MAGIS
Dialogue: 0,0:08:08.38,0:08:10.47,sign,,0000,0000,0000,,LIFE SHIELD - SKILL BIASA
Dialogue: 0,0:09:07.90,0:09:10.03,sign,,0000,0000,0000,,DAYA PERTAHANAN: 0
Dialogue: 0,0:11:42.81,0:11:44.68,sign,,0000,0000,0000,,LIFE SHIELD
Dialogue: 0,0:12:48.08,0:12:50.17,sign,,0000,0000,0000,,PENUMBAL PERTAHANAN - SKILL BIASA
Dialogue: 0,0:16:56.87,0:17:00.87,sign,,0000,0000,0000,,PEDANG MYTHRIL
Dialogue: 0,0:17:00.87,0:17:04.03,sign,,0000,0000,0000,,REKOMENDASI PERLENGKAPAN: LV70
Dialogue: 0,0:00:29.17,0:00:30.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:00:30.93,0:00:35.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Pintunya terbuka.\N- Dasar kakek keras kepala!
Dialogue: 0,0:00:35.27,0:00:37.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan kuminta untuk diberikan padaku.
Dialogue: 0,0:00:37.64,0:00:40.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma ingin kamu menjual\Npedang ini padaku.
Dialogue: 0,0:00:40.23,0:00:42.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak punya senjata\Nuntuk dijual padamu!
Dialogue: 0,0:00:42.31,0:00:45.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ini kelihatan gawat!\N- Lagi pula, ini barang pesanan!
Dialogue: 0,0:00:46.15,0:00:47.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak apa-apa, Kek?
Dialogue: 0,0:00:47.53,0:00:50.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Pendekar Pedang Magis, sudahlah...
Dialogue: 0,0:00:51.01,0:00:53.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kamulah pemesannya?
Dialogue: 0,0:00:56.45,0:00:58.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir orangnya seperti apa.
Dialogue: 0,0:00:58.73,0:01:01.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kek, kamu menempa pedang mythril
Dialogue: 0,0:01:01.54,0:01:02.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- untuk orang yang kelihatan lemah\N- Suaranya terdengar,
Dialogue: 0,0:01:02.67,0:01:04.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- seperti mereka, ya?\N- tapi tidak kelihatan wujudnya?
Dialogue: 0,0:01:04.04,0:01:07.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata Veruga si Pandai Besi\Njuga tidak kuat melawan kemiskinan.
Dialogue: 0,0:01:07.55,0:01:08.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini skill, ya?
Dialogue: 0,0:01:08.55,0:01:10.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elymas, di bawah!
Dialogue: 0,0:01:11.18,0:01:12.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat ke bawah!
Dialogue: 0,0:01:17.94,0:01:22.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu, sedang meremehkanku, ya?
Dialogue: 0,0:01:22.48,0:01:23.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si—
Dialogue: 0,0:01:23.60,0:01:26.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa bocil ini?
Dialogue: 0,0:02:58.61,0:03:03.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu, sedang meremehkanku, ya?
Dialogue: 0,0:03:03.09,0:03:05.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau bilang sesuatu,\Nkatakan saja di depanku!
Dialogue: 0,0:03:05.85,0:03:06.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak kecil?
Dialogue: 0,0:03:06.92,0:03:09.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dia punya kelas.
Dialogue: 0,0:03:09.15,0:03:11.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti sudah Ritual Berkat Ilahi\Ndan berusia 15 tahun?
Dialogue: 0,0:03:11.55,0:03:13.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku 17 tahun.
Dialogue: 0,0:03:13.97,0:03:15.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata lebih tua dariku!
Dialogue: 0,0:03:15.68,0:03:18.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya kamu meremehkanku, ya.
Dialogue: 0,0:03:18.22,0:03:19.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, sialan.
Dialogue: 0,0:03:19.39,0:03:24.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pernah dengar Pendekar Pedang Magis\Nyang dijuluki Pedang Api Hitam?
Dialogue: 0,0:03:27.13,0:03:30.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu julukan yang kudengar\Nsaat mengumpulkan informasi di Lacoryna.
Dialogue: 0,0:03:31.19,0:03:32.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Api Hitam.
Dialogue: 0,0:03:33.14,0:03:36.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia salah satu petualang kelas A\Nyang bahkan di Lacoryna ini
Dialogue: 0,0:03:36.45,0:03:38.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jumlahnya bisa dihitung jari.
Dialogue: 0,0:03:42.12,0:03:43.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan kututup-tutupi.
Dialogue: 0,0:03:43.87,0:03:48.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Hilde ini adalah murid nomor satu\Ndari petualang ternama
Dialogue: 0,0:03:51.00,0:03:54.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sang Pedang Api Hitam itu!
Dialogue: 0,0:03:58.34,0:04:00.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Begitu, ya.
Dialogue: 0,0:04:00.68,0:04:02.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu hebat sekali.
Dialogue: 0,0:04:03.18,0:04:06.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau pemiliknya sudah datang,\Nini bisa mudah diselesaikan.
Dialogue: 0,0:04:06.35,0:04:10.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pasti lebih bisa diajak bicara\Ndibanding kakek keras kepala ini.
Dialogue: 0,0:04:10.56,0:04:13.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang mau kubilang itu cuma satu.
Dialogue: 0,0:04:13.76,0:04:16.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jual pedang mythril itu padaku.
Dialogue: 0,0:04:16.07,0:04:17.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mau.
Dialogue: 0,0:04:17.73,0:04:20.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pesan untuk dibuatkan\Nkarena membutuhkannya.
Dialogue: 0,0:04:20.87,0:04:23.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sok keras begitu,\NKesatria Kelas Berat.
Dialogue: 0,0:04:23.45,0:04:26.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelas ampas sepertimu\Nmau punya perlengkapan
Dialogue: 0,0:04:26.00,0:04:29.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebagus itu pun tidak berarti apa-apa!
Dialogue: 0,0:04:29.04,0:04:31.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat apa keroco punya pedang bagus?
Dialogue: 0,0:04:31.92,0:04:34.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sama sekali tidak paham\Ndunia ini rupanya.
Dialogue: 0,0:04:34.50,0:04:37.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan kutawar dengan sadis.
Dialogue: 0,0:04:37.63,0:04:40.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kubayar 30 juta Gold harusnya cukup, kan?
Dialogue: 0,0:04:41.39,0:04:43.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nominal sebesar ini pasti\Ntidak terbayang olehmu—
Dialogue: 0,0:04:43.89,0:04:45.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, tidak mau.
Dialogue: 0,0:04:45.31,0:04:45.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:04:45.89,0:04:48.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uang 30 juta itu tidak ada apa-apanya.
Dialogue: 0,0:04:49.52,0:04:51.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Bocah!
Dialogue: 0,0:04:51.35,0:04:55.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tubuhnya mungil,\Nkemampuannya tidak bisa diremehkan.
Dialogue: 0,0:04:55.61,0:04:57.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa katamu, Kakek sialan?
Dialogue: 0,0:04:57.03,0:05:02.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia petualang kelas B dan punya riwayat\Nmengalahkan master seorang diri.
Dialogue: 0,0:05:03.03,0:05:04.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, itu benar.
Dialogue: 0,0:05:04.99,0:05:09.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sifatnya sangat busuk,\Njadi jangan sembarangan dijadikan musuh.
Dialogue: 0,0:05:09.50,0:05:10.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Woi!
Dialogue: 0,0:05:10.50,0:05:13.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kamu benci orang seperti itu,
Dialogue: 0,0:05:13.13,0:05:16.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}makanya rela menolak pekerjaan\Ndemi menjaga prinsipmu?
Dialogue: 0,0:05:16.70,0:05:18.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga benci bocah ini.
Dialogue: 0,0:05:18.97,0:05:20.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ingin bernegosiasi.
Dialogue: 0,0:05:20.38,0:05:21.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Woi!
Dialogue: 0,0:05:21.38,0:05:26.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tekadku sudah bulat untuk melakukan ini,\Ntapi kalian masih muda.
Dialogue: 0,0:05:26.41,0:05:29.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya jangan menambah\Nmusuh di serikat.
Dialogue: 0,0:05:29.81,0:05:32.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan saja ini padaku.
Dialogue: 0,0:05:32.06,0:05:33.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya dia aslinya baik hati.
Dialogue: 0,0:05:33.90,0:05:35.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu cemas.
Dialogue: 0,0:05:35.91,0:05:37.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami ini petualang.
Dialogue: 0,0:05:37.73,0:05:41.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sampai jadi seperti itu,\Ntinggal pergi saja ke kota lain.
Dialogue: 0,0:05:42.41,0:05:45.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak merasa\Nlebih lemah dari bocah ini.
Dialogue: 0,0:06:03.43,0:06:05.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reaksimu bagus juga.
Dialogue: 0,0:06:05.22,0:06:07.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, statusmu terlalu menyedihkan.
Dialogue: 0,0:06:07.89,0:06:10.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah batasan Kesatria Kelas Berat.
Dialogue: 0,0:06:10.27,0:06:11.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung saja.
Dialogue: 0,0:06:11.64,0:06:15.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau saja aku sedikit lebih emosi lagi,\Nkamu sudah kubunuh di sini.
Dialogue: 0,0:06:15.31,0:06:18.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Punya senjata yang tidak pantas\Ncuma akan membuatmu mati.
Dialogue: 0,0:06:19.23,0:06:21.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut saja dan jual pedang itu!
Dialogue: 0,0:06:21.99,0:06:24.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kamu tidak apa-apa, Elymas?
Dialogue: 0,0:06:24.66,0:06:28.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mi-Mikir apa kamu ini tiba-tiba seperti itu?
Dialogue: 0,0:06:28.62,0:06:32.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma kutunjukkan dengan jelas\Nkalau kemampuannya itu kurang.
Dialogue: 0,0:06:32.56,0:06:36.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan kejutan tidak bisa\Nmembuktikan perbedaan kemampuan kita.
Dialogue: 0,0:06:36.33,0:06:37.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:06:37.37,0:06:38.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus apa?
Dialogue: 0,0:06:38.34,0:06:40.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau duel denganku?
Dialogue: 0,0:06:40.42,0:06:44.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau berani taruhan pedang mythril,\Nakan kuterima tantanganmu itu.
Dialogue: 0,0:06:45.06,0:06:47.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sendiri akan bertaruh apa?
Dialogue: 0,0:06:47.68,0:06:50.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin aku akan kalah!
Dialogue: 0,0:06:50.60,0:06:54.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain berhenti mengejar pedang itu,\Nakan kubayar juga harga pasarnya padamu.
Dialogue: 0,0:06:54.98,0:06:56.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:06:56.15,0:06:59.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang kamu sudah tidak punya\Nalasan untuk mundur.
Dialogue: 0,0:06:59.11,0:07:01.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terima tawarannya, Bocah!
Dialogue: 0,0:07:01.48,0:07:04.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pendekar Pedang Magis itu\Nahli bertarung satu lawan satu.
Dialogue: 0,0:07:04.78,0:07:09.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duel mengadu kekuatan mentah\Nitu sejak awal tidaklah adil.
Dialogue: 0,0:07:10.37,0:07:12.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu yakin dengan taruhanmu, kan?
Dialogue: 0,0:07:12.58,0:07:14.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Nbiar kuterima dengan senang hati.
Dialogue: 0,0:07:17.29,0:07:19.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Ini jelas tidak bagus!
Dialogue: 0,0:07:19.88,0:07:22.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lawanmu Pendekar Pedang Magis kelas B!
Dialogue: 0,0:07:22.30,0:07:26.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pun tahu kalau kelas itu\Ntak tertandingi dalam duel!
Dialogue: 0,0:07:26.57,0:07:31.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya mau kuabaikan begitu saja,\Ntapi aku telanjur sedikit kesal.
Dialogue: 0,0:07:31.14,0:07:32.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elymas?
Dialogue: 0,0:07:32.31,0:07:35.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan dilewatkan kalau bisa\Ndapat beberapa puluh juta dengan mudah.
Dialogue: 0,0:07:35.81,0:07:38.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kuberi kamu sedikit pelajaran, Hilde.
Dialogue: 0,0:07:38.56,0:07:40.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung saja kamu bodoh!
Dialogue: 0,0:07:40.98,0:07:42.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar kamu tidak bisa mengelak,
Dialogue: 0,0:07:42.44,0:07:45.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan kupanggil pegawai serikat\Nuntuk jadi wasit.
Dialogue: 0,0:07:45.74,0:07:47.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menyesal, ya!
Dialogue: 0,0:08:02.55,0:08:05.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya sebentar lagi Hilde akan kembali.
Dialogue: 0,0:08:08.38,0:08:10.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Life Shield!
Dialogue: 0,0:08:13.89,0:08:17.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bocah, apa yang terus kamu\Nlakukan dari tadi?
Dialogue: 0,0:08:17.98,0:08:22.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maumu membatalkan skill\Nyang sudah kamu aktifkan?
Dialogue: 0,0:08:22.48,0:08:24.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sama sekali tidak paham!
Dialogue: 0,0:08:24.66,0:08:26.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk menjaga HP-ku.
Dialogue: 0,0:08:26.28,0:08:27.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku makin tidak paham.
Dialogue: 0,0:08:28.41,0:08:30.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu bisa menang, Elymas?
Dialogue: 0,0:08:30.99,0:08:35.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini akan bergantung sama\NAmukan Naga di Ambang Ajal, kan?
Dialogue: 0,0:08:36.25,0:08:40.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penumbal Pertahanan juga\Ntidak ada manfaatnya digunakan.
Dialogue: 0,0:08:40.33,0:08:41.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar.
Dialogue: 0,0:08:43.00,0:08:45.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penumbal Pertahanan!
Dialogue: 0,0:08:57.52,0:09:00.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski daya serangku jadi enam kali lipat\Ndengan Penumbal Pertahanan,
Dialogue: 0,0:09:00.98,0:09:03.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya akan jadi dampak berlebih.
Dialogue: 0,0:09:03.63,0:09:07.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya pertahananku juga jadi nol,\Nkalau lawannya punya serangan jarak jauh,
Dialogue: 0,0:09:07.90,0:09:10.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami berdua akan sama-sama mati.
Dialogue: 0,0:09:11.45,0:09:15.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pendekar Pedang Magis jauh lebih\Nmerepotkan daripada Pedang Suci.
Dialogue: 0,0:09:15.50,0:09:18.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain daya ledak instan\Ndan teknik berpedang,
Dialogue: 0,0:09:18.49,0:09:21.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka punya serangan sihir jarak jauh\Nyang praktis.
Dialogue: 0,0:09:24.54,0:09:27.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya memang lebih baik\Nkamu sekarang lari saja.
Dialogue: 0,0:09:27.88,0:09:29.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja peluang menangnya masih ada.
Dialogue: 0,0:09:30.17,0:09:33.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya aku enggan karena ini agak licik,
Dialogue: 0,0:09:33.26,0:09:36.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi Pendekar Pedang Magis\Npunya kecenderungan cara pikir.
Dialogue: 0,0:09:36.06,0:09:39.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Elymas memasang muka jahat!
Dialogue: 0,0:09:43.03,0:09:45.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubawa ke sini, Kesatria Kelas Berat!
Dialogue: 0,0:09:46.32,0:09:49.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak berbuat aneh-aneh\Npada pedangku, kan?
Dialogue: 0,0:09:50.28,0:09:53.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku diseret ke sini karena ada\NKesatria Kelas Berat yang sombong,
Dialogue: 0,0:09:53.91,0:09:56.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ternyata memang kalian.
Dialogue: 0,0:09:56.45,0:09:58.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elymas dan Ruche.
Dialogue: 0,0:10:08.25,0:10:11.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo cepat kita mulai, Kesatria Kelas Berat.
Dialogue: 0,0:10:13.30,0:10:15.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pendekar Pedang Magis\Nmelawan Kesatria Kelas Berat.
Dialogue: 0,0:10:16.64,0:10:19.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini lawan duel yang buruk.
Dialogue: 0,0:10:19.14,0:10:22.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}HP-ku bisa dikikis\Ndengan sihir jarak menengah.
Dialogue: 0,0:10:22.02,0:10:24.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Didekati pun hanya akan dibalas\Ndengan teknik pedang.
Dialogue: 0,0:10:26.27,0:10:30.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Pendekar Pedang Magis\Npunya kebiasaan berpikir.
Dialogue: 0,0:10:30.86,0:10:34.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, kemungkinan kebiasaan itu\Ncukup parah untuk Hilde.
Dialogue: 0,0:10:47.63,0:10:48.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wasit.
Dialogue: 0,0:10:49.17,0:10:51.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang ingin kupastikan sebelum berduel.
Dialogue: 0,0:10:51.63,0:10:53.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memastikan apa, Elymas?
Dialogue: 0,0:10:53.47,0:10:57.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena bertarung dengan skill,\Nbisa saja terjadi hal yang tidak diinginkan.
Dialogue: 0,0:10:57.68,0:11:00.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa jadinya kalau sampai\Nmembuat lawan terbunuh?
Dialogue: 0,0:11:00.51,0:11:01.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:11:01.39,0:11:06.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kedua pihak setuju berduel\Ndengan menyadari risiko bahayanya."
Dialogue: 0,0:11:06.17,0:11:09.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami menjadi wasit atas dasar itu.
Dialogue: 0,0:11:09.77,0:11:12.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau khawatir,\Nbagaimana kalau dibatalkan saja?
Dialogue: 0,0:11:12.44,0:11:15.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku senang bisa memastikannya.
Dialogue: 0,0:11:15.11,0:11:17.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo cepat kita mulai, Hilde.
Dialogue: 0,0:11:18.87,0:11:21.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pancinganmu murahan sekali.
Dialogue: 0,0:11:21.08,0:11:23.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak keberatan dengan\Nkesadaran seperti itu.
Dialogue: 0,0:11:28.21,0:11:29.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jaraknya lumayan.
Dialogue: 0,0:11:29.92,0:11:32.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini jarak serang kelas spesialis sihir, ya.
Dialogue: 0,0:11:35.67,0:11:36.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:11:36.95,0:11:38.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai!
Dialogue: 0,0:11:42.81,0:11:44.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Life Shield!
Dialogue: 0,0:12:23.64,0:12:24.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:12:24.72,0:12:26.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aneh sekali skill-nya.
Dialogue: 0,0:12:42.27,0:12:43.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill itu...
Dialogue: 0,0:12:43.95,0:12:47.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya bahaya dipakai dalam duel!
Dialogue: 0,0:12:51.00,0:12:53.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi-lagi skill yang aneh.
Dialogue: 0,0:12:53.45,0:12:56.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditambah reaksi wanita itu...
Dialogue: 0,0:12:57.76,0:12:59.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini...
Dialogue: 0,0:13:15.07,0:13:17.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kuawasi dulu dari jarak jauh!
Dialogue: 0,0:13:50.56,0:13:53.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:13:57.15,0:14:00.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, kondisinya lumayan.
Dialogue: 0,0:14:04.24,0:14:06.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu! Tunggu dulu!
Dialogue: 0,0:14:06.28,0:14:08.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita jeda dulu!\NBerhenti dulu sebentar!
Dialogue: 0,0:14:09.20,0:14:11.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti!
Dialogue: 0,0:14:11.83,0:14:13.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah membuang senjata!
Dialogue: 0,0:14:13.83,0:14:15.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak dengar, ya?
Dialogue: 0,0:14:15.33,0:14:16.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jeda dulu! Jeda!
Dialogue: 0,0:14:17.46,0:14:19.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius, tolong berhenti!
Dialogue: 0,0:14:19.88,0:14:22.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Me-Menyerah!
Dialogue: 0,0:14:22.17,0:14:23.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menyerah!
Dialogue: 0,0:14:23.38,0:14:24.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuakui kekalahanku!
Dialogue: 0,0:14:24.89,0:14:26.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengaku kalah!
Dialogue: 0,0:14:27.14,0:14:31.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kecenderungan Pendekar Pedang Magis\Nadalah mengutamakan keselamatan diri.
Dialogue: 0,0:14:32.76,0:14:34.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Pendekar Pedang Magis yang lemah di daya tahan\N- Kumohon, jangan mendekat!
Dialogue: 0,0:14:34.85,0:14:36.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- dan mengandalkan daya rusak tinggi\N- Kumohon, jangan mendekat!
Dialogue: 0,0:14:36.86,0:14:38.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- dari skill dengan efek samping.\N- Aku menyerah!
Dialogue: 0,0:14:38.65,0:14:41.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Bisa mudah kehilangan nyawa\N- Hentikan dia!
Dialogue: 0,0:14:41.07,0:14:42.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- kalau sedikit saja salah mengambil langkah.\N- Aku takut!
Dialogue: 0,0:14:42.90,0:14:45.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau diancam, mereka akan ciut.
Dialogue: 0,0:14:45.23,0:14:47.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin akan hal itu.
Dialogue: 0,0:14:48.66,0:14:50.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong umumkan hasil duelnya.
Dialogue: 0,0:14:50.54,0:14:51.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik!
Dialogue: 0,0:14:51.91,0:14:55.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemenangnya Elymas!
Dialogue: 0,0:14:57.92,0:15:00.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ja-Jangan bercanda!
Dialogue: 0,0:15:00.42,0:15:02.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bilang untuk dijeda!
Dialogue: 0,0:15:02.67,0:15:07.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak mau berhenti, jadi aku tidak punya\Npilihan selain bilang menyerah!
Dialogue: 0,0:15:07.22,0:15:09.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sendiri bilang tidak punya pilihan.
Dialogue: 0,0:15:09.22,0:15:10.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hilde.
Dialogue: 0,0:15:10.76,0:15:16.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meminta duel dijeda karena merasa terancam\Nsetelah melihat skill musuhmu,
Dialogue: 0,0:15:16.02,0:15:20.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu tidak bisa serikat terima\Nsebagai alasan yang sah.
Dialogue: 0,0:15:21.53,0:15:23.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena sudah diminta menjadi wasit,
Dialogue: 0,0:15:23.82,0:15:28.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami akan memberi sanksi yang sepadan\Nkalau kamu tidak mau mematuhinya.
Dialogue: 0,0:15:28.57,0:15:31.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku tahu itu!
Dialogue: 0,0:15:31.37,0:15:36.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin sekarang aku bilang sesuatu\Nyang membatalkan duelnya!
Dialogue: 0,0:15:36.33,0:15:38.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar, Elymas!
Dialogue: 0,0:15:38.21,0:15:40.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mintanya dijeda!
Dialogue: 0,0:15:40.50,0:15:45.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan pertimbangan itu,\Nbisa tidak kalau jadi bayar 20 juta Gold saja?
Dialogue: 0,0:15:47.68,0:15:50.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlalu berat kalau 30 juta Gold...
Dialogue: 0,0:15:50.72,0:15:51.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa.
Dialogue: 0,0:15:51.76,0:15:53.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyedihkan sekali...
Dialogue: 0,0:15:53.49,0:15:55.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski aku paham perasaannya.
Dialogue: 0,0:15:55.39,0:16:00.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku harus dapat senjata\Nyang cocok dengan levelku!
Dialogue: 0,0:16:00.40,0:16:03.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemajuan seorang petualang kelas atas
Dialogue: 0,0:16:03.03,0:16:07.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa menyelamatkan kota dari bahaya\Ndan mengurangi kerusakan dari monster!
Dialogue: 0,0:16:07.15,0:16:10.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuakui kalau tindakanku tidak tepat.
Dialogue: 0,0:16:10.24,0:16:12.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bersumpah tidak akan\Nbertindak begini lagi!
Dialogue: 0,0:16:12.99,0:16:14.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baguslah kalau mengerti.
Dialogue: 0,0:16:15.75,0:16:19.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ja-Jadi, bisa tidak kalau 20 juta Gold saja?
Dialogue: 0,0:16:19.92,0:16:21.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa.
Dialogue: 0,0:16:25.84,0:16:28.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}He-Hei, Bocah.
Dialogue: 0,0:16:30.27,0:16:33.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sebenarnya ragu untuk bilang sekarang,
Dialogue: 0,0:16:33.43,0:16:38.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi harga pasar pedang ini\Nbukan 30 juta Gold.
Dialogue: 0,0:16:39.23,0:16:40.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah itu?
Dialogue: 0,0:16:40.56,0:16:43.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang ternyata barang palsu!
Dialogue: 0,0:16:44.61,0:16:48.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taruhanku tadi membayar\Nsenilai harga pasarnya, kan?
Dialogue: 0,0:16:50.20,0:16:52.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, bikin panik saja!
Dialogue: 0,0:16:52.37,0:16:56.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kalian periksa saja sendiri.
Dialogue: 0,0:16:56.87,0:17:00.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Mythril, daya serang +46.
Dialogue: 0,0:17:00.87,0:17:04.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harga jual: 51,5 juta Gold.
Dialogue: 0,0:17:04.03,0:17:06.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang sihir\Nberselimut pendaran mana yang kuat.
Dialogue: 0,0:17:06.95,0:17:09.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Telah ditanami Rune Kehancuran.
Dialogue: 0,0:17:09.88,0:17:14.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Li-Lima puluh satu koma lima juta Gold?
Dialogue: 0,0:17:14.64,0:17:18.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, aku lupa harga rune-nya.
Dialogue: 0,0:17:18.14,0:17:19.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cerobohnya aku.
Dialogue: 0,0:17:20.18,0:17:21.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hilde.
Dialogue: 0,0:17:21.02,0:17:24.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harga pasarnya ternyata 51,5 juta Gold.
Dialogue: 0,0:17:25.04,0:17:26.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bercanda!
Dialogue: 0,0:17:26.53,0:17:28.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin bisa kubayar!
Dialogue: 0,0:17:28.44,0:17:31.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana bisa aku terima begitu saja\Nkalau semahal itu!
Dialogue: 0,0:17:31.41,0:17:33.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon!
Dialogue: 0,0:17:33.16,0:17:35.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong turunkan jadi 40 juta Gold!
Dialogue: 0,0:17:35.91,0:17:38.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kamu ini mau marah atau memohon,\N- Kumohon, tolong kasihani aku...
Dialogue: 0,0:17:38.12,0:17:39.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- bisa tidak pilih salah satu saja?\N- Kumohon, tolong kasihani aku...
Dialogue: 0,0:17:40.44,0:17:43.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kasihani aku!\N- Aku jadi agak kasihan padanya.
Dialogue: 0,0:17:43.04,0:17:45.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kumohon kasihani aku!\N- Benar juga.
Dialogue: 0,0:17:45.17,0:17:48.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sejujurnya, alasan utamaku hanya ingin\N- Tolong kasihani aku!
Dialogue: 0,0:17:48.38,0:17:50.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- memberi dia sedikit pelajaran.\N- Tolong kasihani aku!
Dialogue: 0,0:17:52.22,0:17:55.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kupotong 1,5 juta\Ndan kita sepakati di 50 juta Gold saja.
Dialogue: 0,0:17:55.89,0:17:56.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alamak!
Dialogue: 0,0:18:12.90,0:18:17.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau untuk petualang kelas B,\Nkami bisa meminjamkan uang.
Dialogue: 0,0:19:05.33,0:19:06.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elymas, ya?
Dialogue: 0,0:19:06.83,0:19:08.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengenai duel tempo hari,
Dialogue: 0,0:19:08.92,0:19:13.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami ingin melaporkan bahwa sudah ada\Npembayaran sebesar 50 juta Gold dari Hilde.
Dialogue: 0,0:19:13.43,0:19:15.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia benaran bisa membayarnya?
Dialogue: 0,0:19:15.30,0:19:17.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal baru dua hari.
Dialogue: 0,0:19:17.39,0:19:21.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sudah terbiasa menengahi\Npertikaian antarpetualang.
Dialogue: 0,0:19:21.26,0:19:24.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau serikat sudah mau turun tangan...
Dialogue: 0,0:19:25.27,0:19:26.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Empat puluh juta!
Dialogue: 0,0:19:26.85,0:19:29.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, bagaimana kalau 45 juta saja?
Dialogue: 0,0:19:31.15,0:19:35.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, 50 juta!\NAkan kubayar 50 juta!
Dialogue: 0,0:19:40.33,0:19:41.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketemu!
Dialogue: 0,0:19:41.66,0:19:42.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian!
Dialogue: 0,0:19:42.95,0:19:47.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuambil lagi 50 juta Gold\Nyang kalian rebut dariku!
Dialogue: 0,0:19:50.92,0:19:53.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.\NDia menjual senjatanya, ya.
Dialogue: 0,0:19:53.55,0:19:54.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kabur, Ruche!
Dialogue: 0,0:19:54.88,0:19:55.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:19:57.61,0:19:58.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan harap bisa kabur!
Dialogue: 0,0:20:05.18,0:20:06.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hilde.
Dialogue: 0,0:20:16.84,0:20:19.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia Kesatria Kelas Berat yang kamu maksud?
Dialogue: 0,0:20:31.25,0:20:34.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penampilan dan auranya ini...
Dialogue: 0,0:20:39.01,0:20:42.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinan dialah yang disebut
Dialogue: 0,0:20:42.50,0:20:44.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Api Hitam!
Dialogue: 0,0:20:49.81,0:20:52.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, Master!\NMereka orangnya!
Dialogue: 0,0:20:52.36,0:20:56.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sudah merebut uangku\Ndengan cara yang licik!
Dialogue: 0,0:21:03.74,0:21:05.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata benar.
Dialogue: 0,0:21:06.47,0:21:08.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelasku Pendekar Pedang Magis.
Dialogue: 0,0:21:09.02,0:21:11.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Carlos, petualang kelas A.
Dialogue: 0,0:21:12.62,0:21:16.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi ingin bertemu denganmu\Nsetelah mendengar cerita Hilde.
Dialogue: 0,0:21:21.78,0:21:23.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elymas si Kesatria Kelas Berat.
Dialogue: 0,0:23:11.34,0:23:15.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang muncul di hadapan kami adalah\NCarlos si Pendekar Pedang Magis.
Dialogue: 0,0:23:15.62,0:23:19.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masternya Hilde sekaligus\Npetualang kelas A kebanggaan Lacoryna.
Dialogue: 0,0:23:20.38,0:23:22.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dialah yang dijuluki Pedang Api Hitam.
Dialogue: 0,0:23:23.63,0:23:25.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira dia ingin membahas soal Hilde,
Dialogue: 0,0:23:25.72,0:23:29.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi topik yang dibawa Carlos\Nternyata lebih penting
Dialogue: 0,0:23:29.43,0:23:32.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan misi yang bagiku juga\Ntak bisa dihindari.
Dialogue: 0,0:23:33.18,0:23:35.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, Pedang Api Hitam.
Dialogue: 0,0:23:35.94,0:23:38.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertarungan terbesar yang ada\Nhingga saat ini akan dimulai.
