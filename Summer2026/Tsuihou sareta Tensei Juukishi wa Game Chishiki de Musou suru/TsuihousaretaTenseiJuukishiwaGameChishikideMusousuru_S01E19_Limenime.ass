Dialogue: 0,0:00:57.50,0:01:00.83,sign,,0000,0000,0000,,KESATRIA KELAS BERAT TEREINKARNASI YANG DIASINGKAN\NJADI TANPA TANDING DENGAN PENGETAHUAN GIMNYA
Dialogue: 0,0:02:17.37,0:02:19.19,sign,,0000,0000,0000,,EPISODE 19: RATU KLAN PEMANCING
Dialogue: 0,0:03:47.92,0:03:50.75,sign,,0000,0000,0000,,DAPAT
Dialogue: 0,0:04:06.56,0:04:07.89,sign,,0000,0000,0000,,WADUH
Dialogue: 0,0:04:07.89,0:04:11.40,sign,,0000,0000,0000,,GELEPAR, GELEPAR
Dialogue: 0,0:04:11.40,0:04:12.87,sign,,0000,0000,0000,,JULUKAN: SHARK HUNTER
Dialogue: 0,0:04:12.87,0:04:14.07,sign,,0000,0000,0000,,JULUKAN: RAJA PEMANCING PENUNGGU
Dialogue: 0,0:05:40.78,0:05:42.97,sign,,0000,0000,0000,,JORAN RED TORRENT
Dialogue: 0,0:05:42.97,0:05:44.78,sign,,0000,0000,0000,,HARGA PASAR: 2,5 JUTA G
Dialogue: 0,0:06:06.76,0:06:07.92,sign,,0000,0000,0000,,RUNE KAWANAN IKAN
Dialogue: 0,0:06:07.92,0:06:10.22,sign,,0000,0000,0000,,HARGA PASAR: 500 RIBU G
