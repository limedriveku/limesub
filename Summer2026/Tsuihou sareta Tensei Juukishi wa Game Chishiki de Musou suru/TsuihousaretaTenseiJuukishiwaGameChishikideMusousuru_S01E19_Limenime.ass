Dialogue: 0,0:06:31.33,0:06:33.25,sign,,0000,0000,0000,,HARGA PASAR: 100 RIBU G
Dialogue: 0,0:09:58.08,0:10:00.70,sign,,0000,0000,0000,,KLAN PEMANCING - TARING NAGA LAUT
Dialogue: 0,0:15:30.37,0:15:31.62,sign,,0000,0000,0000,,RATU MARY VS KESATRIA KELAS BERAT ELYMAS
Dialogue: 0,0:15:31.62,0:15:33.33,sign,,0000,0000,0000,,ATURAN DUEL MEMANCING
Dialogue: 0,0:15:35.58,0:15:36.58,sign,,0000,0000,0000,,BATAS WAKTU: 2 JAM
Dialogue: 0,0:15:40.50,0:15:41.38,sign,,0000,0000,0000,,SYARAT MENANG: TOTAL HARGA PASAR TERTINGGI\NDARI IKAN YANG DITANGKAP
Dialogue: 0,0:15:41.38,0:15:44.51,sign,,0000,0000,0000,,LARANGAN KERAS: MELAKUKAN SABOTASE
Dialogue: 0,0:16:20.99,0:16:22.11,sign,,0000,0000,0000,,SALMON OGRE:
Dialogue: 0,0:16:22.11,0:16:24.09,sign,,0000,0000,0000,,HARGA PASAR 80 RIBU G
