Dialogue: 0,0:02:31.46,0:02:34.80,sign,,0000,0000,0000,,KESATRIA KELAS BERAT TEREINKARNASI YANG DIASINGKAN\NJADI TANPA TANDING DENGAN PENGETAHUAN GIMNYA
Dialogue: 0,0:03:49.00,0:03:54.09,sign,,0000,0000,0000,,EPISODE 14: RAKSASA PERAK MAGIS
Dialogue: 0,0:04:11.73,0:04:14.88,sign,,0000,0000,0000,,MONSTER: CRY
Dialogue: 0,0:04:47.06,0:04:49.31,sign,,0000,0000,0000,,DROP LANGKA!
Dialogue: 0,0:04:49.31,0:04:51.40,sign,,0000,0000,0000,,CETANG, CETING
Dialogue: 0,0:07:57.96,0:08:01.46,sign,,0000,0000,0000,,WEBEK, WEBEK
Dialogue: 0,0:08:38.78,0:08:41.66,sign,,0000,0000,0000,,DAYA SERANG: 78
Dialogue: 0,0:08:41.66,0:08:43.50,sign,,0000,0000,0000,,DAYA PERTAHANAN: 66
Dialogue: 0,0:08:43.50,0:08:47.97,sign,,0000,0000,0000,,PENYEMBUHAN OTOMATIS
Dialogue: 0,0:10:45.42,0:10:51.13,sign,,0000,0000,0000,,MONSTER: MYTHRIL GOLEM
Dialogue: 0,0:13:45.05,0:13:46.76,sign,,0000,0000,0000,,PARRY
Dialogue: 0,0:14:02.32,0:14:04.03,sign,,0000,0000,0000,,SHIELD BASH
