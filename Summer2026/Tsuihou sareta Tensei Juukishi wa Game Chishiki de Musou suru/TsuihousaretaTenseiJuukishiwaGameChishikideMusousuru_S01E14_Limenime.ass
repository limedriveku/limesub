Dialogue: 0,0:16:02.19,0:16:03.32,sign,,0000,0000,0000,,PENGINJAK BAYANG
Dialogue: 0,0:16:50.82,0:16:51.82,sign,,0000,0000,0000,,ELYMAS EDVAUGHN LV46
Dialogue: 0,0:17:02.99,0:17:04.58,sign,,0000,0000,0000,,LIFE SHIELD
Dialogue: 0,0:17:15.09,0:17:16.59,sign,,0000,0000,0000,,PENGINJAK BAYANG
Dialogue: 0,0:17:20.44,0:17:21.94,sign,,0000,0000,0000,,SHIELD BASH
Dialogue: 0,0:17:52.93,0:17:54.22,sign,,0000,0000,0000,,PARRY
Dialogue: 0,0:19:18.85,0:19:22.64,sign,,0000,0000,0000,,MENDAPAT 1342 POIN PENGALAMAN
Dialogue: 0,0:00:09.20,0:00:10.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shield Bash!
Dialogue: 0,0:00:13.24,0:00:14.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche!
Dialogue: 0,0:00:14.45,0:00:17.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dice Thrust!
Dialogue: 0,0:00:17.79,0:00:19.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kritikal.
Dialogue: 0,0:00:21.13,0:00:23.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat Cry sudah tidak ada,
Dialogue: 0,0:00:23.50,0:00:27.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}biar kutunjukkan bagaimana jadinya\Nnasib para Smile seperti kalian.
Dialogue: 0,0:00:27.72,0:00:28.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Parry!
Dialogue: 0,0:00:28.63,0:00:32.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian akan jadi pinball\Nkarena kehilangan komando!
Dialogue: 0,0:00:41.10,0:00:42.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tebasan Vital!
Dialogue: 0,0:00:42.65,0:00:44.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin kubiarkan kabur!
Dialogue: 0,0:00:44.27,0:00:45.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penginjak Bayang!
Dialogue: 0,0:00:46.23,0:00:48.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baja hitammu milik kami!
Dialogue: 0,0:00:49.99,0:00:53.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira di sini harus memakai\NAmukan Naga di Ambang Ajal,
Dialogue: 0,0:00:53.74,0:00:55.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}malah bisa menyisihkan tenaga.
Dialogue: 0,0:00:55.45,0:00:57.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elymas sangat bisa diandalkan.
Dialogue: 0,0:00:57.54,0:00:59.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga harus berjuang!
Dialogue: 0,0:01:15.51,0:01:16.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti, Ruche!
Dialogue: 0,0:01:26.86,0:01:29.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Su-Suara apa ini?
Dialogue: 0,0:01:29.90,0:01:33.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mungkin Smile raksasa?
Dialogue: 0,0:01:33.03,0:01:36.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak ada monster seperti itu.
Dialogue: 0,0:01:37.45,0:01:41.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, rasanya juga bukan Wandering.
Dialogue: 0,0:01:41.66,0:01:45.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemunculan dungeon ini masih terhitung baru,
Dialogue: 0,0:01:45.00,0:01:48.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi belum ada imbalan yang diberikan\Nuntuk membasmi masternya.
Dialogue: 0,0:01:49.21,0:01:51.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Situasi saat petualang\Nyang mengincar imbalan,
Dialogue: 0,0:01:51.67,0:01:54.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memancing Master ke lantai dasar dungeon
Dialogue: 0,0:01:54.72,0:01:57.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hingga memicu Wandering,\Nseharusnya tidak terjadi.
Dialogue: 0,0:01:58.77,0:02:02.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, master dungeon ini\Ntidak akan membuat suara seperti ini.
Dialogue: 0,0:02:11.61,0:02:14.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, Mythril Golem?
Dialogue: 0,0:02:14.24,0:02:15.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin!
Dialogue: 0,0:02:15.91,0:02:18.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster langka bisa sampai muncul?
Dialogue: 0,0:03:55.97,0:03:57.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak salah lagi.
Dialogue: 0,0:03:57.55,0:04:01.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini suara langkah kaki Mythril Golem.
Dialogue: 0,0:04:01.01,0:04:03.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mythril Golem?
Dialogue: 0,0:04:03.85,0:04:06.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sepertinya kita kelewat beruntung.
Dialogue: 0,0:04:06.52,0:04:10.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu monster super langka di dungeon ini!
Dialogue: 0,0:04:11.73,0:04:14.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langkanya jauh melebihi Cry.
Dialogue: 0,0:04:15.52,0:04:20.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dikalahkan, akan menjatuhkan mythril,\Nmaterial pembuat senjata yang kuat!
Dialogue: 0,0:04:22.53,0:04:23.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja.
Dialogue: 0,0:04:25.58,0:04:29.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia jauh lebih kuat dari Cry atau Smile.
Dialogue: 0,0:04:30.67,0:04:35.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan Mythril Golem sangatlah berat,\Nbahkan spesialis pertahanan sepertiku
Dialogue: 0,0:04:38.84,0:04:41.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak bisa menerimanya mentah-mentah.
Dialogue: 0,0:04:44.85,0:04:47.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat masih di Magic World.
Dialogue: 0,0:04:47.06,0:04:49.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemain yang terpancing oleh tingkat
Dialogue: 0,0:04:49.31,0:04:51.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kemunculan rendah dan drop langka,
Dialogue: 0,0:04:51.40,0:04:56.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dibabat habis oleh monster seperti ini\Nadalah hal yang sering terjadi.
Dialogue: 0,0:04:56.15,0:04:59.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, di dunia ini,\Nmati berarti segalanya berakhir.
Dialogue: 0,0:05:02.16,0:05:05.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Risiko tinggi untuk hasil yang besar.
Dialogue: 0,0:05:05.83,0:05:10.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau kabur,\Nsebaiknya hentikan penjelajahan dan lari.
Dialogue: 0,0:05:10.54,0:05:15.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sampai tersusul saat bertarung\Ndengan monster lain, habis sudah semuanya.
Dialogue: 0,0:05:15.71,0:05:20.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau harus memilih,\Nmundur pilihan yang bijak...
Dialogue: 0,0:05:20.51,0:05:24.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya, aku sangat ingin dapat mythril!
Dialogue: 0,0:05:24.97,0:05:29.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sudah seperti ikon logam kuat\Ndunia fantasi,
Dialogue: 0,0:05:29.31,0:05:32.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kedudukannya juga sama di dunia ini!
Dialogue: 0,0:05:32.90,0:05:38.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan perlengkapan mythril itu\Njauh melampaui perlengkapan baja hitam!
Dialogue: 0,0:05:39.82,0:05:41.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elymas!
Dialogue: 0,0:05:41.99,0:05:44.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu bimbang, ayo lakukan saja!
Dialogue: 0,0:05:46.12,0:05:48.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang pengecut,
Dialogue: 0,0:05:48.37,0:05:50.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku tetaplah petualang!
Dialogue: 0,0:05:52.29,0:05:54.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo dapatkan mythril itu!
Dialogue: 0,0:05:55.04,0:05:56.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu serius?
Dialogue: 0,0:05:56.09,0:05:58.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu sampai bimbang,
Dialogue: 0,0:05:58.09,0:06:01.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berarti yang kamu pikirkan\Naslinya lebih menguntungkan!
Dialogue: 0,0:06:02.01,0:06:03.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche...
Dialogue: 0,0:06:03.09,0:06:05.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ini memang percobaan yang ceroboh,
Dialogue: 0,0:06:05.43,0:06:10.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku yakin sejak awal kamu\Ntidak akan sampai bimbang begini!
Dialogue: 0,0:06:13.73,0:06:17.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat pertama kali bertemu,\Nkukira dia penakut.
Dialogue: 0,0:06:21.49,0:06:23.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Ruche
Dialogue: 0,0:06:23.15,0:06:25.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sangat berani saat dibutuhkan!
Dialogue: 0,0:06:29.54,0:06:32.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak sudah percaya padaku!
Dialogue: 0,0:06:34.42,0:06:36.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu...
Dialogue: 0,0:06:36.96,0:06:42.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kemungkinan Mythril Golem\Nmuncul karena Hoki Gila milikku, kan?
Dialogue: 0,0:06:42.55,0:06:45.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa bersalah\Nkalau mengabaikannya begitu saja.
Dialogue: 0,0:06:45.76,0:06:49.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, mungkin benar begitu.
Dialogue: 0,0:06:49.56,0:06:54.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dungeon adalah mimpi buruk yang dilihat\Noleh sang Dewa Tertidur, Alxeros.
Dialogue: 0,0:06:54.39,0:07:00.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Munculnya monster baru untuk mengimbangi\Npetualang adalah hal lumrah,
Dialogue: 0,0:07:00.11,0:07:02.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi Mythril Golem normalnya
Dialogue: 0,0:07:02.74,0:07:06.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukanlah monster\Nyang akan muncul semudah ini.
Dialogue: 0,0:07:07.70,0:07:09.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun itu.
Dialogue: 0,0:07:10.58,0:07:13.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Ruche memang mau,\Nbisa kita tantang tanpa ragu.
Dialogue: 0,0:07:16.25,0:07:18.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo berburu Raksasa Mythril!
Dialogue: 0,0:07:21.75,0:07:25.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, kita harus memilih medan\Nuntuk bertarung melawannya.
Dialogue: 0,0:07:25.42,0:07:27.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memilih medan?
Dialogue: 0,0:07:41.36,0:07:42.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:07:42.98,0:07:45.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia benar-benar mengikuti kita.
Dialogue: 0,0:07:45.07,0:07:47.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, duh!
Dialogue: 0,0:07:47.53,0:07:50.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu yakin medannya di sini?
Dialogue: 0,0:07:51.16,0:07:51.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:07:51.95,0:07:55.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat mengalahkan Raana Emas\Ndi Kotak Mainan Malaikat,
Dialogue: 0,0:07:55.66,0:07:57.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lebar lorong juga jadi aspek penting, kan?
Dialogue: 0,0:08:01.46,0:08:06.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat melawan Embryo, karena posisi plafon\Nsama dengan ketinggian dia berada,
Dialogue: 0,0:08:06.51,0:08:08.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu jadi bisa menyerangnya.
Dialogue: 0,0:08:14.27,0:08:15.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya!
Dialogue: 0,0:08:16.60,0:08:19.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena ini dungeon tipe gua,
Dialogue: 0,0:08:19.19,0:08:22.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}perbedaan tiap medannya sangatlah besar.
Dialogue: 0,0:08:23.23,0:08:27.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebar dan ketinggian di dalam gua,\Nlalu tempat berpijak.
Dialogue: 0,0:08:27.41,0:08:29.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada tempat\Nyang lebih sempurna dari ini!
Dialogue: 0,0:08:30.49,0:08:34.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti akan sulit bergerak\Ndengan tubuh raksasanya itu.
Dialogue: 0,0:08:34.96,0:08:38.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mythril Golem yang muncul di sini\Nberlevel 55.
Dialogue: 0,0:08:38.78,0:08:41.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, daya serangnya 78.
Dialogue: 0,0:08:41.66,0:08:43.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya pertahanannya 66.
Dialogue: 0,0:08:43.50,0:08:46.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditambah lagi, punya Penyembuhan Otomatis,
Dialogue: 0,0:08:46.13,0:08:47.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sehingga sangat merepotkan.
Dialogue: 0,0:08:48.72,0:08:50.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangguh sekali!
Dialogue: 0,0:08:50.93,0:08:54.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, daripada ketangguhan,\Nkekuatan utama miliknya
Dialogue: 0,0:08:54.56,0:08:57.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada di daya hancurnya yang luar biasa.
Dialogue: 0,0:08:57.89,0:09:01.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sekalipun tidak mampu menahan\Ndua serangan langsung darinya.
Dialogue: 0,0:09:01.85,0:09:02.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:09:02.86,0:09:06.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makin didengar makin seram saja!
Dialogue: 0,0:09:06.44,0:09:09.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya kita harus memaksa ini\Nselesai dalam waktu singkat.
Dialogue: 0,0:09:09.70,0:09:12.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada artinya\Nmelukai sedikit demi sedikit.
Dialogue: 0,0:09:12.91,0:09:15.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus mengandalkan satu serangan telak.
Dialogue: 0,0:09:15.81,0:09:18.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Incarlah serangan kritikal Dice Thrust.
Dialogue: 0,0:09:18.58,0:09:20.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti!
Dialogue: 0,0:09:29.01,0:09:33.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya pertahanannya memang tinggi,\Ntapi musuh kami lemah pada kritikal.
Dialogue: 0,0:09:33.01,0:09:35.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi angka enam Dice Thrust
Dialogue: 0,0:09:35.14,0:09:39.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa memberikan kerusakan 1,3 kali lipat\Ndari serangan kritikal biasa.
Dialogue: 0,0:09:43.19,0:09:45.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche yang sekarang\Ndilengkapi Pisau Baja Hitam,
Dialogue: 0,0:09:45.61,0:09:48.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau berhasil dapat 6 dari Dice Thrust.
Dialogue: 0,0:09:48.65,0:09:53.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski lawannya Mythril Golem, kalau lancar,\Nbisa dikalahkan dalam dua serangan!
Dialogue: 0,0:09:53.91,0:09:57.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sadar kalau menghindari\Nserangan Mythril Golem
Dialogue: 0,0:09:57.99,0:10:02.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sambil terus mendaratkan Dice Thrust\Nbukanlah hal mudah.
Dialogue: 0,0:10:02.71,0:10:06.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah gunanya diriku dan medan ini!
Dialogue: 0,0:10:09.45,0:10:11.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya datang juga!
Dialogue: 0,0:10:40.95,0:10:45.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dilihat dari dekat,\Nparameternya memang dahsyat!
Dialogue: 0,0:10:45.42,0:10:47.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatannya yang sudah menghabisi
Dialogue: 0,0:10:47.71,0:10:50.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}banyak petualang rakus bukan omong kosong.
Dialogue: 0,0:10:50.05,0:10:51.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi!
Dialogue: 0,0:10:52.09,0:10:55.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kulucuti mythril-mu itu!
Dialogue: 0,0:10:56.89,0:10:58.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membuka celah!
Dialogue: 0,0:10:58.60,0:11:00.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong bantuannya, Ruche!
Dialogue: 0,0:11:00.22,0:11:01.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:11:19.95,0:11:21.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Par—
Dialogue: 0,0:11:21.12,0:11:22.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak sempat!
Dialogue: 0,0:11:36.72,0:11:39.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Parry dari depan jelas mustahil.
Dialogue: 0,0:11:39.51,0:11:41.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tahu,
Dialogue: 0,0:11:41.43,0:11:43.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi dibandingkan saat masih\Ndi Magic World,
Dialogue: 0,0:11:43.52,0:11:47.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hawa intimidasi dan keberadaannya\Ndi tingkat yang berbeda!
Dialogue: 0,0:11:52.52,0:11:54.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya datang juga!
Dialogue: 0,0:12:11.29,0:12:14.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kulucuti mythril-mu itu!
Dialogue: 0,0:12:16.34,0:12:17.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong bantuannya, Ruche!
Dialogue: 0,0:12:17.59,0:12:18.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:12:26.39,0:12:26.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Par—
Dialogue: 0,0:12:26.85,0:12:27.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak sempat!
Dialogue: 0,0:12:42.24,0:12:45.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Parry dari depan jelas mustahil.
Dialogue: 0,0:12:45.29,0:12:46.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tahu,
Dialogue: 0,0:12:46.87,0:12:48.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi dibandingkan saat masih\Ndi Magic World,
Dialogue: 0,0:12:49.29,0:12:52.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hawa intimidasi dan keberadaannya\Ndi tingkat yang berbeda!
Dialogue: 0,0:12:53.34,0:12:57.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya di sini aku ingin\Nmenghujani dengan Disarm,
Dialogue: 0,0:12:57.84,0:13:00.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi mungkin agak sulit, ya.
Dialogue: 0,0:13:05.31,0:13:06.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja!
Dialogue: 0,0:13:11.35,0:13:13.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Target minimalnya sudah terpenuhi!
Dialogue: 0,0:13:13.69,0:13:16.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus!\NSemuanya berjalan lancar!
Dialogue: 0,0:13:21.82,0:13:22.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:13:23.24,0:13:24.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche!
Dialogue: 0,0:13:28.54,0:13:31.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku terkejut!
Dialogue: 0,0:13:34.29,0:13:36.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya hancurnya memang luar biasa,
Dialogue: 0,0:13:36.55,0:13:39.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi di lorong sempit begini,\Ntidak akan leluasa bertarung, kan?
Dialogue: 0,0:13:45.05,0:13:46.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Parry!
Dialogue: 0,0:13:48.89,0:13:49.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus!
Dialogue: 0,0:13:49.98,0:13:54.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dari samping dan bukan serangan penuh,\Nmasih bisa kutangkis!
Dialogue: 0,0:14:02.32,0:14:04.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shield Bash!
Dialogue: 0,0:14:06.16,0:14:11.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shield Bash mengadu nilai dari\Ndaya pertahanan + daya serang yang dibagi dua.
Dialogue: 0,0:14:11.87,0:14:15.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang lebih unggul akan mengempaskan\Nlawannya sebesar nilai itu.
Dialogue: 0,0:14:15.25,0:14:17.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Statusku memang kalah telak.
Dialogue: 0,0:14:19.69,0:14:20.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:14:21.22,0:14:23.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa untuk manuver menghindar darurat!
Dialogue: 0,0:14:29.89,0:14:32.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedua tanganmu sudah terpakai sekarang.
Dialogue: 0,0:14:35.85,0:14:39.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dice Thrust!\N- Kritikal.
Dialogue: 0,0:14:53.66,0:14:56.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantap!\NKerja bagus, Ruche!
Dialogue: 0,0:14:56.25,0:14:58.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekali serang lagi!
Dialogue: 0,0:15:09.68,0:15:10.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penginjak Bayang!
Dialogue: 0,0:15:36.33,0:15:38.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, akhirnya berhenti!
Dialogue: 0,0:15:38.29,0:15:39.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:15:39.21,0:15:42.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau perhatiannya terkunci padaku\Nitu juga merepotkan!
Dialogue: 0,0:15:42.71,0:15:45.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masalah terus muncul silih berganti!
Dialogue: 0,0:15:54.77,0:15:55.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini!
Dialogue: 0,0:16:02.19,0:16:03.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penginjak Bayang!
Dialogue: 0,0:16:04.86,0:16:05.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serang!
Dialogue: 0,0:16:06.07,0:16:07.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche!
Dialogue: 0,0:16:07.15,0:16:08.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:16:08.32,0:16:11.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dice Thrust!
Dialogue: 0,0:16:14.08,0:16:14.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miss.
Dialogue: 0,0:16:20.17,0:16:21.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku gagal!
Dialogue: 0,0:16:22.63,0:16:24.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat kalau tidak tembus.
Dialogue: 0,0:16:24.71,0:16:28.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak awal, aku tidak mengharap\Ndapat angka enam berturut-turut.
Dialogue: 0,0:16:28.72,0:16:31.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sekarang penentuannya!
Dialogue: 0,0:16:32.43,0:16:34.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia sampai membenahi posisinya,
Dialogue: 0,0:16:34.81,0:16:37.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti mustahil dibuat berlutut lagi!
Dialogue: 0,0:16:37.23,0:16:39.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditambah, kalau Penyembuhan Otomatis aktif,
Dialogue: 0,0:16:39.98,0:16:42.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dice Thrust berikutnya tidak akan cukup\Nuntuk menghabisinya.
Dialogue: 0,0:16:43.19,0:16:45.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak bisa menahannya\Nsampai Ruche dapat angka enam,
Dialogue: 0,0:16:45.94,0:16:48.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}peluang menang kami hampir sirna!
Dialogue: 0,0:16:48.57,0:16:50.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, harus diserang dengan paksa!
Dialogue: 0,0:17:02.99,0:17:04.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Life Shield!
Dialogue: 0,0:17:15.09,0:17:16.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penginjak Bayang!
Dialogue: 0,0:17:20.44,0:17:21.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shield Bash!
Dialogue: 0,0:17:30.03,0:17:31.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang!
Dialogue: 0,0:17:31.36,0:17:35.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dice Thrust!
Dialogue: 0,0:17:37.95,0:17:38.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miss.
Dialogue: 0,0:17:39.13,0:17:39.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil!
Dialogue: 0,0:17:39.96,0:17:42.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di saat genting begini malah gagal dua kali?
Dialogue: 0,0:17:42.58,0:17:44.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche, jangan gentar!
Dialogue: 0,0:17:44.38,0:17:45.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serang saja terus!
Dialogue: 0,0:17:52.93,0:17:54.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Parry!
Dialogue: 0,0:17:54.22,0:17:56.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gila sekali kekuatannya!
Dialogue: 0,0:17:57.14,0:17:59.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma, tanganku tidak bertenaga...
Dialogue: 0,0:18:00.10,0:18:01.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa kuhindari!
Dialogue: 0,0:18:15.82,0:18:17.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elymas!
Dialogue: 0,0:18:22.08,0:18:25.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya serangnya benar-benar mengerikan.
Dialogue: 0,0:18:25.42,0:18:31.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru berhasil kutahan dengan dua lapis\Npertahanan dari Life Shield dan tameng.
Dialogue: 0,0:18:32.97,0:18:34.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini gawat.
Dialogue: 0,0:18:34.43,0:18:36.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada kesempatan lagi!
Dialogue: 0,0:18:52.07,0:18:57.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dice Thrust!\N- Kritikal.
Dialogue: 0,0:19:18.85,0:19:22.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mendapat 1342 poin pengalaman.
Dialogue: 0,0:19:25.14,0:19:28.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Telah naik ke level 47.
Dialogue: 0,0:19:30.23,0:19:33.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Telah naik ke level 49.\N- Sip, kerja bagus, Ruche.
Dialogue: 0,0:19:33.90,0:19:38.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah Elymas baik-baik saja!
Dialogue: 0,0:19:38.24,0:19:41.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat gagal dua kali beruntun,
Dialogue: 0,0:19:41.87,0:19:44.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sudah hampir menangis!
Dialogue: 0,0:19:44.75,0:19:46.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, hei.
Dialogue: 0,0:19:46.21,0:19:49.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dapat angka 6 dua kali di empat percobaan\Nitu sudah sangat beruntung.
Dialogue: 0,0:19:51.21,0:19:54.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, meski ada Hoki Gila milik Ruche.
Dialogue: 0,0:19:54.38,0:19:56.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tergantung ketimpangan hoki yang terjadi,
Dialogue: 0,0:19:56.26,0:20:01.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sudah siap misalkan Dice Thrust\Nharus dikeluarkan enam sampai tujuh kali.
Dialogue: 0,0:20:02.01,0:20:04.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya butuh empat kali.
Dialogue: 0,0:20:04.10,0:20:08.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche selalu melakukan hal di luar dugaan.
Dialogue: 0,0:20:13.02,0:20:16.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begini,\Nselain berhasil dapat mythril,
Dialogue: 0,0:20:16.53,0:20:22.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}levelku juga naik lumayan banyak\Ndan sisa skill point milikku jadi berlebih.
Dialogue: 0,0:20:22.12,0:20:23.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya...
Dialogue: 0,0:20:23.99,0:20:29.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar lagi aku akan bisa bertarung\Nlayaknya Kesatria Kelas Berat di Magic World.
Dialogue: 0,0:20:30.46,0:20:35.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Antara mengembangkan Taring Bara Kegilaan\Nyang punya daya ledak lebih dulu,
Dialogue: 0,0:20:42.26,0:20:46.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau membuat Taring Bara Kegilaan\Nyang tidak konsisten jadi stabil
Dialogue: 0,0:20:53.23,0:20:56.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan mengembangkan\NIkrar Zirah Berat lebih dulu.
Dialogue: 0,0:20:57.49,0:21:02.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, kita sepertinya\Nsudah masuk cukup dalam, ya.
Dialogue: 0,0:21:06.16,0:21:07.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche.
Dialogue: 0,0:21:07.54,0:21:10.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada cara untuk langsung keluar dari dungeon
Dialogue: 0,0:21:10.37,0:21:14.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tanpa perlu berjalan ke arah kita masuk.
Dialogue: 0,0:21:14.13,0:21:16.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya ada cara seperti itu?
Dialogue: 0,0:21:16.51,0:21:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah pernah mengalaminya sekali.
Dialogue: 0,0:21:20.05,0:21:22.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Caranya dengan mengalahkan master dungeon.
Dialogue: 0,0:21:25.60,0:21:28.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa itu tidak berbahaya?
Dialogue: 0,0:21:31.56,0:21:34.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Punya banyak cara menyerang serta kejam.
Dialogue: 0,0:21:34.69,0:21:39.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditambah dengan tubuh besarnya itu,\Ndia memang layak disebut master.
Dialogue: 0,0:23:10.20,0:23:12.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat masih gim atau setelah\Njadi nyata seperti sekarang,
Dialogue: 0,0:23:12.95,0:23:15.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membangun karakter memang bikin pusing.
Dialogue: 0,0:23:15.29,0:23:18.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fokus ke menyerang,\Natau mengutamakan kestabilan, ya?
Dialogue: 0,0:23:18.73,0:23:21.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pesona Kesatria Kelas Berat\Nrasanya memang di daya ledak.
Dialogue: 0,0:23:21.52,0:23:25.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, di dunia ini,\Nmati berarti semua berakhir.
Dialogue: 0,0:23:25.84,0:23:26.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga!
Dialogue: 0,0:23:26.93,0:23:29.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau berhasil mengalahkan Mythril Golem,
Dialogue: 0,0:23:29.43,0:23:33.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harusnya kami bisa menantang\Nmaster dungeon ini dengan tenang!
Dialogue: 0,0:23:33.71,0:23:36.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, Penguasa Terowongan Lipan.
Dialogue: 0,0:23:36.27,0:23:39.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia punya titik buta yang jelas!
