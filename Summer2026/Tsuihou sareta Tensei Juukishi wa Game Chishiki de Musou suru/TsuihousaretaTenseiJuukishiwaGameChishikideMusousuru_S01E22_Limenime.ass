Dialogue: 0,0:00:12.12,0:00:13.91,sign,,0000,0000,0000,,MAKAM DUKA - PINTU MASUK
Dialogue: 0,0:00:13.91,0:00:16.00,sign,,0000,0000,0000,,REKOMENDASI LEVEL: 70
Dialogue: 0,0:03:36.45,0:03:39.78,sign,,0000,0000,0000,,KESATRIA KELAS BERAT TEREINKARNASI YANG DIASINGKAN\NJADI TANPA TANDING DENGAN PENGETAHUAN GIMNYA
Dialogue: 0,0:04:56.82,0:05:01.86,sign,,0000,0000,0000,,EPISODE 22: KELT SI PEMBURU DAN PENDETA MAEBEL
Dialogue: 0,0:07:20.63,0:07:25.63,sign,,0000,0000,0000,,MONSTER: MUMMY RAANA
Dialogue: 0,0:07:35.73,0:07:38.31,sign,,0000,0000,0000,,PENGINJAK BAYANG
Dialogue: 0,0:08:46.63,0:08:50.01,sign,,0000,0000,0000,,MENDAPAT 639 POIN PENGALAMAN
Dialogue: 0,0:09:13.91,0:09:15.41,sign,,0000,0000,0000,,SENAPAN LUDAH RACUN
Dialogue: 0,0:09:19.00,0:09:21.54,sign,,0000,0000,0000,,STATUS ABNORMAL: RACUN
Dialogue: 0,0:11:54.11,0:11:55.36,sign,,0000,0000,0000,,MENDAPAT 651 POIN PENGALAMAN
Dialogue: 0,0:11:55.36,0:11:56.61,sign,,0000,0000,0000,,MENDAPAT 639 POIN PENGALAMAN
Dialogue: 0,0:11:56.61,0:11:58.28,sign,,0000,0000,0000,,MENDAPAT 642 POIN PENGALAMAN
Dialogue: 0,0:12:37.07,0:12:40.78,sign,,0000,0000,0000,,JAMUR ZOMBI, HARGA PASAR: 400 RIBU G
Dialogue: 0,0:00:11.22,0:00:13.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makam Duka, Pintu Masuk.
Dialogue: 0,0:00:13.91,0:00:16.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rekomendasi level 70.
Dialogue: 0,0:00:16.51,0:00:19.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini juga terjadi anomali yang serupa\Ndengan Terowongan Lipan.
Dialogue: 0,0:00:20.29,0:00:22.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami harus menemukan penyebabnya!
Dialogue: 0,0:00:25.67,0:00:29.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar penyelidikan\Nbagian dalam dungeon berjalan efektif,
Dialogue: 0,0:00:29.43,0:00:32.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita berpencar jadi lima regu\Ndan mengambil jalan yang berbeda.
Dialogue: 0,0:00:32.68,0:00:34.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu berkumpul lagi di dalam.
Dialogue: 0,0:00:35.65,0:00:39.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kalanya muncul dungeon\Ndengan nama yang sama,
Dialogue: 0,0:00:39.06,0:00:44.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi bagian dalamnya terbentuk secara acak\Ndan strukturnya selalu berbeda.
Dialogue: 0,0:00:44.11,0:00:49.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dari investigasi awal\Ndan informasi yang dijual ke serikat,
Dialogue: 0,0:00:49.15,0:00:52.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jalur utama dungeon ini\Nsepertinya terpecah-pecah.
Dialogue: 0,0:00:52.93,0:00:56.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu penyelidikan selesai,\Nkita serang Master secara bersama-sama.
Dialogue: 0,0:00:57.39,0:00:59.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Upahnya akan dibagi rata per kepala,
Dialogue: 0,0:00:59.83,0:01:02.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi serikat juga akan\Nmemberikan imbalan terpisah.
Dialogue: 0,0:01:03.01,0:01:04.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kalian tenang saja.
Dialogue: 0,0:01:04.75,0:01:07.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master dungeon ini adalah\NKesatria Tengkorak, Nightbone.
Dialogue: 0,0:01:10.01,0:01:12.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang lawan yang merepotkan\Nkarena daya serangnya tinggi,
Dialogue: 0,0:01:12.68,0:01:14.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi dia tidak punya serangan jarak jauh
Dialogue: 0,0:01:14.89,0:01:18.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan levelnya setingkat lebih rendah\Ndari Death Amude.
Dialogue: 0,0:01:23.56,0:01:27.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal semua yang di sini bekerja sama,\Nkita tidak akan kalah melawan dia.
Dialogue: 0,0:01:27.70,0:01:30.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan mungkin ada yang bisa\Nmengalahkannya seorang diri.
Dialogue: 0,0:01:30.53,0:01:34.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi saat ini, segala sesuatu\Nbisa saja terjadi di dungeon ini.
Dialogue: 0,0:01:34.91,0:01:39.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, berhati-hatilah agar tidak masuk\Nke ruang Master duluan.
Dialogue: 0,0:01:43.42,0:01:44.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong awasi sekitar.
Dialogue: 0,0:01:44.58,0:01:45.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, serahkan padaku.
Dialogue: 0,0:01:46.92,0:01:47.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:01:47.88,0:01:50.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master!\NSyukurlah kita satu regu!
Dialogue: 0,0:01:50.88,0:01:53.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master memang sudah mengakuiku, ya?
Dialogue: 0,0:01:53.97,0:01:58.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan perlengkapanmu yang sekarang,\Nkamu tidak bisa kuserahkan ke regu lain.
Dialogue: 0,0:01:58.35,0:02:01.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, aku juga tidak ingat\Npernah jadi mastermu...
Dialogue: 0,0:02:01.35,0:02:04.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Master merasa begitu, anu...
Dialogue: 0,0:02:04.44,0:02:06.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong beri aku pedang...
Dialogue: 0,0:02:09.94,0:02:14.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memakai sabit rasanya pas karena kamu\Njadi tidak maju sembarangan.
Dialogue: 0,0:02:16.62,0:02:18.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, aduh.
Dialogue: 0,0:02:18.12,0:02:20.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata para bocah tadi.
Dialogue: 0,0:02:20.29,0:02:22.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan malah menghambatku.
Dialogue: 0,0:02:25.42,0:02:28.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senangnya bisa seregu dengan kalian\Nyang sempat kuajak mengobrol.
Dialogue: 0,0:02:28.50,0:02:30.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mo-Mohon bantuannya!
Dialogue: 0,0:02:30.92,0:02:35.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elymas kelihatannya baik\Ndan Kelt sepertinya bisa diandalkan.
Dialogue: 0,0:02:35.22,0:02:38.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami serahkan jalannya ke Kelt, ya.
Dialogue: 0,0:02:38.59,0:02:40.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu paham juga rupanya, gadis cilik.
Dialogue: 0,0:02:40.93,0:02:45.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, wajar, pengalamanku memang beda.
Dialogue: 0,0:02:45.83,0:02:50.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu, kita harus mendengarkan\Nkata petualang berpengalaman.
Dialogue: 0,0:02:51.41,0:02:53.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti perkataanku tadi.
Dialogue: 0,0:02:55.47,0:03:01.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}MP untuk menyembuhkan Kelt\Nakan kuhemat dengan baik.
Dialogue: 0,0:03:02.83,0:03:05.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia ini bisa dipercaya?
Dialogue: 0,0:03:05.62,0:03:10.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, selama kita tidak berkhianat,\Ndia tidak akan macam-macam.
Dialogue: 0,0:03:14.22,0:03:15.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saatnya berangkat!
Dialogue: 0,0:05:16.88,0:05:18.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini menyeramkan.
Dialogue: 0,0:05:18.64,0:05:21.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang sudah bosan kulihat\Nsejak masih di gim,
Dialogue: 0,0:05:21.55,0:05:25.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi begitu jadi nyata seperti sekarang,\Nhawa keberadaannya sangat berbeda.
Dialogue: 0,0:05:27.77,0:05:28.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seram...
Dialogue: 0,0:05:28.89,0:05:33.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau disuruh mencari\Nhal yang mencurigakan di sini,
Dialogue: 0,0:05:33.31,0:05:34.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jelas bikin bingung...
Dialogue: 0,0:05:34.98,0:05:37.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya kelihatan mencurigakan.
Dialogue: 0,0:05:37.82,0:05:41.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu monumen batu saja\Nsudah kelihatan sangat berharga...
Dialogue: 0,0:05:41.03,0:05:44.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang sulit kalau cuma diberi tahu\Nsamar-samar seperti itu.
Dialogue: 0,0:05:44.95,0:05:49.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku mungkin bisa menyadari\Nperbedaan dengan saat masih jadi gim.
Dialogue: 0,0:05:50.83,0:05:55.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuan utama kita membasmi monster\Ndan membersihkan dungeon,
Dialogue: 0,0:05:55.50,0:05:58.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi tidak perlu dipikirkan terlalu berat.
Dialogue: 0,0:05:58.00,0:06:00.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toh kita bukan ilmuwan.
Dialogue: 0,0:06:00.42,0:06:02.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Benar juga.
Dialogue: 0,0:06:06.68,0:06:08.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Kesatria Kelas Berat.
Dialogue: 0,0:06:08.64,0:06:10.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sana maju lebih ke depan lagi.
Dialogue: 0,0:06:10.60,0:06:14.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau monster\Nmenyergap juru penyembuh kita?
Dialogue: 0,0:06:15.41,0:06:18.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minimal jalankan tugasmu dengan benar.
Dialogue: 0,0:06:18.40,0:06:21.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terus-terusan menghambatku!
Dialogue: 0,0:06:22.32,0:06:26.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesatria Kelas Berat yang jalannya lambat\Nbuat apa disuruh maju lebih jauh?
Dialogue: 0,0:06:26.70,0:06:30.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, yang sebenarnya perlu dilindungi\Nitu bukan juru penyembuh,
Dialogue: 0,0:06:30.45,0:06:32.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi dirinya\Nyang daya pertahanannya rendah, kan?
Dialogue: 0,0:06:33.21,0:06:36.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski ucapan Kelt ada celahnya,
Dialogue: 0,0:06:36.17,0:06:40.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu masih di taraf beda strategi,\Njadi sulit dibantah.
Dialogue: 0,0:06:40.09,0:06:44.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, caranya memaksakan argumen\Nsangat menjengkelkan.
Dialogue: 0,0:06:45.09,0:06:46.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Secara perlahan,
Dialogue: 0,0:06:46.47,0:06:50.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia membuat suasana yang menguntungkan\Nagar bisa memerintah orang lain.
Dialogue: 0,0:07:02.39,0:07:03.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada monster!
Dialogue: 0,0:07:22.38,0:07:25.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ternyata cuma Raana.
Dialogue: 0,0:07:25.63,0:07:26.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan dianggap remeh.
Dialogue: 0,0:07:26.97,0:07:29.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Status mereka tidak seimut itu.
Dialogue: 0,0:07:35.73,0:07:37.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penginjak Bayang!
Dialogue: 0,0:07:40.23,0:07:42.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shield Bash!
Dialogue: 0,0:07:43.90,0:07:44.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche!
Dialogue: 0,0:07:44.69,0:07:47.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu!
Dialogue: 0,0:07:48.57,0:07:53.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, pantas bocah itu berani mendebatku,\Nsepertinya dia mampu melakukan hal dasar.
Dialogue: 0,0:07:53.79,0:07:58.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, garda depan terlalu kewalahan\Nkalau harus melawan empat monster!
Dialogue: 0,0:07:58.00,0:07:59.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar ikut kuserang—
Dialogue: 0,0:07:59.04,0:07:59.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu!
Dialogue: 0,0:08:00.06,0:08:01.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu cuma buang-buang MP!
Dialogue: 0,0:08:01.50,0:08:04.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlalu maju itu\Nbukan jarak serang pemburu!
Dialogue: 0,0:08:16.60,0:08:18.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyerang titik vital itu\Nsulit mempan untuk Undead!
Dialogue: 0,0:08:31.65,0:08:34.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan cuma bengong,\Ncepat lindungi aku, Badut!
Dialogue: 0,0:08:34.08,0:08:36.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah, ba-baik!
Dialogue: 0,0:08:40.46,0:08:44.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan Beruntun Akrobat!
Dialogue: 0,0:08:46.63,0:08:50.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mendapat 639 poin pengalaman.
Dialogue: 0,0:08:50.97,0:08:52.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia embat pakai skill, ya.
Dialogue: 0,0:08:54.39,0:08:57.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku ingin menghabisi\Ntiga ekor di sini.
Dialogue: 0,0:08:57.02,0:09:01.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia melarang Maebel menyerang,\Nlalu mendekat secara paksa.
Dialogue: 0,0:09:01.52,0:09:04.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti demi mengumpulkan\Npoin pengalaman dan drop item.
Dialogue: 0,0:09:04.94,0:09:08.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja, kemampuannya memang tinggi.
Dialogue: 0,0:09:08.02,0:09:10.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang pantas jadi\Npetualang kelas B di dunia ini.
Dialogue: 0,0:09:16.91,0:09:19.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kodok sialan!
Dialogue: 0,0:09:19.00,0:09:21.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Status Abnormal: Racun.
Dialogue: 0,0:09:21.54,0:09:23.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, sembuhkan aku!
Dialogue: 0,0:09:23.00,0:09:24.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu punya Poizo Heal, kan?
Dialogue: 0,0:09:25.13,0:09:27.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak bisa kulakukan sekarang!
Dialogue: 0,0:09:27.88,0:09:29.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa katamu?
Dialogue: 0,0:09:29.51,0:09:32.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Ruche yang HP-nya rendah\Nterus terluka
Dialogue: 0,0:09:32.64,0:09:36.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selagi aku mengaktifkan Poizo Heal,
Dialogue: 0,0:09:36.39,0:09:38.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}garda depan bisa hancur.
Dialogue: 0,0:09:39.56,0:09:42.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bukan garda depan\Nyang bisa hancur semudah itu!
Dialogue: 0,0:09:42.06,0:09:44.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan cuma bicara berdasarkan asumsi!
Dialogue: 0,0:09:44.44,0:09:45.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu,
Dialogue: 0,0:09:45.40,0:09:49.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}MP penyembuh racun tidak akan efisien\Nkalau bukan setelah bertarung.
Dialogue: 0,0:09:49.36,0:09:52.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti garda depan yang akan\Nterkena racun lebih parah.
Dialogue: 0,0:09:52.40,0:09:55.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, tolong jaga jarak\Ndan bertarung dari jauh, Kelt.
Dialogue: 0,0:09:58.24,0:09:59.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:09:59.62,0:10:02.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti, Nona Pendeta.
Dialogue: 0,0:10:02.79,0:10:06.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kondisimu pasti sulit karena\Njatah juru penyembuh itu sedikit, kan?
Dialogue: 0,0:10:06.29,0:10:10.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal jatah kontribusinya\Nnanti biar aku yang urus.
Dialogue: 0,0:10:10.05,0:10:14.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bekerja sama dengan petualang yang luwes\Ndan mau mendengar kata seniornya
Dialogue: 0,0:10:14.55,0:10:16.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memang lebih mudah.
Dialogue: 0,0:10:16.47,0:10:17.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan?
Dialogue: 0,0:10:19.68,0:10:21.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibentak lalu dirayu.
Dialogue: 0,0:10:21.18,0:10:24.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia ingin membuat Maebel\Nmenurut padanya, ya.
Dialogue: 0,0:10:25.10,0:10:28.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelt, mana bisa aku melakukan itu.
Dialogue: 0,0:10:31.65,0:10:35.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memang sudah terbiasa\Nmenjelajah dungeon.
Dialogue: 0,0:10:35.78,0:10:38.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku juga punya kebanggaan\Ndan tanggung jawab
Dialogue: 0,0:10:38.62,0:10:41.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dalam mengambil keputusan\Nsebagai juru penyembuh!
Dialogue: 0,0:10:41.29,0:10:45.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski ditertawai sekalipun,\Nakan kuutamakan keselamatan rekanku.
Dialogue: 0,0:10:45.08,0:10:47.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah harga diriku!
Dialogue: 0,0:10:48.92,0:10:52.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira dia cuma Healer licik,\Nsepertinya aku agak salah—
Dialogue: 0,0:10:52.72,0:10:53.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:10:56.97,0:11:00.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir Maebel orangnya agak seram,
Dialogue: 0,0:11:00.93,0:11:03.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ternyata baik hati\Ndan penuh semangat, ya.
Dialogue: 0,0:11:06.69,0:11:12.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}MP untuk menyembuhkan Kelt\Nakan kuhemat dengan baik.
Dialogue: 0,0:11:12.94,0:11:18.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibandingkan Kelt, bisa jadi Maebel\Nyang setingkat lebih unggul.
Dialogue: 0,0:11:54.11,0:11:56.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mendapat poin pengalaman.
Dialogue: 0,0:11:58.99,0:12:02.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujung-ujungnya kalian yang mengembat semua.
Dialogue: 0,0:12:05.20,0:12:07.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus.
Dialogue: 0,0:12:07.00,0:12:09.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua perlu kusembuhkan?
Dialogue: 0,0:12:09.29,0:12:10.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah.
Dialogue: 0,0:12:10.29,0:12:11.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya.
Dialogue: 0,0:12:11.79,0:12:13.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih bisa diatasi pakai ramuan.
Dialogue: 0,0:12:14.88,0:12:17.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada dasarnya,\Nitem penyembuh di Magic World
Dialogue: 0,0:12:17.68,0:12:21.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya punya efek mempercepat\Npenyembuhan alami.
Dialogue: 0,0:12:21.10,0:12:23.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi juga bisa untuk menghemat MP Healer.
Dialogue: 0,0:12:24.85,0:12:27.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elymas, ayo kita kumpulkan batu sihirnya!
Dialogue: 0,0:12:28.52,0:12:31.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada item aneh yang jatuh!
Dialogue: 0,0:12:32.48,0:12:35.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Termasuk yang tadi,\Napa-apaan tingkat drop ini?
Dialogue: 0,0:12:35.44,0:12:37.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kebetulan atau bagaimana?
Dialogue: 0,0:12:37.07,0:12:40.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jamur Zombi, harga pasar 400 ribu Gold.
Dialogue: 0,0:12:40.78,0:12:42.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jamur yang wangi.
Dialogue: 0,0:12:42.20,0:12:45.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Punya racun yang bisa mengubah\Nserangga dan hewan kecil jadi zombi.
Dialogue: 0,0:12:45.72,0:12:50.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, apa ini boleh kita ambil begitu saja?
Dialogue: 0,0:12:50.62,0:12:51.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan masalah.
Dialogue: 0,0:12:51.96,0:12:57.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hewan kecil pun bisa tahan asal tidak sedang\Nlemah dan menghirupnya dari dekat.
Dialogue: 0,0:12:58.84,0:13:01.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya siapa yang mau\Nbeli benda seperti ini?
Dialogue: 0,0:13:01.47,0:13:03.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini item material.
Dialogue: 0,0:13:03.05,0:13:04.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dipakai untuk alkimia.
Dialogue: 0,0:13:08.43,0:13:12.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah cukup, kan?\NDalih yang kamu buat-buat tadi.
Dialogue: 0,0:13:13.52,0:13:16.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira kamu cuma pendeta kacangan.
Dialogue: 0,0:13:16.11,0:13:17.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengaku kalah.
Dialogue: 0,0:13:19.31,0:13:21.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ini bicara apa, Kelt?
Dialogue: 0,0:13:21.91,0:13:23.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sadar betul kamu berniat
Dialogue: 0,0:13:23.53,0:13:27.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menunda penyembuhanku\Ndengan alasan mengada-ada.
Dialogue: 0,0:13:28.11,0:13:30.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berdua sudah saling kenal.
Dialogue: 0,0:13:30.16,0:13:34.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin aku diam saja\Nkalau dikucilkan seperti ini.
Dialogue: 0,0:13:34.87,0:13:37.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak ingin bermusuhan denganku\Nyang banyak koneksi ini, kan?
Dialogue: 0,0:13:37.88,0:13:41.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah, lupakan masalah kita\Ndan berdamai saja.
Dialogue: 0,0:13:42.45,0:13:44.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau menyogok, ya?
Dialogue: 0,0:13:44.39,0:13:47.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar marah, Kelt!
Dialogue: 0,0:13:48.56,0:13:51.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Posisiku ini menyangkut nyawa orang!
Dialogue: 0,0:13:52.00,0:13:54.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di raid quest kali ini,
Dialogue: 0,0:13:54.10,0:13:58.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}juru penyembuh mendapat upah khusus\Nyang terpisah dari serikat.
Dialogue: 0,0:13:58.11,0:14:02.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah puas dengan itu\Ndan tidak berniat
Dialogue: 0,0:14:02.11,0:14:04.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengucilkan orang lain!
Dialogue: 0,0:14:04.16,0:14:06.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena sudah bertaruh nyawa,
Dialogue: 0,0:14:06.06,0:14:09.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku paham kamu ingin dapat bagian\Nsedikit lebih banyak dari yang lain.
Dialogue: 0,0:14:09.16,0:14:11.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak menyangkal prinsipmu!
Dialogue: 0,0:14:11.91,0:14:14.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tolong jangan libatkan aku!
Dialogue: 0,0:14:24.30,0:14:26.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa, sih?
Dialogue: 0,0:14:26.71,0:14:28.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiba-tiba menggebu-gebu begitu...
Dialogue: 0,0:14:28.81,0:14:31.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya kita akan sama-sama rugi.
Dialogue: 0,0:14:31.52,0:14:34.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya kamu jadi kelas C\Ndengan pikiran dangkal itu.
Dialogue: 0,0:14:39.27,0:14:42.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kalian sudah selesai\Nmengumpulkan semuanya, kan?
Dialogue: 0,0:14:42.24,0:14:43.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo cepat jalan!
Dialogue: 0,0:14:52.91,0:14:55.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maebel...
Dialogue: 0,0:14:57.73,0:15:00.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Juru penyembuh\Nyang bergantung pada negosiasi
Dialogue: 0,0:15:00.88,0:15:03.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan habis begitu diremehkan.
Dialogue: 0,0:15:03.04,0:15:06.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau ketahuan jadi\Nyang duluan memulai masalah,
Dialogue: 0,0:15:06.43,0:15:10.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada risiko dibenci dan rumor\Ntidak jelas jadi menyebar.
Dialogue: 0,0:15:11.01,0:15:13.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pernah menunjukkan isi hatimu
Dialogue: 0,0:15:13.27,0:15:17.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}begitu kamu mau dimusuhi adalah\Naturan dasar seorang Healer.
Dialogue: 0,0:15:21.61,0:15:23.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sut.
Dialogue: 0,0:15:23.19,0:15:26.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelt yang salah\Nkarena mencari masalah duluan.
Dialogue: 0,0:15:27.29,0:15:28.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:15:29.28,0:15:31.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan bicara macam-macam.
Dialogue: 0,0:15:31.70,0:15:33.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf...
Dialogue: 0,0:15:33.62,0:15:37.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa perlu kubagi beberapa drop item milikku?
Dialogue: 0,0:15:37.83,0:15:39.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau agak seram, sih.
Dialogue: 0,0:15:40.62,0:15:44.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi sudah kubilang,\Njuru penyembuh dapat upah khusus.
Dialogue: 0,0:15:44.63,0:15:47.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal berjalan seperti biasa,\Nitu sudah cukup buatku.
Dialogue: 0,0:15:47.43,0:15:49.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuhargai niat baikmu.
Dialogue: 0,0:15:49.64,0:15:52.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Begitu, ya?
Dialogue: 0,0:15:54.10,0:15:56.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, beginilah ketangguhannya
Dialogue: 0,0:15:56.85,0:15:59.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena sudah bertarung\Nsebagai juru penyembuh.
Dialogue: 0,0:16:27.47,0:16:30.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa jalannya berputar-putar sekali?
Dialogue: 0,0:16:30.09,0:16:32.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serikat ini mikir apa, sih?
Dialogue: 0,0:16:33.14,0:16:38.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah cukup banyak monster\Nyang lolos dari Makam Duka.
Dialogue: 0,0:16:38.35,0:16:42.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rute serumit ini pasti dibuat\Nuntuk mengurangi jumlah monster.
Dialogue: 0,0:16:42.61,0:16:44.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau jumlahnya sudah terlalu banyak,
Dialogue: 0,0:16:44.36,0:16:47.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}meski Master sudah dikalahkan\Ndan dungeon ini lenyap,
Dialogue: 0,0:16:47.61,0:16:50.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebagian monster tetap bisa lolos keluar.
Dialogue: 0,0:17:37.79,0:17:40.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, rutenya benar-benar aneh.
Dialogue: 0,0:17:44.33,0:17:47.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat terasa terus berputar-putar\Ndi satu tempat,
Dialogue: 0,0:17:47.71,0:17:51.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tempat lain malah dilewati dengan singkat.
Dialogue: 0,0:17:51.17,0:17:55.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain tidak ada patokan,\Npetanya juga tidak akurat.
Dialogue: 0,0:17:56.18,0:17:58.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu...
Dialogue: 0,0:18:03.52,0:18:05.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak sekali yang dia corat-coret.
Dialogue: 0,0:18:05.52,0:18:07.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata dia secermat itu?
Dialogue: 0,0:18:08.61,0:18:11.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyuruh ke sana kemari\Nmemakai peta seperti ini,
Dialogue: 0,0:18:11.82,0:18:14.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}serikat benar-benar keterlaluan.
Dialogue: 0,0:18:14.24,0:18:17.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau seperti ini, kita bisa tersesat\Natau dikepung monster.
Dialogue: 0,0:18:17.83,0:18:21.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketemu monster merepotkan\Njuga bukan hal lucu.
Dialogue: 0,0:18:21.04,0:18:24.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kita akan ambil rute terpendek\Nmenuju titik kumpul.
Dialogue: 0,0:18:24.71,0:18:29.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berburu monster juga lebih aman\Ndi dekat titik kumpul.
Dialogue: 0,0:18:30.09,0:18:32.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti kita tidak bisa menyelidiki\Ndan membasmi monster.
Dialogue: 0,0:18:32.97,0:18:35.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau mengabaikan tujuan misinya, ya?
Dialogue: 0,0:18:35.09,0:18:38.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar bocah keras kepala,\Nmana bisa kamu mengerti.
Dialogue: 0,0:18:38.35,0:18:41.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa salahnya mengambil langkah\Nyang aman dan stabil?
Dialogue: 0,0:18:41.10,0:18:44.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham kamu ingin\Nmelaksanakan tugas dari serikat,
Dialogue: 0,0:18:44.48,0:18:47.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi dalam batas tertentu\Nharus bisa mengalah.
Dialogue: 0,0:18:48.44,0:18:51.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang ada bagian yang janggal di petanya.
Dialogue: 0,0:18:52.07,0:18:53.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:18:53.15,0:18:55.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemilihan rutenya kuserahkan padamu.
Dialogue: 0,0:18:55.20,0:18:59.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja, jangan ambil jalan pintas\Nyang terlalu melenceng.
Dialogue: 0,0:19:00.41,0:19:02.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya sejak awal bilang begitu.
Dialogue: 0,0:19:02.66,0:19:03.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santai.
Dialogue: 0,0:19:03.66,0:19:07.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita cuma akan menghindari jalan\Nyang rumit dan merepotkan.
Dialogue: 0,0:19:12.67,0:19:16.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, lurus saja ke sana.
Dialogue: 0,0:19:24.89,0:19:27.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesatria Kelas Berat,\Nsetelah ini belok kiri di sana.
Dialogue: 0,0:19:27.94,0:19:29.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah aneh?
Dialogue: 0,0:19:29.36,0:19:31.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi kamu bilang belok kanan, kan?
Dialogue: 0,0:19:31.23,0:19:34.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari tadi cuma berputar-putar zig-zag\Nke kiri dan ke kanan.
Dialogue: 0,0:19:34.61,0:19:36.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan salahku!
Dialogue: 0,0:19:36.36,0:19:38.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petanya saja yang parah!
Dialogue: 0,0:19:39.30,0:19:43.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelt, bukankah sebaiknya kita coba\Nkembali ke jalan awal dulu?
Dialogue: 0,0:19:43.87,0:19:48.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sampai tersesat di sini,\Nnanti merepotkan petualang lain.
Dialogue: 0,0:19:48.33,0:19:51.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau bilang aku buta arah?
Dialogue: 0,0:19:51.34,0:19:54.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, belok kiri di lorong itu!
Dialogue: 0,0:19:54.01,0:19:57.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arahnya sudah benar,\Nseharusnya tidak melenceng terlalu jauh!
Dialogue: 0,0:19:58.97,0:20:03.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serikat sialan, bisa-bisanya\Nmemberi peta ruwet begini.
Dialogue: 0,0:20:03.22,0:20:07.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang melapor asal-asalan\Ndemi uang jajan?
Dialogue: 0,0:20:07.60,0:20:10.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, belok kiri di lorong itu!
Dialogue: 0,0:20:32.54,0:20:36.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ra-Rasanya ini akan muncul di mimpiku\Nbeberapa hari ke depan.
Dialogue: 0,0:20:39.89,0:20:42.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pemandangan yang juga terkenal di gim.
Dialogue: 0,0:20:43.08,0:20:46.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya ini tidak terkait\Ndengan anomali misterius.
Dialogue: 0,0:20:49.27,0:20:54.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibanding dinding tulang belulang ini,\Naku lebih takut masuk ke jalan buntu
Dialogue: 0,0:20:54.57,0:20:58.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena mengikuti kata petualang senior.
Dialogue: 0,0:21:02.24,0:21:04.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kita mundur\Nsebelum monster datang.
Dialogue: 0,0:21:05.66,0:21:09.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, daripada dibilang salah Kelt,
Dialogue: 0,0:21:09.04,0:21:11.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ini memang salah pihak serikat.
Dialogue: 0,0:21:11.83,0:21:14.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena dibuat dari kumpulan\Nkesaksian petualang,
Dialogue: 0,0:21:14.42,0:21:17.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}wajar kalau ada sedikit kesalahan.
Dialogue: 0,0:21:17.09,0:21:20.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kesalahan kali ini mencolok sekali.
Dialogue: 0,0:21:31.81,0:21:34.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga saja tidak terjadi apa-apa.
Dialogue: 0,0:23:11.75,0:23:13.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelt memang seorang veteran.
Dialogue: 0,0:23:13.75,0:23:15.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maebel juga pendeta yang andal.
Dialogue: 0,0:23:16.59,0:23:19.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja, kami tidak bisa selaras.
Dialogue: 0,0:23:20.00,0:23:22.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konflik sosial dan gaya bermain,
Dialogue: 0,0:23:22.59,0:23:24.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}baik sekarang maupun saat masih di gim,\Ntetap sama, ya.
Dialogue: 0,0:23:25.55,0:23:28.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masalahnya bukan cuma soal Kelt.
Dialogue: 0,0:23:28.60,0:23:32.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sosok jahat yang mendekat juga\Nsepertinya bukan cuma perasaanku.
Dialogue: 0,0:23:33.22,0:23:35.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya,\NDewa Kematian Berlengan Tiga.
Dialogue: 0,0:23:35.89,0:23:38.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami harus bertarung apa pun yang terjadi.
