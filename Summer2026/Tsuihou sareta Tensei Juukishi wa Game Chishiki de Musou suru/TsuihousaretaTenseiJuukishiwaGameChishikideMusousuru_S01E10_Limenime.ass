Dialogue: 0,0:02:15.74,0:02:18.41,sign,,0000,0000,0000,,KESATRIA KELAS BERAT TEREINKARNASI YANG DIASINGKAN\NJADI TANPA TANDING DENGAN PENGETAHUAN GIMNYA
Dialogue: 0,0:03:30.27,0:03:33.07,sign,,0000,0000,0000,,EPISODE 10: NEGOSIASI
Dialogue: 0,0:06:55.31,0:06:57.61,sign,,0000,0000,0000,,RESTO DAPUR RAJA ALKIMIA
Dialogue: 0,0:07:59.25,0:08:04.71,sign,,0000,0000,0000,,RESTO DAPUR RAJA ALKIMIA
Dialogue: 0,0:08:24.32,0:08:24.98,sign,,0000,0000,0000,,PAI KEPITING RAJA SAUS JAMUR HITAM
Dialogue: 0,0:09:51.45,0:09:52.53,sign,,0000,0000,0000,,RESTO DAPUR RAJA ALKIMIA
Dialogue: 0,0:10:31.78,0:10:35.28,sign,,0000,0000,0000,,RUCHE: 46 JUTA GOLD, ELYMAS: 11 JUTA GOLD
Dialogue: 0,0:16:42.77,0:16:46.03,sign,,0000,0000,0000,,KEBINGUNGAN
Dialogue: 0,0:19:37.82,0:19:41.79,sign,,0000,0000,0000,,SUATU TEMPAT DI WILAYAH KEKUASAAN\NKELUARGA COUNT EDVAUGHN
Dialogue: 0,0:00:23.92,0:00:27.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau cuma berdua rasanya\Nlangsung tidak efisien.
Dialogue: 0,0:00:27.38,0:00:29.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!
Dialogue: 0,0:00:31.09,0:00:34.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jamur Penyembuh yang kukira\Nsudah pasti bakal drop,
Dialogue: 0,0:00:34.35,0:00:38.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sial amat tidak dapat satu pun\Npadahal sudah memburu empat Matango!
Dialogue: 0,0:00:39.48,0:00:43.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mungkin Hoki Gila Ruche\Nbenaran berpengaruh?
Dialogue: 0,0:00:43.31,0:00:48.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi kelihatannya tidak ada orang\Nyang sampai sengaja mengejar Matango.
Dialogue: 0,0:00:48.32,0:00:49.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih.
Dialogue: 0,0:00:49.03,0:00:50.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paling cuma kebetulan!
Dialogue: 0,0:00:50.36,0:00:53.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau saja dia tidak minta jatah\Ndari Pedang Berlumur Darah,
Dialogue: 0,0:00:53.45,0:00:56.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku pasti masih tetap membiarkannya di grup.
Dialogue: 0,0:00:56.20,0:00:58.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau minta dia balik?
Dialogue: 0,0:00:58.04,0:00:59.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar, Reiss.
Dialogue: 0,0:00:59.87,0:01:02.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga punya harga diri.
Dialogue: 0,0:01:02.21,0:01:05.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana bisa aku memintanya kembali\Nsetelah berkata sejauh itu.
Dialogue: 0,0:01:05.71,0:01:09.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski harus mati, aku tak akan sudi\Nmenundukkan kepala padanya.
Dialogue: 0,0:01:12.39,0:01:16.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung saja berkat pedang itu,\Nuang kita cukup longgar.
Dialogue: 0,0:01:16.14,0:01:18.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu buru-buru.
Dialogue: 0,0:01:18.18,0:01:22.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita santai saja cari orang level rendah\Nyang mudah diajak kompromi.
Dialogue: 0,0:01:24.77,0:01:26.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dungeon yang itu?
Dialogue: 0,0:01:26.19,0:01:28.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal bukan Kelas D atau C, ya?
Dialogue: 0,0:01:29.90,0:01:32.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa yang terjadi?\N- Mana orangnya? Tak kelihatan!
Dialogue: 0,0:01:33.36,0:01:34.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:01:34.62,0:01:38.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin ada yang berhasil\Nmengalahkan monster berlevel tinggi.
Dialogue: 0,0:01:38.20,0:01:39.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia, ya?
Dialogue: 0,0:01:39.70,0:01:41.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya Beruang Tambalan terlalu kuat?
Dialogue: 0,0:01:41.71,0:01:42.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah lihat.
Dialogue: 0,0:01:42.96,0:01:46.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petualang yang baru naik ke Kelas D\Ndan petualang kelas F?
Dialogue: 0,0:01:46.88,0:01:51.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhasil menaklukkan Kotak Mainan Malaikat\Nyang rekomendasinya level 50?
Dialogue: 0,0:01:56.01,0:01:57.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin.
Dialogue: 0,0:01:57.31,0:02:00.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Me-Mereka berdua?
Dialogue: 0,0:03:30.27,0:03:33.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami bukannya menaklukkan dungeon.
Dialogue: 0,0:03:33.07,0:03:36.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami diserang oleh Master\Nyang sedang Wandering.
Dialogue: 0,0:03:36.90,0:03:40.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ragu, ada dua petualang lain\Nyang juga terlibat.
Dialogue: 0,0:03:40.78,0:03:42.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanya saja ke mereka.
Dialogue: 0,0:03:42.45,0:03:43.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dimengerti.
Dialogue: 0,0:03:44.33,0:03:48.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kota akan memberikan upah\Nuntuk penaklukan Kotak Mainan Malaikat,
Dialogue: 0,0:03:48.88,0:03:51.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}biar kami konfirmasi lebih dulu.
Dialogue: 0,0:03:54.55,0:03:59.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkadang misi penaklukan dikeluarkan\Nuntuk dungeon dekat kota atau desa.
Dialogue: 0,0:03:59.72,0:04:04.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain monster jadi lebih mudah keluar\Ndari dungeon yang dibiarkan terlalu lama,
Dialogue: 0,0:04:04.31,0:04:09.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}keadaan anomali yang berkaitan dengan\Nbencana monster juga jadi mudah terjadi.
Dialogue: 0,0:04:10.19,0:04:13.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rekomendasi level dungeon\Nbervariasi tergantung wilayah.
Dialogue: 0,0:04:13.73,0:04:18.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada wilayah selalu muncul level rendah\Ndan wilayah selalu muncul level tinggi,
Dialogue: 0,0:04:18.36,0:04:20.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semuanya terbagi dengan jelas.
Dialogue: 0,0:04:20.91,0:04:24.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang bilang disebabkan\Nmana yang mengalir di wilayah itu.
Dialogue: 0,0:04:24.79,0:04:27.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada juga yang bilang itu anomali\Ndari Alxeros sang Dewa Tertidur,
Dialogue: 0,0:04:27.79,0:04:30.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi tidak akan bisa dipahami manusia.
Dialogue: 0,0:04:30.00,0:04:34.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak teori yang sudah diberikan,\Ntapi tidak ada yang tahu pasti.
Dialogue: 0,0:04:35.42,0:04:40.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petualang level tinggi biasanya beraktivitas\Ndi kota yang rawan muncul dungeon berbahaya.
Dialogue: 0,0:04:40.84,0:04:44.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu, hasilnya lebih menguntungkan\Ndan berguna juga bagi kerajaan.
Dialogue: 0,0:04:46.18,0:04:48.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itulah, di Kota Rondalm
Dialogue: 0,0:04:48.89,0:04:52.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak ada yang sanggup menaklukkan\NKotak Mainan Malaikat.
Dialogue: 0,0:04:52.48,0:04:55.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wali Kota yang takut dungeon itu\Nakan diabaikan begitu saja,
Dialogue: 0,0:04:55.36,0:04:57.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akhirnya mengajukan upah penaklukan.
Dialogue: 0,0:05:01.36,0:05:04.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ternyata ada upah penaklukannya.
Dialogue: 0,0:05:04.45,0:05:07.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira tidak akan ada,\Njadi tidak kucari tahu dulu.
Dialogue: 0,0:05:07.33,0:05:08.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan dapat berapa?
Dialogue: 0,0:05:08.87,0:05:10.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Se-Sepuluh juga Gold!
Dialogue: 0,0:05:12.42,0:05:14.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Se-Sepuluh juta?
Dialogue: 0,0:05:15.46,0:05:17.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepuluh juta Gold, ya.
Dialogue: 0,0:05:17.38,0:05:19.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dapat sebesar itu di sini\Nsangatlah membantu.
Dialogue: 0,0:05:19.76,0:05:22.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini seharusnya memang disyukuri, tapi...
Dialogue: 0,0:05:22.09,0:05:26.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Standarku kacau karena drop yang didapat,\Njadi bingung harus reaksi seperti apa.
Dialogue: 0,0:05:26.56,0:05:28.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Efek Hoki Gila, ya?
Dialogue: 0,0:05:28.93,0:05:33.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang dapat drop langka dari\NMaster dengan rekomendasi level 50?
Dialogue: 0,0:05:33.85,0:05:36.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Pria bernama Elymas itu\N- Tidak kusangka Hoki Gila
Dialogue: 0,0:05:36.07,0:05:38.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- langsung merekrut Ruche begitu tahu\N- bisa berpengaruh sampai ke sini.
Dialogue: 0,0:05:38.11,0:05:39.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- dia punya Hoki Gila.\N- bisa berpengaruh sampai ke sini.
Dialogue: 0,0:05:39.49,0:05:41.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu langsung memburu mangsa besar!
Dialogue: 0,0:05:41.78,0:05:46.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan tidak gemetar padahal\Nsepuluh juta Gold ada di depan mata?
Dialogue: 0,0:05:46.70,0:05:49.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Berapa banyak yang sudah mereka dapatkan?\N- Sejak dulu aku memang beruntung.
Dialogue: 0,0:05:49.95,0:05:56.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, sesuai aturan serikat, kalian akan\Ndipromosikan jadi petualang kelas D.
Dialogue: 0,0:05:56.46,0:05:59.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche akan langsung lompat\Ndari kelas F ke D.
Dialogue: 0,0:05:59.96,0:06:03.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche... ja-jadi kelas D?
Dialogue: 0,0:06:03.26,0:06:05.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa sadar, entah bagaimana
Dialogue: 0,0:06:05.47,0:06:08.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ru-Ruche... kelas D...\N- dia jadi sosok di luar jangkauan kita, ya.
Dialogue: 0,0:06:08.97,0:06:10.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ru-Ruche... kelas D...\N- Cline?
Dialogue: 0,0:06:12.02,0:06:12.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!
Dialogue: 0,0:06:12.81,0:06:13.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kenapa?
Dialogue: 0,0:06:13.85,0:06:16.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kita berhasil—\N- Ruche!
Dialogue: 0,0:06:16.02,0:06:17.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang salah!
Dialogue: 0,0:06:17.48,0:06:18.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua sudah kurenungkan!
Dialogue: 0,0:06:18.98,0:06:21.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kamu kembali pada kami?
Dialogue: 0,0:06:21.28,0:06:24.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uang dari Pedang Berlumur Berdarah\Nayo kita bagi tiga sama rata!
Dialogue: 0,0:06:24.99,0:06:26.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya?
Dialogue: 0,0:06:32.54,0:06:33.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Payah.
Dialogue: 0,0:06:34.87,0:06:36.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Ruche.
Dialogue: 0,0:06:36.50,0:06:38.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabarnya penyelidikan akan butuh waktu.
Dialogue: 0,0:06:38.71,0:06:40.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik...
Dialogue: 0,0:06:42.55,0:06:44.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, tolong tunggu sebentar!
Dialogue: 0,0:06:44.63,0:06:46.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa dengarkan aku dulu?
Dialogue: 0,0:06:46.89,0:06:49.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengarkan... aku...
Dialogue: 0,0:06:50.47,0:06:53.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengarkan tawaranku dulu...
Dialogue: 0,0:06:57.61,0:06:59.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kelihatan mahal sekali!
Dialogue: 0,0:06:59.32,0:07:00.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi tidak sabar.
Dialogue: 0,0:07:01.28,0:07:04.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf membuat Anda sekalian menunggu lama.
Dialogue: 0,0:07:05.11,0:07:09.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita naik jadi petualang kelas D\Ndan tiba-tiba dapat sepuluh juta Gold
Dialogue: 0,0:07:09.78,0:07:11.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah kejutan yang menggembirakan.
Dialogue: 0,0:07:16.96,0:07:22.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan naik jadi petualang kelas D,\Nbatas skill point yang dimiliki naik jadi 45.
Dialogue: 0,0:07:22.92,0:07:27.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu peluangku untuk beli\NTaring Bara Kegilaan jadi makin terlihat.
Dialogue: 0,0:07:27.34,0:07:30.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya memikirkan\Ncara cari uang selanjutnya.
Dialogue: 0,0:07:32.35,0:07:35.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Ada apa, Elymas?
Dialogue: 0,0:07:35.94,0:07:37.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, maaf.
Dialogue: 0,0:07:37.52,0:07:39.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pesta perayaan yang berharga.
Dialogue: 0,0:07:39.61,0:07:41.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang kita nikmati saja.
Dialogue: 0,0:07:41.61,0:07:43.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, itu benar!
Dialogue: 0,0:07:43.40,0:07:45.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita nikmati dengan gembira!
Dialogue: 0,0:07:45.32,0:07:46.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gembira!
Dialogue: 0,0:07:46.40,0:07:49.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Bersulang!\N- Bersulang!
Dialogue: 0,0:07:55.12,0:07:59.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi katanya hari ini boleh pesan apa saja\Nyang kumau sebanyak apa pun, kan?
Dialogue: 0,0:07:59.25,0:08:02.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Impianku memang memesan sesuka hati
Dialogue: 0,0:08:02.92,0:08:04.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di Resto Dapur Raja Alkimia.
Dialogue: 0,0:08:04.71,0:08:07.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah jadi petualang\Ndan sudah membuahkan hasil,
Dialogue: 0,0:08:07.72,0:08:10.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ingin kemari bersama rekan grupku.
Dialogue: 0,0:08:10.43,0:08:16.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, waktu itu rencananya\Ndatang bersama Cline dan Reiss, sih.
Dialogue: 0,0:08:16.06,0:08:18.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal sudah kuberi sejumlah uang!
Dialogue: 0,0:08:18.64,0:08:20.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah lupa sama utang budimu, ya?
Dialogue: 0,0:08:20.44,0:08:22.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak menerimanya!
Dialogue: 0,0:08:24.98,0:08:25.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:08:25.82,0:08:30.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pai Kepiting Raja Saus Jamur Hitam\Nharganya 8.000 Gold?
Dialogue: 0,0:08:30.07,0:08:32.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka akan semahal ini.
Dialogue: 0,0:08:32.53,0:08:34.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hampir saja aku memesannya.
Dialogue: 0,0:08:34.49,0:08:37.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elymas, jangan pesan yang ada di halaman ini!
Dialogue: 0,0:08:37.71,0:08:41.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo cari yang harga satuannya\Ndi bawah 4.000 Gold!
Dialogue: 0,0:08:41.21,0:08:44.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pesan Pai Kepiting Raja Saus Jamur Hitam.
Dialogue: 0,0:08:44.59,0:08:46.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya terima pesanannya.
Dialogue: 0,0:08:46.09,0:08:48.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Benarkah tidak apa-apa?
Dialogue: 0,0:08:50.09,0:08:52.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dia belum terbiasa.
Dialogue: 0,0:08:52.76,0:08:57.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini Pai Kepiting Raja Saus Jamur Hitam\Nyang dipesan.
Dialogue: 0,0:09:09.74,0:09:12.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata benaran lezat.
Dialogue: 0,0:09:13.45,0:09:16.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahagianya diriku!
Dialogue: 0,0:09:16.24,0:09:18.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini juga enak, lo!
Dialogue: 0,0:09:18.75,0:09:20.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baguslah kalau begitu.
Dialogue: 0,0:09:20.75,0:09:25.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus membahas garis besar soal hadiah\Ndan pembagiannya kali ini.
Dialogue: 0,0:09:25.71,0:09:28.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, soal Skill Book yang itu.
Dialogue: 0,0:09:28.26,0:09:29.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mau kamu pakai?
Dialogue: 0,0:09:30.26,0:09:34.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Angin Menengah cukup berguna\Nuntuk kamu pelajari.
Dialogue: 0,0:09:34.18,0:09:36.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya tidak akan Elymas pakai?
Dialogue: 0,0:09:36.64,0:09:37.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:09:37.52,0:09:40.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya tidak jelek, tapi aku\Nmengincar yang lebih tinggi.
Dialogue: 0,0:09:40.89,0:09:42.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembagian skill juga sudah kuatur.
Dialogue: 0,0:09:42.85,0:09:45.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Naku juga tidak akan memakainya!
Dialogue: 0,0:09:45.27,0:09:46.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, kamu yakin?
Dialogue: 0,0:09:46.94,0:09:51.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan Skill Tree ini, untuk sementara\Nkamu tidak akan kesulitan cari rekan.
Dialogue: 0,0:09:52.53,0:09:57.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah itu artinya tujuanku akan berubah?
Dialogue: 0,0:09:57.03,0:10:01.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ingin mengincar target\Nyang lebih tinggi!
Dialogue: 0,0:10:01.04,0:10:06.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, bukankah sedih\Nkalau harus berpisah secepat ini?
Dialogue: 0,0:10:09.59,0:10:11.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, itu kita jual saja.
Dialogue: 0,0:10:11.84,0:10:14.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya, aku lebih terbantu\Nkalau itu dijual.
Dialogue: 0,0:10:15.14,0:10:17.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu kesulitan uang?
Dialogue: 0,0:10:17.76,0:10:23.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Total pendapatan kali ini setelah dipotong\Nbanyak hal jadi sekitar 57 juta Gold.
Dialogue: 0,0:10:24.06,0:10:26.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mendengar nominalnya saja\Nsudah membuatku pusing.
Dialogue: 0,0:10:26.86,0:10:28.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini lalu dibagi jadi 80:20,
Dialogue: 0,0:10:28.98,0:10:31.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagianmu 46 juta Gold.
Dialogue: 0,0:10:31.78,0:10:35.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, aku dapat 11 juta Gold.
Dialogue: 0,0:10:35.74,0:10:36.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon!
Dialogue: 0,0:10:36.99,0:10:40.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kujamin tidak akan rugi,\Njadi tolong buatlah grup denganku!
Dialogue: 0,0:10:40.16,0:10:42.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bagi hasil 80:20, bagaimana?
Dialogue: 0,0:10:42.66,0:10:45.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu, kamu yang 80%,\Naku 20% saja bukan masalah!
Dialogue: 0,0:10:45.67,0:10:48.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ucapan itu masih berlaku?
Dialogue: 0,0:10:52.34,0:10:55.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche, pelanggan yang lain jadi melihat!
Dialogue: 0,0:10:55.09,0:10:57.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa masih kurang kalau dibagi 80:20?
Dialogue: 0,0:10:57.64,0:10:59.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, maaf—
Dialogue: 0,0:10:59.05,0:11:00.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu!
Dialogue: 0,0:11:00.22,0:11:04.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dipikir seperti apa pun,\Nmana bisa aku menerimanya!
Dialogue: 0,0:11:04.02,0:11:07.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari mana asal hitungan 80:20 itu?
Dialogue: 0,0:11:07.48,0:11:11.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha-Habisnya pembagian jatah\Nkebanyakan memang seperti ini...
Dialogue: 0,0:11:11.82,0:11:15.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aturan bagi jatah dari mana itu?
Dialogue: 0,0:11:15.32,0:11:19.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu bisa menerima\N40 juta Gold ini kalau posisinya dibalik?
Dialogue: 0,0:11:19.33,0:11:24.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah dibantu naik level sampai sini saja\Ntidak cukup kalau cuma berterima kasih!
Dialogue: 0,0:11:25.21,0:11:29.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pa-Padahal menurutku sudah masuk akal...
Dialogue: 0,0:11:41.60,0:11:45.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya, belum ada kesepakatan\Nsoal pembagian uang.
Dialogue: 0,0:11:46.10,0:11:47.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk menjual item yang didapat,
Dialogue: 0,0:11:47.65,0:11:51.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami pun memutuskan pergi\Nke Aula Kitab Sihir Rusak.
Dialogue: 0,0:12:07.87,0:12:10.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kamu datang lagi.
Dialogue: 0,0:12:10.71,0:12:13.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini mengajak gadis yang menggemaskan.
Dialogue: 0,0:12:13.63,0:12:15.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rekanmu, ya?
Dialogue: 0,0:12:15.71,0:12:17.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Benda itu" masih ada, kan?
Dialogue: 0,0:12:17.68,0:12:19.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ini curigaan sekali.
Dialogue: 0,0:12:19.68,0:12:23.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau maksudmu Taring Bara Kegilaan,\Ntentu masih ada.
Dialogue: 0,0:12:23.39,0:12:26.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini sangat menjaga kepercayaan.
Dialogue: 0,0:12:27.98,0:12:32.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, di toko ini ada item\Nyang Elymas inginkan?
Dialogue: 0,0:12:32.06,0:12:34.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis yang polos sekali.
Dialogue: 0,0:12:34.23,0:12:39.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu mau menyuruhnya\Nmempelajari Skill Tree itu?
Dialogue: 0,0:12:39.74,0:12:41.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan berkata konyol.
Dialogue: 0,0:12:41.45,0:12:43.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin aku melakukan hal gila itu.
Dialogue: 0,0:12:43.49,0:12:45.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu untukku.
Dialogue: 0,0:12:46.87,0:12:52.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun juga, menginginkan\Nbenda itu saja dasarnya sudah gila.
Dialogue: 0,0:12:53.59,0:12:57.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini, aku datang untuk memintamu\Nmenilai beberapa item.
Dialogue: 0,0:12:57.34,0:12:58.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh...
Dialogue: 0,0:12:58.76,0:13:06.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang sebijak dirimu kukira tidak akan\Nkepikiran menjual barang di tempatku.
Dialogue: 0,0:13:17.36,0:13:19.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sangat mengejutkan!
Dialogue: 0,0:13:19.45,0:13:22.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada dua Belati Berhias Rana Berkilau!
Dialogue: 0,0:13:22.95,0:13:28.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tahu kamu sehebat ini,\Naku pasti akan lebih ramah padamu.
Dialogue: 0,0:13:28.08,0:13:30.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh disayangkan.
Dialogue: 0,0:13:30.54,0:13:32.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak suka tawar-menawar\Nyang merepotkan!
Dialogue: 0,0:13:33.42,0:13:37.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau berani bayar 30 juta Gold,\Nakan kujual di sini.
Dialogue: 0,0:13:37.96,0:13:40.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau di bawah itu, akan kucari toko lain.
Dialogue: 0,0:13:46.93,0:13:51.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat toko yang terang-terangan,\N30 juta itu pasti agak sulit.
Dialogue: 0,0:13:51.94,0:13:56.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, di sini tidak akan muncul gosip aneh\Nyang bisa membuat orang dengki.
Dialogue: 0,0:13:56.02,0:14:00.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu membahayakan diri\Nhanya demi nominal kecil.
Dialogue: 0,0:14:01.40,0:14:04.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}25 juta Gold.
Dialogue: 0,0:14:04.57,0:14:06.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nenek sialan ini!
Dialogue: 0,0:14:06.49,0:14:10.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal sudah kubilang tidak mau\Nada tawar-menawar!
Dialogue: 0,0:14:12.29,0:14:17.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elymas, bukankah ucapan pemilik toko\Nada benarnya?
Dialogue: 0,0:14:17.34,0:14:20.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}25 juta Gold itu juga sudah besar.
Dialogue: 0,0:14:20.67,0:14:22.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terhasut, Ruche!
Dialogue: 0,0:14:22.34,0:14:25.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu nanti dimanfaatkan\Nkalau menunjukkan sisi lemahmu!
Dialogue: 0,0:14:27.85,0:14:30.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}30 juta Gold memang nominal\Nyang terlalu berani.
Dialogue: 0,0:14:30.97,0:14:34.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkeliling ke toko lainnya juga akan sulit.
Dialogue: 0,0:14:34.23,0:14:38.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mempertimbangkan risikonya,\Ndijual di toko ini adalah salah satu opsi.
Dialogue: 0,0:14:38.44,0:14:43.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau termakan permainan pemilik toko,\Nkurasa harganya nanti bisa lebih turun lagi.
Dialogue: 0,0:14:45.91,0:14:48.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga punya uang\Ndari hasil menjual batu sihir.
Dialogue: 0,0:14:48.70,0:14:53.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belati ini bisa kusimpan saja jadi aset\Nsampai ada tawaran yang bagus.
Dialogue: 0,0:14:53.21,0:14:56.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, berarti aku tidak bisa\Nmenekanmu terlalu jauh.
Dialogue: 0,0:14:56.79,0:14:58.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali.
Dialogue: 0,0:14:58.50,0:15:00.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bukankah dirimu
Dialogue: 0,0:15:00.84,0:15:03.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}punya tujuan lain yang sebenarnya, kan?
Dialogue: 0,0:15:08.05,0:15:11.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya Skill Book\Ndari drop Master dungeon.
Dialogue: 0,0:15:11.85,0:15:14.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya bingung mau kupakai atau tidak,
Dialogue: 0,0:15:14.35,0:15:18.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi akan kupertimbangkan untuk dijual\Nkalau tawaran hargamu menarik.
Dialogue: 0,0:15:18.90,0:15:21.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill Book?
Dialogue: 0,0:15:22.69,0:15:26.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh mengejutkan sekali\Ndalam waktu sesingkat ini.
Dialogue: 0,0:15:26.78,0:15:27.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu...
Dialogue: 0,0:15:27.70,0:15:29.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kalian...
Dialogue: 0,0:15:29.62,0:15:34.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin dalam waktu dekat\Nakan dikenal sebagai pahlawan.
Dialogue: 0,0:15:35.50,0:15:37.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:15:37.25,0:15:40.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ingin menjual ini,\Ntentu akan menjualnya di sini.
Dialogue: 0,0:15:40.13,0:15:44.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dia mulai tertarik,\Ntapi bisa dibawa sejauh mana tawarannya.
Dialogue: 0,0:15:44.63,0:15:48.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harga pasar 20 juta Gold.
Dialogue: 0,0:15:48.34,0:15:52.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sendiri juga bisa kena bahaya\Nkalau menjual benda ini.
Dialogue: 0,0:15:52.93,0:15:58.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau diserahkan ke serikat,\Npaling cuma tujuh juta Gold.
Dialogue: 0,0:15:58.40,0:16:00.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kelihatannya cukup jago,
Dialogue: 0,0:16:00.61,0:16:04.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}biar kuberi sedikit tawaran menarik\Nuntuk memikirkan ke depannya.
Dialogue: 0,0:16:04.44,0:16:09.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bersedia membelinya\Ndengan harga 14 juta Gold.
Dialogue: 0,0:16:09.57,0:16:13.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paling nanti akan kamu pajang di toko\Ndengan harga selangit, kan?
Dialogue: 0,0:16:13.08,0:16:16.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mencari orang yang menginginkan\NSihir Angin Menengah itu mudah.
Dialogue: 0,0:16:16.58,0:16:18.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu ingin kita bisa\Nberhubungan baik,
Dialogue: 0,0:16:18.83,0:16:22.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukankah masih wajar kalau kamu tawar\Nseharga 22 juta Gold?
Dialogue: 0,0:16:28.01,0:16:28.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panas!
Dialogue: 0,0:16:28.93,0:16:31.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah!\NKamu ini cuma bocah!
Dialogue: 0,0:16:31.01,0:16:34.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu kalian berdua\Ntidak berniat menggunakannya!
Dialogue: 0,0:16:34.51,0:16:37.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terlalu serakah!
Dialogue: 0,0:16:37.77,0:16:39.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya kamu yang jangan serakah!
Dialogue: 0,0:16:39.65,0:16:42.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bilang begitu karena mau kujadikan\Ntempat ini sebagai langgananku!
Dialogue: 0,0:16:42.77,0:16:46.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada ruginya sedikit mengalah, kan?
Dialogue: 0,0:16:49.53,0:16:51.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf...
Dialogue: 0,0:16:52.32,0:16:58.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taring Bara Kegilaan yang Elymas incar\Nitu harganya berapa?
Dialogue: 0,0:16:58.50,0:17:00.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, gadis kecil?
Dialogue: 0,0:17:00.58,0:17:04.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal sekarang lagi bagian serunya.
Dialogue: 0,0:17:04.25,0:17:06.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benda yang bocah itu incar
Dialogue: 0,0:17:06.80,0:17:10.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah Skill Book langka\Nyang harganya 55 juta Gold.
Dialogue: 0,0:17:10.01,0:17:13.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal harga pasarnya cuma 30 juta Gold.
Dialogue: 0,0:17:13.64,0:17:16.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia benar-benar tahu kondisiku.
Dialogue: 0,0:17:16.93,0:17:20.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Li-Lima puluh lima juta Gold...
Dialogue: 0,0:17:20.02,0:17:24.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah berjaga-jaga dari mendengar\Nobrolan kalian, tapi mahal sekali...
Dialogue: 0,0:17:26.90,0:17:28.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Bu Pemilik Toko!
Dialogue: 0,0:17:29.78,0:17:31.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kepikiran sesuatu!
Dialogue: 0,0:17:31.95,0:17:33.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau Skill Book itu
Dialogue: 0,0:17:33.53,0:17:39.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}serta seluruh item di meja ini\Nditukar dengan Taring Bara Kegilaan?
Dialogue: 0,0:17:39.04,0:17:40.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:17:40.00,0:17:42.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan negosiasi namanya.
Dialogue: 0,0:17:42.67,0:17:45.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyela obrolan tanpa pikir panjang—
Dialogue: 0,0:17:45.29,0:17:46.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu.
Dialogue: 0,0:17:46.67,0:17:50.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa menjual Taring Bara Kegilaan\Nyang pembelinya sedikit,
Dialogue: 0,0:17:50.47,0:17:54.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu dapat sepaket item yang mudah dijual,\Nkalau dipikir-pikir...
Dialogue: 0,0:17:54.97,0:17:57.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lumayan juga.
Dialogue: 0,0:17:57.76,0:18:01.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Usulan Ruche memang cukup\Nmenguntungkan untukku.
Dialogue: 0,0:18:01.69,0:18:05.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan uang penjualan kristal sihir\Ndan upah penaklukan tetap utuh,
Dialogue: 0,0:18:05.15,0:18:07.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa mendapat Taring Bara Kegilaan.
Dialogue: 0,0:18:09.36,0:18:11.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis kecil.
Dialogue: 0,0:18:11.53,0:18:15.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan suka mengganggu pebisnis\Nyang sedang berunding.
Dialogue: 0,0:18:15.57,0:18:19.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bertaruh pada pahlawan\Ndi masa depan boleh juga.
Dialogue: 0,0:18:19.54,0:18:22.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuterima dengan tawaran seperti itu.
Dialogue: 0,0:18:22.66,0:18:24.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:18:24.67,0:18:26.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tunggu dulu!
Dialogue: 0,0:18:26.96,0:18:30.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku tidak bisa\Nmembagikan jatah upahmu!
Dialogue: 0,0:18:30.17,0:18:32.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah dipikirkan kalau cuma sebegini!
Dialogue: 0,0:18:32.47,0:18:35.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggap saja hadiah\Nsebagai bentuk terima kasihku!
Dialogue: 0,0:18:35.47,0:18:38.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Tapi, nominalnya terlalu besar\Nuntuk bentuk utang budi.
Dialogue: 0,0:18:38.97,0:18:42.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, meski kali ini lancar,\Nke depannya kita belum tahu!
Dialogue: 0,0:18:42.60,0:18:46.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau nanti situasinya\Nmemaksa kita membubarkan grup?
Dialogue: 0,0:18:46.23,0:18:47.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elymas.
Dialogue: 0,0:18:49.40,0:18:52.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang kamu berniat membuangku?
Dialogue: 0,0:18:52.82,0:18:55.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya kamu seolah berusaha\Nagar tidak ada masalah di masa depan.
Dialogue: 0,0:18:55.86,0:18:59.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak, bukan begitu,\Ncuma berjaga-jaga saja.
Dialogue: 0,0:18:59.79,0:19:02.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, itu bukan masalah.
Dialogue: 0,0:19:03.21,0:19:06.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, Bu Pemilik Toko!\NAyo segera kita tukar barangnya!
Dialogue: 0,0:19:06.96,0:19:10.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum Elymas bilang yang tidak-tidak lagi!
Dialogue: 0,0:19:10.38,0:19:12.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu hebat bisa membujuknya, gadis kecil.
Dialogue: 0,0:19:12.84,0:19:16.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pegang yang erat, jangan sampai dia kabur.
Dialogue: 0,0:19:17.14,0:19:19.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tos!\N- Tos!
Dialogue: 0,0:19:20.60,0:19:24.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa mereka berdua malah bisa kompak?
Dialogue: 0,0:20:50.94,0:20:53.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak sanggup melihatnya...
Dialogue: 0,0:20:54.40,0:20:56.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Malice, sudah cukup!
Dialogue: 0,0:20:56.94,0:20:59.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Transfer Daya Hidup sudah selesai!
Dialogue: 0,0:21:00.95,0:21:02.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara ini rasanya sedikit kejam...
Dialogue: 0,0:21:02.95,0:21:04.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski demi menaikkan level...
Dialogue: 0,0:21:04.66,0:21:05.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agak berlebihan...
Dialogue: 0,0:21:14.38,0:21:17.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sudah diasingkan,
Dialogue: 0,0:21:17.17,0:21:22.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tahu betul kalau sejak kecil\Nkamu tidak akan menyerah semudah itu.
Dialogue: 0,0:21:23.60,0:21:29.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski memakan waktu, aku harus\Nmemojokkanmu dengan perlahan dan teliti.
Dialogue: 0,0:21:30.60,0:21:32.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan?
Dialogue: 0,0:21:32.94,0:21:36.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elymas sayangku.
Dialogue: 0,0:23:09.91,0:23:11.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya!
Dialogue: 0,0:23:11.49,0:23:16.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya kudapatkan juga!\NSkill Book Taring Bara Kegilaan!
Dialogue: 0,0:23:16.25,0:23:19.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Janganlah mendekati pemilik Skill Tree ini.
Dialogue: 0,0:23:19.63,0:23:22.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan menyeret tubuh yang hancur,\Nserta mengibas ekor tercabik,
Dialogue: 0,0:23:22.80,0:23:27.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan malaikat maut pun takut mendekati\Namukannya yang tak terhentikan!
Dialogue: 0,0:23:27.64,0:23:30.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya kangen sekali dengan\Nteks deskripsi brutal ini!
Dialogue: 0,0:23:31.56,0:23:33.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya,\NMasa Lalu yang Tak Bisa Dihindari.
Dialogue: 0,0:23:34.56,0:23:38.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, aku tidak boleh terlalu kegirangan.
