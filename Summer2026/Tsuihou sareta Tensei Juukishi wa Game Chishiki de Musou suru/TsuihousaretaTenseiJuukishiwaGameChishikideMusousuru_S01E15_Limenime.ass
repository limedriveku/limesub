Dialogue: 0,0:08:04.63,0:08:04.96,sign,,0000,0000,0000,,SKILL TREE BADUT LV47\NSISA SKILL POINT: 3
Dialogue: 0,0:08:04.96,0:08:08.76,sign,,0000,0000,0000,,KARENA AKROBAT BADUT TELAH NAIK KE LEVEL 18
Dialogue: 0,0:08:08.76,0:08:13.35,sign,,0000,0000,0000,,MENDAPAT SKILL SERANGAN BERUNTUN AKROBAT
Dialogue: 0,0:09:54.37,0:09:55.95,sign,,0000,0000,0000,,TEKAN UNTUK MEMULAI
Dialogue: 0,0:10:33.49,0:10:40.16,sign,,0000,0000,0000,,TEROWONGAN LIPAN - BAGIAN TERDALAM
Dialogue: 0,0:11:52.73,0:11:59.41,sign,,0000,0000,0000,,TEROWONGAN LIPAN - BAGIAN TERDALAM
Dialogue: 0,0:12:45.83,0:12:49.33,sign,,0000,0000,0000,,MONSTER: ROCK CENTIPEDE
Dialogue: 0,0:14:14.96,0:14:17.46,sign,,0000,0000,0000,,ROCK BLAST
Dialogue: 0,0:14:42.95,0:14:47.20,sign,,0000,0000,0000,,MENDAPAT 2379 POIN PENGALAMAN
Dialogue: 0,0:14:47.70,0:14:49.45,sign,,0000,0000,0000,,MENDAPAT 2379 POIN PENGALAMAN
Dialogue: 0,0:16:48.40,0:16:50.57,sign,,0000,0000,0000,,EVOLUSI EKSISTENSI
Dialogue: 0,0:19:39.45,0:19:41.03,sign,,0000,0000,0000,,ROCK CENTIPEDE TELAH MENGALAMI
Dialogue: 0,0:19:41.03,0:19:42.16,sign,,0000,0000,0000,,EVOLUSI EKSISTENSI MENJADI DEATH AMUDE
Dialogue: 0,0:19:44.04,0:19:47.29,sign,,0000,0000,0000,,MONSTER: DEATH AMUDE
Dialogue: 0,0:20:20.53,0:20:26.54,sign,,0000,0000,0000,,MONSTER: DEATH AMUDE
Dialogue: 0,0:00:19.62,0:00:22.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Ba-Ba...
Dialogue: 0,0:00:22.42,0:00:25.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Batu sihirnya besar sekali!
Dialogue: 0,0:00:25.92,0:00:29.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batu Sihir ini saja sepertinya\Nsudah bernilai 2 juta Gold!
Dialogue: 0,0:00:29.93,0:00:34.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petualang tingkat atas memburu\Nmonster yang lebih kuat dari ini, kan?
Dialogue: 0,0:00:34.18,0:00:37.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Me-Memang sebanyak apa uang\Nyang mereka kumpulkan?
Dialogue: 0,0:00:47.24,0:00:50.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mythril Golem rasanya jadi bikin kesal, ya.
Dialogue: 0,0:00:51.36,0:00:54.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal monster aslinya tidak seimut ini.
Dialogue: 0,0:00:55.41,0:00:58.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, harganya tidaklah imut.
Dialogue: 0,0:00:58.75,0:01:00.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mythril Ingot.
Dialogue: 0,0:01:00.25,0:01:02.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harga pasar: 25 juta Gold.
Dialogue: 0,0:01:02.92,0:01:04.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bongkahan ingot Mythril.
Dialogue: 0,0:01:04.25,0:01:07.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Logam sihir yang diselimuti\Ncahaya Mana yang kuat.
Dialogue: 0,0:01:07.21,0:01:11.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Du-Dua puluh lima juta Gold?
Dialogue: 0,0:02:46.53,0:02:50.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Du... Du...
Dialogue: 0,0:02:50.07,0:02:52.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua puluh lima juta Gold?
Dialogue: 0,0:02:52.86,0:02:58.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya dungeon ini bisa semudah itu\Nmemuntahkan item mahal, ya?
Dialogue: 0,0:02:58.74,0:03:02.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mythril Golem itu monster\Nyang benar-benar langka.
Dialogue: 0,0:03:03.37,0:03:08.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, aku ingin menantangnya\Nmeski harus sedikit memaksakan diri.
Dialogue: 0,0:03:08.29,0:03:13.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mythril adalah perlengkapan terkuat\Nyang bisa dikenakan di level kita.
Dialogue: 0,0:03:17.43,0:03:19.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dijual sebenarnya menguntungkan,
Dialogue: 0,0:03:19.68,0:03:22.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi rasanya lebih baik\Njadikan senjata saja.
Dialogue: 0,0:03:22.72,0:03:24.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah kembali ke Lacoryna,
Dialogue: 0,0:03:24.98,0:03:27.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ayo cari pandai besi terampil\Nuntuk minta diolahkan.
Dialogue: 0,0:03:27.52,0:03:28.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti!
Dialogue: 0,0:03:28.56,0:03:30.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita lakukan itu saja!
Dialogue: 0,0:03:30.69,0:03:35.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masalahnya mau dibuat\Njadi pedang atau pisau.
Dialogue: 0,0:03:35.19,0:03:38.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada juga opsi lain untuk dijadikan\Ntameng atau zirah...
Dialogue: 0,0:03:38.28,0:03:40.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senjata mythril, ya?
Dialogue: 0,0:03:40.58,0:03:42.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kali ini dijadikan pisau saja.
Dialogue: 0,0:03:42.79,0:03:45.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakal jadi seperti apa, ya?
Dialogue: 0,0:03:45.58,0:03:50.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dipegang Ruche yang gesit\Ndan sekarang jadi kunci penyerangan,
Dialogue: 0,0:03:50.38,0:03:52.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}cara bertarung kami akan jadi stabil.
Dialogue: 0,0:03:52.63,0:03:57.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, sebagai bentuk balasanku\Nkarena berutang besar pada Ruche.
Dialogue: 0,0:03:59.01,0:04:01.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi tidak sabar!
Dialogue: 0,0:04:08.65,0:04:10.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini, hasil yang kami dapat
Dialogue: 0,0:04:10.94,0:04:12.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah melebihi Kota Mainan Malaikat.
Dialogue: 0,0:04:12.23,0:04:14.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Efek Badut Keberuntungan spesialis Hoki Gila
Dialogue: 0,0:04:14.78,0:04:16.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memang luar biasa.
Dialogue: 0,0:04:17.49,0:04:18.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan laju seperti ini,
Dialogue: 0,0:04:18.95,0:04:22.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengumpulkan uang demi mendapat\NGenggaman Maut Dewa Kematian untuk Ruche,
Dialogue: 0,0:04:22.58,0:04:24.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rasanya tidak akan sulit.
Dialogue: 0,0:04:24.49,0:04:27.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sepakat seperti itu,\Nwaktunya kembali ke kota.
Dialogue: 0,0:04:27.71,0:04:29.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!\NAyo pulang!
Dialogue: 0,0:04:38.88,0:04:43.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu,\Nkita sudah masuk cukup dalam, ya.
Dialogue: 0,0:04:44.64,0:04:49.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga di jalan pulang tidak ada monster\Nmenyusahkan yang menyerang.
Dialogue: 0,0:04:49.14,0:04:53.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah berhasil mengalahkan Mythril Golem,
Dialogue: 0,0:04:53.02,0:04:55.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak ada lagi musuh berarti\Ndi dungeon Terowongan Lipan ini.
Dialogue: 0,0:04:55.82,0:05:00.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ceroboh, Mythril Golem justru\Nbisa lebih berbahaya dari master dungeon ini.
Dialogue: 0,0:05:00.53,0:05:05.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya wajar bagi kita yang sudah naik level\Nbisa mengalahkan master dengan mudah.
Dialogue: 0,0:05:07.62,0:05:09.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:05:09.71,0:05:11.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche.
Dialogue: 0,0:05:11.21,0:05:14.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada cara untuk langsung keluar dari dungeon
Dialogue: 0,0:05:14.13,0:05:17.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tanpa perlu berjalan ke arah kita masuk.
Dialogue: 0,0:05:17.42,0:05:19.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya ada cara seperti itu?
Dialogue: 0,0:05:19.84,0:05:22.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah pernah mengalaminya sekali.
Dialogue: 0,0:05:23.55,0:05:25.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan mengalahkan master dungeon.
Dialogue: 0,0:05:27.77,0:05:34.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dice Thrust!
Dialogue: 0,0:05:50.71,0:05:54.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa itu tidak berbahaya?
Dialogue: 0,0:05:54.79,0:05:57.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master dungeon ini gerakannya lambat,
Dialogue: 0,0:05:57.16,0:06:00.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tidak terlalu kuat\Nasal tahu pola serangannya.
Dialogue: 0,0:06:00.67,0:06:05.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, kukira Mythril Golem akan\Nmembuat kita lebih lelah dari ini,
Dialogue: 0,0:06:05.80,0:06:08.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ternyata bisa menyisihkan stamina.
Dialogue: 0,0:06:08.43,0:06:10.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:06:10.10,0:06:13.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya aku berniat memakai\NAmukan Naga di Ambang Ajal.
Dialogue: 0,0:06:16.15,0:06:19.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, berkat kamu yang berhasil\Nmelancarkan Dice Thrust,
Dialogue: 0,0:06:19.19,0:06:22.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}HP milikku jadi tidak perlu terkuras.
Dialogue: 0,0:06:22.61,0:06:24.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski punya ramuan penyembuh,
Dialogue: 0,0:06:24.78,0:06:29.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau terus terluka dan disembuhkan,\Nakan menumpuk jadi kelelahan mental.
Dialogue: 0,0:06:29.99,0:06:33.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sampai terpaksa memakai\NAmukan Naga di Ambang Ajal,
Dialogue: 0,0:06:33.04,0:06:35.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku berniat untuk mundur saja.
Dialogue: 0,0:06:35.17,0:06:37.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, di kondisi kami sekarang,
Dialogue: 0,0:06:37.04,0:06:40.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak ada alasan mundur\Ndari hadapan master tempat ini.
Dialogue: 0,0:06:41.38,0:06:44.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master dungeon ini monster seperti apa?
Dialogue: 0,0:06:44.80,0:06:47.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau harus bilang seperti apa...
Dialogue: 0,0:06:47.83,0:06:50.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sesuai dengan nama "Terowongan Lipan".
Dialogue: 0,0:06:50.64,0:06:52.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rock Centipede.
Dialogue: 0,0:06:52.81,0:06:55.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alias Kelabang Batu.
Dialogue: 0,0:06:56.52,0:06:58.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelabang... Batu?
Dialogue: 0,0:06:58.56,0:07:00.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gede!
Dialogue: 0,0:07:00.15,0:07:02.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, mau mundur saja?
Dialogue: 0,0:07:02.65,0:07:04.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak, ayo kita lawan saja!
Dialogue: 0,0:07:04.57,0:07:05.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak apa-apa!
Dialogue: 0,0:07:05.91,0:07:06.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat sekarang...
Dialogue: 0,0:07:06.82,0:07:09.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}serangga agak gede bukanlah masalah!\NYakin!
Dialogue: 0,0:07:50.62,0:07:51.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oke.
Dialogue: 0,0:07:51.99,0:07:54.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Poinnya kumasukkan ke Akrobat Badut, ya?
Dialogue: 0,0:07:54.62,0:07:55.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:07:55.58,0:07:58.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill yang di dapat dari Akrobat Badut level 18
Dialogue: 0,0:07:58.71,0:08:01.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan menjadi senjata kuat\Nuntuk Badut tipe apa pun.
Dialogue: 0,0:08:04.96,0:08:08.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Akrobat Badut telah naik ke level 18,
Dialogue: 0,0:08:08.76,0:08:11.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mendapat skill Serangan Beruntun Akrobat.
Dialogue: 0,0:08:13.68,0:08:17.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berhasil mempelajari skill\NSerangan Beruntun Akrobat!
Dialogue: 0,0:08:19.56,0:08:22.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya kamu sudah cukup paham\Nlewat deskripsi skill,
Dialogue: 0,0:08:22.90,0:08:25.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sebaiknya kita coba dulu sekali.
Dialogue: 0,0:08:25.11,0:08:26.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:08:27.32,0:08:31.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bayangannya begini, setelah mengentakkan\Nkaki ke tanah untuk melompat ke udara,
Dialogue: 0,0:08:31.24,0:08:35.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}manfaatkan momentum dengan mengalirkan Mana\Nuntuk mempertahankan kecepatan putaran.
Dialogue: 0,0:08:38.75,0:08:40.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi begitu!
Dialogue: 0,0:08:40.03,0:08:41.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham garis besarnya!
Dialogue: 0,0:08:41.88,0:08:45.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, rasanya akan ada celah\Nsetelah menggunakannya.
Dialogue: 0,0:08:45.34,0:08:48.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau digunakan melawan Mythril Golem,
Dialogue: 0,0:08:48.01,0:08:50.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rasanya aku bakal terempas\Noleh serangan baliknya.
Dialogue: 0,0:08:50.68,0:08:53.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlu pembiasaan untuk mengatasi itu.
Dialogue: 0,0:08:53.14,0:08:55.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kali ini kamu tenang saja.
Dialogue: 0,0:08:56.81,0:09:01.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelabang Batu punya celah mutlak\Nuntuk diserang dengan skill serangan beruntun.
Dialogue: 0,0:09:01.81,0:09:04.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Celah mutlak?
Dialogue: 0,0:09:07.32,0:09:09.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Benar juga!
Dialogue: 0,0:09:09.11,0:09:12.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu berhasil dilakukan,\Nrasanya bisa dikalahkan dengan mudah!
Dialogue: 0,0:09:12.87,0:09:16.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di level kita yang sekarang,\Nsejujurnya tidak ada celah untuk gagal!
Dialogue: 0,0:09:16.58,0:09:21.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini master yang mudah dikalahkan\Nselama tahu metodenya.
Dialogue: 0,0:09:24.71,0:09:27.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelabang Batu, Rock Centipede.
Dialogue: 0,0:09:27.59,0:09:29.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Punya status yang luar biasa.
Dialogue: 0,0:09:29.47,0:09:32.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terutama kecepatannya yang sangat menonjol.
Dialogue: 0,0:09:32.80,0:09:35.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Punya banyak cara menyerang serta brutal.
Dialogue: 0,0:09:35.47,0:09:39.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditambah dengan tubuh besarnya itu,\Ndia memang layak disebut master.
Dialogue: 0,0:09:40.06,0:09:45.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja, dia punya kelemahan besar\Nyang bisa meniadakan semua kelebihan itu.
Dialogue: 0,0:09:45.94,0:09:50.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia master yang sangat disayangkan\Noleh para pemain Magic World karena
Dialogue: 0,0:09:50.44,0:09:54.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa jadi musuh tangguh dan brutal\Nkalau ada sedikit saja yang beda.
Dialogue: 0,0:09:55.95,0:10:00.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pertama kalinya aku masuk\Nke bagian terdalam dungeon!
Dialogue: 0,0:10:00.25,0:10:03.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita dulu melawan Embryo\Ndi kondisi Wandering.
Dialogue: 0,0:10:06.46,0:10:09.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski mudah dikalahkan,\Nlawan kita tetap master.
Dialogue: 0,0:10:09.34,0:10:10.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sampai lengah!
Dialogue: 0,0:10:10.55,0:10:12.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik!
Dialogue: 0,0:10:12.93,0:10:13.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo masuk!
Dialogue: 0,0:10:33.49,0:10:36.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempatnya menakjubkan sekali...
Dialogue: 0,0:10:40.66,0:10:44.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Auranya memang lebih kuat dibanding\Nwaktu kulihat di gim dulu.
Dialogue: 0,0:10:45.25,0:10:49.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau di Bumi ada tempat seperti ini,\Npasti akan dicatat sebagai warisan dunia.
Dialogue: 0,0:10:56.55,0:11:00.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kita tidak punya waktu\Nuntuk menikmati pemandangan!
Dialogue: 0,0:11:26.29,0:11:28.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penunggunya sudah muncul!
Dialogue: 0,0:11:52.73,0:11:55.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempatnya menakjubkan sekali...
Dialogue: 0,0:11:59.77,0:12:03.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Auranya memang lebih kuat dibanding\Nwaktu kulihat di gim dulu.
Dialogue: 0,0:12:03.95,0:12:09.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau di Bumi ada tempat seperti ini,\Npasti akan dicatat sebagai warisan dunia.
Dialogue: 0,0:12:15.01,0:12:18.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kita tidak punya waktu\Nuntuk menikmati pemandangan!
Dialogue: 0,0:12:35.07,0:12:37.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penunggunya sudah muncul!
Dialogue: 0,0:12:49.79,0:12:53.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat kalahkan dia dan setelah dapat\Nitem dan poin pengalamannya,
Dialogue: 0,0:12:53.50,0:12:56.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ayo kita segera kembali ke kota!
Dialogue: 0,0:12:57.34,0:13:00.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Ternyata memang menjijikkan!
Dialogue: 0,0:13:00.22,0:13:02.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jumlah kakinya itu...
Dialogue: 0,0:13:07.60,0:13:10.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa fatal kalau sampai kena serangannya!
Dialogue: 0,0:13:10.10,0:13:11.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche, tolong lakukan sesuai rencana!
Dialogue: 0,0:13:11.73,0:13:13.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik!
Dialogue: 0,0:13:16.72,0:13:18.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shield Bash!
Dialogue: 0,0:13:23.62,0:13:26.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelemahan terbesar\Ndari Rock Centipede adalah
Dialogue: 0,0:13:26.62,0:13:32.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak punya cara ampuh menyerang musuh\Nyang naik ke atasnya!
Dialogue: 0,0:13:37.96,0:13:41.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, aku harus mencari cara\Nuntuk mengulur waktu!
Dialogue: 0,0:13:47.01,0:13:49.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan Beruntun Akrobat!
Dialogue: 0,0:14:00.69,0:14:03.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlebih lagi, akibat tubuhnya yang besar,
Dialogue: 0,0:14:03.49,0:14:08.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}serangan beruntun yang asal sekalipun\Nakan ia terima sepenuhnya.
Dialogue: 0,0:14:19.67,0:14:20.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche!
Dialogue: 0,0:14:23.05,0:14:25.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekali lagi!
Dialogue: 0,0:14:42.95,0:14:47.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mendapat 2379 poin pengalaman.
Dialogue: 0,0:14:47.70,0:14:49.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu berhasil, Ruche!
Dialogue: 0,0:14:51.83,0:14:54.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Telah naik ke level 52.
Dialogue: 0,0:14:54.96,0:14:58.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa ini berkat cara mengalahkannya,
Dialogue: 0,0:14:58.04,0:15:01.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi masih lebih kuat Mythril Golem, ya.
Dialogue: 0,0:15:02.09,0:15:05.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyiapkan strategi dari awal\Nmemang penting di Magic World,
Dialogue: 0,0:15:05.72,0:15:10.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi tidak ada master lain\Nyang hasilnya jadi semudah ini.
Dialogue: 0,0:15:10.22,0:15:13.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena bisa mudah dikalahkan\Ntergantung strategi yang dipakai.
Dialogue: 0,0:15:13.23,0:15:17.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat di gim, dia dijadikan sumber poin\Npengalaman di level rendah
Dialogue: 0,0:15:17.65,0:15:20.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan diperlakukan sebagai master\Nyang sedikit nahas.
Dialogue: 0,0:15:21.48,0:15:23.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche, kalau tidak turun,\Nkamu bisa terlu—
Dialogue: 0,0:15:23.61,0:15:24.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panas!
Dialogue: 0,0:15:26.78,0:15:31.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa,\Nasap ini terasa sangat panas!
Dialogue: 0,0:15:31.54,0:15:32.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panas?
Dialogue: 0,0:15:33.17,0:15:37.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tubuh sebesar Kelabang Batu\Nakan mengeluarkan banyak panas saat lenyap?
Dialogue: 0,0:15:38.42,0:15:43.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa efek hukum fisika dunia ini\Nyang dulunya tidak ada di gim?
Dialogue: 0,0:15:44.34,0:15:46.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, bukan!
Dialogue: 0,0:15:46.13,0:15:48.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche, cepat lompat ke sini!
Dialogue: 0,0:15:48.76,0:15:50.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia belum mati!
Dialogue: 0,0:15:51.39,0:15:54.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster yang harusnya sudah dikalahkan\Nmalah mengeluarkan uap yang berdampak.
Dialogue: 0,0:15:55.52,0:15:59.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fenomena ini sendiri\Njuga ada di Magic World!
Dialogue: 0,0:15:59.31,0:16:00.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:16:01.15,0:16:02.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan segera ke sana!
Dialogue: 0,0:16:03.94,0:16:05.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche!
Dialogue: 0,0:16:08.16,0:16:12.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, harusnya itu tidak terjadi di sini!
Dialogue: 0,0:16:29.26,0:16:32.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master mengalami Evolusi Eksistensi?
Dialogue: 0,0:16:33.89,0:16:35.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Ruche.
Dialogue: 0,0:16:36.89,0:16:39.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku salah mengambil keputusan.
Dialogue: 0,0:16:41.15,0:16:42.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin...
Dialogue: 0,0:16:42.90,0:16:45.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Evolusi Eksistensi?
Dialogue: 0,0:16:48.40,0:16:50.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Evolusi Eksistensi.
Dialogue: 0,0:16:50.57,0:16:55.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu adalah fenomena yang hanya terjadi\Npada segelintir monster
Dialogue: 0,0:16:55.33,0:16:58.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan syarat pemicunya\Nsudah ditentukan tiap ras.
Dialogue: 0,0:16:58.66,0:17:00.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di Magic World,
Dialogue: 0,0:17:00.25,0:17:05.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}syarat Evolusi Eksistensi dari semua monster\Nbelum terungkap dengan jelas.
Dialogue: 0,0:17:06.00,0:17:08.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain karena banyak syarat yang rumit,
Dialogue: 0,0:17:08.76,0:17:11.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}juga tidak ada manfaat\Nuntuk memicunya dengan sengaja.
Dialogue: 0,0:17:17.39,0:17:20.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja, meski sebatas garis besarnya,
Dialogue: 0,0:17:20.34,0:17:24.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tahu syarat Evolusi Eksistensi\Ndari Rock Centipede.
Dialogue: 0,0:17:25.60,0:17:28.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia harus melahap batu sihir\Ndi atas jumlah tertentu.
Dialogue: 0,0:17:29.24,0:17:33.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memakan mayat petualang\Ndi atas jumlah tertentu.
Dialogue: 0,0:17:33.24,0:17:37.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditambah, dia harus dibasmi oleh petualang!
Dialogue: 0,0:17:37.24,0:17:42.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kemungkinan syarat ini terpenuhi\Nnyaris mustahil.
Dialogue: 0,0:17:42.87,0:17:44.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syarat ini hanya bisa terpenuhi
Dialogue: 0,0:17:44.96,0:17:50.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau Wandering yang memungkinkan master\Nberkeliaran di dungeon terpicu beberapa kali.
Dialogue: 0,0:17:50.63,0:17:55.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar Terowongan Lipan\Nbaru muncul belakangan ini.
Dialogue: 0,0:17:55.89,0:17:59.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum lagi,\Nkalau ada korban akibat Wandering,
Dialogue: 0,0:17:59.27,0:18:02.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak mungkin kalau informasinya\Nbelum menyebar di kota.
Dialogue: 0,0:18:02.73,0:18:06.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski aturan di gim dan dunia ini\Nmemang berbeda,
Dialogue: 0,0:18:06.61,0:18:11.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sulit dibayangkan syarat Evolusi Eksistensi\Njadi turun tanpa alasan yang jelas.
Dialogue: 0,0:18:12.36,0:18:13.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang masuk akal adalah
Dialogue: 0,0:18:16.20,0:18:21.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada seseorang dengan tujuan jahat\Nyang memenuhi syarat Evolusi Eksistensinya.
Dialogue: 0,0:18:21.00,0:18:24.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, asumsi itu juga kurang meyakinkan.
Dialogue: 0,0:18:24.17,0:18:26.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain tidak ada alasan untuk melakukan itu,
Dialogue: 0,0:18:26.79,0:18:29.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sulit membayangkan ada orang di dunia ini
Dialogue: 0,0:18:29.67,0:18:32.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang tahu tentang syarat Evolusi Eksistensi\Ndan bisa memicunya.
Dialogue: 0,0:18:35.18,0:18:37.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang jelas adalah
Dialogue: 0,0:18:37.01,0:18:42.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena pemahamanku yang keliru,\NRuche jadi terseret ke kekacauan ini.
Dialogue: 0,0:18:43.56,0:18:45.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar minta maaf, Ruche.
Dialogue: 0,0:18:45.73,0:18:47.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir hal seperti ini mustahil terjadi.
Dialogue: 0,0:18:48.48,0:18:52.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin aku jadi lengah karena\Npetualangan kita terlalu lancar.
Dialogue: 0,0:18:52.44,0:18:55.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan minta maaf!
Dialogue: 0,0:18:55.11,0:18:56.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya!
Dialogue: 0,0:18:56.41,0:18:59.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong terbangkan aku lagi\Nmemakai Shield Bash!
Dialogue: 0,0:18:59.62,0:19:01.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kupakai serangan beruntun lagi...
Dialogue: 0,0:19:01.37,0:19:02.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:19:02.50,0:19:06.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah mengalami Evolusi Eksistensi,\Ndia tidak bisa dilukai dengan mudah.
Dialogue: 0,0:19:06.88,0:19:09.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dice Thrust juga tidak bisa disebut realistis.
Dialogue: 0,0:19:09.80,0:19:14.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dice Thrust setidaknya harus dapat\Nangka enam sebanyak empat kali.
Dialogue: 0,0:19:14.47,0:19:17.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan kalau berharap pada Hoki Gila Ruche,
Dialogue: 0,0:19:17.93,0:19:20.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}paling tidak harus dilancarkan\Nsebanyak sepuluh kali.
Dialogue: 0,0:19:20.81,0:19:24.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terus-menurus gagal,\Npenyembuhan otomatis miliknya akan aktif,
Dialogue: 0,0:19:25.19,0:19:27.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan jumlah yang diperlukan\Nakan terus bertambah.
Dialogue: 0,0:19:37.53,0:19:39.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rock Centipede telah mengalami
Dialogue: 0,0:19:39.45,0:19:42.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Evolusi Eksistensi menjadi Death Amude.
Dialogue: 0,0:19:44.66,0:19:47.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Telah naik ke level 75.
Dialogue: 0,0:19:47.29,0:19:49.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Level 75?
Dialogue: 0,0:19:52.38,0:19:53.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche, menghindar!
Dialogue: 0,0:20:02.51,0:20:05.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kecepatan dan daya serang\Nyang beda tingkatan.
Dialogue: 0,0:20:05.73,0:20:07.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Juga selisih levelnya.
Dialogue: 0,0:20:07.69,0:20:10.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas sangat mustahil\Nuntuk bisa melarikan diri!
Dialogue: 0,0:20:11.73,0:20:14.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andaikan berhasil kabur sekalipun,
Dialogue: 0,0:20:14.23,0:20:16.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau Death Amude sampai lepas\Njadi Wandering,
Dialogue: 0,0:20:16.90,0:20:20.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak ada yang tahu akan sebanyak apa\Nkorban jiwanya nanti!
Dialogue: 0,0:20:21.45,0:20:23.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Statusnya membuat putus asa.
Dialogue: 0,0:20:23.91,0:20:26.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat cepat dan daya serangnya juga tinggi.
Dialogue: 0,0:20:27.29,0:20:29.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski menyerang dari depan,
Dialogue: 0,0:20:29.37,0:20:33.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami akan tewas diempas tubuh raksasanya\Nsebelum bisa mendaratkan serangan!
Dialogue: 0,0:20:33.30,0:20:36.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus membuat kesempatan\Nuntuk menyerangnya dengan aman
Dialogue: 0,0:20:36.17,0:20:40.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu menembus HP\Ndan daya pertahanannya yang tinggi!
Dialogue: 0,0:20:41.11,0:20:46.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang risikonya masih terlalu tinggi,\Njadi ingin kucoba nanti saja,
Dialogue: 0,0:20:46.93,0:20:48.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi cuma ini pilihannya.
Dialogue: 0,0:20:48.56,0:20:49.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche.
Dialogue: 0,0:20:51.19,0:20:54.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski ini taktik yang tidak stabil\Ndan sembrono,
Dialogue: 0,0:20:54.07,0:20:57.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada satu cara yang mungkin\Nbisa membuat kita menang.
Dialogue: 0,0:20:59.91,0:21:03.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu mau menerima usulanku?
Dialogue: 0,0:21:13.84,0:21:16.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu yakin, Elymas?
Dialogue: 0,0:21:17.21,0:21:18.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:21:27.97,0:21:31.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuhajar dia dengan\Nserangan Kesatria Kelas Berat
Dialogue: 0,0:21:34.48,0:21:38.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang dulu disebut sebagai\NBalance Breaker di Magic World!
Dialogue: 0,0:23:10.54,0:23:12.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Evolusi Eksistensi.
Dialogue: 0,0:23:12.45,0:23:15.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukannya lengah,\Ntapi ini mustahil terjadi.
Dialogue: 0,0:23:16.17,0:23:19.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, mungkin ada kelengahan\Ndi suatu tempat.
Dialogue: 0,0:23:19.38,0:23:21.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuh kami Death Amude.
Dialogue: 0,0:23:21.30,0:23:24.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster yang tidak bisa dibandingkan\Ndengan versi sebelum evolusi.
Dialogue: 0,0:23:24.59,0:23:26.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil menang kalau tetap seperti sekarang.
Dialogue: 0,0:23:27.27,0:23:29.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku harus melakukannya!
Dialogue: 0,0:23:29.39,0:23:31.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya ledak luar biasa Kesatria Kelas Berat
Dialogue: 0,0:23:31.51,0:23:33.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan kuwujudkan ulang di dunia ini!
Dialogue: 0,0:23:33.95,0:23:36.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, Berkorban Nyawa.
Dialogue: 0,0:23:36.73,0:23:38.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesempatannya hanya sekali!
