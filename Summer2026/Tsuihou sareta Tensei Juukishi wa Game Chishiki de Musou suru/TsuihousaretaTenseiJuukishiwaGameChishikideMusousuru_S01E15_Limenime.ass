Dialogue: 0,0:04:12.98,0:04:13.65,sign,,0000,0000,0000,,"BARU" BATU SIHIR MYTHRIL GOLEM: 2 JUTA GOLD
Dialogue: 0,0:04:13.65,0:04:14.32,sign,,0000,0000,0000,,BATU SIHIR CRY: 900 RIBU GOLD
Dialogue: 0,0:04:14.32,0:04:14.78,sign,,0000,0000,0000,,BATU SIHIR SMILE: 800 RIBU GOLD X4
Dialogue: 0,0:04:14.78,0:04:16.99,sign,,0000,0000,0000,,TOTAL: 68,5 JUTA GOLD
