Dialogue: 0,0:01:07.84,0:01:08.63,sign,,0000,0000,0000,,TOLAKAN TEMBOK BENTENG
Dialogue: 0,0:03:57.72,0:04:00.39,sign,,0000,0000,0000,,KESATRIA KELAS BERAT TEREINKARNASI YANG DIASINGKAN\NJADI TANPA TANDING DENGAN PENGETAHUAN GIMNYA
Dialogue: 0,0:05:11.96,0:05:12.92,sign,,0000,0000,0000,,EPISODE 11: MASA LALU YANG TIDAK BISA DIHINDARI
Dialogue: 0,0:05:45.20,0:05:47.66,sign,,0000,0000,0000,,TARING BARA KEGILAAN [SKILL BOOK]
Dialogue: 0,0:05:47.66,0:05:50.37,sign,,0000,0000,0000,,HARGA PASAR: 30 JUTA G
Dialogue: 0,0:05:50.37,0:05:52.12,sign,,0000,0000,0000,,DAPAT DIGUNAKAN UNTUK MEMPELAJARI
Dialogue: 0,0:05:52.12,0:05:54.00,sign,,0000,0000,0000,,SKILL TREE TARING BARA KEGILAAN
Dialogue: 0,0:06:54.69,0:06:55.90,sign,,0000,0000,0000,,GLEK
Dialogue: 0,0:06:56.94,0:06:58.90,sign,,0000,0000,0000,,SKILL TREE KESATRIA KELAS BERAT: LV41\NSISA SKILL POINT: 13
Dialogue: 0,0:07:07.41,0:07:09.78,sign,,0000,0000,0000,,PENINGKAT DAYA PERTAHANAN
Dialogue: 0,0:07:32.18,0:07:33.39,sign,,0000,0000,0000,,TARING BARA KEGILAAN
Dialogue: 0,0:08:28.15,0:08:30.99,sign,,0000,0000,0000,,HASIL DROP SEBELUMNYA
Dialogue: 0,0:18:59.16,0:19:00.66,sign,,0000,0000,0000,,ELYMAS EDVAUGHN
Dialogue: 0,0:19:11.67,0:19:12.46,sign,,0000,0000,0000,,ELYMAS EDVAUGHN
Dialogue: 0,0:19:24.52,0:19:25.44,sign,,0000,0000,0000,,TEBASAN VITAL
Dialogue: 0,0:19:49.25,0:19:51.75,sign,,0000,0000,0000,,JULUKAN: PENGACAU ESTIMASI
Dialogue: 0,0:19:51.75,0:19:52.96,sign,,0000,0000,0000,,DAYA SERANG DAN KECEPATAN +15%
Dialogue: 0,0:19:52.96,0:19:54.71,sign,,0000,0000,0000,,SAAT MELAWAN MUSUH LEVEL LEBIH TINGGI
Dialogue: 0,0:00:29.88,0:00:32.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Transfer Daya Hidup sudah selesai!
Dialogue: 0,0:00:43.48,0:00:48.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa benar Elymas bertindak\Nsesuka hati di Kota Rondalm?
Dialogue: 0,0:00:51.86,0:00:54.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya tidak tahu kebenarannya,
Dialogue: 0,0:00:54.08,0:00:58.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi seseorang yang mirip dengan Tuan Elymas\Ntelah menorehkan prestasi luar biasa.
Dialogue: 0,0:01:02.75,0:01:04.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langsung menyerang, ya?
Dialogue: 0,0:01:04.79,0:01:05.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maju sini!
Dialogue: 0,0:01:08.63,0:01:10.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolakan Tembok Benteng!
Dialogue: 0,0:01:25.48,0:01:29.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shield Bash!
Dialogue: 0,0:01:32.82,0:01:38.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah jelas dia memakai nama keluarga\Nuntuk mengancam staf serikat!
Dialogue: 0,0:01:39.45,0:01:43.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah angkat kaki dari sini, dia masih saja\Nmencoreng nama keluarga Count Edvaughn.
Dialogue: 0,0:01:43.75,0:01:47.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan anggap belas kasih ayah dan anak\Nmasih berlaku untukmu, Elymas!
Dialogue: 0,0:01:47.38,0:01:50.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Elymas adalah sosok bijaksana\Ndan berhati mulia.
Dialogue: 0,0:01:50.21,0:01:54.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut saya, Tuan Elymas tidak akan\Nmelakukan hal biadab seperti itu.
Dialogue: 0,0:01:55.30,0:01:58.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon pastikan faktanya dulu, Tuan Aizas.
Dialogue: 0,0:01:59.64,0:02:00.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih!
Dialogue: 0,0:02:00.81,0:02:04.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, Thomas,\Npergilah untuk memastikan.
Dialogue: 0,0:02:04.40,0:02:07.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terbukti memanfaatkan nama keluarga,
Dialogue: 0,0:02:07.98,0:02:12.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}perintahkan serikat agar mengeluarkannya\Ndan larang dia untuk mendaftar ulang.
Dialogue: 0,0:02:12.20,0:02:13.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, sampaikan padanya,
Dialogue: 0,0:02:14.82,0:02:17.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kalau berani melakukan ini lagi,
Dialogue: 0,0:02:17.95,0:02:20.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nyawamu tak akan kuampuni."
Dialogue: 0,0:02:24.17,0:02:26.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepala Keluarga, ini saya.
Dialogue: 0,0:02:28.67,0:02:31.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Malice!\NMasuklah!
Dialogue: 0,0:02:37.51,0:02:40.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sikapmu seperti orang asing saja, Malice.
Dialogue: 0,0:02:40.22,0:02:43.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamulah kepala keluarga berikutnya,\Npenerusku.
Dialogue: 0,0:02:43.43,0:02:46.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu boleh memanggilku Ayah!
Dialogue: 0,0:02:47.40,0:02:51.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal obrolan barusan,\Nsaya rasa perlakuan Anda terlalu lunak.
Dialogue: 0,0:02:51.44,0:02:54.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Thomas terlalu memihak Elymas.
Dialogue: 0,0:02:54.40,0:02:57.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengusirannya dari serikat juga\Nterkesan setengah hati.
Dialogue: 0,0:02:57.57,0:03:00.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elymas yang kehilangan sumber penghidupan,
Dialogue: 0,0:03:00.08,0:03:03.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan kehabisan opsi dan makin\Nmelakukan tindakan dungu.
Dialogue: 0,0:03:03.58,0:03:06.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila nanti dia berakhir menjadi bandit,
Dialogue: 0,0:03:06.25,0:03:09.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu akan jadi aib besar Keluarga Edvaughn.
Dialogue: 0,0:03:10.09,0:03:13.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, ucapanmu memang benar.
Dialogue: 0,0:03:13.01,0:03:15.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, apa yang sebenarnya\Ningin kamu sampaikan?
Dialogue: 0,0:03:16.34,0:03:19.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita berdua yang pergi memeriksanya.
Dialogue: 0,0:03:21.18,0:03:24.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru mengambil keputusan langsung di tempat.
Dialogue: 0,0:03:37.99,0:03:41.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah Skill Book yang kamu incar\Nberhasil didapatkan.
Dialogue: 0,0:05:12.92,0:05:17.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akhirnya membeli Taring Bara Kegilaan.
Dialogue: 0,0:05:17.42,0:05:21.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bilang tidak keberatan,\Njadi apa masalahnya?
Dialogue: 0,0:05:21.09,0:05:23.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hadiah dariku!
Dialogue: 0,0:05:23.43,0:05:27.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, bukankah Elymas juga\Nsudah membelikanku Penembus Besi?
Dialogue: 0,0:05:27.93,0:05:31.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, harganya beda jauh.
Dialogue: 0,0:05:31.44,0:05:35.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, itu memang dibutuhkan\Nuntuk memburu Raana Emas
Dialogue: 0,0:05:35.36,0:05:37.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan aku juga yakin bakal balik modal.
Dialogue: 0,0:05:37.57,0:05:41.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya Skill Tree yang itu\Ntidak bisa balik modal?
Dialogue: 0,0:05:41.45,0:05:43.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti bisa!
Dialogue: 0,0:05:43.41,0:05:45.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin itu!
Dialogue: 0,0:05:45.20,0:05:47.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill Book Taring Bara Kegilaan.
Dialogue: 0,0:05:47.66,0:05:50.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harga pasar: 30 juta Gold.
Dialogue: 0,0:05:50.37,0:05:54.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Janganlah mendekati pemilik Skill Tree ini.
Dialogue: 0,0:05:54.00,0:05:57.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan menyeret tubuh yang hancur,\Nserta mengibas ekor tercabik,
Dialogue: 0,0:05:57.71,0:06:02.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan malaikat maut pun takut mendekati\Namukannya yang tak terhentikan.
Dialogue: 0,0:06:02.22,0:06:06.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche, aku boleh langsung memakainya?
Dialogue: 0,0:06:06.26,0:06:09.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tenang kalau nanti malah dicuri.
Dialogue: 0,0:06:10.22,0:06:12.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja boleh!\NSilakan!
Dialogue: 0,0:06:12.64,0:06:15.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, apa itu benaran kuat?
Dialogue: 0,0:06:15.23,0:06:15.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:06:15.98,0:06:18.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taring Bara Kegilaan itu.
Dialogue: 0,0:06:18.77,0:06:22.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Deskripsinya membuatku sedikit cemas.
Dialogue: 0,0:06:22.61,0:06:24.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yakin tidak akan apa-apa?
Dialogue: 0,0:06:24.41,0:06:27.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa saja ada efek samping yang aneh.
Dialogue: 0,0:06:27.70,0:06:29.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak salah kalau ini memang kuat.
Dialogue: 0,0:06:29.24,0:06:32.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatannya akan langsung naik pesat\Nsetelah dapat skill point yang cukup.
Dialogue: 0,0:06:34.25,0:06:36.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taring Bara Kegilaan bisa memberikan
Dialogue: 0,0:06:36.08,0:06:39.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}skill untuk bertarung mengorbankan nyawa\Ndan siap menghadapi kematian.
Dialogue: 0,0:06:39.75,0:06:44.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kombinasi dengan Kesatria Kelas Berat\Nbisa meningkatkan daya hancur
Dialogue: 0,0:06:44.26,0:06:47.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari Taring Bara Kegilaan\Nke tingkat yang tak masuk akal.
Dialogue: 0,0:06:49.89,0:06:53.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, akan langsung kugunakan.
Dialogue: 0,0:07:01.40,0:07:05.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill yang akan kuhapus untuk diganti\Ndengan Taring Bara Kegilaan
Dialogue: 0,0:07:05.20,0:07:06.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah Peningkat Daya Pertahanan.
Dialogue: 0,0:07:33.39,0:07:36.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Akhirnya dapat Taring Bara Kegilaan!
Dialogue: 0,0:07:36.69,0:07:38.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, Ruche!
Dialogue: 0,0:07:38.56,0:07:41.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa dapat ini berkatmu!
Dialogue: 0,0:07:41.94,0:07:46.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah Elymas bilang status itu\Nbukan hal untuk ditunjukkan ke orang?
Dialogue: 0,0:07:48.99,0:07:52.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa, aku turut senang!
Dialogue: 0,0:07:52.41,0:07:56.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mau langsung diberi skill point?
Dialogue: 0,0:07:56.58,0:08:01.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, Ikrar Zirah Berat dinaikkan\Nuntuk dapat skill ini dulu...
Dialogue: 0,0:08:10.68,0:08:12.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Level kita juga sudah lumayan meningkat,
Dialogue: 0,0:08:12.97,0:08:16.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin tidak ada salahnya\Nmenyiapkan ulang perlengkapan kita.
Dialogue: 0,0:08:16.52,0:08:21.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita coba peruntungan\Ndari drop item di dungeon?
Dialogue: 0,0:08:23.02,0:08:28.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini, Ruche, drop item itu\Nbukan sesuatu yang bisa diincar...
Dialogue: 0,0:08:30.99,0:08:32.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin bisa dicoba.
Dialogue: 0,0:08:32.99,0:08:34.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asyik!
Dialogue: 0,0:08:34.40,0:08:36.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saranku diterima!
Dialogue: 0,0:08:56.47,0:08:57.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan dia?
Dialogue: 0,0:08:57.77,0:08:59.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh!\NBeliau itu tuan tanah!
Dialogue: 0,0:09:00.44,0:09:02.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya dia Pedang Suci?
Dialogue: 0,0:09:02.44,0:09:05.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, selamat datang, Count Edvaughn.
Dialogue: 0,0:09:05.73,0:09:10.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa perlu apa sampai tiba-tiba datang\Nke serikat petualang?
Dialogue: 0,0:09:10.20,0:09:11.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ada urusan penting.
Dialogue: 0,0:09:11.74,0:09:13.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kosongkan tempat ini.
Dialogue: 0,0:09:14.45,0:09:15.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf?
Dialogue: 0,0:09:15.74,0:09:18.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Nbagaimana kalau bicara di dalam saja?
Dialogue: 0,0:09:19.41,0:09:21.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak dengar, ya?
Dialogue: 0,0:09:21.04,0:09:22.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kubilang kosongkan tempat ini!
Dialogue: 0,0:09:24.21,0:09:26.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha-Hari ini serikat kututup!
Dialogue: 0,0:09:26.34,0:09:28.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu tujuan mereka,
Dialogue: 0,0:09:28.59,0:09:30.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku tidak mau terlibat dengan Aizas.
Dialogue: 0,0:09:30.80,0:09:32.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pihak sana juga pasti merasa begitu.
Dialogue: 0,0:09:33.34,0:09:34.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo pergi, Ruche.
Dialogue: 0,0:09:34.72,0:09:36.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sampai menarik perhatian mereka.
Dialogue: 0,0:09:36.51,0:09:38.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik.
Dialogue: 0,0:09:38.22,0:09:41.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi beliau Tuan Aizas.
Dialogue: 0,0:09:41.52,0:09:45.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga Count Edvaughn\Ntidak punya kesan yang baik.
Dialogue: 0,0:09:45.98,0:09:49.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesannya menindas dan menyebalkan.
Dialogue: 0,0:09:52.15,0:09:54.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petualang yang di sana!
Dialogue: 0,0:09:54.07,0:09:55.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tetaplah di sini.
Dialogue: 0,0:09:57.49,0:09:58.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik!
Dialogue: 0,0:09:58.54,0:09:59.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf!\NMaaf!
Dialogue: 0,0:09:59.95,0:10:02.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya cuma bercanda\Nuntuk mencairkan suasana!
Dialogue: 0,0:10:02.37,0:10:03.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, maaf!
Dialogue: 0,0:10:03.08,0:10:04.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja, Ruche.
Dialogue: 0,0:10:07.96,0:10:12.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi mereka bilang punya urusan...
Dialogue: 0,0:10:13.09,0:10:15.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya urusannya denganku.
Dialogue: 0,0:10:48.21,0:10:50.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan bangsawan ada perlu apa denganku?
Dialogue: 0,0:10:51.17,0:10:54.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan cara bicaramu itu?
Dialogue: 0,0:10:56.51,0:10:59.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elymas, sikapmu itu tidak baik!
Dialogue: 0,0:10:59.64,0:11:01.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo cepat minta maaf sama-sama!
Dialogue: 0,0:11:01.43,0:11:01.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:11:02.47,0:11:03.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu...
Dialogue: 0,0:11:05.19,0:11:07.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari tadi berkeliaran dengan sok akrab.
Dialogue: 0,0:11:07.98,0:11:09.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu siapanya Elymas?
Dialogue: 0,0:11:09.90,0:11:14.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sa-Saya kenalannya Elymas...
Dialogue: 0,0:11:15.20,0:11:19.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche, kamu keluar saja dari sini.\NIni masalahku.
Dialogue: 0,0:11:19.33,0:11:20.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Tapi...
Dialogue: 0,0:11:20.62,0:11:23.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan keluar kalau memang mengganggu,
Dialogue: 0,0:11:23.37,0:11:28.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kalau itu agar aku tidak terlibat,\Njustru membuatku ingin tetap di sini!
Dialogue: 0,0:11:28.50,0:11:32.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski mungkin keberadaanku\Ntidak akan banyak membantu.
Dialogue: 0,0:11:32.92,0:11:34.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche...
Dialogue: 0,0:11:34.01,0:11:35.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu,
Dialogue: 0,0:11:35.55,0:11:40.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menurutku di saat seperti ini\Nrekan justru harus ikut menemani.
Dialogue: 0,0:11:40.01,0:11:42.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, perihal ini...
Dialogue: 0,0:11:42.31,0:11:46.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa meninggalkanmu\Nyang tampak tersiksa begitu!
Dialogue: 0,0:11:46.39,0:11:50.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis cilik, rakyat jelata sepertimu\Ningin mencampuri urusan kami?
Dialogue: 0,0:11:50.81,0:11:53.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat menyingkir dari sini!
Dialogue: 0,0:11:53.36,0:11:55.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahanda.
Dialogue: 0,0:11:55.15,0:11:57.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari biarkan dia tetap di sini.
Dialogue: 0,0:11:57.99,0:12:00.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dia cukup dekat dengan Elymas.
Dialogue: 0,0:12:00.87,0:12:03.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dia ada kaitannya dengan hal itu.
Dialogue: 0,0:12:04.95,0:12:06.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudahlah.
Dialogue: 0,0:12:06.83,0:12:12.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, aku sudah setuju agar dirimu\Nyang mengurusnya kali ini.
Dialogue: 0,0:12:12.00,0:12:14.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Count Edvaughn.
Dialogue: 0,0:12:14.25,0:12:17.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkinkah Anda mendengar\Nbahwa dia petualang ulung
Dialogue: 0,0:12:17.68,0:12:20.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kemari untuk merekrutnya\Njadi tentara pribadi?
Dialogue: 0,0:12:20.51,0:12:22.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat sekali Anda dengar beritanya.
Dialogue: 0,0:12:22.60,0:12:26.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petualang ini memang santun dan pemberani.
Dialogue: 0,0:12:26.77,0:12:29.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya mungkin akan tercatat\Ndi sejarah serikat kota ini.
Dialogue: 0,0:12:29.77,0:12:31.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketua Serikat.
Dialogue: 0,0:12:31.81,0:12:34.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan akting murahanmu itu.
Dialogue: 0,0:12:34.65,0:12:36.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah mengetahuinya, kan?
Dialogue: 0,0:12:36.86,0:12:38.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya?
Dialogue: 0,0:12:43.45,0:12:46.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahwa pria ini adalah\Nanggota keluarga Edvaughn!
Dialogue: 0,0:12:50.42,0:12:53.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa maksud Anda?
Dialogue: 0,0:12:53.04,0:12:57.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di antara pegawai serikat pasti ada\Nyang bersekongkol dengan bocah ini.
Dialogue: 0,0:12:57.21,0:12:58.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:12:58.26,0:13:02.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangkap semuanya dan bawa kemari!\NSekarang juga!
Dialogue: 0,0:13:02.39,0:13:04.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}To-Tolong tunggu sebentar!
Dialogue: 0,0:13:04.30,0:13:05.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak mungkin...
Dialogue: 0,0:13:08.23,0:13:10.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Se-Segera saya lakukan!
Dialogue: 0,0:13:10.31,0:13:13.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elymas, jangan-jangan...
Dialogue: 0,0:13:13.11,0:13:15.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Count Aizas itu...
Dialogue: 0,0:13:15.86,0:13:17.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia ayahku.
Dialogue: 0,0:13:19.32,0:13:21.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski aku tidak ingin mengakuinya.
Dialogue: 0,0:13:22.36,0:13:25.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar aib keluarga Count Edvaughn.
Dialogue: 0,0:13:25.66,0:13:29.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya memberimu hukuman pengasingan
Dialogue: 0,0:13:29.25,0:13:33.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena aku percaya kamu\Ntidak akan melakukan hal bodoh!
Dialogue: 0,0:13:33.92,0:13:39.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elymas, apa kamu sudah lupa ucapanku?
Dialogue: 0,0:13:39.05,0:13:41.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau berani menyebut nama\Nkeluarga Count Edvaughn lagi,
Dialogue: 0,0:13:42.34,0:13:45.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan memenggal kepalamu!
Dialogue: 0,0:13:56.73,0:14:00.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perjalananku sejak pergi\Ndari kediaman count terlalu lancar.
Dialogue: 0,0:14:02.28,0:14:05.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aizas yang mendengar\Nkenaikan kelasku yang luar biasa,
Dialogue: 0,0:14:05.49,0:14:11.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kelihatannya curiga ada kecurangan\Ndan datang untuk memeriksa sendiri.
Dialogue: 0,0:14:15.79,0:14:18.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira ada apa, ternyata seperti itu.
Dialogue: 0,0:14:20.05,0:14:23.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak pernah menyebut\Nnama keluarga Count Edvaughn.
Dialogue: 0,0:14:23.43,0:14:25.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Itu benar!
Dialogue: 0,0:14:25.89,0:14:29.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Anda begitu mencurigainya?
Dialogue: 0,0:14:36.48,0:14:38.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil, mana mungkin bisa.
Dialogue: 0,0:14:38.65,0:14:41.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya dalam waktu satu pekan
Dialogue: 0,0:14:41.15,0:14:46.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seorang petualang bisa mengalahkan\NMaster berlevel 50.
Dialogue: 0,0:14:49.74,0:14:53.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahanda,\Ntujuan kita kali ini untuk memeriksa.
Dialogue: 0,0:14:53.08,0:14:55.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu terlalu buru-buru.
Dialogue: 0,0:14:55.00,0:14:55.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:14:56.29,0:14:58.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak salah, Elymas.
Dialogue: 0,0:14:58.17,0:15:01.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Levelmu sekitar 40, kan?
Dialogue: 0,0:15:01.30,0:15:03.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, pas sekali.
Dialogue: 0,0:15:03.09,0:15:07.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru menyelesaikan Transfer Daya Hidup\Ndan naik ke level 45.
Dialogue: 0,0:15:08.97,0:15:13.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita buktikan kebenarannya lewat\Nlatihan tempur sungguhan.
Dialogue: 0,0:15:13.64,0:15:15.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Transfer Daya Hidup?
Dialogue: 0,0:15:15.48,0:15:18.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membunuh penjahat level tinggi\Nuntuk mendapat poin pengalaman.
Dialogue: 0,0:15:19.31,0:15:21.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh kejam.
Dialogue: 0,0:15:23.24,0:15:28.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau level kami setara,\Ndia yang berpengalaman pasti lebih unggul.
Dialogue: 0,0:15:28.37,0:15:33.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beradu pedang sebentar saja,\Nkebenaran akan langsung terungkap.
Dialogue: 0,0:15:35.21,0:15:37.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan berkata konyol, Malice.
Dialogue: 0,0:15:37.67,0:15:40.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski level kalian setara,
Dialogue: 0,0:15:40.29,0:15:43.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesatria Kelas Berat dan Pedang Suci\Njelas tidak sebanding.
Dialogue: 0,0:15:44.72,0:15:48.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hanya latihan ringan, Ayahanda.
Dialogue: 0,0:15:48.01,0:15:49.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam waktu sesingkat ini,
Dialogue: 0,0:15:49.68,0:15:52.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau dia bisa naik setinggi ini\Ndengan kekuatannya sendiri,
Dialogue: 0,0:15:52.85,0:15:55.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukankah sesuatu yang luar biasa?
Dialogue: 0,0:15:55.35,0:15:58.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya hanya ingin meminta arahan darinya.
Dialogue: 0,0:15:58.98,0:16:02.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja,\Nbila semua itu adalah kebohongan,
Dialogue: 0,0:16:02.98,0:16:07.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}latihan ini mungkin bisa\Nsekaligus menjadi hukumannya.
Dialogue: 0,0:16:08.86,0:16:11.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Suci adalah kelas yang sangat kuat.
Dialogue: 0,0:16:11.37,0:16:14.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya serang dan kecepatannya\Njauh di atas rata-rata.
Dialogue: 0,0:16:14.62,0:16:18.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill mereka juga banyak yang mematikan\Ndan mudah dipelajari.
Dialogue: 0,0:16:18.12,0:16:21.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesatria Kelas Berat yang tidak punya\Ndaya serang dan kecepatan,
Dialogue: 0,0:16:21.21,0:16:24.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya bisa bertahan melawan Pedang Suci.
Dialogue: 0,0:16:24.55,0:16:28.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski berhasil menyerang,\Ntidak cukup untuk mengakhiri pertarungan.
Dialogue: 0,0:16:28.76,0:16:32.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih bisa kalau hanya menampilkan\Nperlawanan yang mumpuni,
Dialogue: 0,0:16:32.85,0:16:36.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku ragu\Nkalau akan berhenti sampai sana.
Dialogue: 0,0:16:36.27,0:16:37.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konyol sekali.
Dialogue: 0,0:16:37.94,0:16:41.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa dirimu begitu terobsesi\Npada Elymas, Malice?
Dialogue: 0,0:16:41.69,0:16:43.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dirimulah yang kupilih seba—
Dialogue: 0,0:16:43.44,0:16:46.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, kuterima latihan tempur itu.
Dialogue: 0,0:16:47.11,0:16:49.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja, aku punya satu syarat.
Dialogue: 0,0:16:50.74,0:16:54.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kalian mengakui kekuatanku,
Dialogue: 0,0:16:54.24,0:16:57.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jangan pernah berurusan denganku lagi.
Dialogue: 0,0:16:59.41,0:17:01.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurang ajar!
Dialogue: 0,0:17:02.08,0:17:05.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang, Elymas.
Dialogue: 0,0:17:05.38,0:17:07.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang harusnya begitu.
Dialogue: 0,0:17:14.34,0:17:17.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elymas, kamu terlalu ceroboh!
Dialogue: 0,0:17:17.22,0:17:19.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya kamu sudah mengerti,
Dialogue: 0,0:17:19.81,0:17:21.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi jangan membunuhnya, Malice.
Dialogue: 0,0:17:23.98,0:17:27.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini untuk membuktikan\Nkalau aku tidak bersalah...
Dialogue: 0,0:17:27.15,0:17:28.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:17:28.40,0:17:33.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini duel agar aku bisa lepas\Ndari Keluarga Count Edvaughn!
Dialogue: 0,0:17:33.95,0:17:36.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang bermata tunggalmu bagus, Malice.
Dialogue: 0,0:17:37.58,0:17:39.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Magis, Gagak Air.
Dialogue: 0,0:17:39.58,0:17:42.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senjata dengan peningkatan\Ndaya serang yang cukup tinggi.
Dialogue: 0,0:17:42.50,0:17:46.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah bisa jadi ancaman yang cukup\Nmeski hanya dia ayunkan secara asal.
Dialogue: 0,0:17:46.25,0:17:52.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar Ayahanda diam-diam\Nmenyiapkan ini sebagai hadiah untukmu.
Dialogue: 0,0:17:54.34,0:17:56.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita terakhir berlatih saat masih kecil, ya.
Dialogue: 0,0:17:56.76,0:18:01.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sejujurnya tidak kusangka\Nkamu akan membenciku separah ini.
Dialogue: 0,0:18:07.90,0:18:08.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Parry!
Dialogue: 0,0:18:13.66,0:18:15.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ce-Cepat!
Dialogue: 0,0:18:15.41,0:18:20.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lega karena sepertinya kamu bisa\Nsedikit menghiburku, Elymas.
Dialogue: 0,0:18:20.95,0:18:22.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi...
Dialogue: 0,0:18:24.21,0:18:29.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini akan jadi permainan terakhirku\Ndengan dirimu yang kukagumi!
Dialogue: 0,0:18:29.42,0:18:35.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, biar kuputus lengan kirimu!
Dialogue: 0,0:18:45.35,0:18:48.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Elymas terpojok?
Dialogue: 0,0:18:49.32,0:18:52.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, ada apa?
Dialogue: 0,0:18:52.36,0:18:56.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:19:03.75,0:19:07.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si Elymas masih saja bersikeras\Ntidak mau menyerah.
Dialogue: 0,0:19:07.29,0:19:10.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malice jelas hanya bermain-main!
Dialogue: 0,0:19:12.46,0:19:15.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyawaku sudah dikikis seperempat, ya.
Dialogue: 0,0:19:15.80,0:19:16.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lamban sekali.
Dialogue: 0,0:19:16.93,0:19:19.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gerakan seperti itu mana mungkin sempat—
Dialogue: 0,0:19:21.35,0:19:22.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:19:22.93,0:19:24.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tebasan Vital!
Dialogue: 0,0:19:27.85,0:19:29.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Berhasil!
Dialogue: 0,0:19:29.40,0:19:31.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan langsung Elymas\Nberhasil mengenainya!
Dialogue: 0,0:19:31.78,0:19:33.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Suci dan Kesatria Kelas Berat
Dialogue: 0,0:19:33.90,0:19:37.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seharusnya punya perbedaan status\Nbagaikan langit dan bumi!
Dialogue: 0,0:19:37.32,0:19:40.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Malice lengah?
Dialogue: 0,0:19:40.83,0:19:43.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya serang Kesatria Kelas Berat itu rendah,
Dialogue: 0,0:19:43.70,0:19:45.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi tadi seharusnya cukup berdampak.
Dialogue: 0,0:19:45.54,0:19:49.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja, trik seperti ini\Nhanya mempan sekali.
Dialogue: 0,0:19:49.25,0:19:51.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari peningkat kecepatan Pengacau Estimasi
Dialogue: 0,0:19:51.75,0:19:52.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan sergapan Penginjak Bayang,
Dialogue: 0,0:19:52.96,0:19:54.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seranganku baru bisa mengenainya.
Dialogue: 0,0:20:06.89,0:20:08.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Majulah dengan sungguh-sungguh, Malice.
Dialogue: 0,0:20:08.81,0:20:12.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula kamu tidak berniat mundur\Nkarena serangan barusan, kan?
Dialogue: 0,0:20:13.40,0:20:15.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:20:15.90,0:20:18.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dirimu tetaplah tidak berubah.
Dialogue: 0,0:20:20.12,0:20:25.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cemas karena kukira\Nmomen ini akan cepat berakhir!
Dialogue: 0,0:20:30.33,0:20:35.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai bentuk penghormatan\Nkarena berhasil menyerangku sekali,
Dialogue: 0,0:20:39.89,0:20:44.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan kutunjukkan skill Pedang Suci!
Dialogue: 0,0:20:45.43,0:20:48.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan Beruntun Bajra!
Dialogue: 0,0:20:48.69,0:20:50.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menghilang!
Dialogue: 0,0:20:50.15,0:20:54.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu skill serangan beruntun secepat kilat\Nyang jadi simbol Pedang Suci!
Dialogue: 0,0:21:14.92,0:21:17.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berhasil menahannya?
Dialogue: 0,0:21:26.18,0:21:28.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekali lagi.
Dialogue: 0,0:21:35.36,0:21:37.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elymas!
Dialogue: 0,0:23:10.54,0:23:12.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertarungan sengit melawan Malice\Nterus berlanjut.
Dialogue: 0,0:23:12.79,0:23:15.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selisih status yang luar biasa\Ndan skill yang mematikan.
Dialogue: 0,0:23:16.21,0:23:18.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Suci memang hebat.
Dialogue: 0,0:23:18.21,0:23:20.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesatria Kelas Berat yang ahli bertahan,
Dialogue: 0,0:23:20.13,0:23:23.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}melancarkan teknik licik sebanyak apa pun\Ntidak akan menang.
Dialogue: 0,0:23:24.26,0:23:26.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan khawatir, Ruche!
Dialogue: 0,0:23:26.30,0:23:30.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang aku punya Taring Bara Kegilaan\Nyang kita dapatkan berdua!
Dialogue: 0,0:23:31.39,0:23:33.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, Malice sang Pedang Suci!
Dialogue: 0,0:23:34.49,0:23:38.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini waktunya menunjukkan\Nevolusi Kesatria Kelas Berat!
