Dialogue: 0,0:02:27.46,0:02:30.80,sign,,0000,0000,0000,,KESATRIA KELAS BERAT TEREINKARNASI YANG DIASINGKAN\NJADI TANPA TANDING DENGAN PENGETAHUAN GIMNYA
Dialogue: 0,0:03:45.00,0:03:51.63,sign,,0000,0000,0000,,EPISODE 21: PEDANG API HITAM
Dialogue: 0,0:05:58.75,0:06:01.05,sign,,0000,0000,0000,,JLEB
Dialogue: 0,0:11:15.78,0:11:17.11,sign,,0000,0000,0000,,KELAS: KESATRIA KELAS BERAT LV64\NELYMAS EDVAUGHN
Dialogue: 0,0:12:33.77,0:12:35.28,sign,,0000,0000,0000,,JLEB
Dialogue: 0,0:15:10.31,0:15:11.35,sign,,0000,0000,0000,,MONSTER: MAD WOLF
Dialogue: 0,0:15:43.80,0:15:45.42,sign,,0000,0000,0000,,STATUS ABNORMAL: RACUN
Dialogue: 0,0:15:58.94,0:16:02.40,sign,,0000,0000,0000,,STATUS ABNORMAL: RACUN
Dialogue: 0,0:16:07.91,0:16:10.91,sign,,0000,0000,0000,,MENDAPAT 174 POIN PENGALAMAN
Dialogue: 0,0:21:09.83,0:21:10.63,sign,,0000,0000,0000,,PINTU MASUK MAKAM DUKA,\NREKOMENDASI LEVEL: 70
Dialogue: 0,0:00:21.21,0:00:22.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketemu!
Dialogue: 0,0:00:22.59,0:00:23.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian!
Dialogue: 0,0:00:23.84,0:00:27.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuambil lagi 50 juta gold\Nyang kalian rebut dariku!
Dialogue: 0,0:00:31.55,0:00:34.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.\NDia menjual senjatanya, ya.
Dialogue: 0,0:00:34.26,0:00:35.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kabur, Ruche!
Dialogue: 0,0:00:35.60,0:00:36.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:00:38.23,0:00:39.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan kira bisa kabur!
Dialogue: 0,0:00:44.08,0:00:45.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hilde.
Dialogue: 0,0:00:55.76,0:00:58.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia Kesatria Kelas Berat\Nyang kamu maksud?
Dialogue: 0,0:01:10.03,0:01:12.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penampilan dan auranya ini...
Dialogue: 0,0:01:17.93,0:01:20.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinan dialah yang disebut
Dialogue: 0,0:01:21.10,0:01:22.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Api Hitam!
Dialogue: 0,0:01:28.44,0:01:30.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, Master!\NMereka orangnya!
Dialogue: 0,0:01:30.95,0:01:35.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sudah merebut uangku\Ndengan cara yang licik!
Dialogue: 0,0:01:42.37,0:01:43.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata benar.
Dialogue: 0,0:01:45.45,0:01:47.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelasku Pendekar Pedang Magis.
Dialogue: 0,0:01:48.00,0:01:50.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Carlos, petualang kelas A.
Dialogue: 0,0:01:51.55,0:01:55.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi ingin bertemu denganmu\Nsetelah mendengar cerita Hilde.
Dialogue: 0,0:02:00.64,0:02:02.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elymas si Kesatria Kelas Berat.
Dialogue: 0,0:03:52.94,0:03:58.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, tapi ada sesuatu yang ingin\Nkupastikan lebih dulu.
Dialogue: 0,0:03:59.05,0:04:03.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa benar dirimu sudah menipu Hilde\Nuntuk merampas uangnya?
Dialogue: 0,0:04:07.52,0:04:11.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuan Pedang Api Hitam\Nitu sudah tidak diragukan.
Dialogue: 0,0:04:11.50,0:04:15.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kekuatan kami sekarang,\Nrasanya mustahil untuk menghadapinya.
Dialogue: 0,0:04:15.53,0:04:18.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mengancamku\Nuntuk menyerahkan pedang mythril,
Dialogue: 0,0:04:18.77,0:04:21.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami pun memutuskannya dengan duel.
Dialogue: 0,0:04:22.32,0:04:23.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu beginilah hasilnya.
Dialogue: 0,0:04:32.54,0:04:34.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga seperti itu.
Dialogue: 0,0:04:40.89,0:04:42.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh!
Dialogue: 0,0:04:42.22,0:04:45.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kenapa Master tiba-tiba memukulku?
Dialogue: 0,0:04:46.65,0:04:49.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak awal, sudah kukira kalau\Nsebenarnya seperti itu.
Dialogue: 0,0:04:49.89,0:04:50.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:04:50.85,0:04:54.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukannya tadi bilang\Nbakal percaya padaku?
Dialogue: 0,0:04:54.15,0:04:57.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma minta diantar karena\Ningin bertemu dengannya.
Dialogue: 0,0:04:58.39,0:05:01.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hilde, kamu selalu saja memanggilku Master,
Dialogue: 0,0:05:01.03,0:05:04.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku sejak awal\Ntidak berniat jadi mastermu.
Dialogue: 0,0:05:05.98,0:05:07.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Master...
Dialogue: 0,0:05:12.75,0:05:14.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sekarang bilang begitu,
Dialogue: 0,0:05:14.25,0:05:17.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kesannya seperti mau lari\Ndari tanggung jawab, ya.
Dialogue: 0,0:05:18.42,0:05:23.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf kalian sudah begitu kerepotan\Nkarena kelalaianku dalam mendidik.
Dialogue: 0,0:05:23.18,0:05:24.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tidak.
Dialogue: 0,0:05:24.55,0:05:25.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sebenarnya juga...
Dialogue: 0,0:05:25.89,0:05:29.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}cuma meladeni tantangannya\Nkarena merasa bisa dapat uang jajan.
Dialogue: 0,0:05:29.89,0:05:31.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya kalau mau menolak...
Dialogue: 0,0:05:33.25,0:05:37.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat masih anak baru,\Naku tidak diberkahi banyak teman.
Dialogue: 0,0:05:37.19,0:05:41.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena pernah merasakan itu,\Naku jadi cukup yakin dalam menilai orang.
Dialogue: 0,0:05:42.61,0:05:45.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ini pria yang baik, Elymas.
Dialogue: 0,0:05:45.38,0:05:48.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saking baik hatinya dia,\Naku jadi sungkan sendiri.
Dialogue: 0,0:05:49.21,0:05:52.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku gagal paham kenapa\Nmuridnya bisa seperti ini.
Dialogue: 0,0:05:53.83,0:05:56.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, soal uang...
Dialogue: 0,0:05:57.30,0:05:58.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya jangan dikembalikan
Dialogue: 0,0:05:58.75,0:06:01.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}demi kebaikan dirinya juga.
Dialogue: 0,0:06:01.72,0:06:05.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tipe yang tidak akan jera\Nkalau belum kena batunya.
Dialogue: 0,0:06:05.22,0:06:07.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, baiklah.
Dialogue: 0,0:06:07.57,0:06:10.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, aku juga ada sebuah\Nkeperluan lain dengan kalian.
Dialogue: 0,0:06:12.15,0:06:15.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak enak kalau di sini,\Njadi tolong temani aku makan siang.
Dialogue: 0,0:06:26.37,0:06:29.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, memangnya ada perlu apa?
Dialogue: 0,0:06:29.24,0:06:32.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sekitar Kota Lacoryna belakangan ini,
Dialogue: 0,0:06:32.25,0:06:35.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sering terjadi bencana monster yang aneh.
Dialogue: 0,0:06:36.91,0:06:39.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kejadian ini benar-benar janggal.
Dialogue: 0,0:06:40.30,0:06:43.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster meluap keluar dari dungeon\Nyang belum lama muncul.
Dialogue: 0,0:06:44.71,0:06:48.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Evolusi Eksistensi yang seharusnya jarang\Njuga terus terjadi.
Dialogue: 0,0:06:48.64,0:06:51.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir apakah ini hanya sebuah kebetulan.
Dialogue: 0,0:06:51.89,0:06:55.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau sebuah ketimpangan karena suatu alasan.
Dialogue: 0,0:06:55.04,0:06:59.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pun mengelilingi dungeon di Lacoryna\Nuntuk menyelidikinya secara mandiri.
Dialogue: 0,0:06:59.50,0:07:04.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pihak serikat petualang kelihatannya\Nbelakangan ini dapat informasi baru.
Dialogue: 0,0:07:04.27,0:07:08.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya memang ada sesuatu\Nyang akan terjadi.
Dialogue: 0,0:07:09.11,0:07:12.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, itu soal Terowongan Lipan?
Dialogue: 0,0:07:12.20,0:07:16.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petualang hebat memang cepat\Ndengar berita, ya.
Dialogue: 0,0:07:17.00,0:07:21.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hampir dua pekan ini aku terus\Nmelakukan penyelidikan seorang diri,
Dialogue: 0,0:07:22.37,0:07:25.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku gagal menaklukkan suatu dungeon.
Dialogue: 0,0:07:25.34,0:07:27.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gagal menaklukkan?
Dialogue: 0,0:07:27.09,0:07:28.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal petualang kelas A?
Dialogue: 0,0:07:30.43,0:07:31.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya, di sekitar Lacoryna
Dialogue: 0,0:07:31.97,0:07:36.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak akan muncul dungeon dengan kesulitan\Nyang bisa membuat kelas A menyerah.
Dialogue: 0,0:07:36.85,0:07:39.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Telah terjadi Monster Pool.
Dialogue: 0,0:07:39.02,0:07:39.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:07:39.81,0:07:43.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sudah begitu,\Naku sendiri tidak bisa apa-apa.
Dialogue: 0,0:07:44.44,0:07:46.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster Pool.
Dialogue: 0,0:07:46.45,0:07:50.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Munculnya monster dalam jumlah tidak wajar\Nuntuk dungeon standar.
Dialogue: 0,0:07:50.31,0:07:54.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu salah satu bencana monster\Nyang juga ditakuti di Magic World.
Dialogue: 0,0:07:54.91,0:07:58.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata memang bukan cuma\Nkejadian Death Amude itu, ya.
Dialogue: 0,0:07:59.79,0:08:04.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma bisa menduga ada sesuatu\Nyang memicu bencana monster ini.
Dialogue: 0,0:08:05.57,0:08:09.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ke depannya, tingkat kemunculan\Nbencana monster naik di skala global.
Dialogue: 0,0:08:10.89,0:08:13.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wilayah di dunia ini\Nyang bisa dihuni manusia,
Dialogue: 0,0:08:13.72,0:08:15.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan menyusut secara drastis.
Dialogue: 0,0:08:16.23,0:08:19.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukankah ucapanmu kejauhan, Elymas?
Dialogue: 0,0:08:19.73,0:08:22.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu terlalu berlebihan.
Dialogue: 0,0:08:22.59,0:08:26.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya, menurutku itu tidak berlebihan.
Dialogue: 0,0:08:27.03,0:08:28.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sependapat dengan Elymas.
Dialogue: 0,0:08:33.62,0:08:36.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubicarakan topik utamanya.
Dialogue: 0,0:08:37.40,0:08:40.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin merekrut kalian berdua\Nuntuk Raid Quest.
Dialogue: 0,0:08:42.34,0:08:45.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di Makam Duka,\Ndungeon yang kutinggalkan sebelumnya.
Dialogue: 0,0:08:45.88,0:08:49.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin minta bantuan kalian\Nuntuk penyelidikan dan eksplorasinya.
Dialogue: 0,0:08:51.05,0:08:56.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau cuma Monster Pool, aku tidak akan\Nseburu-buru ini ingin menaklukkannya.
Dialogue: 0,0:08:56.43,0:08:58.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dungeon itu masih baru
Dialogue: 0,0:08:58.50,0:09:02.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan seharusnya belum memenuhi\Nsyarat munculnya bencana monster.
Dialogue: 0,0:09:03.72,0:09:07.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terus ditunda,\Nsituasinya bisa makin buruk.
Dialogue: 0,0:09:12.39,0:09:15.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Elymas, bagaimana ini?
Dialogue: 0,0:09:16.93,0:09:20.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Normalnya akan ingin langsung\Nmenjawab setuju,
Dialogue: 0,0:09:20.08,0:09:22.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ada sedikit yang membuatku cemas.
Dialogue: 0,0:09:22.12,0:09:23.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:09:25.13,0:09:27.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada petualang kelas A yang menemani.
Dialogue: 0,0:09:27.76,0:09:31.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia Pendekar Pedang Magis yang sudah\Nmengajari Hilde kapan untuk mundur.
Dialogue: 0,0:09:31.88,0:09:33.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti tidak akan ceroboh.
Dialogue: 0,0:09:33.68,0:09:37.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja, masalah ini\Nterasa seperti pertanda buruk.
Dialogue: 0,0:09:38.22,0:09:39.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:09:41.98,0:09:45.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, aku tetap ingin pergi.
Dialogue: 0,0:09:51.24,0:09:55.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau memang benar sedang terjadi\Nanomali di dunia ini.
Dialogue: 0,0:09:55.40,0:09:57.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti yang bisa menghentikannya
Dialogue: 0,0:09:57.58,0:10:01.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya orang dengan ingatan dari\Nmemainkan Magic World secara serius,
Dialogue: 0,0:10:01.66,0:10:03.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yaitu aku seorang!
Dialogue: 0,0:10:05.04,0:10:09.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama sekali aku tidak\Nmengayunkan pedang di samping Master!
Dialogue: 0,0:10:09.67,0:10:12.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak perlu memaksakan diri untuk ikut.
Dialogue: 0,0:10:12.76,0:10:14.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master!
Dialogue: 0,0:10:15.34,0:10:17.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bercanda, Hilde.
Dialogue: 0,0:10:43.49,0:10:46.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di bawah arahan Carlos, aku dan Ruche
Dialogue: 0,0:10:46.42,0:10:50.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menuju Makam Duka dalam Raid Quest\Nuntuk menyelidiki dan mengeksplorasinya.
Dialogue: 0,0:11:01.35,0:11:04.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai bisa mengerahkan\Npetualang kelas atas sebanyak ini,
Dialogue: 0,0:11:04.27,0:11:07.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}serikat kota besar memang beda level, ya.
Dialogue: 0,0:11:07.02,0:11:11.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti karena ada pengaruh rasa percaya\Nke Carlos yang petualang kelas A juga.
Dialogue: 0,0:11:11.86,0:11:13.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, benar.
Dialogue: 0,0:11:17.11,0:11:20.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Mythril dan Zirah Baja Hitam.
Dialogue: 0,0:11:20.76,0:11:25.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlengkapanku jadi lengkap berkat\NKakek Veruga menyelesaikannya tepat waktu.
Dialogue: 0,0:11:25.79,0:11:29.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, aku tidak akan dianggap\NKesatria Kelas Berat amatir dengan zirah besi.
Dialogue: 0,0:11:29.96,0:11:31.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elymas.
Dialogue: 0,0:11:32.21,0:11:34.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taring Naga Laut juga ikut serta, ya?
Dialogue: 0,0:11:35.02,0:11:39.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dungeon jadi kacau,\Nkita jadi tidak bisa memancing, kan?
Dialogue: 0,0:11:39.01,0:11:42.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kutunjukkan kehebatanku\Nselain dalam memancing!
Dialogue: 0,0:11:42.26,0:11:44.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku juga berharap tinggi padamu.
Dialogue: 0,0:11:45.70,0:11:48.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi memancing!
Dialogue: 0,0:11:48.35,0:11:51.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya demi dunia, kan?
Dialogue: 0,0:11:51.40,0:11:52.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:11:59.11,0:12:03.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master, benaran butuh orang sebanyak ini?
Dialogue: 0,0:12:03.53,0:12:05.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sendiri ragu.
Dialogue: 0,0:12:05.12,0:12:07.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawa beberapa juru penyembuh\Nharusnya cukup.
Dialogue: 0,0:12:08.96,0:12:11.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa saja situasinya memburuk.
Dialogue: 0,0:12:11.73,0:12:14.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi aku minta dicarikan orang\Nyang agak banyak.
Dialogue: 0,0:12:15.74,0:12:19.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawa banyak beban itu\Ntidak ada gunanya, kan?
Dialogue: 0,0:12:19.47,0:12:23.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa murid Pedang Api Hitam\Nmalah pakai sabit?
Dialogue: 0,0:12:23.43,0:12:24.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah.
Dialogue: 0,0:12:24.56,0:12:28.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dia dapat Skill Tree tipe sabit.
Dialogue: 0,0:12:28.02,0:12:31.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah coba pinjam\Nsenjata Carlos yang tidak terpakai,
Dialogue: 0,0:12:31.27,0:12:31.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh.
Dialogue: 0,0:12:31.98,0:12:33.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi disuruh pakai apa adanya
Dialogue: 0,0:12:33.77,0:12:35.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar jadi pelajaran baginya.
Dialogue: 0,0:12:35.73,0:12:40.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kenapa Carlos mau menerima\NHilde yang kayak begitu jadi muridnya?
Dialogue: 0,0:12:40.95,0:12:43.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf saja kalau sifatku kayak begitu!
Dialogue: 0,0:12:43.28,0:12:44.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:12:44.24,0:12:47.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf, maksudku bukan seperti itu!
Dialogue: 0,0:12:48.71,0:12:53.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, aku tidak melakukan\Nhal berarti sampai disebut master.
Dialogue: 0,0:12:53.68,0:12:56.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku, Pendekar Pedang Magis\Nitu kelas yang kuat.
Dialogue: 0,0:12:58.29,0:13:02.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuan serangannya memang tinggi,\Ntapi daya tahannya begitu buruk.
Dialogue: 0,0:13:02.53,0:13:05.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya sering bikin ribut\Ndengan anggota grup.
Dialogue: 0,0:13:05.56,0:13:08.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dibiarkan begitu saja,\Nakan dikucilkan di serikat.
Dialogue: 0,0:13:09.45,0:13:13.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu akhirnya bertindak ceroboh\Ndan kehilangan nyawa mereka.
Dialogue: 0,0:13:15.52,0:13:17.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang benar, bahkan di Magic World
Dialogue: 0,0:13:17.90,0:13:21.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}keuntungan Pendekar Pedang Magis\Nsering tidak masuk hitungan grup.
Dialogue: 0,0:13:21.53,0:13:24.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuserahkan keroco ke kalian,\Naku akan memburu bosnya!
Dialogue: 0,0:13:24.70,0:13:25.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Curang!
Dialogue: 0,0:13:25.58,0:13:26.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau enaknya doang!
Dialogue: 0,0:13:27.62,0:13:31.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terburu-buru, tidak akan bisa\Nmelihat dunia yang dilihat orang lain.
Dialogue: 0,0:13:32.41,0:13:34.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulunya aku juga begitu.
Dialogue: 0,0:13:37.27,0:13:39.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menderita karena kurang simpati ke sekitar,
Dialogue: 0,0:13:39.47,0:13:41.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ingin segera dapat prestasi,
Dialogue: 0,0:13:41.01,0:13:45.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mengeluh kenapa semua orang\Nselalu bicara seenaknya sendiri.
Dialogue: 0,0:13:48.02,0:13:51.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai saja saat itu ada\Nyang menasihatiku dengan bijak,
Dialogue: 0,0:13:51.39,0:13:53.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sekarang pun aku masih berharap begitu.
Dialogue: 0,0:13:55.74,0:13:59.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, aku pun tidak tahan\Nuntuk menegur Hilde.
Dialogue: 0,0:14:02.78,0:14:07.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masterku memang berhati besar,\Nkuat, dan sangat baik!
Dialogue: 0,0:14:07.95,0:14:10.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?\NHebat, kan?
Dialogue: 0,0:14:10.79,0:14:14.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai saja muridnya bisa sedikit\Nmeniru sifatnya tadi.
Dialogue: 0,0:14:14.92,0:14:16.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa katamu?
Dialogue: 0,0:14:17.30,0:14:19.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan malah ketawa, dasar kurang ajar!
Dialogue: 0,0:14:28.51,0:14:32.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sama sekali tidak bisa membayangkan\Nbagaimana Carlos di masa kelamnya.
Dialogue: 0,0:14:32.48,0:14:37.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kurasa ucapannya dilebih-lebihkan\Nagar Hilde tidak merasa malu.
Dialogue: 0,0:14:37.48,0:14:39.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin saja iya.
Dialogue: 0,0:14:40.03,0:14:41.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, berhenti.
Dialogue: 0,0:15:08.39,0:15:09.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka datang!
Dialogue: 0,0:15:11.35,0:15:13.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru mulai disambut level 52?
Dialogue: 0,0:15:13.89,0:15:16.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kerumunan monster\Nyang meluap dari dungeon!
Dialogue: 0,0:15:17.05,0:15:18.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita halau mereka!
Dialogue: 0,0:15:18.94,0:15:21.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Rondalm sampai dipenuhi\Nmonster selevel ini,
Dialogue: 0,0:15:21.73,0:15:23.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tuan tanah pasti harus turun tangan.
Dialogue: 0,0:15:40.07,0:15:40.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche!
Dialogue: 0,0:15:42.42,0:15:43.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Status abnormal: racun.
Dialogue: 0,0:15:43.80,0:15:45.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhasil kuberi racun!
Dialogue: 0,0:15:45.42,0:15:47.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus!\NLangsung kena, ya?
Dialogue: 0,0:15:47.93,0:15:51.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu efek senjata baru Ruche,\NBelati Kelabang Beracun.
Dialogue: 0,0:15:52.47,0:15:55.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dipakai Ruche yang keberuntungan\Ndan jumlah serangannya banyak,
Dialogue: 0,0:15:55.60,0:15:58.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa memberi efek racun\Ndengan peluang tinggi.
Dialogue: 0,0:15:58.94,0:16:02.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, status racun di Magic World
Dialogue: 0,0:16:02.40,0:16:05.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}punya efek menurunkan\Nkecepatan sebesar 10%
Dialogue: 0,0:16:05.90,0:16:07.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan penghabisan!
Dialogue: 0,0:16:07.91,0:16:10.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mendapat 174 poin pengalaman.
Dialogue: 0,0:16:18.77,0:16:20.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuhnya masih banyak!
Dialogue: 0,0:16:21.13,0:16:22.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo terus kita kurangi jumlahnya!
Dialogue: 0,0:16:23.46,0:16:24.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik!
Dialogue: 0,0:16:40.27,0:16:42.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini sudah semuanya, kan?
Dialogue: 0,0:16:42.36,0:16:46.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sambutannya keras juga padahal\Nbelum masuk ke dungeon.
Dialogue: 0,0:16:47.07,0:16:50.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belati Kelabang Beracun\Nbenaran ada efeknya, ya, Ruche.
Dialogue: 0,0:16:50.66,0:16:53.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelasku bukan yang daya serangnya tinggi,
Dialogue: 0,0:16:53.87,0:16:57.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi pisau yang bisa memberi\Nstatus abnormal ini sangat menolong.
Dialogue: 0,0:16:58.37,0:17:00.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiba-tiba aku merasa jauh lebih kuat.
Dialogue: 0,0:17:01.17,0:17:04.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sepertinya kamu sedikit terluka,\Nyakin tidak apa-apa?
Dialogue: 0,0:17:05.46,0:17:08.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku agak terlalu semangat\Nsama senjata baru.
Dialogue: 0,0:17:08.01,0:17:10.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tidak apa-apa, kok!
Dialogue: 0,0:17:10.47,0:17:13.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa sebaiknya aku pakai\Nramuan penyembuh saja, ya?
Dialogue: 0,0:17:14.06,0:17:15.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Heal.
Dialogue: 0,0:17:17.68,0:17:19.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, terima kasih banyak!
Dialogue: 0,0:17:19.73,0:17:20.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:17:20.69,0:17:24.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Maebel, dengan kelas pendeta.
Dialogue: 0,0:17:24.09,0:17:27.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku diajak ikut karena kelas penyembuh,
Dialogue: 0,0:17:27.35,0:17:29.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku masih kelas C.
Dialogue: 0,0:17:29.19,0:17:33.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon kerja sama dari kalian berdua\Nyang sudah kelas B, ya.
Dialogue: 0,0:17:33.20,0:17:35.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami juga mohon kerja samanya.
Dialogue: 0,0:17:35.28,0:17:39.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, kami juga pemula\Nyang baru naik peringkat.
Dialogue: 0,0:17:39.08,0:17:41.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mo-Mohon kerja samanya!
Dialogue: 0,0:17:41.61,0:17:43.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Elymas, Kesatria Kelas Berat.
Dialogue: 0,0:17:43.33,0:17:45.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedangkan dia Ruche, dengan kelas Badut.
Dialogue: 0,0:17:46.20,0:17:47.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Ruche.
Dialogue: 0,0:17:47.46,0:17:52.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untunglah pengguna sihir putih yang berharga\Nkelihatan bisa dipercaya.
Dialogue: 0,0:17:55.33,0:17:57.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini masih belum masuk dungeon,
Dialogue: 0,0:17:57.89,0:18:01.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jangan buat juru penyembuh\Nmemakai MP-nya yang berharga.
Dialogue: 0,0:18:01.71,0:18:05.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria ini, kalau tidak salah petualang kelas B\Ndengan kelas pemburu
Dialogue: 0,0:18:05.77,0:18:06.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bernama Kelt.
Dialogue: 0,0:18:07.44,0:18:11.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Levelnya termasuk tinggi\Ndi antara partisipan kali ini.
Dialogue: 0,0:18:11.53,0:18:15.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abaikan saja orang yang main serbu\Ndi permulaan seperti mereka ini.
Dialogue: 0,0:18:15.73,0:18:20.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Juru penyembuh yang berharga ternyata\Ntidak bisa mengatur ritmenya sendiri.
Dialogue: 0,0:18:20.62,0:18:23.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya, Kelt.
Dialogue: 0,0:18:23.37,0:18:26.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kupikir lebih matang lagi\Nsebelum bergerak.
Dialogue: 0,0:18:26.48,0:18:27.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu cuma menilai hasilnya.
Dialogue: 0,0:18:27.77,0:18:29.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau lawannya sebanyak itu,
Dialogue: 0,0:18:29.30,0:18:33.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menyerang untuk mengurangi jumlahnya dulu\Nbukanlah langkah yang buruk.
Dialogue: 0,0:18:33.43,0:18:38.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya, itu bukan sesuatu yang perlu\Ndikatakan sampai harus memperkeruh suasana.
Dialogue: 0,0:18:38.95,0:18:41.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ini tidak mengerti apa-apa, ya?
Dialogue: 0,0:18:41.14,0:18:43.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raid Quest ini akan memakan\Ndurasi yang panjang.
Dialogue: 0,0:18:43.89,0:18:46.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuan utamanya menyelidiki\Nbagian dalam dungeon.
Dialogue: 0,0:18:46.65,0:18:48.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan sekadar penjelajahan biasa.
Dialogue: 0,0:18:48.90,0:18:52.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah keras kepala\Ncari-cari masalah, dasar amatir.
Dialogue: 0,0:18:59.45,0:19:03.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sengaja merusak suasana\Nagar bisa mengendalikan situasinya, ya.
Dialogue: 0,0:19:07.33,0:19:08.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kalimatnya tadi,
Dialogue: 0,0:19:08.74,0:19:12.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia membuat suasana agar bisa\Nmengatur tindakan juru penyembuh,
Dialogue: 0,0:19:12.43,0:19:14.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sambil menahan pergerakan\Npenyerang garis depan.
Dialogue: 0,0:19:15.84,0:19:20.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang diuntungkan menghabisi monster\Ndari belakang saat garis depan sulit menyerang
Dialogue: 0,0:19:20.56,0:19:22.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah kelas pemburu Kelt.
Dialogue: 0,0:19:22.57,0:19:28.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan kebanyakan bicara sembarangan\Ndan merusak kesannya, Bocah.
Dialogue: 0,0:19:28.94,0:19:31.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidup itu yang cerdas.
Dialogue: 0,0:19:33.53,0:19:37.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, sepertinya drop kali ini hoki juga.
Dialogue: 0,0:19:37.74,0:19:42.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar tidak ribut, aturannya drop jadi milik\Norang yang menghabisinya, kan?
Dialogue: 0,0:19:42.20,0:19:44.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuambil tanpa sungkan, ya.
Dialogue: 0,0:19:44.25,0:19:47.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal drop-nya karena skill milikku.
Dialogue: 0,0:19:51.05,0:19:53.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pikirkan ucapannya, Maebel.
Dialogue: 0,0:19:53.02,0:19:57.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak awal dia ingin membuatmu tertekan\Ndengan mencari-cari kesalahanmu.
Dialogue: 0,0:19:57.14,0:19:58.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:19:59.05,0:20:04.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi juru penyembuh memang sering\Nberurusan dengan orang seperti itu.
Dialogue: 0,0:20:04.31,0:20:07.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggal pura-pura saja menurut\Nsama orang seperti itu.
Dialogue: 0,0:20:07.85,0:20:11.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu beri seribu alasan\Nuntuk tidak menyembuhkannya.
Dialogue: 0,0:20:11.94,0:20:15.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti lama-lama juga diam sendiri, kok.
Dialogue: 0,0:20:15.32,0:20:18.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu masuk dungeon,\Ntempatnya tidak akan seluas ini.
Dialogue: 0,0:20:18.28,0:20:20.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemburu sekalipun akan tetap\Nterkena serangan.
Dialogue: 0,0:20:20.82,0:20:23.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena daya pertahanan kelasnya rendah...
Dialogue: 0,0:20:24.24,0:20:29.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin akrab dengan kalian berdua,\Njadi mohon kerja samanya.
Dialogue: 0,0:20:29.09,0:20:30.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Begitu, ya.
Dialogue: 0,0:20:30.75,0:20:34.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami juga inginnya seperti itu.
Dialogue: 0,0:20:34.12,0:20:37.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para petualang yang bisa\Nhidup lama di dunia ini,
Dialogue: 0,0:20:37.55,0:20:42.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin aslinya lebih tangguh dari dugaanku.
Dialogue: 0,0:20:42.72,0:20:45.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dipikir-pikir lagi, sihir putihnya tadi
Dialogue: 0,0:20:45.47,0:20:49.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tujuannya pasti untuk dapat petualang\Nyang bisa diajak berhubungan baik.
Dialogue: 0,0:20:50.06,0:20:53.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Heal tadi memang terlalu cepat.
Dialogue: 0,0:20:59.83,0:21:03.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah menghindari Undead\Nyang berkeliaran di sekitar.
Dialogue: 0,0:21:04.08,0:21:05.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkadang juga harus bertarung.
Dialogue: 0,0:21:10.63,0:21:15.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami pun akhirnya sampai\Ndi pintu masuk Makam Duka.
Dialogue: 0,0:21:15.84,0:21:17.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terasa sekali kalau inilah tempatnya.
Dialogue: 0,0:21:17.96,0:21:22.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tidak bisa dikubur\Ndengan lebih layak lagi?
Dialogue: 0,0:21:22.09,0:21:24.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi sampai jadi dungeon begini.
Dialogue: 0,0:21:24.97,0:21:28.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dahulu kala ada desa di dekat sini.
Dialogue: 0,0:21:28.56,0:21:32.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Antara musnah,\Natau sudah pindah ke Lacoryna.
Dialogue: 0,0:21:32.98,0:21:36.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini juga terjadi anomali yang serupa\Ndengan Terowongan Lipan.
Dialogue: 0,0:21:36.96,0:21:38.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami harus menemukan penyebabnya!
Dialogue: 0,0:23:12.37,0:23:17.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan Ruche menantang Raid Quest\Nyang diisi para petualang kelas tinggi.
Dialogue: 0,0:23:17.63,0:23:20.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi bisa membasmi\Nmusuh sebanyak-banyaknya,
Dialogue: 0,0:23:20.21,0:23:24.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami yang dipecah jadi beberapa grup pun\Nbergabung dengan rekan baru.
Dialogue: 0,0:23:24.97,0:23:26.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelt dan Maebel.
Dialogue: 0,0:23:27.05,0:23:30.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berdua sama-sama\Npunya sifat yang sangat unik!
Dialogue: 0,0:23:31.26,0:23:34.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, Kelt si Pemburu\Ndan Pendeta Maebel.
Dialogue: 0,0:23:34.64,0:23:37.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga saja aspek\Nyang bikin cemas cuma ini saja.
