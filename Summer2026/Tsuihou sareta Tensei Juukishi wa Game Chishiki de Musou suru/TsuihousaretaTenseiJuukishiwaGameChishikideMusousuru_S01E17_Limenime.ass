Dialogue: 0,0:01:03.54,0:01:08.76,sign,,0000,0000,0000,,STATUS ABNORMAL: STUN
Dialogue: 0,0:01:35.41,0:01:37.58,sign,,0000,0000,0000,,DEATH NEEDLE
Dialogue: 0,0:02:40.47,0:02:43.81,sign,,0000,0000,0000,,KESATRIA KELAS BERAT TEREINKARNASI YANG DIASINGKAN\NJADI TANPA TANDING DENGAN PENGETAHUAN GIMNYA
Dialogue: 0,0:03:58.01,0:04:03.72,sign,,0000,0000,0000,,EPISODE 17: HAILENN SANG KETUA SERIKAT
Dialogue: 0,0:04:54.69,0:04:59.65,sign,,0000,0000,0000,,STATUS ABNORMAL: STUN
Dialogue: 0,0:05:35.82,0:05:37.45,sign,,0000,0000,0000,,JULUKAN: PEMBASMI MIMPI BURUK
Dialogue: 0,0:05:37.45,0:05:39.40,sign,,0000,0000,0000,,BUKTI TELAH MENGALAHKAN MASTER DI ATAS LV 70
Dialogue: 0,0:05:39.40,0:05:41.07,sign,,0000,0000,0000,,YANG MENGALAMI EVOLUSI EKSISTENSI
Dialogue: 0,0:05:41.07,0:05:46.12,sign,,0000,0000,0000,,DAYA SERANG +7% SAAT MENYERANG MASTER
Dialogue: 0,0:05:54.75,0:05:58.75,sign,,0000,0000,0000,,MENDAPAT JULUKAN PEMBASMI MIMPI BURUK
Dialogue: 0,0:06:33.37,0:06:34.50,sign,,0000,0000,0000,,BELATI KELABANG BERACUN
Dialogue: 0,0:06:34.50,0:06:35.54,sign,,0000,0000,0000,,REKOMENDASI PERLENGKAPAN: LV70
Dialogue: 0,0:06:35.54,0:06:38.21,sign,,0000,0000,0000,,DAYA SERANG: +28
Dialogue: 0,0:06:38.21,0:06:41.13,sign,,0000,0000,0000,,HARGA PASAR: 28 JUTA GOLD
Dialogue: 0,0:06:41.13,0:06:43.51,sign,,0000,0000,0000,,BELATI YANG DISELIMUTI RACUN MEMATIKAN KELABANG
Dialogue: 0,0:06:43.51,0:06:44.88,sign,,0000,0000,0000,,SELAIN PUNYA DAYA SERANG TINGGI,
Dialogue: 0,0:06:44.88,0:06:46.01,sign,,0000,0000,0000,,TERKADANG MEMBERI EFEK RACUN PADA MUSUH
Dialogue: 0,0:07:02.61,0:07:05.11,sign,,0000,0000,0000,,TERKADANG MEMBERI EFEK RACUN PADA MUSUH
Dialogue: 0,0:10:02.62,0:10:05.25,sign,,0000,0000,0000,,MASTER: DEATH AMUDE
Dialogue: 0,0:10:46.08,0:10:47.13,sign,,0000,0000,0000,,EMOSI
Dialogue: 0,0:18:22.04,0:18:25.54,sign,,0000,0000,0000,,KELUARGA INTI - COUNT HOWLRODDE
Dialogue: 0,0:18:28.46,0:18:33.05,sign,,0000,0000,0000,,KELUARGA CABANG - SERIKAT PETUALANG
Dialogue: 0,0:00:00.52,0:00:05.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua skill Taring Bara Kegilaan\Ndan daya serang perlengkapan baja hitam.
Dialogue: 0,0:00:05.32,0:00:10.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, digabung peningkat kemampuan\Ndari julukan Pengacau Estimasi.
Dialogue: 0,0:00:22.37,0:00:24.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Risikonya memang sangat besar,
Dialogue: 0,0:00:24.59,0:00:27.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi memberikan ledakan daya hancur\Nyang sepadan,
Dialogue: 0,0:00:27.38,0:00:30.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}serta punya sinergi kuat\Ndengan Kesatria Kelas Berat.
Dialogue: 0,0:00:30.97,0:00:34.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill yang menopang daya ledak\NKesatria Kelas Berat secara mendasar,
Dialogue: 0,0:00:34.39,0:00:37.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itulah Penumbal Pertahanan!
Dialogue: 0,0:00:39.77,0:00:41.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuakhiri dalam satu serangan!
Dialogue: 0,0:00:49.82,0:00:52.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penumbal Pertahanan!
Dialogue: 0,0:00:52.16,0:00:55.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill ini menguras MP dengan brutal.
Dialogue: 0,0:00:55.12,0:00:58.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang sekarang hanya bisa\Nmempertahankannya beberapa detik.
Dialogue: 0,0:00:58.91,0:01:03.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar bisa mengaktifkan dan langsung\Nmenyerang ke hadapan Death Amude,
Dialogue: 0,0:01:03.54,0:01:06.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harus kuciptakan situasi sehingga aku
Dialogue: 0,0:01:06.38,0:01:08.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak terkena serangan skill dan kakinya.
Dialogue: 0,0:01:08.76,0:01:13.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}HP yang besar, cangkang baja yang keras,\Ndan penyembuhan yang merepotkan.
Dialogue: 0,0:01:13.89,0:01:16.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya tidak berguna lagi!
Dialogue: 0,0:01:51.88,0:01:53.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima ini!
Dialogue: 0,0:04:08.81,0:04:12.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kamu benar-benar\Nmengalahkannya, Elymas!
Dialogue: 0,0:04:13.48,0:04:16.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal level lawanmu jauh lebih tinggi.
Dialogue: 0,0:04:16.27,0:04:19.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Poin pengalaman yang didapat\Nluar biasa banyak!
Dialogue: 0,0:04:19.88,0:04:21.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung kita berhasil menang.
Dialogue: 0,0:04:21.49,0:04:22.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:04:24.23,0:04:26.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku benar-benar minta maaf.
Dialogue: 0,0:04:26.87,0:04:30.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Evolusi Eksistensi seharusnya\Ntidak terjadi di tempat ini.
Dialogue: 0,0:04:31.75,0:04:33.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}To-Tolong jangan minta maaf!
Dialogue: 0,0:04:33.96,0:04:36.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa menang meski seperti itu\Nartinya Elymas memang hebat!
Dialogue: 0,0:04:38.17,0:04:40.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini juga berkat kamu.
Dialogue: 0,0:04:40.89,0:04:42.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Benarkah?
Dialogue: 0,0:04:42.93,0:04:47.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, daya seranganmu tadi\Nluar biasa sekali!
Dialogue: 0,0:04:47.06,0:04:49.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Death Amude sebesar itu\Nbisa kalah sekali serang.
Dialogue: 0,0:04:50.44,0:04:54.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penumbal Pertahanan memang kuat,\Ntapi celahnya begitu besar.
Dialogue: 0,0:04:54.69,0:04:57.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena dia berhasil dibuat kena Stun,
Dialogue: 0,0:04:57.44,0:04:59.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa menyerangnya.
Dialogue: 0,0:05:01.02,0:05:02.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, di saat terakhir...
Dialogue: 0,0:05:02.84,0:05:06.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak ada Life Shield,\Naku pasti sudah mati.
Dialogue: 0,0:05:12.25,0:05:17.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan skill yang ingin secara aktif\Nkugunakan di statusku sekarang.
Dialogue: 0,0:05:18.17,0:05:22.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya yang dihasilkan sangat gila,\Njadi kurasa bisa untuk menggertak.
Dialogue: 0,0:05:26.93,0:05:29.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mendapat julukan Pembasmi Mimpi Buruk.
Dialogue: 0,0:05:29.81,0:05:31.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembasmi Mimpi Buruk?
Dialogue: 0,0:05:31.56,0:05:33.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Julukan apa ini?
Dialogue: 0,0:05:33.31,0:05:35.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Julukan Pembasmi Mimpi Buruk.
Dialogue: 0,0:05:35.82,0:05:39.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukti telah mengalahkan Master di atas Lv 70
Dialogue: 0,0:05:39.40,0:05:41.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang mengalami Evolusi Eksistensi.
Dialogue: 0,0:05:41.07,0:05:46.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya serang +7% saat menyerang Master.
Dialogue: 0,0:05:47.11,0:05:49.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Julukan dengan efek khusus melawan bos.
Dialogue: 0,0:05:49.41,0:05:52.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena berhubungan dengan Evolusi Eksistensi
Dialogue: 0,0:05:52.08,0:05:54.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}julukan ini tidak semudah itu didapat.
Dialogue: 0,0:05:54.75,0:05:57.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa didapat di sini anggap saja
Dialogue: 0,0:05:57.17,0:05:58.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berkah dari luka kita.
Dialogue: 0,0:06:01.59,0:06:04.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, senang karena selamat\Nitu tidak ada salahnya.
Dialogue: 0,0:06:05.64,0:06:08.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, batu sihirnya juga harus kita ambil.
Dialogue: 0,0:06:08.10,0:06:09.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, baik!
Dialogue: 0,0:06:17.57,0:06:18.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Elymas!
Dialogue: 0,0:06:18.90,0:06:22.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Ada sesuatu yang luar biasa!
Dialogue: 0,0:06:22.36,0:06:24.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini!\NLihat ini!
Dialogue: 0,0:06:25.03,0:06:28.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Ruche?\NKalau batu sihir, biar aku...
Dialogue: 0,0:06:28.12,0:06:31.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Ini item drop dari Death Amude!
Dialogue: 0,0:06:33.37,0:06:35.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belati Kelabang Beracun.
Dialogue: 0,0:06:35.54,0:06:38.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya serang +28.
Dialogue: 0,0:06:38.21,0:06:41.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harga pasar: 28 juta Gold.
Dialogue: 0,0:06:41.13,0:06:43.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belati yang diselimuti racun mematikan kelabang.
Dialogue: 0,0:06:43.51,0:06:46.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkadang memberi efek racun pada musuh.
Dialogue: 0,0:06:46.72,0:06:49.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Ada yang dijatuhkan lagi, ya?
Dialogue: 0,0:06:49.10,0:06:50.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar, ya.
Dialogue: 0,0:06:50.77,0:06:53.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selalu saja dapat barang\Ndengan peluang drop yang tidak tinggi
Dialogue: 0,0:06:53.60,0:06:55.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seolah itu hal yang wajar.
Dialogue: 0,0:06:57.10,0:06:58.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ini...
Dialogue: 0,0:06:58.48,0:07:02.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nilainya jelas melebihi semua drop\Nyang kita dapatkan selama ini.
Dialogue: 0,0:07:02.61,0:07:05.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkadang memberi efek racun pada musuh.
Dialogue: 0,0:07:06.95,0:07:09.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peluang keberhasilan efek yang seperti ini,
Dialogue: 0,0:07:09.62,0:07:11.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan terpengaruh oleh daya keberuntungan.
Dialogue: 0,0:07:12.62,0:07:14.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menambah jumlah serangan
Dialogue: 0,0:07:14.08,0:07:15.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- pakai Serangan Beruntun Akrobat\N- Serangan Beruntun Akrobat!
Dialogue: 0,0:07:15.29,0:07:17.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- untuk memberi efek racun secara paksa,\N- Serangan Beruntun Akrobat!
Dialogue: 0,0:07:17.71,0:07:19.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}peluang menang kami akan meningkat pesat.
Dialogue: 0,0:07:19.71,0:07:22.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa dibilang sangat cocok untuk Ruche.
Dialogue: 0,0:07:26.63,0:07:31.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dapat barang seperti ini, bijih yang kita\Nkumpulkan jadi tidak berguna lagi.
Dialogue: 0,0:07:32.35,0:07:34.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Bagaimana ini, Elymas?
Dialogue: 0,0:07:34.85,0:07:37.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Ini harganya 28 juta Gold!
Dialogue: 0,0:07:37.81,0:07:42.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kalau memungut benda seperti ini,\Napa kita tidak bakal kena karma?
Dialogue: 0,0:07:42.27,0:07:43.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Ini tidak baik!
Dialogue: 0,0:07:43.94,0:07:46.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak seharusnya dapat\Nbarang semahal ini!
Dialogue: 0,0:07:46.86,0:07:49.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya lebih baik kalau kita\Ntinggalkan di sini saja?
Dialogue: 0,0:07:49.87,0:07:51.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang dulu, Ruche!
Dialogue: 0,0:07:51.66,0:07:53.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dinginkan kepalamu!\NPikiranmu lagi kacau!
Dialogue: 0,0:07:53.79,0:07:54.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bahaya!
Dialogue: 0,0:07:54.91,0:07:57.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak tahu apa yang bakal terjadi,
Dialogue: 0,0:07:57.33,0:07:59.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi bakal kutinggal saja!
Dialogue: 0,0:07:59.33,0:08:01.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan terjadi apa-apa!
Dialogue: 0,0:08:01.25,0:08:03.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya tenangkan dirimu dulu, Ruche!
Dialogue: 0,0:08:03.50,0:08:04.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang dulu—\NAh!
Dialogue: 0,0:08:04.92,0:08:06.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan dilempar!
Dialogue: 0,0:08:06.80,0:08:07.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma pelan, kok!
Dialogue: 0,0:08:07.80,0:08:12.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche!
Dialogue: 0,0:08:35.33,0:08:37.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencana kali ini sangat lancar.
Dialogue: 0,0:08:37.53,0:08:38.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita lanjutkan seperti ini.
Dialogue: 0,0:08:38.83,0:08:39.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, benar.
Dialogue: 0,0:08:40.46,0:08:42.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini mantap sekali.
Dialogue: 0,0:08:44.84,0:08:47.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung bisa selesai lebih cepat.
Dialogue: 0,0:08:47.67,0:08:51.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kaget, bosnya ternyata lemah banget.
Dialogue: 0,0:08:53.01,0:08:54.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau coba diajak ngobrol?
Dialogue: 0,0:08:54.51,0:08:55.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sedang apa dia?\N- Ogah!
Dialogue: 0,0:09:02.15,0:09:04.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh, jangan dilihat terus.
Dialogue: 0,0:09:11.03,0:09:15.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche, bisa hentikan\Ntingkah mencurigakanmu itu?
Dialogue: 0,0:09:15.33,0:09:18.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Je-Jelas aku bakal bertingkah mencurigakan!
Dialogue: 0,0:09:18.54,0:09:20.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita habis dapat banyak\Ndari Terowongan Lipan!
Dialogue: 0,0:09:42.27,0:09:44.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami mau menjual batu sihir.
Dialogue: 0,0:09:44.48,0:09:48.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, aku ingin bicara dengan\Npetualang kelas atas dari pegawai serikat,
Dialogue: 0,0:09:48.78,0:09:51.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau kalau bisa langsung\Ndengan ketua serikat.
Dialogue: 0,0:09:54.20,0:09:57.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin saja telah terjadi\Nsesuatu yang begitu gawat.
Dialogue: 0,0:09:58.53,0:10:02.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuan kami kali ini\Nbukan hanya menjual barang.
Dialogue: 0,0:10:02.62,0:10:05.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Evolusi Eksistensi master bukanlah
Dialogue: 0,0:10:05.25,0:10:07.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}anomali yang bisa diabaikan.
Dialogue: 0,0:10:07.93,0:10:12.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sesuatu yang wajarnya tidak akan terjadi\Ntanpa banyak memakan korban.
Dialogue: 0,0:10:13.35,0:10:15.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terjadi bencana sebesar itu,
Dialogue: 0,0:10:15.47,0:10:18.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aneh kalau tidak ada informasi\Nyang dibagikan di serikat.
Dialogue: 0,0:10:20.47,0:10:24.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus menyampaikan itu\Npada serikat secara detail.
Dialogue: 0,0:10:27.77,0:10:32.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesatria Kelas Berat dan Badut kelas D?
Dialogue: 0,0:10:34.78,0:10:37.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan saya sampaikan secukupnya\Nke pihak atas.
Dialogue: 0,0:10:37.74,0:10:41.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja kami sedang sibuk,\Njadi tolong ringkas saja.
Dialogue: 0,0:10:41.16,0:10:43.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa-apaan itu?
Dialogue: 0,0:10:43.46,0:10:46.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ucapannya tidak harus seperti itu juga, kan?
Dialogue: 0,0:10:47.13,0:10:49.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini, ya.
Dialogue: 0,0:10:49.09,0:10:52.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kota para petualang, Lacoryna.
Dialogue: 0,0:10:52.34,0:10:54.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami para pegawai serikat
Dialogue: 0,0:10:54.09,0:10:57.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}punya kebanggaan untuk melahirkan\Npara petualang terkenal.
Dialogue: 0,0:10:59.93,0:11:01.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan saja padaku.
Dialogue: 0,0:11:01.81,0:11:04.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka pasti mau mengerti\Nkalau diajak bicara baik-baik.
Dialogue: 0,0:11:04.56,0:11:07.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Elymas yang bilang begitu...
Dialogue: 0,0:11:10.07,0:11:13.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rakyat di kota petualang Lacoryna,
Dialogue: 0,0:11:13.32,0:11:16.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bangga terhadap kota mereka\Ndan punya harga diri tinggi.
Dialogue: 0,0:11:16.78,0:11:20.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga Count Howlrodde\Nyang menguasai kota ini pun
Dialogue: 0,0:11:20.03,0:11:26.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sering dikeluhkan ayahku, Aizas,\Nkarena sombong dan licik.
Dialogue: 0,0:11:27.84,0:11:30.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti ini permohonan sulit.
Dialogue: 0,0:11:30.09,0:11:33.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dirasa menyinggung, kami minta maaf.
Dialogue: 0,0:11:33.88,0:11:37.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kami ingin meminta waktu\Nuntuk meyakinkanmu lebih dulu.
Dialogue: 0,0:11:37.93,0:11:40.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Insiden kali ini sangat rumit.
Dialogue: 0,0:11:40.30,0:11:45.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku khawatir ini akan dianggap remeh\Nkalau disampaikan lewat perantara.
Dialogue: 0,0:11:45.06,0:11:50.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memanggil ketua serikat dengan enteng\Nhanya demi petualang kampung
Dialogue: 0,0:11:50.77,0:11:52.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu tidak menyenangkan.
Dialogue: 0,0:11:53.65,0:11:55.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kampung?
Dialogue: 0,0:11:55.32,0:11:59.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon jangan samakan skala kami\Ndengan serikat kampungan Rondalm.
Dialogue: 0,0:11:59.82,0:12:01.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dari jumlah dan kualitas petualang\N- I-Itu memang benar.
Dialogue: 0,0:12:01.78,0:12:02.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- di bawah naungan kami,\N- I-Itu memang benar.
Dialogue: 0,0:12:02.91,0:12:05.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- maupun jumlah uang yang kami urus,\N- Kuakui kota ini sedikit lebih maju,
Dialogue: 0,0:12:05.08,0:12:06.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- tempat ini jauh lebih besar dari bayangan Anda!\N- Kuakui kota ini sedikit lebih maju,
Dialogue: 0,0:12:06.62,0:12:09.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- tempat ini jauh lebih besar dari bayangan Anda!\N- tapi Rondalm dan wilayah Count Edvaughn
Dialogue: 0,0:12:09.46,0:12:12.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Grup yang dapat beberapa ratus juta Gold\N- menurutku tidak sekampungan itu juga.
Dialogue: 0,0:12:12.84,0:12:15.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dalam sekali penukaran pun tidaklah jarang.
Dialogue: 0,0:12:16.05,0:12:20.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan keterikatan, rasa sayang, atau cinta\Npada kota asalku, tapi sebuah kenyataan.
Dialogue: 0,0:12:20.64,0:12:24.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya, ketua serikat sangatlah sibuk.
Dialogue: 0,0:12:24.01,0:12:27.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permohonan kalian untuk menemui beliau\Ntidak bisa saya penuhi.
Dialogue: 0,0:12:30.60,0:12:33.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya kukeluarkan ini lebih dulu, ya.
Dialogue: 0,0:12:33.27,0:12:34.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong tukar ini dengan uang.
Dialogue: 0,0:12:35.73,0:12:37.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Besar sekali ukurannya!
Dialogue: 0,0:12:37.95,0:12:41.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ditotal semuanya,\Nmungkin hampir 10 juta Gold?
Dialogue: 0,0:12:42.24,0:12:45.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ehem, mohon tunggu sebentar.
Dialogue: 0,0:12:49.67,0:12:52.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi, ada petualang yang meminta
Dialogue: 0,0:12:52.00,0:12:56.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk segera menukar batu sihir\Ndengan 10 juta Gold!
Dialogue: 0,0:12:56.26,0:12:57.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}10 juta Gold sekaligus?
Dialogue: 0,0:12:57.59,0:12:59.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong siapkan secepatnya!
Dialogue: 0,0:12:59.51,0:13:00.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa peringkat orangnya?
Dialogue: 0,0:13:00.93,0:13:02.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelas D!
Dialogue: 0,0:13:02.01,0:13:03.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelas D?
Dialogue: 0,0:13:03.76,0:13:05.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Pokoknya tolong segera!\N- Barusan itu ada sedikit niat
Dialogue: 0,0:13:05.72,0:13:07.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ini menyangkut harga diri Kota Lacoryna!\N- untuk membuat dia tahu rasa, kan?
Dialogue: 0,0:13:07.89,0:13:10.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ini menyangkut harga diri Kota Lacoryna!\NAku tidak ada niat seperti itu.
Dialogue: 0,0:13:12.35,0:13:14.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun,
Dialogue: 0,0:13:14.02,0:13:18.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}begitu selesai menjual batu sihir,\Nkami bisa bertemu ketua serikat.
Dialogue: 0,0:13:20.32,0:13:25.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau petualang kelas D ingin\Nmenjual batu sihir sebanyak itu sekaligus,
Dialogue: 0,0:13:25.33,0:13:27.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sepertinya harus lewat prosedur yang rumit.
Dialogue: 0,0:13:27.95,0:13:31.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, petugas resepsionis sepertinya\Nmendesak untuk diusahakan,
Dialogue: 0,0:13:31.54,0:13:33.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi penukarannya bisa diselesaikan.
Dialogue: 0,0:13:33.21,0:13:37.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di saat bersamaan, tampaknya juga berhasil\Nmembuat janji dengan ketua serikat.
Dialogue: 0,0:13:37.55,0:13:41.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar dia sosok yang sibuk,\Ntapi untungnya kami bisa langsung bertemu.
Dialogue: 0,0:13:44.96,0:13:46.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Hailenn.
Dialogue: 0,0:13:46.22,0:13:50.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya telah membawa para petualang\Nyang saya sampaikan tadi.
Dialogue: 0,0:13:51.60,0:13:53.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang mana, ya?
Dialogue: 0,0:13:53.23,0:13:56.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak dengar\Nada permohonan seperti itu.
Dialogue: 0,0:13:57.69,0:14:00.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa Anda belum dengar\Ndari pegawai yang lain?
Dialogue: 0,0:14:03.16,0:14:05.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah, cepat suruh mereka masuk.
Dialogue: 0,0:14:05.99,0:14:07.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik.
Dialogue: 0,0:14:08.99,0:14:10.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf.
Dialogue: 0,0:14:10.87,0:14:13.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya ada kesalahan...
Dialogue: 0,0:14:13.25,0:14:16.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, tidak jadi masalah asalkan\Nkami bisa bicara dengannya.
Dialogue: 0,0:14:55.25,0:14:57.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Badut dan Kesatria Kelas Berat?
Dialogue: 0,0:14:57.79,0:15:00.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kombinasi yang sangat tidak biasa.
Dialogue: 0,0:15:00.75,0:15:03.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matilda, siapa mereka?
Dialogue: 0,0:15:03.38,0:15:07.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka petualang Kelas D\Nyang baru datang dari Kota Rondalm.
Dialogue: 0,0:15:07.89,0:15:11.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petualang kelas D dari Rondalm?
Dialogue: 0,0:15:12.27,0:15:17.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Tapi, sepertinya mereka sudah\Nmenaklukkan Terowongan Lipan level 60.
Dialogue: 0,0:15:17.48,0:15:22.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya, kemampuan mereka\Ntergolong tinggi di antara kelas D.
Dialogue: 0,0:15:25.24,0:15:30.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua orang petualang kelas D\Nmenaklukkan Terowongan Lipan?
Dialogue: 0,0:15:30.49,0:15:34.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlebih lagi, mereka itu Badut\Ndan Kesatria Kelas Berat?
Dialogue: 0,0:15:34.25,0:15:39.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira keduanya kelas yang kurang cocok\Nuntuk menaklukkan master.
Dialogue: 0,0:15:43.17,0:15:45.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menarik juga.
Dialogue: 0,0:15:48.14,0:15:50.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi sedikit penasaran.
Dialogue: 0,0:15:50.80,0:15:53.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski hawanya agak mencekam,
Dialogue: 0,0:15:53.02,0:15:57.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rasanya kalau tetap seperti ini,\Nomonganku tidak akan diabaikan begitu saja.
Dialogue: 0,0:15:58.77,0:16:02.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja orang ini,\Npengamatannya tidak main-main.
Dialogue: 0,0:16:03.28,0:16:06.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi cemas karena seakan\Ndia bisa membaca isi hatiku.
Dialogue: 0,0:16:07.45,0:16:11.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetap saja, petualang kelas D\Nberani menantang master?
Dialogue: 0,0:16:11.95,0:16:16.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski soal kemampuan mungkin\Ntermasuk tinggi untuk kelas D,
Dialogue: 0,0:16:16.00,0:16:21.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian kelihatan berambisi mengincar lebih\Ntanpa pencapaian yang memadai.
Dialogue: 0,0:16:24.33,0:16:27.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah terlalu buru-buru ingin mati,
Dialogue: 0,0:16:27.01,0:16:33.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau kalian begitu yakin pada kelas\Ndan informasi soal dungeon.
Dialogue: 0,0:16:33.51,0:16:35.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum sempat bicara pun,
Dialogue: 0,0:16:35.43,0:16:40.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia sudah bisa membaca situasi kami\Ndari sedikit informasi.
Dialogue: 0,0:16:40.02,0:16:45.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, inilah ketua serikat daerah dengan\Ntingkat kemunculan dungeon yang tinggi.
Dialogue: 0,0:16:45.44,0:16:46.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak...
Dialogue: 0,0:16:46.61,0:16:50.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa ada juga hal yang tidak bisa\Ndijelaskan hanya dengan itu.
Dialogue: 0,0:16:51.32,0:16:57.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sikap tidak gentar dan berwibawa,\Nserta raut muka yang elegan.
Dialogue: 0,0:16:57.08,0:16:59.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ditambah tahu banyak soal dungeon,
Dialogue: 0,0:17:00.37,0:17:03.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa mungkin dirimu dari keluarga bangsawan?
Dialogue: 0,0:17:03.67,0:17:08.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Juga kudengar kalau kamu\Ndatang Kota Rondalm...
Dialogue: 0,0:17:08.58,0:17:14.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seingatku, tuan tanah di sana\Npunya putra yang seumuran denganmu.
Dialogue: 0,0:17:14.18,0:17:16.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bi-Bisa tahu sampai sejauh itu?
Dialogue: 0,0:17:18.59,0:17:22.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche terlalu mudah ditebak.\NMustahil berakting untuk menyangkal.
Dialogue: 0,0:17:25.48,0:17:27.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Elymas.
Dialogue: 0,0:17:27.69,0:17:29.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedangkan gadis ini Ruche.
Dialogue: 0,0:17:29.86,0:17:34.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti yang disebutkan tadi,\Nkami petualang dari Rondalm.
Dialogue: 0,0:17:34.07,0:17:39.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami berhadapan dengan situasi\Nyang sedikit ganjil di Terowongan Lipan,
Dialogue: 0,0:17:39.37,0:17:45.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi kami memohon bertemu\Nuntuk menyampaikannya langsung.
Dialogue: 0,0:17:45.42,0:17:49.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah berkenan\Nmeluangkan waktu Anda.
Dialogue: 0,0:17:56.18,0:17:58.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:17:58.02,0:18:02.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang membuatku penasaran,\Ntapi tidak akan kutanyakan soal itu.
Dialogue: 0,0:18:03.52,0:18:06.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Hailenn Howlrodde.
Dialogue: 0,0:18:06.48,0:18:09.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketua serikat dari Kota Lacoryna ini.
Dialogue: 0,0:18:09.28,0:18:12.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria yang di situ sepertinya\Nsudah bisa menebak,
Dialogue: 0,0:18:12.36,0:18:15.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku adalah anggota\Ncabang keluarga Count Howlrodde.
Dialogue: 0,0:18:15.66,0:18:18.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya dia tahu betul\Nsoal situasi para bangsawan.
Dialogue: 0,0:18:19.33,0:18:22.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di Kota Petualang Lacoryna ini,
Dialogue: 0,0:18:22.04,0:18:23.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}serikat punya kedudukan lebih tinggi
Dialogue: 0,0:18:23.96,0:18:25.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dibanding kota-kota lain.
Dialogue: 0,0:18:25.54,0:18:28.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menaruh anggota keluarga cabang\Nsebagai ketua serikat
Dialogue: 0,0:18:28.46,0:18:30.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti agar serikat dan keluarga bangsawan
Dialogue: 0,0:18:30.96,0:18:33.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa berkoordinasi dengan mulus.
Dialogue: 0,0:18:33.55,0:18:39.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Badut dan Kesatria Kelas Berat bisa\Nmenaklukkan Terowongan Lipan itu luar biasa.
Dialogue: 0,0:18:39.10,0:18:41.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rock Centipede yang jadi master di sana.
Dialogue: 0,0:18:41.18,0:18:45.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubrukan tubuh raksasanya\Ndan penyembuhan otomatisnya yang cepat
Dialogue: 0,0:18:45.85,0:18:49.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membuatnya ditakuti banyak petualang.
Dialogue: 0,0:18:50.07,0:18:52.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik Kesatria Kelas Berat maupun Badut,
Dialogue: 0,0:18:52.24,0:18:55.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seharusnya tidak punya\Nserangan pemungkas untuk mengatasinya.
Dialogue: 0,0:18:55.41,0:18:58.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Ternyata normalnya memang begitu, ya.
Dialogue: 0,0:19:00.74,0:19:05.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya berbahaya kalau terlalu lama\Nmengobrol santai dengan orang ini.
Dialogue: 0,0:19:05.58,0:19:08.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hailenn tahu terlalu banyak\Ntentang dunia ini.
Dialogue: 0,0:19:08.59,0:19:10.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sampai menunjukkan celah,
Dialogue: 0,0:19:10.09,0:19:15.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rasanya dia bisa menarik kesimpulan\Nkalau aku punya informasi dari luar dunia ini.
Dialogue: 0,0:19:15.68,0:19:21.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang layak menyandang nama Howlrodde\Nyang memimpin kota petualang ini.
Dialogue: 0,0:19:22.02,0:19:26.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Informasi mereka jauh lebih banyak\Ndibanding ayahku, Aizas,
Dialogue: 0,0:19:26.60,0:19:29.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan keluarga Count Edvaughn.
Dialogue: 0,0:19:29.73,0:19:32.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menduga ada jarak di antara kami,
Dialogue: 0,0:19:32.78,0:19:34.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ternyata sejauh ini.
Dialogue: 0,0:19:35.57,0:19:39.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum lagi, ada yang membuatku khawatir.
Dialogue: 0,0:19:40.03,0:19:43.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalang yang sudah memenuhi\Nsyarat Evolusi Eksistensi,
Dialogue: 0,0:19:43.45,0:19:47.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa mungkin adalah ulah\Nkeluarga Count Howlrodde?
Dialogue: 0,0:19:51.71,0:19:55.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau orang keluarga cabang\Nadalah pemimpin serikat,
Dialogue: 0,0:19:55.09,0:19:58.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti mudah untuk menggiring petualang\Ndan memanipulasi informasi.
Dialogue: 0,0:19:58.55,0:20:01.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga punya banyak informasi.
Dialogue: 0,0:20:02.64,0:20:07.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang mencari tahu hukum dunia ini\Ndemi menguasai wilayah.
Dialogue: 0,0:20:07.56,0:20:10.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa juga diasumsikan seperti itu.
Dialogue: 0,0:20:10.73,0:20:13.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang tidak boleh\Nmemutuskan begitu saja,
Dialogue: 0,0:20:13.48,0:20:16.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi situasi yang sekarang\Nmengharuskanku bertindak hati-hati.
Dialogue: 0,0:20:17.53,0:20:19.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena bisa jadi orang di hadapanku,
Dialogue: 0,0:20:19.57,0:20:23.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah dalang Evolusi Eksistensi kali ini!
Dialogue: 0,0:20:24.33,0:20:27.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu terlihat sedang memikirkan sesuatu.
Dialogue: 0,0:20:27.08,0:20:28.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:20:28.96,0:20:32.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah ada yang ingin\Nkamu laporkan padaku?
Dialogue: 0,0:20:32.71,0:20:36.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau jangan-jangan situasi darurat itu bohong,
Dialogue: 0,0:20:36.97,0:20:42.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kamu cuma ingin menarik perhatianku\Ndengan pamer prestasi?
Dialogue: 0,0:20:42.60,0:20:47.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau benar begitu,\Ncara berpikirmu sangatlah lugu.
Dialogue: 0,0:20:47.31,0:20:50.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini berkumpul puluhan ribu petualang
Dialogue: 0,0:20:50.15,0:20:53.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan hanya sebagian kecil saja\Nyang berhasil menumpuk kesuksesan.
Dialogue: 0,0:20:53.23,0:20:56.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kota berisi mimpi dan kegagalan.
Dialogue: 0,0:20:56.07,0:21:01.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memiliki bakat yang menonjol\Nbukanlah hal langka di sini.
Dialogue: 0,0:21:01.45,0:21:06.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cukup tertarik untuk bermain-main\Nsebentar denganmu.
Dialogue: 0,0:21:10.00,0:21:11.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar bocah ingusan.
Dialogue: 0,0:21:11.79,0:21:15.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan berpikir bahwa kamu\Nbisa mempermainkanku!
Dialogue: 0,0:21:18.01,0:21:22.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa arti ucapannya itu\Nmemang apa adanya?
Dialogue: 0,0:21:22.97,0:21:28.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau cuma imbauan berbelit\Nsetelah menebak isi pikiran kami?
Dialogue: 0,0:21:28.02,0:21:31.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar sulit menerka\Napa yang di dalam hatinya.
Dialogue: 0,0:23:11.37,0:23:13.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami berhasil bertemu\Nketua serikat bernama Hailenn.
Dialogue: 0,0:23:13.75,0:23:17.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tampaknya ini baru permulaan.
Dialogue: 0,0:23:17.38,0:23:19.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum tahu dia itu sekutu atau musuh.
Dialogue: 0,0:23:19.96,0:23:25.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus hati-hati memilih setiap ucapan\Nhingga ekspresi yang kutunjukkan.
Dialogue: 0,0:23:25.72,0:23:27.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masalahnya bukan cuma itu.
Dialogue: 0,0:23:27.72,0:23:32.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Juga perlu mencari pandai besi yang bisa\Nmengolah mythril dari Terowongan Lipan.
Dialogue: 0,0:23:33.14,0:23:35.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, Veruga si Pandai Besi.
Dialogue: 0,0:23:35.56,0:23:39.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pandai besi berlevel tinggi\Nmemanglah sosok berharga.
