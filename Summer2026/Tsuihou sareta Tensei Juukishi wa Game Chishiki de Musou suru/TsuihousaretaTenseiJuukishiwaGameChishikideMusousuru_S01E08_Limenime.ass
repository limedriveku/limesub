Dialogue: 0,0:00:00.90,0:00:03.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku butuh kekuatanmu!
Dialogue: 0,0:00:04.61,0:00:07.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong pinjamkan kekuatanmu\Nuntuk ke depannya.
Dialogue: 0,0:00:19.46,0:00:21.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dice Thrust!
Dialogue: 0,0:00:41.60,0:00:43.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kritikal.
Dialogue: 0,0:01:00.37,0:01:03.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Poin pengalaman\Ndari Raana Emas memang nikmat,
Dialogue: 0,0:01:03.63,0:01:07.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kenikmatan utamanya\Nadalah drop item yang harganya mahal.
Dialogue: 0,0:01:08.43,0:01:10.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peluang jatuhnya 50%.
Dialogue: 0,0:01:33.28,0:01:37.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belati Berhias Raana Berkilau,\NDaya Serang +12.
Dialogue: 0,0:01:37.74,0:01:40.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harga pasar: 17 juta Gold.
Dialogue: 0,0:01:40.46,0:01:42.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Pendek Raana yang berkilau.
Dialogue: 0,0:01:42.42,0:01:44.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bongkahan emas Raana\Ndengan kemurnian tinggi.
Dialogue: 0,0:01:45.57,0:01:48.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dia, Belati Berhias Raana Berkilau!
Dialogue: 0,0:03:24.98,0:03:26.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa sekali!
Dialogue: 0,0:03:26.48,0:03:29.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Drop item seharga 1,7 juta Gold\Nbisa jatuh semudah ini!
Dialogue: 0,0:03:31.44,0:03:34.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kamu salah baca nominalnya.
Dialogue: 0,0:03:34.19,0:03:35.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nolnya kurang satu.
Dialogue: 0,0:03:35.74,0:03:36.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:03:36.70,0:03:39.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar 17 juta Gold.
Dialogue: 0,0:03:45.71,0:03:51.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu, sepuluh, seribu, sepuluh ribu...
Dialogue: 0,0:03:51.46,0:03:54.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seratus ribu?\NSatu juta tujuh ratus...
Dialogue: 0,0:04:00.85,0:04:03.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berakhir dikeluarkan dari grup sebelumnya
Dialogue: 0,0:04:03.42,0:04:08.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena ribut minta jatah\Ndari item seharga dua juta.
Dialogue: 0,0:04:08.60,0:04:10.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah agak tenang?
Dialogue: 0,0:04:10.61,0:04:12.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, lumayan.
Dialogue: 0,0:04:12.77,0:04:15.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku masih sulit percaya.
Dialogue: 0,0:04:15.94,0:04:20.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barang mahal ternyata\Nbisa didapat semudah ini.
Dialogue: 0,0:04:20.02,0:04:25.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski terdengar aneh aku bilang begini\Nkarena Elymas yang menyiapkan semuanya.
Dialogue: 0,0:04:28.54,0:04:32.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kalau punya item selangka ini,\Nnyawa kita nanti pasti bakal diincar!
Dialogue: 0,0:04:32.79,0:04:35.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elymas, ayo kita lari sama-sama!
Dialogue: 0,0:04:35.46,0:04:38.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita berdua harus hidup tersembunyi\Ndi desa terpencil!
Dialogue: 0,0:04:38.30,0:04:39.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo seperti itu!
Dialogue: 0,0:04:39.80,0:04:41.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya? Ya?
Dialogue: 0,0:04:41.80,0:04:43.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, ayo!
Dialogue: 0,0:04:43.10,0:04:46.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kamu benar.
Dialogue: 0,0:04:47.27,0:04:49.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah waktunya kita berangkat.
Dialogue: 0,0:04:50.90,0:04:54.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo buru satu ekor lagi\Nsebelum matahari terbenam.
Dialogue: 0,0:04:55.40,0:04:57.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sa-Satu ekor lagi?
Dialogue: 0,0:05:07.08,0:05:08.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiga jam kemudian.
Dialogue: 0,0:05:09.58,0:05:10.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dice Thrust!
Dialogue: 0,0:05:10.71,0:05:11.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miss.
Dialogue: 0,0:05:11.71,0:05:13.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dice Thrust!
Dialogue: 0,0:05:13.13,0:05:13.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miss.
Dialogue: 0,0:05:13.96,0:05:15.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dice Thrust!
Dialogue: 0,0:05:15.34,0:05:16.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miss.
Dialogue: 0,0:05:16.30,0:05:17.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekali lagi!
Dialogue: 0,0:05:17.46,0:05:18.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miss.
Dialogue: 0,0:05:18.34,0:05:19.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dice Thrust!
Dialogue: 0,0:05:19.76,0:05:20.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miss.
Dialogue: 0,0:05:21.34,0:05:22.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini pasti berhasil!
Dialogue: 0,0:05:22.55,0:05:26.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dice Thrust!
Dialogue: 0,0:05:28.47,0:05:30.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kritikal.
Dialogue: 0,0:05:38.40,0:05:39.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita berhasil, Ruche!
Dialogue: 0,0:05:39.94,0:05:41.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini yang kedua!
Dialogue: 0,0:05:41.17,0:05:43.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Telah naik ke level 33.
Dialogue: 0,0:05:43.45,0:05:45.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche?
Dialogue: 0,0:05:51.16,0:05:54.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Su-Sudah, meski beberapa kali meleset,
Dialogue: 0,0:05:54.46,0:05:57.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}anggap saja hoki seperti ini\Nsebagai tabungan untuk nanti.
Dialogue: 0,0:06:00.34,0:06:01.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiga...
Dialogue: 0,0:06:03.55,0:06:07.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiga puluh... empat juta...
Dialogue: 0,0:06:12.18,0:06:13.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche!
Dialogue: 0,0:06:13.44,0:06:15.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuatkan dirimu!
Dialogue: 0,0:06:15.35,0:06:18.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Ruche!
Dialogue: 0,0:06:24.20,0:06:26.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiga... tiga puluh juta.
Dialogue: 0,0:06:26.57,0:06:30.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tiga juta dikali sepuluh.
Dialogue: 0,0:06:31.20,0:06:36.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat Ruche, kita berhasil mendapat\Ndua Belati Berhias Raana Berkilau.
Dialogue: 0,0:06:36.21,0:06:38.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar grup kita bisa terus berjalan,
Dialogue: 0,0:06:38.96,0:06:43.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harus serius memikirkan bagaimana\Nuang sebesar ini akan digunakan.
Dialogue: 0,0:06:44.22,0:06:45.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kamu benar!
Dialogue: 0,0:06:45.97,0:06:48.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus memikirkan ke depannya!
Dialogue: 0,0:06:48.72,0:06:53.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, masih terasa tidak nyata...
Dialogue: 0,0:06:53.77,0:06:58.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita juga harus memikirkan pilihan skill\Nyang sesuai dengan perlengkapan.
Dialogue: 0,0:06:58.23,0:06:59.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya!
Dialogue: 0,0:06:59.82,0:07:03.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Levelku langsung naik banyak,\Njadi ada sisa poin skill lagi.
Dialogue: 0,0:07:03.99,0:07:05.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kumasukkan ke mana?
Dialogue: 0,0:07:06.41,0:07:10.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Su-Sudah kubilang itu bukan sesuatu\Nbuat ditunjukkan ke orang lain.
Dialogue: 0,0:07:10.74,0:07:12.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah telanjur.
Dialogue: 0,0:07:12.83,0:07:14.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak perlu cemas!
Dialogue: 0,0:07:14.00,0:07:18.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berutang budi padamu karena sudah\Nmenaikkan levelku sampai sini.
Dialogue: 0,0:07:18.54,0:07:20.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski nanti diperas habis
Dialogue: 0,0:07:20.42,0:07:23.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu dibuang seperti lap kotor habis pakai,\Naku tidak dendam!
Dialogue: 0,0:07:23.76,0:07:28.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sejauh itu, tidak menaruh dendam\Njustru lebih membebani.
Dialogue: 0,0:07:31.26,0:07:32.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:07:41.02,0:07:42.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara?
Dialogue: 0,0:07:44.07,0:07:45.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara?
Dialogue: 0,0:07:46.40,0:07:50.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa barusan tidak terdengar suara\Nseperti tangisan bayi?
Dialogue: 0,0:07:57.50,0:07:59.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara tangisan bayi?
Dialogue: 0,0:08:06.88,0:08:08.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:08:12.22,0:08:14.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wandering, ya?
Dialogue: 0,0:08:17.77,0:08:19.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kata lain, bos.
Dialogue: 0,0:08:19.31,0:08:22.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master adalah jantung dari dungeon.
Dialogue: 0,0:08:22.40,0:08:25.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya tidak bergerak\Nmengurung diri di bagian terdalam.
Dialogue: 0,0:08:25.90,0:08:31.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, terkadang dalam kasus tertentu\Nakan keluar dan berkeliling di dalam dungeon.
Dialogue: 0,0:08:33.03,0:08:36.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah yang disebut Wandering.
Dialogue: 0,0:08:36.53,0:08:38.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wa-Wandering?
Dialogue: 0,0:08:38.15,0:08:41.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rekomendasi melawan\Nmaster tempat ini level 50, kan?
Dialogue: 0,0:08:41.53,0:08:43.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukankah ini gawat?
Dialogue: 0,0:08:43.59,0:08:44.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan masalah.
Dialogue: 0,0:08:44.71,0:08:48.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dihadapi dengan tepat,\Nkita tidak akan terlibat.
Dialogue: 0,0:08:49.72,0:08:54.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup menuju pintu keluar sambil lari\Nke arah berlawan dari suaranya.
Dialogue: 0,0:08:54.01,0:08:56.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master tidak akan mengejar sampai luar.
Dialogue: 0,0:08:56.31,0:08:58.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ja-Jadi begitu.
Dialogue: 0,0:08:58.52,0:09:00.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku jadi tenang.
Dialogue: 0,0:09:00.52,0:09:01.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:09:02.18,0:09:04.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang semudah itu.
Dialogue: 0,0:09:05.19,0:09:10.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langsung saja menuju pintu keluar,\Nlalu menerima imbalan kali ini.
Dialogue: 0,0:09:10.03,0:09:12.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu, semua ini akan selesai.
Dialogue: 0,0:09:13.42,0:09:14.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya.
Dialogue: 0,0:09:14.53,0:09:15.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:09:16.82,0:09:18.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}To-Tolong kami!
Dialogue: 0,0:09:21.67,0:09:23.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemikiranku terlalu dangkal!
Dialogue: 0,0:09:24.84,0:09:26.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tiba-tiba...
Dialogue: 0,0:09:26.38,0:09:30.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Muncul monster dengan kekuatan\Nyang jauh beda dari sebelumnya!
Dialogue: 0,0:09:41.94,0:09:44.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ini bukanlah gim!\N- Kamu baik-baik saja? Bertahanlah!
Dialogue: 0,0:09:44.48,0:09:46.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Mustahil mereka bisa kabur\N- Apa yang terjadi?
Dialogue: 0,0:09:46.65,0:09:48.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- dengan kondisi seperti itu!\N- Di sana ada...
Dialogue: 0,0:09:48.23,0:09:53.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sekarang kami kabur,\Nmereka berdua pasti akan mati!
Dialogue: 0,0:10:04.04,0:10:07.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche, antar mereka sampai ke luar!
Dialogue: 0,0:10:07.92,0:10:10.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku yang menarik monsternya!
Dialogue: 0,0:10:10.67,0:10:12.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baiklah!
Dialogue: 0,0:10:12.30,0:10:17.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kamu sekalipun tak akan sanggup\Nkalau lawannya Master level 50!
Dialogue: 0,0:10:17.26,0:10:19.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham karakteristik musuh.
Dialogue: 0,0:10:19.21,0:10:23.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau cuma mengulur waktu dan kabur,\Naku sendiri juga bisa.
Dialogue: 0,0:10:23.27,0:10:24.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu!
Dialogue: 0,0:10:26.48,0:10:30.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menarik musuh\Nadalah tugas Kesatria Kelas Berat!
Dialogue: 0,0:10:32.99,0:10:34.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elymas...
Dialogue: 0,0:10:58.80,0:11:00.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Muncul juga.
Dialogue: 0,0:11:16.53,0:11:18.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesatria Kaleng.
Dialogue: 0,0:11:22.58,0:11:24.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}To-Tolong kami!
Dialogue: 0,0:11:25.21,0:11:29.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Muncul monster yang kekuatannya\Njauh berbeda!
Dialogue: 0,0:11:30.71,0:11:33.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ini bukanlah gim!\N- Kamu baik-baik saja?
Dialogue: 0,0:12:14.67,0:12:16.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengulur waktu!
Dialogue: 0,0:12:16.55,0:12:19.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche, tolong urus mereka berdua!
Dialogue: 0,0:12:19.22,0:12:20.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Tapi...
Dialogue: 0,0:12:20.97,0:12:22.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf!
Dialogue: 0,0:12:22.26,0:12:24.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:12:36.99,0:12:38.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:12:38.99,0:12:41.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}HP miliknya sudah terkikis.
Dialogue: 0,0:12:41.62,0:12:44.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih mending dari kondisi terburuk, ya.
Dialogue: 0,0:12:52.00,0:12:56.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elymas, monster itu memang kuat,\Ntapi dia sudah melemah!
Dialogue: 0,0:12:56.51,0:12:58.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita kalahkan berdua!
Dialogue: 0,0:12:58.30,0:13:00.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, itu mustahil, Ruche.
Dialogue: 0,0:13:00.68,0:13:01.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Larilah.
Dialogue: 0,0:13:01.93,0:13:02.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Tapi...
Dialogue: 0,0:13:02.97,0:13:06.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesatria Kaleng bukanlah Master yang asli.
Dialogue: 0,0:13:06.18,0:13:08.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia cuma seperti kaki dan tangannya.
Dialogue: 0,0:13:09.56,0:13:13.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar lagi, bos aslinya akan muncul.
Dialogue: 0,0:13:28.87,0:13:30.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin!
Dialogue: 0,0:13:31.08,0:13:35.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada tiga monster level 40?
Dialogue: 0,0:13:35.59,0:13:38.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan segera kususul setelah\Nsedikit mengulur waktu!
Dialogue: 0,0:13:38.30,0:13:39.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ja-Jangan begitu!
Dialogue: 0,0:13:39.34,0:13:42.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana bisa aku lari menyerahkan ini\Npadamu sendirian!
Dialogue: 0,0:13:42.93,0:13:45.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kamu mau menjadikanku rekan?
Dialogue: 0,0:13:45.05,0:13:47.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa perlu kuperjelas agar kamu paham?
Dialogue: 0,0:13:48.02,0:13:52.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lawannya bukan musuh lemah yang bisa\Nkuhadapi sambil ada yang menghalangi!
Dialogue: 0,0:13:53.10,0:13:54.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu cuma mengganggu.
Dialogue: 0,0:14:04.57,0:14:07.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, ya...
Dialogue: 0,0:14:07.24,0:14:08.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:14:15.00,0:14:18.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong segera menyusul, Elymas!
Dialogue: 0,0:14:21.34,0:14:23.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada tiga monster level 40.
Dialogue: 0,0:14:29.01,0:14:30.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau hanya ini,
Dialogue: 0,0:14:30.39,0:14:34.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin bisa kuminta Ruche dan duo tadi\Nmembantu untuk coba dihabisi.
Dialogue: 0,0:14:40.36,0:14:41.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja...
Dialogue: 0,0:14:44.95,0:14:47.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuh aslinya masih belum muncul.
Dialogue: 0,0:14:48.03,0:14:52.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang bilang ke Ruche kalau akan\Nmengalihkan perhatian mereka lalu kabur.
Dialogue: 0,0:14:52.00,0:14:53.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi itu bohong.
Dialogue: 0,0:14:54.08,0:14:56.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesatria Kelas Berat sepertiku\Ntidaklah cepat.
Dialogue: 0,0:14:57.95,0:15:00.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau cuma Kesatria Kaleng\Nmungkin bisa kuatasi.
Dialogue: 0,0:15:01.51,0:15:05.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, untuk lari menghindar dari Master\Ntempat ini yang punya serangan sihir
Dialogue: 0,0:15:07.01,0:15:08.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu mustahil.
Dialogue: 0,0:15:19.57,0:15:22.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masternya harus kukalahkan di sini!
Dialogue: 0,0:15:24.44,0:15:27.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya kamu muncul juga,\NMaster Embryo!
Dialogue: 0,0:15:33.91,0:15:38.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Status Embryo sendiri terhitung rendah\Ndi antara standar level 50.
Dialogue: 0,0:15:38.71,0:15:42.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masalahnya, dia tidak bisa dilukai.
Dialogue: 0,0:15:42.21,0:15:46.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gumpalan tubuhnya punya\Ndaya pertahanan yang mengerikan.
Dialogue: 0,0:15:46.79,0:15:49.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu bola mata yang jadi satu-satunya\Nbagian yang bisa dilukai,
Dialogue: 0,0:15:50.80,0:15:55.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak bisa diberi kerusakan\Nselain dengan serangan jarak jauh.
Dialogue: 0,0:15:56.73,0:15:57.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:15:58.98,0:16:02.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama masih punya kelemahan,\Nmau seorang diri dan level rendah pun,
Dialogue: 0,0:16:02.98,0:16:04.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}masih bisa mengalahkannya!
Dialogue: 0,0:16:04.65,0:16:07.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Ikrar Zirah Berat telah naik ke level 27,
Dialogue: 0,0:16:07.99,0:16:11.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mendapat skill Shield Bash.
Dialogue: 0,0:16:11.99,0:16:15.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo bertarung, Embryo!
Dialogue: 0,0:16:15.25,0:16:20.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja, aku tak akan lari!\NAku akan melawanmu dengan berani!
Dialogue: 0,0:16:24.46,0:16:27.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shield Bash!
Dialogue: 0,0:16:33.10,0:16:35.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill, Shield Bash.
Dialogue: 0,0:16:35.85,0:16:37.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mendorong musuh dengan tameng
Dialogue: 0,0:16:37.48,0:16:39.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mengempaskannya dengan kuat.
Dialogue: 0,0:16:41.31,0:16:44.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill ini sangat membantu\Nkarena bisa memecah formasi musuh.
Dialogue: 0,0:16:47.12,0:16:48.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Parry!
Dialogue: 0,0:16:49.24,0:16:50.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Disarm!
Dialogue: 0,0:16:52.87,0:16:56.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedua serangan sihir Embryo,\NSylph Cutter dan Thunderstorm,
Dialogue: 0,0:16:56.62,0:17:00.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak akan digunakan\Nkalau Kesatria Kaleng juga ikut kena.
Dialogue: 0,0:17:01.88,0:17:05.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini aku bisa fokus\Nmenyerang Kesatria Kaleng!
Dialogue: 0,0:17:10.58,0:17:12.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Disarm!
Dialogue: 0,0:17:12.82,0:17:14.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini yang kedua.
Dialogue: 0,0:17:15.03,0:17:18.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih ada 47 detik dari durasi Disarm pertama.
Dialogue: 0,0:17:20.89,0:17:22.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syarat aktivasinya sudah tercapai!
Dialogue: 0,0:17:28.31,0:17:30.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolakan Tembok Benteng!
Dialogue: 0,0:17:31.32,0:17:33.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolakan Tembok Benteng!
Dialogue: 0,0:17:34.07,0:17:36.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Acara utamanya baru dimulai sekarang!
Dialogue: 0,0:17:37.87,0:17:39.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu sudah kukalahkan!
Dialogue: 0,0:17:43.00,0:17:44.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:18:08.36,0:18:11.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama tubuh asli Embryo belum dikalahkan,
Dialogue: 0,0:18:11.11,0:18:13.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesatria Kaleng akan terus bangkit.
Dialogue: 0,0:18:14.41,0:18:18.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, saat dia menggunakan sihir,
Dialogue: 0,0:18:18.41,0:18:21.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bola mata yang jadi kelemahannya\Nakan terbuka lebar.
Dialogue: 0,0:18:23.71,0:18:25.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terimalah ini!
Dialogue: 0,0:18:31.09,0:18:34.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini satu-satunya metode serangan\Nyang bisa mengenainya.
Dialogue: 0,0:18:34.55,0:18:36.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batu Sihir Elemen Tanah.
Dialogue: 0,0:18:36.30,0:18:38.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila dialiri MP,
Dialogue: 0,0:18:38.01,0:18:40.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan menembakkan jarum tanah\Ndengan jumlah tidak terhitung.
Dialogue: 0,0:18:42.60,0:18:47.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segera sembunyi di balik Kesatria Kaleng\Nuntuk menghindari jalur tembak Sylph Cutter.
Dialogue: 0,0:18:47.15,0:18:51.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal berhasil melakukan ini, tidak akan\Nlangsung terbunuh oleh serangannya!
Dialogue: 0,0:18:55.66,0:18:56.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shield Bash!
Dialogue: 0,0:19:00.16,0:19:01.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:19:04.41,0:19:06.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tebasan Vital!
Dialogue: 0,0:19:10.71,0:19:14.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka... bisa belajar?
Dialogue: 0,0:19:14.38,0:19:19.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau di Magic World, monster biasa\Ntak akan bisa mengantisipasi skill kami.
Dialogue: 0,0:19:21.64,0:19:27.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka, jelas sekali kalau sudah\Nmengingat gerakan Shield Bash.
Dialogue: 0,0:19:29.23,0:19:31.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini masih dalam perkiraan.
Dialogue: 0,0:19:32.36,0:19:37.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau begini, tingkat kesulitan\Nmenaklukkan Embryo akan naik jauh.
Dialogue: 0,0:19:37.57,0:19:41.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk mengalahkannya,\Naku harus melempar tiga batu sihir lagi.
Dialogue: 0,0:19:41.58,0:19:44.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, penyembuhan otomatis Master\Nitu sangat cepat.
Dialogue: 0,0:19:45.04,0:19:47.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sampai memakan waktu,\Njelas akan gagal total.
Dialogue: 0,0:19:51.96,0:19:53.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar saja!
Dialogue: 0,0:19:53.21,0:19:56.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di posisi seperti ini, harusnya\NSylph Cutter tidak akan ditembakkan!
Dialogue: 0,0:20:02.43,0:20:03.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma.
Dialogue: 0,0:20:05.02,0:20:06.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak bisa kuhindari!
Dialogue: 0,0:20:35.84,0:20:38.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesadaranku memudar...
Dialogue: 0,0:20:40.30,0:20:43.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Denyut jantungku kencang sekali...
Dialogue: 0,0:20:44.81,0:20:47.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakiku tidak bertenaga...
Dialogue: 0,0:20:52.23,0:20:55.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Status abnormal, stun.
Dialogue: 0,0:20:56.82,0:20:58.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:20:58.65,0:21:02.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Stun di situasi seperti ini sangatlah fatal.
Dialogue: 0,0:21:03.37,0:21:04.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:21:05.66,0:21:09.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin karena poin keberuntungan awalku\Nmemang rendah.
Dialogue: 0,0:21:12.25,0:21:16.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya aku minta Ruche tetap di sini saja.
Dialogue: 0,0:21:16.34,0:21:18.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elymas, ayo kita kalahkan berdua!
Dialogue: 0,0:21:28.23,0:21:30.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap.
Dialogue: 0,0:21:35.17,0:21:37.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak sudah percaya padaku!
Dialogue: 0,0:23:10.35,0:23:11.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak lengah.
Dialogue: 0,0:23:11.91,0:23:15.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bertarung sebaik mungkin\Ndari yang bisa kupikirkan.
Dialogue: 0,0:23:15.08,0:23:20.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, pedangku tak bisa mengenai\NEmbryo, Master dari dungeon ini.
Dialogue: 0,0:23:20.71,0:23:22.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruche yang menyelamatkanku.
Dialogue: 0,0:23:22.92,0:23:26.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kembali tanpa memedulikan bahaya.
Dialogue: 0,0:23:26.34,0:23:27.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku...
Dialogue: 0,0:23:27.84,0:23:31.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami berdua akan mengalahkan Embryo!
Dialogue: 0,0:23:31.10,0:23:33.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kami taklukkan dungeon ini!
Dialogue: 0,0:23:33.56,0:23:35.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, Master.
Dialogue: 0,0:23:35.89,0:23:39.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata Ruche jauh melampaui...
