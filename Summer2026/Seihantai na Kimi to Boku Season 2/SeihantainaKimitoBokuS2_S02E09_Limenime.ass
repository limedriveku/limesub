Dialogue: 0,0:11:24.10,0:11:26.06,sign,,0000,0000,0000,,"MENGABDIKAN MASA MUDA UNTUK BELAJAR"
Dialogue: 0,0:12:13.02,0:12:15.24,sign,,0000,0000,0000,,"MATA BENING DAN POLOS"
Dialogue: 0,0:12:16.40,0:12:17.24,sign,,0000,0000,0000,,"100% PERNYATAAN MURNI"
Dialogue: 0,0:12:17.32,0:12:19.61,sign,,0000,0000,0000,,SEJUJURNYA, TIPE IDEALMU SEPERTI APA, SIH?
Dialogue: 0,0:12:20.28,0:12:21.45,sign,,0000,0000,0000,,"BOTOL PET"
Dialogue: 0,0:12:39.26,0:12:40.80,sign,,0000,0000,0000,,"BUKANKAH KELAS 1 JAUH?"
Dialogue: 0,0:12:46.47,0:12:49.56,sign,,0000,0000,0000,,KENAPA EKSPRESIMU BEGITU?
Dialogue: 0,0:13:39.82,0:13:42.32,sign,,0000,0000,0000,,"SAMPAHNYA PUN MASUK FOTO"
Dialogue: 0,0:13:56.17,0:13:57.00,sign,,0000,0000,0000,,TIDAK TERTARIK
Dialogue: 0,0:14:07.85,0:14:09.52,sign,,0000,0000,0000,,"AMBRUK…"
Dialogue: 0,0:15:11.24,0:15:12.79,sign,,0000,0000,0000,,"MENDENGUS…"
