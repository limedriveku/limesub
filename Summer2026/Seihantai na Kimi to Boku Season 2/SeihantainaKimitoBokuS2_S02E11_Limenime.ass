Dialogue: 0,0:00:12.44,0:00:14.44,sign,,0000,0000,0000,,"SEMUA HARI SAAT AKU MENGHINDARINYA…"
Dialogue: 0,0:02:35.23,0:02:36.40,sign,,0000,0000,0000,,MENATAP
Dialogue: 0,0:02:36.48,0:02:37.78,sign,,0000,0000,0000,,"NORMAL - MELAMUN"
Dialogue: 0,0:02:37.86,0:02:38.69,sign,,0000,0000,0000,,"BICARA NONSTOP"
Dialogue: 0,0:02:38.78,0:02:40.70,sign,,0000,0000,0000,,"MELIHAT LURUS"
Dialogue: 0,0:03:05.55,0:03:06.64,sign,,0000,0000,0000,,LUGAS
Dialogue: 0,0:04:46.11,0:04:47.70,sign,,0000,0000,0000,,"APA INI TIDAK MASALAH?"
Dialogue: 0,0:04:52.79,0:04:53.87,sign,,0000,0000,0000,,KENAPA JADI TANYA AKU?
Dialogue: 0,0:05:50.97,0:05:51.80,sign,,0000,0000,0000,,"FILTER PRASANGKA"
Dialogue: 0,0:05:51.89,0:05:53.64,sign,,0000,0000,0000,,"DIA TIDAK MENGANGGAPNYA SEBAGAI PASANGAN"
Dialogue: 0,0:05:53.72,0:05:55.10,sign,,0000,0000,0000,,TAPI TERUS-TERUSAN MEMBERINYA HARAPAN
Dialogue: 0,0:06:32.05,0:06:34.35,sign,,0000,0000,0000,,"MINUMAN HANGAT"
Dialogue: 0,0:07:30.49,0:07:31.74,sign,,0000,0000,0000,,"PUSAT KOMUNITAS YAMANEKO"
Dialogue: 0,0:09:20.01,0:09:21.43,sign,,0000,0000,0000,,"PUSAT OLAHRAGA DAN REKREASI"
Dialogue: 0,0:09:21.51,0:09:22.60,sign,,0000,0000,0000,,"ARENA HALANG RINTANG"
Dialogue: 0,0:09:22.68,0:09:23.85,sign,,0000,0000,0000,,"FASILITAS KEBUGARAN LUAR RUANGAN"
Dialogue: 0,0:09:23.93,0:09:24.85,sign,,0000,0000,0000,,"BERBAGAI OLAHRAGA, DLL"
Dialogue: 0,0:09:45.95,0:09:48.79,sign,,0000,0000,0000,,"CUMA BASA-BASI"
Dialogue: 0,0:10:09.60,0:10:11.27,sign,,0000,0000,0000,,"DIA IKUT WAKTU KAMI MAIN BOLING"
Dialogue: 0,0:10:28.37,0:10:32.17,sign,,0000,0000,0000,,"WAH! IH! AAH!"
Dialogue: 0,0:13:56.38,0:13:59.34,sign,,0000,0000,0000,,KEESOKAN HARINYA
Dialogue: 0,0:14:03.13,0:14:05.55,sign,,0000,0000,0000,,"SUARA RAMAI"
Dialogue: 0,0:14:37.46,0:14:38.55,sign,,0000,0000,0000,,BOLEHKAH?
Dialogue: 0,0:14:43.55,0:14:44.84,sign,,0000,0000,0000,,"ANAK KELAS 3-8 BERGABUNG"
Dialogue: 0,0:15:02.24,0:15:03.86,sign,,0000,0000,0000,,"KEMASAN - BUNGKUS EDISI TERBATAS"
Dialogue: 0,0:15:18.54,0:15:19.88,sign,,0000,0000,0000,,"MEMBUANG CAMILAN"
Dialogue: 0,0:15:25.18,0:15:28.35,sign,,0000,0000,0000,,TATAPAN "KAMU SUDAH MAU PERGI?"
Dialogue: 0,0:15:40.65,0:15:42.86,sign,,0000,0000,0000,,"TIDAK ADA RENCANA"
Dialogue: 0,0:16:16.85,0:16:18.31,sign,,0000,0000,0000,,"HORE"
Dialogue: 0,0:17:31.22,0:17:32.97,sign,,0000,0000,0000,,KELAS 7 SEDANG MENGADAKAN PESTA CAMILAN
Dialogue: 0,0:17:50.28,0:17:51.95,sign,,0000,0000,0000,,"GELISAH"
Dialogue: 0,0:18:02.25,0:18:04.25,sign,,0000,0000,0000,,"INI DIA!"
Dialogue: 0,0:18:07.96,0:18:09.13,sign,,0000,0000,0000,,"TIBA BERGEROMBOL"
Dialogue: 0,0:20:10.21,0:20:12.25,sign,,0000,0000,0000,,"SEMUA MULAI BERANJAK"
Dialogue: 0,0:20:15.26,0:20:16.72,sign,,0000,0000,0000,,"MERASA KESEPIAN…"
Dialogue: 0,0:20:21.60,0:20:23.01,sign,,0000,0000,0000,,KAMU MAU BALIK SEKARANG?
Dialogue: 0,0:20:35.01,0:20:35.86,sign,,0000,0000,0000,,"BERJALAN SEARAH MENUJU TEMPAT BIMBEL"
Dialogue: 0,0:22:19.17,0:22:22.01,sign,,0000,0000,0000,,SAMPAI JUMPA DI EPISODE BERIKUTNYA…
Dialogue: 0,0:00:02.39,0:00:05.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin saja Azuma menyukaiku.
Dialogue: 0,0:00:06.14,0:00:08.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah lama memikirkan hal ini,
Dialogue: 0,0:00:08.69,0:00:10.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ternyata itu cuma kesalahpahaman saja.
Dialogue: 0,0:00:10.86,0:00:11.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku,
Dialogue: 0,0:00:12.44,0:00:14.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau dipikir-pikir sedikit saja,
Dialogue: 0,0:00:14.44,0:00:16.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sadar itu hal yang mustahil.
Dialogue: 0,0:00:18.16,0:00:19.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memalukan sekali.
Dialogue: 0,0:00:20.16,0:00:21.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diriku ini sangat memalukan.
Dialogue: 0,0:00:22.08,0:00:23.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi kasihan padanya.
Dialogue: 0,0:00:23.50,0:00:27.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah mengasihaninya pun terasa memalukan.
Dialogue: 0,0:00:27.83,0:00:30.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau dipikir bagaimanapun juga,\Nitu enggak mungkin.
Dialogue: 0,0:00:30.38,0:00:32.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku bisa berpikiran begitu, ya?
Dialogue: 0,0:00:33.80,0:00:36.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu terlalu percaya diri.
Dialogue: 0,0:00:36.26,0:00:37.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar memalukan!
Dialogue: 0,0:00:41.81,0:00:43.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjijikkan banget.
Dialogue: 0,0:00:59.28,0:01:08.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}You and I Are Polar Opposites\NSeason 2
Dialogue: 0,0:02:15.63,0:02:16.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu
Dialogue: 0,0:02:16.67,0:02:19.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita menyerah pergi ke kantin kemarin.
Dialogue: 0,0:02:19.63,0:02:21.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dengan sisa masa sekolah kita yang ada,
Dialogue: 0,0:02:21.59,0:02:25.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bakal sulit untuk mencicipi\Nseluruh menu yang ada.
Dialogue: 0,0:02:25.26,0:02:27.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak awal, orang sepertiku ini…
Dialogue: 0,0:02:27.89,0:02:30.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu enggak perlu menyimaknya terlalu serius.
Dialogue: 0,0:02:31.23,0:02:35.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sama sekali enggak bisa\Nmenebak jalan pikiran Azuma.
Dialogue: 0,0:02:36.48,0:02:37.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa…
Dialogue: 0,0:02:37.86,0:02:38.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa…
Dialogue: 0,0:02:38.78,0:02:40.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa…
Dialogue: 0,0:02:41.32,0:02:44.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus membuang kebiasaan buruk\Nselalu berpikir berlebihan ini.
Dialogue: 0,0:02:45.41,0:02:49.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersikap terlalu subjektif\Ndan enggak percaya diri
Dialogue: 0,0:02:49.29,0:02:51.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}enggak akan pernah\Nmembuahkan hasil yang baik.
Dialogue: 0,0:02:52.71,0:02:53.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:02:56.55,0:02:58.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti bakal lebih seru kalau kita\Npergi beramai-ramai.
Dialogue: 0,0:02:58.80,0:03:01.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berusaha menebak-nebak maksud mereka
Dialogue: 0,0:03:01.51,0:03:02.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya akan membuang-buang tenaga saja.
Dialogue: 0,0:03:03.05,0:03:04.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taira.
Dialogue: 0,0:03:04.51,0:03:05.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tulisan di papan tulisnya enggak kelihatan.
Dialogue: 0,0:03:06.72,0:03:08.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cowok ini…
Dialogue: 0,0:03:18.78,0:03:21.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita pergi ke kantin.
Dialogue: 0,0:03:21.28,0:03:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah lapar.
Dialogue: 0,0:03:23.07,0:03:24.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kantin?
Dialogue: 0,0:03:25.03,0:03:26.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita pergi bersama!
Dialogue: 0,0:03:27.83,0:03:29.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi…
Dialogue: 0,0:03:31.20,0:03:33.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hai.
Dialogue: 0,0:03:33.50,0:03:35.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasa rendah diriku ini…
Dialogue: 0,0:03:38.34,0:03:39.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merasa rendah diri karena hal apa?
Dialogue: 0,0:03:43.55,0:03:45.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan kepada siapa?
Dialogue: 0,0:04:11.66,0:04:13.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong aku!
Dialogue: 0,0:04:13.79,0:04:15.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mulai lagi, ya.
Dialogue: 0,0:04:15.17,0:04:17.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini soal cintamu yang bertepuk\Nsebelah tangan itu, kan?
Dialogue: 0,0:04:17.29,0:04:17.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini soal cintamu yang bertepuk\Nsebelah tangan itu, kan?\NKamu masih belum yakin ingin\Nberpacaran dengannya atau enggak, kan?
Dialogue: 0,0:04:17.70,0:04:20.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu masih belum yakin ingin\Nberpacaran dengannya atau enggak, kan?
Dialogue: 0,0:04:20.29,0:04:20.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu masih belum yakin ingin\Nberpacaran dengannya atau enggak, kan?\NBenar sekali.
Dialogue: 0,0:04:20.70,0:04:22.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar sekali.
Dialogue: 0,0:04:22.13,0:04:24.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi untuk saat ini,\Naku cuma ingin terus berada di dekatnya.
Dialogue: 0,0:04:24.22,0:04:26.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma berusaha bertahan secara\Ndiam-diam tanpa sepengetahuannya.
Dialogue: 0,0:04:27.05,0:04:28.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sangat menyukainya, ya?
Dialogue: 0,0:04:29.05,0:04:31.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertahan cuma demi bisa terus bersamanya…
Dialogue: 0,0:04:31.22,0:04:33.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu artinya kamu merasa enggak ada\Nharapan kalau menembaknya langsung?
Dialogue: 0,0:04:33.68,0:04:35.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa enggak begitu.
Dialogue: 0,0:04:35.52,0:04:36.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu rupanya.
Dialogue: 0,0:04:36.90,0:04:39.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku terlalu dekat, dia malah menjauh.
Dialogue: 0,0:04:39.56,0:04:42.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi akhir-akhir ini,\Naku merasa kami jadi makin akrab.
Dialogue: 0,0:04:42.53,0:04:44.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Emosiku jadi berantakan dibuatnya.
Dialogue: 0,0:04:44.65,0:04:46.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedengarannya dia cowok
Dialogue: 0,0:04:46.11,0:04:47.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang sangat merepotkan.
Dialogue: 0,0:04:48.53,0:04:51.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu ada di posisiku,\Nkamu bakal bagaimana?
Dialogue: 0,0:04:51.54,0:04:52.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku?
Dialogue: 0,0:04:54.29,0:04:58.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin pendapat dari orang normal\Nsebagai bahan pertimbangan.
Dialogue: 0,0:05:02.25,0:05:04.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlepas dari apakah aku ini\Ntergolong "normal" atau enggak,
Dialogue: 0,0:05:04.51,0:05:07.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku memang suka mendengar\Nkisah asmara orang lain,
Dialogue: 0,0:05:07.30,0:05:10.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sebatas ingin tahu perkembangannya saja.
Dialogue: 0,0:05:10.22,0:05:13.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan berarti aku berempati dengan mereka.
Dialogue: 0,0:05:13.56,0:05:14.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah itu perempuan ataupun laki-laki,
Dialogue: 0,0:05:14.93,0:05:17.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku memandang mereka sama saja\Nsebagai sesama manusia.
Dialogue: 0,0:05:18.35,0:05:22.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, aku kurang paham dengan hubungan\Nyang dimulai dari perasaan romantis.
Dialogue: 0,0:05:22.73,0:05:24.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu, dengan Tani dan Nishi,
Dialogue: 0,0:05:25.07,0:05:27.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku cuma merasa terbawa suasana saja.
Dialogue: 0,0:05:29.66,0:05:32.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah apakah pendapatku ini\Nbakal berguna untukmu atau enggak.
Dialogue: 0,0:05:32.91,0:05:33.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katakan saja.
Dialogue: 0,0:05:34.79,0:05:39.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kamu harus memikirkan ulang apakah\Nkamu menyukainya sebagai seorang manusia.
Dialogue: 0,0:05:39.12,0:05:40.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai seorang manusia…
Dialogue: 0,0:05:41.88,0:05:43.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan semata-mata sebagai seorang pria.
Dialogue: 0,0:05:44.63,0:05:45.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau memang enggak ada\Nharapan untuk menjalin asmara,
Dialogue: 0,0:05:45.92,0:05:48.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu harus menetapkan\Ntujuan lain selain cinta.
Dialogue: 0,0:05:49.55,0:05:50.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu.
Dialogue: 0,0:05:50.97,0:05:51.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin
Dialogue: 0,0:05:51.89,0:05:53.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lebih baik putus hubungan saja.
Dialogue: 0,0:05:55.39,0:05:58.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba pikirkan apakah kamu memang benar-benar\Nmembutuhkan sosoknya dalam hidupmu.
Dialogue: 0,0:05:58.94,0:06:00.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia cuma membawa pengaruh buruk,
Dialogue: 0,0:06:01.06,0:06:03.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lebih baik putuskan hubungan saja dengannya.
Dialogue: 0,0:06:03.19,0:06:05.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu tiba-tiba jadi sekejam itu?\NAku bisa mati, tahu!
Dialogue: 0,0:06:09.78,0:06:12.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau begitu, kalau urusan belajar,
Dialogue: 0,0:06:12.66,0:06:16.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebenarnya aku memang\Njadi berusaha lebih giat.
Dialogue: 0,0:06:18.37,0:06:21.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku enggak berpikir\Ndia bakal ada di sini,
Dialogue: 0,0:06:21.63,0:06:23.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku pasti enggak akan serajin ini\Ndatang ke ruang belajar.
Dialogue: 0,0:06:24.00,0:06:27.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paling cuma\Nbermalas-malasan di rumah saja.
Dialogue: 0,0:06:32.05,0:06:34.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada varian minuman baru.
Dialogue: 0,0:06:35.10,0:06:36.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asyik!
Dialogue: 0,0:06:36.68,0:06:38.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sampai sebegitu senangnya?
Dialogue: 0,0:06:46.40,0:06:48.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya kamu juga membeli minuman yang sama?
Dialogue: 0,0:06:48.36,0:06:50.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar saja aku penasaran, kan?
Dialogue: 0,0:07:05.25,0:07:06.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak enak.
Dialogue: 0,0:07:08.09,0:07:10.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun, tidak enak banget.
Dialogue: 0,0:07:10.38,0:07:11.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, aku malah tertawa.
Dialogue: 0,0:07:11.76,0:07:13.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jeda apa barusan itu?
Dialogue: 0,0:07:13.76,0:07:15.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jeda kecanggungan tadi.
Dialogue: 0,0:07:15.51,0:07:16.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bercanda, ya?
Dialogue: 0,0:07:24.73,0:07:26.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar sangat menyukainya.
Dialogue: 0,0:07:28.69,0:07:30.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini aku akan ke sini.
Dialogue: 0,0:07:30.49,0:07:31.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu jalan kaki?
Dialogue: 0,0:07:31.74,0:07:32.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:07:32.65,0:07:34.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuacanya kurang mendukung pagi ini.
Dialogue: 0,0:07:34.49,0:07:37.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulangnya aku juga bakal\Njalan kaki lewat sini.
Dialogue: 0,0:07:38.12,0:07:41.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Kamu baik sekali, sih.
Dialogue: 0,0:07:41.29,0:07:42.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya.
Dialogue: 0,0:07:42.21,0:07:44.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mengabaikanku.
Dialogue: 0,0:07:46.38,0:07:48.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menyukainya sebagai seorang manusia.
Dialogue: 0,0:07:48.38,0:07:50.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun begitu,
Dialogue: 0,0:07:50.30,0:07:52.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku juga sangat menyukai\Nmomen-momen seperti ini.
Dialogue: 0,0:07:52.59,0:07:54.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu saja sudah cukup.
Dialogue: 0,0:07:57.22,0:07:59.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuharap itu memang benar adanya.
Dialogue: 0,0:08:01.35,0:08:06.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuharap perasaannya juga\Nsama kuatnya dengan perasaanku.
Dialogue: 0,0:08:06.98,0:08:08.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya, itulah yang ada\Ndi pikiranku saat ini.
Dialogue: 0,0:08:09.69,0:08:12.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar enggak tertolong lagi\Nkarena terus memikirkan hal itu.
Dialogue: 0,0:08:15.41,0:08:17.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya kamu dengar musik genre apa?
Dialogue: 0,0:08:18.24,0:08:19.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu tiba-tiba bertanya begitu?
Dialogue: 0,0:08:19.37,0:08:21.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi penasaran\Nlagu apa yang kamu nyanyikan
Dialogue: 0,0:08:21.34,0:08:23.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}waktu karaoke bareng Yamada dan anak-anak.
Dialogue: 0,0:08:24.33,0:08:27.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mungkin enggak tahu lagunya\Nkarena itu lagu lama.
Dialogue: 0,0:08:27.58,0:08:30.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum tentu.\NSiapa tahu aku juga tahu lagunya.
Dialogue: 0,0:08:32.58,0:08:33.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagu yang ini.
Dialogue: 0,0:08:34.47,0:08:35.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak tahu.
Dialogue: 0,0:08:35.51,0:08:37.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:08:39.41,0:08:42.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya aku bisa tahu lagunya sekarang.
Dialogue: 0,0:08:42.27,0:08:42.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya aku bisa tahu lagunya sekarang.\NAkan aku masukkan ke daftar putarku.
Dialogue: 0,0:08:42.41,0:08:43.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan aku masukkan ke daftar putarku.
Dialogue: 0,0:08:45.39,0:08:48.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi antusias.\NNanti bakal aku dengarkan.
Dialogue: 0,0:08:53.40,0:08:54.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara soal Azuma,
Dialogue: 0,0:08:55.36,0:08:56.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku selalu merasa kalau dia
Dialogue: 0,0:08:56.80,0:09:01.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hidup di dunia yang sama sekali\Nenggak ada hubungannya denganku.
Dialogue: 0,0:09:01.91,0:09:04.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia jelas-jelas berasal dari\Nlingkungan yang sangat berbeda.
Dialogue: 0,0:09:04.41,0:09:06.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin malah enggak baik kalau\Ndia terlihat sedang bersamaku.
Dialogue: 0,0:09:07.75,0:09:09.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah terlalu memikirkan semuanya.
Dialogue: 0,0:09:10.38,0:09:15.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa aku sadari, aku sudah masuk\Nke dalam sirkel pertemanannya.
Dialogue: 0,0:09:15.51,0:09:17.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku masih sulit menerimanya begitu saja.
Dialogue: 0,0:09:18.43,0:09:19.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tahu enggak,
Dialogue: 0,0:09:20.01,0:09:21.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pusat olahraga dan rekreasi yang besar
Dialogue: 0,0:09:21.51,0:09:22.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}baru-baru ini dibuka
Dialogue: 0,0:09:22.68,0:09:23.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jaraknya tiga stasiun dari sini?
Dialogue: 0,0:09:23.93,0:09:24.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:09:24.93,0:09:28.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bilang pada Suzuki kalau aku mau\Npergi ke sana sehabis ujian selesai nanti.
Dialogue: 0,0:09:28.40,0:09:29.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin di bulan Maret.
Dialogue: 0,0:09:29.77,0:09:31.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maret, ya…
Dialogue: 0,0:09:32.98,0:09:36.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau di awal Maret,\Nhasil ujianku belum keluar.
Dialogue: 0,0:09:37.07,0:09:38.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak boleh bermain terlalu bebas.
Dialogue: 0,0:09:39.45,0:09:41.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau ikut bareng kami?
Dialogue: 0,0:09:41.95,0:09:43.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:09:43.45,0:09:45.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti bakal lebih seru kalau kita\Npergi beramai-ramai.
Dialogue: 0,0:09:45.95,0:09:48.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kita undur kencannya sedikit saja.
Dialogue: 0,0:09:49.29,0:09:54.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru saja, aku sudah membayangkan\Nkalau aku juga bakal ikut pergi.
Dialogue: 0,0:09:54.84,0:09:58.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu harus ajak yang lain juga.
Dialogue: 0,0:09:58.55,0:10:01.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yamada pasti bakal tertarik.
Dialogue: 0,0:10:02.43,0:10:03.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:10:03.60,0:10:05.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ikut, dong!
Dialogue: 0,0:10:05.14,0:10:07.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bisa membayangkan\Ndia bilang begitu.
Dialogue: 0,0:10:07.60,0:10:09.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira Tani bakal ikut, enggak?
Dialogue: 0,0:10:09.60,0:10:11.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kan kurang suka kegiatan semacam ini, kan?
Dialogue: 0,0:10:11.27,0:10:13.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Suzuki pergi,\Nmungkin dia bakal ikut pergi.
Dialogue: 0,0:10:13.19,0:10:15.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, kurasa dia bakal datang.
Dialogue: 0,0:10:15.73,0:10:17.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlepas dari Suzuki ikut atau enggak.
Dialogue: 0,0:10:17.82,0:10:20.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa dia bakal bilang\Ndengan ekspresi datarnya,
Dialogue: 0,0:10:20.32,0:10:22.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ikut.
Dialogue: 0,0:10:23.53,0:10:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bisa membayangkannya.
Dialogue: 0,0:10:25.29,0:10:28.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlepas dari Sato dan Watanabe,
Dialogue: 0,0:10:28.37,0:10:32.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa Suzuki bakal baik-baik saja di sana?
Dialogue: 0,0:10:32.71,0:10:35.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal dia sendiri yang menyarankannya,\Ntapi kamu malah mencemaskannya?
Dialogue: 0,0:10:37.51,0:10:39.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tertawa terlalu kencang.
Dialogue: 0,0:10:40.13,0:10:42.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, habisnya…
Dialogue: 0,0:10:42.68,0:10:45.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taira, ternyata kamu sangat\Nmemahami mereka semua, ya.
Dialogue: 0,0:10:49.85,0:10:51.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku…
Dialogue: 0,0:10:52.35,0:10:54.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak peduli dengan siapa pun aku bersama,
Dialogue: 0,0:10:54.19,0:10:56.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jauh di lubuk hatiku yang terdalam,\Naku enggak pernah memercayai
Dialogue: 0,0:10:56.98,0:10:59.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau ada tempat\Nyang benar-benar pas untukku.
Dialogue: 0,0:11:00.61,0:11:03.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu-satunya alasanku\Nbisa terus bertahan di sini sekarang
Dialogue: 0,0:11:03.20,0:11:05.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena jati diriku yang sesungguhnya\Nbelum terbongkar.
Dialogue: 0,0:11:07.37,0:11:09.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekalipun aku sampai mengecewakan orang lain,
Dialogue: 0,0:11:09.96,0:11:14.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa berlindung di balik alasan,\N"Sudah kuduga bakal begini akhirnya."
Dialogue: 0,0:11:14.63,0:11:16.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah terbiasa membangun\Nbenteng pertahanan.
Dialogue: 0,0:11:17.67,0:11:18.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kenyataannya…
Dialogue: 0,0:11:19.51,0:11:25.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku mendambakan tempat yang pas untukku\Nlebih dari siapa pun.
Dialogue: 0,0:11:25.35,0:11:28.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama ini aku melihat segala\Nsesuatunya lewat kacamata yang buram.
Dialogue: 0,0:11:28.18,0:11:31.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu bersembunyi di balik\Ntopeng yang penuh kerumitan ini.
Dialogue: 0,0:11:31.69,0:11:32.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku…
Dialogue: 0,0:11:32.98,0:11:35.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena pasti bakal lebih seru\Nkalau ada kamu di sana.
Dialogue: 0,0:11:35.52,0:11:37.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat aku merenungi kembali semua itu,
Dialogue: 0,0:11:37.36,0:11:40.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nyatanya keinginan utamaku\Nsangatlah sederhana.
Dialogue: 0,0:11:42.95,0:11:44.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah mendapatkannya…
Dialogue: 0,0:11:51.08,0:11:53.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sejak lama.
Dialogue: 0,0:11:59.63,0:12:01.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya perlu
Dialogue: 0,0:12:01.84,0:12:05.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menyingkirkan rasa paranoiaku ini.
Dialogue: 0,0:12:07.89,0:12:09.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Azuma.
Dialogue: 0,0:12:09.89,0:12:11.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau mampir sebentar ke toserba?
Dialogue: 0,0:12:11.31,0:12:12.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku agak lapar.
Dialogue: 0,0:12:12.52,0:12:14.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh saja,
Dialogue: 0,0:12:14.73,0:12:16.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi bakal ada banyak\Nteman sekelas kita yang ke sana.
Dialogue: 0,0:12:16.73,0:12:17.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu enggak keberatan dengan hal itu?
Dialogue: 0,0:12:18.19,0:12:22.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak apa-apa.\NAku sudah enggak keberatan sekarang.
Dialogue: 0,0:12:22.24,0:12:24.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau kamu merasa canggung,\Nlupakan saja.
Dialogue: 0,0:12:24.74,0:12:25.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:12:25.78,0:12:26.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:12:33.80,0:12:35.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awal bulan Desember.
Dialogue: 0,0:12:35.71,0:12:41.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gaya rambut anak mantan anggota klub bisbol\Nsudah enggak seperti dulu lagi.
Dialogue: 0,0:12:41.80,0:12:43.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin efek potongan cepak sebelumnya
Dialogue: 0,0:12:43.47,0:12:45.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membuat rambutku tumbuh sedikit\Nlebih keriting sekarang.
Dialogue: 0,0:12:45.10,0:12:46.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya enggak masalah?
Dialogue: 0,0:12:47.02,0:12:49.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepulang sekolah, murid kelas tiga
Dialogue: 0,0:12:49.10,0:12:55.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menikmati sisa waktu yang singkat\Nyang tersisa di sekolah ini.
Dialogue: 0,0:12:57.36,0:12:59.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, apa ini sudah setahun
Dialogue: 0,0:13:00.07,0:13:02.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semenjak pesta ayam goreng kita tahun lalu?
Dialogue: 0,0:13:02.74,0:13:04.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata begitu ya, nama pestanya.
Dialogue: 0,0:13:04.91,0:13:07.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak lama lagi kita bakal lulus.
Dialogue: 0,0:13:07.12,0:13:08.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak mau lulus.
Dialogue: 0,0:13:08.87,0:13:12.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya aku belum menikmati\Nmasa mudaku dengan pantas.
Dialogue: 0,0:13:12.13,0:13:13.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar banget.
Dialogue: 0,0:13:13.59,0:13:16.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya sudah hebat kamu bisa\Nbertahan tiga tahun di klub?
Dialogue: 0,0:13:16.25,0:13:18.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi prestasi sekolah kita kan payah.
Dialogue: 0,0:13:18.51,0:13:20.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bahkan enggak memenangkan\Nkejuaraan apa pun.
Dialogue: 0,0:13:20.63,0:13:25.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sekadar bisa kumpul bareng\Nsemuanya sepulang sekolah begini,
Dialogue: 0,0:13:25.56,0:13:28.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bersenda gurau dengan meme\Nvideo pendek favorit kita,
Dialogue: 0,0:13:28.43,0:13:33.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengarang bebas lirik lagu\Nyang sudah kita lupakan nadanya…
Dialogue: 0,0:13:33.86,0:13:37.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat menyukai momen-momen tersebut.
Dialogue: 0,0:13:38.07,0:13:39.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyatanya kita cuma melakukan hal-hal bodoh.
Dialogue: 0,0:13:40.07,0:13:43.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengucapkannya keras-keras malah\Nmembuatnya terasa makin sia-sia.
Dialogue: 0,0:13:43.70,0:13:45.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin begitu.
Dialogue: 0,0:13:45.53,0:13:46.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,
Dialogue: 0,0:13:46.54,0:13:47.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ayo kita…
Dialogue: 0,0:13:47.74,0:13:49.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ciptakan lebih banyak momen
Dialogue: 0,0:13:49.29,0:13:51.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang bisa menghibur kita!
Dialogue: 0,0:13:51.50,0:13:53.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan diberi penekanan seolah kamu\Nlagi syuting video musik, dong!
Dialogue: 0,0:13:54.42,0:13:56.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu…
Dialogue: 0,0:13:59.84,0:14:02.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asyik!
Dialogue: 0,0:14:03.13,0:14:05.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu butuh asupan gula sebelum mulai belajar.
Dialogue: 0,0:14:05.55,0:14:06.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar banget!
Dialogue: 0,0:14:06.97,0:14:08.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian semua mau lanjut belajar?
Dialogue: 0,0:14:08.85,0:14:10.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami bawa camilan yang persis sama.
Dialogue: 0,0:14:10.64,0:14:11.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah kalau begitu.
Dialogue: 0,0:14:12.06,0:14:14.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak ada kamusnya makan\Nginian terlalu banyak.
Dialogue: 0,0:14:16.44,0:14:18.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gomapon lucu banget, ya.
Dialogue: 0,0:14:18.94,0:14:20.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelas 7 lagi mengadakan pesta camilan.
Dialogue: 0,0:14:21.07,0:14:22.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita gabung dengan mereka!
Dialogue: 0,0:14:24.28,0:14:25.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bagaimana?
Dialogue: 0,0:14:25.74,0:14:27.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa ikut mampir sebentar.
Dialogue: 0,0:14:27.33,0:14:28.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tumben sekali kamu mau.
Dialogue: 0,0:14:28.74,0:14:31.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suzuki juga pasti ada di sana.
Dialogue: 0,0:14:31.75,0:14:32.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksud omonganmu?
Dialogue: 0,0:14:33.42,0:14:34.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau pergi bareng ke sana?
Dialogue: 0,0:14:35.17,0:14:36.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yamada juga pasti ada di sana.
Dialogue: 0,0:14:36.42,0:14:37.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau ikut.
Dialogue: 0,0:14:38.63,0:14:40.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku sekalian bawa ini saja.
Dialogue: 0,0:14:42.42,0:14:43.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izinkan kami ikut bergabung!
Dialogue: 0,0:14:43.55,0:14:44.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu anak Kelas 8.
Dialogue: 0,0:14:45.02,0:14:46.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang!
Dialogue: 0,0:14:47.18,0:14:48.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sini, gabung.
Dialogue: 0,0:14:48.68,0:14:49.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini untuk kalian.
Dialogue: 0,0:14:49.60,0:14:51.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bawa camilan lebih. Silakan diambil.
Dialogue: 0,0:14:51.18,0:14:52.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu yakin mau kasih?
Dialogue: 0,0:14:59.19,0:15:00.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok kamu bisa punya stok sebanyak itu?
Dialogue: 0,0:15:00.90,0:15:02.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma mengoleksinya
Dialogue: 0,0:15:02.24,0:15:03.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}demi mengumpulkan kemasannya saja,
Dialogue: 0,0:15:03.86,0:15:06.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi Nishi dan aku sudah enggak sanggup\Nmenghabiskan isinya lagi.
Dialogue: 0,0:15:06.53,0:15:08.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, jadi begitu ceritanya?
Dialogue: 0,0:15:08.45,0:15:10.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal isinya itulah\Nyang jadi hal utamanya, kan?
Dialogue: 0,0:15:10.83,0:15:12.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita perlu bawa kursi tambahan kemari.
Dialogue: 0,0:15:12.87,0:15:15.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ini dan yang ini.
Dialogue: 0,0:15:15.46,0:15:16.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serta yang ini.
Dialogue: 0,0:15:16.58,0:15:17.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ini juga lumayan enak.
Dialogue: 0,0:15:17.50,0:15:18.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dah.
Dialogue: 0,0:15:18.54,0:15:19.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misiku di sini sudah selesai.
Dialogue: 0,0:15:34.35,0:15:37.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadwalmu enggak bakal terganggu?
Dialogue: 0,0:15:37.27,0:15:40.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya kamu lagi buru-buru mau pergi?
Dialogue: 0,0:15:40.65,0:15:42.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak apa-apa.
Dialogue: 0,0:15:43.11,0:15:45.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kamu bawa itu?
Dialogue: 0,0:15:45.24,0:15:46.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kue keju berukuran mini.
Dialogue: 0,0:15:47.36,0:15:48.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau?
Dialogue: 0,0:15:48.41,0:15:49.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau!
Dialogue: 0,0:15:49.32,0:15:50.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat menikmati.
Dialogue: 0,0:15:50.33,0:15:51.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minta juga, dong!
Dialogue: 0,0:15:51.49,0:15:55.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini lezat banget! Teksturnya lembut banget.
Dialogue: 0,0:15:55.21,0:15:57.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaya akan cita rasa!
Dialogue: 0,0:15:57.46,0:16:00.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanan nomor satu yang pantang kamu\Ntemui di pos minum ajang maraton.
Dialogue: 0,0:16:00.59,0:16:04.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekali kamu tergiur,\Nkamu enggak bakal bisa berhenti memakannya.
Dialogue: 0,0:16:04.88,0:16:06.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ulasan makananmu itu payah banget.
Dialogue: 0,0:16:07.30,0:16:09.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat merindukan\Nkebersamaan seperti ini.
Dialogue: 0,0:16:09.68,0:16:12.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, kita juga sempat\Nmelakukannya tahun lalu, kan?
Dialogue: 0,0:16:12.10,0:16:14.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat momen pesta penutupan semester kedua.
Dialogue: 0,0:16:14.10,0:16:16.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, yang kita obrolkan kemarin itu.
Dialogue: 0,0:16:16.85,0:16:18.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang itu, ya?
Dialogue: 0,0:16:19.69,0:16:20.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pos minum…
Dialogue: 0,0:16:21.31,0:16:22.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu telat banget mencerna leluconnya.
Dialogue: 0,0:16:22.57,0:16:23.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keren!
Dialogue: 0,0:16:24.90,0:16:28.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba beri tahu kami, bagaimana kesanmu\Npada kue keju varian terbarunya?
Dialogue: 0,0:16:28.49,0:16:30.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menyodorkan mikrofon\Nabal-abal ke wajahku, dong.
Dialogue: 0,0:16:30.32,0:16:31.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menatap…
Dialogue: 0,0:16:31.66,0:16:32.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian enggak perlu\Nmenunggu jawabanku segala.
Dialogue: 0,0:16:33.08,0:16:34.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru kali ini aku melihat camilan\Nyang dimakan Watanabe itu.
Dialogue: 0,0:16:35.00,0:16:37.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini produk varian baru. Rasanya sangat unik.
Dialogue: 0,0:16:37.79,0:16:39.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata rasanya lumayan juga. Unik banget.
Dialogue: 0,0:16:39.92,0:16:41.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti apa rasanya?
Dialogue: 0,0:16:41.17,0:16:42.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini rasa stroberi?
Dialogue: 0,0:16:42.67,0:16:44.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini rasa daifuku stroberi.
Dialogue: 0,0:16:44.34,0:16:45.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daifuku rasa stroberi?
Dialogue: 0,0:16:45.63,0:16:47.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nishi, tawamu keras banget, tahu.
Dialogue: 0,0:16:48.01,0:16:50.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yamada pasti dapat rasa yang jelek.
Dialogue: 0,0:16:50.14,0:16:52.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya responsmu\Nbisa lebih heboh dari itu, dong.
Dialogue: 0,0:16:52.26,0:16:54.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, soalnya aku sama sekali\Nenggak tahu rasanya apa.
Dialogue: 0,0:16:54.47,0:16:56.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sensasi asamnya kurang nendang.
Dialogue: 0,0:16:56.18,0:16:59.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seringan basa-basinya Gomapon\Nsama ibu kantin.
Dialogue: 0,0:16:59.94,0:17:01.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, parah banget perumpamaannya!
Dialogue: 0,0:17:24.16,0:17:25.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:17:26.64,0:17:30.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, Taira baru saja ngechat aku.
Dialogue: 0,0:17:33.05,0:17:35.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia cuma ngabarin kalau mereka\Nlagi ngadain pesta camilan.
Dialogue: 0,0:17:35.43,0:17:37.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pesannya kurang jelas maksudnya apa, kan?
Dialogue: 0,0:17:37.89,0:17:39.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dia kasih kode supaya\Nkamu ikut pergi ke sana.
Dialogue: 0,0:17:39.31,0:17:41.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kan kamu juga bagian dari sirkel itu.
Dialogue: 0,0:17:41.48,0:17:42.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kita cek saja ke sana?
Dialogue: 0,0:17:43.61,0:17:44.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya enggak apa-apa?
Dialogue: 0,0:17:44.98,0:17:46.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya kita juga boleh\Nikutan gabung bareng mereka?
Dialogue: 0,0:17:46.94,0:17:48.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya sih boleh.
Dialogue: 0,0:17:48.11,0:17:50.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seriusan?
Dialogue: 0,0:17:50.28,0:17:51.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau kita datang dengan tangan kosong
Dialogue: 0,0:17:51.95,0:17:53.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu ikut menikmati camilan mereka…
Dialogue: 0,0:17:53.24,0:17:55.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya itu terkesan enggak tahu malu?
Dialogue: 0,0:17:55.49,0:17:56.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar enggak masalah, nih?
Dialogue: 0,0:17:57.04,0:17:59.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaan Azuma ini selalu parnoan, ya?
Dialogue: 0,0:18:00.16,0:18:01.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,
Dialogue: 0,0:18:02.25,0:18:04.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagaimana kalau kita membawa camilan sendiri?
Dialogue: 0,0:18:04.25,0:18:05.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kamu punya banyak stoknya!
Dialogue: 0,0:18:06.80,0:18:07.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo!
Dialogue: 0,0:18:07.96,0:18:09.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf mengganggu waktunya!
Dialogue: 0,0:18:09.13,0:18:10.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rame banget gerombolannya.
Dialogue: 0,0:18:10.26,0:18:12.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu Azuma dan Sato! Selamat datang.
Dialogue: 0,0:18:12.88,0:18:13.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami membawakan camilan.
Dialogue: 0,0:18:14.05,0:18:15.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak banget!
Dialogue: 0,0:18:15.51,0:18:16.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya kita harus bawa kursi tambahan lagi.
Dialogue: 0,0:18:17.22,0:18:20.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Suasananya makin ramai!\N- Silakan ambil saja kursinya lagi.
Dialogue: 0,0:18:21.27,0:18:22.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:18:22.94,0:18:24.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu lagi asyik, ya?
Dialogue: 0,0:18:25.11,0:18:26.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, ya.
Dialogue: 0,0:18:30.19,0:18:32.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa juga yang paham maksudmu\Nkalau ngechat begitu?
Dialogue: 0,0:18:32.20,0:18:33.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujung-ujungnya toh aku tetap datang ke mari.
Dialogue: 0,0:18:33.78,0:18:36.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, kupikir kamu sudah pulang duluan.
Dialogue: 0,0:18:36.83,0:18:38.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu sudah jadi sifat tsundere bawaanmu?
Dialogue: 0,0:18:39.91,0:18:40.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nishi.
Dialogue: 0,0:18:41.04,0:18:43.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah terima foto-foto\NFestival Olahraga dari Yamada.
Dialogue: 0,0:18:43.79,0:18:45.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak untuk fotonya.
Dialogue: 0,0:18:45.17,0:18:46.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hasil jepretanmu bagus banget.
Dialogue: 0,0:18:46.46,0:18:48.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu, kok.
Dialogue: 0,0:18:48.46,0:18:51.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lega kalau kamu menyukainya.
Dialogue: 0,0:18:51.09,0:18:53.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa sikap manismu itu cuma ditunjukkan\Npada karakter tertentu saja?
Dialogue: 0,0:18:54.38,0:18:55.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gapacho!
Dialogue: 0,0:18:55.43,0:18:56.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana dia?
Dialogue: 0,0:18:57.14,0:18:58.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah kabur.
Dialogue: 0,0:18:58.72,0:19:00.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gapacho itu memang langka banget\Nbuat ditemui.
Dialogue: 0,0:19:10.40,0:19:11.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan barusan itu?
Dialogue: 0,0:19:11.32,0:19:12.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku juga harus segera berangkat.
Dialogue: 0,0:19:12.65,0:19:13.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau ke bimbel?
Dialogue: 0,0:19:14.74,0:19:15.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat, ya.
Dialogue: 0,0:19:15.86,0:19:16.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat belajarnya!
Dialogue: 0,0:19:23.21,0:19:24.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yusuke.
Dialogue: 0,0:19:27.08,0:19:29.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, aku kasih sedikit bonus buatmu.
Dialogue: 0,0:19:30.21,0:19:32.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat asupan gula tambahan untuk tubuhmu.
Dialogue: 0,0:19:39.51,0:19:40.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, ya.
Dialogue: 0,0:19:54.99,0:19:56.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga harus pamit.
Dialogue: 0,0:19:56.78,0:19:58.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih ada seabrek rutinitas\Nyang harus aku kerjakan.
Dialogue: 0,0:19:58.66,0:20:00.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya aku juga segera balik.
Dialogue: 0,0:20:00.70,0:20:01.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, ya.
Dialogue: 0,0:20:02.12,0:20:03.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih buat camilannya.
Dialogue: 0,0:20:03.75,0:20:04.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai ketemu lagi.
Dialogue: 0,0:20:04.83,0:20:05.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suzuki.
Dialogue: 0,0:20:06.54,0:20:08.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami juga bakal segera pergi dari sini.
Dialogue: 0,0:20:08.92,0:20:10.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kelas bimbel.
Dialogue: 0,0:20:10.21,0:20:12.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar.
Dialogue: 0,0:20:12.55,0:20:14.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal masih ada ronde keduanya
Dialogue: 0,0:20:14.34,0:20:15.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}waktu tahun lalu.
Dialogue: 0,0:20:15.26,0:20:16.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ini memang enggak tertolong lagi.
Dialogue: 0,0:20:25.73,0:20:27.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal itu mengalir dengan sendirinya\Nseperti sebuah kewajaran.
Dialogue: 0,0:20:32.02,0:20:33.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sirkel pertemanan yang aneh namun misterius.
Dialogue: 0,0:20:33.69,0:20:34.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar banget.
Dialogue: 0,0:20:35.86,0:20:37.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu memang ikut les\Ndi tempat bimbel itu,
Dialogue: 0,0:20:37.74,0:20:40.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa kamu sering mampir ke restoran burger\Nyang lokasinya ada di gang belakang?
Dialogue: 0,0:20:40.03,0:20:42.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu sering nongkrong di sana.
Dialogue: 0,0:20:42.62,0:20:45.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya sudah lama kita\Nenggak pulang bareng berduaan begini, ya.
Dialogue: 0,0:20:45.29,0:20:46.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, nih.
Dialogue: 0,0:20:46.58,0:20:48.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya berjalan lancar, kan?
Dialogue: 0,0:20:48.62,0:20:50.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omonganmu kurang jelas maksudnya apa.
Dialogue: 0,0:20:51.33,0:20:53.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kue keju mininya lezat banget, ya.
Dialogue: 0,0:20:53.59,0:20:54.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan?
Dialogue: 0,0:20:55.26,0:20:58.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa aku merasa\Nsangat bahagia saat ini.
Dialogue: 0,0:20:58.30,0:20:59.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kalau begitu.
Dialogue: 0,0:21:05.02,0:21:07.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya aku harus mulai\Nnyetok camilan juga, deh.
Dialogue: 0,0:21:08.02,0:21:10.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, setuju. Kerjaanmu kan selalu\Nnumpang makan camilan orang lain.
Dialogue: 0,0:21:11.23,0:21:13.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau mampir ke suatu tempat\Nsebelum pulang ke rumah hari ini?
Dialogue: 0,0:21:16.32,0:21:18.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukanlah ajang yang bergelar,
Dialogue: 0,0:21:18.99,0:21:21.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ataupun kegiatan yang bakal\Nmemberikanmu semacam penghargaan.
Dialogue: 0,0:21:21.99,0:21:24.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Momen yang membosankan dan\Nkelihatannya tak berguna ini
Dialogue: 0,0:21:24.28,0:21:26.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terkadang justru mampu memberikan\Nwarna tersendiri pada batinmu.
Dialogue: 0,0:21:26.66,0:21:30.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepercik kebahagiaan kecil\Nyang baru bisa kamu rasakan
Dialogue: 0,0:21:30.75,0:21:34.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di saat hatimu sedang merasa lapang.
Dialogue: 0,0:21:35.21,0:21:38.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, jadi Tani pada akhirnya membulatkan\Ntekad buat masuk Universitas Nijigaoka, ya?
Dialogue: 0,0:21:38.47,0:21:39.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:21:39.38,0:21:43.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau benar begitu, otomatis kamu\Nbakal LDR-an pas masa kuliah nanti.
Dialogue: 0,0:21:43.14,0:21:45.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, benar.
Dialogue: 0,0:21:46.35,0:21:49.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kami harus berusaha memperjuangkannya.
Dialogue: 0,0:21:49.10,0:21:51.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuharap semua pengorbanannya membuahkan hasil\Nhingga ia diterima di kampus yang ia idam-idamkan.
Dialogue: 0,0:21:51.73,0:21:52.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tegar banget, ya.
Dialogue: 0,0:21:52.98,0:21:54.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak juga, kok.
Dialogue: 0,0:21:54.19,0:21:56.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru Tani yang jauh lebih tegar.
Dialogue: 0,0:21:56.98,0:21:59.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin karena dia sudah memantapkan\Npilihannya dan enggak bakal goyah lagi,
Dialogue: 0,0:21:59.95,0:22:02.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sekarang dia malah belajar\Njauh lebih keras dari sebelumnya.
Dialogue: 0,0:22:02.61,0:22:05.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya aku terkejut\Nsaat melihatnya muncul hari ini.
Dialogue: 0,0:22:07.33,0:22:09.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gimana bilangnya, ya?
Dialogue: 0,0:22:09.37,0:22:12.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sangat memforsir dirinya sendiri\Nsampai-sampai rasanya sangat mengkhawatirkan.
