Dialogue: 0,0:05:15.23,0:05:16.06,sign,,0000,0000,0000,,LEGA
Dialogue: 0,0:07:06.55,0:07:07.96,sign,,0000,0000,0000,,PUSTAKAWAN KELAS SATU
Dialogue: 0,0:07:10.05,0:07:11.51,sign,,0000,0000,0000,,"BERJALAN PULANG BERSAMA SAAT SEPI"
Dialogue: 0,0:07:55.51,0:07:56.93,sign,,0000,0000,0000,,"NISHI KE KANAN, YAMADA KE KIRI"
Dialogue: 0,0:08:56.07,0:08:58.57,sign,,0000,0000,0000,,"KUE SUS LEZAT"
Dialogue: 0,0:10:42.68,0:10:46.97,sign,,0000,0000,0000,,APA DIA BAKAL KECEWA PADAKU NANTINYA?
Dialogue: 0,0:11:28.93,0:11:30.85,sign,,0000,0000,0000,,"AKU SALAH TINGKAH…"
Dialogue: 0,0:11:54.71,0:11:56.17,sign,,0000,0000,0000,,"KAYAKNYA AKU PERNAH BILANG BEGINI SEBELUMNYA…"
Dialogue: 0,0:12:06.22,0:12:09.56,sign,,0000,0000,0000,,"ENGGAK PERLU MENCEMASKAN REAKSIKU"
Dialogue: 0,0:12:28.74,0:12:30.37,sign,,0000,0000,0000,,"BERGUMAM"
Dialogue: 0,0:12:54.14,0:12:55.77,sign,,0000,0000,0000,,"MEMELUK ERAT"
Dialogue: 0,0:13:51.70,0:13:52.74,sign,,0000,0000,0000,,SEMENTARA ITU, DI TEMPAT LAIN
Dialogue: 0,0:14:05.35,0:14:07.35,sign,,0000,0000,0000,,"PILIHAN TANI: UNIV NEGERI SHIRAHAMA"
Dialogue: 0,0:14:07.43,0:14:09.39,sign,,0000,0000,0000,,"PILIHAN SUZUKI: UNIV SWASTA KUMANEKO"
Dialogue: 0,0:14:31.08,0:14:32.12,sign,,0000,0000,0000,,"LEBIH ENAK DUDUK BERSIMPUH, KAN!"
Dialogue: 0,0:14:32.21,0:14:34.62,sign,,0000,0000,0000,,"KURSI NENEK"
Dialogue: 0,0:14:52.93,0:14:53.94,sign,,0000,0000,0000,,MEMELUK ERAT
Dialogue: 0,0:14:54.23,0:14:57.02,sign,,0000,0000,0000,,BERSENANDUNG…
Dialogue: 0,0:14:57.11,0:14:57.94,sign,,0000,0000,0000,,"AHHH…"
Dialogue: 0,0:15:02.61,0:15:05.11,sign,,0000,0000,0000,,JANTUNG BERDEBAR
Dialogue: 0,0:15:06.11,0:15:06.95,sign,,0000,0000,0000,,BUK
Dialogue: 0,0:15:07.41,0:15:09.37,sign,,0000,0000,0000,,"HIDUNGKU…"
Dialogue: 0,0:15:11.70,0:15:14.12,sign,,0000,0000,0000,,"HARGA DIRI TINGGI"
Dialogue: 0,0:15:16.88,0:15:18.34,sign,,0000,0000,0000,,MELOTOT
Dialogue: 0,0:15:23.34,0:15:24.80,sign,,0000,0000,0000,,"BINGUNG…"
Dialogue: 0,0:15:33.35,0:15:35.89,sign,,0000,0000,0000,,"UNIVERSITAS SHIRAHAMA"
Dialogue: 0,0:17:01.69,0:17:02.77,sign,,0000,0000,0000,,"KETUK…"
Dialogue: 0,0:17:14.70,0:17:16.32,sign,,0000,0000,0000,,TAMAT
Dialogue: 0,0:17:21.46,0:17:23.17,sign,,0000,0000,0000,,"KEMBALI BELAJAR"
Dialogue: 0,0:17:27.05,0:17:28.97,sign,,0000,0000,0000,,"MEMIKIRKAN UNIVERSITAS NIJIGAOKA"
Dialogue: 0,0:17:34.64,0:17:37.89,sign,,0000,0000,0000,,"AKU BAKAL MASUK UNIV SHIRAHAMA!"
Dialogue: 0,0:18:02.71,0:18:04.38,sign,,0000,0000,0000,,INGIN PULANG BERSAMA
Dialogue: 0,0:18:04.46,0:18:06.59,sign,,0000,0000,0000,,INGIN MENGOBROL SEBENTAR
Dialogue: 0,0:18:06.80,0:18:09.13,sign,,0000,0000,0000,,TERKADANG INGIN BELAJAR BERSAMA\NPAS AKHIR PEKAN
Dialogue: 0,0:20:47.83,0:20:50.75,sign,,0000,0000,0000,,"TANGIS PECAH"
Dialogue: 0,0:21:17.53,0:21:19.86,sign,,0000,0000,0000,,"KETAKUTAN"
Dialogue: 0,0:22:18.26,0:22:19.17,sign,,0000,0000,0000,,"MURAM"
Dialogue: 0,0:22:19.26,0:22:20.09,sign,,0000,0000,0000,,ASTAGA
Dialogue: 0,0:00:06.73,0:00:08.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warna merah terlalu mencolok buatmu.
Dialogue: 0,0:00:08.77,0:00:10.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warna biru air lebih cocok.
Dialogue: 0,0:00:12.48,0:00:14.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu rupanya.
Dialogue: 0,0:00:15.24,0:00:16.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:00:16.95,0:00:18.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai saat ini...
Dialogue: 0,0:00:21.12,0:00:22.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bagus.
Dialogue: 0,0:00:23.37,0:00:24.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:00:26.92,0:00:29.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah warna merah itu pilihan standar?
Dialogue: 0,0:00:29.17,0:00:30.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bakal cepat bosan dengan warna unik.
Dialogue: 0,0:00:30.96,0:00:31.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak masalah, kan?
Dialogue: 0,0:00:32.67,0:00:33.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak apa-apa.
Dialogue: 0,0:00:33.96,0:00:35.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, kan?
Dialogue: 0,0:00:35.59,0:00:38.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu membiarkan\Norang lain memilihkan untukku.
Dialogue: 0,0:00:40.26,0:00:41.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga, di bidang ilmu sosial,
Dialogue: 0,0:00:41.85,0:00:46.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jurusan Ekonomi atau Bisnis punya\Ntingkat serapan kerja yang lebih tinggi.
Dialogue: 0,0:00:46.52,0:00:48.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pilihan ini jelas lebih aman.
Dialogue: 0,0:00:49.06,0:00:50.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, kan?
Dialogue: 0,0:00:51.11,0:00:53.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, kan? Bukan cuma nama kampusnya.
Dialogue: 0,0:00:53.48,0:00:55.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jurusan juga sangat memengaruhi kariermu.
Dialogue: 0,0:00:55.86,0:00:58.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa cemas,\Njadi aku mengecek tingkat serapan kerjanya.
Dialogue: 0,0:00:58.72,0:01:00.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Bahkan sampai sekarang,\N- Ekonomi dan Bisnis.
Dialogue: 0,0:01:00.32,0:01:02.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- aku...\N- Kamu bisa mendaftar keduanya, kan?
Dialogue: 0,0:01:02.95,0:01:05.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}masih belum benar-benar berubah.
Dialogue: 0,0:01:21.22,0:01:30.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}You and I Are Polar Opposites\NSeason 2
Dialogue: 0,0:02:37.98,0:02:38.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nishi.
Dialogue: 0,0:02:39.78,0:02:42.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah menentukan pilihan kampusmu?
Dialogue: 0,0:02:42.53,0:02:44.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini...
Dialogue: 0,0:02:44.53,0:02:47.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum mendapat izin\Nuntuk masuk jurusan yang aku mau.
Dialogue: 0,0:02:47.95,0:02:50.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu butuh izin untuk itu?
Dialogue: 0,0:02:50.37,0:02:52.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sempat membahasnya sedikit kemarin.
Dialogue: 0,0:02:52.62,0:02:54.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah menyampaikan\Nsemua yang ingin kamu utarakan?
Dialogue: 0,0:02:54.17,0:02:55.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa begitu.
Dialogue: 0,0:02:56.46,0:02:58.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kalau begitu.
Dialogue: 0,0:02:58.42,0:03:02.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sendiri enggak yakin apakah "syukurlah"\Nadalah tanggapan yang tepat.
Dialogue: 0,0:03:03.26,0:03:04.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:03:05.30,0:03:06.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemarin...
Dialogue: 0,0:03:06.68,0:03:08.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekonomi dan Bisnis.
Dialogue: 0,0:03:08.47,0:03:10.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa mendaftar di keduanya, kan?
Dialogue: 0,0:03:11.64,0:03:15.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa kusadari, sepertinya jurusanku\Nsudah ditentukan secara sepihak.
Dialogue: 0,0:03:16.06,0:03:18.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya kamu mencari tahu sendiri.
Dialogue: 0,0:03:19.03,0:03:22.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu belum perlu mencemaskan hal itu.
Dialogue: 0,0:03:22.20,0:03:23.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, justru ini bagian yang terpenting.
Dialogue: 0,0:03:23.82,0:03:25.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu.
Dialogue: 0,0:03:25.12,0:03:26.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:03:28.45,0:03:30.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}masih belum memutuskan pilihanku.
Dialogue: 0,0:03:31.50,0:03:32.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitukah?
Dialogue: 0,0:03:32.58,0:03:34.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya ini sudah agak terlambat?\NKamu enggak masalah?
Dialogue: 0,0:03:35.17,0:03:37.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah pernah membahas ini.
Dialogue: 0,0:03:37.25,0:03:39.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu masih ragu?
Dialogue: 0,0:03:42.22,0:03:44.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin masuk jurusan Sastra.
Dialogue: 0,0:03:45.30,0:03:47.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak mengatakan hal yang aneh, kan?
Dialogue: 0,0:03:48.05,0:03:50.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku jadi sangat gugup?
Dialogue: 0,0:03:51.14,0:03:54.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa karena aku takut pendapatku ditolak?
Dialogue: 0,0:03:55.27,0:03:59.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu jauh lebih baik daripada jurusan\Nbernama aneh yang belum pernah kudengar...
Dialogue: 0,0:04:00.53,0:04:01.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, deh.
Dialogue: 0,0:04:01.69,0:04:03.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu mencari "jurusan Sastra",
Dialogue: 0,0:04:03.36,0:04:05.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hasil "sulit dapat kerja" langsung muncul.
Dialogue: 0,0:04:05.82,0:04:07.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya, kamu akan masuk kuliah.
Dialogue: 0,0:04:07.49,0:04:09.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kamu benci\Nmerasa kesusahan nantinya?
Dialogue: 0,0:04:09.70,0:04:12.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu belum punya tujuan yang spesifik,
Dialogue: 0,0:04:12.50,0:04:14.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukankah lebih baik memilih\Njurusan yang sudah pasti aman?
Dialogue: 0,0:04:14.87,0:04:16.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana menurutmu?
Dialogue: 0,0:04:18.25,0:04:19.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya ucapanmu itu masuk akal.
Dialogue: 0,0:04:20.63,0:04:23.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa jurusan Ekonomi lebih baik.
Dialogue: 0,0:04:23.88,0:04:26.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu, tapi...
Dialogue: 0,0:04:43.11,0:04:44.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat ingin belajar Sastra.
Dialogue: 0,0:04:45.15,0:04:47.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat membayangkan diriku belajar di sana,
Dialogue: 0,0:04:47.95,0:04:49.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hal itulah yang paling membuatku antusias.
Dialogue: 0,0:04:50.53,0:04:51.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Antusias...
Dialogue: 0,0:04:53.12,0:04:54.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memilih jurusan itu\Nhanya untuk bersenang-senang saja?
Dialogue: 0,0:04:54.96,0:04:56.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah paham kamu ingin menikmati masa kuliah,
Dialogue: 0,0:04:56.75,0:04:58.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi menjadikan itu sebagai\Ntujuan utama rasanya agak...
Dialogue: 0,0:04:58.67,0:04:59.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, bukan begitu maksudku.
Dialogue: 0,0:05:00.21,0:05:01.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:05:01.88,0:05:04.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Natsumi sudah bilang begitu,
Dialogue: 0,0:05:04.09,0:05:07.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kenapa kamu enggak mencoba\Nmendaftar untuk keduanya saja?
Dialogue: 0,0:05:08.26,0:05:11.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:05:11.89,0:05:13.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana, Natsumi?
Dialogue: 0,0:05:14.22,0:05:15.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah...
Dialogue: 0,0:05:19.98,0:05:22.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, Ayah mengerti.
Dialogue: 0,0:05:22.36,0:05:25.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah enggak akan memaksamu lagi.
Dialogue: 0,0:05:25.32,0:05:26.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terserah padamu saja.
Dialogue: 0,0:05:34.58,0:05:37.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah bilang terserah padamu.\NItu pertanda bagus.
Dialogue: 0,0:05:38.08,0:05:41.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, apa aku baru saja mendapatkan izinku?
Dialogue: 0,0:05:43.04,0:05:44.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bagaimana aku harus menjelaskannya?
Dialogue: 0,0:05:45.84,0:05:48.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sama sekali enggak merasa\Nmendapat restu sepenuhnya.
Dialogue: 0,0:05:48.76,0:05:50.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa memang begitu.
Dialogue: 0,0:05:50.64,0:05:53.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula,\Nsekalipun kamu masuk jurusan Ekonomi,
Dialogue: 0,0:05:53.39,0:05:55.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu enggak serta-merta\Nmenjaminmu mudah dapat kerja.
Dialogue: 0,0:05:55.85,0:05:57.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan belajar ilmu Sastra bukan berarti
Dialogue: 0,0:05:57.27,0:06:00.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semua orang harus mengincar\Nkarier yang linier dengan jurusannya.
Dialogue: 0,0:06:00.60,0:06:01.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya apa salahnya dengan itu?
Dialogue: 0,0:06:02.77,0:06:04.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu rupanya.
Dialogue: 0,0:06:04.90,0:06:07.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seandainya aku bisa menjawab selugas itu,
Dialogue: 0,0:06:07.61,0:06:10.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin ayahku akan lebih mudah menerimanya.
Dialogue: 0,0:06:10.74,0:06:11.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:06:12.16,0:06:14.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pada akhirnya, jika kamu sudah bisa mengikuti\Nkata hatimu sendiri,
Dialogue: 0,0:06:14.74,0:06:16.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukankah itu terasa melegakan?
Dialogue: 0,0:06:16.12,0:06:17.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tumbuhkanlah rasa percaya dirimu sedikit.
Dialogue: 0,0:06:17.95,0:06:19.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata hatiku...
Dialogue: 0,0:06:21.71,0:06:23.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya,
Dialogue: 0,0:06:24.50,0:06:27.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tujuanku akhirnya menjadi lebih jelas.
Dialogue: 0,0:06:29.26,0:06:31.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelumnya, aku pasti akan langsung menurut,
Dialogue: 0,0:06:31.47,0:06:34.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bilang, "Kurasa begitu,"\Ndan pasrah mengikuti kemauan mereka.
Dialogue: 0,0:06:35.47,0:06:38.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa mengutarakan perasaanku\Nyang sejujurnya saja,
Dialogue: 0,0:06:39.18,0:06:40.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu sudah menjadi suatu perubahan besar.
Dialogue: 0,0:06:41.85,0:06:43.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa kamu benar.
Dialogue: 0,0:06:53.78,0:06:54.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sia-sia saja.
Dialogue: 0,0:06:55.24,0:06:58.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak bisa tenang.\NAku sama sekali enggak bisa fokus.
Dialogue: 0,0:07:01.54,0:07:03.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah berjuang keras.
Dialogue: 0,0:07:04.21,0:07:06.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa dengan mereka berdua?
Dialogue: 0,0:07:08.59,0:07:09.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesi belajar yang sangat produktif.
Dialogue: 0,0:07:10.05,0:07:11.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah membuatmu menunggu lama.
Dialogue: 0,0:07:11.59,0:07:12.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak sama sekali, kok.
Dialogue: 0,0:07:12.59,0:07:15.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menunggumu karena aku yang mau.
Dialogue: 0,0:07:16.93,0:07:18.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga begitu.
Dialogue: 0,0:07:18.77,0:07:21.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya, aku justru lebih\Ningin cepat bertemu denganmu.
Dialogue: 0,0:07:21.56,0:07:22.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh?
Dialogue: 0,0:07:23.06,0:07:24.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suaraku terlalu kencang tadi. Maaf.
Dialogue: 0,0:07:24.65,0:07:26.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu mengejutkan buatmu?
Dialogue: 0,0:07:26.40,0:07:28.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, hanya saja...
Dialogue: 0,0:07:28.90,0:07:30.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belakangan ini kita jadi jarang bertemu,
Dialogue: 0,0:07:30.78,0:07:32.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku juga enggak mau\Nterus-terusan mengganggumu lewat pesan.
Dialogue: 0,0:07:32.65,0:07:35.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, aku enggak bisa memberimu\Nnasihat berguna soal ujian.
Dialogue: 0,0:07:35.62,0:07:40.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya aku takut dicampakkan\Nkarena bersikap terlalu merepotkan.
Dialogue: 0,0:07:41.50,0:07:43.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata pikiranmu sampai sejauh itu?
Dialogue: 0,0:07:43.29,0:07:45.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak pernah memikirkan\Nhal itu sama sekali.
Dialogue: 0,0:07:45.54,0:07:46.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:07:46.54,0:07:47.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku,
Dialogue: 0,0:07:47.75,0:07:50.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa kamu pernah berpikiran negatif juga?
Dialogue: 0,0:07:50.42,0:07:52.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya kamu pikir aku ini siapa?
Dialogue: 0,0:07:55.51,0:07:56.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah sampai.
Dialogue: 0,0:07:57.93,0:07:59.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat sekali, ya.
Dialogue: 0,0:08:00.56,0:08:01.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:08:01.47,0:08:03.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa di sekolah hari Senin?
Dialogue: 0,0:08:03.89,0:08:05.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga belajarmu lancar, ya.
Dialogue: 0,0:08:05.65,0:08:06.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan berusaha.
Dialogue: 0,0:08:10.03,0:08:11.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu aku harus berjuang keras sekarang,
Dialogue: 0,0:08:15.28,0:08:17.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi hatiku terasa sangat berat.
Dialogue: 0,0:08:20.74,0:08:22.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kentaro.
Dialogue: 0,0:08:24.12,0:08:26.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin bersamamu sedikit lebih lama lagi.
Dialogue: 0,0:08:29.42,0:08:33.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa ini baru pertama kalinya aku memborong\Ncamilan sebanyak ini di toserba.
Dialogue: 0,0:08:33.59,0:08:34.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh?
Dialogue: 0,0:08:34.66,0:08:36.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak menyangka\Nrasanya bakal seseru ini.
Dialogue: 0,0:08:40.85,0:08:42.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:08:42.77,0:08:44.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumahku sedang kosong.
Dialogue: 0,0:08:44.56,0:08:45.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetap harus mengucap permisi.
Dialogue: 0,0:08:46.39,0:08:48.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku kunci pintunya, ya.
Dialogue: 0,0:08:48.31,0:08:49.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:08:52.82,0:08:53.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemarilah.
Dialogue: 0,0:08:56.07,0:08:58.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahu enggak, kadang-kadang
Dialogue: 0,0:08:59.07,0:09:00.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu itu kelihatan sangat berpengalaman.
Dialogue: 0,0:09:00.70,0:09:02.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ya cara mengatakannya?
Dialogue: 0,0:09:02.41,0:09:05.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu, siapa yang lebih dulu\Nmenciumku di luar waktu itu?
Dialogue: 0,0:09:05.46,0:09:07.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mengungkit kejadian itu lagi.
Dialogue: 0,0:09:07.96,0:09:09.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bakal terus mengungkitnya.
Dialogue: 0,0:09:17.97,0:09:19.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah terbiasa sekarang?
Dialogue: 0,0:09:20.93,0:09:23.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah apa aku sudah terbiasa atau belum,
Dialogue: 0,0:09:23.93,0:09:26.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku tetap saja merasa deg-degan.
Dialogue: 0,0:09:28.06,0:09:29.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanginya seperti wangimu, Kentaro.
Dialogue: 0,0:09:30.69,0:09:31.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanginya enggak enak, ya?
Dialogue: 0,0:09:32.11,0:09:33.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan malah tertawa.
Dialogue: 0,0:09:33.69,0:09:35.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak apa-apa, kok.
Dialogue: 0,0:09:48.29,0:09:49.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:09:53.34,0:09:54.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agak aneh rasanya.
Dialogue: 0,0:09:59.80,0:10:01.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Kentaro...
Dialogue: 0,0:10:02.85,0:10:06.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ingin melangkah sejauh ini?
Dialogue: 0,0:10:06.93,0:10:10.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Denganku? Rasanya kok agak aneh.
Dialogue: 0,0:10:14.52,0:10:15.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu enggak suka, ya?
Dialogue: 0,0:10:16.94,0:10:21.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya aku enggak suka, sih.
Dialogue: 0,0:10:21.41,0:10:22.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma merasa kurang yakin.
Dialogue: 0,0:10:23.45,0:10:24.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama ini,
Dialogue: 0,0:10:24.74,0:10:26.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku selalu menolaknya kalau\Naku memang enggak berniat,
Dialogue: 0,0:10:26.95,0:10:29.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ujung-ujungnya aku malah\Nmenyesali penolakanku sendiri,
Dialogue: 0,0:10:29.54,0:10:32.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu jadi bersikap terburu-buru.
Dialogue: 0,0:10:33.13,0:10:37.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku menolaknya lagi kali ini,\Napa yang bakal dia pikirkan tentangku?
Dialogue: 0,0:10:38.34,0:10:41.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana pandangannya terhadapku nantinya?
Dialogue: 0,0:10:47.97,0:10:49.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak apa-apa, kok.
Dialogue: 0,0:10:50.89,0:10:55.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku mengiyakannya,\Napa kamu bakal jadi lebih menyukaiku?
Dialogue: 0,0:10:58.53,0:11:01.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sebenarnya ingin kamu lakukan?
Dialogue: 0,0:11:18.51,0:11:19.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hampir saja!
Dialogue: 0,0:11:19.76,0:11:21.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku nyaris berhenti berpikir jernih tadi.
Dialogue: 0,0:11:21.59,0:11:22.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini terlalu rumit!
Dialogue: 0,0:11:22.51,0:11:24.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawaban macam apa itu tadi?
Dialogue: 0,0:11:24.76,0:11:28.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pikir ketertarikanku padamu bakal luntur\Nkalau kita enggak melakukannya?
Dialogue: 0,0:11:28.93,0:11:30.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:11:30.93,0:11:32.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, hanya saja...
Dialogue: 0,0:11:32.77,0:11:35.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya aku yang minta maaf.
Dialogue: 0,0:11:35.86,0:11:39.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengatakan itu bukan\Nkarena aku ragu padamu.
Dialogue: 0,0:11:39.94,0:11:42.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya hanya kurang tepat saja.
Dialogue: 0,0:11:42.40,0:11:43.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bahkan enggak yakin\Ndengan perasaanku sendiri.
Dialogue: 0,0:11:43.78,0:11:46.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terus-menerus memikirkan\Njawaban yang paling tepat,
Dialogue: 0,0:11:47.49,0:11:50.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}makanya kupikir lebih baik aku\Nmembiarkanmu yang mengambil keputusan.
Dialogue: 0,0:11:50.95,0:11:52.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ini...
Dialogue: 0,0:11:52.66,0:11:53.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengarkan aku baik-baik.
Dialogue: 0,0:11:53.67,0:11:54.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak pernah menuntutmu
Dialogue: 0,0:11:54.71,0:11:56.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk selalu memilih jawaban yang paling benar.
Dialogue: 0,0:11:57.17,0:12:00.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bertanya kepadamu karena aku ingin\Nmendengar isi hatimu yang sejujurnya.
Dialogue: 0,0:12:00.13,0:12:00.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesederhana itu.
Dialogue: 0,0:12:01.05,0:12:02.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh, sesederhana itu saja.
Dialogue: 0,0:12:03.09,0:12:05.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sama sekali enggak perlu\Nmencemaskan reaksiku.
Dialogue: 0,0:12:06.22,0:12:09.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu enggak perlu mencemaskan reaksiku.
Dialogue: 0,0:12:11.22,0:12:15.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar. Aku memang selalu seperti ini.
Dialogue: 0,0:12:15.23,0:12:17.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setiap kali aku merasa ragu\Ndengan pendirianku sendiri,
Dialogue: 0,0:12:17.61,0:12:20.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku selalu menjadikan reaksi orang\Nlain sebagai patokan jawabanku.
Dialogue: 0,0:12:20.86,0:12:23.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama ini aku selalu berpura-pura\Nmenjadi gadis yang penurut,
Dialogue: 0,0:12:23.70,0:12:27.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sebenarnya aku hanya takut\Nmengambil keputusan sendiri.
Dialogue: 0,0:12:28.74,0:12:30.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyedihkan sekali diriku ini.
Dialogue: 0,0:12:31.33,0:12:32.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kentaro.
Dialogue: 0,0:12:33.08,0:12:33.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya?
Dialogue: 0,0:12:34.58,0:12:36.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa sekarang belum saat yang tepat.
Dialogue: 0,0:12:37.75,0:12:38.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:12:40.00,0:12:41.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ketahuilah aku sangat menyukaimu.
Dialogue: 0,0:12:42.63,0:12:44.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh. Karena aku sangat menyukaimu,
Dialogue: 0,0:12:44.47,0:12:46.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ingin kamu memercayaiku.
Dialogue: 0,0:12:46.59,0:12:47.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:12:47.76,0:12:48.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu...
Dialogue: 0,0:12:49.51,0:12:51.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terima kasih karena sudah selalu menyukaiku.
Dialogue: 0,0:12:54.14,0:12:55.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa merasakannya?
Dialogue: 0,0:12:57.35,0:12:59.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang bukan tandingannya.
Dialogue: 0,0:13:00.65,0:13:04.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kentaro, terima kasih banyak untuk hari ini.
Dialogue: 0,0:13:04.11,0:13:06.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, seharusnya aku yang berterima kasih.
Dialogue: 0,0:13:06.20,0:13:08.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bakal terus berjuang keras mulai besok.
Dialogue: 0,0:13:08.45,0:13:11.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terlalu memaksakan dirimu.\NBerjuanglah sewajarnya saja.
Dialogue: 0,0:13:11.58,0:13:12.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saranmu itu sangat kontradiktif, tahu.
Dialogue: 0,0:13:14.70,0:13:17.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sebenarnya\Nmembuatku resah selama ini?
Dialogue: 0,0:13:17.37,0:13:19.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa aku mulai memahaminya sekarang.
Dialogue: 0,0:13:20.38,0:13:24.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa resah bukan karena\Npendapatku enggak diindahkan.
Dialogue: 0,0:13:24.13,0:13:28.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya aku merasa resah karena aku\Nenggak yakin dengan pendirianku sendiri.
Dialogue: 0,0:13:29.89,0:13:36.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menumbuhkan keyakinan kalau\Nakulah yang menentukan pilihanku sendiri.
Dialogue: 0,0:13:37.98,0:13:41.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu-satunya pihak\Nyang ingin kuyakinkan saat ini,
Dialogue: 0,0:13:41.57,0:13:43.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pihak yang ingin kubuktikan,
Dialogue: 0,0:13:43.94,0:13:47.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukanlah orang tuaku,\Nmelainkan diriku sendiri.
Dialogue: 0,0:13:48.70,0:13:49.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pasti bisa melakukannya.
Dialogue: 0,0:13:58.63,0:14:00.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Suzuki Miyu,
Dialogue: 0,0:14:00.59,0:14:02.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}siswi SMA kelas 3 yang saat ini tengah\Nsibuk bersiap menghadapi ujian masuk.
Dialogue: 0,0:14:03.39,0:14:05.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi bisa menikmati kehidupan kampus
Dialogue: 0,0:14:05.35,0:14:07.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bersama pacarku tercinta, Yusuke,
Dialogue: 0,0:14:07.43,0:14:09.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sedang berjuang sekuat tenaga!
Dialogue: 0,0:14:09.47,0:14:11.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarpun begitu,
Dialogue: 0,0:14:12.52,0:14:14.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tetap rindu ingin\Nmenghabiskan waktu dengannya sesekali.
Dialogue: 0,0:14:15.36,0:14:17.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, kami memutuskan untuk mengadakan\Nsesi belajar bersama hari ini.
Dialogue: 0,0:14:18.44,0:14:20.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau dengan cara yang sedikit\Nenggak lazim, sih.
Dialogue: 0,0:14:26.99,0:14:28.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya istirahat sejenak.
Dialogue: 0,0:14:28.74,0:14:30.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belajar pakai meja pendek\Nbegini pasti bikin pegal, kan?
Dialogue: 0,0:14:31.08,0:14:32.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak masalah, kok.
Dialogue: 0,0:14:32.21,0:14:34.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kursi pinjaman dari Nenek ini sangat nyaman.
Dialogue: 0,0:14:35.13,0:14:37.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara rintik hujan dari luar\Nterdengar menenangkan.
Dialogue: 0,0:14:37.38,0:14:38.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suaranya sangat membantuku\Nlebih fokus belajar.
Dialogue: 0,0:14:38.67,0:14:41.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seandainya saja kita bisa tetap belajar\Nbareng di ruang tamu seperti biasanya.
Dialogue: 0,0:14:41.97,0:14:44.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya hari ini semua anggota\Nkeluargaku lagi di rumah.
Dialogue: 0,0:14:44.13,0:14:47.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak apa-apa.\NLagi pula itu cuma permintaan egoisku belaka.
Dialogue: 0,0:14:47.89,0:14:49.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh aku pindah duduk ke sebelahmu?
Dialogue: 0,0:14:49.60,0:14:50.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja boleh.
Dialogue: 0,0:14:51.06,0:14:52.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asyik!
Dialogue: 0,0:15:05.20,0:15:06.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan ini!
Dialogue: 0,0:15:07.41,0:15:09.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, maaf ya.
Dialogue: 0,0:15:09.83,0:15:11.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sampai menangis begitu.
Dialogue: 0,0:15:11.70,0:15:14.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini cuma air mata refleks gara-gara terbentur, tahu.
Dialogue: 0,0:15:18.96,0:15:21.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Universitas Nijigaoka?
Dialogue: 0,0:15:21.88,0:15:22.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini...
Dialogue: 0,0:15:23.34,0:15:24.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu lokasinya di sebelah mana, ya?
Dialogue: 0,0:15:26.30,0:15:28.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu nama universitas yang\Nada di Prefektur Ibaraki.
Dialogue: 0,0:15:29.01,0:15:29.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lokasinya jauh banget.
Dialogue: 0,0:15:30.35,0:15:31.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kampus swasta?
Dialogue: 0,0:15:31.68,0:15:32.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kampus negeri.
Dialogue: 0,0:15:33.35,0:15:35.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kan berniat masuk Universitas Shirahama?
Dialogue: 0,0:15:36.81,0:15:37.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu jadi berniat mendaftar ke sana?
Dialogue: 0,0:15:38.86,0:15:39.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak jadi.
Dialogue: 0,0:15:40.36,0:15:43.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang sempat mempertimbangkannya,\Ntapi aku sudah menyerah.
Dialogue: 0,0:15:45.15,0:15:46.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu serius?
Dialogue: 0,0:15:48.20,0:15:50.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toh aku masih bisa mendapatkan\Nsertifikasi guru di Universitas Shirahama.
Dialogue: 0,0:15:50.95,0:15:53.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah aku bisa ambil kelas mata kuliah\Ndi bidang lain juga di sana.
Dialogue: 0,0:15:53.58,0:15:55.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa itu bakal sangat\Nmembantu memperluas wawasanku.
Dialogue: 0,0:15:55.66,0:15:57.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dilihat dari kelebihannya,\Nitu sudah jadi opsi yang sangat bagus.
Dialogue: 0,0:15:58.08,0:16:00.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jaraknya juga sangat ideal.
Dialogue: 0,0:16:01.38,0:16:03.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Poin plusnya aku bisa pulang pergi\Ndari rumah ke kampus.
Dialogue: 0,0:16:06.01,0:16:07.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu rupanya.
Dialogue: 0,0:16:07.59,0:16:09.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau begitu...
Dialogue: 0,0:16:09.34,0:16:12.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fakta kalau dia sampai sengaja membeli\Nbuku bank soal untuk kampus negeri itu...
Dialogue: 0,0:16:13.31,0:16:15.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu sampai mempertimbangkan\NUniversitas Nijigaoka sebegitunya?
Dialogue: 0,0:16:16.60,0:16:19.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini ceritanya, awalnya,
Dialogue: 0,0:16:19.10,0:16:21.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku selalu yakin dengan pendirianku
Dialogue: 0,0:16:21.65,0:16:24.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau tujuan utamaku masuk kuliah\Nadalah demi bisa menjadi guru.
Dialogue: 0,0:16:24.57,0:16:27.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku tiba-tiba mulai mempertanyakan\Nkembali, apakah aku harus membatasi diriku
Dialogue: 0,0:16:27.37,0:16:28.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pada satu-satunya tujuan itu.
Dialogue: 0,0:16:29.20,0:16:31.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pas aku melihat-lihat materi kampusnya,
Dialogue: 0,0:16:31.28,0:16:33.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku mendapati kampus itu menawarkan\Nbanyak pilihan mata kuliah elektif,
Dialogue: 0,0:16:33.54,0:16:34.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan lambat laun aku jadi makin\Ntertarik dengan programnya.
Dialogue: 0,0:16:35.33,0:16:37.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bahkan sempat mengunjungi\Nkampusnya saat libur musim panas.
Dialogue: 0,0:16:37.71,0:16:39.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru sadar kalau aku bisa mengejar peluang\Nlebih dari sekadar karier jadi guru pengajar.
Dialogue: 0,0:16:39.96,0:16:42.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga bisa mengambil sertifikasi\Nuntuk menjadi kurator museum.
Dialogue: 0,0:16:43.17,0:16:46.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat aku berkunjung, aku merasa sangat cocok\Ndengan atmosfer kampusnya.
Dialogue: 0,0:16:48.01,0:16:50.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi itu kan cuma sekadar perasaanku semata.
Dialogue: 0,0:16:50.59,0:16:52.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, aku memutuskan untuk mencoretnya\Ndari daftar pilihanku untuk saat ini.
Dialogue: 0,0:16:52.97,0:16:54.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau aku sudah mantap mencoretnya,
Dialogue: 0,0:16:55.60,0:16:57.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}entah kenapa,\Nkampus itu terus terbayang-bayang di benakku.
Dialogue: 0,0:17:00.77,0:17:01.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu istirahat sudah selesai.
Dialogue: 0,0:17:01.69,0:17:02.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar, dong!
Dialogue: 0,0:17:02.86,0:17:04.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa obrolan kita\Ndipotong seenaknya begitu?
Dialogue: 0,0:17:05.94,0:17:10.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, aku juga sempat menyinggung hal\Nitu sedikit saat berdiskusi dengan orang tuaku.
Dialogue: 0,0:17:10.24,0:17:11.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya, pilihanku tetap jatuh pada
Dialogue: 0,0:17:11.20,0:17:14.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Universitas Shirahama, yang sekarang\Nsudah mutlak jadi tujuan utamaku.
Dialogue: 0,0:17:21.46,0:17:23.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa rasanya...
Dialogue: 0,0:17:23.63,0:17:26.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia seperti menyederhanakan\Nproses pengambilan keputusannya.
Dialogue: 0,0:17:27.05,0:17:28.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bukan cuma nekat pergi jauh-jauh ke Ibaraki.
Dialogue: 0,0:17:29.05,0:17:30.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan sampai niat membeli buku bank soalnya.
Dialogue: 0,0:17:30.30,0:17:31.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bahkan sampai memikirkan dengan matang
Dialogue: 0,0:17:31.64,0:17:32.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}soal prospek mendapatkan kualifikasi baru.
Dialogue: 0,0:17:32.89,0:17:34.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi keputusannya malah berujung seperti ini.
Dialogue: 0,0:17:34.64,0:17:37.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi orang lain, keputusannya ini terasa kurang meyakinkan.
Dialogue: 0,0:17:38.48,0:17:40.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keputusan gegabah seperti ini sama sekali\Nenggak mencerminkan sifat aslinya.
Dialogue: 0,0:17:41.69,0:17:43.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,
Dialogue: 0,0:17:44.06,0:17:46.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ini baru pertama kalinya aku\Nmendengar soal hal ini darimu.
Dialogue: 0,0:17:46.78,0:17:49.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sama sekali enggak tahu kamu\Nsudah ragu sejak libur musim panas,
Dialogue: 0,0:17:49.44,0:17:52.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ataupun fakta kalau kamu\Nsempat mengunjungi kampus itu,
Dialogue: 0,0:17:53.32,0:17:55.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan fakta kalau kamu sudah\Nmembahasnya dengan orang tuamu.
Dialogue: 0,0:17:55.24,0:17:58.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu serius ingin kuliah di sana,\Nkamu kan terpaksa harus merantau.
Dialogue: 0,0:17:58.50,0:18:00.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar saja kamu harus\Nmendiskusikannya dengan mereka.
Dialogue: 0,0:18:01.25,0:18:02.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar...
Dialogue: 0,0:18:09.21,0:18:11.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dilihat dari sudut pandang mana pun,
Dialogue: 0,0:18:11.13,0:18:13.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sikapkulah yang membuatmu merasa\Nsungkan untuk bercerita jujur kepadaku.
Dialogue: 0,0:18:25.31,0:18:26.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuacanya sedang memburuk.
Dialogue: 0,0:18:26.52,0:18:28.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf ya aku jadi enggak bisa\Nmengantarmu sampai ke rumah.
Dialogue: 0,0:18:28.23,0:18:31.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak apa-apa.\NToh hujannya juga sudah reda, kok.
Dialogue: 0,0:18:31.36,0:18:32.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah mengizinkanku\Nmampir ke rumahmu hari ini.
Dialogue: 0,0:18:37.62,0:18:39.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Udara di luar berubah jadi sejuk sekali, ya.
Dialogue: 0,0:18:39.91,0:18:40.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:18:42.91,0:18:46.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih karena sudah\Nmenyempatkan diri menemuiku hari ini.
Dialogue: 0,0:18:48.92,0:18:51.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku karena belakangan ini\Naku selalu mengucapkan hal-hal egois padamu.
Dialogue: 0,0:18:51.92,0:18:53.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu enggak benar, kok.
Dialogue: 0,0:19:01.93,0:19:03.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Embusan angin ini...
Dialogue: 0,0:19:05.40,0:19:09.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yusuke, mari kita putus\Nuntuk sementara waktu.
Dialogue: 0,0:19:23.96,0:19:26.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sama sekali enggak mau menjadi\Nbeban yang mengekang masa depanmu.
Dialogue: 0,0:19:28.38,0:19:29.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yusuke.
Dialogue: 0,0:19:30.17,0:19:32.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seandainya aku enggak ada di sisimu,
Dialogue: 0,0:19:32.14,0:19:34.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa kamu tetap bakal mengambil keputusan\Nyang sama seperti sekarang?
Dialogue: 0,0:19:39.01,0:19:41.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah pasti...
Dialogue: 0,0:19:42.27,0:19:43.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja enggak.
Dialogue: 0,0:19:43.98,0:19:46.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Poin plusnya aku bisa pulang\Npergi dari rumah ke kampus.
Dialogue: 0,0:19:47.23,0:19:50.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sengaja mengarang segudang alasan\Nyang kedengarannya sangat logis.
Dialogue: 0,0:19:50.52,0:19:52.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi niat asliku yang sesungguhnya adalah...
Dialogue: 0,0:19:53.49,0:19:56.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku hanya berusaha lari dari kenyataan pahit\Nbahwa jarak kami akan membentang jauh.
Dialogue: 0,0:19:57.28,0:20:00.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mati-matian menyembunyikan perasaanku\Nyang sejujurnya darimu. Bukan cuma itu saja.
Dialogue: 0,0:20:01.99,0:20:02.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:20:03.50,0:20:05.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku nyaris menjadikan Miyu\Nsebagai tameng alasanku
Dialogue: 0,0:20:05.83,0:20:07.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}demi menghindari rasa sakit\Nkarena harus berpisah darinya.
Dialogue: 0,0:20:08.83,0:20:13.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bakal memikirkan ulang soal\Npilihan kampusku secara matang.
Dialogue: 0,0:20:14.21,0:20:18.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai detik ini, aku berjanji\Nenggak akan lari dari kenyataan lagi.
Dialogue: 0,0:20:19.47,0:20:21.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon jangan pernah\Nbilang kita harus putus.
Dialogue: 0,0:20:26.27,0:20:29.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita sama-sama berjuang\Nmelakukan yang terbaik.
Dialogue: 0,0:20:31.57,0:20:32.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pulang!
Dialogue: 0,0:20:32.86,0:20:34.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang.
Dialogue: 0,0:20:34.32,0:20:35.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami lagi mau menyiapkan makan malam.
Dialogue: 0,0:20:36.03,0:20:38.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, aku segera menyusul ke sana.
Dialogue: 0,0:20:47.83,0:20:50.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah!
Dialogue: 0,0:20:50.83,0:20:54.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sama sekali enggak ada\Nniatan untuk minta putus.
Dialogue: 0,0:20:54.63,0:20:56.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak pernah terlintas di kepalaku.
Dialogue: 0,0:20:56.38,0:21:00.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku baru sadar\Nkalau ucapan "Aku ingin putus"
Dialogue: 0,0:21:00.14,0:21:04.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memiliki makna yang jauh berbeda\Ndengan "Lebih baik kita putus saja."
Dialogue: 0,0:21:05.52,0:21:07.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita putus untuk sementara waktu.
Dialogue: 0,0:21:08.56,0:21:11.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seandainya saat itu dia mengiyakan ucapanku,
Dialogue: 0,0:21:11.61,0:21:15.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin hari ini hubungan kami\Nbenar-benar akan resmi berakhir.
Dialogue: 0,0:21:16.03,0:21:17.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sama sekali tak mau itu terjadi!
Dialogue: 0,0:21:17.53,0:21:19.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sungguh lega kami tak jadi putus!
Dialogue: 0,0:21:19.95,0:21:22.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekalipun dia memilih kuliah\Ndi kampus yang jauh tanpa ragu,
Dialogue: 0,0:21:22.95,0:21:24.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku pasti tetap bakal merasa sedih.
Dialogue: 0,0:21:25.08,0:21:28.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku sama sekali tak ingin menjadi beban\Nyang mengekang dan menghalangi langkahnya.
Dialogue: 0,0:21:29.00,0:21:33.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, aku sendiri pun merasa\Ndiriku ini sangat merepotkan.
Dialogue: 0,0:21:41.59,0:21:43.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita putus untuk sementara waktu.
Dialogue: 0,0:21:44.51,0:21:48.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjalin sebuah hubungan\Nbukan hanya sekadar soal jarak fisik belaka.
Dialogue: 0,0:21:48.14,0:21:49.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Risiko untuk putus itu\Nakan selalu membayangi.
Dialogue: 0,0:21:50.39,0:21:52.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya fakta itu sudah\Nsangat jelas dari awal,
Dialogue: 0,0:21:52.48,0:21:56.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku baru sungguh-sungguh\Nmenyadarinya saat ini.
Dialogue: 0,0:21:56.65,0:21:57.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin karena selama ini
Dialogue: 0,0:21:57.82,0:22:00.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia sudah selalu bersikap baik\Ndan melakukan banyak hal untukku,
Dialogue: 0,0:22:00.70,0:22:02.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadinya pikiran buruk semacam itu\Ntak pernah sekali pun terlintas di benakku.
Dialogue: 0,0:22:04.16,0:22:06.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, sifatnya jauh berbeda dariku,
Dialogue: 0,0:22:06.83,0:22:10.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia punya mental yang cukup kuat untuk\Nmemilih merelakan sebuah hubungan.
Dialogue: 0,0:22:12.08,0:22:13.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal itu sangat menyeramkan.
Dialogue: 0,0:22:17.34,0:22:18.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyeramkan!
Dialogue: 0,0:22:18.26,0:22:19.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matamu bintitan?
