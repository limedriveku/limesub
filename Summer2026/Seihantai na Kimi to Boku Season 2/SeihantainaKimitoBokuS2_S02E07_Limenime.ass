Dialogue: 0,0:00:01.50,0:00:03.71,sign,,0000,0000,0000,,"MUSIM SEMI TELAH TIBA"
Dialogue: 0,0:00:03.83,0:00:04.79,sign,,0000,0000,0000,,"YAMADA: MAU KETEMU BESOK?"
Dialogue: 0,0:00:04.88,0:00:05.71,sign,,0000,0000,0000,,"NISHI: BOLEH"
Dialogue: 0,0:01:51.02,0:01:53.65,sign,,0000,0000,0000,,LIBURAN MUSIM SEMI:\NKASUS NISHI DAN YAMADA
Dialogue: 0,0:03:01.22,0:03:02.30,sign,,0000,0000,0000,,"AKU HARUS BERDESAKAN DENGAN ANAK-ANAK ITU..."
Dialogue: 0,0:03:05.60,0:03:08.10,sign,,0000,0000,0000,,"RASA TANGGUNG JAWAB..."
Dialogue: 0,0:03:15.19,0:03:16.02,sign,,0000,0000,0000,,DI SANA
Dialogue: 0,0:03:32.92,0:03:35.00,sign,,0000,0000,0000,,MENATAP
Dialogue: 0,0:03:35.09,0:03:36.80,sign,,0000,0000,0000,,TERPESONA...
Dialogue: 0,0:03:36.88,0:03:37.71,sign,,0000,0000,0000,,AH!
Dialogue: 0,0:04:15.04,0:04:16.42,sign,,0000,0000,0000,,"KUBAWA UNTUK BERJAGA-JAGA..."
Dialogue: 0,0:04:53.50,0:04:56.12,sign,,0000,0000,0000,,"CEMAS..."
Dialogue: 0,0:05:02.55,0:05:03.80,sign,,0000,0000,0000,,INI DIA JASNYA
Dialogue: 0,0:05:27.61,0:05:28.62,sign,,0000,0000,0000,,AH
Dialogue: 0,0:05:54.68,0:05:56.14,sign,,0000,0000,0000,,"KELUAR"
Dialogue: 0,0:06:37.52,0:06:39.35,sign,,0000,0000,0000,,"TERKEKEH..."
Dialogue: 0,0:07:03.21,0:07:04.55,sign,,0000,0000,0000,,"GAMBAR: LIHATLAH SATU PER SATU"
Dialogue: 0,0:07:44.33,0:07:46.71,sign,,0000,0000,0000,,LIBURAN MUSIM SEMI:\NKASUS SUZUKI DAN TANI
Dialogue: 0,0:07:57.56,0:07:59.56,sign,,0000,0000,0000,,"TEPAT TENGAH MALAM"
Dialogue: 0,0:08:11.82,0:08:12.70,sign,,0000,0000,0000,,KUKURUYUK
Dialogue: 0,0:08:20.33,0:08:21.33,sign,,0000,0000,0000,,TEMPAT LES
Dialogue: 0,0:08:48.82,0:08:49.69,sign,,0000,0000,0000,,"AH"
Dialogue: 0,0:08:50.98,0:08:51.99,sign,,0000,0000,0000,,"GAWAT"
Dialogue: 0,0:08:52.07,0:08:53.78,sign,,0000,0000,0000,,"BUKAN BEGITU MAKSUDKU..."
Dialogue: 0,0:08:53.86,0:08:55.24,sign,,0000,0000,0000,,"AKU CUMA INGIN MENYEMANGATIMU DULUAN"
Dialogue: 0,0:08:55.32,0:08:57.70,sign,,0000,0000,0000,,"AGAK MERASA MENDAHULUI"
Dialogue: 0,0:08:58.49,0:08:59.33,sign,,0000,0000,0000,,"MELIRIK..."
Dialogue: 0,0:09:01.08,0:09:03.00,sign,,0000,0000,0000,,"PENUH SESAK"
Dialogue: 0,0:09:13.80,0:09:15.38,sign,,0000,0000,0000,,"AH... BERUAP"
Dialogue: 0,0:09:21.60,0:09:23.77,sign,,0000,0000,0000,,"DIAM-DIAM INGIN PAMER PERSIAPANNYA"
Dialogue: 0,0:10:35.55,0:10:37.01,sign,,0000,0000,0000,,KAFE
Dialogue: 0,0:11:09.67,0:11:10.50,sign,,0000,0000,0000,,BRUK
Dialogue: 0,0:11:25.85,0:11:26.68,sign,,0000,0000,0000,,"AKU TIDAK TAHU APA YANG DIA MAU"
Dialogue: 0,0:11:26.77,0:11:27.89,sign,,0000,0000,0000,,"JADI AKU PILIH BARANG YANG PRAKTIS SAJA"
Dialogue: 0,0:11:27.98,0:11:29.81,sign,,0000,0000,0000,,"HORE"
Dialogue: 0,0:11:37.78,0:11:40.45,sign,,0000,0000,0000,,"LEGA..."
Dialogue: 0,0:11:56.50,0:11:57.42,sign,,0000,0000,0000,,HEHE
Dialogue: 0,0:12:15.15,0:12:16.82,sign,,0000,0000,0000,,"TEGAS"
Dialogue: 0,0:13:26.59,0:13:27.43,sign,,0000,0000,0000,,"DENGAN DATAR..."
Dialogue: 0,0:13:30.93,0:13:32.68,sign,,0000,0000,0000,,CARA DIA MENGATAKANNYA\NSANGAT MENYEBALKAN
Dialogue: 0,0:13:43.49,0:13:45.61,sign,,0000,0000,0000,,SENANG
Dialogue: 0,0:14:37.50,0:14:40.88,sign,,0000,0000,0000,,AKU MELAKUKAN ITU... - HEE HEE HEE...
Dialogue: 0,0:14:40.96,0:14:43.50,sign,,0000,0000,0000,,LIBURAN MUSIM SEMI: KASUS AZUMA
Dialogue: 0,0:15:12.62,0:15:14.62,sign,,0000,0000,0000,,KAFE DAN RESTORAN GOSTO
Dialogue: 0,0:15:27.21,0:15:28.05,sign,,0000,0000,0000,,"DIA KERJA PARUH WAKTU DI KEDAI RAMEN"
Dialogue: 0,0:17:03.98,0:17:04.81,sign,,0000,0000,0000,,JEDER
Dialogue: 0,0:17:05.73,0:17:08.85,sign,,0000,0000,0000,,"LANGSUNG BERUBAH PIKIRAN"
Dialogue: 0,0:17:08.94,0:17:11.19,sign,,0000,0000,0000,,SEMESTER BARU SEKOLAH
Dialogue: 0,0:17:13.74,0:17:16.95,sign,,0000,0000,0000,,OBROLAN BERISIK
Dialogue: 0,0:17:18.53,0:17:20.45,sign,,0000,0000,0000,,KELAS 3-1: AZUMA, SATO\NKELAS 3-7: SUZUKI, WATANABE
Dialogue: 0,0:17:42.06,0:17:43.85,sign,,0000,0000,0000,,"KELAS 3-8: TAIRA, TANI"
Dialogue: 0,0:17:53.19,0:17:54.65,sign,,0000,0000,0000,,KELAS 3-8: RIKAKO HONDA
Dialogue: 0,0:17:54.74,0:17:57.11,sign,,0000,0000,0000,,KELAS 3-8: NATSUMI NISHI
Dialogue: 0,0:18:10.88,0:18:12.42,sign,,0000,0000,0000,,"BERAT..."
Dialogue: 0,0:18:25.85,0:18:26.69,sign,,0000,0000,0000,,"INI PERTAMA KALINYA MEREKA NGOBROL BANYAK"
Dialogue: 0,0:18:35.82,0:18:37.53,sign,,0000,0000,0000,,"DIA DICERITAKAN MEREKA SETIAP HARI"
Dialogue: 0,0:18:37.61,0:18:39.41,sign,,0000,0000,0000,,"AKU SAMPAI HAFAL MEREKA SEMUA"
Dialogue: 0,0:18:40.87,0:18:41.70,sign,,0000,0000,0000,,JANTUNG BERDEBAR
Dialogue: 0,0:19:06.85,0:19:08.94,sign,,0000,0000,0000,,"JALAN CEPAT"
Dialogue: 0,0:20:21.26,0:20:22.38,sign,,0000,0000,0000,,"ANAK-ANAK CEWEK JUGA SAMA SAJA"
Dialogue: 0,0:20:22.47,0:20:23.55,sign,,0000,0000,0000,,"ANAK-ANAK CEWEK JUGA SAMA SAJA"
Dialogue: 0,0:21:00.71,0:21:01.97,sign,,0000,0000,0000,,MENYEBALKAN SEKALI...
Dialogue: 0,0:00:01.50,0:00:03.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musim semi sudah tiba.
Dialogue: 0,0:00:03.83,0:00:04.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahun kedua kami
Dialogue: 0,0:00:04.88,0:00:05.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah resmi berakhir.
Dialogue: 0,0:00:05.96,0:00:10.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang menikmati\Nliburan musim semi sesuka hati.
Dialogue: 0,0:00:35.99,0:00:45.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}You and I Are Polar Opposites\NSeason 2
Dialogue: 0,0:01:58.28,0:02:00.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sedikit melenceng dari perkiraanku.
Dialogue: 0,0:02:00.24,0:02:03.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku akan merasa lebih lega\Nkalau menyelesaikan PR-ku dulu.
Dialogue: 0,0:02:03.87,0:02:05.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita pergi setelah tugasmu selesai.
Dialogue: 0,0:02:05.79,0:02:07.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita kencan dan bersenang-senang.
Dialogue: 0,0:02:07.41,0:02:08.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kencan.
Dialogue: 0,0:02:08.62,0:02:11.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa,\Ndia bisa bilang begitu tanpa ragu.
Dialogue: 0,0:02:12.67,0:02:16.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ni... Nishi, ada tempat\Nyang mau kamu kunjungi?
Dialogue: 0,0:02:17.76,0:02:19.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke mana, ya?
Dialogue: 0,0:02:25.06,0:02:27.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau ke akuarium.
Dialogue: 0,0:02:29.73,0:02:30.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berbinar-binar sekali matanya.
Dialogue: 0,0:02:30.90,0:02:33.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nishi, kamu suka akuarium?
Dialogue: 0,0:02:34.61,0:02:36.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu kecil, aku punya tiket tahunan\Nakuarium di dekat rumahku.
Dialogue: 0,0:02:36.82,0:02:38.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya aku sering ke sana\Nbareng keluargaku.
Dialogue: 0,0:02:38.74,0:02:40.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, ini pertama kalinya aku ke sini.
Dialogue: 0,0:02:40.57,0:02:42.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari dulu aku penasaran.
Dialogue: 0,0:02:43.16,0:02:44.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu rupanya.
Dialogue: 0,0:02:44.87,0:02:47.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, aku enggak sengaja bicara terlalu cepat.
Dialogue: 0,0:02:49.79,0:02:51.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Komidi putar!
Dialogue: 0,0:02:51.46,0:02:54.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jarang-jarang ada wahana itu di akuarium.
Dialogue: 0,0:02:54.13,0:02:56.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau naik!
Dialogue: 0,0:02:57.84,0:02:58.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau ikut naik?
Dialogue: 0,0:02:59.30,0:03:00.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, enggak,
Dialogue: 0,0:03:00.30,0:03:01.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}enggak usah.
Dialogue: 0,0:03:01.22,0:03:02.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:03:02.85,0:03:04.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin agak terlambat untuk bilang sekarang,
Dialogue: 0,0:03:04.43,0:03:05.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku agak deg-degan
Dialogue: 0,0:03:05.60,0:03:08.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengajak orang ke tempat yang mau kudatangi.
Dialogue: 0,0:03:08.60,0:03:10.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiba-tiba aku jadi cemas.
Dialogue: 0,0:03:10.60,0:03:13.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga Yamada enggak merasa kebosanan.
Dialogue: 0,0:03:13.90,0:03:15.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, ayo.
Dialogue: 0,0:03:16.11,0:03:16.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:03:17.73,0:03:18.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita berangkat.
Dialogue: 0,0:03:18.82,0:03:19.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau perang?
Dialogue: 0,0:03:22.28,0:03:24.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cantik sekali.
Dialogue: 0,0:03:38.17,0:03:40.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, aku terlalu asyik menikmati suasananya.
Dialogue: 0,0:03:40.47,0:03:43.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kita baru saja mulai berkeliling.\NApa aku melihatnya terlalu lama?
Dialogue: 0,0:03:43.47,0:03:44.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Indah, ya?
Dialogue: 0,0:03:44.43,0:03:45.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:03:45.35,0:03:46.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus mempercepat langkahku sedikit.
Dialogue: 0,0:03:51.89,0:03:52.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ubur-ubur, lo.
Dialogue: 0,0:03:53.06,0:03:55.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruangan yang keren.
Dialogue: 0,0:03:55.48,0:03:57.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemandangannya cantik sekali.
Dialogue: 0,0:04:12.62,0:04:14.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku keluarkan kamera besarku sekarang,
Dialogue: 0,0:04:15.04,0:04:16.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa aku akan terlihat
Dialogue: 0,0:04:16.50,0:04:17.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terlalu antusias?
Dialogue: 0,0:04:20.01,0:04:21.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Na...
Dialogue: 0,0:04:21.80,0:04:23.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, sudah waktunya, nih.
Dialogue: 0,0:04:23.72,0:04:25.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus cari tempat duduk\Nuntuk melihat pertunjukan lumba-lumba.
Dialogue: 0,0:04:27.76,0:04:30.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah penuh semua.
Dialogue: 0,0:04:32.60,0:04:34.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya.
Dialogue: 0,0:04:35.06,0:04:36.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu minta maaf?
Dialogue: 0,0:04:36.90,0:04:38.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu ada kursi kosong!
Dialogue: 0,0:04:39.69,0:04:41.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dekat sekali!
Dialogue: 0,0:04:41.11,0:04:43.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat duduknya strategis.
Dialogue: 0,0:04:43.82,0:04:47.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kursi di barisan ini\Ngampang kena cipratan air.
Dialogue: 0,0:04:48.74,0:04:50.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:04:50.62,0:04:51.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus kita harus bagaimana?
Dialogue: 0,0:04:51.66,0:04:53.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti enggak mau, 'kan?\NDia mungkin enggak akan menyukainya.
Dialogue: 0,0:04:53.50,0:04:56.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira kita bakal sebasah apa nanti?
Dialogue: 0,0:04:56.58,0:04:58.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Mungkin sebaiknya kita mundur saja...\N- Kita harus pakai jas hujan!
Dialogue: 0,0:04:59.21,0:05:00.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku yang belikan!
Dialogue: 0,0:05:19.98,0:05:21.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menggemaskan sekali!
Dialogue: 0,0:05:22.03,0:05:23.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita foto bareng.
Dialogue: 0,0:05:54.68,0:05:56.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah puas melihatnya?
Dialogue: 0,0:05:56.48,0:05:58.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada yang terlewatkan?
Dialogue: 0,0:05:58.44,0:06:00.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu enggak apa-apa\Nkalau kita pulang sekarang?
Dialogue: 0,0:06:02.32,0:06:03.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini...
Dialogue: 0,0:06:03.73,0:06:06.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh aku kembali ke depan\Nuntuk melihat akuarium yang pertama tadi?
Dialogue: 0,0:06:06.65,0:06:08.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja boleh.
Dialogue: 0,0:06:08.82,0:06:11.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya ada hewan di dalam sini?
Dialogue: 0,0:06:11.20,0:06:12.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sedang menyamar.
Dialogue: 0,0:06:12.49,0:06:13.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, ada di sebelah sana.
Dialogue: 0,0:06:13.91,0:06:15.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kamu benar.
Dialogue: 0,0:06:21.50,0:06:24.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah menemaniku hari ini.\NAku merasa sangat senang.
Dialogue: 0,0:06:25.05,0:06:28.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih ada satu hal lagi yang ingin kulakukan.\NBisa temani aku ke sana?
Dialogue: 0,0:06:32.01,0:06:33.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yeay!
Dialogue: 0,0:06:35.43,0:06:37.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ternyata kamu ingin naik wahana itu, ya?
Dialogue: 0,0:06:37.52,0:06:39.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang aku sudah puas. Terima kasih.
Dialogue: 0,0:06:40.73,0:06:43.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi itu sangat menyenangkan!
Dialogue: 0,0:06:43.11,0:06:46.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya, awalnya aku cemas jangan-jangan\Ncuma aku saja yang bersenang-senang.
Dialogue: 0,0:06:46.19,0:06:47.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sampai deg-degan.
Dialogue: 0,0:06:47.69,0:06:50.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa begitu? Aku bersenang-senang, kok.
Dialogue: 0,0:06:50.32,0:06:51.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kalau begitu.
Dialogue: 0,0:06:51.66,0:06:55.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat melihat sesuatu,\Naku memang sering kali terlalu fokus.
Dialogue: 0,0:06:57.41,0:07:00.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedangkan aku lebih suka melihat\Nsegala sesuatunya secara luas.
Dialogue: 0,0:07:01.38,0:07:02.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mata
Dialogue: 0,0:07:02.29,0:07:03.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pakar seperti Bapak Ikan ini,
Dialogue: 0,0:07:03.21,0:07:04.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa caraku menikmati akuarium tadi terkesan aneh?
Dialogue: 0,0:07:04.63,0:07:05.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya?
Dialogue: 0,0:07:06.13,0:07:08.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana menjelaskannya, ya?
Dialogue: 0,0:07:08.67,0:07:11.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asalkan Natsumi merasa bahagia,\Naku juga ikut bahagia.
Dialogue: 0,0:07:12.01,0:07:13.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa lebih bersikap santai, kok.
Dialogue: 0,0:07:22.90,0:07:23.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Natsumi"...
Dialogue: 0,0:07:23.86,0:07:26.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa panggilan itu terlalu berlebihan?\NMalunya.
Dialogue: 0,0:07:26.82,0:07:30.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya, terus memanggilmu\NNishi rasanya agak...
Dialogue: 0,0:07:30.57,0:07:31.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pikiranku memang agak kacau tadi.
Dialogue: 0,0:07:33.16,0:07:34.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Natsumichan.
Dialogue: 0,0:07:34.87,0:07:35.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya?
Dialogue: 0,0:07:36.33,0:07:37.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Natsumi.
Dialogue: 0,0:07:40.16,0:07:41.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nacchan?
Dialogue: 0,0:07:41.17,0:07:43.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kamu saja yang tentukan.
Dialogue: 0,0:07:52.59,0:07:53.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo?
Dialogue: 0,0:07:53.64,0:07:55.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa ini?
Dialogue: 0,0:07:55.85,0:07:57.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat ulang tahun, ya.
Dialogue: 0,0:07:57.56,0:07:59.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:07:59.64,0:08:02.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok ada tempat yang mau kamu kunjungi\Ndi sekitar taman?
Dialogue: 0,0:08:02.69,0:08:04.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus ngapain, ya?
Dialogue: 0,0:08:05.02,0:08:07.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak mau terlalu terikat rencana.\NAyo kita jalan-jalan santai saja.
Dialogue: 0,0:08:10.11,0:08:11.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miyu, kamu sudah bangun?
Dialogue: 0,0:08:12.78,0:08:14.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah!
Dialogue: 0,0:08:14.32,0:08:16.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Tani! Kita lanjut besok, ya.
Dialogue: 0,0:08:16.45,0:08:18.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tani? Kamu lagi teleponan sama cowok?
Dialogue: 0,0:08:28.25,0:08:31.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke mana sebaiknya kita pergi\Ndi musim semi ini?
Dialogue: 0,0:08:32.26,0:08:34.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya, kami memutuskan\Nuntuk menikmati keindahan bunga sakura!
Dialogue: 0,0:08:35.34,0:08:38.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru saja ke sini bersama Azu, Nabe,\Ndan Sato beberapa waktu lalu.
Dialogue: 0,0:08:38.35,0:08:40.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunganya jauh lebih mekar\Ndibandingkan saat itu.
Dialogue: 0,0:08:40.85,0:08:42.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pas kamu mengirimiku foto, 'kan?
Dialogue: 0,0:08:42.94,0:08:43.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul.
Dialogue: 0,0:08:43.94,0:08:46.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka merayakan ulang tahunku\Nsambil menikmati bunga sakura.
Dialogue: 0,0:08:47.06,0:08:48.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bahkan diberikan kado oleh mereka.
Dialogue: 0,0:08:48.82,0:08:49.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:08:50.07,0:08:50.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:08:50.98,0:08:51.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ucapanku tadi
Dialogue: 0,0:08:52.07,0:08:53.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terdengar seperti menagih kado?
Dialogue: 0,0:08:53.86,0:08:55.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan berarti
Dialogue: 0,0:08:55.32,0:08:57.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memberi lebih awal itu selalu lebih baik.
Dialogue: 0,0:08:58.49,0:08:59.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,
Dialogue: 0,0:08:59.41,0:09:00.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku merasa...
Dialogue: 0,0:09:01.08,0:09:03.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah tasnya terlalu besar?
Dialogue: 0,0:09:03.33,0:09:06.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau ternyata dia\Nsudah menyiapkan kejutan besar?
Dialogue: 0,0:09:06.38,0:09:07.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus bereaksi bagaimana nanti?
Dialogue: 0,0:09:07.67,0:09:08.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh iya.
Dialogue: 0,0:09:09.80,0:09:13.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bawa tikar lipat.\NKita mau gelar tikar di mana?
Dialogue: 0,0:09:13.80,0:09:15.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, ya...
Dialogue: 0,0:09:17.34,0:09:19.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku membawakan minuman hangat.
Dialogue: 0,0:09:20.01,0:09:21.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baguslah.
Dialogue: 0,0:09:21.60,0:09:23.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bilang saja kalau butuh tisu basah, ya.
Dialogue: 0,0:09:23.85,0:09:24.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:09:25.73,0:09:27.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana kamu mengambil foto ini?
Dialogue: 0,0:09:27.31,0:09:28.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dekat rumahnya Azu.
Dialogue: 0,0:09:28.98,0:09:32.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya kami mau mengajak Taira juga.
Dialogue: 0,0:09:32.61,0:09:34.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumah Taira juga ada di sekitar sini, 'kan?
Dialogue: 0,0:09:35.07,0:09:36.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kita telepon saja dia?
Dialogue: 0,0:09:36.11,0:09:37.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, ide bagus!
Dialogue: 0,0:09:37.99,0:09:39.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti canggung jadi cowok sendirian\Ndi tengah cewek-cewek.
Dialogue: 0,0:09:39.95,0:09:42.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita kan sudah sedekat ini.\NApa perlu mempermasalahkan hal itu?
Dialogue: 0,0:09:42.54,0:09:44.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ajakan ini sangat mendadak, lo.
Dialogue: 0,0:09:45.00,0:09:47.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira dia mau datang atau enggak\Nkalau ditelepon?
Dialogue: 0,0:09:48.67,0:09:50.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya dia pasti menolak,
Dialogue: 0,0:09:50.46,0:09:52.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ujung-ujungnya pasti datang.
Dialogue: 0,0:09:53.17,0:09:55.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun, aku sudah bisa membayangkannya.\NLucu sekali.
Dialogue: 0,0:09:56.72,0:10:00.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, cuaca hari ini cerah sekali.
Dialogue: 0,0:10:00.93,0:10:01.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang sudah masuk musim semi.
Dialogue: 0,0:10:02.35,0:10:07.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa tiap tahunnya,\Nsaat hawa dingin mulai sirna
Dialogue: 0,0:10:07.52,0:10:11.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan sinar matahari yang hangat\Nseakan jadi pertanda akhir dari musim dingin,
Dialogue: 0,0:10:11.82,0:10:15.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selalu ada perasaan kalau\Nhal baru akan segera dimulai.
Dialogue: 0,0:10:15.11,0:10:18.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah tadi kamu bilang merasa sedih?
Dialogue: 0,0:10:18.11,0:10:19.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu cuma di awal musim seminya saja.
Dialogue: 0,0:10:19.99,0:10:21.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalan pikiranmu susah ditebak.
Dialogue: 0,0:10:28.08,0:10:29.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sungguh berharap
Dialogue: 0,0:10:29.96,0:10:33.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita akan bisa terus menciptakan\Nmomen-momen indah seperti ini bersama.
Dialogue: 0,0:10:37.34,0:10:39.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya enak sekali!
Dialogue: 0,0:10:39.80,0:10:43.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak kusangka kamu tahu kafe senyaman ini.
Dialogue: 0,0:10:44.01,0:10:46.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setiap ada perayaan,
Dialogue: 0,0:10:46.77,0:10:48.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}keluargaku selalu beli kue di sini.
Dialogue: 0,0:10:48.60,0:10:51.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ini juga pertama kalinya\Naku makan langsung di tempatnya.
Dialogue: 0,0:10:51.36,0:10:52.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, jadi begitu rupanya.
Dialogue: 0,0:10:52.61,0:10:53.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa sangat bahagia.
Dialogue: 0,0:10:55.69,0:10:57.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat ulang tahun, ya.
Dialogue: 0,0:11:01.82,0:11:04.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak sekali rasanya.
Dialogue: 0,0:11:04.62,0:11:06.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini untukmu.
Dialogue: 0,0:11:07.75,0:11:09.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok nada bicaramu ragu-ragu begitu?
Dialogue: 0,0:11:10.58,0:11:12.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, lumayan berat.
Dialogue: 0,0:11:12.25,0:11:13.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Isinya apa, nih?
Dialogue: 0,0:11:15.30,0:11:16.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata gelas mug!
Dialogue: 0,0:11:16.71,0:11:17.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada ukiran namaku juga di sini!
Dialogue: 0,0:11:18.22,0:11:20.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini jenis gelas yang bisa tahan suhu?
Dialogue: 0,0:11:22.01,0:11:23.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada tutupnya juga.
Dialogue: 0,0:11:23.43,0:11:25.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku bakal cocok dipakai
Dialogue: 0,0:11:25.85,0:11:26.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di kamarmu.
Dialogue: 0,0:11:26.77,0:11:27.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pasti sangat berguna.
Dialogue: 0,0:11:27.98,0:11:29.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bagus.
Dialogue: 0,0:11:30.14,0:11:31.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang sekali!
Dialogue: 0,0:11:31.77,0:11:34.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain memberiku kado, kamu juga sudah\Nberusaha keras melakukan banyak hal hari ini.
Dialogue: 0,0:11:35.44,0:11:37.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar-benar sudah\Nseperti pacarku sesungguhnya.
Dialogue: 0,0:11:37.78,0:11:40.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Komentar macam apa itu?
Dialogue: 0,0:11:41.70,0:11:42.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi
Dialogue: 0,0:11:42.99,0:11:45.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semua ini bukan sesuatu\Nyang bakal kulakukan kalau sendirian.
Dialogue: 0,0:11:45.99,0:11:48.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa dibilang, aku sedikit\Nmemaksakan diriku hari ini.
Dialogue: 0,0:11:48.29,0:11:50.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sudah berusaha keras\Nagar terlihat keren di matamu.
Dialogue: 0,0:11:51.75,0:11:53.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak percaya kamu\Njujur sekali bilang begitu.
Dialogue: 0,0:11:53.92,0:11:56.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku lega kalau kamu merasakannya.
Dialogue: 0,0:11:57.50,0:12:01.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang sekali. Aku beruntung memilikimu.
Dialogue: 0,0:12:01.59,0:12:03.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga momen seperti ini bisa\Nterus berlanjut selamanya.
Dialogue: 0,0:12:06.01,0:12:08.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus berhati-hati bersikap\Nsupaya kamu enggak bosan kepadaku.
Dialogue: 0,0:12:11.85,0:12:13.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, ada apa denganku?
Dialogue: 0,0:12:13.90,0:12:15.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu enggak akan mungkin terjadi.
Dialogue: 0,0:12:15.15,0:12:16.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tingkat kepercayaan dirinya tinggi sekali.
Dialogue: 0,0:12:19.65,0:12:21.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:12:21.99,0:12:23.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:12:24.16,0:12:26.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lampu jalannya membuat\Npemandangannya makin indah.
Dialogue: 0,0:12:26.41,0:12:28.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matahari juga makin lama\Nterbenamnya sekarang.
Dialogue: 0,0:12:31.75,0:12:33.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sedang merasa gelisah?
Dialogue: 0,0:12:36.46,0:12:39.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma kepikiran, begitu masuk kelas tiga,
Dialogue: 0,0:12:39.17,0:12:41.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku pasti senang banget kalau kita sekelas,
Dialogue: 0,0:12:41.63,0:12:43.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kemungkinannya kecil sekali.
Dialogue: 0,0:12:44.05,0:12:48.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi cemas, nanti karena sibuk\Ndi kelas baru dan stres menghadapi ujian,
Dialogue: 0,0:12:48.22,0:12:52.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita perlahan menjauh\Ndan akhirnya aku akan merasa kesepian.
Dialogue: 0,0:12:52.94,0:12:55.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah mencoba mengalihkan pikiranku,
Dialogue: 0,0:12:55.56,0:13:00.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi mau bagaimanapun,\Ndalam hati kecilku aku merasa cemas.
Dialogue: 0,0:13:00.61,0:13:03.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau lebih tepatnya, aku sedang\Nmenyiapkan mental untuk merasa gelisah?
Dialogue: 0,0:13:06.62,0:13:07.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya akan baik-baik saja, kok.
Dialogue: 0,0:13:08.03,0:13:11.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu kita untuk bertemu mungkin akan\Nberkurang dibandingkan sebelumnya,
Dialogue: 0,0:13:11.83,0:13:16.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ini fase yang penting\Nuntuk menentukan masa depan kita.
Dialogue: 0,0:13:17.08,0:13:20.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan cuma memendamnya sendiri\Ndan memaksakan diri untuk menerimanya.
Dialogue: 0,0:13:20.21,0:13:21.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri tahu aku apa yang sedang kamu rasakan.
Dialogue: 0,0:13:21.96,0:13:24.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kita terbuka, kita enggak akan menjauh.
Dialogue: 0,0:13:24.72,0:13:26.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak akan ada yang berubah.
Dialogue: 0,0:13:26.59,0:13:27.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terutama diriku sendiri.
Dialogue: 0,0:13:27.51,0:13:28.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya?
Dialogue: 0,0:13:28.43,0:13:30.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga enggak akan berubah, paham?
Dialogue: 0,0:13:33.23,0:13:34.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:13:34.35,0:13:37.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mendengarmu bilang begitu\Nmembuat perasaanku sedikit lebih lega.
Dialogue: 0,0:13:37.10,0:13:38.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu artinya\Naku ini terlalu mudah ditebak?
Dialogue: 0,0:13:39.11,0:13:42.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih\Nkarena selalu jujur dan terbuka padaku.
Dialogue: 0,0:13:48.28,0:13:50.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang pura-pura jujur,
Dialogue: 0,0:13:50.53,0:13:52.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi nyatanya aku cuma\Nmenyembunyikan perasaanku.
Dialogue: 0,0:13:53.45,0:13:54.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya akan baik-baik saja.
Dialogue: 0,0:13:55.29,0:13:57.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berpura-pura menenangkannya,
Dialogue: 0,0:13:57.50,0:13:59.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}padahal sebenarnya kata-kata itu\Nkutujukan untuk meyakinkan diriku sendiri.
Dialogue: 0,0:14:00.13,0:14:05.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akulah yang sebenarnya paling takut\Nkalau kami harus saling berjauhan.
Dialogue: 0,0:14:06.09,0:14:10.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sok-sokan berusaha bersikap tenang\Nhanya membuatku terlihat menyedihkan.
Dialogue: 0,0:14:11.56,0:14:12.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yusuke.
Dialogue: 0,0:14:17.73,0:14:18.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu manis sekali.
Dialogue: 0,0:14:22.36,0:14:23.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bisa membaca isi kepalaku?
Dialogue: 0,0:14:25.65,0:14:28.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mempercayakan diriku\Nyang berumur 17 tahun ini padamu.
Dialogue: 0,0:14:31.49,0:14:32.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang.
Dialogue: 0,0:14:32.95,0:14:35.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun, Yu. Kamu terlihat sangat manis.
Dialogue: 0,0:14:45.84,0:14:46.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yamada?
Dialogue: 0,0:14:47.05,0:14:48.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tumben sekali dia meneleponku.
Dialogue: 0,0:14:48.76,0:14:49.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo?
Dialogue: 0,0:14:49.89,0:14:52.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Azuma, kamu sedang apa? Lagi senggang?
Dialogue: 0,0:14:53.10,0:14:55.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sif kerjaku baru saja kelar.\NAku lagi di tempat parkir sepeda.
Dialogue: 0,0:14:55.93,0:14:57.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa dibilang aku lagi senggang, sih.
Dialogue: 0,0:14:57.31,0:14:59.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baguslah.\NKalau begitu, aku ke situ bentar lagi...
Dialogue: 0,0:14:59.35,0:15:00.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:15:01.23,0:15:03.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba jelaskan dulu situasinya padanya.
Dialogue: 0,0:15:03.32,0:15:04.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, benar juga.
Dialogue: 0,0:15:06.07,0:15:09.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lagi nongkrong bareng Taira\Ndi restoran keluarga.
Dialogue: 0,0:15:09.15,0:15:09.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lokasinya di dekat daerahmu, kok.
Dialogue: 0,0:15:10.07,0:15:12.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir kamu mungkin lagi\Nada di sekitar sini juga.
Dialogue: 0,0:15:15.83,0:15:16.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:15:17.96,0:15:19.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat juga kamu datangnya.
Dialogue: 0,0:15:19.71,0:15:21.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf mengundangmu mendadak.
Dialogue: 0,0:15:24.92,0:15:27.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Badanku agak bau ramen sekarang.
Dialogue: 0,0:15:27.21,0:15:28.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak apa-apa?
Dialogue: 0,0:15:28.13,0:15:28.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak masalah, kok.
Dialogue: 0,0:15:29.05,0:15:30.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bau kami juga sekarang\Nmirip bau ruangan karaoke.
Dialogue: 0,0:15:30.88,0:15:33.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian habis karaoke bareng?\NEnggak terduga.
Dialogue: 0,0:15:33.85,0:15:35.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu nyanyi lagu apa saja tadi, Taira?
Dialogue: 0,0:15:35.85,0:15:37.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak penting juga aku nyanyi lagu apa.
Dialogue: 0,0:15:37.72,0:15:39.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tadi dia...\N- Hei, jangan sebutkan!
Dialogue: 0,0:15:39.56,0:15:41.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa\Nkamu ini suka menjaga jarak denganku, ya.
Dialogue: 0,0:15:41.85,0:15:44.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya niat bertanyamu saja sudah jelek.
Dialogue: 0,0:15:44.19,0:15:45.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pasti cuma mencari bahan\Nuntuk menggodaku, 'kan?
Dialogue: 0,0:15:45.82,0:15:47.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku memang berniat menggodamu.\N- Setidaknya pura-pura bantah, dong!
Dialogue: 0,0:15:48.49,0:15:49.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian lagi bertengkar?
Dialogue: 0,0:15:49.65,0:15:51.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami cuma bercanda, kok.
Dialogue: 0,0:15:51.11,0:15:53.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedengarannya lumayan kejam juga karena\Nkeluar dari mulut si tukang goda.
Dialogue: 0,0:15:56.70,0:15:58.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, pesanan kita datang.
Dialogue: 0,0:15:58.45,0:15:59.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dia pesanannya.
Dialogue: 0,0:15:59.75,0:16:01.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti kamu bisa menghabiskannya!
Dialogue: 0,0:16:03.79,0:16:05.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba dipikir-pikir lagi...
Dialogue: 0,0:16:05.71,0:16:08.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya apa perasaanku yang sesungguhnya?
Dialogue: 0,0:16:09.05,0:16:11.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertanyaan itu tiba-tiba saja melintas\Ndi pikiranku.
Dialogue: 0,0:16:11.09,0:16:14.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir suasananya akan terasa canggung,
Dialogue: 0,0:16:14.26,0:16:15.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi nyatanya kami bisa lumayan akrab.
Dialogue: 0,0:16:16.43,0:16:17.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah dipikir kembali,
Dialogue: 0,0:16:17.85,0:16:23.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku belum pernah sedekat ini\Nberteman dengan cowok.
Dialogue: 0,0:16:23.19,0:16:26.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelumnya, aku selalu saja ada firasat\Nbakal jadian dengan cowok yang baru kukenal.
Dialogue: 0,0:16:27.23,0:16:30.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka punya gelagat mendekatiku,
Dialogue: 0,0:16:30.44,0:16:33.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan aku dengan senang hati menerimanya,\Nmeski aku sadar akan hal itu.
Dialogue: 0,0:16:33.86,0:16:36.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku malah merasa\Ntensi romantis di masa PDKT awal-awal itu
Dialogue: 0,0:16:36.20,0:16:39.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah bagian yang paling\Nbikin deg-degan dan asyik.
Dialogue: 0,0:16:40.54,0:16:41.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini gawat.
Dialogue: 0,0:16:42.41,0:16:45.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hubungan kami yang sekarang\Nsama sekali enggak seperti itu.
Dialogue: 0,0:16:45.92,0:16:48.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya,\Napa yang sebenarnya mau kulakukan?
Dialogue: 0,0:16:49.25,0:16:50.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingin berpacaran?
Dialogue: 0,0:16:51.30,0:16:52.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan Taira?
Dialogue: 0,0:16:52.67,0:16:53.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali enggak.
Dialogue: 0,0:16:54.05,0:16:58.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelumnya, aku bisa mudah jatuh cinta hanya\Ndengan sedikit rasa suka pada seseorang.
Dialogue: 0,0:16:59.01,0:17:02.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sekarang aku harus lebih hati-hati\Ndan memikirkannya matang-matang.
Dialogue: 0,0:17:02.77,0:17:03.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, sudahlah hentikan...
Dialogue: 0,0:17:05.73,0:17:08.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan berhenti memikirkannya.
Dialogue: 0,0:17:11.56,0:17:13.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masuk kelas mana, ya?
Dialogue: 0,0:17:20.54,0:17:21.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Azu dan Sato masuk Kelas 1.
Dialogue: 0,0:17:22.00,0:17:23.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nabe dan aku ada di Kelas 7!
Dialogue: 0,0:17:23.50,0:17:24.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sekelas lagi!
Dialogue: 0,0:17:24.71,0:17:26.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kamu bisa melihat\Nsejauh itu dari sini?
Dialogue: 0,0:17:26.17,0:17:29.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Asyik, kita sekelas lagi!\N- Hore! Hore!
Dialogue: 0,0:17:29.21,0:17:30.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sangat antusias sekali\Npadahal masih pagi.
Dialogue: 0,0:17:30.88,0:17:33.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suzuki, bagaimana dengan kelasnya Tani?
Dialogue: 0,0:17:33.42,0:17:34.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tani masuk Kelas 8.
Dialogue: 0,0:17:34.84,0:17:36.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kubilang, bagaimana kamu bisa tahu itu?
Dialogue: 0,0:17:37.18,0:17:38.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:17:38.35,0:17:40.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, nomor absenmu 20!
Dialogue: 0,0:17:40.47,0:17:41.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar.
Dialogue: 0,0:17:42.06,0:17:43.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taira juga di kelas itu!
Dialogue: 0,0:17:44.18,0:17:45.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bikin kaget aja!
Dialogue: 0,0:17:46.35,0:17:47.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu harus kaget segala?
Dialogue: 0,0:17:48.48,0:17:50.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Azu, ayo kita ke kelas.
Dialogue: 0,0:18:01.33,0:18:02.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Honchan!
Dialogue: 0,0:18:03.25,0:18:05.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sekelas lagi! Aku senang sekali.
Dialogue: 0,0:18:05.90,0:18:08.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya. Semoga tahun ini seru juga ya, Nishi.
Dialogue: 0,0:18:09.96,0:18:10.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak mungkin
Dialogue: 0,0:18:10.88,0:18:12.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa menggunakan semua ini.
Dialogue: 0,0:18:12.50,0:18:13.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sih.
Dialogue: 0,0:18:13.63,0:18:15.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:18:15.13,0:18:16.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku sungguh.
Dialogue: 0,0:18:16.47,0:18:17.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suzuki!
Dialogue: 0,0:18:17.76,0:18:18.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kawasaki!
Dialogue: 0,0:18:18.97,0:18:21.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah sering dengar ceritamu\Ndari Azuma, lo.
Dialogue: 0,0:18:21.51,0:18:23.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku merasa lumayan akrab denganmu.
Dialogue: 0,0:18:23.89,0:18:24.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, sama, dong.
Dialogue: 0,0:18:24.93,0:18:25.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga merasa begitu.
Dialogue: 0,0:18:25.85,0:18:26.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hore!
Dialogue: 0,0:18:28.52,0:18:30.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada Tani dan Taira.
Dialogue: 0,0:18:30.65,0:18:32.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada Saotome dan Hasegawa juga.
Dialogue: 0,0:18:32.77,0:18:35.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu cowok kacamata jago main\Ngim yang pacarnya gyaru.
Dialogue: 0,0:18:35.82,0:18:37.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seandainya Yamada juga masuk Kelas 8,
Dialogue: 0,0:18:37.61,0:18:39.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku pasti bakal sangat senang.
Dialogue: 0,0:18:39.95,0:18:40.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:18:41.78,0:18:43.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hush, hus!
Dialogue: 0,0:18:43.74,0:18:46.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin berada di kelas sebelah\Nini memang sudah jalannya.
Dialogue: 0,0:18:49.00,0:18:50.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti bakal terasa canggung
Dialogue: 0,0:18:50.27,0:18:52.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau kami harus saling janjian atau\Nmenunggu di luar kelas sepulang sekolah
Dialogue: 0,0:18:52.79,0:18:54.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}cuma biar bisa pulang bareng.
Dialogue: 0,0:18:54.55,0:18:57.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelumnya pun kami\Nenggak setiap hari pulang bersama.
Dialogue: 0,0:18:58.47,0:19:00.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang mungkin bakal lebih\Njarang lagi momen kami pulang bareng.
Dialogue: 0,0:19:06.85,0:19:08.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, jangan main nyelonong pergi tanpa bilang-bilang!
Dialogue: 0,0:19:10.06,0:19:15.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya kamu jalannya pelan sekali,\Njadi aku enggak mau merepotkanmu.
Dialogue: 0,0:19:15.65,0:19:16.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cowok ini...
Dialogue: 0,0:19:18.70,0:19:19.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu?
Dialogue: 0,0:19:19.99,0:19:21.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kesanmu terhadap kelas barumu?
Dialogue: 0,0:19:21.82,0:19:22.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ini ibuku, ya?
Dialogue: 0,0:19:23.91,0:19:26.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya sih, kelas baruku\Nbakal jadi kelas yang nyaman untukku.
Dialogue: 0,0:19:29.54,0:19:31.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya ada Tani juga di kelasmu, 'kan?
Dialogue: 0,0:19:31.67,0:19:33.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan itu maksudku.
Dialogue: 0,0:19:33.17,0:19:35.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku, rasanya kami semua\Nbakal gampang akrab.
Dialogue: 0,0:19:35.30,0:19:37.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditambah lagi ada anak-anak lain\Ndari Kelas 7.
Dialogue: 0,0:19:37.71,0:19:40.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa saja mengiyakan\Ndi momen kayak begini.
Dialogue: 0,0:19:40.51,0:19:43.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena hal pertama yang dia keluhkan\Nbegitu duduk adalah...
Dialogue: 0,0:19:43.55,0:19:44.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Aku enggak bisa lihat\Ntulisan di papan tulis."
Dialogue: 0,0:19:45.85,0:19:46.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma itu saja.
Dialogue: 0,0:19:47.56,0:19:48.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kocak banget!
Dialogue: 0,0:19:48.48,0:19:50.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kelasmu sendiri bagaimana?
Dialogue: 0,0:19:50.94,0:19:52.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana bilangnya, ya?
Dialogue: 0,0:19:52.90,0:19:55.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lega bisa sekelas sama Sato.
Dialogue: 0,0:19:55.15,0:19:57.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku belum sempat berinteraksi\Ndengan anak-anak lainnya hari ini.
Dialogue: 0,0:19:57.53,0:19:59.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku belum tahu bagaimana\Natmosfer kelasnya nanti.
Dialogue: 0,0:19:59.53,0:20:01.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar, ini kan baru hari pertama.
Dialogue: 0,0:20:05.28,0:20:07.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya sih, kelas baruku\Nbakal jadi kelas yang nyaman untukku.
Dialogue: 0,0:20:08.04,0:20:10.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kaget karena dia membalasnya\Ndengan ceplas-ceplos.
Dialogue: 0,0:20:11.75,0:20:13.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekalipun kamu merasa sangat\Ndekat dengan seseorang,
Dialogue: 0,0:20:13.50,0:20:16.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}orang itu mungkin punya teman lain\Nyang dianggapnya lebih dekat.
Dialogue: 0,0:20:16.46,0:20:19.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya hal semacam itu\Nsangat lazim terjadi.
Dialogue: 0,0:20:19.88,0:20:21.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu mulai mencemaskan\Nhal-hal seperti itu,
Dialogue: 0,0:20:21.26,0:20:22.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}enggak akan ada ujungnya.
Dialogue: 0,0:20:22.47,0:20:23.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu aku
Dialogue: 0,0:20:23.64,0:20:24.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa lebih bersikap cuek soal hal ini.
Dialogue: 0,0:20:26.05,0:20:27.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa, ya, namanya?
Dialogue: 0,0:20:28.02,0:20:33.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasa sepi? Sedih? Rasanya agak beda dari itu.
Dialogue: 0,0:20:35.40,0:20:36.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengesalkan sekali.
Dialogue: 0,0:20:37.82,0:20:39.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma kepalaku saja yang penuh\Nsama pikiran-pikiran begini,
Dialogue: 0,0:20:39.99,0:20:44.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sedangkan kelihatannya aku sama sekali\Nenggak terlintas di pikiran Taira.
Dialogue: 0,0:20:44.13,0:20:45.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyebalkan banget.
Dialogue: 0,0:20:46.78,0:20:49.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaan macam apa ini?
Dialogue: 0,0:20:49.87,0:20:51.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyebalkan. Terlalu kekanak-kanakan.
Dialogue: 0,0:20:51.91,0:20:53.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyedihkan banget.
Dialogue: 0,0:20:53.12,0:20:54.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benci perasaan ini.
Dialogue: 0,0:20:54.79,0:20:58.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira berapa lama ya kita harus\Nmenyimpan pin
Dialogue: 0,0:20:58.50,0:21:00.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari festival tahun lalu di tas kita...
Dialogue: 0,0:21:02.05,0:21:03.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kenapa?
Dialogue: 0,0:21:05.01,0:21:05.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dah, ya.
Dialogue: 0,0:21:10.81,0:21:13.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah enggak sekelas lagi, 'kan?
Dialogue: 0,0:21:13.85,0:21:16.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, itu memang benar, sih.
Dialogue: 0,0:21:18.11,0:21:20.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa reaksimu begitu? Dingin sekali.
Dialogue: 0,0:21:21.61,0:21:24.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, kita kan bisa ketemuan\Nsepulang sekolah nanti.
Dialogue: 0,0:21:25.03,0:21:26.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa ketemuan di stasiun\Natau di sekitar sini.
Dialogue: 0,0:21:29.37,0:21:31.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaanku saja, ya?
Dialogue: 0,0:21:31.25,0:21:32.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekspresimu seperti bilang begitu.
Dialogue: 0,0:21:32.75,0:21:35.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, maksudku, omonganmu itu ada benarnya.
Dialogue: 0,0:21:38.00,0:21:40.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita ngobrol terus, ya? Awas saja!
Dialogue: 0,0:21:40.75,0:21:43.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu jadi sangat memaksa begitu?
Dialogue: 0,0:21:43.59,0:21:45.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pulang dulu, ya. Dah.
Dialogue: 0,0:21:46.47,0:21:47.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dah.
Dialogue: 0,0:22:04.11,0:22:05.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak...
Dialogue: 0,0:22:05.82,0:22:07.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu...
Dialogue: 0,0:22:10.66,0:22:12.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita pulang.
