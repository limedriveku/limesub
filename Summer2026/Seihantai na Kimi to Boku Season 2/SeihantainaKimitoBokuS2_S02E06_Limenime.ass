Dialogue: 0,0:12:18.40,0:12:22.86,sign,,0000,0000,0000,,GUGUP
Dialogue: 0,0:12:23.41,0:12:24.66,sign,,0000,0000,0000,,"KAGET"
Dialogue: 0,0:12:26.45,0:12:27.70,sign,,0000,0000,0000,,"MALU SOAL JALAN PULANG BERSAMA"
