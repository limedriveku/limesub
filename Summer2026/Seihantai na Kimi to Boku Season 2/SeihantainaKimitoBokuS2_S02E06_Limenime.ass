Dialogue: 0,0:21:58.56,0:22:00.02,sign,,0000,0000,0000,,RUMIT, SENSITIF,\NMEREPOTKAN, MENGKHAWATIRKAN
Dialogue: 0,0:00:01.37,0:00:02.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat!
Dialogue: 0,0:00:02.79,0:00:03.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah, ya.
Dialogue: 0,0:00:03.83,0:00:05.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga kalian berdua langgeng.
Dialogue: 0,0:00:05.08,0:00:06.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yeay!
Dialogue: 0,0:00:07.59,0:00:08.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makasih.
Dialogue: 0,0:00:09.25,0:00:11.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yamada sudah punya pacar.
Dialogue: 0,0:00:11.51,0:00:13.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa ceweknya? Apa aku kenal?
Dialogue: 0,0:00:13.55,0:00:14.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang menembak duluan?
Dialogue: 0,0:00:14.76,0:00:16.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan jadiannya?
Dialogue: 0,0:00:16.55,0:00:18.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, tenang dulu.
Dialogue: 0,0:00:18.60,0:00:20.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia seperti sedang diinterogasi.
Dialogue: 0,0:00:20.97,0:00:24.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cewek memang sangat suka bergosip\Nsoal kehidupan asmara orang lain.
Dialogue: 0,0:00:24.48,0:00:25.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa begitu?
Dialogue: 0,0:00:25.48,0:00:26.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana aku tahu?
Dialogue: 0,0:00:26.73,0:00:28.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, ini bukan sekadar gosip asmara.
Dialogue: 0,0:00:28.98,0:00:30.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Telingamu tajam sekali.
Dialogue: 0,0:00:30.32,0:00:32.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami hanya ingin ikut senang\Ndengan membicarakan kabar bahagia.
Dialogue: 0,0:00:32.99,0:00:34.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:00:34.11,0:00:35.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian cuma menikmati suasananya saja, 'kan?
Dialogue: 0,0:00:35.36,0:00:38.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Energi yang didapat dari gosip asmara\Nitu bisa bikin awet muda.
Dialogue: 0,0:00:38.28,0:00:39.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ini penyihir, ya?
Dialogue: 0,0:00:39.20,0:00:42.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang pasti ingin merayakan\Nkebahagiaan sahabatnya, bukan?
Dialogue: 0,0:00:42.12,0:00:43.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa nada bicaramu begitu?
Dialogue: 0,0:00:43.41,0:00:45.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, jangan bicara bersamaan.
Dialogue: 0,0:00:46.21,0:00:49.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taira, balasan ala Pangeran Shotoku milikmu\Nsangat pas hari ini.
Dialogue: 0,0:00:49.34,0:00:50.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak pernah meminta peran ini.
Dialogue: 0,0:00:52.76,0:00:54.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu dapat cokelat Valentine?
Dialogue: 0,0:00:54.22,0:00:55.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:00:56.43,0:00:57.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:00:57.34,0:00:59.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yamada, kamu hebat.
Dialogue: 0,0:01:03.14,0:01:04.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa…
Dialogue: 0,0:01:04.26,0:01:08.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya, kukira perasaanku\Nakan lebih campur aduk.
Dialogue: 0,0:01:08.11,0:01:08.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin karena
Dialogue: 0,0:01:09.02,0:01:10.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku mendengar seluruh ceritanya.
Dialogue: 0,0:01:10.69,0:01:12.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku benar-benar\Ningin mengucapkan selamat.
Dialogue: 0,0:01:13.65,0:01:15.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yamada, aku turut bahagia untukmu.
Dialogue: 0,0:01:16.49,0:01:17.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru sekarang?
Dialogue: 0,0:01:20.49,0:01:22.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, ceweknya seperti apa?
Dialogue: 0,0:01:22.91,0:01:24.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya fotonya.
Dialogue: 0,0:01:24.08,0:01:25.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Layar ponselmu retak.
Dialogue: 0,0:01:32.21,0:01:34.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia anggota komite perpustakaan,\Nsama seperti Tani.
Dialogue: 0,0:01:34.97,0:01:36.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah kenal dia dari dulu?
Dialogue: 0,0:01:38.76,0:01:42.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu rupanya.
Dialogue: 0,0:01:58.28,0:02:07.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}You and I Are Polar Opposites\NSeason 2
Dialogue: 0,0:03:14.31,0:03:18.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi paranoid karena kesalahpahaman lain
Dialogue: 0,0:03:18.57,0:03:19.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan malah menakuti diriku sendiri.
Dialogue: 0,0:03:20.32,0:03:21.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taira…
Dialogue: 0,0:03:21.78,0:03:23.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kamu punya kebiasaan menahan tawa.
Dialogue: 0,0:03:24.91,0:03:26.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tiba-tiba bilang begitu?
Dialogue: 0,0:03:26.16,0:03:27.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa terlalu mendadak?
Dialogue: 0,0:03:27.66,0:03:29.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah cukup lama memikirkan hal itu.
Dialogue: 0,0:03:29.71,0:03:30.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melihatnya beberapa kali hari ini.
Dialogue: 0,0:03:30.91,0:03:32.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senyum konyol
Dialogue: 0,0:03:33.00,0:03:33.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan seringaimu.
Dialogue: 0,0:03:34.00,0:03:34.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tiba-tiba sadar
Dialogue: 0,0:03:34.92,0:03:36.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jarang melihatmu tertawa lepas.
Dialogue: 0,0:03:40.63,0:03:43.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata puding itu milik kakakku.
Dialogue: 0,0:03:47.01,0:03:48.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tawanya seram sekali.
Dialogue: 0,0:03:48.52,0:03:50.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menguping pembicaraan kami!
Dialogue: 0,0:03:52.64,0:03:54.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teman-temanku sedang datang.
Dialogue: 0,0:03:54.48,0:03:55.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan tertawa seperti itu.
Dialogue: 0,0:03:57.90,0:04:00.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aneh, ya, kalau aku tertawa kecil?
Dialogue: 0,0:04:01.78,0:04:04.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu sedang berusaha jadi cowok\Nkeren yang penyendiri?
Dialogue: 0,0:04:04.16,0:04:05.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, bukan begitu.
Dialogue: 0,0:04:08.49,0:04:12.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena… tawaku terdengar seram.
Dialogue: 0,0:04:13.29,0:04:15.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kamu bisa tahu?
Dialogue: 0,0:04:15.42,0:04:17.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seseorang pernah memberitahuku.
Dialogue: 0,0:04:17.50,0:04:19.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak perempuan di kelasku bergosip.
Dialogue: 0,0:04:20.01,0:04:22.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bermula saat SD.
Dialogue: 0,0:04:22.88,0:04:26.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi punya kebiasaan untuk menahannya.
Dialogue: 0,0:04:26.64,0:04:29.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, kenapa aku…
Dialogue: 0,0:04:29.18,0:04:30.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak SD?
Dialogue: 0,0:04:31.10,0:04:32.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sudah berakar lama.
Dialogue: 0,0:04:32.94,0:04:34.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi itu kan sudah bertahun-tahun yang lalu.
Dialogue: 0,0:04:37.11,0:04:38.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu terdengar sangat jahat.
Dialogue: 0,0:04:39.69,0:04:41.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu artinya setiap kali kamu ingin tertawa,
Dialogue: 0,0:04:41.74,0:04:43.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kenangan enggak menyenangkan itu\Nterlintas di benakmu.
Dialogue: 0,0:04:44.07,0:04:45.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah itu menyiksa?
Dialogue: 0,0:04:46.03,0:04:48.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, sekarang itu cuma sekadar kebiasaan.
Dialogue: 0,0:04:48.87,0:04:49.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan masalah besar, kok.
Dialogue: 0,0:04:50.04,0:04:51.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitukah?
Dialogue: 0,0:04:53.96,0:04:57.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa juga aku harus menceritakan semua itu?
Dialogue: 0,0:04:57.92,0:05:00.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih enggak mengerti\Napa itu "tawa seram".
Dialogue: 0,0:05:01.05,0:05:03.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah lebih baik\Njika semua orang tertawa lepas secara normal?
Dialogue: 0,0:05:03.26,0:05:04.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan itu.
Dialogue: 0,0:05:05.13,0:05:07.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang tega mengatakan hal seperti itu?
Dialogue: 0,0:05:07.30,0:05:09.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu Nabe, dia pasti akan\Nmelempari mereka dengan batu bata.
Dialogue: 0,0:05:09.51,0:05:11.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia pernah melakukan itu?
Dialogue: 0,0:05:13.85,0:05:15.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, keretanya pun ikut marah.
Dialogue: 0,0:05:15.73,0:05:17.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:05:17.65,0:05:20.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang baru saja menekan tombol darurat.
Dialogue: 0,0:05:20.36,0:05:21.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keretanya akan berhenti.
Dialogue: 0,0:05:22.11,0:05:23.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu serius?
Dialogue: 0,0:05:24.99,0:05:26.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Azuma, kamu masuk kerja hari ini?
Dialogue: 0,0:05:26.66,0:05:28.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak hari ini.
Dialogue: 0,0:05:34.66,0:05:35.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada lagi?
Dialogue: 0,0:05:35.71,0:05:37.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu enggak punya unek-unek lain?
Dialogue: 0,0:05:37.25,0:05:38.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin kamu punya.\NCeritakan saja.
Dialogue: 0,0:05:38.92,0:05:40.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan berasumsi begitu.
Dialogue: 0,0:05:40.13,0:05:41.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa denganmu tiba-tiba?
Dialogue: 0,0:05:42.71,0:05:43.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taira, kamu…
Dialogue: 0,0:05:44.34,0:05:48.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kamu yang membelaku sebelumnya,\Ndan bilang cuma aku yang menderita?
Dialogue: 0,0:05:50.85,0:05:51.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum kamu mengatakan itu,
Dialogue: 0,0:05:52.06,0:05:56.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tak pernah memikirkannya.
Dialogue: 0,0:05:56.10,0:05:59.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi mendengarmu bicara begitu,\Nsepertinya kamu benar.
Dialogue: 0,0:06:00.19,0:06:02.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah memikirkannya kembali,
Dialogue: 0,0:06:02.15,0:06:04.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku mulai menyadari ada hal-hal
Dialogue: 0,0:06:04.99,0:06:07.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang enggak bisa kulepaskan begitu saja.
Dialogue: 0,0:06:07.95,0:06:09.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa jauh lebih lega sekarang.
Dialogue: 0,0:06:12.41,0:06:14.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah rasanya kita sudah bergerak maju?
Dialogue: 0,0:06:14.37,0:06:16.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, apa yang sedang kita bicarakan?
Dialogue: 0,0:06:16.50,0:06:18.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu enggak masuk akal.
Dialogue: 0,0:06:18.50,0:06:20.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong…
Dialogue: 0,0:06:20.50,0:06:22.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang giliranku mendengarkan ceritamu.
Dialogue: 0,0:06:22.79,0:06:24.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kesimpulan yang cukup sembarangan.
Dialogue: 0,0:06:25.88,0:06:27.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menghargai niat baikmu.
Dialogue: 0,0:06:28.05,0:06:29.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitukah?
Dialogue: 0,0:06:29.09,0:06:30.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:06:30.26,0:06:31.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama-sama.
Dialogue: 0,0:06:33.93,0:06:35.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keretanya bergerak.
Dialogue: 0,0:06:45.98,0:06:47.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh aku tidur sebentar?
Dialogue: 0,0:06:47.95,0:06:50.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bangunkan aku saat kita tiba di stasiun.
Dialogue: 0,0:06:53.53,0:06:55.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaan bergerak maju…
Dialogue: 0,0:06:56.12,0:06:57.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berbeda dari sebelumnya,
Dialogue: 0,0:06:57.45,0:07:00.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sekarang aku punya teman-teman\Nyang bisa membuatku bahagia.
Dialogue: 0,0:07:01.28,0:07:04.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya seseorang\Nyang bisa menerima kelemahanku.
Dialogue: 0,0:07:05.34,0:07:09.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berada\Ndi lingkungan seperti itu sekarang.
Dialogue: 0,0:07:09.59,0:07:12.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagiku, itu artinya bergerak maju…
Dialogue: 0,0:07:14.51,0:07:16.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi mungkin juga enggak.
Dialogue: 0,0:07:17.52,0:07:20.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang terlalu banyak berpikir\Ndan mengenang masa lalu
Dialogue: 0,0:07:20.73,0:07:23.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanyalah kebiasaan yang muncul\Ndari pikiranku sendiri.
Dialogue: 0,0:07:23.98,0:07:27.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak berusaha keras\Nuntuk menyelesaikan apa pun.
Dialogue: 0,0:07:28.24,0:07:31.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya kebetulan menemukan\Nsekelompok teman yang hebat.
Dialogue: 0,0:07:31.36,0:07:33.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada intinya, aku belum berubah sama sekali.
Dialogue: 0,0:07:34.66,0:07:36.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menggali masa lalu dengan Azuma
Dialogue: 0,0:07:36.66,0:07:39.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berbeda dengan mencoba mengubah keadaan.
Dialogue: 0,0:07:39.91,0:07:44.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya mencari pembenaran\Nkenapa aku menjadi diriku yang sekarang.
Dialogue: 0,0:07:44.71,0:07:47.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya aku terus mengungkit masa lalu.
Dialogue: 0,0:07:47.80,0:07:50.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua kenangan enggak menyenangkan itu
Dialogue: 0,0:07:50.22,0:07:53.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tersimpan di tempat\Nyang bisa kuingat kapan saja.
Dialogue: 0,0:07:53.43,0:07:55.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya menghubungkannya dalam pikiranku
Dialogue: 0,0:07:55.93,0:07:58.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar aku bisa menerima keadaanku.
Dialogue: 0,0:07:59.43,0:08:01.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menatap luka di hatiku,
Dialogue: 0,0:08:01.94,0:08:04.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan itu terasa seperti melukai diri sendiri.
Dialogue: 0,0:08:04.44,0:08:07.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan aku melakukannya dengan sadar.
Dialogue: 0,0:08:09.36,0:08:13.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya maju, aku malah melangkah mundur.
Dialogue: 0,0:08:15.49,0:08:19.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan aku enggak bisa\Nmenerima diriku yang seperti ini.
Dialogue: 0,0:08:19.95,0:08:23.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana aku bisa berharap\Norang lain akan menerimaku?
Dialogue: 0,0:08:23.25,0:08:26.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku enggak menghentikan\Nkebiasaan menggali masa lalu ini…
Dialogue: 0,0:08:26.79,0:08:29.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemberhentian berikutnya, Stasiun Yamaneko.\NStasiun Yamaneko.
Dialogue: 0,0:08:30.92,0:08:33.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Azuma, kita hampir sampai…
Dialogue: 0,0:08:37.51,0:08:38.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi.
Dialogue: 0,0:08:38.67,0:08:39.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:08:39.97,0:08:41.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:08:41.42,0:08:42.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini?
Dialogue: 0,0:08:43.77,0:08:46.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus menghalangi cahaya\Nagar bisa tidur nyenyak.
Dialogue: 0,0:08:47.65,0:08:51.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, apa yang baru saja kupikirkan?
Dialogue: 0,0:08:52.74,0:08:54.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sendirian,\Naku pasti terlihat mencurigakan.
Dialogue: 0,0:08:54.82,0:08:56.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi enggak apa-apa karena ada kamu di sini.
Dialogue: 0,0:08:56.45,0:08:59.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, dong. Jangan membuatku\Nikut terlihat mencurigakan.
Dialogue: 0,0:09:01.58,0:09:04.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa dianggap sebagai kaki tanganku.
Dialogue: 0,0:09:04.46,0:09:06.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku ini kaki tangan?
Dialogue: 0,0:09:10.42,0:09:11.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tertawa terlalu lama.
Dialogue: 0,0:09:13.30,0:09:16.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma merasa reaksimu sangat lucu.
Dialogue: 0,0:09:18.01,0:09:19.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:09:22.68,0:09:24.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tertular olehku.
Dialogue: 0,0:09:28.94,0:09:31.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu cara tertawa yang unik.
Dialogue: 0,0:09:34.36,0:09:36.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membahas soal bulan Maret, bagian pertama.
Dialogue: 0,0:09:37.11,0:09:38.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Upacara kelulusan.
Dialogue: 0,0:09:38.53,0:09:40.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada dasarnya, kelulusan dan…
Dialogue: 0,0:09:41.20,0:09:44.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak-kakak kelas tiga akan lulus.
Dialogue: 0,0:09:46.79,0:09:49.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bulan Maret selalu terasa agak sepi.
Dialogue: 0,0:09:50.17,0:09:52.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa? Bukankah ini bulan ulang tahunmu?
Dialogue: 0,0:09:52.92,0:09:54.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu benar.
Dialogue: 0,0:09:55.13,0:09:58.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ini juga musim perpisahan\Ndan masa transisi.
Dialogue: 0,0:09:58.80,0:10:01.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kelulusan dan pergantian kelas.
Dialogue: 0,0:10:01.43,0:10:03.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula,, ulang tahunku jatuh\Nsaat liburan musim semi.
Dialogue: 0,0:10:03.93,0:10:05.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:10:05.39,0:10:08.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melihat lantai dua kosong
Dialogue: 0,0:10:08.10,0:10:11.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selalu membuatku agak terharu…
Dialogue: 0,0:10:12.61,0:10:15.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang akhirnya giliran kita\Nmenempati lantai dua tahun depan.
Dialogue: 0,0:10:15.99,0:10:17.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naik tangga akan jadi lebih mudah.
Dialogue: 0,0:10:17.70,0:10:19.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak merasakan hal seperti itu.
Dialogue: 0,0:10:19.95,0:10:21.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:10:21.91,0:10:22.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu paham, 'kan?
Dialogue: 0,0:10:24.37,0:10:25.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba ulangi.
Dialogue: 0,0:10:28.58,0:10:31.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membahas soal bulan Maret, bagian kedua.
Dialogue: 0,0:10:31.59,0:10:32.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, waktu habis.
Dialogue: 0,0:10:32.79,0:10:34.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oper lembar jawaban kalian ke depan.
Dialogue: 0,0:10:34.55,0:10:35.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu yang di sana, berhenti menulis.
Dialogue: 0,0:10:39.01,0:10:41.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujian akhir.
Dialogue: 0,0:10:41.14,0:10:43.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habislah sudah.
Dialogue: 0,0:10:44.43,0:10:48.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak hal yang akan segera berakhir.\NRasanya agak sepi.
Dialogue: 0,0:10:48.81,0:10:52.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang ujian sudah kelar,\Ntapi aku sedih soal pergantian kelas.
Dialogue: 0,0:10:53.77,0:10:54.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu jujur sekali.
Dialogue: 0,0:10:55.03,0:10:57.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya aku punya teman baik, jadi…
Dialogue: 0,0:10:57.78,0:10:58.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu termasuk aku, 'kan?
Dialogue: 0,0:10:58.99,0:11:00.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu lain cerita.
Dialogue: 0,0:11:02.37,0:11:04.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan malah malu setelah\Nmembahasnya sendiri.
Dialogue: 0,0:11:10.92,0:11:12.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini… hadiah White Day.
Dialogue: 0,0:11:12.58,0:11:14.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hore!
Dialogue: 0,0:11:14.75,0:11:17.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih! Boleh kubuka?
Dialogue: 0,0:11:21.22,0:11:24.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memilihnya karena kelihatannya\Nseperti sesuatu yang akan kamu sukai.
Dialogue: 0,0:11:24.85,0:11:26.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat menyukainya!
Dialogue: 0,0:11:26.22,0:11:28.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manis sekali! Aku senang sekali!
Dialogue: 0,0:11:28.57,0:11:29.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya,
Dialogue: 0,0:11:29.56,0:11:30.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku enggak tahu
Dialogue: 0,0:11:30.48,0:11:31.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seperti apa rasa permen di dalamnya.
Dialogue: 0,0:11:31.52,0:11:34.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang biasanya seperti itu.
Dialogue: 0,0:11:34.57,0:11:39.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membayangkanmu memilih ini di toko,\Naku enggak bisa berhenti tersenyum.
Dialogue: 0,0:11:39.28,0:11:40.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan.
Dialogue: 0,0:11:42.07,0:11:43.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang lain juga, lo!
Dialogue: 0,0:11:43.99,0:11:45.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini permen!
Dialogue: 0,0:11:45.74,0:11:48.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu membelikanku dua hadiah? Terima kasih!
Dialogue: 0,0:11:48.37,0:11:49.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keduanya dari toko yang sama?
Dialogue: 0,0:11:49.87,0:11:51.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, aku memilih permennya belakangan.
Dialogue: 0,0:11:58.55,0:12:00.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kamu enggak perlu repot-repot…
Dialogue: 0,0:12:00.30,0:12:01.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk mencari tahu artinya.
Dialogue: 0,0:12:01.68,0:12:02.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengarkan aku.
Dialogue: 0,0:12:02.59,0:12:04.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar-benar malu, ya.
Dialogue: 0,0:12:05.51,0:12:08.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, aku enggak tahu\Nkamu sampai mencari tahu soal ini.
Dialogue: 0,0:12:23.41,0:12:24.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:12:24.74,0:12:25.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:12:26.45,0:12:27.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak menyangka kamu
Dialogue: 0,0:12:27.78,0:12:29.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan datang dari arah sana.
Dialogue: 0,0:12:29.16,0:12:31.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya kalau aku lewat jalan yang sama,
Dialogue: 0,0:12:31.16,0:12:33.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku merasa akan menyusul terlalu cepat.
Dialogue: 0,0:12:33.83,0:12:35.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu rupanya.
Dialogue: 0,0:12:35.58,0:12:38.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar, hari ini mereka mengembalikan\Nsemua kertas ujian.
Dialogue: 0,0:12:38.63,0:12:41.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutmu itu kabar baik atau buruk?
Dialogue: 0,0:12:41.55,0:12:43.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini…
Dialogue: 0,0:12:43.09,0:12:44.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu terlalu mudah ditebak.
Dialogue: 0,0:12:44.93,0:12:46.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabar baik!
Dialogue: 0,0:12:46.30,0:12:47.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!
Dialogue: 0,0:12:47.93,0:12:50.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak perlu tinggal kelas.\NAku resmi naik kelas!
Dialogue: 0,0:12:51.85,0:12:53.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bagus! Itu kabar yang sangat bagus!
Dialogue: 0,0:12:53.81,0:12:57.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bingung harus bagaimana\Nkalau kamu sampai jadi adik kelasku.
Dialogue: 0,0:12:57.11,0:12:58.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hampir saja.
Dialogue: 0,0:12:58.77,0:13:02.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak bisa membayangkan\Nharus melihat semua orang lulus.
Dialogue: 0,0:13:02.32,0:13:06.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kelulusan, kita harus berfoto bersama\Nsambil memegang tabung ijazah.
Dialogue: 0,0:13:10.54,0:13:12.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar.
Dialogue: 0,0:13:13.33,0:13:15.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, hadiah White Day untukmu.
Dialogue: 0,0:13:15.29,0:13:17.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakakku kadang membeli ini.
Dialogue: 0,0:13:17.21,0:13:18.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sangat enak, lo.
Dialogue: 0,0:13:18.25,0:13:19.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin kamu mencobanya.
Dialogue: 0,0:13:19.88,0:13:21.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajahmu merah sekali!
Dialogue: 0,0:13:22.71,0:13:25.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bahkan belum membayangkan\Nakan seperti apa setahun dari sekarang.
Dialogue: 0,0:13:25.72,0:13:27.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, wajar kalau aku terkejut.
Dialogue: 0,0:13:28.97,0:13:31.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari naik kelas dengan lancar,\Njangan cuma pas-pasan.
Dialogue: 0,0:13:33.85,0:13:35.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}White Day…
Dialogue: 0,0:13:35.44,0:13:38.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat terkejut kamu dan Tani\Nsudah menyiapkan hadiah balasan.
Dialogue: 0,0:13:39.15,0:13:40.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yamada enggak masuk hitungan.
Dialogue: 0,0:13:40.69,0:13:42.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, jangan bicara terlalu blak-blakan.
Dialogue: 0,0:13:42.99,0:13:44.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku secara kepribadian.
Dialogue: 0,0:13:44.86,0:13:46.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sama sekali enggak menghibur, tahu.
Dialogue: 0,0:13:48.07,0:13:50.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sejujurnya, dengan adanya ujian,
Dialogue: 0,0:13:50.41,0:13:51.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku hampir saja lupa.
Dialogue: 0,0:13:52.79,0:13:54.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti. Aku juga begitu.
Dialogue: 0,0:13:54.41,0:13:58.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tani dan aku enggak merencanakan ini berdua.
Dialogue: 0,0:13:58.42,0:14:00.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beda denganku, aku cuma membawa ini
Dialogue: 0,0:14:00.34,0:14:02.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}supaya aku bukan\Nsatu-satunya yang enggak bawa apa-apa.
Dialogue: 0,0:14:02.63,0:14:04.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia ingat persis berapa banyak yang dia dapat.
Dialogue: 0,0:14:04.30,0:14:05.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia jauh lebih jeli soal itu.
Dialogue: 0,0:14:05.76,0:14:08.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu enggak perlu merendahkan dirimu sendiri.
Dialogue: 0,0:14:08.59,0:14:10.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi wajah sombong Suzuki tadi
Dialogue: 0,0:14:10.51,0:14:11.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sangat lucu.
Dialogue: 0,0:14:11.97,0:14:14.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah seharusnya dia cemburu?
Dialogue: 0,0:14:14.35,0:14:15.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sungguh enggak mengerti.
Dialogue: 0,0:14:27.36,0:14:28.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Azuma.
Dialogue: 0,0:14:30.57,0:14:33.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, ini untukmu.
Dialogue: 0,0:14:36.62,0:14:37.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bolehkah aku mengambil semua ini?
Dialogue: 0,0:14:37.87,0:14:39.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa? Ini hadiah ekstra?
Dialogue: 0,0:14:41.08,0:14:45.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah banyak membantuku\Nsejak tahun pertama kita.
Dialogue: 0,0:14:45.76,0:14:49.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru mulai menyadarinya belakangan ini.
Dialogue: 0,0:14:49.09,0:14:53.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin agak aneh kalau aku tiba-tiba\Nberterima kasih untuk semua itu sekarang.
Dialogue: 0,0:14:54.10,0:14:55.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini…
Dialogue: 0,0:14:56.81,0:15:00.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma ingin melakukan ini.
Dialogue: 0,0:15:05.23,0:15:09.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berterima kasih\Nitu bukan soal pendapat orang lain,
Dialogue: 0,0:15:09.28,0:15:12.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}melainkan tentang menyalurkan\Nperasaanmu sendiri.
Dialogue: 0,0:15:13.12,0:15:14.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maret.
Dialogue: 0,0:15:14.83,0:15:17.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana ada akhir, pasti ada awal.
Dialogue: 0,0:15:17.96,0:15:21.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perpaduan antara\Nrasa kesepian dan antusiasme.
Dialogue: 0,0:15:21.79,0:15:24.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya terlihat sama,\Ntapi entah kenapa terasa berbeda.
Dialogue: 0,0:15:25.17,0:15:28.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di awal musim semi seperti ini…
Dialogue: 0,0:15:29.38,0:15:30.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunga-bunga akan segera bermekaran!
Dialogue: 0,0:15:34.01,0:15:35.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hari terakhir kita.
Dialogue: 0,0:15:35.56,0:15:37.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaan apa ini?
Dialogue: 0,0:15:37.52,0:15:38.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manis getir?
Dialogue: 0,0:15:38.43,0:15:39.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:15:39.35,0:15:41.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin mengelus kucingnya Tani.
Dialogue: 0,0:15:41.73,0:15:43.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu enggak ada hubungannya sama sekali\Ndengan nilai kita.
Dialogue: 0,0:15:43.69,0:15:44.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami boleh main ke rumahmu?
Dialogue: 0,0:15:44.90,0:15:45.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:15:45.82,0:15:46.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau ikut!
Dialogue: 0,0:15:47.07,0:15:50.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi takut melihat rapor kita.
Dialogue: 0,0:15:50.20,0:15:51.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua pasti akan baik-baik saja.
Dialogue: 0,0:15:52.24,0:15:54.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menonton SudaKen kemarin?
Dialogue: 0,0:15:54.41,0:15:55.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu yang di drama itu?
Dialogue: 0,0:15:55.45,0:15:56.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:15:56.37,0:15:57.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melihatnya di iklan promo.
Dialogue: 0,0:15:57.91,0:15:59.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melihatnya di promo acara itu.
Dialogue: 0,0:15:59.08,0:16:01.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu enggak dihitung\Nsebagai menontonnya, tahu.
Dialogue: 0,0:16:01.46,0:16:03.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibuku menyukainya,\Njadi kami menontonnya bersama di rumah.
Dialogue: 0,0:16:03.46,0:16:05.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Azumama!
Dialogue: 0,0:16:05.50,0:16:09.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya, aku suka SudaKen\Nsaat memerankan karakter berandalan itu.
Dialogue: 0,0:16:09.67,0:16:11.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, 'kan?
Dialogue: 0,0:16:11.34,0:16:13.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagian "lihat aku saja" itu keren sekali.
Dialogue: 0,0:16:13.72,0:16:14.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar banget!
Dialogue: 0,0:16:15.18,0:16:17.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa aku kurang suka cowok seperti itu.
Dialogue: 0,0:16:17.14,0:16:18.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga kamu akan bilang begitu.
Dialogue: 0,0:16:18.68,0:16:22.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang sangat suka cowok tipe dominan.
Dialogue: 0,0:16:22.35,0:16:23.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sama sekali belum berubah.
Dialogue: 0,0:16:25.19,0:16:27.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, Naoya enggak sekadar bersikap tegas.
Dialogue: 0,0:16:27.69,0:16:29.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa lalu dan kebaikan hatinya
Dialogue: 0,0:16:29.69,0:16:31.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itulah yang membuatnya terlihat keren.
Dialogue: 0,0:16:31.65,0:16:32.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan cuma itu…
Dialogue: 0,0:16:32.61,0:16:33.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sudah hari terakhir kita.
Dialogue: 0,0:16:33.61,0:16:35.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kalian sedang bahas apa?\N- Kamu mengerti bagian mana yang bikin dia hebat?
Dialogue: 0,0:16:35.95,0:16:39.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada intinya,\Nliburan musim semi adalah tentang…
Dialogue: 0,0:16:39.87,0:16:43.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, terima kasih atas\Nkerja keras kalian selama satu tahun ini.
Dialogue: 0,0:16:43.58,0:16:45.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hari terakhir kita.\NBukankah itu terasa terlalu singkat?
Dialogue: 0,0:16:50.59,0:16:53.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai penutup, aku akan memotret\Nkalian berdua yang sedang duduk bersama.
Dialogue: 0,0:16:54.01,0:16:55.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:16:55.93,0:16:59.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dipikir-pikir, tempat duduk kita\Nbelum pernah diubah sejak musim panas lalu.
Dialogue: 0,0:16:59.64,0:17:01.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sampai lupa soal itu.
Dialogue: 0,0:17:01.31,0:17:02.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:17:02.27,0:17:04.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pak Guru, ayo kita berfoto bersama.
Dialogue: 0,0:17:04.94,0:17:06.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senyum!
Dialogue: 0,0:17:07.56,0:17:08.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekspresimu datar sekali.
Dialogue: 0,0:17:16.81,0:17:18.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa.\NKami mau pergi kegiatan ekstrakurikuler.
Dialogue: 0,0:17:18.95,0:17:20.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga lancar.
Dialogue: 0,0:17:20.54,0:17:21.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dah.
Dialogue: 0,0:17:22.45,0:17:24.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang mulai beranjak pulang.
Dialogue: 0,0:17:24.86,0:17:28.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepi sekali. Aku masih ingin kumpul bareng.
Dialogue: 0,0:17:29.46,0:17:31.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang lagi senggang sehabis ini?
Dialogue: 0,0:17:33.30,0:17:34.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita bikin foto stiker bareng!
Dialogue: 0,0:17:34.97,0:17:36.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa muat untuk orang sebanyak ini?
Dialogue: 0,0:17:36.22,0:17:38.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada arkade yang sepi di dekat stasiun,
Dialogue: 0,0:17:38.35,0:17:40.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukankah di sana ada bilik foto\Nuntuk grup besar?
Dialogue: 0,0:17:40.39,0:17:42.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bikin nostalgia! Apa namanya?
Dialogue: 0,0:17:43.06,0:17:44.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taira, kamu masuk kerja hari ini?
Dialogue: 0,0:17:44.64,0:17:45.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak,
Dialogue: 0,0:17:45.56,0:17:46.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}enggak hari ini.
Dialogue: 0,0:17:49.73,0:17:51.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panas sekali!
Dialogue: 0,0:17:51.19,0:17:53.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah ini terlalu sumpek?
Dialogue: 0,0:17:53.40,0:17:56.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiga, dua, satu!
Dialogue: 0,0:18:03.00,0:18:04.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sedang kamu lihat?
Dialogue: 0,0:18:04.66,0:18:05.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini…
Dialogue: 0,0:18:06.29,0:18:08.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi kan bilik stiker foto,\Ntapi dia malah mengirimiku video.
Dialogue: 0,0:18:08.96,0:18:10.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aneh sekali.
Dialogue: 0,0:18:10.29,0:18:11.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah itu yang kamu perhatikan?
Dialogue: 0,0:18:11.75,0:18:12.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa masalahnya?
Dialogue: 0,0:18:12.84,0:18:15.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menang suwit dan mendapatkan stikernya.
Dialogue: 0,0:18:15.13,0:18:18.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak protes\Nkarena aku sangat menginginkan stikernya.
Dialogue: 0,0:18:22.01,0:18:24.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bilang begitu, tapi kamu\Nmenyimpannya dengan sangat hati-hati.
Dialogue: 0,0:18:46.79,0:18:48.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahun kedua sudah usai.
Dialogue: 0,0:18:58.97,0:18:59.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dah.
Dialogue: 0,0:18:59.97,0:19:01.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini…
Dialogue: 0,0:19:02.35,0:19:03.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau makan dulu?
Dialogue: 0,0:19:06.31,0:19:09.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya aku sedang lapar...
Dialogue: 0,0:19:09.69,0:19:12.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja,\Naku ingin berada di sini sedikit lebih lama.
Dialogue: 0,0:19:13.07,0:19:15.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum ingin pulang.
Dialogue: 0,0:19:18.90,0:19:19.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:19:24.20,0:19:25.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meja untuk dua orang? Mari lewat sini.
Dialogue: 0,0:19:27.62,0:19:28.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu dengan, "Aku mengerti"?
Dialogue: 0,0:19:29.04,0:19:31.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa sudah melontarkan kata-kata aneh.
Dialogue: 0,0:19:32.33,0:19:34.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun kita sudah di sini…
Dialogue: 0,0:19:39.88,0:19:41.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dekat dengan rumahku…
Dialogue: 0,0:19:41.89,0:19:43.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuharap aku enggak berpapasan dengan\Norang yang aku kenal.
Dialogue: 0,0:19:43.47,0:19:45.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa memangnya?\NAda seseorang yang kamu blokir di sini?
Dialogue: 0,0:19:45.93,0:19:47.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bicara begitu.
Dialogue: 0,0:19:47.56,0:19:49.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, bukan begitu alasannya.
Dialogue: 0,0:19:49.39,0:19:52.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersikaplah lebih percaya diri,\Nsekalipun ada orang yang melihatmu.
Dialogue: 0,0:19:52.15,0:19:54.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak perlu setakut itu.
Dialogue: 0,0:19:54.36,0:19:56.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa kamu benar.
Dialogue: 0,0:19:56.86,0:19:58.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat aku saja.
Dialogue: 0,0:20:00.24,0:20:03.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku terdengar seperti SudaKen\Ndari drama kemarin, ya.
Dialogue: 0,0:20:03.74,0:20:05.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf kalau aku malah\Nmembuat jantungmu berdebar.
Dialogue: 0,0:20:05.20,0:20:06.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, kok.
Dialogue: 0,0:20:06.66,0:20:07.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak sama sekali.
Dialogue: 0,0:20:07.91,0:20:09.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah merasa baikan sekarang.
Dialogue: 0,0:20:10.62,0:20:11.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:20:11.54,0:20:12.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru sadar…
Dialogue: 0,0:20:12.50,0:20:14.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus berhenti merisaukan hal
Dialogue: 0,0:20:14.63,0:20:17.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang enggak akan bisa diubah.
Dialogue: 0,0:20:17.55,0:20:20.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau enggak,\Naku hanya akan membuat masalah baru.
Dialogue: 0,0:20:20.67,0:20:22.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sama sekali enggak ada gunanya…
Dialogue: 0,0:20:22.47,0:20:24.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Permisi!\N- Hei!
Dialogue: 0,0:20:24.51,0:20:26.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf. Aku menyimak, kok.
Dialogue: 0,0:20:26.76,0:20:28.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sama sekali\Nenggak kelihatan sedang menyimak.
Dialogue: 0,0:20:29.06,0:20:30.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, enggak apa-apa\Nkalaupun kamu enggak menyimak.
Dialogue: 0,0:20:31.81,0:20:34.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa enggak ada staf pelayan\Ndi tempat ini.
Dialogue: 0,0:20:34.56,0:20:35.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mereka kekurangan staf?
Dialogue: 0,0:20:41.95,0:20:43.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada tablet pemesanan di sini, lo.
Dialogue: 0,0:20:44.07,0:20:47.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,\Nkamu sudah cukup lama mengangkat tangan.
Dialogue: 0,0:20:47.62,0:20:50.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya, kamu tinggal menekan tombol\Npanggil saja.
Dialogue: 0,0:20:51.21,0:20:52.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar. Memalukan sekali.
Dialogue: 0,0:20:54.54,0:20:56.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, apanya yang lucu soal itu?
Dialogue: 0,0:20:56.17,0:20:57.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan tiba-tiba berubah jadi serius.
Dialogue: 0,0:21:14.65,0:21:15.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dah.
Dialogue: 0,0:21:15.94,0:21:16.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:21:20.94,0:21:22.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:21:22.49,0:21:25.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada hal yang mengganggumu\Nsaat di kelas baru nanti,
Dialogue: 0,0:21:25.91,0:21:27.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku siap mendengarkan semua keluh kesahmu.
Dialogue: 0,0:21:28.87,0:21:31.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maukah kamu bersedia mendengarkanku lagi?
Dialogue: 0,0:21:37.75,0:21:39.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat menghargainya.
Dialogue: 0,0:21:39.96,0:21:41.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa wajahmu jadi seperti itu?
Dialogue: 0,0:21:41.92,0:21:44.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajahku memang dari sananya begini.
Dialogue: 0,0:21:47.55,0:21:51.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sama sekali enggak mau\Nsampai putus kontak denganmu.
Dialogue: 0,0:21:54.89,0:21:55.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun
Dialogue: 0,0:21:55.81,0:21:57.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia sama sekali
Dialogue: 0,0:21:57.10,0:21:58.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukan tipe cowok idamanku.
Dialogue: 0,0:22:00.65,0:22:02.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku jadi sering mencemaskannya.
Dialogue: 0,0:22:02.53,0:22:04.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku dia cowok yang merepotkan.
Dialogue: 0,0:22:04.24,0:22:06.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku merasa lebih santai saat bersamanya\Nketimbang dengan orang lain.
Dialogue: 0,0:22:07.36,0:22:09.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ada jarak di antara kami,\Naku merasa kesepian.
Dialogue: 0,0:22:09.99,0:22:12.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat dia ada di dekatku, aku merasa bahagia.
Dialogue: 0,0:22:18.71,0:22:22.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaan gelisah yang menyelimutiku saat ini…
Dialogue: 0,0:22:31.35,0:22:33.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya apa arti perasaan ini?
