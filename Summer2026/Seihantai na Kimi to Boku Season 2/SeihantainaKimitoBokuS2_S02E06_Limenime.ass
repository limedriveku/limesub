Dialogue: 0,0:12:29.16,0:12:31.08,sign,,0000,0000,0000,,"DUGAAN"
Dialogue: 0,0:13:58.42,0:14:00.25,sign,,0000,0000,0000,,"BINGKISAN BISKUIT DAN PERMEN"
Dialogue: 0,0:14:02.63,0:14:04.21,sign,,0000,0000,0000,,"PILIHAN TANI: SENBEI"
Dialogue: 0,0:14:08.59,0:14:10.43,sign,,0000,0000,0000,,"BICARA SOMBONG: ITU BENAR"
Dialogue: 0,0:14:10.51,0:14:11.89,sign,,0000,0000,0000,,"DIA ORANG YANG MENGHARGAI HUBUNGAN…"
Dialogue: 0,0:14:11.97,0:14:14.27,sign,,0000,0000,0000,,"JANGAN BERGAYA SEPERTI VETERAN."
Dialogue: 0,0:14:36.62,0:14:37.79,sign,,0000,0000,0000,,"PADAHAL AKU CUMA MEMBERIMU SATU PERMEN KARET…"
Dialogue: 0,0:15:50.20,0:15:51.91,sign,,0000,0000,0000,,"KITA AKAN TETAP NAIK KELAS"
Dialogue: 0,0:16:03.46,0:16:05.09,sign,,0000,0000,0000,,"SUDAH KUDUGA DARI SEORANG CEWEK"
Dialogue: 0,0:16:27.69,0:16:29.61,sign,,0000,0000,0000,,"NAOYA = KARAKTER SUDAKEN"
Dialogue: 0,0:17:33.30,0:17:34.88,sign,,0000,0000,0000,,"OBROLAN BERISIK"
Dialogue: 0,0:17:44.64,0:17:45.48,sign,,0000,0000,0000,,"DIA SENGGANG HARI INI"
Dialogue: 0,0:17:45.56,0:17:46.40,sign,,0000,0000,0000,,"MENGIRA AKAN ADA RENCANA"
