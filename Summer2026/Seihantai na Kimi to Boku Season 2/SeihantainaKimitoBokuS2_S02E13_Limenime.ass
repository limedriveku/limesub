Dialogue: 0,0:02:26.93,0:02:28.85,sign,,0000,0000,0000,,MUSIM SEMI, KELAS 2 SMA
Dialogue: 0,0:02:46.45,0:02:48.20,sign,,0000,0000,0000,,"AKU ENGGAK BISA DIAM SAJA"
Dialogue: 0,0:02:54.17,0:02:55.29,sign,,0000,0000,0000,,"DINGINNYA"
Dialogue: 0,0:03:22.90,0:03:24.78,sign,,0000,0000,0000,,"MEMANGNYA ADA KEJADIAN APA?"
Dialogue: 0,0:03:27.28,0:03:28.12,sign,,0000,0000,0000,,"BAGUSLAH KALAU BEGITU…"
Dialogue: 0,0:03:29.70,0:03:31.33,sign,,0000,0000,0000,,KEMBALI SANTAI
Dialogue: 0,0:04:19.20,0:04:20.05,sign,,0000,0000,0000,,"SEDANG ENGGAK MEMIKIRKAN APA-APA…"
Dialogue: 0,0:04:42.69,0:04:44.36,sign,,0000,0000,0000,,"MELIRIK KE ARAH SANA"
Dialogue: 0,0:05:29.78,0:05:32.24,sign,,0000,0000,0000,,LAMBAT LAUN
Dialogue: 0,0:05:34.24,0:05:36.71,sign,,0000,0000,0000,,"ADA ANGIN APA?"
Dialogue: 0,0:06:10.07,0:06:11.36,sign,,0000,0000,0000,,"BALL?"
Dialogue: 0,0:06:23.59,0:06:24.50,sign,,0000,0000,0000,,"RESPONS INSTAN"
Dialogue: 0,0:06:49.61,0:06:50.90,sign,,0000,0000,0000,,"KENAPA TIBA-TIBA MENUDUH BEGITU?"
Dialogue: 0,0:06:51.82,0:06:52.66,sign,,0000,0000,0000,,"HMPH…"
Dialogue: 0,0:07:27.90,0:07:29.28,sign,,0000,0000,0000,,"OBROLAN BERISIK"
Dialogue: 0,0:07:29.36,0:07:30.69,sign,,0000,0000,0000,,"AHAHA"
Dialogue: 0,0:07:30.78,0:07:33.07,sign,,0000,0000,0000,,"MEREKA HANYA INGIN MEMBUAT RAMAI SAJA…"
Dialogue: 0,0:08:05.52,0:08:07.48,sign,,0000,0000,0000,,"INI AGAK MEMBUAT MERINDING…"
Dialogue: 0,0:08:17.70,0:08:20.08,sign,,0000,0000,0000,,"300 YEN"
Dialogue: 0,0:08:49.48,0:08:52.82,sign,,0000,0000,0000,,"JRENG"
Dialogue: 0,0:09:13.17,0:09:15.38,sign,,0000,0000,0000,,PERPUSTAKAAN
Dialogue: 0,0:11:31.77,0:11:32.77,sign,,0000,0000,0000,,SENTUH
Dialogue: 0,0:12:41.55,0:12:42.71,sign,,0000,0000,0000,,LAMBAT LAUN
Dialogue: 0,0:13:28.43,0:13:31.23,sign,,0000,0000,0000,,MENDENGKUR\NSEMENTARA ITU, SUZUKI
Dialogue: 0,0:14:28.03,0:14:30.33,sign,,0000,0000,0000,,BUKAN KOK, ITU HANYA SALAH PAHAM SAJA.
Dialogue: 0,0:15:25.13,0:15:26.22,sign,,0000,0000,0000,,KAGET
Dialogue: 0,0:17:32.09,0:17:33.39,sign,,0000,0000,0000,,PANGGILAN MASUK: SUZUKI MIYU
Dialogue: 0,0:17:35.43,0:17:38.31,sign,,0000,0000,0000,,MEJA LESEHAN
Dialogue: 0,0:18:17.85,0:18:21.06,sign,,0000,0000,0000,,FESTIVAL KEMBANG API
Dialogue: 0,0:00:10.36,0:00:11.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan tepatnya
Dialogue: 0,0:00:12.90,0:00:14.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pertama kali aku menyadari perasaan ini?
Dialogue: 0,0:00:15.61,0:00:19.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur saja,\Naku masih tak bisa mengingatnya dengan jelas.
Dialogue: 0,0:00:36.30,0:00:46.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}You and I Are Polar Opposites\NSeason 2
Dialogue: 0,0:02:06.58,0:02:08.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi, Yu.
Dialogue: 0,0:02:08.33,0:02:09.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pagi.
Dialogue: 0,0:02:28.93,0:02:30.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka serasi sekali, tahu.
Dialogue: 0,0:02:30.89,0:02:32.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa, sih?
Dialogue: 0,0:02:32.15,0:02:33.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa biasa saja.
Dialogue: 0,0:02:33.56,0:02:36.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak mungkin, pasti ada orang di luar sana\Nyang setuju dengan pendapatku.
Dialogue: 0,0:02:36.90,0:02:38.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menurutmu bagaimana, Tani?
Dialogue: 0,0:02:38.28,0:02:39.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:02:39.99,0:02:42.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku tadi enggak menyimak.
Dialogue: 0,0:02:42.32,0:02:44.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak apa-apa, santai saja.
Dialogue: 0,0:02:44.28,0:02:46.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah, jangan ajak-ajak dia\Nuntuk membahas hal seperti ini.
Dialogue: 0,0:02:46.45,0:02:48.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya, aku pikir kita ini akrab,
Dialogue: 0,0:02:48.29,0:02:49.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi dia pasti bisa dengar obrolan kita.
Dialogue: 0,0:02:49.70,0:02:52.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa dia tetap enggak akan dengar\Nwalaupun kita bicara sekencang ini.
Dialogue: 0,0:02:52.17,0:02:54.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dia hanya menganggap omongan kita\Nseperti suara angin lalu saja.
Dialogue: 0,0:02:54.17,0:02:55.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu berani sekali bicara begitu.
Dialogue: 0,0:02:55.38,0:02:57.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa, sih? Memangnya kenapa?
Dialogue: 0,0:02:58.13,0:03:00.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya aku sengaja menghindari\Nteman-teman di sekitarku
Dialogue: 0,0:03:01.01,0:03:02.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau berusaha menolak kehadiran mereka.
Dialogue: 0,0:03:03.76,0:03:06.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma enggak tertarik saja.
Dialogue: 0,0:03:08.56,0:03:09.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tani!
Dialogue: 0,0:03:11.85,0:03:12.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini,
Dialogue: 0,0:03:12.89,0:03:14.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanaka dan Takahashi
Dialogue: 0,0:03:14.81,0:03:16.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu tadi bukannya sedang\Nbertengkar sungguhan.
Dialogue: 0,0:03:16.48,0:03:19.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berdua memang selalu\Nseperti itu kelakuannya.
Dialogue: 0,0:03:19.53,0:03:22.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya, kamu enggak perlu khawatir.
Dialogue: 0,0:03:22.90,0:03:24.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia ini sedang membicarakan apa, sih?
Dialogue: 0,0:03:24.87,0:03:25.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak usah dipikirkan.
Dialogue: 0,0:03:25.78,0:03:26.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak memikirkan apa-apa.
Dialogue: 0,0:03:27.28,0:03:28.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu, ya?
Dialogue: 0,0:03:28.20,0:03:29.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baguslah kalau begitu.
Dialogue: 0,0:03:36.17,0:03:37.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia jauh-jauh menghampiriku\Ncuma untuk mengatakan itu saja?
Dialogue: 0,0:03:38.42,0:03:39.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk apa, coba?
Dialogue: 0,0:03:41.67,0:03:43.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Nayo kita berangkat sepulang sekolah nanti.
Dialogue: 0,0:03:44.01,0:03:45.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:03:45.68,0:03:47.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior di tempat kerja\Nparuh waktuku kemarin...
Dialogue: 0,0:03:47.93,0:03:49.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang bekerja di kedai ramen itu?
Dialogue: 0,0:03:49.35,0:03:50.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, yang itu.
Dialogue: 0,0:03:50.85,0:03:52.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konsernya sebentar lagi mulai, kan?
Dialogue: 0,0:03:52.73,0:03:53.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari Sabtu besok.
Dialogue: 0,0:03:53.94,0:03:55.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah enggak sabar sekali!
Dialogue: 0,0:03:55.44,0:03:58.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagian saat balik kartunya selalu\Nbikin tertawa walau ditonton berkali-kali.
Dialogue: 0,0:03:58.52,0:04:00.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu suka sekali\Nmenonton stand-up comedy, ya.
Dialogue: 0,0:04:00.44,0:04:01.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kan komika yang menang sebelumnya?
Dialogue: 0,0:04:02.07,0:04:02.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar sekali!
Dialogue: 0,0:04:02.99,0:04:04.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Waktu itu aku menonton...\N- Serius?
Dialogue: 0,0:04:05.74,0:04:06.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tani!
Dialogue: 0,0:04:07.20,0:04:10.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi Yamada agak menyeramkan\Nsaat di kelas memasak.
Dialogue: 0,0:04:11.54,0:04:13.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, cara memotongmu jangan seperti itu!
Dialogue: 0,0:04:13.33,0:04:14.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat ini, jarinya ditekuk.
Dialogue: 0,0:04:14.96,0:04:18.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sebenarnya dia\Nenggak sungguh-sungguh marah, kok.
Dialogue: 0,0:04:18.29,0:04:19.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak usah dipikirkan.
Dialogue: 0,0:04:19.20,0:04:20.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:04:20.13,0:04:22.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sedang enggak memikirkan apa-apa.
Dialogue: 0,0:04:23.01,0:04:26.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa kejadian seperti ini\Npernah terjadi sebelumnya.
Dialogue: 0,0:04:27.26,0:04:31.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa juga dia selalu berlagak\Nmenjadi si pembawa damai begini?
Dialogue: 0,0:04:33.68,0:04:34.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi
Dialogue: 0,0:04:35.98,0:04:38.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukankah ini sesuatu\Nyang pantang untuk dilakukan?
Dialogue: 0,0:04:42.69,0:04:44.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:04:49.49,0:04:50.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melelahkan saja.
Dialogue: 0,0:04:57.96,0:04:59.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguhan?
Dialogue: 0,0:05:17.73,0:05:18.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pagi!
Dialogue: 0,0:05:21.73,0:05:24.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya enak.
Dialogue: 0,0:05:24.15,0:05:24.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:05:25.53,0:05:27.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tani, kamu mau kembali ke kelas?
Dialogue: 0,0:05:28.36,0:05:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duluan, ya!
Dialogue: 0,0:05:32.74,0:05:34.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belakangan ini,
Dialogue: 0,0:05:34.24,0:05:36.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia jadi sering mengajakku mengobrol.
Dialogue: 0,0:05:37.12,0:05:38.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya pindah tempat duduk.
Dialogue: 0,0:05:40.04,0:05:42.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duduk di dekat jendela hawanya panas sekali.
Dialogue: 0,0:05:42.38,0:05:43.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panas sekali, tahu!
Dialogue: 0,0:05:44.55,0:05:47.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tani, coba tebak berapa harganya.
Dialogue: 0,0:05:47.22,0:05:48.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak tahu.
Dialogue: 0,0:05:48.34,0:05:50.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harganya 300 yen!\NMurah sekali, kan?
Dialogue: 0,0:05:50.97,0:05:54.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku, cita rasa adonannya itu
Dialogue: 0,0:05:54.81,0:05:58.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jauh lebih penting daripada\Nseberapa besar potongan guritanya.
Dialogue: 0,0:05:58.19,0:06:00.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tipe yang lebih mementingkan\Nadonan atau isiannya?
Dialogue: 0,0:06:00.94,0:06:02.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak pernah memikirkan\Nsampai sedetail itu.
Dialogue: 0,0:06:02.44,0:06:03.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pagi!
Dialogue: 0,0:06:03.61,0:06:04.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pagi.
Dialogue: 0,0:06:04.52,0:06:06.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini kamu sarapan apa?
Dialogue: 0,0:06:06.90,0:06:07.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Roti panggang.
Dialogue: 0,0:06:07.82,0:06:09.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi aku makan Rumble Ball!\NHabis tiga biji!
Dialogue: 0,0:06:10.07,0:06:11.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:06:11.57,0:06:12.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa ini?
Dialogue: 0,0:06:13.28,0:06:15.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sama sekali tak paham jalan pikirannya.
Dialogue: 0,0:06:15.12,0:06:17.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini obrolan macam apa?
Dialogue: 0,0:06:17.79,0:06:19.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dia selalu saja\N- Tiap kali mencium bau klorin seperti ini,
Dialogue: 0,0:06:19.50,0:06:21.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- mengajak mengobrol tanpa basa-basi.\N- rasanya seperti musim panas benar-benar tiba.
Dialogue: 0,0:06:22.33,0:06:23.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana menurutmu?
Dialogue: 0,0:06:23.59,0:06:24.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana aku tahu.
Dialogue: 0,0:06:25.34,0:06:27.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reaksimu yang dingin itu membuatku tertawa!
Dialogue: 0,0:06:27.09,0:06:31.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia selalu saja membahas hal-hal random\Nyang entah kenapa harus diceritakan padaku.
Dialogue: 0,0:06:31.55,0:06:33.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal dia melempar pertanyaan,
Dialogue: 0,0:06:33.18,0:06:35.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kelihatannya dia juga\Ntak terlalu peduli dengan jawabanku.
Dialogue: 0,0:06:36.10,0:06:37.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, jangan ganggu dia terus.
Dialogue: 0,0:06:39.39,0:06:41.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa tujuan yang jelas,\Ntanpa alasan yang pasti.
Dialogue: 0,0:06:41.81,0:06:44.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini benar-benar percakapan\Nyang sama sekali tak ada faedahnya.
Dialogue: 0,0:06:44.11,0:06:45.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memusingkan sekali.
Dialogue: 0,0:06:46.61,0:06:49.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pikir, "Orang itu bukan mainan,\Njangan diperlakukan seenaknya"?
Dialogue: 0,0:06:49.61,0:06:50.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak berpikiran seperti itu.
Dialogue: 0,0:06:51.82,0:06:52.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu, ya?
Dialogue: 0,0:06:53.37,0:06:54.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga sama anehnya.
Dialogue: 0,0:06:55.03,0:06:56.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya apa yang ada di pikiran dia?
Dialogue: 0,0:06:57.83,0:07:03.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, aku tak pernah menyangka bakal\Nterbiasa dengan gaya komunikasi seabsurd ini.
Dialogue: 0,0:07:04.08,0:07:06.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya itulah yang aku rasakan.
Dialogue: 0,0:07:07.38,0:07:09.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu jago olahraga, enggak?
Dialogue: 0,0:07:09.92,0:07:11.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau urusan lari,\Naku lumayan percaya diri, sih.
Dialogue: 0,0:07:12.05,0:07:14.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa berlari 1.000 meter\Ndalam waktu 3 menit 50 detik.
Dialogue: 0,0:07:14.18,0:07:16.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang biasa enggak lari jarak jauh\Nuntuk sekadar pamer kemampuan fisik.
Dialogue: 0,0:07:17.06,0:07:18.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tepat sasaran!
Dialogue: 0,0:07:19.06,0:07:21.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sejujurnya,\Naku sudah mulai terbiasa dengan ini.
Dialogue: 0,0:07:21.94,0:07:24.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seiring dengan seringnya kami berinteraksi,
Dialogue: 0,0:07:24.48,0:07:27.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku jadi paham kalau dia tak pernah mencari\Nmakna ataupun efisiensi dari percakapannya.
Dialogue: 0,0:07:27.90,0:07:29.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pun akhirnya mulai menyadari
Dialogue: 0,0:07:29.36,0:07:30.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau wujud komunikasi semacam ini
Dialogue: 0,0:07:30.78,0:07:33.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nyatanya memang ada.
Dialogue: 0,0:07:34.66,0:07:35.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu pola pikirku berubah seperti itu,
Dialogue: 0,0:07:35.82,0:07:40.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rasa engganku terhadap hal-hal\Nyang tak mampu kupahami dengan nalar
Dialogue: 0,0:07:40.16,0:07:42.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}langsung sirna secara ajaib.
Dialogue: 0,0:07:45.17,0:07:46.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagu ini…
Dialogue: 0,0:07:49.38,0:07:50.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak ini…
Dialogue: 0,0:07:52.63,0:07:54.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toko ini…
Dialogue: 0,0:07:55.43,0:07:57.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berbagai hal yang dulunya\Ntak pernah kuacuhkan
Dialogue: 0,0:07:57.35,0:07:59.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}perlahan mulai menemukan benang merahnya\Ndengan keseharianku,
Dialogue: 0,0:07:59.72,0:08:00.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}muncul di saat tak terduga.
Dialogue: 0,0:08:01.60,0:08:03.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa cuma kebetulan semata hal-hal seperti itu\Nmakin sering bermunculan belakangan ini?
Dialogue: 0,0:08:03.98,0:08:05.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan semua itu kebetulan juga\Njadi bahan obrolan kami?
Dialogue: 0,0:08:05.52,0:08:07.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa rentetan kebetulan ini bisa terjadi
Dialogue: 0,0:08:07.56,0:08:08.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}layaknya efek domino?
Dialogue: 0,0:08:09.44,0:08:11.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yu, kamu sudah pulang, ya.
Dialogue: 0,0:08:13.70,0:08:15.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru membeli tas itu?
Dialogue: 0,0:08:16.20,0:08:17.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ini?
Dialogue: 0,0:08:17.70,0:08:20.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah punya ini dari dulu, lo.
Dialogue: 0,0:08:21.04,0:08:22.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru di saat itulah aku menyadarinya
Dialogue: 0,0:08:22.41,0:08:24.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau selama ini aku ternyata baru sadar
Dialogue: 0,0:08:24.92,0:08:27.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atas hal-hal yang selalu kuabaikan.
Dialogue: 0,0:08:27.83,0:08:29.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perubahannya memang tak begitu kentara,
Dialogue: 0,0:08:29.67,0:08:31.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku merasa seakan mampu melihat
Dialogue: 0,0:08:31.34,0:08:33.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dunia dengan warna\Nyang jauh lebih beragam sekarang.
Dialogue: 0,0:08:35.01,0:08:36.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlahan tapi pasti,
Dialogue: 0,0:08:37.59,0:08:39.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku mulai berpikir kalau semua ini\Ntidaklah terlalu buruk.
Dialogue: 0,0:08:46.35,0:08:48.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tani, lihat ini!
Dialogue: 0,0:08:49.48,0:08:52.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dango lumpur lembut karyaku kemarin.
Dialogue: 0,0:08:54.19,0:08:55.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:08:55.86,0:08:57.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali enggak ada faedahnya.
Dialogue: 0,0:08:58.62,0:09:00.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini murni sekadar percakapan biasa saja.
Dialogue: 0,0:09:18.59,0:09:21.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya apa yang ada di pikirannya, ya?
Dialogue: 0,0:09:22.89,0:09:26.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu betul\Nkalau semua itu tak ada maknanya,
Dialogue: 0,0:09:29.27,0:09:32.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku sungguh berharap segala omongan\Nsantainya dan caranya memperlakukanku
Dialogue: 0,0:09:33.07,0:09:37.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}benar-benar memiliki arti tersendiri.
Dialogue: 0,0:09:43.87,0:09:45.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tani, kamu mau langsung pulang sekarang?
Dialogue: 0,0:09:45.37,0:09:46.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu terlambat sekali, sih.
Dialogue: 0,0:09:46.41,0:09:48.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekspresinya berlebihan sekali.
Dialogue: 0,0:09:49.67,0:09:51.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ke sini mau menyelesaikan\Ntugas piketku dulu.
Dialogue: 0,0:09:52.25,0:09:54.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumahmu arahnya ke mana?
Dialogue: 0,0:09:55.05,0:09:56.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke luar gerbang sekolah lalu belok kanan.
Dialogue: 0,0:09:56.51,0:09:57.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arah kita sama!
Dialogue: 0,0:10:03.93,0:10:05.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tani…
Dialogue: 0,0:10:05.56,0:10:07.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dipikir-pikir lagi…
Dialogue: 0,0:10:08.19,0:10:11.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita pulang bersama.
Dialogue: 0,0:10:11.44,0:10:12.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya…
Dialogue: 0,0:10:13.40,0:10:15.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}momen inilah yang jadi titik awalnya.
Dialogue: 0,0:10:16.03,0:10:18.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski aku merasa, perasaanku ini\Nsudah tumbuh jauh sebelum momen ini.
Dialogue: 0,0:10:19.07,0:10:21.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sadar kalau aku memang\Nsudah jatuh cinta padanya.
Dialogue: 0,0:10:23.20,0:10:25.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata rumahmu juga searah ke sini, ya.
Dialogue: 0,0:10:25.58,0:10:28.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kok kita enggak pernah\Nberpapasan sama sekali, ya?
Dialogue: 0,0:10:36.96,0:10:39.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya setiap pulang sekolah\Naku selalu bersantai dulu,
Dialogue: 0,0:10:39.42,0:10:40.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi ya wajar saja kalau\Nkita enggak pernah bertemu!
Dialogue: 0,0:10:41.01,0:10:43.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula,\Nkamu kan juga sering ada tugas piket.
Dialogue: 0,0:10:49.10,0:10:51.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru sadar, ternyata...
Dialogue: 0,0:10:52.65,0:10:54.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat Suzuki diam dan tak mengajak mengobrol,
Dialogue: 0,0:10:54.98,0:10:56.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bahkan tak bisa berbasa-basi,
Dialogue: 0,0:10:56.90,0:10:58.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apalagi untuk membuka\Ntopik obrolan yang asyik.
Dialogue: 0,0:10:59.03,0:11:02.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh iya, aku ingat!\NBelum lama ini aku makan di KingBurg.
Dialogue: 0,0:11:02.20,0:11:03.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Isian burgernya melimpah sekali, tahu.
Dialogue: 0,0:11:03.87,0:11:05.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rotinya saja sampai enggak muat\Nmenampung isinya.
Dialogue: 0,0:11:06.03,0:11:08.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rotinya malah terasa seperti\Nmenu sampingannya saja.
Dialogue: 0,0:11:08.50,0:11:12.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sampai bingung bagaimana cara makannya!
Dialogue: 0,0:11:13.04,0:11:14.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang enak, ya?
Dialogue: 0,0:11:15.54,0:11:16.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak! Enak sekali pokoknya!
Dialogue: 0,0:11:17.00,0:11:19.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,\Nkapan-kapan kamu mau makan bersama ke sana?
Dialogue: 0,0:11:20.01,0:11:21.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya mengajak saja, kok.
Dialogue: 0,0:11:22.05,0:11:22.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh saja.
Dialogue: 0,0:11:23.55,0:11:26.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat mewanti-wanti supaya dia tak\Nsampai salah paham dengan perasaanku.
Dialogue: 0,0:11:35.69,0:11:37.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu…
Dialogue: 0,0:12:14.48,0:12:17.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,\Nponi Pak Hara kelihatan jelek sekali, kan?
Dialogue: 0,0:12:17.31,0:12:19.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Iya.\N- Jelek sekali, kan?
Dialogue: 0,0:12:34.41,0:12:36.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lewat sini, ya.
Dialogue: 0,0:12:36.42,0:12:39.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumahmu lewat arah situ, ya?\NTernyata arah rumah kita saling berlawanan.
Dialogue: 0,0:12:39.96,0:12:41.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dah! Sampai jumpa lagi!
Dialogue: 0,0:12:42.80,0:12:43.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dah.
Dialogue: 0,0:13:19.80,0:13:22.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tumben hari ini Suzuki bolos.
Dialogue: 0,0:13:22.14,0:13:25.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tumben. Ini pertama kalinya\Ndia enggak masuk sekolah?
Dialogue: 0,0:13:26.56,0:13:28.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku sudah membuatnya kesal?
Dialogue: 0,0:13:49.04,0:13:50.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tani!
Dialogue: 0,0:14:01.55,0:14:05.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suasana sekolah tanpa kehadiran Suzuki\Nternyata terasa sangat...
Dialogue: 0,0:14:05.51,0:14:07.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suzuki, akhirnya kamu masuk juga!
Dialogue: 0,0:14:07.18,0:14:08.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hai!
Dialogue: 0,0:14:08.81,0:14:11.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, dengar-dengar...
Dialogue: 0,0:14:11.60,0:14:13.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu berpacaran dengan Tani, ya?
Dialogue: 0,0:14:15.81,0:14:19.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata Gapacho, dia melihat kalian berdua\Npulang sekolah bersama kemarin.
Dialogue: 0,0:14:20.24,0:14:23.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, aku harus buru-buru mengelak.
Dialogue: 0,0:14:25.37,0:14:26.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:14:27.12,0:14:27.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku harus mengelak dengan alasan apa, nih?
Dialogue: 0,0:14:30.66,0:14:32.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan seperti itu ceritanya!
Dialogue: 0,0:14:35.63,0:14:36.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:14:37.75,0:14:39.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tempat dudukku.
Dialogue: 0,0:14:40.30,0:14:41.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh aku mengambil buku catatanku sebentar?
Dialogue: 0,0:14:42.22,0:14:43.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, maaf, biar aku pindah.
Dialogue: 0,0:14:43.68,0:14:45.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak usah repot. Kita akan pindah kelas\Nuntuk jam pelajaran selanjutnya.
Dialogue: 0,0:14:54.19,0:14:56.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat karbohidrat dicerna oleh tubuh,
Dialogue: 0,0:14:56.69,0:14:59.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}prosesnya akan memicu lonjakan\Nkadar gula darah sesudah makan.
Dialogue: 0,0:14:59.52,0:15:01.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin kalian pasti sudah sering\Ndengar istilah "Indeks Glikemik".
Dialogue: 0,0:15:01.78,0:15:02.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus minta maaf padanya.
Dialogue: 0,0:15:10.20,0:15:12.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak boleh membiarkan keberadaanku ini
Dialogue: 0,0:15:12.91,0:15:15.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}merusak zona nyaman\Nyang sudah susah payah dia bangun.
Dialogue: 0,0:15:15.87,0:15:18.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih baik kita bersikap seolah\Nkejadian itu enggak pernah ada.
Dialogue: 0,0:15:24.22,0:15:25.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suzuki.
Dialogue: 0,0:15:26.47,0:15:28.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}T-Tani…
Dialogue: 0,0:15:31.72,0:15:34.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggap saja kejadian kemarin itu\Nenggak pernah ada.
Dialogue: 0,0:15:35.44,0:15:36.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya.
Dialogue: 0,0:15:53.66,0:15:54.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suzuki!
Dialogue: 0,0:15:54.70,0:15:57.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupon popcorn gratisku hari ini kedaluwarsa.\NAyo kita pakai!
Dialogue: 0,0:16:01.67,0:16:04.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita pulang bersama.
Dialogue: 0,0:16:13.97,0:16:15.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lupakan saja.
Dialogue: 0,0:16:16.73,0:16:20.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin hal ini justru perlu untuk\Nmeyakinkan perasaanku sendiri.
Dialogue: 0,0:16:21.40,0:16:22.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa
Dialogue: 0,0:16:23.11,0:16:25.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}perasaan gundah yang sulit diutarakan\Ndengan kata-kata ini,
Dialogue: 0,0:16:25.78,0:16:28.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan emosi rumit yang bahkan\Ntak bisa aku pahami dengan jelas,
Dialogue: 0,0:16:30.20,0:16:35.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}malah terasa makin kuat saat aku tahu kalau\Nperasaanku ini tak akan pernah berbalas?
Dialogue: 0,0:16:36.96,0:16:38.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku…
Dialogue: 0,0:16:52.80,0:16:53.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tani!
Dialogue: 0,0:16:53.81,0:16:54.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miyu,
Dialogue: 0,0:16:56.22,0:16:58.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai kapan pun aku akan terus mencintaimu.
Dialogue: 0,0:17:03.73,0:17:06.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong ingat janjiku itu.
Dialogue: 0,0:17:10.28,0:17:11.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jaga dirimu baik-baik, ya.
Dialogue: 0,0:20:40.95,0:20:42.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hai.
Dialogue: 0,0:20:42.33,0:20:43.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taira, lama enggak berjumpa.
Dialogue: 0,0:20:44.08,0:20:45.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tumben kamu datang lebih awal.
Dialogue: 0,0:20:45.08,0:20:46.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga.
Dialogue: 0,0:20:51.04,0:20:52.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua datangnya cepat sekali.
Dialogue: 0,0:20:53.84,0:20:56.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Nbiar kami yang belikan minumannya, ya.
Dialogue: 0,0:20:56.51,0:20:57.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo temani aku, Tani.
Dialogue: 0,0:20:59.09,0:21:01.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Takoyaki itu wajib saat acara lihat bunga.\N- Roti lapis buatan sini
Dialogue: 0,0:21:01.22,0:21:02.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku sudah membeli macam-macam lauk pauk.\N- rasanya enak sekali.
Dialogue: 0,0:21:02.76,0:21:03.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya enak sekali.
Dialogue: 0,0:21:03.68,0:21:04.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Lalu Azuma membawa apa?\N- Aku mau ambil camilan, ah.
Dialogue: 0,0:21:04.72,0:21:06.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hai, semuanya!\NMaaf, aku datang terlambat.
Dialogue: 0,0:21:06.39,0:21:07.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi jalanannya macet parah.
Dialogue: 0,0:21:08.60,0:21:11.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini barang yang sering dipakai\Nuntuk acara festival musik dan kamping.
Dialogue: 0,0:21:11.10,0:21:12.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru meminjam banyak\Nperalatan kamping dari Kii.
Dialogue: 0,0:21:13.65,0:21:14.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yamada.
Dialogue: 0,0:21:14.90,0:21:16.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih,\Nsudah membantu membawa belanjaannya.
Dialogue: 0,0:21:18.07,0:21:19.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dangonya enak sekali.
Dialogue: 0,0:21:19.74,0:21:20.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, kan?
Dialogue: 0,0:21:20.78,0:21:23.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dango rekomendasi dari neneknya Tani.
Dialogue: 0,0:21:24.37,0:21:26.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak akan bosan kalau\Ndisuruh makan ini seumur hidup.
Dialogue: 0,0:21:26.29,0:21:28.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jatahnya hanya satu tusuk per orang, ya!
Dialogue: 0,0:21:28.12,0:21:31.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nabe, gaya rambut pendekmu\Nkelihatan cocok sekali.
Dialogue: 0,0:21:31.17,0:21:32.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga, kok.
Dialogue: 0,0:21:33.21,0:21:34.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih pujiannya.
Dialogue: 0,0:21:34.59,0:21:36.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taira, tanganmu itu…
Dialogue: 0,0:21:37.13,0:21:38.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun!
Dialogue: 0,0:21:39.01,0:21:41.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, semuanya ayo berkumpul di sini!
Dialogue: 0,0:21:41.13,0:21:42.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita mau foto sekarang?
Dialogue: 0,0:21:42.39,0:21:44.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar, senyumku belum siap, nih!
Dialogue: 0,0:21:44.72,0:21:46.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santai saja.
Dialogue: 0,0:21:47.97,0:21:50.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taira, jangan menahan tawa begitu.
Dialogue: 0,0:21:50.14,0:21:51.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bicara begitu malah membuatku\Nmakin susah untuk tersenyum.
Dialogue: 0,0:21:51.94,0:21:53.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yey!
Dialogue: 0,0:21:53.44,0:21:55.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, senyum!
Dialogue: 0,0:22:04.12,0:22:05.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip.
Dialogue: 0,0:22:06.70,0:22:08.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesi foto yang asyik sekali!
Dialogue: 0,0:22:10.37,0:22:11.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fotonya bagus sekali, ya?
Dialogue: 0,0:22:13.08,0:22:14.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar sekali.
