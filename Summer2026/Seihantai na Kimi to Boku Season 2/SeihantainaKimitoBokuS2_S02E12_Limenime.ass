Dialogue: 0,0:00:48.48,0:00:51.52,sign,,0000,0000,0000,,"MENATAP"
Dialogue: 0,0:03:21.78,0:03:23.45,sign,,0000,0000,0000,,"TERNYATA BEGITU CERITANYA"
Dialogue: 0,0:05:21.52,0:05:23.32,sign,,0000,0000,0000,,"WAKTU TAK CUKUP, UJUNGNYA TAK TERLIHAT"
Dialogue: 0,0:05:23.69,0:05:25.40,sign,,0000,0000,0000,,WAKTU BELAJAR TERBATAS\NWAKTU BERSAMA TERBATAS
Dialogue: 0,0:05:25.49,0:05:26.44,sign,,0000,0000,0000,,"AKU ENGGAK MAU INI BERAKHIR"
Dialogue: 0,0:05:26.53,0:05:27.36,sign,,0000,0000,0000,,AKU PENGIN INI CEPAT KELAR
Dialogue: 0,0:05:45.80,0:05:47.51,sign,,0000,0000,0000,,"KAFE"
Dialogue: 0,0:05:56.35,0:05:58.10,sign,,0000,0000,0000,,"TAHUN INI CUMA MAKAN MALAM"
Dialogue: 0,0:06:53.03,0:06:54.07,sign,,0000,0000,0000,,"TIDAK BEREAKSI"
Dialogue: 0,0:08:53.32,0:08:55.11,sign,,0000,0000,0000,,"MAKSUDMU?"
Dialogue: 0,0:09:18.89,0:09:21.43,sign,,0000,0000,0000,,DIA MENGOREKSI UCAPANNYA…
Dialogue: 0,0:09:46.45,0:09:48.46,sign,,0000,0000,0000,,INTINYA, AKU TUH CUMA LAGI\NBERUSAHA SELAMATKAN GENGSIKU AJA!
Dialogue: 0,0:09:48.54,0:09:49.75,sign,,0000,0000,0000,,DEJA VU
Dialogue: 0,0:10:15.28,0:10:17.07,sign,,0000,0000,0000,,"UJIAN MASUK UNIVERSITAS NASIONAL"
Dialogue: 0,0:10:29.62,0:10:31.46,sign,,0000,0000,0000,,SEMANGAT!
Dialogue: 0,0:10:36.88,0:10:39.59,sign,,0000,0000,0000,,KERJA BAGUS BUAT UJIANNYA!
Dialogue: 0,0:11:07.33,0:11:09.54,sign,,0000,0000,0000,,"UPACARA KELULUSAN"
Dialogue: 0,0:11:10.80,0:11:13.09,sign,,0000,0000,0000,,"SELAMAT ATAS KELULUSAN KALIAN"
Dialogue: 0,0:11:22.18,0:11:23.68,sign,,0000,0000,0000,,"SEMANGAT!"
Dialogue: 0,0:11:57.13,0:11:58.64,sign,,0000,0000,0000,,"AKU JADI ENGGAK BISA BUKA SEKARANG"
Dialogue: 0,0:12:01.47,0:12:03.27,sign,,0000,0000,0000,,"SUZUKI MIYU"
Dialogue: 0,0:12:03.35,0:12:05.10,sign,,0000,0000,0000,,"JELEK BANGET!"
Dialogue: 0,0:12:05.48,0:12:08.06,sign,,0000,0000,0000,,"PULPEN"
Dialogue: 0,0:12:55.11,0:12:56.32,sign,,0000,0000,0000,,SERIUS… SAMPAI AKHIR…
Dialogue: 0,0:12:56.94,0:12:58.74,sign,,0000,0000,0000,,"KELIHATAN DEH…"
Dialogue: 0,0:13:03.87,0:13:06.33,sign,,0000,0000,0000,,"ADIK KELAS PEMANDU SORAK"
Dialogue: 0,0:13:06.54,0:13:09.21,sign,,0000,0000,0000,,"YAMADA IKUT NYEMPIL DIAM-DIAM"
Dialogue: 0,0:13:09.29,0:13:10.50,sign,,0000,0000,0000,,OBROLAN CERIA
Dialogue: 0,0:13:10.58,0:13:12.33,sign,,0000,0000,0000,,"TIM HIJAU…"
Dialogue: 0,0:13:12.88,0:13:14.42,sign,,0000,0000,0000,,"OBROLAN CERIA"
Dialogue: 0,0:13:41.20,0:13:42.03,sign,,0000,0000,0000,,"APA-APAAN NIH?"
Dialogue: 0,0:13:54.79,0:13:57.05,sign,,0000,0000,0000,,"AKU PAKAI FILTER TEMA KELULUSAN DULU"
Dialogue: 0,0:13:57.59,0:13:59.17,sign,,0000,0000,0000,,ENGGAK PAHAM
Dialogue: 0,0:14:02.76,0:14:05.60,sign,,0000,0000,0000,,MENATAP…
Dialogue: 0,0:14:12.35,0:14:13.69,sign,,0000,0000,0000,,"JANGAN NGAPIT AKU"
Dialogue: 0,0:14:51.35,0:14:52.56,sign,,0000,0000,0000,,"KEJAR DIA SEKARANG"
Dialogue: 0,0:15:04.61,0:15:06.57,sign,,0000,0000,0000,,- C-I-E-E!
Dialogue: 0,0:15:07.12,0:15:08.33,sign,,0000,0000,0000,,GEBETANNYA?
Dialogue: 0,0:15:17.58,0:15:20.25,sign,,0000,0000,0000,,AKU BUKAN MAU NGEJAR KAMU JUGA, SIH…
Dialogue: 0,0:15:30.14,0:15:31.06,sign,,0000,0000,0000,,YASUDAHLAH.
Dialogue: 0,0:15:37.85,0:15:40.73,sign,,0000,0000,0000,,"IJAZAH KELULUSAN"
Dialogue: 0,0:16:24.69,0:16:25.82,sign,,0000,0000,0000,,SERIUSAN?
Dialogue: 0,0:18:37.24,0:18:38.16,sign,,0000,0000,0000,,TETAP KONTAKAN HABIS LULUS YA - AOI SATO
Dialogue: 0,0:18:38.24,0:18:39.16,sign,,0000,0000,0000,,SYUKUR KITA BISA AKRAB PAS\NTIM SORAK - YUNO MATSUDA
Dialogue: 0,0:18:39.24,0:18:40.20,sign,,0000,0000,0000,,AZU, NANTI KITA BELANJA BARENG KALAU\NSUDAH MASUK KULIAH YA! - SUZUKI
Dialogue: 0,0:18:40.83,0:18:43.04,sign,,0000,0000,0000,,"AKU BINGUNG MAU NULIS APA…"
Dialogue: 0,0:18:49.25,0:18:51.92,sign,,0000,0000,0000,,SEMANGAT KULIAHNYA NANTI!
Dialogue: 0,0:18:52.17,0:18:54.22,sign,,0000,0000,0000,,"SETELAH MIKIR PANJANG LAMA…"
Dialogue: 0,0:19:05.19,0:19:06.40,sign,,0000,0000,0000,,"MELIHAT SELAMANYA…"
Dialogue: 0,0:19:06.48,0:19:07.86,sign,,0000,0000,0000,,"SHUJI: CEMAS KELAKUANNYA GAK SEBAGUS NAMANYA"
Dialogue: 0,0:19:24.54,0:19:25.79,sign,,0000,0000,0000,,"SEMANGAT!"
Dialogue: 0,0:19:42.60,0:19:44.23,sign,,0000,0000,0000,,"HASIL SELEKSI UNIVERSITAS NEGERI"
Dialogue: 0,0:19:44.31,0:19:46.14,sign,,0000,0000,0000,,"PENGUMUMANNYA SERING SESUDAH KELULUSAN"
Dialogue: 0,0:20:10.46,0:20:11.71,sign,,0000,0000,0000,,"SUARA CEMPRENG INI…"
Dialogue: 0,0:20:15.26,0:20:17.18,sign,,0000,0000,0000,,TZ!
Dialogue: 0,0:23:11.73,0:23:12.60,sign,,0000,0000,0000,,"SERING MAIN - SERING NGABARIN"
Dialogue: 0,0:23:12.68,0:23:13.52,sign,,0000,0000,0000,,JANGAN LUPAIN AKU, YA
Dialogue: 0,0:23:13.60,0:23:14.64,sign,,0000,0000,0000,,SUDAH SIAP BILANG, "TENTU SAJA"
Dialogue: 0,0:00:04.18,0:00:08.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yusuke, mending kita putus sementara.
Dialogue: 0,0:00:12.40,0:00:15.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semenjak Yusuke mengganti pilihan kampusnya,
Dialogue: 0,0:00:15.45,0:00:18.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}waktu ngobrol kami jadi berkurang drastis.
Dialogue: 0,0:00:18.49,0:00:20.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Enggak benar, tuh!\N- Pagi.
Dialogue: 0,0:00:21.20,0:00:22.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat istirahat makan siang.
Dialogue: 0,0:00:22.95,0:00:24.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulang sekolah.
Dialogue: 0,0:00:24.37,0:00:25.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau jadwal kami saat bareng,
Dialogue: 0,0:00:25.46,0:00:28.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami malah makan bareng sebelum bimbel.
Dialogue: 0,0:00:28.71,0:00:32.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, kami jadi lebih sering\Nketemu dibanding sebelumnya.
Dialogue: 0,0:00:34.71,0:00:35.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang banget.
Dialogue: 0,0:00:36.63,0:00:38.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau kami berdua lulus ujian,
Dialogue: 0,0:00:39.01,0:00:41.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami akan LDR-an mulai musim semi ini.
Dialogue: 0,0:00:41.47,0:00:42.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin gara-gara itu,
Dialogue: 0,0:00:43.06,0:00:47.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}belakangan ini Yusuke jadi kelihatan\Nlebih sering berusaha menemukanku.
Dialogue: 0,0:00:48.48,0:00:51.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuharap dia enggak terlalu memaksakan diri.
Dialogue: 0,0:00:52.86,0:00:55.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, apa barusan aku ngomong sesuatu?
Dialogue: 0,0:00:55.99,0:00:56.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak.
Dialogue: 0,0:00:57.99,0:00:59.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:01:01.74,0:01:03.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu enggak apa-apa?
Dialogue: 0,0:01:04.20,0:01:05.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kelihatan capek.
Dialogue: 0,0:01:05.91,0:01:07.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih ada waktu sebelum bimbel mulai.
Dialogue: 0,0:01:07.58,0:01:08.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mending kamu tidur siang dulu.
Dialogue: 0,0:01:09.62,0:01:11.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, aku enggak capek, kok.
Dialogue: 0,0:01:11.63,0:01:13.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatan banget kamu bohong.
Dialogue: 0,0:01:13.13,0:01:14.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak ngantuk.
Dialogue: 0,0:01:14.30,0:01:15.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ini anak kecil, ya?
Dialogue: 0,0:01:15.76,0:01:19.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, tadi kita lagi bahas apa?
Dialogue: 0,0:01:19.63,0:01:22.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita enggak bahas apa-apa.
Dialogue: 0,0:01:22.39,0:01:24.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuh kan, kamu capek.
Dialogue: 0,0:01:24.68,0:01:26.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak capek.
Dialogue: 0,0:01:26.68,0:01:31.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau lagi capek, jujur saja bilang capek.
Dialogue: 0,0:01:32.94,0:01:35.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang kalau kita harus putus.
Dialogue: 0,0:01:36.48,0:01:39.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, jangan-jangan...
Dialogue: 0,0:01:40.41,0:01:42.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}gara-gara aku, dia jadi enggak bisa jujur?
Dialogue: 0,0:01:59.26,0:02:08.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}You and I Are Polar Opposites\NSeason 2
Dialogue: 0,0:03:14.60,0:03:16.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ngomong begitu ke dia?
Dialogue: 0,0:03:17.11,0:03:18.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:03:18.86,0:03:21.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu bawa-bawa kata putus,\Njelas saja dia jadi panik.
Dialogue: 0,0:03:21.78,0:03:23.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak banyak pasangan yang balikan
Dialogue: 0,0:03:23.53,0:03:24.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}habis putus, kan?
Dialogue: 0,0:03:24.91,0:03:26.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi saat lagi sibuk-sibuknya\Nmenyiapkan ujian.
Dialogue: 0,0:03:29.16,0:03:30.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tetap saja,
Dialogue: 0,0:03:30.33,0:03:32.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau sampai dia ganti pilihan kampus\Ncuma gara-gara aku,
Dialogue: 0,0:03:32.79,0:03:34.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku juga enggak akan senang.
Dialogue: 0,0:03:34.88,0:03:37.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Nabe yang harus memilih\Ndi antara dua hal itu,
Dialogue: 0,0:03:37.50,0:03:39.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kayaknya kamu akan tetap\Npilih jalanmu sendiri.
Dialogue: 0,0:03:41.92,0:03:44.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengikuti perasaanku saat itu.
Dialogue: 0,0:03:45.39,0:03:48.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau pikirnya sampai sejauh itu,
Dialogue: 0,0:03:48.14,0:03:50.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}malah makin susah menentukan\Npilihan yang tepat.
Dialogue: 0,0:03:50.93,0:03:54.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma peduli dengan apa\Nyang mau kulakukan sekarang.
Dialogue: 0,0:03:55.10,0:03:57.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia memang ingin terus sama kamu,
Dialogue: 0,0:03:57.23,0:03:59.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}makanya memilih kampus yang lebih dekat,
Dialogue: 0,0:03:59.40,0:04:01.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukannya itu enggak masalah?
Dialogue: 0,0:04:01.11,0:04:02.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku sih, begitu.
Dialogue: 0,0:04:04.11,0:04:08.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang terpenting itu\Nadalah pilihannya sendiri.
Dialogue: 0,0:04:08.41,0:04:11.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi apa Tani betulan enggak masalah?
Dialogue: 0,0:04:11.12,0:04:12.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sama sekali enggak menyimak, ya?
Dialogue: 0,0:04:13.58,0:04:17.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Niatnya sih, mau menyemangatinya, tapi...
Dialogue: 0,0:04:17.67,0:04:20.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku malah bikin dia tertekan?
Dialogue: 0,0:04:26.18,0:04:29.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yusuke, kamu enggak apa-apa?
Dialogue: 0,0:04:35.94,0:04:37.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tanya begitu?
Dialogue: 0,0:04:39.27,0:04:40.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baik-baik saja, kok.
Dialogue: 0,0:04:43.28,0:04:44.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:04:52.20,0:04:56.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Susah dijelaskan pakai kata-kata,
Dialogue: 0,0:04:57.75,0:04:59.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi dia kelihatan tertekan banget.
Dialogue: 0,0:05:01.55,0:05:04.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus ngomong apa ke dia, ya?
Dialogue: 0,0:05:04.76,0:05:08.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula,\Nmasalah yang dihadapi Yusuke sekarang
Dialogue: 0,0:05:08.30,0:05:13.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin bukan hal yang bisa aku selesaikan.
Dialogue: 0,0:05:17.39,0:05:20.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebanyak apa pun\Nyang kuberikan atau kulakukan,
Dialogue: 0,0:05:21.52,0:05:23.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya selalu ada yang kurang.
Dialogue: 0,0:05:25.49,0:05:26.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betulan bikin serbasalah.
Dialogue: 0,0:05:33.79,0:05:34.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun begitu,
Dialogue: 0,0:05:35.62,0:05:37.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena dia sudah menyemangati aku,
Dialogue: 0,0:05:38.04,0:05:40.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku enggak boleh menyerah di tengah jalan.
Dialogue: 0,0:05:45.80,0:05:47.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat Natal!
Dialogue: 0,0:05:48.05,0:05:50.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terakhir kali kita ke sini itu\Nsaat musim semi.
Dialogue: 0,0:05:51.93,0:05:55.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kue dan makanannya enak banget.
Dialogue: 0,0:05:55.43,0:05:56.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga saja
Dialogue: 0,0:05:56.35,0:05:58.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tahun depan kita bisa lebih santai.
Dialogue: 0,0:05:58.19,0:06:00.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti kita tukar kado di tempat baru kita.
Dialogue: 0,0:06:05.53,0:06:06.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahun depan, ya...
Dialogue: 0,0:06:08.03,0:06:12.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum pernah aku terpikirkan sekali\Nsoal masa depan seperti ini.
Dialogue: 0,0:06:15.70,0:06:17.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita langsung pulang sekarang?
Dialogue: 0,0:06:17.95,0:06:21.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih ingin jalan-jalan sebentar.
Dialogue: 0,0:06:21.17,0:06:23.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak apa-apa? Kamu masih ada waktu?
Dialogue: 0,0:06:34.18,0:06:35.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih sama seperti dulu, ya.
Dialogue: 0,0:06:37.10,0:06:38.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada hal yang...
Dialogue: 0,0:06:40.35,0:06:41.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja, kan?
Dialogue: 0,0:06:42.31,0:06:45.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada yang mengganjal...
Dialogue: 0,0:06:46.82,0:06:48.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yusuke...
Dialogue: 0,0:06:49.99,0:06:51.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu lagi membicarakan siapa?
Dialogue: 0,0:06:53.03,0:06:54.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa, sih?
Dialogue: 0,0:06:54.16,0:06:54.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya...
Dialogue: 0,0:06:55.08,0:06:57.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu cuma bisa peka\Nsama masalah orang lain?
Dialogue: 0,0:06:58.50,0:06:59.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi diriku,
Dialogue: 0,0:06:59.87,0:07:03.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu itu orang\Nyang paling aku cemaskan, tahu.
Dialogue: 0,0:07:03.12,0:07:05.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kamu saja yang enggak sadar.
Dialogue: 0,0:07:05.71,0:07:07.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu enggak terlalu memaksakan diri, kan?
Dialogue: 0,0:07:07.50,0:07:11.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak. Maksudku, aku enggak mengekangmu.
Dialogue: 0,0:07:12.68,0:07:15.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu sudah kasih hatimu\Nwaktu yang cukup buat istirahat?
Dialogue: 0,0:07:16.01,0:07:18.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada masalah, cerita saja padaku.
Dialogue: 0,0:07:20.10,0:07:22.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, kok. Aku baik-baik saja.
Dialogue: 0,0:07:22.77,0:07:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya memang enggak ada masalah,
Dialogue: 0,0:07:26.19,0:07:29.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi entah kenapa\Naku tetap merasa cemas waktu itu.
Dialogue: 0,0:07:33.05,0:07:35.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu, ya.
Dialogue: 0,0:07:36.28,0:07:41.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma enggak mau mengakui kelemahanku.
Dialogue: 0,0:07:43.33,0:07:45.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku, ya. Aku sudah bohong.
Dialogue: 0,0:07:46.67,0:07:47.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini berat sekali.
Dialogue: 0,0:07:51.26,0:07:52.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lelah.
Dialogue: 0,0:07:55.14,0:07:58.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak mau mengeluh.
Dialogue: 0,0:07:58.72,0:07:59.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya kenapa?
Dialogue: 0,0:08:00.35,0:08:02.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarkan saja semuanya kalau kamu mau.
Dialogue: 0,0:08:02.89,0:08:07.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rintangan yang harus kuatasi sekarang\Nadalah tantanganku sendiri.
Dialogue: 0,0:08:08.69,0:08:11.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus bisa menyelesaikannya sendiri.
Dialogue: 0,0:08:12.99,0:08:14.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi,
Dialogue: 0,0:08:15.07,0:08:18.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukannya dari dulu aku selalu suruh kamu\Nbuat curhat hal seperti ini padaku?
Dialogue: 0,0:08:20.33,0:08:25.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yusuke, kayaknya aku\Nenggak akan bisa selamatkan kamu.
Dialogue: 0,0:08:25.42,0:08:29.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham kita enggak bisa\Nselesaikan semuanya berdua terus.
Dialogue: 0,0:08:29.88,0:08:33.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi di saat kamu lagi kesusahan,
Dialogue: 0,0:08:33.79,0:08:36.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ingin jadi tempat curhatmu.
Dialogue: 0,0:08:37.72,0:08:41.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku sayang kamu,\Naku ingin jadi sosok yang kuat.
Dialogue: 0,0:08:41.64,0:08:43.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu pikirnya begitu.
Dialogue: 0,0:08:43.52,0:08:45.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyatanya aku ini payah dan lemah.
Dialogue: 0,0:08:46.06,0:08:48.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku malah bikin diriku\Nkelihatan makin enggak berguna.
Dialogue: 0,0:08:49.86,0:08:53.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma enggak mau mengeluh\Ndan bikin kamu kecewa.
Dialogue: 0,0:08:53.32,0:08:55.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak mungkin aku akan berpikir begitu.
Dialogue: 0,0:08:55.74,0:08:57.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau putus?
Dialogue: 0,0:08:57.74,0:08:59.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku, ya.
Dialogue: 0,0:08:59.16,0:09:01.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ngomong begitu\Nbukan buat bikin kamu resah.
Dialogue: 0,0:09:03.45,0:09:04.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham, kok.
Dialogue: 0,0:09:05.50,0:09:06.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paham sih, tapi...
Dialogue: 0,0:09:10.25,0:09:11.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:09:13.30,0:09:15.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin jadi sosok kayak kamu.
Dialogue: 0,0:09:17.97,0:09:18.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miyu.
Dialogue: 0,0:09:22.31,0:09:23.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tani.
Dialogue: 0,0:09:23.72,0:09:25.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yusuke.
Dialogue: 0,0:09:25.35,0:09:26.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuchan.
Dialogue: 0,0:09:26.81,0:09:27.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chansuke.
Dialogue: 0,0:09:28.02,0:09:28.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa, tuh?
Dialogue: 0,0:09:29.69,0:09:31.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini...
Dialogue: 0,0:09:31.15,0:09:34.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}enggak setegar yang kamu kira, tahu!
Dialogue: 0,0:09:35.57,0:09:37.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma ingin jadi cewek\Nyang penuh pengertian, berwawasan luas,
Dialogue: 0,0:09:37.99,0:09:41.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan penuh perhatian.
Dialogue: 0,0:09:41.24,0:09:43.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya aku pura-pura sok tegar saja.
Dialogue: 0,0:09:43.58,0:09:46.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya, aku cuma lagi berusaha\Nselamatkan gengsiku saja!
Dialogue: 0,0:09:50.63,0:09:51.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, ya.
Dialogue: 0,0:09:52.84,0:09:56.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku paham apa yang mesti\Nkulakukan dan apa yang terbaik buatku,
Dialogue: 0,0:09:56.88,0:10:00.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku enggak sadar sama batasku sendiri.
Dialogue: 0,0:10:00.14,0:10:02.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya kamu robot?
Dialogue: 0,0:10:06.77,0:10:07.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi ngecas.
Dialogue: 0,0:10:08.64,0:10:10.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mencekik aku.
Dialogue: 0,0:10:15.28,0:10:17.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemudian...
Dialogue: 0,0:10:19.32,0:10:23.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang berhasil\Nmelewati dinginnya ujian.
Dialogue: 0,0:10:58.53,0:11:00.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musim semi akhirnya tiba!
Dialogue: 0,0:11:06.08,0:11:07.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang...
Dialogue: 0,0:11:07.33,0:11:09.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wisudawan, silakan memasuki ruangan.
Dialogue: 0,0:11:10.80,0:11:13.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyerahan ijazah.
Dialogue: 0,0:11:13.17,0:11:16.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perwakilan Kelas 3-1, Tanaka Haruto.
Dialogue: 0,0:11:17.01,0:11:17.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:11:18.18,0:11:22.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perwakilan kelas 3-7, Kawasaki Midori.
Dialogue: 0,0:11:22.18,0:11:23.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:11:23.77,0:11:24.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maju terus, Kapten!
Dialogue: 0,0:11:24.98,0:11:26.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunjukkan pesonamu!
Dialogue: 0,0:11:26.14,0:11:27.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak perlu menunjukkan apa-apa juga kali.
Dialogue: 0,0:11:28.19,0:11:32.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perwakilan Kelas 3-8, Shimizu Nagare.
Dialogue: 0,0:11:32.73,0:11:33.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:11:37.66,0:11:39.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita jarang banget dengar lagu mars sekolah.
Dialogue: 0,0:11:39.49,0:11:40.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sampai lupa bagaimana cara nyanyinya.
Dialogue: 0,0:11:40.83,0:11:42.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya kita pernah latihan?
Dialogue: 0,0:11:42.49,0:11:45.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu saat kelas satu kita sering\Ndisuruh nyanyi lagu ini, kan?
Dialogue: 0,0:11:45.33,0:11:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu anak kelas musik doang.
Dialogue: 0,0:11:47.12,0:11:48.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa, sih?
Dialogue: 0,0:11:48.75,0:11:50.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Azu, dulu kamu ambil kelas seni rupa, kan?
Dialogue: 0,0:11:50.71,0:11:51.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agak di luar nalar, sih.
Dialogue: 0,0:11:52.34,0:11:53.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa begitu?
Dialogue: 0,0:11:54.34,0:11:55.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak sangka ijazahnya
Dialogue: 0,0:11:55.67,0:11:57.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}enggak pakai tabung!
Dialogue: 0,0:11:57.13,0:11:58.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya penting banget, ya?
Dialogue: 0,0:11:59.64,0:12:00.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong…
Dialogue: 0,0:12:01.47,0:12:03.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu enggak menyesal fotonya seperti ini?
Dialogue: 0,0:12:03.35,0:12:05.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini masalah besar, tahu!
Dialogue: 0,0:12:05.48,0:12:08.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tutup saja halaman aib itu.
Dialogue: 0,0:12:08.14,0:12:10.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita penuhi halaman pesannya bareng.
Dialogue: 0,0:12:10.40,0:12:12.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu niat banget.
Dialogue: 0,0:12:12.82,0:12:15.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, ayo tulis.
Dialogue: 0,0:12:15.36,0:12:16.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tulis yang besar.
Dialogue: 0,0:12:20.32,0:12:21.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah fotonya?
Dialogue: 0,0:12:24.12,0:12:25.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cek bentar?
Dialogue: 0,0:12:25.58,0:12:26.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:12:26.50,0:12:28.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pencet sebelah sini buat cek foto\Nyang baru dijepret.
Dialogue: 0,0:12:29.50,0:12:30.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya lumayan.
Dialogue: 0,0:12:31.04,0:12:34.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, tolong fotokan pakai ponselku juga.
Dialogue: 0,0:12:46.43,0:12:47.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, ya.
Dialogue: 0,0:12:47.64,0:12:50.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang giliranku\Nyang fotokan kalian berdua.
Dialogue: 0,0:12:50.10,0:12:51.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gapacho, sini ikutan.
Dialogue: 0,0:12:56.94,0:12:58.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pak Guru, jas formal Bapak
Dialogue: 0,0:12:58.82,0:13:00.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kelihatan lucu banget.
Dialogue: 0,0:13:00.45,0:13:01.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak lucu, tahu.
Dialogue: 0,0:13:01.87,0:13:03.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten! Kakak-kakak!
Dialogue: 0,0:13:03.87,0:13:06.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau foto bareng, dong.
Dialogue: 0,0:13:06.54,0:13:09.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yeay!
Dialogue: 0,0:13:10.58,0:13:12.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka kelihatan bahagia banget.
Dialogue: 0,0:13:12.88,0:13:14.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Honda! Nishi!
Dialogue: 0,0:13:15.34,0:13:17.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak kelas 8, ayo pada kumpul foto bareng!
Dialogue: 0,0:13:20.13,0:13:22.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Delapan!
Dialogue: 0,0:13:39.78,0:13:41.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuchan.
Dialogue: 0,0:13:41.20,0:13:42.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu nangis
Dialogue: 0,0:13:42.11,0:13:43.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat upacara kelulusan tadi, kan?
Dialogue: 0,0:13:43.20,0:13:44.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak nangis.
Dialogue: 0,0:13:44.32,0:13:45.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa?
Dialogue: 0,0:13:45.53,0:13:47.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga tadi enggak nangis, kan?
Dialogue: 0,0:13:47.45,0:13:48.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Exactly.
Dialogue: 0,0:13:48.70,0:13:49.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tiba-tiba pakai bahasa Inggris?
Dialogue: 0,0:13:51.62,0:13:53.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau foto, nih.
Dialogue: 0,0:13:54.79,0:13:57.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita foto pakai aplikasi ini saja.
Dialogue: 0,0:13:59.92,0:14:01.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, aku jepret sekarang, ya.
Dialogue: 0,0:14:06.47,0:14:07.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:14:07.76,0:14:09.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan apa-apa.
Dialogue: 0,0:14:09.85,0:14:11.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cemen banget, deh.
Dialogue: 0,0:14:11.35,0:14:12.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sini.
Dialogue: 0,0:14:12.35,0:14:13.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak butuh, ah.
Dialogue: 0,0:14:21.57,0:14:22.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo foto.
Dialogue: 0,0:14:23.03,0:14:23.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak mau.
Dialogue: 0,0:14:23.99,0:14:25.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sekarang.
Dialogue: 0,0:14:25.78,0:14:26.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi banyak orang…
Dialogue: 0,0:14:28.66,0:14:29.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Siap, ya?\N- Aku jepret, ya.
Dialogue: 0,0:14:29.87,0:14:31.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Yeay!\N- Lucu banget!
Dialogue: 0,0:14:31.45,0:14:32.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yeay!
Dialogue: 0,0:14:48.97,0:14:50.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Azu! Azu!
Dialogue: 0,0:14:51.35,0:14:52.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cowok gebetanmu
Dialogue: 0,0:14:52.64,0:14:53.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}baru saja jalan sendirian ke arah sana.
Dialogue: 0,0:14:55.19,0:14:57.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Kamu membicarakan siapa, sih?
Dialogue: 0,0:14:57.73,0:14:59.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh kusebutkan?
Dialogue: 0,0:14:59.77,0:15:00.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak cowok dari Kelas 8 itu...
Dialogue: 0,0:15:02.15,0:15:03.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat, ya! Kejar!
Dialogue: 0,0:15:03.34,0:15:04.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Azuma kenapa tuh?\N- Azu! Azu!
Dialogue: 0,0:15:04.61,0:15:06.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dia lagi mengejar gebetannya.
Dialogue: 0,0:15:08.70,0:15:11.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teman seangkatan kita?\NSatu sekolah juga?
Dialogue: 0,0:15:11.16,0:15:12.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertanyaan macam apa itu?
Dialogue: 0,0:15:15.54,0:15:17.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka pergi ke arah yang sama, kan...
Dialogue: 0,0:15:20.50,0:15:22.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, omong-omong, Taira pergi ke mana?
Dialogue: 0,0:15:22.80,0:15:24.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yamada, ayo kita foto bareng.
Dialogue: 0,0:15:24.72,0:15:26.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo.
Dialogue: 0,0:15:26.38,0:15:28.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sini biar aku yang jepret.
Dialogue: 0,0:15:28.18,0:15:30.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya tadi kita baru saja foto bareng?
Dialogue: 0,0:15:37.85,0:15:40.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa SMA... Penuh dengan lika-liku.
Dialogue: 0,0:15:42.19,0:15:44.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kalau dipikir-pikir lagi,\Nenggak ada kejadian yang terlalu wah juga.
Dialogue: 0,0:15:44.65,0:15:47.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau dirangkum semuanya,
Dialogue: 0,0:15:50.70,0:15:52.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}masa-masa ini sangatlah menyenangkan.
Dialogue: 0,0:15:55.87,0:15:57.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betulan akan berakhir hari ini, ya?
Dialogue: 0,0:15:59.84,0:16:03.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saking fokusnya ke ujian,\Nsampai sekarang masih terasa kurang nyata.
Dialogue: 0,0:16:12.22,0:16:14.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:16:17.35,0:16:18.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan bilang ke siapa pun, ya,
Dialogue: 0,0:16:20.44,0:16:21.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau tadi aku sempat nangis.
Dialogue: 0,0:16:22.48,0:16:24.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak akan, kok!\NAku enggak akan bilang ke orang lain!
Dialogue: 0,0:16:25.90,0:16:27.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku serius!
Dialogue: 0,0:16:28.66,0:16:29.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya,
Dialogue: 0,0:16:31.41,0:16:32.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku paham perasaannya.
Dialogue: 0,0:16:37.91,0:16:39.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mengerti.
Dialogue: 0,0:16:41.13,0:16:42.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya seru banget, ya?
Dialogue: 0,0:16:44.71,0:16:46.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa-masa SMA kita ini.
Dialogue: 0,0:17:00.56,0:17:06.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berani menunjukkan sisi menyedihkan diriku\Nke orang lain,
Dialogue: 0,0:17:06.99,0:17:10.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan bisa saling mengerti satu sama lain...
Dialogue: 0,0:17:11.86,0:17:13.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuatu yang enggak pernah\Nkubayangkan sebelumnya.
Dialogue: 0,0:17:15.32,0:17:19.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bersyukur bisa sekolah di sini.
Dialogue: 0,0:17:25.92,0:17:27.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Azuma.
Dialogue: 0,0:17:29.26,0:17:30.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, ya.
Dialogue: 0,0:17:34.68,0:17:35.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk semuanya selama ini...
Dialogue: 0,0:17:38.60,0:17:40.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terima kasih banyak.
Dialogue: 0,0:17:44.44,0:17:46.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama-sama.
Dialogue: 0,0:17:46.94,0:17:48.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga merasa begitu, kok.
Dialogue: 0,0:17:50.24,0:17:52.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cowok yang aku suka
Dialogue: 0,0:17:53.49,0:17:55.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selalu menatap mataku sederajat dengannya
Dialogue: 0,0:17:56.24,0:17:59.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan berani mengutarakan perasaannya\Nyang paling jujur.
Dialogue: 0,0:18:00.71,0:18:02.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walaupun cuma hal sesederhana itu,
Dialogue: 0,0:18:04.50,0:18:06.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kurasa itu sudah lebih dari cukup.
Dialogue: 0,0:18:07.92,0:18:09.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:18:13.76,0:18:15.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mukaku pasti sembap banget sekarang.
Dialogue: 0,0:18:16.05,0:18:17.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mukaku juga, kok.
Dialogue: 0,0:18:20.18,0:18:23.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alih-alih mencari kejelasan\Nstatus hubungan kami,
Dialogue: 0,0:18:23.81,0:18:28.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku justru merasa diperlakukan\Nlayaknya orang yang jauh lebih spesial.
Dialogue: 0,0:18:29.82,0:18:33.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mending kita tunggu mata kita mendingan\Nsebelum gabung lagi sama yang lain.
Dialogue: 0,0:18:40.83,0:18:43.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak usah dipikir terlalu berat.
Dialogue: 0,0:18:43.12,0:18:46.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasa juga aku enggak pernah menulis begini.
Dialogue: 0,0:18:52.17,0:18:54.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agak lucu juga pesannya.
Dialogue: 0,0:18:54.68,0:18:57.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, kurang satu lagi. Tulis namamu.
Dialogue: 0,0:18:59.06,0:19:01.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-i-ra…
Dialogue: 0,0:19:01.64,0:19:04.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Damai. Tenang.
Dialogue: 0,0:19:05.19,0:19:06.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata namamu maknanya bagus juga, ya.
Dialogue: 0,0:19:06.48,0:19:07.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan.
Dialogue: 0,0:19:07.94,0:19:09.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa, sih? Bagus, kok.
Dialogue: 0,0:19:09.94,0:19:12.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sini, Shuji, mana buku tahunanmu?
Dialogue: 0,0:19:14.61,0:19:16.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kosong melompong banget.
Dialogue: 0,0:19:16.45,0:19:19.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak kelasku memang\Nenggak suka menulis seperti ini.
Dialogue: 0,0:19:19.99,0:19:22.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Nboleh aku tulis pesannya yang besar?
Dialogue: 0,0:19:24.54,0:19:25.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, beres.
Dialogue: 0,0:19:25.87,0:19:28.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok seram amat gambarnya.\NMonster Yeti, kah?
Dialogue: 0,0:19:29.09,0:19:32.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hak Cipta Sepenuhnya Milik Shino Azuma.
Dialogue: 0,0:19:32.42,0:19:34.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak usah pakai logo hak cipta segala.
Dialogue: 0,0:19:34.80,0:19:36.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula,\Ntadi mengucapkan semangat buat apa?
Dialogue: 0,0:19:36.97,0:19:38.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya kamu akan merantau jauh.
Dialogue: 0,0:19:39.05,0:19:41.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hitung-hitung ucapan\N"Semoga sukses di tempat perantauan".
Dialogue: 0,0:19:41.68,0:19:42.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku sendiri masih belum tahu
Dialogue: 0,0:19:42.60,0:19:44.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan diterima atau enggak.
Dialogue: 0,0:19:44.31,0:19:46.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santai, semuanya pasti aman terkendali, kok.
Dialogue: 0,0:19:46.23,0:19:47.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Firasatku bilang hasilmu\Npasti akan memuaskan.
Dialogue: 0,0:19:48.06,0:19:49.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ngomong sih gampang.
Dialogue: 0,0:19:51.15,0:19:53.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi seandainya...
Dialogue: 0,0:19:53.82,0:19:55.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- aku diterima...\N- Dia diterima...
Dialogue: 0,0:19:55.70,0:19:57.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin hari ini...
Dialogue: 0,0:19:59.49,0:20:01.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan jadi hari terakhir kita.
Dialogue: 0,0:20:01.58,0:20:03.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari terakhir?
Dialogue: 0,0:20:06.21,0:20:09.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taira! Azuma!
Dialogue: 0,0:20:09.21,0:20:10.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}T-Azuma!
Dialogue: 0,0:20:10.46,0:20:11.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian pada di mana, sih?
Dialogue: 0,0:20:11.80,0:20:13.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu Suzuki?
Dialogue: 0,0:20:13.30,0:20:15.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Azuma!
Dialogue: 0,0:20:17.26,0:20:19.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya namaku cuma dipanggil\Npakai inisial doang.
Dialogue: 0,0:20:22.97,0:20:24.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walaupun begitu,
Dialogue: 0,0:20:24.64,0:20:26.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ikhlas-ikhlas saja buat sekarang.
Dialogue: 0,0:20:27.06,0:20:28.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita samperin mereka.
Dialogue: 0,0:20:29.44,0:20:30.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah enggak ada yang kusesali lagi.
Dialogue: 0,0:20:32.98,0:20:33.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu bentar.
Dialogue: 0,0:20:36.95,0:20:40.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti setelah lulus,\Nkita masih bisa bertemu lagi, kan?
Dialogue: 0,0:20:47.21,0:20:49.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya pastilah!
Dialogue: 0,0:20:50.83,0:20:51.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa, sih?
Dialogue: 0,0:22:25.47,0:22:27.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat bunga sakuranya rontok nanti,
Dialogue: 0,0:22:27.76,0:22:30.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita akan resmi memulai masa-masa LDR kita.
Dialogue: 0,0:22:31.23,0:22:32.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah siap mental?
Dialogue: 0,0:22:32.73,0:22:34.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok nada bicaramu jadi begitu, sih?
Dialogue: 0,0:22:34.86,0:22:37.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pasti akan sibuk banget\Nsaat sudah masuk kuliah.
Dialogue: 0,0:22:37.48,0:22:38.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita jadi enggak bisa sering-sering ketemuan.
Dialogue: 0,0:22:38.78,0:22:42.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu akan punya lingkungan pergaulan baru\Ndan ketemu teman-teman baru.
Dialogue: 0,0:22:42.32,0:22:47.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti akan terlupakan dan tergantikan.
Dialogue: 0,0:22:47.70,0:22:49.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok mukamu jadi melas gitu?
Dialogue: 0,0:22:49.87,0:22:52.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan apa-apa,\Ncuma saja tebakanmu barusan betulan akurat.
Dialogue: 0,0:22:54.37,0:22:57.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jamin hatiku enggak akan goyah, kok!\NPercaya sama aku!
Dialogue: 0,0:22:57.34,0:23:00.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti itu tandanya aku yang dianggap\Nenggak bisa dipercaya, dong?
Dialogue: 0,0:23:00.84,0:23:02.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:23:02.59,0:23:04.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya juga, sih,
Dialogue: 0,0:23:04.37,0:23:07.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin aku ini tipe yang susah beradaptasi\Ndi lingkungan baru.
Dialogue: 0,0:23:08.14,0:23:09.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti akan kesepian banget.
Dialogue: 0,0:23:09.31,0:23:10.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur amat ngomongnya.
Dialogue: 0,0:23:11.73,0:23:12.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya...
Dialogue: 0,0:23:14.94,0:23:16.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan berusaha jadi sosok\Nyang tangguh menghadapi itu semua.
Dialogue: 0,0:23:17.06,0:23:18.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa akhirnya begitu?
Dialogue: 0,0:23:19.40,0:23:21.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang...
Dialogue: 0,0:23:21.32,0:23:24.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadikan aku sandaranmu kalau kamu butuh!
Dialogue: 0,0:23:24.15,0:23:26.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lupa kalau aku selalu ada buatmu!
Dialogue: 0,0:23:26.36,0:23:27.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak akan lupa, kok.
Dialogue: 0,0:23:27.70,0:23:29.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku, walau kadang kamu sampai\Nmelupakanku saking sibuknya,
Dialogue: 0,0:23:29.91,0:23:32.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tetap ingin jadi sandaran kuat buatmu.
Dialogue: 0,0:23:32.25,0:23:35.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjelasanmu terlalu disingkat-singkat, tahu!\NItu kebiasaan burukmu.
Dialogue: 0,0:23:35.25,0:23:36.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miyu, selamat ulang tahun.
Dialogue: 0,0:23:36.96,0:23:38.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sengaja mengalihkan topik\Npakai hadiah, ya?
Dialogue: 0,0:23:38.84,0:23:40.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, terima kasih ya!
Dialogue: 0,0:23:40.67,0:23:42.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pasti pikir aku ini gampang dirayu.
Dialogue: 0,0:23:42.96,0:23:43.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, kok.
Dialogue: 0,0:23:43.88,0:23:45.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Bohong banget!\N- Betulan.
Dialogue: 0,0:23:46.01,0:23:47.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatan banget kamu menahan ketawa, tuh.
Dialogue: 0,0:23:47.84,0:23:49.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ngaku saja, deh!
