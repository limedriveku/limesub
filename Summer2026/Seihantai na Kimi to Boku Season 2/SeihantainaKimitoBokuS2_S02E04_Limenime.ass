Dialogue: 0,0:22:14.87,0:22:16.50,sign,,0000,0000,0000,,"MENATAP…"
Dialogue: 0,0:22:18.04,0:22:19.00,sign,,0000,0000,0000,,"MENATAP…"
Dialogue: 0,0:22:19.08,0:22:20.09,sign,,0000,0000,0000,,HARI VALENTINE?
Dialogue: 0,0:00:08.46,0:00:09.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alismu…
Dialogue: 0,0:00:23.85,0:00:26.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku tiba-tiba\Nteringat kejadian tahun lalu?
Dialogue: 0,0:00:28.65,0:00:30.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku masuk lewat Gerbang Selatan,
Dialogue: 0,0:00:30.29,0:00:32.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}turun tangga terdekat,
Dialogue: 0,0:00:32.95,0:00:35.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu naik gerbong ketiga dari depan,
Dialogue: 0,0:00:35.91,0:00:37.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu jalur paling efisien.
Dialogue: 0,0:00:39.62,0:00:41.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku…
Dialogue: 0,0:00:41.41,0:00:42.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiap pagi,
Dialogue: 0,0:00:42.41,0:00:43.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku masuk lewat Gerbang Utara,
Dialogue: 0,0:00:44.29,0:00:46.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jalan ke ujung peron,
Dialogue: 0,0:00:46.92,0:00:49.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu naik gerbong terakhir ke sekolah.
Dialogue: 0,0:00:51.13,0:00:53.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih gampang cari tempat duduk di sini,
Dialogue: 0,0:00:53.42,0:00:55.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan aku enggak ketemu orang yang kukenal.
Dialogue: 0,0:00:56.22,0:00:58.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak ada alasan khusus, sih.
Dialogue: 0,0:00:58.85,0:01:00.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu saja yang kulakukan.
Dialogue: 0,0:01:16.20,0:01:25.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}You and I Are Polar Opposites\NSeason 2
Dialogue: 0,0:02:32.19,0:02:35.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa masih ada beberapa pengumuman lain.
Dialogue: 0,0:02:35.82,0:02:37.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kusampaikan besok\Nkalau sudah kuingat lagi.
Dialogue: 0,0:02:37.49,0:02:39.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku menantikan\Nbekerja sama kalian semester ini.
Dialogue: 0,0:02:39.49,0:02:41.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu enggak masalah, kan?
Dialogue: 0,0:02:42.24,0:02:44.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langitnya gelap banget.
Dialogue: 0,0:02:44.41,0:02:45.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayak sudah malam saja.
Dialogue: 0,0:02:45.79,0:02:47.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bawa payung.
Dialogue: 0,0:02:47.50,0:02:49.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini bakal hujan, ya?
Dialogue: 0,0:02:49.50,0:02:51.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya mungkin turun salju.
Dialogue: 0,0:02:51.67,0:02:52.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nenekku yang bilang.
Dialogue: 0,0:02:52.71,0:02:54.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, itu dia. Ramalan Cuaca Nenek.
Dialogue: 0,0:02:54.92,0:02:55.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuchan,
Dialogue: 0,0:02:56.00,0:02:56.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lihat, deh.
Dialogue: 0,0:02:56.92,0:02:57.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Julukan itu…
Dialogue: 0,0:02:58.51,0:03:01.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taira sudah ada di sana.
Dialogue: 0,0:03:01.97,0:03:05.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Taira enggak kerja,\Ndia selalu langsung pulang.
Dialogue: 0,0:03:06.01,0:03:07.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya dia suka di rumah.
Dialogue: 0,0:03:07.52,0:03:10.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ya? Aku enggak pernah sadar itu.
Dialogue: 0,0:03:15.15,0:03:16.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dingin banget.
Dialogue: 0,0:03:18.53,0:03:19.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salju?
Dialogue: 0,0:03:23.37,0:03:24.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:03:26.49,0:03:28.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak bawa payung. Gawat.
Dialogue: 0,0:03:29.45,0:03:30.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taira!
Dialogue: 0,0:03:31.83,0:03:33.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalanmu cepat banget.
Dialogue: 0,0:03:33.75,0:03:34.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lihat kamu dari belakang tadi.
Dialogue: 0,0:03:34.84,0:03:36.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terus jalan, kupikir bisa menyusul,
Dialogue: 0,0:03:37.00,0:03:38.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi enggak bisa.
Dialogue: 0,0:03:38.21,0:03:40.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:03:41.30,0:03:43.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taira, kamu bawa payung?
Dialogue: 0,0:03:43.09,0:03:44.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak bawa!
Dialogue: 0,0:03:45.51,0:03:46.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, pakai punyaku.
Dialogue: 0,0:03:46.85,0:03:48.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jaketku antiair, jadi aku aman.
Dialogue: 0,0:03:48.85,0:03:50.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pakai ini saja.
Dialogue: 0,0:03:50.39,0:03:51.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dah!
Dialogue: 0,0:03:52.39,0:03:54.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu! Pakai sendiri, dong!
Dialogue: 0,0:03:55.06,0:03:56.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku enggak butuh.\N- Hei!
Dialogue: 0,0:03:56.11,0:03:57.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ayolah, pakai saja.\N- Sudah kubilang tunggu!
Dialogue: 0,0:03:57.77,0:03:59.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kubilang aku enggak butuh!
Dialogue: 0,0:04:00.32,0:04:02.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, sih, sama kamu?
Dialogue: 0,0:04:02.65,0:04:03.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini.
Dialogue: 0,0:04:03.57,0:04:04.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, bukan begitu.
Dialogue: 0,0:04:05.99,0:04:08.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku serius. Enggak usah khawatirkan aku.
Dialogue: 0,0:04:09.04,0:04:11.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi basah kuyup di cuaca sedingin ini\Nkasihan juga, kan?
Dialogue: 0,0:04:13.92,0:04:16.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku yang pegang saja, deh.
Dialogue: 0,0:04:16.67,0:04:17.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makasih.
Dialogue: 0,0:04:24.34,0:04:25.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, Taira!
Dialogue: 0,0:04:25.76,0:04:27.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu merusaknya, kan?
Dialogue: 0,0:04:27.35,0:04:29.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan aku, kan?
Dialogue: 0,0:04:29.18,0:04:30.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, enggak mau balik posisi.
Dialogue: 0,0:04:31.02,0:04:33.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah, lupakan, ayo lari!
Dialogue: 0,0:04:34.19,0:04:36.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, itu masih lucu banget.
Dialogue: 0,0:04:36.69,0:04:38.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ketawa melulu, deh.
Dialogue: 0,0:04:38.15,0:04:40.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga baru saja ketawa, kan?
Dialogue: 0,0:04:43.32,0:04:44.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanganku dingin banget.
Dialogue: 0,0:04:44.86,0:04:46.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merah terang begini.
Dialogue: 0,0:04:46.70,0:04:48.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ambil penghangat tangan. Cepat.
Dialogue: 0,0:04:49.28,0:04:50.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak apa-apa.
Dialogue: 0,0:04:54.62,0:04:56.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah. Sini.
Dialogue: 0,0:05:04.09,0:05:05.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tahu enggak, Taira…
Dialogue: 0,0:05:07.59,0:05:12.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau warnai rambutmu lebih gelap\Ndan coba tampilan basah lain kali?
Dialogue: 0,0:05:13.52,0:05:14.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok tiba-tiba bahas itu?
Dialogue: 0,0:05:14.85,0:05:16.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya itu kesan yang kurasakan sekarang.
Dialogue: 0,0:05:18.81,0:05:20.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku begitu,
Dialogue: 0,0:05:20.36,0:05:22.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}orang bakal kira aku enggak pernah keramas.
Dialogue: 0,0:05:22.73,0:05:24.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kurang percaya diri, ya.
Dialogue: 0,0:05:24.82,0:05:28.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu harus lebih percaya diri\Nsama dirimu yang sekarang.
Dialogue: 0,0:05:29.16,0:05:31.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kamu berubah\Nkarena tertarik sama mode?
Dialogue: 0,0:05:31.87,0:05:33.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang, kan, kalau enggak dinikmati.
Dialogue: 0,0:05:37.58,0:05:38.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lengan tiga perempat…
Dialogue: 0,0:05:40.34,0:05:41.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan
Dialogue: 0,0:05:41.50,0:05:43.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena alasan yang positif.
Dialogue: 0,0:05:44.21,0:05:47.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sayang banget, kan?
Dialogue: 0,0:05:47.47,0:05:49.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah usaha keras, tapi enggak percaya diri.
Dialogue: 0,0:05:50.43,0:05:53.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu dukung kamu, kok.
Dialogue: 0,0:05:56.35,0:05:59.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakiku hangat banget di kereta ini.\NAku ngantuk.
Dialogue: 0,0:05:59.31,0:06:01.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bangunkan aku\Npas kita sampai perhentian, ya.
Dialogue: 0,0:06:01.52,0:06:02.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, tunggu…
Dialogue: 0,0:06:18.79,0:06:19.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:06:22.50,0:06:24.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alismu… Coba dibenahi, deh?
Dialogue: 0,0:06:27.05,0:06:29.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya rambutmu lebih terang sekarang,
Dialogue: 0,0:06:29.43,0:06:30.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau alismu dibenahi biar serasi,
Dialogue: 0,0:06:30.84,0:06:33.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu pasti bakal kelihatan lebih bagus.
Dialogue: 0,0:06:35.02,0:06:36.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok tiba-tiba ngomong begitu?
Dialogue: 0,0:06:36.10,0:06:37.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh aku benahi buat kamu?
Dialogue: 0,0:06:37.43,0:06:38.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak boleh, lah!
Dialogue: 0,0:06:39.69,0:06:41.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menata rambutmu, ya.
Dialogue: 0,0:06:42.77,0:06:44.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ranselnya bagus.
Dialogue: 0,0:06:44.23,0:06:45.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu godai aku terus, sih?
Dialogue: 0,0:06:47.11,0:06:50.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti memandang remeh aku.
Dialogue: 0,0:06:55.66,0:06:56.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, ah.
Dialogue: 0,0:06:57.96,0:06:59.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu caranya dia semangati aku.
Dialogue: 0,0:07:03.21,0:07:05.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku salah paham sama dia.
Dialogue: 0,0:07:06.88,0:07:07.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah jelas, kok.
Dialogue: 0,0:07:08.05,0:07:09.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, deh.
Dialogue: 0,0:07:10.47,0:07:11.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Azuma.
Dialogue: 0,0:07:12.43,0:07:13.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya.
Dialogue: 0,0:07:14.60,0:07:16.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat apa?
Dialogue: 0,0:07:16.56,0:07:19.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu kamu juga ketiduran\Ndan kelewatan perhentian kita?
Dialogue: 0,0:07:20.19,0:07:21.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu juga.
Dialogue: 0,0:07:22.06,0:07:24.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, jadi semua ini salahku?
Dialogue: 0,0:07:25.61,0:07:26.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku, semuanya.
Dialogue: 0,0:07:26.69,0:07:30.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Payung, penghangat tangan, dan lain-lain.
Dialogue: 0,0:07:30.61,0:07:32.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya?
Dialogue: 0,0:07:33.62,0:07:35.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak mengerti,
Dialogue: 0,0:07:36.24,0:07:39.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi daripada khawatir atau minta maaf,
Dialogue: 0,0:07:40.04,0:07:43.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kurasa bilang "Aku senang"\Natau "Makasih" saja sudah cukup.
Dialogue: 0,0:07:44.46,0:07:46.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ngobrol sama aku,
Dialogue: 0,0:07:47.71,0:07:49.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu bisa lebih santai, kok.
Dialogue: 0,0:07:49.21,0:07:50.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toh kita teman.
Dialogue: 0,0:07:51.47,0:07:52.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:07:52.76,0:07:54.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul banget.
Dialogue: 0,0:08:05.02,0:08:08.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam momen sendirian dan tenang ini,
Dialogue: 0,0:08:08.65,0:08:11.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kenangan terus membanjiri pikiranku.
Dialogue: 0,0:08:12.32,0:08:15.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma peduli\Npandangan orang lain terhadapku.
Dialogue: 0,0:08:15.78,0:08:17.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi karena enggak mau terluka,
Dialogue: 0,0:08:17.78,0:08:19.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku menjaga jarak\Ndari orang yang enggak perlu.
Dialogue: 0,0:08:20.33,0:08:23.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kegelisahan dan asumsiku yang bias…
Dialogue: 0,0:08:24.37,0:08:26.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari apa yang kusadari hari ini,
Dialogue: 0,0:08:26.71,0:08:29.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada banyak hal yang harus kurenungkan.
Dialogue: 0,0:08:30.76,0:08:32.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih dari itu,
Dialogue: 0,0:08:33.63,0:08:37.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lari sekencang-kencangnya\Nkayak orang bodoh hari ini…
Dialogue: 0,0:08:38.39,0:08:40.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seluruh situasinya bodoh banget.
Dialogue: 0,0:08:41.17,0:08:42.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi jujur,
Dialogue: 0,0:08:42.10,0:08:43.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menurutku itu menyenangkan.
Dialogue: 0,0:08:44.65,0:08:47.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diperlakukan setara dan sebagainya.
Dialogue: 0,0:08:48.52,0:08:52.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa, aku terus memutarkan\Nkebahagiaan kecil ini di kepalaku.
Dialogue: 0,0:08:53.53,0:08:58.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebahagiaan, malu, atau lega?
Dialogue: 0,0:08:58.70,0:09:00.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sendiri enggak tahu.
Dialogue: 0,0:09:01.66,0:09:05.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada air mata yang keluar sedikit.
Dialogue: 0,0:09:13.04,0:09:13.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:09:16.39,0:09:19.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jarang banget kita berangkat sekolah\Nbareng-bareng.
Dialogue: 0,0:09:19.56,0:09:20.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:09:22.47,0:09:25.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selalu ramai dari perhentian ini.
Dialogue: 0,0:09:26.02,0:09:29.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa aku bakal balik ke gerbong biasa.
Dialogue: 0,0:09:31.15,0:09:32.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tani.
Dialogue: 0,0:09:32.36,0:09:34.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pustakawan minggu ini, kan?
Dialogue: 0,0:09:35.78,0:09:38.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ya? Begitu, ya.
Dialogue: 0,0:09:38.78,0:09:40.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa lagi, nih?
Dialogue: 0,0:09:40.78,0:09:42.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Ada masalah?
Dialogue: 0,0:09:43.00,0:09:45.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, bukan apa-apa.
Dialogue: 0,0:09:47.12,0:09:50.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun aku selalu sadar\Ndia sedang merencanakan sesuatu,
Dialogue: 0,0:09:51.13,0:09:54.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku enggak pernah tahu persis\Napa yang dia pikirkan.
Dialogue: 0,0:09:55.38,0:09:56.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku biarkan imajinasiku liar,
Dialogue: 0,0:09:56.51,0:09:58.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan akhirnya benaran salah tebak.
Dialogue: 0,0:10:07.06,0:10:08.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama enggak ketemu.
Dialogue: 0,0:10:08.44,0:10:11.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menantikan bekerja sama kamu\Nsemester ini.
Dialogue: 0,0:10:11.57,0:10:12.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga.
Dialogue: 0,0:10:15.90,0:10:16.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa, aku merasa
Dialogue: 0,0:10:16.82,0:10:19.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku jarang ngobrol sama Tani,
Dialogue: 0,0:10:19.91,0:10:20.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi Yamada
Dialogue: 0,0:10:21.07,0:10:22.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selalu cerita ke aku soal dia,
Dialogue: 0,0:10:22.70,0:10:24.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku merasa lebih dekat sama dia
Dialogue: 0,0:10:24.58,0:10:25.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dibanding sebelumnya.
Dialogue: 0,0:10:26.08,0:10:28.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takut jadi kelewat santai\Ndan ngomong lebih dari seharusnya.
Dialogue: 0,0:10:28.83,0:10:32.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat Tani, aku cuma orang\Nyang enggak dia kenal baik.
Dialogue: 0,0:10:32.84,0:10:34.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}GEMURUH…
Dialogue: 0,0:10:35.92,0:10:37.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:10:38.22,0:10:39.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Badanmu kurang enak?
Dialogue: 0,0:10:40.97,0:10:43.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, aku baik-baik saja. Maaf, ya.
Dialogue: 0,0:10:43.14,0:10:45.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, aku enggak menyalahkanmu, kok.
Dialogue: 0,0:10:45.43,0:10:47.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayolah, apa masalahnya, sih?
Dialogue: 0,0:10:47.27,0:10:48.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga harus ikut.
Dialogue: 0,0:10:50.02,0:10:51.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo bangun kebiasaan membaca.
Dialogue: 0,0:10:51.86,0:10:53.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sih, enggak keberatan,
Dialogue: 0,0:10:53.57,0:10:55.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kamu bakal bikin ini\Nkelihatan jelas banget.
Dialogue: 0,0:10:55.78,0:10:57.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak apa-apa, kok.
Dialogue: 0,0:10:57.82,0:11:00.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jago banget naturalkan hal begituan.
Dialogue: 0,0:11:00.66,0:11:02.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mukamu bahkan enggak kayak manusia lagi.
Dialogue: 0,0:11:12.13,0:11:13.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini…
Dialogue: 0,0:11:13.67,0:11:15.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nishi, lama tidak berjumpa.
Dialogue: 0,0:11:15.42,0:11:16.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama tidak bertemu.
Dialogue: 0,0:11:17.05,0:11:20.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak ada orang lain di sini,\Njadi enggak usah bisik-bisik.
Dialogue: 0,0:11:20.68,0:11:22.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ya? Bagus, deh.
Dialogue: 0,0:11:25.14,0:11:28.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku pilih buku dulu, ya.
Dialogue: 0,0:11:30.73,0:11:31.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}DIA JALAN SANTAI BANGET…
Dialogue: 0,0:11:36.78,0:11:37.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahasanya formal amat.
Dialogue: 0,0:11:39.40,0:11:40.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai lagi, deh.
Dialogue: 0,0:11:41.95,0:11:44.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya tadi aku ngobrol sama Suzuki.
Dialogue: 0,0:11:44.53,0:11:46.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga teman sekelas, kan?
Dialogue: 0,0:11:46.45,0:11:47.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul.
Dialogue: 0,0:11:53.83,0:11:55.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:11:55.42,0:11:57.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok kamu formal banget?
Dialogue: 0,0:11:57.63,0:11:59.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada hal dari obrolan pribadi kami
Dialogue: 0,0:11:59.26,0:12:02.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dibahas di depan orang lain,\Naku jadi gugup banget.
Dialogue: 0,0:12:03.43,0:12:06.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau orang-orang di sekitar kita tahu\Nkita sering habiskan waktu berdua,
Dialogue: 0,0:12:07.01,0:12:08.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau kita tetap kontak-kontakan,
Dialogue: 0,0:12:08.35,0:12:10.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu enggak keberatan, Yamada?
Dialogue: 0,0:12:10.52,0:12:13.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah Tani bakal mikir itu aneh?
Dialogue: 0,0:12:14.02,0:12:16.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}MENATAP…
Dialogue: 0,0:12:18.15,0:12:21.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin banget rapikan buku\Nyang dikembalikan.
Dialogue: 0,0:12:21.15,0:12:23.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kayaknya itu enggak terlalu mendesak.
Dialogue: 0,0:12:23.74,0:12:26.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku coba baca sesekali, deh.
Dialogue: 0,0:12:26.28,0:12:28.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada rekomendasi buku lain, enggak?
Dialogue: 0,0:12:29.08,0:12:30.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba kupikir dulu…
Dialogue: 0,0:12:38.25,0:12:39.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yamada.
Dialogue: 0,0:12:39.42,0:12:40.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini…
Dialogue: 0,0:12:40.34,0:12:41.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:12:42.84,0:12:44.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga…
Dialogue: 0,0:12:47.10,0:12:48.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, bagaimana?
Dialogue: 0,0:12:49.01,0:12:51.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menatapku kayak preman, dong.
Dialogue: 0,0:12:51.27,0:12:52.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yamada-man.
Dialogue: 0,0:12:52.48,0:12:54.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak ada manga di sini.\NKamu bakal baik-baik saja?
Dialogue: 0,0:12:54.98,0:12:56.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua sama saja, deh.
Dialogue: 0,0:13:00.48,0:13:02.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia rencana datang bareng Yamada.
Dialogue: 0,0:13:02.65,0:13:04.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, gara-gara itu dia begitu?
Dialogue: 0,0:13:13.96,0:13:17.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tani, aku bantu kamu\Nkembalikan buku-bukunya, ya.
Dialogue: 0,0:13:17.21,0:13:18.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak usah. Toh enggak banyak, kok.
Dialogue: 0,0:13:18.92,0:13:20.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak apa-apa.
Dialogue: 0,0:13:20.63,0:13:23.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ke sini soalnya ingin ketemu kamu.
Dialogue: 0,0:13:24.93,0:13:26.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalimat tadi…
Dialogue: 0,0:13:27.18,0:13:28.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kedengaran agak dibuat-buat, ya, enggak?
Dialogue: 0,0:13:29.01,0:13:32.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Aku tulus, kok.
Dialogue: 0,0:13:32.10,0:13:34.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada hal lain yang lagi aku pikirkan.
Dialogue: 0,0:13:35.73,0:13:36.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nishi.
Dialogue: 0,0:13:36.65,0:13:39.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum selesai baca buku ini.\NAku mau pinjam.
Dialogue: 0,0:13:39.73,0:13:40.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:13:40.82,0:13:41.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:13:42.94,0:13:44.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pilih buku lain, ya.
Dialogue: 0,0:13:44.99,0:13:47.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, aku juga baca yang itu, kok.
Dialogue: 0,0:13:47.53,0:13:50.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku pembaca lambat.
Dialogue: 0,0:13:50.28,0:13:54.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Susah selesaikan novel\Nsesingkat ini sepulang sekolah.
Dialogue: 0,0:13:54.58,0:13:57.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba lihat… Kelas 2-7.
Dialogue: 0,0:13:58.42,0:14:00.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A, Ka, Sa, Ta, Na.
Dialogue: 0,0:14:00.38,0:14:02.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya… Ya…
Dialogue: 0,0:14:03.17,0:14:05.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Yamada Kentaro"…
Dialogue: 0,0:14:07.55,0:14:08.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hadir!
Dialogue: 0,0:14:08.59,0:14:11.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kayak absen kelas, deh.
Dialogue: 0,0:14:11.10,0:14:13.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu panggil nama depanku.
Dialogue: 0,0:14:14.35,0:14:15.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, kok!
Dialogue: 0,0:14:21.69,0:14:23.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nishi Natsumi.
Dialogue: 0,0:14:25.65,0:14:27.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkasnya mana, ya?
Dialogue: 0,0:14:27.53,0:14:29.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pinjam sesuatu hari ini?
Dialogue: 0,0:14:29.32,0:14:31.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ingin coba, deh.
Dialogue: 0,0:14:33.58,0:14:35.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nishi Natsumi…
Dialogue: 0,0:14:35.75,0:14:37.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan panggil-panggil namaku terus.
Dialogue: 0,0:14:39.04,0:14:41.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya,\Nenggak ada yang datang hari ini.
Dialogue: 0,0:14:41.59,0:14:42.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya memang sepi,
Dialogue: 0,0:14:43.00,0:14:45.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi anak kelas tiga yang jarang mampir\Nmungkin salah satu alasannya.
Dialogue: 0,0:14:46.09,0:14:49.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak sadar, aku sudah jalan di depan.
Dialogue: 0,0:14:49.84,0:14:51.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukunya…
Dialogue: 0,0:14:51.60,0:14:53.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku yang kembalikan.
Dialogue: 0,0:14:56.02,0:14:59.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak usah tunggu sampai pulang sekolah.
Dialogue: 0,0:14:59.19,0:15:01.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa kembalikan kapan saja, kok.
Dialogue: 0,0:15:03.69,0:15:07.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bukan itu intinya, aku tahu.
Dialogue: 0,0:15:09.24,0:15:10.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dipikir-pikir,
Dialogue: 0,0:15:10.99,0:15:14.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yamada dan Nishi jadi akrab banget, ya?
Dialogue: 0,0:15:14.79,0:15:15.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keren juga.
Dialogue: 0,0:15:17.75,0:15:19.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, aku pergi dulu, ya.
Dialogue: 0,0:15:19.58,0:15:20.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beneran begitu?
Dialogue: 0,0:15:21.29,0:15:22.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dah.
Dialogue: 0,0:15:22.50,0:15:24.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa.
Dialogue: 0,0:15:27.42,0:15:30.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai kita bisa makan bareng.
Dialogue: 0,0:15:30.09,0:15:32.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nishi kayaknya punya\Njam malam yang ketat banget.
Dialogue: 0,0:15:32.64,0:15:34.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar anak baik, deh.
Dialogue: 0,0:15:47.65,0:15:48.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahasanya formal amat.
Dialogue: 0,0:15:48.57,0:15:49.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu lagi, deh.
Dialogue: 0,0:15:49.86,0:15:51.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada rekomendasi buku lain, enggak?
Dialogue: 0,0:15:52.41,0:15:53.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Lain"?
Dialogue: 0,0:15:53.95,0:15:56.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia orang yang kamu suka, ya?
Dialogue: 0,0:15:56.83,0:15:58.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:15:59.12,0:16:00.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:16:10.30,0:16:12.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:16:12.72,0:16:14.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga itu bohong.
Dialogue: 0,0:16:14.22,0:16:18.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, itu juga serius, kok.
Dialogue: 0,0:16:21.10,0:16:22.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pagi, Yamada.
Dialogue: 0,0:16:23.48,0:16:24.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pagi.
Dialogue: 0,0:16:24.94,0:16:25.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:16:25.86,0:16:27.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu makan roti sambil jalan ke sekolah?
Dialogue: 0,0:16:28.03,0:16:29.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak sempat, sih.
Dialogue: 0,0:16:29.69,0:16:30.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Roti panggang selai itu
Dialogue: 0,0:16:31.03,0:16:32.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}benaran prioritas sekarang?
Dialogue: 0,0:16:32.11,0:16:34.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu yang kamu fokuskan?
Dialogue: 0,0:16:42.46,0:16:46.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang kusembunyikan dari Nishi.
Dialogue: 0,0:16:50.92,0:16:53.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hubunganmu sama Yamada sekarang bagaimana?
Dialogue: 0,0:16:53.76,0:16:57.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hubungan? Kok tiba-tiba tanya begitu?
Dialogue: 0,0:16:57.72,0:17:01.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa kami cuma berteman.
Dialogue: 0,0:17:03.27,0:17:05.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mengajak kamu jalan berdua\Npas wisata kelulusan.
Dialogue: 0,0:17:05.84,0:17:07.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian pergi bareng.
Dialogue: 0,0:17:09.23,0:17:10.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian bahkan ketemu
Dialogue: 0,0:17:10.15,0:17:11.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di akhir tahun.
Dialogue: 0,0:17:11.24,0:17:13.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan kalian sering kontak-kontakan sejak itu.
Dialogue: 0,0:17:16.20,0:17:17.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teman?
Dialogue: 0,0:17:18.28,0:17:19.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, begini…
Dialogue: 0,0:17:19.74,0:17:22.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi cuma itu cara menyebutkannya.
Dialogue: 0,0:17:23.07,0:17:25.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu enggak keberatan tetap begitu?
Dialogue: 0,0:17:25.11,0:17:27.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu enggak mau ada kemajuan?
Dialogue: 0,0:17:28.04,0:17:29.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak mungkin, lah.
Dialogue: 0,0:17:29.13,0:17:32.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa keadaan sekarang sudah cukup baik.
Dialogue: 0,0:17:32.13,0:17:33.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa begitu.
Dialogue: 0,0:17:35.09,0:17:36.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bikin aku gemas!
Dialogue: 0,0:17:36.51,0:17:38.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kurasa mereka punya tempo sendiri.
Dialogue: 0,0:17:38.89,0:17:41.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada ikut campur,\Naku harus sabar dan memantau mereka saja…
Dialogue: 0,0:17:41.47,0:17:42.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pacaran, dong!
Dialogue: 0,0:17:43.43,0:17:44.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, kan?
Dialogue: 0,0:17:44.94,0:17:47.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi keadaan sekarang
Dialogue: 0,0:17:47.94,0:17:49.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah di luar kendaliku.
Dialogue: 0,0:17:49.27,0:17:51.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga enggak mengerti soal pacaran.
Dialogue: 0,0:17:53.94,0:17:55.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nishi, maafkan aku.
Dialogue: 0,0:17:56.45,0:17:58.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nishi mungkin enggak tahu ini,
Dialogue: 0,0:17:59.03,0:18:03.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi awalnya aku benci dia.
Dialogue: 0,0:18:10.04,0:18:10.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:18:11.21,0:18:15.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruangan buat kelas kita berikutnya\Ndiganti, ya?
Dialogue: 0,0:18:16.80,0:18:18.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini di lantai empat.
Dialogue: 0,0:18:18.43,0:18:20.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:18:21.14,0:18:23.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma ngobrol sama dia\Npas dia lagi kesulitan,
Dialogue: 0,0:18:23.85,0:18:26.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi dia menganggapku\Nsebagai orang yang menolongnya.
Dialogue: 0,0:18:27.19,0:18:31.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada dasarnya, kalau aku lihat masalah\Ndan enggak lakukan apa-apa,
Dialogue: 0,0:18:31.82,0:18:34.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu yang enggak bisa kubiarkan.
Dialogue: 0,0:18:34.28,0:18:38.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan karena aku baik atau perhatian.
Dialogue: 0,0:18:39.07,0:18:43.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mungkin mikir aku ini orang\Nyang baik dan gampang didekati.
Dialogue: 0,0:18:44.95,0:18:49.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang selalu mikir\Naku jauh lebih baik dari aslinya.
Dialogue: 0,0:18:50.25,0:18:52.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benci itu.
Dialogue: 0,0:18:52.42,0:18:55.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak suka orang yang dekati aku\Ncuma karena mencari teman.
Dialogue: 0,0:18:55.76,0:18:58.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya itu sama sekali bukan diriku.
Dialogue: 0,0:18:58.80,0:19:02.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak, ya, jadi orang yang diberkati.\NEnggak kayak aku…
Dialogue: 0,0:19:02.26,0:19:03.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit hati dengarnya.
Dialogue: 0,0:19:04.01,0:19:05.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu ucapan yang menyakitkan.
Dialogue: 0,0:19:06.27,0:19:08.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Disukai sama orang yang enggak percaya diri,
Dialogue: 0,0:19:08.52,0:19:11.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau orang\Nyang mengasihani diri sendiri…
Dialogue: 0,0:19:11.98,0:19:14.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali enggak ada gunanya.
Dialogue: 0,0:19:14.32,0:19:15.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak jago berempati,
Dialogue: 0,0:19:15.98,0:19:17.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku enggak bisa bilang,\N"Aku mengerti perasaanmu."
Dialogue: 0,0:19:18.36,0:19:19.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau enggak suka,\Nkenapa enggak berhenti saja?
Dialogue: 0,0:19:20.82,0:19:23.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kesulitan\Njustru karena enggak bisa berhenti.
Dialogue: 0,0:19:23.78,0:19:26.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kamu enggak bakal mengerti, kan?
Dialogue: 0,0:19:27.08,0:19:31.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mencari teman sambil tetap jaga jarak.
Dialogue: 0,0:19:31.63,0:19:34.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa sekuat itu karena kamu manis.
Dialogue: 0,0:19:34.25,0:19:36.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang di atas enggak bakal mengerti.
Dialogue: 0,0:19:36.17,0:19:37.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku lakukan hal yang sama…
Dialogue: 0,0:19:37.59,0:19:40.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam…
Dialogue: 0,0:19:41.05,0:19:43.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ambil duri\Nyang lahir dari rasa rendah dirimu
Dialogue: 0,0:19:43.39,0:19:44.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terus menusuk orang lain pakai itu!
Dialogue: 0,0:19:45.64,0:19:47.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku sampai teriak begitu.
Dialogue: 0,0:19:53.02,0:19:56.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami enggak bakal pernah akur.
Dialogue: 0,0:19:58.74,0:20:01.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terlalu dekat sama dia.\NJaga jarakmu.
Dialogue: 0,0:20:02.03,0:20:04.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus sedikit bersikap dingin.
Dialogue: 0,0:20:04.28,0:20:06.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu yang kupikirkan.
Dialogue: 0,0:20:06.16,0:20:08.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rikako, kamu kejam banget.
Dialogue: 0,0:20:09.45,0:20:11.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak sadar sampai kamu bilang begitu.
Dialogue: 0,0:20:11.50,0:20:12.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makasih sudah mengingatkan aku.
Dialogue: 0,0:20:13.04,0:20:15.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak lagi cari nasihat.
Dialogue: 0,0:20:15.88,0:20:19.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.\NItu salah satu cara menyikapinnya.
Dialogue: 0,0:20:19.34,0:20:23.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan pas aku menolak dia,\Nbilang aku enggak niat terima…
Dialogue: 0,0:20:31.06,0:20:32.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pas aku sadar…
Dialogue: 0,0:20:33.65,0:20:38.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang bisa berteman sama kamu, Honchan.
Dialogue: 0,0:20:42.53,0:20:46.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sadar akulah yang diterima.
Dialogue: 0,0:20:48.29,0:20:50.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makin baik sikap Nishi,
Dialogue: 0,0:20:50.79,0:20:54.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku makin merasa nyaman tanpa dihakimi.
Dialogue: 0,0:20:54.92,0:20:58.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu mengingatkan aku\Nsama perlakuanku ke dia dulu.
Dialogue: 0,0:20:59.30,0:21:00.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hon… Honda.
Dialogue: 0,0:21:01.84,0:21:04.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi Nishi terlalu baik
Dialogue: 0,0:21:04.93,0:21:07.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}buat sadar niat jahatku.
Dialogue: 0,0:21:08.01,0:21:09.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kupikir,
Dialogue: 0,0:21:10.72,0:21:12.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}setidaknya aku bisa kasih kamu dorongan.
Dialogue: 0,0:21:14.10,0:21:16.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hubungan kayak apa\Nyang kamu mau sama Yamada?
Dialogue: 0,0:21:17.27,0:21:20.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau jadi pacarnya?\NAtau tetap berteman?
Dialogue: 0,0:21:25.86,0:21:28.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sadar sama perasaanku sendiri.
Dialogue: 0,0:21:29.03,0:21:31.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa itu cinta.
Dialogue: 0,0:21:31.33,0:21:34.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku enggak bisa bayangkan\Ndiriku jadi pacarnya.
Dialogue: 0,0:21:35.04,0:21:38.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, mengharapkan itu saja rasanya lancang.
Dialogue: 0,0:21:40.42,0:21:42.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, coba pikir dari sisi lain.
Dialogue: 0,0:21:44.13,0:21:46.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kalian tetap berteman begini,
Dialogue: 0,0:21:46.97,0:21:50.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan sementara itu,\NYamada jatuh cinta sama orang lain…
Dialogue: 0,0:21:51.10,0:21:53.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa dukung dia?
Dialogue: 0,0:21:53.81,0:21:55.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu enggak bakal menyesal?
Dialogue: 0,0:21:59.48,0:22:01.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu aku bakal menyesal.
Dialogue: 0,0:22:04.11,0:22:08.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin jadi pacar Yamada.
Dialogue: 0,0:22:08.70,0:22:14.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak pernah menyangka\Nbakal merasa kayak begini.
Dialogue: 0,0:22:14.87,0:22:16.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, aku punya kabar baik.
Dialogue: 0,0:22:16.58,0:22:17.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yamada suka cokelat.
Dialogue: 0,0:22:18.04,0:22:19.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kasih dia buat Hari Valentine.
Dialogue: 0,0:22:20.59,0:22:25.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, deh, acara itu terlalu romantis.
Dialogue: 0,0:22:27.38,0:22:28.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa begitu.
Dialogue: 0,0:22:28.80,0:22:31.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, Hari Valentine penting banget\Ndi tiap lingkaran pertemanan tiap tahun.
Dialogue: 0,0:22:32.06,0:22:33.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu "lingkaran pertemanan" apaan?
Dialogue: 0,0:22:33.77,0:22:35.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku semangat banget, nih!
