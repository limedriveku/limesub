Dialogue: 0,0:01:17.10,0:01:22.60,sign,,0000,0000,0000,,KAIJU DARA CARAMELISE
Dialogue: 0,0:10:18.56,0:10:22.60,sign,,0000,0000,0000,,GENDUT
Dialogue: 0,0:11:19.78,0:11:21.16,sign,,0000,0000,0000,,PANGERAN KAIJU, BERTEMU DENGAN KAIJU BARU
Dialogue: 0,0:11:36.93,0:11:38.30,sign,,0000,0000,0000,,SIARAN LANGSUNG TELAH TERHENTI
Dialogue: 0,0:14:56.46,0:14:59.96,sign,,0000,0000,0000,,EPISODE 11: KUROE VS AKAE
Dialogue: 0,0:00:02.73,0:00:06.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari seragamnya, mereka syuting\Nfilm Godora sang Raja Kaiju.
Dialogue: 0,0:00:06.86,0:00:09.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, itu Katsuragi Seina!
Dialogue: 0,0:00:09.24,0:00:10.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa?
Dialogue: 0,0:00:10.16,0:00:11.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:00:14.20,0:00:15.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:00:15.25,0:00:17.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami?
Dialogue: 0,0:00:27.59,0:00:29.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kurotaso!\N- Kuroe!
Dialogue: 0,0:00:31.43,0:00:34.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:00:34.26,0:00:39.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang aku yang minta putus,\Ntapi itu terlalu cepat, kan?
Dialogue: 0,0:00:39.94,0:00:42.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada harus sakit hati...
Dialogue: 0,0:00:42.44,0:00:45.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus kembali jadi diri yang dulu.
Dialogue: 0,0:00:45.82,0:00:49.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembali ke diriku yang belum tahu\Nbadai emosi ini.
Dialogue: 0,0:00:49.78,0:00:51.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu lebih baik!
Dialogue: 0,0:00:51.61,0:00:53.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia juga akan damai!
Dialogue: 0,0:02:42.89,0:02:43.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pacarmu?
Dialogue: 0,0:02:43.73,0:02:45.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, iya.
Dialogue: 0,0:02:46.52,0:02:49.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, wajahmu kelihatan galau.
Dialogue: 0,0:02:49.27,0:02:51.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu habis diajak putus?
Dialogue: 0,0:02:53.78,0:02:57.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, begitulah.
Dialogue: 0,0:02:57.57,0:02:59.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali.
Dialogue: 0,0:02:59.70,0:03:00.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:03:01.83,0:03:04.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajah aslinya begini?
Dialogue: 0,0:03:06.42,0:03:09.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tahu, enggak?
Dialogue: 0,0:03:09.00,0:03:10.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rubah Licik itu.
Dialogue: 0,0:03:10.80,0:03:15.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakatnya di dunia hiburan memang juara,\Ntapi dia wanita berbahaya.
Dialogue: 0,0:03:15.97,0:03:19.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menghalalkan segala cara\Ndemi reputasi acara dan kariernya.
Dialogue: 0,0:03:19.93,0:03:24.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemula yang mendekatinya,\Nakan diisap sari patinya sampai ke tulang.
Dialogue: 0,0:03:27.35,0:03:30.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah apa yang kamu tuju di industri ini,
Dialogue: 0,0:03:30.15,0:03:32.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kalau mau berhenti,\Nsekarang saatnya.
Dialogue: 0,0:03:32.90,0:03:37.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma ingin kembali punya\Nwaktu bersama pacarku.
Dialogue: 0,0:03:37.41,0:03:40.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Kok masuk dunia hiburan?
Dialogue: 0,0:03:40.41,0:03:42.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anu...
Dialogue: 0,0:03:42.91,0:03:46.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira kalau muncul di TV,\Norang-orang akan bosan.
Dialogue: 0,0:03:46.16,0:03:48.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekaligus menyampaikan\Nfakta soal Harugon.
Dialogue: 0,0:03:48.46,0:03:50.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar tumpul.
Dialogue: 0,0:03:50.29,0:03:53.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sifat polosmu itu malah dimanfaatkan.
Dialogue: 0,0:03:53.55,0:03:57.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saking tidak pekanya, pasti kamu\Ntidak menyadari perasaan pacarmu.
Dialogue: 0,0:04:02.64,0:04:05.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja, jangan khawatir.
Dialogue: 0,0:04:05.64,0:04:07.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya.
Dialogue: 0,0:04:12.19,0:04:15.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, apa-apaan aku ini?
Dialogue: 0,0:04:19.27,0:04:22.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya latihan, Pemula.
Dialogue: 0,0:04:22.12,0:04:23.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Adegan reuni sambil pelukan.
Dialogue: 0,0:04:23.74,0:04:24.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:04:24.45,0:04:26.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau protes?
Dialogue: 0,0:04:26.25,0:04:27.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian,
Dialogue: 0,0:04:27.33,0:04:31.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku memang mau kita akting bareng,\Ntapi kenapa harus jadi pacar?
Dialogue: 0,0:04:31.08,0:04:33.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf!
Dialogue: 0,0:04:41.18,0:04:44.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah! Harus lebih bergairah!
Dialogue: 0,0:04:44.06,0:04:47.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya itu cuma latihan akting?
Dialogue: 0,0:04:47.35,0:04:48.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:04:49.89,0:04:52.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus segera meluruskan\Nkesalahpahaman Kuroe!
Dialogue: 0,0:04:52.94,0:04:54.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia lari ke arah sana, kan?
Dialogue: 0,0:04:58.24,0:04:59.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:04:59.53,0:05:01.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara apa itu?
Dialogue: 0,0:05:01.24,0:05:02.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ledakan?
Dialogue: 0,0:05:09.16,0:05:10.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mu-Mustahil.
Dialogue: 0,0:05:10.67,0:05:12.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaiju?
Dialogue: 0,0:05:12.71,0:05:16.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkinkah dia datang\Nuntuk mengalahkanku?
Dialogue: 0,0:05:17.96,0:05:21.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak...
Dialogue: 0,0:05:22.26,0:05:24.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin, ah!
Dialogue: 0,0:05:24.51,0:05:26.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan film kaiju!
Dialogue: 0,0:06:48.55,0:06:53.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata dia memang mengincarku!
Dialogue: 0,0:07:03.82,0:07:05.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:07:05.03,0:07:06.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan syutingnya!
Dialogue: 0,0:07:06.57,0:07:07.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jeda dulu!
Dialogue: 0,0:07:10.37,0:07:13.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaiju? Bukan Harugon?
Dialogue: 0,0:07:13.91,0:07:16.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia membabi buta!
Dialogue: 0,0:07:16.00,0:07:16.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya...
Dialogue: 0,0:07:16.67,0:07:18.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini, Manaty?
Dialogue: 0,0:07:18.79,0:07:21.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tentu saja...
Dialogue: 0,0:07:21.71,0:07:24.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus menghampirinya!
Dialogue: 0,0:07:25.34,0:07:27.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaiju baru telah muncul!
Dialogue: 0,0:07:27.22,0:07:28.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo lari!
Dialogue: 0,0:07:28.76,0:07:30.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namamu!
Dialogue: 0,0:07:30.01,0:07:31.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Manatsu?\N- Tolong beri tahu siapa namamu!
Dialogue: 0,0:07:31.35,0:07:33.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dan teman sekelasnya...\N- Tolong beri tahu siapa namamu!
Dialogue: 0,0:07:33.10,0:07:36.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, Minami!\NKurotaso lari ke arah kaiju itu!
Dialogue: 0,0:07:36.64,0:07:37.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:07:37.19,0:07:39.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya kami bersama-sama!
Dialogue: 0,0:07:39.40,0:07:42.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dia syok melihat adegan pelukanmu!
Dialogue: 0,0:07:42.94,0:07:46.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa melamun?\NAyo cepat lari!
Dialogue: 0,0:07:48.86,0:07:50.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi.
Dialogue: 0,0:07:50.16,0:07:51.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi?
Dialogue: 0,0:07:51.33,0:07:52.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:07:52.58,0:07:55.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau ke sana?\NSudah bosan hidup, ya?
Dialogue: 0,0:07:57.83,0:07:58.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:07:59.79,0:08:02.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami pasti kembali! Berdua!
Dialogue: 0,0:08:03.71,0:08:05.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian larilah!
Dialogue: 0,0:08:05.59,0:08:07.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berjuanglah, Minami!
Dialogue: 0,0:08:07.55,0:08:09.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu harus kembali!
Dialogue: 0,0:08:09.84,0:08:13.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, aku jadi kayak pacar aslinya, dong!
Dialogue: 0,0:08:13.31,0:08:16.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku juga tidak bisa tinggal diam!\N- Seina sungguhan!
Dialogue: 0,0:08:16.02,0:08:17.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengikuti media sosialmu sejak lama!
Dialogue: 0,0:08:17.94,0:08:19.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Makasih...
Dialogue: 0,0:08:20.69,0:08:21.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamerawan, kejar dia!
Dialogue: 0,0:08:21.86,0:08:23.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Kamu bicara apa?
Dialogue: 0,0:08:23.90,0:08:27.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah, ini kesempatan kita\Nmenarik penonton!
Dialogue: 0,0:08:27.53,0:08:29.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berita terkini.
Dialogue: 0,0:08:29.53,0:08:32.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makhluk terbang raksasa\Ntelah muncul di Harumi.
Dialogue: 0,0:08:32.49,0:08:36.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warga sekitar lokasi\Nharap segera mengungsi.
Dialogue: 0,0:08:37.00,0:08:39.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makhluk terbang raksasa\Ntelah muncul di Harumi.
Dialogue: 0,0:08:39.91,0:08:42.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warga sekitar lokasi\Nharap segera mengungsi.
Dialogue: 0,0:08:49.05,0:08:51.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mencariku.
Dialogue: 0,0:08:53.22,0:08:54.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini?
Dialogue: 0,0:08:54.47,0:08:57.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini, akan banyak korban.
Dialogue: 0,0:08:58.27,0:08:59.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:09:31.01,0:09:34.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, enggak!\NMustahil melawan makhluk itu!
Dialogue: 0,0:09:39.39,0:09:41.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketemu! Di sana!
Dialogue: 0,0:09:41.35,0:09:43.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi!
Dialogue: 0,0:09:43.60,0:09:45.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi!
Dialogue: 0,0:09:50.19,0:09:53.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi itu keren, ya.
Dialogue: 0,0:09:53.78,0:09:56.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya dia selalu menunduk?
Dialogue: 0,0:09:56.78,0:10:00.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tatapannya sangat kuat.
Dialogue: 0,0:10:00.54,0:10:03.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia seolah selalu melawan sesuatu.
Dialogue: 0,0:10:08.09,0:10:09.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayak samurai!
Dialogue: 0,0:10:09.76,0:10:11.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu cuma dipandang sinis, tahu.
Dialogue: 0,0:10:14.59,0:10:18.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir dia pasti jauh berbeda denganku.
Dialogue: 0,0:10:22.60,0:10:28.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diriku yang takut bila akan\Nsendiri lagi seperti dulu...
Dialogue: 0,0:10:32.28,0:10:33.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makan ini.
Dialogue: 0,0:10:34.57,0:10:38.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak peduli\Nkamu gendut atau cungkring.
Dialogue: 0,0:10:38.62,0:10:42.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi hari ini, aku bersyukur\Ndatang ke sini bersamamu.
Dialogue: 0,0:10:44.33,0:10:48.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada juga manusia seperti itu di sekitarmu.
Dialogue: 0,0:10:48.54,0:10:52.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya, ada satu.
Dialogue: 0,0:11:09.02,0:11:11.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Manatsu dan Rairi sudah kabur?
Dialogue: 0,0:11:13.61,0:11:15.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurotaso, kamu masih hidup?
Dialogue: 0,0:11:15.11,0:11:16.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah ketemu Minami?
Dialogue: 0,0:11:16.78,0:11:17.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurotaso, kamu aman?
Dialogue: 0,0:11:17.99,0:11:19.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, lihat video ini!
Dialogue: 0,0:11:21.74,0:11:24.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi!
Dialogue: 0,0:11:24.96,0:11:26.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami?
Dialogue: 0,0:11:27.00,0:11:28.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi!
Dialogue: 0,0:11:43.18,0:11:44.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami...
Dialogue: 0,0:11:51.19,0:11:52.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami!
Dialogue: 0,0:12:02.28,0:12:03.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia...
Dialogue: 0,0:12:08.37,0:12:11.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asyik, dapat adegan mantap!
Dialogue: 0,0:12:28.60,0:12:30.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Indah, kok.
Dialogue: 0,0:12:39.11,0:12:40.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi!
Dialogue: 0,0:12:47.91,0:12:48.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak mau.
Dialogue: 0,0:12:50.12,0:12:51.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak mau berakhir seperti ini!
Dialogue: 0,0:13:15.77,0:13:19.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar mencintaimu!
Dialogue: 0,0:13:27.08,0:13:28.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami!
Dialogue: 0,0:13:29.37,0:13:31.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi!
Dialogue: 0,0:13:40.26,0:13:41.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami!
Dialogue: 0,0:13:51.23,0:13:52.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi!
Dialogue: 0,0:13:53.73,0:13:55.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami!
Dialogue: 0,0:13:55.31,0:13:57.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi...
Dialogue: 0,0:14:05.99,0:14:07.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi!
Dialogue: 0,0:14:16.96,0:14:18.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami!
Dialogue: 0,0:14:54.33,0:14:55.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi?
Dialogue: 0,0:16:18.25,0:16:20.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harugon bertarung melawan kaiju!
Dialogue: 0,0:16:20.46,0:16:23.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kita terlalu dekat?
Dialogue: 0,0:16:23.21,0:16:26.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diempaskan oleh Harugon\Nadalah kehormatan bagiku!
Dialogue: 0,0:16:26.34,0:16:28.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bercanda!
Dialogue: 0,0:16:29.72,0:16:31.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:16:31.60,0:16:34.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turunkan aku di tempat aman!
Dialogue: 0,0:16:34.51,0:16:37.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku harus ikut naik juga?
Dialogue: 0,0:16:37.56,0:16:39.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naik helikopter lebih aman, lo.
Dialogue: 0,0:16:43.61,0:16:47.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, mendekat ke Harugon!
Dialogue: 0,0:16:47.11,0:16:47.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Roger.
Dialogue: 0,0:16:47.82,0:16:49.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manaty!
Dialogue: 0,0:16:50.07,0:16:53.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan melihat aksi Harugon dari dekat!
Dialogue: 0,0:16:53.49,0:16:58.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan! Hentikan! Hentikan!\NTidak!
Dialogue: 0,0:17:37.49,0:17:39.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh di luar dugaan!
Dialogue: 0,0:17:39.41,0:17:44.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makhluk raksasa sedang mencoba\Nmendominasi makhluk terbang raksasa!
Dialogue: 0,0:17:44.25,0:17:48.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sedang melihat pemandangan\Nyang sulit dipercaya!
Dialogue: 0,0:17:48.55,0:17:50.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harugon!
Dialogue: 0,0:17:51.01,0:17:54.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, Harugon! Hajar dia!
Dialogue: 0,0:17:56.93,0:17:58.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harugon...
Dialogue: 0,0:18:12.32,0:18:14.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak sanggup!
Dialogue: 0,0:18:17.91,0:18:21.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski berwujud kaiju,\Naku tetap takut, tahu!
Dialogue: 0,0:18:21.58,0:18:24.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}JSDF jangan cuma nonton!\NBantu, dong!
Dialogue: 0,0:18:24.83,0:18:26.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat!
Dialogue: 0,0:18:26.17,0:18:27.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dihajar Harugon, tuh!
Dialogue: 0,0:18:27.34,0:18:29.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berjuanglah, Harugon!
Dialogue: 0,0:18:29.38,0:18:31.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, enggak, enggak!
Dialogue: 0,0:18:31.92,0:18:34.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan berharap padaku!
Dialogue: 0,0:18:39.77,0:18:41.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya aku
Dialogue: 0,0:18:44.27,0:18:48.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}cuma gadis SMA biasa, tahu!
Dialogue: 0,0:18:53.28,0:18:55.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Su-Sulit dipercaya!
Dialogue: 0,0:18:55.91,0:18:58.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makhluk raksasa alias Harugon,
Dialogue: 0,0:18:58.49,0:19:03.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}telah mendominasi\Nmakhluk terbang raksasa!
Dialogue: 0,0:19:07.08,0:19:09.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah!
Dialogue: 0,0:19:11.84,0:19:14.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat! Luar biasa!
Dialogue: 0,0:19:14.38,0:19:17.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang kamulah yang nomor satu!
Dialogue: 0,0:19:17.34,0:19:19.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahaya, Manaty!
Dialogue: 0,0:19:19.47,0:19:21.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manatsu? Rairi?
Dialogue: 0,0:19:21.72,0:19:23.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kalian selamat!
Dialogue: 0,0:19:23.60,0:19:26.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo lebih dekat lagi!
Dialogue: 0,0:19:26.02,0:19:27.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:19:27.60,0:19:29.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turunkan aku!
Dialogue: 0,0:19:29.15,0:19:32.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, padahal kita\Nada di kursi naratama, lo.
Dialogue: 0,0:19:32.53,0:19:35.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mubazir kalau sembunyi, Seina.
Dialogue: 0,0:19:35.36,0:19:37.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:19:38.07,0:19:40.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Minami baik-baik saja?
Dialogue: 0,0:19:49.04,0:19:52.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana dia?\NApa dia terluka?
Dialogue: 0,0:19:53.46,0:19:56.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin cepat kembali ke wujud semula.
Dialogue: 0,0:19:56.63,0:19:59.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin segera bertemu dengannya!
Dialogue: 0,0:20:00.55,0:20:02.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin sebaiknya kita putus.
Dialogue: 0,0:20:04.68,0:20:08.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodohnya aku!\NBisa-bisanya bilang begitu!
Dialogue: 0,0:20:09.52,0:20:10.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal...
Dialogue: 0,0:20:11.73,0:20:13.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal...
Dialogue: 0,0:20:13.98,0:20:15.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat mencintainya!
Dialogue: 0,0:20:17.53,0:20:19.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:20:19.74,0:20:21.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:20:21.70,0:20:24.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh bodoh!
Dialogue: 0,0:20:24.95,0:20:29.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makhluk raksasa kembali mendekat\Nke arah Harumi dengan cepat!
Dialogue: 0,0:20:29.12,0:20:31.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segeralah mengungsi!
Dialogue: 0,0:20:31.96,0:20:33.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami.
Dialogue: 0,0:20:33.88,0:20:35.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami!
Dialogue: 0,0:20:36.30,0:20:37.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami!
Dialogue: 0,0:20:41.26,0:20:43.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian juga cepat mengungsi!
Dialogue: 0,0:20:43.18,0:20:45.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, jangan berhenti!
Dialogue: 0,0:20:45.56,0:20:48.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih, padahal aku ingin lihat dari dekat.
Dialogue: 0,0:20:49.10,0:20:50.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, ayo pergi!
Dialogue: 0,0:20:51.15,0:20:52.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan pergi.
Dialogue: 0,0:20:54.11,0:20:55.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ada di sini.
Dialogue: 0,0:21:04.45,0:21:07.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku juga di sini!
Dialogue: 0,0:21:07.37,0:21:07.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:21:07.87,0:21:11.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka Kak Kuroe lebih darimu!
Dialogue: 0,0:21:11.33,0:21:12.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wek!
Dialogue: 0,0:21:14.50,0:21:16.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kayak anak kecil, ya.
Dialogue: 0,0:21:16.42,0:21:17.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang anak kecil!
Dialogue: 0,0:21:24.51,0:21:26.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}SD? Serius?
Dialogue: 0,0:21:26.43,0:21:28.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang anak SD,
Dialogue: 0,0:21:28.39,0:21:30.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi enggak akan kalah darimu!
Dialogue: 0,0:21:32.60,0:21:34.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami!
Dialogue: 0,0:21:36.82,0:21:39.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan hiraukan aku
Dialogue: 0,0:21:40.86,0:21:42.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan terbanglah tinggi.
Dialogue: 0,0:21:43.95,0:21:48.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku tidak mendengar penjelasannya?
Dialogue: 0,0:21:57.80,0:22:00.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:22:00.38,0:22:03.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaiju-nya bersinar.
Dialogue: 0,0:22:03.80,0:22:05.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:22:12.06,0:22:14.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harugon, lari!
Dialogue: 0,0:22:34.46,0:22:36.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harugon!
Dialogue: 0,0:24:08.59,0:24:11.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manisan berikutnya adalah panekuk.
Dialogue: 0,0:24:11.39,0:24:14.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembali bersama Minami...
