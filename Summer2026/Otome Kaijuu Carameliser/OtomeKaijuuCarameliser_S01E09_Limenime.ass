Dialogue: 0,0:00:10.37,0:00:12.58,sign,,0000,0000,0000,,OBROLAN TANPA HENTI\NRUANGAN MINAMI ARATA
Dialogue: 0,0:01:28.32,0:01:32.49,sign,,0000,0000,0000,,AKAISHI KUROE
Dialogue: 0,0:03:36.11,0:03:41.62,sign,,0000,0000,0000,,KAIJU DARA CARAMELISE
Dialogue: 0,0:04:56.98,0:05:00.49,sign,,0000,0000,0000,,EPISODE 9:\NKAIJU DARA, CURAHKAN KELUH KESAHMU!
Dialogue: 0,0:05:39.32,0:05:39.82,sign,,0000,0000,0000,,AKU MENGEJAR TUR MAYU DULU! LUSA SUDAH PULANG, KOK
Dialogue: 0,0:05:39.82,0:05:40.28,sign,,0000,0000,0000,,JANGAN LUPA BERKABAR!\NTITIP JUMBO KING JUGA!
Dialogue: 0,0:16:17.00,0:16:18.33,sign,,0000,0000,0000,,17 TAHUN LALU
Dialogue: 0,0:00:04.44,0:00:07.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan melindungimu, Harugon.
Dialogue: 0,0:00:12.93,0:00:15.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sempurna, Pangeran!
Dialogue: 0,0:00:15.29,0:00:17.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok tidak sesuai janji?
Dialogue: 0,0:00:18.00,0:00:22.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok bukan siaran berita,\NProduser Takamine?
Dialogue: 0,0:00:22.29,0:00:26.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya orang mengenal\Ndirimu apa adanya dulu.
Dialogue: 0,0:00:26.76,0:00:30.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di acara selanjutnya kamu bebas bicara.
Dialogue: 0,0:00:30.64,0:00:32.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya?
Dialogue: 0,0:00:34.39,0:00:36.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari berjuang.
Dialogue: 0,0:00:36.39,0:00:38.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi orang terkasihmu juga.
Dialogue: 0,0:00:39.94,0:00:41.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menyiapkan mobil.
Dialogue: 0,0:00:59.04,0:01:00.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi?
Dialogue: 0,0:01:00.12,0:01:02.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah terhubung!
Dialogue: 0,0:01:02.00,0:01:03.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku meneleponmu berkali-kali.
Dialogue: 0,0:01:03.75,0:01:07.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mi-Minami, apa-apaan itu?
Dialogue: 0,0:01:07.71,0:01:10.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, kamu pasti kaget.
Dialogue: 0,0:01:10.63,0:01:12.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kujelaskan nanti.
Dialogue: 0,0:01:12.89,0:01:14.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa ketemuan di tempat biasa?
Dialogue: 0,0:01:16.14,0:01:17.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya.
Dialogue: 0,0:01:19.60,0:01:20.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa.
Dialogue: 0,0:01:21.52,0:01:23.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan sampai dalam satu jam.
Dialogue: 0,0:01:23.31,0:01:24.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, ya.
Dialogue: 0,0:01:25.48,0:01:28.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, akan kutunggu.
Dialogue: 0,0:01:33.53,0:01:35.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya ini?
Dialogue: 0,0:01:35.24,0:01:37.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya aku bintang tamu hari ini?
Dialogue: 0,0:01:37.83,0:01:40.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau dia Pangeran Kaiju atau apalah itu.
Dialogue: 0,0:01:40.41,0:01:44.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aktris sekelas aku malah diserobot?
Dialogue: 0,0:01:46.04,0:01:48.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf, Nona Seina.
Dialogue: 0,0:01:48.59,0:01:50.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak terima!
Dialogue: 0,0:01:50.05,0:01:52.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelaskan yang benar!
Dialogue: 0,0:01:53.01,0:01:53.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu!
Dialogue: 0,0:01:59.64,0:02:00.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:02:01.98,0:02:04.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, bukan dia yang salah...
Dialogue: 0,0:02:04.73,0:02:05.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang!
Dialogue: 0,0:02:05.61,0:02:06.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh!
Dialogue: 0,0:02:07.57,0:02:09.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini salahmu.
Dialogue: 0,0:02:09.78,0:02:11.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat tanggung jawab.
Dialogue: 0,0:02:12.61,0:02:14.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kepalang promosi di sosial media
Dialogue: 0,0:02:14.99,0:02:17.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menyiapkan topi segala!
Dialogue: 0,0:02:17.66,0:02:23.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi, tampil di acara ini\Nadalah impianku.
Dialogue: 0,0:02:26.92,0:02:31.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf telah merusak impianmu.
Dialogue: 0,0:02:33.93,0:02:38.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katakan saja kalau ada yang bisa kubantu.
Dialogue: 0,0:02:40.64,0:02:42.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:02:42.48,0:02:46.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bela aku di depan Rubah Licik itu!
Dialogue: 0,0:02:46.27,0:02:47.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ru-Rubah Licik?
Dialogue: 0,0:02:47.98,0:02:51.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Produser itu menyukaimu, kan?
Dialogue: 0,0:02:51.44,0:02:53.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu, Bu Takamine?
Dialogue: 0,0:02:53.99,0:02:55.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:02:55.24,0:02:58.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng, akan kuusahakan.
Dialogue: 0,0:03:03.41,0:03:04.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong, ya.
Dialogue: 0,0:03:04.96,0:03:09.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak sabar sepanggung\Ndenganmu, Pangeran.
Dialogue: 0,0:03:09.88,0:03:11.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo pulang, Koyama!
Dialogue: 0,0:03:11.50,0:03:13.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik!
Dialogue: 0,0:03:14.22,0:03:15.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Seina?
Dialogue: 0,0:03:15.72,0:03:17.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama tidak melihat
Dialogue: 0,0:03:17.30,0:03:20.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Maaf membuatmu menunggu lama.\N- ekspresi selugu itu.
Dialogue: 0,0:03:22.60,0:03:26.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin, aku akan membuat kaiju murka.
Dialogue: 0,0:05:08.91,0:05:10.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi!
Dialogue: 0,0:05:15.00,0:05:15.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mi...
Dialogue: 0,0:05:16.46,0:05:19.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami, lama tidak jumpa!
Dialogue: 0,0:05:19.55,0:05:22.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku sangat merindukanmu!
Dialogue: 0,0:05:22.22,0:05:24.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku juga.
Dialogue: 0,0:05:24.43,0:05:26.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan waktunya membahas itu!
Dialogue: 0,0:05:26.81,0:05:28.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok kamu masuk TV?
Dialogue: 0,0:05:31.48,0:05:33.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf.
Dialogue: 0,0:05:33.56,0:05:34.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ayo pindah tempat dulu.\N- Itu Minami!
Dialogue: 0,0:05:34.86,0:05:35.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ayo pindah tempat dulu.\N- Benaran?
Dialogue: 0,0:05:35.73,0:05:37.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Restoran keluarga, ramai.\N- Apa aku boleh membuntutinya?
Dialogue: 0,0:05:37.78,0:05:39.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Di dekat sini...\N- Apa aku boleh membuntutinya?
Dialogue: 0,0:05:40.28,0:05:42.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu nonton tur Mayu dulu!
Dialogue: 0,0:05:42.82,0:05:44.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu mau,
Dialogue: 0,0:05:44.78,0:05:46.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}datanglah ke rumahku!
Dialogue: 0,0:05:48.95,0:05:50.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kita lolos?
Dialogue: 0,0:05:50.50,0:05:52.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, seharusnya.
Dialogue: 0,0:05:54.50,0:05:56.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, benaran boleh?
Dialogue: 0,0:05:56.92,0:05:59.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mengganggu mampir mendadak?
Dialogue: 0,0:06:00.46,0:06:01.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aman.
Dialogue: 0,0:06:01.92,0:06:06.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang tuaku baru akan pulang lusa.
Dialogue: 0,0:06:06.18,0:06:08.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Oh.
Dialogue: 0,0:06:08.56,0:06:10.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Begitu, ya.
Dialogue: 0,0:06:10.56,0:06:12.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sudah larut.\NAku tidak akan lama.
Dialogue: 0,0:06:13.35,0:06:15.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santai saja, ya.
Dialogue: 0,0:06:15.61,0:06:17.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agak berantakan, sih.
Dialogue: 0,0:06:19.44,0:06:20.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf mengganggu.
Dialogue: 0,0:06:26.24,0:06:29.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pakai sandal rumah atau enggak?
Dialogue: 0,0:06:29.12,0:06:30.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana saja boleh.
Dialogue: 0,0:06:30.70,0:06:32.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gelap banget, ya!
Dialogue: 0,0:06:32.75,0:06:34.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lampu, lampu...
Dialogue: 0,0:06:34.83,0:06:37.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo, di mana?
Dialogue: 0,0:06:37.79,0:06:39.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini?
Dialogue: 0,0:06:42.63,0:06:43.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:06:44.63,0:06:46.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:06:47.14,0:06:49.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:06:50.01,0:06:51.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurang peka bahaya?
Dialogue: 0,0:06:51.85,0:06:53.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenanglah!
Dialogue: 0,0:06:53.43,0:06:57.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke rumah pacar bukan berarti begituan!\NMinami bukan tipe seperti itu!
Dialogue: 0,0:06:57.90,0:06:58.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi.
Dialogue: 0,0:06:59.69,0:07:00.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh peluk?
Dialogue: 0,0:07:04.99,0:07:06.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:07:06.82,0:07:09.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ciuman saja belum!
Dialogue: 0,0:07:09.37,0:07:13.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mentang-mentang jarang bertemu\Nkok mintanya begitu?
Dialogue: 0,0:07:14.33,0:07:16.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini terlalu cepat!
Dialogue: 0,0:07:16.58,0:07:20.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beginikah anak muda zaman sekarang?
Dialogue: 0,0:07:20.09,0:07:21.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak boleh?
Dialogue: 0,0:07:21.25,0:07:25.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau diminta setulus itu...
Dialogue: 0,0:07:30.85,0:07:33.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, warga sekalian.
Dialogue: 0,0:07:33.57,0:07:36.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malam ini, Tokyo akan rata.
Dialogue: 0,0:07:36.44,0:07:39.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Se-Sebentar saja, ya!
Dialogue: 0,0:07:39.15,0:07:40.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asyik!
Dialogue: 0,0:07:42.11,0:07:45.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imutnya!\NAku sangat suka anjing!
Dialogue: 0,0:07:46.32,0:07:48.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa namanya?
Dialogue: 0,0:07:49.16,0:07:50.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jumbo King.
Dialogue: 0,0:07:51.78,0:07:53.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keren!
Dialogue: 0,0:07:53.20,0:07:54.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:07:54.75,0:07:57.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayak pernah lihat...
Dialogue: 0,0:07:59.25,0:08:00.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudahlah!
Dialogue: 0,0:08:00.67,0:08:04.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia benar-benar pelipur lara\Nsetelah semua ini!
Dialogue: 0,0:08:04.88,0:08:06.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Akaishi!
Dialogue: 0,0:08:07.43,0:08:11.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, peluklah sepuasmu.
Dialogue: 0,0:08:13.14,0:08:16.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warga sekalian, ternyata aman.
Dialogue: 0,0:08:18.81,0:08:20.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti,
Dialogue: 0,0:08:20.06,0:08:25.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu sengaja muncul di TV\Nsampai warganet bosan?
Dialogue: 0,0:08:25.74,0:08:27.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu?
Dialogue: 0,0:08:27.49,0:08:28.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:08:28.70,0:08:30.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sa-Santai banget...
Dialogue: 0,0:08:30.95,0:08:36.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebulan lagi atau habis libur musim panas,\Nseharusnya mereka sudah lupa.
Dialogue: 0,0:08:36.58,0:08:39.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya enggak semudah itu.
Dialogue: 0,0:08:39.83,0:08:40.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya...
Dialogue: 0,0:08:41.58,0:08:42.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku topiknya.
Dialogue: 0,0:08:42.46,0:08:44.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ju-Justru laku!
Dialogue: 0,0:08:44.80,0:08:47.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja!\NPasti ada jalan!
Dialogue: 0,0:08:47.55,0:08:51.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari cemas, aku malah jadi agak sebal.
Dialogue: 0,0:08:51.14,0:08:52.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu...
Dialogue: 0,0:08:52.97,0:08:55.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin memberi tahu masyarakat
Dialogue: 0,0:08:55.77,0:08:59.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahwa Harugon bukanlah kaiju jahat.
Dialogue: 0,0:09:00.90,0:09:05.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu yakin dia tidak jahat?
Dialogue: 0,0:09:06.65,0:09:10.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku sendiri\Ntidak paham jati diriku.
Dialogue: 0,0:09:11.07,0:09:14.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahu apa kamu tentangku?
Dialogue: 0,0:09:16.08,0:09:17.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentangmu?
Dialogue: 0,0:09:18.29,0:09:19.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku itu, lo!
Dialogue: 0,0:09:19.91,0:09:22.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalaupun enggak jahat,\Ntetap saja Harugon merusak.
Dialogue: 0,0:09:22.37,0:09:25.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa kamu terlalu cepat menilai!
Dialogue: 0,0:09:26.25,0:09:27.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:09:27.71,0:09:30.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah sering memikirkannya sendiri.
Dialogue: 0,0:09:31.55,0:09:33.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kelihatan agak kesal?
Dialogue: 0,0:09:34.60,0:09:36.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru kali ini aku melihatnya.
Dialogue: 0,0:09:36.56,0:09:41.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, padahal dia\Nsudah berusaha demi aku.
Dialogue: 0,0:09:41.10,0:09:43.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku juga minta maaf.
Dialogue: 0,0:09:43.60,0:09:46.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu enggak salah apa-apa.
Dialogue: 0,0:09:47.73,0:09:50.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang, jangan khawatir.
Dialogue: 0,0:09:50.78,0:09:52.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya.
Dialogue: 0,0:09:53.57,0:09:58.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti akan makin terkenal.
Dialogue: 0,0:09:58.20,0:10:01.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bicara, takutnya ucapanku negatif.
Dialogue: 0,0:10:01.62,0:10:05.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau goyah cuma karena ini,\Naku tidak pantas jadi pacar Minami!
Dialogue: 0,0:10:05.75,0:10:08.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Telan kecemasanku!
Dialogue: 0,0:10:10.80,0:10:14.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?\NHatiku mendadak sesak.
Dialogue: 0,0:10:14.47,0:10:16.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya ada yang mau keluar!
Dialogue: 0,0:10:16.51,0:10:18.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?\NKamu baik-baik saja?
Dialogue: 0,0:10:18.18,0:10:21.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya, aku cuma kebanyakan makan.
Dialogue: 0,0:10:22.64,0:10:25.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jidatmu merah.
Dialogue: 0,0:10:25.27,0:10:25.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:10:25.98,0:10:27.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ini.
Dialogue: 0,0:10:28.57,0:10:30.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kena topi seorang aktris.
Dialogue: 0,0:10:31.32,0:10:33.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aktris?
Dialogue: 0,0:10:33.53,0:10:36.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara aku merebut jam tampilnya.
Dialogue: 0,0:10:36.32,0:10:38.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dia kelihatan baik.
Dialogue: 0,0:10:38.62,0:10:43.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oh? Aktris, ya?\NHebat...
Dialogue: 0,0:10:43.41,0:10:45.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Topinya kena jidat?
Dialogue: 0,0:10:46.08,0:10:49.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jarak kalian sedekat apa?\NSiapa nama aktris itu?
Dialogue: 0,0:10:51.17,0:10:53.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jumbo King bisa salaman, toh!
Dialogue: 0,0:10:53.88,0:10:56.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi, Jumbo King.
Dialogue: 0,0:11:00.89,0:11:03.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Ada yang keluar!
Dialogue: 0,0:11:09.94,0:11:10.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunyi apa itu?
Dialogue: 0,0:11:11.48,0:11:14.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Festival Kembang Api Sungai Sumida.
Dialogue: 0,0:11:14.03,0:11:16.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo, memangnya ada?
Dialogue: 0,0:11:16.36,0:11:19.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf, aku kurang enak badan.
Dialogue: 0,0:11:19.99,0:11:21.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:11:22.33,0:11:24.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada apa-apa, panggil aku.
Dialogue: 0,0:11:24.66,0:11:26.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, maaf.
Dialogue: 0,0:11:32.05,0:11:33.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia baik-baik saja?
Dialogue: 0,0:11:35.76,0:11:38.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Festival kembang apinya di mana?
Dialogue: 0,0:11:39.39,0:11:42.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuhku makin aneh saj—
Dialogue: 0,0:11:46.89,0:11:51.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dunia tahu pacarnya Minami begini...
Dialogue: 0,0:11:53.32,0:11:55.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berkilau banget.
Dialogue: 0,0:11:57.36,0:12:02.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami, kapan kita bisa ketemu\Ndan berduaan lagi?
Dialogue: 0,0:12:03.74,0:12:07.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuharap kamu tidak pergi terlalu jauh.
Dialogue: 0,0:12:13.88,0:12:16.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hatiku rasanya masih gelisah.
Dialogue: 0,0:12:16.63,0:12:18.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurotaso!
Dialogue: 0,0:12:18.76,0:12:20.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu lihat siaran TV?
Dialogue: 0,0:12:20.34,0:12:21.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pacarmu di luar nalar!
Dialogue: 0,0:12:21.80,0:12:24.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu enggak keberatan, nih?
Dialogue: 0,0:12:24.26,0:12:26.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Enggak.
Dialogue: 0,0:12:26.10,0:12:28.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga melihatnya.
Dialogue: 0,0:12:28.94,0:12:32.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan acara itu?
Dialogue: 0,0:12:32.11,0:12:37.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami dan Harugon diperlakukan\Nseolah sepasang kekasih.
Dialogue: 0,0:12:37.65,0:12:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal selagi dia asyik sendiri,\Ncinta kami terus bertumbuh.
Dialogue: 0,0:12:44.33,0:12:49.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami enggak tahu apa-apa soal Harugon!
Dialogue: 0,0:12:49.12,0:12:49.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar.
Dialogue: 0,0:12:49.96,0:12:51.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arata!
Dialogue: 0,0:12:51.29,0:12:53.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kamu hebat banget!\N- Si Artis datang juga!
Dialogue: 0,0:12:54.55,0:12:55.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi!
Dialogue: 0,0:12:55.84,0:12:56.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu sudah seha—
Dialogue: 0,0:12:56.71,0:12:58.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami, aku melihatmu di TV!
Dialogue: 0,0:12:58.47,0:12:59.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keren!
Dialogue: 0,0:13:00.88,0:13:02.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?
Dialogue: 0,0:13:02.47,0:13:04.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu justru kata-kataku.
Dialogue: 0,0:13:04.43,0:13:07.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya, aku baik-baik saja.
Dialogue: 0,0:13:07.89,0:13:11.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, studio Obrolan Tanpa Henti\Nitu seperti apa?
Dialogue: 0,0:13:11.73,0:13:12.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah...
Dialogue: 0,0:13:14.73,0:13:16.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, wah.
Dialogue: 0,0:13:16.57,0:13:19.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia populer seperti biasa.
Dialogue: 0,0:13:19.32,0:13:22.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurotaso, kalian benaran\Nenggak ada waktu berduaan?
Dialogue: 0,0:13:22.87,0:13:25.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kalau di luar memang sulit.
Dialogue: 0,0:13:25.49,0:13:27.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, berhati-hatilah.
Dialogue: 0,0:13:27.79,0:13:28.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:13:28.29,0:13:31.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sampai ditikung\Nkarena jarang bertemu.
Dialogue: 0,0:13:31.79,0:13:35.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa saja dia diincar model atau aktris!
Dialogue: 0,0:13:39.67,0:13:41.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ih, ngeri!
Dialogue: 0,0:13:44.14,0:13:45.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ngeri banget!
Dialogue: 0,0:13:45.97,0:13:48.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku siap mendengar curhatmu, kok!
Dialogue: 0,0:13:51.89,0:13:55.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku makin mual karena omongan Rairi.
Dialogue: 0,0:13:55.61,0:13:57.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidur awal saja hari ini.
Dialogue: 0,0:13:59.86,0:14:00.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:14:06.74,0:14:09.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memanggilmu.
Dialogue: 0,0:14:10.79,0:14:12.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gede!
Dialogue: 0,0:14:12.50,0:14:15.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Ada perlu apa?
Dialogue: 0,0:14:15.71,0:14:19.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melihat kejadian semalam.
Dialogue: 0,0:14:19.71,0:14:24.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menyemburkan api dari mulut\Ndi beranda apartemen.
Dialogue: 0,0:14:29.18,0:14:30.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Cewek Kaiju!
Dialogue: 0,0:14:31.77,0:14:33.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lepaskan aku!
Dialogue: 0,0:14:33.35,0:14:34.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seseorang!
Dialogue: 0,0:14:34.98,0:14:36.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengarkan aku dulu.
Dialogue: 0,0:14:36.48,0:14:37.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:14:37.65,0:14:40.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menurut, aku akan tutup mulut.
Dialogue: 0,0:14:40.07,0:14:40.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:14:41.28,0:14:42.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak.
Dialogue: 0,0:14:44.20,0:14:46.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maukah kamu main denganku?
Dialogue: 0,0:14:46.12,0:14:47.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:14:47.37,0:14:51.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku enggak mengenalmu!
Dialogue: 0,0:14:51.09,0:14:52.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, akan kubocorkan.
Dialogue: 0,0:14:59.00,0:15:01.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kebablasan!
Dialogue: 0,0:15:01.09,0:15:02.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh...
Dialogue: 0,0:15:02.97,0:15:04.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekor?
Dialogue: 0,0:15:04.80,0:15:06.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keren!
Dialogue: 0,0:15:07.01,0:15:09.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kaiju sungguhan!
Dialogue: 0,0:15:28.12,0:15:30.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Capek banget!
Dialogue: 0,0:15:31.29,0:15:35.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal dulu ini sepele.
Dialogue: 0,0:15:35.21,0:15:37.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Umur enggak bisa bohong.
Dialogue: 0,0:15:37.37,0:15:39.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:15:39.25,0:15:42.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa itu sudah lama berlalu.
Dialogue: 0,0:15:42.46,0:15:44.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kotaro?
Dialogue: 0,0:15:44.51,0:15:46.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok kamu di sini?
Dialogue: 0,0:15:46.01,0:15:49.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melihat kaiju muncul di pulau itu.
Dialogue: 0,0:15:50.10,0:15:52.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin kamu akan datang ke sini.
Dialogue: 0,0:15:53.43,0:15:57.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena 17 tahun lalu kita datang ke sini
Dialogue: 0,0:15:57.90,0:16:01.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kamu membawa itu pergi, kan, Senior?
Dialogue: 0,0:16:03.32,0:16:05.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Telur itu...
Dialogue: 0,0:16:06.70,0:16:08.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Identitas kaiju itu...
Dialogue: 0,0:16:08.53,0:16:10.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:16:11.62,0:16:15.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak itu lahir di pulau ini.
Dialogue: 0,0:16:18.33,0:16:20.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak mau pulang!
Dialogue: 0,0:16:20.71,0:16:25.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana bisa pulang begitu saja\Nsetelah ada penemuan besar begini!
Dialogue: 0,0:16:25.76,0:16:27.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyerah saja, Rinko.
Dialogue: 0,0:16:27.38,0:16:28.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ogah!
Dialogue: 0,0:16:28.43,0:16:31.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku, Kak Akaishi.
Dialogue: 0,0:16:31.26,0:16:35.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Profesor sudah mengingatkan\Njangan ke sini, kan?
Dialogue: 0,0:16:35.89,0:16:37.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu saja yang pulang!
Dialogue: 0,0:16:37.68,0:16:40.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama para profesor pengecut itu!
Dialogue: 0,0:16:40.56,0:16:43.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah tujuan kita berekspedisi!
Dialogue: 0,0:16:43.40,0:16:48.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk menyelidiki makhluk langka\Ndi pulau ini dan melindunginya...
Dialogue: 0,0:16:48.49,0:16:50.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sama.
Dialogue: 0,0:16:51.24,0:16:53.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak mengincar pamor.
Dialogue: 0,0:16:55.87,0:17:00.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kawanan makhluk ini\Nmungkin saja masih hidup.
Dialogue: 0,0:17:00.12,0:17:04.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus mencari, menyelidiki,\Ndan melindunginya.
Dialogue: 0,0:17:04.29,0:17:07.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham kenapa banyak\Nprofesor yang kabur.
Dialogue: 0,0:17:08.26,0:17:10.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ini tulang makhluk hidup asli,
Dialogue: 0,0:17:10.76,0:17:12.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ilmu pengetahuan akan berubah total!
Dialogue: 0,0:17:12.89,0:17:16.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, kita harus menyelidikinya!
Dialogue: 0,0:17:21.31,0:17:22.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior!
Dialogue: 0,0:17:41.08,0:17:44.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior, aku akan turun!
Dialogue: 0,0:17:45.59,0:17:48.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ke mana-mana!
Dialogue: 0,0:17:51.59,0:17:53.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?
Dialogue: 0,0:17:53.89,0:17:55.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior?
Dialogue: 0,0:17:55.93,0:17:57.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:18:00.23,0:18:03.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini rahasia, Kotaro.
Dialogue: 0,0:18:05.98,0:18:07.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rahasia antara kita berdua.
Dialogue: 0,0:18:11.78,0:18:16.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi teringat momen mengharukan\N17 tahun lalu itu, ya!
Dialogue: 0,0:18:17.91,0:18:19.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sini, Kotaro!
Dialogue: 0,0:18:19.95,0:18:22.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tempat aku menemukan telur itu.
Dialogue: 0,0:18:26.21,0:18:27.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:18:28.38,0:18:30.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu benar Kuroe?
Dialogue: 0,0:18:31.17,0:18:35.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaiju itu...\NSalah satu dari telur-telur itu...
Dialogue: 0,0:18:35.05,0:18:38.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bermutasi menjadi manusia?
Dialogue: 0,0:18:38.76,0:18:42.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa bermutasi bukan kata yang tepat.
Dialogue: 0,0:18:42.68,0:18:46.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurotan berevolusi dari satu generasi.
Dialogue: 0,0:18:46.61,0:18:48.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berevolusi?
Dialogue: 0,0:18:48.15,0:18:49.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:18:49.23,0:18:53.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berevolusi agar bisa\Nhidup bersamaku sebagai manusia.
Dialogue: 0,0:18:55.53,0:18:59.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mama sangat senang\Nmelihatnya tumbuh sehat!
Dialogue: 0,0:18:59.37,0:19:01.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Se-Senang?
Dialogue: 0,0:19:01.50,0:19:03.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara kamu, seluruh Jepang...
Dialogue: 0,0:19:03.25,0:19:07.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, bahkan seluruh dunia\Nsampai darurat perang.
Dialogue: 0,0:19:08.21,0:19:11.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Kuroe kehilangan kendali diri...
Dialogue: 0,0:19:11.30,0:19:13.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar sajalah.
Dialogue: 0,0:19:14.01,0:19:21.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin saja Bumi yang bisa ditinggali\NKurotan dan anak ini jauh lebih indah.
Dialogue: 0,0:19:21.01,0:19:22.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak ini?
Dialogue: 0,0:19:28.31,0:19:30.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini salah satu dari telur itu.
Dialogue: 0,0:19:30.57,0:19:34.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang satu Kurotan.\NDua telur lainnya jadi nonaktif.
Dialogue: 0,0:19:34.69,0:19:40.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak ini membesar dalam wujud telur\Nsetelah Kurotan lahir.
Dialogue: 0,0:19:40.49,0:19:44.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menaruh kamera di sini\Ndan mengawasinya bertahun-tahun.
Dialogue: 0,0:19:44.41,0:19:46.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski lebih lama dari Kurotan,
Dialogue: 0,0:19:46.62,0:19:49.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti akan terlahir anak yang hebat!
Dialogue: 0,0:19:51.46,0:19:53.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini adik perempuannya?
Dialogue: 0,0:19:53.71,0:19:55.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti namanya Akae?
Dialogue: 0,0:19:55.92,0:19:58.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, aku yang membesarkannya!
Dialogue: 0,0:19:58.39,0:20:00.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan seenaknya menamai!
Dialogue: 0,0:20:01.39,0:20:03.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menangis!
Dialogue: 0,0:20:03.18,0:20:05.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya sudah mau lahir!
Dialogue: 0,0:20:05.10,0:20:07.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada pilihan lain.
Dialogue: 0,0:20:08.02,0:20:09.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin cepat bertemu denganmu!
Dialogue: 0,0:20:09.94,0:20:11.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, ini Hibino.
Dialogue: 0,0:20:11.98,0:20:13.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hubungkan aku ke kepala departemen.
Dialogue: 0,0:20:15.11,0:20:18.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan soal Harugon.\NMungkin ini lebih gawat!
Dialogue: 0,0:20:27.96,0:20:31.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Markas Besar Kabinet\NPenanggulangan Bencana.
Dialogue: 0,0:20:31.25,0:20:34.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tahu, Profesor Hibino.
Dialogue: 0,0:20:35.01,0:20:37.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jauh sebelum kamu datang ke rumahku.
Dialogue: 0,0:20:37.97,0:20:42.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu dan pemerintah\Nterus menyelidiki Kurotan, kan?
Dialogue: 0,0:20:42.01,0:20:44.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selaku ahli biologi.
Dialogue: 0,0:20:45.93,0:20:50.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat! Aku bangga\Nselaku mantan rekan kerjamu!
Dialogue: 0,0:20:51.94,0:20:56.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kulakukan apa pun\Ndemi melindungi anak itu.
Dialogue: 0,0:20:59.95,0:21:01.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, lihat!\NTelurnya retak!
Dialogue: 0,0:21:01.70,0:21:02.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:21:04.95,0:21:06.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menipuku!
Dialogue: 0,0:21:06.50,0:21:11.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak dulu, aku benci sifatmu itu!
Dialogue: 0,0:21:18.97,0:21:20.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, gara-gara kamu...
Dialogue: 0,0:21:31.27,0:21:32.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:21:36.19,0:21:37.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat menjauh!
Dialogue: 0,0:21:50.66,0:21:52.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kamu baik-baik saja?
Dialogue: 0,0:21:53.46,0:21:54.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:21:54.33,0:21:55.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Rin?
Dialogue: 0,0:22:22.45,0:22:25.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, kamu mau pergi, kan?
Dialogue: 0,0:22:32.25,0:22:34.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menuju tempatnya!
Dialogue: 0,0:24:09.01,0:24:10.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manisan berikutnya,
Dialogue: 0,0:24:10.51,0:24:12.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Roti Melon dan Parfait Persik.
Dialogue: 0,0:24:12.10,0:24:14.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rakus sekali!
