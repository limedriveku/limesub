Dialogue: 0,0:00:00.00,0:00:01.27,sign,,0000,0000,0000,,SOSOK PANGERAN KAIJU\NYANG DISOROT SELURUH JEPANG
Dialogue: 0,0:01:10.09,0:01:15.60,sign,,0000,0000,0000,,KAIJU DARA CARAMELISE
Dialogue: 0,0:02:31.01,0:02:34.51,sign,,0000,0000,0000,,EPISODE 7: ARATA YANG DIINCAR
Dialogue: 0,0:03:52.30,0:03:54.09,sign,,0000,0000,0000,,IDENTITAS ASLI HARUGON ADALAH SEORANG GADIS?
Dialogue: 0,0:03:54.09,0:03:57.05,sign,,0000,0000,0000,,GADIS TERSANGKA, 16 TAHUN
Dialogue: 0,0:07:04.03,0:07:05.86,sign,,0000,0000,0000,,AKAISHI, KAMU SEDANG LUANG?
Dialogue: 0,0:07:05.86,0:07:07.66,sign,,0000,0000,0000,,BAGAIMANA KALAU KITA PANGGILAN VIDEO?
Dialogue: 0,0:07:07.66,0:07:08.49,sign,,0000,0000,0000,,KUPIKIR DENGAN BEGINI ENGGAK AKAN ADA
Dialogue: 0,0:07:08.49,0:07:09.37,sign,,0000,0000,0000,,YANG MENGGANGGU KITA
Dialogue: 0,0:14:48.20,0:14:51.12,sign,,0000,0000,0000,,PISANG COKELAT, NANAS DINGIN
Dialogue: 0,0:17:47.50,0:17:49.46,sign,,0000,0000,0000,,SILAKAN ISI DAYA
Dialogue: 0,0:21:35.77,0:21:36.65,sign,,0000,0000,0000,,PAKET VARIASI WARNA-WARNI KEMBANG API
Dialogue: 0,0:00:01.27,0:00:03.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, Pangeran Kaiju diputar lagi.
Dialogue: 0,0:00:03.90,0:00:05.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajahnya seperti apa, ya?
Dialogue: 0,0:00:05.65,0:00:07.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya video tanpa sensornya, lo!
Dialogue: 0,0:00:07.61,0:00:08.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ganteng banget!
Dialogue: 0,0:00:08.66,0:00:09.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana coba?
Dialogue: 0,0:00:09.74,0:00:12.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba cari "Minami Arata".
Dialogue: 0,0:00:13.83,0:00:16.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Minami!\N- Boleh ambil fotomu?
Dialogue: 0,0:00:16.50,0:00:19.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantap, Arata!\NKamu jadi topik panas!
Dialogue: 0,0:00:19.75,0:00:23.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke sekolah pakai masker pula,\Nkayak artis saja.
Dialogue: 0,0:00:23.29,0:00:26.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, biar enggak heboh saja.
Dialogue: 0,0:00:30.30,0:00:32.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nomor tidak dikenal.
Dialogue: 0,0:00:33.39,0:00:34.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, halo?
Dialogue: 0,0:00:34.64,0:00:37.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dengan Minami Arata?
Dialogue: 0,0:00:37.10,0:00:41.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dari program televisi Jepang, Zakkuri.
Dialogue: 0,0:00:41.02,0:00:42.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Televisi?
Dialogue: 0,0:00:42.19,0:00:42.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:00:42.98,0:00:44.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, kamu salah orang!
Dialogue: 0,0:00:44.86,0:00:46.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat kamu, Arata!
Dialogue: 0,0:00:46.48,0:00:47.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Televisi, lo!
Dialogue: 0,0:00:47.78,0:00:48.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gila!
Dialogue: 0,0:00:49.40,0:00:53.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, pacarmu dikerumuni, Kurotaso.
Dialogue: 0,0:00:55.12,0:00:57.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara aku,
Dialogue: 0,0:00:57.04,0:01:00.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami jadi kena masalah!
Dialogue: 0,0:02:38.01,0:02:39.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Minami.
Dialogue: 0,0:02:39.85,0:02:40.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:02:40.89,0:02:43.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?\NIni bukan salahmu.
Dialogue: 0,0:02:44.39,0:02:46.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini salahku.
Dialogue: 0,0:02:48.40,0:02:52.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katakan saja kalau ada\Nyang bisa kubantu.
Dialogue: 0,0:02:52.61,0:02:57.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau diekspos seperti ini,\Nkamu pasti dikomentari banyak orang.
Dialogue: 0,0:02:57.78,0:03:00.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa saja kamu tersakiti.
Dialogue: 0,0:03:01.24,0:03:04.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bilang saja kalau kamu kesusahan.
Dialogue: 0,0:03:04.54,0:03:05.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jamin...
Dialogue: 0,0:03:06.58,0:03:10.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diriku bisa jauh lebih kuat\Ndaripada bayanganmu!
Dialogue: 0,0:03:11.09,0:03:13.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayak kaiju itu!
Dialogue: 0,0:03:14.67,0:03:16.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ga-Garing, ya?
Dialogue: 0,0:03:20.64,0:03:24.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, hatiku jadi tenang.
Dialogue: 0,0:03:24.02,0:03:28.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar mencintaimu!
Dialogue: 0,0:03:31.07,0:03:34.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekorku mau keluar!
Dialogue: 0,0:03:49.29,0:03:50.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:03:50.04,0:03:52.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hampir saja!
Dialogue: 0,0:03:52.30,0:03:54.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ekorku sampai keluar,
Dialogue: 0,0:03:54.09,0:03:57.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan lebih ramai dari topik Pangeran Kaiju!
Dialogue: 0,0:03:58.05,0:03:59.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Akaishi.
Dialogue: 0,0:03:59.76,0:04:01.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak apa-apa.
Dialogue: 0,0:04:01.55,0:04:05.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kita jaga jarak\Nsampai situasinya reda.
Dialogue: 0,0:04:05.81,0:04:06.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:04:06.60,0:04:11.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bersamaku, kamu bisa difoto\Ndan digosipkan macam-macam.
Dialogue: 0,0:04:12.44,0:04:16.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak keberatan, tapi takutnya\Nkamu malah kena imbasnya.
Dialogue: 0,0:04:17.70,0:04:20.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua pasti bosan kalau sudah seminggu.
Dialogue: 0,0:04:21.66,0:04:25.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga enggak mau merepotkan Minami.
Dialogue: 0,0:04:26.08,0:04:29.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar, baiklah.
Dialogue: 0,0:04:31.58,0:04:34.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mencari tempat\Nagar kita tidak diganggu.
Dialogue: 0,0:04:39.01,0:04:41.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belnya bunyi, tuh!
Dialogue: 0,0:04:54.73,0:04:56.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pulang.
Dialogue: 0,0:04:56.57,0:04:58.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Kurotan!
Dialogue: 0,0:04:58.40,0:05:01.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini terus diberitakan sejak pagi, lo!
Dialogue: 0,0:05:01.74,0:05:02.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paham, kan?
Dialogue: 0,0:05:02.99,0:05:06.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu akan jadi kaiju kalau emosi meluap.
Dialogue: 0,0:05:06.37,0:05:09.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus lebih hati-hati.
Dialogue: 0,0:05:09.33,0:05:12.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ciuman di depan umum segala.
Dialogue: 0,0:05:12.79,0:05:15.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu paham kamu sedang puber...
Dialogue: 0,0:05:15.46,0:05:17.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian,
Dialogue: 0,0:05:17.38,0:05:20.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kenapa aku terlahir dengan kondisi ini?
Dialogue: 0,0:05:23.89,0:05:25.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurotan...
Dialogue: 0,0:05:26.18,0:05:30.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurotan menyalahkanku, Jumbo King!
Dialogue: 0,0:05:30.48,0:05:32.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak menyalahkanmu.
Dialogue: 0,0:05:32.65,0:05:34.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mayu di sini!
Dialogue: 0,0:05:34.11,0:05:36.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, ada Mayu! Imutnya!
Dialogue: 0,0:05:48.54,0:05:50.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak, selamat datang.
Dialogue: 0,0:05:50.25,0:05:52.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulangnya aman, tidak?
Dialogue: 0,0:05:52.12,0:05:53.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, iya.
Dialogue: 0,0:05:53.58,0:05:55.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku didatangi orang TV, lo.
Dialogue: 0,0:05:55.96,0:05:56.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:05:56.92,0:06:00.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka langsung bertanya,\N"Apa kamu adiknya?"
Dialogue: 0,0:06:00.59,0:06:02.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku belum sisiran.
Dialogue: 0,0:06:02.84,0:06:04.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ditanyai apa?
Dialogue: 0,0:06:04.47,0:06:08.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng...\N"Kakakmu orang seperti apa?"
Dialogue: 0,0:06:08.14,0:06:11.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Apa hubungannya dengan Harugon?"
Dialogue: 0,0:06:11.48,0:06:12.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:06:12.56,0:06:17.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bilang kalau Kakak\Npunya pacar yang manis!
Dialogue: 0,0:06:17.15,0:06:18.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Moa!
Dialogue: 0,0:06:18.15,0:06:22.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau begini,\NKakak enggak bisa kencan.
Dialogue: 0,0:06:24.24,0:06:26.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, Moa?
Dialogue: 0,0:06:26.12,0:06:27.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu lagi di mana?
Dialogue: 0,0:06:27.95,0:06:29.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di pintu masuk.
Dialogue: 0,0:06:29.33,0:06:31.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakakku baru pulang.
Dialogue: 0,0:06:31.16,0:06:33.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin lihat kakakmu!
Dialogue: 0,0:06:33.25,0:06:34.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak boleh.
Dialogue: 0,0:06:34.29,0:06:35.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah...
Dialogue: 0,0:06:35.29,0:06:38.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak, aku ke kamar dulu, ya.
Dialogue: 0,0:06:38.46,0:06:39.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya.
Dialogue: 0,0:06:39.67,0:06:41.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Punggungnya kelihatan sedikit!
Dialogue: 0,0:06:41.34,0:06:42.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tutup, ah.
Dialogue: 0,0:06:42.34,0:06:44.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Moa pelit.\N- Kalau itu...
Dialogue: 0,0:06:51.14,0:06:54.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodo amat soal pesona gadis.
Dialogue: 0,0:06:54.14,0:06:57.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian, aku enggak bisa ketemu Minami.
Dialogue: 0,0:07:02.57,0:07:04.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami!
Dialogue: 0,0:07:04.03,0:07:07.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm? Panggilan video?
Dialogue: 0,0:07:08.49,0:07:09.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:07:09.37,0:07:11.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana cara pakainya?
Dialogue: 0,0:07:11.41,0:07:13.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus apa?
Dialogue: 0,0:07:13.33,0:07:14.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, gratis?
Dialogue: 0,0:07:21.05,0:07:23.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pinjam dulu tabletnya.
Dialogue: 0,0:07:23.13,0:07:25.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang dipakai.
Dialogue: 0,0:07:25.84,0:07:27.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar saja!
Dialogue: 0,0:07:29.01,0:07:32.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal Mama lagi nonton video Mayu.
Dialogue: 0,0:07:36.27,0:07:39.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tombol yang ini?
Dialogue: 0,0:07:39.81,0:07:42.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa melihatku, Akaishi?
Dialogue: 0,0:07:44.86,0:07:45.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:07:45.74,0:07:48.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf, aku masih siap-siap!
Dialogue: 0,0:07:48.03,0:07:50.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu kuutak-atik malah tersambung!
Dialogue: 0,0:07:51.24,0:07:52.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teleponnya nanti saja?
Dialogue: 0,0:07:52.66,0:07:54.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Enggak perlu!
Dialogue: 0,0:07:56.62,0:07:58.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf menunggu lama.
Dialogue: 0,0:07:58.92,0:07:59.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:07:59.79,0:08:02.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jarang pakai panggilan video,
Dialogue: 0,0:08:02.67,0:08:03.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi bagus juga.
Dialogue: 0,0:08:04.26,0:08:06.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami ada di depan mataku!
Dialogue: 0,0:08:07.59,0:08:10.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami bisa ketemu kapan saja, dong!
Dialogue: 0,0:08:10.01,0:08:15.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, berarti cuma aku yang ada\Ndi pandangan Minami, kan?
Dialogue: 0,0:08:17.06,0:08:19.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahu begini, aku beli baju bagus dulu!
Dialogue: 0,0:08:19.85,0:08:21.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu di mana?
Dialogue: 0,0:08:21.86,0:08:23.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunjukkan wajahmu sedikit lagi.
Dialogue: 0,0:08:23.82,0:08:26.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kurang persiapan,\Njadi agak acak-acakan.
Dialogue: 0,0:08:27.36,0:08:30.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu di mode santai juga manis, kok.
Dialogue: 0,0:08:30.03,0:08:32.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inikah rasanya kalau kita\Ntinggal bersama?
Dialogue: 0,0:08:32.99,0:08:33.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bercanda.
Dialogue: 0,0:08:33.99,0:08:36.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggal bersama...
Dialogue: 0,0:08:43.09,0:08:44.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tandukku!
Dialogue: 0,0:08:44.80,0:08:46.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajahku kelihatan jelas, kan?
Dialogue: 0,0:08:46.38,0:08:48.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya, sih.
Dialogue: 0,0:08:48.17,0:08:49.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa menjauh sedikit?
Dialogue: 0,0:08:49.59,0:08:52.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, kameranya mendekat sendiri.
Dialogue: 0,0:08:52.39,0:08:54.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, kok bisa?
Dialogue: 0,0:08:54.39,0:08:57.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, bicaranya lain kali, ya.
Dialogue: 0,0:08:57.39,0:08:58.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santai.
Dialogue: 0,0:08:58.35,0:08:58.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:08:59.81,0:09:01.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ingin lebih dekat denganmu.
Dialogue: 0,0:09:03.40,0:09:05.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, gawat.
Dialogue: 0,0:09:05.52,0:09:07.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan begitu!
Dialogue: 0,0:09:07.23,0:09:09.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu sebentar!
Dialogue: 0,0:09:10.11,0:09:13.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini, aku perlu sandaran.
Dialogue: 0,0:09:13.53,0:09:15.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Eng, Akaishi?\N- Sip.
Dialogue: 0,0:09:15.20,0:09:17.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudut ini seharusnya aman.
Dialogue: 0,0:09:18.79,0:09:20.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sempurna.
Dialogue: 0,0:09:23.71,0:09:25.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang enggak sanggup.
Dialogue: 0,0:09:27.21,0:09:29.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ribet juga, ya.
Dialogue: 0,0:09:30.05,0:09:32.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurotan, mana tabletnya?
Dialogue: 0,0:09:32.22,0:09:34.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku bawa ke situ.
Dialogue: 0,0:09:36.43,0:09:37.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:09:37.68,0:09:39.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santai, bisa mengobrol saja sudah syukur.
Dialogue: 0,0:09:42.06,0:09:43.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku payah banget.
Dialogue: 0,0:09:43.56,0:09:44.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:09:44.81,0:09:49.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski bilang untuk jaga jarak,\Nmalah aku yang kangen.
Dialogue: 0,0:09:49.36,0:09:52.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin mengobrol\Ndan makan siang bareng.
Dialogue: 0,0:09:53.45,0:09:57.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terus kepikiran kamu\Nsejak pulang ke rumah.
Dialogue: 0,0:09:57.03,0:09:59.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:09:59.16,0:10:00.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:10:00.66,0:10:03.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada tempat tersembunyi, tidak, ya?
Dialogue: 0,0:10:03.33,0:10:07.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau buat kamu kayaknya susah.
Dialogue: 0,0:10:07.55,0:10:09.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa?
Dialogue: 0,0:10:10.05,0:10:10.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh!
Dialogue: 0,0:10:11.38,0:10:14.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggal ke tempat yang tidak\Nseorang pun mengenaliku saja!
Dialogue: 0,0:10:14.43,0:10:17.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat yang tidak seorang pun mengenalimu?
Dialogue: 0,0:10:17.60,0:10:20.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku dapat ide bagus!
Dialogue: 0,0:10:20.35,0:10:22.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?\NKita bisa ketemuan?
Dialogue: 0,0:10:22.56,0:10:24.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mestinya bisa.
Dialogue: 0,0:10:24.27,0:10:25.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana?
Dialogue: 0,0:10:25.75,0:10:27.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana, ya?
Dialogue: 0,0:10:36.53,0:10:38.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami, ya?
Dialogue: 0,0:10:39.20,0:10:42.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira kamu bakal murung\Nkarena enggak bisa ketemu Minami,
Dialogue: 0,0:10:42.25,0:10:44.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}syukurlah kalau ceria.
Dialogue: 0,0:10:44.54,0:10:46.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada hal baik yang terjadi?
Dialogue: 0,0:10:47.75,0:10:49.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya...
Dialogue: 0,0:10:52.05,0:10:55.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Festival kembang api?\NBareng Minami?
Dialogue: 0,0:10:55.01,0:10:57.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelan-pelan, Rairi!
Dialogue: 0,0:10:57.93,0:10:59.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, kebablasan.
Dialogue: 0,0:10:59.81,0:11:03.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya itu tempat ramai?
Dialogue: 0,0:11:03.02,0:11:05.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, Minami bilang,
Dialogue: 0,0:11:05.27,0:11:09.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Justru tidak akan menonjol\Nkalau ada banyak orang."
Dialogue: 0,0:11:09.02,0:11:10.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua fokus ke kembang api.
Dialogue: 0,0:11:10.73,0:11:12.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:11:12.19,0:11:14.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayak riasan pengalih perhatian?
Dialogue: 0,0:11:14.28,0:11:15.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pe-Pengalih?
Dialogue: 0,0:11:15.74,0:11:17.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknik menonjolkan bagian lain
Dialogue: 0,0:11:17.95,0:11:20.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tanpa menyembunyikan\Nkantung mata dan pori-pori.
Dialogue: 0,0:11:20.41,0:11:21.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:11:22.08,0:11:23.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manatsu?
Dialogue: 0,0:11:23.95,0:11:25.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak apa-apa.
Dialogue: 0,0:11:25.71,0:11:27.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersenang-senanglah.
Dialogue: 0,0:11:27.79,0:11:29.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya.
Dialogue: 0,0:11:30.09,0:11:31.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau pakai yukata?
Dialogue: 0,0:11:31.84,0:11:32.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yu...
Dialogue: 0,0:11:32.50,0:11:35.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke festival kembang api\Ncocoknya pakai yukata!
Dialogue: 0,0:11:35.30,0:11:36.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami pasti senang!
Dialogue: 0,0:11:36.97,0:11:37.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo belanja bareng!
Dialogue: 0,0:11:37.93,0:11:39.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya!
Dialogue: 0,0:11:39.05,0:11:41.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengajarimu riasan yukata!
Dialogue: 0,0:11:42.85,0:11:47.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menghafal lokasi toilet\Ndan cara membenarkan yukata yang longgar.
Dialogue: 0,0:11:47.39,0:11:51.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisanya tinggal pakai ini\Nlalu pergi diam-diam.
Dialogue: 0,0:11:55.90,0:11:57.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok enggak bagus?
Dialogue: 0,0:11:57.99,0:12:01.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah latihan berhari-hari\Nsambil nonton video, lo.
Dialogue: 0,0:12:03.20,0:12:05.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus dipasang dari awal lagi.
Dialogue: 0,0:12:15.21,0:12:18.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakai baju biasa saja, deh.
Dialogue: 0,0:12:18.43,0:12:23.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal Rairi dan Manatsu\Nsudah membantuku memilihnya.
Dialogue: 0,0:12:24.01,0:12:26.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurotan, mau makan malam apa?
Dialogue: 0,0:12:27.98,0:12:29.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baju apa itu?
Dialogue: 0,0:12:29.73,0:12:30.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat...
Dialogue: 0,0:12:30.77,0:12:33.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat ke festival kembang api?
Dialogue: 0,0:12:34.36,0:12:35.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:12:46.50,0:12:47.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurotan.
Dialogue: 0,0:12:51.58,0:12:53.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, berdiri yang tegak.
Dialogue: 0,0:12:53.50,0:12:54.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:12:54.04,0:12:56.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu lepas dulu, ya.
Dialogue: 0,0:12:56.05,0:12:56.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:12:56.80,0:12:57.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hadap ke depan.
Dialogue: 0,0:12:57.92,0:12:59.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oke.
Dialogue: 0,0:13:03.10,0:13:04.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, pas.
Dialogue: 0,0:13:08.02,0:13:08.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip.
Dialogue: 0,0:13:10.35,0:13:11.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:13:15.86,0:13:17.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengejutkan.
Dialogue: 0,0:13:17.11,0:13:19.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini mah Mama jago.
Dialogue: 0,0:13:19.45,0:13:21.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira Ibu akan melarang.
Dialogue: 0,0:13:23.62,0:13:25.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah...
Dialogue: 0,0:13:25.08,0:13:29.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mama sedih karena kamu\Nmau pergi diam-diam.
Dialogue: 0,0:13:32.54,0:13:34.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pergi dulu.
Dialogue: 0,0:13:34.71,0:13:36.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, hati-hati di jalan.
Dialogue: 0,0:13:36.75,0:13:38.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:13:39.63,0:13:41.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih!
Dialogue: 0,0:13:46.85,0:13:49.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kulakukan, sih?
Dialogue: 0,0:13:56.44,0:13:59.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya Minami sudah sampai.
Dialogue: 0,0:13:59.90,0:14:00.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi.
Dialogue: 0,0:14:00.78,0:14:02.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami!
Dialogue: 0,0:14:04.28,0:14:05.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf menunggu lama.
Dialogue: 0,0:14:07.74,0:14:11.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pakai topeng biar susah dikenali.
Dialogue: 0,0:14:11.33,0:14:13.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Begitu, ya.
Dialogue: 0,0:14:13.00,0:14:16.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi, kamu cocok banget pakai yukata!
Dialogue: 0,0:14:16.50,0:14:17.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imut!
Dialogue: 0,0:14:17.38,0:14:21.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, kok.\NJustru kamu yang keren.
Dialogue: 0,0:14:21.17,0:14:22.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:14:22.63,0:14:23.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:14:23.97,0:14:26.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, kerennya kelewatan.
Dialogue: 0,0:14:27.22,0:14:29.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa gawat—
Dialogue: 0,0:14:30.31,0:14:31.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi?
Dialogue: 0,0:14:31.64,0:14:33.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baik-baik saja!
Dialogue: 0,0:14:33.19,0:14:35.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obiku sedikit longgar.
Dialogue: 0,0:14:35.23,0:14:37.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekor kelihatan kalau pakai yukata!
Dialogue: 0,0:14:37.56,0:14:39.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenanglah, diriku!
Dialogue: 0,0:14:39.44,0:14:40.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?
Dialogue: 0,0:14:40.57,0:14:41.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya!
Dialogue: 0,0:14:42.74,0:14:45.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mumpung masih lama,\Nayo berkeliling.
Dialogue: 0,0:15:11.22,0:15:12.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak!
Dialogue: 0,0:15:13.39,0:15:15.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mama, lihat!
Dialogue: 0,0:15:37.00,0:15:38.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makin ramai saja.
Dialogue: 0,0:15:38.75,0:15:42.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya, kembang apinya mau dimulai, sih.
Dialogue: 0,0:15:42.96,0:15:44.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi enggak sabar.
Dialogue: 0,0:15:44.26,0:15:46.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku menemukan tempat bagus.
Dialogue: 0,0:15:47.43,0:15:48.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat bagus?
Dialogue: 0,0:15:49.34,0:15:51.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat yang jarang orang datangi.
Dialogue: 0,0:15:51.72,0:15:53.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bisa leluasa di sana.
Dialogue: 0,0:15:59.23,0:16:01.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu mengerikan.
Dialogue: 0,0:16:01.73,0:16:02.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:16:02.36,0:16:06.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seram. Seram.\NApa tidak jadi masalah?
Dialogue: 0,0:16:06.57,0:16:09.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempatnya tidak aneh, kok, aman.
Dialogue: 0,0:16:11.41,0:16:13.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sekitar sini.
Dialogue: 0,0:16:13.24,0:16:17.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musim panas gila banget!
Dialogue: 0,0:16:17.37,0:16:18.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantap!
Dialogue: 0,0:16:18.71,0:16:19.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yey!
Dialogue: 0,0:16:19.63,0:16:21.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benaran di sini?
Dialogue: 0,0:16:21.34,0:16:22.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh.
Dialogue: 0,0:16:22.63,0:16:25.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak aneh, tapi agak berisik, ya.
Dialogue: 0,0:16:25.67,0:16:28.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, kalian cakep juga!
Dialogue: 0,0:16:28.43,0:16:29.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak SMA?
Dialogue: 0,0:16:30.26,0:16:33.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gila, itu Pangeran Kaiju!
Dialogue: 0,0:16:33.14,0:16:34.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pangeran Kaiju? Serius?
Dialogue: 0,0:16:34.89,0:16:35.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apaan, tuh?\N- Maaf.
Dialogue: 0,0:16:35.72,0:16:36.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kamu enggak tahu?\N- Ayo pergi.
Dialogue: 0,0:16:36.73,0:16:37.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dia terkenal banget!\N- Iya.
Dialogue: 0,0:16:37.94,0:16:39.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak tahu!
Dialogue: 0,0:16:43.98,0:16:45.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat minta maaf.
Dialogue: 0,0:16:45.53,0:16:47.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak apa-apa, kok!
Dialogue: 0,0:16:47.19,0:16:50.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malahan aku selam—\NSayang sekali, ya.
Dialogue: 0,0:16:51.07,0:16:53.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus mencari tempat lain.
Dialogue: 0,0:16:54.87,0:16:57.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak banget orangnya.
Dialogue: 0,0:16:57.54,0:16:59.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembang apinya mau dimulai.
Dialogue: 0,0:16:59.71,0:17:00.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:17:02.42,0:17:05.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dari sini pasti kurang kelihatan.
Dialogue: 0,0:17:10.18,0:17:13.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Tempat seperti apa pun...
Dialogue: 0,0:17:14.97,0:17:17.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau kembang apinya tidak terlihat...
Dialogue: 0,0:17:17.31,0:17:20.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang asal bisa bersamamu!
Dialogue: 0,0:17:20.56,0:17:21.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sedih!
Dialogue: 0,0:17:23.85,0:17:25.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi...
Dialogue: 0,0:17:28.78,0:17:29.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah dimu—
Dialogue: 0,0:17:31.91,0:17:33.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami!
Dialogue: 0,0:17:33.32,0:17:34.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi!
Dialogue: 0,0:17:34.83,0:17:36.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lepaskan tanganku!
Dialogue: 0,0:17:38.66,0:17:40.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami!
Dialogue: 0,0:17:40.37,0:17:42.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi!
Dialogue: 0,0:17:49.88,0:17:52.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baterai ponselku habis.
Dialogue: 0,0:17:53.93,0:17:55.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami di mana?
Dialogue: 0,0:17:55.80,0:17:57.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak ketemu.
Dialogue: 0,0:17:59.35,0:18:00.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami.
Dialogue: 0,0:18:01.52,0:18:03.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami!
Dialogue: 0,0:18:04.94,0:18:10.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembang apinya keburu kelar!
Dialogue: 0,0:18:20.79,0:18:23.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bos, kita harus mengungsi!
Dialogue: 0,0:18:23.58,0:18:24.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar bodoh!
Dialogue: 0,0:18:24.25,0:18:26.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah melakukan ini\Nselama 50 tahun!
Dialogue: 0,0:18:26.84,0:18:29.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana sudi batal cuma gara-gara kaiju!
Dialogue: 0,0:18:29.71,0:18:31.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bos!
Dialogue: 0,0:18:31.26,0:18:33.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu lagi, terbanglah!
Dialogue: 0,0:18:33.80,0:18:36.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengikutimu selamanya!
Dialogue: 0,0:18:41.85,0:18:43.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Indahnya...
Dialogue: 0,0:18:44.52,0:18:47.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin melihatnya bersama Minami.
Dialogue: 0,0:18:49.98,0:18:53.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami!
Dialogue: 0,0:18:53.20,0:18:54.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harugon!
Dialogue: 0,0:18:57.45,0:18:58.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami!
Dialogue: 0,0:18:58.62,0:19:00.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenanglah!
Dialogue: 0,0:19:00.29,0:19:02.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada banyak orang\Nyang menantikan hari ini!
Dialogue: 0,0:19:08.63,0:19:10.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia benar.
Dialogue: 0,0:19:10.71,0:19:12.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga menantikannya.
Dialogue: 0,0:19:13.59,0:19:15.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari jauh-jauh hari.
Dialogue: 0,0:19:23.23,0:19:25.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha-Harugon?
Dialogue: 0,0:19:25.23,0:19:26.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:19:26.44,0:19:31.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para pengunjung yang menantikan hari ini,\Naku janji tidak akan mengamuk.
Dialogue: 0,0:19:31.36,0:19:35.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak akan berteriak\Ndan mengamuk.
Dialogue: 0,0:19:35.57,0:19:36.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya...
Dialogue: 0,0:19:42.58,0:19:43.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bolehkah aku
Dialogue: 0,0:19:44.25,0:19:48.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}melihat kembang api\Nbersama orang yang kucintai?
Dialogue: 0,0:19:49.25,0:19:51.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa.
Dialogue: 0,0:19:52.55,0:19:54.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis yang kucintai...
Dialogue: 0,0:19:54.71,0:19:57.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal dia sudah berdandan,
Dialogue: 0,0:19:57.47,0:19:59.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku malah mengecewakannya.
Dialogue: 0,0:19:59.76,0:20:01.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang dia sedang sendirian.
Dialogue: 0,0:20:03.31,0:20:07.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Akaishi juga melihat\Npemandangan ini?
Dialogue: 0,0:20:18.20,0:20:19.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya normal lagi.
Dialogue: 0,0:20:19.91,0:20:22.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus banget telanjang, nih?
Dialogue: 0,0:20:22.45,0:20:25.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini?\NPulang ke rumah dulu?
Dialogue: 0,0:20:25.08,0:20:27.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa sambil telanjang?
Dialogue: 0,0:20:27.00,0:20:30.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketemu!\NYukata dan tas kecilku!
Dialogue: 0,0:20:30.00,0:20:33.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah, untung yukataku utuh...
Dialogue: 0,0:20:40.47,0:20:41.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami!
Dialogue: 0,0:20:42.47,0:20:44.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf.
Dialogue: 0,0:20:44.51,0:20:45.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:20:45.56,0:20:47.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya kita bertemu!
Dialogue: 0,0:20:47.14,0:20:49.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami, nanti kamu basah.
Dialogue: 0,0:20:51.73,0:20:55.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi aku tersandung.
Dialogue: 0,0:20:55.07,0:20:57.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu terluka?
Dialogue: 0,0:20:57.03,0:20:59.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak, tapi...
Dialogue: 0,0:20:59.78,0:21:02.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penampilanku jadi begini.
Dialogue: 0,0:21:04.20,0:21:05.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi.
Dialogue: 0,0:21:07.04,0:21:08.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami?
Dialogue: 0,0:21:08.58,0:21:11.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulangnya nanti dulu, ya?
Dialogue: 0,0:21:19.01,0:21:20.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami...
Dialogue: 0,0:21:20.51,0:21:21.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf menunggu lama!
Dialogue: 0,0:21:25.68,0:21:28.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku cuma menemukan ini.
Dialogue: 0,0:21:28.77,0:21:30.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih!
Dialogue: 0,0:21:33.06,0:21:35.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga beli ini.
Dialogue: 0,0:21:36.65,0:21:37.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:21:38.32,0:21:39.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembang api?
Dialogue: 0,0:21:39.78,0:21:40.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:21:41.15,0:21:46.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya kamu bilang\Nakan senang asal bersamaku.
Dialogue: 0,0:21:53.54,0:21:57.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Munculnya Harugon bikin kaget,\Ntapi syukurlah kita melihat kembang api.
Dialogue: 0,0:21:57.30,0:21:58.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:22:03.09,0:22:04.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harugon.
Dialogue: 0,0:22:06.43,0:22:09.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan melakukannya.
Dialogue: 0,0:23:43.74,0:23:46.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Akaishi merasa senang?
Dialogue: 0,0:23:47.53,0:23:50.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sempat cemas waktu dia\Nbilang tersandung.
Dialogue: 0,0:23:52.87,0:23:56.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi Akaishi terlalu ceroboh.
Dialogue: 0,0:24:00.84,0:24:04.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menunggumu, Minami.
Dialogue: 0,0:24:04.88,0:24:07.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duduklah.
Dialogue: 0,0:24:08.68,0:24:10.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manisan berikutnya.
Dialogue: 0,0:24:11.60,0:24:14.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buah-buahan tropis!
