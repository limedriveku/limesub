Dialogue: 0,0:01:08.26,0:01:13.68,sign,,0000,0000,0000,,KAIJU DARA CARAMELISE
Dialogue: 0,0:02:29.05,0:02:32.55,sign,,0000,0000,0000,,EPISODE 5:\NCEWEK GAUL DAN LIPSTIK
Dialogue: 0,0:02:55.74,0:02:58.70,sign,,0000,0000,0000,,AKU TUNGGU DI TAMAN.\NDI TEMPAT PATUNG BERBENTUK BOLA!
Dialogue: 0,0:07:48.03,0:07:49.53,sign,,0000,0000,0000,,KELAS B, MINAMI ARATA
Dialogue: 0,0:07:49.53,0:07:50.99,sign,,0000,0000,0000,,KELAS C, AKAISHI KUROE
Dialogue: 0,0:11:34.59,0:11:36.55,sign,,0000,0000,0000,,LIPSTIK BARU MEREK YSM!\NWARNANYA BAGUS...
Dialogue: 0,0:00:02.40,0:00:04.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu membenci diri sendiri.
Dialogue: 0,0:00:05.82,0:00:10.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jelek, pemurung,\Ndan sama sekali enggak cantik.
Dialogue: 0,0:00:10.74,0:00:15.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku selalu mengira\Ncinta itu menakutkan.
Dialogue: 0,0:00:16.45,0:00:17.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi.
Dialogue: 0,0:00:22.25,0:00:23.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mencintaimu.
Dialogue: 0,0:00:23.75,0:00:27.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maukah kamu berpacaran denganku?
Dialogue: 0,0:00:38.94,0:00:43.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster raksasa telah muncul!
Dialogue: 0,0:00:43.02,0:00:46.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penduduk di dekat Sungai Sumida\Nharap segera mengungsi.
Dialogue: 0,0:00:46.40,0:00:48.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabar darurat, kabar darurat.
Dialogue: 0,0:00:48.86,0:00:51.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bertemu lagi hari ini.
Dialogue: 0,0:00:51.82,0:00:54.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurotan, masa kambuh lagi?
Dialogue: 0,0:02:33.26,0:02:36.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurotan, kamu itu kenapa?
Dialogue: 0,0:02:36.59,0:02:41.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok terus-terusan jadi kaiju\Nsetelah festival musik itu?
Dialogue: 0,0:02:43.68,0:02:46.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal sudah semester baru.\NYakin tidak apa-apa?
Dialogue: 0,0:02:50.65,0:02:53.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keringkan badanmu dulu!
Dialogue: 0,0:03:00.79,0:03:02.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berangkat!
Dialogue: 0,0:03:04.62,0:03:06.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar.
Dialogue: 0,0:03:07.96,0:03:10.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama kami tidak bertemu.
Dialogue: 0,0:03:10.67,0:03:14.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang kami bisa bertemu tiap hari lagi!
Dialogue: 0,0:03:20.05,0:03:21.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi!
Dialogue: 0,0:03:22.72,0:03:26.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia makin menyilaukan!
Dialogue: 0,0:03:29.56,0:03:32.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pagi, hari ini silau, ya.
Dialogue: 0,0:03:35.78,0:03:37.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin gara-gara\Nkeseringan main gim ponsel.
Dialogue: 0,0:03:37.95,0:03:39.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:03:39.53,0:03:40.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:03:45.41,0:03:47.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak mau pindah kelas.
Dialogue: 0,0:03:47.46,0:03:48.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama.
Dialogue: 0,0:03:48.58,0:03:53.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, walau kelas kita berbeda,\Nsituasinya enggak akan berubah.
Dialogue: 0,0:03:53.80,0:03:56.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya, kita sudah...
Dialogue: 0,0:03:58.26,0:03:59.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pacaran.
Dialogue: 0,0:04:08.77,0:04:10.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arata!
Dialogue: 0,0:04:10.94,0:04:12.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang apa di sini?
Dialogue: 0,0:04:12.52,0:04:15.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku janji ketemuan sama pacarku.
Dialogue: 0,0:04:16.02,0:04:16.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:04:16.77,0:04:20.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan langsung bikin heboh\Ndi awal semester baru, dong!
Dialogue: 0,0:04:20.16,0:04:21.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti kenalkan pacarmu, ya!
Dialogue: 0,0:04:21.74,0:04:23.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:04:23.99,0:04:26.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyaris saja.
Dialogue: 0,0:04:26.66,0:04:30.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barusan dia bilang, "kenalkan pacarmu"?
Dialogue: 0,0:04:30.96,0:04:32.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sampai lupa saking terlenanya.
Dialogue: 0,0:04:32.96,0:04:36.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau orang-orang tahu\Naku pacarnya Minami...
Dialogue: 0,0:04:36.09,0:04:39.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bercanda, kan?\NBenaran sama Neng Menhera?
Dialogue: 0,0:04:39.93,0:04:41.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi malas menyukai unggahannya, deh.
Dialogue: 0,0:04:41.84,0:04:44.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisa Minami\Njadi bahan ejekan karena aku!
Dialogue: 0,0:04:47.48,0:04:48.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, ketemu.
Dialogue: 0,0:04:52.52,0:04:54.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu cepat banget, Akaishi!
Dialogue: 0,0:04:54.57,0:04:57.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ki-Kita tidak boleh jalan bersebelahan!
Dialogue: 0,0:04:57.36,0:04:58.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, kenapa?
Dialogue: 0,0:04:58.65,0:05:01.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus pura-pura asing\Nkalau di sekolah.
Dialogue: 0,0:05:02.24,0:05:05.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu akan dianggap aneh\Nkalau ada di sampingku!
Dialogue: 0,0:05:05.70,0:05:09.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teman dan jumlah suka-mu\Nakan berkurang karena aku!
Dialogue: 0,0:05:13.21,0:05:15.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak butuh reaksi suka
Dialogue: 0,0:05:15.34,0:05:17.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maupun teman semacam itu.
Dialogue: 0,0:05:17.84,0:05:20.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana bisa pura-pura asing.
Dialogue: 0,0:05:20.13,0:05:22.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu itu pacarku.
Dialogue: 0,0:05:25.72,0:05:26.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat!
Dialogue: 0,0:05:26.97,0:05:28.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, tunggu!
Dialogue: 0,0:05:29.85,0:05:30.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi...
Dialogue: 0,0:05:30.94,0:05:31.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ma...\N- Maaf!
Dialogue: 0,0:05:31.89,0:05:35.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah pura-pura asing, deh.
Dialogue: 0,0:05:35.57,0:05:38.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya kita pura-pura berteman saja.
Dialogue: 0,0:05:41.20,0:05:42.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:05:44.24,0:05:46.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf kalau permintaanku egois.
Dialogue: 0,0:05:46.62,0:05:51.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah, aku ingin kamu jadi lebih egois.
Dialogue: 0,0:05:52.54,0:05:55.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, aku pergi duluan lewat sini, ya.
Dialogue: 0,0:06:02.63,0:06:06.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa orang sepertiku boleh lebih egois lagi?
Dialogue: 0,0:06:08.76,0:06:10.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin lebih percaya diri.
Dialogue: 0,0:06:11.48,0:06:12.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi!
Dialogue: 0,0:06:14.19,0:06:16.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak murid SMA Ginjuji, kan?
Dialogue: 0,0:06:16.90,0:06:18.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:06:18.23,0:06:21.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kamu\Nmemberikan ini ke abangku?
Dialogue: 0,0:06:21.74,0:06:22.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kelas satu...
Dialogue: 0,0:06:22.53,0:06:23.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, bukan.
Dialogue: 0,0:06:23.61,0:06:26.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abangku Minami Arata, kelas dua.
Dialogue: 0,0:06:27.28,0:06:28.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kenal!
Dialogue: 0,0:06:28.37,0:06:31.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?\NAbang memang beken!
Dialogue: 0,0:06:31.45,0:06:34.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, padahal dia aku ingatkan\Nuntuk bawa bekal.
Dialogue: 0,0:06:34.83,0:06:37.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia jadi ceroboh semenjak punya pacar.
Dialogue: 0,0:06:37.67,0:06:40.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan saat kemarin ricuh akibat kaiju,
Dialogue: 0,0:06:40.63,0:06:43.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia enggak sadar ada imbauan darurat.
Dialogue: 0,0:06:43.59,0:06:47.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya isi pikirannya\Npenuh sama Akaishi.
Dialogue: 0,0:06:47.18,0:06:50.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi itu seimut apa, sih?
Dialogue: 0,0:06:51.72,0:06:54.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat!\NTolong, ya, Kak.
Dialogue: 0,0:07:03.11,0:07:05.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami sama si Neng Menhera?
Dialogue: 0,0:07:05.40,0:07:07.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paling kamu salah lihat.
Dialogue: 0,0:07:07.66,0:07:08.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia datang!
Dialogue: 0,0:07:09.33,0:07:10.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:07:10.33,0:07:12.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami sendirian, tuh.
Dialogue: 0,0:07:12.50,0:07:15.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata memang salah paham.
Dialogue: 0,0:07:15.04,0:07:17.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil dia memilih Neng Menhera!
Dialogue: 0,0:07:17.29,0:07:19.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bikin kaget saja, ih!
Dialogue: 0,0:07:23.42,0:07:27.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Adikmu menitipkan bekal ini.
Dialogue: 0,0:07:27.26,0:07:28.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus...
Dialogue: 0,0:07:28.68,0:07:32.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan abaikan imbauan darurat, ya.
Dialogue: 0,0:07:32.47,0:07:36.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya... mungkin...
Dialogue: 0,0:07:38.40,0:07:41.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa saja kaijunya muncul lagi malam ini.
Dialogue: 0,0:07:43.15,0:07:44.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:07:44.69,0:07:46.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan hati-hati.
Dialogue: 0,0:07:50.99,0:07:53.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita beda kelas.
Dialogue: 0,0:07:53.08,0:07:54.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:07:54.20,0:07:57.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kita beda kelas,\Nayo makan siang bersama.
Dialogue: 0,0:07:57.62,0:07:59.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, iya!
Dialogue: 0,0:08:00.38,0:08:01.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai nanti.
Dialogue: 0,0:08:01.84,0:08:03.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya.
Dialogue: 0,0:08:03.80,0:08:07.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat sudah resmi berpacaran, Kuroe.
Dialogue: 0,0:08:07.76,0:08:10.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar turut senang.
Dialogue: 0,0:08:10.89,0:08:12.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:08:12.97,0:08:16.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita rayakan.\NJangan lupa undang Harugon.
Dialogue: 0,0:08:18.56,0:08:21.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kuharap tahun ajaran baru\Nberjalan damai,
Dialogue: 0,0:08:21.65,0:08:23.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kayaknya bakal berat.
Dialogue: 0,0:08:23.77,0:08:27.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak mau pindah kelas.
Dialogue: 0,0:08:27.32,0:08:30.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku, sih, senang sekelas denganmu.
Dialogue: 0,0:08:30.32,0:08:33.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau ada\Ncewek gaul yang mengincarku?
Dialogue: 0,0:08:33.45,0:08:36.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan melindungimu\Nsebagai pengganti Minami!
Dialogue: 0,0:08:37.33,0:08:39.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manatsu...
Dialogue: 0,0:08:40.75,0:08:42.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi lebih tenang!
Dialogue: 0,0:08:43.66,0:08:46.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat kamu Neng.
Dialogue: 0,0:08:46.42,0:08:49.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mendekati Minami pakai cara apa?
Dialogue: 0,0:08:49.30,0:08:50.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat banget.
Dialogue: 0,0:08:50.80,0:08:52.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hutan rimba?
Dialogue: 0,0:08:52.76,0:08:53.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manatsu...
Dialogue: 0,0:08:53.76,0:08:56.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tomosato, nanti kita nonton ini, yuk!
Dialogue: 0,0:08:56.18,0:08:58.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kurang suka film\Nyang aktornya cuma manusia.
Dialogue: 0,0:08:58.93,0:09:01.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tomosato, boleh minta kontakmu?\N- Dia terlalu populer!
Dialogue: 0,0:09:01.19,0:09:03.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Enggak boleh.\N- Kamu dengar, enggak?
Dialogue: 0,0:09:03.90,0:09:05.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pagi!
Dialogue: 0,0:09:07.07,0:09:10.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada banyak yang dulu sekelas denganku!
Dialogue: 0,0:09:10.32,0:09:12.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian lagi senang-senang, ya!
Dialogue: 0,0:09:12.11,0:09:14.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rairi, kamu juga imut hari ini!
Dialogue: 0,0:09:14.28,0:09:16.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Riasan jingga cocok untukmu!
Dialogue: 0,0:09:16.20,0:09:17.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan?
Dialogue: 0,0:09:17.29,0:09:19.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah lihat\Nulasan kosmetikmu kemarin!
Dialogue: 0,0:09:19.16,0:09:20.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makasih!
Dialogue: 0,0:09:20.25,0:09:21.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si-Siapa itu?
Dialogue: 0,0:09:21.92,0:09:24.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matanya besar!\NKulitnya berkilau!
Dialogue: 0,0:09:24.21,0:09:26.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanita kasta atas!
Dialogue: 0,0:09:26.21,0:09:28.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia sampai mengincarku,\Ntamatlah sudah.
Dialogue: 0,0:09:28.71,0:09:31.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rairi, kamu sudah dengar soal dia?
Dialogue: 0,0:09:31.22,0:09:32.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Deg!
Dialogue: 0,0:09:32.13,0:09:34.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumornya, dia pacar Minami.
Dialogue: 0,0:09:34.51,0:09:35.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:09:41.35,0:09:43.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di-Dia mendekat!
Dialogue: 0,0:09:50.28,0:09:52.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Main kekerasan?
Dialogue: 0,0:09:55.49,0:09:57.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Punggungmu bungkuk!
Dialogue: 0,0:09:59.58,0:10:02.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau posturmu buruk,\Ntakutnya disebut cewek jelek!
Dialogue: 0,0:10:02.29,0:10:03.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu harus percaya diri!
Dialogue: 0,0:10:04.88,0:10:07.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bibirmu juga kering banget!
Dialogue: 0,0:10:07.42,0:10:09.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal bawaannya sudah cantik,\Nmubazir banget!
Dialogue: 0,0:10:09.76,0:10:10.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sini.
Dialogue: 0,0:10:12.63,0:10:14.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warna apa yang cocok, ya?
Dialogue: 0,0:10:14.97,0:10:16.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Rairi...
Dialogue: 0,0:10:16.64,0:10:18.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, yang ini saja.
Dialogue: 0,0:10:19.18,0:10:22.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, pakai dulu scrub bibir.
Dialogue: 0,0:10:23.19,0:10:25.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, oleskan concealer bibir!
Dialogue: 0,0:10:25.44,0:10:29.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus oleskan lipstik ini\Ndi tengah bibir saja
Dialogue: 0,0:10:29.02,0:10:31.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan ratakan bagian luarnya dengan jari.
Dialogue: 0,0:10:31.90,0:10:35.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terakhir, tambahkan sedikit lip gloss.
Dialogue: 0,0:10:35.61,0:10:37.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selesai!
Dialogue: 0,0:10:38.87,0:10:40.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadinya imut banget, kan?
Dialogue: 0,0:10:40.83,0:10:42.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Benar juga.
Dialogue: 0,0:10:42.12,0:10:44.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kelihatan lebih segar.
Dialogue: 0,0:10:44.54,0:10:46.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hore, berubah total!
Dialogue: 0,0:10:47.17,0:10:49.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}PosiPeace!
Dialogue: 0,0:10:49.13,0:10:50.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Po-Posi?
Dialogue: 0,0:10:50.96,0:10:54.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Kono Raimu!\NPanggil saja Rairi!
Dialogue: 0,0:10:54.17,0:10:55.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rairi, aku juga!
Dialogue: 0,0:10:55.89,0:10:57.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba kamu bikin tutorial riasan!
Dialogue: 0,0:10:57.72,0:10:59.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja!
Dialogue: 0,0:11:00.60,0:11:03.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil berubah cuma karena lipstik.
Dialogue: 0,0:11:03.10,0:11:04.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini monster.
Dialogue: 0,0:11:05.90,0:11:07.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, entah kenapa...
Dialogue: 0,0:11:09.19,0:11:10.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, berikutnya.
Dialogue: 0,0:11:10.57,0:11:12.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa sedikit...
Dialogue: 0,0:11:12.99,0:11:15.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku Akaishi Kuroe.
Dialogue: 0,0:11:15.45,0:11:17.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sungkan untuk menyapaku.
Dialogue: 0,0:11:17.74,0:11:19.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal!
Dialogue: 0,0:11:19.53,0:11:22.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal.
Dialogue: 0,0:11:22.08,0:11:24.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, berikutnya.
Dialogue: 0,0:11:28.54,0:11:32.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mungkin orang yang cukup baik.
Dialogue: 0,0:11:39.97,0:11:42.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Ada apa?
Dialogue: 0,0:11:42.14,0:11:44.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu terasa berbeda dari pagi tadi.
Dialogue: 0,0:11:44.89,0:11:47.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, aku juga berpikir begitu.
Dialogue: 0,0:11:47.60,0:11:49.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa karena dia pakai lipstik?
Dialogue: 0,0:11:50.11,0:11:52.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajahmu jadi berseri-seri.
Dialogue: 0,0:11:52.65,0:11:56.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayak wujud pertama kaiju biologis!
Dialogue: 0,0:11:56.78,0:11:58.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, kaiju?
Dialogue: 0,0:12:00.24,0:12:01.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hapus saja.
Dialogue: 0,0:12:01.66,0:12:02.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:12:02.12,0:12:03.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cantik banget, lo!
Dialogue: 0,0:12:03.62,0:12:06.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu cocok banget!\NImut sekali!
Dialogue: 0,0:12:12.17,0:12:14.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Terima kasih.
Dialogue: 0,0:12:14.46,0:12:17.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cinta membuat cewek makin cantik, ya.
Dialogue: 0,0:12:17.26,0:12:20.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, aku didandani teman sekelas!
Dialogue: 0,0:12:24.39,0:12:27.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lipstiknya luntur sehabis aku makan siang.
Dialogue: 0,0:12:27.23,0:12:29.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal warnanya indah.
Dialogue: 0,0:12:29.14,0:12:32.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lipstik itu dijual di mana, ya?
Dialogue: 0,0:12:32.19,0:12:33.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Pasti bisa, kok!\N- Ingin tanya...
Dialogue: 0,0:12:33.61,0:12:34.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:12:34.65,0:12:36.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:12:37.44,0:12:39.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, jangan, deh.
Dialogue: 0,0:12:41.53,0:12:44.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu cocok banget!\NImut sekali!
Dialogue: 0,0:12:47.29,0:12:49.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bener banget!
Dialogue: 0,0:12:49.04,0:12:52.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anu, Rairi.
Dialogue: 0,0:12:52.00,0:12:54.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lipstikmu tadi pagi beli di mana?
Dialogue: 0,0:12:57.34,0:13:00.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia jijik...\NTapi wajar, sih.
Dialogue: 0,0:13:00.13,0:13:03.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian orang kayak aku\Nsok-sokan mau dandan.
Dialogue: 0,0:13:03.26,0:13:04.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, yang itu?
Dialogue: 0,0:13:04.85,0:13:06.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau belanja bareng?
Dialogue: 0,0:13:10.52,0:13:13.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit dipercaya,\Naku belanja bareng cewek gaul.
Dialogue: 0,0:13:13.86,0:13:15.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama belakangmu siapa, ya?
Dialogue: 0,0:13:15.73,0:13:17.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ku-Kuroe.
Dialogue: 0,0:13:17.86,0:13:19.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurotaso, ya?
Dialogue: 0,0:13:20.86,0:13:22.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taso?
Dialogue: 0,0:13:25.91,0:13:27.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, ketemu!
Dialogue: 0,0:13:30.12,0:13:31.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Terima kasih.
Dialogue: 0,0:13:36.09,0:13:38.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kubantu cari perona pipi yang pas.
Dialogue: 0,0:13:38.84,0:13:40.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mo-Mohon bantuannya.
Dialogue: 0,0:13:40.80,0:13:43.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perona pipi itu apa?
Dialogue: 0,0:13:43.26,0:13:45.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, boleh aku tanya?
Dialogue: 0,0:13:45.43,0:13:48.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu ingin menjadi imut?
Dialogue: 0,0:13:49.98,0:13:53.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai kamu tanya saran kosmetik.
Dialogue: 0,0:13:53.02,0:13:56.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa, ya?\NEng...
Dialogue: 0,0:13:57.23,0:14:01.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kecil aku penyakitan.
Dialogue: 0,0:14:01.57,0:14:04.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gejala yang muncul di tubuhku\Nsangat kompleks.
Dialogue: 0,0:14:04.70,0:14:07.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi kesulitan bergaul\Ndengan orang lain.
Dialogue: 0,0:14:07.53,0:14:10.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku enggak bisa jujur,\NMinami jadi...
Dialogue: 0,0:14:11.29,0:14:15.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang kucintai\Njadi sering salah paham.
Dialogue: 0,0:14:15.96,0:14:21.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin andai lebih percaya diri,\Naku bisa jadi lebih terbuka.
Dialogue: 0,0:14:21.17,0:14:25.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, saat Minami\Nmemuji lisptikku hari ini,
Dialogue: 0,0:14:25.22,0:14:29.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku merasa melayang\Ndan bisa melakukan apa pun.
Dialogue: 0,0:14:30.60,0:14:36.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kepercayaan diri\Nadalah kumpulan dari perasaan berkilau itu!
Dialogue: 0,0:14:36.15,0:14:41.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, aku ingin berusaha\Nmeski tidak bisa sepertimu.
Dialogue: 0,0:14:45.49,0:14:47.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kamu kenapa?
Dialogue: 0,0:14:47.57,0:14:51.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, kamu mengingatkanku\Npada diriku yang dulu.
Dialogue: 0,0:14:52.33,0:14:55.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja!\NKamu pasti bisa berubah, Kurotaso!
Dialogue: 0,0:14:56.67,0:14:58.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah berbelanja!
Dialogue: 0,0:15:01.38,0:15:04.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik!\NKonstruksi di mana-mana!
Dialogue: 0,0:15:04.88,0:15:07.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekitar sekolah juga\Nberantakan gara-gara kaiju.
Dialogue: 0,0:15:07.72,0:15:09.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf banget.
Dialogue: 0,0:15:09.56,0:15:10.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mampir ke bilik foto, yuk.
Dialogue: 0,0:15:10.93,0:15:14.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak perlu menggantinya?
Dialogue: 0,0:15:14.69,0:15:17.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya lipstikmu sudah kupakai.
Dialogue: 0,0:15:17.65,0:15:19.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak perlu!
Dialogue: 0,0:15:20.02,0:15:22.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian tasku penuh.
Dialogue: 0,0:15:25.82,0:15:28.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pipa airnya meledak!
Dialogue: 0,0:15:30.08,0:15:31.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rairi!
Dialogue: 0,0:15:31.24,0:15:33.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?
Dialogue: 0,0:15:44.09,0:15:46.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ra-Rairi?
Dialogue: 0,0:16:02.23,0:16:03.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rairi?
Dialogue: 0,0:16:03.48,0:16:05.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mencari sesuatu!
Dialogue: 0,0:16:08.07,0:16:09.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Ini, ya?
Dialogue: 0,0:16:14.95,0:16:17.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panik, ih.
Dialogue: 0,0:16:17.71,0:16:19.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurotaso, seragammu enggak basah?
Dialogue: 0,0:16:19.83,0:16:21.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, enggak.
Dialogue: 0,0:16:21.42,0:16:24.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Parah, aku benaran kaget!
Dialogue: 0,0:16:25.38,0:16:27.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rairi, barusan itu...
Dialogue: 0,0:16:27.05,0:16:28.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:16:38.39,0:16:40.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rairi lama banget ke toiletnya.
Dialogue: 0,0:16:45.36,0:16:48.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu Rairi, kan?
Dialogue: 0,0:16:54.37,0:16:55.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu merasa jijik?
Dialogue: 0,0:16:55.91,0:16:57.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berbicara!
Dialogue: 0,0:16:57.20,0:16:59.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, enggak.
Dialogue: 0,0:16:59.54,0:17:02.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya kamu bisa kuajak curhat.
Dialogue: 0,0:17:03.46,0:17:06.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maukah kamu mendengar ceritaku?
Dialogue: 0,0:17:08.63,0:17:13.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu aku selalu diejek\Ndengan sebutan Gorilairi.
Dialogue: 0,0:17:14.30,0:17:15.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya sedih,
Dialogue: 0,0:17:15.89,0:17:20.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi poin positifku cuma sifat ceria,\Njadi aku lanjutkan komedi gorila itu.
Dialogue: 0,0:17:20.98,0:17:27.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan saat kelas 3 SMP, orang yang kucintai\Ntertawa keras melihat komediku.
Dialogue: 0,0:17:27.53,0:17:30.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa sadar, kami jadi duo pelawak.
Dialogue: 0,0:17:30.95,0:17:33.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk pertama kalinya,\Naku bersyukur mirip gorila.
Dialogue: 0,0:17:34.49,0:17:36.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bahagia berada di sampingnya
Dialogue: 0,0:17:36.66,0:17:39.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sambil melawak jadi gorila tiap hari.
Dialogue: 0,0:17:42.29,0:17:45.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya aku paling bahagia\Nsaat bersamamu!
Dialogue: 0,0:17:46.42,0:17:50.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dibilang begitu,\Nnanti aku jatuh cinta, lo, Okada!
Dialogue: 0,0:17:50.80,0:17:53.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jatuh cinta juga boleh, kok.
Dialogue: 0,0:17:54.97,0:17:57.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah punya pacar, sih.
Dialogue: 0,0:17:58.14,0:18:02.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gorilairi, ya?\NKayaknya dia naksir kamu, lo.
Dialogue: 0,0:18:02.23,0:18:05.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya, aku enggak minat sama gorila.
Dialogue: 0,0:18:10.24,0:18:12.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belakangan ini Rairi murung.
Dialogue: 0,0:18:12.74,0:18:16.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami bosan, Rairi.\NLakukan yang biasanya, dong.
Dialogue: 0,0:18:17.78,0:18:20.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nih, kesukaanmu.
Dialogue: 0,0:18:24.33,0:18:27.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sebegitunya mau main\Nsama gorila, akan kuladeni!
Dialogue: 0,0:18:27.96,0:18:29.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benci kalian!
Dialogue: 0,0:18:29.55,0:18:31.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang bodoh tidak berperasaan!
Dialogue: 0,0:18:31.84,0:18:34.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cowok jahat tukang bikin salah paham!
Dialogue: 0,0:18:34.59,0:18:36.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia yang kejam buat orang jelek!
Dialogue: 0,0:18:36.76,0:18:37.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajah ini juga!
Dialogue: 0,0:18:37.97,0:18:39.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan diriku sendiri!
Dialogue: 0,0:18:39.60,0:18:42.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benci semuanya!
Dialogue: 0,0:18:46.94,0:18:52.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untungnya, aku jatuh ke semak-semak\Ndan dirawat selama sebulan.
Dialogue: 0,0:18:53.15,0:18:56.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teman-temanku pun menjenguk\Ndan meminta maaf.
Dialogue: 0,0:18:56.45,0:18:59.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi hatiku sudah membeku.
Dialogue: 0,0:18:59.58,0:19:02.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kalian pasti sedang tertawa, kan?"\NBegitu pikirku.
Dialogue: 0,0:19:04.08,0:19:08.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akulah yang paling membenci\Ndiriku sendiri.
Dialogue: 0,0:19:11.21,0:19:14.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu, aku menemukan ini.
Dialogue: 0,0:19:14.63,0:19:19.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini gratisan dari majalah\Ndan barang kolaborasi aktris terkenal.
Dialogue: 0,0:19:20.01,0:19:22.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan meremehkan gorila!
Dialogue: 0,0:19:34.36,0:19:38.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raimu, penampilanmu hari ini\Nagak berbeda, ya.
Dialogue: 0,0:19:39.07,0:19:41.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa karena riasan?
Dialogue: 0,0:19:41.03,0:19:42.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manis!
Dialogue: 0,0:19:44.25,0:19:47.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manis? Aku manis?
Dialogue: 0,0:19:53.55,0:19:58.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu mencari sesuatu\Nuntuk bisa menembus kegelapan.
Dialogue: 0,0:19:58.59,0:20:02.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berulang kali mengubah\Nriasan sampai iritasi kulit.
Dialogue: 0,0:20:02.43,0:20:05.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga merasa cemas\Nsaat enggak ada yang memuji.
Dialogue: 0,0:20:05.56,0:20:07.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sering nyaris menyerah.
Dialogue: 0,0:20:07.89,0:20:10.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tiap kali merasa begitu,
Dialogue: 0,0:20:10.48,0:20:13.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Enggak apa-apa,\Nkamu yang paling imut! PosiPeace!"
Dialogue: 0,0:20:13.94,0:20:17.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terus memuji diri sendiri\Ndi depan cermin.
Dialogue: 0,0:20:18.24,0:20:22.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga baru bisa menyukai diriku\Nbelakangan ini.
Dialogue: 0,0:20:22.66,0:20:23.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat.
Dialogue: 0,0:20:23.83,0:20:27.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seberapa keras kamu berjuang\Nsampai bisa menguasai keahlian itu?
Dialogue: 0,0:20:28.62,0:20:32.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang pun aku cuma menunjukkan\Nwajah tanpa riasan pada orang yang kupercaya!
Dialogue: 0,0:20:32.67,0:20:35.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong rahasiakan perkara gorila ini\Npada teman-teman, ya.
Dialogue: 0,0:20:35.59,0:20:36.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:20:36.30,0:20:38.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya mimpi.
Dialogue: 0,0:20:38.30,0:20:41.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelak, aku ingin mendirikan\Nmerek kosmetik sendiri.
Dialogue: 0,0:20:41.47,0:20:44.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin membuat kosmetik yang bisa
Dialogue: 0,0:20:44.18,0:20:47.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memicu gadis-gadis minder seperti kita\Nuntuk mengubah diri mereka!
Dialogue: 0,0:20:47.77,0:20:52.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, tiap hari aku mengulas kosmetik\Nagar dapat tawaran pekerjaan!
Dialogue: 0,0:20:52.65,0:20:55.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pasti bisa mewujudkannya!
Dialogue: 0,0:20:55.61,0:20:58.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buatlah kosmetik yang bisa\Nmengubah kaiju jadi manis!
Dialogue: 0,0:20:58.78,0:21:00.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, kaiju?
Dialogue: 0,0:21:00.16,0:21:01.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, enggak...
Dialogue: 0,0:21:01.57,0:21:05.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin kamu membuat\Nkosmetik sedahsyat itu!
Dialogue: 0,0:21:05.33,0:21:07.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke! Akan kubuat!
Dialogue: 0,0:21:07.04,0:21:10.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubuat gorila, kaiju,\Ndan semua orang jadi imut!
Dialogue: 0,0:21:11.88,0:21:14.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rairi sangat tegar.
Dialogue: 0,0:21:15.13,0:21:18.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang yang baik\Npasti punya alasannya tersendiri.
Dialogue: 0,0:21:19.72,0:21:22.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga harus berjuang.
Dialogue: 0,0:21:22.59,0:21:23.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pulang!
Dialogue: 0,0:21:24.55,0:21:27.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang, Kurotan!
Dialogue: 0,0:21:27.02,0:21:28.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:21:28.02,0:21:30.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajahmu kok begitu?\NPakai riasan?
Dialogue: 0,0:21:30.73,0:21:34.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak perlu sekaget itu!\NKamu juga, Jumbo King!
Dialogue: 0,0:21:35.44,0:21:38.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah itu kurang cocok buatmu?
Dialogue: 0,0:21:38.90,0:21:41.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu lebih suka wajah polosmu.
Dialogue: 0,0:21:42.03,0:21:45.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang menentukan\Ndiri yang kusukai!
Dialogue: 0,0:21:45.83,0:21:48.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Palingan demi Minami.
Dialogue: 0,0:21:50.79,0:21:52.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak cocok, ya?
Dialogue: 0,0:21:52.79,0:21:56.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, teknik Rairi sudah paling ajib.
Dialogue: 0,0:22:01.63,0:22:05.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah siap untuk karyawisata?\NAku enggak sabar pergi ke Okutama!
Dialogue: 0,0:22:05.43,0:22:07.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karyawisata, ya.
Dialogue: 0,0:22:07.56,0:22:10.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kami bisa ketemuan saat jam bebas?
Dialogue: 0,0:22:12.02,0:22:14.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawa lipstik, ah.
Dialogue: 0,0:22:14.19,0:22:18.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami juga bakal senang, kan?\NMungkin.
Dialogue: 0,0:22:26.24,0:22:27.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurotan, waktunya mak—
Dialogue: 0,0:22:29.49,0:22:32.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa teriak-teriak, sih?
Dialogue: 0,0:22:32.04,0:22:34.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warga Tokyo bisa terganggu, tahu!
Dialogue: 0,0:22:34.25,0:22:37.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan masuk kamarku sembarangan!
Dialogue: 0,0:24:09.18,0:24:10.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manisan berikutnya.
Dialogue: 0,0:24:10.72,0:24:11.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Marshmallow, dong!
Dialogue: 0,0:24:11.93,0:24:14.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dimakan langsung\Natau dibakar dulu sama-sama enak!
