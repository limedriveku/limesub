Dialogue: 0,0:00:48.19,0:00:50.61,sign,,0000,0000,0000,,KALAU ADA WAKTU BEBAS,\NAKU AKAN MENEMUIMU.
Dialogue: 0,0:00:53.07,0:00:55.03,sign,,0000,0000,0000,,OKE.
Dialogue: 0,0:01:04.17,0:01:09.67,sign,,0000,0000,0000,,KAIJU DARA CARAMELISE
Dialogue: 0,0:02:25.00,0:02:28.50,sign,,0000,0000,0000,,EPISODE 6: HUTAN RAIRI
Dialogue: 0,0:12:13.55,0:12:15.97,sign,,0000,0000,0000,,DEG
Dialogue: 0,0:13:38.17,0:13:42.38,sign,,0000,0000,0000,,HAHA
Dialogue: 0,0:18:33.47,0:18:35.22,sign,,0000,0000,0000,,MURUNG
Dialogue: 0,0:24:05.17,0:24:07.97,sign,,0000,0000,0000,,PRIA YANG BERCIUMAN DENGAN HARUGON!\NMENGUNGKAP MISTERI SANG PANGERAN KAIJU
Dialogue: 0,0:00:03.86,0:00:05.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus...
Dialogue: 0,0:00:07.78,0:00:14.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat gradasi tipis di pipi dengan gerakan\Nmelingkar dari bagian dalam.
Dialogue: 0,0:00:14.16,0:00:16.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlalu pink!
Dialogue: 0,0:00:16.41,0:00:17.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti aneh!
Dialogue: 0,0:00:17.83,0:00:19.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti ini aneh!
Dialogue: 0,0:00:21.71,0:00:23.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, aku mau bilas wajah—
Dialogue: 0,0:00:35.64,0:00:38.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sudah dibantu Rairi memilih riasan,
Dialogue: 0,0:00:38.85,0:00:41.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku enggak pandai memakainya.
Dialogue: 0,0:00:41.69,0:00:45.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku ingin terlihat\Nsedikit lebih imut.
Dialogue: 0,0:02:28.50,0:02:30.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sampai.
Dialogue: 0,0:02:30.71,0:02:32.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, luasnya!
Dialogue: 0,0:02:32.97,0:02:34.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Danau Okutama.
Dialogue: 0,0:02:34.63,0:02:37.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama resminya Waduk Ogouchi.
Dialogue: 0,0:02:37.68,0:02:41.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduk ini mampu menampung\N185 juta ton air
Dialogue: 0,0:02:41.56,0:02:43.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tergolong besar di Jepang.
Dialogue: 0,0:02:43.31,0:02:48.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Waduk Ogouchi ini dihancurkan\Noleh dewa penjaga kerajaan laut.
Dialogue: 0,0:02:48.27,0:02:50.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di-Dihancurkan?
Dialogue: 0,0:02:50.07,0:02:50.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:02:50.98,0:02:53.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oleh kumbang tanduk raksasa!
Dialogue: 0,0:02:57.03,0:02:58.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:02:58.28,0:03:00.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita satu grup, kan?
Dialogue: 0,0:03:01.58,0:03:04.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon kerja samanya.
Dialogue: 0,0:03:05.37,0:03:08.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Bentangkan terpal di tempat\Nyang diinginkan
Dialogue: 0,0:03:08.75,0:03:12.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tancapkan pasak di kedua ujungnya\Nagar tidak tertiup angin."
Dialogue: 0,0:03:12.84,0:03:13.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah!
Dialogue: 0,0:03:13.71,0:03:17.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, Manaty,\Nkamu pakai foundation apa?
Dialogue: 0,0:03:17.09,0:03:17.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:03:17.68,0:03:19.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fan?
Dialogue: 0,0:03:19.14,0:03:22.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku fan Alien Rakus.
Dialogue: 0,0:03:22.81,0:03:24.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?\NKok aku baru dengar?
Dialogue: 0,0:03:24.68,0:03:27.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat, mereka sudah akrab.
Dialogue: 0,0:03:31.98,0:03:34.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya aku enggak bisa!
Dialogue: 0,0:03:37.03,0:03:38.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa lihat-lihat?
Dialogue: 0,0:03:38.91,0:03:41.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya riasan kalian bagus.
Dialogue: 0,0:03:41.66,0:03:42.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:03:43.49,0:03:45.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, ada apa?
Dialogue: 0,0:03:45.71,0:03:47.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rairi.
Dialogue: 0,0:03:47.00,0:03:50.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Neng Menhera protes, nih.
Dialogue: 0,0:03:50.04,0:03:51.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukan!
Dialogue: 0,0:03:51.54,0:03:57.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku, gradasi pipi kalian alami\Ndan bulu matanya pun lentik.
Dialogue: 0,0:03:58.43,0:04:00.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matamu jeli juga.
Dialogue: 0,0:04:00.05,0:04:02.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perona pipi ini rekomendasi Rairi.
Dialogue: 0,0:04:05.02,0:04:06.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aman.
Dialogue: 0,0:04:06.81,0:04:08.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:04:08.14,0:04:11.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, ayo cepat selesaikan\Nlalu makan daging!
Dialogue: 0,0:04:11.23,0:04:12.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Gas!\N- Ya!
Dialogue: 0,0:04:12.52,0:04:14.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya!
Dialogue: 0,0:04:15.74,0:04:18.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski belum berjalan lancar.
Dialogue: 0,0:04:19.11,0:04:22.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga masih tidak yakin bisa berubah.
Dialogue: 0,0:04:22.37,0:04:27.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku ingin perlahan berubah\Njadi diri yang ideal.
Dialogue: 0,0:04:27.91,0:04:29.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo angkat!
Dialogue: 0,0:04:29.29,0:04:31.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu, wa!
Dialogue: 0,0:04:33.92,0:04:35.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sukses!\N- Hebat!
Dialogue: 0,0:04:37.51,0:04:39.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wih, jago banget!
Dialogue: 0,0:04:39.76,0:04:41.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, wah.
Dialogue: 0,0:04:53.19,0:04:55.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mesra banget, deh!
Dialogue: 0,0:04:55.07,0:04:56.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rairi!
Dialogue: 0,0:04:56.94,0:05:00.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kalian sangat akrab!
Dialogue: 0,0:05:01.24,0:05:04.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, apa yang kamu suka dari Minami?
Dialogue: 0,0:05:04.83,0:05:05.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:05:05.83,0:05:09.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharian ini,\Nkamu terus melirik Minami, kan?
Dialogue: 0,0:05:09.62,0:05:11.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kelihatan, ya?
Dialogue: 0,0:05:12.08,0:05:17.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Adakah sisi kerennya yang ingin kamu\Nceritakan ke orang lain?
Dialogue: 0,0:05:17.30,0:05:19.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Eh?
Dialogue: 0,0:05:19.34,0:05:21.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, justru...
Dialogue: 0,0:05:22.51,0:05:25.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya tidak bisa kuceritakan.
Dialogue: 0,0:05:26.26,0:05:27.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:05:28.06,0:05:30.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana bisa pura-pura asing.
Dialogue: 0,0:05:30.39,0:05:32.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu itu pacarku.
Dialogue: 0,0:05:33.27,0:05:38.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami selalu melihatku dengan tulus.
Dialogue: 0,0:05:40.57,0:05:43.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rairi, riasan matamu!
Dialogue: 0,0:05:43.61,0:05:44.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, wah.
Dialogue: 0,0:05:45.32,0:05:48.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurotaso, jangan membuatku terharu.
Dialogue: 0,0:05:48.79,0:05:50.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf.
Dialogue: 0,0:05:50.25,0:05:52.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cinta kalian murni!
Dialogue: 0,0:05:52.83,0:05:54.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enaknya!
Dialogue: 0,0:05:54.08,0:05:58.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku, sih, belum mau jatuh cinta lagi.
Dialogue: 0,0:05:58.67,0:06:01.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya patah hati sebelumnya\Nmasih berbekas.
Dialogue: 0,0:06:01.59,0:06:04.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan aku belum berani tampil apa adanya.
Dialogue: 0,0:06:04.64,0:06:06.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rairi...
Dialogue: 0,0:06:07.35,0:06:09.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Manaty bagaimana?
Dialogue: 0,0:06:09.72,0:06:10.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku?
Dialogue: 0,0:06:10.98,0:06:14.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja ada sosok yang kucintai!
Dialogue: 0,0:06:14.27,0:06:15.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:06:18.77,0:06:21.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ramai sekali, ya?
Dialogue: 0,0:06:21.36,0:06:23.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya SMA lain juga datang.
Dialogue: 0,0:06:23.40,0:06:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, tunggu!
Dialogue: 0,0:06:25.20,0:06:28.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daging dari SMA yang ini\Nkayak lebih mewah!
Dialogue: 0,0:06:28.37,0:06:29.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rairi!
Dialogue: 0,0:06:32.71,0:06:33.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau coba?
Dialogue: 0,0:06:33.58,0:06:35.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, boleh?
Dialogue: 0,0:06:43.55,0:06:44.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Okada?
Dialogue: 0,0:06:46.05,0:06:48.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Okada, kan...
Dialogue: 0,0:06:48.30,0:06:52.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kelas 3 SMP,\Nada orang yang kucintai.
Dialogue: 0,0:06:53.81,0:06:57.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cowok yang menggoda Rairi\Nmeski sudah punya pacar!
Dialogue: 0,0:06:57.27,0:07:00.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajahmu berubah banget!
Dialogue: 0,0:07:02.86,0:07:05.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kita pernah bertemu?
Dialogue: 0,0:07:07.87,0:07:10.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di-Dia enggak sadar?
Dialogue: 0,0:07:13.04,0:07:13.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rai...
Dialogue: 0,0:07:16.71,0:07:19.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Okachin, dia kenalanmu?
Dialogue: 0,0:07:19.13,0:07:20.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:07:20.75,0:07:23.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cewek gaul itu cantik juga.
Dialogue: 0,0:07:31.47,0:07:32.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konyol banget!
Dialogue: 0,0:07:32.97,0:07:35.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia enggak sadar sama sekali!
Dialogue: 0,0:07:35.31,0:07:39.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar saja!\NAku sudah berubah sejak SMA!
Dialogue: 0,0:07:39.94,0:07:43.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru aneh kalau dia sadar!
Dialogue: 0,0:07:43.15,0:07:44.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak apa-apa?
Dialogue: 0,0:07:47.53,0:07:49.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja!
Dialogue: 0,0:07:49.16,0:07:50.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan dipikirkan!
Dialogue: 0,0:07:50.95,0:07:53.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia benar-benar gelisah.
Dialogue: 0,0:07:53.79,0:07:55.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat.
Dialogue: 0,0:07:55.66,0:08:01.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau foto yang kami ambil bersama\Nsaat SMP masih ada di ponselnya...
Dialogue: 0,0:08:01.54,0:08:03.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini Rairi?
Dialogue: 0,0:08:03.34,0:08:04.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal dia panutanku!
Dialogue: 0,0:08:04.84,0:08:07.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita diajari dandan sama gorila?
Dialogue: 0,0:08:08.13,0:08:11.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya pasti kecewa berat.
Dialogue: 0,0:08:11.05,0:08:12.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, kok.
Dialogue: 0,0:08:14.89,0:08:18.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus membunuhnya\Nsebelum aku yang terbunuh!
Dialogue: 0,0:08:18.39,0:08:20.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Tenanglah!
Dialogue: 0,0:08:20.06,0:08:22.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu hindari saja orang itu!
Dialogue: 0,0:08:22.40,0:08:23.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlu bantuan?
Dialogue: 0,0:08:26.19,0:08:27.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau dibawa ke mana?
Dialogue: 0,0:08:29.99,0:08:31.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyaris saja!
Dialogue: 0,0:08:32.74,0:08:34.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf!\NKamu baik-baik saja?
Dialogue: 0,0:08:36.12,0:08:38.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cantik sekali.
Dialogue: 0,0:08:40.83,0:08:43.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}He-Hei, ayo pergi.
Dialogue: 0,0:08:43.63,0:08:45.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, hei, hei!
Dialogue: 0,0:08:49.51,0:08:51.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukannya gombal,
Dialogue: 0,0:08:51.43,0:08:54.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku orangnya memang terus terang.
Dialogue: 0,0:08:54.68,0:08:57.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur, kamu cantik banget.
Dialogue: 0,0:08:57.06,0:08:59.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum pernah ada yang secantik kamu.
Dialogue: 0,0:08:59.73,0:09:02.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jatuh cinta\Npada pandangan pertama!
Dialogue: 0,0:09:04.98,0:09:08.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daging yang tadi masih ada,\Nmau makan bareng?
Dialogue: 0,0:09:08.19,0:09:09.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu! Hei!
Dialogue: 0,0:09:09.90,0:09:12.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menyerang tanpa henti!
Dialogue: 0,0:09:12.78,0:09:16.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Tapi, Rairi pasti enggak mau...
Dialogue: 0,0:09:16.16,0:09:17.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke gas!
Dialogue: 0,0:09:17.79,0:09:20.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rairi?\NGampangan amat!
Dialogue: 0,0:09:20.33,0:09:21.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asyik!
Dialogue: 0,0:09:21.50,0:09:22.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke!
Dialogue: 0,0:09:22.79,0:09:24.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu!
Dialogue: 0,0:09:24.04,0:09:25.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rairi, tenangkan dirimu!
Dialogue: 0,0:09:26.40,0:09:29.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Benar juga!\NAku ini kenapa, sih?
Dialogue: 0,0:09:30.42,0:09:33.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu.\NAku paham, tapi...
Dialogue: 0,0:09:34.30,0:09:36.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini?\NAku senang.
Dialogue: 0,0:09:38.72,0:09:42.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu ingin balas dendam.
Dialogue: 0,0:09:42.27,0:09:45.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya dia mengucapkan itu padaku.
Dialogue: 0,0:09:46.44,0:09:51.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat ingin dipuji cantik olehnya!
Dialogue: 0,0:09:51.45,0:09:53.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rairi...
Dialogue: 0,0:09:53.72,0:09:55.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi!
Dialogue: 0,0:09:55.28,0:09:57.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Marshmallow bakar enak banget, lo!
Dialogue: 0,0:09:57.49,0:09:58.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami!
Dialogue: 0,0:09:58.74,0:10:00.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih ada banyak, ayo sini!
Dialogue: 0,0:10:00.83,0:10:02.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya.
Dialogue: 0,0:10:02.46,0:10:04.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergilah.
Dialogue: 0,0:10:04.12,0:10:05.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:10:05.00,0:10:08.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sudah jam bebas.\NAku akan baik-baik saja, kok.
Dialogue: 0,0:10:08.80,0:10:11.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya dia enggak akan sadar.
Dialogue: 0,0:10:11.72,0:10:15.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan bermain sebentar dengannya\Nsebagai bentuk balas dendam!
Dialogue: 0,0:10:18.22,0:10:19.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati, ya.
Dialogue: 0,0:10:20.39,0:10:21.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke!
Dialogue: 0,0:10:32.74,0:10:33.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak?
Dialogue: 0,0:10:33.70,0:10:34.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak.
Dialogue: 0,0:10:34.99,0:10:36.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan memaksakan diri!
Dialogue: 0,0:10:36.95,0:10:39.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benaran enak, kok!
Dialogue: 0,0:10:39.29,0:10:41.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku kepikiran sesuatu.
Dialogue: 0,0:10:41.62,0:10:43.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sudah kuduga.
Dialogue: 0,0:10:43.83,0:10:50.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya tumben wajahmu ketus,\Nbiasanya ceria kalau makan yang manis.
Dialogue: 0,0:10:52.55,0:10:54.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia benar-benar memperhatikanku.
Dialogue: 0,0:10:55.43,0:11:00.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tipe orang yang mementingkan\Npenampilan pacar?
Dialogue: 0,0:11:01.89,0:11:03.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, ya?
Dialogue: 0,0:11:03.48,0:11:06.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya kalau iya,\Nseharusnya kamu tidak memilihku.
Dialogue: 0,0:11:06.73,0:11:08.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu cantik, lo.
Dialogue: 0,0:11:08.73,0:11:10.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi-lagi bilang begitu.
Dialogue: 0,0:11:10.15,0:11:13.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau kelak aku menjadi kaiju...
Dialogue: 0,0:11:13.53,0:11:17.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya sosok menjijikkan.\NKamu pasti kabur, kan?
Dialogue: 0,0:11:17.49,0:11:18.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sosok menjijikkan?
Dialogue: 0,0:11:18.66,0:11:20.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu, sih...
Dialogue: 0,0:11:22.49,0:11:23.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:11:24.08,0:11:29.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu ingin bersamamu\Nterlepas dari apa pun wujudmu.
Dialogue: 0,0:11:32.38,0:11:34.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok tiba-tiba tanya begitu?
Dialogue: 0,0:11:34.55,0:11:38.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma mendadak cemas, tapi...
Dialogue: 0,0:11:38.97,0:11:40.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tenang.
Dialogue: 0,0:11:41.56,0:11:42.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:11:57.45,0:12:01.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Marshmallow-nya enak banget!\NMasih ada, enggak, ya?
Dialogue: 0,0:12:01.33,0:12:04.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya masih ada!\NMungkin!
Dialogue: 0,0:12:04.12,0:12:06.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau lagi!\NAku ambil dulu!
Dialogue: 0,0:12:06.71,0:12:07.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:12:13.55,0:12:15.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa itu tadi?
Dialogue: 0,0:12:16.38,0:12:19.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:12:19.68,0:12:22.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, itu terlalu cepat!
Dialogue: 0,0:12:22.01,0:12:23.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak sanggup!
Dialogue: 0,0:12:30.73,0:12:33.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, lihat si Okada.
Dialogue: 0,0:12:33.44,0:12:35.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mendekati cewek cakep lagi.
Dialogue: 0,0:12:35.53,0:12:37.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah punya pacar, masih saja begitu.
Dialogue: 0,0:12:37.57,0:12:38.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:12:38.24,0:12:39.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar tukang serong.
Dialogue: 0,0:12:39.91,0:12:42.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemarin pun dia main sama cewek lain.
Dialogue: 0,0:12:49.92,0:12:53.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Berengsek!
Dialogue: 0,0:12:54.71,0:12:56.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benaran enggak punya pacar?
Dialogue: 0,0:12:56.67,0:12:58.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:12:58.38,0:13:00.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal secantik ini.
Dialogue: 0,0:13:00.59,0:13:04.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kalau kamu?
Dialogue: 0,0:13:04.18,0:13:06.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku?\NMasih jomlo, kok.
Dialogue: 0,0:13:06.56,0:13:07.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita senasib.
Dialogue: 0,0:13:07.81,0:13:10.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rairi, cowok itu buaya!
Dialogue: 0,0:13:10.98,0:13:12.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Antingmu menarik, ya.
Dialogue: 0,0:13:13.81,0:13:15.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa pisang?
Dialogue: 0,0:13:16.15,0:13:20.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sebagai pengingat masa lalu
Dialogue: 0,0:13:20.20,0:13:22.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan demi mewujudkan mimpiku.
Dialogue: 0,0:13:22.07,0:13:25.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kalau melihat itu,
Dialogue: 0,0:13:25.41,0:13:28.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku jadi teringat padanya.
Dialogue: 0,0:13:29.08,0:13:32.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cewek jelek yang mirip gorila!
Dialogue: 0,0:13:32.25,0:13:36.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa dia mengamuk\Ngara-gara pisang.
Dialogue: 0,0:13:38.17,0:13:39.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah minta maaf,
Dialogue: 0,0:13:39.91,0:13:42.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi dia menghilang entah ke mana!
Dialogue: 0,0:13:47.18,0:13:50.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal dia sudah aku bikin populer.
Dialogue: 0,0:13:53.69,0:13:54.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kembali saja.
Dialogue: 0,0:13:57.07,0:14:00.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu enggak akan paham selamanya.
Dialogue: 0,0:14:00.82,0:14:03.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minggir, biar aku dayung sendiri.
Dialogue: 0,0:14:03.36,0:14:05.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu salah paham, ya?
Dialogue: 0,0:14:05.28,0:14:06.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah, minggir!
Dialogue: 0,0:14:06.74,0:14:08.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kenapa, sih?
Dialogue: 0,0:14:08.45,0:14:09.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minggir sana!
Dialogue: 0,0:14:09.95,0:14:11.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang dulu!
Dialogue: 0,0:14:11.12,0:14:13.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lepaskan aku!
Dialogue: 0,0:14:16.96,0:14:18.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat!
Dialogue: 0,0:14:21.51,0:14:23.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kantung rias!\NKantung riasku mana?
Dialogue: 0,0:14:23.51,0:14:25.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kubilang juga apa!
Dialogue: 0,0:14:25.01,0:14:25.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mendekat!
Dialogue: 0,0:14:25.97,0:14:27.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Rairi?
Dialogue: 0,0:14:27.93,0:14:29.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia baik-baik saja?
Dialogue: 0,0:14:29.43,0:14:31.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia enggak bisa bergerak?
Dialogue: 0,0:14:31.48,0:14:32.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia terluka?
Dialogue: 0,0:14:32.64,0:14:34.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Gawat, nih!\N- Riasannya luntur, ya?
Dialogue: 0,0:14:34.10,0:14:35.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Akan kupanggilkan guru!\N- Riasannya luntur, ya?
Dialogue: 0,0:14:35.10,0:14:36.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat!
Dialogue: 0,0:14:36.11,0:14:38.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang bakal tahu rahasia Rairi!
Dialogue: 0,0:14:38.69,0:14:39.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:14:41.44,0:14:42.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami!
Dialogue: 0,0:14:42.82,0:14:43.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:14:44.36,0:14:47.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sebagian tubuhku\Nberubah jadi wujud itu,
Dialogue: 0,0:14:47.07,0:14:51.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}perhatian orang akan teralihkan\Nsupaya Rairi bisa dandan.
Dialogue: 0,0:14:51.37,0:14:54.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, agar bisa begitu...
Dialogue: 0,0:14:56.88,0:14:59.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, mau bagaimana lagi!
Dialogue: 0,0:14:59.34,0:15:01.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Isi penuh keberanianku!
Dialogue: 0,0:15:02.26,0:15:03.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami!
Dialogue: 0,0:15:03.42,0:15:04.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya?
Dialogue: 0,0:15:09.72,0:15:12.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, aku terlalu membayangkannya!
Dialogue: 0,0:15:12.72,0:15:13.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, lipstik itu!
Dialogue: 0,0:15:15.10,0:15:16.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang tempo hari?
Dialogue: 0,0:15:17.60,0:15:19.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga, kamu cantik!
Dialogue: 0,0:15:21.02,0:15:22.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajahnya dekat banget.
Dialogue: 0,0:15:23.74,0:15:26.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak mau lari lagi.
Dialogue: 0,0:15:27.20,0:15:31.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada terus merendah diri,\Naku ingin mengungkapkan cintaku.
Dialogue: 0,0:15:31.49,0:15:34.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang sekarang pasti bisa.
Dialogue: 0,0:15:35.04,0:15:41.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena temanku yang paling bersinar\Ntelah mengajariku keberanian!
Dialogue: 0,0:15:54.77,0:15:55.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Me...
Dialogue: 0,0:15:55.85,0:15:57.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meleset!
Dialogue: 0,0:15:57.73,0:15:58.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi!
Dialogue: 0,0:15:58.77,0:16:00.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan lompat!
Dialogue: 0,0:16:00.98,0:16:02.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiga!
Dialogue: 0,0:16:02.07,0:16:03.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua!
Dialogue: 0,0:16:03.15,0:16:04.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu!
Dialogue: 0,0:16:08.36,0:16:09.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, ayo kembali.
Dialogue: 0,0:16:09.62,0:16:12.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kembali sendirian,\Naku akan dianggap jahat.
Dialogue: 0,0:16:12.87,0:16:14.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:16:16.50,0:16:17.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar, enggak?
Dialogue: 0,0:16:22.92,0:16:26.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kamu Gorilairi?
Dialogue: 0,0:16:27.13,0:16:29.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seram! Jijik!
Dialogue: 0,0:16:30.22,0:16:33.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan ini?\NEnggak masuk akal!
Dialogue: 0,0:16:33.81,0:16:35.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, tebing?
Dialogue: 0,0:16:35.85,0:16:41.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?\NPadahal tadi enggak ada.
Dialogue: 0,0:16:41.23,0:16:41.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:16:54.66,0:16:55.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harugon?
Dialogue: 0,0:16:55.74,0:16:56.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harugon!
Dialogue: 0,0:16:57.87,0:17:00.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata tidak bisa sebagian tubuh saja.
Dialogue: 0,0:17:00.79,0:17:02.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudahlah.
Dialogue: 0,0:17:02.25,0:17:05.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengulur waktu demi Rairi!
Dialogue: 0,0:17:07.63,0:17:10.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cowok menyedihkan.
Dialogue: 0,0:17:16.97,0:17:19.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begini,\Nkamu bisa leluasa dandan.
Dialogue: 0,0:17:19.59,0:17:22.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gunakan tanganku sebagai ruang rias.
Dialogue: 0,0:17:27.73,0:17:30.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa pun tolong aku!
Dialogue: 0,0:17:30.78,0:17:33.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak bisa berenang!
Dialogue: 0,0:17:33.49,0:17:35.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia anak dari kelasku!
Dialogue: 0,0:17:35.70,0:17:38.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pak Guru, Rairi juga ada\Ndi dalam tangan kaiju itu!
Dialogue: 0,0:17:39.54,0:17:43.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, aku bikin ombaknya kacau.
Dialogue: 0,0:17:43.00,0:17:44.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku banyak bergerak...
Dialogue: 0,0:17:44.79,0:17:46.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Bakal jatuh!
Dialogue: 0,0:17:46.67,0:17:48.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong aku!
Dialogue: 0,0:17:48.42,0:17:49.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rairi!
Dialogue: 0,0:17:49.63,0:17:50.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lari!
Dialogue: 0,0:17:51.34,0:17:53.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedikit lagi...
Dialogue: 0,0:18:19.62,0:18:22.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, lari!
Dialogue: 0,0:18:23.67,0:18:27.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menunjukkan wajah aslinya?
Dialogue: 0,0:18:27.75,0:18:30.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rairi!
Dialogue: 0,0:18:35.22,0:18:37.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaiju-nya murung?
Dialogue: 0,0:18:41.14,0:18:43.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rairi?
Dialogue: 0,0:18:43.94,0:18:49.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, inilah wajah asliku.
Dialogue: 0,0:18:51.19,0:18:54.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sudah membulatkan tekad,\Nternyata tetap malu.
Dialogue: 0,0:18:55.99,0:19:00.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Adakah yang mau\Nmeminjamkanku alat rias?
Dialogue: 0,0:19:00.20,0:19:02.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kantung riasku hanyut.
Dialogue: 0,0:19:02.58,0:19:04.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Foundation saja juga boleh.
Dialogue: 0,0:19:09.46,0:19:10.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon.
Dialogue: 0,0:19:19.43,0:19:22.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini foundation yang kamu sarankan.
Dialogue: 0,0:19:22.02,0:19:24.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma bawa ini.
Dialogue: 0,0:19:24.31,0:19:28.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku dipuji banyak orang\Nsaat memakainya!
Dialogue: 0,0:19:28.31,0:19:29.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama!
Dialogue: 0,0:19:29.61,0:19:33.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada lem kelopak mata\Ndan eyeliner rekomendasimu juga, lo!
Dialogue: 0,0:19:33.40,0:19:37.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat ajaranmu,\Nlipatan kelopak mata gandaku bagus!
Dialogue: 0,0:19:37.74,0:19:39.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini concealer-nya.
Dialogue: 0,0:19:39.20,0:19:42.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkatmu, aku enggak khawatir\Nsama bekas jerawat lagi.
Dialogue: 0,0:19:42.33,0:19:45.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ada perona pipi!\NYang satu merek denganmu!
Dialogue: 0,0:19:45.12,0:19:48.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa sudah cukup, Rairi?
Dialogue: 0,0:19:48.63,0:19:49.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:19:50.67,0:19:52.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup!
Dialogue: 0,0:19:54.09,0:19:55.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:19:56.51,0:19:58.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini penipuan.
Dialogue: 0,0:19:58.18,0:20:01.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Riasan cewek ngeri banget.
Dialogue: 0,0:20:01.01,0:20:02.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sok cantik.
Dialogue: 0,0:20:02.85,0:20:04.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar jelek.
Dialogue: 0,0:20:05.60,0:20:07.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rairi, apa-apaan dia?
Dialogue: 0,0:20:07.52,0:20:08.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak apa-apa.
Dialogue: 0,0:20:09.56,0:20:12.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga cuma menilai\Ndari penampilan luar.
Dialogue: 0,0:20:12.86,0:20:16.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berpikir bisa lebih percaya diri
Dialogue: 0,0:20:16.49,0:20:20.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau dipuji olehmu\Nyang berwajah tampan.
Dialogue: 0,0:20:20.24,0:20:24.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku enggak peduli lagi.
Dialogue: 0,0:20:24.20,0:20:26.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajah asliku memang gorila,
Dialogue: 0,0:20:26.91,0:20:29.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi semua temanku orang baik!
Dialogue: 0,0:20:29.29,0:20:31.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga punya mimpi besar!
Dialogue: 0,0:20:31.29,0:20:34.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski bisa goyah,\Ntetap pantang menyerah!
Dialogue: 0,0:20:35.13,0:20:37.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah yang membuatku cantik!
Dialogue: 0,0:20:37.80,0:20:41.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, kamu enggak penting.
Dialogue: 0,0:20:41.01,0:20:44.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergi sana kalau enggak mau\Nkulempar pisang lagi.
Dialogue: 0,0:20:44.35,0:20:47.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyatanya kamu juga enggak seberapa.
Dialogue: 0,0:20:47.27,0:20:50.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?\NTeman Si Jelek ya sama-sama jelek!
Dialogue: 0,0:20:50.60,0:20:51.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelek!
Dialogue: 0,0:20:57.57,0:21:00.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster raksasa muncul\Ndi Danau Okutama!
Dialogue: 0,0:21:00.36,0:21:02.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa yang sebenarnya terjadi?
Dialogue: 0,0:21:02.62,0:21:05.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya ada manusia\Nyang tersangkut di ekor Harugon!
Dialogue: 0,0:21:07.04,0:21:09.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cewek-cewek di penjuru negeri!
Dialogue: 0,0:21:09.79,0:21:12.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waspadalah pada pria ini!
Dialogue: 0,0:21:14.54,0:21:16.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Payah.
Dialogue: 0,0:21:19.09,0:21:21.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harugon, turunkan dia!
Dialogue: 0,0:21:22.18,0:21:23.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami.
Dialogue: 0,0:21:23.47,0:21:25.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak ingin kamu dianggap jahat!
Dialogue: 0,0:21:30.23,0:21:31.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:21:36.86,0:21:41.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kelak aku bisa menganggap\Nwujudku yang ini juga imut?
Dialogue: 0,0:21:45.20,0:21:50.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, hari ini aku juga\Nsudah berjuang keras.
Dialogue: 0,0:21:50.08,0:21:54.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, aku akan mulai\Ndari memuji diri sendiri.
Dialogue: 0,0:21:54.79,0:21:58.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diriku hari ini sangatlah manis.
Dialogue: 0,0:23:33.85,0:23:35.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,
Dialogue: 0,0:23:35.60,0:23:38.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kenapa lipstik Kurotaso\Nbisa ada di tangan kaiju itu?
Dialogue: 0,0:23:38.81,0:23:40.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Entah.
Dialogue: 0,0:23:40.73,0:23:43.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kaiju juga ingin menjadi imut?
Dialogue: 0,0:23:43.44,0:23:45.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masuk akal, tuh!
Dialogue: 0,0:23:45.11,0:23:46.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat menyentuh.
Dialogue: 0,0:23:46.53,0:23:48.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rairi!
Dialogue: 0,0:23:48.11,0:23:51.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jumlah penonton di video kemarin\Nbanyak banget!
Dialogue: 0,0:23:51.33,0:23:53.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Video rias dari muka polos itu!
Dialogue: 0,0:23:53.87,0:23:54.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:23:54.62,0:23:55.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau coba!
Dialogue: 0,0:23:55.91,0:23:57.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh, ayo coba sama-sama!
Dialogue: 0,0:23:57.58,0:23:59.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah lihat ini?
Dialogue: 0,0:23:59.67,0:24:01.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah!
Dialogue: 0,0:24:01.04,0:24:02.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masuk ke tren juga, lo!
Dialogue: 0,0:24:02.75,0:24:04.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sang Pangeran Kaiju!
Dialogue: 0,0:24:09.05,0:24:10.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manisan berikutnya.
Dialogue: 0,0:24:10.55,0:24:11.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permen Kapas.
Dialogue: 0,0:24:11.55,0:24:15.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuh bebuyutan Rairi!
