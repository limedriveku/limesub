Dialogue: 0,0:00:44.15,0:00:49.65,sign,,0000,0000,0000,,KAIJU DARA CARAMELISE
Dialogue: 0,0:02:04.98,0:02:08.47,sign,,0000,0000,0000,,EPISODE 8: TERBANG KE PULAU KAIJU MANATSU!
Dialogue: 0,0:04:43.80,0:04:44.26,sign,,0000,0000,0000,,AKU SUDAH SAMPAI.
Dialogue: 0,0:05:32.14,0:05:34.11,sign,,0000,0000,0000,,NOMOR TIDAK DIKENAL
Dialogue: 0,0:11:03.85,0:11:05.27,sign,,0000,0000,0000,,PRODUSER TV, SUTRADARA, TAKAMINE TOUKO
Dialogue: 0,0:14:03.66,0:14:07.37,sign,,0000,0000,0000,,DI LUAR JANGKAUAN
Dialogue: 0,0:20:12.82,0:20:14.69,sign,,0000,0000,0000,,KAMU BACA?\NKAMU PULANG BESOK, KAN?
Dialogue: 0,0:20:14.69,0:20:15.78,sign,,0000,0000,0000,,KUROTAN\NCEMAS
Dialogue: 0,0:20:29.54,0:20:30.63,sign,,0000,0000,0000,,BERITA TERKINI: MAKHLUK RAKSASA MUNCUL
Dialogue: 0,0:20:30.63,0:20:31.54,sign,,0000,0000,0000,,DI PERAIRAN DEKAT KEPULAUAN OGASAWARA
Dialogue: 0,0:23:08.58,0:23:09.62,sign,,0000,0000,0000,,MINAMI ARATA\NSISWA SMA YANG VIRAL SAAT INI
Dialogue: 0,0:23:09.62,0:23:11.54,sign,,0000,0000,0000,,SANG PANGERAN KAIJU
Dialogue: 0,0:00:06.03,0:00:09.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manatsu, kamu sedang apa?
Dialogue: 0,0:00:09.03,0:00:12.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pintu masuk apartemenku.
Dialogue: 0,0:00:12.49,0:00:14.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu.
Dialogue: 0,0:00:14.33,0:00:16.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan duduk.
Dialogue: 0,0:00:17.33,0:00:23.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah beberapa hari, aku menunggu\Nkesempatan bicara denganmu.
Dialogue: 0,0:00:23.71,0:00:24.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:00:24.34,0:00:28.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sudah pacaran dengan Kuroe,
Dialogue: 0,0:00:29.55,0:00:32.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu masih mau main serong, Minami?
Dialogue: 0,0:02:09.03,0:02:11.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Main serong?
Dialogue: 0,0:02:11.19,0:02:14.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu, aku selingkuh sama Harugon?
Dialogue: 0,0:02:14.91,0:02:17.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kecewa padamu.
Dialogue: 0,0:02:17.16,0:02:20.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira kamu pria setia.
Dialogue: 0,0:02:20.58,0:02:22.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:02:23.46,0:02:26.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memikirkan Harugon 24 jam.
Dialogue: 0,0:02:26.92,0:02:28.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di kala cerah maupun hujan,
Dialogue: 0,0:02:28.71,0:02:33.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku selalu menunggunya\Ndengan baju terbaik!
Dialogue: 0,0:02:33.76,0:02:37.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok Harugon malah memilihmu?
Dialogue: 0,0:02:37.64,0:02:39.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu salah paham!
Dialogue: 0,0:02:39.26,0:02:39.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:02:39.81,0:02:42.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dia menganggapku teman.
Dialogue: 0,0:02:43.27,0:02:45.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami cuma melihat kembang api sama-sama.
Dialogue: 0,0:02:45.74,0:02:46.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di malam festival pun...
Dialogue: 0,0:02:46.81,0:02:48.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malam festival?
Dialogue: 0,0:02:48.02,0:02:52.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di malam festival,\NHarugon cuma menggenggamku.
Dialogue: 0,0:02:52.49,0:02:54.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menggenggam?
Dialogue: 0,0:02:54.20,0:02:56.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan kumaafkan!
Dialogue: 0,0:02:56.20,0:02:57.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pengin pulang.
Dialogue: 0,0:02:57.74,0:02:59.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata sejauh itu, toh!
Dialogue: 0,0:02:59.87,0:03:01.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu!
Dialogue: 0,0:03:01.99,0:03:04.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak berniat main serong!
Dialogue: 0,0:03:04.37,0:03:05.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu,
Dialogue: 0,0:03:05.87,0:03:08.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang kucintai hanya Akaishi!
Dialogue: 0,0:03:10.50,0:03:11.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cinta...
Dialogue: 0,0:03:12.09,0:03:14.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku cinta Akaishi.
Dialogue: 0,0:03:14.67,0:03:16.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi?
Dialogue: 0,0:03:16.59,0:03:17.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:03:17.14,0:03:21.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pacaran kok masih memanggil marga?
Dialogue: 0,0:03:24.89,0:03:28.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang kucintai hanya Kuroe.
Dialogue: 0,0:03:29.61,0:03:31.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Kok direkam?
Dialogue: 0,0:03:31.48,0:03:34.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menyimpan videomu untuk jaminan.
Dialogue: 0,0:03:34.61,0:03:36.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi kebaikan Kuroe juga.
Dialogue: 0,0:03:36.74,0:03:38.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bo-Boleh, sih.
Dialogue: 0,0:03:40.49,0:03:42.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku disadarkan olehmu.
Dialogue: 0,0:03:43.54,0:03:49.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah mengungkapkan\Nrasa cintaku pada Harugon.
Dialogue: 0,0:03:50.46,0:03:54.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sudah sering cari perhatian,\Naku belum menyatakan cinta.
Dialogue: 0,0:03:54.59,0:03:58.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dia kurang peka\Nuntuk menyadari cintaku.
Dialogue: 0,0:03:58.59,0:04:01.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak mau lagi memendam rasa ini!
Dialogue: 0,0:04:01.55,0:04:03.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah lelah menunggunya!
Dialogue: 0,0:04:03.51,0:04:06.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini aku akan menghampiri Harugon!
Dialogue: 0,0:04:08.73,0:04:11.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pinjam Kuroe di hari Sabtu, ya!
Dialogue: 0,0:04:11.52,0:04:13.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? O-Oke.
Dialogue: 0,0:04:18.11,0:04:20.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak, tadi itu apa?
Dialogue: 0,0:04:20.16,0:04:22.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak juga enggak tahu.
Dialogue: 0,0:04:28.62,0:04:30.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gila!
Dialogue: 0,0:04:30.75,0:04:33.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manaty benar-benar seorang seleb!
Dialogue: 0,0:04:33.21,0:04:36.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya menyewa seluruh pantai!
Dialogue: 0,0:04:36.30,0:04:40.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesekali ada baiknya kita\Nnongkrong dengan mewah.
Dialogue: 0,0:04:48.23,0:04:49.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuroe.
Dialogue: 0,0:04:49.69,0:04:52.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menyiapkan camilan manis juga, lo.
Dialogue: 0,0:04:53.15,0:04:55.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada es krim gulung!
Dialogue: 0,0:04:56.32,0:04:57.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat makan!
Dialogue: 0,0:05:00.07,0:05:01.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa, nih?
Dialogue: 0,0:05:02.24,0:05:04.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurotaso pakainya baju renang sekolah?
Dialogue: 0,0:05:04.62,0:05:08.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurang estetik, deh.\NMau pinjam punyaku?
Dialogue: 0,0:05:08.16,0:05:11.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memakainya bukan buat difoto, kok.
Dialogue: 0,0:05:11.96,0:05:14.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Disita!
Dialogue: 0,0:05:14.04,0:05:17.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kirim foto untuk Minami\Nyang sedang lelah!
Dialogue: 0,0:05:17.38,0:05:18.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, tunggu!
Dialogue: 0,0:05:18.46,0:05:20.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti langsung semangat!
Dialogue: 0,0:05:20.84,0:05:22.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan!
Dialogue: 0,0:05:23.05,0:05:24.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf!
Dialogue: 0,0:05:38.48,0:05:40.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nomor ini lagi.
Dialogue: 0,0:05:45.53,0:05:46.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:05:46.87,0:05:49.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulau ini auranya mencekam.
Dialogue: 0,0:05:49.62,0:05:51.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayak bakal ada kaiju yang muncul.
Dialogue: 0,0:05:51.58,0:05:54.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuroe memang hebat.\NInstingmu tajam.
Dialogue: 0,0:05:54.79,0:05:58.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulau ini terkenal dengan legenda kaiju.
Dialogue: 0,0:05:58.75,0:06:03.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mural yang mirip kaiju juga\Nditemukan di gua pulau ini.
Dialogue: 0,0:06:03.59,0:06:08.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konon para penduduk pulau\Ndilahap oleh kaiju ini.
Dialogue: 0,0:06:08.26,0:06:10.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyeramkan.
Dialogue: 0,0:06:10.10,0:06:13.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuhnya yang ramping ini\Nmirip Harugon, kan?
Dialogue: 0,0:06:13.56,0:06:15.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya.
Dialogue: 0,0:06:15.69,0:06:16.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maka dari itu,
Dialogue: 0,0:06:17.44,0:06:21.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisakah kalian membantuku sedikit?
Dialogue: 0,0:06:21.19,0:06:21.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:06:21.94,0:06:23.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa, bisa!
Dialogue: 0,0:06:23.07,0:06:24.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun boleh!
Dialogue: 0,0:06:24.78,0:06:28.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin aku tidak balas budi\Nkalau dikasih kemewahan ini!
Dialogue: 0,0:06:28.78,0:06:30.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Benar.
Dialogue: 0,0:06:30.33,0:06:32.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:06:32.66,0:06:33.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo ikut aku.
Dialogue: 0,0:06:33.79,0:06:35.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurotaso, ayo cepat!
Dialogue: 0,0:06:35.67,0:06:37.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya.
Dialogue: 0,0:06:41.59,0:06:42.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manatsu.
Dialogue: 0,0:06:43.51,0:06:45.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan ini?
Dialogue: 0,0:06:45.97,0:06:48.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon, Kuroe.
Dialogue: 0,0:06:48.47,0:06:51.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bantulah aku sekarang juga\Nselaku Miko Harugon!
Dialogue: 0,0:06:53.77,0:06:55.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa terjadi sesuatu?
Dialogue: 0,0:06:55.31,0:07:00.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin mengungkapkan perasaanku\Nsebelum Harugon jadi milik orang lain.
Dialogue: 0,0:07:00.61,0:07:05.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin bisa menemuinya di pulau\Nyang terkenal sebagai Pulau Kaiju ini.
Dialogue: 0,0:07:05.24,0:07:08.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau dandan secantik mungkin\Ndi hari spesial ini,
Dialogue: 0,0:07:08.49,0:07:11.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku meminta bantuan Rairi!
Dialogue: 0,0:07:11.49,0:07:15.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terkejut waktu dia bilang\Nmau berubah jadi Harugon.
Dialogue: 0,0:07:15.33,0:07:17.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada-ada saja.
Dialogue: 0,0:07:17.08,0:07:20.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kualitas ini luar biasa!
Dialogue: 0,0:07:20.38,0:07:23.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata cinta sejati\Nyang kamu maksud itu Harugon?
Dialogue: 0,0:07:23.51,0:07:25.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seleramu gokil abis!
Dialogue: 0,0:07:25.47,0:07:28.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kayaknya aku enggak bisa membantu!
Dialogue: 0,0:07:28.59,0:07:30.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harugon kayaknya masih tidur.
Dialogue: 0,0:07:30.01,0:07:31.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong diusahakan!
Dialogue: 0,0:07:32.43,0:07:39.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kali ini gagal bertemu Harugon,\Naku berniat untuk melupakannya.
Dialogue: 0,0:07:39.40,0:07:40.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:07:40.98,0:07:44.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasa cintaku padanya enggak akan pudar,
Dialogue: 0,0:07:44.53,0:07:47.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku enggak mau merepotkan!
Dialogue: 0,0:07:47.15,0:07:48.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Begitu, ya.
Dialogue: 0,0:07:48.74,0:07:52.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski Manatsu agak kasihan,\Nmungkin itu opsi terbaik.
Dialogue: 0,0:07:52.70,0:07:55.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalaupun dia tidak di sini,
Dialogue: 0,0:07:55.83,0:07:58.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seharusnya pulau ini mudah didatangi.
Dialogue: 0,0:07:58.50,0:08:00.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon, Kuroe!
Dialogue: 0,0:08:00.33,0:08:04.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku coba panggil, deh.
Dialogue: 0,0:08:04.63,0:08:06.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:08:08.55,0:08:10.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan, Kuroe.
Dialogue: 0,0:08:10.51,0:08:12.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggil Harugon kemari!
Dialogue: 0,0:08:12.60,0:08:13.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:08:13.26,0:08:16.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo! Datanglah kapan saja, Harugon!
Dialogue: 0,0:08:16.64,0:08:18.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku harus apa?
Dialogue: 0,0:08:18.69,0:08:19.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:08:19.44,0:08:20.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Kuroe!
Dialogue: 0,0:08:20.98,0:08:21.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:08:21.40,0:08:25.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah... eng...
Dialogue: 0,0:08:26.74,0:08:27.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yo!
Dialogue: 0,0:08:27.74,0:08:31.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harugon! Harugon!
Dialogue: 0,0:08:31.95,0:08:34.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, hei, Harugon!
Dialogue: 0,0:08:35.65,0:08:38.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat!\NGelombangnya makin kuat!
Dialogue: 0,0:08:40.00,0:08:41.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, kocak banget...
Dialogue: 0,0:08:42.88,0:08:44.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tiba-tiba mengantuk.
Dialogue: 0,0:08:44.88,0:08:48.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Yo, Harugon!\N- Teruskan, Kuroe!
Dialogue: 0,0:08:48.34,0:08:51.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sini, sini, Harugon.\N- Harugon!
Dialogue: 0,0:09:06.19,0:09:08.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah cukup, kan?
Dialogue: 0,0:09:08.57,0:09:10.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harugon enggak mau bangun, tuh.
Dialogue: 0,0:09:10.61,0:09:13.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti lokasinya salah.
Dialogue: 0,0:09:14.87,0:09:18.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memanggil Harugon\Ndari tebing itu!
Dialogue: 0,0:09:18.33,0:09:20.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lumayan jauh, ya.
Dialogue: 0,0:09:20.00,0:09:22.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ikut.\NBahaya kalau kamu sendirian.
Dialogue: 0,0:09:22.92,0:09:25.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih!
Dialogue: 0,0:09:28.55,0:09:29.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedikit lagi.
Dialogue: 0,0:09:29.97,0:09:32.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar lagi sampai!
Dialogue: 0,0:09:40.10,0:09:42.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harugon!
Dialogue: 0,0:09:42.48,0:09:49.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai Harugon!\NAku sangat mengagumimu!
Dialogue: 0,0:09:55.87,0:09:59.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari mulai gelap, kita harus kembali.
Dialogue: 0,0:10:00.33,0:10:03.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti hari ini dia sedang\Nenggak enak badan.
Dialogue: 0,0:10:14.51,0:10:16.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manatsu...
Dialogue: 0,0:10:18.60,0:10:19.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harugon!
Dialogue: 0,0:10:24.90,0:10:25.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ja...
Dialogue: 0,0:10:26.15,0:10:29.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan itu yang dikira kaiju...
Dialogue: 0,0:10:33.28,0:10:35.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kamu?\NJangan mengganggu!
Dialogue: 0,0:10:35.70,0:10:37.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok malah dicentang?
Dialogue: 0,0:10:39.54,0:10:41.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lari!
Dialogue: 0,0:10:41.12,0:10:43.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kulawan sampai titik\Ndarah penghabisan!
Dialogue: 0,0:10:43.75,0:10:45.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar bodoh!
Dialogue: 0,0:10:45.42,0:10:47.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahaya!
Dialogue: 0,0:10:51.96,0:10:52.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walah.
Dialogue: 0,0:10:52.80,0:10:53.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:10:53.88,0:10:55.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduduh!
Dialogue: 0,0:10:58.05,0:11:00.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf menelepon terus-menerus.
Dialogue: 0,0:11:00.93,0:11:03.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka kamu mau ketemuan.
Dialogue: 0,0:11:03.31,0:11:05.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kartu namaku.
Dialogue: 0,0:11:06.15,0:11:09.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memang tampan, Pangeran Kaiju.
Dialogue: 0,0:11:10.23,0:11:11.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Produser?
Dialogue: 0,0:11:11.53,0:11:12.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!
Dialogue: 0,0:11:12.86,0:11:16.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku datang untuk menolak dengan tegas.
Dialogue: 0,0:11:16.57,0:11:18.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ingin masuk TV.
Dialogue: 0,0:11:18.07,0:11:20.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti!
Dialogue: 0,0:11:20.28,0:11:23.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Situasi sekarang sangat sulit, kan?
Dialogue: 0,0:11:23.29,0:11:26.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seluruh Jepang ingin tahu\Ninformasi tentangmu.
Dialogue: 0,0:11:28.63,0:11:31.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bahkan tidak bisa kencan\Ndengan tenang, kan?
Dialogue: 0,0:11:32.71,0:11:36.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makin kamu sembunyi,\Nmasyarakat akan makin mengejar.
Dialogue: 0,0:11:36.68,0:11:41.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu angkat suara\Ntentang foto waktu itu,
Dialogue: 0,0:11:41.01,0:11:43.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}situasi akan lebih cepat reda.
Dialogue: 0,0:11:44.98,0:11:47.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tidak akan mengedit apa pun.
Dialogue: 0,0:11:47.85,0:11:50.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan saja pada kami.
Dialogue: 0,0:11:50.61,0:11:53.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya ini cara agar kamu\Nbisa kembali hidup damai,
Dialogue: 0,0:11:53.90,0:11:55.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pangeran.
Dialogue: 0,0:11:55.24,0:11:57.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan pangeran.
Dialogue: 0,0:12:06.83,0:12:10.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kamu jelaskan lebih lanjut?
Dialogue: 0,0:12:16.97,0:12:19.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku masih hidup.
Dialogue: 0,0:12:19.18,0:12:20.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuroe!
Dialogue: 0,0:12:23.18,0:12:24.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manatsu!
Dialogue: 0,0:12:24.31,0:12:25.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuroe!
Dialogue: 0,0:12:25.39,0:12:27.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu terluka?
Dialogue: 0,0:12:27.27,0:12:29.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ajaibnya enggak!\NKalau kamu?
Dialogue: 0,0:12:29.35,0:12:31.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga baik-baik saja!
Dialogue: 0,0:12:31.48,0:12:34.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kakiku sedikit memar.
Dialogue: 0,0:12:34.27,0:12:37.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan ke sana!\NJangan ke mana-mana!
Dialogue: 0,0:12:37.40,0:12:39.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati!
Dialogue: 0,0:12:46.04,0:12:48.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh.
Dialogue: 0,0:12:51.67,0:12:52.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:12:54.25,0:12:57.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata cuma coretan biasa.
Dialogue: 0,0:13:03.76,0:13:05.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:13:11.02,0:13:12.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sana juga ada.
Dialogue: 0,0:13:21.16,0:13:22.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Telur?
Dialogue: 0,0:13:34.88,0:13:37.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuroe!
Dialogue: 0,0:13:39.17,0:13:41.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ke sana sekarang!
Dialogue: 0,0:13:46.97,0:13:49.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Kuroe.
Dialogue: 0,0:13:49.77,0:13:52.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita jadi begini gara-gara aku.
Dialogue: 0,0:13:52.10,0:13:54.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak apa-apa, kok.
Dialogue: 0,0:13:54.23,0:13:56.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan kakimu?
Dialogue: 0,0:13:56.52,0:13:58.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung tidak patah.
Dialogue: 0,0:13:58.98,0:14:02.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, mungkin sulit dipakai jalan.
Dialogue: 0,0:14:03.66,0:14:07.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kita menunggu pertolongan.
Dialogue: 0,0:14:07.37,0:14:08.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit.
Dialogue: 0,0:14:09.24,0:14:10.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terasa sakit, ya?
Dialogue: 0,0:14:11.08,0:14:13.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hatiku sakit.
Dialogue: 0,0:14:13.62,0:14:18.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di saat seperti ini pun\NHarugon tetap tidak datang, ya.
Dialogue: 0,0:14:20.17,0:14:25.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu mengira dia menghindar\Nkarena mencintaiku.
Dialogue: 0,0:14:25.22,0:14:26.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:14:26.64,0:14:27.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:14:27.76,0:14:31.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir dia selalu melarikan diri\Nkarena merasa malu.
Dialogue: 0,0:14:31.68,0:14:35.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, nyatanya dia sama sekali\Nenggak tertarik padaku.
Dialogue: 0,0:14:36.94,0:14:41.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin dicubit pakai tangan\Ndan kakinya yang rupawan itu!
Dialogue: 0,0:14:41.15,0:14:42.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dicubit, ya.
Dialogue: 0,0:14:48.12,0:14:50.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu secinta itu padanya?
Dialogue: 0,0:14:52.20,0:14:55.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya ingin menyangkalmu,
Dialogue: 0,0:14:55.21,0:14:59.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku enggak paham\Napa daya tarik Harugon.
Dialogue: 0,0:14:59.17,0:15:01.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian dia seram.
Dialogue: 0,0:15:02.67,0:15:04.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau berubah jadi wujud itu,
Dialogue: 0,0:15:05.43,0:15:08.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mustahil aku bisa menjalin asmara.
Dialogue: 0,0:15:08.10,0:15:10.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti aku akan menderita.
Dialogue: 0,0:15:13.06,0:15:15.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:15:15.81,0:15:19.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata ada yang berpikiran\Nseperti itu juga.
Dialogue: 0,0:15:21.61,0:15:25.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, aku tetap mencintai sosoknya.
Dialogue: 0,0:15:26.66,0:15:29.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harugon ada di dunia ini.
Dialogue: 0,0:15:29.07,0:15:33.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal itu sudah membuat hatiku\Nberdebar tiap hari
Dialogue: 0,0:15:33.45,0:15:36.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai-sampai lupa bernapas.
Dialogue: 0,0:15:38.83,0:15:43.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tumbuh besar di keluarga kaya\Ntanpa kesulitan apa pun,
Dialogue: 0,0:15:43.46,0:15:47.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membuatku kurang memahami\Nobrolan anak yang seumuran.
Dialogue: 0,0:15:47.05,0:15:51.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segala sesuatu di dunia ini\Nterasa sudah ditentukan.
Dialogue: 0,0:15:51.76,0:15:55.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi lebih tertarik pada dunia fiksi.
Dialogue: 0,0:15:57.06,0:16:01.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi hari itu, malam saat aku\Nmendengar auman Harugon...
Dialogue: 0,0:16:02.77,0:16:06.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duniaku seperti dijungkir balik.
Dialogue: 0,0:16:14.12,0:16:15.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun yang kulihat sekarang
Dialogue: 0,0:16:16.16,0:16:19.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rasanya punya potensi\Nyang menjulang 100 meter.
Dialogue: 0,0:16:20.63,0:16:25.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski Harugon mengutuk\Ntakdirnya sendiri...
Dialogue: 0,0:16:25.21,0:16:28.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski seisi dunia memusuhinya...
Dialogue: 0,0:16:28.30,0:16:30.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan terus berteriak.
Dialogue: 0,0:16:31.35,0:16:34.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Terima kasih sudah terlahir."
Dialogue: 0,0:16:35.89,0:16:37.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski ditolak,
Dialogue: 0,0:16:37.94,0:16:40.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bangga pada cinta ini.
Dialogue: 0,0:16:40.85,0:16:42.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manatsu...
Dialogue: 0,0:16:46.78,0:16:50.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku enggak bisa\Nmempertemukanmu kalian.
Dialogue: 0,0:16:52.16,0:16:56.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan aku bertemu denganmu\Nberkat Harugon.
Dialogue: 0,0:17:06.13,0:17:08.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Larilah, Kuroe!
Dialogue: 0,0:17:08.01,0:17:09.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakiku enggak sanggup!
Dialogue: 0,0:17:09.05,0:17:10.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bi-Bicara apa kamu?
Dialogue: 0,0:17:10.47,0:17:11.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil aku meninggalkan...
Dialogue: 0,0:17:11.64,0:17:15.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak sanggup bertemu Minami\Nkalau terjadi sesuatu padamu!
Dialogue: 0,0:17:15.22,0:17:17.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi dia sangat mencintaimu!
Dialogue: 0,0:17:18.77,0:17:22.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga!\NTolong terima video ini, Kuroe!
Dialogue: 0,0:17:22.34,0:17:24.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersama dengan nyawaku!
Dialogue: 0,0:17:24.81,0:17:26.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang kucintai...
Dialogue: 0,0:17:27.48,0:17:28.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya Kuroe.
Dialogue: 0,0:17:29.40,0:17:32.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya Kuroe.
Dialogue: 0,0:17:35.58,0:17:40.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, tinggalkan aku dan larilah!
Dialogue: 0,0:17:42.25,0:17:44.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergi begitu saja?
Dialogue: 0,0:17:50.17,0:17:51.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harugon...
Dialogue: 0,0:17:54.43,0:17:56.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mencintaimu, Harugon!
Dialogue: 0,0:18:30.51,0:18:31.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harugon...
Dialogue: 0,0:18:32.13,0:18:35.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menerima perasaanku?
Dialogue: 0,0:18:49.52,0:18:50.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti mimpi saja.
Dialogue: 0,0:18:51.94,0:18:53.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mencintaimu, Harugon!
Dialogue: 0,0:18:53.99,0:18:55.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sosok terbaik sealam semesta!
Dialogue: 0,0:18:55.78,0:18:59.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan cubit aku sampai hancur\Natau lelehkan pakai sinar panas!
Dialogue: 0,0:18:59.99,0:19:03.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini momen yang kutunggu-tunggu!
Dialogue: 0,0:19:12.26,0:19:14.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Indahnya.
Dialogue: 0,0:19:15.68,0:19:18.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dunia memang seluas ini,
Dialogue: 0,0:19:18.76,0:19:22.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}keberadaanmu tidaklah aneh.
Dialogue: 0,0:19:24.23,0:19:28.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kelak kamu akan bisa\Nbertemu dengan teman-temanmu.
Dialogue: 0,0:19:29.65,0:19:31.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jantungku terus berdebar!
Dialogue: 0,0:19:34.40,0:19:36.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Temanku?
Dialogue: 0,0:19:36.07,0:19:38.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mereka benar ada,\Nbisa gawat jadinya.
Dialogue: 0,0:19:39.57,0:19:42.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku saja tidak tahu asal-usulku.
Dialogue: 0,0:19:42.66,0:19:45.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Manaty!
Dialogue: 0,0:19:50.92,0:19:55.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, apa itu sebenarnya?
Dialogue: 0,0:20:00.97,0:20:02.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harugon?
Dialogue: 0,0:20:02.85,0:20:04.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:20:04.56,0:20:07.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ada di sini.
Dialogue: 0,0:20:07.19,0:20:09.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harugon?
Dialogue: 0,0:20:15.78,0:20:18.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurotan tidak bisa dihubungi.
Dialogue: 0,0:20:18.74,0:20:20.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa terjadi sesuatu?
Dialogue: 0,0:20:20.91,0:20:25.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berita terkini, makhluk raksasa\Nmuncul di Perairan Ogasawara.
Dialogue: 0,0:20:25.75,0:20:26.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:20:26.20,0:20:28.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurotan kambuh lagi?
Dialogue: 0,0:20:28.62,0:20:31.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makhluk itu mendarat di pulau
Dialogue: 0,0:20:31.54,0:20:33.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- tanpa penghuni lalu hilang di laut.\N- Pulau ini...
Dialogue: 0,0:20:35.17,0:20:37.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tapi...
Dialogue: 0,0:20:38.13,0:20:40.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulau itu juga, suatu saat...
Dialogue: 0,0:20:43.31,0:20:44.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus pergi.
Dialogue: 0,0:20:45.43,0:20:48.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan membuat Mama khawatir,
Dialogue: 0,0:20:48.73,0:20:49.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurotan.
Dialogue: 0,0:22:23.32,0:22:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah jam sebegini, ya.
Dialogue: 0,0:22:25.62,0:22:28.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum sempat mengabari Ibu.
Dialogue: 0,0:22:28.37,0:22:30.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dia bakal menangis lagi.
Dialogue: 0,0:22:33.25,0:22:34.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pula—
Dialogue: 0,0:22:35.13,0:22:37.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mengejutkanku, Jumbo King!
Dialogue: 0,0:22:37.88,0:22:40.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Ibu mana?
Dialogue: 0,0:22:46.64,0:22:49.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengejar tur Mayu dulu!\NLusa sudah pulang, kok!
Dialogue: 0,0:22:49.68,0:22:51.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lupa berkabar!
Dialogue: 0,0:22:51.06,0:22:52.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Titip Jumbo King juga!
Dialogue: 0,0:22:52.35,0:22:53.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari Mama.
Dialogue: 0,0:22:53.27,0:22:56.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tur Mayu?\NMendadak banget.
Dialogue: 0,0:22:56.60,0:22:59.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Perdana di obrolan tanpa henti!\N- Mandi dulu, ah.
Dialogue: 0,0:22:59.19,0:23:01.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian pasti kaget,
Dialogue: 0,0:23:01.99,0:23:06.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pangeran Kaiju yang sedang viral\Nakan tampil perdana di sini!
Dialogue: 0,0:23:09.62,0:23:12.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah sang Pangeran Kaiju, Minami Arata!
Dialogue: 0,0:23:13.25,0:23:15.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, apa?\NKok bisa?
Dialogue: 0,0:23:15.71,0:23:18.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kenapa Minami di situ?\N- Dia sangat populer di kalangan wanita!
Dialogue: 0,0:23:19.17,0:23:22.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak berminat terlibat\Ndalam industri hiburan, kan?
Dialogue: 0,0:23:22.13,0:23:23.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa datang ke acara ini?
Dialogue: 0,0:23:23.72,0:23:25.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti gara-gara orang itu, ya?
Dialogue: 0,0:23:25.38,0:23:26.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Produser Takamine!
Dialogue: 0,0:23:26.97,0:23:30.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memang tidak ada lawan\Nkalau soal melobi!
Dialogue: 0,0:23:31.18,0:23:33.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu ciuman dengan kaiju?
Dialogue: 0,0:23:33.22,0:23:35.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng, gadis itu...
Dialogue: 0,0:23:35.60,0:23:38.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis itu?\NHarugon perempuan?
Dialogue: 0,0:23:38.19,0:23:40.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, intuisiku bilang begitu.
Dialogue: 0,0:23:40.27,0:23:42.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak takut Harugon dibasmi?
Dialogue: 0,0:23:43.03,0:23:44.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal itu...
Dialogue: 0,0:23:46.70,0:23:48.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawablah sambil mengarah\Nke kamera kedua.
Dialogue: 0,0:23:48.78,0:23:49.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng...
Dialogue: 0,0:23:52.74,0:23:55.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan melindungimu, Harugon.
Dialogue: 0,0:23:56.54,0:23:59.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reaksinya gila!
Dialogue: 0,0:23:59.17,0:24:00.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini ladang pekerjaan!
Dialogue: 0,0:24:00.46,0:24:03.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Bakal sibuk, nih!\N- Minami?
Dialogue: 0,0:24:08.84,0:24:10.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manisan berikutnya.
Dialogue: 0,0:24:10.22,0:24:11.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak ada.
Dialogue: 0,0:24:11.18,0:24:14.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kebanyakan makan\Ncamilan manis pulau tropis!
