Dialogue: 0,0:01:13.80,0:01:15.43,sign,,0000,0000,0000,,PLES
Dialogue: 0,0:03:02.16,0:03:07.67,sign,,0000,0000,0000,,KAIJU DARA CARAMELISE
Dialogue: 0,0:04:22.95,0:04:26.45,sign,,0000,0000,0000,,EPISODE 10: JANGAN MENANGIS,\NKAIJU YANG SEDANG PATAH HATI
Dialogue: 0,0:07:12.54,0:07:14.12,sign,,0000,0000,0000,,AKAISHI KUROE
Dialogue: 0,0:07:14.12,0:07:15.50,sign,,0000,0000,0000,,HARI INI AKU WAWANCARA\NUNTUK PROGRAM BERITA
Dialogue: 0,0:00:02.73,0:00:04.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bintangnya indah.
Dialogue: 0,0:00:04.44,0:00:06.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tidak seindah dirimu.
Dialogue: 0,0:00:06.24,0:00:07.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gombal, ah.
Dialogue: 0,0:00:08.86,0:00:09.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:00:12.58,0:00:14.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Burungnya besar sekali.
Dialogue: 0,0:00:19.04,0:00:22.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukannya itu terlalu besar?
Dialogue: 0,0:00:29.76,0:00:31.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mendekat!
Dialogue: 0,0:00:50.82,0:00:52.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat!
Dialogue: 0,0:00:56.70,0:00:58.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat!
Dialogue: 0,0:00:58.16,0:01:03.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berbagai macam wujudku\Ndilihat oleh pria itu!
Dialogue: 0,0:01:03.33,0:01:04.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini?
Dialogue: 0,0:01:04.54,0:01:07.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia punya foto atau video\Nsebagai bukti...
Dialogue: 0,0:01:07.63,0:01:09.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau benar begitu...
Dialogue: 0,0:01:17.39,0:01:19.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak boleh!\NAku manusia! Aku manusia!
Dialogue: 0,0:01:19.73,0:01:21.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Jangan bercanda!\N- Aku manusia!
Dialogue: 0,0:01:21.31,0:01:24.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini beda jauh!\NAku enggak butuh yang ini!
Dialogue: 0,0:01:24.56,0:01:26.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kamu yang asal membelinya,\N- Itu dia.
Dialogue: 0,0:01:26.82,0:01:28.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi tidak akan kuganti.
Dialogue: 0,0:01:28.57,0:01:29.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak guna banget.
Dialogue: 0,0:01:29.78,0:01:31.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, benar!\NBodoh!
Dialogue: 0,0:01:31.65,0:01:33.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ajak kami bicara lagi!
Dialogue: 0,0:01:33.24,0:01:35.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berantem sama anak SD?
Dialogue: 0,0:01:47.30,0:01:49.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan kamu?\NKayak bocah saja!
Dialogue: 0,0:01:50.42,0:01:51.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu...
Dialogue: 0,0:01:51.30,0:01:52.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?
Dialogue: 0,0:01:52.43,0:01:54.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berani juga kamu, Yonegon!
Dialogue: 0,0:01:54.18,0:01:57.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa cewek ini?\NKakakmu?
Dialogue: 0,0:01:57.10,0:01:59.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar tukang mengadu!
Dialogue: 0,0:01:59.06,0:02:00.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar! Benar!
Dialogue: 0,0:02:00.27,0:02:02.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar enggak guna.
Dialogue: 0,0:02:02.52,0:02:05.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku maunya melihat yang asli,\Nbukan komik!
Dialogue: 0,0:02:05.73,0:02:06.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, yang asli!
Dialogue: 0,0:02:06.94,0:02:08.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}2D juga enggak apa-apa.
Dialogue: 0,0:02:08.44,0:02:12.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira kamu bisa mendapatkannya\Ndengan mudah.
Dialogue: 0,0:02:12.86,0:02:14.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di-Dia
Dialogue: 0,0:02:14.82,0:02:17.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}disuruh-suruh sama bocah SD?
Dialogue: 0,0:02:17.41,0:02:19.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak usah main lagi sama kami!\NDadah!
Dialogue: 0,0:02:19.87,0:02:20.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dadah!
Dialogue: 0,0:02:20.79,0:02:21.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!
Dialogue: 0,0:02:25.17,0:02:27.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?
Dialogue: 0,0:02:27.67,0:02:30.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf kalau ikut campur,
Dialogue: 0,0:02:30.30,0:02:35.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sulit bergaul sama anak SD\Nkalau kita orang dewasa.
Dialogue: 0,0:02:37.85,0:02:41.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, ranselmu ketinggalan!
Dialogue: 0,0:02:41.18,0:02:42.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini punyaku!
Dialogue: 0,0:02:46.73,0:02:49.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan orang dewasa!
Dialogue: 0,0:02:50.65,0:02:53.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku anak SD!
Dialogue: 0,0:04:27.41,0:04:29.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anak SD?
Dialogue: 0,0:04:30.54,0:04:32.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku gagal paham sama ucapanmu.
Dialogue: 0,0:04:32.79,0:04:34.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini buktinya!
Dialogue: 0,0:04:35.00,0:04:38.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertumbuhanku lebih cepat dari anak lain,
Dialogue: 0,0:04:38.47,0:04:41.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi orang-orang sering salah paham,\Ntapi inilah buktinya!
Dialogue: 0,0:04:41.76,0:04:44.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf, kukira kamu mahasiswa.
Dialogue: 0,0:04:44.39,0:04:45.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, kakiku berdarah!
Dialogue: 0,0:04:45.97,0:04:47.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit!
Dialogue: 0,0:04:56.11,0:04:57.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?
Dialogue: 0,0:04:57.53,0:05:00.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti lukamu harus disterilkan, ya.
Dialogue: 0,0:05:09.46,0:05:10.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu orang baik.
Dialogue: 0,0:05:12.00,0:05:13.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mbak Kaiju.
Dialogue: 0,0:05:14.42,0:05:18.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bi-Bisakah kamu merahasiakan soal itu?
Dialogue: 0,0:05:18.67,0:05:20.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya, itu...
Dialogue: 0,0:05:20.63,0:05:22.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu penyakit.
Dialogue: 0,0:05:22.34,0:05:25.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyakit yang membuat\Nanggota tubuhku berubah jadi kaiju.
Dialogue: 0,0:05:28.02,0:05:28.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Termasuk lasernya?
Dialogue: 0,0:05:28.98,0:05:32.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya, makanya jangan bilang-bilang.
Dialogue: 0,0:05:38.11,0:05:39.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat!
Dialogue: 0,0:05:40.74,0:05:42.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma itu?
Dialogue: 0,0:05:42.07,0:05:45.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak akan bilang,\Ntapi kamu harus turuti permintaanku!
Dialogue: 0,0:05:45.78,0:05:46.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa?
Dialogue: 0,0:05:46.87,0:05:49.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo bangun desa bersamaku!
Dialogue: 0,0:05:49.87,0:05:51.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu perkara mudah!
Dialogue: 0,0:05:52.92,0:05:54.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Yoneyama Daichi!
Dialogue: 0,0:05:54.67,0:05:56.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Akaishi Kuroe.
Dialogue: 0,0:05:56.59,0:05:58.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal, Kak Kuroe!
Dialogue: 0,0:05:58.63,0:05:59.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal.
Dialogue: 0,0:05:59.80,0:06:00.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya.
Dialogue: 0,0:06:00.76,0:06:02.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong rahasiakan soal ini.
Dialogue: 0,0:06:02.97,0:06:07.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bilang aku boleh gabung geng\Nkalau beli majalah mesum.
Dialogue: 0,0:06:07.22,0:06:09.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya aku kelihatan kayak pria dewasa.
Dialogue: 0,0:06:09.85,0:06:12.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yonegon?\NItu panggilanmu?
Dialogue: 0,0:06:12.10,0:06:15.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya aku besar dan seram\Nkayak Harugon.
Dialogue: 0,0:06:15.19,0:06:16.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, deh.
Dialogue: 0,0:06:16.69,0:06:18.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, kutu kayu.
Dialogue: 0,0:06:19.44,0:06:21.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak punya teman.
Dialogue: 0,0:06:21.78,0:06:24.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya penampilanku begini.
Dialogue: 0,0:06:24.28,0:06:26.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku suka Harugon!
Dialogue: 0,0:06:26.62,0:06:28.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harugon itu keren!
Dialogue: 0,0:06:28.70,0:06:31.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia enggak gentar meski ditembaki\Npesawat tempur!
Dialogue: 0,0:06:31.54,0:06:33.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia makhluk terkuat!
Dialogue: 0,0:06:33.33,0:06:36.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, Mbak Kaiju pasti keren juga!
Dialogue: 0,0:06:36.96,0:06:38.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka!
Dialogue: 0,0:06:42.01,0:06:44.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, kamu juga keren.
Dialogue: 0,0:06:45.68,0:06:48.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku iri sama tinggimu.
Dialogue: 0,0:06:48.22,0:06:50.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Benarkah?\NBaru kali ini ada yang bilang begitu.
Dialogue: 0,0:06:50.85,0:06:51.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asyik!
Dialogue: 0,0:06:54.02,0:06:56.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pukulanmu kuat banget.
Dialogue: 0,0:06:56.23,0:06:58.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mulai kelihatan kayak anak SD.
Dialogue: 0,0:06:58.52,0:07:01.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu apartemenku!\NAyo main sepulang sekolah!
Dialogue: 0,0:07:01.23,0:07:02.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha-Hari ini?
Dialogue: 0,0:07:02.44,0:07:03.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak bisa?
Dialogue: 0,0:07:05.99,0:07:07.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa, toh, aku senggang.
Dialogue: 0,0:07:07.57,0:07:10.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Asyik! Aku tunggu, ya!\N- Lagian aku enggak bisa ketemu Minami.
Dialogue: 0,0:07:10.20,0:07:11.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dadah!
Dialogue: 0,0:07:11.20,0:07:12.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:07:18.00,0:07:19.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami.
Dialogue: 0,0:07:19.21,0:07:21.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Film! Ada film!
Dialogue: 0,0:07:21.00,0:07:21.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:07:21.59,0:07:23.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada tawaran untukmu.
Dialogue: 0,0:07:23.30,0:07:26.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini film kaiju yang akan tayang\Ntahun depan, Godora.
Dialogue: 0,0:07:26.30,0:07:30.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma perlu muncul di adegan kilas balik\Ndan enggak pakai dialog, tenang saja.
Dialogue: 0,0:07:30.26,0:07:33.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini enggak ada kaitannya\Ndengan Harugon, kan?
Dialogue: 0,0:07:33.18,0:07:35.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaiju ini didesain berdasarkan Harugon.
Dialogue: 0,0:07:35.48,0:07:38.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pangeran Kaiju wajib muncul, kan?
Dialogue: 0,0:07:41.69,0:07:43.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, silakan masuk!
Dialogue: 0,0:07:43.53,0:07:44.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:07:50.70,0:07:52.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tidak berjumpa.
Dialogue: 0,0:07:55.79,0:07:58.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak jago banget basmi hantunya!
Dialogue: 0,0:08:00.25,0:08:03.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku harus melindungi desa.
Dialogue: 0,0:08:03.88,0:08:05.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tebang pohon, ya.
Dialogue: 0,0:08:05.42,0:08:07.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, biar kuratakan tanahnya.
Dialogue: 0,0:08:13.64,0:08:15.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asyik! Rumahnya jadi!
Dialogue: 0,0:08:15.89,0:08:17.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seru juga, ya.
Dialogue: 0,0:08:17.89,0:08:20.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pertama kalinya aku\Nmain gim sama orang lain.
Dialogue: 0,0:08:20.35,0:08:21.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:08:22.40,0:08:23.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:08:23.40,0:08:26.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya aku juga enggak punya teman.
Dialogue: 0,0:08:26.36,0:08:29.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana cara agar punya teman, ya?
Dialogue: 0,0:08:29.74,0:08:32.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana, ya...
Dialogue: 0,0:08:32.83,0:08:34.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekor!
Dialogue: 0,0:08:35.37,0:08:38.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku keasyikan main gim\Nsampai enggak sadar!
Dialogue: 0,0:08:38.25,0:08:40.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lihat!
Dialogue: 0,0:08:40.21,0:08:43.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak perlu ditutupi.\NItu penyakit, kan?
Dialogue: 0,0:08:44.46,0:08:46.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak juga kerepotan, ya.
Dialogue: 0,0:08:46.67,0:08:48.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia malaikat?
Dialogue: 0,0:08:48.34,0:08:50.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita mirip, ya.
Dialogue: 0,0:08:50.38,0:08:51.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:08:52.80,0:08:54.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa tenang.
Dialogue: 0,0:08:55.47,0:08:58.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai saja aku dan Minami\Nbisa seperti ini juga.
Dialogue: 0,0:09:08.86,0:09:10.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibumu?
Dialogue: 0,0:09:10.40,0:09:13.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia meninggal karena sakit tiga tahun lalu.
Dialogue: 0,0:09:14.91,0:09:19.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibuku selalu mencemaskanku.
Dialogue: 0,0:09:22.50,0:09:25.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya aku selalu sendirian.
Dialogue: 0,0:09:27.09,0:09:29.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti dia masih mencemaskanku sekarang.
Dialogue: 0,0:09:29.80,0:09:33.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, aku ingin punya banyak teman.
Dialogue: 0,0:09:33.93,0:09:36.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan membuat Ibu tenang.
Dialogue: 0,0:09:38.22,0:09:40.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harugon itu keren!
Dialogue: 0,0:09:40.10,0:09:43.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, Mbak Kaiju pasti keren juga!
Dialogue: 0,0:09:43.73,0:09:45.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka!
Dialogue: 0,0:09:48.57,0:09:51.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti tenang, kok.
Dialogue: 0,0:09:51.32,0:09:54.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bahkan bisa akrab sama kaiju.
Dialogue: 0,0:09:54.78,0:09:57.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pria berhati baik.
Dialogue: 0,0:10:03.04,0:10:03.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}He-Hei!
Dialogue: 0,0:10:03.92,0:10:07.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Kuroe kayak ibuku, deh!
Dialogue: 0,0:10:07.00,0:10:08.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan ibumu!
Dialogue: 0,0:10:08.42,0:10:09.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenaganya gede!
Dialogue: 0,0:10:11.51,0:10:13.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:10:15.47,0:10:18.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kami tidak sering ketemu dulu.
Dialogue: 0,0:10:18.47,0:10:22.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempo hari saja aku bikin\Nsuasananya canggung.
Dialogue: 0,0:10:30.19,0:10:32.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih makan malamnya.
Dialogue: 0,0:10:32.24,0:10:34.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masakan ayahku enak, kan?
Dialogue: 0,0:10:34.41,0:10:35.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mampir saja kalau mau lagi!
Dialogue: 0,0:10:35.82,0:10:37.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya harus!
Dialogue: 0,0:10:37.03,0:10:37.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:10:37.83,0:10:39.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa.
Dialogue: 0,0:10:41.08,0:10:42.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan bisa main lagi?
Dialogue: 0,0:10:42.87,0:10:45.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku senggang tiap pulang sekolah.
Dialogue: 0,0:10:45.75,0:10:48.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lain kali, aku akan bawa teman...
Dialogue: 0,0:10:48.34,0:10:51.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, kamu suka Harugon?
Dialogue: 0,0:10:51.38,0:10:54.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apanya yang kamu suka?\NSeberapa suka?
Dialogue: 0,0:10:54.05,0:10:56.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahu jumlah tonjolan di ekor Harugon?
Dialogue: 0,0:10:56.55,0:10:58.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, kita main berdua saja.
Dialogue: 0,0:10:58.89,0:11:01.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asyik!\NAku suka Kak Kuroe!
Dialogue: 0,0:11:01.47,0:11:02.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, jangan asal peluk.
Dialogue: 0,0:11:03.18,0:11:05.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kayak guguk saja!
Dialogue: 0,0:11:05.69,0:11:10.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski dia anak SD,\Norang lewat pasti salah paham.
Dialogue: 0,0:11:10.65,0:11:13.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kamu terlalu dekat, Daichi.
Dialogue: 0,0:11:14.32,0:11:16.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Kuroe?
Dialogue: 0,0:11:17.16,0:11:18.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:11:19.16,0:11:22.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, dia anak SD.
Dialogue: 0,0:11:22.54,0:11:24.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru aneh kalau aku baper.
Dialogue: 0,0:11:25.33,0:11:28.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku tolak, dia pasti sakit hati.
Dialogue: 0,0:11:28.79,0:11:31.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf, Daichi!\NAku cuma kaget sedikit!
Dialogue: 0,0:11:31.96,0:11:34.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga suka kamu banget!
Dialogue: 0,0:11:34.72,0:11:35.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suka banget!
Dialogue: 0,0:11:35.88,0:11:36.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga!
Dialogue: 0,0:11:37.51,0:11:39.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suka banget!
Dialogue: 0,0:11:45.23,0:11:46.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi?
Dialogue: 0,0:11:47.69,0:11:49.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa dia?
Dialogue: 0,0:11:49.73,0:11:51.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu yang siapa?
Dialogue: 0,0:11:51.36,0:11:53.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini salah paham!
Dialogue: 0,0:11:53.23,0:11:55.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia anak SD!
Dialogue: 0,0:11:55.28,0:11:56.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sumpah!
Dialogue: 0,0:11:56.57,0:11:58.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, pasti enggak percaya.
Dialogue: 0,0:11:58.61,0:12:00.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, orang itu.
Dialogue: 0,0:12:00.62,0:12:02.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pangeran Kaiju, kan?
Dialogue: 0,0:12:02.66,0:12:04.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, benaran!
Dialogue: 0,0:12:04.70,0:12:06.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keren!
Dialogue: 0,0:12:11.79,0:12:12.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:12:12.59,0:12:13.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!
Dialogue: 0,0:12:15.42,0:12:17.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak, siapa dia?
Dialogue: 0,0:12:17.26,0:12:18.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di-Dia pacarku!
Dialogue: 0,0:12:18.63,0:12:19.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pacar?
Dialogue: 0,0:12:20.97,0:12:24.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang disukai kakak?
Dialogue: 0,0:12:25.43,0:12:29.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka Kuroe lebih dari kamu!
Dialogue: 0,0:12:29.27,0:12:31.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku bukan anak kecil!\N- Kamu ini bicara apa?
Dialogue: 0,0:12:31.98,0:12:33.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah dewasa!
Dialogue: 0,0:12:37.40,0:12:39.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami!
Dialogue: 0,0:12:43.45,0:12:44.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:12:45.12,0:12:46.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak orang yang melihat.
Dialogue: 0,0:12:48.50,0:12:49.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami...
Dialogue: 0,0:12:51.17,0:12:52.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu.
Dialogue: 0,0:12:53.79,0:12:58.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar saja dia salah paham\Ndi situasi seperti ini.
Dialogue: 0,0:12:58.55,0:13:03.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dia bahkan enggak mau\Nmendengar penjelasanku?
Dialogue: 0,0:13:03.51,0:13:05.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bahkan enggak tahu kapan\Nkami bisa ketemu lagi.
Dialogue: 0,0:13:05.89,0:13:07.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa akhirnya begini?
Dialogue: 0,0:13:07.85,0:13:10.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebegitu pedulinya dia\Nsama mata orang-orang?
Dialogue: 0,0:13:10.64,0:13:12.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan sampai mengabaikanku?
Dialogue: 0,0:13:13.81,0:13:15.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin lebih sering bertemu.
Dialogue: 0,0:13:15.19,0:13:17.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin bertemu dan mengobrol.
Dialogue: 0,0:13:17.23,0:13:19.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaanku diabaikan begitu saja?
Dialogue: 0,0:13:19.28,0:13:21.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, bagaimana denganku?
Dialogue: 0,0:13:21.16,0:13:23.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku... aku... aku...
Dialogue: 0,0:13:24.66,0:13:27.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti itu bakal keluar lagi.
Dialogue: 0,0:13:27.20,0:13:29.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jauh lebih besar dari yang selama ini.
Dialogue: 0,0:13:30.16,0:13:33.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa gawat kalau sampai keluar!
Dialogue: 0,0:13:33.46,0:13:36.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakal gawat banget!
Dialogue: 0,0:13:37.38,0:13:39.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak tahan lagi!
Dialogue: 0,0:13:41.22,0:13:43.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin sebaiknya kita putus.
Dialogue: 0,0:13:52.52,0:13:53.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Se...
Dialogue: 0,0:13:53.94,0:13:56.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya gawat kalau orang-orang
Dialogue: 0,0:13:56.44,0:13:58.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku tidak bisa berhenti.\N- tahu aku pacarmu.
Dialogue: 0,0:13:58.65,0:14:01.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Bisa-bisa penggemarmu hilang.\N- Aku tidak bisa berhenti.
Dialogue: 0,0:14:01.53,0:14:03.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sama aktris mungkin aman,
Dialogue: 0,0:14:03.16,0:14:05.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku tidak bisa berhenti!\N- tapi kamu pasti malu kalau denganku, kan?
Dialogue: 0,0:14:05.37,0:14:06.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi?
Dialogue: 0,0:14:06.08,0:14:08.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga selalu merasa malu!
Dialogue: 0,0:14:08.08,0:14:12.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat berada di sampingmu,\Nkejelekanku makin mencolok.
Dialogue: 0,0:14:12.08,0:14:15.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kita kencan, pandangan\Norang-orang juga menyakitkan.
Dialogue: 0,0:14:17.59,0:14:22.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita ini terlalu jauh berbeda!
Dialogue: 0,0:14:24.22,0:14:26.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia hiburan bagus, kan?
Dialogue: 0,0:14:26.47,0:14:29.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seluruh wanita di Jepang mendambakanmu.
Dialogue: 0,0:14:31.56,0:14:34.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan hiraukan aku
Dialogue: 0,0:14:35.73,0:14:37.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan terbanglah tinggi.
Dialogue: 0,0:14:43.40,0:14:44.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak...
Dialogue: 0,0:14:49.45,0:14:50.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Apa?
Dialogue: 0,0:14:50.33,0:14:52.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Pasangan putus?\N- Pangeran Kaiju?
Dialogue: 0,0:14:52.04,0:14:53.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana?
Dialogue: 0,0:14:53.04,0:14:54.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius yang itu?
Dialogue: 0,0:15:05.30,0:15:07.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Kak.
Dialogue: 0,0:15:08.05,0:15:11.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menangis gara-gara aku?
Dialogue: 0,0:15:11.81,0:15:14.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, lambat laun pasti begini.
Dialogue: 0,0:15:16.19,0:15:17.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terlalu naif.
Dialogue: 0,0:15:18.73,0:15:22.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil kaiju dan pangeran menjalin...
Dialogue: 0,0:15:25.32,0:15:26.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai nanti, Daichi.
Dialogue: 0,0:15:27.87,0:15:29.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong biarkan aku sendiri.
Dialogue: 0,0:15:29.78,0:15:31.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak...
Dialogue: 0,0:15:48.47,0:15:50.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku iri.
Dialogue: 0,0:15:50.14,0:15:51.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat iri.
Dialogue: 0,0:15:53.60,0:15:56.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menyatakan cinta sepuasnya.
Dialogue: 0,0:15:56.39,0:15:58.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa takut apa pun.
Dialogue: 0,0:15:59.56,0:16:02.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku wanita paling sial sedunia.
Dialogue: 0,0:16:52.95,0:16:56.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semalam Harugon tidak ada sama sekali,
Dialogue: 0,0:16:56.08,0:16:58.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai aku cari semalaman.
Dialogue: 0,0:16:58.58,0:17:00.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti lelah.
Dialogue: 0,0:17:01.12,0:17:02.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pagi, Kurotaso!
Dialogue: 0,0:17:02.79,0:17:04.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi, Kuroe.
Dialogue: 0,0:17:04.58,0:17:06.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pagi.
Dialogue: 0,0:17:14.72,0:17:16.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kurang tidur?
Dialogue: 0,0:17:16.52,0:17:18.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:17:20.77,0:17:22.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu dan Minami putus?
Dialogue: 0,0:17:23.90,0:17:24.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:17:24.65,0:17:27.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, saking kagetnya riasanku sampai luntur.
Dialogue: 0,0:17:27.65,0:17:29.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelukannya cuma salah paham, kan?
Dialogue: 0,0:17:29.57,0:17:31.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sudah bicara baik-baik?
Dialogue: 0,0:17:31.61,0:17:33.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa.
Dialogue: 0,0:17:33.24,0:17:36.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saking sibuknya dia, aku bahkan\Ntidak tahu dia sedang apa.
Dialogue: 0,0:17:36.29,0:17:37.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:17:37.20,0:17:38.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah.
Dialogue: 0,0:17:39.16,0:17:41.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah lelah.
Dialogue: 0,0:17:41.75,0:17:42.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diingat-ingat,
Dialogue: 0,0:17:42.79,0:17:48.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lebih banyak momen sedih dan sulit\Ndaripada momen bahagia.
Dialogue: 0,0:17:49.80,0:17:53.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya percintaan berjalan lancar\Nkalau sama orang yang tepat.
Dialogue: 0,0:17:53.76,0:17:56.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tertulis di Tanya-Jawab Yahoo!
Dialogue: 0,0:17:56.14,0:17:57.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Info dari internet...
Dialogue: 0,0:17:57.76,0:18:01.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kami bukan pasangan yang tepat.
Dialogue: 0,0:18:01.98,0:18:04.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia kami jauh berbeda.
Dialogue: 0,0:18:06.48,0:18:08.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku sudah tahu.
Dialogue: 0,0:18:08.65,0:18:10.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bodoh, ya?
Dialogue: 0,0:18:12.82,0:18:14.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak.
Dialogue: 0,0:18:14.16,0:18:17.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak merasa dunia kalian berbeda!
Dialogue: 0,0:18:18.33,0:18:23.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur, kadang aku merasa\Nkamu mirip Harugon.
Dialogue: 0,0:18:23.46,0:18:24.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:18:24.33,0:18:26.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski bertubuh kecil,
Dialogue: 0,0:18:26.84,0:18:30.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu punya hati sebesar Harugon.
Dialogue: 0,0:18:31.59,0:18:34.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saking besarnya
Dialogue: 0,0:18:34.38,0:18:37.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai memancarkan\Ncahaya hangat setiap saat.
Dialogue: 0,0:18:37.43,0:18:38.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu sadar?
Dialogue: 0,0:18:40.43,0:18:44.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu itu gadis yang sangat memesona.
Dialogue: 0,0:18:44.19,0:18:46.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan merendahkan diri lagi.
Dialogue: 0,0:18:46.77,0:18:48.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi diriku juga.
Dialogue: 0,0:18:50.86,0:18:51.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu,
Dialogue: 0,0:18:51.57,0:18:53.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu juga Miko Harugon!
Dialogue: 0,0:18:53.65,0:18:58.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan seharusnya pria di seluruh dunia\Nrela bersujud demi pacaran denganmu!
Dialogue: 0,0:18:58.99,0:19:01.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar! Benar!\NAku kurang paham soal Miko, sih!
Dialogue: 0,0:19:01.66,0:19:04.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami juga tetap Minami, kan?
Dialogue: 0,0:19:04.04,0:19:06.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia wajib mendengar penjelasanmu!
Dialogue: 0,0:19:06.00,0:19:08.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau di posisimu,\Ndia sudah kulempar pisang!
Dialogue: 0,0:19:08.21,0:19:09.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kasihan banget!
Dialogue: 0,0:19:09.96,0:19:11.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu terlalu tabah!
Dialogue: 0,0:19:11.21,0:19:13.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, justru itu yang bikin aku suka!
Dialogue: 0,0:19:13.01,0:19:16.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Duh, saking panasnya riasanku luntur.\N- Rairi...
Dialogue: 0,0:19:16.47,0:19:18.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cobalah bicara sekali lagi!
Dialogue: 0,0:19:18.47,0:19:19.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kutemani kalau kamu takut!
Dialogue: 0,0:19:19.93,0:19:21.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ikut!
Dialogue: 0,0:19:23.64,0:19:26.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian benar.
Dialogue: 0,0:19:26.02,0:19:30.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mumpung sudah sepakat,\Nayo rapat strategi sambil makan manisan!
Dialogue: 0,0:19:31.61,0:19:32.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat!
Dialogue: 0,0:19:32.48,0:19:34.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pesta manisan persik, nih!
Dialogue: 0,0:19:34.65,0:19:35.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurotaso mau yang mana?
Dialogue: 0,0:19:45.58,0:19:48.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya, panekuk persiknya terjual habis.
Dialogue: 0,0:19:48.08,0:19:49.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu memang populer, sih.
Dialogue: 0,0:19:51.04,0:19:52.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuroe?
Dialogue: 0,0:19:52.21,0:19:53.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, enggak.
Dialogue: 0,0:19:53.96,0:19:55.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bimbang.
Dialogue: 0,0:19:55.34,0:19:58.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku pesan\Nsemua yang bisa dipesan!
Dialogue: 0,0:19:59.30,0:20:01.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya kebanyakan.
Dialogue: 0,0:20:01.64,0:20:06.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa bedanya Es Krim Persik Utuh\Ndan Es Krim Persik Segar?
Dialogue: 0,0:20:06.06,0:20:07.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ukurannya?
Dialogue: 0,0:20:07.02,0:20:09.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak buahnya jelas beda.
Dialogue: 0,0:20:13.98,0:20:15.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita makan banyak!
Dialogue: 0,0:20:15.44,0:20:17.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenyang banget!
Dialogue: 0,0:20:17.32,0:20:20.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Manatsu, Rairi.
Dialogue: 0,0:20:20.49,0:20:21.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi sedikit bersemangat.
Dialogue: 0,0:20:21.99,0:20:24.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita ini teman, jangan sungkan!
Dialogue: 0,0:20:24.62,0:20:26.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan menemanimu kapan saja.
Dialogue: 0,0:20:28.29,0:20:31.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu masih mencintai Minami, kan?
Dialogue: 0,0:20:31.59,0:20:32.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih.
Dialogue: 0,0:20:32.42,0:20:34.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampaikanlah perasaan itu!
Dialogue: 0,0:20:34.88,0:20:37.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian pasti baikan\Nkalau salah pahamnya beres.
Dialogue: 0,0:20:38.59,0:20:39.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:20:40.01,0:20:41.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kaiju!
Dialogue: 0,0:20:41.60,0:20:42.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harugon?
Dialogue: 0,0:20:42.14,0:20:43.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekorku enggak keluar, kan?
Dialogue: 0,0:20:43.35,0:20:44.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo lari!
Dialogue: 0,0:20:44.76,0:20:46.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cut!
Dialogue: 0,0:20:47.02,0:20:48.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:20:48.02,0:20:50.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi ada syuting, ya?
Dialogue: 0,0:20:50.02,0:20:52.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, rasa senangku sia-sia.
Dialogue: 0,0:20:55.94,0:21:00.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari seragamnya, mereka syuting\Nfilm Godora sang Raja Kaiju.
Dialogue: 0,0:21:00.45,0:21:02.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, itu Katsuragi Sena!
Dialogue: 0,0:21:02.74,0:21:03.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa?
Dialogue: 0,0:21:03.41,0:21:04.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah cerita, kan?
Dialogue: 0,0:21:04.99,0:21:06.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, lo!
Dialogue: 0,0:21:06.08,0:21:07.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku penggemarnya sejak dulu!
Dialogue: 0,0:21:07.95,0:21:10.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat! Jadi semangat, nih!
Dialogue: 0,0:21:10.37,0:21:11.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:21:14.42,0:21:15.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:21:15.55,0:21:17.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami?
Dialogue: 0,0:21:28.64,0:21:31.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ku-Kurotaso...
Dialogue: 0,0:21:37.82,0:21:39.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kurotaso!\N- Kuroe!
Dialogue: 0,0:21:41.57,0:21:44.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:21:44.49,0:21:46.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang aku yang minta putus,
Dialogue: 0,0:21:46.95,0:21:49.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi itu terlalu cepat, kan?
Dialogue: 0,0:21:49.20,0:21:51.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu benar.
Dialogue: 0,0:21:51.75,0:21:54.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya aku enggak jatuh cinta.
Dialogue: 0,0:21:55.00,0:21:57.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada harus sakit hati...
Dialogue: 0,0:21:57.67,0:22:00.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus kembali jadi diri yang dulu.
Dialogue: 0,0:22:01.17,0:22:04.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembali ke diriku yang belum tahu\Nbadai emosi ini.
Dialogue: 0,0:22:05.05,0:22:06.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu lebih baik!
Dialogue: 0,0:22:06.93,0:22:08.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia juga akan damai!
Dialogue: 0,0:22:10.10,0:22:11.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benci.
Dialogue: 0,0:22:12.52,0:22:13.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benci!
Dialogue: 0,0:22:15.02,0:22:16.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benci!
Dialogue: 0,0:22:29.33,0:22:31.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, sudah kuduga.
Dialogue: 0,0:22:34.87,0:22:37.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cinta hanyalah rasa takut.
Dialogue: 0,0:24:08.47,0:24:09.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manisan berikutnya.
Dialogue: 0,0:24:09.89,0:24:10.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Okashi Mochi!
Dialogue: 0,0:24:10.85,0:24:12.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan dorong! Jangan lari! Jangan ngobrol!
Dialogue: 0,0:24:12.35,0:24:14.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kabur!
