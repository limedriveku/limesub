Dialogue: 0,0:00:41.15,0:00:46.65,sign,,0000,0000,0000,,KAIJU DARA CARAMELISE
Dialogue: 0,0:02:01.98,0:02:05.48,sign,,0000,0000,0000,,EPISODE 12:\NDENGAN SATU SERANGAN PENUH CINTA INI
Dialogue: 0,0:09:51.99,0:09:53.36,sign,,0000,0000,0000,,BERITA TERKINI: MAKHLUK TERBANG RAKSASA
Dialogue: 0,0:09:53.36,0:09:54.95,sign,,0000,0000,0000,,KEMBALI MENUJU HARUMI
Dialogue: 0,0:10:44.83,0:10:46.04,sign,,0000,0000,0000,,MINAMI ARATA\NPAGI!
Dialogue: 0,0:10:48.13,0:10:51.01,sign,,0000,0000,0000,,AKU BARU BERANGKAT DARI RUMAH
Dialogue: 0,0:11:05.94,0:11:07.02,sign,,0000,0000,0000,,PANEKUK COKELAT, PANEKUK PERSIK
Dialogue: 0,0:00:07.11,0:00:08.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harugon!
Dialogue: 0,0:00:13.33,0:00:16.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya aku mendengar
Dialogue: 0,0:00:17.21,0:00:19.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}suara Minami.
Dialogue: 0,0:02:06.90,0:02:08.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ulangi.
Dialogue: 0,0:02:08.47,0:02:12.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warga sekitar lokasi\Nharap segera mengungsi!
Dialogue: 0,0:02:21.00,0:02:24.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makhluk terbang raksasa\Nmasih belum ditaklukkan!
Dialogue: 0,0:02:24.37,0:02:26.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kembali menuju ke Ginza!
Dialogue: 0,0:02:26.96,0:02:29.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harap segera mengungsi!
Dialogue: 0,0:02:33.01,0:02:35.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teganya kamu melukai Harugon-ku!
Dialogue: 0,0:02:35.39,0:02:37.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak bisa dimaafkan!
Dialogue: 0,0:02:37.47,0:02:39.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manaty, hentikan!
Dialogue: 0,0:02:39.81,0:02:42.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus segera ke sisi Harugon!
Dialogue: 0,0:02:42.43,0:02:45.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan, takutnya kaiju tadi kembali!
Dialogue: 0,0:02:45.23,0:02:47.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rairi, Seina, mengungsilah duluan!
Dialogue: 0,0:02:47.77,0:02:50.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turunkan aku di atas jembatan!
Dialogue: 0,0:02:50.98,0:02:51.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap.
Dialogue: 0,0:02:51.69,0:02:53.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap gundulmu!
Dialogue: 0,0:02:53.11,0:02:54.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jembatannya roboh!
Dialogue: 0,0:02:54.78,0:02:56.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, ada orang!
Dialogue: 0,0:02:57.70,0:02:58.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:02:58.74,0:02:59.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami?
Dialogue: 0,0:02:59.95,0:03:00.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:03:07.17,0:03:10.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya jangan lepaskan aku!
Dialogue: 0,0:03:10.96,0:03:14.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak akan.
Dialogue: 0,0:03:16.22,0:03:18.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong!
Dialogue: 0,0:03:18.76,0:03:20.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Minami!\N- Aku akan jatuh!
Dialogue: 0,0:03:20.93,0:03:23.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu aman?\NKayaknya enggak!
Dialogue: 0,0:03:23.93,0:03:26.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manatsu dan yang lainnya!\NSeina juga!
Dialogue: 0,0:03:26.64,0:03:30.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan menolongmu!\NBertahanlah!
Dialogue: 0,0:03:30.57,0:03:32.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia baik-baik saja.
Dialogue: 0,0:03:32.36,0:03:33.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari mananya?
Dialogue: 0,0:03:33.61,0:03:35.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harugon lebih penting!
Dialogue: 0,0:03:35.03,0:03:37.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sampai jatuh, Pemula!
Dialogue: 0,0:03:37.86,0:03:40.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak mau main\Nsama aktor pengganti!
Dialogue: 0,0:03:40.49,0:03:43.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat lakukan sesuatu!
Dialogue: 0,0:03:43.33,0:03:45.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangganya kuturunkan, nih.
Dialogue: 0,0:03:45.29,0:03:47.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan setengah hati, dong.
Dialogue: 0,0:03:51.67,0:03:54.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pegangan yang erat!\NJangan lihat ke bawah!
Dialogue: 0,0:03:54.76,0:03:56.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takut!
Dialogue: 0,0:03:56.55,0:03:58.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat, pijakannya rapuh!
Dialogue: 0,0:04:06.81,0:04:07.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa namamu?
Dialogue: 0,0:04:09.98,0:04:11.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daichi.
Dialogue: 0,0:04:11.23,0:04:12.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Arata.
Dialogue: 0,0:04:12.77,0:04:16.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daichi, kamu menyukai Akaishi?
Dialogue: 0,0:04:17.36,0:04:19.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suka! Suka banget!
Dialogue: 0,0:04:19.91,0:04:24.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang anak SD,\Ntapi enggak akan kalah darimu!
Dialogue: 0,0:04:24.58,0:04:25.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:04:27.58,0:04:29.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti kita rival!
Dialogue: 0,0:04:31.46,0:04:34.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baiklah.
Dialogue: 0,0:04:34.09,0:04:35.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian kamu menolongku.
Dialogue: 0,0:04:35.88,0:04:40.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terjadi sesuatu padaku,\Ntolong lindungi Akaishi.
Dialogue: 0,0:04:42.68,0:04:45.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kamu mau apa?
Dialogue: 0,0:04:45.35,0:04:46.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat naik!
Dialogue: 0,0:04:46.64,0:04:48.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami?
Dialogue: 0,0:04:50.06,0:04:52.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?\NNanti Kakak menangis lagi!
Dialogue: 0,0:04:52.65,0:04:57.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu enggak tahu, kan?\NKakak menangis setelah kalian bertengkar!
Dialogue: 0,0:04:57.86,0:04:59.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu pacarnya,
Dialogue: 0,0:04:59.45,0:05:01.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lindungi dia, dong!
Dialogue: 0,0:05:02.95,0:05:06.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, makanya...
Dialogue: 0,0:05:06.95,0:05:08.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pergi dulu.
Dialogue: 0,0:05:38.53,0:05:42.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami! Minami!
Dialogue: 0,0:05:43.20,0:05:47.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus bilang apa ke Kurotaso?
Dialogue: 0,0:05:47.20,0:05:50.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di situasi ini,\Nmungkin Kurotaso juga...
Dialogue: 0,0:05:51.50,0:05:53.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan khawatir.
Dialogue: 0,0:05:53.75,0:05:56.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuroe itu Miko Harugon!
Dialogue: 0,0:05:56.25,0:05:57.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harugon pasti melindunginya!
Dialogue: 0,0:05:57.59,0:05:59.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harugon sudah kalah, tahu!
Dialogue: 0,0:06:04.89,0:06:07.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan tinggalkan aku, Harugon!
Dialogue: 0,0:06:07.76,0:06:11.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia tidak berarti tanpamu!
Dialogue: 0,0:06:12.81,0:06:13.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh.
Dialogue: 0,0:06:13.98,0:06:18.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembalilah hidup-hidup, Pemula.
Dialogue: 0,0:06:20.32,0:06:21.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:06:35.88,0:06:36.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami!
Dialogue: 0,0:06:52.56,0:06:54.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harugon!
Dialogue: 0,0:07:01.57,0:07:02.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harugon!
Dialogue: 0,0:07:08.74,0:07:11.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pasti kesakitan, Harugon.
Dialogue: 0,0:07:19.96,0:07:21.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sirip punggungnya!
Dialogue: 0,0:07:21.42,0:07:24.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sirip punggung Harugon sekilas bersinar!
Dialogue: 0,0:07:25.13,0:07:26.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana?
Dialogue: 0,0:07:26.47,0:07:28.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok enggak bersinar?
Dialogue: 0,0:07:28.43,0:07:29.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar sekilas.
Dialogue: 0,0:07:29.72,0:07:31.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin!
Dialogue: 0,0:07:31.60,0:07:33.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh!
Dialogue: 0,0:07:37.06,0:07:39.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harugon masih hidup!
Dialogue: 0,0:07:39.27,0:07:42.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenanglah, Manaty!
Dialogue: 0,0:07:42.11,0:07:43.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hei, hei, hei!\N- Cup, cup, cup.
Dialogue: 0,0:07:43.40,0:07:47.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hei, hei, hei!\N- Seina, bantu aku!
Dialogue: 0,0:07:47.36,0:07:50.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, ini gawat!
Dialogue: 0,0:07:50.41,0:07:51.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:07:51.08,0:07:51.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat!
Dialogue: 0,0:07:59.08,0:08:01.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mi-Minami?
Dialogue: 0,0:08:01.71,0:08:05.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sedang apa?
Dialogue: 0,0:08:06.76,0:08:07.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berita terkini!
Dialogue: 0,0:08:07.84,0:08:12.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlihat ada manusia menaiki\Ntubuh makhluk raksasa!
Dialogue: 0,0:08:12.14,0:08:13.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamera bisa lebih dekat?
Dialogue: 0,0:08:13.89,0:08:15.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat itu, gila banget.
Dialogue: 0,0:08:15.77,0:08:17.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia? Mana?
Dialogue: 0,0:08:17.14,0:08:18.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan dia?
Dialogue: 0,0:08:18.60,0:08:23.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya itu seorang pria,\Ntapi terlalu jauh untuk dipastikan.
Dialogue: 0,0:08:23.36,0:08:26.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya apa tujuannya?
Dialogue: 0,0:08:28.99,0:08:30.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahaya!
Dialogue: 0,0:08:30.20,0:08:31.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dekatkan kameranya!
Dialogue: 0,0:08:31.78,0:08:34.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok mirip Pangeran Kaiju?
Dialogue: 0,0:08:34.12,0:08:36.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak mungkin, ah.
Dialogue: 0,0:08:54.85,0:08:57.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan ke sana.
Dialogue: 0,0:08:58.39,0:08:59.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggulah.
Dialogue: 0,0:09:01.35,0:09:04.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami, kamu mau apa?
Dialogue: 0,0:09:04.73,0:09:06.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kehilangan akal, ya?
Dialogue: 0,0:09:06.73,0:09:08.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harugon masih hidup!
Dialogue: 0,0:09:08.78,0:09:11.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku panggil dari dekat,\Nmungkin dia akan bangun!
Dialogue: 0,0:09:12.39,0:09:15.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian menjauhlah!\NTakutnya kaiju itu datang lagi!
Dialogue: 0,0:09:15.66,0:09:19.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara apa kamu?\NCepat kembali!
Dialogue: 0,0:09:21.58,0:09:25.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang mustahil bisa menyaingimu.
Dialogue: 0,0:09:30.42,0:09:32.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Berjuanglah, Minami!\N- Semangat, Kak!
Dialogue: 0,0:09:32.68,0:09:35.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hei, kok malah disemangati?\N- Semangat, Kak!
Dialogue: 0,0:09:51.99,0:09:54.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaiju itu ke sini lagi!
Dialogue: 0,0:09:54.95,0:09:58.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan dia mau\Nmenghabisi Harugon?
Dialogue: 0,0:10:00.70,0:10:02.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami!
Dialogue: 0,0:10:29.02,0:10:30.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mimpi?
Dialogue: 0,0:10:32.24,0:10:34.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:10:34.41,0:10:37.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah!
Dialogue: 0,0:10:38.28,0:10:41.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mimpinya kacau sekali.
Dialogue: 0,0:10:41.12,0:10:43.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kayak film kaiju.
Dialogue: 0,0:10:46.04,0:10:47.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami!
Dialogue: 0,0:10:51.01,0:10:52.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat!
Dialogue: 0,0:10:52.21,0:10:54.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini ada kencan dengan Minami!
Dialogue: 0,0:10:54.68,0:10:57.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku ingin siap-siap\Ndua jam sebelumnya!
Dialogue: 0,0:10:57.39,0:10:59.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuku palsuku sudah lepas!
Dialogue: 0,0:11:02.47,0:11:05.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak sabar\Nmencicipi panekuk khas Butters.
Dialogue: 0,0:11:07.02,0:11:08.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pilih yang mana, ya?
Dialogue: 0,0:11:08.86,0:11:10.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bingung, deh.
Dialogue: 0,0:11:11.32,0:11:15.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau berbagi sama Minami,\Nkami bisa coba keduanya!
Dialogue: 0,0:11:15.15,0:11:16.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua-duanya enak!
Dialogue: 0,0:11:16.86,0:11:19.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kencan itu hebat!
Dialogue: 0,0:11:21.20,0:11:22.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip.
Dialogue: 0,0:11:23.12,0:11:24.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip.
Dialogue: 0,0:11:28.88,0:11:29.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip.
Dialogue: 0,0:11:32.38,0:11:34.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mi-Minami?
Dialogue: 0,0:11:34.21,0:11:37.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Akaishi.\NAku datang terlalu cepat.
Dialogue: 0,0:11:37.93,0:11:40.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu dulu!\NAku segera keluar!
Dialogue: 0,0:11:40.47,0:11:44.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng, lipstik, saputangan,\Ndompet, ponsel, terus...
Dialogue: 0,0:11:44.77,0:11:46.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santai saja.
Dialogue: 0,0:11:47.44,0:11:51.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia akan memuji baju baruku?
Dialogue: 0,0:11:54.40,0:11:55.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf lama, Minami!
Dialogue: 0,0:12:19.51,0:12:22.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi?\NAda apa?
Dialogue: 0,0:12:23.22,0:12:27.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf, Minami.
Dialogue: 0,0:12:28.19,0:12:31.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kamu menunggu sebentar?
Dialogue: 0,0:12:32.52,0:12:34.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan segera kembali!
Dialogue: 0,0:12:35.03,0:12:36.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus ganti baju.
Dialogue: 0,0:12:36.44,0:12:39.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus!\NPokoknya harus!
Dialogue: 0,0:12:49.00,0:12:50.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sebanyak ini,
Dialogue: 0,0:12:50.33,0:12:52.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti ada baju kencan lain.
Dialogue: 0,0:13:23.03,0:13:25.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi?\NAda apa?
Dialogue: 0,0:13:26.70,0:13:28.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:13:29.25,0:13:30.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak bisa pergi.
Dialogue: 0,0:13:30.91,0:13:32.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:13:32.00,0:13:33.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf!
Dialogue: 0,0:13:43.01,0:13:44.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami?
Dialogue: 0,0:14:22.34,0:14:23.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya,
Dialogue: 0,0:14:23.72,0:14:25.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}enggak ada.
Dialogue: 0,0:14:25.97,0:14:29.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada satu pun baju imut
Dialogue: 0,0:14:29.81,0:14:32.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang bisa kupakai!
Dialogue: 0,0:14:38.61,0:14:39.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:14:45.86,0:14:47.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah memakainya.
Dialogue: 0,0:14:48.37,0:14:51.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, kembalilah.
Dialogue: 0,0:15:04.05,0:15:07.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita makan panekuk,
Dialogue: 0,0:15:08.14,0:15:09.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi.
Dialogue: 0,0:15:24.40,0:15:25.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia datang lagi!
Dialogue: 0,0:15:28.37,0:15:29.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harugon!
Dialogue: 0,0:15:29.28,0:15:31.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami, larilah!
Dialogue: 0,0:15:31.03,0:15:34.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma, enggak akan sempat!
Dialogue: 0,0:16:44.23,0:16:48.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuh Harugon beregenerasi.
Dialogue: 0,0:17:03.38,0:17:06.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya bisa kuucapkan.
Dialogue: 0,0:17:09.58,0:17:12.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya, Akaishi!
Dialogue: 0,0:17:21.52,0:17:23.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia berwarna pink.
Dialogue: 0,0:17:30.45,0:17:35.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski jadi paling tidak imut sedunia,\Nitu bukan masalah.
Dialogue: 0,0:17:44.84,0:17:49.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku bisa berteriak\Ndengan suara terkencang sedunia.
Dialogue: 0,0:17:57.85,0:17:59.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami!
Dialogue: 0,0:18:00.18,0:18:06.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat mencintaimu!
Dialogue: 0,0:18:12.86,0:18:17.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski agak malu kalau sampai\Nterdengar ke ujung dunia.
Dialogue: 0,0:18:25.54,0:18:28.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kamu hebat, Harugon!
Dialogue: 0,0:18:28.30,0:18:30.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harugon, terima kasih!
Dialogue: 0,0:18:30.21,0:18:32.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu luar biasa!
Dialogue: 0,0:18:32.26,0:18:34.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harugon! Harugon!
Dialogue: 0,0:18:34.72,0:18:36.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harugon keren!
Dialogue: 0,0:18:36.72,0:18:38.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih belum!\NDia masih bergerak!
Dialogue: 0,0:18:56.82,0:18:59.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di-Dia kabur?
Dialogue: 0,0:18:59.12,0:19:00.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabur ke mana?
Dialogue: 0,0:19:02.54,0:19:05.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kamu sebenarnya?
Dialogue: 0,0:19:07.96,0:19:10.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuro jadi bertarung, deh.
Dialogue: 0,0:19:16.09,0:19:20.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tindakanmu selanjutnya,\NKak Akaishi?
Dialogue: 0,0:19:21.22,0:19:24.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf meninggalkanmu sendirian!
Dialogue: 0,0:19:24.60,0:19:26.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjemputmu,
Dialogue: 0,0:19:27.27,0:19:28.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurotan!
Dialogue: 0,0:19:32.11,0:19:33.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harugon berjalan!
Dialogue: 0,0:19:33.99,0:19:36.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, mana Minami?
Dialogue: 0,0:19:37.41,0:19:38.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah, dia selamat!
Dialogue: 0,0:19:38.99,0:19:42.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaiju itu mau membawanya ke mana?
Dialogue: 0,0:19:42.87,0:19:47.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minami, enggak akan kubiarkan\Nkamu memonopoli Harugon!
Dialogue: 0,0:19:49.96,0:19:52.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kamu selamat.
Dialogue: 0,0:19:52.00,0:19:54.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?\NAda yang terasa sakit?
Dialogue: 0,0:19:54.71,0:19:57.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, aku bicara sama Daichi.
Dialogue: 0,0:19:57.59,0:19:59.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka dia anak SD!
Dialogue: 0,0:19:59.97,0:20:01.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku minta maaf!
Dialogue: 0,0:20:01.43,0:20:05.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mungkin salah paham,\Ntapi Seina cuma aktris!
Dialogue: 0,0:20:05.60,0:20:08.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kejadiannya tidak seperti\Nyang kamu bayangkan!
Dialogue: 0,0:20:09.56,0:20:14.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu masih bisa tersenyum?
Dialogue: 0,0:20:15.53,0:20:19.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini kaiju, lo.
Dialogue: 0,0:20:34.55,0:20:35.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi!
Dialogue: 0,0:20:37.51,0:20:38.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pergi!
Dialogue: 0,0:20:38.76,0:20:41.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ceritakan lebih banyak tentangmu!
Dialogue: 0,0:20:44.22,0:20:48.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo lebih sering bersama!
Dialogue: 0,0:20:49.44,0:20:51.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarlah tubuhmu penuh duri.
Dialogue: 0,0:20:52.19,0:20:54.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak merasa sakit, kok!
Dialogue: 0,0:20:55.11,0:20:56.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lompatlah ke pelukanku!
Dialogue: 0,0:20:56.90,0:20:59.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai pacarku yang paling keren
Dialogue: 0,0:20:59.24,0:21:02.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan paling manis sejagat raya!
Dialogue: 0,0:21:18.26,0:21:21.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak bertemu denganmu,
Dialogue: 0,0:21:22.39,0:21:24.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hidupku bagaikan mimpi.
Dialogue: 0,0:21:27.35,0:21:28.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan mimpi.
Dialogue: 0,0:23:17.79,0:23:18.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan?
Dialogue: 0,0:23:21.42,0:23:22.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:23:23.42,0:23:25.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, yah...
Dialogue: 0,0:23:25.76,0:23:29.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wujudmu sekarang bikin gagal fokus.
Dialogue: 0,0:23:32.77,0:23:34.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Tenanglah!
Dialogue: 0,0:23:37.40,0:23:39.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ga-Gawat.
Dialogue: 0,0:23:39.23,0:23:39.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:23:39.98,0:23:43.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau deg-degan, aku akan menjadi kaiju!
Dialogue: 0,0:23:43.03,0:23:45.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?\NHarus apa, dong?
Dialogue: 0,0:23:50.12,0:23:51.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akaishi.
Dialogue: 0,0:23:51.83,0:23:52.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo.
Dialogue: 0,0:23:54.95,0:23:55.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
