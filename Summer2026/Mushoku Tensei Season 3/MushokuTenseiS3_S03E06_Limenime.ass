Dialogue: 0,0:23:32.06,0:23:35.06,sign,,0000,0000,0000,,EPISODE 6: KONFLIK PANAS, LAGI?
Dialogue: 0,0:23:35.06,0:23:40.06,sign,,0000,0000,0000,,SELANJUTNYA: TINGKAT KEEMPAT
Dialogue: 0,0:00:01.98,0:00:05.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lucy sayang, ini Papa...
Dialogue: 0,0:00:05.11,0:00:06.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, tingginya...
Dialogue: 0,0:00:08.61,0:00:10.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, manis sekali.
Dialogue: 0,0:00:10.88,0:00:15.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa di dunia ini ada yang semanis Lucy\Nsaat sedang tertawa?
Dialogue: 0,0:00:15.64,0:00:20.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila di dunia ini ada malaikat,\Nsudah pasti adalah anak ini.
Dialogue: 0,0:00:20.00,0:00:21.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Rudeus.
Dialogue: 0,0:00:21.88,0:00:25.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau cuma menimang Nona Muda,\Nbiar aku saja sebagai ibu susunya.
Dialogue: 0,0:00:25.25,0:00:29.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan rebut waktu bahagiaku, Suzanne.
Dialogue: 0,0:00:29.34,0:00:32.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, tidak akan kuhentikan\Nkalau itu memang maumu.
Dialogue: 0,0:00:32.64,0:00:35.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana ada pria yang tidak mau melakukan ini?
Dialogue: 0,0:00:35.26,0:00:38.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suamiku tidak suka melakukannya.
Dialogue: 0,0:00:38.19,0:00:42.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Timothy kurang sadar\Nkalau dia seorang ayah?
Dialogue: 0,0:00:43.27,0:00:45.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan, Lucy?
Dialogue: 0,0:00:45.15,0:00:47.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu berubah.
Dialogue: 0,0:00:47.40,0:00:52.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku tetap saja kaget Suzanne\Npindah ke Sharia.
Dialogue: 0,0:00:52.17,0:00:53.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga.
Dialogue: 0,0:00:53.61,0:00:57.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka kamu menikah\Ndan sudah punya putri.
Dialogue: 0,0:00:58.53,0:01:01.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Grupnya sudah bubar, kan?
Dialogue: 0,0:01:01.08,0:01:02.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:01:02.27,0:01:05.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak lama setelah berpisah denganmu.
Dialogue: 0,0:01:05.12,0:01:09.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kemampuan selevel kami,\Nkehilangan satu orang itu sudah berat.
Dialogue: 0,0:01:12.49,0:01:14.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sara, bagaimana?
Dialogue: 0,0:01:14.64,0:01:16.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu penasaran?
Dialogue: 0,0:01:16.31,0:01:18.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, sedikit.
Dialogue: 0,0:01:18.43,0:01:21.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia masih meneruskan jadi petualang.
Dialogue: 0,0:01:22.63,0:01:25.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau bicara,\Nlebih baik segera setelah bertemu.
Dialogue: 0,0:01:25.61,0:01:28.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak tahu kapan petualang akan mati.
Dialogue: 0,0:01:30.33,0:01:34.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, tidak ada yang perlu\Nkukatakan padanya.
Dialogue: 0,0:01:35.10,0:01:36.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:01:37.73,0:01:40.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi, Tuan Rudeus.
Dialogue: 0,0:01:40.08,0:01:44.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya bawa Nyonya kemari karena beliau\Nkhawatir pada Nona Lucy.
Dialogue: 0,0:01:44.70,0:01:48.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu, hari ini Lucy sangat sehat, lo.
Dialogue: 0,0:01:52.55,0:01:56.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lucy memang sayang sama Nenek, ya.
Dialogue: 0,0:02:05.51,0:02:08.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Rudeus, mohon permisi.
Dialogue: 0,0:02:10.66,0:02:13.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cup, cup, cup, ada apa?
Dialogue: 0,0:02:13.60,0:02:15.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mengompol?
Dialogue: 0,0:02:16.68,0:02:19.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya dia lapar.
Dialogue: 0,0:02:22.63,0:02:27.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, sadar kalau Lucy lapar?
Dialogue: 0,0:02:28.17,0:02:31.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ini tanda pemulihan,\Nberarti hal yang bagus.
Dialogue: 0,0:02:41.95,0:02:45.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah mau menerima\Npermintaan hari ini.
Dialogue: 0,0:02:45.35,0:02:48.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena tidak lain dan tidak bukan\Nini permintaan Roxy.
Dialogue: 0,0:02:48.66,0:02:53.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tetap saja Roxy hebat sekali\Nsampai diminta mengawal Putri Ranoa.
Dialogue: 0,0:02:53.99,0:02:56.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, cuma kebetulan saja.
Dialogue: 0,0:02:56.63,0:03:00.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya tepat sebelum keluarga\Nbangsawan Ranoa menginjak kedewasaan,
Dialogue: 0,0:03:00.71,0:03:04.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka harus melakukan perjalanan\Nsebagai latihan.
Dialogue: 0,0:03:04.60,0:03:08.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski disebut perjalanan, hanya sekadar\Nmengunjungi kuil di dalam negeri.
Dialogue: 0,0:03:08.01,0:03:11.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, pengawalnya harus disiapkan sendiri.
Dialogue: 0,0:03:12.02,0:03:16.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada anggota grup pengawal\Nyang sakit dan harus absen, ya.
Dialogue: 0,0:03:16.39,0:03:20.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kita akan jadi pengganti untuk mereka.
Dialogue: 0,0:03:20.94,0:03:23.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar Putri Ariel juga akan ikut.
Dialogue: 0,0:03:23.92,0:03:27.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya beliau ingin menjalin hubungan\Ndengan Putri Ranoa.
Dialogue: 0,0:03:28.07,0:03:29.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat sekali.
Dialogue: 0,0:03:29.83,0:03:34.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski untuk membuat koneksi,\Nsampai ikut ke hutan bermonster juga.
Dialogue: 0,0:03:34.19,0:03:39.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sendiri, kalau bangsawan yang dikawal\Nbertambah jadi dua,
Dialogue: 0,0:03:39.57,0:03:42.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}justru terasa lebih berat dan bikin cemas.
Dialogue: 0,0:03:44.30,0:03:48.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, Rudy mau menemani\Nitu membuatku tenang.
Dialogue: 0,0:03:48.76,0:03:51.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggap saja sedang jalan-jalan santai.
Dialogue: 0,0:03:51.17,0:03:53.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengandalkanmu.
Dialogue: 0,0:03:53.13,0:03:59.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mushoku Tensei:\NJobless Reincarnation Season 3
Dialogue: 0,0:04:01.47,0:04:04.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, jangan bilang di Kerajaan Asura juga?
Dialogue: 0,0:04:04.18,0:04:07.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, ada taman di dalam kastel.
Dialogue: 0,0:04:07.77,0:04:10.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata di mana pun sama saja, ya.
Dialogue: 0,0:04:11.81,0:04:12.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menarik sekali.
Dialogue: 0,0:04:14.07,0:04:17.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kalian?\NPerkenalkan nama kalian.
Dialogue: 0,0:04:17.11,0:04:21.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal, saya Roxy Migurdia Greyrat.
Dialogue: 0,0:04:21.20,0:04:22.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya Rudeus Greyrat.
Dialogue: 0,0:04:23.28,0:04:29.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Grace, ini dua orang yang tadi\Ndisampaikan sebagai pengawal Tuan Putri.
Dialogue: 0,0:04:30.46,0:04:33.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, jadi kalian.
Dialogue: 0,0:04:33.63,0:04:35.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah dengar ceritanya.
Dialogue: 0,0:04:35.46,0:04:39.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Grace, seorang kesatria.\NTolong bantuannya untuk hari ini.
Dialogue: 0,0:04:39.68,0:04:43.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya dengar ada petualang lainnya?
Dialogue: 0,0:04:43.30,0:04:46.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka grup petualang bernama Amazones Ace.
Dialogue: 0,0:04:46.68,0:04:48.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya sebentar lagi kembali...
Dialogue: 0,0:04:48.85,0:04:50.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah, menurut saja!
Dialogue: 0,0:04:50.56,0:04:53.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut saja?!\NKau sudah lupa yang sebelumnya?!
Dialogue: 0,0:04:53.81,0:04:57.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tina dan Melanie hampir mati karena\Npara bodoh itu berbuat yang tidak perlu!
Dialogue: 0,0:04:57.74,0:04:59.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pokoknya menolak!
Dialogue: 0,0:04:59.61,0:05:02.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak punya pilihan,\Npermintaannya seperti itu.
Dialogue: 0,0:05:02.57,0:05:06.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada ketambahan orang aneh,\Nlebih mending kalau aku sendiri!
Dialogue: 0,0:05:06.33,0:05:09.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau terlalu melebihkan kemampuanku
Dialogue: 0,0:05:09.08,0:05:12.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai berani menyerahkan\Nsisi belakangku ke dirimu seorang.
Dialogue: 0,0:05:12.29,0:05:16.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga harus bisa menyesuaikan\Nmanuver dengan siapa saja, lo.
Dialogue: 0,0:05:16.67,0:05:17.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, sih, tidak masalah,
Dialogue: 0,0:05:17.96,0:05:21.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi bukan berarti akan terus\Nsatu grup dengan orang yang sama.
Dialogue: 0,0:05:28.43,0:05:29.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kamu orangnya.
Dialogue: 0,0:05:30.06,0:05:31.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa dia? Kenalanmu?
Dialogue: 0,0:05:31.56,0:05:33.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, begitulah.
Dialogue: 0,0:05:37.52,0:05:38.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sara.
Dialogue: 0,0:05:38.69,0:05:42.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mana mungkin bisa melupakannya.
Dialogue: 0,0:05:42.11,0:05:44.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu terang-terangan dan berwatak kuat.
Dialogue: 0,0:05:44.53,0:05:47.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, gadis yang otaknya lumayan encer.
Dialogue: 0,0:05:48.04,0:05:52.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah beberapa kali menjalani misi bersama,\Naku pun jadi suka padanya.
Dialogue: 0,0:05:53.33,0:05:55.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau mungkin dia yang suka padaku.
Dialogue: 0,0:05:56.25,0:06:00.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaliknya aku tidak begitu mengerti\Nperasaanku sendiri.
Dialogue: 0,0:06:00.59,0:06:05.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena hubungan kami berlalu dan\Nselesai sebelum bisa memastikannya.
Dialogue: 0,0:06:05.39,0:06:07.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, semua sudah selesai.
Dialogue: 0,0:06:07.97,0:06:11.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan bertemu lagi dengannya.
Dialogue: 0,0:06:11.68,0:06:14.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu yang kukira selama ini.
Dialogue: 0,0:06:15.56,0:06:18.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alissa, Sara, ada dua yang ke arah sana!
Dialogue: 0,0:06:19.15,0:06:22.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naungan bara agung akan selalu datang\Nbagi mereka yang membutuhkan.
Dialogue: 0,0:06:22.86,0:06:25.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Datangkanlah panasnya cahaya\Nnan gagah berani di sini.
Dialogue: 0,0:06:25.28,0:06:26.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fireball!
Dialogue: 0,0:06:30.79,0:06:33.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bara kecil kian menghanguskan\Nrahmat nan agung!
Dialogue: 0,0:06:34.33,0:06:35.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Flamethrower!
Dialogue: 0,0:06:50.39,0:06:52.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sana tidak apa-apa?
Dialogue: 0,0:06:52.77,0:06:53.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aman.
Dialogue: 0,0:07:05.20,0:07:09.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, kali ini kita menang gampang.
Dialogue: 0,0:07:09.87,0:07:13.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengajar akademi sihir yang sudah\Nmenaklukkan Labirin Teleportasi.
Dialogue: 0,0:07:13.41,0:07:15.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya gosip yang beredar memang benar.
Dialogue: 0,0:07:15.41,0:07:19.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembagian sihir serangan dan\Npenyembuhanmu sangat mengagumkan!
Dialogue: 0,0:07:19.21,0:07:23.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka ada yang bisa begitu\Ndi pertarungan sesungguhnya!
Dialogue: 0,0:07:23.01,0:07:24.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa saja bicaramu itu.
Dialogue: 0,0:07:24.55,0:07:28.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal awalnya bilang enggak mau\Nbareng bocah seperti ini.
Dialogue: 0,0:07:28.34,0:07:30.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah bicara sembarangan!
Dialogue: 0,0:07:30.51,0:07:33.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak apa-apa, sudah sering terjadi.
Dialogue: 0,0:07:33.68,0:07:38.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melihat Roxy disanjung orang sekitar\Nmemang menyenangkan hati.
Dialogue: 0,0:07:38.77,0:07:42.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia itu masterku, lo.
Dialogue: 0,0:07:46.74,0:07:50.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, sebelum rombongan putri kembali,\Nayo kita siapkan makanan!
Dialogue: 0,0:07:50.99,0:07:53.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hei, Rudeus...\N- Ah, biar aku yang menyiapkan makanan!
Dialogue: 0,0:07:53.70,0:07:55.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi aku belum berguna dalam pertarungan.
Dialogue: 0,0:07:55.91,0:07:57.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, tapi...
Dialogue: 0,0:07:57.50,0:08:00.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan saja, begini-begini\Naku jago soal memasak.
Dialogue: 0,0:08:00.92,0:08:03.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya mantan pacar, ya?
Dialogue: 0,0:08:03.46,0:08:05.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau tahu apa yang terjadi?
Dialogue: 0,0:08:05.96,0:08:08.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedikit banyak aku memang tahu.
Dialogue: 0,0:08:10.05,0:08:13.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat pulang juga ada kemungkinan\Nberpapasan dengan monster.
Dialogue: 0,0:08:13.56,0:08:16.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Bilang saja padaku kalau ada yang bisa kubantu.\N- Kalau bisa aku ingin dia fokus.
Dialogue: 0,0:08:19.06,0:08:21.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti ibadahnya berjalan lancar, ya.
Dialogue: 0,0:08:21.94,0:08:22.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:08:22.94,0:08:27.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat Putri Ariel, ziarah kemari rasanya\Nbisa selesai dengan menyenangkan.
Dialogue: 0,0:08:27.24,0:08:28.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kalau begitu.
Dialogue: 0,0:08:28.99,0:08:33.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayunda, bisa tidak mengajariku sihir\Nselama perjalanan?
Dialogue: 0,0:08:33.45,0:08:35.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak masalah.
Dialogue: 0,0:08:35.28,0:08:36.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hore!
Dialogue: 0,0:08:36.20,0:08:37.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Ayunda!
Dialogue: 0,0:08:37.90,0:08:40.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, panggilan ayunda seperti itu...
Dialogue: 0,0:08:41.33,0:08:45.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, perbedaan suasananya dengan Roxy\Nbagai langit dan bumi.
Dialogue: 0,0:08:45.17,0:08:47.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin gabung ke sana.
Dialogue: 0,0:08:47.13,0:08:50.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ingin dipanggil "Kakanda" oleh Roxy.
Dialogue: 0,0:08:50.59,0:08:53.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rudy, dia kenalanmu, kan?
Dialogue: 0,0:08:54.18,0:08:56.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya coba ajak dia mengobrol.
Dialogue: 0,0:08:56.35,0:08:59.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, aku juga paham, sih.
Dialogue: 0,0:09:00.39,0:09:04.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tenggorokanku jadi kering.
Dialogue: 0,0:09:04.36,0:09:07.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak salah di jalan tadi\Ntumbuh buah kuning, ya?
Dialogue: 0,0:09:07.57,0:09:11.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya aku sungkan karena ini egois,\Ntapi aku ingin memakan itu.
Dialogue: 0,0:09:11.70,0:09:13.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa tolong diambilkan?
Dialogue: 0,0:09:17.37,0:09:19.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, biar kuambilkan.
Dialogue: 0,0:09:20.29,0:09:23.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berjalan sendirian di hutan itu tidak baik.
Dialogue: 0,0:09:23.96,0:09:28.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rudeus, Fitz, tolong temani dia.
Dialogue: 0,0:09:28.13,0:09:32.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah beliau sedang berbaik hati\Nmemberiku kesempatan?
Dialogue: 0,0:09:32.88,0:09:34.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:09:34.05,0:09:37.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah, Rudy sendiri pasti cukup.
Dialogue: 0,0:09:37.60,0:09:40.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menemani di sisi Putri Ariel.
Dialogue: 0,0:09:40.31,0:09:41.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak apa-apa?
Dialogue: 0,0:09:41.77,0:09:43.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:09:43.31,0:09:44.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak akan lari.
Dialogue: 0,0:09:48.28,0:09:52.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, benar juga, aku sedang lari.
Dialogue: 0,0:09:55.74,0:09:58.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh kalau terus-terusan lari, kan?
Dialogue: 0,0:09:59.41,0:10:02.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rudeus, bisa minta tolong?
Dialogue: 0,0:10:04.21,0:10:05.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa.
Dialogue: 0,0:10:18.68,0:10:21.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu masih lanjut jadi petualang, ya.
Dialogue: 0,0:10:21.52,0:10:23.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya itu?
Dialogue: 0,0:10:24.69,0:10:26.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Counter Arrow sudah bubar, bukan?
Dialogue: 0,0:10:26.98,0:10:30.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suzanne dan Timothy menikah\Ndan berhenti jadi petualang, kan?
Dialogue: 0,0:10:31.11,0:10:35.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga dengar kalau Patrice kembali\Nke Kerajaan Asura untuk jadi tentara.
Dialogue: 0,0:10:40.70,0:10:42.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sara sendiri bagaimana?
Dialogue: 0,0:10:42.62,0:10:44.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku gonta-ganti masuk ke banyak grup.
Dialogue: 0,0:10:44.96,0:10:48.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kurang lebih begini terus\Nsejak jadi peringkat A.
Dialogue: 0,0:10:48.79,0:10:51.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru kali ini aku lihat grup\Nisinya wanita semua.
Dialogue: 0,0:10:52.09,0:10:55.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya banyak\Nkalau di peringkat rendah.
Dialogue: 0,0:10:55.34,0:10:59.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya setelah peringkat C ke atas\Nkemampuan lebih penting daripada jenis kelamin.
Dialogue: 0,0:10:59.26,0:11:01.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadinya bakal jarang lihat.
Dialogue: 0,0:11:01.14,0:11:02.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh...
Dialogue: 0,0:11:02.77,0:11:05.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga baru pertama kali coba masuk.
Dialogue: 0,0:11:05.39,0:11:07.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, banyak juga untungnya\Nkalau cewek semua.
Dialogue: 0,0:11:07.98,0:11:10.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kalanya jadi disukai klien juga.
Dialogue: 0,0:11:10.73,0:11:15.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengawal Tuan Putri memang cocok\Nkalau grupnya berisi wanita semua.
Dialogue: 0,0:11:16.82,0:11:18.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang jelas jadi santai.
Dialogue: 0,0:11:18.66,0:11:21.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bakal kejadian masalah\Nkarena jadi suka atau disukai.
Dialogue: 0,0:11:28.92,0:11:30.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sendiri bagaimana?
Dialogue: 0,0:11:31.09,0:11:32.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apanya?
Dialogue: 0,0:11:32.30,0:11:37.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menikah, punya anak, dan tiap hari\Nhidup rukun dengan kedua istrimu.
Dialogue: 0,0:11:37.13,0:11:38.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu yang kudengar dari Suzanne.
Dialogue: 0,0:11:38.89,0:11:40.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu, anu...
Dialogue: 0,0:11:42.22,0:11:42.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:11:42.89,0:11:45.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukannya mau kamu minta maaf!
Dialogue: 0,0:12:05.29,0:12:06.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sara.
Dialogue: 0,0:12:06.96,0:12:09.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pasti bukannya ingin aku minta maaf.
Dialogue: 0,0:12:09.75,0:12:11.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku minta maaf.
Dialogue: 0,0:12:11.75,0:12:15.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kita berpisah bukan dengan\Ncara yang mengenakkan hati.
Dialogue: 0,0:12:15.88,0:12:19.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiba-tiba bertemu begini,\Naku jadi tidak tahu harus bicara apa.
Dialogue: 0,0:12:19.93,0:12:22.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tidak baik kalau kuabaikan saja.
Dialogue: 0,0:12:23.51,0:12:24.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:12:25.27,0:12:29.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, aku bukannya ingin\Nkamu meminta maaf.
Dialogue: 0,0:12:31.02,0:12:32.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh duduk di sampingmu?
Dialogue: 0,0:12:32.81,0:12:35.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yakin? Nanti dimarahi istrimu, lo.
Dialogue: 0,0:12:35.98,0:12:39.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti akan segera kujelaskan\Nsetelah pulang mengambil buah ini.
Dialogue: 0,0:12:39.20,0:12:43.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, yang mengawal Tuan Putri tadi,\Njadi dia orangnya.
Dialogue: 0,0:12:43.99,0:12:45.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak diberi tahu Suzanne?
Dialogue: 0,0:12:45.99,0:12:48.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma bilang namanya Sylphiette.
Dialogue: 0,0:12:49.12,0:12:51.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, begitu ternyata.\NPantas saja.
Dialogue: 0,0:12:51.67,0:12:52.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Roxy.
Dialogue: 0,0:12:53.38,0:12:55.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis suku iblis berambut biru juga.
Dialogue: 0,0:12:55.30,0:12:57.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, yang itu juga?
Dialogue: 0,0:12:57.01,0:13:00.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Roxy itu, yang dulu kamu bilang\Nmaster ilmu sihirmu?
Dialogue: 0,0:13:00.97,0:13:02.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:13:09.23,0:13:14.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku, selama ini merasa\Nharus minta maaf padamu.
Dialogue: 0,0:13:14.19,0:13:17.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sara minta maaf padaku?
Dialogue: 0,0:13:17.11,0:13:20.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya. Setelah berpisah denganmu,
Dialogue: 0,0:13:20.45,0:13:24.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku baru tahu kalau itu, kamu sedang sakit.
Dialogue: 0,0:13:24.87,0:13:29.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku malah merasa kalau\Ncuma aku yang disakiti.
Dialogue: 0,0:13:29.33,0:13:31.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu menganggapmu orang jahat.
Dialogue: 0,0:13:35.75,0:13:38.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau lebih dewasa, apa mungkin\Naku akan menyadarinya, ya?
Dialogue: 0,0:13:39.13,0:13:42.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu juga tersakiti sampai ingin mati.
Dialogue: 0,0:13:44.85,0:13:46.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:13:49.89,0:13:52.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang aku baru bisa sadar, sih.
Dialogue: 0,0:13:52.73,0:13:58.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa waktu itu kemungkinan aku\Ntidak sesuka itu padamu.
Dialogue: 0,0:13:58.44,0:14:00.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa coba?
Dialogue: 0,0:14:00.40,0:14:04.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyebab sakitku adalah gadis bernama Eris.
Dialogue: 0,0:14:04.82,0:14:07.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa dicampakkan olehnya.
Dialogue: 0,0:14:07.70,0:14:11.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sara lalu menunjukkan rasa suka\Ndi saat seperti itu,
Dialogue: 0,0:14:11.04,0:14:16.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadinya aku berpikir untuk lanjut melangkah\Ndan melupakan yang sebelumnya.
Dialogue: 0,0:14:16.42,0:14:21.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, itu tidak berjalan lancar dan malah\Nberkata jahat untuk melindungi diriku sendiri.
Dialogue: 0,0:14:21.97,0:14:25.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tulus padamu.
Dialogue: 0,0:14:25.80,0:14:28.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, kamu tidak perlu minta maaf.
Dialogue: 0,0:14:29.22,0:14:31.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah berubah, ya.
Dialogue: 0,0:14:31.60,0:14:32.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:14:32.73,0:14:33.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:14:33.77,0:14:37.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dirimu yang dulu tidak akan\Nbilang seperti itu walau cuma bohong.
Dialogue: 0,0:14:37.94,0:14:41.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak pernah bicara\Ndengan nada selembut ini.
Dialogue: 0,0:14:41.44,0:14:43.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:14:43.07,0:14:47.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu tidak mendekati orang lain\Nlebih dari yang dibutuhkan.
Dialogue: 0,0:14:47.62,0:14:51.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena takut disakiti seperti itu lagi.
Dialogue: 0,0:14:51.08,0:14:53.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena tidak ingin dibenci.
Dialogue: 0,0:14:53.25,0:14:54.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sekarang...
Dialogue: 0,0:14:55.37,0:14:57.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah mendapat kepercayaan diri.
Dialogue: 0,0:14:57.67,0:14:58.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari istrimu?
Dialogue: 0,0:14:58.92,0:14:59.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:14:59.96,0:15:04.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sylphy yang sepenuh hati\Nmenyembuhkan penyakitku.
Dialogue: 0,0:15:05.13,0:15:07.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal itu pertama kali baginya.
Dialogue: 0,0:15:07.93,0:15:11.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan cuma dengan tubuhnya,\Ntapi sampai pakai obat perangsang juga.
Dialogue: 0,0:15:11.72,0:15:16.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh... Bagaimana, ya?\NItu hebat sekali.
Dialogue: 0,0:15:16.73,0:15:21.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal dia rela sampai seperti itu,\Ntapi kamu malah menikahi istri kedua?
Dialogue: 0,0:15:21.40,0:15:23.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti bakal berpikir begitu.
Dialogue: 0,0:15:23.90,0:15:26.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Roxy juga melakukan hal yang sama.
Dialogue: 0,0:15:26.86,0:15:32.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat aku kehilangan orang yang berharga\Ndan tidak peduli pada apa pun lagi,
Dialogue: 0,0:15:32.37,0:15:34.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia datang menolongku.
Dialogue: 0,0:15:34.54,0:15:35.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:15:38.79,0:15:41.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku, mungkin tidak akan bisa seperti itu.
Dialogue: 0,0:15:41.75,0:15:45.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski saat itu tahu soal penyakitmu.
Dialogue: 0,0:15:45.63,0:15:50.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin itu yang jadi alasan\Nkamu tidak bisa menyukaiku.
Dialogue: 0,0:15:53.93,0:15:55.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang benar.
Dialogue: 0,0:15:55.39,0:15:58.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik Sylphy dan Roxy, mereka suka padaku.
Dialogue: 0,0:15:58.69,0:16:02.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku menyukai mereka lebih dari itu.
Dialogue: 0,0:16:02.90,0:16:06.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang membedakan mereka dari Sara\Ndan wanita lain pastilah bagian itu.
Dialogue: 0,0:16:11.16,0:16:13.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh iya, jangan salah paham.
Dialogue: 0,0:16:13.91,0:16:16.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cintaku sudah berakhir di hari itu.
Dialogue: 0,0:16:16.45,0:16:21.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang ingin minta maaf karena\Nsudah berkata jahat tanpa tahu situasimu.
Dialogue: 0,0:16:21.79,0:16:23.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, cuma itu.
Dialogue: 0,0:16:23.34,0:16:26.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sama sekali tidak kepikiran\Nbuat kembali seperti dulu.
Dialogue: 0,0:16:27.22,0:16:31.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kamu juga jangan pasang\Nmuka sungkan melulu.
Dialogue: 0,0:16:32.89,0:16:36.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasa saja bicara padaku\Nlayaknya teman lamamu.
Dialogue: 0,0:16:40.65,0:16:42.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, baiklah.
Dialogue: 0,0:17:01.29,0:17:02.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Roxy!
Dialogue: 0,0:17:27.98,0:17:31.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri Ariel, apa kita bisa bertemu lagi?
Dialogue: 0,0:17:31.07,0:17:33.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, mari bertemu lagi suatu saat.
Dialogue: 0,0:17:33.87,0:17:38.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin diajari berbagai sihir lagi\Nsama Ayunda Roxy!
Dialogue: 0,0:17:38.41,0:17:39.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, anu...
Dialogue: 0,0:17:39.79,0:17:43.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, bagaimana kalau masuk ke grup kami saja!
Dialogue: 0,0:17:43.29,0:17:45.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya itu tawaran yang menarik,
Dialogue: 0,0:17:45.25,0:17:47.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sekarang pekerjaanku sudah mencukupi.
Dialogue: 0,0:17:47.50,0:17:48.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga punya suami.
Dialogue: 0,0:17:48.76,0:17:50.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak masalah!
Dialogue: 0,0:17:50.13,0:17:52.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau pria ditinggal dulu beberapa waktu,
Dialogue: 0,0:17:52.38,0:17:54.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bakal langsung memanjakan\Nsetelah bertemu lagi!
Dialogue: 0,0:17:54.97,0:17:57.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alissa, hentikan sampai di situ!
Dialogue: 0,0:17:57.85,0:17:59.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:18:01.68,0:18:04.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, Rudeus, saatnya berpisah.
Dialogue: 0,0:18:04.52,0:18:06.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, sehat-sehat, ya.
Dialogue: 0,0:18:06.69,0:18:08.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga.
Dialogue: 0,0:18:08.11,0:18:12.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedua istrimu kelihatan rukun,\Ntapi jangan dibanding-bandingkan, lo!
Dialogue: 0,0:18:12.53,0:18:15.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya, akan kuingat baik-baik.
Dialogue: 0,0:18:15.82,0:18:16.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus!
Dialogue: 0,0:18:18.41,0:18:19.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa.
Dialogue: 0,0:18:29.84,0:18:33.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rudy, kamu yakin berpisah begitu saja?
Dialogue: 0,0:18:33.88,0:18:35.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:18:35.55,0:18:39.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia gadis yang dulu Rudy suka, kan?
Dialogue: 0,0:18:40.52,0:18:44.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa aku bukan suka padanya.
Dialogue: 0,0:18:44.19,0:18:48.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu aku masih lugu dalam banyak hal,\Njadi cuma sedikit bimbang saja.
Dialogue: 0,0:18:48.57,0:18:51.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:18:53.53,0:18:56.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, Rudy itu suka gadis seperti apa?
Dialogue: 0,0:18:57.62,0:19:00.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku juga ingin tahu!
Dialogue: 0,0:19:02.79,0:19:04.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:19:04.75,0:19:10.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku punya perasaan istimewa\Npada gadis yang menolongku di saat genting.
Dialogue: 0,0:19:10.38,0:19:12.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu maksudnya...
Dialogue: 0,0:19:13.97,0:19:18.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rudy, itu berarti kami ini istimewa?
Dialogue: 0,0:19:18.14,0:19:21.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kalian berdua istimewa.
Dialogue: 0,0:19:22.81,0:19:27.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis yang menolongku di saat genting\Ntidaklah sebanyak itu.
Dialogue: 0,0:19:27.94,0:19:31.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, Sylphy tidak perlu merasa cemas.
Dialogue: 0,0:19:31.77,0:19:34.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan menambah istri\Nlebih dari ini.
Dialogue: 0,0:19:34.74,0:19:36.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku janji.
Dialogue: 0,0:19:36.32,0:19:37.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:19:37.28,0:19:39.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Rudy...
Dialogue: 0,0:19:39.03,0:19:44.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagiku kalau ada yang Rudy anggap istimewa,\Ndan dia juga menganggap Rudy istimewa,
Dialogue: 0,0:19:44.91,0:19:48.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau ada dua atau tiga pun tidak masalah.
Dialogue: 0,0:19:48.12,0:19:49.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istimewa?
Dialogue: 0,0:19:52.38,0:19:54.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah mencampakkanku.
Dialogue: 0,0:19:54.80,0:20:00.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dulu Ruijerd bilang\Nkalau itu pasti salah paham.
Dialogue: 0,0:20:02.60,0:20:06.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sylphy, aku tidak tahu nanti akan bagaimana.
Dialogue: 0,0:20:06.35,0:20:09.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, mungkin aku akan\Nmelanggar janjiku lagi.
Dialogue: 0,0:20:10.81,0:20:12.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak masalah.
Dialogue: 0,0:20:13.02,0:20:17.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, saat itu terjadi, dia harus\Nkamu bawa dulu bertemu kami, ya.
Dialogue: 0,0:20:17.36,0:20:21.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana bisa aku mengizinkan orang yang nantinya\Njadi istrimu malah tidak mencintai
Dialogue: 0,0:20:21.41,0:20:23.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau tidak punya rasa pada Rudy.
Dialogue: 0,0:20:23.37,0:20:24.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:20:24.87,0:20:26.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berjanjilah untuk ini.
Dialogue: 0,0:20:26.62,0:20:32.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sampai sembunyi-sembunyi\Ndan tanpa sadar punya anak...
Dialogue: 0,0:20:32.79,0:20:34.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sekalipun...
Dialogue: 0,0:20:34.09,0:20:35.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik!
Dialogue: 0,0:20:37.38,0:20:42.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, aku akan menantikan\Ngadis seperti apa yang nanti Rudy bawa.
Dialogue: 0,0:20:44.68,0:20:48.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ilmu pedang kalian sudah bukan\Ndi ranah Pedang Suci lagi.
Dialogue: 0,0:20:49.10,0:20:52.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa sudah saatnya memilih Ratu Pedang\Nsetelah Ghislaine.
Dialogue: 0,0:20:52.81,0:20:54.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sebelum itu aku ingin bertanya.
Dialogue: 0,0:20:54.65,0:20:57.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Panjang Cahaya adalah\Nteknik terkuat Aliran Dewa Pedang.
Dialogue: 0,0:20:57.94,0:21:01.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan ada tingkatan dalam menguasai esensinya.
Dialogue: 0,0:21:01.61,0:21:06.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Suci, Ratu Pedang,\NKaisar Pedang, Dewa Pedang.
Dialogue: 0,0:21:06.41,0:21:09.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutmu apa perbedaannya, Jino?
Dialogue: 0,0:21:09.58,0:21:13.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain teknik, mungkin keahlian\Npergerakan kaki atau otot.
Dialogue: 0,0:21:13.42,0:21:16.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau malah, keunggulan senjata?
Dialogue: 0,0:21:16.50,0:21:17.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senjata?!
Dialogue: 0,0:21:17.96,0:21:19.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah berapa tahun kau berlatih?
Dialogue: 0,0:21:19.76,0:21:21.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sa-Saya mohon maaf!
Dialogue: 0,0:21:21.80,0:21:24.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau masih bocah makanya belum paham, ya.
Dialogue: 0,0:21:24.35,0:21:28.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah, walau tidak paham,\Nmereka yang kuat tetaplah kuat.
Dialogue: 0,0:21:28.77,0:21:31.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, sekarang coba jawab, Nina.
Dialogue: 0,0:21:32.31,0:21:33.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah hasrat?
Dialogue: 0,0:21:34.94,0:21:37.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belakangan ini kau mulai\Nterlihat memancarkan pesona seorang gadis.
Dialogue: 0,0:21:38.28,0:21:42.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, sampai sejauh mana\Nhasratmu bisa bertahan?
Dialogue: 0,0:21:42.03,0:21:44.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertahan?
Dialogue: 0,0:21:44.03,0:21:45.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misalkan saja.
Dialogue: 0,0:21:45.45,0:21:51.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana yang kau pilih kalau disuruh memilih\Nantara menikahi Jino atau jadi Ratu Pedang?
Dialogue: 0,0:21:53.62,0:21:55.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memilih Ratu Pedang.
Dialogue: 0,0:21:56.29,0:21:59.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tetap saja masih polos, ya.
Dialogue: 0,0:21:59.21,0:22:01.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang Eris, bagaimana denganmu?
Dialogue: 0,0:22:01.88,0:22:02.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tekad.
Dialogue: 0,0:22:02.88,0:22:06.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tekad? Itu salah.
Dialogue: 0,0:22:06.39,0:22:09.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak salah.\NJawabannya tekad.
Dialogue: 0,0:22:09.18,0:22:12.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti kau tidak perlu jadi Ratu Pedang?
Dialogue: 0,0:22:12.10,0:22:14.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak peduli.
Dialogue: 0,0:22:14.06,0:22:16.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya kau ingin jadi kuat?
Dialogue: 0,0:22:16.11,0:22:18.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku ingin jadi kuat.
Dialogue: 0,0:22:18.19,0:22:21.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, julukan itu tidak penting, kan?
Dialogue: 0,0:22:22.07,0:22:24.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, Eris, Nina.
Dialogue: 0,0:22:24.86,0:22:28.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang menang dari kalian\Nakan kujadikan Ratu Pedang.
Dialogue: 0,0:22:30.87,0:22:34.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi teringat saat kau pertama kali\Ndatang ke sini.
Dialogue: 0,0:22:34.42,0:22:35.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, benar.
Dialogue: 0,0:22:35.83,0:22:37.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini aku yang akan menang.
Dialogue: 0,0:22:43.42,0:22:44.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rudeus.
Dialogue: 0,0:22:59.15,0:23:00.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau sampai kapan saling tatap?
Dialogue: 0,0:23:08.41,0:23:09.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup sampai situ!
Dialogue: 0,0:23:14.37,0:23:16.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau kesal, Nina?
Dialogue: 0,0:23:16.96,0:23:18.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:23:18.17,0:23:19.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau masih bisa tumbuh.
Dialogue: 0,0:23:20.09,0:23:21.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berusahalah lebih keras.
Dialogue: 0,0:23:22.67,0:23:24.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, Ayah.
Dialogue: 0,0:23:26.59,0:23:28.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus, Eris.
Dialogue: 0,0:23:28.93,0:23:31.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuberikan julukan Ratu Pedang padamu.
