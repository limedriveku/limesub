Dialogue: 0,0:22:02.01,0:22:05.01,sign,,0000,0000,0000,,EPISODE 7: TINGKAT KEEMPAT
Dialogue: 0,0:23:35.02,0:23:40.02,sign,,0000,0000,0000,,SELANJUTNYA: BENTENG TERBANG
Dialogue: 0,0:00:14.79,0:00:18.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perwakilan wisudawan, Liniana Dedoldia.
Dialogue: 0,0:00:18.99,0:00:22.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beserta Pursena Adoldia.
Dialogue: 0,0:00:24.09,0:00:30.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuberikan kalian ijazah kelulusan\Nserta sertifikat Kelas D dari Serikat Sihir.
Dialogue: 0,0:00:30.59,0:00:37.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♫ Bila menyusuri jalan ini
Dialogue: 0,0:00:37.68,0:00:43.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♫ Lereng dan gunung akan berlanjut
Dialogue: 0,0:00:44.86,0:00:57.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♫ Bahkan di tempat yang tak terlihat\Napa yang ada di depannya
Dialogue: 0,0:00:58.58,0:01:04.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♫ Ingin kujalani
Dialogue: 0,0:01:06.13,0:01:11.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♫ Seperti jam yang bergulir
Dialogue: 0,0:01:12.47,0:01:26.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♫ Hari-hari yang sama dan\Nterus terulang pun tak mengapa
Dialogue: 0,0:01:26.61,0:01:39.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♫ Perlahan akan muncul kuncup kecil
Dialogue: 0,0:01:40.50,0:01:51.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♫ Selama ke depannya aku hidup bersamamu
Dialogue: 0,0:01:51.26,0:01:57.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mushoku Tensei:\NJobless Reincarnation Season 3
Dialogue: 0,0:01:59.47,0:02:04.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka kalian akan menghadiri\Nupacara kelulusan Linia dan Pursena.
Dialogue: 0,0:02:04.01,0:02:08.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski banyak hal yang terjadi,\Nmereka begitu hormat pada Guru.
Dialogue: 0,0:02:08.69,0:02:13.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika begitu, saya pun tidak bisa\Nterus menyimpan rasa permusuhan.
Dialogue: 0,0:02:13.79,0:02:18.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau sejujurnya aku tidak pernah\Nberinteraksi dengan mereka yang jorok itu.
Dialogue: 0,0:02:18.29,0:02:19.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sebagai sesama siswa khusus,
Dialogue: 0,0:02:19.99,0:02:22.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka tetap kuanggap kawan\Nyang telah belajar dengan tekun.
Dialogue: 0,0:02:23.24,0:02:25.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu aku merasa harus\Nmelepas mereka dengan baik.
Dialogue: 0,0:02:27.23,0:02:33.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat aku baru masuk, hawa di antara\Npara siswa khusus terasa canggung.
Dialogue: 0,0:02:34.01,0:02:36.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berdua ternyata bisa berubah.
Dialogue: 0,0:02:40.39,0:02:42.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanahoshi, aku masuk, ya.
Dialogue: 0,0:02:42.28,0:02:43.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan.
Dialogue: 0,0:02:46.71,0:02:48.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masuk angin lagi, ya?
Dialogue: 0,0:02:49.53,0:02:51.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya begitu.
Dialogue: 0,0:02:51.03,0:02:55.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setahun ini entah kenapa\Nkondisi Nanahoshi terlihat buruk.
Dialogue: 0,0:02:55.74,0:02:58.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sering batuk kering atau demam.
Dialogue: 0,0:02:58.28,0:03:02.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kucoba menyembuhkannya\Ndengan sihir penawar racun.
Dialogue: 0,0:03:02.16,0:03:04.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tidak lama kemudian\Nkondisinya memburuk lagi.
Dialogue: 0,0:03:04.91,0:03:08.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir penawar racun tidak bisa\Nmenyembuhkan tubuh yang tidak sehat, lo.
Dialogue: 0,0:03:08.85,0:03:12.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya beristirahatlah hingga\Nmasuk anginmu sembuh sepenuhnya.
Dialogue: 0,0:03:12.52,0:03:14.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penelitiannya sedang lancar.
Dialogue: 0,0:03:14.75,0:03:16.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana bisa aku istirahat.
Dialogue: 0,0:03:16.72,0:03:20.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penelitian Nanahoshi memang berjalan lancar.
Dialogue: 0,0:03:20.10,0:03:22.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini sudah di tingkat ketiga.
Dialogue: 0,0:03:22.26,0:03:27.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mencoba untuk memanggil makhluk hidup\Nseperti tumbuhan atau hewan kecil.
Dialogue: 0,0:03:27.49,0:03:31.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar lagi, sayur dari dunia sebelumnya\Npasti akan muncul di dunia ini.
Dialogue: 0,0:03:31.77,0:03:33.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar lancar.
Dialogue: 0,0:03:33.75,0:03:36.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, ayo kita mulai eksperimen.
Dialogue: 0,0:03:37.78,0:03:38.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan!
Dialogue: 0,0:03:41.99,0:03:43.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi, meong.
Dialogue: 0,0:03:43.40,0:03:44.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izin masuk.
Dialogue: 0,0:03:44.59,0:03:46.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bos, kami mencarimu, meong.
Dialogue: 0,0:03:46.69,0:03:48.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong ikut kami sebentar.
Dialogue: 0,0:03:48.96,0:03:51.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suasana mereka hari ini sedikit berbeda.
Dialogue: 0,0:03:51.95,0:03:53.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mau berduel lagi?
Dialogue: 0,0:03:53.96,0:03:57.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Tidak boleh pulang kalau belum menang,"\Npasti mereka berpikir seperti itu.
Dialogue: 0,0:03:57.72,0:03:59.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bos, kami mohon, meong.
Dialogue: 0,0:03:59.75,0:04:01.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami mohon.
Dialogue: 0,0:04:03.16,0:04:06.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah, ini yang terakhir,\Nbiar kuladeni saja.
Dialogue: 0,0:04:06.82,0:04:08.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:04:08.52,0:04:10.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanahoshi, aku pergi dulu.
Dialogue: 0,0:04:10.35,0:04:12.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lah, aku yang duluan?!
Dialogue: 0,0:04:12.15,0:04:13.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eksperimennya bagaimana?!
Dialogue: 0,0:04:13.50,0:04:15.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian juga harus ikut, meong.
Dialogue: 0,0:04:15.07,0:04:17.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami undang sekalian secara khusus.
Dialogue: 0,0:04:17.41,0:04:20.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kami izinkan, berterimakasihlah kalian!
Dialogue: 0,0:04:20.38,0:04:24.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei... apa-apaan kalian?!\NAku sedang sibuk!
Dialogue: 0,0:04:31.42,0:04:32.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini saja.
Dialogue: 0,0:04:32.67,0:04:34.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat yang mengingatkan masa lalu.
Dialogue: 0,0:04:34.96,0:04:36.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah ini tempat
Dialogue: 0,0:04:36.63,0:04:40.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku dan Zanoba dulu menculik\NLinia dan Pursena?
Dialogue: 0,0:04:40.87,0:04:46.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat pertama kali kelahi dengan mereka,\Njadi bisa dibilang tempat kenangan.
Dialogue: 0,0:04:46.27,0:04:50.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru, apakah ini niatnya\Nmenantang ulang yang waktu itu?
Dialogue: 0,0:04:54.11,0:04:56.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin iya.
Dialogue: 0,0:05:02.81,0:05:05.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami ingin Bos dan kalian lihat.
Dialogue: 0,0:05:06.00,0:05:07.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian mau melakukan apa?
Dialogue: 0,0:05:07.41,0:05:11.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang kami akan menentukan siapa\Nyang lebih kuat antara aku dan Linia.
Dialogue: 0,0:05:11.77,0:05:13.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk keperluan apa?
Dialogue: 0,0:05:13.58,0:05:17.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemenangnya akan jadi kepala Suku Doldia.
Dialogue: 0,0:05:18.53,0:05:22.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena sejak awal suku kalian\Nterbagi dua antara Dedoldia dan Adoldia,
Dialogue: 0,0:05:22.22,0:05:25.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kenapa tidak jadi\Nkepala suku masing-masing saja?
Dialogue: 0,0:05:25.10,0:05:28.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya kami juga berpikir begitu, meong.
Dialogue: 0,0:05:28.18,0:05:32.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hingga kami menghajar habis\Npara pelamar yang sedang berahi itu.
Dialogue: 0,0:05:32.35,0:05:37.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya tidak ada pria\Nyang lebih kuat dari kami.
Dialogue: 0,0:05:37.01,0:05:40.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, yang lebih kuat\Njadi kepala suku saja,
Dialogue: 0,0:05:40.19,0:05:42.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu yang satu lagi bisa hidup bebas.
Dialogue: 0,0:05:42.49,0:05:45.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidup bukan hanya soal jadi kepala suku.
Dialogue: 0,0:05:45.19,0:05:46.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh ada dendam.
Dialogue: 0,0:05:46.75,0:05:48.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Logika macam apa itu?!
Dialogue: 0,0:05:48.72,0:05:50.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:05:50.18,0:05:53.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa membuat kalian puas,\Nlakukan saja sesuka hati.
Dialogue: 0,0:05:53.29,0:05:56.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yakin, kau mau merestui mereka berkelahi?
Dialogue: 0,0:05:56.36,0:05:59.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Palingan, tidak kulihat pun\Ntetap akan mereka lakukan.
Dialogue: 0,0:05:59.25,0:06:00.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berterima kasih, meong.
Dialogue: 0,0:06:00.97,0:06:02.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sangat membantu.
Dialogue: 0,0:06:04.07,0:06:06.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinan kekuatan mereka setara.
Dialogue: 0,0:06:07.17,0:06:11.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk menghindari situasi terburuk,\Nmaka aku harus melihat pertarungan mereka.
Dialogue: 0,0:06:12.53,0:06:16.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, bukan bermaksud mengoreksi,\Nini bukan kelahi tapi duel.
Dialogue: 0,0:06:16.65,0:06:19.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertarungan demi penentuan.
Dialogue: 0,0:06:23.15,0:06:28.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang sekarang akan dimulai adalah\Npertarungan saling bunuh antara binatang.
Dialogue: 0,0:06:28.08,0:06:31.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pursena, aku sudah lama ingin bilang ini!
Dialogue: 0,0:06:31.70,0:06:34.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya aku tidak suka denganmu!
Dialogue: 0,0:06:34.07,0:06:35.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kalimatku, bajingan!
Dialogue: 0,0:06:35.83,0:06:41.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kecil Linia hanyalah adik\Nyang selalu mengekor di belakangku,
Dialogue: 0,0:06:41.01,0:06:42.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sekarang besar kepala!
Dialogue: 0,0:06:42.51,0:06:45.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?! Yang adik itu justru dirimu!
Dialogue: 0,0:06:45.59,0:06:46.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat umur empat tahun
Dialogue: 0,0:06:46.97,0:06:50.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku menyembunyikan bekas ompolmu,\Nkau sudah lupa utang itu padaku?!
Dialogue: 0,0:06:50.68,0:06:55.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Adoldia katanya tidak akan lupa utang budi\Nhingga seratus tahun, ternyata omong kosong!
Dialogue: 0,0:06:55.57,0:06:59.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sudah impas saat aku menolongmu\Nwaktu jatuh dan hampir hanyut di sungai!
Dialogue: 0,0:06:59.98,0:07:03.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pursena yang tidak tahu utang budi\Ntidak akan bisa punya cowok!
Dialogue: 0,0:07:03.61,0:07:06.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu salah Linia karena menghajar habis\Npara pelamar!
Dialogue: 0,0:07:06.95,0:07:08.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pursena si pusar bodong!
Dialogue: 0,0:07:08.41,0:07:09.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Linia bego!
Dialogue: 0,0:07:09.70,0:07:12.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar Pursena gendut!
Dialogue: 0,0:07:14.29,0:07:16.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak gemuk!
Dialogue: 0,0:07:25.88,0:07:30.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Pursena yang menerjang seperti tank berat\Nberhasil didorong balik oleh Linia!
Dialogue: 0,0:07:30.18,0:07:33.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pursena menang kekuatan,\Ntapi kecepatan Linia menang tipis!
Dialogue: 0,0:07:33.72,0:07:36.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini pukulan kanan Pursena membabi-buta!
Dialogue: 0,0:07:36.52,0:07:38.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Linia terhuyung, Pursena terus menyerang!
Dialogue: 0,0:07:38.81,0:07:40.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Linia akan bagaimana?!
Dialogue: 0,0:07:40.25,0:07:42.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akankah lari?!\NAtau malah berdiam diri?!
Dialogue: 0,0:07:42.11,0:07:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia terdiam!
Dialogue: 0,0:07:43.78,0:07:45.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pukulan kiri kilat dari Linia!\NPukulan kilat!
Dialogue: 0,0:07:45.81,0:07:47.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan apa-apa untuk Pursena!
Dialogue: 0,0:07:47.53,0:07:50.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun Pursena maju bersamaan\Npukulan kanan Linia!
Dialogue: 0,0:07:50.49,0:07:54.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh! Baju Pursena robek di sini!
Dialogue: 0,0:07:54.37,0:07:56.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini akan jadi masalah kalau siaran langsung!
Dialogue: 0,0:07:56.42,0:07:59.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana menurutmu, Komentator Zanoba?!
Dialogue: 0,0:08:01.35,0:08:03.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini serangan jarak dekat Pursena!
Dialogue: 0,0:08:03.67,0:08:06.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pukulan Pursena sepenuhnya\Nmenghalangi langkah Linia!
Dialogue: 0,0:08:06.61,0:08:08.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagai kupu-kupu yang diputus sayapnya!
Dialogue: 0,0:08:08.32,0:08:10.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akankah dia takluk oleh raja\Nyang merayap di daratan ini?!
Dialogue: 0,0:08:10.88,0:08:13.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetapi, di sini Linia berhasil menggigit!
Dialogue: 0,0:08:13.07,0:08:15.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu menjatuhkan dan menyeretnya\Ndi atas tanah!
Dialogue: 0,0:08:15.71,0:08:18.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetapi, Pursena juga punya taring!
Dialogue: 0,0:08:18.03,0:08:20.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia balik membalas gigit!
Dialogue: 0,0:08:20.31,0:08:22.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara bertarung mereka buruk sekali.
Dialogue: 0,0:08:22.37,0:08:25.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti perkelahian anak kecil saja.
Dialogue: 0,0:08:25.12,0:08:27.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, memang bisa dibilang begitu.
Dialogue: 0,0:08:28.18,0:08:31.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, padahal mereka berdua\Nberusaha setengah mati,
Dialogue: 0,0:08:31.12,0:08:34.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kenapa kau malah bisa bercanda begitu?
Dialogue: 0,0:08:37.09,0:08:38.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:08:55.96,0:08:57.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menang.
Dialogue: 0,0:09:00.85,0:09:03.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wujud yang begitu heroik.
Dialogue: 0,0:09:03.34,0:09:05.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penampilannya begitu gagah.
Dialogue: 0,0:09:05.90,0:09:08.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wujud seseorang yang telah\Nmelewati pertarungan hidup mati.
Dialogue: 0,0:09:15.87,0:09:18.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang menang.
Dialogue: 0,0:09:18.03,0:09:20.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, selamat.
Dialogue: 0,0:09:20.21,0:09:22.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kuobati dengan sihir penyembuh.
Dialogue: 0,0:09:22.37,0:09:25.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, tapi tidak perlu.
Dialogue: 0,0:09:25.50,0:09:27.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luka ini adalah tanda kehormatan.
Dialogue: 0,0:09:27.65,0:09:32.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu apa akan bertemu\NLinia lagi, jadi ingin kubiarkan saja.
Dialogue: 0,0:09:33.13,0:09:36.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalian masih akan bersama\Nsampai keluar dari kota, kan?
Dialogue: 0,0:09:37.43,0:09:39.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami berpisah di sini.
Dialogue: 0,0:09:39.35,0:09:42.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barang-barang sudah ditata,\Njadi akan pergi hari ini.
Dialogue: 0,0:09:43.81,0:09:46.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mungkin memang sudah\Ndiputuskan seperti itu?
Dialogue: 0,0:09:46.75,0:09:50.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalan mereka akan terpisah di sini,\Njadi memilih berpisah di sini.
Dialogue: 0,0:09:52.38,0:09:54.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa keren sekali.
Dialogue: 0,0:09:55.16,0:09:59.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah pakai sihir penyembuh, deh,\Ntapi tetap diobati, ya.
Dialogue: 0,0:09:59.00,0:10:00.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:10:00.66,0:10:03.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bos, selamat tinggal.
Dialogue: 0,0:10:13.12,0:10:15.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berdua punya sisi baik juga.
Dialogue: 0,0:10:17.10,0:10:18.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang...
Dialogue: 0,0:10:22.55,0:10:23.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau masih hidup?
Dialogue: 0,0:10:25.20,0:10:27.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih hidup, meong.
Dialogue: 0,0:10:27.01,0:10:29.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kecantikanmu jadi sia-sia.
Dialogue: 0,0:10:29.07,0:10:30.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, meong.
Dialogue: 0,0:10:32.89,0:10:34.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, meong.
Dialogue: 0,0:10:37.54,0:10:39.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kalah, meong.
Dialogue: 0,0:10:39.34,0:10:40.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertandingan yang hebat, kok.
Dialogue: 0,0:10:40.99,0:10:43.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omongan Bos kedengaran semua.
Dialogue: 0,0:10:43.74,0:10:46.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asyik sekali kelihatannya.
Dialogue: 0,0:10:46.68,0:10:50.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, sepertinya aku sedikit\Ngagal baca suasana.
Dialogue: 0,0:10:50.41,0:10:53.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, memang pertandingan hebat\Nyang meningkatkan gairah.
Dialogue: 0,0:10:53.34,0:10:56.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, syukurlah kalau bisa menghibur\Ndi saat-saat terakhir.
Dialogue: 0,0:10:56.97,0:10:59.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dilihat orang luar,\Nini cuma perkelahian biasa.
Dialogue: 0,0:10:59.83,0:11:01.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang senang, dialah yang menang.
Dialogue: 0,0:11:01.88,0:11:04.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga tidak butuh sihir penyembuh?
Dialogue: 0,0:11:04.63,0:11:07.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya aku ingin menghapus\Nluka kekalahan ini.
Dialogue: 0,0:11:07.57,0:11:10.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kali ini biar kuterima lapang dada.
Dialogue: 0,0:11:10.61,0:11:15.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang begini bisa jadi kebanggaan\Nseiring berjalannya waktu.
Dialogue: 0,0:11:15.00,0:11:17.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luka kehormatan, ya.
Dialogue: 0,0:11:17.15,0:11:19.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mengerti pertarungan\Npara suku binatang.
Dialogue: 0,0:11:19.55,0:11:22.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, mataku benar-benar terpaku.
Dialogue: 0,0:11:22.24,0:11:25.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai dipuji dirimu segala.
Dialogue: 0,0:11:25.07,0:11:28.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beda jauh dari saat diculik di sini.
Dialogue: 0,0:11:28.63,0:11:31.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku minta maaf untuk patung itu.
Dialogue: 0,0:11:31.51,0:11:34.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru sudah mengampuni perihal itu.
Dialogue: 0,0:11:34.77,0:11:38.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diriku sudah tidak punya\Nrasa permusuhan pada Linia.
Dialogue: 0,0:11:44.45,0:11:47.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencanamu ke depannya bagaimana?
Dialogue: 0,0:11:47.48,0:11:51.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah melakukan perjalanan sebentar,\Naku ingin mulai berbisnis, meong.
Dialogue: 0,0:11:51.41,0:11:54.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisnis, ya?\NPerasaanku sangat tidak enak.
Dialogue: 0,0:11:55.06,0:11:57.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu punya rencana yang mendetail?
Dialogue: 0,0:11:57.65,0:11:59.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:11:59.41,0:12:02.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sudah punya bayangan,\Nrasanya tidak masalah.
Dialogue: 0,0:12:02.76,0:12:05.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, rasanya akan jadi masalah.
Dialogue: 0,0:12:05.67,0:12:11.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya dia akan melakukan segala sesuatu\Ndengan pikiran dangkal dan membuat masalah.
Dialogue: 0,0:12:11.17,0:12:14.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencanaku, jadi kaya raya\Ndalam lima tahun, meong.
Dialogue: 0,0:12:15.33,0:12:20.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah, kalau misal ada masalah,\Nkau boleh minta bantuanku.
Dialogue: 0,0:12:20.13,0:12:22.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diriku juga akan ikut bantu.
Dialogue: 0,0:12:23.11,0:12:26.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku sukses, akan kuberi pinjaman uang!
Dialogue: 0,0:12:29.87,0:12:33.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah mereka berencana untuk\Ntidak pernah bertemu lagi?
Dialogue: 0,0:12:33.49,0:12:35.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal sudah sedekat itu.
Dialogue: 0,0:12:37.40,0:12:39.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, jalan hidup seperti itu,
Dialogue: 0,0:12:39.48,0:12:43.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada diriku yang menganggap itu\Nsedikit keren.
Dialogue: 0,0:12:45.57,0:12:49.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beberapa hari kemudian ada yang melihat\Ndua gadis suku binatang
Dialogue: 0,0:12:49.00,0:12:52.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan badan penuh perban,\Nbertengkar di dalam kereta kuda.
Dialogue: 0,0:12:52.09,0:12:54.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada gosip seperti itu yang kudengar.
Dialogue: 0,0:12:55.19,0:12:56.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinan.
Dialogue: 0,0:12:56.17,0:13:00.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sama-sama gagal menebak kapan\Nakan berangkat dan malah bertemu.
Dialogue: 0,0:13:00.07,0:13:02.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh tidak ada habisnya.
Dialogue: 0,0:13:10.26,0:13:12.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, tolong kau mulai.
Dialogue: 0,0:13:13.98,0:13:15.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan mulai kualiri daya sihir.
Dialogue: 0,0:13:18.60,0:13:21.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata memang memakan\Ndaya sihir yang besar.
Dialogue: 0,0:13:21.55,0:13:24.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin tidak ada yang bisa\Nmenggunakannya selain diriku.
Dialogue: 0,0:13:25.17,0:13:26.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lumayan makan waktu.
Dialogue: 0,0:13:26.80,0:13:28.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin sebaiknya dibenahi...
Dialogue: 0,0:13:34.99,0:13:37.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah lihat\Npendaran cahaya seperti ini!
Dialogue: 0,0:13:37.83,0:13:41.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tepat sebelum bencana teleportasi,\Njuga muncul cahaya seperti ini!
Dialogue: 0,0:13:42.54,0:13:44.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini?\NApa harus kuhentikan?!
Dialogue: 0,0:13:44.68,0:13:46.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terjadi teleportasi lagi,\Nnanti mereka...
Dialogue: 0,0:13:47.97,0:13:49.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:13:49.14,0:13:52.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penelitian selama ini dilakukan\Nagar tidak jadi seperti itu lagi!
Dialogue: 0,0:13:53.61,0:13:56.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa, tenang saja!\NPasti bisa!
Dialogue: 0,0:14:11.99,0:14:13.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sukses!
Dialogue: 0,0:14:14.21,0:14:16.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hore!
Dialogue: 0,0:14:16.59,0:14:18.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat, Guru!
Dialogue: 0,0:14:18.83,0:14:19.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini berhasil!
Dialogue: 0,0:14:19.92,0:14:22.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, coraknya sangat mengerikan.
Dialogue: 0,0:14:22.71,0:14:24.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aman kalau kupegang?
Dialogue: 0,0:14:24.61,0:14:28.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, tapi jangan sampai jatuh.\NKarena aslinya mudah pecah.
Dialogue: 0,0:14:28.93,0:14:33.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Nanahoshi, semangka itu\Ndari dunia sana, kan?
Dialogue: 0,0:14:33.43,0:14:35.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena tidak ada di dunia sini.
Dialogue: 0,0:14:35.44,0:14:36.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinan iya.
Dialogue: 0,0:14:36.67,0:14:40.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, kita masih belum bisa\Nmemilih target secara mendetail.
Dialogue: 0,0:14:40.62,0:14:43.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini saja niatku ingin memanggil kubis.
Dialogue: 0,0:14:44.11,0:14:47.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dunia ini juga ada sayuran\Nyang mirip dengan kubis.
Dialogue: 0,0:14:47.61,0:14:51.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetapi, apa bisa dibedakan\Ndengan kubis dari dunia sana?
Dialogue: 0,0:14:51.84,0:14:57.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah rencana memanggil sayuran\Nsejak awal sudah ada cacatnya?
Dialogue: 0,0:14:57.58,0:15:00.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti akan kuhidangkan untuk kalian,\Ntunggu saja, ya.
Dialogue: 0,0:15:00.98,0:15:02.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, tidak apa-apa.
Dialogue: 0,0:15:02.83,0:15:05.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau yang muncul semangka\Npadahal ingin memanggil sayur,
Dialogue: 0,0:15:05.99,0:15:08.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}masih bisa dibilang kalau ini berhasil.
Dialogue: 0,0:15:08.22,0:15:11.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ini memang berhasil,\Nmari nanti malam kita rayakan.
Dialogue: 0,0:15:11.89,0:15:13.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, benar juga.
Dialogue: 0,0:15:13.99,0:15:15.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Bersulang!\N- Bersulang!
Dialogue: 0,0:15:16.45,0:15:18.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat merayakan sesuatu untuk seseorang.
Dialogue: 0,0:15:18.59,0:15:22.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengadakan pesta tanpa sadar\Nsudah jadi kebiasaan.
Dialogue: 0,0:15:22.49,0:15:25.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetapi, Linia dan Pursena sudah tidak ada.
Dialogue: 0,0:15:25.63,0:15:28.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai gantinya, Roxy dan Norn\Nyang ikut serta.
Dialogue: 0,0:15:28.95,0:15:32.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Badigadi juga tidak ada,\Nperan tim hore jadi hilang.
Dialogue: 0,0:15:32.89,0:15:36.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, suasana yang mengalir di sini\Nkurasa tetap tidak berubah.
Dialogue: 0,0:15:36.25,0:15:40.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, tumben sekali\NNanahoshi seceria itu.
Dialogue: 0,0:15:40.17,0:15:42.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, silakan, Rudy.
Dialogue: 0,0:15:42.31,0:15:45.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.\NSylphy tidak mau minum?
Dialogue: 0,0:15:45.38,0:15:48.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau minum miras, aku nanti jadi aneh.
Dialogue: 0,0:15:48.82,0:15:50.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, ingin sedikit kukurangi.
Dialogue: 0,0:15:50.90,0:15:52.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oalah.
Dialogue: 0,0:15:52.24,0:15:54.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini tidak menginap, lo.
Dialogue: 0,0:15:54.33,0:15:57.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus bilang selamat tidur ke Lucy, lo!
Dialogue: 0,0:15:57.42,0:15:58.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu.
Dialogue: 0,0:15:58.65,0:16:02.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal saat mabuk, Sylphy manis bukan main.
Dialogue: 0,0:16:02.02,0:16:06.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rudy, tolong sedikit mundurkan kursinya.
Dialogue: 0,0:16:09.06,0:16:11.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Roxy, kamu sudah mabuk?
Dialogue: 0,0:16:11.07,0:16:12.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedikit.
Dialogue: 0,0:16:12.26,0:16:14.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku nanti juga mau begitu, dong.
Dialogue: 0,0:16:14.68,0:16:16.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas boleh.
Dialogue: 0,0:16:16.41,0:16:21.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau perlu, Roxy di paha kiriku\Ndan Sylphy di paha kananku juga boleh.
Dialogue: 0,0:16:21.48,0:16:22.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak.
Dialogue: 0,0:16:24.77,0:16:27.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Norn.\NBikin kamu tidak enak, ya.
Dialogue: 0,0:16:27.63,0:16:29.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tidak, tidak apa-apa.
Dialogue: 0,0:16:29.65,0:16:34.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, ada sesuatu yang ingin kubicarakan,\Napakah boleh?
Dialogue: 0,0:16:34.34,0:16:35.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh, apa memangnya?
Dialogue: 0,0:16:35.89,0:16:40.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, ini soal OSIS.
Dialogue: 0,0:16:40.70,0:16:42.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal itu, ya.
Dialogue: 0,0:16:42.21,0:16:47.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak salah, saat upacara kelulusan,\NNorn bersama para anggota OSIS.
Dialogue: 0,0:16:47.41,0:16:50.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku diundang masuk oleh Kak Ariel.
Dialogue: 0,0:16:50.74,0:16:53.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Prestasiku jelas tidak bisa disebut bagus,
Dialogue: 0,0:16:53.99,0:16:58.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku punya daya tarik,\Njadi ditawari masuk OSIS.
Dialogue: 0,0:16:58.62,0:16:59.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:16:59.97,0:17:03.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, kudengar Norn punya\Nbanyak penggemar di sekolah.
Dialogue: 0,0:17:03.75,0:17:05.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sylphy sudah tahu?
Dialogue: 0,0:17:05.78,0:17:07.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurang lebih iya.
Dialogue: 0,0:17:07.51,0:17:09.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dia sudah tahu.
Dialogue: 0,0:17:09.41,0:17:11.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang Roxy juga?
Dialogue: 0,0:17:13.11,0:17:16.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang tidak tahu cuma aku,\Nkenapa bisa begini?
Dialogue: 0,0:17:16.57,0:17:20.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya, aku ingin kamu\Ndengar dari Norn sendiri.
Dialogue: 0,0:17:20.58,0:17:21.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:17:22.30,0:17:27.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, Kak, apa aku boleh\Nsecara resmi masuk ke OSIS?
Dialogue: 0,0:17:27.34,0:17:28.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu sa...
Dialogue: 0,0:17:28.63,0:17:33.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, saat ini Norn ada latihan pedang\Ndan penulisan buku.
Dialogue: 0,0:17:33.19,0:17:37.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ketambahan tugas OSIS,\Napa dia mampu melakukannya?
Dialogue: 0,0:17:37.80,0:17:38.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Norn.
Dialogue: 0,0:17:38.86,0:17:39.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya?
Dialogue: 0,0:17:39.69,0:17:42.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukannya menentang kamu masuk OSIS.
Dialogue: 0,0:17:42.98,0:17:45.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, apa kamu sanggup\Nmengurus sebanyak itu?
Dialogue: 0,0:17:45.71,0:17:49.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belajarmu sendiri pasti akan\Nmakin sulit di tahun ketiga.
Dialogue: 0,0:17:49.52,0:17:53.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan berusaha untuk menulis buku,\Nlatihan pedang, dan belajar.
Dialogue: 0,0:17:54.17,0:17:57.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bilang di mulut memang mudah, tapi...
Dialogue: 0,0:17:58.92,0:18:00.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rudy.
Dialogue: 0,0:18:01.17,0:18:04.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dik Norn untuk saat ini sudah\Nmelakukan itu semua dengan baik, kok.
Dialogue: 0,0:18:04.61,0:18:08.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pekerjaannya membantu OSIS\Njuga sudah lebih dari setahun lalu.
Dialogue: 0,0:18:08.43,0:18:13.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, berarti sudah dia lakukan\Njauh sebelum kuajari ilmu pedang?
Dialogue: 0,0:18:14.41,0:18:17.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja, Rudy.\NBiar aku yang jamin.
Dialogue: 0,0:18:18.61,0:18:21.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi begitu, bukannya bisa atau tidak.
Dialogue: 0,0:18:21.70,0:18:23.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, berani bilang karena sudah bisa.
Dialogue: 0,0:18:23.54,0:18:26.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku tidak bisa menentangnya.
Dialogue: 0,0:18:26.75,0:18:28.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi Norn sudah berusaha keras, ya.
Dialogue: 0,0:18:29.30,0:18:33.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau sejak awal kurasa aku tidak perlu\Nmemberi izin, tapi akan kuizinkan.
Dialogue: 0,0:18:34.71,0:18:36.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:18:37.77,0:18:39.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perhatian!
Dialogue: 0,0:18:39.72,0:18:41.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita belah semangkanya!
Dialogue: 0,0:18:41.81,0:18:45.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya tergantung usaha orangnya.
Dialogue: 0,0:18:45.61,0:18:49.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanahoshi sendiri bisa membuahkan hasil\Nkarena sudah berusaha keras.
Dialogue: 0,0:18:49.83,0:18:51.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Linia dan Pursena juga begitu.
Dialogue: 0,0:18:52.25,0:18:56.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tugas orang sekitarlah yang\Nharus menyemangati usaha itu.
Dialogue: 0,0:18:57.05,0:19:01.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sendiri bisa seperti sekarang\Nkarena disemangati orang sekitar.
Dialogue: 0,0:19:01.91,0:19:05.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu aku juga harus memberi\Nmereka semangat sebanyak apa pun itu.
Dialogue: 0,0:19:10.49,0:19:12.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas kerjanya.
Dialogue: 0,0:19:12.92,0:19:14.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak apa-apa?
Dialogue: 0,0:19:15.21,0:19:17.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlu kurapalkan penawar racun?
Dialogue: 0,0:19:17.50,0:19:20.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi aku sudah minta dirapalkan Sylphy,\Njadi sementara ini tidak apa-apa.
Dialogue: 0,0:19:21.31,0:19:23.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang jelas kali ini aku juga terbantu.
Dialogue: 0,0:19:23.87,0:19:26.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya bisa lanjut ke tahap berikutnya.
Dialogue: 0,0:19:26.68,0:19:31.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak salah, tingkat keempat adalah\Nmenentukan detail benda yang dipanggil, ya.
Dialogue: 0,0:19:31.23,0:19:32.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:19:32.21,0:19:35.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada orang yang tahu detail soal itu,\Njadi aku berniat tanya padanya.
Dialogue: 0,0:19:35.61,0:19:39.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ahli jurus pemanggilan yang\Ndulu sempat dibahas itu, ya?
Dialogue: 0,0:19:40.95,0:19:44.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu, bukan Orsted, kan?!
Dialogue: 0,0:19:44.09,0:19:45.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, kok.
Dialogue: 0,0:19:46.96,0:19:49.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk itu ada sedikit usulan.
Dialogue: 0,0:19:49.87,0:19:52.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eksperimen sebelumnya belum kubalas, kan?
Dialogue: 0,0:19:52.46,0:19:56.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh iya, masih disimpan dulu\Nkarena terlalu sibuk.
Dialogue: 0,0:19:56.17,0:19:57.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekalian untuk jatah kali ini,
Dialogue: 0,0:19:57.82,0:20:02.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagaimana kalau aku akan mengenalkanmu\Npada penyihir itu?
Dialogue: 0,0:20:02.10,0:20:03.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dikenalkan padaku, ya.
Dialogue: 0,0:20:03.89,0:20:07.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, apa orangnya sehebat itu\Nsampai setara jatah dua kali eksperimen?
Dialogue: 0,0:20:07.85,0:20:09.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:20:09.02,0:20:15.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin saja beliau bisa memberi solusi\Npada ibumu yang hilang ingatan.
Dialogue: 0,0:20:15.58,0:20:17.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:20:17.52,0:20:20.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah itu?!
Dialogue: 0,0:20:20.47,0:20:21.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak tahu.
Dialogue: 0,0:20:21.95,0:20:25.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kemungkinan besar dia tahu sesuatu\Nkarena sudah hidup lama.
Dialogue: 0,0:20:27.19,0:20:30.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku Zenith sudah perlahan pulih\Ndengan lancar.
Dialogue: 0,0:20:30.46,0:20:34.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, masih sulit ditebak apakah\Ningatannya akan kembali atau tidak.
Dialogue: 0,0:20:34.46,0:20:39.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tidak akan sembuh, kalau bisa tahu\Nnama penyakit atau kasus yang serupa.
Dialogue: 0,0:20:39.22,0:20:41.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin keadaan akan sedikit membaik.
Dialogue: 0,0:20:42.19,0:20:46.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada alasannya baru kau beri tahu sekarang\Ndan tidak segera diperkenalkan padaku, ya.
Dialogue: 0,0:20:46.90,0:20:50.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, maaf saja, tapi aku juga\Npunya urusan sendiri.
Dialogue: 0,0:20:50.80,0:20:53.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang membahas guru Nona Nanahoshi, ya?
Dialogue: 0,0:20:53.86,0:20:58.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau kau perkenalkan,\Naku juga ingin bisa dipertemukan.
Dialogue: 0,0:20:58.24,0:21:02.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, kalian memang juga ikut membantu,\Njadi sebenarnya tidak masalah.
Dialogue: 0,0:21:02.65,0:21:05.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku juga sedikit tertarik.
Dialogue: 0,0:21:06.25,0:21:09.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tidak mengganggu kalau\Ndidatangi banyak orang?
Dialogue: 0,0:21:09.39,0:21:10.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja itu.
Dialogue: 0,0:21:10.99,0:21:13.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya tidak masalah sampai 12 orang.
Dialogue: 0,0:21:13.97,0:21:16.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau ingin bertemu,\Npasti butuh waktu, kan?
Dialogue: 0,0:21:16.83,0:21:19.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ingin ketemu,\Nsehari juga bakal sampai, kok.
Dialogue: 0,0:21:19.22,0:21:21.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, jadi di sekitar sini.
Dialogue: 0,0:21:21.49,0:21:24.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mungkin kadang aku juga ketemu?
Dialogue: 0,0:21:24.03,0:21:26.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan di dekat sini,\Ndan kau juga belum bertemu dia,
Dialogue: 0,0:21:26.55,0:21:28.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ada caranya untuk bertemu.
Dialogue: 0,0:21:28.55,0:21:30.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke?
Dialogue: 0,0:21:30.41,0:21:33.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, siapa namanya?
Dialogue: 0,0:21:38.23,0:21:41.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan disebar ke mana-mana, ya.
Dialogue: 0,0:21:45.36,0:21:47.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raja Naga Zirah, Perugius.
Dialogue: 0,0:21:49.69,0:21:51.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raja Naga Zirah, Perugius.
Dialogue: 0,0:21:52.15,0:21:58.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu salah satu nama dari Tiga Pahlawan\NPembunuh Dewa Iblis yang membawa kemenangan
Dialogue: 0,0:21:58.36,0:22:01.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagi suku manusia\Ndalam Perang Laplace 400 tahun lalu.
