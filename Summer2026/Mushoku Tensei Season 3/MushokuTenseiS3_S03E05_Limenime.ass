Dialogue: 0,0:23:34.98,0:23:39.98,5-normal,,0,0,0,,{\pos(960,338)\fs65\bord0\c&H000A49&\b0}Selanjutnya
Dialogue: 0,0:23:34.31,0:23:39.98,5-normal,,0,0,0,,{\pos(960,652)\fs100\b1\bord0\c&H000A49&\fad(1500,0)}Konflik Panas, Lagi?
Dialogue: 0,0:00:10.06,0:00:12.83,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kak Cliff, ini Rudeus.
Dialogue: 0,0:00:13.55,0:00:16.52,Default,,0,0,0,,{\blur3}{\fad(00,40)}Silakan masuk, tidak dikunci.
Dialogue: 0,0:00:24.99,0:00:26.44,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sendirian saja?
Dialogue: 0,0:00:26.44,0:00:27.66,Default,,0,0,0,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:00:27.66,0:00:30.68,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hari ini Cliff juga harus\Nmenyiapkan upacara pernikahan.
Dialogue: 0,0:00:31.20,0:00:34.12,Default,,0,0,0,,{\blur3}{\fad(00,40)}Saat kami pergi ke Benua Begaritt,
Dialogue: 0,0:00:34.12,0:00:37.14,Default,,0,0,0,,{\blur3}{\fad(00,40)}Cliff melamar Elinalise.
Dialogue: 0,0:00:37.14,0:00:38.14,Default,,0,0,0,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:00:38.14,0:00:40.27,Default,,0,0,0,,{\blur3}{\fad(00,40)}Mereka berdua akan menikah.
Dialogue: 0,0:00:40.78,0:00:43.57,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bagaimanapun juga, selamat.
Dialogue: 0,0:00:45.16,0:00:47.33,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa ada yang membuatmu tidak puas?
Dialogue: 0,0:00:47.33,0:00:50.01,Default,,0,0,0,,{\blur3}{\fad(00,40)}Belakangan ini, Cliff terlalu sibuk,
Dialogue: 0,0:00:50.01,0:00:53.03,Default,,0,0,0,,{\blur3}{\fad(00,40)}jadi kami hanya melakukan itu\Ntiga hari sekali.
Dialogue: 0,0:00:53.32,0:00:55.16,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau sarang cinta kalian sudah jadi,
Dialogue: 0,0:00:55.16,0:00:57.39,Default,,0,0,0,,{\blur3}{\fad(00,40)}seminggu sekali juga\Nenggak akan keluar rumah.
Dialogue: 0,0:00:58.34,0:01:00.77,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kamu bikin iri saja, Rudeus.
Dialogue: 0,0:01:00.77,0:01:04.16,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kamu pasti melakukannya berdua sama\NSylphy dan Roxy sekaligus, kan?
Dialogue: 0,0:01:04.16,0:01:07.67,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak, tidak, tidak,\Nkami tidak melakukannya bertiga.
Dialogue: 0,0:01:07.67,0:01:10.37,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lo? Kalian tidak begitu rupanya.
Dialogue: 0,0:01:10.37,0:01:13.83,Default,,0,0,0,,{\blur3}{\fad(00,40)}Melakukannya dengan banyak orang itu\Nlumayan mengasyikkan, lo.
Dialogue: 0,0:01:13.83,0:01:16.01,Default,,0,0,0,,{\blur3}{\fad(00,40)}Coba saja minimal sekali.
Dialogue: 0,0:01:17.55,0:01:20.54,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jangan! Ini bisikan setan!
Dialogue: 0,0:01:20.54,0:01:24.90,Default,,0,0,0,,{\blur3}{\fad(00,40)}Coba saja usulkan itu,\Nhubungan dengan mereka pasti akan rusak!
Dialogue: 0,0:01:25.36,0:01:26.91,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jangan dengarkan dia, Rudeus!
Dialogue: 0,0:01:26.91,0:01:28.33,Default,,0,0,0,,{\blur3}{\fad(00,40)}Enyahlah, Mara!
Dialogue: 0,0:01:28.33,0:01:29.53,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau mau,
Dialogue: 0,0:01:29.83,0:01:33.95,Default,,0,0,0,,{\blur3}{\fad(00,40)}aku bisa membantu memberi pancingan\Nke mereka berdua.
Dialogue: 0,0:01:33.95,0:01:36.45,Default,,0,0,0,,{\blur3}{\fad(00,40)}Mohon bantuannya, Kanjeng Ratu Elinalise!
Dialogue: 0,0:01:36.45,0:01:41.72,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ah, tapi ini tidak ada untungnya\Nsama sekali buatku, kan?
Dialogue: 0,0:01:43.19,0:01:47.62,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa yang harus kulakukan?
Dialogue: 0,0:01:47.62,0:01:52.30,Default,,0,0,0,,{\blur3}{\fad(00,40)}Seingatku, Kerajaan Asura\Npunya obat perangsang rahasia.
Dialogue: 0,0:01:52.30,0:01:55.39,Default,,0,0,0,,{\blur3}{\fad(00,40)}Memangnya Elinalise butuh?
Dialogue: 0,0:01:55.39,0:01:57.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}Setidaknya aku ingin diserang Cliff
Dialogue: 0,0:01:57.04,0:02:00.37,Default,,0,0,0,,{\blur3}{\fad(00,40)}yang jadi binatang buas\Ndi hari pertama pernikahan.
Dialogue: 0,0:02:01.90,0:02:05.35,Default,,0,0,0,,{\blur3}{\fad(00,40)}Baiklah, akan kuusahakan mendapatkan itu.
Dialogue: 0,0:02:06.47,0:02:10.75,Default,,0,0,0,,{\blur3}{\fad(00,40)}Membayangkan Cliff tidak bisa\Nmenahan dirinya karena obat perangsang...
Dialogue: 0,0:02:23.31,0:02:26.42,Default,,0,0,0,,{\blur3}{\fad(00,40)}Cliff Grimoire, sebagai suami,
Dialogue: 0,0:02:26.42,0:02:31.36,Default,,0,0,0,,{\blur3}{\fad(00,40)}apakah bersumpah hanya mencintai\NElinalise Dragonroad seumur hidupmu?
Dialogue: 0,0:02:31.36,0:02:34.63,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku bersumpah mencintai Elinalise\Nhingga ajal menjemput.
Dialogue: 0,0:02:34.89,0:02:38.11,Default,,0,0,0,,{\blur3}{\fad(00,40)}Elinalise Dragonroad, sebagai istri,
Dialogue: 0,0:02:38.11,0:02:42.51,Default,,0,0,0,,{\blur3}{\fad(00,40)}apakah bersumpah hanya mencintai\NCliff Grimoire seumur hidupmu?
Dialogue: 0,0:02:42.51,0:02:46.47,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku bersumpah mencintai Cliff seumur hidupku.
Dialogue: 0,0:02:48.77,0:02:53.32,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sekarang, suami silakan mengalungkan\Nkalung Milis ke sang istri.
Dialogue: 0,0:02:54.65,0:02:56.76,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lize, tolong menunduk sedikit lagi.
Dialogue: 0,0:02:56.76,0:02:58.69,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ah, maaf.
Dialogue: 0,0:03:02.27,0:03:05.64,Default,,0,0,0,,{\blur3}{\fad(00,40)}Istri silakan beri sang suami kecupan janji.
Dialogue: 0,0:03:05.64,0:03:06.44,Default,,0,0,0,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:03:18.68,0:03:19.85,Default,,0,0,0,,{\blur3}{\fad(00,40)}Wahai Dewa!
Dialogue: 0,0:03:19.85,0:03:25.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}Berkatilah keduanya dengan cinta abadi\Ndan kemakmuran selamanya!
Dialogue: 0,0:03:41.49,0:03:43.07,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hebat sekali, ya!
Dialogue: 0,0:03:43.07,0:03:45.69,Default,,0,0,0,,{\blur3}{\fad(00,40)}Elinalise tadi cantik sekali.
Dialogue: 0,0:03:45.69,0:03:47.54,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku pengin coba pakai bajunya tadi!
Dialogue: 0,0:03:47.85,0:03:51.93,Default,,0,0,0,,{\blur3}{\fad(00,40)}Anak gadis memang terpikat\Ndengan yang seperti itu, ya?
Dialogue: 0,0:03:51.93,0:03:53.34,Default,,0,0,0,,{\blur3}{\fad(00,40)}Begitulah.
Dialogue: 0,0:03:53.34,0:03:58.15,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi, acara kita dulu\Npunya kehangatannya tersendiri, kan.
Dialogue: 0,0:03:58.15,0:03:59.31,Default,,0,0,0,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:04:06.93,0:04:09.75,Default,,0,0,0,,{\blur3}{\fad(00,40)}Roxy ingin mengadakan\Nupacara pernikahan juga?
Dialogue: 0,0:04:09.75,0:04:11.02,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak...
Dialogue: 0,0:04:11.31,0:04:14.65,Default,,0,0,0,,{\blur3}{\fad(00,40)}Suku Migurd sepertinya\Ntidak punya tradisi seperti itu.
Dialogue: 0,0:04:14.65,0:04:17.02,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jadi, aku dan Roxy tidak mengadakan upacara.
Dialogue: 0,0:04:17.37,0:04:22.41,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tetapi, bila melihat yang seperti itu,\Napa mungkin dirinya jadi kepingin juga?
Dialogue: 0,0:04:22.41,0:04:27.81,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku tidak butuh upacara,\Ntapi, duh, kamu mengerti, kan?
Dialogue: 0,0:04:38.25,0:04:41.26,Default,,0,0,0,,{\blur3}{\fad(00,40)}Maaf, habisnya dahimu begitu indah.
Dialogue: 0,0:04:41.26,0:04:43.53,Default,,0,0,0,,{\blur3}{\fad(00,40)}Be-Benarkah?
Dialogue: 0,0:04:44.49,0:04:47.18,Default,,0,0,0,,{\blur3}{\fad(00,40)}Rudy, aku juga mau.
Dialogue: 0,0:04:52.59,0:04:57.90,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kakak, bisa tidak jangan melakukan itu\Ndi tempat seperti ini?
Dialogue: 0,0:04:57.90,0:04:59.92,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa boleh buat.
Dialogue: 0,0:04:59.92,0:05:01.57,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aduh, ih!
Dialogue: 0,0:05:01.57,0:05:03.65,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jangan begitu, dong!
Dialogue: 0,0:05:07.43,0:05:11.67,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dasar, kenapa Kakak selalu saja\Ntidak punya malu begitu?!
Dialogue: 0,0:05:11.67,0:05:12.67,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aisha.
Dialogue: 0,0:05:14.13,0:05:15.75,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kakak!
Dialogue: 0,0:05:18.34,0:05:21.77,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aisha, jangan melingkarkan kakimu begitu.
Dialogue: 0,0:05:21.77,0:05:22.97,Default,,0,0,0,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:05:22.97,0:05:29.65,Default,,0,0,0,,{\blur3}{\fad(00,40)}Astaga, kamu itu sudah sebelas tahun,\Nbersikaplah seperti gadis dewasa yang anggun.
Dialogue: 0,0:05:29.65,0:05:32.23,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sudah, namanya juga keluarga.
Dialogue: 0,0:05:32.59,0:05:34.61,Default,,0,0,0,,{\blur3}{\fad(00,40)}Oh, sebelas tahun?
Dialogue: 0,0:05:35.01,0:05:40.07,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa mungkin ulang tahun kelima dan\Nkesepuluh mereka berdua belum dirayakan?
Dialogue: 0,0:05:40.40,0:05:44.57,Default,,0,0,0,,{\blur3}{\fad(00,40)}Selama bencana teleportasi,\NPaul pasti tidak sempat melakukannya.
Dialogue: 0,0:05:45.18,0:05:49.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}Saat pulang nanti, harus kita rayakan\Ndengan meriah bersama-sama.
Dialogue: 0,0:05:49.72,0:05:51.29,Default,,0,0,0,,{\blur3}{\fad(00,40)}Oke, sudah kuputuskan.
Dialogue: 0,0:05:51.96,0:05:53.61,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ayo adakan pesta.
Dialogue: 0,0:06:03.20,0:06:06.41,Default,,0,0,0,,{\blur3}{\fad(00,40)}Musim ini selalu saja\Nramai seperti biasanya, ya.
Dialogue: 0,0:06:06.41,0:06:07.81,Default,,0,0,0,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:06:07.81,0:06:10.31,Default,,0,0,0,,{\blur3}{\fad(00,40)}Berbagai orang akan datang\Nsaat festival panen.
Dialogue: 0,0:06:10.70,0:06:13.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}Barang tidak biasa dari luar\Nakan mudah masuk ke sini,
Dialogue: 0,0:06:13.71,0:06:16.02,Default,,0,0,0,,{\blur3}{\fad(00,40)}pasti bisa dapat kado yang bagus.
Dialogue: 0,0:06:16.02,0:06:18.27,Default,,0,0,0,,{\blur3}{\fad(00,40)}Mereka berdua pasti akan kaget.
Dialogue: 0,0:06:18.59,0:06:21.58,Default,,0,0,0,,{\blur3}{\fad(00,40)}Karena ini pesta kejutan\Nuntuk kedua adik perempuanku,
Dialogue: 0,0:06:21.58,0:06:24.83,Default,,0,0,0,,{\blur3}{\fad(00,40)}aku langsung minta tolong ke Sylphy dan Roxy.
Dialogue: 0,0:06:24.83,0:06:29.54,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi, tujuan kami pergi ke kota hari ini\Nbukan hanya untuk itu saja.
Dialogue: 0,0:06:29.93,0:06:32.87,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku sudah memberi pancingan ke mereka berdua.
Dialogue: 0,0:06:34.87,0:06:36.16,Default,,0,0,0,,{\blur3}{\fad(00,40)}Rudy?
Dialogue: 0,0:06:36.55,0:06:38.13,Default,,0,0,0,,{\blur3}{\fad(00,40)}Rudy!
Dialogue: 0,0:06:38.13,0:06:39.36,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kamu tidak apa-apa?
Dialogue: 0,0:06:39.36,0:06:41.23,Default,,0,0,0,,{\blur3}{\fad(00,40)}Air liurmu menetes, lo.
Dialogue: 0,0:06:41.23,0:06:43.34,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa sudah lapar?
Dialogue: 0,0:06:43.34,0:06:46.85,Default,,0,0,0,,{\blur3}{\fad(00,40)}Gawat, gawat, aku jadi larut dalam khayalan.
Dialogue: 0,0:06:46.85,0:06:49.88,Default,,0,0,0,,{\blur3}{\fad(00,40)}Harus pilih dengan benar kado\Nuntuk Norn dan Aisha.
Dialogue: 0,0:06:49.88,0:06:52.26,Default,,0,0,0,,{\blur3}{\fad(00,40)}Juga menikmati kencan dengan mereka berdua.
Dialogue: 0,0:06:52.26,0:06:53.84,Default,,0,0,0,,{\blur3}{\fad(00,40)}Keduanya sama-sama penting.
Dialogue: 0,0:06:53.84,0:06:57.39,Default,,0,0,0,,{\blur3}{\fad(00,40)}Maaf, sepertinya mulutku sedikit kendur.
Dialogue: 0,0:06:57.39,0:06:59.23,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sudah, ayo lanjut.
Dialogue: 0,0:07:01.77,0:07:05.90,Default,,0,0,0,,{\blur3}{\fad(00,40)}Panci yang isinya akan membeku\Nsaat dialiri daya sihir,
Dialogue: 0,0:07:05.90,0:07:08.16,Default,,0,0,0,,{\blur3}{\fad(00,40)}mungkin bagus untuk Aisha.
Dialogue: 0,0:07:08.16,0:07:11.85,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kurasa Aisha akan suka sesuatu\Nyang lebih imut.
Dialogue: 0,0:07:11.85,0:07:13.48,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ah, benar juga.
Dialogue: 0,0:07:13.48,0:07:17.12,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau dipikir, Norn kira-kira suka apa, ya?
Dialogue: 0,0:07:17.45,0:07:20.13,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau Norn, apa, ya?
Dialogue: 0,0:07:20.13,0:07:25.38,Default,,0,0,0,,{\blur3}{\fad(00,40)}Zirah, pedang, atau kuda,\Nkelihatannya dia suka barang anak lelaki.
Dialogue: 0,0:07:25.71,0:07:27.89,Default,,0,0,0,,{\blur3}{\fad(00,40)}Oh, kamu tahu banyak, ya.
Dialogue: 0,0:07:28.17,0:07:31.76,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku sendiri ingin bisa akrab dengan dia.
Dialogue: 0,0:08:07.25,0:08:10.47,Default,,0,0,0,,{\blur3}{\fad(00,40)}Maaf, ya, sampai memilihkan bajuku juga.
Dialogue: 0,0:08:10.47,0:08:14.17,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jangan dipikirkan,\Naku juga menikmatinya, kok.
Dialogue: 0,0:08:14.70,0:08:16.52,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ayo kita segera makan malam.
Dialogue: 0,0:08:17.82,0:08:20.75,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sebenarnya aku sudah memesan tempat.
Dialogue: 0,0:08:24.25,0:08:25.90,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tempat ini...
Dialogue: 0,0:08:25.90,0:08:28.40,Default,,0,0,0,,{\blur3}{\fad(00,40)}yang Nenek bilang padaku.
Dialogue: 0,0:08:28.40,0:08:32.65,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau bertengkar sama Rudy,\Nkatanya disuruh berbaikan di sini.
Dialogue: 0,0:08:32.65,0:08:35.24,Default,,0,0,0,,{\blur3}{\fad(00,40)}Oh, Sylphy juga?
Dialogue: 0,0:08:35.24,0:08:37.12,Default,,0,0,0,,{\blur3}{\fad(00,40)}Elinalise juga memberitahuku,
Dialogue: 0,0:08:37.45,0:08:42.38,Default,,0,0,0,,{\blur3}{\fad(00,40)}"Rudy mungkin mengajakmu sama Sylphy\Nke penginapan ini."
Dialogue: 0,0:08:42.89,0:08:47.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jadi, itu maksudnya memang...
Dialogue: 0,0:08:48.98,0:08:50.81,Default,,0,0,0,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:08:51.64,0:08:53.82,Default,,0,0,0,,{\blur3}{\fad(00,40)}Rudy ini memang cabul, ya.
Dialogue: 0,0:08:53.82,0:08:56.17,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa pun kata mereka, tidak ada masalah.
Dialogue: 0,0:08:56.17,0:08:59.89,Default,,0,0,0,,{\blur3}{\fad(00,40)}Karena Kanjeng Ratu Elinalise\Nsudah selesai memberi pancingan!
Dialogue: 0,0:08:59.89,0:09:03.65,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ah, kalau mau menginap,\Naku khawatir sama Lucy.
Dialogue: 0,0:09:03.65,0:09:06.90,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tenang, aku sudah minta tolong ke Lilia.
Dialogue: 0,0:09:06.90,0:09:08.41,Default,,0,0,0,,{\blur3}{\fad(00,40)}Meski sudah minta tolong.
Dialogue: 0,0:09:08.41,0:09:12.03,Default,,0,0,0,,{\blur3}{\fad(00,40)}Yah, kalau Lilia rasanya\Nbisa kupasrahkan dengan tenang.
Dialogue: 0,0:09:12.03,0:09:17.15,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sylphy pasti ingin bilang tidak baik kalau\Nkedua orang tua malah menginap di luar.
Dialogue: 0,0:09:17.15,0:09:18.91,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku juga paham itu.
Dialogue: 0,0:09:18.91,0:09:23.06,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi, benar, tidak perlu cari-cari alasan.
Dialogue: 0,0:09:23.06,0:09:27.38,Default,,0,0,0,,{\blur3}{\fad(00,40)}Maaf, Lucy, ampunilah ayahmu\Nyang lemah pada nafsu duniawi.
Dialogue: 0,0:09:28.42,0:09:30.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ya sudah, kalian berdua.
Dialogue: 0,0:09:30.71,0:09:32.38,Default,,0,0,0,,{\blur3}{\fad(00,40)}- Iya?\N- Ada apa?
Dialogue: 0,0:09:34.64,0:09:36.23,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sebenarnya...
Dialogue: 0,0:09:37.59,0:09:40.41,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku sudah pesan kamar.
Dialogue: 0,0:09:40.41,0:09:43.31,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalimat yang setidaknya ingin kuucapkan\Nsekali dalam hidup.
Dialogue: 0,0:09:48.07,0:09:51.65,Default,,0,0,0,,{\blur3}{\fad(00,40)}Anu, Roxy, biar kutanya sekali lagi.
Dialogue: 0,0:09:51.65,0:09:53.99,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kamu tidak apa-apa, kan, kalau sama aku juga?
Dialogue: 0,0:09:53.99,0:09:56.79,Default,,0,0,0,,{\blur3}{\fad(00,40)}Iya, aku sudah siap mental.
Dialogue: 0,0:09:56.79,0:09:58.69,Default,,0,0,0,,{\blur3}{\fad(00,40)}Mohon bantuannya.
Dialogue: 0,0:10:07.45,0:10:10.65,Default,,0,0,0,,{\blur3}{\fad(00,40)}Malam ini rasanya akan jadi malam terhebat.
Dialogue: 0,0:10:18.87,0:10:21.73,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hari ini pesta ulang tahun kejutan\Nakan dilakukan.
Dialogue: 0,0:10:22.26,0:10:24.57,Default,,0,0,0,,{\blur3}{\fad(00,40)}Memang banyak yang harus disiapkan...
Dialogue: 0,0:10:24.57,0:10:29.23,Default,,0,0,0,,{\blur3}{\fad(00,40)}Selagi itu, aku harus membawa adik-adikku\Nke luar dari rumah dulu.
Dialogue: 0,0:10:47.28,0:10:51.09,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ah, ketemu juga kalian, Roxy, Norn, Aisha.
Dialogue: 0,0:10:51.09,0:10:54.11,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ada yang ingin kubicarakan,\Ntolong ikut aku sebentar.
Dialogue: 0,0:10:54.11,0:10:55.59,Default,,0,0,0,,{\blur3}{\fad(00,40)}Mau membicarakan apa?
Dialogue: 0,0:10:55.59,0:10:58.30,Default,,0,0,0,,{\blur3}{\fad(00,40)}Baiklah, akan kutemani.
Dialogue: 0,0:10:58.30,0:10:59.17,Default,,0,0,0,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:10:59.17,0:11:03.73,Default,,0,0,0,,{\blur3}{\fad(00,40)}Itu ajakan dari Tuan Rudeus.\NAisha, pergilah sana.
Dialogue: 0,0:11:14.79,0:11:16.06,Default,,0,0,0,,{\blur3}{\fad(00,40)}Memancing, ya.
Dialogue: 0,0:11:16.06,0:11:16.98,Default,,0,0,0,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:11:16.98,0:11:19.92,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ini bagus untuk mempererat hubungan, bukan?
Dialogue: 0,0:11:23.01,0:11:26.45,Default,,0,0,0,,{\blur3}{\fad(00,40)}Habisnya Norn masih canggung ke Roxy.
Dialogue: 0,0:11:26.45,0:11:28.88,Default,,0,0,0,,{\blur3}{\fad(00,40)}Roxy sendiri bilang ingin akrab dengannya.
Dialogue: 0,0:11:29.27,0:11:32.15,Default,,0,0,0,,{\blur3}{\fad(00,40)}Semoga dengan ini mereka bisa jadi dekat.
Dialogue: 0,0:11:35.72,0:11:38.76,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku belum pernah memancing.
Dialogue: 0,0:11:38.76,0:11:40.93,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku juga belum pernah!
Dialogue: 0,0:11:40.93,0:11:44.37,Default,,0,0,0,,{\blur3}{\fad(00,40)}Makanya aku pengin coba setidaknya sekali.
Dialogue: 0,0:11:47.05,0:11:50.93,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kak, ayo beradu siapa\Nyang dapat ikan lebih banyak!
Dialogue: 0,0:11:50.93,0:11:52.91,Default,,0,0,0,,{\blur3}{\fad(00,40)}O-Oh, boleh!
Dialogue: 0,0:11:52.91,0:11:56.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bagaimana kalau sekalian yang kalah\Nharus menuruti satu perintah pemenangnya?
Dialogue: 0,0:11:56.71,0:11:57.74,Default,,0,0,0,,{\blur3}{\fad(00,40)}Setuju!
Dialogue: 0,0:12:01.95,0:12:04.91,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kak! Ini harus diapakan?!
Dialogue: 0,0:12:06.65,0:12:08.53,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kakak juga tidak tahu.
Dialogue: 0,0:12:08.53,0:12:11.13,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku sendiri belum pernah memancing.
Dialogue: 0,0:12:12.96,0:12:14.24,Default,,0,0,0,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:12:17.31,0:12:19.38,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa perlu kuajari?
Dialogue: 0,0:12:21.86,0:12:23.76,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tolong bantuannya.
Dialogue: 0,0:12:25.77,0:12:29.73,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tancapkan cacing ke kail dengan hati-hati\Nagar tidak putus.
Dialogue: 0,0:12:30.21,0:12:34.81,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau dari sini, kurasa sebaiknya incar\Nsekitar bayangan pohon di seberang sana.
Dialogue: 0,0:12:34.81,0:12:36.53,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kira-kira bisa, tidak?
Dialogue: 0,0:12:36.53,0:12:38.07,Default,,0,0,0,,{\blur3}{\fad(00,40)}Akan kucoba.
Dialogue: 0,0:12:48.01,0:12:49.65,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kamu pintar sekali.
Dialogue: 0,0:12:49.65,0:12:51.67,Default,,0,0,0,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:12:55.71,0:12:57.37,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kakak sudah terbiasa, ya.
Dialogue: 0,0:12:57.37,0:13:03.35,Default,,0,0,0,,{\blur3}{\fad(00,40)}Saat bertualang sendiri, sebisa mungkin\Naku harus menangkap makanan sendiri.
Dialogue: 0,0:13:11.26,0:13:12.56,Default,,0,0,0,,{\blur3}{\fad(00,40)}Oh iya.
Dialogue: 0,0:13:12.56,0:13:17.05,Default,,0,0,0,,{\blur3}{\fad(00,40)}Saat melakukan perjalanan,\NRuijerd juga menangkapkan ikan.
Dialogue: 0,0:13:17.05,0:13:18.33,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dia juga bisa memancing?
Dialogue: 0,0:13:18.33,0:13:19.24,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:13:19.24,0:13:22.02,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dia menusukkan tombak ke air,
Dialogue: 0,0:13:22.02,0:13:24.96,Default,,0,0,0,,{\blur3}{\fad(00,40)}lalu ada tiga ikan yang tertusuk di ujungnya.
Dialogue: 0,0:13:25.66,0:13:28.33,Default,,0,0,0,,{\blur3}{\fad(00,40)}Norn, ada yang memakan pancingmu!
Dialogue: 0,0:13:28.33,0:13:29.45,Default,,0,0,0,,{\blur3}{\fad(00,40)}Eh? Eh?!
Dialogue: 0,0:13:29.45,0:13:30.60,Default,,0,0,0,,{\blur3}{\fad(00,40)}Cepat tarik.
Dialogue: 0,0:13:30.60,0:13:31.21,Default,,0,0,0,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:13:33.88,0:13:34.67,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ah, tolong!
Dialogue: 0,0:13:36.16,0:13:39.05,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bagus, benar begitu. Ayo ditarik.
Dialogue: 0,0:13:39.05,0:13:41.55,Default,,0,0,0,,{\blur3}{\fad(00,40)}Berusahalah, dengan hati-hati.
Dialogue: 0,0:13:51.12,0:13:54.35,Default,,0,0,0,,{\blur3}{\fad(00,40)}Berhasil, dapat ikan!\NIni hasil pancingan pertamaku!
Dialogue: 0,0:13:54.77,0:13:57.36,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hebat, ini tangkapan besar!
Dialogue: 0,0:13:58.18,0:14:01.31,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sepertinya cuma masalah waktu\Nhingga mereka jadi akrab.
Dialogue: 0,0:14:01.31,0:14:02.28,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hyak!
Dialogue: 0,0:14:02.83,0:14:04.74,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ini ikan ketiga!
Dialogue: 0,0:14:10.45,0:14:14.17,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pancingan Kakak dari tadi\Nkelihatannya tidak bagus.
Dialogue: 0,0:14:14.17,0:14:15.99,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kenapa, hayo?
Dialogue: 0,0:14:15.99,0:14:17.69,Default,,0,0,0,,{\blur3}{\fad(00,40)}Seharusnya tidak begini...
Dialogue: 0,0:14:17.69,0:14:19.51,Default,,0,0,0,,{\blur3}{\fad(00,40)}Enaknya nanti minta apa, ya?
Dialogue: 0,0:14:19.51,0:14:25.76,Default,,0,0,0,,{\blur3}{\fad(00,40)}Minta dipeluk semalaman sambil dibisiki,\N"Aisha, kamu manis sekali," saja, ah.
Dialogue: 0,0:14:26.14,0:14:29.21,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau cuma itu sebenarnya tidak masalah.
Dialogue: 0,0:14:29.21,0:14:30.19,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:14:30.19,0:14:34.02,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bukankah di sini seharusnya\Nmenunjukkan wibawaku sebagai kakak?!
Dialogue: 0,0:14:35.03,0:14:37.49,Default,,0,0,0,,{\blur3}{\fad(00,40)}Fish!
Dialogue: 0,0:14:38.15,0:14:39.65,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sip! Tangkapan be...
Dialogue: 0,0:14:42.78,0:14:44.30,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kak.
Dialogue: 0,0:14:44.30,0:14:47.91,Default,,0,0,0,,{\blur3}{\fad(00,40)}Membersihkan tempat pemancingan\Njuga tugas seorang pemancing.
Dialogue: 0,0:14:48.51,0:14:51.16,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aisha, aku juga akan serius.
Dialogue: 0,0:14:51.16,0:14:53.47,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jadi, selama ini belum serius?
Dialogue: 0,0:14:53.47,0:14:55.14,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sudah, lihat saja.
Dialogue: 0,0:15:02.61,0:15:03.84,Default,,0,0,0,,{\blur3}{\fad(00,40)}Itu?
Dialogue: 0,0:15:03.84,0:15:06.42,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sejak diajari Lightning oleh Roxy
Dialogue: 0,0:15:06.42,0:15:08.72,Default,,0,0,0,,{\blur3}{\fad(00,40)}aku sudah mencoba beragam hal.
Dialogue: 0,0:15:09.07,0:15:11.89,Default,,0,0,0,,{\blur3}{\fad(00,40)}Inti utama sihir ini ada di kompresi.
Dialogue: 0,0:15:11.89,0:15:14.81,Default,,0,0,0,,{\blur3}{\fad(00,40)}Menciptakan awan dari daya sihir\Nyang disebarkan di angkasa,
Dialogue: 0,0:15:14.81,0:15:17.98,Default,,0,0,0,,{\blur3}{\fad(00,40)}lalu memampatkannya untuk menurunkan petir.
Dialogue: 0,0:15:17.98,0:15:20.94,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tetapi, bila dari awal\Nukuran awannya sudah diatur,
Dialogue: 0,0:15:20.94,0:15:24.23,Default,,0,0,0,,{\blur3}{\fad(00,40)}bisa menembakkan serangan petir\Ndengan daya yang dibatasi!
Dialogue: 0,0:15:24.87,0:15:25.95,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kuberi nama...
Dialogue: 0,0:15:26.72,0:15:27.91,Default,,0,0,0,,{\blur3}{\fad(00,40)}Electric!
Dialogue: 0,0:15:38.02,0:15:41.29,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bagaimana?! Dengan ini Kakak yang menang!
Dialogue: 0,0:15:41.29,0:15:43.65,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kakak! Pakai sihir itu curang!
Dialogue: 0,0:15:43.65,0:15:44.84,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kakak.
Dialogue: 0,0:15:44.84,0:15:47.76,Default,,0,0,0,,{\blur3}{\fad(00,40)}Rudy, mau dilihat dari sisi mana pun,\Nitu bukan sikap orang dewasa.
Dialogue: 0,0:15:53.72,0:15:56.69,Default,,0,0,0,,{\blur3}{\fad(00,40)}Coba lihat! Aku dapat sebanyak ini!
Dialogue: 0,0:15:56.69,0:15:58.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kak Norn bagaimana?
Dialogue: 0,0:15:59.61,0:16:03.40,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku diajari Kak Roxy,\Nterus dapat ikan sebesar ini!
Dialogue: 0,0:16:05.97,0:16:08.51,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kak Roxy, lain kali ajari aku juga!
Dialogue: 0,0:16:08.51,0:16:11.85,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak boleh!\NAisha, kan, dapat ikan lebih banyak!
Dialogue: 0,0:16:11.85,0:16:14.87,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kak Roxy bakal mengajariku lagi!
Dialogue: 0,0:16:15.32,0:16:17.67,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ayo, kalian jangan bertengkar.
Dialogue: 0,0:16:17.67,0:16:19.95,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalian berdua akan kuajari.
Dialogue: 0,0:16:21.24,0:16:23.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}- Kami pulang!
Dialogue: 0,0:16:25.99,0:16:28.17,Default,,0,0,0,,{\blur3}{\fad(00,40)}Selamat ulang tahun.
Dialogue: 0,0:16:30.16,0:16:32.18,Default,,0,0,0,,{\blur3}{\fad(00,40)}- Selamat ulang tahun.
Dialogue: 0,0:16:32.49,0:16:35.82,Default,,0,0,0,,{\blur3}{\fad(00,40)}Anu, tapi kami sudah sebelas tahun.
Dialogue: 0,0:16:35.82,0:16:39.91,Default,,0,0,0,,{\blur3}{\fad(00,40)}Iya, soalnya tidak sempat dirayakan\Nsaat kalian sepuluh tahun.
Dialogue: 0,0:16:39.91,0:16:44.07,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kata Rudy,\N"Tidak masalah terlambat kalau cuma setahun."
Dialogue: 0,0:16:44.07,0:16:45.87,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kakak yang bilang?
Dialogue: 0,0:16:45.87,0:16:47.74,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sudah, ayo masuk.
Dialogue: 0,0:16:57.12,0:17:00.29,Default,,0,0,0,,{\blur3}{\fad(00,40)}Minuman kalian sudah siap?
Dialogue: 0,0:17:01.46,0:17:04.48,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tujuh tahun berlalu\Nsejak bencana teleportasi Wilayah Fittoa.
Dialogue: 0,0:17:04.48,0:17:08.17,Default,,0,0,0,,{\blur3}{\fad(00,40)}Memang memakan waktu,\Ntapi keluarga kita akhirnya berkumpul.
Dialogue: 0,0:17:08.47,0:17:10.21,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ayah sudah tiada.
Dialogue: 0,0:17:10.21,0:17:12.93,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ibu juga tidak tahu bisa pulih\Nseperti semula atau tidak.
Dialogue: 0,0:17:13.25,0:17:17.68,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi, kalau terus menerus bermuka sedih,\NAyah pasti tidak akan senang.
Dialogue: 0,0:17:18.40,0:17:23.21,Default,,0,0,0,,{\blur3}{\fad(00,40)}Karena itu kurasa aku,\Nkurasa kita, harus bisa tersenyum.
Dialogue: 0,0:17:23.73,0:17:26.02,Default,,0,0,0,,{\blur3}{\fad(00,40)}Saat bertemu Ayah di Benua Begaritt,
Dialogue: 0,0:17:26.02,0:17:29.69,Default,,0,0,0,,{\blur3}{\fad(00,40)}kami berjanji untuk merayakan dengan meriah\Nkalau kita berkumpul lagi.
Dialogue: 0,0:17:32.12,0:17:36.07,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sesuai wasiat mendiang Ayah,\Nhari ini ayo kita bergembira lepas.
Dialogue: 0,0:17:38.29,0:17:39.58,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bersulang!
Dialogue: 0,0:17:39.58,0:17:41.16,Default,,0,0,0,,{\blur3}{\fad(00,40)}- Bersulang!
Dialogue: 0,0:17:44.23,0:17:48.30,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ini hadiah untuk kalian berdua\Ndari Rudy dan kami.
Dialogue: 0,0:17:48.91,0:17:51.38,Default,,0,0,0,,{\blur3}{\fad(00,40)}Semoga kalian menyukainya.
Dialogue: 0,0:17:52.01,0:17:54.00,Default,,0,0,0,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:18:01.31,0:18:03.08,Default,,0,0,0,,{\blur3}{\fad(00,40)}Boleh kubuka?!
Dialogue: 0,0:18:03.08,0:18:04.63,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tentu saja boleh.
Dialogue: 0,0:18:19.99,0:18:21.53,Default,,0,0,0,,{\blur3}{\fad(00,40)}Indah sekali!
Dialogue: 0,0:18:21.53,0:18:24.42,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lihat, Kak Norn! Aku dapat sepatu!
Dialogue: 0,0:18:24.72,0:18:28.17,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalian berdua dapat hadiah yang bagus, ya.
Dialogue: 0,0:18:28.49,0:18:31.30,Default,,0,0,0,,{\blur3}{\fad(00,40)}Coba lihat, Ibu. Aku dapat ini.
Dialogue: 0,0:18:31.30,0:18:34.65,Default,,0,0,0,,{\blur3}{\fad(00,40)}Nanti ayo jalan-jalan pakai ini, ya.
Dialogue: 0,0:18:41.81,0:18:43.99,Default,,0,0,0,,{\blur3}{\fad(00,40)}Barusan, tersenyum?
Dialogue: 0,0:18:46.91,0:18:48.43,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ibu...
Dialogue: 0,0:18:57.48,0:19:01.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}Nyonya?! Syukurlah.
Dialogue: 0,0:19:07.40,0:19:10.88,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ini hadiah dariku dan Nyonya\Nuntuk kalian berdua.
Dialogue: 0,0:19:10.88,0:19:13.69,Default,,0,0,0,,{\blur3}{\fad(00,40)}Terima kasih, Lilia.
Dialogue: 0,0:19:13.69,0:19:17.59,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ibu, anu, aku juga boleh menerima ini?
Dialogue: 0,0:19:17.59,0:19:20.05,Default,,0,0,0,,{\blur3}{\fad(00,40)}Iya, tentu saja boleh.
Dialogue: 0,0:19:20.05,0:19:24.18,Default,,0,0,0,,{\blur3}{\fad(00,40)}Karena kamu juga putri Tuan Paul.
Dialogue: 0,0:19:26.21,0:19:28.94,Default,,0,0,0,,{\blur3}{\fad(00,40)}Terima kasih, Ibu.
Dialogue: 0,0:19:31.93,0:19:35.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}Nyonya, mohon bantuannya lagi\Nuntuk ke depannya.
Dialogue: 0,0:19:46.41,0:19:48.15,Default,,0,0,0,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:19:52.83,0:19:54.14,Default,,0,0,0,,{\blur3}{\fad(00,40)}Roxy.
Dialogue: 0,0:19:57.59,0:19:59.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:19:59.71,0:20:02.91,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ini, dari kami buat Roxy.
Dialogue: 0,0:20:04.60,0:20:06.53,Default,,0,0,0,,{\blur3}{\fad(00,40)}Anu, untuk apa, ya?
Dialogue: 0,0:20:06.53,0:20:08.23,Default,,0,0,0,,{\blur3}{\fad(00,40)}Perayaan pernikahanmu.
Dialogue: 0,0:20:08.23,0:20:11.12,Default,,0,0,0,,{\blur3}{\fad(00,40)}Roxy, selamat atas pernikahanmu dengan Rudy.
Dialogue: 0,0:20:11.12,0:20:12.81,Default,,0,0,0,,{\blur3}{\fad(00,40)}Eh, anu...
Dialogue: 0,0:20:12.81,0:20:14.48,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ayo, dibuka.
Dialogue: 0,0:20:22.19,0:20:23.99,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:20:23.99,0:20:28.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kamu ingat perkataanku tempo hari\Nkalau aku cuma mujur?
Dialogue: 0,0:20:28.71,0:20:29.87,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ingat.
Dialogue: 0,0:20:29.87,0:20:33.21,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kurasa kalau aku tidak bertemu Rudy,
Dialogue: 0,0:20:33.21,0:20:37.15,Default,,0,0,0,,{\blur3}{\fad(00,40)}pasti sekarang aku\Ntidak akan ada di sini hidup-hidup.
Dialogue: 0,0:20:37.15,0:20:38.89,Default,,0,0,0,,{\blur3}{\fad(00,40)}Itu berlebihan.
Dialogue: 0,0:20:38.89,0:20:40.39,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak juga, kok.
Dialogue: 0,0:20:40.81,0:20:44.26,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bertemu dengan Rudy, hidupku pun berubah.
Dialogue: 0,0:20:44.64,0:20:49.37,Default,,0,0,0,,{\blur3}{\fad(00,40)}Makanya, aku senang kalau orang\Nyang mengubah hidup Rudy jadi lebih baik
Dialogue: 0,0:20:49.37,0:20:52.27,Default,,0,0,0,,{\blur3}{\fad(00,40)}jatuh cinta pada Rudy.
Dialogue: 0,0:20:54.27,0:21:01.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi, aku bukannya tidak suka kalau aku\Njadi alasan Rudy tidak bisa menjawabnya...
Dialogue: 0,0:21:01.71,0:21:04.03,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aduh, tidak bisa kujelaskan dengan gamblang.
Dialogue: 0,0:21:06.39,0:21:08.55,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jadi, Roxy...
Dialogue: 0,0:21:09.50,0:21:13.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kita harus jadi seperti Zenith dan Lilia, ya.
Dialogue: 0,0:21:18.12,0:21:20.93,Default,,0,0,0,,{\blur3}{\fad(00,40)}Terima kasih banyak...
Dialogue: 0,0:21:23.47,0:21:26.22,Default,,0,0,0,,{\blur3}{\fad(00,40)}Seluruh keluarga tersenyum dan berbahagia.
Dialogue: 0,0:21:27.09,0:21:31.12,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pasti pemandangan seperti inilah\Nyang diinginkan Paul.
Dialogue: 0,0:21:38.23,0:21:39.23,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bweek, bweek!
Dialogue: 0,0:21:39.23,0:21:41.74,Default,,0,0,0,,{\blur3}{\fad(00,40)}- Ba!\N- Lucy, ayo senyum!
Dialogue: 0,0:21:41.74,0:21:43.81,Default,,0,0,0,,{\blur3}{\fad(00,40)}Muka apa itu, Aisha.
Dialogue: 0,0:21:46.81,0:21:50.58,Default,,0,0,0,,{\blur3}{\fad(00,40)}- Rudy, selamat ulang tahun yang kelima!\N- Tuan Rudeus, selamat ulang tahun yang kelima!
Dialogue: 0,0:21:50.58,0:21:52.35,Default,,0,0,0,,{\blur3}{\fad(00,40)}Senang, ya, Lucy.
Dialogue: 0,0:21:52.35,0:21:56.42,Default,,0,0,0,,{\blur3}{\fad(00,40)}Saat mereka lima belas tahun,\Nayo kita rayakan lagi dengan meriah.
Dialogue: 0,0:21:57.56,0:21:59.47,Default,,0,0,0,,{\blur3}{\fad(00,40)}Oh, dia tertawa.
Dialogue: 0,0:21:59.47,0:22:00.62,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lucy!
Dialogue: 0,0:22:00.62,0:22:01.97,Default,,0,0,0,,{\blur3}{\fad(00,40)}Imut sekali!
