Dialogue: 0,0:04:25.19,0:04:26.00,sign,,0000,0000,0000,,BUKU HARIAN\NRUDEUS GREYRAT
Dialogue: 0,0:22:17.27,0:22:18.87,sign,,0000,0000,0000,,"EPISODE 14: TEKAD"
Dialogue: 0,0:23:34.98,0:23:39.98,sign,,0000,0000,0000,,TERIMA KASIH TELAH MENONTON!\NSELAMAT MENANTIKAN PARUH KEDUA!
Dialogue: 0,0:00:34.79,0:00:36.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rudy?!
Dialogue: 0,0:00:36.93,0:00:39.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kenapa?\NApa baik-baik saja?
Dialogue: 0,0:00:45.54,0:00:47.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ru-Rudy?
Dialogue: 0,0:00:54.35,0:00:57.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga sedang tidak baik-baik saja.
Dialogue: 0,0:00:57.85,0:01:00.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan selalu menghiburmu, kok.
Dialogue: 0,0:01:01.38,0:01:03.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sylphy yang sebaik ini,
Dialogue: 0,0:01:03.96,0:01:06.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku yang di masa depan akan mengkhianatinya.
Dialogue: 0,0:01:06.83,0:01:08.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Sylphy.
Dialogue: 0,0:01:08.83,0:01:12.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa jadi saat di masa yang begitu sulit,
Dialogue: 0,0:01:12.89,0:01:15.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan mengatakan\Nhal yang sangat menyakitkan.
Dialogue: 0,0:01:16.05,0:01:17.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu mendadak bilang begitu?
Dialogue: 0,0:01:17.93,0:01:21.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kumohon jangan pergi meninggalkanku.
Dialogue: 0,0:01:22.49,0:01:28.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu terjadi, aku mungkin juga akan\Nbersikap keras dan kita jadi bertengkar.
Dialogue: 0,0:01:32.82,0:01:36.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kita pasti bisa berbaikan, kan?
Dialogue: 0,0:01:37.67,0:01:39.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti bisa, kok!
Dialogue: 0,0:01:40.05,0:01:43.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kita pasti bisa berbaikan.
Dialogue: 0,0:03:11.59,0:03:18.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mushoku Tensei:\NJobless Reincarnation Season 3
Dialogue: 0,0:03:25.73,0:03:29.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Roxy, apa ada yang berubah\Ndari kondisimu belakangan ini?
Dialogue: 0,0:03:29.72,0:03:33.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sehat-sehat saja, kok.\NKenapa menanyakan itu?
Dialogue: 0,0:03:33.95,0:03:39.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya, aku ingin sekali agar Roxy\Nbisa hidup panjang.
Dialogue: 0,0:03:39.26,0:03:44.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mempertimbangkan usia sukuku,\Naku akan hidup lebih panjang dari Rudy.
Dialogue: 0,0:03:44.43,0:03:47.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rudy sendiri tolong hidup panjang, ya.
Dialogue: 0,0:03:47.62,0:03:49.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:03:50.81,0:03:53.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berdua masih hidup.
Dialogue: 0,0:03:53.14,0:03:56.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Isi buku harian itu harus kucegah sebisaku.
Dialogue: 0,0:03:58.06,0:04:01.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru ingat ada yang harus kukerjakan,\Naku kembali ke kamar dulu, ya.
Dialogue: 0,0:04:01.34,0:04:03.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, yang semangat, ya.
Dialogue: 0,0:04:07.93,0:04:10.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sikap Rudy hari ini apa tidak terasa aneh?
Dialogue: 0,0:04:10.74,0:04:11.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:04:12.35,0:04:16.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rudy memang sulit mengutarakan\Nkalau dia sedang di masa-masa sulit.
Dialogue: 0,0:04:18.05,0:04:22.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah dicari tahu terlalu dalam,\Ntapi nanti kita bantu saja saat diperlukan.
Dialogue: 0,0:04:22.74,0:04:23.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:04:24.03,0:04:25.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu benar.
Dialogue: 0,0:04:28.00,0:04:30.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada tiga hal yang harus kulakukan.
Dialogue: 0,0:04:30.67,0:04:32.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minta saran pada Nanahoshi.
Dialogue: 0,0:04:32.82,0:04:36.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Curiga pada Dewa Manusia,\Ntapi jangan memusuhinya.
Dialogue: 0,0:04:36.71,0:04:39.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, mengirim surat untuk Eris.
Dialogue: 0,0:04:42.56,0:04:44.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo mulai dari ini dulu.
Dialogue: 0,0:04:45.14,0:04:49.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasangan pertamaku,\Njuga orang yang pernah kucinta.
Dialogue: 0,0:04:49.39,0:04:52.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, orang yang tiba-tiba menghilang\Ndari hadapanku.
Dialogue: 0,0:04:53.75,0:04:56.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memendam\Nperasaan sekompleks itu padanya.
Dialogue: 0,0:05:02.30,0:05:06.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Surat ini akan kukirim setelah\Nberdiskusi dengan Sylphy dan Roxy.
Dialogue: 0,0:05:07.53,0:05:08.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak!
Dialogue: 0,0:05:09.16,0:05:10.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makannya sudah siap!
Dialogue: 0,0:05:11.57,0:05:12.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya.
Dialogue: 0,0:05:13.06,0:05:14.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo makan sama-sama.
Dialogue: 0,0:05:14.40,0:05:16.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada saus menempel di mulutmu, tuh.
Dialogue: 0,0:05:19.41,0:05:20.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih!
Dialogue: 0,0:05:20.97,0:05:26.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan setelah jadi sampah masyarakat,\Nsepertinya Aisha masih mau mengurusku.
Dialogue: 0,0:05:27.82,0:05:30.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aisha, apa ada sesuatu yang kamu inginkan?
Dialogue: 0,0:05:30.77,0:05:32.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, kenapa tiba-tiba tanya begitu?
Dialogue: 0,0:05:32.98,0:05:37.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan ingin menyogokku\Ndemi dalaman Kak Sylphy dan Kak Roxy?
Dialogue: 0,0:05:37.78,0:05:40.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya.\NSudah, ayo makan.
Dialogue: 0,0:05:40.79,0:05:42.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:05:46.51,0:05:50.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidangan hari ini\Nterasa lebih enak dari biasanya.
Dialogue: 0,0:05:50.75,0:05:52.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, Norn.
Dialogue: 0,0:05:52.44,0:05:53.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya?
Dialogue: 0,0:05:53.42,0:05:55.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kegiatanmu di sekolah?
Dialogue: 0,0:05:55.61,0:05:58.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belajar dan ilmu pedangku\Nmasih belum seberapa,
Dialogue: 0,0:05:58.15,0:06:00.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku bekerja keras di OSIS.
Dialogue: 0,0:06:00.27,0:06:01.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:06:01.83,0:06:03.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada apa-apa,\Nlangsung bilang, ya.
Dialogue: 0,0:06:03.85,0:06:04.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:06:06.64,0:06:10.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Rudeus, apakah hidangannya\Ntidak cocok di lidah Anda?
Dialogue: 0,0:06:10.25,0:06:13.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, justru terasa lebih enak\Ndaripada biasanya.
Dialogue: 0,0:06:13.78,0:06:16.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda berlebihan.
Dialogue: 0,0:06:16.01,0:06:20.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini Aisha sangat bersemangat\Nuntuk membuat Anda ceria.
Dialogue: 0,0:06:28.55,0:06:33.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi keluarga ini juga,\Naku harus bisa diandalkan.
Dialogue: 0,0:06:39.86,0:06:43.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu Sylphy dan Bu Roxy,\Nterima kasih sudah mau ke sini.
Dialogue: 0,0:06:44.55,0:06:49.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, apa belakangan ini ada yang\Nmengganggu pikiran Roxy?
Dialogue: 0,0:06:49.70,0:06:53.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya aku kepikiran akan satu hal.
Dialogue: 0,0:06:53.10,0:06:55.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, akan kuberi tahu\Nsetelah sudah memastikan.
Dialogue: 0,0:06:57.10,0:06:59.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kutunggu dengan sepenuh hati.
Dialogue: 0,0:06:59.28,0:07:02.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sylphy sendiri apakah belakangan ini\Nada yang mengganggu pikiranmu?
Dialogue: 0,0:07:02.82,0:07:04.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada.
Dialogue: 0,0:07:04.09,0:07:08.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau harus bilang, mungkin soal suamiku\Nyang sedang menyembunyikan sesuatu.
Dialogue: 0,0:07:10.17,0:07:12.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, maaf.
Dialogue: 0,0:07:15.40,0:07:18.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memanggil kalian berdua hari ini\Nuntuk membahas hal itu.
Dialogue: 0,0:07:21.46,0:07:27.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempo hari aku bertemu dengan semacam\NAnak Dewa yang bisa meramal masa depan.
Dialogue: 0,0:07:28.11,0:07:32.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya menurut Anak Dewa itu,\Nada orang yang mengincar keluarga kita.
Dialogue: 0,0:07:32.55,0:07:34.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa alasannya?
Dialogue: 0,0:07:34.78,0:07:36.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak tahu.
Dialogue: 0,0:07:36.35,0:07:39.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, di situasi terburuknya,\Nakan ada korban jiwa.
Dialogue: 0,0:07:40.84,0:07:43.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah itu bisa dipercaya?
Dialogue: 0,0:07:43.22,0:07:46.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar itu, apa kamu tidak\Nterlalu khawatir?
Dialogue: 0,0:07:46.45,0:07:50.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya aku punya petunjuk\Ndan cukup yakin akan hal itu.
Dialogue: 0,0:07:50.94,0:07:52.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:07:54.47,0:07:56.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, aku percaya.
Dialogue: 0,0:07:58.11,0:08:02.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Rudy bakal keluar\Nmenghadapi bahaya lagi, kan?
Dialogue: 0,0:08:02.03,0:08:04.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin saja akan seperti itu.
Dialogue: 0,0:08:04.76,0:08:08.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya aku tidak suka\Nkalau harus seperti itu.
Dialogue: 0,0:08:12.75,0:08:14.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:08:14.47,0:08:18.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selagi Rudy pergi meninggalkan rumah,\Nbiar aku yang melindungi keluarga kita.
Dialogue: 0,0:08:18.98,0:08:20.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Roxy tidak masalah?
Dialogue: 0,0:08:20.78,0:08:25.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Rudy akan lebih bersedih kalau\Nkeluarganya yang terkena kemalangan.
Dialogue: 0,0:08:25.86,0:08:27.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:08:27.36,0:08:32.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja saat Rudy dalam bahaya,\Naku juga tidak akan diam melihat saja.
Dialogue: 0,0:08:33.58,0:08:39.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggal kita tolong saja Rudy\Nsaat dirasa itu berbahaya.
Dialogue: 0,0:08:41.57,0:08:43.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:08:43.80,0:08:46.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, aku mengerti.
Dialogue: 0,0:08:46.19,0:08:50.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa melakukan sesuatu agar Rudy\Nmerasa tenang, itu yang terbaik, kan?
Dialogue: 0,0:08:53.05,0:08:57.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rudy tidak usah melihat ke belakang,\Nlakukan saja apa yang kamu mau sepenuh hati.
Dialogue: 0,0:08:57.98,0:08:59.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:09:01.75,0:09:04.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, masih ada satu lagi...
Dialogue: 0,0:09:05.43,0:09:08.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu harus bagaimana\Nmengutarakan hal ini.
Dialogue: 0,0:09:08.59,0:09:11.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah masalah yang cukup berat?
Dialogue: 0,0:09:12.63,0:09:14.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya masih belum pasti.
Dialogue: 0,0:09:16.22,0:09:19.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bisa jadi aku akan\Nmenambah satu istri lagi.
Dialogue: 0,0:09:24.92,0:09:27.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa? Nanahoshi?
Dialogue: 0,0:09:27.48,0:09:29.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan Nanahoshi.
Dialogue: 0,0:09:31.59,0:09:33.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, orang bernama Eris.
Dialogue: 0,0:09:33.33,0:09:34.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eris?
Dialogue: 0,0:09:37.10,0:09:41.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah itu orang yang jadi\Npenyebab penyakit Rudy?
Dialogue: 0,0:09:41.41,0:09:44.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, benar.
Dialogue: 0,0:09:44.98,0:09:47.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya Rudy suka sama orang itu?
Dialogue: 0,0:09:48.11,0:09:50.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini aku lebih mencintai Sylphy!
Dialogue: 0,0:09:52.89,0:09:57.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, Rudy ingin balikan lagi sama orang\Nyang sudah mencampakkanmu?
Dialogue: 0,0:09:57.87,0:10:00.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada mencampakkan...
Dialogue: 0,0:10:00.79,0:10:03.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya itu kesalahpahamanku.
Dialogue: 0,0:10:05.05,0:10:08.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum menikah,\NRudy sangat menderita, kan?
Dialogue: 0,0:10:09.62,0:10:12.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya lebih parah kalau dibandingkan\Ndengan yang sekarang.
Dialogue: 0,0:10:13.28,0:10:16.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau kamu merasakan\Nhal seperti itu lagi.
Dialogue: 0,0:10:17.79,0:10:19.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:10:19.32,0:10:22.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belakangan ini pun aku merasa seperti itu.
Dialogue: 0,0:10:22.38,0:10:26.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, justru karena itu,\Naku ingin menghadapi Eris lagi.
Dialogue: 0,0:10:27.19,0:10:31.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya Eris selama ini\Nsedang berlatih demi diriku.
Dialogue: 0,0:10:31.45,0:10:33.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kemudian ditolak begitu saja,
Dialogue: 0,0:10:33.61,0:10:36.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rasanya ia akan merasakan\Nhal yang sama denganku.
Dialogue: 0,0:10:37.18,0:10:38.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rudy...
Dialogue: 0,0:10:40.22,0:10:46.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku bisa paham betapa menakutkannya\Nditolak padahal sudah berusaha keras.
Dialogue: 0,0:10:46.99,0:10:50.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat di Desa Buena aku juga sudah\Nberusaha keras untuk mengejar Rudy.
Dialogue: 0,0:10:51.21,0:10:56.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kita masih belum tahu apakah dia\Nbenar-benar berlatih atau tidak.
Dialogue: 0,0:10:57.09,0:10:59.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kamu memang tidak suka, ya.
Dialogue: 0,0:10:59.30,0:11:03.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya tidak suka atau bagaimana,\Naku cuma khawatir.
Dialogue: 0,0:11:03.70,0:11:06.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mungkin nanti Rudy akan terluka lagi.
Dialogue: 0,0:11:11.25,0:11:16.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, bagaimana kalau diputuskan saja\Nsetelah bertemu Eris lebih dulu?
Dialogue: 0,0:11:16.05,0:11:20.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti juga banyak yang tidak Rudy tahu\Nkalau tidak bertemu lebih dulu.
Dialogue: 0,0:11:20.02,0:11:21.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:11:21.49,0:11:25.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi dulu bukannya Sylphy pernah bilang?
Dialogue: 0,0:11:25.47,0:11:29.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Rudy harus membawa\Norangnya ke hadapan kita.
Dialogue: 0,0:11:31.01,0:11:32.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:11:33.29,0:11:35.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita saja belum pernah ketemu dia.
Dialogue: 0,0:11:36.53,0:11:40.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira yang namanya Eris\Nitu orang yang jahat,
Dialogue: 0,0:11:40.05,0:11:42.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi bisa jadi itu juga salah paham, ya?
Dialogue: 0,0:11:42.66,0:11:46.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah dia bisa saja sama sepertiku\Nyang sepanjang waktu terus menyukai Rudy.
Dialogue: 0,0:11:46.99,0:11:50.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kurasa pasti begitu.
Dialogue: 0,0:11:51.47,0:11:54.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, tolong bawa Eris kemari.
Dialogue: 0,0:11:54.69,0:11:58.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misal tetap tidak bisa\Nmeski sudah diobrolkan,
Dialogue: 0,0:11:58.15,0:12:01.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku juga akan ikut menolak saat itu terjadi.
Dialogue: 0,0:12:02.56,0:12:03.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:12:05.83,0:12:07.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Roxy.
Dialogue: 0,0:12:07.54,0:12:11.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, mari kita jaga baik perasaan Sylphy.
Dialogue: 0,0:12:11.36,0:12:13.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya, Sylphy.
Dialogue: 0,0:12:13.27,0:12:14.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah.
Dialogue: 0,0:12:14.54,0:12:17.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah mau\Nmembicarakannya lebih dulu.
Dialogue: 0,0:12:17.22,0:12:19.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kutemui dia untuk memastikan.
Dialogue: 0,0:12:19.25,0:12:22.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu baru akan kusampaikan perasaanku.
Dialogue: 0,0:12:28.09,0:12:29.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat tidur.
Dialogue: 0,0:12:29.81,0:12:31.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat tidur.
Dialogue: 0,0:12:31.66,0:12:34.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat tidur, Sylphy, Roxy.
Dialogue: 0,0:12:44.13,0:12:47.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berani sekali bertindak konyol seperti itu.
Dialogue: 0,0:12:47.37,0:12:50.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Curang sekali malah datang dari masa depan.
Dialogue: 0,0:12:50.05,0:12:54.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa coba, padahal hampir saja\Nsemua berjalan lancar.
Dialogue: 0,0:12:54.13,0:12:59.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melihat dirimu kelihatan kesal,\Nsepertinya perkataan Pak Tua itu benar.
Dialogue: 0,0:12:59.21,0:13:02.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah, siapa juga yang tahu.
Dialogue: 0,0:13:02.64,0:13:07.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dirimu di masa depan\Njuga banyak salah pahamnya.
Dialogue: 0,0:13:07.27,0:13:09.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, seperti perkataan diriku\Ndari masa depan,
Dialogue: 0,0:13:09.88,0:13:11.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak berniat memusuhimu.
Dialogue: 0,0:13:12.03,0:13:15.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, tolong jangan usik keluargaku.
Dialogue: 0,0:13:15.27,0:13:17.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulia sekali tindakanmu itu.
Dialogue: 0,0:13:17.74,0:13:21.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku yang sekarang\Nmasih belum kau apa-apakan.
Dialogue: 0,0:13:21.37,0:13:23.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa aku ingin menjalin\Nhubungan yang sehat.
Dialogue: 0,0:13:23.87,0:13:25.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh...
Dialogue: 0,0:13:26.63,0:13:30.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kubilang tujuanku adalah\Nperdamaian dunia, apa akan percaya?
Dialogue: 0,0:13:30.62,0:13:33.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, hebat sekali itu.
Dialogue: 0,0:13:33.22,0:13:36.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cinta dan Perdamaian adalah motoku.
Dialogue: 0,0:13:36.02,0:13:38.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baguslah kalau begitu.
Dialogue: 0,0:13:38.05,0:13:41.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada Dewa Naga, kan?\NSi Orsted itu.
Dialogue: 0,0:13:41.13,0:13:45.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuan utamanya adalah\Nmenghancurkan dunia ini.
Dialogue: 0,0:13:45.47,0:13:47.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya iya?
Dialogue: 0,0:13:47.02,0:13:51.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku mati, dunia ini akan\Nterpecah-belah dan lenyap.
Dialogue: 0,0:13:51.28,0:13:55.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya Orsted mati-matian ingin membunuhku.
Dialogue: 0,0:13:55.77,0:13:59.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Incar saja Orsted kalau begitu,\Njangan malah aku.
Dialogue: 0,0:13:59.48,0:14:02.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Niatku memang begitu.
Dialogue: 0,0:14:04.37,0:14:06.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemudian muncul dirimu.
Dialogue: 0,0:14:06.24,0:14:08.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya aku kenapa?
Dialogue: 0,0:14:09.18,0:14:11.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski Orsted kuat, tapi dia seorang diri.
Dialogue: 0,0:14:11.53,0:14:14.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia terkena kutukan seperti itu.
Dialogue: 0,0:14:14.07,0:14:17.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau seorang diri,\Ntidak akan bisa menang melawanku.
Dialogue: 0,0:14:17.57,0:14:23.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sepertinya dirimu dan keturunanmu\Ntidak terpengaruh oleh kutukan Orsted.
Dialogue: 0,0:14:23.38,0:14:28.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di masa depan aku akan dikalahkan\Noleh Orsted dan para keturunanmu.
Dialogue: 0,0:14:28.89,0:14:33.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya, makanya kau mengincar\NRoxy yang sedang mengandung.
Dialogue: 0,0:14:35.21,0:14:38.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, tinggal incar saja aku\Ndi saat yang lebih awal lagi.
Dialogue: 0,0:14:38.82,0:14:40.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja sudah kuincar.
Dialogue: 0,0:14:40.67,0:14:44.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja takdirmu itu bukan main kuatnya.
Dialogue: 0,0:14:44.66,0:14:46.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya menyebut takdir?
Dialogue: 0,0:14:47.03,0:14:49.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana aku menjelaskannya, ya?
Dialogue: 0,0:14:49.40,0:14:53.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa melihat beberapa\Ngaris besar masa depan
Dialogue: 0,0:14:53.02,0:14:55.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan bisa mengubahnya dalam batas tertentu.
Dialogue: 0,0:14:55.17,0:14:59.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, orang dengan takdir yang kuat\Ntidak akan berjalan sesuai keinginanku.
Dialogue: 0,0:14:59.50,0:15:01.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, seperti itu.
Dialogue: 0,0:15:01.57,0:15:05.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istri dan keturunanmu juga punya\Ntakdir yang luar biasa kuat.
Dialogue: 0,0:15:05.61,0:15:10.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, ada kalanya takdir seorang wanita\Njadi sedikit mengendur.
Dialogue: 0,0:15:11.18,0:15:12.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang...
Dialogue: 0,0:15:12.90,0:15:17.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, saat sedang mengandung anak\Ndi dalam tubuhnya.
Dialogue: 0,0:15:18.10,0:15:21.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir sudah sempurna.
Dialogue: 0,0:15:21.00,0:15:24.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedikit demi sedikit menyetir\Ndirimu yang punya takdir kuat,
Dialogue: 0,0:15:24.15,0:15:29.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seharusnya itu cara paling efektif\Nuntuk hasil terbaik di saat terlemahmu.
Dialogue: 0,0:15:29.93,0:15:33.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku tidak berniat menyerah\Ndengan ini.
Dialogue: 0,0:15:33.27,0:15:36.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sendiri tidak ingin mati.
Dialogue: 0,0:15:36.06,0:15:38.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, pasti begitu.
Dialogue: 0,0:15:38.58,0:15:41.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, apa tidak ada cara lain?
Dialogue: 0,0:15:41.02,0:15:44.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau demi menyelamatkan keluargaku,\Naku rela melakukan apa saja.
Dialogue: 0,0:15:44.79,0:15:47.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kamu bilang rela melakukan apa saja?
Dialogue: 0,0:15:47.90,0:15:49.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya.
Dialogue: 0,0:15:50.68,0:15:52.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:15:52.61,0:15:55.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunuhlah Orsted.
Dialogue: 0,0:15:56.85,0:15:58.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rudy...
Dialogue: 0,0:15:58.05,0:16:00.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rudy, sesak...
Dialogue: 0,0:16:00.64,0:16:03.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rudy!
Dialogue: 0,0:16:04.53,0:16:06.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesak, Rudy!
Dialogue: 0,0:16:07.07,0:16:08.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf!
Dialogue: 0,0:16:10.31,0:16:12.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak apa-apa?
Dialogue: 0,0:16:12.85,0:16:15.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barusan tadi, apakah mimpi?
Dialogue: 0,0:16:15.87,0:16:18.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, itu bukan mimpi.
Dialogue: 0,0:16:18.20,0:16:20.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak salah lagi itu Dewa Manusia.
Dialogue: 0,0:16:26.30,0:16:29.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Rudy?\NKamu tidak apa-apa?
Dialogue: 0,0:16:33.97,0:16:35.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rudy?
Dialogue: 0,0:16:37.39,0:16:42.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya sekarang aku harus\Nmembunuh seseorang.
Dialogue: 0,0:16:44.95,0:16:48.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya itu, Rudy?
Dialogue: 0,0:16:51.37,0:16:52.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:17:11.58,0:17:13.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membunuh Orsted.
Dialogue: 0,0:17:13.85,0:17:18.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus membunuh dia\Nuntuk melindungi kehidupan keluargaku.
Dialogue: 0,0:17:18.38,0:17:24.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski harus mati bersamanya dan membuat\Nkeluarga yang kutinggal bersedih.
Dialogue: 0,0:17:32.26,0:17:35.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, benar tidak ada yang aneh?
Dialogue: 0,0:17:35.80,0:17:37.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu perbaiki sekarang pun,
Dialogue: 0,0:17:37.30,0:17:40.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nanti tetap berantakan\Ndi jalan menuju Sharia.
Dialogue: 0,0:17:40.37,0:17:41.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:17:41.70,0:17:45.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh iya, aku dengar sedikit gosip\Nsoal pacarmu.
Dialogue: 0,0:17:45.13,0:17:46.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti apa?!
Dialogue: 0,0:17:46.27,0:17:48.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menaklukkan labirin legendaris,
Dialogue: 0,0:17:48.78,0:17:51.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengalahkan Raja Iblis Abadi,
Dialogue: 0,0:17:51.03,0:17:55.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sama gosip bisa seimbang\Nmelawan Tujuh Kekuatan Agung.
Dialogue: 0,0:17:55.10,0:17:58.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat sekali Rudeus,\Nmemang harus begitu!
Dialogue: 0,0:17:58.90,0:18:02.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, kudengar dia suka gadis\Nberdada kecil.
Dialogue: 0,0:18:04.93,0:18:06.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak masalah.
Dialogue: 0,0:18:06.61,0:18:11.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditambah suka main wanita\Ndan selalu ditemani cewek berbeda.
Dialogue: 0,0:18:14.20,0:18:15.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Eris.
Dialogue: 0,0:18:16.01,0:18:20.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa jangan-jangan,\Nkamu sudah dilupakan?
Dialogue: 0,0:18:23.18,0:18:25.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu cuma gosip.
Dialogue: 0,0:18:26.01,0:18:27.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eris!
Dialogue: 0,0:18:28.96,0:18:30.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf menunggu lama.
Dialogue: 0,0:18:30.46,0:18:34.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, yang melepas kepergian kami\Ncuma Nina seorang?
Dialogue: 0,0:18:34.44,0:18:36.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nak Gal kenapa?
Dialogue: 0,0:18:36.70,0:18:41.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru, itu karena Tuan Dewa Pedang\Nlemah dengan miras.
Dialogue: 0,0:18:41.85,0:18:44.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rombongan Isolte mau pulang\Nke Kerajaan Asura, ya?
Dialogue: 0,0:18:44.92,0:18:45.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:18:46.52,0:18:48.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya bakal sepi.
Dialogue: 0,0:18:48.73,0:18:52.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan mampir ke tempat kami\Nbila mengunjungi Kerajaan Asura.
Dialogue: 0,0:18:52.83,0:18:54.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kuantar mengelilingi kota.
Dialogue: 0,0:18:54.74,0:18:59.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, ah, orang udik sepertiku\Nnanti yang ada bakal ditertawakan.
Dialogue: 0,0:18:59.15,0:19:03.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hmph, tinggal hajar saja orang-orang\Nyang menertawakan kita.
Dialogue: 0,0:19:05.67,0:19:08.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa habis kalau kamu yang maju.
Dialogue: 0,0:19:08.20,0:19:10.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar itu, cukup dipukul saja.
Dialogue: 0,0:19:10.71,0:19:11.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:19:11.52,0:19:13.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu maksudku!
Dialogue: 0,0:19:13.73,0:19:15.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, mari segera berangkat.
Dialogue: 0,0:19:15.81,0:19:16.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah...
Dialogue: 0,0:19:16.56,0:19:19.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eris!
Dialogue: 0,0:19:19.43,0:19:21.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada surat dari orang bernama Rudeus!
Dialogue: 0,0:19:21.93,0:19:23.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rudeus!
Dialogue: 0,0:19:43.28,0:19:45.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, apa isi tulisan suratnya?
Dialogue: 0,0:19:45.73,0:19:49.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik kamu, ada banyak huruf\Nyang belum kupelajari!
Dialogue: 0,0:19:49.44,0:19:50.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nina saja yang baca!
Dialogue: 0,0:19:50.71,0:19:53.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, aku saja tidak bisa baca aksara!
Dialogue: 0,0:19:53.97,0:19:57.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, tenang dulu.\NBiar aku yang membacakannya.
Dialogue: 0,0:19:57.59,0:19:58.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong, ya.
Dialogue: 0,0:20:00.03,0:20:05.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepada Nona Eris, lama tidak berjumpa.\NIni dari Rudeus Greyrat.
Dialogue: 0,0:20:06.23,0:20:09.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih ingatkah malam pertama\Nsaat kita bersama?
Dialogue: 0,0:20:09.88,0:20:15.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu, dalam hati saya bersumpah\Nuntuk menikahi Anda hingga akhir hayat.
Dialogue: 0,0:20:15.07,0:20:20.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetapi, saat bangun di pagi hari,\NAnda tidak ada di sisi saya.
Dialogue: 0,0:20:20.13,0:20:26.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kehilangan dan kekosongan dari saat itu\Nmelahirkan kegelapan mendalam di hati saya.
Dialogue: 0,0:20:28.44,0:20:31.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku sudah meninggalkan pesan, lo.
Dialogue: 0,0:20:32.14,0:20:36.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, saya menulis ini karena seseorang
Dialogue: 0,0:20:36.46,0:20:40.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengatakan hati Anda\Nselalu tertuju pada saya.
Dialogue: 0,0:20:40.64,0:20:44.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya pikir saya telah Anda campakkan.
Dialogue: 0,0:20:44.90,0:20:49.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika perasaan Anda masih belum berubah\Nsama seperti dulu,
Dialogue: 0,0:20:49.03,0:20:51.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saya pun siap untuk menerimanya.
Dialogue: 0,0:20:51.98,0:20:58.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetapi, saat ini saya sudah punya dua istri,\Njadi nanti Anda akan menjadi yang ketiga.
Dialogue: 0,0:20:58.73,0:21:00.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila benar-benar tidak terima akan itu,
Dialogue: 0,0:21:00.94,0:21:04.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saya telah membulatkan tekad\Nuntuk menerima tinju Anda.
Dialogue: 0,0:21:04.33,0:21:10.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tidak bisa berkeluarga, saya harap kita\Ndapat berhubungan baik sebagai teman.
Dialogue: 0,0:21:11.21,0:21:12.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekian, dengan penuh hormat.
Dialogue: 0,0:21:13.71,0:21:17.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Parah sekali!\NRasanya dia meremehkan wanita!
Dialogue: 0,0:21:17.45,0:21:19.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa sudah penuh perasaan, kok.
Dialogue: 0,0:21:19.78,0:21:22.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaan?!\NTidak ada kata "cinta" sama sekali, lo!
Dialogue: 0,0:21:22.92,0:21:26.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eris juga salah karena sudah\Nmengabaikannya begitu saja.
Dialogue: 0,0:21:26.01,0:21:28.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti cuma menginginkan tubuh Eris!
Dialogue: 0,0:21:28.53,0:21:31.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau iya, berarti dia\Nsama sekali tidak sayang nyawa, dong.
Dialogue: 0,0:21:31.19,0:21:36.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eris, tidak usah ke Sharia,\Nikut saja ke Asura bersama kami!
Dialogue: 0,0:21:36.82,0:21:38.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih ada selembar lagi, lo.
Dialogue: 0,0:21:38.78,0:21:39.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:21:40.38,0:21:43.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, tambahan.
Dialogue: 0,0:21:43.24,0:21:48.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, saya akan mulai bersiap\Nmenantang Dewa Naga Orsted.
Dialogue: 0,0:21:49.79,0:21:52.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak tahu apakah bisa menang atau tidak.
Dialogue: 0,0:21:52.77,0:21:57.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila berhasil pulang dengan selamat,\Nmari kita teruskan pembahasan kita.
Dialogue: 0,0:22:02.41,0:22:05.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak bergegas,\Nnanti bisa terlambat!
Dialogue: 0,0:22:06.63,0:22:08.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo berangkat, Ghislaine!
Dialogue: 0,0:22:09.71,0:22:11.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati di jalan, ya!
Dialogue: 0,0:22:15.40,0:22:17.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ke sana sekarang!
Dialogue: 0,0:22:17.27,0:22:18.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rudeus!
