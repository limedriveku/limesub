Dialogue: 0,0:22:02.01,0:22:05.01,sign,,0,0,0,,{\pos(960,759)\fs100\b1\bord0\3c&H181D2F&\4c&H000000&\shad3}Benteng Terbang
Dialogue: 0,0:23:35.02,0:23:40.02,sign,,0,0,0,,{\pos(960,338)\fs65\bord0\c&H000A49&\b0}Selanjutnya
Dialogue: 0,0:23:35.02,0:23:40.02,sign,,0,0,0,,{\pos(960,642)\fs100\b1\bord0\c&H000A49&\fad(1500,0)}Tangis Pilu
Dialogue: 0,0:04:38.80,0:04:49.02,sign,,0,0,0,,{\fad(1000,0)\fs100\bord3\shad0\pos(960,154)\c&H0B0C0E&\3c&HFFFFFF&}Mushoku Tensei:\N{\c&H03B7D7&}Jobless Reincarnation {\c&H0B0C0E&}Season 3
Dialogue: 0,0:00:10.36,0:00:13.24,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tetap saja ini tempat yang megah.
Dialogue: 0,0:00:13.24,0:00:19.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}Konon, ini tempat suku manusia berlindung\Ndan bertahan dari invasi suku iblis saat perang.
Dialogue: 0,0:00:19.71,0:00:23.97,Default,,0,0,0,,{\blur3}{\fad(00,40)}Meski akhirnya tidak bisa menandingi\Ndan kemudian ditaklukkan.
Dialogue: 0,0:00:23.97,0:00:25.17,Default,,0,0,0,,{\blur3}{\fad(00,40)}Oh...
Dialogue: 0,0:00:25.17,0:00:27.37,Default,,0,0,0,,{\blur3}{\fad(00,40)}Raja Naga Zirah, Perugius.
Dialogue: 0,0:00:27.37,0:00:30.13,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dia adalah pahlawan Perang Laplace.
Dialogue: 0,0:00:30.81,0:00:33.17,Default,,0,0,0,,{\blur3}{\fad(00,40)}Mengendalikan 12 Roh Panggilan Magis,
Dialogue: 0,0:00:33.17,0:00:35.99,Default,,0,0,0,,{\blur3}{\fad(00,40)}memulihkan benteng terbang kuno,
Dialogue: 0,0:00:35.99,0:00:39.01,Default,,0,0,0,,{\blur3}{\fad(00,40)}dan bersama teman-temannya,\Ndia menyegel Laplace.
Dialogue: 0,0:00:39.01,0:00:44.44,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lalu, untuk menghormati pencapaiannya,\NKalender Naga Zirah pun mulai dipakai.
Dialogue: 0,0:00:44.44,0:00:48.96,Default,,0,0,0,,{\blur3}{\fad(00,40)}Nona Nanahoshi, kuucapkan terima kasih\Nsudah mengizinkan kami turut serta.
Dialogue: 0,0:00:48.96,0:00:51.49,Default,,0,0,0,,{\blur3}{\fad(00,40)}Karena Sylphy sudah banyak membantuku.
Dialogue: 0,0:00:55.74,0:00:57.03,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sudah sampai.
Dialogue: 0,0:01:01.20,0:01:02.75,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kita mau apa di sini?
Dialogue: 0,0:01:02.75,0:01:04.03,Default,,0,0,0,,{\blur3}{\fad(00,40)}Akan kupanggil.
Dialogue: 0,0:01:11.05,0:01:12.80,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak bunyi apa-apa, lo.
Dialogue: 0,0:01:14.77,0:01:16.18,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sudah tiba.
Dialogue: 0,0:01:20.67,0:01:23.40,Default,,0,0,0,,{\blur3}{\fad(00,40)}Almanfi yang Bersinar telah tiba.
Dialogue: 0,0:01:26.23,0:01:27.36,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bukankah dia...?!
Dialogue: 0,0:01:28.40,0:01:32.07,Default,,0,0,0,,{\blur3}{\fad(00,40)}Saat mendengar nama Perugius,\Naku merasa apakah mungkin?
Dialogue: 0,0:01:32.70,0:01:35.03,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jumlahnya tidak masalah, kan?
Dialogue: 0,0:01:35.03,0:01:36.72,Default,,0,0,0,,{\blur3}{\fad(00,40)}Itu tidak masalah.
Dialogue: 0,0:01:36.72,0:01:39.45,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hanya saja, suku iblis tidak boleh ikut.
Dialogue: 0,0:01:39.45,0:01:40.33,Default,,0,0,0,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:01:41.45,0:01:43.43,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sama sekali tidak bisa diakali?
Dialogue: 0,0:01:43.43,0:01:48.09,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tuan Perugius memang murah hati,\Ntapi beliau sangat membenci suku iblis.
Dialogue: 0,0:01:48.09,0:01:52.13,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak apa-apa, aku sudah terbiasa\Ndengan hal seperti ini.
Dialogue: 0,0:01:52.13,0:01:54.14,Default,,0,0,0,,{\blur3}{\fad(00,40)}Nanti biar kumintakan oleh-oleh.
Dialogue: 0,0:01:54.14,0:01:58.51,Default,,0,0,0,,{\blur3}{\fad(00,40)}Asal pulang nanti kamu peluk aku\Ndengan erat, itu sudah cukup.
Dialogue: 0,0:02:01.67,0:02:03.27,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ini apa?
Dialogue: 0,0:02:03.27,0:02:05.36,Default,,0,0,0,,{\blur3}{\fad(00,40)}Cukup pegang saja.
Dialogue: 0,0:02:05.36,0:02:08.09,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sekarang kalian tunggulah sebentar.
Dialogue: 0,0:02:08.97,0:02:10.94,Default,,0,0,0,,{\blur3}{\fad(00,40)}Rasanya membuat hati berdebar, ya.
Dialogue: 0,0:02:10.94,0:02:12.24,Default,,0,0,0,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:02:24.85,0:02:25.76,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lo, heh?!
Dialogue: 0,0:02:41.47,0:02:44.66,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jadi ini sihir teleportasi Perugius?
Dialogue: 0,0:02:44.66,0:02:46.68,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hei, coba lihat!
Dialogue: 0,0:03:00.57,0:03:06.12,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apakah kalian menyukai pemandangan\Ndari benteng terbang kami?
Dialogue: 0,0:03:06.12,0:03:09.95,Default,,0,0,0,,{\blur3}{\fad(00,40)}Saya pelayan Tuan Perugius yang pertama.
Dialogue: 0,0:03:09.95,0:03:12.88,Default,,0,0,0,,{\blur3}{\fad(00,40)}Nama saya Sylvaril sang Hampa.
Dialogue: 0,0:03:12.88,0:03:19.14,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hari ini, izinkan saya memandu Anda sekalian\Nke dalam Benteng Terbang Chaos Breaker.
Dialogue: 0,0:03:25.85,0:03:29.74,Default,,0,0,0,,{\blur3}{\fad(00,40)}♫ Yang bersinar di langit dingin nan jauh
Dialogue: 0,0:03:29.75,0:03:31.52,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lama tidak berjumpa, Sylvaril.
Dialogue: 0,0:03:31.52,0:03:34.21,Default,,0,0,0,,{\blur3}{\fad(00,40)}Iya, saya senang Nona Nanahoshi sehat...
Dialogue: 0,0:03:34.21,0:03:36.33,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sepertinya tidak sehat, ya.
Dialogue: 0,0:03:37.11,0:03:48.21,Default,,0,0,0,,{\blur3}{\fad(00,40)}♫ Adalah dunia yang akan lenyap suatu hari
Dialogue: 0,0:03:48.21,0:03:53.12,Default,,0,0,0,,{\blur3}{\fad(00,40)}♫ Mengapa diri ini terbakar habis
Dialogue: 0,0:03:53.13,0:03:54.25,Default,,0,0,0,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:03:55.54,0:03:57.14,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa ada sesuatu?
Dialogue: 0,0:03:57.14,0:04:00.55,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak, bukan masalah yang berarti.
Dialogue: 0,0:04:00.55,0:04:04.46,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tetapi, apakah saya boleh menanyakan sesuatu?
Dialogue: 0,0:04:04.46,0:04:05.81,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:04:05.81,0:04:10.31,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa Anda pernah dengar nama Dewa Manusia?
Dialogue: 0,0:04:10.31,0:04:15.14,Default,,0,0,0,,{\blur3}{\fad(00,40)}♫ Meski kini cahaya yang indah
Dialogue: 0,0:04:15.15,0:04:17.19,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak, tidak pernah.
Dialogue: 0,0:04:17.19,0:04:19.85,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lalu, apa ada amarah atau niat membunuh
Dialogue: 0,0:04:19.85,0:04:22.80,Default,,0,0,0,,{\blur3}{\fad(00,40)}yang muncul saat mendengar nama itu?
Dialogue: 0,0:04:22.80,0:04:24.24,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak ada.
Dialogue: 0,0:04:24.24,0:04:25.95,Default,,0,0,0,,{\blur3}{\fad(00,40)}Saya juga sama.
Dialogue: 0,0:04:25.95,0:04:30.05,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau begitu, tidak ada yang\Nperlu saya sampaikan.
Dialogue: 0,0:04:32.25,0:04:38.79,Default,,0,0,0,,{\blur3}{\fad(00,40)}♫ Apa yang 'kan ditinggalkan saat pergi
Dialogue: 0,0:04:50.10,0:04:52.52,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa kalian sudah siap?
Dialogue: 0,0:04:52.80,0:04:55.02,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tuan Perugius memanglah murah hati.
Dialogue: 0,0:04:55.51,0:04:58.56,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi, mohon sebisa mungkin\Njangan berbuat lancang.
Dialogue: 0,0:05:26.51,0:05:31.14,Default,,0,0,0,,{\blur3}{\fad(00,40)}Akulah Raja Naga Zirah, Perugius Dola.
Dialogue: 0,0:05:31.49,0:05:34.40,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lama tidak berjumpa, Tuan Perugius.
Dialogue: 0,0:05:34.40,0:05:36.15,Default,,0,0,0,,{\blur3}{\fad(00,40)}Nanahoshi, ya.
Dialogue: 0,0:05:36.15,0:05:42.72,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jika kau kembali kemari, artinya sudah tahu\Nsesuatu soal pemanggilan dari dunia lain.
Dialogue: 0,0:05:42.72,0:05:43.76,Default,,0,0,0,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:05:43.76,0:05:47.19,Default,,0,0,0,,{\blur3}{\fad(00,40)}Meski saya tidak tahu apakah hasilnya\Nsesuai harapan Tuan Perugius...
Dialogue: 0,0:05:47.19,0:05:48.70,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hasil tidaklah penting.
Dialogue: 0,0:05:48.70,0:05:53.29,Default,,0,0,0,,{\blur3}{\fad(00,40)}Eksplorasi pengetahuanlah yang jadi\Ngaris takdir kami, para suku naga.
Dialogue: 0,0:05:53.29,0:05:59.09,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sesuai perjanjian, saya harap bisa diajari\Nmengenai sihir pemanggilan dunia ini.
Dialogue: 0,0:05:59.09,0:06:00.30,Default,,0,0,0,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:06:00.74,0:06:04.43,Default,,0,0,0,,{\blur3}{\fad(00,40)}Omong-omong, kau datang membawa\Nbanyak rombongan.
Dialogue: 0,0:06:04.43,0:06:08.39,Default,,0,0,0,,{\blur3}{\fad(00,40)}Benar, merekalah yang telah\Nmembantu penelitian saya.
Dialogue: 0,0:06:08.39,0:06:12.48,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sebagai imbalannya, mereka ingin\Ndipertemukan dengan Tuan Perugius.
Dialogue: 0,0:06:12.48,0:06:13.81,Default,,0,0,0,,{\blur3}{\fad(00,40)}Oh...
Dialogue: 0,0:06:14.52,0:06:16.73,Default,,0,0,0,,{\blur3}{\fad(00,40)}Senang dapat bertemu dengan Anda.
Dialogue: 0,0:06:16.73,0:06:22.29,Default,,0,0,0,,{\blur3}{\fad(00,40)}Saya putri kedua Kerajaan Asura,\NAriel Anemoi Asura.
Dialogue: 0,0:06:22.29,0:06:24.95,Default,,0,0,0,,{\blur3}{\fad(00,40)}Saya merasa tersanjung dapat\Nbertemu dengan Anda.
Dialogue: 0,0:06:24.95,0:06:27.95,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ariel Anemoi Asura, ya.
Dialogue: 0,0:06:27.95,0:06:30.18,Default,,0,0,0,,{\blur3}{\fad(00,40)}Senang dapat mengenal Anda.
Dialogue: 0,0:06:30.18,0:06:34.99,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apakah kau datang kemari berharap\Nbisa meminjam kekuatanku?
Dialogue: 0,0:06:34.99,0:06:36.17,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:06:36.17,0:06:40.34,Default,,0,0,0,,{\blur3}{\fad(00,40)}Saya hanya ingin bertemu pahlawan\Nyang namanya telah mendunia.
Dialogue: 0,0:06:40.34,0:06:44.87,Default,,0,0,0,,{\blur3}{\fad(00,40)}Niat tersembunyimu terlihat jelas,\NAriel Anemoi Asura.
Dialogue: 0,0:06:47.66,0:06:52.02,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi, kisanak telah datang kemari,\Nitu jugalah takdir.
Dialogue: 0,0:06:52.35,0:06:54.92,Default,,0,0,0,,{\blur3}{\fad(00,40)}Akan kuizinkan kau berada di kastelku.
Dialogue: 0,0:06:54.92,0:06:58.07,Default,,0,0,0,,{\blur3}{\fad(00,40)}Te-Terima kasih atas kemurahan Anda.
Dialogue: 0,0:06:58.07,0:07:00.35,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lalu, kau adalah?
Dialogue: 0,0:07:00.35,0:07:04.78,Default,,0,0,0,,{\blur3}{\fad(00,40)}Senang bertemu dengan Anda,\Nnama saya Rudeus Greyrat.
Dialogue: 0,0:07:04.78,0:07:07.09,Default,,0,0,0,,{\blur3}{\fad(00,40)}Rudeus Greyrat.
Dialogue: 0,0:07:07.09,0:07:11.29,Default,,0,0,0,,{\blur3}{\fad(00,40)}Memindahkanmu sesungguhnya\Ncukup merepotkanku.
Dialogue: 0,0:07:11.58,0:07:16.54,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bila kisanak melawan dengan serius,\Npasti tidak akan bisa diteleportasi kemari.
Dialogue: 0,0:07:17.53,0:07:20.54,Default,,0,0,0,,{\blur3}{\fad(00,40)}Mohon maaf telah merepotkan seperti itu.
Dialogue: 0,0:07:20.80,0:07:21.89,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak masalah.
Dialogue: 0,0:07:21.89,0:07:25.54,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tetapi, daya sihir kisanak punya kemiripan\Ndengan milik Laplace.
Dialogue: 0,0:07:25.54,0:07:27.85,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jangan coba-coba memakai daya sihir
Dialogue: 0,0:07:27.85,0:07:31.05,Default,,0,0,0,,{\blur3}{\fad(00,40)}dengan jumlah menjijikkan itu\Ndi dalam kastel ini.
Dialogue: 0,0:07:36.25,0:07:40.33,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tentu, saya tidak akan coba-coba melawan.
Dialogue: 0,0:07:40.33,0:07:45.13,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tuan Perugius, dia telah berjasa besar\Npada penelitian saya.
Dialogue: 0,0:07:45.13,0:07:47.74,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dapatkah Anda lebih berbaik hati padanya?
Dialogue: 0,0:07:49.47,0:07:51.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau begitu, aku akan berbaik hati.
Dialogue: 0,0:07:51.71,0:07:55.87,Default,,0,0,0,,{\blur3}{\fad(00,40)}Wahai rekan Nanahoshi,\Napa yang kisanak inginkan?
Dialogue: 0,0:07:56.33,0:07:59.08,Default,,0,0,0,,{\blur3}{\fad(00,40)}Uang, ataukah kekuatan?
Dialogue: 0,0:07:59.59,0:08:02.46,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau begitu, ada satu hal\Nyang ingin saya tanyakan.
Dialogue: 0,0:08:04.59,0:08:07.92,Default,,0,0,0,,{\blur3}{\fad(00,40)}Begitu rupanya, penyakit ibumu, ya.
Dialogue: 0,0:08:07.92,0:08:09.76,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kudengar ada labirin kuno yang
Dialogue: 0,0:08:09.76,0:08:13.98,Default,,0,0,0,,{\blur3}{\fad(00,40)}bisa menangkap manusia dan\Nmemfungsikannya sebagai jantung.
Dialogue: 0,0:08:14.58,0:08:17.81,Default,,0,0,0,,{\blur3}{\fad(00,40)}Mereka yang jadi jantung akan\Nberubah oleh daya sihir.
Dialogue: 0,0:08:17.81,0:08:20.31,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kehilangan ingatan tanpa terkecuali.
Dialogue: 0,0:08:20.31,0:08:24.40,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lalu, akan memiliki kekuatan misterius\Ndi dalam raganya.
Dialogue: 0,0:08:24.40,0:08:26.21,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kekuatan misterius?
Dialogue: 0,0:08:26.21,0:08:31.21,Default,,0,0,0,,{\blur3}{\fad(00,40)}Merekalah orang-orang dengan kekuatan\Nyang disebut Anak Terkutuk atau Anak Dewa.
Dialogue: 0,0:08:31.21,0:08:33.40,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku juga tidak tahu detailnya.
Dialogue: 0,0:08:33.40,0:08:38.44,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hanya saja, aku tahu seorang wanita\Nyang dulunya mengalami takdir serupa.
Dialogue: 0,0:08:40.66,0:08:43.28,Default,,0,0,0,,{\blur3}{\fad(00,40)}Elinalise Dragonroad.
Dialogue: 0,0:08:43.98,0:08:46.59,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau tidak salah 200 tahun lalu kisanak
Dialogue: 0,0:08:46.59,0:08:51.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}seharusnya telah diselamatkan\Noleh kawanku dari Labirin Bau.
Dialogue: 0,0:08:51.85,0:08:53.55,Default,,0,0,0,,{\blur3}{\fad(00,40)}Itu benar.
Dialogue: 0,0:08:53.55,0:08:55.65,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kenapa tidak kau ceritakan?
Dialogue: 0,0:08:55.65,0:08:59.94,Default,,0,0,0,,{\blur3}{\fad(00,40)}Karena ikut menemani kemari,\Nbukankah artinya kalian saling kenal?
Dialogue: 0,0:09:00.33,0:09:01.84,Default,,0,0,0,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:09:09.82,0:09:11.79,Default,,0,0,0,,{\blur3}{\fad(00,40)}Maaf, Rudeus.
Dialogue: 0,0:09:11.79,0:09:15.62,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku merasa harus menceritakannya,\Ntapi kemudian jadi ragu.
Dialogue: 0,0:09:16.05,0:09:19.25,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tolong nanti jelaskan detailnya.
Dialogue: 0,0:09:22.30,0:09:24.13,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apakah ada yang lain?
Dialogue: 0,0:09:24.13,0:09:26.99,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau begitu, bolehkah diriku ikut bertanya?
Dialogue: 0,0:09:26.99,0:09:28.18,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kisanak adalah?
Dialogue: 0,0:09:28.18,0:09:29.72,Default,,0,0,0,,{\blur3}{\fad(00,40)}Maaf terlambat menjelaskan.
Dialogue: 0,0:09:29.72,0:09:34.26,Default,,0,0,0,,{\blur3}{\fad(00,40)}Saya Zanoba Shirone,\Npangeran ketiga Kerajaan Shirone.
Dialogue: 0,0:09:34.26,0:09:37.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apakah kisanak juga menginginkan\Nbantuan dalam perebutan takhta?
Dialogue: 0,0:09:37.71,0:09:40.52,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak, itu sama sekali tidak saya pedulikan.
Dialogue: 0,0:09:40.52,0:09:43.40,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lambang ini sangat mirip dengan yang terdapat
Dialogue: 0,0:09:43.40,0:09:47.77,Default,,0,0,0,,{\blur3}{\fad(00,40)}pada gerbang di luar kastel serta\Ndinding di situ, apa Anda mengetahuinya?
Dialogue: 0,0:09:47.77,0:09:51.70,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku tahu, itu milik Raja Naga Gila, Chaos.
Dialogue: 0,0:09:51.70,0:09:55.41,Default,,0,0,0,,{\blur3}{\fad(00,40)}Oh, lalu Tuan Chaos tersebut\Nsekarang berada di mana?!
Dialogue: 0,0:09:55.73,0:09:57.16,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sudah mati.
Dialogue: 0,0:09:59.16,0:10:02.54,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ja-Jadi begitu...
Dialogue: 0,0:10:02.54,0:10:04.47,Default,,0,0,0,,{\blur3}{\fad(00,40)}Itu beberapa dekade lalu.
Dialogue: 0,0:10:04.47,0:10:07.33,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku tidak tahu ada penerusnya atau tidak.
Dialogue: 0,0:10:07.33,0:10:10.42,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tetapi, di mana kisanak menemukan itu?
Dialogue: 0,0:10:10.42,0:10:13.72,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ini ada di sebelah patung yang\Ndapat bergerak sendiri
Dialogue: 0,0:10:13.72,0:10:16.76,Default,,0,0,0,,{\blur3}{\fad(00,40)}yang saya temukan di rumah kosong\Ndi Kota Sihir Sharia.
Dialogue: 0,0:10:16.76,0:10:20.45,Default,,0,0,0,,{\blur3}{\fad(00,40)}Begitu rupanya, patung yang\Nbisa bergerak sendiri, ya.
Dialogue: 0,0:10:20.45,0:10:22.77,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apakah itu benda yang luar biasa?
Dialogue: 0,0:10:22.77,0:10:24.43,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tentu saja itu!
Dialogue: 0,0:10:24.43,0:10:27.46,Default,,0,0,0,,{\blur3}{\fad(00,40)}Teknik yang terukir di tiap detailnya\Nmembuat saya terus jatuh hati.
Dialogue: 0,0:10:27.46,0:10:32.44,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sangat terasa bahwa beliau\Nbegitu mencintai patung tersebut!
Dialogue: 0,0:10:34.17,0:10:37.57,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sepertinya kisanak mengerti seni.
Dialogue: 0,0:10:37.57,0:10:42.76,Default,,0,0,0,,{\blur3}{\fad(00,40)}Baiklah, di ruang harta kastel ini\Nada beberapa karya ciptaan Chaos.
Dialogue: 0,0:10:42.76,0:10:44.54,Default,,0,0,0,,{\blur3}{\fad(00,40)}Biar nanti kutunjukkan padamu.
Dialogue: 0,0:10:44.54,0:10:47.56,Default,,0,0,0,,{\blur3}{\fad(00,40)}Oh, sebuah kebahagiaan yang patut disyukuri.
Dialogue: 0,0:10:48.10,0:10:51.25,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa aku... apakah saya juga boleh\Nmenanyakan sesuatu?
Dialogue: 0,0:10:51.25,0:10:52.75,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kisanak adalah?
Dialogue: 0,0:10:52.75,0:10:56.64,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pengawal Putri Ariel sebagai\Nputri kedua Kerajaan Asura,
Dialogue: 0,0:10:56.64,0:11:01.64,Default,,0,0,0,,{\blur3}{\fad(00,40)}serta istri dari Rudeus Greyrat,\Nnama saya Sylphiette Greyrat.
Dialogue: 0,0:11:02.64,0:11:04.77,Default,,0,0,0,,{\blur3}{\fad(00,40)}Suami istri datang berdua, ya.
Dialogue: 0,0:11:05.10,0:11:07.60,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sebelum ke pertanyaanmu, jawablah sesuatu.
Dialogue: 0,0:11:07.60,0:11:09.79,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa kalian punya putra?
Dialogue: 0,0:11:09.79,0:11:12.90,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ah, tidak, kami cuma punya putri.
Dialogue: 0,0:11:12.90,0:11:18.03,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bila kalian dapat seorang putra,\Nbawalah ke hadapanku.
Dialogue: 0,0:11:18.03,0:11:20.39,Default,,0,0,0,,{\blur3}{\fad(00,40)}Akan kuberikan nama padanya.
Dialogue: 0,0:11:20.39,0:11:21.55,Default,,0,0,0,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:11:21.55,0:11:24.26,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lalu, apa pertanyaanmu?
Dialogue: 0,0:11:24.26,0:11:27.36,Default,,0,0,0,,{\blur3}{\fad(00,40)}Saya ingin bertanya mengenai\Nbencana teleportasi.
Dialogue: 0,0:11:27.36,0:11:31.42,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pada akhirnya, siapa yang telah\Nmenyebabkan bencana tersebut?
Dialogue: 0,0:11:31.42,0:11:33.29,Default,,0,0,0,,{\blur3}{\fad(00,40)}Masih belum jelas.
Dialogue: 0,0:11:33.29,0:11:37.68,Default,,0,0,0,,{\blur3}{\fad(00,40)}Awalnya kukira ulah Laplace\Natau orang yang terkait dengannya.
Dialogue: 0,0:11:38.01,0:11:41.81,Default,,0,0,0,,{\blur3}{\fad(00,40)}Namun, bahkan aku sendiri mustahil\Nuntuk memanggil Nanahoshi.
Dialogue: 0,0:11:41.81,0:11:46.88,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jika demikian, tidak ada seorang pun\Ndi dunia ini yang mampu melakukannya.
Dialogue: 0,0:11:46.88,0:11:48.23,Default,,0,0,0,,{\blur3}{\fad(00,40)}Berarti...
Dialogue: 0,0:11:48.23,0:11:50.88,Default,,0,0,0,,{\blur3}{\fad(00,40)}Itu bukanlah sesuatu yang\Ndisebabkan manusia.
Dialogue: 0,0:11:50.88,0:11:53.32,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sesuatu yang terjadi secara kebetulan.
Dialogue: 0,0:11:53.73,0:11:56.01,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jadi, begitu...
Dialogue: 0,0:11:56.01,0:11:57.74,Default,,0,0,0,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:11:57.74,0:11:59.59,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa ada yang lain?
Dialogue: 0,0:12:00.99,0:12:06.48,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau begitu, nikmatilah dengan santai\Nbenteng terbang kebanggaanku ini.
Dialogue: 0,0:12:08.02,0:12:09.46,Default,,0,0,0,,{\blur3}{\fad(00,40)}Silakan.
Dialogue: 0,0:12:09.46,0:12:11.14,Default,,0,0,0,,{\blur3}{\fad(00,40)}Terima kasih banyak, ya.
Dialogue: 0,0:12:11.14,0:12:11.96,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak masalah.
Dialogue: 0,0:12:14.52,0:12:18.90,Default,,0,0,0,,{\blur3}{\fad(00,40)}Diriku saat diselamatkan dari labirin\Nsekitar 200 tahun lalu,
Dialogue: 0,0:12:18.90,0:12:21.85,Default,,0,0,0,,{\blur3}{\fad(00,40)}kehilangan ingatan dan emosi.
Dialogue: 0,0:12:22.40,0:12:26.56,Default,,0,0,0,,{\blur3}{\fad(00,40)}Permukiman elf yang kemudian\Njadi tempatku dititipkan,
Dialogue: 0,0:12:26.56,0:12:30.98,Default,,0,0,0,,{\blur3}{\fad(00,40)}mau menerimaku dengan baik\Nmeski bukan kerabat mereka.
Dialogue: 0,0:12:31.34,0:12:34.49,Default,,0,0,0,,{\blur3}{\fad(00,40)}Entah berkat hal itu atau bukan.
Dialogue: 0,0:12:34.49,0:12:37.56,Default,,0,0,0,,{\blur3}{\fad(00,40)}Beberapa tahun kemudian emosiku kembali
Dialogue: 0,0:12:37.56,0:12:40.33,Default,,0,0,0,,{\blur3}{\fad(00,40)}lalu menjalin ikatan dengan\Npria dari permukiman itu.
Dialogue: 0,0:12:40.82,0:12:43.49,Default,,0,0,0,,{\blur3}{\fad(00,40)}Meski ingatanku tidak kembali,
Dialogue: 0,0:12:43.49,0:12:45.83,Default,,0,0,0,,{\blur3}{\fad(00,40)}tapi aku tetap bahagia.
Dialogue: 0,0:12:46.88,0:12:51.35,Default,,0,0,0,,{\blur3}{\fad(00,40)}Baru sejak itu, kutukanku mulai\Nmuncul ke permukaan.
Dialogue: 0,0:12:51.35,0:12:55.00,Default,,0,0,0,,{\blur3}{\fad(00,40)}Seolah tiap malam selalu minta diladeni.
Dialogue: 0,0:12:55.34,0:13:02.32,Default,,0,0,0,,{\blur3}{\fad(00,40)}Terlebih, sekali tiap bulannya badanku\Nmulai mengeluarkan kristal daya sihir kecil.
Dialogue: 0,0:13:02.32,0:13:04.80,Default,,0,0,0,,{\blur3}{\fad(00,40)}Awalnya memang mengerikan,
Dialogue: 0,0:13:04.80,0:13:08.52,Default,,0,0,0,,{\blur3}{\fad(00,40)}tapi nyatanya hal ini jadi membantu\Nkeuangan rumah tangga.
Dialogue: 0,0:13:08.93,0:13:10.45,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tetapi, pada suatu hari,
Dialogue: 0,0:13:10.45,0:13:17.28,Default,,0,0,0,,{\blur3}{\fad(00,40)}suamiku yang pergi menjual kristal daya sihir\Ndiserang oleh bandit dan kehilangan nyawanya.
Dialogue: 0,0:13:17.63,0:13:23.80,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lalu, aku memutuskan hidup sendiri dengan\Nmenyimpan kenangan bersama suamiku di dada.
Dialogue: 0,0:13:23.80,0:13:27.35,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hanya saja, kutukanku tidak mengizinkannya.
Dialogue: 0,0:13:27.35,0:13:33.29,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku tidak bisa menahan dorongannya,\Nlalu memburu pria permukiman satu per satu.
Dialogue: 0,0:13:33.69,0:13:39.55,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku yang terus lepas kendali seperti itu,\Nkemudian diusir dari permukiman.
Dialogue: 0,0:13:39.80,0:13:42.83,Default,,0,0,0,,{\blur3}{\fad(00,40)}Memang banyak yang terjadi setelah itu,
Dialogue: 0,0:13:42.83,0:13:47.01,Default,,0,0,0,,{\blur3}{\fad(00,40)}tapi sekarang aku hidup\Nsebagai petualang seperti ini.
Dialogue: 0,0:13:47.68,0:13:51.31,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kurang lebih seperti itulah kisah hidupku.
Dialogue: 0,0:13:53.08,0:13:58.36,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sejak itu aku mulai beradaptasi dengan kutukan\Ndan menikmati pertemuan dengan para pria.
Dialogue: 0,0:13:58.36,0:14:01.53,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tentunya, sekarang aku\Nakan setia pada Cliff seorang.
Dialogue: 0,0:14:03.34,0:14:06.16,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ingatanmu tidak kembali, ya?
Dialogue: 0,0:14:06.16,0:14:08.57,Default,,0,0,0,,{\blur3}{\fad(00,40)}Iya, bahkan sampai sekarang.
Dialogue: 0,0:14:08.57,0:14:13.21,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi, kondisi Zenith jauh berbeda denganku.
Dialogue: 0,0:14:13.21,0:14:15.97,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kemungkinan terkena kutukan yang lain.
Dialogue: 0,0:14:15.97,0:14:17.51,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kamu bisa tahu?
Dialogue: 0,0:14:17.51,0:14:20.17,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hanya firasatku.
Dialogue: 0,0:14:20.17,0:14:22.99,Default,,0,0,0,,{\blur3}{\fad(00,40)}Yang jelas jangan sampai lengah.
Dialogue: 0,0:14:22.99,0:14:26.30,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pada akhirnya sekarang\Ncuma bisa memantau kondisi, ya.
Dialogue: 0,0:14:26.30,0:14:29.93,Default,,0,0,0,,{\blur3}{\fad(00,40)}Maaf, aku terlambat menyampaikan ini.
Dialogue: 0,0:14:29.93,0:14:34.22,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sudah, aku juga tidak enak sudah minta\Ndiceritakan kisah tidak mengenakkan.
Dialogue: 0,0:14:34.22,0:14:38.32,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku juga sangat mengerti rasanya\Ntidak ingin menceritakan masa lalu.
Dialogue: 0,0:14:38.60,0:14:42.03,Default,,0,0,0,,{\blur3}{\fad(00,40)}Makanya, aku tidak akan menyalahkannya.
Dialogue: 0,0:14:48.97,0:14:50.79,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sudah berkumpul, ya?
Dialogue: 0,0:14:50.79,0:14:54.41,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau begitu,\Nizinkan saya mulai pelajarannya.
Dialogue: 0,0:14:54.91,0:14:57.59,Default,,0,0,0,,{\blur3}{\fad(00,40)}Meski tidak ada kemajuan soal Zenith,
Dialogue: 0,0:14:57.59,0:15:00.67,Default,,0,0,0,,{\blur3}{\fad(00,40)}tapi ada hasil lain yang didapat\Ndari tempat tidak terduga.
Dialogue: 0,0:15:00.67,0:15:06.68,Default,,0,0,0,,{\blur3}{\fad(00,40)}Nanahoshi berbaik hati mengizinkan kami\Nmengikuti pelajaran sihir pemanggilan.
Dialogue: 0,0:15:06.68,0:15:09.43,Default,,0,0,0,,{\blur3}{\fad(00,40)}Walau baru diajari bagian dasarnya,
Dialogue: 0,0:15:09.43,0:15:11.93,Default,,0,0,0,,{\blur3}{\fad(00,40)}tapi keseruannya baru dimulai.
Dialogue: 0,0:15:15.10,0:15:17.65,Default,,0,0,0,,{\blur3}{\fad(00,40)}Mungkin sudah saatnya istirahat.
Dialogue: 0,0:15:17.65,0:15:20.52,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa Anda sekalian ingin makan sesuatu?
Dialogue: 0,0:15:21.67,0:15:23.19,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa saja boleh.
Dialogue: 0,0:15:23.19,0:15:25.74,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa bisa menyajikan makanan Milis?
Dialogue: 0,0:15:25.74,0:15:30.53,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bisa, meski tidak punya bahan-bahannya,\Nbiar Almanfi yang mencarikan.
Dialogue: 0,0:15:30.53,0:15:35.29,Default,,0,0,0,,{\blur3}{\fad(00,40)}Memangnya boleh diperlakukan\Nseperti pesuruh serbacepat begitu?
Dialogue: 0,0:15:35.60,0:15:38.67,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tunggu, mungkin ini kesempatan.
Dialogue: 0,0:15:43.17,0:15:45.43,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa tidak masalah dengan seperti ini?
Dialogue: 0,0:15:45.43,0:15:47.34,Default,,0,0,0,,{\blur3}{\fad(00,40)}Iya, sudah sempurna!
Dialogue: 0,0:15:47.34,0:15:51.03,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sekali-kali pengin makan yang begini, kan?
Dialogue: 0,0:15:51.03,0:15:53.24,Default,,0,0,0,,{\blur3}{\fad(00,40)}Yah, benar juga.
Dialogue: 0,0:15:54.31,0:15:57.08,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sekarang, tangkupkan tangan.
Dialogue: 0,0:15:58.32,0:15:59.63,Default,,0,0,0,,{\blur3}{\fad(00,40)}Selamat makan.
Dialogue: 0,0:16:00.01,0:16:01.69,Default,,0,0,0,,{\blur3}{\fad(00,40)}Selamat makan.
Dialogue: 0,0:16:03.79,0:16:07.17,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku sudah minta dicarikan apakah\Ndi dunia ini ada shoyu,
Dialogue: 0,0:16:07.17,0:16:09.20,Default,,0,0,0,,{\blur3}{\fad(00,40)}tapi memang tidak ketemu.
Dialogue: 0,0:16:09.20,0:16:15.83,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi, sebagai gantinya dibawakan olahan\Nfermentasi kacang dari Kerajaan Biheiril.
Dialogue: 0,0:16:15.83,0:16:20.46,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kemudian aku minta dibuatkan\Nset menu jejepangan dari itu semua.
Dialogue: 0,0:16:22.27,0:16:25.59,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sup miso ini saja tidak ada kaldu dasarnya.
Dialogue: 0,0:16:32.60,0:16:35.30,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sebenarnya memang tidak enak.
Dialogue: 0,0:16:35.83,0:16:40.34,Default,,0,0,0,,{\blur3}{\fad(00,40)}Makanan Jepang yang di ingatan kami\Nseharusnya punya rasa yang lebih halus.
Dialogue: 0,0:16:41.12,0:16:44.66,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hanya saja, tangan kami tidak mau berhenti.
Dialogue: 0,0:16:48.82,0:16:51.61,Default,,0,0,0,,{\blur3}{\fad(00,40)}Terima kasih atas hidangannya.
Dialogue: 0,0:16:57.79,0:17:00.98,Default,,0,0,0,,{\blur3}{\fad(00,40)}Meski begitu, kastel ini memang luas.
Dialogue: 0,0:17:00.98,0:17:06.84,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku masih tetap tercengang kalau\Nbangunan sebesar ini bisa terbang di udara.
Dialogue: 0,0:17:11.10,0:17:12.58,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sedang menjelajah?
Dialogue: 0,0:17:13.42,0:17:14.79,Default,,0,0,0,,{\blur3}{\fad(00,40)}Rudeus, ya?
Dialogue: 0,0:17:14.79,0:17:17.02,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kami penasaran apa yang ada di depan sana.
Dialogue: 0,0:17:17.02,0:17:19.67,Default,,0,0,0,,{\blur3}{\fad(00,40)}Oh, kelihatannya menarik.
Dialogue: 0,0:17:19.67,0:17:21.10,Default,,0,0,0,,{\blur3}{\fad(00,40)}Biar ikut kutemani.
Dialogue: 0,0:17:21.10,0:17:22.56,Default,,0,0,0,,{\blur3}{\fad(00,40)}Itu memang akan membantu,
Dialogue: 0,0:17:22.95,0:17:25.44,Default,,0,0,0,,{\blur3}{\fad(00,40)}tapi kami ragu apa boleh\Ndimasuki sembarangan.
Dialogue: 0,0:17:25.44,0:17:28.19,Default,,0,0,0,,{\blur3}{\fad(00,40)}Wah, kalau itu bagaimana, ya.
Dialogue: 0,0:17:28.19,0:17:29.69,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak masalah, kok.
Dialogue: 0,0:17:29.69,0:17:31.68,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kamu pernah masuk ke sana?
Dialogue: 0,0:17:31.68,0:17:35.20,Default,,0,0,0,,{\blur3}{\fad(00,40)}Iya, walau sebagian besar\Nruangannya terkunci,
Dialogue: 0,0:17:35.20,0:17:38.18,Default,,0,0,0,,{\blur3}{\fad(00,40)}tapi ada sesuatu yang menarik.
Dialogue: 0,0:17:41.58,0:17:44.27,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ini yang kamu bilang menarik?
Dialogue: 0,0:17:44.27,0:17:46.84,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bukan, tapi di balik sini.
Dialogue: 0,0:17:48.95,0:17:51.87,Default,,0,0,0,,{\blur3}{\fad(00,40)}Meski tidak pantas untuk usiaku,\Ntapi ini membuat hatiku berdebar!
Dialogue: 0,0:17:51.87,0:17:52.81,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku juga!
Dialogue: 0,0:17:52.81,0:17:54.05,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku juga sama!
Dialogue: 0,0:17:54.05,0:17:56.80,Default,,0,0,0,,{\blur3}{\fad(00,40)}Cowok memang suka beginian, ya.
Dialogue: 0,0:18:07.92,0:18:10.54,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ini sangat luar biasa!
Dialogue: 0,0:18:10.54,0:18:13.74,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lukisan relief, ya?\NKelihatannya sangat tua.
Dialogue: 0,0:18:14.77,0:18:19.12,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kisah yang terlukis di sini\Nrasanya pernah kulihat di suatu tempat.
Dialogue: 0,0:18:19.12,0:18:22.16,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku juga sama, tapi apa, ya?
Dialogue: 0,0:18:23.67,0:18:25.42,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sedang apa kalian?
Dialogue: 0,0:18:26.92,0:18:29.12,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tuan Perugius.
Dialogue: 0,0:18:29.88,0:18:32.05,Default,,0,0,0,,{\blur3}{\fad(00,40)}Cukup, berdirilah.
Dialogue: 0,0:18:32.05,0:18:35.17,Default,,0,0,0,,{\blur3}{\fad(00,40)}Benteng terbang Tuan Perugius\Nmemanglah luar biasa.
Dialogue: 0,0:18:35.17,0:18:38.51,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bahkan di tempat seperti ini\Npunya sesuatu yang menggetarkan hati.
Dialogue: 0,0:18:38.86,0:18:43.95,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi, sepertinya kami sangat lancang\Nsudah masuk kemari dengan seenaknya.
Dialogue: 0,0:18:43.95,0:18:45.15,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak masalah.
Dialogue: 0,0:18:45.57,0:18:50.15,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lukisan relief ini bukan sesuatu yang\Ndisiapkan atas seleraku.
Dialogue: 0,0:18:50.15,0:18:52.45,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa maksud Anda?
Dialogue: 0,0:18:52.45,0:18:58.45,Default,,0,0,0,,{\blur3}{\fad(00,40)}Saat mendapatkan benteng terbang ini,\Nhampir tidak ada yang tersisa di dalamnya.
Dialogue: 0,0:18:58.74,0:19:04.23,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tetapi, lukisan relief ini masih tersisa\Ndengan kondisi sempurna seperti sekarang.
Dialogue: 0,0:19:04.23,0:19:08.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}Meski lainnya menjadi sampah debu,\Ntapi hanya lukisan ini yang tidak.
Dialogue: 0,0:19:09.32,0:19:11.97,Default,,0,0,0,,{\blur3}{\fad(00,40)}Di sana pun aku melihat\Npemikiran dari pendahulu.
Dialogue: 0,0:19:11.97,0:19:16.72,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kejadian ini harus disampaikan\Npada anak cucu.
Dialogue: 0,0:19:16.72,0:19:19.34,Default,,0,0,0,,{\blur3}{\fad(00,40)}Saya bisa merasakan romansa\Nyang begitu mendalam.
Dialogue: 0,0:19:19.34,0:19:24.10,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku juga ingin berpikiran seperti itu,\Ntapi aku tidak suka lukisan relief ini.
Dialogue: 0,0:19:24.10,0:19:29.73,Default,,0,0,0,,{\blur3}{\fad(00,40)}Entah kenapa ada perasaan sesak,\Nputus asa, dan rasa muak mendalam di dada.
Dialogue: 0,0:19:29.73,0:19:34.11,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau begitu, sebaiknya kita\Ntidak berlama-lama di sini.
Dialogue: 0,0:19:36.11,0:19:39.43,Default,,0,0,0,,{\blur3}{\fad(00,40)}Almanfi, antarlah mereka semua.
Dialogue: 0,0:19:39.43,0:19:40.37,Default,,0,0,0,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:19:51.09,0:19:53.93,Default,,0,0,0,,{\blur3}{\fad(00,40)}Putri Ariel bagaimana?
Dialogue: 0,0:19:54.79,0:19:56.72,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kelihatannya sedikit sulit.
Dialogue: 0,0:19:57.01,0:20:02.01,Default,,0,0,0,,{\blur3}{\fad(00,40)}Meski didekati dengan tawaran diberi\Ngelar bangsawan atau diberikan wilayah.
Dialogue: 0,0:20:02.01,0:20:04.38,Default,,0,0,0,,{\blur3}{\fad(00,40)}"Aku tidak butuh hal seperti itu," katanya.
Dialogue: 0,0:20:04.38,0:20:05.93,Default,,0,0,0,,{\blur3}{\fad(00,40)}Beliau seorang pahlawan.
Dialogue: 0,0:20:05.93,0:20:08.63,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dipancing seperti itu bukankah\Nakan berefek sebaliknya?
Dialogue: 0,0:20:08.63,0:20:10.06,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sepertinya iya.
Dialogue: 0,0:20:10.46,0:20:12.23,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau Rudy akan bagaimana?
Dialogue: 0,0:20:12.49,0:20:15.00,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pertama mungkin mencoba\Nakrab dulu dengan beliau.
Dialogue: 0,0:20:15.00,0:20:18.14,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tanya soal hobi atau kisah heroik misalnya.
Dialogue: 0,0:20:18.14,0:20:22.45,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau kenalan meminta sesuatu,\Nkamu pasti ingin mengusahakannya, kan?
Dialogue: 0,0:20:22.45,0:20:25.33,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dipikir-pikir lagi, mungkin begitu.
Dialogue: 0,0:20:25.33,0:20:28.37,Default,,0,0,0,,{\blur3}{\fad(00,40)}Terima kasih, biar coba kusampaikan\Nke Putri Ariel.
Dialogue: 0,0:20:28.37,0:20:30.25,Default,,0,0,0,,{\blur3}{\fad(00,40)}Rudy sendiri bagaimana?
Dialogue: 0,0:20:30.25,0:20:32.55,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sepertinya baru mulai.
Dialogue: 0,0:20:32.55,0:20:35.55,Default,,0,0,0,,{\blur3}{\fad(00,40)}Belajar sihir pemanggilan\Nbersama Nanahoshi dan yang lain.
Dialogue: 0,0:20:35.55,0:20:39.97,Default,,0,0,0,,{\blur3}{\fad(00,40)}Oh iya, saat makan siang, aku minta dibuatkan\Nmakanan dari kampung halaman Nanahoshi.
Dialogue: 0,0:20:39.97,0:20:42.00,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sayangnya sama sekali tidak enak.
Dialogue: 0,0:20:42.00,0:20:44.76,Default,,0,0,0,,{\blur3}{\fad(00,40)}Rudy, kamu akur sekali sama Nanahoshi.
Dialogue: 0,0:20:46.39,0:20:50.52,Default,,0,0,0,,{\blur3}{\fad(00,40)}Eh?! A-Aku sama sekali\Ntidak ada perasaan begitu sama dia!
Dialogue: 0,0:20:50.52,0:20:52.55,Default,,0,0,0,,{\blur3}{\fad(00,40)}Percayalah padaku!
Dialogue: 0,0:20:54.05,0:20:57.36,Default,,0,0,0,,{\blur3}{\fad(00,40)}Maaf, maaf, aku cuma ingin\Nsedikit menjahilimu.
Dialogue: 0,0:20:57.36,0:20:58.90,Default,,0,0,0,,{\blur3}{\fad(00,40)}O-Oalah.
Dialogue: 0,0:20:59.17,0:21:02.47,Default,,0,0,0,,{\blur3}{\fad(00,40)}Harus hati-hati membahas Nanahoshi\Ndi depan Sylphy.
Dialogue: 0,0:21:05.25,0:21:06.49,Default,,0,0,0,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:21:07.41,0:21:09.05,Default,,0,0,0,,{\blur3}{\fad(00,40)}Nanahoshi?!
Dialogue: 0,0:21:10.71,0:21:13.79,Default,,0,0,0,,{\blur3}{\fad(00,40)}Maaf, apa kalian sedang sibuk?
Dialogue: 0,0:21:14.05,0:21:15.73,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sebenarnya tidak masalah.
Dialogue: 0,0:21:15.73,0:21:17.64,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hei, kamu tidak apa-apa?
Dialogue: 0,0:21:17.64,0:21:20.05,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku ingin minta dirapalkan penawar racun.
Dialogue: 0,0:21:20.05,0:21:21.43,Default,,0,0,0,,{\blur3}{\fad(00,40)}Biar kurapalkan.
Dialogue: 0,0:21:21.43,0:21:22.79,Default,,0,0,0,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:21:22.79,0:21:24.80,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi, kalau tidak kunjung membaik,
Dialogue: 0,0:21:24.80,0:21:27.56,Default,,0,0,0,,{\blur3}{\fad(00,40)}mungkin sebaiknya minta dirapalkan\Nsihir tingkat atas sama Cliff.
Dialogue: 0,0:21:29.22,0:21:31.81,Default,,0,0,0,,{\blur3}{\fad(00,40)}Eh, terasa ada yang aneh.
Dialogue: 0,0:21:32.15,0:21:34.06,Default,,0,0,0,,{\blur3}{\fad(00,40)}Entah kenapa daya sihirnya...
Dialogue: 0,0:21:40.33,0:21:41.99,Default,,0,0,0,,{\blur3}{\fad(00,40)}Nanahoshi?!
Dialogue: 0,0:21:43.50,0:21:44.41,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hei...
Dialogue: 0,0:21:52.25,0:21:54.50,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bukan, ini bukan ulahku...
Dialogue: 0,0:21:55.11,0:21:56.38,Default,,0,0,0,,{\blur3}{\fad(00,40)}Maaf...
Dialogue: 0,0:21:58.11,0:21:59.26,Default,,0,0,0,,{\blur3}{\fad(00,40)}Nanahoshi!
Dialogue: 0,0:21:59.57,0:22:02.01,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hei, Nanahoshi!
