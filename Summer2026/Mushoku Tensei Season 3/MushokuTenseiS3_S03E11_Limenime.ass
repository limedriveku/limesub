Dialogue: 0,0:15:01.17,0:15:02.80,sign,,0000,0000,0000,,BUKU HARIAN RUDEUS GREYRAT
Dialogue: 0,0:15:09.68,0:15:10.35,sign,,0000,0000,0000,,MULAI HARI INI AKU AKAN MENULIS BUKU HARIAN.\NMESKI BEGITU, DALAM 10 HARI INI...
Dialogue: 0,0:20:11.61,0:20:12.98,sign,,0000,0000,0000,,BUKU HARIAN RUDEUS GREYRAT
Dialogue: 0,0:22:02.01,0:22:05.01,sign,,0000,0000,0000,,EPISODE 11: TITIK BALIK 4
Dialogue: 0,0:23:35.02,0:23:40.23,sign,,0000,0000,0000,,SELANJUTNYA: PENGHABISAN DAN AWAL MULA
Dialogue: 0,0:00:09.72,0:00:12.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru!
Dialogue: 0,0:00:40.08,0:00:43.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau saja waktu itu Perugius tidak datang,
Dialogue: 0,0:00:43.63,0:00:46.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin aku sudah tidak bisa\Nbertemu siapa-siapa lagi.
Dialogue: 0,0:00:49.19,0:00:51.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rudy, kamu kenapa?
Dialogue: 0,0:00:54.58,0:00:56.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua baik-baik saja, kok.
Dialogue: 0,0:01:00.62,0:01:08.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♫ Yang bersinar di langit dingin nan jauh
Dialogue: 0,0:01:08.08,0:01:08.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zanoba.
Dialogue: 0,0:01:08.79,0:01:10.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Guru.
Dialogue: 0,0:01:11.02,0:01:13.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kondisi luka Anda sudah membaik?
Dialogue: 0,0:01:13.28,0:01:14.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:01:14.43,0:01:16.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zanoba sendiri sudah tidak apa-apa?
Dialogue: 0,0:01:16.50,0:01:18.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, seperti yang bisa dilihat.
Dialogue: 0,0:01:18.48,0:01:21.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya, sudah membuatmu\Nikut terkena jurusku.
Dialogue: 0,0:01:21.73,0:01:24.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti menurut Guru\Nitu adalah pilihan terbaik.
Dialogue: 0,0:01:24.74,0:01:28.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila begitu, mari kita syukuri\Ntelah berhasil kembali dengan selamat.
Dialogue: 0,0:01:28.96,0:01:30.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:01:30.67,0:01:33.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisanya semoga kondisi Nanahoshi\Nbisa membaik.
Dialogue: 0,0:01:33.80,0:01:35.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja soal Nanahoshi.
Dialogue: 0,0:01:35.97,0:01:38.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kondisi tubuhnya sudah mulai stabil.
Dialogue: 0,0:01:39.08,0:01:42.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang justru kondisi Cliff\Nyang membuat khawatir.
Dialogue: 0,0:01:42.39,0:01:44.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mata Iblis pemberian Kishirika, ya?
Dialogue: 0,0:01:44.62,0:01:45.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:01:46.05,0:01:48.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya ini disebut Mata Selidik.
Dialogue: 0,0:01:49.17,0:01:52.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Muncul segala informasi dari\Napa saja yang dilihat mataku.
Dialogue: 0,0:01:52.23,0:01:54.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pandanganku jadi penuh tulisan.
Dialogue: 0,0:01:54.85,0:01:58.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sama-sama kesulitan\Nsetelah mendapat Mata Iblis.
Dialogue: 0,0:01:58.76,0:02:01.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang, biar segera kukuasai mata ini.
Dialogue: 0,0:02:01.67,0:02:05.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau boleh mengandalkanku kalau nanti\Nterjadi hal seperti ini lagi.
Dialogue: 0,0:02:05.97,0:02:06.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:02:06.80,0:02:10.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sebaiknya juga pergi\Nmenengok Nanahoshi sana.
Dialogue: 0,0:02:10.28,0:02:12.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang pasti masih bangun.
Dialogue: 0,0:02:12.24,0:02:14.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku ke sana dulu.
Dialogue: 0,0:02:17.20,0:02:23.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mushoku Tensei:\NJobless Reincarnation Season 3
Dialogue: 0,0:02:34.21,0:02:35.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kondisimu bagaimana?
Dialogue: 0,0:02:36.51,0:02:38.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keadaan saya sudah lumayan membaik.
Dialogue: 0,0:02:38.56,0:02:42.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau saya diberi tahu untuk istirahat\Nsetidaknya sampai satu bulan lagi.
Dialogue: 0,0:02:43.44,0:02:46.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya sungguh berterima kasih\Natas kejadian kali ini.
Dialogue: 0,0:02:48.29,0:02:52.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya dengar sampai mencarikan obat\Nke tempat berbahaya.
Dialogue: 0,0:02:52.46,0:02:55.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, saya sangat tertolong.
Dialogue: 0,0:02:56.00,0:02:58.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa dia jadi sopan sekali.
Dialogue: 0,0:02:58.69,0:03:00.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah dipikir.
Dialogue: 0,0:03:00.38,0:03:06.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dipikir lagi, bicara saya sangat tidak sopan\Npadahal Pak Rudeus lebih tua.
Dialogue: 0,0:03:06.98,0:03:08.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya tidak enak.
Dialogue: 0,0:03:08.50,0:03:12.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, tidak masalah.\NToh di sini aku masih 18 tahun.
Dialogue: 0,0:03:12.52,0:03:14.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aslinya, usia Anda kira-kira berapa?
Dialogue: 0,0:03:14.55,0:03:19.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiga puluh...\NSebaiknya jangan bahas umur, deh.
Dialogue: 0,0:03:19.26,0:03:23.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah pakai bahasa sopan juga,\Nseperti biasanya selama ini saja.
Dialogue: 0,0:03:23.02,0:03:24.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:03:28.39,0:03:31.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya kamu sudah dengar,\Nsoal penyakitmu itu...
Dialogue: 0,0:03:31.52,0:03:33.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya tidak bisa sembuh, ya.
Dialogue: 0,0:03:35.72,0:03:40.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski daya sihir dalam tubuh untuk sementara\Nbisa dikeluarkan dengan Rumput Sokasu,
Dialogue: 0,0:03:40.47,0:03:43.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi nantinya daya sihir akan\Nmenumpuk lagi di dalam tubuh.
Dialogue: 0,0:03:44.00,0:03:48.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama masih hidup di dunia ini,\Nmustahil tidak bersentuhan dengan daya sihir.
Dialogue: 0,0:03:50.31,0:03:53.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanahoshi, dirimu harus pulang.
Dialogue: 0,0:03:53.91,0:03:56.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh mati di dunia ini.
Dialogue: 0,0:03:57.67,0:03:58.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:03:58.76,0:04:01.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga akan membantu sejauh yang kubisa.
Dialogue: 0,0:04:08.74,0:04:11.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:04:14.17,0:04:16.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti akan pulang.
Dialogue: 0,0:04:16.77,0:04:20.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, pasti ingin pulang secepatnya.
Dialogue: 0,0:04:20.66,0:04:22.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu.
Dialogue: 0,0:04:22.34,0:04:24.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai pulang tidak akan bisa\Nmenebus utang budi ini.
Dialogue: 0,0:04:24.98,0:04:27.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah memikirkan utang budi segala.
Dialogue: 0,0:04:27.24,0:04:31.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tapi akan senang kalau kau mau\Nmemberi saran saat aku kebingungan.
Dialogue: 0,0:04:32.25,0:04:33.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:04:35.97,0:04:39.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, begitu saja.\NCepat sembuh, ya.
Dialogue: 0,0:04:39.60,0:04:42.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, terima kasih yang sebesar-besarnya.
Dialogue: 0,0:04:44.47,0:04:47.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di situlah daya sihir berwarna ungu\Nyang ditembakkan Guru
Dialogue: 0,0:04:47.68,0:04:50.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membakar hangus badan Atofe!
Dialogue: 0,0:04:50.60,0:04:55.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi Atofe sudah melemah sejauh itu\Nkarena ulah dirinya, ya?
Dialogue: 0,0:04:55.71,0:04:58.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, setelah itu apa yang terjadi?
Dialogue: 0,0:04:58.53,0:05:02.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya di situlah diriku pingsan.
Dialogue: 0,0:05:02.47,0:05:04.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang minum teh bersama?
Dialogue: 0,0:05:04.24,0:05:05.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru.
Dialogue: 0,0:05:05.50,0:05:06.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, benar.
Dialogue: 0,0:05:06.83,0:05:11.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Tuan Perugius bilang ingin mendengar\Nbagaimana pertempuran melawan Atofe.
Dialogue: 0,0:05:11.54,0:05:14.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi sedang kuceritakan dengan detail.
Dialogue: 0,0:05:14.52,0:05:16.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kudengar, Rudeus.
Dialogue: 0,0:05:16.63,0:05:21.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya ilmu sihirmu yang membuat\NAtofe melemah sejauh itu.
Dialogue: 0,0:05:22.60,0:05:25.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang pun masih terbayang\Nsosok bodohnya di mataku.
Dialogue: 0,0:05:25.76,0:05:28.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia sebenci itu padanya, ya?
Dialogue: 0,0:05:28.63,0:05:30.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda terlihat senang sekali.
Dialogue: 0,0:05:30.18,0:05:35.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena tidak kuduga akan datang\Nkesempatan balas dendam di saat seperti ini.
Dialogue: 0,0:05:35.59,0:05:37.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Balas dendam?
Dialogue: 0,0:05:37.66,0:05:38.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:05:39.02,0:05:43.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat Perang Laplace dia sudah berulang kali\Nmembuatku kesusahan.
Dialogue: 0,0:05:43.35,0:05:46.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suatu saat aku berniat membalas perbuatannya,
Dialogue: 0,0:05:46.18,0:05:52.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sahabatku, Kalman sang Dewa Utara\Nmelarang untuk saling bunuh dengan Atofe.
Dialogue: 0,0:05:52.50,0:05:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa sadar, kesempatan balas dendam\Nsudah hilang dan aku hampir menyerah,
Dialogue: 0,0:05:57.00,0:06:00.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi tidak kusangka bisa\Nsecara sepihak menghajarnya begini.
Dialogue: 0,0:06:00.91,0:06:03.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus berterima kasih padamu.
Dialogue: 0,0:06:03.43,0:06:05.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena sudah bekerja dengan baik.
Dialogue: 0,0:06:05.46,0:06:08.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tidak masalah Anda mengingkari janjinya?
Dialogue: 0,0:06:08.54,0:06:11.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Kal larang adalah saling bunuh.
Dialogue: 0,0:06:11.25,0:06:15.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan protes kalau sekadar\Nmenghajar sesuka hati.
Dialogue: 0,0:06:15.02,0:06:17.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toh kalau sebatas itu dia tidak akan mati.
Dialogue: 0,0:06:19.96,0:06:23.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku sedikit salah menilai dirimu.
Dialogue: 0,0:06:23.40,0:06:26.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sudah seharusnya diberi suatu hadiah.
Dialogue: 0,0:06:26.82,0:06:28.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hadiah?
Dialogue: 0,0:06:30.67,0:06:36.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, apa boleh saya diizinkan belajar\Ncara bertarung dari Tuan Perugius?
Dialogue: 0,0:06:37.68,0:06:42.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terpancing oleh pertemuan Atofe, ya?\NAtau hasratmu mulai muncul?
Dialogue: 0,0:06:42.42,0:06:47.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, saya hanya merasa ingin punya\Nkekuatan untuk melindungi keluarga saya.
Dialogue: 0,0:06:49.88,0:06:53.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya akan kuberi alat\Nuntuk berkomunikasi denganku.
Dialogue: 0,0:06:54.22,0:06:55.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sylvaril.
Dialogue: 0,0:06:58.40,0:07:03.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Clearnight akan mendengarnya bila\Ndigunakan di tempat yang terhubung denganku
Dialogue: 0,0:07:03.80,0:07:06.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan Almanfi akan datang menjemput.
Dialogue: 0,0:07:06.98,0:07:10.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya akan menolong\Nsaat aku ada masalah, ya?
Dialogue: 0,0:07:11.00,0:07:13.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ikutlah duduk.
Dialogue: 0,0:07:13.02,0:07:16.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo berbincang dulu sebentar.
Dialogue: 0,0:07:16.58,0:07:21.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah mengobrol, Perugius ternyata\Norang yang lumayan menarik.
Dialogue: 0,0:07:21.59,0:07:25.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sendiri tidak bisa mengikuti obrolan\Nkarena kurang pengetahuan,
Dialogue: 0,0:07:25.76,0:07:29.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi mendengar ceritanya saja\Nsudah membuatku tertarik.
Dialogue: 0,0:07:29.34,0:07:35.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Perugius, dalam waktu dekat saya ingin\Nmenjual patung buatan Guru.
Dialogue: 0,0:07:35.41,0:07:38.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkenankah Anda memberi\Npendapat yang terbuka?
Dialogue: 0,0:07:40.17,0:07:44.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kisanak yakin mengatakan itu\Nmeski tahu aku membenci suku iblis?
Dialogue: 0,0:07:44.82,0:07:48.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Perugius hebat sekali bisa tahu\Ndalam sekali lihat.
Dialogue: 0,0:07:48.80,0:07:53.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zanoba seharusnya tahu kalau\NPerugius membenci suku iblis.
Dialogue: 0,0:07:53.40,0:07:54.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa coba maksudnya?
Dialogue: 0,0:07:54.92,0:07:58.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ingin menjual benda seperti ini,\Nsebaiknya urungkan saja.
Dialogue: 0,0:07:59.28,0:08:05.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetapi, Tuan Perugius seharusnya berutang budi\Npada sosok yang jadi model patung ini.
Dialogue: 0,0:08:05.09,0:08:06.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berutang budi?
Dialogue: 0,0:08:10.26,0:08:13.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang patung ini,\Nadalah Ruijerd Superdia?
Dialogue: 0,0:08:13.89,0:08:16.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tepat sekali.
Dialogue: 0,0:08:16.17,0:08:19.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam pertempuran terakhir melawan Laplace\Nyang Anda ceritakan sebelumnya.
Dialogue: 0,0:08:19.86,0:08:25.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah Tuan Ruijerd yang sudah membantu\NTuan Perugius dan kawan-kawan saat itu.
Dialogue: 0,0:08:25.81,0:08:31.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saya sepenuhnya mengerti\Nbahwa Tuan Perugius membenci suku iblis.
Dialogue: 0,0:08:31.69,0:08:37.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetapi, bila keahlian Guru sampai ke publik,\Npasti akan memunculkan gebrakan seni baru.
Dialogue: 0,0:08:37.40,0:08:39.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidakkah Anda ingin melihatnya?
Dialogue: 0,0:08:39.85,0:08:43.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia indah yang dipenuhi karya seni!
Dialogue: 0,0:08:43.03,0:08:45.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benci suku Superd.
Dialogue: 0,0:08:45.45,0:08:48.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sudah membantai habis\Nrakyat tak bersalah.
Dialogue: 0,0:08:48.38,0:08:53.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetapi, bila tidak ada pertolongan Ruijerd,\Naku mungkin sudah mati.
Dialogue: 0,0:08:53.82,0:08:55.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja...
Dialogue: 0,0:08:57.34,0:09:01.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Perugius, Ruijerd menyesali\Napa yang sudah ia perbuat.
Dialogue: 0,0:09:02.18,0:09:03.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyesal?
Dialogue: 0,0:09:03.55,0:09:05.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di bawah pengaruh Laplace,
Dialogue: 0,0:09:05.72,0:09:10.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia menodai martabat sukunya,\Nbahkan menghabisi keluarganya sendiri.
Dialogue: 0,0:09:10.32,0:09:12.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laplace, ya?
Dialogue: 0,0:09:12.25,0:09:17.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia membenci Laplace, lalu berkeliling dunia\Nuntuk mengembalikan martabat sukunya.
Dialogue: 0,0:09:18.23,0:09:21.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Patung ini adalah langkah\Nuntuk membantu hal tersebut.
Dialogue: 0,0:09:21.90,0:09:24.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah Anda memberikan izin\Ndemi kebaikannya juga?
Dialogue: 0,0:09:25.37,0:09:29.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sebenarnya tidak peduli\Ndengan martabat suku Superd.
Dialogue: 0,0:09:30.12,0:09:33.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetapi, utang budi haruslah dibalas.
Dialogue: 0,0:09:33.22,0:09:35.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, berarti?
Dialogue: 0,0:09:35.40,0:09:37.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lakukanlah sesukamu.
Dialogue: 0,0:09:37.33,0:09:39.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas kemurahan hati Anda.
Dialogue: 0,0:09:39.43,0:09:42.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Terima kasih banyak, Tuan Perugius.\N- Dengan ini rencana pemulihan martabat suku Superd,
Dialogue: 0,0:09:42.81,0:09:44.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah berjalan selangkah lagi.
Dialogue: 0,0:09:44.91,0:09:47.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersabarlah, Ruijerd.
Dialogue: 0,0:09:47.19,0:09:48.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh iya, Guru.
Dialogue: 0,0:09:48.73,0:09:52.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau menunjukkan proses\Npembuatan patung pada Tuan Perugius?
Dialogue: 0,0:09:52.89,0:09:54.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Proses membuat patungnya?
Dialogue: 0,0:09:54.44,0:09:55.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunjukkanlah padaku.
Dialogue: 0,0:09:55.69,0:09:58.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tertarik pada ilmu sihirmu.
Dialogue: 0,0:09:58.55,0:10:00.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, saya mengerti.
Dialogue: 0,0:10:03.10,0:10:04.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini Sylvaril, ya?
Dialogue: 0,0:10:05.45,0:10:09.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata sihir tanah bisa digunakan\Nuntuk seperti ini.
Dialogue: 0,0:10:09.03,0:10:10.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat mengejutkan.
Dialogue: 0,0:10:10.53,0:10:13.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ada pesanan khusus,\Nsaya bisa membuatkan apa saja.
Dialogue: 0,0:10:13.55,0:10:17.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, bawalah kemari jika\Nkau berhasil membuat sesuatu yang apik.
Dialogue: 0,0:10:17.74,0:10:19.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membelinya.
Dialogue: 0,0:10:19.70,0:10:21.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau seperti itu...
Dialogue: 0,0:10:21.22,0:10:25.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerajaan Asura kami juga punya\Nperajin batu yang luar biasa.
Dialogue: 0,0:10:25.48,0:10:30.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat saya menjadi Raja, biar kami\Npersembahkan patung Tuang Perugius.
Dialogue: 0,0:10:31.35,0:10:34.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerajinan batu yang dibuat sekadar\Nuntuk pamer bangsawan
Dialogue: 0,0:10:34.28,0:10:36.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak ada menariknya sama sekali.
Dialogue: 0,0:10:37.56,0:10:41.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila menjadi raja, bukankah ada sesuatu\Nyang harus lebih dulu kau lakukan?
Dialogue: 0,0:10:42.28,0:10:43.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Itu...
Dialogue: 0,0:10:46.24,0:10:48.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Ariel Anemoi Asura.
Dialogue: 0,0:10:48.63,0:10:51.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagimu, menjadi raja itu apa?
Dialogue: 0,0:10:51.55,0:10:54.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutmu apa arti raja yang sesungguhnya?
Dialogue: 0,0:10:54.76,0:10:56.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:10:56.57,0:10:58.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memiliki pengetahuan,
Dialogue: 0,0:10:58.18,0:11:00.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mendengarkan perkataan para menteri,
Dialogue: 0,0:11:00.39,0:11:01.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}serta menyadari posisi sebagai raja...
Dialogue: 0,0:11:01.90,0:11:03.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah.
Dialogue: 0,0:11:03.77,0:11:07.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sahabatku, Gaunis Freean Asura\Nadalah raja sejati,
Dialogue: 0,0:11:07.85,0:11:10.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi dia bukan pria seperti itu.
Dialogue: 0,0:11:10.20,0:11:15.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia penakut dan tidak suka berperang,\Ntapi suka menggoda anak gadis di kedai minum.
Dialogue: 0,0:11:15.54,0:11:17.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia adalah pria seperti itu.
Dialogue: 0,0:11:18.32,0:11:22.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetapi, dia memiliki aspek terpenting\Nsebagai seorang raja.
Dialogue: 0,0:11:22.62,0:11:27.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itulah aku menganggapnya\Nsebagai raja yang sejati.
Dialogue: 0,0:11:28.40,0:11:30.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aspek terpenting yang Anda maksud?
Dialogue: 0,0:11:30.57,0:11:35.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila itu bisa keluar dari mulutmu sendiri,\Nmaka aku akan mau memberi bantuan.
Dialogue: 0,0:11:36.10,0:11:39.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya, Ariel sedang diuji.
Dialogue: 0,0:11:39.81,0:11:43.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rudeus, apa kau mengerti sesuatu?
Dialogue: 0,0:11:43.33,0:11:46.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengenai apa itu raja?
Dialogue: 0,0:11:48.44,0:11:50.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menurut saya...
Dialogue: 0,0:11:50.82,0:11:54.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau yang jadi raja adalah seseorang yang\Nmau memikirkan dan berdiri di pihak rakyat,
Dialogue: 0,0:11:54.99,0:11:56.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saya akan senang.
Dialogue: 0,0:11:56.19,0:11:57.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:11:58.14,0:12:01.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria ini memberi jawaban\Nyang lebih baik darimu, lo.
Dialogue: 0,0:12:03.16,0:12:07.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pikirkanlah baik-baik, Ariel Anemoi Asura.
Dialogue: 0,0:12:11.86,0:12:16.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aspek terpenting sebagai seorang raja?
Dialogue: 0,0:12:20.46,0:12:22.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pulang.
Dialogue: 0,0:12:22.01,0:12:24.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, selamat datang!
Dialogue: 0,0:12:24.92,0:12:25.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?!
Dialogue: 0,0:12:25.98,0:12:28.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak sama Kak Sylphy?!
Dialogue: 0,0:12:28.26,0:12:29.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pulang.
Dialogue: 0,0:12:29.40,0:12:31.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak sudah selesai?
Dialogue: 0,0:12:31.02,0:12:33.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Nanahoshi tertolong?
Dialogue: 0,0:12:33.84,0:12:34.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau malah...
Dialogue: 0,0:12:34.81,0:12:36.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua, selamat datang.
Dialogue: 0,0:12:37.09,0:12:38.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami pulang.
Dialogue: 0,0:12:38.42,0:12:41.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Badanmu sudah baik-baik saja, Sylphy?
Dialogue: 0,0:12:41.30,0:12:44.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, maaf sudah memintamu jaga rumah.
Dialogue: 0,0:12:44.77,0:12:46.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:12:46.08,0:12:50.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau rencana awalnya\Naku yang pulang sendiri duluan.
Dialogue: 0,0:12:50.96,0:12:54.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau seperti itu,\Nberarti berhasil sukses, ya.
Dialogue: 0,0:12:54.28,0:12:57.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, biar kujelaskan detailnya nanti.
Dialogue: 0,0:12:57.51,0:12:59.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sebelum itu...
Dialogue: 0,0:13:01.55,0:13:03.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pulang.
Dialogue: 0,0:13:04.67,0:13:06.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang.
Dialogue: 0,0:13:09.39,0:13:13.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, untuk sekarang\NNanahoshi sudah tidak apa-apa.
Dialogue: 0,0:13:13.27,0:13:19.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja gejala yang dialami Ibu,\Ncuma tahu kalau itu terkena kutukan.
Dialogue: 0,0:13:19.09,0:13:20.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:13:20.58,0:13:23.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu saja sudah kemajuan besar, kok.
Dialogue: 0,0:13:23.55,0:13:26.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencanaku sekarang akan\Nbolak-balik Benteng Terbang
Dialogue: 0,0:13:26.52,0:13:28.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mencari cara menyembuhkannya.
Dialogue: 0,0:13:28.60,0:13:33.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk sementara, aku juga akan meninggalkan\Nrumah untuk mengawal Putri Ariel.
Dialogue: 0,0:13:33.40,0:13:36.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, kalian tidak usah khawatir\Nsoal di sini.
Dialogue: 0,0:13:37.06,0:13:38.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya.
Dialogue: 0,0:13:38.20,0:13:41.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sekiranya bisa pulang,\Naku akan pulang ke rumah.
Dialogue: 0,0:13:41.00,0:13:42.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jaga Lucie, ya.
Dialogue: 0,0:13:42.90,0:13:45.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan saja segala urusan rumah.
Dialogue: 0,0:13:45.87,0:13:47.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:13:49.16,0:13:50.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekian laporanku.
Dialogue: 0,0:13:50.84,0:13:52.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuberi tahu kalau ada apa-apa lagi.
Dialogue: 0,0:13:57.87,0:14:03.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak yang terjadi dalam waktu singkat\Nsejak pergi menemui Perugius.
Dialogue: 0,0:14:03.85,0:14:06.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanahoshi jatuh sakit, pergi ke Benua Iblis,
Dialogue: 0,0:14:06.85,0:14:10.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bertemu Kishirika, membuat murka Atofe.
Dialogue: 0,0:14:12.53,0:14:14.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sangat kuat.
Dialogue: 0,0:14:16.21,0:14:19.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga harus jadi lebih kuat lagi.
Dialogue: 0,0:14:20.24,0:14:26.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu artinya, belajar pada Perugius\Nmungkin bisa dibilang langkah yang bagus.
Dialogue: 0,0:14:27.09,0:14:29.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, apa lagi, ya?
Dialogue: 0,0:14:31.28,0:14:36.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlalu banyak yang dipikirkan,\Njadi mulai lupa hal-hal yang telah lalu.
Dialogue: 0,0:14:36.33,0:14:40.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini, bisa-bisa aku\Nmengulangi kesalahan yang sama.
Dialogue: 0,0:14:40.66,0:14:42.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, biar kubuat buku harian.
Dialogue: 0,0:14:43.12,0:14:44.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, ayo tulis itu.
Dialogue: 0,0:14:44.63,0:14:46.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langsung tulis sekarang.
Dialogue: 0,0:14:57.67,0:14:59.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip.
Dialogue: 0,0:15:03.41,0:15:06.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, mulai kutulis dari mana, ya.
Dialogue: 0,0:15:07.02,0:15:09.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan, ya, terakhir kali aku\Nmenulis buku harian?
Dialogue: 0,0:15:10.36,0:15:13.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga kali ini bukan cuma jalan tiga hari.
Dialogue: 0,0:15:23.41,0:15:24.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hai.
Dialogue: 0,0:15:25.01,0:15:26.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau?
Dialogue: 0,0:15:26.94,0:15:29.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti aku ketiduran, ya.
Dialogue: 0,0:15:29.68,0:15:31.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tidak ketemu.
Dialogue: 0,0:15:31.11,0:15:36.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kau tidak muncul sekali pun\Nselama tiga tahun saat aku jadi petualang.
Dialogue: 0,0:15:36.94,0:15:39.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak hal sulit yang kualami di masa itu.
Dialogue: 0,0:15:39.67,0:15:41.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, benar.
Dialogue: 0,0:15:41.05,0:15:45.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedangkan belakangan ini kondisimu\Nbaik sekali dibanding saat itu.
Dialogue: 0,0:15:46.06,0:15:47.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah.
Dialogue: 0,0:15:47.29,0:15:49.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menikah dan rukun dengan keluarga.
Dialogue: 0,0:15:49.85,0:15:53.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jauh lebih baik dan tidak bisa\Ndibandingkan dengan hidupku sebelumnya.
Dialogue: 0,0:15:53.74,0:15:56.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dirimu juga berhasil\Nberteman dengan Perugius.
Dialogue: 0,0:15:56.64,0:15:59.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perugius, ya.\NDia hebat sekali, kan?
Dialogue: 0,0:15:59.39,0:16:01.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga disenangi Atofe.
Dialogue: 0,0:16:01.42,0:16:05.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, kalau itu, aku tidak suka\Nsampai disenangi sama dia.
Dialogue: 0,0:16:05.53,0:16:09.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin akan gawat misalkan aku\Ntidak belajar sihir tingkat Raja Air dari Roxy.
Dialogue: 0,0:16:09.75,0:16:12.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, sihir itu hebat sekali.
Dialogue: 0,0:16:12.85,0:16:16.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir yang bisa menembus Aura Tempur\Ndan melumpuhkan otot secara langsung
Dialogue: 0,0:16:16.75,0:16:18.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu jarang adanya.
Dialogue: 0,0:16:18.62,0:16:21.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aura Tempur?\NApa itu?
Dialogue: 0,0:16:21.36,0:16:26.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknik meningkatkan kemampuan fisik\Nmemanfaatkan daya sihir di dalam tubuh.
Dialogue: 0,0:16:26.16,0:16:29.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dikuasai, gerakanmu bisa jadi gesit,
Dialogue: 0,0:16:29.09,0:16:32.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan katanya jadi tidak mudah dilukai.
Dialogue: 0,0:16:32.28,0:16:36.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konon kalau melatih tubuhmu,\Nnanti bisa memakainya dengan sendirinya, lo.
Dialogue: 0,0:16:36.53,0:16:39.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sudah lumayan melatih tubuhku,
Dialogue: 0,0:16:39.39,0:16:40.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi belum pernah bisa pakai, tuh.
Dialogue: 0,0:16:41.23,0:16:42.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kadang memang ada manusia
Dialogue: 0,0:16:42.81,0:16:46.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang tidak bisa pakai Aura Tempur\Nmeski berlatih sekeras apa pun.
Dialogue: 0,0:16:46.53,0:16:48.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu soal bakat.
Dialogue: 0,0:16:48.69,0:16:50.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makasih infonya.
Dialogue: 0,0:16:50.25,0:16:52.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah bersedih.
Dialogue: 0,0:16:52.26,0:16:55.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihirmu bisa mengabaikan Aura Tempur tadi.
Dialogue: 0,0:16:55.50,0:16:58.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti bisa mempan juga pada Orsted.
Dialogue: 0,0:16:58.34,0:16:59.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa iya?
Dialogue: 0,0:16:59.91,0:17:02.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Heh, aku tidak berniat\Nberhadapan sama Orsted, lo.
Dialogue: 0,0:17:02.98,0:17:04.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak punya dendam sama dia.
Dialogue: 0,0:17:04.50,0:17:05.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:17:05.55,0:17:09.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh iya, aku sangat tertolong\Nsaat di Benua Begaritt.
Dialogue: 0,0:17:09.75,0:17:12.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau bohong kalau aku bilang\Ntidak menyesalinya.
Dialogue: 0,0:17:12.56,0:17:14.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tidaklah buruk.
Dialogue: 0,0:17:14.78,0:17:17.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski aku tidak mengikuti nasihatmu.
Dialogue: 0,0:17:17.57,0:17:20.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, itu sudah pilihanmu.
Dialogue: 0,0:17:20.32,0:17:22.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau coba tanya.
Dialogue: 0,0:17:22.50,0:17:25.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa jadinya kalau aku tidak ke sana?
Dialogue: 0,0:17:25.02,0:17:26.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau tidak ke sana.
Dialogue: 0,0:17:26.29,0:17:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahmu akan berhasil\Nberusaha menyelamatkan ibumu
Dialogue: 0,0:17:29.70,0:17:31.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tidak akan mati.
Dialogue: 0,0:17:31.57,0:17:38.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, dirimu akan meminang kedua\Nputri suku binatang dan hidup bahagia.
Dialogue: 0,0:17:38.35,0:17:40.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?!
Dialogue: 0,0:17:40.19,0:17:43.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, Paul mati karena ada aku?
Dialogue: 0,0:17:43.68,0:17:45.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, benar.
Dialogue: 0,0:17:45.09,0:17:49.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena ada dirimu, dia jadi semangat\Nuntuk tampil keren di depanmu.
Dialogue: 0,0:17:49.29,0:17:51.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu itu malah membuatnya gagal.
Dialogue: 0,0:17:52.02,0:17:55.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tapi, mana mungkin...
Dialogue: 0,0:17:55.14,0:17:59.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibiarkan sekalipun, dia akan berhasil\Nmenyelamatkan ibumu.
Dialogue: 0,0:17:59.43,0:18:01.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu bersama Roxy juga.
Dialogue: 0,0:18:02.35,0:18:04.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih agak sulit kupercaya.
Dialogue: 0,0:18:04.67,0:18:06.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya itu berjalan terlalu mulus?
Dialogue: 0,0:18:07.14,0:18:08.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin iya.
Dialogue: 0,0:18:08.36,0:18:11.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, memang seperti itulah takdir.
Dialogue: 0,0:18:11.66,0:18:13.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:18:13.31,0:18:16.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata lebih baik kalau tidak ada aku.
Dialogue: 0,0:18:16.32,0:18:19.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan, diberi tahu seperti itu\Nmalah membuatku sedih.
Dialogue: 0,0:18:19.92,0:18:21.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sudah berlalu.
Dialogue: 0,0:18:22.50,0:18:25.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, tidak ada gunanya disesali.
Dialogue: 0,0:18:26.35,0:18:29.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang aku merasa bahagia.
Dialogue: 0,0:18:29.27,0:18:33.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pilihanku mungkin memang salah,\Ntapi itulah kenyataannya.
Dialogue: 0,0:18:33.78,0:18:37.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagiku itu bukan hanya minus belaka,\Nkurasa begitu.
Dialogue: 0,0:18:38.10,0:18:39.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Optimis sekali dirimu.
Dialogue: 0,0:18:39.87,0:18:42.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, hari ini ada apa?
Dialogue: 0,0:18:42.41,0:18:44.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau memberi nasihat lagi?
Dialogue: 0,0:18:44.47,0:18:48.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, daripada nasihat,\Nmungkin lebih seperti permintaan.
Dialogue: 0,0:18:48.20,0:18:50.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permintaan?\NTumben sekali.
Dialogue: 0,0:18:50.51,0:18:53.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terkadang juga bisa minta tolong sesuatu.
Dialogue: 0,0:18:53.86,0:18:55.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah.
Dialogue: 0,0:18:55.32,0:19:00.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekali-sekali kurasa tidak ada salahnya\Nmenjalankan nasihatmu begitu saja.
Dialogue: 0,0:19:00.58,0:19:01.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, benarkah?
Dialogue: 0,0:19:01.97,0:19:04.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan terbantu kalau kau bilang begitu.
Dialogue: 0,0:19:04.04,0:19:06.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toh aku sudah berulang kali tertolong.
Dialogue: 0,0:19:06.83,0:19:09.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku justru tidak enak\Nselama ini meragukanmu.
Dialogue: 0,0:19:09.54,0:19:12.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini-begini aku seorang dewa, lo.
Dialogue: 0,0:19:12.11,0:19:15.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak punya hobi menjebak orang\Nuntuk kesenangan semata.
Dialogue: 0,0:19:15.89,0:19:17.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:19:17.51,0:19:19.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus, aku harus apa?
Dialogue: 0,0:19:19.68,0:19:21.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma sepele, kok.
Dialogue: 0,0:19:21.85,0:19:26.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang pergilah ke rubanah untuk\Nmemeriksa ada keanehan atau tidak.
Dialogue: 0,0:19:26.62,0:19:30.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misalkan tidak apa-apa, ya sudah,\Nbagus kalau begitu.
Dialogue: 0,0:19:30.23,0:19:33.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada keanehan atau tidak?\NKenapa?
Dialogue: 0,0:19:33.50,0:19:35.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, baiklah.
Dialogue: 0,0:19:35.35,0:19:39.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini aku akan menuruti perkataanmu\Ntanpa meragukan apa pun.
Dialogue: 0,0:19:40.22,0:19:41.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:19:47.58,0:19:49.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:20:00.28,0:20:02.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari Sylphy atau Roxy, ya?
Dialogue: 0,0:20:03.41,0:20:05.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal dibangunkan saja tidak apa-apa.
Dialogue: 0,0:20:12.98,0:20:14.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang.
Dialogue: 0,0:20:16.14,0:20:17.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dinginnya.
Dialogue: 0,0:20:17.78,0:20:21.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya aku harus memeriksa rubanah.
Dialogue: 0,0:20:21.02,0:20:23.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nasihat yang tidak kumengerti.
Dialogue: 0,0:20:24.08,0:20:27.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang terjadi sesuatu\Npada benda suci di rumahku?
Dialogue: 0,0:20:27.57,0:20:29.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin begitu.
Dialogue: 0,0:20:41.47,0:20:43.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaanku saja, ya.
Dialogue: 0,0:20:45.52,0:20:47.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pura-puranya begitu,\Ntapi kau di sana rupanya?!
Dialogue: 0,0:20:47.65,0:20:49.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bercanda...
Dialogue: 0,0:20:53.34,0:20:56.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah berhasil, ya?
Dialogue: 0,0:20:57.93,0:21:01.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, sepertinya gagal.
Dialogue: 0,0:21:01.92,0:21:04.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin bisa berhasil.
Dialogue: 0,0:21:04.63,0:21:06.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si-Siapa?
Dialogue: 0,0:21:07.59,0:21:10.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang Dewa Manusia?!
Dialogue: 0,0:21:12.71,0:21:15.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pergi ke rubanah.
Dialogue: 0,0:21:15.34,0:21:18.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini kau sedang diperdaya Dewa Manusia.
Dialogue: 0,0:21:18.59,0:21:20.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar...
Dialogue: 0,0:21:21.02,0:21:22.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ini siapa?
Dialogue: 0,0:21:22.77,0:21:24.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masuk dari mana?
Dialogue: 0,0:21:25.90,0:21:27.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku adalah...
Dialogue: 0,0:21:29.92,0:21:31.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku adalah...
Dialogue: 0,0:21:37.24,0:21:41.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu adalah nama yang hanya diketahui\Ndiriku seorang di dunia ini.
Dialogue: 0,0:21:42.53,0:21:46.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama yang seharusnya hanya\Naku yang tahu sampai ke balik liang lahad.
Dialogue: 0,0:21:47.00,0:21:49.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama yang tidak ingin kuingat lagi.
Dialogue: 0,0:21:49.86,0:21:53.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama dari sesuatu yang seharusnya\Ntidak ada di dunia ini.
Dialogue: 0,0:21:53.63,0:21:57.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu adalah namaku di kehidupan sebelumnya.
Dialogue: 0,0:21:58.16,0:22:02.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku datang dari masa depan.
