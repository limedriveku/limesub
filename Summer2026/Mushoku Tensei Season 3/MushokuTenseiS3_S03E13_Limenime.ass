Dialogue: 0,0:22:33.83,0:22:35.58,sign,,0000,0000,0000,,BUKU HARIAN RUDEUS GREYRAT
Dialogue: 0,0:23:31.97,0:23:34.97,sign,,0000,0000,0000,,EPISODE 13: BUKU HARIAN
Dialogue: 0,0:23:34.97,0:23:39.98,sign,,0000,0000,0000,,SELANJUTNYA: TEKAD
Dialogue: 0,0:00:00.54,0:00:02.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mushoku Tensei:\NJobless Reincarnation Season 3
Dialogue: 0,0:00:02.78,0:00:03.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:00:03.77,0:00:04.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kasihan sekali.
Dialogue: 0,0:00:04.97,0:00:06.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?!
Dialogue: 0,0:00:06.68,0:00:08.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa itu?
Dialogue: 0,0:00:08.32,0:00:10.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya jangan dipegang.
Dialogue: 0,0:00:11.58,0:00:13.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bangkai kucing yang aneh?
Dialogue: 0,0:00:13.45,0:00:15.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, menyeramkan sekali waktu kulihat.
Dialogue: 0,0:00:15.91,0:00:18.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga lihat kalau itu.
Dialogue: 0,0:00:18.58,0:00:22.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan kucing, sih, tapi ada tikus aneh\Nmati di belakang rumah.
Dialogue: 0,0:00:22.88,0:00:25.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mungkin sedang musim penyakit, ya?
Dialogue: 0,0:00:25.50,0:00:27.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa saja begitu.
Dialogue: 0,0:00:27.38,0:00:31.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian harus cuci tangan dan berkumur\Nyang bersih untuk pencegahan, ya.
Dialogue: 0,0:00:31.01,0:00:32.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Iya.\N- Baik.
Dialogue: 0,0:00:32.34,0:00:33.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rudeus!
Dialogue: 0,0:00:37.60,0:00:40.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lize sudah hamil.
Dialogue: 0,0:00:41.19,0:00:43.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Selamat!\N- Selamat, Nek!
Dialogue: 0,0:00:43.39,0:00:45.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, ya.
Dialogue: 0,0:00:45.44,0:00:47.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak, ya?
Dialogue: 0,0:00:47.07,0:00:50.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya aku juga sudah pengin\Npunya anak sama Roxy.
Dialogue: 0,0:00:50.28,0:00:52.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira menurut Roxy bagaimana, ya?
Dialogue: 0,0:00:53.12,0:00:55.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga dia juga merasakan hal yang sama.
Dialogue: 0,0:01:01.66,0:01:03.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara apa itu?!
Dialogue: 0,0:01:04.42,0:01:06.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Roxy!
Dialogue: 0,0:01:09.76,0:01:12.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir penawar racun tingkat atas\Njuga tidak berpengaruh.
Dialogue: 0,0:01:12.43,0:01:14.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Kakak tahu sesuatu?
Dialogue: 0,0:01:16.75,0:01:18.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini Wabah Batu Sihir.
Dialogue: 0,0:01:19.18,0:01:20.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya.
Dialogue: 0,0:01:25.13,0:01:29.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyakit mematikan yang hanya sembuh\Ndengan sihir penawar racun tingkat dewa.
Dialogue: 0,0:01:36.49,0:01:38.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bilang apa tadi?
Dialogue: 0,0:01:38.70,0:01:40.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di Kerajaan Suci Millis,
Dialogue: 0,0:01:40.48,0:01:43.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada kitab suci yang memuat\Nsihir penawar racun tingkat dewa.
Dialogue: 0,0:01:43.92,0:01:47.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma itu pilihan yang tersisa\Nuntuk menyelamatkan Roxy.
Dialogue: 0,0:01:47.48,0:01:50.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu di mana itu disimpan.
Dialogue: 0,0:01:50.65,0:01:53.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, biarkan aku\Nmengantarmu ke sana, Rudeus.
Dialogue: 0,0:01:54.24,0:01:56.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu, aku juga akan menemani.
Dialogue: 0,0:01:59.92,0:02:03.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua, terima kasih banyak, ya.
Dialogue: 0,0:02:04.34,0:02:07.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada penyusup!\NKitab suci sudah dicuri!
Dialogue: 0,0:02:12.28,0:02:16.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami disergap pasukan Millis\Ndi reruntuhan teleportasi.
Dialogue: 0,0:02:20.13,0:02:21.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk pertama kalinya aku...
Dialogue: 0,0:02:22.82,0:02:24.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membunuh manusia.
Dialogue: 0,0:03:02.50,0:03:04.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}La-Lama tidak ketemu, Rudeus!
Dialogue: 0,0:03:04.91,0:03:08.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ghislaine dan, Eris?
Dialogue: 0,0:03:08.56,0:03:10.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa malah di sini?
Dialogue: 0,0:03:10.55,0:03:13.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, aku dengar di sekolah!
Dialogue: 0,0:03:13.62,0:03:16.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya berhasil melukai raja iblis,\Njadi pentolan para murid,
Dialogue: 0,0:03:16.93,0:03:18.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sama mengalahkan hydra seorang diri!
Dialogue: 0,0:03:18.80,0:03:23.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu mengorbankan tangan kiri dan menang\Nmelawan Tujuh Kekuatan Agung, lalu, lalu...
Dialogue: 0,0:03:23.44,0:03:25.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa urusanmu?
Dialogue: 0,0:03:27.90,0:03:29.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah jadi kuat sekarang!
Dialogue: 0,0:03:30.30,0:03:33.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rudeus mungkin sudah makin jauh di depan.
Dialogue: 0,0:03:33.65,0:03:36.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, aku sudah jadi kuat\Nuntuk bisa bersanding denganmu!
Dialogue: 0,0:03:37.39,0:03:39.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, ayo!
Dialogue: 0,0:03:39.65,0:03:41.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita jadi suami istri!
Dialogue: 0,0:03:44.44,0:03:46.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bilang apa kamu ini?
Dialogue: 0,0:03:47.25,0:03:49.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan seenakmu sendiri!
Dialogue: 0,0:03:49.38,0:03:52.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang kau pikir sudah\Nseberapa menderita diriku?
Dialogue: 0,0:03:54.09,0:03:56.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah punya dua istri.
Dialogue: 0,0:03:56.94,0:03:58.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah tidak bisa meladenimu.
Dialogue: 0,0:04:05.58,0:04:07.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Guru yakin?
Dialogue: 0,0:04:07.31,0:04:08.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang Roxy yang utama.
Dialogue: 0,0:04:09.31,0:04:11.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa malah sekarang?
Dialogue: 0,0:04:57.60,0:04:59.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Roxy sudah tiada.
Dialogue: 0,0:05:00.06,0:05:01.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Roxy yang itu...
Dialogue: 0,0:05:11.62,0:05:15.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rudy, aku tidak akan memintamu\Nuntuk jangan bersedih.
Dialogue: 0,0:05:15.74,0:05:19.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau bisa tolong pikirkan juga\Nkami sebagai keluargamu.
Dialogue: 0,0:05:20.51,0:05:23.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami juga sedih soal Roxy.
Dialogue: 0,0:05:23.40,0:05:27.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Roxy pasti tidak akan senang\Nkalau lihat Rudy yang sekarang.
Dialogue: 0,0:05:32.30,0:05:34.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa mengalihkan kesedihanmu...
Dialogue: 0,0:05:35.47,0:05:38.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu boleh memperlakukan badanku sesukamu.
Dialogue: 0,0:05:39.74,0:05:42.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin aku bisa mendekapmu\Nkalau dibilang seperti itu?!
Dialogue: 0,0:05:45.33,0:05:46.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:05:52.00,0:05:54.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sekarang aku mendekap Sylphy,
Dialogue: 0,0:05:54.00,0:05:57.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang ada nanti malah\Nmemperlakukan dia dengan kasar.
Dialogue: 0,0:05:57.24,0:05:59.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai pengganti Roxy,
Dialogue: 0,0:05:59.55,0:06:01.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebagai sasaran pelampiasanku...
Dialogue: 0,0:06:15.35,0:06:18.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belakangan ini kita sering sekali bertemu.
Dialogue: 0,0:06:18.68,0:06:22.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lamaran seperti apa yang hari ini\Nakan kau katakan padaku...
Dialogue: 0,0:06:25.77,0:06:27.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tiba-tiba main...
Dialogue: 0,0:06:33.26,0:06:37.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toh tidak ada seorang pun\Nyang mengerti perasaanku.
Dialogue: 0,0:06:38.51,0:06:40.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Datang lagi, ya.
Dialogue: 0,0:07:07.82,0:07:09.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bakal datang lagi.
Dialogue: 0,0:07:15.33,0:07:17.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sylphy...
Dialogue: 0,0:07:17.91,0:07:20.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tidak mau kalau sama aku?!
Dialogue: 0,0:07:20.91,0:07:22.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sylphy!
Dialogue: 0,0:07:25.49,0:07:28.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beberapa hari kemudian Sylphy pun pergi.
Dialogue: 0,0:07:29.34,0:07:31.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lilia menyuruhku untuk mengejarnya.
Dialogue: 0,0:07:31.74,0:07:34.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, apakah aku punya hak\Nuntuk melakukannya?
Dialogue: 0,0:07:35.23,0:07:38.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai di saat seperti ini ada Elinalise.
Dialogue: 0,0:07:47.68,0:07:52.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya Sylphy menuju Kerajaan Asura\Nbersama Ariel.
Dialogue: 0,0:07:52.98,0:07:55.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya masih terkejar kalau bergegas.
Dialogue: 0,0:07:58.86,0:08:00.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus benar-benar minta maaf.
Dialogue: 0,0:08:01.04,0:08:04.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya harus pulang berdua\Ndan ditata lagi bersama.
Dialogue: 0,0:08:07.61,0:08:11.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka harus jadi imigran gelap\Nke Kerajaan Asura.
Dialogue: 0,0:08:11.56,0:08:13.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, akan kusiapkan kereta kuda dulu.
Dialogue: 0,0:08:13.99,0:08:15.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan keluar dari sini, lo.
Dialogue: 0,0:08:15.68,0:08:18.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Terus jangan sembarangan mendekat ke jendela.\N- Tidak masalah walau harus minta bantuan bandit.
Dialogue: 0,0:08:18.98,0:08:22.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau sama yang seperti ini,\NSylphy nanti salah paham atau tidak, ya?
Dialogue: 0,0:08:28.63,0:08:30.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa bisa ada di sini?!
Dialogue: 0,0:08:30.19,0:08:33.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh iya, kampung halamannya\Njuga di Kerajaan Asura.
Dialogue: 0,0:08:33.19,0:08:35.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, tidak aneh kalau ada di sini.
Dialogue: 0,0:08:37.90,0:08:40.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut bandit bernama Triss,
Dialogue: 0,0:08:40.60,0:08:44.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raja Asura umurnya sudah tidak panjang\Nkarena penyakit.
Dialogue: 0,0:08:44.54,0:08:49.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ariel mempercepat kepulangannya pasti\Nuntuk ikut dalam perebutan takhta.
Dialogue: 0,0:08:49.80,0:08:52.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa benar Putri Ariel\Nakan memakai kekuatan militer?
Dialogue: 0,0:08:52.91,0:08:55.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, tapi katanya sudah tertangkap.
Dialogue: 0,0:08:55.92,0:08:58.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Isunya dalam waktu dekat akan dieksekusi.
Dialogue: 0,0:09:08.80,0:09:10.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar pemberontak!
Dialogue: 0,0:09:10.82,0:09:13.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beraninya merusak kedamaian ibu kota!
Dialogue: 0,0:09:13.48,0:09:15.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar tidak tahu malu!
Dialogue: 0,0:09:32.59,0:09:35.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sylphy! Sylphy!
Dialogue: 0,0:09:37.12,0:09:40.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya Tuhan, Sylphy...
Dialogue: 0,0:09:42.02,0:09:43.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kau ini?
Dialogue: 0,0:09:43.82,0:09:46.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga kawan mereka, ya?!
Dialogue: 0,0:09:53.99,0:09:58.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan berani menodai Sylphy!
Dialogue: 0,0:10:01.84,0:10:03.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tidak peduli.
Dialogue: 0,0:10:04.08,0:10:06.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Negara seperti ini, lebih baik hancur saja.
Dialogue: 0,0:10:06.95,0:10:09.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih baik, segalanya lenyap.
Dialogue: 0,0:10:24.73,0:10:28.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini omelanmu berisik sekali.
Dialogue: 0,0:10:28.55,0:10:31.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirasnya jadi tidak enak,\Nbisa diam saja, tidak?
Dialogue: 0,0:10:31.62,0:10:33.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, saya tidak akan diam.
Dialogue: 0,0:10:33.89,0:10:36.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiap hari mabuk-mabukan\Ndan uang selalu keluar tanpa henti.
Dialogue: 0,0:10:37.54,0:10:40.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan tempo hari sampai membawa pelacur.
Dialogue: 0,0:10:40.49,0:10:43.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akulah tuan di rumah ini.
Dialogue: 0,0:10:43.38,0:10:46.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suka-sukaku mau berbuat apa.
Dialogue: 0,0:10:46.01,0:10:50.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau soal uang, kenapa tidak\Ndicari saja pakai badanmu itu?!
Dialogue: 0,0:10:50.02,0:10:54.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tetap seperti ini, nanti tidak baik\Nuntuk didikan Nona Lucie.
Dialogue: 0,0:10:54.00,0:10:56.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumah kita bisa runtuh.
Dialogue: 0,0:10:56.72,0:10:58.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumah kita?
Dialogue: 0,0:10:58.58,0:11:01.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah rumahku.
Dialogue: 0,0:11:01.02,0:11:05.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumah yang kusiapkan untuk\Nhidup bahagia dengan Sylphy.
Dialogue: 0,0:11:05.44,0:11:08.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal cuma menumpang...
Dialogue: 0,0:11:08.02,0:11:10.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah terus-terusan\Nberlagak seperti ibuku begitu!
Dialogue: 0,0:12:47.36,0:12:50.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa setelah Roxy meninggal,
Dialogue: 0,0:12:50.67,0:12:53.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku jadi tidak bisa melakukan\Nsegalanya dengan benar?
Dialogue: 0,0:12:59.88,0:13:02.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak, selamat datang.
Dialogue: 0,0:13:02.34,0:13:05.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makannya sebentar lagi siap, ditunggu, ya.
Dialogue: 0,0:13:10.05,0:13:11.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hai.
Dialogue: 0,0:13:11.98,0:13:13.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ini.
Dialogue: 0,0:13:13.82,0:13:17.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kupanggil, tetap saja\Ntidak muncul di saat yang penting.
Dialogue: 0,0:13:17.11,0:13:19.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang ada urusan apa sekarang?
Dialogue: 0,0:13:19.15,0:13:21.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kepingin menyapamu\Nuntuk terakhir kalinya.
Dialogue: 0,0:13:22.13,0:13:24.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk terakhir kali?\NBilang apa kau ini?
Dialogue: 0,0:13:24.75,0:13:26.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti yang kukatakan.
Dialogue: 0,0:13:26.25,0:13:28.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya aku sudah tidak punya\Nurusan denganmu lagi.
Dialogue: 0,0:13:30.53,0:13:34.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertemuanku denganmu itu\Nsaat bencana teleportasi terjadi, kan?
Dialogue: 0,0:13:34.65,0:13:37.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, waktu itu aku benar-benar bikin panik.
Dialogue: 0,0:13:37.10,0:13:39.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya masa depan tiba-tiba berubah.
Dialogue: 0,0:13:39.90,0:13:43.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi berkahku tidak mempan padamu,
Dialogue: 0,0:13:43.29,0:13:46.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi benar-benar susah untuk\Nmendapat kepercayaanmu.
Dialogue: 0,0:13:46.42,0:13:50.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, pada akhirnya kamu pun mau\Nmenuruti permintaanku.
Dialogue: 0,0:13:50.42,0:13:52.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja kerasku akhirnya terbayar.
Dialogue: 0,0:13:52.58,0:13:54.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permintaanmu?
Dialogue: 0,0:13:54.42,0:13:57.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak salah, yang menyuruh\Nmemeriksa rubanah.
Dialogue: 0,0:13:57.07,0:14:01.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, berkatnya aku jadi berhasil\Nmembunuh Roxy.
Dialogue: 0,0:14:05.45,0:14:08.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bilang apa kau ini?
Dialogue: 0,0:14:08.09,0:14:10.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah melawak yang tidak lucu.
Dialogue: 0,0:14:13.98,0:14:15.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau...
Dialogue: 0,0:14:16.00,0:14:18.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau yang membunuh Roxy?
Dialogue: 0,0:14:18.59,0:14:21.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih tepatnya bukan aku.
Dialogue: 0,0:14:21.20,0:14:23.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa ikut campur secara langsung.
Dialogue: 0,0:14:24.03,0:14:28.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma memberi nasihat dan dirimu\Nhanya menjalankannya seperti biasa.
Dialogue: 0,0:14:29.46,0:14:32.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu artinya, yang sudah membunuh dia...
Dialogue: 0,0:14:33.30,0:14:34.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin dirimu.
Dialogue: 0,0:14:34.56,0:14:36.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau yang sudah membunuhnya?!
Dialogue: 0,0:14:36.86,0:14:38.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kau!
Dialogue: 0,0:14:40.02,0:14:41.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kau...
Dialogue: 0,0:14:45.60,0:14:48.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mukamu itu yang pengin kulihat!
Dialogue: 0,0:14:48.33,0:14:51.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau membunuh Roxy?
Dialogue: 0,0:14:51.55,0:14:53.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya jadi kacau setelah itu!
Dialogue: 0,0:14:53.78,0:14:56.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya menghilang satu per satu.
Dialogue: 0,0:14:57.31,0:14:59.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu masalahmu sendiri, kan?
Dialogue: 0,0:14:59.54,0:15:03.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak awal kamu memang punya\Nbibit buat jadi seperti itu.
Dialogue: 0,0:15:03.09,0:15:06.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan limpahkan\Nsemua kesalahan pada diriku, dong.
Dialogue: 0,0:15:06.72,0:15:11.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, melihat dirimu yang hancur\Nberkeping-keping itu menghibur sekali.
Dialogue: 0,0:15:11.85,0:15:13.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berengsek!
Dialogue: 0,0:15:14.51,0:15:18.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh iya, biar kuberi tahu sesuatu\Nuntuk terakhir kalinya.
Dialogue: 0,0:15:19.10,0:15:24.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Roxy itu sebenarnya sedang hamil.
Dialogue: 0,0:15:25.11,0:15:30.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat dirimu yang bodoh itu,\Nsemua jadi berjalan sesuai rencanaku!
Dialogue: 0,0:15:33.70,0:15:36.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, terima kasih sudah bekerja keras.
Dialogue: 0,0:15:38.31,0:15:42.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, hei!\NUrusan kita masih belum selesai!
Dialogue: 0,0:15:42.17,0:15:45.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dewa Manusia!
Dialogue: 0,0:16:02.34,0:16:06.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mungkin keberadaannya itu\Nhanya mimpi belaka?
Dialogue: 0,0:16:06.64,0:16:10.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu terpikirkan olehku karena petunjuk\Nsoal Dewa Manusia sama sekali tidak ketemu.
Dialogue: 0,0:16:11.41,0:16:12.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:16:12.46,0:16:14.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sensasi sentuhannya di bahuku.
Dialogue: 0,0:16:14.29,0:16:15.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara tawanya.
Dialogue: 0,0:16:15.79,0:16:17.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini semua nyata.
Dialogue: 0,0:16:17.94,0:16:20.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun caranya harus\Nkukumpulkan informasi,
Dialogue: 0,0:16:20.50,0:16:21.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mencari keberadaannya,
Dialogue: 0,0:16:21.87,0:16:24.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan membunuh si berengsek itu!
Dialogue: 0,0:16:28.72,0:16:29.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:16:31.25,0:16:36.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau pernah dengar soal Dewa Manusia?
Dialogue: 0,0:16:38.53,0:16:40.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan dia juga, ya.
Dialogue: 0,0:16:40.89,0:16:44.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira ada lagi\Norang yang mungkin tahu atau tidak?
Dialogue: 0,0:16:48.22,0:16:52.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah, sekarang katakan saja padaku\Nsoal Dewa Manusia.
Dialogue: 0,0:16:52.79,0:16:53.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eris.
Dialogue: 0,0:16:55.95,0:16:58.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan matamu itu?!
Dialogue: 0,0:17:05.85,0:17:07.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayolah, katakan sesuatu.
Dialogue: 0,0:17:07.49,0:17:09.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya kau ini lebih cerewet, kan?
Dialogue: 0,0:17:10.42,0:17:16.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kematian Sylphy hingga saat ini,\Ndia selalu saja menggangguku.
Dialogue: 0,0:17:16.81,0:17:18.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti tahu sesuatu.
Dialogue: 0,0:17:18.97,0:17:20.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuatu.
Dialogue: 0,0:17:23.56,0:17:26.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin saja tanya\Nsoal Dewa Manusia ke Perugius.
Dialogue: 0,0:17:26.52,0:17:30.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, akan sangat merepotkan\Nkalau ternyata dia di pihak Dewa Manusia.
Dialogue: 0,0:17:30.22,0:17:32.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus hati-hati bertindak.
Dialogue: 0,0:17:39.83,0:17:41.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pak Greyrat!
Dialogue: 0,0:17:44.42,0:17:45.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aisha!
Dialogue: 0,0:17:45.68,0:17:46.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aisha!
Dialogue: 0,0:17:51.53,0:17:52.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zanoba?!
Dialogue: 0,0:18:20.26,0:18:24.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aisha dan Zanoba tetap bersikap biasa\Nmeski aku seperti ini.
Dialogue: 0,0:18:25.26,0:18:29.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa di saat genting,\Naku malah tidak di sisi mereka?
Dialogue: 0,0:18:30.22,0:18:34.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, masih belum selesai.\NMasih ada yang bisa kulakukan.
Dialogue: 0,0:18:34.52,0:18:38.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suku iblis abadi yang hidup panjang\Npasti tahu soal Dewa Manusia.
Dialogue: 0,0:18:38.72,0:18:40.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih belum kalah.
Dialogue: 0,0:18:48.69,0:18:51.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh juga dirimu, wahai pahlawan!
Dialogue: 0,0:18:56.99,0:18:58.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah terbaca!
Dialogue: 0,0:19:02.96,0:19:06.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti bisa, asal terus kutekan\Nseperti ini sampai hancur.
Dialogue: 0,0:19:08.04,0:19:09.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai roh air...
Dialogue: 0,0:19:10.33,0:19:12.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berilah aku kekuatan!
Dialogue: 0,0:19:12.42,0:19:14.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Deep Mist!
Dialogue: 0,0:19:18.64,0:19:20.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana Atofe?!
Dialogue: 0,0:19:20.76,0:19:22.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kena kau!
Dialogue: 0,0:19:28.21,0:19:29.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eris?!
Dialogue: 0,0:19:39.53,0:19:42.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak bisa lepas!
Dialogue: 0,0:19:46.06,0:19:48.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Moore!
Dialogue: 0,0:19:48.37,0:19:50.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cari mereka!
Dialogue: 0,0:19:56.96,0:20:00.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eris, kenapa?
Dialogue: 0,0:20:01.34,0:20:05.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Putri hanya ingin ada di sisimu.
Dialogue: 0,0:20:06.94,0:20:10.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Putri Eris tidak banyak berubah\Ndari masa lalu.
Dialogue: 0,0:20:11.30,0:20:14.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia terus berjuang demi dirimu.
Dialogue: 0,0:20:14.72,0:20:18.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percaya kelak kau akan mengerti\Ndan menerima dirinya.
Dialogue: 0,0:20:20.09,0:20:24.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja, kau sudah berubah, ya.
Dialogue: 0,0:20:24.11,0:20:25.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin.
Dialogue: 0,0:20:26.19,0:20:29.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti dia selama ini...
Dialogue: 0,0:20:29.87,0:20:35.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus, terus dan terus memikirkanku?
Dialogue: 0,0:20:36.72,0:20:41.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin aku bisa tahu itu.
Dialogue: 0,0:20:51.04,0:20:54.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya semua\Nyang berharga bagiku telah tiada.
Dialogue: 0,0:20:54.91,0:20:57.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak berhasil melindungi siapa pun.
Dialogue: 0,0:20:58.11,0:20:59.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini salah Dewa Manusia!
Dialogue: 0,0:21:00.21,0:21:04.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paling tidak aku harus membunuh Dewa Manusia.
Dialogue: 0,0:21:07.95,0:21:11.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya, akhirnya aku mengerti!
Dialogue: 0,0:21:11.49,0:21:15.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia ini awalnya tercipta\Ndari enam buah dunia.
Dialogue: 0,0:21:15.99,0:21:18.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaikan enam sisi.
Dialogue: 0,0:21:18.36,0:21:21.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kata lain terhubung\Nseperti sebuah dadu.
Dialogue: 0,0:21:22.21,0:21:27.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu sisi dalamnya yang disebut Dunia Hampa,\Nadalah tempat Dewa Manusia berada.
Dialogue: 0,0:21:27.49,0:21:30.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya butuh ilmu rahasia suku naga\Nuntuk pergi ke sana.
Dialogue: 0,0:21:31.39,0:21:36.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetapi, apa sebenarnya lima harta rahasia\Nyang dibutuhkan untuk itu?
Dialogue: 0,0:21:38.82,0:21:40.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut Perugius,
Dialogue: 0,0:21:40.61,0:21:45.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kelima harta itu baru akan muncul di dunia\Nbeberapa dekade lagi.
Dialogue: 0,0:21:45.19,0:21:48.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kemungkinan aku tidak akan mampu\Nhidup hingga saat itu.
Dialogue: 0,0:21:49.90,0:21:52.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah lelah.
Dialogue: 0,0:21:52.78,0:21:56.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dendamku pada Dewa Manusia pun\Nrasanya perlahan memudar.
Dialogue: 0,0:21:56.85,0:22:01.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi apa, dan demi siapa\Naku melakukan semuanya?
Dialogue: 0,0:22:10.80,0:22:12.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo ke masa lalu.
Dialogue: 0,0:22:12.34,0:22:16.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir pemanggilan serta sihir\Ndari lukisan relief suku naga.
Dialogue: 0,0:22:16.14,0:22:19.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau keduanya dipakai\Ndengan mengubah urutannya,
Dialogue: 0,0:22:19.12,0:22:21.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harusnya bisa berteleportasi ke masa lalu.
Dialogue: 0,0:22:24.27,0:22:26.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja banyak yang membuatku cemas.
Dialogue: 0,0:22:26.71,0:22:31.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah diriku di masa lalu akan percaya\Npada ucapanku dari masa depan ini?
Dialogue: 0,0:22:31.06,0:22:33.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, aku tidak tahu apa\Nsungguhan bisa ke masa lalu.
Dialogue: 0,0:22:36.03,0:22:39.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau bisa berhasil...
Dialogue: 0,0:22:39.00,0:22:42.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin bisa untuk membalas\Nperbuatan Dewa Manusia.
Dialogue: 0,0:22:47.78,0:22:51.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, sudah cukup.\NJangan bicara lagi.
Dialogue: 0,0:22:51.70,0:22:55.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar kau tidak menyesal...
Dialogue: 0,0:22:55.57,0:23:00.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal rubanah, soal Nanahoshi, soal Eris.
Dialogue: 0,0:23:00.98,0:23:03.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu soal Dewa Manusia.
Dialogue: 0,0:23:04.00,0:23:06.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku bisa menyampaikan\Nitu semua sampai selesai?
Dialogue: 0,0:23:07.70,0:23:11.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya ingin sekali saja\Nmelihat Sylphy dan Roxy lagi...
Dialogue: 0,0:23:15.83,0:23:20.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, Sylphy... Roxy...
Dialogue: 0,0:23:21.04,0:23:23.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan...
Dialogue: 0,0:23:24.00,0:23:29.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian selalu sangat manis...
