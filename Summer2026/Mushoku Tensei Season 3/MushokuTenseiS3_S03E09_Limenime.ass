Dialogue: 0,0:22:03.73,0:22:04.93,sign,,0000,0000,0000,,EPISODE 9: TANGIS PILU
Dialogue: 0,0:23:34.93,0:23:39.94,sign,,0000,0000,0000,,SELANJUTNYA: PERTEMUAN DENGAN RAJA IBLIS ABADI
Dialogue: 0,0:00:00.00,0:00:03.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mushoku Tensei:\NJobless Reincarnation Season 3
Dialogue: 0,0:00:03.54,0:00:06.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiga hari berlalu sejak\NNanahoshi jatuh pingsan.
Dialogue: 0,0:00:07.41,0:00:09.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ia masih belum kunjung sadar.
Dialogue: 0,0:00:09.38,0:00:11.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyebab muntah darahnya pun\Nbelum diketahui.
Dialogue: 0,0:00:12.33,0:00:13.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuruzu sang Penebus Dosa sepertinya
Dialogue: 0,0:00:13.91,0:00:18.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}punya kekuatan untuk memindah stamina\Ndan kesehatan dari orang lain.
Dialogue: 0,0:00:18.34,0:00:21.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sehingga bisa menyembuhkan\Nsebagian besar penyakit.
Dialogue: 0,0:00:21.88,0:00:26.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sylphy berpikir Nanahoshi terkapar\Nkarena ilmu sihirnya.
Dialogue: 0,0:00:27.39,0:00:29.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merasa sangat bertanggung jawab,
Dialogue: 0,0:00:29.51,0:00:32.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia pun tidak mau digantikan\Ndalam membantu pengobatan.
Dialogue: 0,0:00:32.34,0:00:36.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga Nanahoshi segera membaik\Ndemi Sylphy juga.
Dialogue: 0,0:00:38.89,0:00:41.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana, Karowante?
Dialogue: 0,0:00:41.38,0:00:45.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada jejak gangguan selain\Ndari sihir penawar racun.
Dialogue: 0,0:00:45.89,0:00:49.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aliran daya sihir di dalam tubuhnya\Nterlihat terhambat, tetapi...
Dialogue: 0,0:00:49.70,0:00:51.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}penyebabnya belum jelas.
Dialogue: 0,0:00:51.58,0:00:53.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu coba cari di ruang arsip.
Dialogue: 0,0:00:53.45,0:00:54.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Baik.\N- Baik.
Dialogue: 0,0:00:54.61,0:00:56.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izinkan aku membantu!
Dialogue: 0,0:00:56.14,0:00:57.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah.
Dialogue: 0,0:00:57.75,0:01:00.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak berniat memasukkan\Norang luar ke ruang arsip.
Dialogue: 0,0:01:08.21,0:01:10.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanahoshi akan sembuh atau tidak, ya?
Dialogue: 0,0:01:11.25,0:01:14.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya sesuai kehendak Dewa Milis.
Dialogue: 0,0:01:19.35,0:01:21.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini seperti di film yang dulu kutonton.
Dialogue: 0,0:01:21.77,0:01:25.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alien yang datang ke bumi,\Nmusnah karena flu.
Dialogue: 0,0:01:26.42,0:01:29.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia akan mati?
Dialogue: 0,0:01:32.86,0:01:35.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyakit Nona Nanahoshi telah diketahui.
Dialogue: 0,0:01:36.26,0:01:38.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wabah Drain.
Dialogue: 0,0:01:38.31,0:01:39.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyakit pada dahulu kala
Dialogue: 0,0:01:39.91,0:01:44.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat daya sihir manusia jauh\Nlebih sedikit dari sekarang.
Dialogue: 0,0:01:44.03,0:01:48.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu, mereka yang tidak mampu menetralkan\Ndaya sihir yang masuk ke dalam tubuh,
Dialogue: 0,0:01:48.09,0:01:50.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan kehilangan nyawa tanpa kecuali.
Dialogue: 0,0:01:50.36,0:01:51.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah yang tertulis.
Dialogue: 0,0:01:51.80,0:01:55.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya itu tidak bertentangan\Ndengan kondisi Nanahoshi sekarang.
Dialogue: 0,0:01:56.59,0:01:58.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada metode penyembuhannya?
Dialogue: 0,0:01:58.18,0:01:59.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak diketahui.
Dialogue: 0,0:01:59.77,0:02:02.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja sekitar 7000 tahun lalu,
Dialogue: 0,0:02:02.39,0:02:06.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah musnah dengan menguatnya\Ndaya sihir manusia.
Dialogue: 0,0:02:06.53,0:02:11.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}7000 tahun yang lalu berarti,\Nsaat perang manusia dan iblis yang pertama.
Dialogue: 0,0:02:11.55,0:02:13.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, sekarang mau bagaimana?
Dialogue: 0,0:02:13.70,0:02:19.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuhentikan waktu Nanahoshi\Ndengan kekuatan Sukeakoto sang Waktu.
Dialogue: 0,0:02:19.08,0:02:23.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selagi itu, akan kuminta orang di muka bumi\Nuntuk mencari cara menyembuhkannya.
Dialogue: 0,0:02:23.74,0:02:27.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tidak bisa ditangani\Ndengan kuasa Tuan Perugius?
Dialogue: 0,0:02:27.30,0:02:30.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diriku dan Nanahoshi hanyalah rekan bisnis.
Dialogue: 0,0:02:30.71,0:02:34.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan menolong\Nsampai berutang pada seseorang.
Dialogue: 0,0:02:36.43,0:02:38.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, jangan salah paham.
Dialogue: 0,0:02:38.34,0:02:42.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama masih menjadi tamuku,\Naku tetap akan memberi sedikit bantuan.
Dialogue: 0,0:02:42.60,0:02:44.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetapi, tidak akan sepenuhnya kutolong.
Dialogue: 0,0:02:44.97,0:02:48.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena tujuan hidupku hanyalah\Nmenemukan Laplace
Dialogue: 0,0:02:48.02,0:02:51.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang kelak akan bangkit, lalu mengalahkannya.
Dialogue: 0,0:02:51.79,0:02:53.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laplace akan bangkit?!
Dialogue: 0,0:02:53.76,0:02:56.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena disegel, berarti ada batas waktunya?!
Dialogue: 0,0:02:56.61,0:02:59.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang akan terjadi bila dia bangkit?
Dialogue: 0,0:02:59.50,0:03:01.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bicara soal Laplace.
Dialogue: 0,0:03:01.37,0:03:05.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti akan membawa suku iblis dan\Ndatang menghancurkan suku manusia lagi.
Dialogue: 0,0:03:08.16,0:03:10.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena punya tujuan seperti itu,
Dialogue: 0,0:03:10.63,0:03:14.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maka menolong kami pun ada batasnya.
Dialogue: 0,0:03:14.13,0:03:16.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi mau menelantarkan Nanahoshi?!
Dialogue: 0,0:03:16.53,0:03:18.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kubilang akan ditelantarkan.
Dialogue: 0,0:03:18.76,0:03:19.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bohong!
Dialogue: 0,0:03:19.65,0:03:23.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang sehebat dirimu seharusnya bisa\Nmencari cara mengobati Nanahoshi!
Dialogue: 0,0:03:25.05,0:03:28.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski bisa, bukan berarti\Nharus dia sendiri yang mencari.
Dialogue: 0,0:03:28.15,0:03:29.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bercanda!
Dialogue: 0,0:03:29.73,0:03:32.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menolong mereka yang lemah\Nadalah tugas mereka yang kuat!
Dialogue: 0,0:03:33.42,0:03:36.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan memaksakan ajaran Milis\Nyang menjengkelkan itu.
Dialogue: 0,0:03:36.82,0:03:37.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa katamu?!
Dialogue: 0,0:03:37.99,0:03:41.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perkataanmu sama saja\Nmau menelantarkan Nanahoshi!
Dialogue: 0,0:03:41.49,0:03:42.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menolong ya harus sampai tun...
Dialogue: 0,0:03:42.79,0:03:43.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, hentikan!
Dialogue: 0,0:03:44.53,0:03:47.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti perasaanmu, tapi tahanlah dulu.
Dialogue: 0,0:03:47.35,0:03:50.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ingin kehilangan dirimu\Nhanya karena hal ini.
Dialogue: 0,0:03:58.00,0:04:01.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak terima, bagaimana kalau\Nkau sendiri yang bergerak?
Dialogue: 0,0:04:01.51,0:04:04.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah dewamu juga bilang begitu?
Dialogue: 0,0:04:04.10,0:04:08.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mengandalkan orang\Nsaat menolong orang lain, bukankah begitu?
Dialogue: 0,0:04:12.02,0:04:14.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menolong Nanahoshi.
Dialogue: 0,0:04:14.24,0:04:17.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Perugius punya batasnya sendiri.
Dialogue: 0,0:04:17.63,0:04:20.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, mana mungkin aku bisa...
Dialogue: 0,0:04:24.62,0:04:25.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:04:27.45,0:04:30.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Nanahoshi telah kembali sadar.
Dialogue: 0,0:04:37.81,0:04:39.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baik-baik saja?
Dialogue: 0,0:04:43.60,0:04:45.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang kelihatannya baik-baik saja?
Dialogue: 0,0:04:50.54,0:04:54.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyakitku, katanya tidak bisa diobati.
Dialogue: 0,0:04:54.61,0:04:57.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bukan berarti tidak bisa disembuhkan.
Dialogue: 0,0:04:57.11,0:04:59.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma tidak tahu cara pengobatannya.
Dialogue: 0,0:04:59.05,0:05:02.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar sekali, tinggal dicari tahu saja.
Dialogue: 0,0:05:02.24,0:05:03.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan patah semangat.
Dialogue: 0,0:05:03.55,0:05:06.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kalau sampai patah semangat saat tidak sehat,\N- Bagi orang sedang benar-benar menderita,
Dialogue: 0,0:05:06.04,0:05:09.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- sakit yang harusnya sembuh tidak akan sembuh.\N- kalimat pelipur sesuatu yang paling tak ingin didengar.
Dialogue: 0,0:05:12.96,0:05:15.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan kalimat yang bisa kuucapkan.
Dialogue: 0,0:05:29.02,0:05:34.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak awal tubuhku memang tidak terlalu kuat.
Dialogue: 0,0:05:35.01,0:05:38.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya gampang sakit juga, sih.
Dialogue: 0,0:05:38.54,0:05:41.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setahun sekali pasti bakal kena flu.
Dialogue: 0,0:05:41.99,0:05:46.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ilmu kedokteran di dunia ini\Ntidak terlalu berkembang, kan?
Dialogue: 0,0:05:46.29,0:05:48.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah karena ada ilmu sihir atau bukan.
Dialogue: 0,0:05:48.76,0:05:51.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mencuci luka terbuka saja tidak, lo.
Dialogue: 0,0:05:52.06,0:05:56.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak orang yang terlambat ditolong\Ndan mati karena itu.
Dialogue: 0,0:05:56.50,0:05:58.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh sekali, kan?
Dialogue: 0,0:05:59.84,0:06:07.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah sangat berhati-hati sejak tahu\Nkalau diriku tidak bisa memakai sihir, lo.
Dialogue: 0,0:06:07.51,0:06:10.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena, kalau sampai sakit...
Dialogue: 0,0:06:11.49,0:06:15.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kurasa aku mungkin tidak bisa disembuhkan.
Dialogue: 0,0:06:16.27,0:06:20.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, bukankah dunia ini aneh?
Dialogue: 0,0:06:20.05,0:06:23.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hampir seluruhnya mengabaikan\Nhukum fisika begitu saja.
Dialogue: 0,0:06:23.85,0:06:29.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, saat baru tiba di sini,\Naku juga merasa dunia ini menarik.
Dialogue: 0,0:06:30.06,0:06:32.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bohong jadinya kalau kubilang
Dialogue: 0,0:06:32.41,0:06:36.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dunia lain berisi pedang dan sihir\Nmembuatku tidak tertarik.
Dialogue: 0,0:06:45.18,0:06:48.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau mati di tempat seperti ini.
Dialogue: 0,0:06:49.64,0:06:51.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau mati!
Dialogue: 0,0:06:51.10,0:06:53.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau mati di dunia gila ini!
Dialogue: 0,0:06:54.34,0:06:56.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?!\NTidak masuk akal!
Dialogue: 0,0:06:56.59,0:07:00.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahu tidak? Aku sama sekali tidak berubah\Nsejak delapan tahun lalu!
Dialogue: 0,0:07:00.77,0:07:03.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak tambah tinggi,\Nrambutku pun tetap sama!
Dialogue: 0,0:07:03.19,0:07:06.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal perutku bisa lapar, tetap bisa makan,\Ndan bisa buang air!
Dialogue: 0,0:07:06.66,0:07:09.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kukuku tidak tumbuh,\Ntidak datang bulan juga!
Dialogue: 0,0:07:09.03,0:07:11.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan manusia dari dunia ini!
Dialogue: 0,0:07:11.87,0:07:13.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak hidup di dunia ini!
Dialogue: 0,0:07:13.79,0:07:15.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi sama seperti mayat!
Dialogue: 0,0:07:16.82,0:07:20.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kenapa...
Dialogue: 0,0:07:20.42,0:07:23.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa malah bisa terserang penyakit?!
Dialogue: 0,0:07:25.71,0:07:27.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya aneh?!
Dialogue: 0,0:07:27.30,0:07:30.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa nasibku harus jadi seperti ini?!
Dialogue: 0,0:07:31.34,0:07:32.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau mati!
Dialogue: 0,0:07:32.89,0:07:37.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ingin... Aku tidak ingin\Nmati di dunia aneh seperti ini!
Dialogue: 0,0:07:37.19,0:07:41.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku saja belum pernah berciuman!
Dialogue: 0,0:07:41.39,0:07:43.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku suka seseorang,\Ntapi belum bilang suka padanya!
Dialogue: 0,0:07:43.98,0:07:44.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenanglah dulu.
Dialogue: 0,0:07:44.82,0:07:47.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini iri denganmu!
Dialogue: 0,0:07:47.50,0:07:50.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiap hari kelihatan senang sekali!\NHidupmu lancar sekali!
Dialogue: 0,0:07:50.47,0:07:51.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan kau ini?!
Dialogue: 0,0:07:51.74,0:07:53.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahmu mati katamu?!
Dialogue: 0,0:07:53.43,0:07:56.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kondisi ibumu parah karena penyakit?!
Dialogue: 0,0:07:56.12,0:07:58.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus kenapa?! Apa salahnya?!
Dialogue: 0,0:07:58.71,0:08:03.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tetap begini, aku tidak akan bisa\Nmelihat ayahku saat meninggal!
Dialogue: 0,0:08:03.00,0:08:07.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walaupun aku mati,\Nibuku tidak akan tahu soal itu!
Dialogue: 0,0:08:08.18,0:08:14.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin bertemu lagi,\Ndengan ayahku, dengan ibuku.
Dialogue: 0,0:08:19.07,0:08:22.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih ingat kejadian di pagi hari itu.
Dialogue: 0,0:08:23.77,0:08:28.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah bilang hari itu akan pulang cepat.
Dialogue: 0,0:08:29.41,0:08:34.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu bilang nanti malam akan\Nmemanggang ikan sanma.
Dialogue: 0,0:08:34.72,0:08:40.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bilang ke ayah buat pulang telat saja\Nkarena temanku akan datang.
Dialogue: 0,0:08:40.74,0:08:45.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga protes ke ibu kalau sudah bosan\Nsama ikan sanma.
Dialogue: 0,0:08:45.89,0:08:48.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku mengatakan itu...
Dialogue: 0,0:08:49.44,0:08:54.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti, ayah dan ibu mengkhawatirkanku.
Dialogue: 0,0:08:54.73,0:08:56.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin ketemu mereka.
Dialogue: 0,0:08:56.35,0:08:58.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin pulang.
Dialogue: 0,0:08:58.16,0:09:00.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau mati.
Dialogue: 0,0:09:00.31,0:09:03.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ingin mati di tempat seperti ini!
Dialogue: 0,0:09:08.51,0:09:11.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingin pulang, ingin bertemu keluarga lagi.
Dialogue: 0,0:09:11.58,0:09:13.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski diberi tahu hal seperti itu.
Dialogue: 0,0:09:13.41,0:09:17.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti tidak akan mengena pada diriku\Nsaat masih awal tiba di dunia ini.
Dialogue: 0,0:09:18.30,0:09:20.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sekarang aku bisa mengerti.
Dialogue: 0,0:09:21.17,0:09:24.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betapa berharganya keseharian biasa\Nbersama keluarga.
Dialogue: 0,0:09:24.81,0:09:26.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betapa menakutkannya kehilangan itu.
Dialogue: 0,0:09:28.02,0:09:31.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila keseharian berharga itu akan terancam.
Dialogue: 0,0:09:31.17,0:09:33.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti juga akan berjuang mati-matian.
Dialogue: 0,0:09:33.80,0:09:35.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin saja.
Dialogue: 0,0:09:35.14,0:09:41.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang mengingatkan Nanahoshi pada Jepang\Nadalah satu-satunya penghibur baginya.
Dialogue: 0,0:09:41.42,0:09:43.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada keseharian yang telah hilang.
Dialogue: 0,0:09:43.69,0:09:47.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai satu-satunya yang ia rasa\Nterhubung pada dunia itu.
Dialogue: 0,0:09:47.48,0:09:50.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa saja, tolong aku.
Dialogue: 0,0:10:01.38,0:10:02.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:10:02.62,0:10:04.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga akan bergerak.
Dialogue: 0,0:10:04.25,0:10:08.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila bisa mendapat bantuan dalam taraf\Ntidak mengganggu pekerjaan Tuan Perugius,
Dialogue: 0,0:10:08.05,0:10:09.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan sangat berterima kasih.
Dialogue: 0,0:10:09.63,0:10:13.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, jadi kisanak mau bergerak.
Dialogue: 0,0:10:17.69,0:10:18.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:10:19.13,0:10:23.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sendiri tidak tega bila\Nmelihat Nanahoshi mati.
Dialogue: 0,0:10:23.13,0:10:24.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:10:25.17,0:10:27.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langsung saja, Tuan Perugius.
Dialogue: 0,0:10:27.30,0:10:30.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah Anda bisa menghubungi\NDewa Naga Orsted?
Dialogue: 0,0:10:30.10,0:10:31.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil.
Dialogue: 0,0:10:31.82,0:10:34.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, dia baru muncul\Nsekitar 100 tahun lalu.
Dialogue: 0,0:10:34.95,0:10:40.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski dia berpengetahuan luas, tidak mungkin\Ntahu soal penyakit dari 7000 tahun lalu.
Dialogue: 0,0:10:40.62,0:10:42.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:10:42.16,0:10:45.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, 7000 tahun lalu?
Dialogue: 0,0:10:45.49,0:10:49.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, apakah memungkinkan\Njika aku dikirim ke Benua Iblis?
Dialogue: 0,0:10:49.29,0:10:52.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benua Iblis?\NApa yang mau kau lakukan?
Dialogue: 0,0:10:54.16,0:10:58.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kucoba bertanya pada\NKishirika Kishirisu sang Kaisar Iblis.
Dialogue: 0,0:10:59.58,0:11:02.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kishirika Kishirisu sang Kaisar Iblis.
Dialogue: 0,0:11:02.66,0:11:05.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang memberiku Mata Terka.
Dialogue: 0,0:11:05.69,0:11:07.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut semua buku sejarah,
Dialogue: 0,0:11:07.60,0:11:12.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia adalah tokoh kunci dalam perang besar\Nmanusia dan iblis yang pecah 7000 tahun lalu.
Dialogue: 0,0:11:13.26,0:11:18.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencananya adalah mencari Kishirika dan\Nmenanyakan cara pengobatannya, hanya saja...
Dialogue: 0,0:11:18.57,0:11:23.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masalahnya adalah dia berkeliaran\Ndi berbagai penjuru Benua Iblis.
Dialogue: 0,0:11:23.26,0:11:25.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, akan sulit untuk menemukannya.
Dialogue: 0,0:11:25.54,0:11:27.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah akan butuh waktu berapa bulan.
Dialogue: 0,0:11:27.88,0:11:32.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetapi, demi menyelamatkan Nanahoshi,\Naku ingin minta bantuan kalian semua.
Dialogue: 0,0:11:32.70,0:11:37.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu ceritanya, aku akan membantu\Nmenyiapkan perjalanannya.
Dialogue: 0,0:11:37.47,0:11:39.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:11:39.42,0:11:43.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zanoba dan Elinalise tolong ikut\Njadi pengawalku.
Dialogue: 0,0:11:43.21,0:11:45.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan padaku, Guru.
Dialogue: 0,0:11:45.02,0:11:46.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, aku mengerti.
Dialogue: 0,0:11:46.86,0:11:47.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ikut!
Dialogue: 0,0:11:48.67,0:11:52.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mengerti perasaan Nanahoshi\Nyang ingin pulang ke kampung halaman.
Dialogue: 0,0:11:52.48,0:11:53.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan aku ikut.
Dialogue: 0,0:11:53.78,0:11:55.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin berbuat sesuatu untuk dia.
Dialogue: 0,0:11:56.09,0:11:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon!
Dialogue: 0,0:11:59.36,0:12:00.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:12:00.49,0:12:01.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, boleh?!
Dialogue: 0,0:12:01.53,0:12:03.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, mohon bantuannya.
Dialogue: 0,0:12:03.78,0:12:04.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan padaku!
Dialogue: 0,0:12:05.15,0:12:07.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sebaiknya melakukan apa?
Dialogue: 0,0:12:07.64,0:12:11.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin Sylphy memulihkan diri\Ndari keletihan pengobatan di sini.
Dialogue: 0,0:12:11.82,0:12:13.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, lalu setelah itu?
Dialogue: 0,0:12:13.92,0:12:15.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah kamu istirahat...
Dialogue: 0,0:12:17.76,0:12:21.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin kamu pulang dan\Nmerawat Lucy di rumah.
Dialogue: 0,0:12:22.76,0:12:25.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku mungkin tidak akan pulang\Ndalam waktu lama.
Dialogue: 0,0:12:25.65,0:12:30.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku tidak baik untuk anak kalau\Nselama itu tidak ada orang tuanya.
Dialogue: 0,0:12:32.15,0:12:35.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, sepertinya memang benar.
Dialogue: 0,0:12:35.24,0:12:39.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Rudy tidak ada,\Nharus aku yang merawat Lucy, kan?
Dialogue: 0,0:12:39.86,0:12:41.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:12:41.17,0:12:42.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah.
Dialogue: 0,0:12:42.62,0:12:45.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sylphy sudah berbuat cukup banyak, kok.
Dialogue: 0,0:12:45.26,0:12:46.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan saja sisanya.
Dialogue: 0,0:12:47.30,0:12:48.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:12:48.60,0:12:51.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, jangan sampai tanganmu hilang lagi, ya?
Dialogue: 0,0:12:52.34,0:12:53.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuusahakan.
Dialogue: 0,0:12:55.11,0:12:56.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?!
Dialogue: 0,0:12:56.25,0:12:58.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan pulang lagi\Nuntuk sementara waktu?!
Dialogue: 0,0:12:58.38,0:12:59.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hush, Aisha!
Dialogue: 0,0:12:59.91,0:13:02.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya, Ibu...
Dialogue: 0,0:13:02.09,0:13:05.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Niatnya aku tetap akan pulang\Nbeberapa hari sekali.
Dialogue: 0,0:13:06.24,0:13:08.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini ada bantuan dari Perugius.
Dialogue: 0,0:13:09.10,0:13:11.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu perjalanannya hampir tidak ada.
Dialogue: 0,0:13:11.42,0:13:13.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa pulang kapan saja tanpa hambatan.
Dialogue: 0,0:13:14.46,0:13:16.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak, tolong hati-hati.
Dialogue: 0,0:13:16.86,0:13:17.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:13:17.96,0:13:20.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Norn juga yang semangat\Nmengurus pekerjaan OSIS.
Dialogue: 0,0:13:20.36,0:13:21.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:13:27.46,0:13:29.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, tolong jaga rumah.
Dialogue: 0,0:13:29.75,0:13:32.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan saja urusan rumah pada kami.
Dialogue: 0,0:13:32.29,0:13:35.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Rudeus,\Nsemoga keberuntungan menyertai Anda.
Dialogue: 0,0:13:35.81,0:13:36.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:13:41.99,0:13:46.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, masih ada ruang seperti ini\Ndi bagian bawah tanah.
Dialogue: 0,0:13:46.81,0:13:50.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lingkaran sihir inilah yang terdekat\Ndengan Kaisar Iblis.
Dialogue: 0,0:13:50.98,0:13:53.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu kata Tuan Perugius.
Dialogue: 0,0:13:53.23,0:13:57.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, Tuan Perugius punya petunjuk\Ndi mana Paduka Kishirika berada?
Dialogue: 0,0:13:57.53,0:13:59.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah tentu.
Dialogue: 0,0:13:59.15,0:14:02.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, situasi di sana belum dikonfirmasi.
Dialogue: 0,0:14:02.70,0:14:04.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon waspada.
Dialogue: 0,0:14:04.03,0:14:07.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kalau sekiranya tidak berhasil,\Nkami akan kembali dulu kemari.
Dialogue: 0,0:14:08.29,0:14:09.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati di jalan.
Dialogue: 0,0:14:09.87,0:14:10.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:14:15.82,0:14:18.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maju, Zanoba Robo!\NBuka jalannya!
Dialogue: 0,0:14:18.94,0:14:20.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap, Guru!
Dialogue: 0,0:14:23.93,0:14:27.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Guru, robo itu apa?
Dialogue: 0,0:14:27.34,0:14:30.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di suatu daerah, itu sebutan\Nuntuk pria dengan badan
Dialogue: 0,0:14:30.58,0:14:32.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seperti baja dan kekuatan luar biasa.
Dialogue: 0,0:14:32.66,0:14:36.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya,\NGuru memang berpengetahuan luas.
Dialogue: 0,0:14:37.21,0:14:39.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini Benua Iblis.
Dialogue: 0,0:14:42.24,0:14:46.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Cliff, banyak monster raksasa dan ganas\Ndi Benua Iblis.
Dialogue: 0,0:14:46.82,0:14:48.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong hati-hati, ya.
Dialogue: 0,0:14:48.31,0:14:50.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku tahu.
Dialogue: 0,0:14:50.45,0:14:53.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, kemungkinan hampir tidak ada\Npenganut agama Milis.
Dialogue: 0,0:14:53.92,0:14:56.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan berkelahi karena hal sepele.
Dialogue: 0,0:14:56.67,0:14:58.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tahu itu...
Dialogue: 0,0:14:59.09,0:15:01.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, aku akan hati-hati.
Dialogue: 0,0:15:01.77,0:15:05.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tidak mengerti bahasa Dewa Iblis,\Njadi tenang saja.
Dialogue: 0,0:15:06.25,0:15:07.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:15:08.28,0:15:09.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru!
Dialogue: 0,0:15:10.88,0:15:12.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa terlihat sesuatu?
Dialogue: 0,0:15:19.90,0:15:22.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata malah di sini petunjuknya.
Dialogue: 0,0:15:23.12,0:15:29.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat dengan sedikit kenangan tidak enak\Nyang dulu kudatangi bersama Eris dan Ruijerd.
Dialogue: 0,0:15:29.91,0:15:31.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kota Rikarisu.
Dialogue: 0,0:15:36.92,0:15:37.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:15:38.12,0:15:39.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti!
Dialogue: 0,0:15:39.42,0:15:40.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, ya?
Dialogue: 0,0:15:40.54,0:15:42.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar, soal wanita yang di situ.
Dialogue: 0,0:15:47.79,0:15:49.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:15:49.26,0:15:50.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:15:50.10,0:15:51.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm...
Dialogue: 0,0:15:53.38,0:15:59.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, bukannya tidak mirip sama Elinalise,\Ntapi daya sihirnya beda level!
Dialogue: 0,0:15:59.02,0:16:00.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan kusebut di bagian mana.
Dialogue: 0,0:16:00.40,0:16:03.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan dia, mereka boleh lewat.
Dialogue: 0,0:16:03.11,0:16:04.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya ada apa?
Dialogue: 0,0:16:04.44,0:16:07.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tidak perlu tahu.
Dialogue: 0,0:16:07.88,0:16:10.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya mereka mencari seseorang.
Dialogue: 0,0:16:10.43,0:16:12.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya begitu.
Dialogue: 0,0:16:34.11,0:16:35.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf menunggu lama.
Dialogue: 0,0:16:36.22,0:16:37.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah ini mau bagaimana?
Dialogue: 0,0:16:37.99,0:16:40.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau prediksi Perugius tepat,
Dialogue: 0,0:16:40.38,0:16:43.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa jadi ada info kalau Kishirika\Nterlihat di kota ini.
Dialogue: 0,0:16:43.52,0:16:44.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tanya sekitar dulu...
Dialogue: 0,0:16:44.77,0:16:46.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yo!
Dialogue: 0,0:16:46.28,0:16:48.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tidak ketemu.
Dialogue: 0,0:16:48.70,0:16:51.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya sehat-sehat saja.
Dialogue: 0,0:16:53.87,0:16:55.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia yang waktu itu...
Dialogue: 0,0:16:56.49,0:16:59.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah pisah sama Roxy, ya?
Dialogue: 0,0:16:59.49,0:16:59.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:16:59.94,0:17:03.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kalau tidak salah teman satu grup Roxy\Ndi masa lalu, ya.
Dialogue: 0,0:17:03.87,0:17:04.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:17:04.38,0:17:05.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa itu?!
Dialogue: 0,0:17:05.88,0:17:08.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Elinalise, bisa jelaskan\Nlebih jauh soal itu?!
Dialogue: 0,0:17:08.33,0:17:11.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rudeus, tolong diterjemahkan, ya.
Dialogue: 0,0:17:11.22,0:17:14.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kenalan Roxy.
Dialogue: 0,0:17:14.22,0:17:16.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Nokopara.
Dialogue: 0,0:17:16.49,0:17:19.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mengerti bahasaku, ya?
Dialogue: 0,0:17:20.89,0:17:23.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, Nokopara.
Dialogue: 0,0:17:23.19,0:17:26.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa bicara bahasa Dewa Iblis.
Dialogue: 0,0:17:26.27,0:17:29.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tahu banyak situasi kota.
Dialogue: 0,0:17:29.17,0:17:31.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau minta dibantu\Ncari informasi?
Dialogue: 0,0:17:31.40,0:17:33.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:17:33.62,0:17:36.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Ahli Rawa, senang berkenalan denganmu.
Dialogue: 0,0:17:36.74,0:17:38.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Ahli Rawa.
Dialogue: 0,0:17:38.54,0:17:42.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kita pernah ketemu di suatu tempat?
Dialogue: 0,0:17:42.50,0:17:44.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, mana mungkin.
Dialogue: 0,0:17:44.21,0:17:46.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sedang mencari orang,
Dialogue: 0,0:17:46.04,0:17:47.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa tolong dibantu?
Dialogue: 0,0:17:47.38,0:17:50.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berani bayar berapa?
Dialogue: 0,0:17:50.30,0:17:53.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koin hijau dua keping.
Dialogue: 0,0:17:53.68,0:17:55.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ketemu,
Dialogue: 0,0:17:55.30,0:17:57.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kuberi dua keping lagi, bagaimana?
Dialogue: 0,0:17:57.89,0:18:01.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Empat keping?! Yakin, nih?!
Dialogue: 0,0:18:01.89,0:18:04.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Situasi kami memang semendesak itu.
Dialogue: 0,0:18:04.65,0:18:07.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, meski kami punya uang,
Dialogue: 0,0:18:07.27,0:18:09.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jangan berpikiran tidak-tidak, ya.
Dialogue: 0,0:18:09.03,0:18:13.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, aku ini kenal dengan Roxy.
Dialogue: 0,0:18:13.82,0:18:15.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin kalian kutipu.
Dialogue: 0,0:18:15.87,0:18:17.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan saja padaku.
Dialogue: 0,0:18:19.78,0:18:22.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, ayo kita juga ikut mencari.
Dialogue: 0,0:18:32.55,0:18:34.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hilang sudah harapanku.
Dialogue: 0,0:18:34.64,0:18:39.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka Jalil dan Vizquel\Nsudah pergi dari kota.
Dialogue: 0,0:18:39.01,0:18:43.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf, Guru.\NAndai kami juga bisa bahasa Dewa Iblis.
Dialogue: 0,0:18:43.66,0:18:45.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan dipikirkan.
Dialogue: 0,0:18:45.31,0:18:47.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada di sini rupanya.
Dialogue: 0,0:18:48.57,0:18:51.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dapat info yang bagus.
Dialogue: 0,0:18:52.57,0:18:57.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, soal kaisar iblis itu,
Dialogue: 0,0:18:57.45,0:18:59.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}katanya juga sedang dicari Raja Iblis.
Dialogue: 0,0:18:59.70,0:19:01.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raja Iblis?
Dialogue: 0,0:19:01.66,0:19:06.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sejak sekitar setahun lalu.
Dialogue: 0,0:19:06.54,0:19:10.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang raja iblis itu
Dialogue: 0,0:19:10.25,0:19:12.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}namanya Badigadi?
Dialogue: 0,0:19:12.42,0:19:15.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, bukan Paduka Badi.
Dialogue: 0,0:19:15.05,0:19:17.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kakak perempuannya, Paduka Atofe.
Dialogue: 0,0:19:17.80,0:19:21.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Badi punya kakak perempuan?
Dialogue: 0,0:19:21.68,0:19:25.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, ayo kita tanya pada Paduka Atofe itu.
Dialogue: 0,0:19:25.69,0:19:27.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wo-Woi, sebaiknya jangan melakukan itu.
Dialogue: 0,0:19:27.94,0:19:30.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paduka Atofe sangat berbahaya!
Dialogue: 0,0:19:30.77,0:19:33.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya jangan ditemui!
Dialogue: 0,0:19:33.32,0:19:34.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahaya?
Dialogue: 0,0:19:35.92,0:19:37.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:19:37.17,0:19:39.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perutku sedikit lapar.
Dialogue: 0,0:19:39.65,0:19:42.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kubelikan untuk kalian juga di sana.
Dialogue: 0,0:19:42.26,0:19:43.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau ikut.
Dialogue: 0,0:19:43.70,0:19:45.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati.
Dialogue: 0,0:19:47.96,0:19:50.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Guru, bagaimana hasilnya?
Dialogue: 0,0:19:50.39,0:19:53.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya Raja Iblis sedang bagaimana begitu.
Dialogue: 0,0:19:53.38,0:19:55.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, Cliff dan Elinalise mana?
Dialogue: 0,0:19:55.33,0:19:58.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang membeli makanan di sana.
Dialogue: 0,0:19:58.94,0:20:00.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oalah.
Dialogue: 0,0:20:02.90,0:20:08.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru, Anda tidak perlu merasa\Nbertanggung jawab atas Nona Nanahoshi.
Dialogue: 0,0:20:08.46,0:20:09.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:20:09.99,0:20:15.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi aku juga mengerti perasaannya ingin\Nkembali hidup-hidup ke kampung halaman.
Dialogue: 0,0:20:15.99,0:20:18.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya ikut kubantu seperti ini.
Dialogue: 0,0:20:18.14,0:20:19.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi begitu?
Dialogue: 0,0:20:19.49,0:20:22.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira kamu suka dengan kehidupan sekarang.
Dialogue: 0,0:20:22.78,0:20:24.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu itu benar.
Dialogue: 0,0:20:24.70,0:20:30.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, nyatanya belakangan ini aku merasa kangen\Ndengan pemandangan kampung halaman.
Dialogue: 0,0:20:30.17,0:20:33.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Nanahoshi sudah mati-matian seperti itu.
Dialogue: 0,0:20:33.65,0:20:37.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti dia meninggalkan sesuatu yang berharga\Ndi kampung halamannya.
Dialogue: 0,0:20:38.46,0:20:41.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya orang yang disuka dan keluarganya.
Dialogue: 0,0:20:42.38,0:20:46.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya diriku kurang mengerti\Nsoal dua hal itu.
Dialogue: 0,0:20:46.75,0:20:48.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buatmu sama saja seperti patung.
Dialogue: 0,0:20:49.27,0:20:53.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi begitu, berarti memang sangat berharga.
Dialogue: 0,0:20:54.98,0:20:56.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, bau!
Dialogue: 0,0:20:56.28,0:20:57.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mendekat!
Dialogue: 0,0:20:57.44,0:21:00.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makan, tolong beri aku makan...
Dialogue: 0,0:21:00.99,0:21:02.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bebal sekali kau ini!
Dialogue: 0,0:21:02.66,0:21:04.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergi sana!
Dialogue: 0,0:21:04.33,0:21:05.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baunya!
Dialogue: 0,0:21:10.16,0:21:12.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, makanlah.
Dialogue: 0,0:21:12.33,0:21:14.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih! Terima kasih!
Dialogue: 0,0:21:15.86,0:21:19.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak, enak!\NIni enak!
Dialogue: 0,0:21:19.35,0:21:21.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar, kenapa rasanya dejavu?
Dialogue: 0,0:21:21.72,0:21:25.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak banget!
Dialogue: 0,0:21:32.19,0:21:34.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kisanak, aku berterima kasih padamu.
Dialogue: 0,0:21:34.78,0:21:36.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya.
Dialogue: 0,0:21:36.44,0:21:42.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku adalah Kishirika Kishirisu!
Dialogue: 0,0:21:42.12,0:21:44.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang memanggilku...
Dialogue: 0,0:21:45.45,0:21:49.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaisar Iblis!
Dialogue: 0,0:21:50.58,0:21:51.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Deh!
Dialogue: 0,0:21:53.04,0:21:54.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Deh!
Dialogue: 0,0:21:55.04,0:21:57.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dirimu telah menyelamatkan nyawaku!
Dialogue: 0,0:21:57.89,0:22:01.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang katakanlah apa pun keinginanmu!
Dialogue: 0,0:22:01.92,0:22:03.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo katakan!
