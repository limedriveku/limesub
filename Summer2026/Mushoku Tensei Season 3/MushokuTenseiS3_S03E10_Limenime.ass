Dialogue: 0,0:22:01.84,0:22:05.01,sign,,0000,0000,0000,,EPISODE 10:\NPERTEMUAN DENGAN RAJA IBLIS KEKAL
Dialogue: 0,0:23:35.02,0:23:40.02,sign,,0000,0000,0000,,SELANJUTNYA: TITIK BALIK 4
Dialogue: 0,0:00:05.15,0:00:07.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang katakanlah apa pun keinginanmu!
Dialogue: 0,0:00:08.15,0:00:10.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sebutkan namamu dulu!
Dialogue: 0,0:00:10.14,0:00:12.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Na-Namaku Cliff Grimoire.
Dialogue: 0,0:00:12.53,0:00:13.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cliff, ya?
Dialogue: 0,0:00:13.81,0:00:17.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jasamu telah memberiku makan\Nitu sangat besar.
Dialogue: 0,0:00:17.54,0:00:21.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi aku sudah setengah tahun\Nbelum makan apa-apa.
Dialogue: 0,0:00:21.40,0:00:23.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tidak berjumpa, Paduka Kishirika.
Dialogue: 0,0:00:23.92,0:00:25.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Engkau ini siapa?
Dialogue: 0,0:00:30.09,0:00:31.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Engkau rupanya?!
Dialogue: 0,0:00:31.69,0:00:35.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria dengan daya sihir menjijikkan\Npadahal seorang manusia!
Dialogue: 0,0:00:35.19,0:00:39.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak salah namamu...\NRu... Ru... mba...
Dialogue: 0,0:00:39.98,0:00:41.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumbaus!
Dialogue: 0,0:00:41.73,0:00:44.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana bisa aku menyedot debu!
Dialogue: 0,0:00:44.57,0:00:46.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama saya Rudeus Greyrat.
Dialogue: 0,0:00:46.28,0:00:48.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh iya, itu dia!
Dialogue: 0,0:00:48.53,0:00:51.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetapi, bukan engkau yang kali ini\Nakan dapat hadiah!
Dialogue: 0,0:00:51.36,0:00:53.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Cliff Grimoire!
Dialogue: 0,0:00:53.49,0:00:56.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katakanlah apa pun keinginanmu!
Dialogue: 0,0:00:58.24,0:01:02.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kalau begitu, tolong beri tahu\Ncara menyembuhkan Wabah Drain.
Dialogue: 0,0:01:04.26,0:01:07.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenalanku terkena penyakit itu.
Dialogue: 0,0:01:07.00,0:01:09.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong beri tahu kalau tahu sesuatu.
Dialogue: 0,0:01:09.30,0:01:12.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, Wabah Drain, ya?
Dialogue: 0,0:01:12.30,0:01:17.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengejutkan sekali zaman sekarang\Nada yang terkena penyakit itu.
Dialogue: 0,0:01:18.44,0:01:20.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, apa bisa disembuhkan?
Dialogue: 0,0:01:20.24,0:01:22.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja bisa.
Dialogue: 0,0:01:23.52,0:01:27.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyakit seperti itu tinggal minum\NRumput Sokasu yang dijadikan teh,
Dialogue: 0,0:01:27.70,0:01:29.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nanti bakal keluar bareng tahi!
Dialogue: 0,0:01:29.87,0:01:32.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumput Sokasu?\NAda di mana itu?
Dialogue: 0,0:01:32.74,0:01:36.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulunya ada di gua yang berada\Ndi lembah yang disebut Ekor Naga Merah.
Dialogue: 0,0:01:37.23,0:01:39.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, di akhir perang besar kedua\NManusia dan Iblis,
Dialogue: 0,0:01:39.82,0:01:44.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tercipta lubang besar di benua akibat\Npertarungan Dewa Naga dan Dewa Tempur
Dialogue: 0,0:01:44.73,0:01:46.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan membuatnya lenyap.
Dialogue: 0,0:01:47.75,0:01:51.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, Rumput Sokasu sekarang sudah punah?
Dialogue: 0,0:01:52.36,0:01:54.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itulah!
Dialogue: 0,0:01:54.09,0:01:59.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuperintah untuk membudidayakannya\Ndi rubanah kastel tiap raja iblis!
Dialogue: 0,0:01:59.72,0:02:02.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya teh Sokasu itu enak rasanya!
Dialogue: 0,0:02:05.48,0:02:07.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau kira sudah tidak bisa didapat, ya?!
Dialogue: 0,0:02:07.81,0:02:09.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti kau kira begitu, ya?!
Dialogue: 0,0:02:09.37,0:02:11.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang banget, deh!
Dialogue: 0,0:02:11.11,0:02:14.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu juga dibudidayakan di Kastel Kishirika!
Dialogue: 0,0:02:14.48,0:02:17.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh kutendang sekuat tenaga?
Dialogue: 0,0:02:17.07,0:02:18.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia ini...
Dialogue: 0,0:02:18.45,0:02:20.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahan dulu, Kak Cliff!
Dialogue: 0,0:02:20.37,0:02:22.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat dia memberi tahu semuanya dulu.
Dialogue: 0,0:02:22.67,0:02:24.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:02:24.85,0:02:30.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paduka Kishirika, bisakah kami\Nmeminta sedikit Rumput Sokasu itu?
Dialogue: 0,0:02:30.89,0:02:32.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh saja!
Dialogue: 0,0:02:32.54,0:02:35.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja ada satu masalah.
Dialogue: 0,0:02:35.07,0:02:39.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini Kastel Kishirika sedang\Ndidatangi orang menyebalkan.
Dialogue: 0,0:02:53.89,0:02:55.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon tunggu.
Dialogue: 0,0:02:55.44,0:02:58.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami adalah pasukan pengawal\NRatu Iblis Kekal
Dialogue: 0,0:02:58.27,0:03:01.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paduka Atoferatofe dari wilayah Gaslow.
Dialogue: 0,0:03:01.84,0:03:05.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kalian menyerahkan\NPaduka Kishirika pada kami?
Dialogue: 0,0:03:05.55,0:03:07.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak mau?
Dialogue: 0,0:03:09.10,0:03:11.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sudah dengar ceritanya.
Dialogue: 0,0:03:12.86,0:03:16.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami juga tahu cara budi daya Rumput Sokasu.
Dialogue: 0,0:03:17.64,0:03:21.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila perlu akan kami siapkan pot\Nberisi bibit siap tanam.
Dialogue: 0,0:03:21.13,0:03:22.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi mohon.
Dialogue: 0,0:03:23.81,0:03:26.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ja-Jangan dengarkan omongannya!
Dialogue: 0,0:03:26.73,0:03:30.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atofe adalah yang paling bodoh\Ndari semua Raja Iblis.
Dialogue: 0,0:03:30.09,0:03:32.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bukan orang yang bisa diajak bicara!
Dialogue: 0,0:03:33.86,0:03:36.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sebenarnya terjadi?
Dialogue: 0,0:03:36.03,0:03:42.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paduka Kishirika telah meminum habis\Nalkohol favorit yang disimpan Paduka Atofe.
Dialogue: 0,0:03:43.39,0:03:48.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Amarah Paduka Atofe kemudian meledak\Nsetelah mengetahui hal itu.
Dialogue: 0,0:03:48.55,0:03:51.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya, saya mengerti.
Dialogue: 0,0:03:54.80,0:03:56.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:03:59.80,0:04:10.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♫ Yang bersinar di langit dingin nan jauh
Dialogue: 0,0:04:10.94,0:04:22.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♫ Adalah dunia yang akan lenyap suatu hari
Dialogue: 0,0:04:22.20,0:04:33.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♫ Mengapa diri ini terbakar habis
Dialogue: 0,0:04:33.42,0:04:44.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♫ Dunia manusia pun bagai bintang
Dialogue: 0,0:04:44.60,0:04:54.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♫ Meski kini cahaya yang indah
Dialogue: 0,0:04:54.59,0:04:55.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rudeus!
Dialogue: 0,0:04:56.17,0:04:58.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami mau minta Rumput Sokasu dulu.
Dialogue: 0,0:04:58.59,0:05:00.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, kuserahkan ke kalian.
Dialogue: 0,0:05:01.05,0:05:05.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat menghadap Paduka Atofe,\Nmohon jangan menerima hadiah apa pun.
Dialogue: 0,0:05:05.93,0:05:06.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hadiah?
Dialogue: 0,0:05:07.14,0:05:12.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila bahasannya mengarah ke hadiah,\Nkami sudah tidak bisa ikut campur lagi.
Dialogue: 0,0:05:13.50,0:05:15.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah kalau begitu.
Dialogue: 0,0:05:18.17,0:05:22.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mushoku Tensei:\NJobless Reincarnation Season 3
Dialogue: 0,0:05:34.74,0:05:36.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih belum, ya?
Dialogue: 0,0:05:36.62,0:05:41.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di antara para bangsawan, ada juga\Nyang butuh waktu untuk menyiapkan diri.
Dialogue: 0,0:05:41.00,0:05:43.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, disuruh menunggu dua jam\Nitu sudah kelewat batas, lo.
Dialogue: 0,0:05:43.99,0:05:46.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana Paduka Atofe?
Dialogue: 0,0:05:46.95,0:05:48.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah dipanggil ini.
Dialogue: 0,0:05:48.49,0:05:50.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang sedang keluar dari kota.
Dialogue: 0,0:05:51.04,0:05:52.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian bisa diam, tidak?
Dialogue: 0,0:05:52.54,0:05:54.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka seperti di rumah saja.
Dialogue: 0,0:05:54.81,0:05:57.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat obrolan seperti ini\Nbikin hati jadi tenang.
Dialogue: 0,0:05:57.34,0:05:58.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minggir.
Dialogue: 0,0:05:58.32,0:05:59.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, baik.
Dialogue: 0,0:05:59.67,0:06:00.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus.
Dialogue: 0,0:06:07.85,0:06:09.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akulah sang Ratu Iblis Kekal!
Dialogue: 0,0:06:10.02,0:06:12.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atoferatofe Rybak!
Dialogue: 0,0:06:17.90,0:06:19.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paduka Atofe!
Dialogue: 0,0:06:19.45,0:06:23.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah sudah berulang kali\Nsaya mohon masuk ke ruangan
Dialogue: 0,0:06:24.36,0:06:26.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lewat belakang takhta!
Dialogue: 0,0:06:26.32,0:06:27.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah masuk dari depan,
Dialogue: 0,0:06:27.99,0:06:29.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rasanya lebih enak?
Dialogue: 0,0:06:30.16,0:06:31.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan soal enak atau tidak.
Dialogue: 0,0:06:32.12,0:06:34.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti Ayahanda Anda akan sedih.
Dialogue: 0,0:06:34.96,0:06:37.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu suami Anda, Tuan Rybak juga...
Dialogue: 0,0:06:37.92,0:06:39.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cerewet!
Dialogue: 0,0:06:43.55,0:06:46.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan teriak keras-keras di depan tamu!
Dialogue: 0,0:06:46.51,0:06:47.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:06:48.05,0:06:51.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetapi, mohon jangan gegabah.
Dialogue: 0,0:06:51.98,0:06:54.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus kalau kau paham.
Dialogue: 0,0:06:54.85,0:06:56.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, ayo ulangi lagi dari awal.
Dialogue: 0,0:06:57.13,0:06:58.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laksanakan.
Dialogue: 0,0:06:59.55,0:07:01.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akulah sang Ratu Iblis Kekal!
Dialogue: 0,0:07:01.36,0:07:03.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atoferatofe Rybak!
Dialogue: 0,0:07:10.33,0:07:11.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, kuucapkan terima kasih.
Dialogue: 0,0:07:12.04,0:07:13.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat kalian,
Dialogue: 0,0:07:13.45,0:07:15.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}si bodoh berhasil ditangkap.
Dialogue: 0,0:07:16.25,0:07:19.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kecil dia memang\Ntidak punya gambar potret dirinya,
Dialogue: 0,0:07:19.54,0:07:22.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi memakan waktu untuk mencarinya.
Dialogue: 0,0:07:23.38,0:07:26.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus bisa menemukan dia.
Dialogue: 0,0:07:27.01,0:07:27.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu...
Dialogue: 0,0:07:31.58,0:07:33.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa baterainya habis?
Dialogue: 0,0:07:34.14,0:07:36.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Moore, apa tadi?
Dialogue: 0,0:07:36.62,0:07:37.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal hadiah.
Dialogue: 0,0:07:38.06,0:07:38.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:07:39.11,0:07:40.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang harus diberi hadiah.
Dialogue: 0,0:07:40.94,0:07:43.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, tapi saya tidak perlu hadiah.
Dialogue: 0,0:07:45.69,0:07:48.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu kau tidak butuh
Dialogue: 0,0:07:48.24,0:07:49.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hadiah dariku, ya?
Dialogue: 0,0:07:53.33,0:07:54.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:07:54.79,0:07:57.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang apa yang akan diberikan?
Dialogue: 0,0:07:58.92,0:08:00.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuberi hak masuk jadi pasukan pengawalku.
Dialogue: 0,0:08:01.17,0:08:04.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan kulatih tanpa istirahat\Nseumur hidupmu.
Dialogue: 0,0:08:04.46,0:08:05.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebuah kehormatan, kan?
Dialogue: 0,0:08:05.88,0:08:08.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, anu...
Dialogue: 0,0:08:11.55,0:08:12.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf.
Dialogue: 0,0:08:13.26,0:08:15.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya izin menolak kehormatan itu.
Dialogue: 0,0:08:15.47,0:08:17.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah sungkan!
Dialogue: 0,0:08:18.31,0:08:21.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena saya sudah berkeluarga.
Dialogue: 0,0:08:22.27,0:08:24.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah dipikirkan.
Dialogue: 0,0:08:24.68,0:08:27.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sudah 100 tahun\Ntidak bertemu putraku.
Dialogue: 0,0:08:28.07,0:08:30.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teman saya yang sedang sakit\Njuga sedang menunggu.
Dialogue: 0,0:08:30.88,0:08:33.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, saya harus segera mencari\Ncara mengobatinya
Dialogue: 0,0:08:33.33,0:08:34.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan segera pulang.
Dialogue: 0,0:08:36.25,0:08:37.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin lain kali...
Dialogue: 0,0:08:37.62,0:08:40.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cerewet!
Dialogue: 0,0:08:41.75,0:08:44.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau jadi pasukanku atau tidak?!
Dialogue: 0,0:08:44.42,0:08:45.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pilih yang mana?!
Dialogue: 0,0:08:46.00,0:08:47.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak.
Dialogue: 0,0:08:47.55,0:08:48.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?!
Dialogue: 0,0:08:49.11,0:08:50.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa menolak?!
Dialogue: 0,0:08:51.00,0:08:52.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anu...
Dialogue: 0,0:08:52.85,0:08:56.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh iya, dia tidak paham bahasanya.
Dialogue: 0,0:08:56.18,0:08:57.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa berharap ke Zanoba.
Dialogue: 0,0:08:57.98,0:09:00.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia ini bodoh.
Dialogue: 0,0:09:00.70,0:09:03.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana bisa diajak bicara dengan benar.
Dialogue: 0,0:09:03.69,0:09:04.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik!
Dialogue: 0,0:09:04.87,0:09:07.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bodoh!
Dialogue: 0,0:09:07.57,0:09:09.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sudah, jadilah pasukan pengawalku!\N- Ga-Gawat!
Dialogue: 0,0:09:09.15,0:09:10.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Semuanya, tahan beliau!\N- Senang, kan?
Dialogue: 0,0:09:10.70,0:09:11.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Paduka Atofe!\N- Tersanjung, kan?
Dialogue: 0,0:09:11.86,0:09:13.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini di dalam istana!
Dialogue: 0,0:09:13.57,0:09:15.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minggir, minggir!
Dialogue: 0,0:09:15.60,0:09:16.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minggir!
Dialogue: 0,0:09:17.16,0:09:18.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kalian mengganggu!\N- Guru, serahkan ini padaku!
Dialogue: 0,0:09:18.75,0:09:19.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minggir!
Dialogue: 0,0:09:23.88,0:09:25.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatanmu hebat juga.
Dialogue: 0,0:09:25.92,0:09:27.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon tenang dulu!
Dialogue: 0,0:09:27.62,0:09:30.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tidak berniat merendahkan apa pun!
Dialogue: 0,0:09:30.44,0:09:31.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya butuh Rumput...
Dialogue: 0,0:09:31.38,0:09:34.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bicara yang tidak kumengerti!
Dialogue: 0,0:09:36.60,0:09:37.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kisanak.
Dialogue: 0,0:09:38.14,0:09:39.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerasnya tubuhmu ini.
Dialogue: 0,0:09:39.47,0:09:42.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau dibalut Aura Tempur\Nyang lumayan kuat, ya.
Dialogue: 0,0:09:42.21,0:09:43.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menarik!
Dialogue: 0,0:09:47.19,0:09:48.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:09:48.48,0:09:52.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akulah Ratu Iblis Kekal, Atoferatofe Rybak!
Dialogue: 0,0:09:52.47,0:09:55.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istri pendiri aliran Dewa Utara!
Dialogue: 0,0:09:55.70,0:09:58.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalman Rybak!
Dialogue: 0,0:09:59.79,0:10:05.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kutunjukkan aliran Dewa Utara\Nyang sesungguhnya padamu!
Dialogue: 0,0:10:09.59,0:10:10.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matilah!
Dialogue: 0,0:10:10.76,0:10:14.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknik rahasia aliran Dewa Utara...!
Dialogue: 0,0:10:20.89,0:10:22.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Paduka Atofe!\N- Ga-Gawat.
Dialogue: 0,0:10:22.39,0:10:23.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia jatuh ke luar!
Dialogue: 0,0:10:23.15,0:10:26.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terlalu fokus ingin melindungi Guru,\Nsampai tanganku jadi tidak tertahan.
Dialogue: 0,0:10:27.18,0:10:28.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa sudah mati, ya?\N- Kelihatan, tidak?
Dialogue: 0,0:10:28.98,0:10:31.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tidak, terlalu jauh.\N- Ah, kurasa tidak akan mati.
Dialogue: 0,0:10:36.62,0:10:41.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti kalian tidak ada niatan\Nuntuk jadi teman kami?
Dialogue: 0,0:10:41.22,0:10:42.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak ada.
Dialogue: 0,0:10:44.32,0:10:46.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, segeralah lari.
Dialogue: 0,0:10:46.94,0:10:49.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada terowongan rahasia di bawah kastel.
Dialogue: 0,0:10:49.51,0:10:50.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apakah boleh?
Dialogue: 0,0:10:51.18,0:10:53.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama lima ribu tahun ini,
Dialogue: 0,0:10:53.37,0:10:56.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak ada yang mampu mengalahkan\Npaduka kami selain
Dialogue: 0,0:10:56.51,0:11:00.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dewa Utara Kalman dan Dewa Iblis Laplace.
Dialogue: 0,0:11:00.66,0:11:03.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ja-Jadi, beliau sekuat itu.
Dialogue: 0,0:11:03.35,0:11:07.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sampai dibuat kalah,\Npasti akan dipaksa membuat kontrak.
Dialogue: 0,0:11:07.35,0:11:10.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagian besar dari kami memang\Ndengan senang hati di sini,
Dialogue: 0,0:11:10.37,0:11:12.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi banyak juga yang tidak seperti itu.
Dialogue: 0,0:11:12.82,0:11:15.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bernasib sama sepertiku.
Dialogue: 0,0:11:15.00,0:11:16.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pengin ketemu keluargaku...
Dialogue: 0,0:11:18.08,0:11:21.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, izinkan kami\Nmenerima usulan tersebut.
Dialogue: 0,0:11:21.01,0:11:22.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiks.
Dialogue: 0,0:11:26.46,0:11:28.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bolehkah jika Paduka Kishirika\Nkami bawa juga?
Dialogue: 0,0:11:31.76,0:11:36.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, misi kami hanya sampai\Nmenangkap Paduka Kishirika.
Dialogue: 0,0:11:38.84,0:11:41.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya.\NAku berutang ke kalian!
Dialogue: 0,0:11:42.66,0:11:44.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Cliff, Elinalise!
Dialogue: 0,0:11:44.91,0:11:45.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rudeus?
Dialogue: 0,0:11:45.90,0:11:47.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa? Kenapa panik begitu?
Dialogue: 0,0:11:47.85,0:11:49.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kujelaskan sambil jalan.
Dialogue: 0,0:11:49.89,0:11:51.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumput Sokasu bagaimana?
Dialogue: 0,0:11:51.52,0:11:52.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak masalah.
Dialogue: 0,0:11:52.81,0:11:54.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami juga diajari cara budi dayanya.
Dialogue: 0,0:11:56.26,0:11:59.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, ayo kabur lewat\Nterowongan rahasia bawah tanah.
Dialogue: 0,0:11:59.14,0:12:01.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, jangan lewat bawah tanah.
Dialogue: 0,0:12:01.44,0:12:05.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lorong bawah tanah dulu dihancurkan Badi\Ndan harusnya masih seperti itu.
Dialogue: 0,0:12:05.37,0:12:06.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah itu?!
Dialogue: 0,0:12:06.79,0:12:10.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria bernama Moore adalah orang yang licik.
Dialogue: 0,0:12:10.11,0:12:14.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tadi bilang seperti itu,\Npasti sedang merencanakan sesuatu.
Dialogue: 0,0:12:14.93,0:12:17.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin dia berbohong\Ndi kondisi seperti ini, ya.
Dialogue: 0,0:12:17.61,0:12:20.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, kita keluar\Ndari lantai satu kastel...
Dialogue: 0,0:12:20.55,0:12:22.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Moore!
Dialogue: 0,0:12:23.56,0:12:26.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kejar mereka!
Dialogue: 0,0:12:26.32,0:12:27.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seram, ih!
Dialogue: 0,0:12:31.77,0:12:33.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita mau ke mana?
Dialogue: 0,0:12:33.75,0:12:37.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini ada lingkaran sihir teleportasi\Nyang kami gunakan.
Dialogue: 0,0:12:37.11,0:12:40.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, benda seperti itu masih ada\Nyang tersisa rupanya.
Dialogue: 0,0:12:40.90,0:12:42.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, tapi...
Dialogue: 0,0:12:43.18,0:12:45.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tiba-tiba berhenti?!
Dialogue: 0,0:12:46.70,0:12:49.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama sekali.
Dialogue: 0,0:12:49.54,0:12:51.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ce-Cepat sekali...
Dialogue: 0,0:12:51.58,0:12:53.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda tiba di sini...
Dialogue: 0,0:12:58.30,0:13:00.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terbang memang cepat sampai.
Dialogue: 0,0:13:01.34,0:13:04.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga bisa melihat kalian\Nsaat sedang berlari.
Dialogue: 0,0:13:05.47,0:13:07.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus, Moore.
Dialogue: 0,0:13:07.56,0:13:10.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tepat seperti ucapanmu.
Dialogue: 0,0:13:10.54,0:13:12.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika menurut Anda begitu,
Dialogue: 0,0:13:12.48,0:13:13.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tolong ikuti arahan saya.
Dialogue: 0,0:13:13.98,0:13:15.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menolak!
Dialogue: 0,0:13:22.99,0:13:24.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akulah sang Ratu Iblis Kekal!
Dialogue: 0,0:13:24.74,0:13:26.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atoferatofe Rybak!
Dialogue: 0,0:13:27.20,0:13:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuberi gelar pahlawan\Njika bisa menang melawanku!
Dialogue: 0,0:13:30.12,0:13:32.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kalah, akan kujadikan bonekaku\Nsampai napas kalian habis!
Dialogue: 0,0:13:33.38,0:13:36.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Moore, kalian jangan berani turun tangan.
Dialogue: 0,0:13:37.84,0:13:40.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini aku tidak akan lengah.
Dialogue: 0,0:13:41.26,0:13:43.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini cepat belajar.
Dialogue: 0,0:13:43.68,0:13:45.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, serang lagi.
Dialogue: 0,0:13:48.32,0:13:51.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Sylphy, aku mungkin\Ntidak akan bisa pulang.
Dialogue: 0,0:13:51.90,0:13:53.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rudeus.
Dialogue: 0,0:13:53.27,0:13:56.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau cuma Cliff, ayo usahakan dia\Nbisa lari ke lingkaran sihir teleportasi.
Dialogue: 0,0:13:56.94,0:14:01.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal bisa membawa pulang rumputnya,\NNanahoshi pasti bisa diselamatkan.
Dialogue: 0,0:14:01.07,0:14:04.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, juga bisa menyuruh Cliff\Nuntuk minta bantuan.
Dialogue: 0,0:14:04.86,0:14:05.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:14:06.24,0:14:08.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa tolong bujuk Cliff?
Dialogue: 0,0:14:08.19,0:14:09.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kucoba.
Dialogue: 0,0:14:10.09,0:14:13.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Cliff bisa kembali,\NNanahoshi akan tertolong.
Dialogue: 0,0:14:13.02,0:14:16.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menolongnya, itulah tujuanku.
Dialogue: 0,0:14:16.06,0:14:18.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku juga ingin pulang.
Dialogue: 0,0:14:18.25,0:14:20.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu merasa cemas.
Dialogue: 0,0:14:20.69,0:14:24.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ratu Iblis akan kutahan\Nmeski nyawa taruhannya.
Dialogue: 0,0:14:28.14,0:14:29.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:14:29.63,0:14:31.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rudeus.
Dialogue: 0,0:14:34.82,0:14:37.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, tolong Rudeus yang mulai menyerang.
Dialogue: 0,0:14:37.68,0:14:40.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan Zanoba akan menahan Atofe.
Dialogue: 0,0:14:40.83,0:14:44.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu kamu berusahalah hentikan\Ngerombolan yang di belakang.
Dialogue: 0,0:14:44.73,0:14:46.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:14:46.24,0:14:49.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah dapat rencana untuk menang dariku?
Dialogue: 0,0:14:55.71,0:14:58.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak berguna, apa harus pakai Electric?
Dialogue: 0,0:14:58.48,0:14:59.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru.
Dialogue: 0,0:14:59.79,0:15:02.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percayalah padaku.
Dialogue: 0,0:15:05.18,0:15:06.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kumulai!
Dialogue: 0,0:15:13.27,0:15:14.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terbaca!
Dialogue: 0,0:15:15.14,0:15:19.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, tunggu...!\NKubilang tunggu!
Dialogue: 0,0:15:19.56,0:15:20.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terbaca...
Dialogue: 0,0:15:21.90,0:15:23.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bau!
Dialogue: 0,0:15:23.49,0:15:26.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sudah kau lempar itu?!
Dialogue: 0,0:15:33.87,0:15:34.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lembek.
Dialogue: 0,0:15:41.17,0:15:41.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih belum!
Dialogue: 0,0:15:51.51,0:15:52.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sini!
Dialogue: 0,0:15:55.89,0:15:57.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berengsek, beraninya kau memelukku!
Dialogue: 0,0:15:57.81,0:15:59.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh tidak tahu malu!
Dialogue: 0,0:16:04.16,0:16:05.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru!
Dialogue: 0,0:16:05.53,0:16:06.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Cliff!
Dialogue: 0,0:16:07.28,0:16:08.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian!
Dialogue: 0,0:16:08.82,0:16:11.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan biarkan satu pun kabur!
Dialogue: 0,0:16:11.62,0:16:13.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, kejar mereka!
Dialogue: 0,0:16:13.24,0:16:13.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik!
Dialogue: 0,0:16:14.32,0:16:15.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah terlambat!
Dialogue: 0,0:16:16.41,0:16:17.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?!
Dialogue: 0,0:16:21.92,0:16:26.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai roh api yang tersebar luas\Ndi langit dan bumi.
Dialogue: 0,0:16:26.42,0:16:29.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan darahku ini,\Nbiarlah ledakan api membakar tubuhku.
Dialogue: 0,0:16:30.34,0:16:32.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Burning Place!
Dialogue: 0,0:16:36.06,0:16:38.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian semua rapalkan Burning Place!
Dialogue: 0,0:16:38.81,0:16:39.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:16:41.68,0:16:43.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Moore!
Dialogue: 0,0:16:43.38,0:16:45.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan biarkan lolos!
Dialogue: 0,0:16:45.32,0:16:45.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:16:46.07,0:16:47.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan kubiarkan!
Dialogue: 0,0:16:47.74,0:16:49.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rudeus, tahan mereka!
Dialogue: 0,0:16:49.85,0:16:51.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik!
Dialogue: 0,0:16:54.87,0:16:57.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai dewa yang tidak pasti!
Dialogue: 0,0:16:58.00,0:17:01.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawab seruan hamba,\Nuntuk menembus langit dari bumi!
Dialogue: 0,0:17:01.61,0:17:04.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Earth Lance!
Dialogue: 0,0:17:10.47,0:17:12.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai para roh yang tersebar luas\Ndi tanah yang mati!
Dialogue: 0,0:17:13.80,0:17:16.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawablah seruanku!
Dialogue: 0,0:17:17.35,0:17:19.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Disturb Magic!
Dialogue: 0,0:17:19.14,0:17:19.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil?!
Dialogue: 0,0:17:20.14,0:17:21.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Disturb Magic," katamu?!
Dialogue: 0,0:17:22.15,0:17:24.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai roh air, berilah aku kekuatan!
Dialogue: 0,0:17:25.94,0:17:27.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Deep Mist!
Dialogue: 0,0:17:32.20,0:17:32.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lepaskan!
Dialogue: 0,0:17:33.20,0:17:33.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo baku hantam!
Dialogue: 0,0:17:34.03,0:17:35.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mau berhenti!
Dialogue: 0,0:17:35.35,0:17:37.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa penyihir berpengalaman bisa sejauh ini?!
Dialogue: 0,0:17:37.91,0:17:39.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rudeus, tolong Cliff!
Dialogue: 0,0:17:39.97,0:17:41.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Moore!
Dialogue: 0,0:17:41.92,0:17:43.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, Paduka Atofe!
Dialogue: 0,0:18:12.55,0:18:14.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi?!\NCliff bagaimana?!
Dialogue: 0,0:18:17.55,0:18:18.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Moore?
Dialogue: 0,0:18:19.03,0:18:21.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia masih bisa memakai sihir, ya.
Dialogue: 0,0:18:21.12,0:18:22.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus cepat kuberi Disturb Magic!
Dialogue: 0,0:18:22.91,0:18:24.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wind Bind!
Dialogue: 0,0:18:25.58,0:18:28.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai tangan, sedotlah habis!
Dialogue: 0,0:18:29.67,0:18:30.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?!
Dialogue: 0,0:18:31.05,0:18:32.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan itu.
Dialogue: 0,0:18:32.76,0:18:35.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berengsek, berani juga kau.
Dialogue: 0,0:18:36.64,0:18:39.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah memakai sihir yang aneh.
Dialogue: 0,0:18:39.56,0:18:40.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:18:40.89,0:18:44.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak sabar menjadikanmu\Nsebagai bawahanku!
Dialogue: 0,0:18:45.02,0:18:48.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Cliff, kuserahkan padamu.
Dialogue: 0,0:18:48.76,0:18:52.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong bujuklah Perugius sebaik mungkin.
Dialogue: 0,0:18:53.24,0:18:54.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cliff!
Dialogue: 0,0:18:56.56,0:18:59.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar saja, di dalam juga ada?!
Dialogue: 0,0:19:01.58,0:19:03.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pa-Paduka Atofe...
Dialogue: 0,0:19:03.83,0:19:06.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuan lingkaran sihirnya adalah...
Dialogue: 0,0:19:06.75,0:19:07.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peru...
Dialogue: 0,0:19:13.37,0:19:16.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perugius!
Dialogue: 0,0:19:16.63,0:19:19.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka ada dirimu.
Dialogue: 0,0:19:19.49,0:19:24.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kastelku sudah ternoda oleh\Ndarah prajuritmu yang kotor itu.
Dialogue: 0,0:19:24.10,0:19:25.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:19:25.65,0:19:29.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atofe memberi perintah untuk memeriksa\Ntujuan lingkaran sihir teleportasi.
Dialogue: 0,0:19:29.98,0:19:31.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ganggu saja!
Dialogue: 0,0:19:37.49,0:19:40.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?\NApa kau lengah lagi?
Dialogue: 0,0:19:40.52,0:19:43.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lengah memanglah keahlian\Npara raja iblis kekal seperti kalian.
Dialogue: 0,0:19:44.04,0:19:47.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, jadi mereka itu untuk membunuhku...
Dialogue: 0,0:19:48.38,0:19:51.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana perjanjianmu dengan Kal?!
Dialogue: 0,0:19:52.05,0:19:56.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Janji dengan Kal akan kujaga,\Nkarena dia adalah sahabatku.
Dialogue: 0,0:19:58.61,0:20:01.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naga hanya hidup demi kesetiaan semata.
Dialogue: 0,0:20:02.10,0:20:04.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedua cakarnya begitu panjang dan tajam,\Ntakkan pernah bisa mengepalkan tinju.
Dialogue: 0,0:20:04.85,0:20:06.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kau, jangan bilang...
Dialogue: 0,0:20:07.02,0:20:10.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat naga itu murka, tinjunya akan mengepal.
Dialogue: 0,0:20:10.74,0:20:14.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cakarnya akan patah, taringnya akan lepas,\Ntapi ia akan menyadari.
Dialogue: 0,0:20:14.61,0:20:18.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naga yang menggenggam kesetiaan,\Natas pikiran apa ia membuang kesetiaan itu.
Dialogue: 0,0:20:18.20,0:20:19.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paduka Atofe!
Dialogue: 0,0:20:20.02,0:20:22.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naga ketiga yang mati.
Dialogue: 0,0:20:22.30,0:20:26.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jenderal naga bersisik perak\Ndengan mata paling tajam.
Dialogue: 0,0:20:27.09,0:20:30.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupanggil atas nama Raja Naga Zirah Perugius.
Dialogue: 0,0:20:31.67,0:20:33.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terbukalah, Gerbang Naga Depan!
Dialogue: 0,0:20:33.63,0:20:35.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ajaklah, Gerbang Naga Belakang!
Dialogue: 0,0:20:38.28,0:20:40.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perugi...
Dialogue: 0,0:20:40.72,0:20:43.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau melanggar perjanjiannya, ya!
Dialogue: 0,0:20:43.97,0:20:45.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan kulanggar.
Dialogue: 0,0:20:45.68,0:20:51.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja ini kesempatan seumur hidup\Nyang sangat langka!
Dialogue: 0,0:20:52.88,0:20:54.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Telapak Naga Zirah!
Dialogue: 0,0:20:54.86,0:20:56.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tebasan Tunggal!
Dialogue: 0,0:20:58.44,0:21:00.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awas, ingat ini!
Dialogue: 0,0:21:02.51,0:21:05.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perugius!
Dialogue: 0,0:21:08.79,0:21:11.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paduka Atofe!
Dialogue: 0,0:21:12.53,0:21:15.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toh dia tidak akan mati.
Dialogue: 0,0:21:15.00,0:21:19.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sylvaril, bawa dan obati mereka berempat.
Dialogue: 0,0:21:19.66,0:21:22.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, saya juga melihat\NKaisar Agung Dunia Iblis Kishirika.
Dialogue: 0,0:21:24.40,0:21:25.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan saja.
Dialogue: 0,0:21:25.69,0:21:26.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:21:28.03,0:21:29.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami selamat.
Dialogue: 0,0:21:33.76,0:21:37.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat mereka berdua,\NRatu Iblis Kekal bisa dihentikan.
Dialogue: 0,0:21:38.23,0:21:40.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Persahabatan memang tak ternilai harganya,
Dialogue: 0,0:21:40.67,0:21:43.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi setelah pulang biar kuberi\Nucapan terima kasih yang layak.
Dialogue: 0,0:21:43.38,0:21:46.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah beres, sekarang selamat tinggal!
Dialogue: 0,0:21:50.22,0:21:52.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cliff juga sudah berlari dengan hebat.
Dialogue: 0,0:21:53.13,0:21:55.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumput Sokasu juga sudah didapat.
Dialogue: 0,0:21:57.29,0:22:00.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini Nanahoshi harusnya bisa sembuh.
