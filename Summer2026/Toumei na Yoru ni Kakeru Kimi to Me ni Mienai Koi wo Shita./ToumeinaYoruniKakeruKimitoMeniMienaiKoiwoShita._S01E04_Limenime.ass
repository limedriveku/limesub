Dialogue: 0,0:02:20.16,0:02:30.80,sign,,0000,0000,0000,,LOVE UNSEEN BENEATH THE CLEAR NIGHT SKY
Dialogue: 0,0:07:31.10,0:07:32.85,sign,,0000,0000,0000,,SABTU, 25 JULI
Dialogue: 0,0:07:32.85,0:07:35.35,sign,,0000,0000,0000,,MINGGU, 26 JULI
Dialogue: 0,0:11:06.77,0:11:10.02,sign,,0000,0000,0000,,KOPI
Dialogue: 0,0:11:10.02,0:11:13.03,sign,,0000,0000,0000,,TEH HITAM
Dialogue: 0,0:11:21.74,0:11:23.75,sign,,0000,0000,0000,,TEH HITAM, TEH MURNI, TEH LEMON
Dialogue: 0,0:14:47.07,0:14:47.57,sign,,0000,0000,0000,,MENEMBAK SAMPAI 5 METER
Dialogue: 0,0:15:05.97,0:15:08.46,sign,,0000,0000,0000,,KEMBANG API ROKET
Dialogue: 0,0:19:05.08,0:19:06.74,sign,,0000,0000,0000,,PINTU KELUAR, LIFT PLATFORM KURSI RODA
Dialogue: 0,0:19:06.74,0:19:08.40,sign,,0000,0000,0000,,KAPASITAS BEBAN MAKSIMUM: 240 KG
Dialogue: 0,0:19:08.40,0:19:09.96,sign,,0000,0000,0000,,DILARANG DIGUNAKAN SAAT BERLAYAR
Dialogue: 0,0:19:31.07,0:19:35.57,sign,,0000,0000,0000,,DILARANG BERDIRI DI SINI
Dialogue: 0,0:23:56.89,0:24:02.67,sign,,0000,0000,0000,,KENCAN PERTAMA
Dialogue: 0,0:00:06.80,0:00:08.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, nih?
Dialogue: 0,0:00:08.85,0:00:10.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:00:10.83,0:00:13.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, soalnya kamu juga cowok.
Dialogue: 0,0:00:13.99,0:00:15.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu meledekku?
Dialogue: 0,0:00:15.68,0:00:20.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah mandi sebelum ketemu cewek,\Ntapi masih kelihatan polos begitu.
Dialogue: 0,0:00:20.06,0:00:21.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bikin iri saja.
Dialogue: 0,0:00:21.98,0:00:23.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata memang meledekku!
Dialogue: 0,0:00:23.73,0:00:25.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, kok.
Dialogue: 0,0:00:26.13,0:00:27.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang bikin suka?
Dialogue: 0,0:00:27.38,0:00:29.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan berarti aku menyukainya.
Dialogue: 0,0:00:29.07,0:00:31.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, kamu manis banget.
Dialogue: 0,0:00:31.02,0:00:33.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata benaran lagi meledekku!
Dialogue: 0,0:00:33.10,0:00:35.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, kok.
Dialogue: 0,0:00:37.06,0:00:40.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuyutsuki bilang hanya ingin ditemani.
Dialogue: 0,0:00:40.21,0:00:41.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau ikut juga?
Dialogue: 0,0:00:41.98,0:00:44.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dih, dasar ayam penakut.
Dialogue: 0,0:00:44.23,0:00:45.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawel.
Dialogue: 0,0:00:45.52,0:00:47.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada ayam penakut di sini.
Dialogue: 0,0:00:47.47,0:00:50.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawel, ah!
Dialogue: 0,0:00:50.16,0:00:52.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini aku ada kerja sambilan.
Dialogue: 0,0:00:52.39,0:00:54.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya sif malam?
Dialogue: 0,0:00:54.05,0:00:57.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya kamu ingin pacaran\Nsama Fuyutsuki?
Dialogue: 0,0:00:57.22,0:00:58.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:00:58.10,0:01:00.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya begitu.
Dialogue: 0,0:01:01.39,0:01:05.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya nyaman mengobrol dengannya,\Ntidak ada pikiran ke arah situ.
Dialogue: 0,0:01:05.50,0:01:07.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa, sih?
Dialogue: 0,0:01:07.41,0:01:12.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan aku masih bingung\Nmenanggapi soal matanya.
Dialogue: 0,0:01:12.01,0:01:16.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak yakin bisa menanggapinya\Nseperti yang kamu lakukan.
Dialogue: 0,0:01:16.21,0:01:18.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya menanggapi?
Dialogue: 0,0:01:18.73,0:01:22.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, kata-kataku kurang tepat.
Dialogue: 0,0:01:22.02,0:01:26.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku bisa memperlakukannya\Nsama seperti orang lain?
Dialogue: 0,0:01:26.61,0:01:29.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlakukan seperti biasa saja.
Dialogue: 0,0:01:29.17,0:01:32.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru aku bingung di bagian situ.
Dialogue: 0,0:01:33.06,0:01:36.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah sebaiknya\Ntidak menyinggung soal matanya,
Dialogue: 0,0:01:36.54,0:01:41.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau perlu memilihkan jalan\Nyang mudah untuknya.
Dialogue: 0,0:01:41.12,0:01:43.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih baik mengulurkan tangan\Nuntuk menuntunnya,
Dialogue: 0,0:01:43.94,0:01:47.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau sebaiknya bertanya dulu\Nuntuk semua hal?
Dialogue: 0,0:01:47.78,0:01:49.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggal tanya saja.
Dialogue: 0,0:01:50.42,0:01:52.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takut suasananya jadi canggung.
Dialogue: 0,0:01:54.74,0:01:57.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga pernah mengalami itu,
Dialogue: 0,0:01:57.84,0:02:00.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi dikasihani seperti itu\Nlebih menyakitkan.
Dialogue: 0,0:03:36.06,0:03:38.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah dikatai ayam penakut,
Dialogue: 0,0:03:38.49,0:03:40.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi pengin makan ayam benaran.
Dialogue: 0,0:04:08.50,0:04:09.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuyutsuki.
Dialogue: 0,0:04:11.55,0:04:14.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Sorano, maaf menunggu.
Dialogue: 0,0:04:14.40,0:04:15.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menunggu lama?
Dialogue: 0,0:04:15.99,0:04:18.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menunggu dua jam.
Dialogue: 0,0:04:18.42,0:04:20.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu salahmu sendiri.
Dialogue: 0,0:04:20.64,0:04:22.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, tapi gara-gara kamu.
Dialogue: 0,0:04:22.98,0:04:24.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lah?
Dialogue: 0,0:04:24.78,0:04:26.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bercanda.
Dialogue: 0,0:04:26.83,0:04:28.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo berangkat.
Dialogue: 0,0:04:28.46,0:04:31.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Stasiun Tsukishima lewat sini.
Dialogue: 0,0:04:31.63,0:04:33.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lewat mana?
Dialogue: 0,0:04:33.09,0:04:36.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, maksudnya jalan ke arah kiri.
Dialogue: 0,0:04:36.71,0:04:38.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:04:40.26,0:04:43.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya orang akan langsung paham\Ndengan menunjuk.
Dialogue: 0,0:04:43.22,0:04:45.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tidak dengan Fuyutsuki.
Dialogue: 0,0:04:46.40,0:04:48.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski aku menatapnya dari samping,
Dialogue: 0,0:04:48.73,0:04:50.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia tidak akan menyadarinya.
Dialogue: 0,0:04:52.56,0:04:55.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya kamu ingin pacaran\Nsama Fuyutsuki?
Dialogue: 0,0:04:56.19,0:05:01.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intuisiku bilang pacaran sama\Ntunanetra itu merepotkan.
Dialogue: 0,0:05:01.66,0:05:07.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku tidak menganggapnya\Nsebagai calon pasangan.
Dialogue: 0,0:05:08.21,0:05:11.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham pikiran ini\Nsangat tidak sopan.
Dialogue: 0,0:05:11.87,0:05:17.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, perasaan suka dariku\Nmemangnya ada nilainya, ya?
Dialogue: 0,0:05:17.42,0:05:19.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah tahu tempatnya?
Dialogue: 0,0:05:19.22,0:05:21.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sudah.
Dialogue: 0,0:05:21.57,0:05:23.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi tidak sabar.
Dialogue: 0,0:05:27.07,0:05:27.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:05:27.92,0:05:29.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:05:29.17,0:05:31.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa jalan melompat-lompat?
Dialogue: 0,0:05:31.98,0:05:36.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga bisa melakukannya\Nsambil menutup mata, kan?
Dialogue: 0,0:05:39.60,0:05:41.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tertawa?
Dialogue: 0,0:05:41.17,0:05:43.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, maaf.
Dialogue: 0,0:05:43.74,0:05:46.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya aku enggak bisa, deh.
Dialogue: 0,0:05:49.82,0:05:52.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir naik kereta bawah tanah
Dialogue: 0,0:05:52.58,0:05:54.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan lebih gampang transit...
Dialogue: 0,0:05:55.94,0:06:00.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski bawa tongkat putih,\Nbukan berarti dapat kursi.
Dialogue: 0,0:06:00.59,0:06:02.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia ini keras juga, ya.
Dialogue: 0,0:06:03.55,0:06:04.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuyutsuki.
Dialogue: 0,0:06:05.42,0:06:07.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sebelah kananmu tidak ada orang.
Dialogue: 0,0:06:07.36,0:06:09.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:06:17.25,0:06:18.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:06:18.69,0:06:22.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kamu jentelmen, ya.
Dialogue: 0,0:06:22.59,0:06:24.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm? Apanya?
Dialogue: 0,0:06:25.28,0:06:28.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sengaja memilihkan\Nrute yang lebih sepi, kan?
Dialogue: 0,0:06:28.81,0:06:30.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukan begitu.
Dialogue: 0,0:06:34.72,0:06:37.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajahku jadi panas begini.
Dialogue: 0,0:06:44.09,0:06:46.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya ini membuatku kepikiran terus,
Dialogue: 0,0:06:46.36,0:06:48.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa alasanmu\Ningin meluncurkan kembang api?
Dialogue: 0,0:06:48.51,0:06:50.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena sudah suka dari dulu.
Dialogue: 0,0:06:50.82,0:06:54.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sekarang kamu tidak bisa melihat,\Njadi penasaran soal itu.
Dialogue: 0,0:06:54.51,0:06:58.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembang api itu bukan hanya\Ndinikmati oleh mata, lo.
Dialogue: 0,0:06:58.67,0:07:01.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada benarnya, sih.
Dialogue: 0,0:07:01.23,0:07:05.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada suara ledakannya,\Naroma mesiu,
Dialogue: 0,0:07:05.74,0:07:08.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan teriakan semua orang.
Dialogue: 0,0:07:08.30,0:07:12.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti kamu coba nikmati kembang api\Nsambil tutup mata, deh.
Dialogue: 0,0:07:12.85,0:07:15.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pasti bisa merasakannya\Ndengan seluruh tubuhmu.
Dialogue: 0,0:07:15.75,0:07:20.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menikmati kembang api kawat sambil\Njongkok pun sudah cukup bagiku.
Dialogue: 0,0:07:20.26,0:07:24.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu juga bagus, kok.\NNanti kita beli, ya?
Dialogue: 0,0:07:24.43,0:07:26.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benaran suka kembang api, ya.
Dialogue: 0,0:07:27.73,0:07:31.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu aku suka melihatnya\Nbersama keluarga.
Dialogue: 0,0:07:31.10,0:07:32.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembang api luncur?
Dialogue: 0,0:07:32.85,0:07:35.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat aku masih bisa melihat.
Dialogue: 0,0:07:35.35,0:07:37.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersama ibu dan ayahku.
Dialogue: 0,0:07:37.60,0:07:41.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ingin meluncurkan kembang api\Nkarena punya kenangan itu, ya?
Dialogue: 0,0:07:41.61,0:07:46.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, bukan begitu maksudku.
Dialogue: 0,0:07:46.13,0:07:49.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang membuatku sangat ingin meluncurkan\Nkembang api adalah
Dialogue: 0,0:07:49.81,0:07:52.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}setelah aku tidak bisa melihat.
Dialogue: 0,0:07:52.33,0:07:53.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya?
Dialogue: 0,0:07:53.79,0:07:56.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini...
Dialogue: 0,0:07:56.13,0:07:58.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih ke ingin berjuang melakukan sesuatu.
Dialogue: 0,0:07:58.72,0:08:00.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bikin makin bingung saja.
Dialogue: 0,0:08:09.92,0:08:12.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keretanya mulai penuh?
Dialogue: 0,0:08:12.13,0:08:13.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok tahu?
Dialogue: 0,0:08:13.39,0:08:16.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kamu jadi lebih dekat denganku.
Dialogue: 0,0:08:16.02,0:08:18.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak juga.
Dialogue: 0,0:08:19.54,0:08:22.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah melindungiku.
Dialogue: 0,0:08:30.93,0:08:32.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu capek?
Dialogue: 0,0:08:32.32,0:08:33.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kok.
Dialogue: 0,0:08:34.29,0:08:36.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku sudah capek.
Dialogue: 0,0:08:36.48,0:08:38.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bilang apa tadi?
Dialogue: 0,0:08:38.38,0:08:39.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo.
Dialogue: 0,0:08:39.82,0:08:41.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita ke arah kiri.
Dialogue: 0,0:08:56.16,0:08:59.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia cuma melihatnya\Ndan pergi setelah menabraknya?
Dialogue: 0,0:08:59.14,0:09:00.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalan pakai ma—
Dialogue: 0,0:09:02.24,0:09:03.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:09:03.28,0:09:04.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:09:04.66,0:09:07.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah terbiasa, kok.
Dialogue: 0,0:09:07.57,0:09:09.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu...
Dialogue: 0,0:09:09.11,0:09:11.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia lagi pegang ponsel, kan?
Dialogue: 0,0:09:11.66,0:09:15.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti sedang membaca pesan\Ndari orang terdekatnya.
Dialogue: 0,0:09:15.38,0:09:17.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nada bicaramu jadi kurang ramah.
Dialogue: 0,0:09:17.83,0:09:20.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu semarah itu.
Dialogue: 0,0:09:22.38,0:09:23.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:09:30.61,0:09:32.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau ke kafe dulu?
Dialogue: 0,0:09:34.20,0:09:35.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang.
Dialogue: 0,0:09:42.70,0:09:45.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah menentukan pesanannya?
Dialogue: 0,0:09:45.71,0:09:46.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hayase?
Dialogue: 0,0:09:46.78,0:09:48.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Ada apa ini?
Dialogue: 0,0:09:48.67,0:09:50.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suaranya Yuko!
Dialogue: 0,0:09:50.13,0:09:52.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koharu!
Dialogue: 0,0:09:53.36,0:09:54.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi.
Dialogue: 0,0:09:59.79,0:10:03.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata Sorano lagi sama Koharu, ya.
Dialogue: 0,0:10:04.51,0:10:06.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pesan es kopi dan paket C.
Dialogue: 0,0:10:06.82,0:10:09.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak perlu buru-buru\Nmemesan begitu, dong.
Dialogue: 0,0:10:09.92,0:10:11.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu lagi kerja, kan?
Dialogue: 0,0:10:11.34,0:10:12.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya.
Dialogue: 0,0:10:15.17,0:10:17.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini ada acara apa?
Dialogue: 0,0:10:17.03,0:10:18.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mau meluncurkan kembang api.
Dialogue: 0,0:10:18.98,0:10:20.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembang api?
Dialogue: 0,0:10:20.21,0:10:22.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau ikutan main kembang api juga?
Dialogue: 0,0:10:22.98,0:10:25.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau, dong!\NKapan?
Dialogue: 0,0:10:25.67,0:10:27.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan, nih?
Dialogue: 0,0:10:27.73,0:10:30.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok tanya aku?
Dialogue: 0,0:10:35.86,0:10:40.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencana kita hari ini adalah membeli\Nkembang api luncur paling mewah!
Dialogue: 0,0:10:40.11,0:10:42.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang anggarannya satu juta yen.
Dialogue: 0,0:10:42.03,0:10:44.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua bisa dibeli sama Sultan Fuyutsuki.
Dialogue: 0,0:10:44.77,0:10:46.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:10:48.26,0:10:52.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,\Nsejak kapan kalian sedekat ini?
Dialogue: 0,0:10:52.21,0:10:54.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami terlihat dekat?
Dialogue: 0,0:10:54.18,0:10:57.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya Kakeru\Nselalu menunjukkan wajah suram?
Dialogue: 0,0:10:57.62,0:11:00.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, sekarang lagi cengar-cengir.
Dialogue: 0,0:11:00.54,0:11:01.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:11:01.12,0:11:04.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?\NAku mau pegang wajahmu, dong!
Dialogue: 0,0:11:04.66,0:11:06.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok jadi ke situ?
Dialogue: 0,0:11:06.77,0:11:10.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada itu, mending pesan dulu.
Dialogue: 0,0:11:10.02,0:11:13.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, menunya tidak kelihatan.
Dialogue: 0,0:11:13.03,0:11:14.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:11:14.93,0:11:19.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kopi, es kopi, teh hitam.
Dialogue: 0,0:11:19.38,0:11:21.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Es teh susu lagi laris, lo.
Dialogue: 0,0:11:24.66,0:11:27.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa menghabiskan\Ngelas sebesar ini?
Dialogue: 0,0:11:27.46,0:11:29.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, maaf.
Dialogue: 0,0:11:34.01,0:11:36.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya.
Dialogue: 0,0:11:38.08,0:11:41.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Situasi begini yang bikin canggung.
Dialogue: 0,0:11:41.89,0:11:44.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau teh susu hangat,\Nukurannya normal.
Dialogue: 0,0:11:44.93,0:11:46.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pesan yang itu saja.
Dialogue: 0,0:11:48.03,0:11:49.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf menunggu.
Dialogue: 0,0:11:50.77,0:11:52.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:11:52.27,0:11:53.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat menikmati.
Dialogue: 0,0:12:03.26,0:12:06.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teh susunya tepat di depanmu.
Dialogue: 0,0:12:06.10,0:12:07.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa, kok.
Dialogue: 0,0:12:14.42,0:12:16.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata masih panas.
Dialogue: 0,0:12:17.01,0:12:18.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati.
Dialogue: 0,0:12:19.28,0:12:21.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ini enak.
Dialogue: 0,0:12:22.56,0:12:26.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kami tidak akan pernah\Nsaling bertatapan,
Dialogue: 0,0:12:26.78,0:12:30.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terkadang aku merasa\Npandangan kami saling bertemu.
Dialogue: 0,0:12:30.74,0:12:34.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu membuatku gugup dan sesak.
Dialogue: 0,0:12:36.10,0:12:38.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak makan?
Dialogue: 0,0:12:39.30,0:12:41.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak perlu khawatir soal itu, kok.
Dialogue: 0,0:12:42.03,0:12:44.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau cicip sedikit?
Dialogue: 0,0:12:44.06,0:12:46.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kamu mau menyuapiku?
Dialogue: 0,0:12:47.31,0:12:48.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mau.
Dialogue: 0,0:12:48.50,0:12:49.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelit.
Dialogue: 0,0:12:51.38,0:12:53.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan makan siangnya?
Dialogue: 0,0:12:54.38,0:12:59.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya aku tidak terlalu suka\Ndilihat orang saat makan.
Dialogue: 0,0:12:59.31,0:13:00.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:13:01.26,0:13:04.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar memang banyak cewek\Nyang keberatan soal itu.
Dialogue: 0,0:13:04.24,0:13:06.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukannya...
Dialogue: 0,0:13:08.18,0:13:11.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang kamu memperlakukanku\Nseperti cewek pada umumnya.
Dialogue: 0,0:13:13.50,0:13:16.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senyumannya kena banget di hati.
Dialogue: 0,0:13:23.74,0:13:24.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh.
Dialogue: 0,0:13:26.77,0:13:29.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak perlu menjawab soal ini.
Dialogue: 0,0:13:30.51,0:13:35.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana rasanya tidak bisa melihat?
Dialogue: 0,0:13:35.33,0:13:37.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa seperti melihat dalam gelap?
Dialogue: 0,0:13:38.13,0:13:40.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng...
Dialogue: 0,0:13:43.14,0:13:46.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu keberatan menjawabnya...
Dialogue: 0,0:13:46.06,0:13:49.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak yang mengira gelap gulita,
Dialogue: 0,0:13:49.16,0:13:51.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku justru sebaliknya.
Dialogue: 0,0:13:51.12,0:13:52.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaliknya?
Dialogue: 0,0:13:53.09,0:13:58.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira seperti berada di tengah kabut\Ntransparan yang agak putih.
Dialogue: 0,0:14:07.20,0:14:09.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya di sekitar sini.
Dialogue: 0,0:14:10.42,0:14:12.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ketemu.
Dialogue: 0,0:14:14.64,0:14:16.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toko kembang api.
Dialogue: 0,0:14:20.43,0:14:23.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, isinya kembang api semua.
Dialogue: 0,0:14:24.84,0:14:27.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toko spesialis memang beda.
Dialogue: 0,0:14:27.72,0:14:30.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak jenisnya.
Dialogue: 0,0:14:30.10,0:14:32.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakal susah memilihnya, deh.
Dialogue: 0,0:14:33.14,0:14:35.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa saja?
Dialogue: 0,0:14:35.01,0:14:39.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, kembang api luncur itu
Dialogue: 0,0:14:39.31,0:14:41.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}banyak dipajang di rak sebelah kanan.
Dialogue: 0,0:14:41.76,0:14:44.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya yang jenis tembakan\Nberuntun paling laris.
Dialogue: 0,0:14:47.57,0:14:51.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai dari 10 tembakan beruntun\Nsampai 30 tembakan beruntun.
Dialogue: 0,0:14:51.36,0:14:53.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak tipenya juga ternyata.
Dialogue: 0,0:14:53.14,0:14:57.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mumpung kita lagi di sini,\Nbeli paling banyak saja.
Dialogue: 0,0:14:57.01,0:14:59.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}30 tembakan beruntun!
Dialogue: 0,0:14:59.07,0:15:00.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:15:00.40,0:15:04.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sampingnya ada kembang api luncur\Nbersuara nyaring juga.
Dialogue: 0,0:15:04.02,0:15:05.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersuara nyaring?
Dialogue: 0,0:15:05.97,0:15:08.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut penjelasannya...
Dialogue: 0,0:15:08.46,0:15:13.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naik sambil berbunyi pyuu\Nlalu meledak bunyi duar.
Dialogue: 0,0:15:15.07,0:15:17.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau coba itu!
Dialogue: 0,0:15:17.33,0:15:18.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:15:19.74,0:15:22.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kembang api pegangan tangan juga?
Dialogue: 0,0:15:22.07,0:15:27.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada, seperti kembang api bambu,\Nkembang api kawat,
Dialogue: 0,0:15:27.20,0:15:29.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kembang api pijar.
Dialogue: 0,0:15:29.42,0:15:31.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menarik juga!
Dialogue: 0,0:15:31.70,0:15:33.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beli yang ini juga?
Dialogue: 0,0:15:33.26,0:15:36.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makin banyak jenisnya, makin bagus.
Dialogue: 0,0:15:36.53,0:15:38.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggarannya satu juta yen, ya?
Dialogue: 0,0:15:38.51,0:15:41.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, soalnya aku sultan.
Dialogue: 0,0:15:43.78,0:15:45.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakeru.
Dialogue: 0,0:15:45.34,0:15:48.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benaran boleh dititipkan ke kamu dulu?
Dialogue: 0,0:15:48.35,0:15:49.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, bukan masalah.
Dialogue: 0,0:15:49.84,0:15:54.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kemungkinan akan diluncurkan di kampus,\Njadi simpan di asramaku saja.
Dialogue: 0,0:15:54.67,0:15:56.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:15:58.02,0:16:00.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kapan mau diluncurkan?
Dialogue: 0,0:16:00.78,0:16:05.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, apa kita butuh izin\Nuntuk meluncurkannya?
Dialogue: 0,0:16:05.31,0:16:08.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita tanya Yuko!
Dialogue: 0,0:16:08.20,0:16:11.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, aku sudah tidak sabar.
Dialogue: 0,0:16:14.30,0:16:18.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah membeli kembang api,\Nsekarang mau ke mana?
Dialogue: 0,0:16:18.43,0:16:19.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:16:20.27,0:16:22.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu masih mau kencan denganku?
Dialogue: 0,0:16:22.48,0:16:24.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibilang ini bukan kencan.
Dialogue: 0,0:16:24.08,0:16:26.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bercanda, kok.
Dialogue: 0,0:16:26.16,0:16:29.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sambil bawa kembang api pasti berat.
Dialogue: 0,0:16:29.25,0:16:34.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak enak kamu bawa berat-berat,\Nbagaimana kalau kita pulang saja?
Dialogue: 0,0:16:34.93,0:16:42.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, kalau bawa sebanyak ini,\Nbisa dikira bawa barang berbahaya sama polisi.
Dialogue: 0,0:16:42.06,0:16:44.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku akan dikira komplotanmu?
Dialogue: 0,0:16:44.91,0:16:47.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru kamu pelaku utamanya.
Dialogue: 0,0:16:47.79,0:16:51.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, kamu selalu punya cara\Nmenanggapi bercandaanku.
Dialogue: 0,0:16:53.34,0:16:58.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya aku mulai suka\Nmembuatnya tertawa.
Dialogue: 0,0:16:58.21,0:16:59.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,
Dialogue: 0,0:16:59.46,0:17:01.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mau pulang naik bus air saja?
Dialogue: 0,0:17:02.46,0:17:04.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bus air?
Dialogue: 0,0:17:04.74,0:17:08.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di kampung halamanku ada feri\Nyang menghubungkan sampai Pelabuhan Moji.
Dialogue: 0,0:17:08.98,0:17:11.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di Tokyo juga ada yang begituan?
Dialogue: 0,0:17:11.42,0:17:14.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang beroperasi dari Asakusa,\Nlewat Sungai Sumida,
Dialogue: 0,0:17:14.06,0:17:18.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai Odaiba di Teluk Tokyo, lo.
Dialogue: 0,0:17:18.57,0:17:20.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, aku baru tahu.
Dialogue: 0,0:17:21.44,0:17:24.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah naik itu dulu.
Dialogue: 0,0:17:24.61,0:17:28.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya dengan bus air, dari sekitar sini\Nbisa pulang sampai daerah Tsukishima,
Dialogue: 0,0:17:28.69,0:17:30.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku mau coba naik.
Dialogue: 0,0:17:32.98,0:17:37.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, meski tidak bisa melihat,\Ndia bisa naik kapal.
Dialogue: 0,0:17:37.06,0:17:42.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa mendengar suara kapal membelah air,\Natau menikmati angin yang menerpa.
Dialogue: 0,0:17:43.76,0:17:45.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar.
Dialogue: 0,0:17:48.21,0:17:52.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melewati Jembatan Kuramae,\Ndi Ryogoku ada dermaga.
Dialogue: 0,0:17:52.47,0:17:54.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya bisa sampai dekat kampus.
Dialogue: 0,0:17:56.22,0:17:58.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:17:58.22,0:17:59.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk apa?
Dialogue: 0,0:18:00.31,0:18:03.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atas kebaikanmu membantu\Nmencarikan informasi.
Dialogue: 0,0:18:03.62,0:18:06.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini wajar, kok.
Dialogue: 0,0:18:06.02,0:18:10.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ini dianggap wajar,\Nlisensi kebaikanmu ada di level dua.
Dialogue: 0,0:18:10.97,0:18:13.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lisensi apaan itu?
Dialogue: 0,0:18:18.90,0:18:20.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah sampai di dermaga.
Dialogue: 0,0:18:20.94,0:18:22.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempatnya seperti apa?
Dialogue: 0,0:18:23.06,0:18:26.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dalam gedung ada loket,
Dialogue: 0,0:18:26.30,0:18:29.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan di dermaga bagian belakang,\Nbus air sudah menunggu.
Dialogue: 0,0:18:30.75,0:18:33.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bus air itu lantai satunya ruang kabin,
Dialogue: 0,0:18:33.50,0:18:36.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lantai duanya sepertinya jadi dek atap.
Dialogue: 0,0:18:39.39,0:18:41.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita beli tiketnya dulu.
Dialogue: 0,0:18:41.12,0:18:42.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:18:59.55,0:19:02.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa duduk di kabin lantai satu,
Dialogue: 0,0:19:02.18,0:19:05.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau ke dek atap di lantai dua.
Dialogue: 0,0:19:05.08,0:19:06.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau yang mana?
Dialogue: 0,0:19:06.74,0:19:08.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dek atap.
Dialogue: 0,0:19:12.29,0:19:14.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:19:14.11,0:19:16.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangganya agak sempit.
Dialogue: 0,0:19:17.09,0:19:19.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahaya karena kapalnya bergoyang.
Dialogue: 0,0:19:19.76,0:19:22.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti hanya bisa menuntun\Nsambil genggam tangannya.
Dialogue: 0,0:19:25.49,0:19:27.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pinjam tanganmu.
Dialogue: 0,0:19:27.41,0:19:28.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:19:41.82,0:19:42.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:19:42.96,0:19:44.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:19:45.02,0:19:47.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama seperti sebelumnya,
Dialogue: 0,0:19:47.10,0:19:51.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tanganmu benar-benar hangat.
Dialogue: 0,0:19:51.09,0:19:54.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah, kalau kakimu terbentur,\Nnanti sakit.
Dialogue: 0,0:20:00.11,0:20:03.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapalnya agak bergoyang, ya.
Dialogue: 0,0:20:03.60,0:20:07.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di depanmu ada pegangan setinggi pinggang.
Dialogue: 0,0:20:07.67,0:20:08.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pegangan ke situ saja.
Dialogue: 0,0:20:08.94,0:20:09.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:20:13.94,0:20:15.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:20:17.26,0:20:19.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat menantikan ini.
Dialogue: 0,0:20:19.63,0:20:21.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benaran kelihatan menantikannya.
Dialogue: 0,0:20:21.55,0:20:26.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, karena tidak menyangka\Nakan ditemani naik kapal.
Dialogue: 0,0:20:26.86,0:20:28.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kamu...
Dialogue: 0,0:20:29.68,0:20:34.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hampir bilang\Nbisa menemaninya kapan saja.
Dialogue: 0,0:20:35.90,0:20:40.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku tidak keberatan\Nberinteraksi lebih banyak dengannya?
Dialogue: 0,0:20:41.20,0:20:43.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sendiri pun belum paham.
Dialogue: 0,0:20:54.77,0:20:56.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemandangannya indah?
Dialogue: 0,0:20:58.03,0:21:02.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kamu diam saja,\Naku pikir kamu sedang menikmatinya.
Dialogue: 0,0:21:02.37,0:21:04.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, iya.
Dialogue: 0,0:21:05.58,0:21:07.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak bisa melihat\Npemandangannya, ya.
Dialogue: 0,0:21:07.93,0:21:11.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tidak bisa melihat,\Naku menikmatinya.
Dialogue: 0,0:21:11.65,0:21:17.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa pernah melihat pemandangan\Ndi tempat yang sama saat masih melihat.
Dialogue: 0,0:21:17.60,0:21:20.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku teringat pemandangan itu.
Dialogue: 0,0:21:21.70,0:21:24.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemandangan apa yang kamu lihat saat itu?
Dialogue: 0,0:21:25.98,0:21:28.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seingatku mendung.
Dialogue: 0,0:21:31.07,0:21:33.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini sangat cerah.
Dialogue: 0,0:21:33.81,0:21:35.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langitnya juga biru.
Dialogue: 0,0:21:36.30,0:21:39.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langit biru yang terpantul\Ndi permukaan air,
Dialogue: 0,0:21:39.38,0:21:41.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terlihat sangat indah.
Dialogue: 0,0:21:43.23,0:21:48.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik sekali mau mendeskripsikan\Npemandangannya padaku.
Dialogue: 0,0:21:48.48,0:21:52.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena hari ini baru dapat\Nlisensi kebaikan level dua.
Dialogue: 0,0:21:54.42,0:21:57.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih telah menggunakan jasa kami.
Dialogue: 0,0:21:57.21,0:21:59.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapal akan segera diberangkatkan.
Dialogue: 0,0:21:59.86,0:22:01.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pegangan yang kuat, ya.
Dialogue: 0,0:22:01.84,0:22:03.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja!
Dialogue: 0,0:22:03.41,0:22:05.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibilang pegangan!
Dialogue: 0,0:22:28.10,0:22:30.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anginnya kencang, kamu baik-baik saja?
Dialogue: 0,0:22:30.34,0:22:32.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejuk rasanya.
Dialogue: 0,0:22:34.14,0:22:36.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyaman sekali.
Dialogue: 0,0:22:36.03,0:22:37.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:23:49.23,0:23:52.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah menemaniku naik kapal.
Dialogue: 0,0:23:55.18,0:23:58.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih kembali.
