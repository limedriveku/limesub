Dialogue: 0,0:00:55.29,0:01:05.84,sign,,0000,0000,0000,,LOVE UNSEEN BENEATH THE CLEAR NIGHT SKY
Dialogue: 0,0:03:32.23,0:03:33.43,sign,,0000,0000,0000,,HAYASE YUKO: ADA YANG MELIHAT KOHARU
Dialogue: 0,0:03:33.43,0:03:34.32,sign,,0000,0000,0000,,SEJAK KEJADIAN WAKTU ITU?
Dialogue: 0,0:03:34.32,0:03:35.39,sign,,0000,0000,0000,,USHIO NARUMI:
Dialogue: 0,0:03:35.39,0:03:36.78,sign,,0000,0000,0000,,AKU TIDAK BISA MENGHUBUNGINYA
Dialogue: 0,0:03:36.78,0:03:38.99,sign,,0000,0000,0000,,AKU JUGA
Dialogue: 0,0:03:38.99,0:03:39.87,sign,,0000,0000,0000,,DIBACA 2
Dialogue: 0,0:03:40.87,0:03:42.83,sign,,0000,0000,0000,,HEI
Dialogue: 0,0:03:50.46,0:03:53.21,sign,,0000,0000,0000,,FUYUTSUKI KOHARU
Dialogue: 0,0:04:41.64,0:04:44.14,sign,,0000,0000,0000,,HARI INI\NHARI INI KAMU KULIAH TIDAK?
Dialogue: 0,0:05:58.63,0:06:02.01,sign,,0000,0000,0000,,TERIMA KASIH ATAS PEMBELIANNYA
Dialogue: 0,0:10:59.14,0:11:00.09,sign,,0000,0000,0000,,INFORMASI KONSULTASI MEDIS
Dialogue: 0,0:11:00.09,0:11:00.75,sign,,0000,0000,0000,,NOMOR YANG DIPANGGIL KONSULTASI
Dialogue: 0,0:11:00.75,0:11:02.28,sign,,0000,0000,0000,,NOMOR ANTREAN KONSULTASI, PEMBAYARAN
Dialogue: 0,0:11:02.28,0:11:03.54,sign,,0000,0000,0000,,NOMOR YANG DIPANGGIL PEMBAYARAN
Dialogue: 0,0:11:03.54,0:11:04.52,sign,,0000,0000,0000,,NOMOR ANTREAN PEMBAYARAN\NTERIMA KASIH ATAS KUNJUNGAN ANDA
Dialogue: 0,0:11:32.50,0:11:33.11,sign,,0000,0000,0000,,HAYASE YUKO\NSORANO, SUDAH BISA MENGHUBUNGI KOHARU?
Dialogue: 0,0:11:33.11,0:11:33.81,sign,,0000,0000,0000,,PESAN DARIKU BAHKAN BELUM DIBACA\NIYA, SUDAH KUDUGA, SIH...
Dialogue: 0,0:11:33.81,0:11:34.41,sign,,0000,0000,0000,,NANTI AKU KABARI KALAU DIA BALAS\NMAAF, YA, DAN TERIMA KASIH
Dialogue: 0,0:11:34.41,0:11:35.01,sign,,0000,0000,0000,,AKU BARU SAMPAI RUMAH SAKIT\NAKU JUGA, KAMU DI MANA?
Dialogue: 0,0:12:17.13,0:12:22.26,sign,,0000,0000,0000,,INFORMASI UMUM
Dialogue: 0,0:12:22.26,0:12:25.42,sign,,0000,0000,0000,,PETUNJUK ARAH RUMAH SAKIT
Dialogue: 0,0:12:25.42,0:12:26.52,sign,,0000,0000,0000,,RUANG RAWAT INAP
Dialogue: 0,0:12:26.52,0:12:27.36,sign,,0000,0000,0000,,BANGSAL BEDAH
Dialogue: 0,0:12:27.36,0:12:28.01,sign,,0000,0000,0000,,RUANG OPERASI PUSAT, ICU/OFTALMOLOGI
Dialogue: 0,0:12:28.01,0:12:28.64,sign,,0000,0000,0000,,PUSAT OTAK DAN SARAF/OTOLARINGOLOGI
Dialogue: 0,0:12:32.15,0:12:33.42,sign,,0000,0000,0000,,BANGSAL PENYAKIT DALAM
Dialogue: 0,0:12:33.42,0:12:36.53,sign,,0000,0000,0000,,BANGSAL BEDAH
Dialogue: 0,0:13:38.63,0:13:39.46,sign,,0000,0000,0000,,NANTI AKU KABARI KALAU DIA BALAS\NMAAF, YA, DAN TERIMA KASIH
Dialogue: 0,0:13:39.46,0:13:41.01,sign,,0000,0000,0000,,AKU BARU SAMPAI RUMAH SAKIT
Dialogue: 0,0:13:41.01,0:13:42.01,sign,,0000,0000,0000,,AKU JUGA
Dialogue: 0,0:14:52.54,0:14:53.39,sign,,0000,0000,0000,,HAYASE YUKO\NADA DI SINI
Dialogue: 0,0:14:53.39,0:14:54.70,sign,,0000,0000,0000,,DI MANA?
Dialogue: 0,0:14:54.70,0:14:59.65,sign,,0000,0000,0000,,RUANG ANAK DI BANGSAL PEDIATRI
Dialogue: 0,0:14:59.65,0:15:04.46,sign,,0000,0000,0000,,DIA LAGI APA?
Dialogue: 0,0:15:04.46,0:15:14.64,sign,,0000,0000,0000,,MENYANYIKAN LAGU UNTUK ANAK-ANAK
Dialogue: 0,0:22:07.18,0:22:08.61,sign,,0000,0000,0000,,CEPAT SEMBUH, YA
Dialogue: 0,0:22:08.61,0:22:10.19,sign,,0000,0000,0000,,NANTI KITA MAIN BARENG LAGI
Dialogue: 0,0:22:10.19,0:22:11.81,sign,,0000,0000,0000,,LAWAN PENYAKITNYA
Dialogue: 0,0:22:11.81,0:22:12.39,sign,,0000,0000,0000,,KAMI MENUNGGUMU DI SEKOLAH
Dialogue: 0,0:22:12.39,0:22:18.28,sign,,0000,0000,0000,,SEDANG OPERASI
Dialogue: 0,0:23:54.91,0:24:06.43,sign,,0000,0000,0000,,TRANSPARAN
Dialogue: 0,0:03:07.57,0:03:10.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak mengirim video pernyataan cinta\Npada Fuyutsuki,
Dialogue: 0,0:03:10.46,0:03:14.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}belum ada balasan darinya ke siapa pun.
Dialogue: 0,0:03:15.30,0:03:20.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan, sudah seminggu berlalu sejak itu,\Naku belum bertemu dengannya lagi.
Dialogue: 0,0:03:22.08,0:03:27.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan karena malu bertemu,\Natau karena canggung,
Dialogue: 0,0:03:27.39,0:03:29.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memang tidak bisa bertemu saja.
Dialogue: 0,0:03:30.75,0:03:32.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya
Dialogue: 0,0:03:32.23,0:03:34.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Narumi dan Hayase juga sama,
Dialogue: 0,0:03:35.39,0:03:36.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi kami
Dialogue: 0,0:03:36.78,0:03:38.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sering saling menghubungi.
Dialogue: 0,0:03:57.25,0:03:59.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya apa yang terjadi?
Dialogue: 0,0:04:06.64,0:04:08.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuyutsuki...
Dialogue: 0,0:04:09.41,0:04:11.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah kelas pertama hari Senin,
Dialogue: 0,0:04:11.65,0:04:14.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami biasa menghabiskan waktu\Ndi bangku teras ini.
Dialogue: 0,0:04:15.74,0:04:19.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengobrol hal-hal ringan,\Ndan Fuyutsuki tertawa.
Dialogue: 0,0:04:19.89,0:04:22.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira itu akan terus berlanjut.
Dialogue: 0,0:04:23.82,0:04:28.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seingatku, dia pernah bilang\Ntidak kuat minum soda.
Dialogue: 0,0:04:32.42,0:04:34.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengin dengar suaranya...
Dialogue: 0,0:04:46.54,0:04:48.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibaca pun tidak.
Dialogue: 0,0:04:48.54,0:04:52.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku diabaikan?\NAtau diblokir?
Dialogue: 0,0:04:55.17,0:04:57.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaan apa ini?
Dialogue: 0,0:04:57.02,0:04:59.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Patah hati?
Dialogue: 0,0:05:02.10,0:05:03.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya bukan.
Dialogue: 0,0:05:04.66,0:05:08.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih ke khawatir terjadi sesuatu\Nsama Fuyutsuki.
Dialogue: 0,0:05:08.87,0:05:13.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku ingin bertemu\Ndan memastikannya.
Dialogue: 0,0:05:14.85,0:05:17.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang terdekatku tiba-tiba hilang.
Dialogue: 0,0:05:18.50,0:05:21.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti tidak pernah ada sejak awal.
Dialogue: 0,0:05:22.62,0:05:27.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahku juga tiba-tiba pergi\Ndan menghilang.
Dialogue: 0,0:05:29.92,0:05:32.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kalau dia sepenting itu buatmu,\Nakan kurebut saja."
Dialogue: 0,0:05:32.90,0:05:36.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya seperti sesuatu yang sudah lama\Nkusembunyikan di dalam hati,
Dialogue: 0,0:05:36.19,0:05:37.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}direnggut begitu saja dariku.
Dialogue: 0,0:05:39.92,0:05:41.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hukuman macam apa ini?
Dialogue: 0,0:05:41.71,0:05:45.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti pernah melakukan dosa besar\Ndi kehidupan sebelumnya.
Dialogue: 0,0:05:46.34,0:05:47.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi.
Dialogue: 0,0:05:49.12,0:05:52.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Hayase.
Dialogue: 0,0:05:52.85,0:05:54.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak apa-apa?
Dialogue: 0,0:05:54.27,0:05:58.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jarang aku lihat kamu segalau ini.
Dialogue: 0,0:05:58.63,0:06:02.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku kelihatan setegar itu?
Dialogue: 0,0:06:02.01,0:06:07.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang suka berinisiatif\Nbiasanya terlihat begitu.
Dialogue: 0,0:06:07.71,0:06:11.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, mentalku rapuh, tahu.
Dialogue: 0,0:06:12.71,0:06:15.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga Koharu tidak ada di sini.
Dialogue: 0,0:06:16.16,0:06:19.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara aku mengirim\Nvideo aneh itu, ya?
Dialogue: 0,0:06:19.02,0:06:21.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok dibilang aneh?
Dialogue: 0,0:06:23.03,0:06:26.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena menganggap enteng\Npernyataan cinta orang lain.
Dialogue: 0,0:06:26.53,0:06:29.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu maksudmu.
Dialogue: 0,0:06:30.06,0:06:34.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hayase pasti tidak terbiasa sendirian.
Dialogue: 0,0:06:35.62,0:06:38.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak segalau Hayase.
Dialogue: 0,0:06:40.02,0:06:43.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, bohong.\NKoreksi.
Dialogue: 0,0:06:43.63,0:06:45.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuyutsuki bikin galau.
Dialogue: 0,0:06:47.98,0:06:49.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi, ya?
Dialogue: 0,0:06:50.30,0:06:51.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, ya.
Dialogue: 0,0:06:54.00,0:06:58.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu dikasih soal-soal ujian\Nsemester lalu sama senior?
Dialogue: 0,0:06:58.52,0:07:01.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, dikasih beberapa.
Dialogue: 0,0:07:01.70,0:07:03.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau fotokopi, dong.
Dialogue: 0,0:07:03.60,0:07:05.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti aku traktir minuman.
Dialogue: 0,0:07:05.65,0:07:06.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh.
Dialogue: 0,0:07:08.67,0:07:10.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sorano!
Dialogue: 0,0:07:21.25,0:07:22.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:07:23.26,0:07:24.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa lari-larian?
Dialogue: 0,0:07:25.81,0:07:28.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku langsung lari...\Ndari Tsukishima...
Dialogue: 0,0:07:29.39,0:07:32.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Narumi, cowok badan gede sepertimu—
Dialogue: 0,0:07:32.21,0:07:33.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melihat...
Dialogue: 0,0:07:34.30,0:07:35.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuyutsuki.
Dialogue: 0,0:07:38.06,0:07:39.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana?
Dialogue: 0,0:07:39.40,0:07:43.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berjalan dari Shintomicho\Ndan masuk ke sebuah rumah sakit besar.
Dialogue: 0,0:07:43.82,0:07:45.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumah sakit?
Dialogue: 0,0:07:46.11,0:07:47.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang...
Dialogue: 0,0:07:47.53,0:07:48.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:07:49.79,0:07:50.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ke sana dulu.
Dialogue: 0,0:07:50.74,0:07:52.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ikut.
Dialogue: 0,0:07:52.22,0:07:53.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bagaimana?
Dialogue: 0,0:07:54.50,0:07:57.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ada kelas yang harus kuhadiri.
Dialogue: 0,0:07:57.62,0:08:00.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa,\Nbiar kami berdua yang ke sana.
Dialogue: 0,0:08:00.99,0:08:03.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tahu tempatnya?
Dialogue: 0,0:08:04.34,0:08:07.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa cari lewat peta.\NMakasih.
Dialogue: 0,0:08:09.06,0:08:10.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati!
Dialogue: 0,0:08:27.95,0:08:29.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak apa-apa?
Dialogue: 0,0:08:35.39,0:08:38.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu duluan saja.
Dialogue: 0,0:09:14.12,0:09:17.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan terakhir kali\Naku berlari mati-matian begini?
Dialogue: 0,0:09:51.60,0:09:54.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, permisi.
Dialogue: 0,0:09:56.69,0:09:59.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh aku bertanya?
Dialogue: 0,0:09:59.01,0:10:02.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bo-Boleh, ini kunjungan pertama Anda?
Dialogue: 0,0:10:02.48,0:10:05.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa di rumah sakit ini ada Fuyutsuki...
Dialogue: 0,0:10:05.50,0:10:08.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seseorang bernama Fuyutsuki Koharu?
Dialogue: 0,0:10:08.75,0:10:11.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Informasi pribadi pasien tidak bisa...
Dialogue: 0,0:10:11.13,0:10:12.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mohon.
Dialogue: 0,0:10:12.59,0:10:15.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belakangan ini,\Naku tidak bisa menghubunginya.
Dialogue: 0,0:10:15.84,0:10:19.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sadar betapa konyolnya tindakanku ini.
Dialogue: 0,0:10:19.20,0:10:21.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku tidak bisa berhenti.\NAku ingin tahu.
Dialogue: 0,0:10:21.74,0:10:24.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong beri tahu.\NAku ingin bertemu dengannya.
Dialogue: 0,0:10:26.30,0:10:28.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski Anda bilang begitu...
Dialogue: 0,0:10:30.22,0:10:31.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:10:33.98,0:10:36.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, sudah tidak apa-apa?
Dialogue: 0,0:10:38.88,0:10:40.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apanya yang tidak apa-apa?
Dialogue: 0,0:10:40.85,0:10:45.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu betapa konyolnya kelakuanku...
Dialogue: 0,0:10:46.18,0:10:47.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu itu...
Dialogue: 0,0:10:59.14,0:11:03.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin saja nama Fuyutsuki akan dipanggil.
Dialogue: 0,0:11:11.90,0:11:16.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nomor 107, silakan ke resepsionis.
Dialogue: 0,0:11:16.84,0:11:18.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata bukan panggil nama.
Dialogue: 0,0:11:21.56,0:11:24.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuyutsuki...
Dialogue: 0,0:11:26.64,0:11:28.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pergi ke mana?
Dialogue: 0,0:11:37.34,0:11:39.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sorano.
Dialogue: 0,0:11:42.36,0:11:45.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat juga datangnya.\NKamu naik kereta?
Dialogue: 0,0:11:45.30,0:11:46.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:11:46.56,0:11:49.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan ada taksi lewat.
Dialogue: 0,0:11:49.15,0:11:51.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah bertemu Koharu?
Dialogue: 0,0:11:54.30,0:11:57.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tanya ke resepsionis,\Ntapi tidak dikasih tahu.
Dialogue: 0,0:11:57.43,0:11:59.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya iyalah.
Dialogue: 0,0:12:00.32,0:12:04.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, benar juga, ya...
Dialogue: 0,0:12:05.20,0:12:06.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:12:06.25,0:12:08.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus mencarinya sendiri.
Dialogue: 0,0:12:08.72,0:12:11.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan cari di gedung lama sebelah.
Dialogue: 0,0:12:11.00,0:12:12.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti berkabar, ya.
Dialogue: 0,0:12:22.26,0:12:25.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat yang paling memungkinkan...
Dialogue: 0,0:12:26.52,0:12:28.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di bagian mata.
Dialogue: 0,0:12:33.42,0:12:36.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang membawa tongkat putih...
Dialogue: 0,0:12:43.80,0:12:45.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada.
Dialogue: 0,0:13:39.46,0:13:42.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hayase belum ada kabar.
Dialogue: 0,0:13:44.14,0:13:46.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ada di mana, sih?
Dialogue: 0,0:13:55.16,0:13:56.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara piano?
Dialogue: 0,0:14:03.24,0:14:08.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biji ek jatuh berguling-guling, blung.
Dialogue: 0,0:14:08.62,0:14:13.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tercebur ke kolam, wah, gawat.
Dialogue: 0,0:14:13.94,0:14:19.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seekor ikan loach pun muncul dan berkata,
Dialogue: 0,0:14:19.23,0:14:24.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Adik kecil, ayo bermain bersama."
Dialogue: 0,0:14:25.58,0:14:31.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Biji ek berguling-guling dengan gembira.\N- Situasi apa ini?
Dialogue: 0,0:14:31.09,0:14:36.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Bermain bersama untuk sementara waktu.\N- Itu dia, dia ada di sana.
Dialogue: 0,0:14:36.52,0:14:40.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Namun akhirnya merindukan gunungnya.\N- Syukurlah...
Dialogue: 0,0:14:40.02,0:14:41.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Namun akhirnya merindukan gunungnya.\N- Dia tidak hilang.
Dialogue: 0,0:14:41.96,0:14:44.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ia menangis\N- Syukurlah dia tidak menghilang.
Dialogue: 0,0:14:44.42,0:14:47.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hingga membuat si loach kebingungan.
Dialogue: 0,0:14:48.10,0:14:50.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak, mainkan yang lain, dong.
Dialogue: 0,0:14:50.74,0:14:52.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh.
Dialogue: 0,0:14:53.39,0:14:54.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu, dua.
Dialogue: 0,0:14:54.70,0:14:59.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gelembung sabun terbang.
Dialogue: 0,0:14:59.65,0:15:09.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terbang sampai ke atap.
Dialogue: 0,0:15:09.52,0:15:14.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu pecah dan hilang.
Dialogue: 0,0:15:14.64,0:15:19.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gelembung sabun lenyap.
Dialogue: 0,0:15:19.78,0:15:24.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum sempat terbang jauh.
Dialogue: 0,0:15:24.78,0:15:29.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru saja tercipta.
Dialogue: 0,0:15:29.78,0:15:34.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah pecah dan hilang.
Dialogue: 0,0:15:34.61,0:15:37.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Momen Fuyutsuki menjadi kakak penyanyi\N- Angin, jangan bertiup.
Dialogue: 0,0:15:37.36,0:15:40.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berlangsung sekitar 15 menit.\N- Angin, jangan bertiup.
Dialogue: 0,0:15:40.02,0:15:44.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari terbangkan gelembung sabun.
Dialogue: 0,0:15:44.32,0:15:47.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:15:47.38,0:15:48.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dadah.
Dialogue: 0,0:15:50.43,0:15:51.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo.
Dialogue: 0,0:15:52.22,0:15:53.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:16:05.71,0:16:08.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, aku harus bicara apa?
Dialogue: 0,0:16:14.67,0:16:15.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuyutsuki!
Dialogue: 0,0:16:16.54,0:16:19.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketika berbicara dengan orang\Nyang tidak bisa melihat,
Dialogue: 0,0:16:19.49,0:16:23.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita harus memberi tahu mereka\Nsiapa diri kita.
Dialogue: 0,0:16:25.07,0:16:29.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuyutsuki sudah mulai terbiasa\Ndengan suaraku.
Dialogue: 0,0:16:30.67,0:16:31.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:16:32.42,0:16:34.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada sesuatu yang terasa aneh.
Dialogue: 0,0:16:36.54,0:16:38.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Fuyutsuki.
Dialogue: 0,0:16:38.05,0:16:40.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Sorano.\NAku ada di belakangmu.
Dialogue: 0,0:16:47.34,0:16:49.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mencarimu ke mana-mana.
Dialogue: 0,0:16:49.33,0:16:52.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu punya waktu, Tuan Putri?
Dialogue: 0,0:16:54.19,0:16:58.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya dia akan jawab, "Siapa, ya,"\Natau "Kamu salah orang."
Dialogue: 0,0:16:58.80,0:17:01.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengikuti candaanku dan tertawa.
Dialogue: 0,0:17:03.46,0:17:04.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:17:16.74,0:17:20.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koharu, di sini ada tangga,\Npegangan saja ke sikuku.
Dialogue: 0,0:17:20.46,0:17:21.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa sendiri.
Dialogue: 0,0:17:31.74,0:17:33.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang janggal.
Dialogue: 0,0:17:40.85,0:17:42.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng...
Dialogue: 0,0:17:42.54,0:17:45.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, begini...
Dialogue: 0,0:17:46.08,0:17:47.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tidak berjumpa.
Dialogue: 0,0:17:49.42,0:17:51.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami khawatir, tahu.
Dialogue: 0,0:17:51.68,0:17:54.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tidak menghubungi kami?
Dialogue: 0,0:17:55.97,0:17:56.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:17:57.33,0:17:58.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf...
Dialogue: 0,0:18:02.88,0:18:06.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kita pernah bertemu?
Dialogue: 0,0:18:09.42,0:18:12.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak perlu menjawab soal ini.
Dialogue: 0,0:18:13.30,0:18:14.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng...
Dialogue: 0,0:18:14.96,0:18:18.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana rasanya tidak bisa melihat?
Dialogue: 0,0:18:18.64,0:18:20.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa seperti melihat dalam gelap?
Dialogue: 0,0:18:21.47,0:18:23.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng...
Dialogue: 0,0:18:26.56,0:18:29.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu keberatan menjawabnya...
Dialogue: 0,0:18:30.67,0:18:33.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak yang mengira gelap gulita,
Dialogue: 0,0:18:33.73,0:18:35.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku justru sebaliknya.
Dialogue: 0,0:18:35.71,0:18:37.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaliknya?
Dialogue: 0,0:18:37.66,0:18:42.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira seperti berada di tengah kabut\Ntransparan yang agak putih.
Dialogue: 0,0:18:51.66,0:18:55.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak perlu jawab\Nyang ini juga, kok.
Dialogue: 0,0:18:55.79,0:18:58.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan tanyakan saja.
Dialogue: 0,0:19:01.02,0:19:03.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kapan kamu tidak bisa melihat?
Dialogue: 0,0:19:06.86,0:19:09.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kelas tiga SMP.
Dialogue: 0,0:19:10.14,0:19:11.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kecelakaan?
Dialogue: 0,0:19:14.67,0:19:16.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kanker.
Dialogue: 0,0:19:16.86,0:19:19.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemoterapinya berat banget, tahu.
Dialogue: 0,0:21:00.45,0:21:04.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak perlu jawab\Nyang ini juga, kok.
Dialogue: 0,0:21:04.50,0:21:06.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan tanyakan saja.
Dialogue: 0,0:21:09.90,0:21:12.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kapan kamu tidak bisa melihat?
Dialogue: 0,0:21:15.58,0:21:18.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kelas tiga SMP.
Dialogue: 0,0:21:18.67,0:21:19.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kecelakaan?
Dialogue: 0,0:21:23.74,0:21:25.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kanker.
Dialogue: 0,0:21:25.86,0:21:28.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemoterapinya berat banget, tahu.
Dialogue: 0,0:21:30.67,0:21:34.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya aku ingin dia tahu\Nsegalanya tentangku.
Dialogue: 0,0:21:35.82,0:21:36.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi,
Dialogue: 0,0:21:37.40,0:21:38.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku menceritakan semuanya.
Dialogue: 0,0:21:40.88,0:21:45.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang paling pertama,\Nmuncul benjolan kecil di dalam kepalaku.
Dialogue: 0,0:21:46.61,0:21:51.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Titik putih kecil ini adalah tumor ganas.
Dialogue: 0,0:21:52.48,0:21:56.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah menjalani pengobatan yang cuma perlu\Ntidur beberapa kali di dalam mesin besar,
Dialogue: 0,0:21:56.67,0:21:59.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sembuh begitu saja tanpa masalah.
Dialogue: 0,0:22:00.17,0:22:04.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, ternyata gampang.\NDengan ini, semuanya sudah selesai.
Dialogue: 0,0:22:04.68,0:22:06.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu yang kupikirkan waktu itu.
Dialogue: 0,0:22:08.61,0:22:10.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beberapa tahun kemudian,
Dialogue: 0,0:22:10.19,0:22:11.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sel kankernya menyebar.
Dialogue: 0,0:22:13.92,0:22:15.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena menyebar ke retina,
Dialogue: 0,0:22:15.91,0:22:17.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku jadi harus memilih.
Dialogue: 0,0:22:18.90,0:22:20.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengangkat kedua bola mata,
Dialogue: 0,0:22:20.90,0:22:25.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau mempertahankan bola mata\Nsambil menjalani operasi dan kemoterapi.
Dialogue: 0,0:22:26.67,0:22:29.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memilih mempertahankannya.
Dialogue: 0,0:22:32.21,0:22:35.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita mulai kemoterapinya.
Dialogue: 0,0:22:35.36,0:22:36.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:22:38.56,0:22:41.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi menekan pertumbuhan sel kanker,
Dialogue: 0,0:22:41.40,0:22:43.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku menyuntikkan obat keras\Nke tubuhku sendiri.
Dialogue: 0,0:22:44.72,0:22:50.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertumbuhan sel jahat memang berhenti,\Ntapi fungsi sel normal juga jadi melambat.
Dialogue: 0,0:23:31.76,0:23:34.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama-lama aku jadi tidak bisa tidur.
Dialogue: 0,0:23:35.15,0:23:38.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin karena tidak bisa tidur,\Nkesadaranku menjadi kabur,
Dialogue: 0,0:23:38.69,0:23:41.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan ingatanku mulai kacau.
Dialogue: 0,0:23:42.37,0:23:45.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya ini efek samping "chemo brain".
Dialogue: 0,0:23:49.06,0:23:54.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Ini di mana, ya?
