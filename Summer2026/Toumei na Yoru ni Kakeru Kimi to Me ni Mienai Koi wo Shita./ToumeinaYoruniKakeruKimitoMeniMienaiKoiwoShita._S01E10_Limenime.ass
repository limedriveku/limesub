Dialogue: 0,0:02:52.28,0:03:02.83,sign,,0000,0000,0000,,LOVE UNSEEN BENEATH THE CLEAR NIGHT SKY
Dialogue: 0,0:08:30.61,0:08:33.12,sign,,0000,0000,0000,,RAMEN YOAKE
Dialogue: 0,0:14:32.60,0:14:33.68,sign,,0000,0000,0000,,KOMPETISI LAUT JEPANG
Dialogue: 0,0:14:56.29,0:14:56.98,sign,,0000,0000,0000,,KOMPETISI LAUT JEPANG
Dialogue: 0,0:15:11.47,0:15:13.02,sign,,0000,0000,0000,,AKU MAU PERGI KE PABRIK KEMBANG API!
Dialogue: 0,0:15:18.19,0:15:19.19,sign,,0000,0000,0000,,TENTU SAJA!
Dialogue: 0,0:15:19.19,0:15:21.40,sign,,0000,0000,0000,,AYO PERGI BARENG!
Dialogue: 0,0:15:21.40,0:15:24.40,sign,,0000,0000,0000,,PABRIK KEMBANG API NANIGASHI
Dialogue: 0,0:15:59.15,0:16:04.78,sign,,0000,0000,0000,,CANGKANG UKURAN 3 SAMPAI 10
Dialogue: 0,0:19:25.23,0:19:27.15,sign,,0000,0000,0000,,SORANO KYOUKO
Dialogue: 0,0:22:24.78,0:22:30.04,sign,,0000,0000,0000,,SELALU DI SISIMU
Dialogue: 0,0:00:04.37,0:00:06.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang ini berat bagiku!
Dialogue: 0,0:00:08.59,0:00:10.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa menyuruhku lebih semangat?
Dialogue: 0,0:00:10.82,0:00:13.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teganya berkata hal sekejam itu.
Dialogue: 0,0:00:18.06,0:00:20.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba sentuh ini.
Dialogue: 0,0:00:26.74,0:00:29.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini punyaku?
Dialogue: 0,0:00:30.90,0:00:33.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku membacanya.
Dialogue: 0,0:00:34.38,0:00:35.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Curang.
Dialogue: 0,0:00:36.51,0:00:37.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlalu curang.
Dialogue: 0,0:00:39.39,0:00:43.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih baik punya tujuan daripada menangis.
Dialogue: 0,0:00:44.00,0:00:45.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo semangat.
Dialogue: 0,0:00:45.78,0:00:48.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa meringankan rasa sakitmu,
Dialogue: 0,0:00:49.20,0:00:52.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku bisa menjengukmu,\Nmendengar ceritamu,
Dialogue: 0,0:00:52.61,0:00:54.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan memberimu semangat.
Dialogue: 0,0:00:56.27,0:00:58.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sedang terluka,
Dialogue: 0,0:00:58.74,0:01:01.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}orang yang kucintai ini\Nrela menyumbangkan rambutnya.
Dialogue: 0,0:01:02.30,0:01:03.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menyemangatinya.
Dialogue: 0,0:01:04.87,0:01:05.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu,
Dialogue: 0,0:01:06.59,0:01:07.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ayo semangat.
Dialogue: 0,0:01:09.26,0:01:11.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tahu Fuyutsuki tidak bisa melihat,
Dialogue: 0,0:01:12.03,0:01:13.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan tetap tersenyum.
Dialogue: 0,0:01:15.32,0:01:17.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa akan baik-baik saja?
Dialogue: 0,0:01:18.20,0:01:22.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, semua akan baik-baik saja.
Dialogue: 0,0:01:24.86,0:01:27.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku bisa semangat lagi?
Dialogue: 0,0:01:29.57,0:01:33.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga boleh menggambar\Nkembang api, kan?
Dialogue: 0,0:01:34.94,0:01:36.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:01:40.80,0:01:43.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berjanjilah.
Dialogue: 0,0:01:43.80,0:01:48.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak boleh melihat gambar\Ndari kertas yang kulipat ini.
Dialogue: 0,0:01:48.76,0:01:50.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:01:51.08,0:01:54.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu punya pensil warna?
Dialogue: 0,0:01:54.12,0:01:55.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang merah muda.
Dialogue: 0,0:01:56.16,0:01:57.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada.
Dialogue: 0,0:02:02.50,0:02:05.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong hadap belakang.
Dialogue: 0,0:02:05.06,0:02:06.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:02:10.52,0:02:12.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benaran hadap belakang, kan?
Dialogue: 0,0:02:13.18,0:02:16.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kamu butuh bantuan?
Dialogue: 0,0:02:16.10,0:02:18.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa sendiri.
Dialogue: 0,0:02:22.91,0:02:24.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah selesai.
Dialogue: 0,0:02:32.10,0:02:35.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Janji jangan melihatnya, ya.
Dialogue: 0,0:04:11.34,0:04:14.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama kita tidak jalan bertiga.
Dialogue: 0,0:04:15.70,0:04:18.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selepas Kids Time, ayo jenguk Koharu.
Dialogue: 0,0:04:19.89,0:04:20.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:04:25.68,0:04:26.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kondisimu?
Dialogue: 0,0:04:29.24,0:04:30.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lumayan.
Dialogue: 0,0:04:32.26,0:04:34.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lumayan apanya, ya?
Dialogue: 0,0:04:34.84,0:04:36.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lumayan mendingan?
Dialogue: 0,0:04:36.64,0:04:38.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau lumayan sakit?
Dialogue: 0,0:04:39.47,0:04:43.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus, pas ada dua bapak-bapak mau ribut,
Dialogue: 0,0:04:43.58,0:04:45.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku langsung melerai mereka.
Dialogue: 0,0:04:45.98,0:04:49.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka malah suka sama aku,
Dialogue: 0,0:04:49.73,0:04:53.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai disuruh kerja\Ndi perusahaannya pas lulus.
Dialogue: 0,0:04:53.66,0:04:56.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu saja yang gampang disukai pemabuk.
Dialogue: 0,0:04:56.62,0:04:59.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manajer toko sampai terharu, tahu!
Dialogue: 0,0:04:59.24,0:05:02.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang, "Narumi pahlawan toko kita!"
Dialogue: 0,0:05:02.24,0:05:03.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya.
Dialogue: 0,0:05:05.20,0:05:07.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat, ya.
Dialogue: 0,0:05:12.54,0:05:15.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Su-Sudah waktunya pulang.
Dialogue: 0,0:05:15.10,0:05:17.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, hari ini sampai di sini saja.
Dialogue: 0,0:05:27.26,0:05:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuyutsuki, kami akan datang lagi.
Dialogue: 0,0:05:32.22,0:05:33.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:05:44.94,0:05:48.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Hayase, jangan sampai tumpah.
Dialogue: 0,0:05:48.70,0:05:52.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya menetes terus.
Dialogue: 0,0:05:52.08,0:05:54.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan diarahkan ke sini.
Dialogue: 0,0:05:54.70,0:05:56.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau jatuh itu.
Dialogue: 0,0:05:58.84,0:06:01.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ketawa!
Dialogue: 0,0:06:02.82,0:06:03.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah.
Dialogue: 0,0:06:09.86,0:06:12.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, perutku sampai sakit.
Dialogue: 0,0:06:12.10,0:06:14.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa es krim kita sama semua?
Dialogue: 0,0:06:14.60,0:06:17.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sendiri yang pilih.
Dialogue: 0,0:06:17.84,0:06:21.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski agak awal,\Nmau makan malam hamburger?
Dialogue: 0,0:06:21.30,0:06:22.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada di Tsukishima.
Dialogue: 0,0:06:22.78,0:06:23.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh.
Dialogue: 0,0:06:25.40,0:06:27.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya kamu mau makan apa?
Dialogue: 0,0:06:29.06,0:06:31.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kedai ramen yang ingin kucoba,
Dialogue: 0,0:06:31.98,0:06:36.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di dekat Stasiun Monzen-nakacho,\Nbawah jalan layang Shuto.
Dialogue: 0,0:06:36.21,0:06:39.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seniorku bilang rasanya enak,
Dialogue: 0,0:06:39.17,0:06:41.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi canggung kalau masuk sendirian.
Dialogue: 0,0:06:41.34,0:06:43.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa enggak bareng seniormu?
Dialogue: 0,0:06:43.59,0:06:46.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa ragu.
Dialogue: 0,0:06:46.38,0:06:48.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama kami enggak ragu, ya.
Dialogue: 0,0:06:49.16,0:06:50.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah.
Dialogue: 0,0:06:51.00,0:06:54.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, kita naik kereta dari Tsukishima.
Dialogue: 0,0:06:56.84,0:06:59.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kita
Dialogue: 0,0:06:59.14,0:07:02.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berhenti menjenguk Fuyutsuki ramai-ramai.
Dialogue: 0,0:07:03.84,0:07:05.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:07:06.86,0:07:09.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar mereka bilang begitu.
Dialogue: 0,0:07:10.49,0:07:13.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melihat langsung kondisi Fuyutsuki\Nyang seburuk itu,
Dialogue: 0,0:07:13.42,0:07:16.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lima menit pun kami tidak sanggup\Nada di kamar rawatnya.
Dialogue: 0,0:07:17.40,0:07:20.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tidak tega melihatnya semenderita itu.
Dialogue: 0,0:07:21.82,0:07:25.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Liburan musim panas nanti\Naku ada praktik berlayar,
Dialogue: 0,0:07:25.58,0:07:29.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi sampai akhir Agustus\Ntidak pulang ke asrama.
Dialogue: 0,0:07:29.22,0:07:30.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa, sih?
Dialogue: 0,0:07:30.82,0:07:32.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baru tahu?
Dialogue: 0,0:07:33.04,0:07:35.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jurusanku memang begitu.
Dialogue: 0,0:07:35.14,0:07:38.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan keliling Jepang\Nnaik kapal latih.
Dialogue: 0,0:07:38.48,0:07:41.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oleh-olehnya karamel Jingisukan saja.
Dialogue: 0,0:07:41.61,0:07:43.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan mau liburan.
Dialogue: 0,0:07:44.90,0:07:49.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita yang gantian\Njenguk Koharu saja?
Dialogue: 0,0:07:50.44,0:07:52.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku saja.
Dialogue: 0,0:07:52.00,0:07:53.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sendiri?
Dialogue: 0,0:07:53.94,0:07:54.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:07:55.70,0:07:57.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak usah?
Dialogue: 0,0:07:57.60,0:08:01.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, justru biarkan aku\Nmenjenguknya sendiri.
Dialogue: 0,0:08:01.54,0:08:02.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:08:03.88,0:08:07.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai gantinya, aku akan membantu\Npersiapan rencana kembang apinya.
Dialogue: 0,0:08:08.40,0:08:11.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ingatan Koharu akan kembali\Ndengan kembang api?
Dialogue: 0,0:08:13.06,0:08:16.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak akan tahu sebelum mencobanya.
Dialogue: 0,0:08:17.22,0:08:18.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:08:19.88,0:08:23.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak awal peluangnya memang kecil.
Dialogue: 0,0:08:24.06,0:08:28.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang penting menunjukkan kembang api\Npada Fuyutsuki dan anak-anak.
Dialogue: 0,0:08:33.65,0:08:37.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ramen ekstra lemak dan nasi goreng satu.
Dialogue: 0,0:08:37.08,0:08:38.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ramen biasa satu.
Dialogue: 0,0:08:38.91,0:08:40.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ramen...
Dialogue: 0,0:08:40.14,0:08:43.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, minyaknya bisa dikurangi sedikit?
Dialogue: 0,0:08:43.96,0:08:45.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:08:45.80,0:08:48.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Narumi, makanmu banyak juga.
Dialogue: 0,0:08:48.34,0:08:52.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya aku selalu dalam masa pertumbuhan.
Dialogue: 0,0:08:53.16,0:08:55.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya kamu pesan ekstra minyak, kan?
Dialogue: 0,0:08:55.72,0:08:57.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya.
Dialogue: 0,0:08:57.60,0:09:01.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu malah minta dikurangi minyak,\Nkayak bocah saja.
Dialogue: 0,0:09:01.32,0:09:05.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di kampungku tidak ada budaya\Nminta ekstra lemak begitu.
Dialogue: 0,0:09:05.11,0:09:08.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu, ya.
Dialogue: 0,0:09:09.96,0:09:11.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan.
Dialogue: 0,0:09:15.52,0:09:19.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Liburan musim panas nanti\Nkamu pulang kampung?
Dialogue: 0,0:09:19.76,0:09:22.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ada rencana pulang.
Dialogue: 0,0:09:22.78,0:09:25.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,\Nkampungmu di mana, Hayase?
Dialogue: 0,0:09:26.16,0:09:27.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku?
Dialogue: 0,0:09:28.36,0:09:30.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tinggal di kampung halaman, kok.
Dialogue: 0,0:09:30.68,0:09:33.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Rumahmu di Kiyosumi Shirakawa?
Dialogue: 0,0:09:33.96,0:09:37.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Punya rumah di pusat Tokyo?\NTajir banget.
Dialogue: 0,0:09:37.52,0:09:41.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini kita ditraktir ramen\Nsama orang tajir itu.
Dialogue: 0,0:09:41.52,0:09:42.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana ada!
Dialogue: 0,0:09:42.96,0:09:46.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluargaku cuma pekerja kantoran biasa.
Dialogue: 0,0:09:46.27,0:09:50.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa pakai irama segala coba?
Dialogue: 0,0:09:51.62,0:09:53.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pekerja kantoran~
Dialogue: 0,0:09:58.40,0:10:00.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kondisimu?
Dialogue: 0,0:10:00.66,0:10:02.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini mendingan.
Dialogue: 0,0:10:02.48,0:10:04.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Efek sampingnya juga tidak terlalu terasa.
Dialogue: 0,0:10:05.52,0:10:07.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:10:07.96,0:10:11.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memang terlihat lebih segar\Ndari biasanya.
Dialogue: 0,0:10:12.32,0:10:15.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak memanggil Narumi abang,
Dialogue: 0,0:10:15.70,0:10:18.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sedangkan aku dianggap kakak biasa.
Dialogue: 0,0:10:19.98,0:10:22.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:10:22.58,0:10:29.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memang terasa seperti\Nseorang kakak dewasa, sih.
Dialogue: 0,0:10:30.44,0:10:32.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa, sih?
Dialogue: 0,0:10:32.40,0:10:34.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau lebih akrab.
Dialogue: 0,0:10:48.74,0:10:50.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sorano?
Dialogue: 0,0:10:53.30,0:10:56.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kira kamu pergi.
Dialogue: 0,0:10:57.30,0:10:58.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku di sini.
Dialogue: 0,0:10:58.94,0:11:02.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau lagi diam, aku takut dijaili.
Dialogue: 0,0:11:02.62,0:11:04.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar suka berburuk sangka.
Dialogue: 0,0:11:04.89,0:11:08.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kan orangnya keras kepala\Ndan pantang menyerah.
Dialogue: 0,0:11:12.42,0:11:17.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obatnya manjur,\Njadi katanya mengecil sedikit.
Dialogue: 0,0:11:17.66,0:11:21.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Benarkah?\NSyukurlah.
Dialogue: 0,0:11:22.08,0:11:23.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:11:23.72,0:11:25.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah berjuang.
Dialogue: 0,0:11:28.62,0:11:32.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, boleh ambilkan tisu?
Dialogue: 0,0:11:32.02,0:11:33.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar.
Dialogue: 0,0:11:35.12,0:11:36.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini.
Dialogue: 0,0:11:37.00,0:11:38.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:11:41.98,0:11:46.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sudah mencoba tegar,\Ndia pasti tetap takut.
Dialogue: 0,0:11:49.42,0:11:53.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunga ini aromanya enak juga.
Dialogue: 0,0:11:53.40,0:11:55.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya manis begitu.
Dialogue: 0,0:11:56.38,0:11:58.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya bakung putih.
Dialogue: 0,0:11:58.84,0:12:01.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin ibuku yang memajangnya.
Dialogue: 0,0:12:01.80,0:12:03.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bunga kesukaanku.
Dialogue: 0,0:12:03.96,0:12:05.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah...
Dialogue: 0,0:12:05.37,0:12:07.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Muncul juga kebiasaanmu.
Dialogue: 0,0:12:08.28,0:12:09.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:12:09.34,0:12:11.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa itu kebiasaanmu.
Dialogue: 0,0:12:11.78,0:12:13.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa?
Dialogue: 0,0:12:13.38,0:12:16.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, karena kamu sering bilang begitu.
Dialogue: 0,0:12:16.62,0:12:17.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah...
Dialogue: 0,0:12:17.76,0:12:18.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuh!
Dialogue: 0,0:12:21.26,0:12:22.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya juga.
Dialogue: 0,0:12:25.54,0:12:27.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Esok hari,
Dialogue: 0,0:12:27.23,0:12:29.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat mau menjenguk Fuyutsuki,
Dialogue: 0,0:12:29.58,0:12:31.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak ada orang di kamarnya.
Dialogue: 0,0:12:36.24,0:12:40.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuyutsuki...
Dialogue: 0,0:12:40.36,0:12:41.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu di mana?
Dialogue: 0,0:12:56.98,0:12:59.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuyutsuki, lagi apa?
Dialogue: 0,0:12:59.18,0:13:01.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sorano?
Dialogue: 0,0:13:01.18,0:13:03.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan malah tanya balik.
Dialogue: 0,0:13:03.90,0:13:05.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau ke mana sendirian?
Dialogue: 0,0:13:06.46,0:13:08.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ke mana-mana.
Dialogue: 0,0:13:08.38,0:13:11.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takut kehilangan otot\Nkalau tidur terus.
Dialogue: 0,0:13:11.84,0:13:15.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesekali harus jalan\Nsupaya tidak kalah sama penyakit.
Dialogue: 0,0:13:18.50,0:13:20.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah minta izin dokter?
Dialogue: 0,0:13:21.20,0:13:23.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan memaksakan diri.
Dialogue: 0,0:13:25.56,0:13:26.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya...
Dialogue: 0,0:13:27.64,0:13:32.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takut tidak bisa jalan\Nsaat kembang api nanti.
Dialogue: 0,0:13:32.67,0:13:36.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah memutuskan berjuang\Nuntuk hari itu.
Dialogue: 0,0:13:36.96,0:13:39.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dukung aku, dong.
Dialogue: 0,0:13:40.82,0:13:44.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski berat,\Ndia tetap berjalan sambil tertawa.
Dialogue: 0,0:13:46.08,0:13:48.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulangnya aku bantu, ya.
Dialogue: 0,0:13:48.16,0:13:51.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, boleh pinjam lengan kirimu?
Dialogue: 0,0:14:07.00,0:14:08.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan kalah.
Dialogue: 0,0:14:10.20,0:14:12.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah berkeliling lorong sekali,
Dialogue: 0,0:14:13.04,0:14:15.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuyutsuki kembali ke tempat tidurnya.
Dialogue: 0,0:14:17.38,0:14:21.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keesokan harinya, kondisinya memburuk.
Dialogue: 0,0:14:21.46,0:14:25.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seminggu setelah itu,\Naku tidak bisa menemuinya lagi.
Dialogue: 0,0:14:33.68,0:14:37.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Narumi lagi di laut mana, ya?
Dialogue: 0,0:14:38.20,0:14:42.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di tengah laut sana lebih adem\Ndari kamar ini tidak, ya?
Dialogue: 0,0:14:45.28,0:14:47.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:14:49.08,0:14:53.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah tidak ada rencana pulang kampung,\Nditambah tidak ada teman main juga.
Dialogue: 0,0:14:53.58,0:14:55.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian, bokek juga
Dialogue: 0,0:14:56.98,0:15:00.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuyutsuki lagi apa, ya?
Dialogue: 0,0:15:00.04,0:15:02.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi lagi enggak bisa menjenguknya.
Dialogue: 0,0:15:02.80,0:15:05.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar enggak ada kerjaan.
Dialogue: 0,0:15:06.48,0:15:09.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bosan banget karena enggak ada kerjaan.
Dialogue: 0,0:15:09.01,0:15:10.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu lagi apa?
Dialogue: 0,0:15:15.64,0:15:17.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku boleh ikut?
Dialogue: 0,0:15:30.62,0:15:34.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah cara kami menjemur\Ncangkang kembang api
Dialogue: 0,0:15:34.32,0:15:36.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di bawah matahari supaya kering.
Dialogue: 0,0:15:36.46,0:15:39.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, banyak banget.
Dialogue: 0,0:15:39.67,0:15:44.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para perajin membuatnya\Nsatu per satu dengan tangan.
Dialogue: 0,0:15:44.14,0:15:46.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Isinya penuh bubuk mesiu, lo.
Dialogue: 0,0:15:46.22,0:15:48.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar karya perajin sejati.
Dialogue: 0,0:15:48.93,0:15:50.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:15:50.36,0:15:52.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Terima kasih sudah mau mampir.\N- Hayase gampang banget akrab sama orang.
Dialogue: 0,0:15:52.60,0:15:55.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kami juga bisa menunjukkan\N- Hayase gampang banget akrab sama orang.
Dialogue: 0,0:15:55.12,0:15:56.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}beberapa desain kami yang lain.
Dialogue: 0,0:15:56.90,0:15:58.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah...
Dialogue: 0,0:16:04.78,0:16:07.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, Sorano?
Dialogue: 0,0:16:08.91,0:16:11.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior Kotomugi?
Dialogue: 0,0:16:12.90,0:16:14.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok ada di sini?
Dialogue: 0,0:16:15.00,0:16:18.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan, aku lagi kerja sambilan.
Dialogue: 0,0:16:18.54,0:16:23.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kami kebetulan lagi kurang orang.
Dialogue: 0,0:16:28.30,0:16:29.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sorano.
Dialogue: 0,0:16:30.80,0:16:33.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawa barang-barang itu ke sana.
Dialogue: 0,0:16:33.31,0:16:35.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, iya.
Dialogue: 0,0:16:56.46,0:16:59.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior, ayo istirahat sebentar.
Dialogue: 0,0:17:08.16,0:17:10.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sedang menempel cangkang.
Dialogue: 0,0:17:10.93,0:17:12.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menempel cangkang itu apa?
Dialogue: 0,0:17:13.68,0:17:16.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tahap terakhir pembuatan kembang api.
Dialogue: 0,0:17:16.46,0:17:21.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyatukan dua cangkang setengah lingkaran\Nberisi bubuk mesiu menjadi satu bola,
Dialogue: 0,0:17:21.56,0:17:24.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu merekatkannya dengan selotip kertas.
Dialogue: 0,0:17:24.52,0:17:29.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu, mereka menempelkan\Nkertas kraft yang diolesi lem.
Dialogue: 0,0:17:30.49,0:17:34.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dilapisi berulang-ulang dengan teratur.
Dialogue: 0,0:17:35.10,0:17:37.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Repot juga, ya.
Dialogue: 0,0:17:37.80,0:17:39.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang kerjaan berat.
Dialogue: 0,0:17:39.64,0:17:42.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditempel, digulingkan di papan kayu
Dialogue: 0,0:17:42.90,0:17:46.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk membuang angin, lalu dijemur.
Dialogue: 0,0:17:46.18,0:17:48.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kering, ditempel kertas kraft lagi,
Dialogue: 0,0:17:48.60,0:17:50.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}diulang berkali-kali.
Dialogue: 0,0:17:51.86,0:17:55.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu, tekanan dalamnya merata,
Dialogue: 0,0:17:55.52,0:17:57.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sehingga bisa meledak membentuk\Nlingkaran bulat sempurna.
Dialogue: 0,0:17:57.94,0:17:59.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah...
Dialogue: 0,0:17:59.77,0:18:02.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kertas yang berlapis-lapis inilah
Dialogue: 0,0:18:02.18,0:18:04.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang menjadi energi\Nsaat kembang api meledak.
Dialogue: 0,0:18:05.27,0:18:09.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya orang-orang suka\Nkembang api luncur.
Dialogue: 0,0:18:09.18,0:18:11.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya?
Dialogue: 0,0:18:11.62,0:18:15.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setiap orang punya perasaan\Nyang mereka pendam, kan?
Dialogue: 0,0:18:15.96,0:18:20.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembang api meledak dengan suara duar\Ndan meluapkan segalanya.
Dialogue: 0,0:18:20.54,0:18:23.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka pasti merasakan hal yang sama
Dialogue: 0,0:18:23.83,0:18:25.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat melihat kembang api.
Dialogue: 0,0:18:28.92,0:18:30.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua mau coba buat?
Dialogue: 0,0:18:30.67,0:18:33.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami boleh membuat cangkang kembang api?
Dialogue: 0,0:18:33.18,0:18:36.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu agak sulit, sih,
Dialogue: 0,0:18:36.18,0:18:39.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi bisa kalau kembang api pegang.
Dialogue: 0,0:18:58.88,0:19:02.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembang api pegang juga bagus, ya.
Dialogue: 0,0:19:02.38,0:19:04.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:19:04.21,0:19:07.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kembang api luncur\Njauh lebih bagus.
Dialogue: 0,0:19:07.04,0:19:08.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:19:12.62,0:19:15.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suatu hari, aku ingin main\Nsama Fuyutsuki juga.
Dialogue: 0,0:19:31.34,0:19:32.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo?
Dialogue: 0,0:19:33.02,0:19:34.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu lagi senggang?
Dialogue: 0,0:19:34.88,0:19:37.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama tidak dengar suaramu.
Dialogue: 0,0:19:37.92,0:19:38.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:19:40.06,0:19:41.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kabarmu?
Dialogue: 0,0:19:41.52,0:19:43.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lumayan.
Dialogue: 0,0:19:43.24,0:19:44.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kuliahmu?
Dialogue: 0,0:19:44.91,0:19:46.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lumayan juga.
Dialogue: 0,0:19:46.86,0:19:48.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku rajin masuk kelas, kok.
Dialogue: 0,0:19:50.10,0:19:51.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:19:52.05,0:19:54.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana festival kampusnya?
Dialogue: 0,0:19:54.18,0:19:57.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku naik perahu cutter,\Nterus pegal-pegal.
Dialogue: 0,0:19:57.48,0:20:00.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lumayan buat olahraga, kan?
Dialogue: 0,0:20:00.06,0:20:02.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya aku enggak mau ikutan lagi.
Dialogue: 0,0:20:02.93,0:20:05.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kesempatan biar badan kekar.
Dialogue: 0,0:20:05.32,0:20:07.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teman sekamarku sudah kekar, kok.
Dialogue: 0,0:20:07.54,0:20:10.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kamu juga?
Dialogue: 0,0:20:10.76,0:20:12.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, ah.
Dialogue: 0,0:20:13.96,0:20:16.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara Ibu benar-benar bikin tenang.
Dialogue: 0,0:20:17.88,0:20:19.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak pulang ke rumah?
Dialogue: 0,0:20:19.80,0:20:22.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum masuk rencana.
Dialogue: 0,0:20:22.34,0:20:24.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau pacaran, ya?
Dialogue: 0,0:20:25.14,0:20:26.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok jadi ke situ?
Dialogue: 0,0:20:26.96,0:20:31.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya setelah tiga bulan\Nbisa dapat satu dua pacar.
Dialogue: 0,0:20:31.22,0:20:34.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beda sama di sini,\Ndi Tokyo kan banyak cewek.
Dialogue: 0,0:20:34.40,0:20:36.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tokyo itu bukan tempat harem.
Dialogue: 0,0:20:36.94,0:20:38.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa?
Dialogue: 0,0:20:38.50,0:20:41.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku keseringan di asrama\Njadi isinya cowok semua.
Dialogue: 0,0:20:41.46,0:20:43.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadinya harem terbalik.
Dialogue: 0,0:20:43.38,0:20:46.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kan bukan cewek.
Dialogue: 0,0:20:46.80,0:20:50.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu sama Paman akur enggak?
Dialogue: 0,0:20:50.38,0:20:52.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akur, kok.
Dialogue: 0,0:20:52.02,0:20:53.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:20:54.52,0:20:58.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau mengganggu\Nkehidupan baru mereka,
Dialogue: 0,0:20:59.00,0:21:00.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}makanya tidak mau pulang.
Dialogue: 0,0:21:02.24,0:21:03.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu.
Dialogue: 0,0:21:04.46,0:21:06.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh aku tanya sesuatu\Nyang agak berat?
Dialogue: 0,0:21:06.98,0:21:08.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:21:09.10,0:21:13.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Paman masuk rumah sakit,\NIbu akan bagaimana?
Dialogue: 0,0:21:13.78,0:21:17.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu akan menjenguknya tiap hari.
Dialogue: 0,0:21:17.06,0:21:19.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun kondisinya tidak membaik?
Dialogue: 0,0:21:19.84,0:21:22.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu akan genggam tangannya\Nsampai napas terakhirnya.
Dialogue: 0,0:21:24.10,0:21:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tegar sekali.
Dialogue: 0,0:21:26.74,0:21:30.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua juga bisa menjadi tegar\Nsetelah membesarkan anak.
Dialogue: 0,0:21:31.52,0:21:34.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata enggak segampang itu.
Dialogue: 0,0:21:34.14,0:21:36.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lemah juga tidak apa-apa.
Dialogue: 0,0:21:36.14,0:21:38.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin ini hanya perasaanku,
Dialogue: 0,0:21:38.36,0:21:40.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kamu tumbuh jadi anak yang baik.
Dialogue: 0,0:21:40.84,0:21:42.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, ah.
Dialogue: 0,0:21:43.64,0:21:48.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sikapmu yang suka jaga jarak juga,\Nmungkin itu gejolak masa mudamu.
Dialogue: 0,0:21:48.54,0:21:50.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kubilang sudah, ih.
Dialogue: 0,0:21:50.78,0:21:55.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu menjadi kuat\Nuntuk di sisi seseorang.
Dialogue: 0,0:21:56.18,0:21:58.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup temani saja dia.
Dialogue: 0,0:21:58.34,0:22:00.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sudah cukup.
Dialogue: 0,0:22:02.26,0:22:03.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:22:05.58,0:22:07.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti Ibu transfer ke rekeningmu.
Dialogue: 0,0:22:09.18,0:22:14.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku bukan takut bilang ke Ibu\Nkalau uangku sudah habis.
Dialogue: 0,0:22:18.65,0:22:23.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus menggenggam tangannya\Ndan tetap berada di sisinya...
