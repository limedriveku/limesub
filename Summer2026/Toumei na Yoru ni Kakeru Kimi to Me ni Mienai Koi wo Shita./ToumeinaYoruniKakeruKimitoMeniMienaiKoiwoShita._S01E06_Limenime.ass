Dialogue: 0,0:00:16.25,0:00:26.80,sign,,0000,0000,0000,,LOVE UNSEEN BENEATH THE CLEAR NIGHT SKY
Dialogue: 0,0:10:00.33,0:10:03.08,sign,,0000,0000,0000,,SAN
Dialogue: 0,0:10:08.84,0:10:11.84,sign,,0000,0000,0000,,MONJA TSUKISHIMA KOMACHI
Dialogue: 0,0:12:29.69,0:12:30.13,sign,,0000,0000,0000,,KAWARA SOBA
Dialogue: 0,0:12:30.13,0:12:31.55,sign,,0000,0000,0000,,KAWARA SOBA ADALAH HIDANGAN KHAS DAERAH
Dialogue: 0,0:12:31.55,0:12:32.06,sign,,0000,0000,0000,,YANG BERASAL DARI KOTA SHIMONOSEKI,\NPREFEKTUR YAMAGUCHI.
Dialogue: 0,0:15:04.93,0:15:09.18,sign,,0000,0000,0000,,MONJA TSUKISHIMA KOMACHI
Dialogue: 0,0:21:42.16,0:21:43.32,sign,,0000,0000,0000,,DIBACA
Dialogue: 0,0:22:18.48,0:22:19.52,sign,,0000,0000,0000,,SAMPAI KETEMU DI KAMPUS BESOK\NKAPAN MAU MAIN KEMBANG API YANG KITA BELI?
Dialogue: 0,0:22:19.52,0:22:20.49,sign,,0000,0000,0000,,FUYUTSUKI, HARI INI TIDAK MASUK JUGA?
Dialogue: 0,0:22:20.49,0:22:21.24,sign,,0000,0000,0000,,FUYUTSUKI, APA KABARMU?
Dialogue: 0,0:22:24.74,0:22:30.00,sign,,0000,0000,0000,,BANGKU TERAS YANG KOSONG
Dialogue: 0,0:01:31.32,0:01:34.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah festival kembang api\Ndibatalkan karena hujan,
Dialogue: 0,0:01:34.15,0:01:36.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada dua pilihan yang terbesit di kepalaku.
Dialogue: 0,0:01:37.83,0:01:40.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berteduh sampai reda,
Dialogue: 0,0:01:40.83,0:01:43.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau mengantar Fuyutsuki pulang sekarang.
Dialogue: 0,0:01:44.71,0:01:49.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengantarnya pulang adalah\Npilihan yang tepat,
Dialogue: 0,0:01:50.48,0:01:54.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku masih ingin bersamanya.
Dialogue: 0,0:01:58.24,0:02:00.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita ke asrama dulu.
Dialogue: 0,0:02:00.13,0:02:01.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:02:08.44,0:02:09.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti masuk angin.
Dialogue: 0,0:02:09.87,0:02:11.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:02:12.68,0:02:15.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh kugenggam tanganmu?
Dialogue: 0,0:02:15.91,0:02:19.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena tidak bawa payung,\Ntakut terpeleset juga.
Dialogue: 0,0:02:19.17,0:02:20.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh.
Dialogue: 0,0:02:34.75,0:02:37.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf kamarnya sempit.
Dialogue: 0,0:02:38.35,0:02:41.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan duduk di kasur\Nsebelah kananmu saja.
Dialogue: 0,0:02:54.97,0:02:57.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, ada handuk.
Dialogue: 0,0:03:00.84,0:03:02.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:03:09.05,0:03:10.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lumayan basah juga ternyata.
Dialogue: 0,0:03:12.17,0:03:14.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?\NBisa menyekanya sendiri?
Dialogue: 0,0:03:14.73,0:03:16.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa.
Dialogue: 0,0:03:19.08,0:03:22.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, bagaimana bilangnya, ya...
Dialogue: 0,0:03:22.73,0:03:25.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada yang tembus pandang?
Dialogue: 0,0:03:25.94,0:03:27.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bajuku.
Dialogue: 0,0:03:30.99,0:03:35.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal dia minta dilihat bajunya,\Nbukan tengkuknya.
Dialogue: 0,0:03:41.47,0:03:45.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku bilang tembus pandang,\Ndia pasti syok.
Dialogue: 0,0:03:48.33,0:03:50.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak tembus, kok.
Dialogue: 0,0:03:51.25,0:03:54.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku taruh handuknya di pundakmu\Ntakutnya kamu kedinginan.
Dialogue: 0,0:04:01.15,0:04:02.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Canggung banget.
Dialogue: 0,0:04:08.51,0:04:12.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah berduaan\Nbegini sama cewek.
Dialogue: 0,0:04:13.23,0:04:15.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku yang mengajak ke sini,
Dialogue: 0,0:04:15.83,0:04:18.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}malah gugup sendiri.
Dialogue: 0,0:04:26.40,0:04:29.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini kamarmu, Kakeru?
Dialogue: 0,0:04:29.29,0:04:32.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, satu ruangan sama Narumi.
Dialogue: 0,0:04:35.31,0:04:38.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu ini kasurmu?
Dialogue: 0,0:04:39.43,0:04:40.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:04:52.13,0:04:54.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng, dalamanmu...
Dialogue: 0,0:04:54.68,0:04:56.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hampir kelihatan.
Dialogue: 0,0:05:01.40,0:05:02.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu melihatnya?
Dialogue: 0,0:05:02.65,0:05:05.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bilang sebelum kelihatan, kan?
Dialogue: 0,0:05:05.89,0:05:07.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mesum, ih.
Dialogue: 0,0:05:07.16,0:05:09.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibilang aku enggak melihatnya.
Dialogue: 0,0:05:10.40,0:05:12.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku percaya saja, deh.
Dialogue: 0,0:05:15.21,0:05:16.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang banget, ya.
Dialogue: 0,0:05:16.12,0:05:18.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibilang, aku enggak melihatnya.
Dialogue: 0,0:05:18.35,0:05:20.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, maksudku soal kembang api.
Dialogue: 0,0:05:22.60,0:05:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mukaku sampai merah gara-gara\Nasal menyimpulkan sendiri.
Dialogue: 0,0:05:25.93,0:05:28.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi malu setengah mati.
Dialogue: 0,0:05:29.91,0:05:31.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bisa coba tahun depan.
Dialogue: 0,0:05:31.64,0:05:34.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya itu acara tahunan festival kampus.
Dialogue: 0,0:05:35.16,0:05:37.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ingin gabung klub penelitiannya.
Dialogue: 0,0:05:37.81,0:05:41.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meluncurkan kembang api di festival\Nseperti sedang bermasa muda, ya.
Dialogue: 0,0:05:42.63,0:05:45.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku takut tidak diterima.
Dialogue: 0,0:05:46.13,0:05:47.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau gabung bersama?
Dialogue: 0,0:05:47.66,0:05:50.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, kamu yakin?
Dialogue: 0,0:05:50.56,0:05:51.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak keberatan.
Dialogue: 0,0:05:53.27,0:05:54.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Janji, ya?
Dialogue: 0,0:05:59.00,0:06:00.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:06:00.72,0:06:03.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara hujannya terdengar mulai berkurang.
Dialogue: 0,0:06:08.44,0:06:10.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sekarang gerimis.
Dialogue: 0,0:06:13.19,0:06:15.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kuantar ke apartemenmu.
Dialogue: 0,0:06:15.91,0:06:16.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:06:22.48,0:06:26.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tercium aroma sampo Fuyutsuki\Nyang bercampur dengan hujan.
Dialogue: 0,0:06:28.43,0:06:30.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Demi mengalihkan perhatian,\N- Namu Amida Butsu...
Dialogue: 0,0:06:30.93,0:06:35.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- aku terus membaca doa dalam hati.\N- Namu Amida Butsu...
Dialogue: 0,0:06:35.54,0:06:37.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}3.14159...
Dialogue: 0,0:06:37.69,0:06:39.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Karena doanya terlalu pendek,\N- 3.14159265...
Dialogue: 0,0:06:39.89,0:06:42.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- aku coba menghitung pi.\N- 3.14159265...
Dialogue: 0,0:06:42.05,0:06:44.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Batas presisinya cuma delapan desimal,\N- 3.14159265...
Dialogue: 0,0:06:44.64,0:06:46.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- bahkan tidak sampai lima detik.\N- 3.14159265...
Dialogue: 0,0:06:49.00,0:06:51.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembang api kita mau diapakan?
Dialogue: 0,0:06:51.81,0:06:54.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita nyalakan saat musim panas\Nbersama teman-teman saja.
Dialogue: 0,0:06:54.39,0:06:56.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu boleh keluar malam?
Dialogue: 0,0:06:56.91,0:06:58.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh-boleh saja.
Dialogue: 0,0:06:58.93,0:07:03.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya kita bertemu\Nsaat pesta penyambutan malam?
Dialogue: 0,0:07:03.57,0:07:05.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:07:05.65,0:07:08.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita ajak Narumi dan Hayase juga, ya.
Dialogue: 0,0:07:08.20,0:07:09.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh.
Dialogue: 0,0:07:19.21,0:07:20.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakeru...
Dialogue: 0,0:07:23.07,0:07:27.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa kamu belum punya pacar?
Dialogue: 0,0:07:27.89,0:07:28.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pacar?
Dialogue: 0,0:07:28.88,0:07:29.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:07:30.23,0:07:32.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum punya, sih.
Dialogue: 0,0:07:33.27,0:07:34.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:07:34.84,0:07:37.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya itu?
Dialogue: 0,0:07:37.09,0:07:37.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:07:41.49,0:07:46.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya, karena sudah sering\Ndibantu olehmu,
Dialogue: 0,0:07:46.00,0:07:50.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku jadi tidak enak kalau ternyata\Nkamu sudah punya pacar.
Dialogue: 0,0:07:50.20,0:07:53.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan aku sampai merangkul\Ntanganmu begini.
Dialogue: 0,0:07:54.72,0:07:56.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kira apa...
Dialogue: 0,0:07:56.35,0:07:58.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kira apa?
Dialogue: 0,0:07:58.27,0:07:59.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:07:59.33,0:08:02.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, itu, maksudku...
Dialogue: 0,0:08:02.76,0:08:05.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pikir kamu naksir sama aku.
Dialogue: 0,0:08:05.29,0:08:07.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:08:08.32,0:08:10.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kamu lemah sama\Nbercandaan seperti ini.
Dialogue: 0,0:08:12.41,0:08:13.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar jail.
Dialogue: 0,0:08:15.22,0:08:16.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit, tahu.
Dialogue: 0,0:08:17.93,0:08:20.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu balasan yang setimpal.
Dialogue: 0,0:08:23.00,0:08:23.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah sampai.
Dialogue: 0,0:08:26.04,0:08:27.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:08:27.84,0:08:28.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:08:30.40,0:08:34.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya ada cara melihat wajah\Nmeski mata tidak bisa melihat, lo.
Dialogue: 0,0:08:34.61,0:08:35.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melihat wajah?
Dialogue: 0,0:08:36.84,0:08:40.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, caranya menyentuh wajah dengan tangan.
Dialogue: 0,0:08:41.59,0:08:44.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kamu mau melakukan itu padaku?
Dialogue: 0,0:08:48.07,0:08:49.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh?
Dialogue: 0,0:08:50.28,0:08:52.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh saja.
Dialogue: 0,0:09:01.25,0:09:04.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh membungkuk sedikit?
Dialogue: 0,0:09:05.84,0:09:06.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebegini?
Dialogue: 0,0:09:20.49,0:09:24.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu lemah sama\Nbercandaan seperti ini, Kakeru?
Dialogue: 0,0:09:32.07,0:09:33.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat malam.
Dialogue: 0,0:09:37.72,0:09:38.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malam.
Dialogue: 0,0:09:44.92,0:09:47.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah ini aroma lipstiknya\NFuyutsuki atau bukan.
Dialogue: 0,0:09:49.21,0:09:52.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tercium aroma manis dari bibirku.
Dialogue: 0,0:10:01.13,0:10:03.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu ciuman pertamaku,
Dialogue: 0,0:10:03.08,0:10:06.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bingung merespons kejadian kemarin
Dialogue: 0,0:10:06.53,0:10:08.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan akhirnya minta saran ke Narumi.
Dialogue: 0,0:10:09.63,0:10:11.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pilih ini saja?
Dialogue: 0,0:10:18.53,0:10:22.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya orang Kansai enggak makan monja,
Dialogue: 0,0:10:22.63,0:10:24.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi okonomiyaki, kan?
Dialogue: 0,0:10:24.85,0:10:29.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena ibuku berasal dan Gunma,\Naku setengah Kansai dan Kanto.
Dialogue: 0,0:10:29.76,0:10:31.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setengah apaan?
Dialogue: 0,0:10:31.38,0:10:33.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gunma itu di Kanto, ya?
Dialogue: 0,0:10:35.52,0:10:37.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baru mengajak ribut\Nsetengah penduduk Jepang.
Dialogue: 0,0:10:37.85,0:10:40.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah, semangat bikin monja-nya.
Dialogue: 0,0:10:45.33,0:10:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatan enak!
Dialogue: 0,0:10:47.04,0:10:48.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sering bikin di rumah.
Dialogue: 0,0:10:48.99,0:10:49.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah.
Dialogue: 0,0:10:53.24,0:10:54.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang!
Dialogue: 0,0:10:55.21,0:10:56.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelah sini!
Dialogue: 0,0:10:56.29,0:10:57.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:10:57.07,0:10:58.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:10:59.37,0:11:01.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, kalian menunggu lama?
Dialogue: 0,0:11:02.83,0:11:04.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pesan teh oolong!
Dialogue: 0,0:11:04.73,0:11:05.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:11:06.73,0:11:10.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa ada Hayase?\NJelaskan!
Dialogue: 0,0:11:10.64,0:11:12.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar, ya!
Dialogue: 0,0:11:12.48,0:11:15.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini lagi bagian pentingnya.
Dialogue: 0,0:11:17.45,0:11:21.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah dipanggang tiga menit,\Ntusuk pakai spatula kecil, ya.
Dialogue: 0,0:11:21.15,0:11:23.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah terbiasa, ya.
Dialogue: 0,0:11:23.21,0:11:26.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bukannya orang Kansai\Nenggak makan monja?
Dialogue: 0,0:11:26.41,0:11:28.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tanya tadi.
Dialogue: 0,0:11:28.27,0:11:33.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena ibuku berasal dan Gunma,\Naku setengah Kansai dan Kanto.
Dialogue: 0,0:11:33.84,0:11:35.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setengah apaan?
Dialogue: 0,0:11:36.77,0:11:38.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gunma itu di Kanto, ya?
Dialogue: 0,0:11:38.88,0:11:40.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi juga dialognya begitu.
Dialogue: 0,0:11:42.99,0:11:46.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kampung halaman ibuku sangat terpencil.
Dialogue: 0,0:11:47.24,0:11:50.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok enggak jawab ngajak ribut\Nsetengah penduduk Jepang?
Dialogue: 0,0:11:50.01,0:11:51.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa coba?
Dialogue: 0,0:11:51.01,0:11:52.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan.
Dialogue: 0,0:11:53.99,0:11:55.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersulang!
Dialogue: 0,0:11:56.80,0:11:58.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah matang.
Dialogue: 0,0:11:58.12,0:12:00.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, selamat makan!
Dialogue: 0,0:12:02.41,0:12:04.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, lezat!
Dialogue: 0,0:12:04.12,0:12:06.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak juga.
Dialogue: 0,0:12:06.21,0:12:07.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan?
Dialogue: 0,0:12:08.44,0:12:11.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sorano, kamu asal mana?
Dialogue: 0,0:12:11.51,0:12:13.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Honshu paling barat.
Dialogue: 0,0:12:13.36,0:12:16.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di Shimonoseki jarang makan monja, kan?
Dialogue: 0,0:12:17.44,0:12:20.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya mereka memanggang soba\Ndi atas genting.
Dialogue: 0,0:12:20.03,0:12:21.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apaan, tuh?
Dialogue: 0,0:12:21.80,0:12:23.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya kawara soba.
Dialogue: 0,0:12:23.67,0:12:26.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu lihat fotonya, unik banget.
Dialogue: 0,0:12:27.00,0:12:29.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka memanggang soba\Nteh hijau di atas genting.
Dialogue: 0,0:12:30.13,0:12:31.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata betulan.
Dialogue: 0,0:12:32.65,0:12:35.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa memanggang soba di atas genting?
Dialogue: 0,0:12:36.35,0:12:38.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena konduksi panasnya pas.
Dialogue: 0,0:12:39.12,0:12:44.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sekitar rumah orang tuaku,\Ntiap rumah punya satu.
Dialogue: 0,0:12:44.66,0:12:47.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama kayak panci tanah liat, ya?
Dialogue: 0,0:12:49.84,0:12:51.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bohong, ya?
Dialogue: 0,0:12:51.31,0:12:53.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas-jelas cuma bercanda.
Dialogue: 0,0:12:53.73,0:12:55.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada itu, makanlah monja-nya.
Dialogue: 0,0:12:57.47,0:13:00.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadinya mau curhat soal Fuyutsuki,
Dialogue: 0,0:13:00.93,0:13:05.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kalau ada Hayase,\Njadi bingung bagaimana mulainya.
Dialogue: 0,0:13:06.95,0:13:08.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak banget.
Dialogue: 0,0:13:10.92,0:13:12.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sorano, kamu sehat?
Dialogue: 0,0:13:12.76,0:13:14.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak banget.
Dialogue: 0,0:13:16.97,0:13:18.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanmu sudah kebanyakan.
Dialogue: 0,0:13:18.97,0:13:21.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aman saja.
Dialogue: 0,0:13:30.36,0:13:33.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah saatnya curhat soal Fuyutsuki.
Dialogue: 0,0:13:34.12,0:13:37.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar, istirahat dulu.
Dialogue: 0,0:13:37.76,0:13:40.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi, pesan teh oolong satu!
Dialogue: 0,0:13:40.56,0:13:41.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:13:42.86,0:13:46.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ke sini karena Narumi bilang\Nada cerita seru.
Dialogue: 0,0:13:46.73,0:13:49.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah jadi pesta monja doang.
Dialogue: 0,0:13:50.67,0:13:52.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan.
Dialogue: 0,0:13:58.69,0:14:02.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Apaan ini?\NPahit banget.
Dialogue: 0,0:14:05.37,0:14:08.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin itu koktail teh oolong\Npunya pelanggan lain!
Dialogue: 0,0:14:08.59,0:14:09.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya!
Dialogue: 0,0:14:13.97,0:14:16.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sorano, kamu tidak apa-apa?
Dialogue: 0,0:14:16.23,0:14:17.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aman.
Dialogue: 0,0:14:18.31,0:14:19.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matanya mulai kosong, tuh.
Dialogue: 0,0:14:19.72,0:14:21.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aman saja.
Dialogue: 0,0:14:22.60,0:14:25.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal pikiranku jernih begini.
Dialogue: 0,0:14:25.91,0:14:29.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Jadi ini rasanya mabuk?\N- Kamu tidak apa-apa?
Dialogue: 0,0:14:33.98,0:14:35.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh.
Dialogue: 0,0:14:35.16,0:14:37.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiba-tiba ketawa sendiri.
Dialogue: 0,0:14:37.69,0:14:40.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini mah sudah enggak bisa\Ncurhat soal Fuyutsuki.
Dialogue: 0,0:14:40.35,0:14:42.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:14:42.74,0:14:44.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa, kok.
Dialogue: 0,0:14:46.15,0:14:50.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, mungkin ada bagusnya dia mabuk.
Dialogue: 0,0:14:50.97,0:14:53.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, sekarang saatnya.
Dialogue: 0,0:14:53.19,0:14:56.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa ceritakan bagaimana kronologinya\Nsampai bisa jadi seperti itu
Dialogue: 0,0:14:56.52,0:14:57.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan Fuyutsuki?
Dialogue: 0,0:15:01.87,0:15:03.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:15:06.63,0:15:09.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah ceritanya,
Dialogue: 0,0:15:09.95,0:15:13.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan akhirnya aku ciuman sama Fuyutsuki.
Dialogue: 0,0:15:13.25,0:15:17.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Normis, mati saja sana!\N- Aku enggak menduga akan begini!
Dialogue: 0,0:15:18.27,0:15:21.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa bukan kamu yang maju duluan?
Dialogue: 0,0:15:21.16,0:15:23.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kamu bilang begitu...
Dialogue: 0,0:15:23.89,0:15:27.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah, tenang dulu.
Dialogue: 0,0:15:27.16,0:15:30.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya cowok\Nyang menyatakan cinta duluan!
Dialogue: 0,0:15:30.91,0:15:33.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang sudah enggak zaman begituan.
Dialogue: 0,0:15:33.52,0:15:36.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sorano pasti punya caranya sendiri.
Dialogue: 0,0:15:36.15,0:15:39.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus kamu tidak berbuat apa-apa\Nsetelah mengajaknya ke kamar?
Dialogue: 0,0:15:39.54,0:15:41.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin aku begitu.
Dialogue: 0,0:15:41.30,0:15:42.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:15:42.92,0:15:45.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya Fuyutsuki tidak bisa melihat!
Dialogue: 0,0:15:45.44,0:15:48.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, kamu jadi tidak bisa apa-apa?
Dialogue: 0,0:15:48.71,0:15:50.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu!
Dialogue: 0,0:15:50.80,0:15:53.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang dulu, kalian berdua!
Dialogue: 0,0:15:58.29,0:15:59.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:15:59.99,0:16:01.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami minta maaf.
Dialogue: 0,0:16:03.92,0:16:05.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ceritakan sudut pandangmu.
Dialogue: 0,0:16:08.81,0:16:10.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuyutsuki itu...
Dialogue: 0,0:16:10.55,0:16:11.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya?
Dialogue: 0,0:16:12.04,0:16:13.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena dia tidak bisa melihat...
Dialogue: 0,0:16:14.37,0:16:15.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus?
Dialogue: 0,0:16:16.04,0:16:17.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti takut.
Dialogue: 0,0:16:19.56,0:16:20.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya?
Dialogue: 0,0:16:21.91,0:16:26.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tiba-tiba dia disentuh,
Dialogue: 0,0:16:26.39,0:16:28.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin dia akan takut.
Dialogue: 0,0:16:29.51,0:16:32.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku mendadak agresif,\Nyang ada dia ketakutan.
Dialogue: 0,0:16:36.85,0:16:38.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketawamu kelewatan.
Dialogue: 0,0:16:39.00,0:16:41.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah salah paham.
Dialogue: 0,0:16:41.23,0:16:44.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kamu polos banget!
Dialogue: 0,0:16:46.65,0:16:48.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian mengejekku, ya?
Dialogue: 0,0:16:48.65,0:16:50.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, kok.
Dialogue: 0,0:16:52.91,0:16:54.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian memang mengejekku!
Dialogue: 0,0:16:54.51,0:16:56.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibilang enggak, kok.
Dialogue: 0,0:16:56.54,0:16:58.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengejek banget ini mah!
Dialogue: 0,0:16:59.11,0:17:00.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga kalian masuk neraka!
Dialogue: 0,0:17:02.41,0:17:04.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau bertanya sedikit, dong.
Dialogue: 0,0:17:05.76,0:17:08.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang bikin suka sama Koharu?
Dialogue: 0,0:17:08.01,0:17:09.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak mau bilang.
Dialogue: 0,0:17:09.19,0:17:14.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, wajahnya, ya?\NTubuhnya, ya?
Dialogue: 0,0:17:14.23,0:17:16.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar mata keranjang.
Dialogue: 0,0:17:16.04,0:17:18.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cowok kayak begitu\Nenggak cocok sama Koharu.
Dialogue: 0,0:17:18.95,0:17:20.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian bukan!
Dialogue: 0,0:17:21.93,0:17:25.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuyutsuki sering tersenyum, kan?
Dialogue: 0,0:17:27.32,0:17:29.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku kehilangan penglihatanku,
Dialogue: 0,0:17:31.92,0:17:35.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak akan bisa\Nberpikiran positif seperti dia.
Dialogue: 0,0:17:36.93,0:17:37.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paham.
Dialogue: 0,0:17:38.72,0:17:39.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya...
Dialogue: 0,0:17:41.85,0:17:44.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang tuaku sudah bercerai,
Dialogue: 0,0:17:44.28,0:17:46.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tidak bisa berpikiran positif soal itu.
Dialogue: 0,0:17:47.12,0:17:48.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:17:49.64,0:17:54.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu aku cuma bisa berpikiran picik\Ndan sibuk menyalahkan keadaan.
Dialogue: 0,0:17:54.97,0:17:56.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:17:58.32,0:18:01.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma bisa sibuk memperhatikan\Nraut wajah orang lain.
Dialogue: 0,0:18:02.09,0:18:04.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi Fuyutsuki jauh lebih bebas.
Dialogue: 0,0:18:04.65,0:18:06.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa dia hebat.
Dialogue: 0,0:18:06.90,0:18:11.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya dia punya semua\Nyang tidak kupunya.
Dialogue: 0,0:18:11.53,0:18:17.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menyadarkanku, kemalangan itu\Nhanya masalah sudut pandang.
Dialogue: 0,0:18:19.66,0:18:21.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi menyukainya...
Dialogue: 0,0:18:24.43,0:18:28.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya, hati orang itu yang utama.
Dialogue: 0,0:18:28.97,0:18:29.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga paham.
Dialogue: 0,0:18:31.72,0:18:33.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koharu itu,
Dialogue: 0,0:18:33.39,0:18:38.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tiap hari selalu dandan rapi, mengajakmu\Nkeluar cuma demi main kembang api,
Dialogue: 0,0:18:39.31,0:18:42.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kuliahnya juga masuk terus.
Dialogue: 0,0:18:42.43,0:18:44.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa pernah beralasan soal matanya.
Dialogue: 0,0:18:45.71,0:18:49.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku saja masih suka kesiangan.
Dialogue: 0,0:18:49.47,0:18:50.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia benaran hebat.
Dialogue: 0,0:18:52.92,0:18:56.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, agak susah mengungkapkannya...
Dialogue: 0,0:18:56.91,0:18:58.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin begini...
Dialogue: 0,0:19:00.31,0:19:06.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia jujur sama perasaannya, lurus,\Ndan beda banget sama aku.
Dialogue: 0,0:19:06.63,0:19:09.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham banget\Nkenapa kamu bisa mengaguminya.
Dialogue: 0,0:19:12.15,0:19:14.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koharu keren banget, kan?
Dialogue: 0,0:19:19.05,0:19:20.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa bikin-bikin alasan.
Dialogue: 0,0:19:20.68,0:19:23.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sosoknya yang terus terang\Nsoal keinginannya.
Dialogue: 0,0:19:24.14,0:19:28.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa itu juga\Nyang menggerakkan hati Hayase.
Dialogue: 0,0:19:29.92,0:19:31.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:19:32.00,0:19:33.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langsung tembak saja.
Dialogue: 0,0:19:33.36,0:19:35.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bentar, itu agak...
Dialogue: 0,0:19:35.19,0:19:37.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo, kenapa?\NAlurnya lagi ke situ, tahu!
Dialogue: 0,0:19:37.76,0:19:39.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok ke situ?
Dialogue: 0,0:19:39.80,0:19:43.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, ternyata memang susah, ya.
Dialogue: 0,0:19:43.32,0:19:45.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu!
Dialogue: 0,0:19:45.21,0:19:47.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benaran cinta padanya?
Dialogue: 0,0:19:47.10,0:19:48.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:19:48.77,0:19:51.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti susah buat memberanikan diri.
Dialogue: 0,0:19:51.02,0:19:53.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya calon pacarmu tidak bisa melihat.
Dialogue: 0,0:19:54.80,0:19:57.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang bukan begitu!
Dialogue: 0,0:19:57.20,0:19:59.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benaran cinta padanya?
Dialogue: 0,0:20:01.08,0:20:02.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, akan kutembak!
Dialogue: 0,0:20:02.56,0:20:03.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan?
Dialogue: 0,0:20:03.57,0:20:04.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok kapan?
Dialogue: 0,0:20:04.87,0:20:07.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau langsung\Nlatihan saja sekarang?
Dialogue: 0,0:20:07.41,0:20:09.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan merekamnya.
Dialogue: 0,0:20:09.12,0:20:11.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Latihan?
Dialogue: 0,0:20:11.02,0:20:13.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuh, kan, bisanya ngomong doang.
Dialogue: 0,0:20:13.53,0:20:16.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi kasihan sama Koharu.
Dialogue: 0,0:20:19.66,0:20:23.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perhatian!
Dialogue: 0,0:20:26.99,0:20:29.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tidak bisa berhenti.
Dialogue: 0,0:20:30.13,0:20:31.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini!
Dialogue: 0,0:20:31.42,0:20:33.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya pengumuman penting!
Dialogue: 0,0:20:37.08,0:20:39.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku, Sorano Kakeryu...
Dialogue: 0,0:20:39.93,0:20:41.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lidahnya kegigit.
Dialogue: 0,0:20:44.31,0:20:48.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini ungkapan cinta pertamaku,\Ntapi lidahku malah kegigit.
Dialogue: 0,0:20:53.25,0:20:55.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sorano Kakeru...
Dialogue: 0,0:20:56.01,0:20:58.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mencintai...
Dialogue: 0,0:20:59.40,0:21:02.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuyutsuki Koharu!
Dialogue: 0,0:21:02.37,0:21:06.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin berpacaran dengannya!
Dialogue: 0,0:21:15.92,0:21:18.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau sama dia, dong!
Dialogue: 0,0:21:19.99,0:21:21.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah puas?
Dialogue: 0,0:21:25.04,0:21:27.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah mengirimnya ke Koharu.
Dialogue: 0,0:21:28.88,0:21:29.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:21:30.21,0:21:30.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nih.
Dialogue: 0,0:21:35.37,0:21:39.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Video telah dikirim ke Koharu"...
Dialogue: 0,0:21:43.87,0:21:44.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:21:46.16,0:21:47.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius, dong.
Dialogue: 0,0:21:49.20,0:21:50.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius, nih?
Dialogue: 0,0:21:51.62,0:21:53.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti diterima, kok!
Dialogue: 0,0:21:53.11,0:21:55.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aman saja!
Dialogue: 0,0:21:55.88,0:21:59.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku sampai ditolak,\Nsalah kalian berdua, ya!
Dialogue: 0,0:22:04.20,0:22:06.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau gali kuburanku sendiri!
Dialogue: 0,0:22:06.24,0:22:07.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laki banget kamu!
Dialogue: 0,0:22:08.45,0:22:10.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus!
Dialogue: 0,0:22:12.27,0:22:14.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemudian, setelah itu...
Dialogue: 0,0:22:19.52,0:22:21.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beberapa hari berlalu,
Dialogue: 0,0:22:21.24,0:22:24.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi tidak ada balasan dari Fuyutsuki.
