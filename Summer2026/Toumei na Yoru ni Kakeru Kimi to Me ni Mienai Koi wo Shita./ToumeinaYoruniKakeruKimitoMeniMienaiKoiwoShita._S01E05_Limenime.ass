Dialogue: 0,0:00:52.24,0:01:02.83,sign,,0000,0000,0000,,LOVE UNSEEN BENEATH THE CLEAR NIGHT SKY
Dialogue: 0,0:12:08.62,0:12:10.57,sign,,0000,0000,0000,,FESTIVAL RAJA LAUT
Dialogue: 0,0:12:13.50,0:12:17.53,sign,,0000,0000,0000,,KAPAL CUTTER
Dialogue: 0,0:12:17.53,0:12:18.38,sign,,0000,0000,0000,,ACARA UJI COBA
Dialogue: 0,0:22:24.74,0:22:30.00,sign,,0000,0000,0000,,PELUNCURAN KEMBANG API
Dialogue: 0,0:00:01.44,0:00:03.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pulang.
Dialogue: 0,0:00:07.04,0:00:08.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hanya kebiasaan.
Dialogue: 0,0:00:09.49,0:00:12.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyalakan lampu pun\Ntidak memengaruhi penglihatanku.
Dialogue: 0,0:00:13.48,0:00:15.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dengan menyalakan lampu kamar,
Dialogue: 0,0:00:15.75,0:00:18.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membuatku merasa sudah di rumah.
Dialogue: 0,0:00:22.35,0:00:24.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seru banget.
Dialogue: 0,0:00:24.63,0:00:26.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang, Koharu.
Dialogue: 0,0:00:26.87,0:00:28.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu belum makan, bukan?
Dialogue: 0,0:00:29.27,0:00:30.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:02:08.00,0:02:09.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini masak apa?
Dialogue: 0,0:02:10.44,0:02:12.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempura.
Dialogue: 0,0:02:12.07,0:02:13.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asyik!
Dialogue: 0,0:02:15.21,0:02:16.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau langsung makan?
Dialogue: 0,0:02:16.31,0:02:18.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, terima kasih.
Dialogue: 0,0:02:22.25,0:02:25.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga merasa lapar\Nseperti orang biasa,
Dialogue: 0,0:02:25.00,0:02:27.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku kurang suka makan
Dialogue: 0,0:02:27.34,0:02:28.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di hadapan orang lain.
Dialogue: 0,0:02:29.53,0:02:30.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat makan.
Dialogue: 0,0:02:31.56,0:02:33.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati, masih panas.
Dialogue: 0,0:02:33.65,0:02:35.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di depanmu ada piring tempura.
Dialogue: 0,0:02:35.97,0:02:37.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisanya seperti biasa.
Dialogue: 0,0:02:37.72,0:02:38.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:02:45.59,0:02:47.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lezat!
Dialogue: 0,0:02:50.61,0:02:55.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku selalu kepikiran\Nmulutku akan berlepotan.
Dialogue: 0,0:02:57.44,0:02:59.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu makan bersama Kakeru,
Dialogue: 0,0:02:59.61,0:03:02.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sampai deg-degan juga.
Dialogue: 0,0:03:03.39,0:03:06.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya kencanmu lancar, ya?
Dialogue: 0,0:03:06.97,0:03:09.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok tahu itu kencan?
Dialogue: 0,0:03:10.35,0:03:14.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya dandanmu lebih rapi\Ndan gonta-ganti baju terus.
Dialogue: 0,0:03:17.28,0:03:20.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini aku memang lebih niat, sih.
Dialogue: 0,0:03:21.65,0:03:24.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sengaja bangun lebih awal,
Dialogue: 0,0:03:24.35,0:03:25.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mandi,
Dialogue: 0,0:03:25.85,0:03:27.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memilih baju,
Dialogue: 0,0:03:27.23,0:03:29.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lama berdandan
Dialogue: 0,0:03:29.53,0:03:31.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menampilkan versi terbaikku.
Dialogue: 0,0:03:32.31,0:03:34.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak merasa itu merepotkan.
Dialogue: 0,0:03:34.61,0:03:36.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin dilihat Kakeru.
Dialogue: 0,0:03:36.95,0:03:40.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaan itu saja sudah membuatku senang.
Dialogue: 0,0:03:41.67,0:03:43.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Persiapannya saja sudah menyenangkan,
Dialogue: 0,0:03:43.88,0:03:47.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apalagi kalau sudah bertemu Kakeru.
Dialogue: 0,0:03:52.41,0:03:54.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, menyenangkan.
Dialogue: 0,0:03:55.80,0:03:57.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu senyam-senyum, tuh.
Dialogue: 0,0:03:57.52,0:03:59.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, kok.
Dialogue: 0,0:04:02.67,0:04:04.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih makanannya.
Dialogue: 0,0:04:05.50,0:04:08.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kencannya tidak sampai setengah hari,
Dialogue: 0,0:04:08.98,0:04:12.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}waktu yang diluangkan Kakeru untukku,
Dialogue: 0,0:04:12.91,0:04:14.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kebersamaannya,
Dialogue: 0,0:04:15.49,0:04:17.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu membuatku bahagia.
Dialogue: 0,0:04:19.20,0:04:22.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tidak bisa melihat,\Naku punya banyak keinginan.
Dialogue: 0,0:04:23.60,0:04:26.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, orang sekitarku akan berpikir\Nitu merepotkan.
Dialogue: 0,0:04:27.89,0:04:30.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka yang langsung\Njaga jarak setelahnya,
Dialogue: 0,0:04:30.83,0:04:32.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}paling membuatku sedih.
Dialogue: 0,0:04:36.43,0:04:39.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Kakeru berbeda.
Dialogue: 0,0:04:39.84,0:04:41.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mencoba memahamiku.
Dialogue: 0,0:04:43.51,0:04:44.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh.
Dialogue: 0,0:04:46.53,0:04:49.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak perlu menjawab soal ini...
Dialogue: 0,0:04:49.83,0:04:53.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkadang Kakeru berbicara lembut padaku.
Dialogue: 0,0:04:55.16,0:04:58.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terdengar seperti tidak ingin menyakitiku.
Dialogue: 0,0:04:58.83,0:05:00.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kala suaranya begitu.
Dialogue: 0,0:05:01.91,0:05:06.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana rasanya tidak bisa melihat?
Dialogue: 0,0:05:06.58,0:05:08.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa seperti melihat dalam gelap?
Dialogue: 0,0:05:09.44,0:05:11.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng...
Dialogue: 0,0:05:12.69,0:05:15.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu keberatan menjawabnya...
Dialogue: 0,0:05:16.89,0:05:19.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak yang mengira gelap gulita,
Dialogue: 0,0:05:20.09,0:05:21.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku justru sebaliknya.
Dialogue: 0,0:05:21.92,0:05:22.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaliknya?
Dialogue: 0,0:05:23.88,0:05:28.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira seperti berada di tengah kabut\Ntransparan yang agak putih.
Dialogue: 0,0:05:31.95,0:05:35.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakeru sering merespons,\N"Wah..."
Dialogue: 0,0:05:35.48,0:05:38.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu kebiasaannya?\NImut juga.
Dialogue: 0,0:05:38.99,0:05:43.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa itu respons yang sudah dipikirkan\Nbaik-baik sebelum diucapkan.
Dialogue: 0,0:05:43.88,0:05:46.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagian seperti itu yang membuatku suka.
Dialogue: 0,0:05:48.32,0:05:50.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Pasti repot karena tidak bisa melihat."
Dialogue: 0,0:05:51.07,0:05:53.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada saja orang yang bilang begitu.
Dialogue: 0,0:05:55.17,0:05:59.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti memang tidak banyak\Norang yang tidak bisa melihat.
Dialogue: 0,0:06:00.99,0:06:04.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingin kusampaikan bahwa sebenarnya\Naku baik-baik saja, kok.
Dialogue: 0,0:06:07.04,0:06:09.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapalnya agak bergoyang, ya.
Dialogue: 0,0:06:09.80,0:06:13.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di depanmu ada pegangan setinggi pinggang.
Dialogue: 0,0:06:13.51,0:06:14.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pegangan ke situ saja.
Dialogue: 0,0:06:14.85,0:06:15.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:06:22.19,0:06:26.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang syok\Nwaktu pertama kali tidak bisa melihat.
Dialogue: 0,0:06:27.47,0:06:29.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi perlahan mulai terbiasa.
Dialogue: 0,0:06:30.24,0:06:33.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih bisa makan dan mandi juga.
Dialogue: 0,0:06:34.07,0:06:37.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa memakai ponsel juga\Ndan baca buku lewat buku audio.
Dialogue: 0,0:06:39.07,0:06:42.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih bisa berdandan dan mengikuti tren.
Dialogue: 0,0:06:43.29,0:06:47.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena blok pemandu bikin susah jalan,\Naku tidak pilih sepatu hak tipis.
Dialogue: 0,0:06:49.01,0:06:51.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sepatu bot atau sandal masih aman.
Dialogue: 0,0:06:51.96,0:06:53.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata aku hidup cukup normal juga.
Dialogue: 0,0:06:57.41,0:07:00.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih telah menggunakan jasa kami.
Dialogue: 0,0:07:00.44,0:07:02.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapal akan segera diberangkatkan.
Dialogue: 0,0:07:02.76,0:07:04.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pegangan yang kuat, ya.
Dialogue: 0,0:07:05.08,0:07:06.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja!
Dialogue: 0,0:07:06.28,0:07:08.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibilang pegangan!
Dialogue: 0,0:07:11.25,0:07:15.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak yang tidak bisa dilakukan sendiri,\Ntapi pada akhirnya pasti ada jalan.
Dialogue: 0,0:07:16.91,0:07:19.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat tidak bisa,\Naku akan bergantung pada orang lain.
Dialogue: 0,0:07:19.77,0:07:22.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga jadi dapat teman karena itu.
Dialogue: 0,0:07:23.73,0:07:27.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya tidak perlu terlalu\Nmengkhawatirkanku.
Dialogue: 0,0:07:28.69,0:07:30.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anginnya kencang, kamu baik-baik saja?
Dialogue: 0,0:07:31.17,0:07:33.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya dan sejuk rasanya.
Dialogue: 0,0:07:36.08,0:07:37.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di kedua sisi kapal,
Dialogue: 0,0:07:38.43,0:07:41.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di tepi Sungai Sumida,\Nberjejer gedung-gedung tinggi.
Dialogue: 0,0:07:42.53,0:07:43.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:07:44.96,0:07:47.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di pinggir sungai, sesekali ada taman,
Dialogue: 0,0:07:48.33,0:07:50.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terlihat pepohonan hijau.
Dialogue: 0,0:07:52.99,0:07:54.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena mataharinya masih tinggi,
Dialogue: 0,0:07:54.44,0:07:57.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sinarnya memantul di sungai,\Nsampai silau rasanya.
Dialogue: 0,0:07:58.97,0:08:03.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka perhatian kecilnya\Nyang terasa begitu alami.
Dialogue: 0,0:08:07.04,0:08:09.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka hangat tangannya Kakeru.
Dialogue: 0,0:08:10.08,0:08:13.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suka suaranya, suka saat dia\Nmembuatku tertawa.
Dialogue: 0,0:08:14.36,0:08:16.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka sifat baiknya.
Dialogue: 0,0:08:18.39,0:08:19.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:08:19.35,0:08:20.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:08:20.90,0:08:25.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sisi jembatan yang ada di depan\Ntertulis Jembatan Eitai,
Dialogue: 0,0:08:25.04,0:08:27.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi mungkin ini jembatan\Nyang namanya Eitai,
Dialogue: 0,0:08:27.22,0:08:29.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi lebih rendah dibanding jembatan lain.
Dialogue: 0,0:08:29.32,0:08:32.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus jongkok supaya tidak terjedot!
Dialogue: 0,0:08:32.30,0:08:33.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:08:42.85,0:08:43.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:08:44.71,0:08:48.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata tidak serendah itu.\NSama sekali enggak kena.
Dialogue: 0,0:08:48.49,0:08:51.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar kamu ini.
Dialogue: 0,0:08:54.39,0:08:57.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di saat seperti ini,\Nkuharap bisa melihat wajahnya.
Dialogue: 0,0:08:57.81,0:08:59.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekilas aku berpikir begitu.
Dialogue: 0,0:09:00.80,0:09:05.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski bisa melihat wajahnya pun\Naku pasti tetap jatuh cinta.
Dialogue: 0,0:09:06.59,0:09:08.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mencintai Kakeru.
Dialogue: 0,0:09:08.89,0:09:12.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku takut menyatakan cinta ini.
Dialogue: 0,0:09:13.52,0:09:16.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takutnya dia tidak mau dengan\Npenyandang disabilitas.
Dialogue: 0,0:09:17.32,0:09:19.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakeru bukan orang seperti itu.
Dialogue: 0,0:09:19.92,0:09:23.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski aku berpikir begitu,\Naku tetap merasa cemas
Dialogue: 0,0:09:23.46,0:09:25.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan takut.
Dialogue: 0,0:09:29.47,0:09:31.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah sampai Teluk Tokyo belum, ya?
Dialogue: 0,0:09:34.83,0:09:37.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terasa aroma laut, ya.
Dialogue: 0,0:09:37.00,0:09:39.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin sudah mau sampai.
Dialogue: 0,0:09:39.45,0:09:41.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kampusnya belum kelihatan,
Dialogue: 0,0:09:41.89,0:09:44.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin hampir sampai Etchujima...
Dialogue: 0,0:09:49.40,0:09:51.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf tiba-tiba menyentuhmu.
Dialogue: 0,0:09:55.41,0:09:57.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:10:01.19,0:10:03.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sangat menyenangkan!
Dialogue: 0,0:10:09.28,0:10:11.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mataku bisa melihat,
Dialogue: 0,0:10:11.97,0:10:14.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa waktu itu aku bisa\Nbilang cinta padanya?
Dialogue: 0,0:10:16.17,0:10:19.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, pasti masih takut.
Dialogue: 0,0:10:20.63,0:10:25.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ternyata menyatakan cinta\Nsemenakutkan ini.
Dialogue: 0,0:10:29.99,0:10:33.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, senangnya.
Dialogue: 0,0:10:33.11,0:10:35.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang bisa menyadari perasaan ini.
Dialogue: 0,0:10:35.99,0:10:38.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang telah mengenal cinta.
Dialogue: 0,0:10:41.40,0:10:44.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang akan Kakeru pikirkan, ya?
Dialogue: 0,0:10:46.17,0:10:49.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa lebih baik\Naku yang menyatakan cinta saja?
Dialogue: 0,0:10:49.85,0:10:52.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau ditolak?
Dialogue: 0,0:10:52.01,0:10:56.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semenjak bertukar kontak,\Ndia belum pernah menghubungiku duluan juga.
Dialogue: 0,0:11:03.39,0:11:06.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu menyenangkan sekaligus menyesakkan.
Dialogue: 0,0:11:07.45,0:11:09.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dadaku serasa mau meledak.
Dialogue: 0,0:11:10.09,0:11:13.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dipenuhi kegembiraan dan kesedihan.
Dialogue: 0,0:11:14.89,0:11:16.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakeru...
Dialogue: 0,0:11:18.39,0:11:20.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu!
Dialogue: 0,0:11:20.95,0:11:22.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:11:22.17,0:11:24.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu!
Dialogue: 0,0:11:24.45,0:11:25.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:11:25.67,0:11:27.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu!
Dialogue: 0,0:11:27.88,0:11:28.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:11:28.85,0:11:31.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu!
Dialogue: 0,0:11:31.13,0:11:31.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:11:31.89,0:11:33.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Latihan cutter.
Dialogue: 0,0:11:34.23,0:11:37.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya tradisi asrama,\Nkatanya sudah berlangsung seratus tahun,
Dialogue: 0,0:11:37.60,0:11:40.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}katanya dimulai sejak kedatangan Kapal Hitam.
Dialogue: 0,0:11:41.32,0:11:43.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cerita yang sudah dibumbui macam-macam.
Dialogue: 0,0:11:43.88,0:11:47.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Latihan ini wajib diikuti\Nseluruh penghuni asrama.
Dialogue: 0,0:11:48.69,0:11:52.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak pagi buta, penghuni asrama\Nberkumpul di Dermaga Harumi,
Dialogue: 0,0:11:52.11,0:11:55.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}naik kapal kecil bernama cutter,
Dialogue: 0,0:11:55.24,0:11:59.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu mendayung tanpa henti\Nmengikuti aba-aba
Dialogue: 0,0:11:59.17,0:12:01.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai matahari terbit.
Dialogue: 0,0:12:01.49,0:12:03.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu!
Dialogue: 0,0:12:03.68,0:12:04.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:12:04.53,0:12:06.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu!
Dialogue: 0,0:12:06.95,0:12:07.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:12:07.75,0:12:08.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu!
Dialogue: 0,0:12:08.62,0:12:10.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua ini demi acara uji coba
Dialogue: 0,0:12:10.57,0:12:13.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}naik kapal cutter untuk pengunjung,
Dialogue: 0,0:12:13.50,0:12:16.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang diadakan penghuni asrama pada
Dialogue: 0,0:12:16.16,0:12:17.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}festival kampus awal Juni.
Dialogue: 0,0:12:18.81,0:12:20.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cutter itu membawa pengunjung berkeliling
Dialogue: 0,0:12:20.99,0:12:26.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari area laut segitiga yang dikelilingi\NEtchujima, Tsukishima, dan Toyosu,
Dialogue: 0,0:12:26.23,0:12:29.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}melewati bawah Jembatan Harumi,\Nlalu kembali satu putaran penuh.
Dialogue: 0,0:12:29.33,0:12:32.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah satu acara paling populer\Ndi festival kampus.
Dialogue: 0,0:12:32.52,0:12:33.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:12:33.61,0:12:36.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakeru, semangat!
Dialogue: 0,0:12:36.53,0:12:38.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fokus!
Dialogue: 0,0:12:38.89,0:12:40.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa ada mereka berdua?
Dialogue: 0,0:12:40.32,0:12:42.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu!
Dialogue: 0,0:12:42.29,0:12:42.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:12:44.08,0:12:46.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, terlalu belok ke kanan, deh!
Dialogue: 0,0:12:46.31,0:12:48.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sorano! Keluarkan tenagamu!
Dialogue: 0,0:12:48.68,0:12:51.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu yang terlalu kuat, Narumi!
Dialogue: 0,0:12:52.25,0:12:53.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:12:53.13,0:12:55.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu!
Dialogue: 0,0:12:55.65,0:12:58.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuyutsuki, kamu baik-baik saja?\NTidak takut, kan?
Dialogue: 0,0:12:59.49,0:13:01.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat seru, kok!
Dialogue: 0,0:13:02.44,0:13:04.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat, semangat, Kakeru!
Dialogue: 0,0:13:05.19,0:13:07.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat, semangat, Kakeru!
Dialogue: 0,0:13:07.59,0:13:10.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa malah menikmati banget?
Dialogue: 0,0:13:10.92,0:13:15.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aroma laut dan anginnya\Nsangat menyegarkan!
Dialogue: 0,0:13:15.39,0:13:18.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti ini hal yang menyenangkan!
Dialogue: 0,0:13:18.76,0:13:19.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dingin!
Dialogue: 0,0:13:22.12,0:13:22.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:13:22.87,0:13:24.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu!
Dialogue: 0,0:13:24.12,0:13:26.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laut adalah tempatnya pria!
Dialogue: 0,0:13:26.76,0:13:29.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang lebih\Nmembuat semangat dari ini!
Dialogue: 0,0:13:29.43,0:13:31.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu!
Dialogue: 0,0:13:31.62,0:13:32.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:13:32.81,0:13:35.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu!
Dialogue: 0,0:13:35.16,0:13:36.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:13:36.00,0:13:38.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu!
Dialogue: 0,0:13:38.26,0:13:40.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat!
Dialogue: 0,0:13:40.51,0:13:42.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum seberapa!
Dialogue: 0,0:13:42.41,0:13:44.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu!
Dialogue: 0,0:13:44.89,0:13:45.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:13:45.73,0:13:50.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah ini, aku mau berhenti ngampus,\Nlalu bercocok tanam di kampung.
Dialogue: 0,0:13:50.97,0:13:52.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau berhenti?
Dialogue: 0,0:13:52.51,0:13:54.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu, Koharu.
Dialogue: 0,0:13:54.83,0:13:57.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan termakan bercandaannya.
Dialogue: 0,0:13:57.98,0:13:58.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:13:58.73,0:14:01.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu!
Dialogue: 0,0:14:01.36,0:14:02.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:14:02.19,0:14:04.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu!
Dialogue: 0,0:14:04.76,0:14:05.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:14:05.21,0:14:07.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hayase, kamu baik-baik saja?
Dialogue: 0,0:14:07.62,0:14:10.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Enggak kedengaran!
Dialogue: 0,0:14:11.92,0:14:13.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?
Dialogue: 0,0:14:14.12,0:14:15.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:14:15.25,0:14:17.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu!
Dialogue: 0,0:14:17.38,0:14:20.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?
Dialogue: 0,0:14:20.26,0:14:22.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak baik-baik saja!
Dialogue: 0,0:14:22.56,0:14:27.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior, ada yang mabuk laut,\Nayo pelan-pelan saja!
Dialogue: 0,0:14:28.39,0:14:30.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Angkat dayung!
Dialogue: 0,0:14:35.96,0:14:37.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian baik sekali.
Dialogue: 0,0:14:37.81,0:14:40.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, kami keasyikan sendiri.
Dialogue: 0,0:14:45.17,0:14:46.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sudah tahu?
Dialogue: 0,0:14:46.75,0:14:50.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setiap penutupan festival kampus,\Nkatanya ada kembang api luncur.
Dialogue: 0,0:14:51.20,0:14:53.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, Sorano.
Dialogue: 0,0:14:53.52,0:14:56.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bertugas jadi panitia festival kampus,
Dialogue: 0,0:14:56.03,0:14:59.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku ingin kamu menemani Koharu.
Dialogue: 0,0:14:59.50,0:15:02.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ada sif malam.
Dialogue: 0,0:15:03.11,0:15:08.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah mendayung kapal cutter neraka ini,\Ndia masih ada kerja sambilan?
Dialogue: 0,0:15:08.48,0:15:11.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya enggak ada kata capek buat dia.
Dialogue: 0,0:15:12.45,0:15:13.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh saja.
Dialogue: 0,0:15:14.29,0:15:16.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menemaninya.\NKetemuan di mana?
Dialogue: 0,0:15:17.44,0:15:20.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuyutsuki, nanti tunggu saja\Ndi teras seperti biasa.
Dialogue: 0,0:15:20.68,0:15:21.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:15:23.21,0:15:26.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita belum menyalakan kembang api\Nyang kemarin beli juga.
Dialogue: 0,0:15:26.72,0:15:28.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:15:29.14,0:15:31.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tahu akan diluncurkan saat festival,
Dialogue: 0,0:15:31.85,0:15:34.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak perlu beli sebanyak itu.
Dialogue: 0,0:15:35.23,0:15:36.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar.
Dialogue: 0,0:15:37.25,0:15:41.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah, kamu jadi bisa kencan\Nsama Koharu, kan?
Dialogue: 0,0:15:41.04,0:15:44.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan dia mandi dulu sebelum berangkat.
Dialogue: 0,0:15:44.20,0:15:45.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Niat banget.
Dialogue: 0,0:15:45.56,0:15:47.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koharu, kamu harus hati-hati.
Dialogue: 0,0:15:47.72,0:15:50.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mengejekku terus!
Dialogue: 0,0:15:54.45,0:15:57.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pada ketawa, dong!
Dialogue: 0,0:16:03.09,0:16:06.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara kelamaan di atas air,
Dialogue: 0,0:16:06.24,0:16:09.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tanahnya jadi bergoyang\Ndan bikin susah jalan.
Dialogue: 0,0:16:11.22,0:16:13.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanganku sampai gemetar dan kapalan.
Dialogue: 0,0:16:14.45,0:16:17.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pinggangku sakit kayak mau patah.
Dialogue: 0,0:16:18.07,0:16:20.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal sebabak belur ini...
Dialogue: 0,0:16:20.75,0:16:24.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketika memikirkan akan bertemu Fuyutsuki,
Dialogue: 0,0:16:24.35,0:16:26.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hatiku riang gembira.
Dialogue: 0,0:16:27.35,0:16:29.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kapan begini, ya?
Dialogue: 0,0:16:29.80,0:16:31.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa merasa sebahagia ini.
Dialogue: 0,0:16:47.55,0:16:49.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, kamu menunggu lama?
Dialogue: 0,0:16:49.92,0:16:52.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak menunggu lama, kok.
Dialogue: 0,0:16:53.69,0:16:54.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau tambah?
Dialogue: 0,0:16:54.85,0:16:57.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah, tidak apa-apa.
Dialogue: 0,0:16:57.62,0:17:00.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat!
Dialogue: 0,0:17:00.50,0:17:03.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri tepuk tangan meriah!
Dialogue: 0,0:17:07.56,0:17:08.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakeru?
Dialogue: 0,0:17:08.83,0:17:09.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:17:10.55,0:17:13.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kira kamu pergi.
Dialogue: 0,0:17:13.97,0:17:16.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya aku menghapus hawa kehadiranku.
Dialogue: 0,0:17:17.01,0:17:18.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar jail.
Dialogue: 0,0:17:22.48,0:17:27.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma mendengar suara Hayase\Nsebagai pewara dari panggung.
Dialogue: 0,0:17:27.77,0:17:31.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya mustahil aku bisa ikutan\Njadi panitia seperti dia.
Dialogue: 0,0:17:31.71,0:17:33.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panutan banget.
Dialogue: 0,0:17:33.85,0:17:35.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:17:36.74,0:17:39.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terakhirnya ada kontes yukata, kan?
Dialogue: 0,0:17:39.69,0:17:42.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sisanya tinggal kembang api.
Dialogue: 0,0:17:45.61,0:17:48.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi ingin pakai yukata.
Dialogue: 0,0:17:48.76,0:17:52.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yukata punya Sultan Fuyutsuki,\Nkayaknya mahal banget.
Dialogue: 0,0:17:53.37,0:17:58.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu ibuku punya yukata dengan\Nobi motif bunga bakung.
Dialogue: 0,0:17:58.43,0:18:00.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu ingin memakainya.
Dialogue: 0,0:18:00.67,0:18:03.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tidak ikut kontes yukata saja?
Dialogue: 0,0:18:04.40,0:18:06.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku?
Dialogue: 0,0:18:06.93,0:18:09.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin kamu juara satu.
Dialogue: 0,0:18:14.51,0:18:19.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku ikut kontes yukata,\Nkamu akan memilihku?
Dialogue: 0,0:18:19.13,0:18:20.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas...
Dialogue: 0,0:18:20.35,0:18:22.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong pikirkan baik-baik.
Dialogue: 0,0:18:25.73,0:18:28.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas aku akan memilihmu.
Dialogue: 0,0:18:29.17,0:18:32.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski aku tidak bisa melihat?
Dialogue: 0,0:18:32.03,0:18:33.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu...
Dialogue: 0,0:18:33.26,0:18:36.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tetap akan memilihku?
Dialogue: 0,0:18:38.04,0:18:41.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang ada hubungannya bisa melihat\Natau tidak di kontes yukata?
Dialogue: 0,0:18:42.49,0:18:44.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil tidak ada hubungannya.
Dialogue: 0,0:18:44.71,0:18:46.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang pasti ada\Nsedikit pikiran itu.
Dialogue: 0,0:18:47.63,0:18:50.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil akan dianggap\Ntidak ada apa-apa.
Dialogue: 0,0:18:51.89,0:18:53.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu...
Dialogue: 0,0:18:55.04,0:18:57.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, terlepas dari semua itu,
Dialogue: 0,0:18:57.24,0:18:59.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tetap akan memilihmu.
Dialogue: 0,0:19:02.91,0:19:05.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu terdengar
Dialogue: 0,0:19:06.13,0:19:08.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seperti pernyataan cinta.
Dialogue: 0,0:19:10.00,0:19:13.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukan, maksudnya karena\Npenampilanmu bagus!
Dialogue: 0,0:19:13.87,0:19:14.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penampilanku?
Dialogue: 0,0:19:14.73,0:19:16.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, bukan, bukan!
Dialogue: 0,0:19:16.36,0:19:20.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku, kamu kelihatan cocok\Ndan terbiasa memakai yukata.
Dialogue: 0,0:19:20.72,0:19:23.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya coba?
Dialogue: 0,0:19:26.69,0:19:28.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini cinta...
Dialogue: 0,0:19:28.36,0:19:29.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:19:30.11,0:19:33.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maksudku, kamu cinta mati\Nsama kembang api, ya?
Dialogue: 0,0:19:33.36,0:19:36.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena bahas kembang api melulu.
Dialogue: 0,0:19:39.43,0:19:42.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa meluncurkan\Nkembang api sendiri,
Dialogue: 0,0:19:42.29,0:19:44.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rasanya akan menyenangkan.
Dialogue: 0,0:19:45.80,0:19:48.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan menjadi hari spesial juga.
Dialogue: 0,0:19:48.88,0:19:51.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kenangan seumur hidup.
Dialogue: 0,0:19:53.52,0:19:55.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembelian impulsif kembang api kemarin,
Dialogue: 0,0:19:55.89,0:19:58.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti berat, ya?
Dialogue: 0,0:19:58.36,0:20:02.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kembang apinya ada di pojokan\Ndan lagi cemberut.
Dialogue: 0,0:20:03.81,0:20:07.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada kembang api di festival kampus,\Nharusnya kasih tahu dari awal.
Dialogue: 0,0:20:07.09,0:20:08.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari kapan?
Dialogue: 0,0:20:09.53,0:20:11.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pas upacara penerimaan mahasiswa baru?
Dialogue: 0,0:20:12.45,0:20:15.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Selamat datang mahasiswa baru.
Dialogue: 0,0:20:15.20,0:20:17.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski masih agak lama,
Dialogue: 0,0:20:17.85,0:20:20.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pas festival akan ada kembang api, ya."
Dialogue: 0,0:20:20.55,0:20:21.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu?
Dialogue: 0,0:20:21.74,0:20:23.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ih!
Dialogue: 0,0:20:28.71,0:20:32.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuacanya kurang bersahabat, ya.
Dialogue: 0,0:20:32.67,0:20:35.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anginnya juga makin kencang.
Dialogue: 0,0:20:36.48,0:20:38.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, saatnya pengumuman!
Dialogue: 0,0:20:38.65,0:20:42.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Juara pertama kontes yukata\Nkali ini jatuh kepada...
Dialogue: 0,0:20:42.39,0:20:45.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mahasiswi tahun kedua\NTeknik Sistem Perkapalan,
Dialogue: 0,0:20:45.01,0:20:46.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Funayama Shiori!
Dialogue: 0,0:20:46.67,0:20:49.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Besok suara Yuko pasti serak.\N- Selamat!
Dialogue: 0,0:20:49.48,0:20:51.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sudah berjuang keras, ya.
Dialogue: 0,0:20:53.86,0:20:55.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:20:59.24,0:21:00.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aroma hujan.
Dialogue: 0,0:21:07.53,0:21:11.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas partisipasinya!
Dialogue: 0,0:21:12.04,0:21:14.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepada para pengunjung,\Nkami sampaikan pengumuman.
Dialogue: 0,0:21:15.69,0:21:20.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peluncuran kembang api hari ini\Ndibatalkan karena hujan.
Dialogue: 0,0:21:21.64,0:21:23.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami ulangi.
Dialogue: 0,0:21:23.26,0:21:26.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepada para pengunjung,\Nkami sampaikan pengumuman.
Dialogue: 0,0:21:27.37,0:21:30.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya tidak akan reda.
Dialogue: 0,0:21:30.17,0:21:31.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kedinginan?
Dialogue: 0,0:21:31.99,0:21:33.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak apa-apa...
Dialogue: 0,0:21:37.08,0:21:41.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus segera mengantar\NFuyutsuki yang kehujanan,
Dialogue: 0,0:21:42.11,0:21:46.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku ingin bersamanya\Nlebih lama lagi.
Dialogue: 0,0:21:51.24,0:21:52.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita ke asrama dulu.
Dialogue: 0,0:22:01.41,0:22:02.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti masuk angin.
Dialogue: 0,0:22:02.84,0:22:04.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:22:05.60,0:22:07.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh kugenggam tanganmu?
Dialogue: 0,0:22:08.87,0:22:12.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena tidak bawa payung,\Ntakut terpeleset juga.
Dialogue: 0,0:22:12.08,0:22:13.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh.
