Dialogue: 0,0:00:16.25,0:00:26.80,sign,,0000,0000,0000,,LOVE UNSEEN BENEATH THE CLEAR NIGHT SKY
Dialogue: 0,0:02:40.72,0:02:44.48,sign,,0000,0000,0000,,PENGEMBALIAN
Dialogue: 0,0:02:44.48,0:02:47.23,sign,,0000,0000,0000,,TANPA GULA, DENGAN GULA
Dialogue: 0,0:09:11.80,0:09:13.74,sign,,0000,0000,0000,,26 SEPTEMBER PUKUL 18.00 - 19.00
Dialogue: 0,0:09:13.74,0:09:14.78,sign,,0000,0000,0000,,KEMBANG API ANAK-ANAK PERTAMA\NDI LAPANGAN RUMPUT KAMPUS
Dialogue: 0,0:09:14.78,0:09:16.99,sign,,0000,0000,0000,,KEMBANG API ANAK-ANAK PERTAMA
Dialogue: 0,0:09:28.76,0:09:32.01,sign,,0000,0000,0000,,ASOSIASI MEDIS SEIROUKAI
Dialogue: 0,0:11:27.17,0:11:30.42,sign,,0000,0000,0000,,KOPI BRAZIL
Dialogue: 0,0:12:21.80,0:12:24.06,sign,,0000,0000,0000,,KLUB PENELITIAN KEMBANG API
Dialogue: 0,0:12:50.87,0:12:53.13,sign,,0000,0000,0000,,AIR
Dialogue: 0,0:15:50.60,0:15:52.10,sign,,0000,0000,0000,,SYUKURLAH
Dialogue: 0,0:15:52.10,0:15:53.22,sign,,0000,0000,0000,,KALAU FUYUTSUKI SUDAH BANGUN...
Dialogue: 0,0:17:27.81,0:17:29.01,sign,,0000,0000,0000,,BERBAGI LAYAR, EFEK,\NMATIKAN KAMERA, MATIKAN MIKROFON
Dialogue: 0,0:22:24.82,0:22:30.00,sign,,0000,0000,0000,,SORANO KAKERU
Dialogue: 0,0:01:34.14,0:01:36.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak larangan besuk dicabut,
Dialogue: 0,0:01:36.83,0:01:39.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku menjenguknya tiap hari.
Dialogue: 0,0:01:44.24,0:01:45.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan.
Dialogue: 0,0:01:46.70,0:01:48.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Sorano.
Dialogue: 0,0:01:48.22,0:01:50.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas bantuannya.
Dialogue: 0,0:01:50.82,0:01:52.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo jalan lagi hari ini.
Dialogue: 0,0:01:52.93,0:01:53.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:01:55.23,0:01:57.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kankernya mengecil,
Dialogue: 0,0:01:57.60,0:02:01.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan Fuyutsuki sedang aktif\Nmemulihkan staminanya.
Dialogue: 0,0:02:06.24,0:02:09.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa bicara pun,\Nperasaannya terasa lewat lengan.
Dialogue: 0,0:02:11.00,0:02:15.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketika kakinya tidak kuat menumpu,\Ntangannya menggenggam erat.
Dialogue: 0,0:02:15.37,0:02:18.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat mampu melangkah sendiri,\Ngenggamannya melemah.
Dialogue: 0,0:02:19.92,0:02:25.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyesuaikan kondisinya,\Nsebisa mungkin kami jalan santai tiap hari.
Dialogue: 0,0:02:27.71,0:02:29.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip, sudah sampai.
Dialogue: 0,0:02:30.22,0:02:31.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau minum apa?
Dialogue: 0,0:02:31.47,0:02:33.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa beli sendiri.
Dialogue: 0,0:02:33.01,0:02:35.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya juga mesin punya sendiri.
Dialogue: 0,0:02:35.34,0:02:37.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, dong.
Dialogue: 0,0:02:50.70,0:02:54.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mengingat tombol\Nteh susu dan gulanya.
Dialogue: 0,0:02:55.42,0:02:59.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski hilang ingatan,\Nseleranya tetap sama
Dialogue: 0,0:03:06.02,0:03:07.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak?
Dialogue: 0,0:03:08.40,0:03:11.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teh susu manis memang terbaik.
Dialogue: 0,0:03:12.21,0:03:13.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awas gigimu berlubang.
Dialogue: 0,0:03:14.80,0:03:18.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seumur hidup,\Ngigiku belum pernah berlubang.
Dialogue: 0,0:03:19.38,0:03:22.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar kalau mulutmu bebas\Nbakteri gigi berlubang.
Dialogue: 0,0:03:23.46,0:03:26.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi katanya bisa menular lewat ciuman.
Dialogue: 0,0:03:26.59,0:03:28.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:03:28.80,0:03:32.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, harus membulatkan tekad\Nuntuk berciuman, ya?
Dialogue: 0,0:03:37.38,0:03:38.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa hari itu
Dialogue: 0,0:03:38.99,0:03:43.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia membulatkan tekad\Nuntuk menciumku juga?
Dialogue: 0,0:03:45.76,0:03:50.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian percuma juga bertanya,\Nkarena dia hilang ingatan.
Dialogue: 0,0:03:57.86,0:03:59.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sorano?
Dialogue: 0,0:03:59.39,0:04:00.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:04:00.75,0:04:03.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kira kamu pergi.
Dialogue: 0,0:04:04.47,0:04:06.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya aku menghapus hawa kehadiranku.
Dialogue: 0,0:04:07.25,0:04:09.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar jail.
Dialogue: 0,0:04:11.07,0:04:14.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuharap momen ini berlangsung selamanya.
Dialogue: 0,0:04:21.08,0:04:23.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah aku terlalu merepotkan?
Dialogue: 0,0:04:23.95,0:04:27.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah tidak bisa melihat,\Ntubuhku juga melemah.
Dialogue: 0,0:04:27.73,0:04:32.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih baik luangkan waktumu\Nuntuk orang normal dan sehat.
Dialogue: 0,0:04:32.26,0:04:33.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:04:36.86,0:04:39.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kankernya mengecil,
Dialogue: 0,0:04:39.66,0:04:42.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada kemungkinan pindah ke bagian lain.
Dialogue: 0,0:04:46.19,0:04:47.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik...
Dialogue: 0,0:04:47.36,0:04:48.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bohong.
Dialogue: 0,0:04:49.79,0:04:53.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bohong, tapi bohong, tapi bohong...
Dialogue: 0,0:04:55.04,0:04:58.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bertekad bertahan\Nsampai kembang api nanti,
Dialogue: 0,0:04:58.13,0:05:01.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi malah jadi suram begini,\Njadi kutarik kata-kataku.
Dialogue: 0,0:05:01.49,0:05:03.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan memaksakan...
Dialogue: 0,0:05:03.49,0:05:05.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dokter bilang
Dialogue: 0,0:05:06.13,0:05:09.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kanker itu takut sama senyuman.
Dialogue: 0,0:05:10.27,0:05:12.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi aku harus tersenyum.
Dialogue: 0,0:05:12.22,0:05:15.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kondisiku sudah membaik,\Nkita bisa terapi jalan lagi.
Dialogue: 0,0:05:19.17,0:05:22.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuharap aku bisa mengatakan\Nsemoga lekas sembuh
Dialogue: 0,0:05:23.07,0:05:24.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau semua akan baik-baik saja.
Dialogue: 0,0:05:27.92,0:05:31.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oktober nanti aku akan dipindahkan\Nke rumah sakit di Hokkaido.
Dialogue: 0,0:05:31.95,0:05:32.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:05:34.40,0:05:37.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya aku masih ragu\Nmau pindah atau tidak,
Dialogue: 0,0:05:37.36,0:05:42.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi rumah sakit rekanan di Hokkaido\Npunya alat terapi sinar proton.
Dialogue: 0,0:05:43.73,0:05:46.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ditawari ke sana,
Dialogue: 0,0:05:47.62,0:05:49.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi
Dialogue: 0,0:05:54.59,0:05:56.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}katanya baru bisa
Dialogue: 0,0:05:56.70,0:06:01.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau obatnya berhasil mengecilkan\Nkankerku dulu sebelum pergi.
Dialogue: 0,0:06:01.55,0:06:03.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mendukungnya.
Dialogue: 0,0:06:06.06,0:06:09.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tolong jangan mengejarku\Nsampai Hokkaido, ya.
Dialogue: 0,0:06:12.27,0:06:15.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari kembang apinya sudah ditentukan.
Dialogue: 0,0:06:16.32,0:06:17.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan?
Dialogue: 0,0:06:17.87,0:06:20.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sabtu keempat bulan September.
Dialogue: 0,0:06:20.77,0:06:22.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo terus semangat sampai hari itu.
Dialogue: 0,0:06:23.25,0:06:25.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita usir kankernya.
Dialogue: 0,0:06:28.32,0:06:29.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku usahakan.
Dialogue: 0,0:06:32.18,0:06:33.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya permintaan.
Dialogue: 0,0:06:33.86,0:06:34.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh.
Dialogue: 0,0:06:34.77,0:06:35.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:06:35.67,0:06:36.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:06:37.79,0:06:41.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum bilang permintaannya.
Dialogue: 0,0:06:41.82,0:06:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuai kemampuanku, kan?
Dialogue: 0,0:06:43.78,0:06:45.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun akan kulakukan.
Dialogue: 0,0:06:53.84,0:06:55.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong bacakan buku untukku.
Dialogue: 0,0:06:56.42,0:06:58.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa baca tulisan braille.
Dialogue: 0,0:06:58.22,0:06:59.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belajar dari sekarang.
Dialogue: 0,0:06:59.86,0:07:01.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ngawur.
Dialogue: 0,0:07:05.70,0:07:08.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buku Harian Anne, kan?\NNanti kucarikan.
Dialogue: 0,0:07:10.51,0:07:12.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:07:15.33,0:07:20.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak saat itu, membacakan buku\Nmenjadi rutinitasku.
Dialogue: 0,0:07:34.30,0:07:37.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini pun cuacanya panas banget.
Dialogue: 0,0:07:37.47,0:07:40.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sorano, suaramu terdengar serak,
Dialogue: 0,0:07:40.93,0:07:42.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kena flu musim panas?
Dialogue: 0,0:07:44.00,0:07:46.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih ke membacakan buku tiap hari, sih.
Dialogue: 0,0:07:52.98,0:07:55.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenangkan dirimu,\Nsemua akan baik-baik saja.
Dialogue: 0,0:07:59.22,0:08:04.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu, Fuyutsuki masuk\NICU selama dua minggu.
Dialogue: 0,0:08:04.26,0:08:07.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa sadar, sudah memasuki September.
Dialogue: 0,0:08:12.42,0:08:14.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seribu bangau kertas ini...
Dialogue: 0,0:08:14.39,0:08:17.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibuku yang memajangnya.
Dialogue: 0,0:08:17.26,0:08:19.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya dari Narumi.
Dialogue: 0,0:08:19.84,0:08:22.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya dia terus membuatnya di kapal.
Dialogue: 0,0:08:22.69,0:08:24.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:08:24.46,0:08:27.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teman jurusannya juga ikut membantu.
Dialogue: 0,0:08:28.40,0:08:30.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata Fuyutsuki
Dialogue: 0,0:08:30.28,0:08:32.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lumayan terkenal di kampus.
Dialogue: 0,0:08:33.57,0:08:36.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dijuluki bidadari teras
Dialogue: 0,0:08:36.50,0:08:38.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai cewek jelita yang riang.
Dialogue: 0,0:08:40.40,0:08:45.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar dia dirawat, semua orang yang kenal\Nlangsung mendoakan kesembuhannya.
Dialogue: 0,0:08:46.50,0:08:48.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sorano.
Dialogue: 0,0:08:48.62,0:08:49.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:08:49.71,0:08:51.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ujian semester ganjilmu?
Dialogue: 0,0:08:52.83,0:08:56.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, aku berhasil melewatinya.
Dialogue: 0,0:08:56.05,0:08:57.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa?
Dialogue: 0,0:08:58.80,0:09:04.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski bilang begitu, beberapa mata kuliah\Npilihanku tetap mengulang.
Dialogue: 0,0:09:05.25,0:09:08.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja, nilai bisa diurus nanti.
Dialogue: 0,0:09:09.60,0:09:11.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang terpenting
Dialogue: 0,0:09:11.80,0:09:13.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sekarang adalah Fuyutsuki.
Dialogue: 0,0:09:21.89,0:09:23.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat siang.
Dialogue: 0,0:09:23.31,0:09:26.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sorano, mohon bantuannya untuk hari ini.
Dialogue: 0,0:09:26.80,0:09:28.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon bantuannya juga.
Dialogue: 0,0:09:29.23,0:09:31.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku meminjam kursi roda.
Dialogue: 0,0:09:33.54,0:09:34.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:09:35.31,0:09:39.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sorano, bisa antar Koharu ke taman?
Dialogue: 0,0:09:39.20,0:09:40.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu!
Dialogue: 0,0:09:40.43,0:09:43.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya kenapa?\NSekalian kencan.
Dialogue: 0,0:09:43.30,0:09:45.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu...
Dialogue: 0,0:09:46.96,0:09:49.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu terlalu menyangkalnya.
Dialogue: 0,0:09:51.23,0:09:53.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh minta tolong dorongkan?
Dialogue: 0,0:09:54.40,0:09:55.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh.
Dialogue: 0,0:10:05.38,0:10:08.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hatiku terenyuh\Nmenyadari betapa ringannya dia.
Dialogue: 0,0:10:10.70,0:10:12.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia sampai tahu perasaanku,
Dialogue: 0,0:10:12.32,0:10:15.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu hanya akan menyakiti Fuyutsuki\Nyang sudah berjuang keras.
Dialogue: 0,0:10:17.39,0:10:20.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus bersikap seperti biasa.
Dialogue: 0,0:10:22.32,0:10:24.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau beli minuman dulu?
Dialogue: 0,0:10:24.30,0:10:26.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin minum teh susu...
Dialogue: 0,0:10:28.37,0:10:30.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak kuat, biar kuhabiskan.
Dialogue: 0,0:10:31.59,0:10:34.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terlalu memanjakanku.
Dialogue: 0,0:10:34.95,0:10:37.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memanjakanmu bagaimana?
Dialogue: 0,0:10:40.43,0:10:42.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan apa-apa.
Dialogue: 0,0:10:44.08,0:10:45.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, silakan.
Dialogue: 0,0:10:46.81,0:10:48.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:10:53.53,0:10:55.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini kamu terlihat semangat.
Dialogue: 0,0:10:57.81,0:10:59.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku sudah bertekad.
Dialogue: 0,0:10:59.84,0:11:01.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadinya bisa semangat.
Dialogue: 0,0:11:02.02,0:11:04.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini bukan tujuan utamanya.
Dialogue: 0,0:11:04.02,0:11:05.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:11:05.44,0:11:09.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya tujuan kita kembang api hari ini?
Dialogue: 0,0:11:09.82,0:11:12.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu baru setengah jalan.
Dialogue: 0,0:11:13.63,0:11:15.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Curang.
Dialogue: 0,0:11:16.58,0:11:18.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pindah rumah sakit\Nuntuk sembuh, kan?
Dialogue: 0,0:11:21.87,0:11:23.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanganmu...
Dialogue: 0,0:11:24.37,0:11:26.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa genggam tanganku?
Dialogue: 0,0:11:34.43,0:11:36.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hangat...
Dialogue: 0,0:11:36.53,0:11:39.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan perlakukan tanganku sebagai\Nminuman hangat, dong.
Dialogue: 0,0:11:40.78,0:11:42.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minuman hangat?
Dialogue: 0,0:11:42.37,0:11:46.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bikin aku ketawa, dong,\Nsakitnya jadi terasa, nih.
Dialogue: 0,0:11:47.02,0:11:48.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, maaf.
Dialogue: 0,0:11:49.66,0:11:53.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus berterima kasih padamu.
Dialogue: 0,0:11:54.48,0:11:58.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang aku merasa\Ntidak boleh kalah sama penyakit.
Dialogue: 0,0:12:00.82,0:12:03.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai penyakitnya bisa hilang.
Dialogue: 0,0:12:03.68,0:12:09.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya ingin perjuangan Fuyutsuki\Nterbalas di masa depan.
Dialogue: 0,0:12:11.65,0:12:14.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau ke kampus dulu\Nuntuk menyiapkan kembang api.
Dialogue: 0,0:12:14.94,0:12:17.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sore aku ke sini lagi.
Dialogue: 0,0:12:17.12,0:12:18.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:12:24.78,0:12:26.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana perkembangannya?
Dialogue: 0,0:12:26.58,0:12:28.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lancar.
Dialogue: 0,0:12:32.05,0:12:33.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kondisi Fuyutsuki?
Dialogue: 0,0:12:33.87,0:12:35.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia baik-baik saja.
Dialogue: 0,0:12:36.21,0:12:39.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah dapat izin keluar hari ini?
Dialogue: 0,0:12:39.07,0:12:40.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi dibicarakan dengan dokternya.
Dialogue: 0,0:12:41.50,0:12:43.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya bisa dapat izin.
Dialogue: 0,0:12:44.35,0:12:45.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:12:48.35,0:12:50.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau beli sesuatu dulu.
Dialogue: 0,0:12:53.65,0:12:57.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti aku mau ke rumah sakit\Nuntuk menjelaskan ke orang tua anak-anak,
Dialogue: 0,0:12:57.94,0:13:00.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu memandu mereka ke lokasi acara.
Dialogue: 0,0:13:00.48,0:13:03.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa banyak anak yang bisa ikut?
Dialogue: 0,0:13:04.70,0:13:08.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau yang dapat izin keluar,\Ncuma sekitar separuhnya.
Dialogue: 0,0:13:09.34,0:13:12.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kasihan sama yang tidak bisa ikut.
Dialogue: 0,0:13:12.14,0:13:15.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Solusinya sudah ada, kok.
Dialogue: 0,0:13:15.92,0:13:17.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga acaranya sukses.
Dialogue: 0,0:13:18.42,0:13:21.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga Fuyutsuki bisa ingat lagi\Nsetelah melihat kembang api.
Dialogue: 0,0:13:21.97,0:13:23.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah...
Dialogue: 0,0:13:23.70,0:13:25.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terlalu memikirkan soal itu.
Dialogue: 0,0:13:32.61,0:13:35.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjelaskan lokasi\NKembang Api Anak-Anak.
Dialogue: 0,0:13:36.50,0:13:41.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang naik taksi,\Nturun di sini agar lebih dekat.
Dialogue: 0,0:13:41.72,0:13:44.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti cek peta ini, ya.
Dialogue: 0,0:13:47.60,0:13:50.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuyutsuki, Anda sadar?\NBisa genggam tangan saya?
Dialogue: 0,0:13:50.68,0:13:53.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuyutsuki, bisa dengar saya?\NFuyutsuki.
Dialogue: 0,0:13:53.87,0:13:55.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Perasaanku tidak enak.\N- Dia hilang kesadaran.
Dialogue: 0,0:13:55.81,0:13:56.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Persiapan selesai.
Dialogue: 0,0:13:56.92,0:13:58.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Perasaanku makin tidak enak.\N- Saya buka mulutnya, ya.
Dialogue: 0,0:13:58.72,0:14:00.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuyutsuki, saya bersihkan saluran napasnya.
Dialogue: 0,0:14:00.93,0:14:02.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alat penyedot sudah siap.
Dialogue: 0,0:14:02.56,0:14:04.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya aktifkan alatnya, ya.
Dialogue: 0,0:14:04.75,0:14:06.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuyutsuki!
Dialogue: 0,0:14:06.20,0:14:08.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu, jangan masuk dulu!
Dialogue: 0,0:14:12.78,0:14:17.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil, ini tidak mungkin...
Dialogue: 0,0:14:17.78,0:14:19.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Narumi...
Dialogue: 0,0:14:20.27,0:14:23.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus menghubungi Hayase...
Dialogue: 0,0:14:39.71,0:14:42.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Fuyutsuki baik-baik saja?
Dialogue: 0,0:14:42.90,0:14:46.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf membuatmu khawatir, Sorano.
Dialogue: 0,0:14:46.67,0:14:49.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia hanya muntah darah sedikit.
Dialogue: 0,0:14:50.00,0:14:54.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Darahnya masuk saluran napas,\Njadi sempat sesak.
Dialogue: 0,0:14:54.02,0:14:56.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang sudah tidak apa-apa.
Dialogue: 0,0:14:56.11,0:14:57.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Muntah darah...
Dialogue: 0,0:14:58.58,0:15:00.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ada permintaan.
Dialogue: 0,0:15:01.68,0:15:02.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:15:03.57,0:15:04.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku
Dialogue: 0,0:15:06.45,0:15:08.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sedikit kelelahan.
Dialogue: 0,0:15:09.90,0:15:12.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jaga dia di sampingnya.
Dialogue: 0,0:15:12.88,0:15:16.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, Ibu istirahat saja.
Dialogue: 0,0:15:26.64,0:15:27.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia masih hidup.
Dialogue: 0,0:15:28.66,0:15:30.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sadar bahwa hal itu saja\Nsudah melegakan,
Dialogue: 0,0:15:31.79,0:15:34.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}betapa beratnya cinta yang kujalani ini.
Dialogue: 0,0:15:36.42,0:15:40.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkali-kali hampir menyerah,\Nmemaksakan diri bertahan.
Dialogue: 0,0:15:40.71,0:15:45.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi senyum Fuyutsuki selalu berhasil\Nmemikat hatiku kembali.
Dialogue: 0,0:16:06.93,0:16:08.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sorano?
Dialogue: 0,0:16:09.97,0:16:11.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasakan hawa kehadiranmu.
Dialogue: 0,0:16:14.03,0:16:16.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu berhasil mendeteksi hawa kehadiranku.
Dialogue: 0,0:16:16.72,0:16:19.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kita sudah sering bersama.
Dialogue: 0,0:16:20.83,0:16:22.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang jam berapa?
Dialogue: 0,0:16:22.90,0:16:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jam 17.50.
Dialogue: 0,0:16:25.20,0:16:28.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembang apinya kelewat, ya.
Dialogue: 0,0:16:28.02,0:16:30.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini kamu dilarang keluar.
Dialogue: 0,0:16:30.27,0:16:32.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah...
Dialogue: 0,0:16:39.25,0:16:41.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku sudah berjuang...
Dialogue: 0,0:16:45.98,0:16:48.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malangnya diriku...
Dialogue: 0,0:16:51.54,0:16:52.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:16:52.99,0:16:55.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apanya yang tidak apa-apa?
Dialogue: 0,0:16:55.70,0:16:58.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya sudah terlambat!
Dialogue: 0,0:17:00.11,0:17:02.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku sudah berjuang...
Dialogue: 0,0:17:03.52,0:17:07.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah berjuang keras bertahan hidup...
Dialogue: 0,0:17:08.91,0:17:11.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja, masih sempat.
Dialogue: 0,0:17:14.67,0:17:16.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:17:22.48,0:17:25.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kurang meriah...
Dialogue: 0,0:17:29.01,0:17:31.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koharu, kamu baik-baik saja?
Dialogue: 0,0:17:33.33,0:17:37.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita nonton bareng\Nlewat panggilan video.
Dialogue: 0,0:17:39.22,0:17:41.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga di sini.
Dialogue: 0,0:17:41.63,0:17:44.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan tayangkan kembang apinya\Ndi layar besar,
Dialogue: 0,0:17:44.80,0:17:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar anak-anak\Nyang tidak bisa keluar bisa nonton.
Dialogue: 0,0:17:47.04,0:17:49.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak pianis, semangat!
Dialogue: 0,0:17:49.82,0:17:51.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih!
Dialogue: 0,0:17:55.82,0:17:57.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah mau mulai.
Dialogue: 0,0:18:00.43,0:18:02.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lima, empat,
Dialogue: 0,0:18:02.94,0:18:04.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tiga, dua,
Dialogue: 0,0:18:04.94,0:18:05.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}satu.
Dialogue: 0,0:18:05.94,0:18:08.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meluncur!
Dialogue: 0,0:18:20.03,0:18:21.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sorano.
Dialogue: 0,0:18:21.55,0:18:22.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:18:22.67,0:18:26.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa minta tolong jelaskan bagaimana\Nbentuk kembang apinya?
Dialogue: 0,0:18:29.54,0:18:32.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, kembang api kuning\Nsedang meluncur.
Dialogue: 0,0:18:33.63,0:18:37.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berbentuk lingkaran sempurna\Nlalu menghilang bersama bayangannya.
Dialogue: 0,0:18:38.02,0:18:39.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:18:40.53,0:18:42.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kembang api apa namanya, ya?
Dialogue: 0,0:18:43.15,0:18:47.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah meletup, cahayanya tertinggal\Ndan berguguran bak sakura.
Dialogue: 0,0:18:48.48,0:18:50.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Indah?
Dialogue: 0,0:18:50.08,0:18:51.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat indah.
Dialogue: 0,0:18:53.30,0:18:54.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah...
Dialogue: 0,0:18:56.18,0:19:00.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang bisa menyaksikan\Nkembang api sama semuanya.
Dialogue: 0,0:19:01.79,0:19:06.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembang Api Anak-Anak,\Nmenyulap gambar mereka jadi kembang api.
Dialogue: 0,0:19:06.73,0:19:10.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya kembang api bentuk,\Nmesiu dibentuk pola hingga gambarnya
Dialogue: 0,0:19:10.74,0:19:13.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berpendar di langit malam.
Dialogue: 0,0:19:14.00,0:19:18.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malam ini, selamat menikmati kembang api\Nyang membawa mimpi anak-anak!
Dialogue: 0,0:19:19.95,0:19:23.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembuka kita adalah kembang api\Nkarya Dik Hiroto,
Dialogue: 0,0:19:23.29,0:19:25.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang menyukai senyum ibunya.
Dialogue: 0,0:19:25.23,0:19:27.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:19:27.46,0:19:29.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keren!
Dialogue: 0,0:19:30.61,0:19:32.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terdengar seru.
Dialogue: 0,0:19:32.88,0:19:34.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu suka kembang api?
Dialogue: 0,0:19:35.30,0:19:37.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin karena aku mengaguminya.
Dialogue: 0,0:19:38.62,0:19:42.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembang api itu terpatri di hati.
Dialogue: 0,0:19:43.41,0:19:47.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu kecil, aku pernah sakit\Ndan sangat terpuruk.
Dialogue: 0,0:19:48.33,0:19:52.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu keluargaku mengajak\Nmelihat kembang api.
Dialogue: 0,0:19:59.20,0:20:04.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketika aku menoleh ke belakang,\Nsemua orang menatap ke atas.
Dialogue: 0,0:20:04.80,0:20:07.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa,\Nitu membuatku ingin berjuang lagi.
Dialogue: 0,0:20:08.83,0:20:11.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat tertunduk lesu pun,
Dialogue: 0,0:20:11.02,0:20:15.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}asal ada kenangan mendongak,\Nrasanya bisa semangat lagi.
Dialogue: 0,0:20:16.72,0:20:20.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana menjelaskan perasaan ini, ya?
Dialogue: 0,0:20:21.50,0:20:25.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi ingin menjalani hidup\Nyang bisa mematri
Dialogue: 0,0:20:25.02,0:20:27.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di hati orang lain.
Dialogue: 0,0:20:30.42,0:20:33.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah ada di dalam diriku.
Dialogue: 0,0:20:37.09,0:20:38.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar?
Dialogue: 0,0:20:38.85,0:20:40.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada di dalam diriku juga.
Dialogue: 0,0:20:40.46,0:20:43.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lah, kamu juga dengar, Narumi?
Dialogue: 0,0:20:43.85,0:20:46.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedengaran sampai sini juga
Dialogue: 0,0:20:46.19,0:20:48.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koharu, kamu menikmatinya?
Dialogue: 0,0:20:48.56,0:20:50.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:20:50.66,0:20:53.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya kembang apimu, Koharu.
Dialogue: 0,0:20:53.39,0:20:58.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, jadi aku harus menyaksikan\Nkembang apiku sama Sorano?
Dialogue: 0,0:20:58.74,0:21:02.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berulang kali menderita\Nkarena penyakit,
Dialogue: 0,0:21:02.48,0:21:05.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}demi membalas budi orang-orang\Nyang mendukungnya...
Dialogue: 0,0:21:06.53,0:21:08.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi malu!
Dialogue: 0,0:21:08.06,0:21:10.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sorano, jangan lihat, ya!
Dialogue: 0,0:21:18.16,0:21:19.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lambang hati.
Dialogue: 0,0:21:19.49,0:21:21.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak perlu dijelaskan.
Dialogue: 0,0:21:21.95,0:21:24.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku yang menggambarnya sendiri!
Dialogue: 0,0:21:24.30,0:21:26.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan diucapkan!
Dialogue: 0,0:21:26.10,0:21:28.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa malah malu sendiri?
Dialogue: 0,0:21:28.45,0:21:29.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik!
Dialogue: 0,0:21:30.37,0:21:33.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terakhir, kembang apinya Sorano Kakeru.
Dialogue: 0,0:21:34.19,0:21:36.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, benar juga.
Dialogue: 0,0:21:36.43,0:21:38.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga ikut menggambar?
Dialogue: 0,0:21:38.78,0:21:40.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Disuruh Hayase.
Dialogue: 0,0:21:42.98,0:21:45.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bentuknya bagaimana?
Dialogue: 0,0:21:46.69,0:21:47.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuyutsuki.
Dialogue: 0,0:21:47.95,0:21:49.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:21:51.33,0:21:54.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum mengutarakannya langsung.
Dialogue: 0,0:21:57.48,0:21:58.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mencintaimu.
Dialogue: 0,0:21:59.44,0:22:02.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin berada di sisimu.
Dialogue: 0,0:22:09.42,0:22:10.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa...
Dialogue: 0,0:22:15.90,0:22:18.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu tidak kunjung menyerah?
Dialogue: 0,0:22:20.34,0:22:21.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakeru...
