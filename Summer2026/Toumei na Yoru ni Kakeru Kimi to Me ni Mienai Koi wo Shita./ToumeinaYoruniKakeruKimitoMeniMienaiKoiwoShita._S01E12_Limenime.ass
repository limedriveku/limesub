Dialogue: 0,0:15:43.63,0:15:45.97,sign,,0000,0000,0000,,LOVE UNSEEN BENEATH THE CLEAR NIGHT SKY
Dialogue: 0,0:16:54.33,0:16:55.07,sign,,0000,0000,0000,,SORANO KAKERU
Dialogue: 0,0:20:35.88,0:20:38.30,sign,,0000,0000,0000,,HARI KEDEWASAAN
Dialogue: 0,0:23:54.70,0:24:05.24,sign,,0000,0000,0000,,KENANGAN SEUMUR HIDUP
Dialogue: 0,0:00:01.76,0:00:04.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di hari aku mencium Kakeru,
Dialogue: 0,0:00:04.81,0:00:07.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku mengalami anemia\Ndan pingsan di rumah.
Dialogue: 0,0:00:09.12,0:00:12.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hasil pemeriksaan CT menunjukkan\Nkanker sudah menyebar,
Dialogue: 0,0:00:12.62,0:00:14.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan didiagnosis Stadium 4.
Dialogue: 0,0:00:18.84,0:00:21.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang kupikirkan saat itu\Nhanya tentang Kakeru.
Dialogue: 0,0:00:22.73,0:00:25.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku sampai menyampaikan\Nperasaanku ini...
Dialogue: 0,0:00:26.15,0:00:29.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedikit saja perasaan ini tersampaikan...
Dialogue: 0,0:00:29.95,0:00:33.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakeru akan menyia-nyiakan waktunya.
Dialogue: 0,0:00:35.11,0:00:37.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sekarang, masih bisa mundur.
Dialogue: 0,0:00:38.08,0:00:40.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga dia menemukan yang lebih baik.
Dialogue: 0,0:00:47.81,0:00:51.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya pengumuman penting!
Dialogue: 0,0:00:51.86,0:00:55.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku, Sorano Kakeryu...
Dialogue: 0,0:00:56.85,0:00:59.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sorano Kakeru...
Dialogue: 0,0:00:59.03,0:01:02.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mencintai...
Dialogue: 0,0:01:02.37,0:01:04.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuyutsuki Koharu!
Dialogue: 0,0:01:05.25,0:01:08.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin berpacaran dengannya!
Dialogue: 0,0:01:10.57,0:01:11.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke...
Dialogue: 0,0:01:12.01,0:01:13.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa...
Dialogue: 0,0:01:14.79,0:01:17.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa senang.
Dialogue: 0,0:01:17.97,0:01:20.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil aku tidak merasa senang.
Dialogue: 0,0:01:20.79,0:01:23.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tidak boleh lebih jauh dari ini.
Dialogue: 0,0:01:24.36,0:01:26.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menyakiti Kakeru.
Dialogue: 0,0:01:28.59,0:01:29.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuputuskan.
Dialogue: 0,0:01:30.79,0:01:33.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menarik diri dari teman-teman.
Dialogue: 0,0:01:33.33,0:01:36.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski bertemu Kakeru lagi,\Npura-pura tidak kenal saja.
Dialogue: 0,0:01:37.47,0:01:39.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai dia menyerah.
Dialogue: 0,0:01:40.41,0:01:43.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai dia melupakanku.
Dialogue: 0,0:01:46.20,0:01:48.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti berat.
Dialogue: 0,0:01:49.21,0:01:53.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal dia sudah menyatakan cinta...\NPadahal aku juga mencintainya...
Dialogue: 0,0:02:02.16,0:02:06.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu tidak kunjung menyerah?
Dialogue: 0,0:02:07.48,0:02:10.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Umurku tidak panjang.
Dialogue: 0,0:02:11.65,0:02:14.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar lagi juga akan mati.
Dialogue: 0,0:02:17.53,0:02:20.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di tengah ketakutan bagai berlari dalam gelap\Ndengan mata terpejam,
Dialogue: 0,0:02:21.61,0:02:26.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia memilih sendirian\Nkarena tidak bisa melibatkan siapa pun.
Dialogue: 0,0:02:28.33,0:02:29.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk Fuyutsuki yang seperti itu,
Dialogue: 0,0:02:30.65,0:02:32.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk orang yang sangat kucintai itu,
Dialogue: 0,0:02:33.09,0:02:35.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa yang bisa kulakukan untuknya?
Dialogue: 0,0:02:37.28,0:02:39.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuyutsuki, bisa melihatku?
Dialogue: 0,0:02:44.35,0:02:46.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa malah tertawa?
Dialogue: 0,0:02:47.08,0:02:47.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya...
Dialogue: 0,0:02:47.81,0:02:52.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bicara begitu!\NAku bukan lagi bercanda.
Dialogue: 0,0:02:52.31,0:02:56.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya, kanker takut sama senyuman, kan?
Dialogue: 0,0:02:58.40,0:03:01.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya susah kalau senyum sendirian?
Dialogue: 0,0:03:02.95,0:03:06.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, tinggal saling\Nbercanda saja sama aku.
Dialogue: 0,0:03:07.19,0:03:09.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku rasa kamu butuh orang\Nyang seperti itu.
Dialogue: 0,0:03:12.84,0:03:16.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar-benar bodoh, Kakeru.
Dialogue: 0,0:03:17.75,0:03:20.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakeru, ya?\NSudah kuduga.
Dialogue: 0,0:03:21.93,0:03:24.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga apanya?
Dialogue: 0,0:03:25.12,0:03:27.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kadang kamu suka senyum sendiri.
Dialogue: 0,0:03:29.80,0:03:34.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu juga kamu sempat bilang\Npembatas buku itu "milikku".
Dialogue: 0,0:03:35.25,0:03:39.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bilang sudah membuat itu\Njauh sebelum kuliah, kan?
Dialogue: 0,0:03:39.89,0:03:42.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah bilang begitu?
Dialogue: 0,0:03:42.35,0:03:43.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pernah.
Dialogue: 0,0:03:44.13,0:03:47.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingat semua yang kamu katakan.
Dialogue: 0,0:03:48.44,0:03:50.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar bodoh.
Dialogue: 0,0:03:52.09,0:03:54.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tahu betapa beratnya
Dialogue: 0,0:03:54.79,0:03:56.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku menahan semua ini?
Dialogue: 0,0:03:57.76,0:03:58.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:04:03.35,0:04:04.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:04:04.68,0:04:06.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena sudah berbohong?
Dialogue: 0,0:04:07.35,0:04:09.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu juga.
Dialogue: 0,0:04:09.11,0:04:10.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus apa?
Dialogue: 0,0:04:11.12,0:04:12.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kondisi tubuhku.
Dialogue: 0,0:04:13.56,0:04:16.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan masalah.\NKamu akan menyembuhkannya, kan?
Dialogue: 0,0:04:17.29,0:04:20.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Persentase bertahan hidupnya\Nrendah banget, lo.
Dialogue: 0,0:04:20.99,0:04:22.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan masalah, kok.
Dialogue: 0,0:04:23.55,0:04:24.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa sembuh.
Dialogue: 0,0:04:26.24,0:04:27.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku usahakan.
Dialogue: 0,0:04:28.67,0:04:29.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku percaya.
Dialogue: 0,0:04:31.59,0:04:34.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan berusaha, jadi percayalah.
Dialogue: 0,0:04:45.15,0:04:46.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertengahan Oktober.
Dialogue: 0,0:04:47.67,0:04:50.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu tenaganya pulih,
Dialogue: 0,0:04:50.39,0:04:53.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuyutsuki memutuskan pergi\Nke rumah sakit di Hokkaido.
Dialogue: 0,0:04:58.04,0:04:59.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sehari sebelum pindah rumah sakit.
Dialogue: 0,0:05:00.47,0:05:02.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?\NCocok?
Dialogue: 0,0:05:06.55,0:05:07.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cocok, kan?
Dialogue: 0,0:05:14.43,0:05:16.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlihat sangat cantik.
Dialogue: 0,0:05:21.52,0:05:23.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya bisa mengenakannya.
Dialogue: 0,0:05:24.81,0:05:28.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya ada yang bisa kupamerkan\Npada Kakeru.
Dialogue: 0,0:05:29.85,0:05:32.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan pernah dilupakan.
Dialogue: 0,0:05:33.79,0:05:37.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, lagian mustahil bisa lupa.
Dialogue: 0,0:05:38.15,0:05:39.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hore!
Dialogue: 0,0:05:40.49,0:05:44.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin membuat kenang-kenangan\Nkarena besok kita tidak bisa bertemu.
Dialogue: 0,0:05:49.72,0:05:52.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anginnya sejuk.
Dialogue: 0,0:05:52.03,0:05:54.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pertama kali kita ke sini\Nmalam-malam, ya?
Dialogue: 0,0:05:56.01,0:06:00.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku sudah kembali sehat,\Nmau kencan denganku lagi?
Dialogue: 0,0:06:00.60,0:06:02.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau tidak, ya?
Dialogue: 0,0:06:02.40,0:06:03.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar jail.
Dialogue: 0,0:06:06.05,0:06:11.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, maaf. Kapan pun bisa, kok.\NKita bisa kencan kapan saja.
Dialogue: 0,0:06:12.33,0:06:14.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau ke mana kita?
Dialogue: 0,0:06:14.23,0:06:15.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke mana pun.
Dialogue: 0,0:06:16.48,0:06:20.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gunung, sungai, mal,\Natau taman hiburan juga boleh.
Dialogue: 0,0:06:23.44,0:06:26.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin pergi ke tempat kelahiranmu.
Dialogue: 0,0:06:26.77,0:06:30.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh, ada laut yang sering\Naku pandangi di sana.
Dialogue: 0,0:06:31.41,0:06:35.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi tidak sabar.\NAku harus bertahan sampai waktunya nanti.
Dialogue: 0,0:06:37.17,0:06:40.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawa kembang api yang kita beli\Ndi Asakusabashi?
Dialogue: 0,0:06:40.72,0:06:41.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:06:43.00,0:06:45.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menyalakannya di sini.
Dialogue: 0,0:06:45.52,0:06:46.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya tidak bisa di sini.
Dialogue: 0,0:06:48.09,0:06:49.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:06:50.51,0:06:52.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa, ya?
Dialogue: 0,0:06:52.61,0:06:56.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kembang api kawat\Nharusnya aman, kan?
Dialogue: 0,0:06:58.71,0:07:01.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu kami membuatnya bersama.
Dialogue: 0,0:07:01.82,0:07:03.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisalah kita menyalakannya hari ini.
Dialogue: 0,0:07:04.53,0:07:07.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau menjadikanku komplotanmu?
Dialogue: 0,0:07:07.97,0:07:11.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru kamu pelaku utamanya.
Dialogue: 0,0:07:11.61,0:07:13.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bercandanya begitu lagi.
Dialogue: 0,0:07:15.77,0:07:17.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nih, kembang api kawatnya.
Dialogue: 0,0:07:19.89,0:07:22.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bawa pemantik api?
Dialogue: 0,0:07:22.04,0:07:23.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawa.
Dialogue: 0,0:07:23.12,0:07:25.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata sudah niat.
Dialogue: 0,0:07:26.32,0:07:29.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terlalu jauh dariku,\Nnanti bisa masuk angin.
Dialogue: 0,0:07:29.07,0:07:32.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal tinggal bilang langsung\Nkalau ingin berdekatan.
Dialogue: 0,0:07:32.47,0:07:34.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, sini lebih dekat.
Dialogue: 0,0:07:34.87,0:07:35.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:07:43.95,0:07:45.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau lomba?
Dialogue: 0,0:07:46.12,0:07:48.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang nyala lebih lama.
Dialogue: 0,0:07:48.51,0:07:49.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh.
Dialogue: 0,0:07:53.77,0:07:57.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuharap nyala Fuyutsuki yang lebih lama.
Dialogue: 0,0:07:58.05,0:08:01.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun itu satu detik lebih lama dariku.
Dialogue: 0,0:08:02.87,0:08:07.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau memang akan segera habis terbakar,\Nlebih baik tidak usah memercikkan api.
Dialogue: 0,0:08:07.53,0:08:11.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai saja dia bisa terus\Nmenyala lebih lama.
Dialogue: 0,0:08:13.88,0:08:17.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, bukan begitu.\NIni sudah cukup.
Dialogue: 0,0:08:19.25,0:08:23.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin dia menyala sekuat tenaga,\Nmenerangi seseorang selagi hidup.
Dialogue: 0,0:08:24.33,0:08:28.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin dia terus bersinar,\Nsampai benar-benar puas.
Dialogue: 0,0:08:29.09,0:08:31.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyalalah, menyalalah,
Dialogue: 0,0:08:31.89,0:08:34.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jangan jatuh, jangan jatuh.
Dialogue: 0,0:08:40.23,0:08:43.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, aku yang jatuh duluan.
Dialogue: 0,0:08:46.67,0:08:49.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu selalu saja mengatakan\Nkebohongan yang manis.
Dialogue: 0,0:08:58.87,0:09:02.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembang api kawatnya masih ada,\Nnyalakan sekali lagi, yuk!
Dialogue: 0,0:09:02.73,0:09:05.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bohong lagi, ya?
Dialogue: 0,0:09:05.44,0:09:07.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, sini lebih dekat lagi.
Dialogue: 0,0:09:20.12,0:09:23.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakeru, apa yang kamu lakukan?
Dialogue: 0,0:09:23.55,0:09:28.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kembang apinya ditempelkan,\Nakan menyala lebih lama tidak, ya?
Dialogue: 0,0:09:29.04,0:09:31.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti sudah bukan lomba, dong.
Dialogue: 0,0:09:31.89,0:09:33.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu benar.
Dialogue: 0,0:09:34.57,0:09:37.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku tetap ingin menyala lebih lama.
Dialogue: 0,0:09:38.47,0:09:41.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski itu satu detik lebih lama.
Dialogue: 0,0:09:43.65,0:09:47.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku meninggal duluan,\Nkamu akan bagaimana?
Dialogue: 0,0:09:47.39,0:09:49.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang begitu.
Dialogue: 0,0:09:49.47,0:09:51.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya misalnya.
Dialogue: 0,0:09:51.59,0:09:53.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan kuat.
Dialogue: 0,0:09:53.45,0:09:55.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa aku ingin mati bersama.
Dialogue: 0,0:09:55.73,0:09:57.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga akan begitu.
Dialogue: 0,0:09:58.77,0:09:59.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlalu berat?
Dialogue: 0,0:10:00.16,0:10:03.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak terlalu,\Ntapi bukan hal menyenangkan.
Dialogue: 0,0:10:04.04,0:10:06.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tetap ingin panjang umur\Nbersama orang yang kucintai.
Dialogue: 0,0:10:14.03,0:10:15.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembatas buku itu...
Dialogue: 0,0:10:15.89,0:10:19.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya punyaku?
Dialogue: 0,0:10:19.36,0:10:22.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain yang tertulis di situ,
Dialogue: 0,0:10:22.31,0:10:24.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada yang ingin kamu lakukan lagi\Ndi masa depan?
Dialogue: 0,0:10:26.63,0:10:27.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada.
Dialogue: 0,0:10:28.32,0:10:30.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kedengarannya ada.
Dialogue: 0,0:10:30.59,0:10:32.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah ini terlalu berat?
Dialogue: 0,0:10:32.71,0:10:34.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka yang berat-berat.
Dialogue: 0,0:10:34.51,0:10:36.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan tertawa, ya.
Dialogue: 0,0:10:36.64,0:10:37.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan.
Dialogue: 0,0:10:39.09,0:10:43.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Klise, tapi aku ingin mengenakan\Ngaun pengantin.
Dialogue: 0,0:10:43.14,0:10:44.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:10:45.64,0:10:48.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingin pergi bulan madu juga.
Dialogue: 0,0:10:48.24,0:10:49.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau ke mana?
Dialogue: 0,0:10:49.72,0:10:51.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke mana pun akan senang.
Dialogue: 0,0:10:52.44,0:10:56.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa tempat yang hangat dan santai.
Dialogue: 0,0:10:56.16,0:10:57.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:10:58.53,0:11:01.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin anak, meski hanya satu.
Dialogue: 0,0:11:01.83,0:11:02.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:11:03.31,0:11:08.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak itu akan mengenakan kimono\NShichi-Go-San punyaku dulu.
Dialogue: 0,0:11:08.37,0:11:09.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:11:09.55,0:11:13.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat anak itu masuk SD, aku ingin datang\Nke hari kunjungan orang tua.
Dialogue: 0,0:11:13.77,0:11:17.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, apa aku boleh datang\Nmeski tidak bisa melihat?
Dialogue: 0,0:11:17.03,0:11:19.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku yang cari cara.
Dialogue: 0,0:11:19.96,0:11:22.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin sering pergi piknik keluarga.
Dialogue: 0,0:11:22.48,0:11:23.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan padaku.
Dialogue: 0,0:11:23.75,0:11:26.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingin mengenakan kimono formal\Npada hari kedewasaannya.
Dialogue: 0,0:11:26.92,0:11:29.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku belajar memakaikannya.
Dialogue: 0,0:11:29.73,0:11:34.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi jangan acara keluarga terus,\Nsesekali aku ingin kencan berdua.
Dialogue: 0,0:11:34.61,0:11:36.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dimengerti.
Dialogue: 0,0:11:37.03,0:11:39.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingin menghadiri\Nupacara pernikahannya juga.
Dialogue: 0,0:11:40.62,0:11:45.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat dia membacakan surat untuk ibunya,\Naku akan menangis tersedu-sedu.
Dialogue: 0,0:11:45.54,0:11:47.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya aku juga bakal nangis.
Dialogue: 0,0:11:47.69,0:11:49.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi malu.
Dialogue: 0,0:11:50.87,0:11:52.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata ada banyak.
Dialogue: 0,0:11:52.67,0:11:55.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, ada banyak.
Dialogue: 0,0:11:56.71,0:11:57.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu harus tetap hidup.
Dialogue: 0,0:11:58.44,0:11:59.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:12:00.83,0:12:02.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan panjang umur.
Dialogue: 0,0:12:03.87,0:12:05.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berjanji.
Dialogue: 0,0:12:10.88,0:12:12.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah jatuh?
Dialogue: 0,0:12:12.15,0:12:13.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah.
Dialogue: 0,0:12:13.72,0:12:16.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini disudahi saja?
Dialogue: 0,0:12:19.33,0:12:20.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya.
Dialogue: 0,0:12:22.64,0:12:23.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini.
Dialogue: 0,0:12:23.73,0:12:25.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:12:25.93,0:12:27.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buku Harian Anne.
Dialogue: 0,0:12:28.25,0:12:30.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku membuatkan rekamannya.
Dialogue: 0,0:12:30.53,0:12:32.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya?
Dialogue: 0,0:12:32.96,0:12:35.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenggorokanku sampai kering.
Dialogue: 0,0:12:35.00,0:12:37.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, semuanya, ya?
Dialogue: 0,0:12:38.49,0:12:40.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih!
Dialogue: 0,0:12:41.85,0:12:44.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengirim bunga\Nke rumah sakit Hokkaido.
Dialogue: 0,0:12:45.27,0:12:46.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau mengirim bunga?
Dialogue: 0,0:12:48.29,0:12:49.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakung putih.
Dialogue: 0,0:12:50.01,0:12:51.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tahu bahasa bunganya?
Dialogue: 0,0:12:52.17,0:12:54.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Aku memercayaimu?"
Dialogue: 0,0:12:55.65,0:12:57.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah tahu?
Dialogue: 0,0:12:57.05,0:12:59.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya selalu ada di kamar rawat.
Dialogue: 0,0:12:59.87,0:13:02.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, arti lainnya?
Dialogue: 0,0:13:02.00,0:13:05.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Masih ada arti lain?
Dialogue: 0,0:13:07.36,0:13:09.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Ke suatu tempat yang jauh."
Dialogue: 0,0:13:10.23,0:13:12.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke suatu tempat yang jauh?
Dialogue: 0,0:13:14.84,0:13:18.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Ke mana pun kamu pergi jauh,\Naku akan memercayaimu."
Dialogue: 0,0:13:20.89,0:13:22.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat sembuh di sana, ya.
Dialogue: 0,0:13:24.60,0:13:28.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke mana pun kamu pergi jauh,\Naku akan memercayaimu.
Dialogue: 0,0:13:31.77,0:13:32.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakeru.
Dialogue: 0,0:13:34.88,0:13:38.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bersyukur jatuh cinta padamu.
Dialogue: 0,0:13:52.77,0:13:55.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan terus berusaha sedikit lagi.
Dialogue: 0,0:13:55.96,0:13:56.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:14:00.20,0:14:04.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu, Fuyutsuki berkali-kali\Nmengalami kekambuhan kanker,
Dialogue: 0,0:14:04.36,0:14:06.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tiap kali itu, dia terus berjuang.
Dialogue: 0,0:14:08.07,0:14:09.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu penyakit itu pun,
Dialogue: 0,0:14:10.96,0:14:14.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}merenggut nyawa Fuyutsuki dariku.
Dialogue: 0,0:16:04.56,0:16:06.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah cukup.
Dialogue: 0,0:16:08.35,0:16:11.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudahi saja.
Dialogue: 0,0:16:12.01,0:16:14.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menyerah, Pak Sorano.
Dialogue: 0,0:16:18.01,0:16:20.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini istirahatlah yang cukup.
Dialogue: 0,0:16:25.67,0:16:28.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas kerja kerasnya, Dokter.
Dialogue: 0,0:16:28.11,0:16:29.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tidak.
Dialogue: 0,0:16:29.29,0:16:31.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah datang.
Dialogue: 0,0:16:33.08,0:16:36.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah, kenapa berekspresi begitu?
Dialogue: 0,0:16:37.59,0:16:38.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakura.
Dialogue: 0,0:16:39.83,0:16:42.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti dimarahi Ibu yang lagi di surga.
Dialogue: 0,0:16:49.20,0:16:53.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segera setelah Koharu meninggal dunia,\Nkanker ditemukan di usus besarku.
Dialogue: 0,0:16:55.07,0:16:58.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyebar ke hati, lalu ke paru-paru.
Dialogue: 0,0:16:59.25,0:17:01.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya sudah Stadium 4.
Dialogue: 0,0:17:01.29,0:17:03.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kondisi yang disebut kanker stadium akhir.
Dialogue: 0,0:17:05.27,0:17:09.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Operasi berkali-kali,\Nefek samping obat keras.
Dialogue: 0,0:17:09.64,0:17:13.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlalu menyiksa sampai pengobatan pun\Njadi tidak penting lagi bagiku.
Dialogue: 0,0:17:13.84,0:17:15.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur, aku sudah lelah.
Dialogue: 0,0:17:18.19,0:17:20.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak itu, Koharu yang terus\Nberjuang melawan penyakit
Dialogue: 0,0:17:20.80,0:17:22.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengalami pemulihan yang luar biasa,
Dialogue: 0,0:17:22.99,0:17:25.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan setelah dua tahun,\Nakhirnya bisa keluar dari rumah sakit.
Dialogue: 0,0:17:26.34,0:17:31.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu, aku dan Koharu menikah,\Ndan Sakura pun lahir.
Dialogue: 0,0:17:32.49,0:17:35.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, saat Koharu berusia 45 tahun,
Dialogue: 0,0:17:35.55,0:17:37.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia terkena kanker payudara.
Dialogue: 0,0:17:37.55,0:17:42.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiga tahun lalu, dia meninggal dunia,\Nmeninggalkanku dan Sakura.
Dialogue: 0,0:17:43.87,0:17:45.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku sampai meninggal juga,
Dialogue: 0,0:17:45.71,0:17:50.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku pasti akan membuat Sakura\Ntambah bersedih lagi.
Dialogue: 0,0:17:50.63,0:17:51.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya.
Dialogue: 0,0:17:52.39,0:17:56.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menemukan ini di laci lemari Ibu.
Dialogue: 0,0:18:03.11,0:18:05.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau ganti bunga dulu.
Dialogue: 0,0:18:18.16,0:18:19.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buku Harian Anne.
Dialogue: 0,0:18:20.99,0:18:23.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Narasinya payah banget.
Dialogue: 0,0:18:24.35,0:18:27.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koharu mendengarkan rekaman\Npayah ini bertahun-tahun?
Dialogue: 0,0:18:29.96,0:18:31.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk Kakeru.
Dialogue: 0,0:18:32.81,0:18:35.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, maafkan aku\Nkarena pergi mendahuluimu.
Dialogue: 0,0:18:37.37,0:18:41.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya.\NSepertinya kali ini agak sulit.
Dialogue: 0,0:18:42.48,0:18:45.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perpisahan ini datang sedikit lebih cepat,
Dialogue: 0,0:18:45.24,0:18:47.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi jangan terlalu bersedih, ya.
Dialogue: 0,0:18:49.12,0:18:52.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu menangis karena kematianku?
Dialogue: 0,0:18:53.60,0:18:57.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, mungkin sampai pemakaman\Nkamu memang menangis, sih.
Dialogue: 0,0:18:58.69,0:19:03.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, setelah benar-benar berpamitan,\Nkamu tidak perlu menangis lagi.
Dialogue: 0,0:19:05.19,0:19:07.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali tidak menangis pun\Ntidak apa-apa.
Dialogue: 0,0:19:08.64,0:19:13.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya, tidak ada satu pun kenangan\Nyang membuatku pantas ditangisi.
Dialogue: 0,0:19:14.89,0:19:20.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada itu, pujilah aku karena sudah\Nberumur panjang untuk ukuranku.
Dialogue: 0,0:19:21.25,0:19:23.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musim panas tahun pertama kuliah itu.
Dialogue: 0,0:19:23.95,0:19:28.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau saja tidak ada kamu,\Nmungkin hidupku sudah berakhir di sana.
Dialogue: 0,0:19:30.69,0:19:35.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak itu, aku banyak sekali...
Dialogue: 0,0:21:02.04,0:21:03.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakeru.
Dialogue: 0,0:21:04.07,0:21:05.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang
Dialogue: 0,0:21:05.62,0:21:10.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu pikir aku masih punya penyesalan?
Dialogue: 0,0:21:11.11,0:21:17.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang menyesal meninggalkanmu\Ndan Sakura dari dunia ini.
Dialogue: 0,0:21:18.64,0:21:21.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, aku bahagia.
Dialogue: 0,0:21:22.71,0:21:25.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hidup yang bahagia.
Dialogue: 0,0:21:26.89,0:21:29.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Kakeru.
Dialogue: 0,0:21:31.75,0:21:34.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah bertemu denganku.
Dialogue: 0,0:21:35.23,0:21:38.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah memilihku.
Dialogue: 0,0:21:40.19,0:21:42.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langkahku memang berhenti di sini,
Dialogue: 0,0:21:42.56,0:21:46.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku percaya padamu\Nyang akan melangkah jauh.
Dialogue: 0,0:21:47.99,0:21:53.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku percaya padamu\Nyang akan tegar dan terus maju.
Dialogue: 0,0:21:54.67,0:21:55.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon.
Dialogue: 0,0:21:56.76,0:21:58.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalanilah hidup sambil tersenyum.
Dialogue: 0,0:22:06.15,0:22:08.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah menangisi apa?
Dialogue: 0,0:22:11.05,0:22:12.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, maaf.
Dialogue: 0,0:22:13.25,0:22:16.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunga barunya harum, lo.
Dialogue: 0,0:22:17.96,0:22:21.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tahu bahasa bunga itu?
Dialogue: 0,0:22:21.39,0:22:22.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakung putih?
Dialogue: 0,0:22:23.88,0:22:27.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Ke mana pun kamu pergi jauh,\Naku akan memercayaimu."
Dialogue: 0,0:22:28.12,0:22:29.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memercayai?
Dialogue: 0,0:22:29.77,0:22:30.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:22:33.12,0:22:37.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dalam hatiku dan kamu,\NKoharu selalu ada,
Dialogue: 0,0:22:37.43,0:22:39.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan aku yakin dia akan terus
Dialogue: 0,0:22:40.83,0:22:44.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengucapkan kata-kata ini pada kita.
Dialogue: 0,0:22:44.51,0:22:47.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Ayah tersenyum?
Dialogue: 0,0:22:49.04,0:22:52.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya kanker takut sama senyuman.
Dialogue: 0,0:22:54.19,0:22:56.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koharu tidak bisa melihat.
Dialogue: 0,0:22:57.00,0:22:59.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga tersiksa oleh penyakit berat.
Dialogue: 0,0:23:00.17,0:23:02.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, dia tidak pernah\Nmenyerah pada hidupnya.
Dialogue: 0,0:23:04.64,0:23:07.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku bisa menjadi sepertinya?
Dialogue: 0,0:23:07.59,0:23:10.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku juga bisa menyambungkan\Nhidup ini untuk seseorang?
Dialogue: 0,0:23:12.57,0:23:14.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, kembang api.
Dialogue: 0,0:23:15.21,0:23:17.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah, lihat!
Dialogue: 0,0:23:23.67,0:23:24.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakura.
Dialogue: 0,0:23:26.57,0:23:28.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa minta tolong panggilkan dokter?
Dialogue: 0,0:23:29.67,0:23:32.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah mau konsultasi soal pengobatan.
Dialogue: 0,0:23:34.28,0:23:36.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, baiklah.
Dialogue: 0,0:23:47.25,0:23:48.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:23:49.76,0:23:53.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga bersyukur\Nbisa bertemu denganmu, Koharu.
