Dialogue: 0,0:00:16.25,0:00:26.80,sign,,0000,0000,0000,,LOVE UNSEEN BENEATH THE CLEAR NIGHT SKY
Dialogue: 0,0:07:37.85,0:07:40.56,sign,,0000,0000,0000,,PERPUSTAKAAN UNIVERSITAS
Dialogue: 0,0:07:40.56,0:07:43.71,sign,,0000,0000,0000,,PENCARIAN BASIS DATA
Dialogue: 0,0:07:43.71,0:07:46.86,sign,,0000,0000,0000,,KAMUS BRAILLE
Dialogue: 0,0:07:46.86,0:07:47.99,sign,,0000,0000,0000,,PENCARIAN BASIS DATA
Dialogue: 0,0:08:13.85,0:08:15.85,sign,,0000,0000,0000,,DAFTAR SIMBOL BRAILLE
Dialogue: 0,0:08:20.86,0:08:23.07,sign,,0000,0000,0000,,ACARA MINUM-MINUM, PERGI
Dialogue: 0,0:12:33.61,0:12:35.03,sign,,0000,0000,0000,,KOPI
Dialogue: 0,0:16:16.91,0:16:19.36,sign,,0000,0000,0000,,KEMBANG API ANAK-ANAK
Dialogue: 0,0:16:19.36,0:16:20.79,sign,,0000,0000,0000,,GAMBAR KEMBANG API YANG KALIAN SUKA
Dialogue: 0,0:16:25.17,0:16:29.84,sign,,0000,0000,0000,,KEMBANG API ANAK-ANAK
Dialogue: 0,0:16:29.84,0:16:34.75,sign,,0000,0000,0000,,GAMBAR KEMBANG API YANG KALIAN SUKA
Dialogue: 0,0:17:56.68,0:17:58.89,sign,,0000,0000,0000,,PENSIL WARNA
Dialogue: 0,0:18:19.29,0:18:21.37,sign,,0000,0000,0000,,PASTIKAN TELAH MEMAKAI MASTER DAN DISINFEKTAN
Dialogue: 0,0:18:21.37,0:18:22.62,sign,,0000,0000,0000,,SEBELUM MASUK
Dialogue: 0,0:22:25.62,0:22:30.00,sign,,0000,0000,0000,,SENDIRI
Dialogue: 0,0:01:49.97,0:01:53.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekadar mengingatkan, ini area merokok.
Dialogue: 0,0:01:54.05,0:01:55.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah sendiri di sini.
Dialogue: 0,0:01:56.19,0:01:58.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahu yang namanya perokok pasif?
Dialogue: 0,0:01:58.72,0:02:03.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, tolong tahan napasmu\Nuntuk sementara.
Dialogue: 0,0:02:09.50,0:02:13.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu teman kampusnya Fuyutsuki?
Dialogue: 0,0:02:15.98,0:02:18.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dokter yang merawat Fuyutsuki.
Dialogue: 0,0:02:18.64,0:02:20.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dokternya, ya?
Dialogue: 0,0:02:25.84,0:02:28.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng, boleh aku bertanya?
Dialogue: 0,0:02:28.70,0:02:30.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal ingatan Fuyutsuki?
Dialogue: 0,0:02:31.55,0:02:36.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya kanker bisa\Nmembuat orang hilang ingatan?
Dialogue: 0,0:02:36.16,0:02:41.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada tumor di area memori otak,\Nkemungkinannya memang ada.
Dialogue: 0,0:02:42.85,0:02:47.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kasus Fuyutsuki menyebar ke hati,
Dialogue: 0,0:02:48.18,0:02:51.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}normalnya hampir mustahil dia hilang ingatan.
Dialogue: 0,0:02:51.77,0:02:54.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus kenapa?
Dialogue: 0,0:02:55.87,0:02:58.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kemungkinannya kecil,
Dialogue: 0,0:02:58.00,0:03:01.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat kemoterapi dimulai,\Ningatan pasien terkadang bisa kacau.
Dialogue: 0,0:03:02.54,0:03:06.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lupa kejadian kemarin, pikiran berkabut...
Dialogue: 0,0:03:06.64,0:03:08.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istilahnya disebut chemo brain.
Dialogue: 0,0:03:08.74,0:03:12.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penggunaan obat keras bisa memicu kondisi itu.
Dialogue: 0,0:03:12.27,0:03:14.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, kali ini juga...
Dialogue: 0,0:03:17.26,0:03:21.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kasusnya Fuyutsuki berbeda dari chemo brain.
Dialogue: 0,0:03:21.85,0:03:24.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya?
Dialogue: 0,0:03:24.11,0:03:27.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyebabnya bukan penyakit atau obat.
Dialogue: 0,0:03:28.29,0:03:31.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih ke faktor psikologis.
Dialogue: 0,0:03:32.14,0:03:35.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seolah dia sendiri yang sengaja\Nmenutup ingatannya.
Dialogue: 0,0:03:35.79,0:03:37.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menutup?
Dialogue: 0,0:03:41.38,0:03:45.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ingatannya distimulasi,\Nmungkin akan ada reaksi.
Dialogue: 0,0:03:47.07,0:03:48.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau coba?
Dialogue: 0,0:03:48.85,0:03:50.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong beri tahu aku.
Dialogue: 0,0:03:51.78,0:03:54.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kankernya Fuyutsuki bisa disembuhkan?
Dialogue: 0,0:03:55.84,0:03:57.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah...
Dialogue: 0,0:03:57.55,0:03:59.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinannya lima persen.
Dialogue: 0,0:03:59.86,0:04:01.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu peluang kematiannya?
Dialogue: 0,0:04:02.29,0:04:03.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:04:04.06,0:04:06.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peluang bertahan hidup\Nsampai akhir tahun ini.
Dialogue: 0,0:04:13.82,0:04:15.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa disembuhkan, kok.
Dialogue: 0,0:04:27.52,0:04:28.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?
Dialogue: 0,0:04:28.91,0:04:31.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh...
Dialogue: 0,0:04:31.22,0:04:33.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada senior apalah itu.
Dialogue: 0,0:04:33.23,0:04:35.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal banget.
Dialogue: 0,0:04:35.34,0:04:36.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Kotomugi.
Dialogue: 0,0:04:38.42,0:04:39.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:04:40.93,0:04:43.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis yang tidak bisa melihat itu mana?
Dialogue: 0,0:04:44.56,0:04:47.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia masuk rumah sakit.
Dialogue: 0,0:04:48.03,0:04:49.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kondisinya memburuk.
Dialogue: 0,0:04:49.82,0:04:50.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh.
Dialogue: 0,0:04:51.92,0:04:54.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai pacar, kamu harus ada di sampingnya.
Dialogue: 0,0:04:54.78,0:04:56.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan pacarnya.
Dialogue: 0,0:04:56.46,0:04:58.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tidak pacaran?
Dialogue: 0,0:04:59.15,0:05:00.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ditolak.
Dialogue: 0,0:05:01.46,0:05:03.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, dong, aku mau nangis.
Dialogue: 0,0:05:05.01,0:05:07.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau galau, kembang api solusinya.
Dialogue: 0,0:05:07.66,0:05:09.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok jadi ke situ?
Dialogue: 0,0:05:09.17,0:05:11.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, aku mau kasih tahu sesuatu.
Dialogue: 0,0:05:11.98,0:05:15.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembang api festival kampus\Nkemarin dibatalkan, kan?
Dialogue: 0,0:05:15.20,0:05:17.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara itu sekarang jadi masalah.
Dialogue: 0,0:05:18.61,0:05:20.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:05:20.48,0:05:22.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal biaya pembatalan,
Dialogue: 0,0:05:23.28,0:05:27.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pengrajin kembang apinya\Nminta semua yang dibuat dibeli lunas.
Dialogue: 0,0:05:27.65,0:05:32.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi panitia cuma mau bayar biaya pasang
Dialogue: 0,0:05:32.48,0:05:34.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena kembang apinya\Nmasih bisa dipakai lagi.
Dialogue: 0,0:05:34.91,0:05:37.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedua pihak tidak mau mengalah.
Dialogue: 0,0:05:37.25,0:05:40.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bayangkan posisiku yang ada\Ndi tengah-tengah mereka.
Dialogue: 0,0:05:43.15,0:05:44.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak peduli.
Dialogue: 0,0:05:45.49,0:05:49.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kita boleh meluncurkan\Nkembang api di kampus, ya?
Dialogue: 0,0:05:49.06,0:05:50.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar itu.
Dialogue: 0,0:05:50.58,0:05:54.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meluncurkan kembang api itu\Nbiasanya butuh izin.
Dialogue: 0,0:05:54.50,0:05:57.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di situnya bagian paling repotnya.
Dialogue: 0,0:05:57.26,0:05:59.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, ada jalan keluarnya.
Dialogue: 0,0:05:59.59,0:06:02.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Program 3 menit: 50 peluru nomor 2,\N15 peluru nomor 3,
Dialogue: 0,0:06:02.72,0:06:08.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}10 peluru nomor 4, diselingi kembang api\NNiagara dan atraksi panggung.
Dialogue: 0,0:06:09.18,0:06:14.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan jumlah mesiu sebegitu,\Nkita bisa menyalakannya tanpa perlu izin.
Dialogue: 0,0:06:14.85,0:06:17.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, aku baru tahu.
Dialogue: 0,0:06:17.65,0:06:21.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau mancing, mau ikut?
Dialogue: 0,0:06:22.22,0:06:23.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang musim ikan kembung kecil.
Dialogue: 0,0:06:23.94,0:06:27.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ibu kantin bisa bantu goreng untuk kita.\N- Sudah cukup, dong.
Dialogue: 0,0:06:27.71,0:06:28.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya!
Dialogue: 0,0:06:30.08,0:06:32.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Ada di mana, ya?
Dialogue: 0,0:06:32.72,0:06:34.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:06:34.80,0:06:35.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:06:36.58,0:06:39.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau pulang dan menulis laporan.
Dialogue: 0,0:06:39.10,0:06:40.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada!
Dialogue: 0,0:06:41.42,0:06:42.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya ini...
Dialogue: 0,0:06:45.23,0:06:47.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Punya pacarmu?
Dialogue: 0,0:06:50.51,0:06:52.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dapat dari mana?
Dialogue: 0,0:06:52.85,0:06:55.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terjatuh di bangunan pracetak\Npenelitian kembang api.
Dialogue: 0,0:06:56.10,0:06:59.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin pembatas buku braille ini punya dia,
Dialogue: 0,0:06:59.61,0:07:01.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi mau kukasih saat bertemu,
Dialogue: 0,0:07:01.94,0:07:03.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kalau dia masuk rumah sakit...
Dialogue: 0,0:07:03.78,0:07:04.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior!
Dialogue: 0,0:07:05.62,0:07:07.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Terima kasih!\N- Sesak.
Dialogue: 0,0:07:07.99,0:07:10.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makasih banget!
Dialogue: 0,0:07:12.58,0:07:16.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembatas buku Fuyutsuki sudah ketemu!
Dialogue: 0,0:07:16.08,0:07:17.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah ketemu!
Dialogue: 0,0:07:22.06,0:07:23.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lari-larian.
Dialogue: 0,0:07:24.22,0:07:25.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:07:31.23,0:07:33.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamus braille ada di mana, ya?
Dialogue: 0,0:07:38.88,0:07:40.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pernah bikin daftar hal
Dialogue: 0,0:07:40.56,0:07:42.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang ingin dilakukan sebelum mati?
Dialogue: 0,0:07:43.71,0:07:46.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia tidak pernah tahu kapan akan mati.
Dialogue: 0,0:07:48.69,0:07:51.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin waktu itu dia tidak bercanda.
Dialogue: 0,0:07:52.99,0:07:57.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan,\NFuyutsuki sedang melawan kecemasannya.
Dialogue: 0,0:07:59.81,0:08:02.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal yang selalu ingin dilakukan Fuyutsuki.
Dialogue: 0,0:08:02.45,0:08:05.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tertulis di sini.
Dialogue: 0,0:09:00.48,0:09:02.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergi ke acara minum-minum.
Dialogue: 0,0:09:02.53,0:09:04.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masuk lingkar pertemanan.
Dialogue: 0,0:09:09.65,0:09:11.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mendapatkan teman.
Dialogue: 0,0:09:12.48,0:09:14.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergi berbelanja.
Dialogue: 0,0:09:24.54,0:09:26.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meluncurkan kembang api.
Dialogue: 0,0:09:26.37,0:09:28.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jatuh cinta.
Dialogue: 0,0:09:39.65,0:09:41.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu belum mewujudkannya.
Dialogue: 0,0:09:42.30,0:09:45.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa meluncurkan\Nkembang api sendiri,
Dialogue: 0,0:09:45.38,0:09:47.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rasanya akan menyenangkan.
Dialogue: 0,0:09:48.76,0:09:51.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan menjadi hari spesial juga.
Dialogue: 0,0:09:52.00,0:09:54.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kenangan seumur hidup.
Dialogue: 0,0:09:56.34,0:09:58.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal tinggal wujudkan.
Dialogue: 0,0:09:58.87,0:10:02.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada alasan untuk menyerah.
Dialogue: 0,0:10:02.70,0:10:03.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:10:03.87,0:10:06.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga...
Dialogue: 0,0:10:18.03,0:10:19.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo luncurkan kembang api.
Dialogue: 0,0:10:21.07,0:10:25.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Demi sang putri yang kian melemah,\N- Kukira aku bukan orang yang bergantung
Dialogue: 0,0:10:25.55,0:10:26.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- pangeran berlari sekuat tenaga\N- pada orang lain.
Dialogue: 0,0:10:26.88,0:10:29.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- membawa buah penawar sihir.\N- Padahal itu cuma kepasrahan
Dialogue: 0,0:10:29.01,0:10:31.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- membawa buah penawar sihir.\N- berkedok perlindungan diri.
Dialogue: 0,0:10:31.32,0:10:33.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Begitu tiba di sisi sang putri,\N- Aku sendiri kaget menyadari
Dialogue: 0,0:10:33.71,0:10:36.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- pangeran menyerahkan buah\N- betapa keras kepalanya
Dialogue: 0,0:10:36.38,0:10:37.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- yang dibungkusnya dengan hati-hati.\N- akar perasaan itu.
Dialogue: 0,0:10:37.86,0:10:38.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Setelah memakan\N- akar perasaan itu.
Dialogue: 0,0:10:38.91,0:10:41.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}gigitan kecil dari buah itu,
Dialogue: 0,0:10:41.76,0:10:44.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}air mata sang putri menetes berderai.
Dialogue: 0,0:10:44.54,0:10:49.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terbebas dari kutukan sihir,\Nsang putri akhirnya berucap,
Dialogue: 0,0:10:49.17,0:10:51.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Aku sangat mencintaimu."
Dialogue: 0,0:10:52.55,0:10:55.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan sang putri serta sang pangeran pun
Dialogue: 0,0:10:55.74,0:10:58.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hidup bahagia selamanya.
Dialogue: 0,0:10:59.05,0:11:00.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tamat.
Dialogue: 0,0:11:02.10,0:11:04.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang waktunya bernyanyi.
Dialogue: 0,0:11:06.38,0:11:07.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?
Dialogue: 0,0:11:08.42,0:11:09.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:11:10.88,0:11:14.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keesokan harinya\Nsaat aku sedang bertugas,
Dialogue: 0,0:11:14.02,0:11:16.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak melihat sosok Fuyutsuki.
Dialogue: 0,0:11:18.77,0:11:22.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu aku khawatir\Nmelihatnya sempoyongan,
Dialogue: 0,0:11:22.29,0:11:26.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi kubuntuti sampai ke kamar rawat\Ntanpa menyapa.
Dialogue: 0,0:11:27.39,0:11:31.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ngeri sendiri\Nkarena merasa seperti penguntit,
Dialogue: 0,0:11:32.98,0:11:35.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi dengan begini aku tahu kamarnya.
Dialogue: 0,0:11:44.02,0:11:46.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benaran mau dipotong saja?
Dialogue: 0,0:11:46.21,0:11:48.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, tolong.
Dialogue: 0,0:11:58.22,0:12:00.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibunya Fuyutsuki?
Dialogue: 0,0:12:01.91,0:12:04.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, gawat!
Dialogue: 0,0:12:07.74,0:12:09.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu?
Dialogue: 0,0:12:09.27,0:12:11.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, baiklah.
Dialogue: 0,0:12:11.79,0:12:15.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu mau beli minuman dulu, ya.
Dialogue: 0,0:12:20.91,0:12:23.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Temannya Koharu?
Dialogue: 0,0:12:23.06,0:12:25.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, iya!
Dialogue: 0,0:12:27.33,0:12:29.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kita mengobrol di sana.
Dialogue: 0,0:12:35.79,0:12:36.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aneh.
Dialogue: 0,0:12:38.21,0:12:40.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya seperti menatap Fuyutsuki.
Dialogue: 0,0:12:41.92,0:12:45.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu temannya Koharu?
Dialogue: 0,0:12:45.04,0:12:48.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, iya, namaku Sorano Kakeru.
Dialogue: 0,0:12:48.98,0:12:50.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teman kampusnya.
Dialogue: 0,0:12:50.54,0:12:51.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kampus?
Dialogue: 0,0:12:51.94,0:12:52.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:12:53.17,0:12:56.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata anak itu benar-benar kuliah, kan?
Dialogue: 0,0:12:56.61,0:13:00.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, karena kami satu jurusan.
Dialogue: 0,0:13:00.90,0:13:03.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:13:04.34,0:13:10.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak masuk rumah sakit, dia bersikeras\Nkalau dia tidak pernah kuliah.
Dialogue: 0,0:13:10.02,0:13:13.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah aku yang jadi bingung sendiri.
Dialogue: 0,0:13:13.52,0:13:15.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di rumah juga dia bilang begitu, ya?
Dialogue: 0,0:13:16.42,0:13:18.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang sesuatu?
Dialogue: 0,0:13:19.22,0:13:22.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bersikap seolah melupakan kami.
Dialogue: 0,0:13:23.78,0:13:25.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:13:26.98,0:13:30.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian pasti sedih diperlakukan seperti itu.
Dialogue: 0,0:13:30.66,0:13:33.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, aku tidak apa-apa.
Dialogue: 0,0:13:33.57,0:13:36.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang begitu.\NPasti sedih, kan?
Dialogue: 0,0:13:37.18,0:13:38.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:13:39.57,0:13:41.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:13:44.66,0:13:47.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu juga pasti sedih, ya?
Dialogue: 0,0:13:47.93,0:13:50.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, kamu memanggilku Ibu.
Dialogue: 0,0:13:50.62,0:13:51.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang...
Dialogue: 0,0:13:51.86,0:13:54.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukan!
Dialogue: 0,0:13:54.65,0:13:56.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bercanda.
Dialogue: 0,0:13:59.78,0:14:02.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu dan anak sama saja.
Dialogue: 0,0:14:02.62,0:14:05.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata turun dari ibunya.
Dialogue: 0,0:14:06.08,0:14:07.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu
Dialogue: 0,0:14:08.69,0:14:11.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harus memberi tahu hal ini\Npadamu atau tidak.
Dialogue: 0,0:14:13.12,0:14:14.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini topik berat.
Dialogue: 0,0:14:15.76,0:14:20.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiap hari aku selalu menyesal,
Dialogue: 0,0:14:20.02,0:14:22.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kenapa tidak melahirkannya\Ndengan tubuh kuat.
Dialogue: 0,0:14:22.99,0:14:26.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau aku pasang wajah sedih,
Dialogue: 0,0:14:26.75,0:14:29.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kasihan dia, kan?
Dialogue: 0,0:14:30.43,0:14:33.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena ini cobaan yang harus dihadapi,
Dialogue: 0,0:14:33.26,0:14:35.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku harus tetap tersenyum di sisinya.
Dialogue: 0,0:14:36.54,0:14:40.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kumohon temani dia.
Dialogue: 0,0:14:41.10,0:14:43.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski berat,
Dialogue: 0,0:14:43.65,0:14:47.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetaplah tersenyum di sisinya.
Dialogue: 0,0:14:48.88,0:14:50.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:14:53.26,0:14:54.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:14:57.50,0:15:00.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu gunting untuk apa?
Dialogue: 0,0:15:00.16,0:15:01.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:15:03.12,0:15:05.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk memotong rambutnya.
Dialogue: 0,0:15:05.82,0:15:09.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang lagian akan rontok\Nkarena efek obat.
Dialogue: 0,0:15:10.02,0:15:11.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata begitu.
Dialogue: 0,0:15:12.79,0:15:15.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal rambutnya panjang dan indah.
Dialogue: 0,0:15:15.57,0:15:18.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, rambutnya tidak dibuang, kok.
Dialogue: 0,0:15:18.67,0:15:21.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tahu Hair Donation?
Dialogue: 0,0:15:21.63,0:15:23.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hair Donation?
Dialogue: 0,0:15:24.06,0:15:26.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyumbangkan rambut yang telah dipotong.
Dialogue: 0,0:15:27.55,0:15:30.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kegiatan sosial membuat wig\Ndan membagikannya gratis
Dialogue: 0,0:15:30.72,0:15:34.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagi anak-anak yang kehilangan\Nrambut karena penyakit.
Dialogue: 0,0:15:34.64,0:15:38.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tidak dijadikan wig\Nuntuk diri sendiri saja?
Dialogue: 0,0:15:41.15,0:15:44.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu Koharu juga sedih\Nkarena kehilangan rambutnya,
Dialogue: 0,0:15:45.34,0:15:49.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi dia ingin menyumbangkan\Nrambutnya untuk anak-anak.
Dialogue: 0,0:15:49.97,0:15:51.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:15:52.90,0:15:57.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuyutsuki memang pribadi\Nyang akan melakukan itu.
Dialogue: 0,0:15:57.27,0:15:59.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul itu.
Dialogue: 0,0:15:59.50,0:16:04.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agak malu bilangnya,\Ntapi dia tumbuh jadi anak baik.
Dialogue: 0,0:16:06.46,0:16:09.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada waktu, datang jenguk lagi, ya.
Dialogue: 0,0:16:09.66,0:16:10.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah.
Dialogue: 0,0:16:11.42,0:16:12.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:16:19.36,0:16:20.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak!
Dialogue: 0,0:16:21.55,0:16:25.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini kita akan menggambar kembang api.
Dialogue: 0,0:16:25.17,0:16:27.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:16:27.66,0:16:29.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya "kembang api bentuk".
Dialogue: 0,0:16:29.84,0:16:33.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gambar kita bisa jadi kembang api sungguhan, lo.
Dialogue: 0,0:16:33.26,0:16:34.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:16:34.75,0:16:36.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Bohong, ah.\N- Mana mungkin.
Dialogue: 0,0:16:36.64,0:16:40.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, itu benaran, lo.
Dialogue: 0,0:16:40.15,0:16:41.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Keren!\N- Hore!
Dialogue: 0,0:16:41.65,0:16:43.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok reaksinya beda?
Dialogue: 0,0:16:43.71,0:16:45.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kasihan banget dia.
Dialogue: 0,0:16:47.36,0:16:48.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seminggu lalu,
Dialogue: 0,0:16:48.93,0:16:53.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}setelah berhasil membaca "daftar hal\Nyang ingin dilakukan sebelum mati",
Dialogue: 0,0:16:53.41,0:16:56.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}orang yang kutelepon adalah Hayase.
Dialogue: 0,0:16:56.60,0:16:59.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu kamu menelepon, aku kaget.
Dialogue: 0,0:16:59.20,0:17:00.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:17:01.07,0:17:05.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya kepikiran kamu sebagai panitia festival\Nsaat baca soal peluncuran kembang api.
Dialogue: 0,0:17:05.92,0:17:10.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau untuk Koharu,\Ntanpa kamu minta pun aku bantu.
Dialogue: 0,0:17:10.67,0:17:15.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya jadi ada banyak masalah\Nsetelah kembang api itu dibatalkan.
Dialogue: 0,0:17:16.36,0:17:19.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior Kotomugi hebat banget, ya.
Dialogue: 0,0:17:19.41,0:17:21.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal biasanya santai,
Dialogue: 0,0:17:21.47,0:17:25.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak kusangka dia mau mewujudkan\Nacara Kembang Api Anak-Anak ini.
Dialogue: 0,0:17:25.90,0:17:28.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berutang budi seumur hidup padanya.
Dialogue: 0,0:17:29.81,0:17:33.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bisa memberi kenangan\Nkembang api yang indah
Dialogue: 0,0:17:33.47,0:17:35.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk anak-anak ini, kan?
Dialogue: 0,0:17:35.60,0:17:36.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:17:38.05,0:17:41.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga ingatan Koharu kembali.
Dialogue: 0,0:17:42.30,0:17:43.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:17:44.10,0:17:49.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuharap kembang api ini bisa membuka\Ntutup ingatan Fuyutsuki...
Dialogue: 0,0:17:51.47,0:17:54.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini pun, Fuyutsuki tidak datang.
Dialogue: 0,0:18:02.58,0:18:05.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sorano, terima kasih untuk hari ini.
Dialogue: 0,0:18:05.66,0:18:09.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru aku yang tidak enak karena\Ntelah merepotkan tiap hari.
Dialogue: 0,0:18:09.94,0:18:13.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin saat ini Koharu sedang tidur,
Dialogue: 0,0:18:13.03,0:18:15.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan aku ada perlu.
Dialogue: 0,0:18:15.78,0:18:17.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:18:17.70,0:18:19.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum masuk,
Dialogue: 0,0:18:19.29,0:18:22.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tolong pakai masker dan disinfektan, ya.
Dialogue: 0,0:18:24.26,0:18:26.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jaga Koharu.
Dialogue: 0,0:18:27.84,0:18:30.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:18:45.02,0:18:47.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia seperti Putri Putih Salju.
Dialogue: 0,0:18:56.90,0:18:59.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga waktu damai ini
Dialogue: 0,0:18:59.65,0:19:01.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terus berlanjut.
Dialogue: 0,0:19:12.05,0:19:14.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, gawat.
Dialogue: 0,0:19:19.94,0:19:24.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu? Jendelanya dibuka saja.
Dialogue: 0,0:19:24.53,0:19:27.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya adem.
Dialogue: 0,0:19:29.01,0:19:30.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu?
Dialogue: 0,0:19:31.92,0:19:35.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, kamu perawat, ya?
Dialogue: 0,0:19:35.98,0:19:38.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku Sorano.
Dialogue: 0,0:19:42.42,0:19:44.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu!
Dialogue: 0,0:19:44.29,0:19:46.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa masuk sembarangan?
Dialogue: 0,0:19:46.21,0:19:50.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belakangan ini kita enggak ketemu,\Naku jadi khawatir.
Dialogue: 0,0:19:50.40,0:19:53.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal sudah kubilang lupakan saja aku!
Dialogue: 0,0:19:53.31,0:19:55.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menjenguk doang, kok.
Dialogue: 0,0:19:55.38,0:19:57.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibumu yang minta tolong padaku.
Dialogue: 0,0:19:57.18,0:19:59.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ketemu ibuku?
Dialogue: 0,0:20:00.80,0:20:02.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak apa-apa?
Dialogue: 0,0:20:02.99,0:20:05.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minta waktu sebentar.
Dialogue: 0,0:20:10.93,0:20:11.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:20:13.88,0:20:17.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana supaya kamu melupakanku?
Dialogue: 0,0:20:17.86,0:20:19.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:20:19.06,0:20:21.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan minta maaf.
Dialogue: 0,0:20:21.97,0:20:23.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah baikan?
Dialogue: 0,0:20:23.31,0:20:25.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berat rasanya.
Dialogue: 0,0:20:26.03,0:20:29.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minum air putih pun bisa muntah.
Dialogue: 0,0:20:29.66,0:20:32.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya dipasang infus.
Dialogue: 0,0:20:32.54,0:20:36.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Efek samping?\NObatnya terlalu keras?
Dialogue: 0,0:20:36.27,0:20:38.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:20:38.16,0:20:43.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sel darah putihku menurun\Njadi sering seriawan.
Dialogue: 0,0:20:44.74,0:20:50.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dokter bilang minggu depan\Nrambutku mulai rontok.
Dialogue: 0,0:20:51.34,0:20:53.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:20:56.18,0:21:00.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu yang paling membuatku sedih.
Dialogue: 0,0:21:01.12,0:21:03.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku tidak bisa melihat,
Dialogue: 0,0:21:03.89,0:21:06.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi tidak tahu diriku seperti apa.
Dialogue: 0,0:21:08.21,0:21:11.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya bisa membayangkan lewat sentuhan itu,
Dialogue: 0,0:21:12.02,0:21:13.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membuatku sangat sedih.
Dialogue: 0,0:21:20.66,0:21:22.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin mati.
Dialogue: 0,0:21:24.37,0:21:27.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ingin tidak bisa apa-apa
Dialogue: 0,0:21:27.71,0:21:30.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di depan orang yang kusayang.
Dialogue: 0,0:21:36.11,0:21:40.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di kampus ada proyek bernama\NKembang Api Anak-Anak.
Dialogue: 0,0:21:40.99,0:21:42.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembang Api Anak-Anak?
Dialogue: 0,0:21:42.82,0:21:44.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:21:44.22,0:21:46.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagian dari program relawan rumah sakit
Dialogue: 0,0:21:46.41,0:21:49.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk mengubah gambar anak-anak\Njadi kembang api.
Dialogue: 0,0:21:50.14,0:21:52.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu,
Dialogue: 0,0:21:52.64,0:21:55.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mau ikut menggambar juga, Fuyutsuki?
Dialogue: 0,0:21:55.36,0:21:57.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga?
Dialogue: 0,0:21:57.39,0:21:58.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:21:59.41,0:22:03.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini kami akan mengirim\Ngambar anak-anak,
Dialogue: 0,0:22:03.12,0:22:07.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi karena perlu banyak persiapan,\Npeluncurannya akhir September.
Dialogue: 0,0:22:07.81,0:22:11.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, ayo semangat.
Dialogue: 0,0:22:11.04,0:22:13.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggal dua bulan lagi.
Dialogue: 0,0:22:13.17,0:22:17.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadikan target\Nagar tubuhmu membaik saat itu!
Dialogue: 0,0:22:17.42,0:22:18.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa...
Dialogue: 0,0:22:19.82,0:22:22.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa bisa berkata seperti itu?
Dialogue: 0,0:22:24.48,0:22:27.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang ini berat bagiku!
