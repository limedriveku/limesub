Dialogue: 0,0:10:36.16,0:10:37.66,sign,,0000,0000,0000,,ASOSIASI MEDIS SEIROUKAI\NDICARI VOLUNTER MAHASISWA
Dialogue: 0,0:11:03.27,0:11:04.43,sign,,0000,0000,0000,,ASOSIASI MEDIS SEIROUKAI
Dialogue: 0,0:11:04.43,0:11:05.76,sign,,0000,0000,0000,,DICARI VOLUNTER MAHASISWA
Dialogue: 0,0:11:35.01,0:11:35.73,sign,,0000,0000,0000,,3. PENCEGAHAN INFEKSI
Dialogue: 0,0:11:35.73,0:11:40.64,sign,,0000,0000,0000,,4. HINDARI PEMBICARAAN MENGENAI PENYAKIT
Dialogue: 0,0:15:53.85,0:15:54.52,sign,,0000,0000,0000,,MUDAH
Dialogue: 0,0:15:54.52,0:15:57.06,sign,,0000,0000,0000,,OLAHRAGA MAKSIMAL
Dialogue: 0,0:15:57.06,0:15:59.88,sign,,0000,0000,0000,,YANG BISA KAMU LAKUKAN DI RUMAH
Dialogue: 0,0:15:59.88,0:16:01.06,sign,,0000,0000,0000,,PAMAN BEROTOT
Dialogue: 0,0:17:00.83,0:17:02.58,sign,,0000,0000,0000,,MOBIL MINI
Dialogue: 0,0:17:02.58,0:17:05.58,sign,,0000,0000,0000,,ENSIKLOPEDIA ORIGAMI
Dialogue: 0,0:17:05.58,0:17:06.53,sign,,0000,0000,0000,,MOBIL MINI
Dialogue: 0,0:22:24.74,0:22:30.04,sign,,0000,0000,0000,,PERASAAN CINTA
Dialogue: 0,0:00:07.20,0:00:08.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf...
Dialogue: 0,0:00:08.97,0:00:11.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kita pernah bertemu?
Dialogue: 0,0:00:16.30,0:00:17.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bohong...
Dialogue: 0,0:00:21.59,0:00:22.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu serius?
Dialogue: 0,0:00:26.97,0:00:27.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:00:29.80,0:00:30.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:00:33.31,0:00:35.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bukan lagi bercanda, kan?
Dialogue: 0,0:00:36.63,0:00:38.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tanya begitu?
Dialogue: 0,0:00:40.23,0:00:42.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata bukan bercanda.
Dialogue: 0,0:00:43.05,0:00:45.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kalian sebenarnya?
Dialogue: 0,0:00:45.48,0:00:47.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau aku lapor satpam.
Dialogue: 0,0:00:51.00,0:00:52.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:00:54.17,0:00:57.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sudah pasrah, aku malah jadi tenang.
Dialogue: 0,0:01:03.20,0:01:04.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perkenalkan.
Dialogue: 0,0:01:04.56,0:01:07.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Sorano Kakeru.
Dialogue: 0,0:03:02.92,0:03:04.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau lempar.
Dialogue: 0,0:03:14.61,0:03:16.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau menimbulkan\Nriak sekecil apa pun.
Dialogue: 0,0:03:26.88,0:03:29.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian baik-baik saja?
Dialogue: 0,0:03:48.00,0:03:49.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang.
Dialogue: 0,0:03:49.44,0:03:50.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian mau makan juga?
Dialogue: 0,0:03:52.09,0:03:53.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bau bawang!
Dialogue: 0,0:03:56.32,0:03:59.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita rangkum situasinya.
Dialogue: 0,0:04:04.71,0:04:07.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah festival kampus hari Minggu...
Dialogue: 0,0:04:07.02,0:04:09.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Telan dulu baru ngomong.
Dialogue: 0,0:04:09.96,0:04:12.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa dia bisa sesantai ini, sih?
Dialogue: 0,0:04:17.81,0:04:20.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah festival kampus hari Minggu...
Dialogue: 0,0:04:20.75,0:04:23.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berciuman dengan Fuyutsuki.
Dialogue: 0,0:04:24.31,0:04:26.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, hari Senin?
Dialogue: 0,0:04:26.55,0:04:29.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari itu kamu tidak bertemu Fuyutsuki, kan?
Dialogue: 0,0:04:29.21,0:04:32.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, bahkan dia tidak masuk kuliah.
Dialogue: 0,0:04:33.05,0:04:38.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, Senin malam, aku mengiriminya\Nvideo pernyataan cinta.
Dialogue: 0,0:04:38.88,0:04:43.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu, seminggu tidak bisa bertemu,\Ntidak bisa menghubunginya juga,
Dialogue: 0,0:04:43.31,0:04:46.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu setelah bertemu, dia hilang ingatan.
Dialogue: 0,0:04:49.56,0:04:53.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah menjelaskan kami pernah berteman,
Dialogue: 0,0:04:53.27,0:04:55.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia terus menyangkalnya.
Dialogue: 0,0:04:55.81,0:04:58.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bawa ponselnya tidak?
Dialogue: 0,0:04:59.36,0:05:02.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya bisa dibuktikan\Nlewat riwayat pesan?
Dialogue: 0,0:05:02.04,0:05:06.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sudah meminta dia\Nmenunjukkan ponselnya.
Dialogue: 0,0:05:06.60,0:05:08.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu...
Dialogue: 0,0:05:08.69,0:05:09.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:05:10.95,0:05:13.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Layarnya retak parah.
Dialogue: 0,0:05:20.43,0:05:22.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Masih bisa dipakai telepon, kok.
Dialogue: 0,0:05:22.41,0:05:26.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja layarnya susah digunakan."
Dialogue: 0,0:05:26.07,0:05:30.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu ucapan yang Koharu banget.
Dialogue: 0,0:05:32.68,0:05:34.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirip banget.
Dialogue: 0,0:05:34.61,0:05:37.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibilang bukan waktunya bercanda!
Dialogue: 0,0:05:37.05,0:05:40.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu situasinya lagi kurang baik.
Dialogue: 0,0:05:40.03,0:05:43.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi jangan ditambah ketus sama kami, dong.
Dialogue: 0,0:05:44.41,0:05:48.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa bilang begitu\Nkarena belum bertemu Koharu.
Dialogue: 0,0:05:49.64,0:05:53.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, jangan menangis terus.
Dialogue: 0,0:05:53.85,0:05:55.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham kenapa dia menangis.
Dialogue: 0,0:05:57.11,0:05:59.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kalian sebenarnya?
Dialogue: 0,0:06:01.72,0:06:05.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya semua yang berlalu\Nterhapus begitu saja.
Dialogue: 0,0:06:06.83,0:06:08.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal dulu begitu menyenangkan,
Dialogue: 0,0:06:08.71,0:06:12.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}penuh tawa dan rasa bahagia.
Dialogue: 0,0:06:12.63,0:06:14.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin aku terima
Dialogue: 0,0:06:14.77,0:06:18.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau semua itu hilang begitu saja?
Dialogue: 0,0:06:20.47,0:06:24.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah, menangis pun percuma, kan?
Dialogue: 0,0:06:24.13,0:06:26.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ingin kita melakukan sesuatu, kan?
Dialogue: 0,0:06:27.09,0:06:29.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melakukan apa?
Dialogue: 0,0:06:29.97,0:06:33.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada yang bisa kita lakukan?
Dialogue: 0,0:06:33.52,0:06:36.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya apa yang bisa kita lakukan?
Dialogue: 0,0:06:36.87,0:06:39.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, lakukan saja sebisa kita.
Dialogue: 0,0:06:42.13,0:06:44.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian mau sup miso?
Dialogue: 0,0:06:45.81,0:06:46.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayak emak-emak.
Dialogue: 0,0:06:47.35,0:06:50.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nasi juga masih banyak,\Ntidak usah sungkan.
Dialogue: 0,0:06:50.31,0:06:51.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya kamu emak kami?
Dialogue: 0,0:06:53.25,0:06:55.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga jangan bikin aku ketawa, dong.
Dialogue: 0,0:06:56.33,0:06:58.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menangis juga percuma, kan?
Dialogue: 0,0:06:59.80,0:07:02.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu juga sesantai itu?
Dialogue: 0,0:07:02.91,0:07:05.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santai?\NAku santai?
Dialogue: 0,0:07:06.63,0:07:07.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santai dari mana?
Dialogue: 0,0:07:10.36,0:07:11.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, ah.
Dialogue: 0,0:07:12.25,0:07:14.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makan giozanya sebelum dingin.
Dialogue: 0,0:07:14.64,0:07:15.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gih.
Dialogue: 0,0:07:16.48,0:07:19.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak usah.
Dialogue: 0,0:07:19.11,0:07:22.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma juga kita bertengkar.
Dialogue: 0,0:07:22.04,0:07:24.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sana makan giozanya.
Dialogue: 0,0:07:24.57,0:07:25.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayak emak-emak.
Dialogue: 0,0:07:31.24,0:07:32.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak.
Dialogue: 0,0:07:32.41,0:07:33.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan?
Dialogue: 0,0:07:40.31,0:07:43.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, jangan dimakan semua.
Dialogue: 0,0:07:43.31,0:07:47.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kalau lagi galau,\Nmakannya banyak.
Dialogue: 0,0:07:47.15,0:07:49.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada camilan selain gioza?
Dialogue: 0,0:07:49.55,0:07:53.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seingatku keluargamu baru mengirim sosis.
Dialogue: 0,0:07:54.76,0:07:58.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak boleh!\NItu makanan kesukaanku!
Dialogue: 0,0:07:58.00,0:08:01.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sosis spiral itu sosis yang melingkar...
Dialogue: 0,0:08:01.38,0:08:02.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu dia!
Dialogue: 0,0:08:02.75,0:08:05.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedengarannya enak banget!
Dialogue: 0,0:08:06.17,0:08:07.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak boleh.
Dialogue: 0,0:08:08.19,0:08:10.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pelit, bagi-bagi, dong!
Dialogue: 0,0:08:10.89,0:08:12.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak boleh!
Dialogue: 0,0:08:12.17,0:08:16.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Jangan!\N- Buka kulkasnya!
Dialogue: 0,0:08:16.04,0:08:19.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin pikiran kami terlalu naif\Nkarena ingin
Dialogue: 0,0:08:19.87,0:08:22.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menyelesaikan masalah Fuyutsuki sendiri.
Dialogue: 0,0:08:22.19,0:08:22.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gioza!
Dialogue: 0,0:08:22.90,0:08:26.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Giozanya buat kamu semua saja!\N- Tapi, memanggang gioza,
Dialogue: 0,0:08:26.32,0:08:27.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berebut sosis,
Dialogue: 0,0:08:27.99,0:08:30.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}gelisah, menangis, bertengkar...
Dialogue: 0,0:08:31.52,0:08:35.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir keputusasaan kami ini\Ntidak ada salahnya.
Dialogue: 0,0:08:48.75,0:08:54.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata dia rutin bernyanyi bersama anak-anak\Ndi rumah sakit tiap jam dua siang.
Dialogue: 0,0:09:02.47,0:09:03.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hai.
Dialogue: 0,0:09:07.68,0:09:11.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia benar-benar melupakanku?
Dialogue: 0,0:09:13.01,0:09:15.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sama sekali tidak menyadariku,
Dialogue: 0,0:09:15.57,0:09:17.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seolah tidak mendengar apa pun.
Dialogue: 0,0:09:19.48,0:09:22.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesak.\NSakit sekali.
Dialogue: 0,0:09:23.00,0:09:24.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya aku tidak menyapanya.
Dialogue: 0,0:09:25.61,0:09:26.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menghilang.
Dialogue: 0,0:09:28.52,0:09:29.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal...
Dialogue: 0,0:09:29.89,0:09:32.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku hanya ingin berada di dekat Fuyutsuki.
Dialogue: 0,0:09:34.68,0:09:36.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aneh rasanya.
Dialogue: 0,0:09:37.83,0:09:40.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang tidak pernah\Npeduli pada orang lain,
Dialogue: 0,0:09:40.29,0:09:42.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sekarang begitu terobsesi pada Fuyutsuki.
Dialogue: 0,0:09:52.21,0:09:53.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, deh!
Dialogue: 0,0:09:55.29,0:09:57.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka lagi mencari volunter mahasiswa.
Dialogue: 0,0:09:58.59,0:10:00.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau ikut volunter lagi?
Dialogue: 0,0:10:00.55,0:10:02.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baca dulu isinya.
Dialogue: 0,0:10:07.35,0:10:08.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumah sakit itu?
Dialogue: 0,0:10:09.16,0:10:12.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, membantu menemani anak bermain.
Dialogue: 0,0:10:13.29,0:10:15.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti membacakan dongeng\Natau cerita bergambar.
Dialogue: 0,0:10:15.87,0:10:18.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti kalau ikut itu...
Dialogue: 0,0:10:19.88,0:10:22.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bisa mengobrol dengan Koharu.
Dialogue: 0,0:10:23.29,0:10:25.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau punya niat terselubung...
Dialogue: 0,0:10:25.96,0:10:28.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Telan dulu baru ngomong.
Dialogue: 0,0:10:30.69,0:10:35.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak akan lolos wawancara\Nkalau punya niat terselubung.
Dialogue: 0,0:10:39.55,0:10:44.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau, aku akan berusaha maksimal\Ntanpa melibatkan Koharu.
Dialogue: 0,0:10:45.31,0:10:48.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita ambil dulu saja,\Nlagi pula Koharu sudah ketemu.
Dialogue: 0,0:10:49.82,0:10:50.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:10:55.92,0:10:57.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawabannya cuma satu.
Dialogue: 0,0:10:58.32,0:11:00.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asalkan aku bisa berada di sisi Fuyutsuki.
Dialogue: 0,0:11:04.43,0:11:05.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keesokan harinya,
Dialogue: 0,0:11:05.76,0:11:10.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami bertiga memutuskan mendaftar\Nvolunter mahasiswa di rumah sakit.
Dialogue: 0,0:11:11.41,0:11:15.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami bertiga lolos wawancara\Nyang sempat kukhawatirkan tanpa kendala.
Dialogue: 0,0:11:17.47,0:11:19.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama besar kampus
Dialogue: 0,0:11:19.29,0:11:23.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan pengalaman Hayase sebagai\Nvolunter sangat membantu.
Dialogue: 0,0:11:27.13,0:11:30.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak urusan administrasi seperti\Nmengisi formulir, tes antibodi,
Dialogue: 0,0:11:30.24,0:11:34.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai asuransi volunter.
Dialogue: 0,0:11:35.73,0:11:40.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, kami mengikuti orientasi volunter.
Dialogue: 0,0:11:41.25,0:11:46.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu bermain untuk anak-anak\Nyang dirawat disebut Kids Time.
Dialogue: 0,0:11:47.55,0:11:50.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kids Time bertujuan agar anak-anak\Nbisa melupakan rasa sakit mereka,
Dialogue: 0,0:11:50.64,0:11:53.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}meski hanya sejenak.
Dialogue: 0,0:11:54.69,0:11:58.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, jangan pernah menyinggung\Nsoal penyakit mereka.
Dialogue: 0,0:11:59.09,0:12:02.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagian besar pasien anak\Nyang dirawat inap jangka panjang
Dialogue: 0,0:12:02.41,0:12:04.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengidap penyakit berat.
Dialogue: 0,0:12:07.23,0:12:08.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pekerjaan ini memang berat,
Dialogue: 0,0:12:09.43,0:12:11.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kuharap kalian bisa bertahan lama.
Dialogue: 0,0:12:12.84,0:12:15.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata bukan pekerjaan mudah.
Dialogue: 0,0:12:20.40,0:12:22.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia salah satu pasien rawat inap
Dialogue: 0,0:12:22.92,0:12:25.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang biasa bermain piano di Kids Time.
Dialogue: 0,0:12:27.08,0:12:31.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuyutsuki,\Nperkenalkan volunter mahasiswa kita,
Dialogue: 0,0:12:31.25,0:12:35.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sorano, Narumi, dan Hayase.
Dialogue: 0,0:12:36.23,0:12:41.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka akan membantu kegiatan\NKids Time sebagai volunter.
Dialogue: 0,0:12:41.85,0:12:43.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata rawat inap.
Dialogue: 0,0:12:44.03,0:12:46.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kira bukan.
Dialogue: 0,0:12:48.10,0:12:49.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon bantuannya.
Dialogue: 0,0:12:50.73,0:12:53.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon bantuannya juga.
Dialogue: 0,0:13:07.06,0:13:09.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bentar, aku lagi bikin origami, tahu.
Dialogue: 0,0:13:09.89,0:13:12.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- A-Aduh!\N- Rawr!
Dialogue: 0,0:13:12.40,0:13:14.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit!
Dialogue: 0,0:13:14.29,0:13:15.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke sana, ah.
Dialogue: 0,0:13:19.83,0:13:22.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pinjam buku origaminya, dong.
Dialogue: 0,0:13:24.35,0:13:25.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:13:29.40,0:13:31.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buatkan aku origami, dong.
Dialogue: 0,0:13:31.64,0:13:34.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa membuatnya juga tidak, ya?
Dialogue: 0,0:13:44.09,0:13:46.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak, tolong yang ini.
Dialogue: 0,0:13:46.37,0:13:47.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:13:49.56,0:13:50.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terbang.
Dialogue: 0,0:13:51.89,0:13:52.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya.
Dialogue: 0,0:13:52.85,0:13:54.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar, ya.
Dialogue: 0,0:14:11.51,0:14:13.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:14:16.83,0:14:19.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau kubuatkan pesawat kertas juga?
Dialogue: 0,0:14:20.53,0:14:21.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu lagi kewalahan, kan?
Dialogue: 0,0:14:24.93,0:14:27.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tusuk!
Dialogue: 0,0:14:33.02,0:14:36.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh!
Dialogue: 0,0:14:37.55,0:14:39.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit banget!
Dialogue: 0,0:14:39.02,0:14:41.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan begitu!\NAduh!
Dialogue: 0,0:14:41.60,0:14:43.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan diulangi lagi!
Dialogue: 0,0:14:43.37,0:14:45.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa lihat-lihat Kakak?
Dialogue: 0,0:14:45.81,0:14:47.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bikin risi, tahu.
Dialogue: 0,0:14:47.41,0:14:50.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Aku enggak lihat-lihat!
Dialogue: 0,0:14:50.76,0:14:51.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bohong!
Dialogue: 0,0:14:51.67,0:14:52.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:14:53.09,0:14:57.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kamu melihat teteknya, kan?
Dialogue: 0,0:14:57.17,0:14:58.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:15:02.40,0:15:04.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak lihat, kok!
Dialogue: 0,0:15:04.55,0:15:06.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin aku lihat!
Dialogue: 0,0:15:06.18,0:15:08.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bohong, ah.
Dialogue: 0,0:15:08.84,0:15:11.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menjaili orang dewasa.
Dialogue: 0,0:15:12.28,0:15:15.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dia melihat teteknya!\N- Hei, tunggu!
Dialogue: 0,0:15:15.56,0:15:19.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tetek, tetek, tetek!\N- Jangan lari-larian!
Dialogue: 0,0:15:19.19,0:15:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetek, tetek, tetek!
Dialogue: 0,0:15:26.44,0:15:28.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tertangkap kamu!
Dialogue: 0,0:15:29.96,0:15:31.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Narumi.
Dialogue: 0,0:15:32.99,0:15:34.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lepaskan!
Dialogue: 0,0:15:34.68,0:15:37.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gerah, nih, Paman!
Dialogue: 0,0:15:37.00,0:15:37.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman?
Dialogue: 0,0:15:38.87,0:15:44.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau lari-larian lagi,\Nnanti ditangkap sama Paman Berotot.
Dialogue: 0,0:15:44.04,0:15:44.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dih.
Dialogue: 0,0:15:46.49,0:15:47.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:15:48.95,0:15:51.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman Berotot apaan?
Dialogue: 0,0:15:51.59,0:15:53.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti bakal viral di situs video, tuh.
Dialogue: 0,0:15:54.52,0:15:57.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini, dua ratus kali push up!
Dialogue: 0,0:15:57.06,0:15:59.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo genjot lagi bareng Paman hari ini!
Dialogue: 0,0:15:59.88,0:16:01.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Garing amat.
Dialogue: 0,0:16:01.06,0:16:02.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok rasanya aku yang garing?
Dialogue: 0,0:16:02.85,0:16:04.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang garing, kan?
Dialogue: 0,0:16:04.97,0:16:08.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian, Paman Berotot itu apaan?
Dialogue: 0,0:16:08.43,0:16:11.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, bantu buatkan origaminya!
Dialogue: 0,0:16:13.03,0:16:14.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:16:15.08,0:16:17.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah seperti duo pelawak, ya.
Dialogue: 0,0:16:30.20,0:16:31.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,
Dialogue: 0,0:16:31.22,0:16:34.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hari ini Sumire tidak datang lagi, ya?
Dialogue: 0,0:16:34.77,0:16:37.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya mereka\Nsudah memulai pengobatannya.
Dialogue: 0,0:16:37.65,0:16:40.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, pasti akan berat.
Dialogue: 0,0:16:43.49,0:16:47.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhir Juni, musim hujan berakhir\Nlebih cepat dari biasanya,
Dialogue: 0,0:16:47.75,0:16:50.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan libur musim panas sebentar lagi tiba.
Dialogue: 0,0:16:51.16,0:16:55.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski aku terus mengajak Fuyutsuki bicara,\Nobrolan kami tetap kaku,
Dialogue: 0,0:16:55.69,0:16:57.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan malah terkesan menghindariku.
Dialogue: 0,0:17:06.53,0:17:08.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sorano, kamu ada di sini?
Dialogue: 0,0:17:15.91,0:17:18.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ada di kananmu.
Dialogue: 0,0:17:21.76,0:17:25.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sorano, kuliahmu baik-baik saja?
Dialogue: 0,0:17:26.95,0:17:28.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya?
Dialogue: 0,0:17:29.55,0:17:34.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa,\Naku hanya mengkhawatirkan absensimu.
Dialogue: 0,0:17:34.20,0:17:36.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, soal itu.
Dialogue: 0,0:17:36.87,0:17:40.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aman saja, ada Hayase yang menggantikanku.
Dialogue: 0,0:17:41.56,0:17:44.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku orangnya gampang khawatir.
Dialogue: 0,0:17:44.71,0:17:47.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sendiri baik-baik saja?
Dialogue: 0,0:17:49.25,0:17:50.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya?
Dialogue: 0,0:17:51.34,0:17:55.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuliahmu baik-baik saja?
Dialogue: 0,0:17:56.64,0:17:57.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuliah?
Dialogue: 0,0:17:58.43,0:18:00.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak kuliah.
Dialogue: 0,0:18:04.45,0:18:06.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mengalihkan pembicaraan.
Dialogue: 0,0:18:06.84,0:18:08.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sedang membicarakanmu.
Dialogue: 0,0:18:10.07,0:18:13.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kegiatan volunter memang bagus,\N- Lelah. Hatiku sudah di batasnya.
Dialogue: 0,0:18:13.73,0:18:16.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- tapi tidak boleh melalaikan kuliah.\N- Tidak mau berpikir lagi.
Dialogue: 0,0:18:24.37,0:18:25.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sorano?
Dialogue: 0,0:18:27.60,0:18:28.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:18:31.35,0:18:33.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pikir kamu pergi.
Dialogue: 0,0:18:36.35,0:18:38.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya aku menghapus hawa kehadiranku.
Dialogue: 0,0:18:39.10,0:18:41.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bercanda.
Dialogue: 0,0:18:44.47,0:18:48.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Interaksi biasa kami dulu\Nsungguh sangat berharga.
Dialogue: 0,0:18:48.94,0:18:50.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu dengar?
Dialogue: 0,0:18:54.25,0:18:57.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa juga yang peduli soal kuliahku!
Dialogue: 0,0:18:59.65,0:19:02.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kenapa?
Dialogue: 0,0:19:06.19,0:19:07.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan urusanmu.
Dialogue: 0,0:19:08.16,0:19:09.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan apa-apa.
Dialogue: 0,0:19:10.73,0:19:15.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita mengobrol di luar saja, ya?
Dialogue: 0,0:19:20.75,0:19:21.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:19:23.63,0:19:25.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku tetap merasa bersalah.
Dialogue: 0,0:19:28.99,0:19:31.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat menyentuh tangan Fuyutsuki\Nsetelah sekian lama,
Dialogue: 0,0:19:31.64,0:19:34.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rasanya jauh lebih dingin daripada tangan
Dialogue: 0,0:19:34.61,0:19:36.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang pernah kugenggam dulu.
Dialogue: 0,0:20:01.32,0:20:02.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari luruskan dulu.
Dialogue: 0,0:20:03.68,0:20:05.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luruskan apa?
Dialogue: 0,0:20:05.95,0:20:09.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu, aku satu kampus
Dialogue: 0,0:20:09.98,0:20:11.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan kalian?
Dialogue: 0,0:20:11.75,0:20:13.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, begitu.
Dialogue: 0,0:20:15.16,0:20:17.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita saling kenal,
Dialogue: 0,0:20:17.95,0:20:22.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu tiba-tiba aku terlihat\Nseperti hilang ingatan?
Dialogue: 0,0:20:22.65,0:20:23.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:20:24.89,0:20:27.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya aku bingung.
Dialogue: 0,0:20:27.75,0:20:30.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu harus berbuat apa.
Dialogue: 0,0:20:30.37,0:20:33.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, kamu mau aku bagaimana?
Dialogue: 0,0:20:33.71,0:20:35.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau aku mengingatnya?
Dialogue: 0,0:20:35.41,0:20:36.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:20:36.63,0:20:39.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya, itu sangat menggangguku.
Dialogue: 0,0:20:40.43,0:20:41.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengganggu?
Dialogue: 0,0:20:42.35,0:20:43.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apanya yang mengganggu?
Dialogue: 0,0:20:44.99,0:20:46.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengingatnya itu mengganggu?
Dialogue: 0,0:20:47.47,0:20:49.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa hal yang sangat berharga bagiku,
Dialogue: 0,0:20:49.45,0:20:53.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sama sekali tidak ada artinya\Nbagi Fuyutsuki?
Dialogue: 0,0:20:55.12,0:20:56.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan?
Dialogue: 0,0:20:57.53,0:20:59.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan itu?
Dialogue: 0,0:21:02.41,0:21:05.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya, sisa hidupku tinggal\Nsetengah tahun lagi.
Dialogue: 0,0:21:06.32,0:21:07.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:21:08.82,0:21:11.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kankernya sudah menyebar ke hati.
Dialogue: 0,0:21:11.39,0:21:13.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar lagi aku akan mati.
Dialogue: 0,0:21:14.69,0:21:16.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sudah tahu akan mati,
Dialogue: 0,0:21:16.93,0:21:20.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengingat kenangan itu hanya\Nakan menyakitkan, bukan?
Dialogue: 0,0:21:21.02,0:21:22.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk kamu juga,
Dialogue: 0,0:21:22.67,0:21:26.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lebih baik jangan pedulikan orang\Nyang sebentar lagi mati sepertiku.
Dialogue: 0,0:21:26.79,0:21:28.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu cuma buang-buang waktu.
Dialogue: 0,0:21:30.08,0:21:33.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu tenangnya Fuyutsuki\Nmengucapkan hal semenyedihkan itu.
Dialogue: 0,0:21:35.89,0:21:38.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar-benar akan mati?
Dialogue: 0,0:21:39.59,0:21:41.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:21:41.63,0:21:43.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sudah biasa.
Dialogue: 0,0:21:43.97,0:21:45.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena sudah ketiga kalinya.
Dialogue: 0,0:21:47.35,0:21:50.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemoterapi sudah dimulai sejak minggu lalu,
Dialogue: 0,0:21:50.46,0:21:52.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan sejujurnya, kondisiku memburuk.
Dialogue: 0,0:21:54.00,0:21:57.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira dua minggu lagi, aku tidak akan\Nbisa keluar dari kamar rawat.
Dialogue: 0,0:21:59.46,0:22:02.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, lupakanlah aku.
Dialogue: 0,0:22:04.70,0:22:07.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong, lupakan aku.
Dialogue: 0,0:22:11.10,0:22:15.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf karena sudah bersikap aneh padamu.
Dialogue: 0,0:22:16.46,0:22:19.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah memaksakan diri mendekatimu.
Dialogue: 0,0:22:21.59,0:22:24.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaanku yang mencintai Fuyutsuki\Nmeluap tidak terkendali.
Dialogue: 0,0:22:26.77,0:22:27.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai berantakan.
